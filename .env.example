# Copy this file to `.env` and fill in the real values. Same names need to go
# into Railway → Variables (so the deployed build has them baked in).
#
# All PUBLIC_* values end up in the browser bundle — that's fine here, each
# service rate-limits per key. Never put `secret`/`service_role` keys here.

# ─── Supabase — admin centre, customer login, all database/storage access ───
#  Supabase dashboard → Project Settings → API
PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ─── Pexels — stock photo search in the editor's Photos panel ───────────────
#  Sign up: https://www.pexels.com/api  (200 req/hour free, no approval needed)
PUBLIC_PEXELS_API_KEY=YOUR-PEXELS-KEY

# ─── Unsplash — stock photo search in the editor's Photos panel ─────────────
#  Sign up: https://unsplash.com/developers  (50 req/hour demo, 1000/hr in prod)
PUBLIC_UNSPLASH_ACCESS_KEY=YOUR-UNSPLASH-ACCESS-KEY

# ─── Cloudflare R2 deliverables Worker — Jack's videography uploads ──────────
#  Deploy worker/ (see worker/README.md) then paste the deployed Worker URL.
#  e.g. https://tmke-deliverables-api.<your-subdomain>.workers.dev
PUBLIC_R2_WORKER_URL=

# ─── Ask an Expert — in-Studio chat widget backend ─────────────────────────
#  Point at the deployed Supabase Edge Function (recommended):
#    https://<project-ref>.supabase.co/functions/v1/ask-expert
#  Deploy with:  supabase functions deploy ask-expert --no-verify-jwt
#  Then:  supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
#  Leave blank during local dev — the widget falls back to a stub reply.
PUBLIC_ASK_EXPERT_URL=
