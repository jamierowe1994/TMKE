# Supabase — admin centre + customer catalogue
# Copy this file to `.env` and fill in the values from your Supabase project:
#   Supabase dashboard → Project Settings → API
#
# These keys are PUBLIC (exposed to the browser). Row-level security policies
# on the database enforce who can read/write — see supabase/schema.sql.

PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
