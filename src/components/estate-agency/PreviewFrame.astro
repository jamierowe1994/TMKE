---
// Chrome that wraps a template preview. Floating top bar tells the visitor
// they're looking at a TMKE example, with a back-to-showcase link and an
// inline "Register interest" CTA that scrolls to the form embedded below.
interface Props {
  templateName: string;
  tagline?: string;
  accent?: string;
}

const { templateName, tagline = "", accent = "#474254" } = Astro.props;
---

<div class="ea-preview-frame" style={`--ea-accent: ${accent};`}>
  <header class="ea-preview-bar">
    <a href="/estate-agency" class="ea-preview-back" aria-label="Back to showcase">
      <span aria-hidden="true">&larr;</span>
      <span>All templates</span>
    </a>
    <div class="ea-preview-meta">
      <span class="ea-preview-eyebrow">TMKE Preview</span>
      <span class="ea-preview-name">{templateName}</span>
      {tagline && <span class="ea-preview-tagline">{tagline}</span>}
    </div>
    <a href="#register-interest" class="ea-preview-cta">
      Register interest
      <span aria-hidden="true">&rarr;</span>
    </a>
  </header>

  <div class="ea-preview-stage">
    <slot />
  </div>
</div>

<style>
  .ea-preview-frame {
    --ea-accent: #474254;
    background: var(--paper);
    color: var(--ink);
  }
  .ea-preview-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding: 14px 28px;
    background: rgba(12,11,10,0.92);
    color: var(--paper);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid rgba(240,238,235,0.08);
  }
  .ea-preview-back,
  .ea-preview-cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--paper);
    padding: 8px 14px;
    border: 1px solid rgba(240,238,235,0.2);
    border-radius: 2px;
    transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }
  .ea-preview-back:hover { border-color: rgba(240,238,235,0.5); }
  .ea-preview-cta {
    background: var(--ea-accent);
    border-color: var(--ea-accent);
  }
  .ea-preview-cta:hover { background: var(--paper); color: var(--ink); }

  .ea-preview-meta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    text-align: center;
  }
  .ea-preview-eyebrow {
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: rgba(240,238,235,0.55);
  }
  .ea-preview-name {
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    color: var(--paper);
  }
  .ea-preview-tagline {
    font-family: var(--sans);
    font-size: 11px;
    color: rgba(240,238,235,0.55);
  }

  @media (max-width: 720px) {
    .ea-preview-bar { padding: 10px 16px; gap: 12px; }
    .ea-preview-tagline { display: none; }
    .ea-preview-back span:not([aria-hidden]),
    .ea-preview-cta span:not([aria-hidden]) {
      display: none;
    }
  }

  .ea-preview-stage {
    min-height: 70vh;
  }
</style>
