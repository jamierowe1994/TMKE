<script is:inline>
  (function () {
    const scope = document.querySelector(".wo-root");
    if (!scope) return;

    const items = scope.querySelectorAll("[data-reveal]");
    if (!items.length) return;

    items.forEach(function (el) {
      const d = el.getAttribute("data-reveal-delay");
      if (d) el.style.setProperty("--wo-rd", d + "ms");
    });

    // Force-reveal helper.
    function reveal(el) { el.classList.add("is-in"); }

    // Bail on legacy environments.
    if (!("IntersectionObserver" in window)) {
      items.forEach(reveal);
      return;
    }

    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          reveal(entry.target);
          io.unobserve(entry.target);
        }
      });
    }, { threshold: 0.15, rootMargin: "0px 0px -60px 0px" });

    items.forEach(function (el) { io.observe(el); });

    // Initial above-the-fold pass — elements already in view should reveal
    // immediately instead of waiting for the IO callback (which can miss
    // elements that loaded already inside the viewport).
    requestAnimationFrame(function () {
      var vh = window.innerHeight || document.documentElement.clientHeight || 0;
      items.forEach(function (el) {
        var r = el.getBoundingClientRect();
        if (r.top < vh && r.bottom > 0) reveal(el);
      });
    });

    // Safety net — if anything's still un-revealed after a reasonable
    // window (slow / hidden viewport / IO not firing), reveal them all so
    // the page never gets stuck with invisible content.
    setTimeout(function () {
      items.forEach(reveal);
    }, 3000);
  })();
</script>
