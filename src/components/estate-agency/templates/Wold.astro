---
// WOLD — Countryside template.
// Warm cream/oak palette. Traditional country property, minimal pace.
// Regional collections, period-property listings, slow editorial copy.

const UNSPLASH = (id, w = 1600, h = 1000) =>
  `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${w}&h=${h}&q=80`;

const HERO = UNSPLASH("1505693416388-ac5ce068fe85", 2400, 1500);

const REGIONS = [
  { name: "Cotswolds",     count: 28, img: UNSPLASH("1469854523086-cc02fe5d8800", 800, 600) },
  { name: "Yorkshire Dales", count: 17, img: UNSPLASH("1502672260266-1c1ef2d93688", 800, 600) },
  { name: "Lake District", count: 22, img: UNSPLASH("1496564203457-11bb12075d90", 800, 600) },
  { name: "Peak District", count: 14, img: UNSPLASH("1521017432531-fbd92d768814", 800, 600) },
];

const LISTINGS = [
  {
    title: "Stable Cottage",
    where: "Stow-on-the-Wold, Gloucestershire",
    period: "Grade II · 1840s",
    land: "1.2 acres",
    beds: 4,
    guide: "£1,650,000",
    img: UNSPLASH("1505693416388-ac5ce068fe85", 1200, 900),
  },
  {
    title: "Foxholes Farm",
    where: "Kirkby Lonsdale, Cumbria",
    period: "Period · 1790s",
    land: "8.4 acres",
    beds: 6,
    guide: "£2,250,000",
    img: UNSPLASH("1448630360428-65456885c650", 1200, 900),
  },
  {
    title: "Long Meadow",
    where: "Bakewell, Derbyshire",
    period: "Stone-built · 1880s",
    land: "0.6 acres",
    beds: 5,
    guide: "£995,000",
    img: UNSPLASH("1430285561322-7808604715df", 1200, 900),
  },
];

const VALUES = [
  { h: "Character",  p: "Houses with bones worth preserving — beams, stone, period detail." },
  { h: "Light",      p: "Aspect, ceilings, windows. The rooms feel right before you measure them." },
  { h: "Land",       p: "An acre that earns its keep — orchard, paddock, walled garden, view." },
  { h: "Stewardship", p: "Quiet, careful sales. We move slowly so the right buyer can be found." },
];
---

<div class="wo-root">

  <header class="wo-nav">
    <a href="#" class="wo-mark">Wold</a>
    <nav class="wo-nav-links">
      <a href="#">Properties</a>
      <a href="#">Regions</a>
      <a href="#">Stories</a>
      <a href="#">About</a>
    </nav>
    <a href="#register-interest" class="wo-nav-cta">Enquire</a>
  </header>

  <!-- Hero: type-led, country property image on the right. -->
  <section class="wo-hero">
    <div class="wo-hero-text">
      <div class="wo-eyebrow">/ Country Property /</div>
      <h1 class="wo-hero-h">
        Quiet houses.<br />
        <em>Honest land.</em>
      </h1>
      <p class="wo-hero-p">
        A small, considered list of country homes across the wolds, dales, and
        downs. We sell slowly. We choose the houses we know.
      </p>
      <div class="wo-hero-actions">
        <a href="#listings" class="wo-btn wo-btn--solid">See the houses</a>
        <a href="#regions" class="wo-btn">Browse by region</a>
      </div>
      <div class="wo-hero-meta">
        <span><strong>81</strong> homes listed</span>
        <span><strong>6</strong> counties</span>
        <span>Est. 2014</span>
      </div>
    </div>
    <div class="wo-hero-media">
      <img src={HERO} alt="" loading="eager" />
      <div class="wo-hero-tag">Cotswolds &middot; Stable Cottage</div>
    </div>
  </section>

  <!-- Editorial intro. -->
  <section class="wo-intro">
    <div class="wo-intro-inner">
      <div class="wo-chapter">/ The list /</div>
      <h2 class="wo-intro-h">
        Country homes for people who would rather not rush.
      </h2>
      <p>
        Wold isn't a portal. We hold a short list of country houses at any time
        &mdash; period properties with land, character, and an honest story
        behind the door. We meet the owners, we know the houses, and we sell
        them to the right people, not the first ones.
      </p>
    </div>
  </section>

  <!-- Regions. -->
  <section class="wo-regions" id="regions">
    <header class="wo-section-head">
      <div class="wo-chapter">/ Regions /</div>
      <h2>Where we work.</h2>
      <p>Four counties we know by heart. Tap one to see what's listed.</p>
    </header>
    <div class="wo-regions-grid">
      {REGIONS.map((r) => (
        <a class="wo-region" href="#">
          <div class="wo-region-media"><img src={r.img} alt={r.name} loading="lazy" /></div>
          <div class="wo-region-name">{r.name}</div>
          <div class="wo-region-count">{r.count} listed</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Listings. -->
  <section class="wo-listings" id="listings">
    <header class="wo-section-head">
      <div class="wo-chapter">/ Currently on the list /</div>
      <h2>Three to consider.</h2>
      <p>A snapshot of the present list. The full set is shown on request.</p>
    </header>
    <div class="wo-listings-grid">
      {LISTINGS.map((l) => (
        <article class="wo-listing">
          <div class="wo-listing-media"><img src={l.img} alt={l.title} loading="lazy" /></div>
          <div class="wo-listing-body">
            <h3>{l.title}</h3>
            <p class="wo-listing-where">{l.where}</p>
            <ul class="wo-listing-meta">
              <li><span>Period</span><strong>{l.period}</strong></li>
              <li><span>Land</span><strong>{l.land}</strong></li>
              <li><span>Bedrooms</span><strong>{l.beds}</strong></li>
            </ul>
            <footer>
              <span class="wo-listing-guide">Guide {l.guide}</span>
              <span class="wo-listing-arrow">&rarr;</span>
            </footer>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- What we look for. -->
  <section class="wo-values">
    <header class="wo-section-head wo-section-head--light">
      <div class="wo-chapter">/ What we look for /</div>
      <h2>Four things, every time.</h2>
    </header>
    <div class="wo-values-grid">
      {VALUES.map((v, i) => (
        <article class="wo-value">
          <div class="wo-value-num">{String(i + 1).padStart(2, "0")}</div>
          <h3>{v.h}</h3>
          <p>{v.p}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Quiet CTA. -->
  <section class="wo-cta">
    <div class="wo-cta-inner">
      <h2>
        Looking for somewhere <em>slower</em>?<br />
        Tell us what you're after.
      </h2>
      <p>
        A short conversation, an honest list. We'll come back with a handful
        of houses you'd actually want to see, and we'll travel to meet you on
        the doorstep if it helps.
      </p>
      <a href="#register-interest" class="wo-btn wo-btn--solid">Start a conversation</a>
    </div>
  </section>

  <footer class="wo-foot">
    <div class="wo-foot-grid">
      <div>
        <div class="wo-mark wo-foot-mark">Wold</div>
        <p>Country property &mdash; carefully chosen.</p>
      </div>
      <div>
        <h4>Office</h4>
        <p>The Old Wool Hall<br />Stow-on-the-Wold<br />GL54 1AA</p>
      </div>
      <div>
        <h4>Contact</h4>
        <p>list@wold.country<br />01451 000 000</p>
      </div>
      <div>
        <h4>Hours</h4>
        <p>Mon &ndash; Sat<br />By appointment</p>
      </div>
    </div>
    <div class="wo-foot-base">
      <span>&copy; 2026 Wold &mdash; Country Property</span>
      <span>Registered in England &middot; No. 00000000</span>
    </div>
  </footer>
</div>

<style>
  .wo-root {
    --wo-cream:  #F2EEE5;
    --wo-paper:  #FAF7F0;
    --wo-oak:    #6f6147;
    --wo-sage:   #7d8a6e;
    --wo-ink:    #2a2620;
    --wo-mute:   rgba(42,38,32,0.65);
    --wo-line:   rgba(42,38,32,0.14);
    --wo-serif:  "Cormorant Garamond", "EB Garamond", Georgia, serif;
    --wo-sans:   "Darker Grotesque", "Inter", system-ui, sans-serif;
    background: var(--wo-paper);
    color: var(--wo-ink);
    font-family: var(--wo-sans);
  }
  .wo-root *, .wo-root *::before, .wo-root *::after { box-sizing: border-box; }

  /* === Nav === */
  .wo-nav {
    position: sticky; top: 0; z-index: 20;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 40px;
    background: rgba(250,247,240,0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--wo-line);
  }
  .wo-mark {
    font-family: var(--wo-serif);
    font-size: 26px;
    letter-spacing: 0.02em;
    color: var(--wo-ink);
  }
  .wo-nav-links { display: flex; gap: 28px; }
  .wo-nav-links a {
    font-size: 13px;
    color: var(--wo-ink);
    opacity: 0.78;
  }
  .wo-nav-links a:hover { opacity: 1; }
  .wo-nav-cta {
    padding: 8px 18px;
    border: 1px solid var(--wo-ink);
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--wo-ink);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .wo-nav-cta:hover { background: var(--wo-ink); color: var(--wo-paper); }

  /* === Hero === */
  .wo-hero {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 56px;
    align-items: center;
    padding: 90px 40px 110px;
    max-width: 1320px;
    margin: 0 auto;
  }
  @media (max-width: 880px) {
    .wo-hero { grid-template-columns: 1fr; gap: 32px; padding: 60px 24px 80px; }
  }
  .wo-eyebrow {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--wo-oak);
    margin-bottom: 22px;
  }
  .wo-hero-h {
    font-family: var(--wo-serif);
    font-weight: 400;
    font-size: clamp(48px, 7vw, 96px);
    line-height: 1.0;
    letter-spacing: -0.02em;
    margin: 0 0 24px;
  }
  .wo-hero-h em { font-style: italic; color: var(--wo-oak); }
  .wo-hero-p {
    font-size: 16px;
    line-height: 1.65;
    color: var(--wo-mute);
    max-width: 44ch;
    margin: 0 0 32px;
  }
  .wo-hero-actions { display: flex; gap: 12px; margin-bottom: 36px; flex-wrap: wrap; }
  .wo-btn {
    display: inline-flex;
    align-items: center;
    padding: 12px 22px;
    border: 1px solid var(--wo-ink);
    border-radius: 999px;
    font-size: 12px;
    letter-spacing: 0.16em;
    color: var(--wo-ink);
    transition: background 0.2s ease, color 0.2s ease;
  }
  .wo-btn--solid { background: var(--wo-ink); color: var(--wo-paper); border-color: var(--wo-ink); }
  .wo-btn:hover { background: var(--wo-ink); color: var(--wo-paper); }
  .wo-btn--solid:hover { background: #000; }
  .wo-hero-meta {
    display: flex; gap: 28px;
    padding-top: 18px;
    border-top: 1px solid var(--wo-line);
    font-size: 12px;
    color: var(--wo-mute);
  }
  .wo-hero-meta strong { color: var(--wo-ink); font-weight: 600; }

  .wo-hero-media {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 2px;
  }
  .wo-hero-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wo-hero-tag {
    position: absolute;
    left: 20px; bottom: 20px;
    padding: 8px 14px;
    background: rgba(250,247,240,0.9);
    border-radius: 999px;
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--wo-ink);
  }

  /* === Intro === */
  .wo-intro { background: var(--wo-cream); padding: 110px 40px; }
  .wo-intro-inner { max-width: 880px; margin: 0 auto; }
  .wo-chapter {
    font-size: 11px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--wo-oak);
    margin-bottom: 18px;
  }
  .wo-intro-h {
    font-family: var(--wo-serif);
    font-weight: 400;
    font-size: clamp(34px, 4.4vw, 56px);
    line-height: 1.1;
    letter-spacing: -0.014em;
    margin: 0 0 22px;
  }
  .wo-intro p {
    font-size: 16px;
    line-height: 1.7;
    color: var(--wo-mute);
    max-width: 60ch;
    margin: 0;
  }

  /* === Section heads === */
  .wo-section-head {
    max-width: 1320px;
    margin: 0 auto 56px;
    padding: 0 40px;
  }
  .wo-section-head h2 {
    font-family: var(--wo-serif);
    font-weight: 400;
    font-size: clamp(34px, 4vw, 52px);
    margin: 0 0 14px;
    letter-spacing: -0.014em;
  }
  .wo-section-head p {
    font-size: 15px;
    color: var(--wo-mute);
    margin: 0;
    max-width: 50ch;
  }
  .wo-section-head--light .wo-chapter { color: var(--wo-cream); opacity: 0.7; }
  .wo-section-head--light h2 { color: var(--wo-cream); }

  /* === Regions === */
  .wo-regions { padding: 110px 0 90px; }
  .wo-regions-grid {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  @media (max-width: 880px) {
    .wo-regions-grid { grid-template-columns: 1fr 1fr; }
  }
  .wo-region {
    display: block;
    color: var(--wo-ink);
  }
  .wo-region-media {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 2px;
    margin-bottom: 14px;
  }
  .wo-region-media img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.6s cubic-bezier(.2,.7,.2,1);
  }
  .wo-region:hover .wo-region-media img { transform: scale(1.04); }
  .wo-region-name {
    font-family: var(--wo-serif);
    font-size: 22px;
    margin-bottom: 4px;
  }
  .wo-region-count {
    font-size: 12px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wo-mute);
  }

  /* === Listings === */
  .wo-listings { background: var(--wo-cream); padding: 110px 0; }
  .wo-listings-grid {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 880px) { .wo-listings-grid { grid-template-columns: 1fr; } }
  .wo-listing {
    background: var(--wo-paper);
    border-radius: 2px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .wo-listing-media { aspect-ratio: 4 / 3; overflow: hidden; }
  .wo-listing-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .wo-listing-body { padding: 24px 24px 22px; flex: 1; display: flex; flex-direction: column; }
  .wo-listing h3 {
    font-family: var(--wo-serif);
    font-weight: 400;
    font-size: 26px;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }
  .wo-listing-where {
    font-size: 13px;
    color: var(--wo-mute);
    margin: 0 0 18px;
  }
  .wo-listing-meta {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .wo-listing-meta li {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    border-bottom: 1px dashed var(--wo-line);
    padding-bottom: 8px;
  }
  .wo-listing-meta span { color: var(--wo-mute); letter-spacing: 0.06em; text-transform: uppercase; font-size: 11px; }
  .wo-listing-meta strong { font-weight: 600; color: var(--wo-ink); }
  .wo-listing footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 8px;
  }
  .wo-listing-guide {
    font-family: var(--wo-serif);
    font-size: 18px;
    color: var(--wo-oak);
  }
  .wo-listing-arrow {
    width: 32px; height: 32px;
    border-radius: 50%;
    background: var(--wo-ink);
    color: var(--wo-paper);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
  }

  /* === Values === */
  .wo-values { background: var(--wo-oak); padding: 110px 0; color: var(--wo-cream); }
  .wo-values-grid {
    max-width: 1320px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 32px;
  }
  @media (max-width: 880px) { .wo-values-grid { grid-template-columns: 1fr 1fr; } }
  .wo-value {
    padding-top: 18px;
    border-top: 1px solid rgba(242,238,229,0.3);
  }
  .wo-value-num {
    font-family: var(--wo-serif);
    font-style: italic;
    font-size: 14px;
    opacity: 0.7;
    margin-bottom: 22px;
  }
  .wo-value h3 {
    font-family: var(--wo-serif);
    font-weight: 400;
    font-size: 22px;
    margin: 0 0 8px;
  }
  .wo-value p {
    font-size: 13px;
    line-height: 1.6;
    color: rgba(242,238,229,0.78);
    margin: 0;
  }

  /* === CTA === */
  .wo-cta { padding: 130px 40px; text-align: center; }
  .wo-cta-inner { max-width: 720px; margin: 0 auto; }
  .wo-cta h2 {
    font-family: var(--wo-serif);
    font-weight: 400;
    font-size: clamp(34px, 4.4vw, 54px);
    line-height: 1.1;
    margin: 0 0 18px;
    letter-spacing: -0.014em;
  }
  .wo-cta h2 em { font-style: italic; color: var(--wo-oak); }
  .wo-cta p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--wo-mute);
    margin: 0 0 32px;
  }

  /* === Footer === */
  .wo-foot { background: var(--wo-cream); padding: 80px 40px 36px; }
  .wo-foot-grid {
    max-width: 1320px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1fr;
    gap: 32px;
    padding-bottom: 48px;
    border-bottom: 1px solid var(--wo-line);
  }
  @media (max-width: 880px) { .wo-foot-grid { grid-template-columns: 1fr 1fr; gap: 24px; } }
  .wo-foot-mark { margin-bottom: 8px; }
  .wo-foot h4 {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--wo-mute);
    margin: 0 0 8px;
  }
  .wo-foot p {
    margin: 0;
    font-size: 13px;
    color: var(--wo-ink);
    line-height: 1.65;
  }
  .wo-foot-base {
    max-width: 1320px;
    margin: 0 auto;
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--wo-mute);
  }
</style>
