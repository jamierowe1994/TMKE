  .pa-foot-base {
    max-width: 1280px;
    margin: 0 auto;
    padding-top: 22px;
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    color: var(--pa-mute);
  }

  /* === Cinematic hero (scroll-scrubbed video) === */
  .pa-cine {
    position: relative;
    /* Scroll runway: 500vh = the visitor scrolls 5 screen-heights to
       traverse the entire video. Adjust to taste — taller = slower scrub. */
    height: 500vh;
    background: #000;
  }
  .pa-cine-sticky {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }
  .pa-cine-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    /* Hardware-accelerated paint — avoids reflow on currentTime updates. */
    transform: translateZ(0);
  }
  .pa-cine-vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(
        to bottom,
        rgba(0,0,0,0.35) 0%,
        rgba(0,0,0,0) 28%,
        rgba(0,0,0,0) 58%,
        rgba(0,0,0,0.6) 100%
      );
  }
  .pa-cine-captions {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  /* Caption — frosted-glass card pinned to the bottom-left by default.
     The middle caption uses .pa-cine-caption--right to flip to the right
     side for visual variety; layout is otherwise identical. */
  .pa-cine-caption {
    position: absolute;
    bottom: 88px;
    left: 56px;
    max-width: 520px;
    color: #fff;
    opacity: 0;
    will-change: opacity;
    /* JS sets opacity per-frame for accurate scrub; no CSS transition. */
    padding: 26px 30px 28px;
    background: rgba(20, 22, 26, 0.32);
    backdrop-filter: blur(22px) saturate(140%);
    -webkit-backdrop-filter: blur(22px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.16);
    border-radius: 16px;
    box-shadow:
      0 12px 36px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.08);
  }
  .pa-cine-caption--right {
    left: auto;
    right: 56px;
    text-align: right;
  }
  .pa-cine-eyebrow {
    font-size: 11px;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.78);
    margin-bottom: 12px;
  }
  .pa-cine-caption h2 {
    font-weight: 600;
    font-size: clamp(34px, 4.6vw, 56px);
    line-height: 1.05;
    letter-spacing: -0.02em;
    margin: 0 0 10px;
  }
  .pa-cine-caption p {
    font-size: 15px;
    line-height: 1.5;
    color: rgba(255,255,255,0.88);
    margin: 0;
    max-width: 44ch;
  }
  .pa-cine-caption--right p { margin-left: auto; }
  .pa-cine-scroll-hint {
    position: absolute;
    bottom: 28px;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    color: rgba(255,255,255,0.7);
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    animation: pa-cine-bob 2.6s ease-in-out infinite;
    pointer-events: none;
  }
  .pa-cine-scroll-hint svg {
    width: 16px;
    height: 16px;
  }
  @keyframes pa-cine-bob {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50%      { transform: translateX(-50%) translateY(6px); }
  }
  @media (max-width: 880px) {
    .pa-cine-caption {
      bottom: 80px; left: 20px; right: 20px;
      max-width: none; padding: 22px 24px 24px;
    }
    /* On mobile, the right-aligned caption falls back to left alignment so
       the glass card still spans the available width without awkward margins. */
    .pa-cine-caption--right { right: 20px; text-align: left; }
    .pa-cine-caption--right p { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    /* No scroll runway — the section collapses to one viewport.
       Script detects this and pins the first caption visible. */
    .pa-cine { height: 100vh; }
    .pa-cine-scroll-hint { display: none; }
    .pa-cine-video { animation: none; }
  }
</style>

<script is:inline>
  /* Parade — scroll-driven video scrub.
   *
   * Drives <video>.currentTime from the visitor's scroll position through
   * the sticky cinematic section, and fades captions in/out at per-caption
   * progress milestones (data-at / data-until, normalised [0..1]).
   *
   * Architecture: continuous rAF loop while the section is in view, reading
   * scroll position via getBoundingClientRect every frame. We deliberately
   * do NOT rely on the window 'scroll' event because Lenis (smooth-scroll
   * library, loaded in BaseLayout) intercepts wheel input and the native
   * scroll event does not fire on window in this environment. rAF + IO is
   * also the canonical pattern for high-fidelity scroll scrubbing (Apple,
   * Stripe, etc. all do it this way).
   *
   * Notes:
   * - The MP4 is encoded all-keyframe so currentTime seeks are frame-accurate
   *   even on iOS Safari (where non-keyframe scrubbing is slow).
   * - We "prime" the decoder on first user gesture (scroll/touch) because
   *   iOS won't allow currentTime updates on a video that's never played.
   * - The rAF loop is idle when the section is off-screen (IntersectionObserver
   *   gates it), so there's no per-frame cost on the rest of the page.
   * - prefers-reduced-motion: pins the first caption, skips the scrub entirely.
   */
  (function () {
    const root = document.querySelector('[data-pa-cine]');
    if (!root) return;
    const video = root.querySelector('[data-pa-cine-video]');
    const captions = Array.from(root.querySelectorAll('.pa-cine-caption'));
    const nav = document.querySelector('[data-pa-nav]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Nav morph — toggles .pa-nav--solid when scroll has progressed far
    // enough through the cinematic that the wordmark should "land" into
    // the page nav (glass background, dark text, nav links visible).
    // Threshold sits past the last caption so the morph happens during the
    // final stretch of the cinematic, not mid-content.
    const NAV_SOLID_AT = 0.92;
    const setNavSolid = (solid) => {
      if (!nav) return;
      nav.classList.toggle('pa-nav--solid', solid);
    };

    if (reduced) {
      // Static fallback — first caption stays visible over the poster frame.
      if (captions[0]) captions[0].style.opacity = '1';
      // The cinematic collapses to one viewport in reduced-motion mode, so
      // jump the nav straight to its solid state — no morph to drive.
      setNavSolid(true);
      return;
    }

    let duration = 0;
    let primed = false;
    let lastProgress = -1;

    const setDuration = () => { duration = video.duration || 0; };
    video.addEventListener('loadedmetadata', setDuration);
    if (video.readyState >= 1) setDuration();

    // iOS Safari requires a user gesture before currentTime updates work
    // reliably on a video that's never played. Prime once on first input.
    const prime = () => {
      if (primed) return;
      primed = true;
      const p = video.play();
      if (p && typeof p.then === 'function') {
        p.then(() => video.pause()).catch(() => {});
      }
    };
    window.addEventListener('wheel',      prime, { passive: true, once: true });
    window.addEventListener('touchstart', prime, { passive: true, once: true });
    window.addEventListener('keydown',    prime, { once: true });

    // Smooth fade band around each caption's at/until window.
    const FADE = 0.05;

    // The actual per-frame work — compute scroll progress through the
    // section, drive video.currentTime, fade captions in/out.
    //
    // We call this from three input sources, belt-and-braces, because no
    // single source is reliable in all environments:
    //   1. requestAnimationFrame — works in real browsers, may be throttled
    //      to zero in some headless preview environments.
    //   2. lenis.on('scroll', tick) — fires while Lenis smooth-scrolls.
    //      Lenis suppresses the native window 'scroll' event so this is
    //      the only way to react to wheel-driven scroll without polling.
    //   3. wheel / touchmove on window — fires on direct user input even
    //      if Lenis isn't loaded or rAF is throttled.
    // Each call is idempotent and cheap (one rect read + arithmetic).
    const tick = () => {
      const rect = root.getBoundingClientRect();
      const runway   = rect.height - window.innerHeight;
      const scrolled = -rect.top;
      const progress = Math.max(0, Math.min(1, runway > 0 ? scrolled / runway : 0));

      // Nav morph runs ALWAYS — even when the cinematic is off-screen —
      // so the nav stays solid after the visitor scrolls past, and returns
      // to transparent if they scroll back up to the top.
      setNavSolid(progress >= NAV_SOLID_AT);

      if (!duration) return;
      // Only do the video work while the section is on screen.
      const onScreen = rect.bottom > 0 && rect.top < window.innerHeight;
      if (!onScreen) return;

      // Skip the work if scroll position barely moved frame-over-frame.
      if (Math.abs(progress - lastProgress) <= 0.0005) return;
      lastProgress = progress;

      // Drive the video timeline. Wrapped in try/catch because some
      // browsers throw if currentTime is set before metadata is ready.
      try { video.currentTime = progress * duration; } catch (_) {}

      // Per-caption opacity with linear fade-in / fade-out at edges.
      for (let i = 0; i < captions.length; i++) {
        const c = captions[i];
        const at    = parseFloat(c.dataset.at);
        const until = parseFloat(c.dataset.until);
        let opacity;
        if (progress < at - FADE || progress > until + FADE) {
          opacity = 0;
        } else if (progress < at) {
          opacity = (progress - (at - FADE)) / FADE;
        } else if (progress > until) {
          opacity = 1 - (progress - until) / FADE;
        } else {
          opacity = 1;
        }
        c.style.opacity = opacity;
      }
    };

    // Source 1: continuous rAF loop (primary in real browsers).
    const rafLoop = () => { tick(); requestAnimationFrame(rafLoop); };
    requestAnimationFrame(rafLoop);

    // Source 2: hook into Lenis if it's running. The instance is exposed
    // on window.__lenis by public/scripts/app.js. We poll briefly because
    // Lenis is loaded with `defer` and may not be ready when this runs.
    const hookLenis = () => {
      if (window.__lenis && typeof window.__lenis.on === 'function') {
        window.__lenis.on('scroll', tick);
        return true;
      }
      return false;
    };
    if (!hookLenis()) {
      let attempts = 0;
      const poll = setInterval(() => {
        if (hookLenis() || ++attempts > 40) clearInterval(poll); // ~4s max
      }, 100);
    }

    // Source 3: direct input events — last-resort guarantee that scrubbing
    // responds to user input even if rAF is throttled and Lenis is absent.
    window.addEventListener('wheel',     tick, { passive: true });
    window.addEventListener('touchmove', tick, { passive: true });
    window.addEventListener('scroll',    tick, { passive: true });

    // Reset progress cache on resize so the runway math re-evaluates.
    window.addEventListener('resize', () => { lastProgress = -1; tick(); });
  })();
</script>
