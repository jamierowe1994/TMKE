  }

  /* === Agent === */
  .pa-agent { padding: 80px 32px; background: var(--pa-bg); }
  .pa-agent-inner {
    max-width: 1180px;
    margin: 0 auto;
    background: var(--pa-paper);
    border-radius: 16px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 0;
  }
  @media (max-width: 880px) { .pa-agent-inner { grid-template-columns: 1fr; } }
  .pa-agent-photo { aspect-ratio: 4 / 5; overflow: hidden; }
  .pa-agent-photo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .pa-agent-body { padding: 36px 40px; display: flex; flex-direction: column; justify-content: center; }
  .pa-agent-brand {
    font-size: 11px;
    letter-spacing: 0.24em;
    color: var(--pa-mute);
    margin-bottom: 14px;
  }
  .pa-agent-body h2 {
    font-weight: 600;
    font-size: clamp(28px, 3vw, 38px);
    margin: 0 0 4px;
    letter-spacing: -0.018em;
  }
  .pa-agent-role { font-size: 14px; color: var(--pa-mute); margin: 0 0 14px; }
  .pa-agent-rating { font-size: 14px; margin-bottom: 18px; }
  .pa-agent-rating strong { font-size: 22px; font-weight: 600; }
  .pa-agent-rating span { color: var(--pa-mute); margin-left: 4px; }
  .pa-agent-bio {
    font-size: 14px;
    line-height: 1.7;
    color: var(--pa-mute);
    max-width: 50ch;
    margin: 0 0 22px;
  }
  .pa-agent-actions { display: flex; gap: 18px; align-items: center; flex-wrap: wrap; }
  .pa-agent-link { font-size: 13px; color: var(--pa-ink); }

  /* === Footer === */
  .pa-foot { background: var(--pa-paper); border-top: 1px solid var(--pa-line); padding: 60px 32px 28px; }
  .pa-foot-grid {
    max-width: 1280px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr 1.4fr;
    gap: 36px;
    padding-bottom: 32px;
    border-bottom: 1px solid var(--pa-line);
  }
  @media (max-width: 880px) { .pa-foot-grid { grid-template-columns: 1fr 1fr; } }
  .pa-foot-mark { margin-bottom: 12px; }
  .pa-foot p { font-size: 13px; color: var(--pa-mute); margin: 0; line-height: 1.6; }
  .pa-foot h4 {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pa-mute);
    margin: 0 0 12px;
  }
  .pa-foot ul { list-style: none; padding: 0; margin: 0; }
  .pa-foot ul li {
    font-size: 13px;
    color: var(--pa-ink);
