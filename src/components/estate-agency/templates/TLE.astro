---
// THE LETTING EXPERTS — editorial WHITE rebuild of thelettingexperts.co.uk.
// Real content pulled from the live homepage (copy, listings, team, reviews,
// blog, footer). Brand: white + red #e31f36 + grey, set in Montserrat. Look:
// airy, editorial, framed photography, big display type, pill buttons.
// The .tle-ph blocks stay as image placeholders to swap for TLE's photography.

import { PROPERTIES as ALL_PROPERTIES } from "../../../data/tle-properties.js";

const BRAND = "The Letting Experts";

// Hero assets — plain sky background + the building as a transparent cut-out,
// so the giant wordmark can sit between them (building clips the wording).
const SKY = "https://assets.tmke.co.uk/TLE/sky.png";
const BUILDING = "https://assets.tmke.co.uk/TLE/sky%20(2).png";

// Drifting cloud cut-outs layered into the hero sky.
const CLOUD1 = "https://assets.tmke.co.uk/TLE/cloud.png";
const CLOUD2 = "https://assets.tmke.co.uk/TLE/cloud%202.png";
const CLOUD3 = "https://assets.tmke.co.uk/TLE/full%20image.png";

// Wide editorial image for the "Changing the future" section.
const FUTURE_IMG = "https://images.unsplash.com/photo-1512359953714-f0c9a632ab85?auto=format&fit=crop&w=2400&q=80";

// "Properties We Think You'll Love" — the first four from the shared dataset.
const PROPERTIES = ALL_PROPERTIES.slice(0, 4);

// "A Different Approach to Lettings" — TLE's stated offering (three levels of
// landlord service; flagship Experts Management Service w/ rent guarantee +
// legal protection).
const SERVICES = [
  { n: "01", h: "Experts Management Service", p: "Our flagship fully-managed service — rent guarantee and legal protection built in, so your investment is safeguarded." },
  { n: "02", h: "Rent Collection", p: "We collect, reconcile and pay you on time, with clear statements and all the chasing handled for you." },
  { n: "03", h: "Tenant Find", p: "Marketed properly, referenced thoroughly and moved in smoothly — then the property is back with you." },
  { n: "04", h: "Compliance & Safety", p: "Gas, electrical, EPC and deposit protection kept current so you stay the right side of legislation." },
  { n: "05", h: "Property Management", p: "Local expertise plus market-leading technology, keeping landlords and tenants updated at every step." },
  { n: "06", h: "Advice & Support", p: "A named Letting Expert by your side throughout — keeping you informed and giving you peace of mind." },
];

// "Our Client Testimonials" — real homepage reviews (excerpts).
const TESTIMONIALS = [
  { quote: "Angela let and managed our property in London Bridge — I cannot speak highly enough of her efficiency.", name: "Verified client", role: "Google review" },
  { quote: "Working with Angela was brilliant. She is proactive, responsive and reliable and we really felt looked after.", name: "Verified client", role: "Google review" },
  { quote: "I had an excellent experience with Lou throughout the entire rental process. From start to finish, she was superb.", name: "Verified client", role: "Google review" },
];

// "Letting Experts You Can Trust" — real team, with their real headshots
// (only the agents whose cut-out headshot exists in the TLE folder).
const HEADSHOTS = "https://assets.tmke.co.uk/TLE/TLE%20headshots";
const TEAM = [
  { name: "Lauren Engley",         role: "Bristol",                        photo: `${HEADSHOTS}/Lauren%20Engley.png` },
  { name: "Dan Richards",          role: "Wolverhampton",                  photo: `${HEADSHOTS}/Dan%20Richards.png` },
  { name: "Angela Davey",          role: "Birmingham",                     photo: `${HEADSHOTS}/Angela%20Davey.png` },
  { name: "Graham Cross",          role: "Leicestershire & Warwickshire",  photo: `${HEADSHOTS}/Graham%20Cross.png` },
  { name: "Tony Poon",             role: "Milton Keynes",                  photo: `${HEADSHOTS}/Tony%20Poon%20.png` },
  { name: "Richard Callow",        role: "Oxfordshire",                    photo: `${HEADSHOTS}/Richard%20Callow.png` },
  { name: "Elizabeth Ogunfowokan", role: "Chelmsford & Colchester",        photo: `${HEADSHOTS}/Elizabeth%20Ogunfowokan.png` },
  { name: "James Crumpton",        role: "Bristol",                        photo: `${HEADSHOTS}/James%20Crumpton.png` },
];

// "Latest Articles" — real blog posts.
const ARTVIDEO = "https://assets.tmke.co.uk/TLE/7646533-uhd_3840_2160_25fps.mp4";
const BLOG = [
  { cat: "Landlords", title: "How to Make Your Rental Property Easier to Manage", sub: "Small changes that cut voids, protect your yield and keep great tenants for longer.", date: "4 Jun 2026", read: "6 min read" },
  { cat: "Tenants",   title: "Why Good Tenants Miss Out on Rental Homes & How to Avoid It", sub: "What letting agents really look for — and how to make your application stand out.", date: "21 May 2026", read: "5 min read" },
  { cat: "Landlords", title: "How to Handle the End of a Tenancy Smoothly and Professionally", sub: "From notice to check-out and deposit return, the right way to wrap up a tenancy.", date: "7 May 2026", read: "7 min read" },
];

// Accreditations.
const ACCREDS = ["ARLA Propertymark", "Property Redress Scheme", "Client Money Protection", "Tenancy Deposit Scheme", "ICO Registered"];
---

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" />

<div class="tle-root">

  <!-- ============ Nav ============ -->
  <header class="tle-nav">
    <a href="#" class="tle-logo">The&nbsp;Letting&nbsp;<span>Experts</span></a>
    <nav class="tle-nav-links">
      <a href="/estate-agency/preview/tle-search">Search</a>

      <!-- Landlords — bento mega-menu -->
      <div class="tle-nav-item has-mega">
        <button type="button" class="tle-nav-trigger" aria-haspopup="true" aria-expanded="false">
          Landlords
          <svg class="tle-chev" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" /></svg>
        </button>
        <div class="tle-mega tle-mega--left">
          <div class="tle-mega-grid">
            <a class="tle-bento tle-bento--big" href="#">
              <span class="tle-bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" /><path d="M9 12l2 2 4-4" /></svg></span>
              <span class="tle-bento-tx"><strong>Our Expertise</strong><small>Why thousands of landlords across the UK trust us with their property.</small></span>
            </a>
            <a class="tle-bento" href="#">
              <span class="tle-bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
              <span class="tle-bento-tx"><strong>Our Services</strong><small>Fully managed, rent collection &amp; tenant find.</small></span>
            </a>
            <a class="tle-bento" href="#">
              <span class="tle-bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M7 3h7l5 5v13H7zM14 3v5h5M10 13h6M10 17h6" /></svg></span>
              <span class="tle-bento-tx"><strong>The Renters' Rights Act</strong><small>What the reforms mean for you.</small></span>
            </a>
            <a class="tle-bento tle-bento--bar" href="#">
              <span class="tle-bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.5 8.5 0 0 1-12.2 7.6L3 21l1.9-5.8A8.5 8.5 0 1 1 21 11.5Z" /></svg></span>
              <span class="tle-bento-tx"><strong>Advice &amp; Support</strong><small>A named Letting Expert by your side throughout.</small></span>
            </a>
          </div>
        </div>
      </div>

      <!-- About Us — bento mega-menu -->
      <div class="tle-nav-item has-mega">
        <button type="button" class="tle-nav-trigger" aria-haspopup="true" aria-expanded="false">
          About
          <svg class="tle-chev" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M1 1.5 6 6.5l5-5" /></svg>
        </button>
        <div class="tle-mega tle-mega--right">
          <div class="tle-mega-grid">
            <a class="tle-bento tle-bento--big" href="#">
              <span class="tle-bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M3 21h18M5 21V5l7-2v18M19 21V9l-7-4M9 8h.01M9 12h.01M9 16h.01" /></svg></span>
              <span class="tle-bento-tx"><strong>The Letting Experts</strong><small>Our story, our people and the way we do lettings differently.</small></span>
            </a>
            <a class="tle-bento" href="#">
              <span class="tle-bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z" /><circle cx="12" cy="10" r="2.5" /></svg></span>
              <span class="tle-bento-tx"><strong>Find a Letting Expert</strong><small>Search the expert who looks after your area.</small></span>
            </a>
            <a class="tle-bento" href="#">
              <span class="tle-bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="8" r="4" /><path d="M5.5 21a6.5 6.5 0 0 1 13 0" /></svg></span>
              <span class="tle-bento-tx"><strong>Become a Letting Expert</strong><small>Build your own lettings business with us.</small></span>
            </a>
            <a class="tle-bento tle-bento--bar" href="#">
              <span class="tle-bento-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 5h13v14H5a2 2 0 0 1-2-2V7M17 9h3v8a2 2 0 0 1-2 2M7 8h7M7 12h7M7 16h4" /></svg></span>
              <span class="tle-bento-tx"><strong>News</strong><small>The latest from The Letting Experts.</small></span>
            </a>
          </div>
        </div>
      </div>

    </nav>
    <a href="#book" class="tle-nav-contact">
      <span class="cb-fill" aria-hidden="true"></span>
      <span class="cb-gloss" aria-hidden="true"></span>
      <span class="nc-short">Contact</span>
      <span class="nc-full">Contact&nbsp;us</span>
    </a>
  </header>

  <!-- ============ Hero — outline ring (behind) + building cut-out (middle,
       shifts right on scroll) + words & buttons (front, over the top) ========= -->
  <section class="tle-hero" style={`background-image:url('${SKY}')`}>
    <div class="tle-cloud tle-cloud--l" aria-hidden="true"><img src={CLOUD1} alt="" /></div>
    <div class="tle-cloud tle-cloud--m" aria-hidden="true"><img src={CLOUD3} alt="" /></div>
    <div class="tle-cloud tle-cloud--r" aria-hidden="true"><img src={CLOUD2} alt="" /></div>
    <div class="tle-hero-ring" aria-hidden="true"></div>
    <div class="tle-hero-building-wrap">
      <img class="tle-hero-building" src={BUILDING} alt="A property managed by The Letting Experts" />
    </div>
    <div class="tle-hero-content">
      <div class="tle-hero-cinner">
        <h1 class="tle-hero-word">Giving Landlords<br />Peace of Mind</h1>
        <div class="tle-hero-cta">
          <a href="#book" class="tle-btn tle-btn--red">Contact us Today</a>
          <a href="#properties" class="tle-btn tle-btn--ghost">View Properties &rarr;</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Properties you'll love ============ -->
  <section class="tle-section" id="properties">
    <header class="tle-head tle-reveal">
      <div>
        <h2 class="tle-h">Properties we think you'll love<span class="tle-dot">.</span></h2>
      </div>
      <a href="#" class="tle-link">View all properties &rarr;</a>
    </header>
    <div class="tle-props">
      {PROPERTIES.map((p, i) => (
        <a
          class={`tle-prop tle-reveal${i === 0 ? " tle-prop--feature" : ""}${i === 3 ? " tle-prop--wide" : ""}`}
          href={`/estate-agency/preview/tle-property/${p.slug}`}
          data-prop
          data-img={p.images[0]}
          data-status={p.status}
          data-area={p.area}
          data-pcm={p.pcm}
          data-beds={p.beds}
          data-baths={p.baths}
          data-size={p.size}
          data-type={p.type}
        >
          <img class="tle-prop-media" src={p.images[0]} alt={p.area} loading="lazy" />
          <em class="tle-prop-tag">{p.status}</em>
          <div class="tle-prop-overlay">
            <h3 class="tle-prop-area">{p.area}</h3>
            <div class="tle-prop-details">
              <div class="tle-prop-meta">{p.beds} bed · {p.baths} bath</div>
              <div class="tle-prop-foot"><span class="tle-prop-price">{p.pcm}</span></div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Property preview modal (opened when a card on the homepage is clicked) -->
  <div class="tle-modal" id="tle-modal" hidden>
    <div class="tle-modal-backdrop" data-close></div>
    <div class="tle-modal-card" role="dialog" aria-modal="true" aria-label="Property preview">
      <button type="button" class="tle-modal-x" data-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6 6 18" /></svg>
      </button>
      <div class="tle-modal-frame">
        <div class="tle-modal-hero">
          <img id="tlem-img" src="" alt="" />
          <em class="tle-prop-tag" id="tlem-tag"></em>
          <div class="tle-modal-glass">
            <div class="tle-modal-glass-main">
              <div class="tle-modal-price" id="tlem-price"></div>
              <div class="tle-modal-area" id="tlem-area"></div>
              <div class="tle-modal-stats" id="tlem-stats"></div>
            </div>
            <a class="tle-btn tle-btn--red tle-btn--box" id="tlem-full" href="#">View full page &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ Changing the future + 'A different approach' scrolls over it ====== -->
  <div class="tle-overlap">
  <section class="tle-future tle-future--pin" id="book">
    <div class="tle-future-head tle-reveal">
      <div class="tle-future-label">Why The Letting Experts</div>
      <div class="tle-future-headtx">
        <h2 class="tle-future-h">
          <span class="lead">Changing the future of lettings.</span>{" "}
          <span class="muted">Your trusted partner throughout the journey of letting your property — we prioritise compliance, safety and legislation to safeguard you, and keep you informed every step of the way for real peace of mind.</span>
        </h2>
        <a href="#" class="tle-btn tle-btn--red tle-btn--box">Book an appointment</a>
      </div>
    </div>
    <div class="tle-future-frame tle-reveal tle-reveal--expand">
      <img class="tle-future-pimg" src={FUTURE_IMG} alt="City living with The Letting Experts" loading="lazy" />
    </div>
  </section>

  <!-- ============ Services — a different approach (scrolls over the future) ====== -->
  <section class="tle-section tle-over" id="services">
    <header class="tle-head tle-reveal">
      <div>
        <h2 class="tle-h">A different approach to lettings.</h2>
      </div>
      <p class="tle-head-note">Three levels of landlord service and a comprehensive range of tailored lettings and property-management expertise.</p>
    </header>
    <div class="tle-services">
      {SERVICES.map((s) => (
        <article class="tle-service tle-reveal">
          <span class="tle-service-n">{s.n}</span>
          <h3 class="tle-service-h">{s.h}</h3>
          <p class="tle-service-p">{s.p}</p>
          <a href="#" class="tle-link tle-link--sm">Learn more &rarr;</a>
        </article>
      ))}
    </div>
  </section>
  </div>

  <!-- ============ CTA banner (contained box) ============ -->
  <section class="tle-banner">
    <div class="tle-banner-box tle-reveal">
      <h2 class="tle-banner-h">Thinking of letting? Let's talk this week.</h2>
      <a href="#book" class="tle-btn tle-btn--red">Book your free valuation &rarr;</a>
    </div>
  </section>

  <!-- ============ Testimonials ============ -->
  <section class="tle-section" id="reviews">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( Reviews )</div>
        <h2 class="tle-h">Our client testimonials.</h2>
      </div>
    </header>
    <div class="tle-quotes">
      {TESTIMONIALS.map((t) => (
        <figure class="tle-quote tle-reveal">
          <div class="tle-quote-stars">★★★★★</div>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ============ Meet the team ============ -->
  <section class="tle-section" id="team">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( The team )</div>
        <h2 class="tle-h">Letting Experts you can trust.</h2>
      </div>
      <a href="#" class="tle-link">View all Agents &rarr;</a>
    </header>
    <div class="tle-team-scroller" id="tle-team-scroller">
      <div class="tle-team-track">
        {TEAM.map((m) => (
          <article class="tle-member">
            <div class="tle-member-photo"><img src={m.photo} alt={m.name} loading="lazy" /></div>
            <div class="tle-member-info">
              <h3 class="tle-member-name">{m.name}</h3>
              <div class="tle-member-role">{m.role} Letting Expert</div>
            </div>
          </article>
        ))}
      </div>
    </div>
    <p class="tle-team-hint">Drag to meet the team &middot; hover a face for details</p>
  </section>

  <!-- ============ Latest Articles — edge-to-edge video rotator ============ -->
  <section class="tle-section tle-insights" id="blog">
    <header class="tle-head tle-reveal">
      <div>
        <h2 class="tle-h">Latest Articles<span class="tle-dot">.</span></h2>
      </div>
      <a href="/estate-agency/preview/tle-blog" class="tle-link">View all posts &rarr;</a>
    </header>
    <div class="tle-artfeature tle-reveal">
      <video class="tle-artfeature-video" autoplay muted loop playsinline preload="auto"><source src={ARTVIDEO} type="video/mp4" /></video>
      <div class="tle-artfeature-scrim" aria-hidden="true"></div>
      <div class="tle-artfeature-content">
        <div class="tle-artfeature-main">
          {BLOG.map((b, i) => (
            <a class={`tle-artslide${i === 0 ? " is-active" : ""}`} data-aslide={i} href="/estate-agency/preview/tle-blog">
              <span class="tle-artpill">{b.cat}</span>
              <h3 class="tle-arttitle">{b.title}</h3>
              <p class="tle-artsub">{b.sub}</p>
            </a>
          ))}
          <div class="tle-artdots">
            {BLOG.map((b, i) => (
              <button type="button" class={`tle-artdot${i === 0 ? " is-active" : ""}`} data-adot={i} aria-label={`Article ${i + 1}`}></button>
            ))}
          </div>
        </div>
        <div class="tle-artfeature-meta">
          {BLOG.map((b, i) => (
            <div class={`tle-artmeta${i === 0 ? " is-active" : ""}`} data-aslide={i}>
              <div class="tle-artmeta-date">{b.date}</div>
              <div class="tle-artmeta-read">{b.read}</div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ Accreditations ============ -->
  <section class="tle-accred tle-reveal">
    <div class="tle-accred-label">Regulated &amp; accredited</div>
    <div class="tle-accred-row">
      {ACCREDS.map((a) => (
        <div class="tle-accred-item"><span>{a}</span></div>
      ))}
    </div>
  </section>

  <!-- ============ Footer ============ -->
  <footer class="tle-footer">
    <div class="tle-footer-card">
      <div class="tle-footer-grid">
        <div class="tle-footer-brand">
          <a class="tle-footer-logo" href="#">
            <span class="tle-footer-mark"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M5 19 19 5M9 19l10-10" /></svg></span>
            The Letting Experts
          </a>
          <p>Giving landlords peace of mind — clear, compliant, fully-managed lettings, nationwide.</p>
          <div class="tle-footer-socials">
            <a href="#" aria-label="X"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M18.9 2H22l-7.3 8.3L23 22h-6.8l-5.3-6.9L4.8 22H1.7l7.8-8.9L1 2h6.9l4.8 6.4L18.9 2Zm-2.4 18h1.9L7.6 3.9H5.6L16.5 20Z" /></svg></a>
            <a href="#" aria-label="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg></a>
            <a href="#" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05C20.5 8.65 22 10.6 22 14v7h-4v-6.2c0-1.48-.03-3.38-2.06-3.38-2.06 0-2.38 1.6-2.38 3.27V21H9V9Z" /></svg></a>
            <a href="#" aria-label="Facebook"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12Z" /></svg></a>
          </div>
        </div>
        <div class="tle-footer-cols">
          <div><h4>Lettings</h4><a href="#">Our Services</a><a href="#">Advice &amp; Support</a><a href="#">Our Expertise</a><a href="#">Renters' Rights Act</a></div>
          <div><h4>Resources</h4><a href="/estate-agency/preview/tle-blog">Latest Articles</a><a href="#">Find an Expert</a><a href="#">Become an Expert</a><a href="#">Client Money Protection</a></div>
          <div><h4>Company</h4><a href="#">About Us</a><a href="#">Contact</a><a href="#">Careers</a><a href="#">Partners</a></div>
        </div>
      </div>
      <div class="tle-footer-rule"></div>
      <div class="tle-footer-legal">
        <span>© 2026 The Letting Experts. The Letting Experts (Nationwide) Ltd · Company No. 14702207.</span>
        <div class="tle-footer-legal-links"><a href="/privacy">Privacy Policy</a><a href="#">Terms of Service</a><a href="#">Cookies Settings</a></div>
      </div>
      <div class="tle-footer-watermark" aria-hidden="true">experts</div>
    </div>
  </footer>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');

  .tle-root {
    --red: #e31f36;
    --ink: #16171a;
    --grey: #6e6e76;
    --line: #e7e7ea;
    --surface: #f4f4f5;
    --surface-2: #ededee;
    font-family: "Montserrat", system-ui, sans-serif;
    color: var(--ink);
    background: #fff;
    -webkit-font-smoothing: antialiased;
    line-height: 1.55;
  }
  .tle-root *, .tle-root *::before, .tle-root *::after { box-sizing: border-box; }
  .tle-root a { color: inherit; text-decoration: none; }

  /* ---- Reveal on scroll ---- */
  .tle-reveal { opacity: 0; transform: translateY(26px); transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
  .tle-reveal.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .tle-reveal { opacity: 1; transform: none; transition: none; } }

  /* Expand-from-centre: the first time it scrolls in, the frame opens outwards
     from the middle (once), then sticks. */
  .tle-reveal--expand { opacity: 1; transform: none; clip-path: inset(16% 36% 16% 36%); transition: clip-path 1.2s cubic-bezier(.16, 1, .3, 1); }
  .tle-reveal--expand.is-in { clip-path: inset(0% 0% 0% 0%); }
  @media (prefers-reduced-motion: reduce) { .tle-reveal--expand { clip-path: none; } }

  /* ---- Shared ---- */
  /* Everything flows on white — contrast comes from boxes/cards, not full-width
     background-colour bands. */
  .tle-section { padding: clamp(64px, 8vw, 130px) clamp(20px, 6vw, 110px); }
  .tle-label { font-size: 12px; font-weight: 600; letter-spacing: 0.18em; color: var(--red); margin-bottom: 16px; }
  .tle-eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--red); margin-bottom: 22px; }
  .tle-h {
    font-size: clamp(30px, 4.2vw, 60px); font-weight: 800; line-height: 1.02;
    letter-spacing: -0.02em; margin: 0;
  }
  .tle-h--xl { font-size: clamp(34px, 5vw, 76px); }
  .tle-h em { font-style: italic; font-weight: 500; color: var(--red); }
  .tle-lead { font-size: clamp(16px, 1.3vw, 19px); color: var(--grey); max-width: 52ch; margin: 22px 0 28px; }

  .tle-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-bottom: clamp(36px, 4vw, 64px); }
  .tle-head-note { font-size: 15px; color: var(--grey); max-width: 42ch; margin: 0; }

  .tle-link { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--ink); border-bottom: 2px solid var(--red); padding-bottom: 3px; transition: color .25s; }
  .tle-link:hover { color: var(--red); }
  .tle-link--sm { font-size: 12px; border-bottom-width: 1px; }

  /* ---- Buttons ---- */
  .tle-btn {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    font-family: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.04em;
    padding: 14px 26px; border-radius: 999px; border: 1.5px solid transparent;
    transition: background .25s, color .25s, border-color .25s, transform .25s;
    white-space: nowrap;
  }
  .tle-btn--sm { padding: 9px 18px; font-size: 12px; }
  .tle-btn--red { background: var(--red); color: #fff; }
  .tle-btn--red:hover { background: var(--ink); transform: translateY(-2px); }
  .tle-btn--ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .tle-btn--ghost:hover { border-color: var(--ink); }
  .tle-btn--white { background: #fff; color: var(--red); }
  .tle-btn--white:hover { transform: translateY(-2px); }
  /* Rounded-square (not a pill) — softens the edge without a hard corner. */
  .tle-btn--box { border-radius: 11px; }

  /* ---- Image placeholders (swap for real photography) ---- */
  .tle-ph {
    position: relative; background: var(--surface);
    background-image: repeating-linear-gradient(135deg, transparent 0 18px, rgba(0,0,0,0.012) 18px 19px);
    border: 1px solid var(--line); overflow: hidden; display: flex; align-items: center; justify-content: center;
  }
  .tle-ph > span { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #b6b6bd; font-weight: 600; }
  .tle-ph--hero { height: min(80vh, 720px); width: 100%; border-radius: 6px; }
  .tle-ph--prop { aspect-ratio: 4 / 3; }
  .tle-ph--tall { aspect-ratio: 3 / 4; height: 100%; }
  .tle-ph--portrait { aspect-ratio: 3 / 4; }
  .tle-ph--wide { aspect-ratio: 3 / 2; }

  /* ---- Nav — fixed & see-through so the hero spreads up behind it; white text
     over a soft scrim, then it focuses to solid white once the second section
     reaches the top. ---- */
  .tle-nav {
    --nav-fg: #fff;
    position: fixed; top: 0; left: 0; right: 0; z-index: 30;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 18px clamp(20px, 6vw, 110px);
    background: transparent; border-bottom: 1px solid transparent;
    transition: background .3s ease, border-color .3s ease, box-shadow .3s ease, transform .38s cubic-bezier(.16,1,.3,1);
    /* Drops in last in the entrance sequence; backwards fill so the auto-hide
       transform still works once the animation is done. */
    animation: tleNavDrop .7s cubic-bezier(.16, 1, .3, 1) 1.7s backwards;
  }
  /* Auto-hide: slides up out of view on scroll down, slides back on scroll up. */
  .tle-nav.is-hidden { transform: translateY(-105%); }
  /* Soft top scrim so white nav text reads over both the light sky and the
     dark building as the hero scrolls past. */
  .tle-nav::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, rgba(0,0,0,0.32), rgba(0,0,0,0));
    opacity: 1; transition: opacity .3s ease;
  }
  .tle-nav.is-stuck {
    --nav-fg: var(--ink);
    background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom-color: var(--line); box-shadow: 0 12px 30px -24px rgba(0,0,0,0.45);
  }
  .tle-nav.is-stuck::before { opacity: 0; }

  /* Scoped under .tle-nav so these beat the base `.tle-root a { color: inherit }`. */
  .tle-nav .tle-logo { font-weight: 800; font-size: 17px; letter-spacing: -0.01em; color: var(--nav-fg); transition: color .3s ease; }
  .tle-nav .tle-logo span { color: inherit; }

  .tle-nav-links { display: flex; align-items: center; gap: 28px; }
  .tle-nav .tle-nav-links > a,
  .tle-nav .tle-nav-trigger {
    font-family: inherit; font-size: 14px; font-weight: 500; color: var(--nav-fg);
    background: none; border: 0; padding: 0; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px; transition: color .2s;
  }
  .tle-nav .tle-nav-links > a:hover,
  .tle-nav .tle-nav-trigger:hover { color: var(--red); }
  .tle-chev { width: 11px; height: 8px; transition: transform .28s ease; }
  @media (max-width: 860px) { .tle-nav-links { display: none; } }

  /* Contact — plain text over the hero; once the nav focuses it becomes a
     "liquid glass" pill: brand-red colours swirl inside the glass, a top gloss
     gives the shine, and a blurred copy projects the colour onto the page. */
  .tle-nav .tle-nav-contact {
    position: relative; isolation: isolate;
    display: inline-flex; align-items: center; justify-content: center;
    font-family: inherit; font-size: 14px; font-weight: 600; color: var(--nav-fg);
    padding: 0; border-radius: 999px;
    transition: color .3s ease, padding .35s ease;
  }
  .tle-nav .tle-nav-contact .nc-short,
  .tle-nav .tle-nav-contact .nc-full { position: relative; z-index: 4; white-space: nowrap; }
  .tle-nav-contact .nc-full { display: none; }
  .tle-nav .tle-nav-contact:hover { color: var(--red); }

  .cb-fill, .cb-gloss { position: absolute; border-radius: 999px; pointer-events: none; opacity: 0; transition: opacity .45s ease; }
  /* A whisper of swirling brand-red over the dark pill — kept very faint. */
  .cb-fill { inset: 0; overflow: hidden; z-index: 1; }
  .cb-fill::before {
    content: ""; position: absolute; inset: -110%;
    background: conic-gradient(from 0deg, #e31f36, #b3122f, #e31f36, #8e0f25, #d11a3a, #e31f36);
    filter: blur(8px); opacity: 0.16; animation: cbSwirl 11s linear infinite;
  }
  .cb-gloss { z-index: 3; top: 2px; left: 12%; right: 12%; height: 46%; background: linear-gradient(to bottom, rgba(255,255,255,0.5), rgba(255,255,255,0.03)); }
  /* Subtle glass edge, only when the pill is shown. */
  .tle-nav-contact::after {
    content: ""; position: absolute; inset: 0; border-radius: 999px; z-index: 2; pointer-events: none; opacity: 0;
    box-shadow: inset 0 1.5px 1px rgba(255,255,255,0.4), inset 0 -2px 6px rgba(0,0,0,0.35), inset 0 0 0 1px rgba(255,255,255,0.12);
    transition: opacity .45s ease;
  }
  @keyframes cbSwirl { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .cb-fill::before { animation: none; } }

  .tle-nav.is-stuck .tle-nav-contact {
    color: #fff; padding: 12px 26px; font-weight: 700;
    background: var(--ink);
    /* Small drop shadow at the foot — stays within the nav. */
    box-shadow: 0 5px 12px -6px rgba(0,0,0,0.5);
  }
  .tle-nav.is-stuck .tle-nav-contact .cb-fill,
  .tle-nav.is-stuck .tle-nav-contact .cb-gloss,
  .tle-nav.is-stuck .tle-nav-contact::after { opacity: 1; }
  .tle-nav.is-stuck .tle-nav-contact .nc-short { display: none; }
  .tle-nav.is-stuck .tle-nav-contact .nc-full { display: inline; }

  /* ---- Bento mega-menu — bubbles out from under the link on hover ---- */
  .tle-nav-item { position: relative; }
  .tle-nav-item.has-mega:hover .tle-chev,
  .tle-nav-item.has-mega:focus-within .tle-chev { transform: rotate(180deg); }

  .tle-mega {
    position: absolute; top: 100%; padding-top: 16px;
    width: min(560px, 82vw);
    opacity: 0; visibility: hidden; pointer-events: none; z-index: 40;
    /* Grow outwards with an overshoot — not a flat pop. */
    transition: opacity .24s ease, transform .46s cubic-bezier(.34, 1.56, .5, 1), visibility .24s;
  }
  .tle-mega--left  { left: 0;  transform-origin: top left;  transform: translateY(16px) scale(.8); }
  .tle-mega--right { right: 0; transform-origin: top right; transform: translateY(16px) scale(.8); }
  .has-mega:hover .tle-mega, .has-mega:focus-within .tle-mega {
    opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0) scale(1);
  }

  /* Railway-style layout: a big card on the left spanning both rows, two stacked
     cards on the right, and one long thin bar across the bottom. */
  .tle-mega-grid {
    display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr auto; gap: 12px;
    background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 12px;
    box-shadow: 0 44px 80px -42px rgba(0,0,0,0.5), 0 8px 24px -16px rgba(0,0,0,0.28);
  }

  .tle-bento {
    display: flex; gap: 13px; align-items: flex-start;
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
    padding: 16px; transition: background .2s, border-color .2s, transform .2s;
  }
  .tle-bento--big { grid-column: 1; grid-row: 1 / 3; }
  .tle-bento--bar { grid-column: 1 / 3; align-items: center; }
  .tle-bento--bar .tle-bento-tx { gap: 1px; }
  .tle-bento:hover { background: #fff; border-color: var(--red); transform: translateY(-2px); }
  .tle-bento-ico {
    flex: none; width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center;
    background: #fff; border: 1px solid var(--line); color: var(--red);
    transition: background .2s, color .2s, border-color .2s;
  }
  .tle-bento:hover .tle-bento-ico { background: var(--red); color: #fff; border-color: var(--red); }
  .tle-bento-ico svg { width: 20px; height: 20px; }
  .tle-bento-tx { display: flex; flex-direction: column; gap: 3px; }
  .tle-bento-tx strong { font-size: 14px; font-weight: 700; color: var(--ink); letter-spacing: -0.01em; }
  .tle-bento-tx small { font-size: 12px; color: var(--grey); line-height: 1.4; }
  .tle-bento--big .tle-bento-tx { gap: 6px; }
  .tle-bento--big .tle-bento-tx strong { font-size: 16px; }

  /* ---- Hero — layered: a transparent outline ring on the left (behind), the
     building cut-out in the middle (shifts right on scroll), and the words +
     buttons in front, coming over the top. Bright white theme. ---- */
  .tle-hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background-size: cover; background-position: center bottom; background-repeat: no-repeat;
    border-bottom-left-radius: calc(var(--p, 0) * 40px);
    border-bottom-right-radius: calc(var(--p, 0) * 40px);
  }
  /* Ring + content share the same left anchor + size so the words sit inside the
     outline box; the building (z-2) slots between them. */
  .tle-hero-ring,
  .tle-hero-content {
    position: absolute; left: clamp(20px, 6vw, 96px);
    top: 50%;
    /* Drift the whole box (outline + words + buttons) down as you scroll, so it
       lingers toward the bottom of the hero. */
    transform: translateY(calc(-50% + var(--p, 0) * 44vh));
    width: min(54vw, 620px); height: min(60vh, 500px);
    will-change: transform;
  }
  .tle-hero-ring {
    z-index: 1;
    border: 2.8px solid rgba(255, 255, 255, 0.7);
    border-radius: 32px;
  }
  .tle-hero-content { z-index: 3; overflow: hidden; pointer-events: none; }
  .tle-hero-cinner {
    height: 100%; display: flex; flex-direction: column; justify-content: center; gap: clamp(22px, 3.6vh, 40px);
    padding: 0 clamp(30px, 3vw, 56px);
    /* Words + buttons rise out of the box's bottom line and fade in. */
    animation: tleContentRise .9s cubic-bezier(.16, 1, .3, 1) 1.05s both;
  }
  .tle-hero-cinner > * { pointer-events: auto; }
  .tle-hero-word {
    margin: 0; font-weight: 800;
    font-size: clamp(32px, 4.4vw, 60px); line-height: 1.02; letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.96); text-shadow: 0 2px 30px rgba(20, 22, 34, 0.22);
  }
  /* Building cut-out — transparent PNG; sits over its own sky bg and shifts to
     the right as you scroll, clearing the words while still clipping the ring. */
  /* Building cut-out — entrance (rise up) lives on the wrapper; the scroll shift
     + tilt live on the image, so they never fight. */
  .tle-hero-building-wrap {
    position: absolute; z-index: 2; inset: 0;
    animation: tleRiseUp 1s cubic-bezier(.16, 1, .3, 1) .1s both;
  }
  .tle-hero-building {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center bottom;
    /* translateY + small scale close the gap the -1deg tilt opens at the
       bottom/edges, so the building always meets the foot of the hero. */
    transform: translateX(calc(9% + var(--p, 0) * 15%)) translateY(18px) rotate(-1deg) scale(1.02);
    will-change: transform;
    pointer-events: none; user-select: none;
  }

  /* Clouds — lazy 60s+ drift on the inner image; the wrapper handles the
     entrance (slide in from L/R). They sit behind the building (z-1 < z-2). */
  .tle-cloud { position: absolute; z-index: 1; pointer-events: none; user-select: none; }
  .tle-cloud img { display: block; width: 100%; will-change: transform; }
  .tle-cloud--l { left: -10%; top: 14%; width: clamp(300px, 42vw, 820px); animation: tleCloudInL 1.2s cubic-bezier(.16, 1, .3, 1) .5s both; }
  .tle-cloud--m { right: 18%; top: -2%; width: clamp(150px, 19vw, 360px); animation: tleCloudInL 1.2s cubic-bezier(.16, 1, .3, 1) .6s both; }
  .tle-cloud--r { right: -10%; top: 16%; width: clamp(460px, 60vw, 1080px); animation: tleCloudInR 1.2s cubic-bezier(.16, 1, .3, 1) .5s both; }
  .tle-cloud--l img { animation: tleCloudL 58s ease-in-out infinite alternate; }
  .tle-cloud--r img { animation: tleCloudR 70s ease-in-out infinite alternate; }
  .tle-cloud--m img { animation: tleCloudM 64s ease-in-out infinite alternate; opacity: 0.92; }
  @keyframes tleCloudL { from { transform: translate(-4%, 2%); } to { transform: translate(30%, -10%); } }
  @keyframes tleCloudR { from { transform: translate(6%, 0); } to { transform: translate(-26%, 9%); } }
  @keyframes tleCloudM { from { transform: translate(8%, 0); } to { transform: translate(-16%, 5%); } }

  /* ---- Entrance sequence: building rises, clouds slide in, words rise out of
     the box, nav drops in (timed via animation-delay). ---- */
  @keyframes tleRiseUp { from { transform: translateY(104%); } to { transform: translateY(0); } }
  @keyframes tleCloudInL { from { transform: translateX(-72vw); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  @keyframes tleCloudInR { from { transform: translateX(72vw); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  @keyframes tleContentRise { from { transform: translateY(74%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  @keyframes tleNavDrop { from { transform: translateY(-100%); } to { transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) {
    .tle-cloud, .tle-cloud img, .tle-hero-building-wrap, .tle-hero-cinner, .tle-nav { animation: none !important; }
  }
  .tle-hero-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .tle-hero-cta .tle-btn { min-width: 216px; justify-content: center; }
  .tle-hero-cta .tle-btn--ghost { color: #fff; border-color: rgba(255, 255, 255, 0.65); }
  .tle-hero-cta .tle-btn--ghost:hover { background: #fff; color: var(--ink); border-color: #fff; }

  @media (max-width: 820px) {
    .tle-hero-ring, .tle-hero-content { left: 50%; transform: translate(-50%, -50%); width: min(90vw, 520px); height: auto; }
    .tle-hero-content { padding: 40px clamp(22px, 6vw, 40px); }
    .tle-hero-ring { min-height: 60vh; }
    .tle-hero-building { transform: translateX(calc(4% + var(--p, 0) * 10%)); opacity: 0.92; }
  }

  /* ---- Properties — bento: one big feature (with an ambient video) + smaller
     cards dotted around it. All cards are full-bleed media with the detail
     overlaid at the bottom. ---- */
  /* Wide but brought in a touch; square corners; the header matches the width. */
  #properties { padding-left: clamp(26px, 2.8vw, 48px); padding-right: clamp(26px, 2.8vw, 48px); }
  .tle-props {
    display: grid; grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: clamp(200px, 16.5vw, 290px);
    gap: clamp(12px, 1.1vw, 18px);
  }
  .tle-prop {
    position: relative; border-radius: 0; overflow: hidden;
    border: 1px solid var(--line); background: var(--surface);
    transition: box-shadow .3s, transform .3s;
  }
  .tle-prop:hover { box-shadow: 0 34px 64px -38px rgba(0,0,0,0.4); }
  .tle-prop--feature { grid-column: span 2; grid-row: span 2; }
  .tle-prop--wide { grid-column: span 2; }
  @media (max-width: 1100px) {
    .tle-props { grid-template-columns: repeat(2, 1fr); }
    .tle-prop--feature { grid-column: span 2; grid-row: span 2; }
    .tle-prop--wide { grid-column: span 2; }
  }
  @media (max-width: 560px) {
    .tle-props { grid-template-columns: 1fr; grid-auto-rows: 210px; }
    .tle-prop--feature, .tle-prop--wide { grid-column: span 1; grid-row: span 1; }
    .tle-prop--feature { grid-row: span 2; }
  }

  .tle-prop-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .tle-prop:hover .tle-prop-media { transform: scale(1.05); }
  .tle-prop-media.tle-ph { border: 0; border-radius: 0; }

  .tle-prop-tag { position: absolute; z-index: 3; top: 14px; left: 14px; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; background: rgba(255,255,255,0.92); color: var(--red); padding: 5px 11px; border-radius: 999px; font-style: normal; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  /* By default only the (big) name shows; on hover it lifts and the details
     reveal below over a frosted-glass strip for legibility. */
  .tle-prop-overlay {
    position: absolute; z-index: 2; inset: auto 0 0 0; padding: clamp(16px, 1.3vw, 26px); color: #fff;
    background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.06) 56%, transparent 78%);
    transition: backdrop-filter .35s ease, background .35s ease;
  }
  .tle-prop:hover .tle-prop-overlay { background: linear-gradient(to top, rgba(0,0,0,0.55) 0%, rgba(0,0,0,0.3) 60%, rgba(0,0,0,0.08) 100%); backdrop-filter: blur(7px); -webkit-backdrop-filter: blur(7px); }
  .tle-prop-area { font-size: clamp(18px, 2.1vw, 28px); font-weight: 800; margin: 0; line-height: 1.12; letter-spacing: -0.01em; color: #fff; max-width: 64%; text-shadow: 0 2px 16px rgba(0,0,0,0.55); transition: transform .35s cubic-bezier(.16,1,.3,1); }
  .tle-prop-details { max-height: 0; opacity: 0; overflow: hidden; transform: translateY(8px); transition: max-height .38s ease, opacity .32s ease, transform .38s ease, margin-top .38s ease; margin-top: 0; }
  .tle-prop:hover .tle-prop-details { max-height: 70px; opacity: 1; transform: none; margin-top: 12px; }
  .tle-prop-meta { font-size: 12.5px; color: rgba(255,255,255,0.85); margin-bottom: 10px; }
  .tle-prop-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .tle-prop-price { font-size: 17px; font-weight: 800; color: #fff; }
  .tle-prop--feature .tle-prop-area { font-size: clamp(26px, 3vw, 46px); max-width: 62%; }
  .tle-prop--feature .tle-prop-meta { font-size: 14px; }
  .tle-prop--feature .tle-prop-price { font-size: clamp(18px, 1.6vw, 23px); }
  .tle-prop--feature:hover .tle-prop-details { max-height: 90px; }

  /* Red full stop on section headings. */
  .tle-dot { color: var(--red); }

  /* ---- Property preview modal (homepage cards) ---- */
  .tle-modal { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 20px; }
  .tle-modal[hidden] { display: none; }
  .tle-modal-backdrop { position: absolute; inset: 0; background: rgba(12,12,16,0.55); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); opacity: 0; transition: opacity .3s ease; }
  .tle-modal.is-open .tle-modal-backdrop { opacity: 1; }
  .tle-modal-card {
