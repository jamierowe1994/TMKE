---
// THE LETTINGS EXPERT (TLE) — editorial WHITE rebuild of thelettingexperts.co.uk.
// Reference look: airy, editorial, framed photography, big display type, section
// labels in parentheses, pill buttons — but light (white) instead of dark, in the
// brand red #e31f36 + grey, set in Montserrat.
//
// WIREFRAME: copy is representative placeholder (drop in TLE's real copy) and the
// .tle-ph blocks are image placeholders (swap for TLE's stock photography). The
// layout, type system, palette and motion are the finished part.

// Property showcase — "Properties you'll love".
const PROPERTIES = [
  { area: "Clarendon Road, Leamington Spa", beds: 2, baths: 1, pcm: "£1,250 pcm", tag: "Available now" },
  { area: "Park Crescent, Warwick",          beds: 3, baths: 2, pcm: "£1,650 pcm", tag: "New" },
  { area: "Regent Street, Royal Spa",        beds: 1, baths: 1, pcm: "£895 pcm",   tag: "Let agreed" },
  { area: "Mill Gardens, Kenilworth",        beds: 4, baths: 2, pcm: "£2,200 pcm", tag: "Available now" },
];

// "A different approach to lettings" — services.
const SERVICES = [
  { n: "01", h: "Fully Managed", p: "End-to-end management — tenants found, rent collected, maintenance handled, you stay hands-off." },
  { n: "02", h: "Rent Collection", p: "We chase, reconcile and pay you on time, every time, with clear monthly statements." },
  { n: "03", h: "Tenant Find", p: "Marketed properly, referenced thoroughly, moved in smoothly — then it's over to you." },
  { n: "04", h: "Compliance & Safety", p: "Gas, electrical, EPC and deposit protection kept current so you're never exposed." },
  { n: "05", h: "Maintenance", p: "A vetted network of local trades, dispatched fast, billed transparently." },
  { n: "06", h: "Landlord Advice", p: "Honest guidance on yield, regulation and the local market from people who live it." },
];

// Client testimonials.
const TESTIMONIALS = [
  { quote: "They turned a stressful let into something I genuinely didn't have to think about. First agent I've actually trusted.", name: "Sarah M.", role: "Landlord, 6 properties" },
  { quote: "Communication is the difference. I always know exactly where things stand — and the rent is always on time.", name: "David R.", role: "Accidental landlord" },
  { quote: "Professional, proactive and refreshingly straight-talking. Worth every penny of the fee.", name: "Priya N.", role: "Portfolio landlord" },
];

// "Lettings experts you can trust" — meet the team.
const TEAM = [
  { name: "Name Surname", role: "Director" },
  { name: "Name Surname", role: "Lettings Manager" },
  { name: "Name Surname", role: "Property Manager" },
  { name: "Name Surname", role: "Maintenance Lead" },
];

// Blog / insights.
const BLOG = [
  { cat: "Landlords", title: "The 2026 rules every landlord needs on their radar", date: "12 Jun 2026" },
  { cat: "Renting", title: "What a good reference actually looks like", date: "04 Jun 2026" },
  { cat: "Market", title: "Where rents are heading across the Midlands", date: "28 May 2026" },
];

// Accreditations.
const ACCREDS = ["ARLA Propertymark", "Property Redress Scheme", "Client Money Protect", "Deposit Protection", "Trading Standards"];
---

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" />

<div class="tle-root">

  <!-- ============ Nav ============ -->
  <header class="tle-nav">
    <a href="#" class="tle-logo">The&nbsp;Lettings&nbsp;<span>Expert</span></a>
    <nav class="tle-nav-links">
      <a href="#properties">Properties</a>
      <a href="#services">Services</a>
      <a href="#team">About</a>
      <a href="#blog">Insights</a>
    </nav>
    <a href="#book" class="tle-btn tle-btn--red">Book a valuation</a>
  </header>

  <!-- ============ Hero ============ -->
  <section class="tle-hero">
    <div class="tle-hero-text tle-reveal">
      <div class="tle-eyebrow">(&nbsp;Lettings done properly&nbsp;)</div>
      <h1 class="tle-hero-h">
        The home of <em>better</em><br />lettings.
      </h1>
      <p class="tle-hero-sub">
        A different kind of lettings agency — straight-talking, properly proactive,
        and on your side. Whether you're letting your first property or your fiftieth,
        we make it feel effortless.
      </p>
      <div class="tle-hero-cta">
        <a href="#book" class="tle-btn tle-btn--red">Book an appointment</a>
        <a href="#properties" class="tle-btn tle-btn--ghost">Browse properties &rarr;</a>
      </div>
      <form class="tle-search" onsubmit="return false">
        <input type="text" placeholder="Search by area or postcode" aria-label="Search area" />
        <select aria-label="Bedrooms"><option>Any beds</option><option>1+</option><option>2+</option><option>3+</option><option>4+</option></select>
        <button type="submit" class="tle-btn tle-btn--red">Search</button>
      </form>
    </div>
    <div class="tle-hero-media tle-reveal">
      <div class="tle-ph tle-ph--hero"><span>Hero photography</span></div>
      <div class="tle-hero-badge">
        <strong>4.9</strong>
        <span>★★★★★<br />Google reviews</span>
      </div>
    </div>
  </section>

  <!-- ============ Properties you'll love ============ -->
  <section class="tle-section" id="properties">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( Properties )</div>
        <h2 class="tle-h">Properties you'll love.</h2>
      </div>
      <a href="#" class="tle-link">View all properties &rarr;</a>
    </header>
    <div class="tle-props">
      {PROPERTIES.map((p) => (
        <article class="tle-prop tle-reveal">
          <div class="tle-ph tle-ph--prop">
            <span>Property image</span>
            <em class="tle-prop-tag">{p.tag}</em>
          </div>
          <div class="tle-prop-body">
            <h3 class="tle-prop-area">{p.area}</h3>
            <div class="tle-prop-meta">{p.beds} bed · {p.baths} bath</div>
            <div class="tle-prop-foot">
              <span class="tle-prop-price">{p.pcm}</span>
              <a href="#" class="tle-btn tle-btn--red tle-btn--sm">Rent</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ Changing the future of lettings ============ -->
  <section class="tle-future" id="book">
    <div class="tle-future-media tle-reveal">
      <div class="tle-ph tle-ph--tall"><span>Lifestyle photography</span></div>
    </div>
    <div class="tle-future-text tle-reveal">
      <div class="tle-label">( A different approach )</div>
      <h2 class="tle-h tle-h--xl">Changing the future of lettings in the UK.</h2>
      <p class="tle-lead">
        Lettings shouldn't feel like a chore you endure. We've rebuilt the whole
        experience around clarity, speed and people who actually pick up the phone —
        so renting out your property finally feels like a good decision.
      </p>
      <ul class="tle-ticks">
        <li>Transparent fees, no surprises</li>
        <li>A single named contact who knows your property</li>
        <li>Rent paid on time, every time</li>
      </ul>
      <a href="#" class="tle-btn tle-btn--red">Book an appointment</a>
    </div>
  </section>

  <!-- ============ Services — a different approach ============ -->
  <section class="tle-section" id="services">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( Services )</div>
        <h2 class="tle-h">A different approach to lettings.</h2>
      </div>
      <p class="tle-head-note">Pick the level of support that suits you — from a simple tenant find to fully hands-off management.</p>
    </header>
    <div class="tle-services">
      {SERVICES.map((s) => (
        <article class="tle-service tle-reveal">
          <span class="tle-service-n">{s.n}</span>
          <h3 class="tle-service-h">{s.h}</h3>
          <p class="tle-service-p">{s.p}</p>
          <a href="#" class="tle-link tle-link--sm">Learn more &rarr;</a>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ Red banner ============ -->
  <section class="tle-banner tle-reveal">
    <h2 class="tle-banner-h">Thinking of letting? Let's talk this week.</h2>
    <a href="#book" class="tle-btn tle-btn--white">Book your free valuation &rarr;</a>
  </section>

  <!-- ============ Testimonials ============ -->
  <section class="tle-section" id="reviews">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( Reviews )</div>
        <h2 class="tle-h">What our landlords say.</h2>
      </div>
    </header>
    <div class="tle-quotes">
      {TESTIMONIALS.map((t) => (
        <figure class="tle-quote tle-reveal">
          <div class="tle-quote-stars">★★★★★</div>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ============ Meet the team ============ -->
  <section class="tle-section tle-section--grey" id="team">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( The team )</div>
        <h2 class="tle-h">Lettings experts you can trust.</h2>
      </div>
      <p class="tle-head-note">Real people who live and work where you let — and answer the phone when you call.</p>
    </header>
    <div class="tle-team">
      {TEAM.map((m) => (
        <article class="tle-member tle-reveal">
          <div class="tle-ph tle-ph--portrait"><span>Team photo</span></div>
          <h3 class="tle-member-name">{m.name}</h3>
          <div class="tle-member-role">{m.role}</div>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ Blog ============ -->
  <section class="tle-section" id="blog">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( Insights )</div>
        <h2 class="tle-h">From the blog.</h2>
      </div>
      <a href="#" class="tle-link">All articles &rarr;</a>
    </header>
    <div class="tle-blog">
      {BLOG.map((b) => (
        <article class="tle-post tle-reveal">
          <div class="tle-ph tle-ph--wide"><span>Article image</span></div>
          <div class="tle-post-cat">{b.cat}</div>
          <h3 class="tle-post-h">{b.title}</h3>
          <div class="tle-post-date">{b.date}</div>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ Accreditations ============ -->
  <section class="tle-accred tle-reveal">
    <div class="tle-accred-label">Regulated &amp; accredited</div>
    <div class="tle-accred-row">
      {ACCREDS.map((a) => (
        <div class="tle-accred-item"><span>{a}</span></div>
      ))}
    </div>
  </section>

  <!-- ============ Footer ============ -->
  <footer class="tle-footer">
    <div class="tle-footer-top">
      <div class="tle-footer-brand">
        <div class="tle-logo tle-logo--light">The&nbsp;Lettings&nbsp;<span>Expert</span></div>
        <p>Lettings done properly. Straight-talking, proactive and on your side.</p>
        <a href="#book" class="tle-btn tle-btn--red">Book a valuation</a>
      </div>
      <div class="tle-footer-cols">
        <div><h4>Lettings</h4><a href="#">Find a property</a><a href="#">Fully managed</a><a href="#">Tenant find</a><a href="#">Rent collection</a></div>
        <div><h4>Company</h4><a href="#">About us</a><a href="#">The team</a><a href="#">Insights</a><a href="#">Careers</a></div>
        <div><h4>Contact</h4><a href="#">01926 000 000</a><a href="#">hello@thelettingexperts.co.uk</a><a href="#">Leamington Spa</a></div>
      </div>
    </div>
    <div class="tle-footer-bottom">
      <span>© The Lettings Expert. All rights reserved.</span>
      <span class="tle-footer-tmke">Concept redesign by TMKE</span>
    </div>
  </footer>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');

  .tle-root {
    --red: #e31f36;
    --ink: #16171a;
    --grey: #6e6e76;
    --line: #e7e7ea;
    --surface: #f4f4f5;
    --surface-2: #ededee;
    font-family: "Montserrat", system-ui, sans-serif;
    color: var(--ink);
    background: #fff;
    -webkit-font-smoothing: antialiased;
    line-height: 1.55;
  }
  .tle-root *, .tle-root *::before, .tle-root *::after { box-sizing: border-box; }
  .tle-root a { color: inherit; text-decoration: none; }

  /* ---- Reveal on scroll ---- */
  .tle-reveal { opacity: 0; transform: translateY(26px); transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
  .tle-reveal.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .tle-reveal { opacity: 1; transform: none; transition: none; } }

  /* ---- Shared ---- */
  .tle-section { padding: clamp(64px, 8vw, 130px) clamp(20px, 6vw, 110px); }
  .tle-section--grey { background: var(--surface); }
  .tle-label { font-size: 12px; font-weight: 600; letter-spacing: 0.18em; color: var(--red); margin-bottom: 16px; }
  .tle-eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--red); margin-bottom: 22px; }
  .tle-h {
    font-size: clamp(30px, 4.2vw, 60px); font-weight: 800; line-height: 1.02;
    letter-spacing: -0.02em; margin: 0;
  }
  .tle-h--xl { font-size: clamp(34px, 5vw, 76px); }
  .tle-h em { font-style: italic; font-weight: 500; color: var(--red); }
  .tle-lead { font-size: clamp(16px, 1.3vw, 19px); color: var(--grey); max-width: 52ch; margin: 22px 0 28px; }

  .tle-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-bottom: clamp(36px, 4vw, 64px); }
  .tle-head-note { font-size: 15px; color: var(--grey); max-width: 42ch; margin: 0; }

  .tle-link { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--ink); border-bottom: 2px solid var(--red); padding-bottom: 3px; transition: color .25s; }
  .tle-link:hover { color: var(--red); }
  .tle-link--sm { font-size: 12px; border-bottom-width: 1px; }

  /* ---- Buttons ---- */
  .tle-btn {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    font-family: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.04em;
    padding: 14px 26px; border-radius: 999px; border: 1.5px solid transparent;
    transition: background .25s, color .25s, border-color .25s, transform .25s;
    white-space: nowrap;
  }
  .tle-btn--sm { padding: 9px 18px; font-size: 12px; }
  .tle-btn--red { background: var(--red); color: #fff; }
  .tle-btn--red:hover { background: var(--ink); transform: translateY(-2px); }
  .tle-btn--ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .tle-btn--ghost:hover { border-color: var(--ink); }
  .tle-btn--white { background: #fff; color: var(--red); }
  .tle-btn--white:hover { transform: translateY(-2px); }

  /* ---- Image placeholders (swap for real photography) ---- */
  .tle-ph {
    position: relative; background: var(--surface);
    background-image: repeating-linear-gradient(135deg, transparent 0 18px, rgba(0,0,0,0.012) 18px 19px);
    border: 1px solid var(--line); overflow: hidden; display: flex; align-items: center; justify-content: center;
  }
  .tle-ph > span { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #b6b6bd; font-weight: 600; }
  .tle-ph--hero { aspect-ratio: 4 / 5; width: 100%; border-radius: 4px; }
  .tle-ph--prop { aspect-ratio: 4 / 3; }
  .tle-ph--tall { aspect-ratio: 3 / 4; height: 100%; }
  .tle-ph--portrait { aspect-ratio: 3 / 4; }
  .tle-ph--wide { aspect-ratio: 3 / 2; }

  /* ---- Nav ---- */
  .tle-nav {
    position: sticky; top: 0; z-index: 30;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 18px clamp(20px, 6vw, 110px);
    background: rgba(255,255,255,0.86); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .tle-logo { font-weight: 800; font-size: 17px; letter-spacing: -0.01em; }
  .tle-logo span { color: var(--red); }
  .tle-nav-links { display: flex; gap: 28px; }
  .tle-nav-links a { font-size: 14px; font-weight: 500; color: var(--ink); transition: color .2s; }
  .tle-nav-links a:hover { color: var(--red); }
  @media (max-width: 860px) { .tle-nav-links { display: none; } }

  /* ---- Hero ---- */
  .tle-hero {
    display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 5vw, 80px);
    align-items: center; padding: clamp(48px, 7vw, 110px) clamp(20px, 6vw, 110px) clamp(56px, 7vw, 120px);
  }
  .tle-hero-h { font-size: clamp(44px, 7vw, 104px); font-weight: 800; line-height: 0.98; letter-spacing: -0.03em; margin: 0; }
  .tle-hero-h em { font-style: italic; font-weight: 500; color: var(--red); }
  .tle-hero-sub { font-size: clamp(16px, 1.35vw, 19px); color: var(--grey); max-width: 46ch; margin: 26px 0 30px; }
  .tle-hero-cta { display: flex; gap: 14px; flex-wrap: wrap; margin-bottom: 30px; }
  .tle-search {
    display: flex; gap: 8px; flex-wrap: wrap; padding: 10px; background: #fff;
    border: 1px solid var(--line); border-radius: 999px; max-width: 560px; box-shadow: 0 18px 50px -30px rgba(0,0,0,0.25);
  }
  .tle-search input, .tle-search select {
    font-family: inherit; font-size: 14px; border: none; background: transparent; padding: 8px 14px; color: var(--ink); outline: none;
  }
  .tle-search input { flex: 1 1 180px; min-width: 0; }
  .tle-search select { border-left: 1px solid var(--line); }
  .tle-hero-media { position: relative; }
  .tle-hero-badge {
    position: absolute; left: -22px; bottom: 28px; background: #fff; border: 1px solid var(--line);
    border-radius: 14px; padding: 14px 18px; display: flex; align-items: center; gap: 12px;
    box-shadow: 0 24px 60px -28px rgba(0,0,0,0.35);
  }
  .tle-hero-badge strong { font-size: 30px; font-weight: 800; color: var(--red); line-height: 1; }
  .tle-hero-badge span { font-size: 11px; color: var(--grey); line-height: 1.3; letter-spacing: 0.02em; }
  @media (max-width: 820px) { .tle-hero { grid-template-columns: 1fr; } .tle-hero-badge { left: 16px; } }

  /* ---- Properties ---- */
  .tle-props { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(18px, 1.6vw, 28px); }
  @media (max-width: 1100px) { .tle-props { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .tle-props { grid-template-columns: 1fr; } }
  .tle-prop { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #fff; transition: transform .3s, box-shadow .3s; }
  .tle-prop:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -34px rgba(0,0,0,0.3); }
  .tle-prop-tag { position: absolute; top: 12px; left: 12px; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; background: var(--red); color: #fff; padding: 5px 10px; border-radius: 999px; font-style: normal; }
  .tle-prop-body { padding: 18px 18px 20px; }
  .tle-prop-area { font-size: 15px; font-weight: 700; margin: 0 0 4px; line-height: 1.25; }
  .tle-prop-meta { font-size: 13px; color: var(--grey); margin-bottom: 16px; }
  .tle-prop-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .tle-prop-price { font-size: 16px; font-weight: 800; }

  /* ---- Future / book ---- */
  .tle-future { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px, 5vw, 80px); align-items: center; padding: clamp(64px, 8vw, 130px) clamp(20px, 6vw, 110px); background: var(--ink); color: #fff; }
  .tle-future .tle-label { color: #ff5566; }
  .tle-future .tle-h { color: #fff; }
  .tle-future .tle-lead { color: rgba(255,255,255,0.66); }
  .tle-future-media .tle-ph { background: #23242a; border-color: rgba(255,255,255,0.1); }
  .tle-future-media .tle-ph > span { color: rgba(255,255,255,0.4); }
  .tle-ticks { list-style: none; padding: 0; margin: 0 0 30px; display: flex; flex-direction: column; gap: 12px; }
  .tle-ticks li { position: relative; padding-left: 28px; font-size: 15px; color: rgba(255,255,255,0.85); }
  .tle-ticks li::before { content: "✓"; position: absolute; left: 0; top: -1px; color: var(--red); font-weight: 800; }
  @media (max-width: 820px) { .tle-future { grid-template-columns: 1fr; } .tle-future-media { order: 2; } }

  /* ---- Services ---- */
  .tle-services { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  @media (max-width: 900px) { .tle-services { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .tle-services { grid-template-columns: 1fr; } }
  .tle-service { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: clamp(28px, 2.4vw, 40px); transition: background .3s; }
  .tle-service:hover { background: var(--surface); }
  .tle-service-n { font-size: 13px; font-weight: 800; color: var(--red); letter-spacing: 0.1em; }
  .tle-service-h { font-size: clamp(19px, 1.7vw, 24px); font-weight: 700; margin: 14px 0 10px; }
  .tle-service-p { font-size: 14.5px; color: var(--grey); margin: 0 0 18px; }

  /* ---- Banner ---- */
  .tle-banner { background: var(--red); color: #fff; text-align: center; padding: clamp(56px, 7vw, 96px) clamp(20px, 6vw, 110px); display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .tle-banner-h { font-size: clamp(26px, 3.6vw, 50px); font-weight: 800; letter-spacing: -0.02em; margin: 0; max-width: 18ch; line-height: 1.05; }

  /* ---- Testimonials ---- */
  .tle-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2vw, 32px); }
  @media (max-width: 900px) { .tle-quotes { grid-template-columns: 1fr; } }
  .tle-quote { border: 1px solid var(--line); border-radius: 10px; padding: clamp(26px, 2.4vw, 36px); margin: 0; }
  .tle-quote-stars { color: var(--red); letter-spacing: 0.12em; margin-bottom: 16px; }
  .tle-quote blockquote { font-size: clamp(16px, 1.35vw, 19px); font-weight: 500; line-height: 1.5; margin: 0 0 22px; }
  .tle-quote figcaption { display: flex; flex-direction: column; gap: 2px; }
  .tle-quote figcaption strong { font-weight: 700; font-size: 14px; }
