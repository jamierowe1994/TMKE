<script is:inline>
  /* Only decode videos while they're on screen — keeps the heavy clip from
     hammering the renderer when it's parked far down the page. */
  (function () {
    const vids = document.querySelectorAll("video");
    if (!vids.length || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { const p = e.target.play(); if (p && p.catch) p.catch(() => {}); }
        else { e.target.pause(); }
      });
    }, { threshold: 0.12 });
    vids.forEach((v) => io.observe(v));
  })();

  (function () {
    const els = document.querySelectorAll(".tle-reveal");
    if (!("IntersectionObserver" in window) || !els.length) {
      els.forEach((el) => el.classList.add("is-in"));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          // gentle stagger for grouped items
          setTimeout(() => e.target.classList.add("is-in"), Math.min(i * 60, 240));
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
    els.forEach((el) => io.observe(el));
  })();

  /* Properties — coordinated build-in animation (once on scroll-in). */
  (function () {
    const sec = document.getElementById("properties");
    if (!sec) return;
    if (!("IntersectionObserver" in window)) { sec.classList.add("props-in"); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { sec.classList.add("props-in"); io.unobserve(e.target); }
      });
    }, { threshold: 0, rootMargin: "0px 0px -48% 0px" });
    io.observe(sec);
  })();

  /* Hero parallax — drive the wordmark shrink/sink, the button growth and the
     corner curve from a single scroll-progress var; fade the nav into focus. */
  (function () {
    const hero = document.querySelector(".tle-hero");
    const nav = document.querySelector(".tle-nav");
    if (!hero) return;
    const overlap = document.querySelector(".tle-overlap");
    const words = Array.prototype.slice.call(document.querySelectorAll(".tle-future-h .muted .fw"));
    let ticking = false, lastY = window.scrollY;
    function onScroll() {
      const y = window.scrollY;
      // The hero is min-height:100vh, so never trust a transiently-small
      // offsetHeight at load (it would falsely stick the nav at scroll 0).
      const h = Math.max(hero.offsetHeight || 0, window.innerHeight);
      const p = Math.min(Math.max(y / (h * 0.85), 0), 1);
      hero.style.setProperty("--p", p.toFixed(4));
      if (nav) {
        const navH = nav.offsetHeight || 64;
        // Stay see-through over the hero; focus to solid only once the next
        // section reaches the nav.
        nav.classList.toggle("is-stuck", y > h - navH - 4);
        // Auto-hide: hide while scrolling down (past the fold), show on scroll up.
        if (y > lastY + 4 && y > 140) nav.classList.add("is-hidden");
        else if (y < lastY - 4) nav.classList.remove("is-hidden");
      }
      // Scroll-fill the "Changing the future" body copy word by word while the
      // section is pinned (holds central; the words ink in as you scroll).
      if (overlap && words.length) {
        const ot = overlap.getBoundingClientRect().top;
        // Tie the fill to the hold spacer: the words finish inking in as you
        // scroll through the hold, just before the services card comes over.
        const hold = overlap.querySelector(".tle-future-hold");
        const range = hold ? Math.max(hold.offsetHeight * 0.86, 320) : window.innerHeight * 0.7;
        const prog = Math.min(Math.max((-ot - 40) / range, 0), 1);
        const reach = prog * (words.length + 2);
        for (let i = 0; i < words.length; i++) {
          const wf = Math.min(Math.max((reach - i) * 100, 0), 100);
          words[i].style.setProperty("--wf", wf.toFixed(0) + "%");
        }
      }
      lastY = y;
      ticking = false;
    }
    window.addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
    }, { passive: true });
    window.addEventListener("resize", onScroll);
    window.addEventListener("load", onScroll);
    onScroll();
  })();

  /* Team — auto-rotating arc. Each member sits on a semi-circle: the centre is
     biggest and highest, the rest trend down and shrink, the edges fade. A
     floating "pos" advances over time so the whole arc rotates. */
  (function () {
    const arc = document.getElementById("tle-team-arc");
    if (!arc) return;
    const members = Array.prototype.slice.call(arc.querySelectorAll(".tle-arc-member"));
    const N = members.length;
    if (!N) return;
    const photos = members.map((el) => el.querySelector(".tle-arc-photo"));
    const capName = document.querySelector(".tle-team-caption-name");
    const capRole = document.querySelector(".tle-team-caption-role");
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let pos = 0, target = 0, last = 0, lastStep = 0, lastCenter = -1, visible = true;

    function wrapD(i) {
      let d = (i - pos) % N;
      if (d > N / 2) d -= N;
      if (d < -N / 2) d += N;
      return d;
    }

    function layout() {
      const w = arc.clientWidth || 900;
      const R = Math.min(560, w * 0.46);   // horizontal amplitude
      const Y = R * 0.42;                   // vertical drop amplitude
      const step = 0.4;                     // radians between neighbours
      let centerEl = null, centerAbs = Infinity;
      members.forEach((el, i) => {
        const d = wrapD(i);
        const ad = Math.abs(d);
        const a = d * step;
        const x = Math.sin(a) * R;
        const y = (1 - Math.cos(a)) * Y;
        // Centre is much bigger and sits on top; neighbours shrink off faster.
        const scale = Math.max(0.32, 1.24 - ad * 0.34);
        const op = Math.max(0, Math.min(1, 1.2 - ad * 0.34));
        el.style.transform = "translate(-50%, 0) translate(" + x.toFixed(1) + "px, " + y.toFixed(1) + "px) scale(" + scale.toFixed(3) + ")";
        el.style.opacity = op.toFixed(2);
        el.style.zIndex = String(Math.round(100 - ad * 12));
        // Drop shadow: really heavy under the centre and reaching down onto the
        // caption (a defined contact line), lighter on each step out.
        const sh = Math.max(0, 1 - ad * 0.46);
        const ph = photos[i];
        if (ph) {
          const yo = (18 + sh * 60).toFixed(0);
          const bl = (22 + sh * 34).toFixed(0);
          const al = (0.1 + sh * 0.62).toFixed(2);
          ph.style.boxShadow = "0 " + yo + "px " + bl + "px -14px rgba(0,0,0," + al + ")";
        }
        if (ad < centerAbs) { centerAbs = ad; centerEl = el; }
      });
      const idx = centerEl ? +centerEl.dataset.i : 0;
      if (idx !== lastCenter && capName) {
        lastCenter = idx;
        capName.textContent = centerEl.dataset.name;
        capRole.textContent = centerEl.dataset.role;
      }
    }

    function frame(t) {
      if (!last) { last = t; lastStep = t; }
      last = t;
      if (visible && !reduce) {
        // Dwell on each agent for a beat, then ease across to the next.
        if (t - lastStep > 2600) { target += 1; lastStep = t; }
        pos += (target - pos) * 0.07;
      }
      layout();
      requestAnimationFrame(frame);
    }
    layout();
    requestAnimationFrame(frame);
    window.addEventListener("resize", layout);
    // Pause the rotation while the arc is off screen.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((es) => { es.forEach((e) => { visible = e.isIntersecting; }); }, { threshold: 0 }).observe(arc);
    }
  })();

  /* Property preview modal — homepage cards open a highlights pop-out instead
     of navigating; "View full page" follows the card's link. */
  (function () {
    const modal = document.getElementById("tle-modal");
    if (!modal) return;
    const $ = (id) => document.getElementById(id);
    function open(card) {
      const d = card.dataset;
      $("tlem-img").src = d.img; $("tlem-img").alt = d.area;
      $("tlem-tag").textContent = d.status;
      $("tlem-price").textContent = d.pcm;
      $("tlem-area").textContent = d.area;
      $("tlem-stats").innerHTML =
        "<span>" + d.beds + " bed</span><span>" + d.baths + " bath</span><span>" + d.size + "</span><span>" + d.type + "</span>";
      $("tlem-full").href = card.getAttribute("href");
      modal.hidden = false;
      requestAnimationFrame(() => modal.classList.add("is-open"));
      document.body.style.overflow = "hidden";
    }
    function close() {
      modal.classList.remove("is-open");
      document.body.style.overflow = "";
      setTimeout(() => { modal.hidden = true; }, 340);
    }
    document.querySelectorAll("[data-prop]").forEach((card) => {
      card.addEventListener("click", (e) => { e.preventDefault(); open(card); });
    });
    modal.querySelectorAll("[data-close]").forEach((b) => b.addEventListener("click", close));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hidden) close(); });
  })();

  /* Latest Articles — rotate the featured article; each has its own background,
     and the pagination pill fills toward the next dot then bubbles over to it. */
  (function () {
    var slides = document.querySelectorAll(".tle-artslide");
    if (!slides.length) return;
    var metas = document.querySelectorAll(".tle-artmeta");
    var bgs = document.querySelectorAll(".tle-artbg");
    var dots = Array.prototype.slice.call(document.querySelectorAll(".tle-artpag-dot"));
    var left = document.getElementById("tle-artpag-tail");   // reaches out from the current dot
    var right = document.getElementById("tle-artpag-head");  // reaches back from the next dot
    var N = slides.length;
    var DWELL = 4600, BASE = 15, HOLD = 0.6;
    var cur = 0, elapsed = 0, lastT = 0, visible = true;

    function show(n) {
      cur = (n + N) % N;
      slides.forEach(function (s, i) { s.classList.toggle("is-active", i === cur); });
      metas.forEach(function (s, i) { s.classList.toggle("is-active", i === cur); });
      bgs.forEach(function (s, i) { s.classList.toggle("is-active", i === cur); });
      dots.forEach(function (d, i) { d.classList.toggle("is-active", i === cur); });
    }
    function centerOf(i) { return dots[i].offsetLeft + dots[i].offsetWidth / 2; }
    function ease(p) { return 1 - Math.pow(1 - p, 3); }
    // Draw a pill spanning x1..x2 (rounded ends via border-radius); h is its
    // thickness — pass 0 to hide it.
    function pill(el, x1, x2, h) {
      var lo = Math.min(x1, x2), hi = Math.max(x1, x2);
      var w = Math.max(hi - lo, h);
      el.style.left = ((lo + hi) / 2).toFixed(1) + "px";
      el.style.width = w.toFixed(1) + "px";
      el.style.height = h.toFixed(1) + "px";
    }

    function frame(t) {
      if (!lastT) lastT = t;
      var dt = t - lastT; lastT = t;
      if (visible) elapsed += dt;
      var p = Math.min(elapsed / DWELL, 1);
      var ac = centerOf(cur), nc = centerOf((cur + 1) % N), mid = (ac + nc) / 2;
      if (p < HOLD) {
        // Resting: a single white pill on the current dot.
        pill(left, ac, ac, BASE);
        pill(right, ac, ac, 0);
      } else {
        var m = (p - HOLD) / (1 - HOLD);
        if (m <= 0.55) {
          // Reach: current pill stretches toward the middle, the next dot
          // bulges out and reaches back — they approach and the goo fuses them.
          var e1 = ease(m / 0.55);
          pill(left, ac, ac + (mid - ac) * e1, BASE);
          pill(right, nc - (nc - mid) * e1, nc, BASE * Math.min(1, m / 0.16));
        } else {
          // Merge & settle: the joined mass consolidates onto the next dot.
          var e2 = ease((m - 0.55) / 0.45);
          pill(left, ac + (nc - ac) * e2, mid + (nc - mid) * e2, BASE);
          pill(right, mid + (nc - mid) * e2, nc, BASE);
        }
      }
      if (p >= 1) { show((cur + 1) % N); elapsed = 0; }
      requestAnimationFrame(frame);
    }

    dots.forEach(function (d, i) { d.addEventListener("click", function () { show(i); elapsed = 0; }); });
    show(0);
    // Seat the pill on the first dot before the first frame (no top-left flash).
    var c0 = centerOf(0);
    pill(left, c0, c0, BASE); pill(right, c0, c0, 0);
    requestAnimationFrame(frame);
    if ("IntersectionObserver" in window) {
      var feat = document.querySelector(".tle-artfeature");
      if (feat) new IntersectionObserver(function (es) { es.forEach(function (e) { visible = e.isIntersecting; }); }, { threshold: 0 }).observe(feat);
    }
  })();
</script>
