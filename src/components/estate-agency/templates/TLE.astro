---
// THE LETTING EXPERTS — editorial WHITE rebuild of thelettingexperts.co.uk.
// Real content pulled from the live homepage (copy, listings, team, reviews,
// blog, footer). Brand: white + red #e31f36 + grey, set in Montserrat. Look:
// airy, editorial, framed photography, big display type, pill buttons.
// The .tle-ph blocks stay as image placeholders to swap for TLE's photography.

const BRAND = "The Letting Experts";

// Hero assets — plain sky background + the building as a transparent cut-out,
// so the giant wordmark can sit between them (building clips the wording).
const SKY = "https://assets.tmke.co.uk/TLE/sky.png";
const BUILDING = "https://assets.tmke.co.uk/TLE/sky%20(2).png";

// "Properties We Think You'll Love" — real listings from the homepage.
const PROPERTIES = [
  { area: "Garland Road, Poole, BH15",            beds: 1, baths: 1, pcm: "£725 pcm",   tag: "Let agreed" },
  { area: "Glenfield Road, Leicester, LE3",       beds: 1, baths: 1, pcm: "£715 pcm",   tag: "To let" },
  { area: "Douglas Gardens Mews, Edinburgh, EH4", beds: 3, baths: 2, pcm: "£2,600 pcm", tag: "To let" },
  { area: "Chapter Road, London, NW2",            beds: 3, baths: 1, pcm: "£2,400 pcm", tag: "To let" },
];

// "A Different Approach to Lettings" — TLE's stated offering (three levels of
// landlord service; flagship Experts Management Service w/ rent guarantee +
// legal protection).
const SERVICES = [
  { n: "01", h: "Experts Management Service", p: "Our flagship fully-managed service — rent guarantee and legal protection built in, so your investment is safeguarded." },
  { n: "02", h: "Rent Collection", p: "We collect, reconcile and pay you on time, with clear statements and all the chasing handled for you." },
  { n: "03", h: "Tenant Find", p: "Marketed properly, referenced thoroughly and moved in smoothly — then the property is back with you." },
  { n: "04", h: "Compliance & Safety", p: "Gas, electrical, EPC and deposit protection kept current so you stay the right side of legislation." },
  { n: "05", h: "Property Management", p: "Local expertise plus market-leading technology, keeping landlords and tenants updated at every step." },
  { n: "06", h: "Advice & Support", p: "A named Letting Expert by your side throughout — keeping you informed and giving you peace of mind." },
];

// "Our Client Testimonials" — real homepage reviews (excerpts).
const TESTIMONIALS = [
  { quote: "Angela let and managed our property in London Bridge — I cannot speak highly enough of her efficiency.", name: "Verified client", role: "Google review" },
  { quote: "Working with Angela was brilliant. She is proactive, responsive and reliable and we really felt looked after.", name: "Verified client", role: "Google review" },
  { quote: "I had an excellent experience with Lou throughout the entire rental process. From start to finish, she was superb.", name: "Verified client", role: "Google review" },
];

// "Letting Experts You Can Trust" — real team (selection of the nationwide roster).
const TEAM = [
  { name: "Geraldine Mulhern", role: "East Surrey & West Sussex" },
  { name: "Graham Cross",      role: "Leicestershire & Warwickshire" },
  { name: "Angela Davey",      role: "Birmingham" },
  { name: "Lauren Engley",     role: "Bristol" },
  { name: "Tony Poon",         role: "Milton Keynes" },
  { name: "Sean McMahon",      role: "Edinburgh" },
  { name: "Claire Riley",      role: "Coventry" },
  { name: "Richard Callow",    role: "Oxfordshire" },
];

// "Latest Articles" — real blog posts.
const BLOG = [
  { cat: "Landlords", title: "How to Make Your Rental Property Easier to Manage", date: "4 Jun 2026" },
  { cat: "Tenants",   title: "Why Good Tenants Miss Out on Rental Homes & How to Avoid It", date: "21 May 2026" },
  { cat: "Landlords", title: "How to Handle the End of a Tenancy Smoothly and Professionally", date: "7 May 2026" },
];

// Accreditations.
const ACCREDS = ["ARLA Propertymark", "Property Redress Scheme", "Client Money Protection", "Tenancy Deposit Scheme", "ICO Registered"];
---

<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap" />

<div class="tle-root">

  <!-- ============ Nav ============ -->
  <header class="tle-nav">
    <a href="#" class="tle-logo">The&nbsp;Letting&nbsp;<span>Experts</span></a>
    <nav class="tle-nav-links">
      <a href="#properties">Property Search</a>
      <a href="#services">Landlords</a>
      <a href="#team">About Us</a>
      <a href="#book">Contact</a>
    </nav>
    <a href="#book" class="tle-btn tle-btn--red">Book an appointment</a>
  </header>

  <!-- ============ Hero — wordmark sandwiched between sky + building ============ -->
  <section class="tle-hero" style={`background-image:url('${SKY}')`}>
    <h1 class="tle-hero-word">The Letting<br />Experts</h1>
    <img class="tle-hero-building" src={BUILDING} alt="A property managed by The Letting Experts" />
    <div class="tle-hero-cta">
      <a href="#book" class="tle-btn tle-btn--red">Contact us Today</a>
      <a href="#properties" class="tle-btn tle-btn--ghost">View Properties &rarr;</a>
    </div>
  </section>

  <!-- ============ Properties you'll love ============ -->
  <section class="tle-section" id="properties">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( Properties )</div>
        <h2 class="tle-h">Properties we think you'll love.</h2>
      </div>
      <a href="#" class="tle-link">View all properties &rarr;</a>
    </header>
    <div class="tle-props">
      {PROPERTIES.map((p) => (
        <article class="tle-prop tle-reveal">
          <div class="tle-ph tle-ph--prop">
            <span>Property image</span>
            <em class="tle-prop-tag">{p.tag}</em>
          </div>
          <div class="tle-prop-body">
            <h3 class="tle-prop-area">{p.area}</h3>
            <div class="tle-prop-meta">{p.beds} bed · {p.baths} bath</div>
            <div class="tle-prop-foot">
              <span class="tle-prop-price">{p.pcm}</span>
              <a href="#" class="tle-btn tle-btn--red tle-btn--sm">Rent</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ Changing the future of lettings ============ -->
  <section class="tle-future" id="book">
    <div class="tle-future-media tle-reveal">
      <div class="tle-ph tle-ph--tall"><span>Lifestyle photography</span></div>
    </div>
    <div class="tle-future-text tle-reveal">
      <div class="tle-label">( Welcome )</div>
      <h2 class="tle-h tle-h--xl">Changing the future of lettings in the UK.</h2>
      <p class="tle-lead">
        Your trusted partner throughout the journey of letting your property. We
        prioritise compliance, safety and legislation to safeguard you and your
        property — and keep you informed every step of the way, for real peace of
        mind throughout the tenancy.
      </p>
      <ul class="tle-ticks">
        <li>Flagship Experts Management Service</li>
        <li>Rent guarantee &amp; legal protection</li>
        <li>Three levels of landlord service</li>
      </ul>
      <a href="#" class="tle-btn tle-btn--red">Book an appointment</a>
    </div>
  </section>

  <!-- ============ Services — a different approach ============ -->
  <section class="tle-section" id="services">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( Services )</div>
        <h2 class="tle-h">A different approach to lettings.</h2>
      </div>
      <p class="tle-head-note">Three levels of landlord service and a comprehensive range of tailored lettings and property-management expertise.</p>
    </header>
    <div class="tle-services">
      {SERVICES.map((s) => (
        <article class="tle-service tle-reveal">
          <span class="tle-service-n">{s.n}</span>
          <h3 class="tle-service-h">{s.h}</h3>
          <p class="tle-service-p">{s.p}</p>
          <a href="#" class="tle-link tle-link--sm">Learn more &rarr;</a>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ CTA banner (contained box) ============ -->
  <section class="tle-banner">
    <div class="tle-banner-box tle-reveal">
      <h2 class="tle-banner-h">Thinking of letting? Let's talk this week.</h2>
      <a href="#book" class="tle-btn tle-btn--red">Book your free valuation &rarr;</a>
    </div>
  </section>

  <!-- ============ Testimonials ============ -->
  <section class="tle-section" id="reviews">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( Reviews )</div>
        <h2 class="tle-h">Our client testimonials.</h2>
      </div>
    </header>
    <div class="tle-quotes">
      {TESTIMONIALS.map((t) => (
        <figure class="tle-quote tle-reveal">
          <div class="tle-quote-stars">★★★★★</div>
          <blockquote>“{t.quote}”</blockquote>
          <figcaption><strong>{t.name}</strong><span>{t.role}</span></figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- ============ Meet the team ============ -->
  <section class="tle-section" id="team">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( The team )</div>
        <h2 class="tle-h">Letting Experts you can trust.</h2>
      </div>
      <a href="#" class="tle-link">View all Agents &rarr;</a>
    </header>
    <div class="tle-team">
      {TEAM.map((m) => (
        <article class="tle-member tle-reveal">
          <div class="tle-ph tle-ph--portrait"><span>Team photo</span></div>
          <h3 class="tle-member-name">{m.name}</h3>
          <div class="tle-member-role">{m.role} Letting Expert</div>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ Blog ============ -->
  <section class="tle-section" id="blog">
    <header class="tle-head tle-reveal">
      <div>
        <div class="tle-label">( Insights )</div>
        <h2 class="tle-h">Latest articles.</h2>
        <p class="tle-head-note" style="margin-top:14px">Stay up to date with our latest news, tips and tricks.</p>
      </div>
      <a href="#" class="tle-link">View all posts &rarr;</a>
    </header>
    <div class="tle-blog">
      {BLOG.map((b) => (
        <article class="tle-post tle-reveal">
          <div class="tle-ph tle-ph--wide"><span>Article image</span></div>
          <div class="tle-post-cat">{b.cat}</div>
          <h3 class="tle-post-h">{b.title}</h3>
          <div class="tle-post-date">{b.date}</div>
        </article>
      ))}
    </div>
  </section>

  <!-- ============ Accreditations ============ -->
  <section class="tle-accred tle-reveal">
    <div class="tle-accred-label">Regulated &amp; accredited</div>
    <div class="tle-accred-row">
      {ACCREDS.map((a) => (
        <div class="tle-accred-item"><span>{a}</span></div>
      ))}
    </div>
  </section>

  <!-- ============ Footer ============ -->
  <footer class="tle-footer">
    <div class="tle-footer-top">
      <div class="tle-footer-brand">
        <div class="tle-logo tle-logo--light">The&nbsp;Letting&nbsp;<span>Experts</span></div>
        <p>The future of lettings — giving landlords peace of mind, nationwide.</p>
        <a href="#book" class="tle-btn tle-btn--red">Book an appointment</a>
      </div>
      <div class="tle-footer-cols">
        <div><h4>Landlords</h4><a href="#">Our Services</a><a href="#">Advice &amp; Support</a><a href="#">Our Expertise</a><a href="#">Book an appointment</a></div>
        <div><h4>Company</h4><a href="#">About Us</a><a href="#">Letting Experts</a><a href="#">Latest Articles</a><a href="#">Client Money Protection</a></div>
        <div><h4>Contact</h4><a href="#">0333 344 9915</a><a href="#">hello@thelettingexperts.co.uk</a><a href="#">5 Regent Street, Rugby, CV21 2PE</a></div>
      </div>
    </div>
    <div class="tle-footer-bottom">
      <span>© 2026 The Letting Experts. The Letting Experts (Nationwide) Ltd · Company No. 14702207.</span>
      <span class="tle-footer-tmke">Concept redesign by TMKE</span>
    </div>
  </footer>
</div>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');

  .tle-root {
    --red: #e31f36;
    --ink: #16171a;
    --grey: #6e6e76;
    --line: #e7e7ea;
    --surface: #f4f4f5;
    --surface-2: #ededee;
    font-family: "Montserrat", system-ui, sans-serif;
    color: var(--ink);
    background: #fff;
    -webkit-font-smoothing: antialiased;
    line-height: 1.55;
  }
  .tle-root *, .tle-root *::before, .tle-root *::after { box-sizing: border-box; }
  .tle-root a { color: inherit; text-decoration: none; }

  /* ---- Reveal on scroll ---- */
  .tle-reveal { opacity: 0; transform: translateY(26px); transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
  .tle-reveal.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .tle-reveal { opacity: 1; transform: none; transition: none; } }

  /* ---- Shared ---- */
  /* Everything flows on white — contrast comes from boxes/cards, not full-width
     background-colour bands. */
  .tle-section { padding: clamp(64px, 8vw, 130px) clamp(20px, 6vw, 110px); }
  .tle-label { font-size: 12px; font-weight: 600; letter-spacing: 0.18em; color: var(--red); margin-bottom: 16px; }
  .tle-eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--red); margin-bottom: 22px; }
  .tle-h {
    font-size: clamp(30px, 4.2vw, 60px); font-weight: 800; line-height: 1.02;
    letter-spacing: -0.02em; margin: 0;
  }
  .tle-h--xl { font-size: clamp(34px, 5vw, 76px); }
  .tle-h em { font-style: italic; font-weight: 500; color: var(--red); }
  .tle-lead { font-size: clamp(16px, 1.3vw, 19px); color: var(--grey); max-width: 52ch; margin: 22px 0 28px; }

  .tle-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-bottom: clamp(36px, 4vw, 64px); }
  .tle-head-note { font-size: 15px; color: var(--grey); max-width: 42ch; margin: 0; }

  .tle-link { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--ink); border-bottom: 2px solid var(--red); padding-bottom: 3px; transition: color .25s; }
  .tle-link:hover { color: var(--red); }
  .tle-link--sm { font-size: 12px; border-bottom-width: 1px; }

  /* ---- Buttons ---- */
  .tle-btn {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    font-family: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.04em;
    padding: 14px 26px; border-radius: 999px; border: 1.5px solid transparent;
    transition: background .25s, color .25s, border-color .25s, transform .25s;
    white-space: nowrap;
  }
  .tle-btn--sm { padding: 9px 18px; font-size: 12px; }
  .tle-btn--red { background: var(--red); color: #fff; }
  .tle-btn--red:hover { background: var(--ink); transform: translateY(-2px); }
  .tle-btn--ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .tle-btn--ghost:hover { border-color: var(--ink); }
  .tle-btn--white { background: #fff; color: var(--red); }
  .tle-btn--white:hover { transform: translateY(-2px); }

  /* ---- Image placeholders (swap for real photography) ---- */
  .tle-ph {
    position: relative; background: var(--surface);
    background-image: repeating-linear-gradient(135deg, transparent 0 18px, rgba(0,0,0,0.012) 18px 19px);
    border: 1px solid var(--line); overflow: hidden; display: flex; align-items: center; justify-content: center;
  }
  .tle-ph > span { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #b6b6bd; font-weight: 600; }
  .tle-ph--hero { height: min(80vh, 720px); width: 100%; border-radius: 6px; }
  .tle-ph--prop { aspect-ratio: 4 / 3; }
  .tle-ph--tall { aspect-ratio: 3 / 4; height: 100%; }
  .tle-ph--portrait { aspect-ratio: 3 / 4; }
  .tle-ph--wide { aspect-ratio: 3 / 2; }

  /* ---- Nav ---- */
  .tle-nav {
    position: sticky; top: 0; z-index: 30;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 18px clamp(20px, 6vw, 110px);
    background: rgba(255,255,255,0.86); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .tle-logo { font-weight: 800; font-size: 17px; letter-spacing: -0.01em; }
  .tle-logo span { color: var(--red); }
  .tle-nav-links { display: flex; gap: 28px; }
  .tle-nav-links a { font-size: 14px; font-weight: 500; color: var(--ink); transition: color .2s; }
  .tle-nav-links a:hover { color: var(--red); }
  @media (max-width: 860px) { .tle-nav-links { display: none; } }

  /* ---- Hero — the giant wordmark sits on the sky, the building cut-out is laid
     over the top at the exact same crop, so the building rises through and clips
     the wording. Simple + striking. ---- */
  .tle-hero {
    position: relative;
    min-height: calc(100vh - 62px);
    overflow: hidden;
    background-size: cover; background-position: center bottom; background-repeat: no-repeat;
  }
  .tle-hero-word {
    position: absolute; z-index: 1;
    top: clamp(56px, 12vh, 150px); left: 0; right: 0;
    margin: 0; text-align: center;
    font-weight: 800; font-size: clamp(44px, 11vw, 178px);
    line-height: 0.86; letter-spacing: -0.04em; color: var(--ink);
  }
  /* Building cut-out — same crop as the sky bg, so it lands over its own sky and
     in front of the wordmark. */
  .tle-hero-building {
    position: absolute; z-index: 2; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center bottom;
    pointer-events: none; user-select: none;
  }
  .tle-hero-cta {
    position: absolute; z-index: 3; left: 0; right: 0; bottom: clamp(30px, 5vh, 56px);
    display: flex; justify-content: center; gap: 14px; flex-wrap: wrap;
  }
  /* Ghost button sits over the dark building — make it light. */
  .tle-hero-cta .tle-btn--ghost { color: #fff; border-color: rgba(255,255,255,0.6); }
  .tle-hero-cta .tle-btn--ghost:hover { background: #fff; color: var(--ink); border-color: #fff; }

  /* ---- Properties ---- */
  .tle-props { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(18px, 1.6vw, 28px); }
  @media (max-width: 1100px) { .tle-props { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .tle-props { grid-template-columns: 1fr; } }
  .tle-prop { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; background: #fff; transition: transform .3s, box-shadow .3s; }
  .tle-prop:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -34px rgba(0,0,0,0.3); }
  .tle-prop-tag { position: absolute; top: 12px; left: 12px; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; background: rgba(255,255,255,0.92); color: var(--red); padding: 5px 11px; border-radius: 999px; font-style: normal; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }
  .tle-prop-body { padding: 18px 18px 20px; }
  .tle-prop-area { font-size: 15px; font-weight: 700; margin: 0 0 4px; line-height: 1.25; }
  .tle-prop-meta { font-size: 13px; color: var(--grey); margin-bottom: 16px; }
  .tle-prop-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .tle-prop-price { font-size: 16px; font-weight: 800; }

  /* ---- Future / book — flows on white; the framed image is the contrast ---- */
  .tle-future { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(32px, 5vw, 80px); align-items: center; padding: clamp(64px, 8vw, 130px) clamp(20px, 6vw, 110px); }
  .tle-future-media .tle-ph { border-radius: 14px; box-shadow: 0 40px 90px -50px rgba(0,0,0,0.4); }
  .tle-ticks { list-style: none; padding: 0; margin: 0 0 30px; display: flex; flex-direction: column; gap: 12px; }
  .tle-ticks li { position: relative; padding-left: 28px; font-size: 15px; color: var(--ink); }
  .tle-ticks li::before { content: "✓"; position: absolute; left: 0; top: -1px; color: var(--red); font-weight: 800; }
  @media (max-width: 820px) { .tle-future { grid-template-columns: 1fr; } .tle-future-media { order: 2; } }

  /* ---- Services ---- */
  .tle-services { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  @media (max-width: 900px) { .tle-services { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .tle-services { grid-template-columns: 1fr; } }
  .tle-service { border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: clamp(28px, 2.4vw, 40px); transition: background .3s; }
  .tle-service:hover { background: var(--surface); }
  .tle-service-n { font-size: 13px; font-weight: 800; color: var(--red); letter-spacing: 0.1em; }
  .tle-service-h { font-size: clamp(19px, 1.7vw, 24px); font-weight: 700; margin: 14px 0 10px; }
  .tle-service-p { font-size: 14.5px; color: var(--grey); margin: 0 0 18px; }

  /* ---- Banner — a contained dark box (not a full-bleed red band); red is
     reserved for the CTA button inside it. ---- */
  .tle-banner { padding: clamp(20px, 4vw, 64px) clamp(20px, 6vw, 110px); }
  .tle-banner-box { background: var(--ink); color: #fff; border-radius: 22px; text-align: center; padding: clamp(48px, 6vw, 92px) clamp(24px, 5vw, 72px); display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .tle-banner-h { font-size: clamp(26px, 3.6vw, 50px); font-weight: 800; letter-spacing: -0.02em; margin: 0; max-width: 18ch; line-height: 1.05; }

  /* ---- Testimonials ---- */
  .tle-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2vw, 32px); }
  @media (max-width: 900px) { .tle-quotes { grid-template-columns: 1fr; } }
  .tle-quote { border: 1px solid var(--line); border-radius: 10px; padding: clamp(26px, 2.4vw, 36px); margin: 0; }
  .tle-quote-stars { color: var(--red); letter-spacing: 0.12em; margin-bottom: 16px; }
  .tle-quote blockquote { font-size: clamp(16px, 1.35vw, 19px); font-weight: 500; line-height: 1.5; margin: 0 0 22px; }
  .tle-quote figcaption { display: flex; flex-direction: column; gap: 2px; }
  .tle-quote figcaption strong { font-weight: 700; font-size: 14px; }
  .tle-quote figcaption span { font-size: 12px; color: var(--grey); }

  /* ---- Team ---- */
  .tle-team { display: grid; grid-template-columns: repeat(4, 1fr); gap: clamp(18px, 1.8vw, 30px); }
  @media (max-width: 900px) { .tle-team { grid-template-columns: repeat(2, 1fr); } }
  .tle-member-name { font-size: 16px; font-weight: 700; margin: 16px 0 2px; }
