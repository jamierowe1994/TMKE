  .tle-artslide.is-active { opacity: 1; transform: none; pointer-events: auto; position: relative; }
  .tle-artpill { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.03em; background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.35); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); padding: 7px 16px; border-radius: 999px; margin-bottom: 18px; }
  .tle-arttitle { font-size: clamp(26px, 3.4vw, 46px); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; margin: 0 0 14px; text-shadow: 0 2px 30px rgba(0,0,0,0.4); }
  .tle-artsub { font-size: clamp(15px, 1.3vw, 18px); color: rgba(255,255,255,0.86); margin: 0; max-width: 54ch; }
  .tle-artdots { display: flex; gap: 9px; margin-top: 26px; }
  .tle-artdot { width: 9px; height: 9px; border-radius: 999px; border: 0; background: rgba(255,255,255,0.4); cursor: pointer; transition: background .3s, width .3s; }
  .tle-artdot.is-active { background: #fff; width: 26px; }
  .tle-artfeature-meta { position: relative; text-align: right; align-self: flex-end; min-width: 130px; min-height: 44px; }
  .tle-artmeta { position: absolute; inset: auto 0 0 0; opacity: 0; transition: opacity .5s ease; }
  .tle-artmeta.is-active { opacity: 1; position: relative; }
  .tle-artmeta-date { font-size: 14px; font-weight: 700; }
  .tle-artmeta-read { font-size: 13px; color: rgba(255,255,255,0.78); margin-top: 4px; }
  @media (max-width: 760px) { .tle-artfeature-meta { display: none; } }

  /* ---- Accreditations ---- */
  .tle-accred { padding: clamp(40px, 4vw, 64px) clamp(20px, 6vw, 110px); border-top: 1px solid var(--line); text-align: center; }
  .tle-accred-label { font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--grey); margin-bottom: 26px; }
  .tle-accred-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: clamp(16px, 3vw, 48px); }
  .tle-accred-item { height: 56px; min-width: 130px; padding: 0 22px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
  .tle-accred-item span { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: #9a9aa2; text-align: center; }

  /* ---- Footer ---- */
  /* ---- Footer — a white card on a soft-grey field, with a giant half-cut-off
