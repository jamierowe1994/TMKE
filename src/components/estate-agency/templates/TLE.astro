<style>
  @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Montserrat:wght@300;400;500;600;700;800;900&display=swap');

  .tle-root {
    --red: #e31f36;
    --ink: #16171a;
    --grey: #6e6e76;
    --line: #e7e7ea;
    --surface: #f4f4f5;
    --surface-2: #ededee;
    font-family: "Montserrat", system-ui, sans-serif;
    color: var(--ink);
    background: #fff;
    -webkit-font-smoothing: antialiased;
    line-height: 1.55;
  }
  .tle-root *, .tle-root *::before, .tle-root *::after { box-sizing: border-box; }
  .tle-root a { color: inherit; text-decoration: none; }

  /* ---- Reveal on scroll ---- */
  .tle-reveal { opacity: 0; transform: translateY(26px); transition: opacity .8s cubic-bezier(.16,1,.3,1), transform .8s cubic-bezier(.16,1,.3,1); }
  .tle-reveal.is-in { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) { .tle-reveal { opacity: 1; transform: none; transition: none; } }

  /* Expand-from-centre: the first time it scrolls in, the frame opens outwards
     from the middle (once), then sticks. */
  .tle-reveal--expand { opacity: 1; transform: none; clip-path: inset(16% 36% 16% 36%); transition: clip-path 1.2s cubic-bezier(.16, 1, .3, 1); }
  .tle-reveal--expand.is-in { clip-path: inset(0% 0% 0% 0%); }
  @media (prefers-reduced-motion: reduce) { .tle-reveal--expand { clip-path: none; } }

  /* ---- Shared ---- */
  /* Everything flows on white — contrast comes from boxes/cards, not full-width
     background-colour bands. */
  .tle-section { padding: clamp(64px, 8vw, 130px) clamp(20px, 6vw, 110px); }
  .tle-label { font-size: 12px; font-weight: 600; letter-spacing: 0.18em; color: var(--red); margin-bottom: 16px; }
  .tle-eyebrow { font-size: 12px; font-weight: 600; letter-spacing: 0.2em; text-transform: uppercase; color: var(--red); margin-bottom: 22px; }
  .tle-h {
    font-size: clamp(30px, 4.2vw, 60px); font-weight: 800; line-height: 1.02;
    letter-spacing: -0.02em; margin: 0;
  }
  .tle-h--xl { font-size: clamp(34px, 5vw, 76px); }
  .tle-h em { font-style: italic; font-weight: 500; color: var(--red); }
  .tle-lead { font-size: clamp(16px, 1.3vw, 19px); color: var(--grey); max-width: 52ch; margin: 22px 0 28px; }

  .tle-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 32px; flex-wrap: wrap; margin-bottom: clamp(36px, 4vw, 64px); }
  .tle-head-note { font-size: 15px; color: var(--grey); max-width: 42ch; margin: 0; }

  .tle-link { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--ink); border-bottom: 2px solid var(--red); padding-bottom: 3px; transition: color .25s; }
  .tle-link:hover { color: var(--red); }
  .tle-link--sm { font-size: 12px; border-bottom-width: 1px; }

  /* ---- Buttons ---- */
  .tle-btn {
    display: inline-flex; align-items: center; gap: 8px; cursor: pointer;
    font-family: inherit; font-size: 13px; font-weight: 700; letter-spacing: 0.04em;
    padding: 14px 26px; border-radius: 999px; border: 1.5px solid transparent;
    transition: background .25s, color .25s, border-color .25s, transform .25s;
    white-space: nowrap;
  }
  .tle-btn--sm { padding: 9px 18px; font-size: 12px; }
  .tle-btn--red { background: var(--red); color: #fff; }
  .tle-btn--red:hover { background: var(--ink); transform: translateY(-2px); }
  .tle-btn--ghost { background: transparent; color: var(--ink); border-color: var(--line); }
  .tle-btn--ghost:hover { border-color: var(--ink); }
  .tle-btn--white { background: #fff; color: var(--red); }
  .tle-btn--white:hover { transform: translateY(-2px); }
  /* Rounded-square (not a pill) — softens the edge without a hard corner. */
  .tle-btn--box { border-radius: 11px; }

  /* ---- Image placeholders (swap for real photography) ---- */
  .tle-ph {
    position: relative; background: var(--surface);
    background-image: repeating-linear-gradient(135deg, transparent 0 18px, rgba(0,0,0,0.012) 18px 19px);
    border: 1px solid var(--line); overflow: hidden; display: flex; align-items: center; justify-content: center;
  }
  .tle-ph > span { font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: #b6b6bd; font-weight: 600; }
  .tle-ph--hero { height: min(80vh, 720px); width: 100%; border-radius: 6px; }
  .tle-ph--prop { aspect-ratio: 4 / 3; }
  .tle-ph--tall { aspect-ratio: 3 / 4; height: 100%; }
  .tle-ph--portrait { aspect-ratio: 3 / 4; }
  .tle-ph--wide { aspect-ratio: 3 / 2; }

  /* ---- Nav — fixed & see-through so the hero spreads up behind it; white text
     over a soft scrim, then it focuses to solid white once the second section
     reaches the top. ---- */
  .tle-nav {
    --nav-fg: #fff;
    position: fixed; top: 0; left: 0; right: 0; z-index: 30;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 18px clamp(20px, 6vw, 110px);
    background: transparent; border-bottom: 1px solid transparent;
    transition: background .3s ease, border-color .3s ease, box-shadow .3s ease, transform .38s cubic-bezier(.16,1,.3,1);
    /* Drops in last in the entrance sequence; backwards fill so the auto-hide
       transform still works once the animation is done. */
    animation: tleNavDrop .7s cubic-bezier(.16, 1, .3, 1) 1.7s backwards;
  }
  /* Auto-hide: slides up out of view on scroll down, slides back on scroll up. */
  .tle-nav.is-hidden { transform: translateY(-105%); }
  /* Soft top scrim so white nav text reads over both the light sky and the
     dark building as the hero scrolls past. */
  .tle-nav::before {
    content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: linear-gradient(to bottom, rgba(0,0,0,0.32), rgba(0,0,0,0));
    opacity: 1; transition: opacity .3s ease;
  }
  .tle-nav.is-stuck {
    --nav-fg: var(--ink);
    background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    border-bottom-color: var(--line); box-shadow: 0 12px 30px -24px rgba(0,0,0,0.45);
  }
  .tle-nav.is-stuck::before { opacity: 0; }

  /* Scoped under .tle-nav so these beat the base `.tle-root a { color: inherit }`. */
  .tle-nav .tle-logo { font-weight: 800; font-size: 17px; letter-spacing: -0.01em; color: var(--nav-fg); transition: color .3s ease; }
  .tle-nav .tle-logo span { color: inherit; }

  .tle-nav-links { display: flex; align-items: center; gap: 28px; }
  .tle-nav .tle-nav-links > a,
  .tle-nav .tle-nav-trigger {
    font-family: inherit; font-size: 14px; font-weight: 500; color: var(--nav-fg);
    background: none; border: 0; padding: 0; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px; transition: color .2s;
  }
  .tle-nav .tle-nav-links > a:hover,
  .tle-nav .tle-nav-trigger:hover { color: var(--red); }
  .tle-chev { width: 11px; height: 8px; transition: transform .28s ease; }
  @media (max-width: 860px) { .tle-nav-links { display: none; } }

  /* Contact — a minimal CTA: text between two rules that spreads its letters
     apart on hover. Colour + rules follow the nav (white over the hero, ink
     once focused). */
  .tle-nav .tle-nav-contact {
    font-family: inherit; font-size: 14px; font-weight: 600; color: var(--nav-fg);
    border-top: 2px solid var(--nav-fg); border-bottom: 2px solid var(--nav-fg);
    padding: 9px 5px; letter-spacing: 2px; line-height: 1;
    transition: letter-spacing .25s ease, color .3s ease, border-color .3s ease;
  }
  .tle-nav .tle-nav-contact:hover { letter-spacing: 7px; }
  .tle-nav .tle-nav-contact .nc-short,
  .tle-nav .tle-nav-contact .nc-full { white-space: nowrap; }
  .tle-nav-contact .nc-full { display: none; }
  .tle-nav.is-stuck .tle-nav-contact .nc-short { display: none; }
  .tle-nav.is-stuck .tle-nav-contact .nc-full { display: inline; }

  /* ---- Bento mega-menu — bubbles out from under the link on hover ---- */
  .tle-nav-item { position: relative; }
  .tle-nav-item.has-mega:hover .tle-chev,
  .tle-nav-item.has-mega:focus-within .tle-chev { transform: rotate(180deg); }

  .tle-mega {
    position: absolute; top: 100%; padding-top: 16px;
    width: min(560px, 82vw);
    opacity: 0; visibility: hidden; pointer-events: none; z-index: 40;
    /* Grow outwards with an overshoot — not a flat pop. */
    transition: opacity .24s ease, transform .46s cubic-bezier(.34, 1.56, .5, 1), visibility .24s;
  }
  .tle-mega--left  { left: 0;  transform-origin: top left;  transform: translateY(16px) scale(.8); }
  .tle-mega--right { right: 0; transform-origin: top right; transform: translateY(16px) scale(.8); }
  .has-mega:hover .tle-mega, .has-mega:focus-within .tle-mega {
    opacity: 1; visibility: visible; pointer-events: auto; transform: translateY(0) scale(1);
  }

  /* Railway-style layout: a big card on the left spanning both rows, two stacked
     cards on the right, and one long thin bar across the bottom. */
  .tle-mega-grid {
    display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr auto; gap: 12px;
    background: #fff; border: 1px solid var(--line); border-radius: 20px; padding: 12px;
    box-shadow: 0 44px 80px -42px rgba(0,0,0,0.5), 0 8px 24px -16px rgba(0,0,0,0.28);
  }

  .tle-bento {
    display: flex; gap: 13px; align-items: flex-start;
    background: var(--surface); border: 1px solid var(--line); border-radius: 14px;
    padding: 16px; transition: background .2s, border-color .2s, transform .2s;
  }
  .tle-bento--big { grid-column: 1; grid-row: 1 / 3; }
  .tle-bento--bar { grid-column: 1 / 3; align-items: center; }
  .tle-bento--bar .tle-bento-tx { gap: 1px; }
  .tle-bento:hover { background: #fff; border-color: var(--red); transform: translateY(-2px); }
  .tle-bento-ico {
    flex: none; width: 38px; height: 38px; border-radius: 10px; display: grid; place-items: center;
    background: #fff; border: 1px solid var(--line); color: var(--red);
    transition: background .2s, color .2s, border-color .2s;
  }
  .tle-bento:hover .tle-bento-ico { background: var(--red); color: #fff; border-color: var(--red); }
  .tle-bento-ico svg { width: 20px; height: 20px; }
  .tle-bento-tx { display: flex; flex-direction: column; gap: 3px; }
  .tle-bento-tx strong { font-size: 14px; font-weight: 700; color: var(--ink); letter-spacing: -0.01em; }
  .tle-bento-tx small { font-size: 12px; color: var(--grey); line-height: 1.4; }
  .tle-bento--big .tle-bento-tx { gap: 6px; }
  .tle-bento--big .tle-bento-tx strong { font-size: 16px; }

  /* ---- Hero — layered: a transparent outline ring on the left (behind), the
     building cut-out in the middle (shifts right on scroll), and the words +
     buttons in front, coming over the top. Bright white theme. ---- */
  .tle-hero {
    position: relative;
    min-height: 100vh;
    overflow: hidden;
    background-size: cover; background-position: center bottom; background-repeat: no-repeat;
    border-bottom-left-radius: calc(var(--p, 0) * 40px);
    border-bottom-right-radius: calc(var(--p, 0) * 40px);
  }
  /* Ring + content share the same left anchor + size so the words sit inside the
     outline box; the building (z-2) slots between them. */
  .tle-hero-ring,
  .tle-hero-content {
    position: absolute; left: clamp(20px, 6vw, 96px);
    top: 50%;
    /* Drift the whole box (outline + words + buttons) down as you scroll, so it
       lingers toward the bottom of the hero. */
    transform: translateY(calc(-50% + var(--p, 0) * 44vh));
    width: min(54vw, 620px); height: min(60vh, 500px);
    will-change: transform;
  }
  .tle-hero-ring {
    z-index: 1;
    border: 2.8px solid rgba(255, 255, 255, 0.7);
    border-radius: 32px;
  }
  .tle-hero-content { z-index: 3; overflow: hidden; pointer-events: none; }
  .tle-hero-cinner {
    height: 100%; display: flex; flex-direction: column; justify-content: center; gap: clamp(22px, 3.6vh, 40px);
    padding: 0 clamp(30px, 3vw, 56px);
    /* Words + buttons rise out of the box's bottom line and fade in. */
    animation: tleContentRise .9s cubic-bezier(.16, 1, .3, 1) 1.05s both;
  }
  .tle-hero-cinner > * { pointer-events: auto; }
  .tle-hero-word {
    margin: 0; font-weight: 800;
    font-size: clamp(32px, 4.4vw, 60px); line-height: 1.02; letter-spacing: -0.03em;
    color: rgba(255, 255, 255, 0.96); text-shadow: 0 2px 30px rgba(20, 22, 34, 0.22);
  }
  /* Building cut-out — transparent PNG; sits over its own sky bg and shifts to
     the right as you scroll, clearing the words while still clipping the ring. */
  /* Building cut-out — entrance (rise up) lives on the wrapper; the scroll shift
     + tilt live on the image, so they never fight. */
  .tle-hero-building-wrap {
    position: absolute; z-index: 2; inset: 0;
    animation: tleRiseUp 1s cubic-bezier(.16, 1, .3, 1) .1s both;
  }
  .tle-hero-building {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    object-fit: cover; object-position: center bottom;
    /* translateY + small scale close the gap the -1deg tilt opens at the
       bottom/edges, so the building always meets the foot of the hero. */
    transform: translateX(calc(9% + var(--p, 0) * 15%)) translateY(18px) rotate(-1deg) scale(1.02);
    will-change: transform;
    pointer-events: none; user-select: none;
  }

  /* Clouds — lazy 60s+ drift on the inner image; the wrapper handles the
     entrance (slide in from L/R). They sit behind the building (z-1 < z-2). */
  .tle-cloud { position: absolute; z-index: 1; pointer-events: none; user-select: none; }
  .tle-cloud img { display: block; width: 100%; will-change: transform; }
  .tle-cloud--l { left: -10%; top: 14%; width: clamp(300px, 42vw, 820px); animation: tleCloudInL 1.2s cubic-bezier(.16, 1, .3, 1) .5s both; }
  .tle-cloud--m { right: 18%; top: -2%; width: clamp(150px, 19vw, 360px); animation: tleCloudInL 1.2s cubic-bezier(.16, 1, .3, 1) .6s both; }
  .tle-cloud--r { right: -10%; top: 16%; width: clamp(460px, 60vw, 1080px); animation: tleCloudInR 1.2s cubic-bezier(.16, 1, .3, 1) .5s both; }
  .tle-cloud--l img { animation: tleCloudL 58s ease-in-out infinite alternate; }
  .tle-cloud--r img { animation: tleCloudR 70s ease-in-out infinite alternate; }
  .tle-cloud--m img { animation: tleCloudM 64s ease-in-out infinite alternate; opacity: 0.92; }
  @keyframes tleCloudL { from { transform: translate(-4%, 2%); } to { transform: translate(30%, -10%); } }
  @keyframes tleCloudR { from { transform: translate(6%, 0); } to { transform: translate(-26%, 9%); } }
  @keyframes tleCloudM { from { transform: translate(8%, 0); } to { transform: translate(-16%, 5%); } }

  /* ---- Entrance sequence: building rises, clouds slide in, words rise out of
     the box, nav drops in (timed via animation-delay). ---- */
  @keyframes tleRiseUp { from { transform: translateY(104%); } to { transform: translateY(0); } }
  @keyframes tleCloudInL { from { transform: translateX(-72vw); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  @keyframes tleCloudInR { from { transform: translateX(72vw); opacity: 0; } to { transform: translateX(0); opacity: 1; } }
  @keyframes tleContentRise { from { transform: translateY(74%); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
  @keyframes tleNavDrop { from { transform: translateY(-100%); } to { transform: translateY(0); } }
  @media (prefers-reduced-motion: reduce) {
    .tle-cloud, .tle-cloud img, .tle-hero-building-wrap, .tle-hero-cinner, .tle-nav { animation: none !important; }
  }
  .tle-hero-cta { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  /* Hero CTAs get a tactile "pop + press" feel: they lift/enlarge on hover and
     push back in on click. Transform/shadow use a snappy spring; colour fades
     stay smooth. */
  .tle-hero-cta .tle-btn {
    min-width: 216px; justify-content: center;
    transition: background .25s, color .25s, border-color .25s,
                transform .2s cubic-bezier(.34, 1.56, .64, 1), box-shadow .2s ease;
  }
  .tle-hero-cta .tle-btn:hover {
    transform: translateY(-3px) scale(1.05);
    box-shadow: 0 12px 26px -10px rgba(0, 0, 0, 0.4);
  }
  /* Press in — snap down quickly so the click reads as a physical button. */
  .tle-hero-cta .tle-btn:active {
    transform: translateY(0) scale(0.95);
    box-shadow: 0 3px 8px -5px rgba(0, 0, 0, 0.45);
    transition: transform .07s ease, box-shadow .07s ease;
  }
  /* Contact (red): keep it red on hover — just pop, no colour flip to black. */
  .tle-hero-cta .tle-btn--red:hover { background: var(--red); color: #fff; }
  /* View Properties (ghost): keep the outline → white colour change. */
  .tle-hero-cta .tle-btn--ghost { color: #fff; border-color: rgba(255, 255, 255, 0.65); }
  .tle-hero-cta .tle-btn--ghost:hover { background: #fff; color: var(--ink); border-color: #fff; }

  @media (max-width: 820px) {
    .tle-hero-ring, .tle-hero-content { left: 50%; transform: translate(-50%, -50%); width: min(90vw, 520px); height: auto; }
    .tle-hero-content { padding: 40px clamp(22px, 6vw, 40px); }
    .tle-hero-ring { min-height: 60vh; }
    .tle-hero-building { transform: translateX(calc(4% + var(--p, 0) * 10%)); opacity: 0.92; }
  }

  /* ---- Properties — bento: one big feature (with an ambient video) + smaller
     cards dotted around it. All cards are full-bleed media with the detail
     overlaid at the bottom. ---- */
  /* Wide but brought in a touch; square corners; the header matches the width. */
  #properties { padding-left: clamp(26px, 2.8vw, 48px); padding-right: clamp(26px, 2.8vw, 48px); }
  /* Tighten the gap between the properties grid and the "Why The Letting
     Experts" section that follows it (~110px closer). */
  #properties { padding-bottom: clamp(24px, 3vw, 48px); }
  #book.tle-future { padding-top: clamp(20px, 3vw, 52px); }

  /* ---- Entrance: holds until you're ~3/4 into the section, then the cards
     slide into place (Garland + the two small ones rise, Chapter slides from
     the left), the heading slides in from the left and knocks the red dot,
     which pops off the line, falls, bounces and rolls back. The hold lives on
     :not(.props-in) so the settled state is the plain default (no stuck
     transforms — which keeps Chapter aligned with Garland). ---- */
  #properties .tle-prop { transition: opacity .5s ease, transform .7s cubic-bezier(.16, 1, .3, 1); }
  #properties:not(.props-in) .tle-prop { opacity: 0; transform: translateY(44px); }
  #properties.props-in .tle-props > :nth-child(1) { transition-delay: .04s; }
  #properties.props-in .tle-props > :nth-child(2) { transition-delay: .10s; }
  #properties.props-in .tle-props > :nth-child(3) { transition-delay: .16s; }
  #properties.props-in .tle-props > :nth-child(4) { transition-delay: .22s; }
  #properties.props-in .tle-props > :nth-child(5) { transition-delay: .28s; }
  #properties.props-in .tle-props > :nth-child(6) { transition-delay: .34s; }
  #properties.props-in .tle-props > :nth-child(7) { transition-delay: .40s; }
  #properties.props-in .tle-props > :nth-child(8) { transition-delay: .46s; }

  /* Heading slides in from the left, clipped (a slide, not a fade). 'clip' +
     a generous clip-margin keeps the left edge clipped while letting the red
     dot bounce out of the box without disappearing. */
  #properties .tle-head--props > div { overflow: clip; overflow-clip-margin: 46px; }
  #properties .tle-head--props .tle-h { transition: transform .7s cubic-bezier(.16, 1, .3, 1); transition-delay: .10s; }
  #properties:not(.props-in) .tle-head--props .tle-h { transform: translateX(-115%); }
  #properties .tle-head--props .tle-link { transition: opacity .5s ease; transition-delay: .7s; }
  #properties:not(.props-in) .tle-head--props .tle-link { opacity: 0; }

  .tle-dot { display: inline-block; transform-origin: center; }
  /* Dot fires as the cards reach the last ~15% of their slide (cards settle
     ~0.92s; the heading lands ~0.80s, then the dot knocks straight away). */
  #properties.props-in .tle-dot { animation: tleDotBounce 1.15s cubic-bezier(.5, 1.3, .5, 1) 0.8s both; }
  @keyframes tleDotBounce {
    0%   { transform: translate(-12px, 0) scale(1); }
    22%  { transform: translate(0, 0) scale(1); }            /* caught up to the line */
    34%  { transform: translate(16px, -12px) scale(1.3); }   /* knocked: pops up & right */
    48%  { transform: translate(11px, 7px) scale(1.05); }    /* falls down */
    60%  { transform: translate(5px, -7px) scale(1.14); }    /* bounces up */
    72%  { transform: translate(2px, 4px) scale(0.98); }     /* settles */
    84%  { transform: translate(-1px, -3px) scale(1.05); }   /* small bubble */
    93%  { transform: translate(0, 1px) scale(1); }
    100% { transform: translate(0, 0) scale(1); }            /* rolls back into place */
  }
  @media (prefers-reduced-motion: reduce) {
    #properties:not(.props-in) .tle-prop,
    #properties:not(.props-in) .tle-head--props .tle-h,
    #properties:not(.props-in) .tle-head--props .tle-link { opacity: 1; transform: none; }
    #properties.props-in .tle-dot { animation: none; }
  }
  /* Clean, uniform listing grid — equal white cards (image on top, a tidy info
     body below). Minimalist; replaces the busy mixed-size bento. */
  .tle-props {
    display: grid; grid-template-columns: repeat(4, 1fr);
    gap: clamp(14px, 1.4vw, 22px);
  }
  @media (max-width: 1100px) { .tle-props { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .tle-props { grid-template-columns: 1fr; } }
  .tle-prop {
    display: flex; flex-direction: column; border-radius: 0; overflow: hidden;
    background: #fff; border: 1px solid var(--line);
    transition: box-shadow .35s ease, transform .35s ease, border-color .35s ease;
  }
  .tle-prop:hover { box-shadow: 0 30px 58px -36px rgba(0,0,0,0.32); transform: translateY(-3px); border-color: #e7e7ea; }

  .tle-prop-imgwrap { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--surface); }
  .tle-prop-media { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .6s cubic-bezier(.16,1,.3,1); }
  .tle-prop:hover .tle-prop-media { transform: scale(1.05); }
  .tle-prop-tag { position: absolute; z-index: 3; top: 12px; left: 12px; font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; background: rgba(255,255,255,0.94); color: var(--red); padding: 5px 11px; border-radius: 999px; font-style: normal; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); }

  .tle-prop-body { padding: clamp(14px, 1vw, 18px); display: flex; flex-direction: column; }
  .tle-prop-area { font-size: clamp(15px, 1.1vw, 17px); font-weight: 700; margin: 0; line-height: 1.25; letter-spacing: -0.01em; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .tle-prop-sub { font-size: 13px; color: var(--grey); margin-top: 2px; }
  .tle-prop-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: clamp(11px, 1vw, 15px); padding-top: clamp(11px, 1vw, 14px); border-top: 1px solid var(--line); }
  .tle-prop-meta { font-size: 12.5px; color: var(--grey); }
  .tle-prop-price { font-size: 16px; font-weight: 800; color: var(--red); }

  /* ---- In-place expand: clicked card opens into a full-width detail panel ---- */
  /* Cards push off to their side as the panel opens. */
  .tle-prop { transition: opacity .4s ease, transform .55s cubic-bezier(.5, 0, .15, 1), box-shadow .35s ease; }
  .tle-prop.push-l { transform: translateX(-130%); opacity: 0; pointer-events: none; }
  .tle-prop.push-r { transform: translateX(130%); opacity: 0; pointer-events: none; }
  .tle-prop.is-picked { opacity: 0; transition: opacity .35s ease .1s; pointer-events: none; }
  #properties.is-exp .tle-props { display: none; }

  /* Two columns: a half-width hero (left, grows from the clicked card) with the
     gallery beneath it; the property detail flows in on the right. */
  .tle-pexp {
    position: relative; margin-top: 8px;
    display: grid; grid-template-columns: 1fr 1fr; gap: clamp(22px, 3vw, 52px);
    align-items: start;
  }
  .tle-pexp[hidden] { display: none; }
  @media (max-width: 820px) { .tle-pexp { grid-template-columns: 1fr; gap: 18px; } }
  .tle-pexp-x {
    position: absolute; z-index: 5; top: 14px; left: 14px; width: 46px; height: 46px;
    border-radius: 999px; border: 0; background: rgba(255,255,255,0.94); color: var(--ink);
    display: grid; place-items: center; cursor: pointer; box-shadow: 0 6px 18px -4px rgba(0,0,0,0.35);
    opacity: 0; transform: scale(0.8); transition: opacity .3s ease .5s, transform .3s ease .5s;
  }
  .tle-pexp-x svg { width: 19px; height: 19px; }
  .tle-pexp.is-open .tle-pexp-x { opacity: 1; transform: none; }

  .tle-pexp-main { min-width: 0; }
  /* Hero grows (FLIP) from the clicked card — JS sets the starting transform
     and plays it to identity; here we only define framing + the settle. */
  .tle-pexp-hero {
    position: relative; width: 100%; aspect-ratio: 3 / 2; overflow: hidden;
    background: var(--surface); border-radius: 14px; will-change: transform;
  }
  .tle-pexp-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tle-pexp-hero .tle-prop-tag { top: 16px; left: 16px; }

  /* Gallery sits beneath the hero, spanning the same (half) width. */
  .tle-pexp-thumbs {
    display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px;
    opacity: 0; transform: translateY(20px);
    transition: opacity .5s ease .4s, transform .6s cubic-bezier(.16, 1, .3, 1) .4s;
  }
  .tle-pexp.is-open .tle-pexp-thumbs { opacity: 1; transform: none; }
  /* Thumbnails are injected via JS (no Astro scope attr) — reach them with :global. */
  .tle-pexp-thumbs :global(.tle-pexp-thumb) {
    width: clamp(64px, 7vw, 104px); aspect-ratio: 4 / 3; overflow: hidden; padding: 0; cursor: pointer;
    border: 2px solid transparent; background: var(--surface); border-radius: 8px; transition: border-color .25s ease; flex: 0 0 auto;
  }
  .tle-pexp-thumbs :global(.tle-pexp-thumb img) { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tle-pexp-thumbs :global(.tle-pexp-thumb.is-active) { border-color: var(--red); }

  /* Detail column — vertically centred beside the hero, flows in just after. */
  .tle-pexp-info {
    align-self: center;
    opacity: 0; transform: translateY(24px);
    transition: opacity .5s ease .3s, transform .6s cubic-bezier(.16, 1, .3, 1) .3s;
  }
  .tle-pexp.is-open .tle-pexp-info { opacity: 1; transform: none; }
  .tle-pexp-area { font-size: clamp(22px, 2.2vw, 34px); font-weight: 700; letter-spacing: -0.01em; margin: 0 0 12px; }
  .tle-pexp-stats { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: clamp(16px, 1.8vw, 22px); }
  /* Stat pills are injected via JS — reach them with :global. */
  .tle-pexp-stats :global(span) { font-size: 13px; font-weight: 600; border: 1px solid var(--line); border-radius: 999px; padding: 7px 15px; }
  .tle-pexp-price { font-size: clamp(26px, 3vw, 40px); font-weight: 800; letter-spacing: -0.02em; color: var(--red); margin: 0 0 14px; }
  .tle-pexp-desc { font-size: 15px; line-height: 1.65; color: var(--grey); margin: 0 0 22px; }

  /* Red full stop on section headings. */
  .tle-dot { color: var(--red); }

  /* ---- Property preview modal (homepage cards) ---- */
  .tle-modal { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 20px; }
  .tle-modal[hidden] { display: none; }
  .tle-modal-backdrop { position: absolute; inset: 0; background: rgba(12,12,16,0.55); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); opacity: 0; transition: opacity .3s ease; }
  .tle-modal.is-open .tle-modal-backdrop { opacity: 1; }
  .tle-modal-card {
    position: relative; z-index: 1; width: min(980px, 96vw); max-height: 92vh; overflow: auto;
    background: #fff; border-radius: 26px; box-shadow: 0 60px 120px -40px rgba(0,0,0,0.65);
    transform: translateY(20px) scale(.95); opacity: 0;
    transition: transform .46s cubic-bezier(.34,1.5,.5,1), opacity .3s ease;
  }
  .tle-modal.is-open .tle-modal-card { transform: none; opacity: 1; }
  .tle-modal-x { position: absolute; z-index: 4; top: 22px; right: 22px; width: 42px; height: 42px; border-radius: 999px; border: 0; background: rgba(255,255,255,0.92); color: var(--ink); display: grid; place-items: center; cursor: pointer; box-shadow: 0 6px 18px -4px rgba(0,0,0,0.35); }
  .tle-modal-x svg { width: 19px; height: 19px; }
  /* White box; the image sits within it, with a glazed-glass panel over the
     bottom of the image (you can faintly see the photo through the frost). */
  .tle-modal-frame { padding: clamp(14px, 1.5vw, 22px); }
  .tle-modal-hero { position: relative; border-radius: 16px; overflow: hidden; aspect-ratio: 16 / 9.5; background: var(--surface); }
  .tle-modal-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tle-modal-hero .tle-prop-tag { top: 18px; left: 18px; }
  .tle-modal-glass {
    position: absolute; inset: auto 12px 12px 12px; z-index: 2;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 22px; flex-wrap: wrap;
    padding: clamp(18px, 2vw, 30px); border-radius: 14px; color: #fff;
    background: linear-gradient(to top, rgba(18,18,24,0.5), rgba(18,18,24,0.28));
    backdrop-filter: blur(18px) saturate(1.3); -webkit-backdrop-filter: blur(18px) saturate(1.3);
    border: 1px solid rgba(255,255,255,0.18);
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.3), 0 18px 40px -20px rgba(0,0,0,0.5);
  }
  .tle-modal-price { font-size: clamp(30px, 3.4vw, 46px); font-weight: 800; letter-spacing: -0.02em; line-height: 1; }
  .tle-modal-area { font-size: clamp(15px, 1.3vw, 18px); font-weight: 600; color: rgba(255,255,255,0.9); margin: 8px 0 14px; }
  .tle-modal-stats { display: flex; flex-wrap: wrap; gap: 8px; }
  .tle-modal-stats span { font-size: 12.5px; font-weight: 600; border: 1px solid rgba(255,255,255,0.32); border-radius: 999px; padding: 7px 15px; }
  .tle-modal-glass .tle-btn { flex: none; }

  /* ---- Future / book — editorial: a left label, a two-tone heading (black lead
     sentence, grey continuation), then a near-full-screen image that drifts on
     scroll for a gentle parallax. ---- */
  /* Scroll-over: the future section pins while 'A different approach' slides up
     over the top of it as a white card, adding depth. */
  .tle-overlap { position: relative; }
  .tle-future--pin { position: sticky; top: 0; z-index: 1; }
  .tle-over {
    position: relative; z-index: 2; background: #fff;
    border-radius: 36px 36px 0 0;
    box-shadow: 0 -34px 70px -26px rgba(0,0,0,0.22);
  }
  /* Services pins (its 'viewpoint' hold) once it has slid over the future. */
  .tle-over--pin { position: sticky; top: 0; }
  /* Testimonials sits above services so it slides over the pinned card. */
  .tle-over--2 { z-index: 3; }
  @media (max-width: 820px) {
    .tle-future--pin { position: relative; }
    .tle-over--pin { position: relative; }
    .tle-over { border-radius: 26px 26px 0 0; }
  }

  /* Full-height panel so the copy sits dead-centre when the section pins. */
  .tle-future {
    min-height: 100vh; box-sizing: border-box;
    display: flex; flex-direction: column; justify-content: center;
    padding: clamp(64px, 9vh, 130px) clamp(20px, 6vw, 110px);
  }
  /* Old formatting: label on the left, heading + button left-aligned on the
     right — but with the newer, larger type sizing. */
  .tle-future-head {
    display: grid; grid-template-columns: 0.3fr 0.7fr; gap: clamp(24px, 4vw, 60px);
    align-items: start; max-width: 1280px; margin: 0 auto; text-align: left;
  }
  .tle-future-label { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--red); padding-top: clamp(6px, 0.8vw, 12px); }
  .tle-future-h { font-size: clamp(27px, 4vw, 56px); font-weight: 600; letter-spacing: -0.02em; line-height: 1.12; margin: 0 0 clamp(28px, 3.4vw, 44px); }
  .tle-future-h .lead { color: var(--ink); }
  /* Grey body copy that fills to ink word-by-word as you scroll. */
  .tle-future-h .muted { display: block; margin-top: 10px; color: #cfcfd4; }
  .tle-future-h .muted .fw {
    color: transparent;
    background-image: linear-gradient(to right, var(--ink) 0%, var(--ink) var(--wf, 0%), #cfcfd4 var(--wf, 0%), #cfcfd4 100%);
    -webkit-background-clip: text; background-clip: text; background-clip: text;
  }
  .tle-future-head .tle-btn { margin: 0; }
  @media (max-width: 820px) { .tle-future-head { grid-template-columns: 1fr; } }
  /* Transparent scroll-room behind the pinned future (sits under it, static, so
     the pinned section holds in view a beat before the services card overlaps). */
  /* Roughly doubled so the words ink in over ~2–2.5 scrolls (slower read) and
     the section stays pinned a beat at the end with the copy fully filled. */
  .tle-future-hold { height: clamp(1000px, 185vh, 2000px); pointer-events: none; }
  /* Scroll-room behind the pinned services card so it holds in view a beat
     before testimonials overlaps (covered by the pinned card, so no empty gap). */
  .tle-services-hold { height: clamp(380px, 62vh, 760px); pointer-events: none; }
  @media (max-width: 820px) { .tle-services-hold { display: none; } }

  /* ---- "A different approach" — scroll-driven letter-shatter morph ---- */
  /* The plain fallback list shows until JS marks the section live. */
  .tle-morph-section { position: relative; }
  .tle-morph { display: none; height: clamp(21300px, 3733vh, 41300px); }
  .tle-morph-section.is-live .tle-morph { display: block; }
  .tle-morph-section.is-live .tle-morph-fallback { display: none; }
  .tle-morph-stage {
    position: sticky; top: 0; height: 100vh; overflow: hidden; background: #fff;
  }
  .tle-morph-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .tle-morph-copies { position: absolute; inset: 0; pointer-events: none; }
  .tle-morph-copy {
    position: absolute; top: 50%; right: clamp(24px, 8vw, 150px);
    transform: translateY(-46%); width: min(40%, 460px);
    opacity: 0; transition: opacity .45s ease, transform .55s cubic-bezier(.16, 1, .3, 1);
  }
  .tle-morph-copy.is-active { opacity: 1; transform: translateY(-50%); }
  .tle-morph-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--red); margin-bottom: 12px; }
  .tle-morph-h { font-size: clamp(26px, 3vw, 44px); font-weight: 700; letter-spacing: -0.02em; line-height: 1.08; margin: 0 0 14px; color: var(--ink); }
  .tle-morph-p { font-size: clamp(15px, 1.1vw, 17px); line-height: 1.6; color: var(--grey); margin: 0; }
  .tle-morph-fallback { padding-top: 8px; }
  /* The long pin is desktop-only — on small screens show the plain list. */
  @media (max-width: 820px) {
    .tle-morph-section.is-live .tle-morph { display: none; }
    .tle-morph-section.is-live .tle-morph-fallback { display: block; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tle-morph-section.is-live .tle-morph { display: none; }
    .tle-morph-section.is-live .tle-morph-fallback { display: block; }
  }

  /* ---- Services — two columns of three, revealed one-by-one on scroll ---- */
  .tle-services { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 6vw, 120px); align-items: start; }
  @media (max-width: 820px) { .tle-services { grid-template-columns: 1fr; gap: 0; } }
  .tle-services-col { display: flex; flex-direction: column; }
  /* As the white card scrolls up over the future, each service rises + fades in
     on its own as it reaches the viewpoint — breaking the block up on scroll. */
  #services .tle-service { transition: opacity .7s ease, transform .95s cubic-bezier(.16, 1, .3, 1); }
  #services .tle-service.tle-reveal:not(.is-in) { opacity: 0; transform: translateY(56px); }
  /* Each service is a list row: big faded number, then the copy. */
  .tle-service {
    display: grid; grid-template-columns: auto 1fr; gap: clamp(18px, 1.8vw, 30px);
    align-items: start; padding: clamp(24px, 2.6vw, 36px) 0;
    border-top: 1px solid var(--line);
  }
  .tle-services-col:first-child .tle-service:first-child,
  .tle-services-col:last-child .tle-service:first-child { border-top: none; }
  @media (max-width: 820px) { .tle-services-col:last-child .tle-service:first-child { border-top: 1px solid var(--line); } }
  .tle-service-n { font-size: clamp(26px, 2.4vw, 34px); font-weight: 800; line-height: 1; color: var(--red); opacity: 0.92; letter-spacing: -0.01em; }
  .tle-service-tx { min-width: 0; }
  .tle-service-h { font-size: clamp(19px, 1.7vw, 24px); font-weight: 700; margin: 2px 0 8px; }
  .tle-service-p { font-size: 14.5px; line-height: 1.55; color: var(--grey); margin: 0 0 16px; }

  /* Centred CTA under the testimonials. */
  .tle-reviews-cta { display: flex; justify-content: center; margin-top: clamp(36px, 4.5vw, 64px); }

  /* ---- Banner — a contained dark box (not a full-bleed red band); red is
     reserved for the CTA button inside it. ---- */
  .tle-banner { padding: clamp(20px, 4vw, 64px) clamp(20px, 6vw, 110px); }
  .tle-banner-box { background: var(--ink); color: #fff; border-radius: 22px; text-align: center; padding: clamp(48px, 6vw, 92px) clamp(24px, 5vw, 72px); display: flex; flex-direction: column; align-items: center; gap: 28px; }
  .tle-banner-h { font-size: clamp(26px, 3.6vw, 50px); font-weight: 800; letter-spacing: -0.02em; margin: 0; max-width: 18ch; line-height: 1.05; }

  /* ---- Testimonials ---- */
  .tle-quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2vw, 32px); }
  @media (max-width: 900px) { .tle-quotes { grid-template-columns: 1fr; } }
  .tle-quote { border: 1px solid var(--line); border-radius: 10px; padding: clamp(26px, 2.4vw, 36px); margin: 0; }
  .tle-quote-stars { color: var(--red); letter-spacing: 0.12em; margin-bottom: 16px; }
  .tle-quote blockquote { font-size: clamp(16px, 1.35vw, 19px); font-weight: 500; line-height: 1.5; margin: 0 0 22px; }
  .tle-quote figcaption { display: flex; flex-direction: column; gap: 2px; }
  .tle-quote figcaption strong { font-weight: 700; font-size: 14px; }
  .tle-quote figcaption span { font-size: 12px; color: var(--grey); }

  /* ---- Team — auto-rotating arc: centre face biggest, the rest trend down and
     shrink into a semi-circle, edges fade out. JS positions each member. ---- */
  .tle-team-arc {
    position: relative; height: clamp(400px, 48vh, 540px); margin-top: clamp(10px, 2vw, 26px);
    /* No mask here — it would clip the centre member's heavy drop shadow. The
       edges fade via each member's opacity falloff (set in JS) instead. */
    overflow: visible;
  }
  .tle-arc-member {
    position: absolute; left: 50%; top: 28%; width: clamp(128px, 13vw, 186px); margin-left: 0;
    transform-origin: 50% 50%;
    will-change: transform, opacity;
  }
  .tle-arc-photo {
    width: 100%; aspect-ratio: 1; border-radius: 20px; overflow: hidden;
    background: var(--surface); border: 1px solid var(--line);
    box-shadow: 0 26px 50px -28px rgba(0,0,0,0.35);
  }
  .tle-arc-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center top; display: block; }

  .tle-team-caption { position: relative; z-index: 3; text-align: center; margin-top: clamp(-46px, -3vw, -26px); min-height: 44px; }
  .tle-team-caption-name { font-size: 16px; font-weight: 700; margin: 0 0 3px; transition: opacity .3s ease; }
  .tle-team-caption-role { font-size: 13px; color: var(--red); font-weight: 600; transition: opacity .3s ease; }

  /* ---- Blog ---- */
  /* ---- Latest Articles — near edge-to-edge video with a rotating overlay ---- */
  #blog { padding-left: clamp(16px, 2vw, 30px); padding-right: clamp(16px, 2vw, 30px); }
  .tle-insights .tle-head { padding: 0 clamp(8px, 1vw, 16px); }
  .tle-artfeature { position: relative; border-radius: 22px; overflow: hidden; min-height: clamp(420px, 62vh, 680px); background: #1a1c22; }
  .tle-artbg { position: absolute; inset: 0; opacity: 0; transition: opacity .7s ease; }
  .tle-artbg.is-active { opacity: 1; }
  .tle-artbg video, .tle-artbg img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tle-artfeature-scrim { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.74) 0%, rgba(0,0,0,0.14) 46%, transparent 100%); }
  .tle-artfeature-content { position: absolute; inset: auto 0 0 0; z-index: 2; color: #fff; display: flex; align-items: flex-end; justify-content: space-between; gap: 30px; flex-wrap: wrap; padding: clamp(26px, 4vw, 56px); }
  .tle-artfeature-main { position: relative; flex: 1 1 540px; min-height: 200px; }
  .tle-artslide { position: absolute; inset: 0 0 auto 0; display: block; max-width: 640px; color: #fff; opacity: 0; transform: translateY(14px); pointer-events: none; transition: opacity .6s ease, transform .6s cubic-bezier(.16,1,.3,1); }
  .tle-artslide.is-active { opacity: 1; transform: none; pointer-events: auto; position: relative; }
  .tle-artpill { display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: 0.03em; background: rgba(255,255,255,0.16); border: 1px solid rgba(255,255,255,0.35); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); padding: 7px 16px; border-radius: 999px; margin-bottom: 18px; }
  .tle-arttitle { font-size: clamp(26px, 3.4vw, 46px); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; margin: 0 0 14px; text-shadow: 0 2px 30px rgba(0,0,0,0.4); }
  .tle-artsub { font-size: clamp(15px, 1.3vw, 18px); color: rgba(255,255,255,0.86); margin: 0; max-width: 54ch; }
  /* Filling pagination — a white pill stretches from the active dot toward the
     next as the timer runs, then bubbles over and collapses onto it. */
  .tle-artpag { position: relative; margin-top: 28px; height: 15px; }
  .tle-artpag-track { position: relative; display: flex; gap: 14px; width: max-content; height: 15px; align-items: center; }
  .tle-artpag-dot { width: 13px; height: 13px; padding: 0; border: 0; border-radius: 999px; background: rgba(255,255,255,0.4); cursor: pointer; position: relative; z-index: 1; }
  /* Gooey layer: the active pill reaches out toward the next dot while the next
     reaches back, the two meet in the middle and merge (surface-tension look)
     before settling onto the next dot. */
  .tle-artpag-goo {
    position: absolute; left: 0; top: 50%; height: 34px; width: 100%; margin-top: -17px;
    pointer-events: none; z-index: 2;
    filter: url(#tleArtGoo) drop-shadow(0 0 5px rgba(255,255,255,0.45));
  }
  .tle-artpag-blob {
    position: absolute; top: 50%; left: 0; width: 15px; height: 15px;
    border-radius: 999px; background: #fff; transform: translate(-50%, -50%);
    will-change: transform, width, height;
  }
  .tle-artfeature-meta { position: relative; text-align: right; align-self: flex-end; min-width: 130px; min-height: 44px; }
  .tle-artmeta { position: absolute; inset: auto 0 0 0; opacity: 0; transition: opacity .5s ease; }
  .tle-artmeta.is-active { opacity: 1; position: relative; }
  .tle-artmeta-date { font-size: 14px; font-weight: 700; }
  .tle-artmeta-read { font-size: 13px; color: rgba(255,255,255,0.78); margin-top: 4px; }
  @media (max-width: 760px) { .tle-artfeature-meta { display: none; } }

  /* ---- Accreditations ---- */
  .tle-accred { padding: clamp(40px, 4vw, 64px) clamp(20px, 6vw, 110px); border-top: 1px solid var(--line); text-align: center; }
  .tle-accred-label { font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--grey); margin-bottom: 26px; }
  .tle-accred-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: clamp(16px, 3vw, 48px); }
  .tle-accred-item { height: 56px; min-width: 130px; padding: 0 22px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line); border-radius: 6px; background: var(--surface); }
  .tle-accred-item span { font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: #9a9aa2; text-align: center; }

  /* ---- Footer ---- */
  /* ---- Footer — a white card on a soft-grey field, with a giant half-cut-off
     "experts" watermark across the bottom. ---- */
  .tle-footer { background: var(--surface); padding: clamp(20px, 3vw, 44px) clamp(14px, 3vw, 40px); }
  .tle-footer-card {
    position: relative; overflow: hidden; max-width: 1320px; margin: 0 auto;
    background: #fff; border: 1px solid var(--line); border-radius: 28px;
    box-shadow: 0 36px 90px -56px rgba(0,0,0,0.3);
    padding: clamp(32px, 4vw, 60px) clamp(28px, 4vw, 60px) clamp(96px, 13vw, 200px);
  }
  .tle-footer-grid { position: relative; z-index: 2; display: grid; grid-template-columns: 1.25fr 2fr; gap: clamp(30px, 5vw, 80px); }
  @media (max-width: 820px) { .tle-footer-grid { grid-template-columns: 1fr; } }
  .tle-footer-logo { display: inline-flex; align-items: center; gap: 11px; font-size: 19px; font-weight: 800; letter-spacing: -0.01em; color: var(--ink); }
  .tle-footer-mark { width: 30px; height: 30px; border-radius: 8px; background: var(--ink); color: #fff; display: grid; place-items: center; }
  .tle-footer-mark svg { width: 17px; height: 17px; }
  .tle-footer-brand p { font-size: 14px; color: var(--grey); margin: 18px 0 22px; max-width: 36ch; line-height: 1.6; }
  .tle-footer-socials { display: flex; gap: 16px; }
  .tle-footer-socials a { color: var(--ink); opacity: 0.85; transition: opacity .2s; }
  .tle-footer-socials a:hover { opacity: 1; color: var(--red); }
  .tle-footer-socials svg { width: 18px; height: 18px; display: block; }
  .tle-footer-cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  @media (max-width: 560px) { .tle-footer-cols { grid-template-columns: repeat(2, 1fr); } }
  .tle-footer-cols h4 { font-size: 14px; font-weight: 700; margin: 0 0 16px; color: var(--ink); }
  .tle-footer-cols a { display: block; font-size: 13.5px; color: var(--grey); margin-bottom: 11px; transition: color .2s; }
  .tle-footer-cols a:hover { color: var(--ink); }
  .tle-footer-rule { position: relative; z-index: 2; height: 1px; background: var(--line); margin: clamp(30px, 3.4vw, 48px) 0 22px; }
  .tle-footer-legal { position: relative; z-index: 2; display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; font-size: 12.5px; color: var(--grey); }
  .tle-footer-legal-links { display: flex; gap: 22px; flex-wrap: wrap; }
  .tle-footer-legal-links a { text-decoration: underline; transition: color .2s; }
  .tle-footer-legal-links a:hover { color: var(--ink); }
  .tle-footer-watermark {
    position: absolute; left: 0; right: 0; bottom: -0.34em; z-index: 1; text-align: center;
    font-size: clamp(120px, 25vw, 400px); font-weight: 800; letter-spacing: -0.03em; line-height: 0.8;
    color: rgba(20, 21, 26, 0.05); pointer-events: none; user-select: none; white-space: nowrap;
    -webkit-mask-image: linear-gradient(to bottom, #000 0%, #000 52%, transparent 76%);
    mask-image: linear-gradient(to bottom, #000 0%, #000 52%, transparent 76%);
  }
</style>

<script is:inline>
  /* Only decode videos while they're on screen — keeps the heavy clip from
     hammering the renderer when it's parked far down the page. */
  (function () {
    const vids = document.querySelectorAll("video");
    if (!vids.length || !("IntersectionObserver" in window)) return;
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { const p = e.target.play(); if (p && p.catch) p.catch(() => {}); }
        else { e.target.pause(); }
      });
    }, { threshold: 0.12 });
    vids.forEach((v) => io.observe(v));
  })();

  (function () {
    const els = document.querySelectorAll(".tle-reveal");
    if (!("IntersectionObserver" in window) || !els.length) {
      els.forEach((el) => el.classList.add("is-in"));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e, i) => {
        if (e.isIntersecting) {
          // gentle stagger for grouped items
          setTimeout(() => e.target.classList.add("is-in"), Math.min(i * 60, 240));
          io.unobserve(e.target);
        }
      });
    }, { threshold: 0.12, rootMargin: "0px 0px -8% 0px" });
    els.forEach((el) => io.observe(el));
  })();

  /* Properties — coordinated build-in animation (once on scroll-in). */
  (function () {
    const sec = document.getElementById("properties");
    if (!sec) return;
    if (!("IntersectionObserver" in window)) { sec.classList.add("props-in"); return; }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { sec.classList.add("props-in"); io.unobserve(e.target); }
      });
    }, { threshold: 0, rootMargin: "0px 0px -48% 0px" });
    io.observe(sec);
  })();

  /* Hero parallax — drive the wordmark shrink/sink, the button growth and the
     corner curve from a single scroll-progress var; fade the nav into focus. */
  (function () {
    const hero = document.querySelector(".tle-hero");
    const nav = document.querySelector(".tle-nav");
    if (!hero) return;
    const overlap = document.querySelector(".tle-overlap");
    const words = Array.prototype.slice.call(document.querySelectorAll(".tle-future-h .muted .fw"));
    let ticking = false, lastY = window.scrollY;
    function onScroll() {
      const y = window.scrollY;
      // The hero is min-height:100vh, so never trust a transiently-small
      // offsetHeight at load (it would falsely stick the nav at scroll 0).
      const h = Math.max(hero.offsetHeight || 0, window.innerHeight);
      const p = Math.min(Math.max(y / (h * 0.85), 0), 1);
      hero.style.setProperty("--p", p.toFixed(4));
      if (nav) {
        const navH = nav.offsetHeight || 64;
        // Stay see-through over the hero; focus to solid only once the next
        // section reaches the nav.
        nav.classList.toggle("is-stuck", y > h - navH - 4);
        // Auto-hide: hide while scrolling down (past the fold), show on scroll up.
        if (y > lastY + 4 && y > 140) nav.classList.add("is-hidden");
        else if (y < lastY - 4) nav.classList.remove("is-hidden");
      }
      // Scroll-fill the "Changing the future" body copy word by word while the
      // section is pinned (holds central; the words ink in as you scroll).
      if (overlap && words.length) {
        const ot = overlap.getBoundingClientRect().top;
        // Tie the fill to the hold spacer: the words finish inking in as you
        // scroll through the hold, just before the services card comes over.
        const hold = overlap.querySelector(".tle-future-hold");
        // Finish the fill at ~68% of the hold so the section visibly holds a
        // beat longer at the bottom (words done) before the services overlap.
        const range = hold ? Math.max(hold.offsetHeight * 0.68, 320) : window.innerHeight * 0.7;
        const prog = Math.min(Math.max((-ot - 40) / range, 0), 1);
        const reach = prog * (words.length + 2);
        for (let i = 0; i < words.length; i++) {
          const wf = Math.min(Math.max((reach - i) * 100, 0), 100);
          words[i].style.setProperty("--wf", wf.toFixed(0) + "%");
        }
      }
      lastY = y;
      ticking = false;
    }
    window.addEventListener("scroll", () => {
      if (!ticking) { ticking = true; requestAnimationFrame(onScroll); }
    }, { passive: true });
    window.addEventListener("resize", onScroll);
    window.addEventListener("load", onScroll);
    onScroll();
  })();

  /* Team — auto-rotating arc. Each member sits on a semi-circle: the centre is
     biggest and highest, the rest trend down and shrink, the edges fade. A
     floating "pos" advances over time so the whole arc rotates. */
  (function () {
    const arc = document.getElementById("tle-team-arc");
    if (!arc) return;
    const members = Array.prototype.slice.call(arc.querySelectorAll(".tle-arc-member"));
    const N = members.length;
    if (!N) return;
    const photos = members.map((el) => el.querySelector(".tle-arc-photo"));
    const capName = document.querySelector(".tle-team-caption-name");
    const capRole = document.querySelector(".tle-team-caption-role");
    const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    let pos = 0, target = 0, last = 0, lastStep = 0, lastCenter = -1, visible = true;

    function wrapD(i) {
      let d = (i - pos) % N;
      if (d > N / 2) d -= N;
      if (d < -N / 2) d += N;
      return d;
    }

    function layout() {
      const w = arc.clientWidth || 900;
      const R = Math.min(700, w * 0.56);   // horizontal amplitude — wider spread
      const Y = R * 0.46;                   // vertical drop amplitude — harsher arc
      const step = 0.4;                     // radians between neighbours
      let centerEl = null, centerAbs = Infinity;
      members.forEach((el, i) => {
        const d = wrapD(i);
        const ad = Math.abs(d);
        const a = d * step;
        const x = Math.sin(a) * R;
        const y = (1 - Math.cos(a)) * Y;
        // Centre is the showcase — much bigger and on top; the rest drop back to
        // clearly secondary (smaller + more faded) until the arc rotates to them.
        const scale = Math.max(0.28, 1.5 - ad * 0.46);
        const op = Math.max(0, Math.min(1, 1.28 - ad * 0.42));
        el.style.transform = "translate(-50%, 0) translate(" + x.toFixed(1) + "px, " + y.toFixed(1) + "px) scale(" + scale.toFixed(3) + ")";
        el.style.opacity = op.toFixed(2);
        el.style.zIndex = String(Math.round(100 - ad * 12));
        // Drop shadow: really heavy under the centre and reaching down onto the
        // caption (a defined contact line), lighter on each step out.
        const sh = Math.max(0, 1 - ad * 0.46);
        const ph = photos[i];
        if (ph) {
          const yo = (18 + sh * 60).toFixed(0);
          const bl = (22 + sh * 34).toFixed(0);
          const al = (0.1 + sh * 0.62).toFixed(2);
          ph.style.boxShadow = "0 " + yo + "px " + bl + "px -14px rgba(0,0,0," + al + ")";
        }
        if (ad < centerAbs) { centerAbs = ad; centerEl = el; }
      });
      const idx = centerEl ? +centerEl.dataset.i : 0;
      if (idx !== lastCenter && capName) {
        lastCenter = idx;
        capName.textContent = centerEl.dataset.name;
        capRole.textContent = centerEl.dataset.role;
      }
    }

    function frame(t) {
      if (!last) { last = t; lastStep = t; }
      last = t;
      if (visible && !reduce) {
        // Dwell on each agent for a beat, then ease across to the next.
        if (t - lastStep > 2600) { target += 1; lastStep = t; }
        pos += (target - pos) * 0.07;
      }
      layout();
      requestAnimationFrame(frame);
    }
    layout();
    requestAnimationFrame(frame);
    window.addEventListener("resize", layout);
    // Pause the rotation while the arc is off screen.
    if ("IntersectionObserver" in window) {
      new IntersectionObserver((es) => { es.forEach((e) => { visible = e.isIntersecting; }); }, { threshold: 0 }).observe(arc);
    }
  })();

  /* Property cards — click to expand in place: the others push off, then the
     clicked card opens into a full-width detail panel (image → thumbnails →
     price/description, each flowing in after the last). X reverses it. */
  (function () {
    const sec = document.getElementById("properties");
    const panel = document.getElementById("tle-pexp");
    if (!sec || !panel) return;
    const cards = Array.prototype.slice.call(sec.querySelectorAll(".tle-prop"));
    const $ = (id) => document.getElementById(id);
    let openIdx = -1, busy = false;

    function buildThumbs(images) {
      const wrap = $("tle-pexp-thumbs");
      wrap.innerHTML = "";
      if (images.length < 2) return;     // no strip for a single image
      images.forEach((src, i) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "tle-pexp-thumb" + (i === 0 ? " is-active" : "");
        b.innerHTML = '<img src="' + src + '" alt="" loading="lazy" />';
        b.addEventListener("click", () => {
          $("tle-pexp-img").src = src;
          wrap.querySelectorAll(".tle-pexp-thumb").forEach((t) => t.classList.remove("is-active"));
          b.classList.add("is-active");
        });
        wrap.appendChild(b);
      });
    }

    function openCard(card, idx) {
      if (busy || openIdx >= 0) return;
      busy = true; openIdx = idx;
      const d = card.dataset;
      let images = [];
      try { images = JSON.parse(d.images || "[]"); } catch (e) { images = [d.img]; }
      $("tle-pexp-img").src = images[0] || d.img;
      $("tle-pexp-img").alt = d.area;
      $("tle-pexp-tag").textContent = d.status;
      $("tle-pexp-area").textContent = d.area;
      $("tle-pexp-stats").innerHTML =
        "<span>" + d.beds + " bed</span><span>" + d.baths + " bath</span><span>" + d.size + "</span><span>" + d.type + "</span>";
      $("tle-pexp-price").textContent = d.pcm;
      $("tle-pexp-desc").textContent = d.blurb || "";
      $("tle-pexp-full").href = card.getAttribute("href");
      buildThumbs(images);

      const hero = panel.querySelector(".tle-pexp-hero");
      const media = card.querySelector(".tle-prop-media");
      // FLIP "First": where the clicked image sits right now.
      const r0 = media.getBoundingClientRect();

      // Push the neighbours aside (the focal card stays put as the anchor).
      cards.forEach((c, i) => {
        c.classList.remove("push-l", "push-r", "is-picked");
        if (i < idx) c.classList.add("push-l");
        else if (i > idx) c.classList.add("push-r");
      });

      // Let the neighbours clear, then collapse the grid and grow the hero out
      // of the clicked card's position (so it reads as the image expanding,
      // not a page swap).
      setTimeout(() => {
        sec.classList.add("is-exp");
        panel.hidden = false;
        // FLIP "Last": the hero's resting rect.
        const r1 = hero.getBoundingClientRect();
        const dx = r0.left - r1.left, dy = r0.top - r1.top;
        const sx = r1.width ? r0.width / r1.width : 1;
        const sy = r1.height ? r0.height / r1.height : 1;
        hero.style.transformOrigin = "top left";
        hero.style.transition = "none";
        hero.style.transform = "translate(" + dx + "px," + dy + "px) scale(" + sx + "," + sy + ")";
        // Commit the start frame (forced reflow), then play to identity — more
        // reliable than rAF, which can be throttled when the tab isn't painting.
        void hero.offsetWidth;
        hero.style.transition = "transform .62s cubic-bezier(.16, 1, .3, 1)";
        hero.style.transform = "none";
        panel.classList.add("is-open");
        setTimeout(() => { busy = false; }, 640);
      }, 340);
    }

    function close() {
      if (busy || openIdx < 0) return;
      busy = true;
      const hero = panel.querySelector(".tle-pexp-hero");
      panel.classList.remove("is-open");
      // Shrink the hero back toward its corner as the detail fades, then restore
      // the grid (the pushed cards slide back in).
      hero.style.transition = "transform .42s ease, opacity .42s ease";
      hero.style.transformOrigin = "top left";
      hero.style.transform = "scale(0.55)";
      hero.style.opacity = "0";
      setTimeout(() => {
        panel.hidden = true;
        hero.style.transition = "none";
        hero.style.transform = "none";
        hero.style.opacity = "";
        sec.classList.remove("is-exp");
        cards.forEach((c) => c.classList.remove("push-l", "push-r", "is-picked"));
        openIdx = -1; busy = false;
      }, 440);
    }

    cards.forEach((card, idx) => {
      card.addEventListener("click", (e) => { e.preventDefault(); openCard(card, idx); });
    });
    $("tle-pexp-x").addEventListener("click", close);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && openIdx >= 0) close(); });
  })();

  /* Latest Articles — rotate the featured article; each has its own background,
     and the pagination pill fills toward the next dot then bubbles over to it. */
  (function () {
    var slides = document.querySelectorAll(".tle-artslide");
    if (!slides.length) return;
    var metas = document.querySelectorAll(".tle-artmeta");
    var bgs = document.querySelectorAll(".tle-artbg");
    var dots = Array.prototype.slice.call(document.querySelectorAll(".tle-artpag-dot"));
    var left = document.getElementById("tle-artpag-tail");   // reaches out from the current dot
    var right = document.getElementById("tle-artpag-head");  // reaches back from the next dot
    var N = slides.length;
    var DWELL = 4600, BASE = 15, HOLD = 0.6;
    var cur = 0, elapsed = 0, lastT = 0, visible = true;

    function show(n) {
      cur = (n + N) % N;
      slides.forEach(function (s, i) { s.classList.toggle("is-active", i === cur); });
      metas.forEach(function (s, i) { s.classList.toggle("is-active", i === cur); });
      bgs.forEach(function (s, i) { s.classList.toggle("is-active", i === cur); });
      dots.forEach(function (d, i) { d.classList.toggle("is-active", i === cur); });
    }
    function centerOf(i) { return dots[i].offsetLeft + dots[i].offsetWidth / 2; }
    function ease(p) { return 1 - Math.pow(1 - p, 3); }
    // Draw a pill spanning x1..x2 (rounded ends via border-radius); h is its
    // thickness — pass 0 to hide it.
    function pill(el, x1, x2, h) {
      var lo = Math.min(x1, x2), hi = Math.max(x1, x2);
      var w = Math.max(hi - lo, h);
      el.style.left = ((lo + hi) / 2).toFixed(1) + "px";
      el.style.width = w.toFixed(1) + "px";
      el.style.height = h.toFixed(1) + "px";
    }

    function frame(t) {
      if (!lastT) lastT = t;
      var dt = t - lastT; lastT = t;
      if (visible) elapsed += dt;
      var p = Math.min(elapsed / DWELL, 1);
      var ac = centerOf(cur), nc = centerOf((cur + 1) % N), mid = (ac + nc) / 2;
      if (p < HOLD) {
        // Resting: a single white pill on the current dot.
        pill(left, ac, ac, BASE);
        pill(right, ac, ac, 0);
      } else {
        var m = (p - HOLD) / (1 - HOLD);
        if (m <= 0.55) {
          // Reach: current pill stretches toward the middle, the next dot
          // bulges out and reaches back — they approach and the goo fuses them.
          var e1 = ease(m / 0.55);
          pill(left, ac, ac + (mid - ac) * e1, BASE);
          pill(right, nc - (nc - mid) * e1, nc, BASE * Math.min(1, m / 0.16));
        } else {
          // Merge & settle: the joined mass consolidates onto the next dot.
          var e2 = ease((m - 0.55) / 0.45);
          pill(left, ac + (nc - ac) * e2, mid + (nc - mid) * e2, BASE);
          pill(right, mid + (nc - mid) * e2, nc, BASE);
        }
      }
      if (p >= 1) { show((cur + 1) % N); elapsed = 0; }
      requestAnimationFrame(frame);
    }

    dots.forEach(function (d, i) { d.addEventListener("click", function () { show(i); elapsed = 0; }); });
    show(0);
    // Seat the pill on the first dot before the first frame (no top-left flash).
    var c0 = centerOf(0);
    pill(left, c0, c0, BASE); pill(right, c0, c0, 0);
    requestAnimationFrame(frame);
    if ("IntersectionObserver" in window) {
      var feat = document.querySelector(".tle-artfeature");
      if (feat) new IntersectionObserver(function (es) { es.forEach(function (e) { visible = e.isIntersecting; }); }, { threshold: 0 }).observe(feat);
    }
  })();

  /* "A different approach" — scroll-driven letter-shatter morph. The title is
     sampled into a cloud of red shards which scatter and re-gather into an icon
     for each of the six services as you scroll. Pure canvas; desktop only;
     reduced-motion + mobile fall back to the plain list (handled in CSS). */
  (function () {
    var sec = document.getElementById("services");
    if (!sec || !sec.classList.contains("tle-morph-section")) return;
    var stage = document.getElementById("tle-morph-stage");
    var canvas = document.getElementById("tle-morph-canvas");
    if (!stage || !canvas) return;
    var reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (reduce || (window.matchMedia && window.matchMedia("(max-width: 820px)").matches)) return;

    var ctx = canvas.getContext("2d");
    if (!ctx) return;
    sec.classList.add("is-live");

    var RED = (getComputedStyle(document.documentElement).getPropertyValue("--red") || "#e8442f").trim() || "#e8442f";
    var N = 3000;                      // burst shards (rest states draw SOLID, so N only feeds the explosion)
    var STATES = 7;                    // title + 6 icons
    var HOLD = 0.42;                   // fraction of each step the shape holds solid
    var W = 0, H = 0, DPR = 1;
    var icx = 0, icy = 0, isz = 0;     // icon box centre + size (sits left of the copy)
    var bmps = [];                     // [state] -> offscreen SOLID red render (gapless)
    var pts = [];                      // [state] -> Float32Array(2N) burst sample points (css px)
    var scatter = new Float32Array(2 * N);
    var baseRot = new Float32Array(N), spin = new Float32Array(N), size = new Float32Array(N);
    var copies = Array.prototype.slice.call(stage.querySelectorAll(".tle-morph-copy"));
    var seeded = false, lastState = -2, ticking = false;

    function rnd(a, b) { return a + Math.random() * (b - a); }
    function ease(t) { return t < 0.5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; }

    // ---- Icon silhouettes (filled), drawn into an offscreen ctx at (cx,cy,s) ----
    function house(c, cx, cy, s) {
      c.beginPath();
      c.moveTo(cx - 0.46 * s, cy - 0.04 * s); c.lineTo(cx, cy - 0.46 * s); c.lineTo(cx + 0.46 * s, cy - 0.04 * s); c.closePath(); c.fill();
      c.fillRect(cx - 0.32 * s, cy - 0.06 * s, 0.64 * s, 0.46 * s);
    }
    function coin(c, cx, cy, s) {
      c.beginPath(); c.arc(cx, cy, 0.42 * s, 0, Math.PI * 2); c.fill();
      c.save(); c.globalCompositeOperation = "destination-out";
      c.fillStyle = "#000"; c.textAlign = "center"; c.textBaseline = "middle";
      c.font = "700 " + (0.6 * s) + "px Georgia, serif"; c.fillText("£", cx, cy + 0.02 * s);
      c.restore();
    }
    function magnifier(c, cx, cy, s) {
      // A clear ring (annulus) with a straight handle coming out of the bottom
      // right — a recognisable magnifying glass.
      var gx = cx - 0.07 * s, gy = cy - 0.16 * s, ro = 0.27 * s;
      c.beginPath(); c.arc(gx, gy, ro, 0, Math.PI * 2); c.fill();
      c.save(); c.globalCompositeOperation = "destination-out";
      c.beginPath(); c.arc(gx, gy, 0.175 * s, 0, Math.PI * 2); c.fill();
      c.restore();
      c.save(); c.translate(gx, gy); c.rotate(Math.PI / 4);
      c.fillRect(-0.058 * s, ro - 0.03 * s, 0.116 * s, 0.46 * s);
      c.restore();
    }
    function shield(c, cx, cy, s) {
      c.beginPath();
      c.moveTo(cx - 0.34 * s, cy - 0.36 * s); c.lineTo(cx + 0.34 * s, cy - 0.36 * s);
      c.lineTo(cx + 0.34 * s, cy + 0.04 * s);
      c.quadraticCurveTo(cx + 0.30 * s, cy + 0.34 * s, cx, cy + 0.46 * s);
      c.quadraticCurveTo(cx - 0.30 * s, cy + 0.34 * s, cx - 0.34 * s, cy + 0.04 * s);
      c.closePath(); c.fill();
    }
    function gear(c, cx, cy, s) {
      var teeth = 9, ro = 0.46 * s, ri = 0.33 * s;
      for (var i = 0; i < teeth; i++) {
        var a = (i / teeth) * Math.PI * 2;
        c.save(); c.translate(cx, cy); c.rotate(a);
        c.fillRect(-0.09 * s, ri - 0.02 * s, 0.18 * s, (ro - ri) + 0.06 * s);
        c.restore();
      }
      c.beginPath(); c.arc(cx, cy, ri, 0, Math.PI * 2); c.fill();
      c.save(); c.globalCompositeOperation = "destination-out";
      c.beginPath(); c.arc(cx, cy, 0.15 * s, 0, Math.PI * 2); c.fillStyle = "#000"; c.fill(); c.restore();
    }
    function chat(c, cx, cy, s) {
      var x = cx - 0.42 * s, y = cy - 0.36 * s, w = 0.84 * s, h = 0.56 * s, r = 0.14 * s;
      c.beginPath();
      c.moveTo(x + r, y); c.arcTo(x + w, y, x + w, y + h, r); c.arcTo(x + w, y + h, x, y + h, r);
      c.arcTo(x, y + h, x, y, r); c.arcTo(x, y, x + w, y, r); c.closePath(); c.fill();
      c.beginPath(); c.moveTo(cx - 0.28 * s, cy + 0.20 * s); c.lineTo(cx - 0.10 * s, cy + 0.20 * s); c.lineTo(cx - 0.30 * s, cy + 0.44 * s); c.closePath(); c.fill();
    }
    var ICONS = [house, coin, magnifier, shield, gear, chat];

    // Draw state `idx` with the current fillStyle: 0 = the title words, 1–6 = icons.
    function drawShape(c, idx) {
      if (idx === 0) {
        c.textAlign = "center"; c.textBaseline = "middle";
        // Inter, regular weight, ~65% of the old size — calmer, less in-your-face.
        var fs = Math.min(W / 8.5, H / 4.4) * 0.65;
        c.font = "400 " + fs + "px Inter, system-ui, sans-serif";
        var lines = ["A different", "approach", "to lettings"], lh = fs * 1.16, y0 = H / 2 - lh;
        for (var i = 0; i < lines.length; i++) c.fillText(lines[i], W / 2, y0 + i * lh);
      } else {
        ICONS[idx - 1](c, icx, icy, isz);
      }
    }

    // Build the SOLID red bitmap (gapless) + a set of burst sample points for one
    // state. The bitmap is what shows at rest; the points feed the explosion.
    function buildState(idx) {
      var sw = Math.max(2, Math.floor(W)), sh = Math.max(2, Math.floor(H));
      var oc = document.createElement("canvas"); oc.width = sw; oc.height = sh;
      var o = oc.getContext("2d"); o.clearRect(0, 0, sw, sh); o.fillStyle = RED;
      drawShape(o, idx);
      bmps[idx] = oc;
      var data = o.getImageData(0, 0, sw, sh).data, p = [];
      for (var y = 0; y < sh; y += 2) for (var x = 0; x < sw; x += 2) if (data[(y * sw + x) * 4 + 3] > 100) p.push(x, y);
      var count = p.length / 2, out = new Float32Array(2 * N);
      if (!count) { for (var k = 0; k < N; k++) { out[2 * k] = W / 2; out[2 * k + 1] = H / 2; } pts[idx] = out; return; }
      var ix = []; for (var j = 0; j < count; j++) ix.push(j);
      for (var m = count - 1; m > 0; m--) { var q = (Math.random() * (m + 1)) | 0, tm = ix[m]; ix[m] = ix[q]; ix[q] = tm; }
      for (var i2 = 0; i2 < N; i2++) { var pj = ix[i2 % count]; out[2 * i2] = p[2 * pj]; out[2 * i2 + 1] = p[2 * pj + 1]; }
      pts[idx] = out;
    }

    function buildFormations() {
      icx = W * 0.36; icy = H * 0.5; isz = Math.min(W * 0.5, H) * 0.74;
      bmps = []; pts = [];
      for (var i = 0; i < STATES; i++) buildState(i);
    }

    function seedShards() {
      var maxD = Math.min(W, H) * 0.62;
      for (var i = 0; i < N; i++) {
        var a = rnd(0, Math.PI * 2), d = rnd(0.12, 1) * maxD;
        scatter[2 * i] = Math.cos(a) * d; scatter[2 * i + 1] = Math.sin(a) * d;
        baseRot[i] = rnd(0, Math.PI * 2); spin[i] = rnd(-3.2, 3.2); size[i] = rnd(3.2, 6.4);
      }
      seeded = true;
    }

    function resize() {
      var r = stage.getBoundingClientRect();
      W = r.width || stage.clientWidth; H = r.height || stage.clientHeight;
      if (!W || !H) return;
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      canvas.width = Math.floor(W * DPR); canvas.height = Math.floor(H * DPR);
      ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
      if (!seeded) seedShards();
      buildFormations();
      render();
    }

    function setCopy(state) {
      if (state === lastState) return;
      lastState = state;
      for (var i = 0; i < copies.length; i++) copies[i].classList.toggle("is-active", +copies[i].dataset.state === state);
    }

    function render() {
      if (!W || !H || !bmps.length) return;
      var rect = sec.getBoundingClientRect();
      var total = sec.offsetHeight - stage.offsetHeight;
      var p = total > 0 ? Math.min(Math.max(-rect.top / total, 0), 1) : 0;
      ctx.clearRect(0, 0, W, H);

      var sp = p * (STATES - 1);
      var u = Math.min(STATES - 2, Math.floor(sp));
      var frac = sp - u;

      if (frac < HOLD) {
        // At rest: draw the SOLID shape/word — a complete, gapless image.
        ctx.globalAlpha = 1; ctx.drawImage(bmps[u], 0, 0, W, H);
        setCopy(u);
        return;
      }

      // Transition u → u+1: solid A dissolves into shards (same coords, so no
      // jump), the shards burst out and re-gather, then resolve into solid B.
      var lp = (frac - HOLD) / (1 - HOLD);
      var kIn = Math.min(lp / 0.16, 1);             // shards take over from solid A
      var kOut = Math.max(0, (lp - 0.84) / 0.16);   // solid B takes over from shards
      var pAlpha = Math.min(kIn, 1 - kOut);
      var solidA = 1 - kIn, solidB = kOut;
      var ep = Math.min(Math.max((lp - 0.16) / 0.68, 0), 1);
      var t = ease(ep), scat = Math.sin(ep * Math.PI);

      if (solidA > 0.001) { ctx.globalAlpha = solidA; ctx.drawImage(bmps[u], 0, 0, W, H); }
      if (solidB > 0.001) { ctx.globalAlpha = solidB; ctx.drawImage(bmps[u + 1], 0, 0, W, H); }
      if (pAlpha > 0.001) {
        var A = pts[u], B = pts[u + 1];
        ctx.globalAlpha = pAlpha; ctx.fillStyle = RED;
        for (var i = 0; i < N; i++) {
          var x = A[2 * i] + (B[2 * i] - A[2 * i]) * t + scatter[2 * i] * scat;
          var y = A[2 * i + 1] + (B[2 * i + 1] - A[2 * i + 1]) * t + scatter[2 * i + 1] * scat;
          var s = size[i], rot = baseRot[i] + scat * spin[i];
          ctx.save(); ctx.translate(x, y); ctx.rotate(rot);
          ctx.fillRect(-s / 2, -s / 2, s, s * 0.66);
          ctx.restore();
        }
      }
      ctx.globalAlpha = 1;
      setCopy(lp < 0.5 ? u : u + 1);
    }

    function onScroll() { if (!ticking) { ticking = true; requestAnimationFrame(function () { render(); ticking = false; }); } }

    resize();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", resize);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(resize);
    // The title is drawn to canvas, which won't trigger the webfont download —
    // request Inter explicitly, then re-render so it samples the real glyphs.
    if (document.fonts && document.fonts.load) {
      document.fonts.load("400 80px Inter").then(resize).catch(function () {});
    }
    window.addEventListener("load", resize);
  })();
</script>
