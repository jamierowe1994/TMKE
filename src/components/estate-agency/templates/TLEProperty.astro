---
// THE LETTING EXPERTS — single-property feature page. A big, gallery-led layout
// (à la findrealestate.com): address + actions, a wide hero, headline figures,
// a large image slider, an "About this home" block (amenities + description),
// a feature image, a photo gallery, an "Other details" block and a map.
import { PROPERTIES } from "../../../data/tle-properties.js";

interface Props {
  property: (typeof PROPERTIES)[number];
}
const { property } = Astro.props;
const HOME = "/estate-agency/preview/tle";
const { slug, address, locality, type, beds, baths, size, pcm, status, available, images, lat, lng } = property;
const town = locality.split(",")[0].trim();

const U = (id, w = 1600, h = 1100) =>
  `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${w}&h=${h}&q=80`;

// Shared interior stock to flesh out the gallery for the concept.
const INTERIORS = [
  U("1556911220-bff31c812dba"), U("1556228453-efd6c1ff04f6"), U("1560185007-cde436f6a4d0"),
  U("1522708323590-d24dbb6b0267"), U("1505691938895-1758d7feb511"), U("1484154218962-a197022b5858"),
  U("1502005229762-cf1b2da7c5d6"), U("1493809842364-78817add7ffb"),
];
const gallery = images.concat(INTERIORS);

const isFlat = type === "Flat" || type === "Apartment";
const amenities = [
  isFlat ? "Allocated Parking" : "Private Garden",
  "Dishwasher", "Hardwood Floors", "Fitted Kitchen",
  isFlat ? "Lift Access" : "Off-street Parking",
  "Double Glazing", "Gas Central Heating", "EPC Rating B",
];

const details = [
  { k: "Property Type", v: type },
  { k: "Square Footage", v: size },
  { k: "Furnishing", v: "Furnished" },
  { k: "Available From", v: "Now" },
  { k: "Parking", v: isFlat ? "Allocated" : "Driveway" },
  { k: "Garden", v: isFlat ? "No" : "Yes" },
];

const baths_w = baths === 1 ? "Bath" : "Baths";
const beds_w = beds === 1 ? "Bed" : "Beds";
---

<div class="tlp-root">
  <!-- Nav -->
  <header class="tlp-nav">
    <a class="tlp-logo" href={HOME}>The&nbsp;Letting&nbsp;<span>Experts</span></a>
    <nav class="tlp-nav-links">
      <a href="/estate-agency/preview/tle-search">Search</a>
      <a href={`${HOME}#team`}>Agents</a>
      <a href={`${HOME}#services`}>Landlords</a>
      <a href={`${HOME}#reviews`}>About</a>
    </nav>
    <a class="tlp-contact" href={`${HOME}#book`}>Contact Us</a>
  </header>

  <div class="tlp-wrap">
    <!-- Title -->
    <div class="tlp-titlerow">
      <h1 class="tlp-title">{address}, <span class="muted">{locality}</span></h1>
      <button type="button" class="tlp-compare" aria-label="Compare">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7h6M7 4v6M14 8h6M4 17h6M14 14h6M17 11v6" /></svg>
      </button>
    </div>
    <hr class="tlp-divider" />

    <!-- Pills + actions -->
    <div class="tlp-actionsrow">
      <div class="tlp-pills">
        <span class={`tlp-pill tlp-pill--status${available ? " is-available" : ""}`}>
          <i class="tlp-dot"></i>{available ? "Available" : "Let agreed"}
        </span>
        <span class="tlp-pill">To Let</span>
      </div>
      <div class="tlp-actions">
        <a href={`${HOME}#book`} class="tlp-schedule">Schedule Viewing
          <svg viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 7h17M12 1l6 6-6 6" /></svg>
        </a>
        <button type="button" class="tlp-circle" aria-label="Send email">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m22 2-7 20-4-9-9-4Z" /><path d="M22 2 11 13" /></svg>
        </button>
        <a href="#" class="tlp-circle" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M21 11.5a8.5 8.5 0 0 1-12.2 7.6L3 21l1.9-5.8A8.5 8.5 0 1 1 21 11.5Z" /></svg>
        </a>
      </div>
    </div>

    <!-- Hero image -->
    <div class="tlp-hero"><img src={images[0]} alt={`${address}, ${locality}`} /></div>

    <!-- Figures -->
    <div class="tlp-figures">
      <div class="tlp-price">{pcm}</div>
      <div class="tlp-stats">
        <div class="tlp-stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 18v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5M3 18h18M3 18v2M21 18v2M6 11V8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v3" /></svg><b>{beds} {beds_w}</b></div>
        <div class="tlp-stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 12h16v3a4 4 0 0 1-4 4H8a4 4 0 0 1-4-4v-3ZM6 12V6a2 2 0 0 1 2-2 2 2 0 0 1 2 2M7 19l-1 2M18 19l1 2" /></svg><b>{baths} {baths_w}</b></div>
        <div class="tlp-stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 9V4h5M20 15v5h-5M4 4l6 6M20 20l-6-6" /></svg><b>{size}</b></div>
        <div class="tlp-stat"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M3 21h18M5 21V8l7-4 7 4v13M9 21v-6h6v6" /></svg><b>{type}</b></div>
      </div>
    </div>

    <!-- Image slider -->
    <section class="tlp-slider" id="tlp-slider">
      <div class="tlp-slider-track" id="tlp-track">
        {gallery.map((g, i) => (
          <div class="tlp-slide"><img src={g} alt={`${address} — photo ${i + 1}`} loading="lazy" /><span class="tlp-credit">The Letting Experts</span></div>
        ))}
      </div>
      <div class="tlp-slider-foot">
        <div class="tlp-counter"><b id="tlp-cur">01</b> <span>/ {String(gallery.length).padStart(2, "0")}</span></div>
        <div class="tlp-progress"><span id="tlp-bar"></span></div>
        <div class="tlp-arrows">
          <button type="button" id="tlp-prev" aria-label="Previous"><svg viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M19 7H2M8 1 1 7l7 6" /></svg></button>
          <button type="button" id="tlp-next" aria-label="Next" class="is-dark"><svg viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M1 7h17M12 1l6 6-6 6" /></svg></button>
        </div>
      </div>
    </section>

    <!-- About this home -->
    <section class="tlp-block">
      <div class="tlp-block-head"><h2>About<br /><span>this home</span></h2></div>
      <div class="tlp-block-body">
        <div class="tlp-amenities">
          {amenities.map((a) => <span class="tlp-amenity">{a}</span>)}
        </div>
        <div class="tlp-desc">
          <p>An immaculately presented {beds}-bedroom {type.toLowerCase()} offered to let by The Letting Experts in the heart of {town}. The property briefly comprises {beds} well-proportioned bedrooms, {baths} {baths === 1 ? "bathroom" : "bathrooms"}, a bright open-plan living and dining space and a modern fitted kitchen with integrated appliances.</p>
          <p>Finished to a high standard throughout, the home benefits from generous natural light, ample storage and a low-maintenance layout — ideal for professionals and families alike. {isFlat ? "Secure entry and allocated parking complete the package." : "A private garden and off-street parking complete the package."}</p>
          <p>Located within easy reach of local shops, schools, transport links and green space, {town} offers the perfect balance of convenience and community. Available now on a fully-managed basis with rent guarantee and legal protection built in. Early viewing is highly recommended.</p>
        </div>
      </div>
    </section>

    <!-- Feature image -->
    <div class="tlp-feature"><img src={gallery[1] || images[0]} alt={`${address} — feature`} loading="lazy" /></div>

    <!-- Gallery -->
    <section class="tlp-gallery">
      {gallery.slice(2, 8).map((g, i) => (
        <div class={`tlp-gcell${i === 0 ? " tlp-gcell--wide" : ""}`}><img src={g} alt={`${address} — gallery ${i + 1}`} loading="lazy" /></div>
      ))}
    </section>

    <!-- Other details -->
    <section class="tlp-block">
      <div class="tlp-block-head"><h2>Other<br /><span>details</span></h2></div>
      <div class="tlp-block-body">
        <div class="tlp-details">
          {details.map((d) => (
            <div class="tlp-detail"><div class="tlp-detail-k">{d.k}</div><div class="tlp-detail-v">{d.v}</div></div>
          ))}
        </div>
      </div>
    </section>

    <!-- Map -->
    <section class="tlp-maprow">
      <div class="tlp-block-head"><h2>On the<br /><span>map</span></h2></div>
      <div class="tlp-map" id="tlp-map"></div>
    </section>

    <a href="/estate-agency/preview/tle-search" class="tlp-back">&larr; Back to search</a>
  </div>
</div>

<script is:inline define:vars={{ lat, lng, slug, pcm, area: `${address}, ${locality}` }}>
  (function () {
    /* ---- Slider ---- */
    var track = document.getElementById("tlp-track");
    if (track) {
      var slides = track.querySelectorAll(".tlp-slide");
      var curEl = document.getElementById("tlp-cur");
      var bar = document.getElementById("tlp-bar");
      function step() { return slides[0] ? slides[0].getBoundingClientRect().width + 16 : 400; }
      function update() {
        var max = track.scrollWidth - track.clientWidth;
        var pct = max > 0 ? track.scrollLeft / max : 0;
        bar.style.width = (8 + pct * 92) + "%";
        var idx = Math.round(track.scrollLeft / step()) + 1;
        idx = Math.max(1, Math.min(slides.length, idx));
        curEl.textContent = String(idx).padStart(2, "0");
      }
      document.getElementById("tlp-prev").addEventListener("click", function () { track.scrollBy({ left: -step(), behavior: "smooth" }); });
      document.getElementById("tlp-next").addEventListener("click", function () { track.scrollBy({ left: step(), behavior: "smooth" }); });
      track.addEventListener("scroll", function () { window.requestAnimationFrame(update); }, { passive: true });
      update();
    }

    /* ---- Map ---- */
    function initMap() {
      var L = window.L;
      var map = L.map("tlp-map", { scrollWheelZoom: false }).setView([lat, lng], 14);
      L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png", { attribution: "&copy; OpenStreetMap &copy; CARTO", subdomains: "abcd", maxZoom: 19 }).addTo(map);
      var icon = L.divIcon({ className: "tls-pinwrap", html: '<span class="tls-pin"></span>', iconSize: [22, 30], iconAnchor: [11, 30] });
      L.marker([lat, lng], { icon: icon }).addTo(map);
    }
    function loadLeaflet() {
      if (window.L) return initMap();
      var css = document.createElement("link"); css.rel = "stylesheet"; css.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"; document.head.appendChild(css);
      var s = document.createElement("script"); s.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"; s.onload = initMap; document.head.appendChild(s);
    }
    loadLeaflet();
  })();
</script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&display=swap');

  .tlp-root {
    --red: #e31f36; --ink: #16171a; --grey: #6e6e76; --line: #e7e7ea; --surface: #f4f4f5; --green: #18a558;
    font-family: "Montserrat", system-ui, sans-serif; color: var(--ink); background: #fff;
    -webkit-font-smoothing: antialiased; line-height: 1.5;
  }
  .tlp-root *, .tlp-root *::before, .tlp-root *::after { box-sizing: border-box; }
  .tlp-root a { color: inherit; text-decoration: none; }

  /* Nav */
  .tlp-nav {
    position: sticky; top: 0; z-index: 30; height: 64px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: 0 clamp(18px, 4vw, 44px); background: #fff; border-bottom: 1px solid var(--line);
  }
  .tlp-logo { font-weight: 800; font-size: 17px; letter-spacing: -0.01em; }
  .tlp-logo span { color: var(--red); }
  .tlp-nav-links { display: flex; gap: 26px; }
  .tlp-nav-links a { font-size: 14px; font-weight: 500; color: var(--grey); transition: color .2s; }
  .tlp-nav-links a:hover { color: var(--ink); }
  .tlp-nav .tlp-contact { font-size: 13px; font-weight: 700; color: #fff; background: var(--red); padding: 11px 24px; border-radius: 999px; transition: background .2s, transform .2s; }
  .tlp-nav .tlp-contact:hover { background: var(--ink); transform: translateY(-1px); }
  @media (max-width: 760px) { .tlp-nav-links { display: none; } }

  /* Wider page — comes out to ~82% of the viewport. */
  .tlp-wrap { width: 82%; max-width: 1680px; margin: 0 auto; padding: clamp(24px, 4vw, 44px) 0 80px; }

  /* Title */
  .tlp-titlerow { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .tlp-title { font-size: clamp(26px, 4vw, 52px); font-weight: 800; letter-spacing: -0.02em; line-height: 1.05; margin: 0; }
  .tlp-title .muted { color: var(--grey); font-weight: 700; }
  .tlp-compare { flex: none; width: 46px; height: 46px; border-radius: 999px; border: 1px solid var(--line); background: #fff; color: var(--ink); display: grid; place-items: center; cursor: pointer; transition: border-color .2s, background .2s; }
  .tlp-compare:hover { border-color: var(--ink); background: var(--surface); }
  .tlp-compare svg { width: 20px; height: 20px; }
  .tlp-divider { border: 0; border-top: 1px solid var(--line); margin: clamp(20px, 2.4vw, 30px) 0 clamp(22px, 2.6vw, 32px); }

  /* Pills + actions */
  .tlp-actionsrow { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; margin-bottom: clamp(22px, 2.8vw, 34px); }
  .tlp-pills { display: flex; gap: 10px; flex-wrap: wrap; }
  .tlp-pill { display: inline-flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 8px 16px; }
  .tlp-pill--status { color: var(--grey); }
  .tlp-pill--status.is-available { color: var(--green); border-color: rgba(24,165,88,0.4); }
  .tlp-dot { width: 7px; height: 7px; border-radius: 999px; background: var(--grey); }
  .tlp-pill--status.is-available .tlp-dot { background: var(--green); }
  .tlp-actions { display: flex; align-items: center; gap: 12px; }
  .tlp-schedule { display: inline-flex; align-items: center; gap: 12px; font-size: 14px; font-weight: 700; color: #fff; background: var(--ink); border-radius: 999px; padding: 15px 26px; transition: background .2s, transform .2s; }
  .tlp-schedule:hover { background: var(--red); transform: translateY(-1px); }
  .tlp-schedule svg { width: 19px; height: 13px; }
  .tlp-circle { width: 48px; height: 48px; border-radius: 999px; border: 1px solid var(--line); background: #fff; color: var(--ink); display: grid; place-items: center; cursor: pointer; transition: background .2s, color .2s, border-color .2s; }
  .tlp-circle:hover { background: var(--red); color: #fff; border-color: var(--red); }
  .tlp-circle svg { width: 19px; height: 19px; }

  /* Hero image — barely-rounded corners. */
  .tlp-hero { border-radius: 5px; overflow: hidden; background: var(--surface); aspect-ratio: 16 / 8.5; }
  .tlp-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Figures */
  .tlp-figures { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; padding: clamp(26px, 3vw, 40px) 0 clamp(8px, 1vw, 14px); border-bottom: 1px solid var(--line); }
  .tlp-price { font-size: clamp(34px, 5vw, 64px); font-weight: 800; letter-spacing: -0.02em; }
  .tlp-stats { display: flex; gap: clamp(28px, 4vw, 64px); flex-wrap: wrap; }
  .tlp-stat { display: flex; flex-direction: column; gap: 10px; color: var(--grey); }
  .tlp-stat svg { width: 26px; height: 26px; }
  .tlp-stat b { font-size: clamp(15px, 1.4vw, 18px); font-weight: 600; color: var(--ink); }

  /* Slider */
  .tlp-slider { padding: clamp(40px, 5vw, 72px) 0 0; }
  .tlp-slider-track { display: flex; gap: 16px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none; }
  .tlp-slider-track::-webkit-scrollbar { display: none; }
  .tlp-slide { position: relative; flex: 0 0 calc(50% - 8px); scroll-snap-align: start; border-radius: 5px; overflow: hidden; aspect-ratio: 3 / 2; background: var(--surface); }
  @media (max-width: 720px) { .tlp-slide { flex: 0 0 100%; } }
  .tlp-slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tlp-credit { position: absolute; left: 12px; bottom: 10px; font-size: 11px; color: rgba(255,255,255,0.85); text-shadow: 0 1px 4px rgba(0,0,0,0.5); }
  .tlp-slider-foot { display: flex; align-items: center; gap: clamp(18px, 3vw, 40px); margin-top: 26px; }
  .tlp-counter { font-size: 22px; font-weight: 800; letter-spacing: 0.02em; white-space: nowrap; }
  .tlp-counter span { color: var(--grey); font-weight: 600; }
  .tlp-progress { flex: 1; height: 1px; background: var(--line); position: relative; }
  .tlp-progress span { position: absolute; left: 0; top: -1px; height: 3px; width: 8%; background: var(--ink); transition: width .2s ease; }
  .tlp-arrows { display: flex; gap: 12px; }
  .tlp-arrows button { width: 54px; height: 54px; border-radius: 999px; border: 0; background: var(--surface); color: var(--ink); display: grid; place-items: center; cursor: pointer; transition: background .2s, color .2s, transform .2s; }
  .tlp-arrows button:hover { transform: translateY(-2px); }
  .tlp-arrows button.is-dark { background: var(--ink); color: #fff; }
  .tlp-arrows button.is-dark:hover { background: var(--red); }
  .tlp-arrows svg { width: 22px; height: 15px; }

  /* Section blocks (label left, body right) */
  .tlp-block { display: grid; grid-template-columns: 0.32fr 0.68fr; gap: clamp(24px, 4vw, 60px); padding: clamp(46px, 6vw, 96px) 0; border-bottom: 1px solid var(--line); }
  .tlp-block-head h2 { font-size: clamp(30px, 3.6vw, 50px); font-weight: 800; line-height: 1.0; letter-spacing: -0.02em; margin: 0; }
  .tlp-block-head h2 span { color: var(--grey); }
  @media (max-width: 820px) { .tlp-block { grid-template-columns: 1fr; gap: 24px; } }

  .tlp-amenities { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: clamp(28px, 3vw, 40px); }
  .tlp-amenity { font-size: 13px; font-weight: 600; color: var(--ink); border: 1px solid var(--line); border-radius: 999px; padding: 9px 18px; }
  .tlp-desc p { font-size: clamp(16px, 1.25vw, 19px); line-height: 1.6; margin: 0 0 22px; max-width: 62ch; }
  .tlp-desc p:last-child { margin-bottom: 0; }

  /* Feature image */
  .tlp-feature { margin: clamp(40px, 5vw, 80px) 0; border-radius: 5px; overflow: hidden; background: var(--surface); aspect-ratio: 16 / 7.5; }
  .tlp-feature img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Gallery */
  .tlp-gallery { display: grid; grid-template-columns: repeat(3, 1fr); grid-auto-rows: clamp(160px, 15vw, 230px); gap: clamp(12px, 1.2vw, 18px); margin-bottom: clamp(40px, 5vw, 80px); }
  .tlp-gcell { border-radius: 5px; overflow: hidden; background: var(--surface); }
  .tlp-gcell--wide { grid-column: span 2; grid-row: span 2; }
  .tlp-gcell img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform .5s cubic-bezier(.16,1,.3,1); }
  .tlp-gcell:hover img { transform: scale(1.04); }
  @media (max-width: 640px) { .tlp-gallery { grid-template-columns: 1fr 1fr; } .tlp-gcell--wide { grid-column: span 2; grid-row: span 1; } }

  /* Other details */
  .tlp-details { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(24px, 3vw, 44px) clamp(20px, 3vw, 40px); }
  @media (max-width: 720px) { .tlp-details { grid-template-columns: repeat(2, 1fr); } }
  .tlp-detail-k { font-size: 13px; color: var(--grey); margin-bottom: 8px; }
  .tlp-detail-v { font-size: clamp(18px, 1.5vw, 22px); font-weight: 700; }

  /* Map */
  .tlp-maprow { display: grid; grid-template-columns: 0.32fr 0.68fr; gap: clamp(24px, 4vw, 60px); padding: clamp(46px, 6vw, 96px) 0; }
  @media (max-width: 820px) { .tlp-maprow { grid-template-columns: 1fr; gap: 24px; } }
  .tlp-map { height: clamp(320px, 42vh, 520px); border-radius: 5px; overflow: hidden; background: var(--surface); }

  .tlp-back { display: inline-block; font-size: 13px; font-weight: 700; color: var(--ink); border-bottom: 2px solid var(--red); padding-bottom: 3px; }
  .tlp-back:hover { color: var(--red); }
</style>

<style is:global>
  .tls-pinwrap { background: none; border: 0; }
  .tls-pin { display: block; width: 20px; height: 20px; background: #e31f36; border: 2px solid #fff; border-radius: 50% 50% 50% 0; transform: rotate(-45deg); box-shadow: 0 3px 9px rgba(0,0,0,0.4); }
</style>
