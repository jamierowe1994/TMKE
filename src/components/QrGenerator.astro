---
/* The QR code generator, a pop-out of its own (Dani, 16 Oct 2026): opened
   from the Studio home's Design tools, where Background Remover was.

   A link, or a WhatsApp chat (a UK 07... number becomes the 447... WhatsApp
   wants), in black, white, the TMKE wine or one of the member's brand
   colours, on white or clear. Downloads as a PNG for posting or an SVG for
   print, which stays sharp at any size. The encoder is the same vendored
   copy the Studio editor's QR box uses (public/scripts/vendor), and the same
   rules: medium error correction, four modules of quiet margin.

   window.tmkeQr.open() opens it. */
---

<div class="qr-scrim" id="qr-scrim" data-lenis-prevent hidden>
  <div class="qr-modal" role="dialog" aria-modal="true" aria-labelledby="qr-title">
    <button type="button" class="qr-x" data-qr-close aria-label="Close">
      <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg>
    </button>
    <header class="qr-head">
      <span class="qr-eyebrow">QR code generator</span>
      <h2 class="qr-title" id="qr-title">Make a QR code.</h2>
      <p class="qr-sub">For a listing, your reviews, a valuation form or a WhatsApp chat. Download it for a post or for print.</p>
    </header>

    <div class="qr-body">
      <div class="qr-form">
        <div class="qr-tabs" role="tablist">
          <button type="button" class="qr-tab is-on" data-qr-kind="link" role="tab" aria-selected="true">Link</button>
          <button type="button" class="qr-tab" data-qr-kind="whatsapp" role="tab" aria-selected="false">WhatsApp</button>
        </div>
        <label class="qr-field" data-qr-pane="link"><span>Web address</span>
          <input type="text" inputmode="url" spellcheck="false" data-qr="url" placeholder="e.g. www.yourwebsite.co.uk/valuation" />
        </label>
        <div data-qr-pane="whatsapp" hidden>
          <label class="qr-field"><span>Mobile number</span>
            <input type="tel" data-qr="phone" placeholder="e.g. 07700 900123" />
          </label>
          <label class="qr-field"><span>Message <em>optional, filled in for them</em></span>
            <textarea data-qr="message" rows="2" placeholder="e.g. Hi, I'd like a valuation"></textarea>
          </label>
        </div>
        <div class="qr-field"><span>Colour</span>
          <div class="qr-swatches" data-qr-swatches></div>
        </div>
        <label class="qr-check"><input type="checkbox" data-qr="clear" /> Clear background <em>for laying over a design</em></label>
        <p class="qr-tip">Scan it with your phone's camera before you print it.</p>
      </div>

      <div class="qr-out">
        <div class="qr-preview" data-qr-preview aria-live="polite">
          <p class="qr-empty" data-qr-empty>Your QR code shows here.</p>
          <img alt="Your QR code" data-qr-img hidden />
        </div>
        <p class="qr-target" data-qr-target></p>
        <div class="qr-actions">
          <button type="button" class="qr-btn qr-btn--primary" data-qr-png disabled>Download PNG</button>
          <button type="button" class="qr-btn" data-qr-svg disabled>Download SVG</button>
        </div>
      </div>
    </div>
  </div>
</div>

<style is:global>
  .qr-scrim { position: fixed; inset: 0; z-index: 1200; display: flex; align-items: center; justify-content: center; padding: 22px; background: rgba(20,16,22,0.5); -webkit-backdrop-filter: blur(3px); backdrop-filter: blur(3px); }
  .qr-scrim[hidden] { display: none; }
  .qr-modal { position: relative; width: min(760px, 100%); max-height: 92vh; overflow-y: auto; overscroll-behavior: contain; background: #fff; border-radius: 16px; box-shadow: 0 40px 90px -40px rgba(20,16,22,0.6); padding: 30px clamp(22px, 3vw, 34px) 28px; font-family: var(--sans); animation: qrIn .3s cubic-bezier(.2,.7,.3,1); }
  @keyframes qrIn { from { opacity: 0; transform: translateY(12px) scale(.98); } to { opacity: 1; transform: none; } }
  .qr-x { position: absolute; top: 16px; right: 16px; width: 34px; height: 34px; border: 0; border-radius: 50%; background: rgba(28,29,34,0.05); cursor: pointer; display: grid; place-items: center; color: rgba(28,29,34,0.6); }
  .qr-x:hover { background: rgba(28,29,34,0.1); color: var(--ink); }
  .qr-x svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; }
  .qr-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--english-violet); }
  .qr-title { font-family: var(--serif); font-weight: 400; font-size: clamp(24px, 3vw, 30px); line-height: 1.1; color: var(--ink); margin: 10px 0 0; }
  .qr-sub { font-size: 13.5px; line-height: 1.5; color: rgba(28,29,34,0.6); margin: 4px 0 0; }   /* half the gap under the title (Dani, 17 Oct) */
  .qr-body { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(18px, 2.4vw, 30px); margin-top: 22px; }
  .qr-form { display: flex; flex-direction: column; gap: 14px; }
  .qr-tabs { display: flex; gap: 6px; }
  .qr-tab { all: unset; box-sizing: border-box; cursor: pointer; display: inline-flex; align-items: center; height: 30px; padding: 0 12px; border: 1px solid rgba(55,30,40,0.45); border-radius: 6px; font-size: 10.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet); }
  .qr-tab.is-on { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
  .qr-tab:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
  .qr-field { display: flex; flex-direction: column; gap: 6px; }
  [data-qr-pane="whatsapp"] { display: flex; flex-direction: column; gap: 14px; }
  [data-qr-pane][hidden] { display: none; }
  .qr-field > span { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
  .qr-field > span em, .qr-check em { font-style: normal; font-weight: 500; letter-spacing: 0; text-transform: none; color: rgba(28,29,34,0.4); }
  .qr-field textarea { resize: vertical; min-height: calc(2 * 1.45em + 22px); line-height: 1.45; }
  .qr-field input, .qr-field textarea { font-family: inherit; font-size: 14.5px; color: var(--ink); background: #fff; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; padding: 10px 12px; transition: border-color .2s, box-shadow .2s; }
  .qr-field input:focus, .qr-field textarea:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(var(--violet-rgb),0.12); }
  .qr-swatches { display: flex; flex-wrap: wrap; gap: 8px; }
  .qr-sw { all: unset; box-sizing: border-box; cursor: pointer; width: 30px; height: 30px; border-radius: 50%; border: 1px solid rgba(28,29,34,0.18); background: var(--c); position: relative; }
  .qr-sw.is-on { box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--english-violet); }
  .qr-sw:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 3px; }
  .qr-check { display: flex; align-items: center; gap: 8px; font-size: 13.5px; color: var(--ink); cursor: pointer; }
  .qr-check input { width: 16px; height: 16px; accent-color: var(--english-violet); }
  .qr-tip { margin: 0; font-size: 12.5px; line-height: 1.45; color: rgba(28,29,34,0.55); }
  .qr-out { display: flex; flex-direction: column; gap: 12px; }
  /* A chequered floor under a clear background, so "clear" can be seen. */
  .qr-preview { position: relative; aspect-ratio: 1 / 1; display: grid; place-items: center; border-radius: 10px; border: 1px solid rgba(28,29,34,0.12);
    background: #fff; background-image: linear-gradient(45deg, #f1eeec 25%, transparent 25%), linear-gradient(-45deg, #f1eeec 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #f1eeec 75%), linear-gradient(-45deg, transparent 75%, #f1eeec 75%);
    background-size: 18px 18px; background-position: 0 0, 0 9px, 9px -9px, -9px 0; }
  .qr-preview img { width: 86%; height: 86%; image-rendering: pixelated; }
  .qr-empty { margin: 0; padding: 0 24px; text-align: center; font-size: 13px; color: rgba(28,29,34,0.5); }
  .qr-target { margin: 0; min-height: 1.4em; font-size: 12px; color: rgba(28,29,34,0.55); word-break: break-all; }
  .qr-actions { display: flex; flex-wrap: wrap; gap: 8px; }
  /* Its own buttons, in the hub's shape: the pop-out sits outside the page
     wrapper the shared .ws-btn takes its sizes from. */
  .qr-btn { all: unset; box-sizing: border-box; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; height: 34px; padding: 0 14px; border-radius: 4px;
    border: 1px solid rgba(55,30,40,0.45); font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--english-violet); transition: background .2s, border-color .2s, opacity .2s; }
  .qr-btn:hover { border-color: var(--english-violet); }
  .qr-btn--primary { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
  .qr-btn--primary:hover { opacity: 0.9; }
  .qr-btn:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
  .qr-btn[disabled] { opacity: 0.4; cursor: default; }
  @media (max-width: 640px) { .qr-body { grid-template-columns: 1fr; } .qr-preview { max-width: 280px; width: 100%; margin: 0 auto; } }
</style>

<script>
  const scrim = document.getElementById("qr-scrim");
  if (scrim) {
    const $ = (sel) => scrim.querySelector(sel);
    const input = (k) => scrim.querySelector(`[data-qr="${k}"]`);
    const img = $("[data-qr-img]"), empty = $("[data-qr-empty]"), target = $("[data-qr-target]");
    const pngBtn = $("[data-qr-png]"), svgBtn = $("[data-qr-svg]");
    let kind = "link", dark = "#000000", svgText = "", lastFocus = null;

    let lib = null;
    // Loaded from the site at run time, as the editor does, not bundled.
    const QR_LIB = ["", "scripts", "vendor", "qrcode-generator-2.0.4.mjs"].join("/");
    const qrLib = () => (lib ||= import(/* @vite-ignore */ QR_LIB).then((m) => m.qrcode || m.default));

    const normaliseUrl = (u) => {
      u = String(u || "").trim();
      if (!u) return "";
      return /^[a-z][a-z0-9+.-]*:/i.test(u) ? u : "https://" + u.replace(/^\/+/, "");
    };
    // A UK mobile written the usual way (07...) becomes 447..., as WhatsApp wants.
    const waNumber = (p) => {
      let d = String(p || "").replace(/[^0-9+]/g, "");
      if (d.startsWith("+")) d = d.slice(1);
      else if (d.startsWith("00")) d = d.slice(2);
      else if (d.startsWith("0")) d = "44" + d.slice(1);
      return d.replace(/\D/g, "");
    };
    const text = () => {
      if (kind === "whatsapp") {
        const n = waNumber(input("phone").value);
        if (n.length < 10) return "";
        const msg = input("message").value.trim();
        return "https://wa.me/" + n + (msg ? "?text=" + encodeURIComponent(msg) : "");
      }
      return normaliseUrl(input("url").value);
    };

    // Black, white, TMKE wine, then the member's own brand colours.
    function swatches() {
      const box = $("[data-qr-swatches]");
      const list = [["#000000", "Black"], ["#371e28", "TMKE wine"], ["#ffffff", "White"]];
      try {
        const kit = JSON.parse(localStorage.getItem("tmke.brand") || "null");
        (kit && kit.colors || []).forEach((c) => {
          const hex = c && /^#[0-9a-f]{6}$/i.test(c.hex || "") ? c.hex.toLowerCase() : "";
          if (hex && !list.some(([h]) => h === hex)) list.push([hex, c.name || "Brand colour"]);
        });
      } catch (_) {}
      box.innerHTML = list.map(([h, name]) => `<button type="button" class="qr-sw${h === dark ? " is-on" : ""}" style="--c:${h}" data-qr-colour="${h}" aria-label="${name.replace(/"/g, "&quot;")}" title="${name.replace(/"/g, "&quot;")}"></button>`).join("");
    }

    async function draw() {
      const t = text();
      if (!t) { svgText = ""; img.hidden = true; empty.hidden = false; target.textContent = ""; pngBtn.disabled = svgBtn.disabled = true; return; }
      const qrcode = await qrLib();
      const q = qrcode(0, "M");
      q.addData(unescape(encodeURIComponent(t)), "Byte");   // UTF-8, so £ and ' survive
      q.make();
      const n = q.getModuleCount(), m = 4, size = n + m * 2;   // four modules of margin: scanners need it
      let d = "";
      for (let y = 0; y < n; y++) {
        for (let x = 0; x < n; x++) {
          if (!q.isDark(y, x)) continue;
          let run = 1;
          while (x + run < n && q.isDark(y, x + run)) run++;
          d += `M${x + m} ${y + m}h${run}v1h-${run}z`;
          x += run - 1;
        }
      }
      const clear = input("clear").checked;
      svgText = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${size} ${size}" shape-rendering="crispEdges">` +
        (clear ? "" : `<rect width="${size}" height="${size}" fill="#ffffff"/>`) + `<path fill="${dark}" d="${d}"/></svg>`;
      img.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svgText);
      img.hidden = false; empty.hidden = true;
      target.textContent = t;
      pngBtn.disabled = svgBtn.disabled = false;
    }

    const save = (href, name) => { const a = document.createElement("a"); a.href = href; a.download = name; document.body.appendChild(a); a.click(); a.remove(); };
    const fileName = (ext) => {
      const t = text().replace(/^https?:\/\/(www\.)?/i, "").replace(/[^a-z0-9]+/gi, "-").replace(/^-|-$/g, "").slice(0, 40);
      return `qr-${t || "code"}.${ext}`;
    };

    pngBtn.addEventListener("click", () => {
      if (!svgText) return;
      const px = 1200, im = new Image();
      im.onload = () => {
        const c = document.createElement("canvas"); c.width = c.height = px;
        const ctx = c.getContext("2d"); ctx.imageSmoothingEnabled = false;
        ctx.drawImage(im, 0, 0, px, px);
        c.toBlob((b) => { if (!b) return; const u = URL.createObjectURL(b); save(u, fileName("png")); setTimeout(() => URL.revokeObjectURL(u), 4000); }, "image/png");
      };
      im.src = "data:image/svg+xml;charset=utf-8," + encodeURIComponent(svgText);
    });
    svgBtn.addEventListener("click", () => {
      if (!svgText) return;
      const u = URL.createObjectURL(new Blob([svgText], { type: "image/svg+xml" }));
      save(u, fileName("svg")); setTimeout(() => URL.revokeObjectURL(u), 4000);
    });

    scrim.addEventListener("input", draw);
    scrim.addEventListener("change", draw);
    scrim.addEventListener("click", (e) => {
      const tab = e.target.closest("[data-qr-kind]");
      if (tab) {
        kind = tab.dataset.qrKind;
        scrim.querySelectorAll("[data-qr-kind]").forEach((b) => { const on = b === tab; b.classList.toggle("is-on", on); b.setAttribute("aria-selected", on ? "true" : "false"); });
        scrim.querySelectorAll("[data-qr-pane]").forEach((p) => { p.hidden = p.dataset.qrPane !== kind; });
        draw();
        return;
      }
      const sw = e.target.closest("[data-qr-colour]");
      if (sw) { dark = sw.dataset.qrColour; scrim.querySelectorAll("[data-qr-colour]").forEach((b) => b.classList.toggle("is-on", b === sw)); draw(); return; }
      if (e.target.closest("[data-qr-close]") || e.target === scrim) close();
    });

    function open() {
      lastFocus = document.activeElement;
      swatches();
      scrim.hidden = false;
      window.__lenis?.stop?.();
      setTimeout(() => input(kind === "link" ? "url" : "phone").focus(), 50);
      draw();
    }
    function close() {
      scrim.hidden = true;
      window.__lenis?.start?.();
      lastFocus?.focus?.();
    }
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !scrim.hidden) close(); });
    window.tmkeQr = { open, close };
  }
</script>
