---
// Shared admin app shell: collapsible glass sidebar + topbar + content slot.
// Wrap any /admin page:  <AdminShell active="orders" title="Orders">…</AdminShell>
// Handles the admin auth gate, loads the signed-in admin's profile (name +
// headshot from `admin_profiles`), the collapse toggle, and sign-out.
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin-shell.css";

interface Props { active?: string; title?: string; }
const { active = "dashboard", title = "Dashboard" } = Astro.props;

// Icons are small inline line-SVGs (stroke = currentColor).
const I = {
  dash: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/></svg>',
  orders: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 4 6v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6l-2-4z"/><path d="M4 6h16M9 10a3 3 0 0 0 6 0"/></svg>',
  catalogue: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>',
  studio: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7a2.8 2.8 0 0 0-4-4l-7 7-1 5z"/><path d="M14 6l4 4"/></svg>',
  subs: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13A4 4 0 0 1 16 11"/></svg>',
  enquiries: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
  email: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>',
  blog: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>',
  automations: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="6" r="2.5"/><circle cx="12" cy="18" r="2.5"/><path d="M6 8.5v3a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2v-3M12 13.5v2"/></svg>',
  contacts: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  video: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="m23 7-7 5 7 5z"/><rect x="1" y="5" width="15" height="14" rx="2"/></svg>',
  social: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="m8.6 13.5 6.8 4M15.4 6.5l-6.8 4"/></svg>',
  editor: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>',
  invoicing: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2h9l5 5v13a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"/><path d="M14 2v6h6M9 13h6M9 17h6M9 9h2"/></svg>',
  settings: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>',
};

const NAV = [
  { label: "Main", items: [{ key: "dashboard", label: "Dashboard", href: "/admin", icon: I.dash }] },
  { label: "Commerce", items: [
    { key: "orders", label: "Orders", href: "/admin/orders", icon: I.orders },
    { key: "catalogue", label: "Catalogue", href: "/admin/packs", icon: I.catalogue },
    { key: "studio", label: "Design studio", href: "/admin/templates", icon: I.studio },
    { key: "invoicing", label: "Invoicing", href: "/admin/invoicing", icon: I.invoicing },
  ]},
  { label: "Marketing", items: [
    { key: "contacts", label: "Contacts", href: "/admin/contacts", icon: I.contacts },
    { key: "subscribers", label: "Purchases", href: "/admin/subscribers", icon: I.subs },
    { key: "enquiries", label: "Enquiries", href: "/admin/enquiries", icon: I.enquiries },
    { key: "email", label: "Email studio", href: "/admin/email", icon: I.email },
    { key: "automations", label: "Automations", href: "/admin/automations", icon: I.automations },
    { key: "blog", label: "Blog editor", href: "/admin/blog", icon: I.blog },
  ]},
  { label: "Studio", items: [
    { key: "videography", label: "Videography", href: "/admin/videography", icon: I.video },
    { key: "social", label: "Social media", href: "/admin/social", icon: I.social },
  ]},
  { label: "System", items: [
    { key: "editor", label: "Website editor", href: "/?edit=1", icon: I.editor },
    { key: "settings", label: "Settings", href: "/admin/settings", icon: I.settings },
  ]},
];
---

<BaseLayout title={`${title} — TMKE admin`} description="TMKE internal admin." hideNav hideFooter>
  <div class="ash" id="ash" data-active={active}>
    <div class="ash-scrim" id="ash-scrim"></div>

    <aside class="ash-side">
      <a href="/admin" class="ash-logo"><span class="ash-logo-mark">T</span><span class="ash-logo-text">TMKE</span></a>
      <nav class="ash-nav" aria-label="Admin sections">
        {NAV.map((group) => (
          <div class="ash-group">
            <div class="ash-group-label">{group.label}</div>
            {group.items.map((it) => (
              <a href={it.href} class:list={["ash-link", active === it.key && "is-active"]} aria-current={active === it.key ? "page" : undefined}>
                <Fragment set:html={it.icon} />
                <span class="ash-link-label">{it.label}</span>
              </a>
            ))}
          </div>
        ))}
      </nav>
      <div class="ash-side-foot">
        <div class="ash-user">
          <span class="ash-avatar" id="ash-avatar">·</span>
          <div class="ash-user-meta">
            <div class="ash-user-name" id="ash-user-name">…</div>
            <div class="ash-user-role" id="ash-user-role">Admin</div>
          </div>
        </div>
        <button type="button" class="ash-signout" id="ash-signout">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
          <span class="ash-signout-txt">Sign out</span>
        </button>
      </div>
    </aside>

    <div class="ash-main">
      <header class="ash-top">
        <button type="button" class="ash-burger" id="ash-burger" aria-label="Toggle menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
        </button>
        <div class="ash-top-title">{title}</div>
        <div class="ash-top-spacer"></div>
        <label class="ash-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" placeholder="Search…" aria-label="Search" />
        </label>
      </header>
      <main class="ash-content"><slot /></main>
    </div>
  </div>

  <script>
    import { requireAdmin, signOut } from "../../lib/admin-gate.js";
    import { supabase } from "../../lib/supabase.js";

    const ash = document.getElementById("ash");
    const COLLAPSE_KEY = "tmke-admin-collapsed";

    // Collapse (desktop) / off-canvas (mobile) via the same burger.
    if (localStorage.getItem(COLLAPSE_KEY) === "1") ash?.classList.add("is-collapsed");
    document.getElementById("ash-burger")?.addEventListener("click", () => {
      if (window.matchMedia("(max-width: 760px)").matches) {
        ash?.classList.toggle("is-mobile-open");
      } else {
        ash?.classList.toggle("is-collapsed");
        localStorage.setItem(COLLAPSE_KEY, ash?.classList.contains("is-collapsed") ? "1" : "0");
      }
    });
    document.getElementById("ash-scrim")?.addEventListener("click", () => ash?.classList.remove("is-mobile-open"));
    document.getElementById("ash-signout")?.addEventListener("click", () => signOut());

    // Keep the sidebar's scroll position across page loads — navigating from a
    // link you had to scroll down to should not jump the nav back to the top.
    const ashNav = document.querySelector(".ash-nav");
    if (ashNav) {
      const NAV_SCROLL_KEY = "tmke-admin-nav-scroll";
      const saved = parseInt(sessionStorage.getItem(NAV_SCROLL_KEY) || "0", 10);
      if (saved) ashNav.scrollTop = saved;
      let raf = 0;
      ashNav.addEventListener("scroll", () => {
        if (raf) return;
        raf = requestAnimationFrame(() => { raf = 0; sessionStorage.setItem(NAV_SCROLL_KEY, String(ashNav.scrollTop)); });
      }, { passive: true });
      // Belt-and-braces: capture the position the instant a link is clicked.
      ashNav.addEventListener("click", (e) => {
        if (e.target.closest("a")) sessionStorage.setItem(NAV_SCROLL_KEY, String(ashNav.scrollTop));
      });
    }

    (async () => {
      // In local dev the admin area renders without a login so it's previewable;
      // production stays gated by requireAdmin (which redirects when signed out).
      let session;
      if (import.meta.env.DEV) {
        session = (await supabase.auth.getSession()).data.session || { user: { email: "dev-preview@tmke.co.uk", id: "dev" } };
      } else {
        session = await requireAdmin();
        if (!session) return;
      }
      const email = session.user.email || "admin";

      // Load this admin's profile (name + headshot). Falls back to email/initials.
      let profile = null;
      try {
        const { data } = await supabase.from("admin_profiles").select("full_name, role, avatar_url").eq("user_id", session.user.id).maybeSingle();
        profile = data;
      } catch (_) { /* table may not exist yet */ }

      const name = (profile && profile.full_name) || email.split("@")[0];
      const role = (profile && profile.role) || "Admin";
      const nameEl = document.getElementById("ash-user-name");
      const roleEl = document.getElementById("ash-user-role");
      const avatarEl = document.getElementById("ash-avatar");
      if (nameEl) nameEl.textContent = name;
      if (roleEl) roleEl.textContent = role;
      if (avatarEl) {
        if (profile && profile.avatar_url) {
          avatarEl.innerHTML = "";
          avatarEl.style.background = `center/cover url('${profile.avatar_url}')`;
        } else {
          avatarEl.textContent = (name[0] || "A").toUpperCase();
        }
      }
      // Let pages react once auth + profile are ready.
      document.dispatchEvent(new CustomEvent("ash:ready", { detail: { session, profile } }));
    })();
  </script>
</BaseLayout>
