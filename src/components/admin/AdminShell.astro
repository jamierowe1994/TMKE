---
// Shared admin app shell: collapsible glass sidebar + topbar + content slot.
// Wrap any /admin page:  <AdminShell active="orders" title="Orders">…</AdminShell>
// Handles the admin auth gate, loads the signed-in admin's profile (name +
// headshot from `admin_profiles`), the collapse toggle, and sign-out.
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/hub-tokens.css";
import "../../styles/admin-shell.css";

interface Props { active?: string; title?: string; }
// `skin="hub"` opts a page into the My Marketing Hub styling. Opt-in rather
// than global so pages can be moved across one at a time instead of all
// twenty changing at once.
const { active = "dashboard", title = "Dashboard", skin = "" } = Astro.props;

// Icons are small inline line-SVGs (stroke = currentColor).
// TMKE OS sidebar (Dani, 4 Nov 2026): nine groups that open and close
// instead of twenty-five links; white line icons, one per group. The keys
// are the pages' `active` values, so highlighting and the management-only
// rule (Payments, Invoicing) work as before.
const G = {
  home: '<path d="M3.5 10.5 12 3.5l8.5 7"/><path d="M5.5 9v10.5a1 1 0 0 0 1 1H10v-6h4v6h3.5a1 1 0 0 0 1-1V9"/>',
  money: '<circle cx="12" cy="12" r="8.5"/><path d="M14.6 8.6A2.6 2.6 0 0 0 10 10.2v5.3M8.6 12.4h4.6M8.6 15.5h6.8"/>',
  studio: '<path d="M12 3.5a8.5 8.5 0 1 0 0 17c1 0 1.6-.8 1.6-1.6 0-.4-.2-.8-.4-1.1-.3-.3-.5-.7-.5-1.1 0-.9.7-1.6 1.6-1.6h1.9a4.3 4.3 0 0 0 4.3-4.3C20.5 6.9 16.7 3.5 12 3.5z"/><circle cx="7.6" cy="11.2" r="1"/><circle cx="10" cy="7.4" r="1"/><circle cx="14.4" cy="7.4" r="1"/>',
  clients: '<path d="M4.5 7.5h2.8l1.8-2.6h5.8l1.8 2.6h2.8a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1h-15a1 1 0 0 1-1-1v-10a1 1 0 0 1 1-1z"/><circle cx="12" cy="13.2" r="3.4"/>',
  people: '<circle cx="9" cy="8.5" r="3.3"/><path d="M3.2 19.5c.5-3.1 2.9-5.2 5.8-5.2s5.3 2.1 5.8 5.2"/><path d="M15.5 5.6a3.3 3.3 0 0 1 0 5.8M17.4 14.6c1.7.7 2.9 2.4 3.3 4.9"/>',
  email: '<rect x="3" y="5" width="18" height="14" rx="1.6"/><path d="m3.6 6.2 8.4 6.6 8.4-6.6"/>',
  hub: '<path d="M3 6.4c2.6-1.4 5.7-1.3 9 .8 3.3-2.1 6.4-2.2 9-.8v12c-2.6-1.4-5.7-1.3-9 .8-3.3-2.1-6.4-2.2-9-.8z"/><path d="M12 7.2v12"/>',
  insights: '<path d="M4 20h16"/><path d="M6.5 16v-4M11 16V7M15.5 16v-6M20 16V5"/>',
  system: '<path d="M4 7h9M17 7h3M4 12h3M11 12h9M4 17h11M19 17h1"/><circle cx="15" cy="7" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="17" r="2"/>',
};
const icon = (k: string) => `<svg class="ash-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${G[k as keyof typeof G]}</svg>`;

type Item = { key: string; label: string; href: string };
type Group = { k: string; label: string; key?: string; href?: string; items?: Item[] };
const NAV: Group[] = [
  { k: "home", label: "Home", key: "dashboard", href: "/admin" },
  { k: "money", label: "Money", items: [
    { key: "invoicing", label: "Invoicing", href: "/admin/invoicing" },
    { key: "payments", label: "Revenue", href: "/admin/revenue" },
    { key: "orders", label: "Pack orders", href: "/admin/orders" },
  ]},
  { k: "studio", label: "Studio", items: [
    { key: "catalogue", label: "Catalogue", href: "/admin/packs" },
    { key: "studio", label: "Design studio", href: "/admin/templates" },
    { key: "calendar", label: "Content calendar", href: "/admin/content-calendar" },
  ]},
  { k: "clients", label: "Clients", items: [
    { key: "videography", label: "Videography", href: "/admin/videography" },
    { key: "social", label: "Social media", href: "/admin/social" },
    { key: "content", label: "Creative Studio", href: "/admin/content" },
  ]},
  { k: "people", label: "People", items: [
    { key: "contacts", label: "Contacts", href: "/admin/contacts" },
    { key: "enquiries", label: "Enquiries", href: "/admin/enquiries" },
    { key: "reviews", label: "Reviews", href: "/admin/reviews" },
  ]},
  { k: "email", label: "Email", items: [
    { key: "email", label: "Email studio", href: "/admin/email" },
    { key: "automations", label: "Automations", href: "/admin/automations" },
  ]},
  { k: "hub", label: "Member hub", items: [
    { key: "trending", label: "Trending month", href: "/admin/trending" },
    { key: "prompts", label: "Prompts", href: "/admin/prompts" },
    { key: "guides", label: "Guides", href: "/admin/guides" },
    { key: "community", label: "Community", href: "/admin/community" },
    { key: "assistant", label: "Assistant", href: "/admin/assistant" },
  ]},
  { k: "insights", label: "Insights", items: [
    { key: "insights", label: "Website", href: "/admin/insights" },
    { key: "blog", label: "Blog editor", href: "/admin/blog" },
  ]},
  { k: "system", label: "System", items: [
    { key: "teg", label: "TEG sync", href: "/admin/teg" },
    { key: "editor", label: "Website editor", href: "/?edit=1" },
    { key: "settings", label: "Settings", href: "/admin/settings" },
  ]},
];
// The group this page sits in starts open.
const activeGroup = (NAV.find((g) => g.key === active || (g.items || []).some((it) => it.key === active)) || {}).k || "";
---

<BaseLayout title={`${title} — TMKE admin`} description="TMKE internal admin." hideNav hideFooter>
  <div class="ash" id="ash" data-active={active}>
    <div class="ash-scrim" id="ash-scrim"></div>

    <aside class="ash-side">
      <a href="/admin" class="ash-logo" aria-label="TMKE OS home"><span class="ash-logo-text">TMKE<span class="ash-logo-os">OS</span></span><span class="ash-logo-mono">T</span></a>
      <!-- Search that understands plain English (Dani, 4 Nov 2026). -->
      <button type="button" class="ash-find" id="ash-find" title="Search or ask (⌘K)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="ash-find-label">Search or ask</span><kbd>⌘K</kbd>
      </button>
      <nav class="ash-nav" aria-label="Admin sections">
        {NAV.map((g) => g.href ? (
          <div class="ash-group ash-group--solo">
            <a href={g.href} data-navkey={g.key} class:list={["ash-grp-h", "ash-link", active === g.key && "is-active"]} aria-current={active === g.key ? "page" : undefined} title={g.label}>
              <Fragment set:html={icon(g.k)} /><span class="ash-grp-label">{g.label}</span>
            </a>
          </div>
        ) : (
          <div class:list={["ash-group", activeGroup === g.k && "is-open", activeGroup === g.k && "is-here"]} data-group={g.k}>
            <button type="button" class="ash-grp-h" data-toggle={g.k} aria-expanded={activeGroup === g.k ? "true" : "false"} title={g.label}>
              <Fragment set:html={icon(g.k)} /><span class="ash-grp-label">{g.label}</span>
              <svg class="ash-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
            </button>
            <div class="ash-grp-items">
              {(g.items || []).map((it) => (
                <a href={it.href} data-navkey={it.key} class:list={["ash-link", active === it.key && "is-active"]} aria-current={active === it.key ? "page" : undefined}>
                  <span class="ash-link-label">{it.label}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </nav>
      <button type="button" class="ash-fold" id="ash-fold" title="Fold the sidebar">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 5v14"/><path d="m14 7-5 5 5 5M9 12h11"/></svg>
        <span class="ash-fold-label">Fold</span>
      </button>
      <div class="ash-side-foot">
        <div class="ash-user">
          <span class="ash-avatar" id="ash-avatar">·</span>
          <div class="ash-user-meta">
            <div class="ash-user-name" id="ash-user-name">…</div>
            <div class="ash-user-role" id="ash-user-role">Admin</div>
          </div>
        </div>
        <button type="button" class="ash-signout" id="ash-signout">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5M21 12H9"/></svg>
          <span class="ash-signout-txt">Sign out</span>
        </button>
      </div>
    </aside>

    <!-- The search, over everything (⌘K from any page). -->
    <div class="ash-pal" id="ash-pal" hidden>
      <div class="ash-pal-card" role="dialog" aria-modal="true" aria-label="Search TMKE OS">
        <div class="ash-pal-in">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
          <input id="ash-pal-q" type="text" placeholder="Where do I…" autocomplete="off" spellcheck="false" />
          <kbd>esc</kbd>
        </div>
        <div class="ash-pal-list" id="ash-pal-list"></div>
        <div class="ash-pal-foot"><span>↑ ↓ to choose</span><span>↵ to go</span><span>Not sure of the name? Describe the job.</span></div>
      </div>
    </div>

    <div class="ash-main">
      <header class="ash-top">
        <button type="button" class="ash-burger" id="ash-burger" aria-label="Toggle menu">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 12h18M3 6h18M3 18h18"/></svg>
        </button>
        <div class="ash-top-title">{title}</div>
        <div class="ash-top-spacer"></div>
        <!-- Hidden until the browser says the app is installable. -->
        <button type="button" class="ash-install" id="ash-install" hidden>Install app</button>

        <!-- What happened while you were elsewhere. Every page has this, so
             a thing that wants attention is visible from wherever you are
             rather than only on the page it belongs to. -->
        <!-- Refresh (Dani, 5 Nov 2026): a hard reload without the keyboard.
             It fetches the page fresh past the browser's cache, then reloads.
             Nothing saved in the browser is cleared, so sign-in and unsaved
             edits stay put. -->
        <button type="button" class="ash-notif-btn ash-refresh" id="ash-refresh" aria-label="Refresh the page" title="Refresh">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/></svg>
        </button>
        <div class="ash-notif" id="ash-notif">
          <button type="button" class="ash-notif-btn" id="ash-notif-btn" aria-label="Notifications" aria-expanded="false">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
            <span class="ash-notif-dot" id="ash-notif-dot" hidden></span>
          </button>
          <div class="ash-notif-panel" id="ash-notif-panel" hidden>
            <div class="ash-notif-head">
              <strong>Notifications</strong>
              <span class="ash-notif-head-acts">
                <button type="button" class="ash-notif-clear" id="ash-notif-clear">Mark all read</button>
                <button type="button" class="ash-notif-pop" id="ash-notif-pop" aria-label="Pop out notifications" title="Pop out: filter and sort">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                </button>
              </span>
            </div>
            <div class="ash-notif-list" id="ash-notif-list"></div>
          </div>
        </div>
        <!-- The bell, popped out: every notification, filtered and sorted. -->
        <div class="ash-nx" id="ash-nx" hidden>
          <div class="ash-nx-backdrop" data-nx-close></div>
          <div class="ash-nx-card" role="dialog" aria-modal="true" aria-labelledby="ash-nx-title">
            <div class="ash-nx-head">
              <h2 id="ash-nx-title">Notifications</h2>
              <span class="ash-nx-count" id="ash-nx-count"></span>
              <button type="button" class="ash-notif-clear" id="ash-nx-clear">Mark all read</button>
              <button type="button" class="ash-nx-x" data-nx-close aria-label="Close">&times;</button>
            </div>
            <div class="ash-nx-bar">
              <div class="ash-nx-chips" id="ash-nx-types" role="group" aria-label="Type"></div>
              <div class="ash-nx-row">
                <div class="ash-nx-chips" role="group" aria-label="When">
                  <button type="button" class="ash-nx-chip is-on" data-within="0">Any time</button>
                  <button type="button" class="ash-nx-chip" data-within="24">Last 24 hours</button>
                  <button type="button" class="ash-nx-chip" data-within="48">Last 48 hours</button>
                  <button type="button" class="ash-nx-chip" data-within="168">Last 7 days</button>
                </div>
                <button type="button" class="ash-nx-chip" id="ash-nx-unread" aria-pressed="false">Unread only</button>
                <label class="ash-nx-sort">Sort
                  <select id="ash-nx-sort">
                    <option value="new">Newest first</option>
                    <option value="old">Oldest first</option>
                    <option value="urgent">Most urgent first</option>
                  </select>
                </label>
              </div>
            </div>
            <p class="ash-nx-note" id="ash-nx-note" hidden></p>
            <div class="ash-nx-list" id="ash-nx-list"></div>
          </div>
        </div>
      </header>
      <main class={`ash-content${skin === "hub" ? " hub-skin" : ""}`}><slot /></main>
    </div>
  </div>

  <script>
    import { requireAdmin, signOut, isManagementUser } from "../../lib/admin-gate.js";
    import { wireInstallButton } from "../../lib/pwa-install.js";
    import { ADMIN_PLACES } from "../../data/admin-places.js";

    wireInstallButton("ash-install");
    import { supabase } from "../../lib/supabase.js";

    const ash = document.getElementById("ash");
    const COLLAPSE_KEY = "tmke-admin-collapsed";

    // Collapse (desktop) / off-canvas (mobile) via the same burger.
    // Folding is a desktop thing; a phone always gets the full menu.
    if (localStorage.getItem(COLLAPSE_KEY) === "1" && !window.matchMedia("(max-width: 760px)").matches) ash?.classList.add("is-collapsed");
    document.getElementById("ash-burger")?.addEventListener("click", () => {
      if (window.matchMedia("(max-width: 760px)").matches) {
        ash?.classList.toggle("is-mobile-open");
      } else {
        ash?.classList.toggle("is-collapsed");
        localStorage.setItem(COLLAPSE_KEY, ash?.classList.contains("is-collapsed") ? "1" : "0");
      }
    });
    document.getElementById("ash-scrim")?.addEventListener("click", () => ash?.classList.remove("is-mobile-open"));
    document.getElementById("ash-signout")?.addEventListener("click", () => signOut());

    /* ---- TMKE OS sidebar (Dani, 4 Nov 2026) ----
       Groups open and close, and stay as you left them; the one you're in
       is always open. Fold sits at the foot; folded, a group's icon unfolds
       the sidebar with that group open. */
    const OPEN_KEY = "tmke-admin-open-groups";
    const readOpen = () => { try { return new Set(JSON.parse(localStorage.getItem(OPEN_KEY) || "[]")); } catch (_) { return new Set(); } };
    const saveOpen = (set) => { try { localStorage.setItem(OPEN_KEY, JSON.stringify([...set])); } catch (_) {} };
    const openGroups = readOpen();
    document.querySelectorAll(".ash-group[data-group]").forEach((g) => {
      if (openGroups.has(g.dataset.group)) { g.classList.add("is-open"); g.querySelector("[data-toggle]")?.setAttribute("aria-expanded", "true"); }
    });
    document.querySelector(".ash-nav")?.addEventListener("click", (e) => {
      const t = e.target.closest("[data-toggle]");
      if (!t) return;
      const g = t.closest(".ash-group");
      if (ash?.classList.contains("is-collapsed")) {
        ash.classList.remove("is-collapsed");
        localStorage.setItem(COLLAPSE_KEY, "0");
        g.classList.add("is-open");
      } else g.classList.toggle("is-open");
      const open = g.classList.contains("is-open");
      t.setAttribute("aria-expanded", String(open));
      const set = readOpen(); open ? set.add(g.dataset.group) : set.delete(g.dataset.group); saveOpen(set);
    });
    document.getElementById("ash-fold")?.addEventListener("click", () => {
      ash?.classList.toggle("is-collapsed");
      localStorage.setItem(COLLAPSE_KEY, ash?.classList.contains("is-collapsed") ? "1" : "0");
    });

    /* ---- Search: "where do I…?" ----
       Matches the list of every place (src/data/admin-places.js) by the
       everyday words people use, instantly. When nothing clear comes up,
       "Ask Claude" sends the question and the list to the Worker, which asks
       Claude Haiku for the best one to three. ⌘K or Ctrl+K from any page.
       Payments and Invoicing are shown to management only, as in the nav. */
    const pal = document.getElementById("ash-pal");
    if (pal && pal.parentElement !== document.body) document.body.appendChild(pal);
    const palQ = document.getElementById("ash-pal-q");
    const palList = document.getElementById("ash-pal-list");
    const WORKER_URL = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    let palMgmt = false;
    document.addEventListener("ash:ready", (e) => { palMgmt = !!(e.detail && e.detail.isManagement); });
    const palEsc = (v) => String(v == null ? "" : v).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    const STOP = new Set("where do does i the a an to for of in on is my we our how can find put enter add go page it what with and or at which who when".split(" "));
    const stem = (w) => w.replace(/'s$/, "").replace(/ies$/, "y").replace(/(ing|es|s)$/, "");
    const toks = (t) => String(t || "").toLowerCase().replace(/[^a-z0-9£&' ]+/g, " ").split(/\s+/).filter((w) => w && !STOP.has(w)).map(stem);
    const PRE = ADMIN_PLACES.map((pl, i) => ({ pl, i, name: toks(pl.n), words: new Set(toks(pl.n + " " + pl.w + " " + pl.t)), hay: (pl.n + " " + pl.t).toLowerCase() }));
    const allowed = (pl) => !pl.m || palMgmt;
    function palSearch(q) {
      const qt = toks(q);
      if (!qt.length) return [];
      const ql = q.toLowerCase().trim();
      return PRE.filter((x) => allowed(x.pl)).map((x) => {
        let sc = 0;
        for (const t of qt) { if (x.name.includes(t)) sc += 3; else if (x.words.has(t)) sc += 2; else if (t.length > 3 && [...x.words].some((w) => w.startsWith(t))) sc += 1; }
        for (let k = 0; k < qt.length - 1; k++) if (x.hay.includes(qt[k] + " " + qt[k + 1])) sc += 2;
        if (ql.length > 3 && x.hay.includes(ql)) sc += 4;
        return { x, sc };
      }).filter((r) => r.sc >= 2).sort((a, b) => b.sc - a.sc).slice(0, 7).map((r) => r.x.pl);
    }
    let palSel = 0, palItems = [], palAnswer = "";
    const START = ["Dashboard", "Videography", "Contacts", "Trending month", "Prompts"];
    function palDraw() {
      const q = palQ.value.trim();
      const res = q ? palSearch(q) : ADMIN_PLACES.filter((pl) => allowed(pl) && START.includes(pl.n)).slice(0, 5);
      palItems = res.map((pl) => ({ pl }));
      let html = `<div class="ash-pal-sec">${q ? (res.length ? "Best matches" : "No clear match") : "Jump to"}</div>`;
      html += palItems.map((it, k) => `<a class="ash-pal-item${k === palSel ? " is-on" : ""}" href="${palEsc(it.pl.h)}" data-k="${k}"><span class="ash-pal-n">${palEsc(it.pl.n)}</span><span class="ash-pal-w">${palEsc(it.pl.w)}</span><span class="ash-pal-j">${palEsc(it.pl.j)}</span></a>`).join("");
      if (q) {
        palItems.push({ ask: true });
        const k = palItems.length - 1;
        html += `<div class="ash-pal-sec">Not it?</div><button type="button" class="ash-pal-ask${k === palSel ? " is-on" : ""}" data-k="${k}"><span class="ash-pal-spark">✦</span><span><b>Ask Claude: “${palEsc(q)}”</b><small>Reads the list of every page and tab and tells you where.</small></span></button>`;
      }
      if (palAnswer) html += palAnswer;
      palList.innerHTML = html;
    }
    async function palAsk() {
      const q = palQ.value.trim();
      if (!q || !WORKER_URL) return;
      const pool = ADMIN_PLACES.filter(allowed);
      palAnswer = `<p class="ash-pal-answer">Asking Claude…</p>`; palDraw();
      try {
        const { data: { session } } = await supabase.auth.getSession();
        const r = await fetch(`${WORKER_URL}/admin/nav-ask`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + (session && session.access_token) },
          body: JSON.stringify({ q, places: pool.map((pl) => ({ n: pl.n, w: pl.w, j: pl.j })) }),
        });
        const j = await r.json().catch(() => ({}));
        if (!r.ok) throw new Error(j.error || r.status);
        const picks = (j.picks || []).map((n) => pool[n]).filter(Boolean);
        palAnswer = `<div class="ash-pal-answer"><p>${palEsc(j.answer || "Claude couldn't find a clear match.")}</p>${picks.map((pl) => `<a class="ash-pal-item" href="${palEsc(pl.h)}"><span class="ash-pal-n">${palEsc(pl.n)}</span><span class="ash-pal-w">${palEsc(pl.w)}</span></a>`).join("")}</div>`;
      } catch (err) {
        palAnswer = `<p class="ash-pal-answer">Couldn't ask Claude just now (${palEsc(err.message || err)}). Try other words.</p>`;
      }
      palDraw();
    }
    function palOpen() { if (!pal) return; pal.hidden = false; palQ.value = ""; palSel = 0; palAnswer = ""; palDraw(); setTimeout(() => palQ.focus(), 0); }
    function palClose() { if (pal) pal.hidden = true; }
    document.getElementById("ash-find")?.addEventListener("click", palOpen);
    palQ?.addEventListener("input", () => { palSel = 0; palAnswer = ""; palDraw(); });
    palQ?.addEventListener("keydown", (e) => {
      if (e.key === "ArrowDown") { e.preventDefault(); palSel = Math.min(palItems.length - 1, palSel + 1); palDraw(); }
      else if (e.key === "ArrowUp") { e.preventDefault(); palSel = Math.max(0, palSel - 1); palDraw(); }
      else if (e.key === "Enter") {
        e.preventDefault();
        const it = palItems[palSel];
        if (!it) return;
        if (it.ask) palAsk(); else location.href = it.pl.h;
      }
    });
    palList?.addEventListener("click", (e) => { if (e.target.closest(".ash-pal-ask")) palAsk(); });
    pal?.addEventListener("click", (e) => { if (e.target === pal) palClose(); });
    document.addEventListener("keydown", (e) => {
      if ((e.metaKey || e.ctrlKey) && String(e.key).toLowerCase() === "k") { e.preventDefault(); pal && pal.hidden ? palOpen() : palClose(); }
      else if (e.key === "Escape" && pal && !pal.hidden) palClose();
    });

    // Keep the sidebar's scroll position across page loads — navigating from a
    // link you had to scroll down to should not jump the nav back to the top.
    const ashNav = document.querySelector(".ash-nav");
    if (ashNav) {
      const NAV_SCROLL_KEY = "tmke-admin-nav-scroll";
      const saved = parseInt(sessionStorage.getItem(NAV_SCROLL_KEY) || "0", 10);
      if (saved) ashNav.scrollTop = saved;
      let raf = 0;
      ashNav.addEventListener("scroll", () => {
        if (raf) return;
        raf = requestAnimationFrame(() => { raf = 0; sessionStorage.setItem(NAV_SCROLL_KEY, String(ashNav.scrollTop)); });
      }, { passive: true });
      // Belt-and-braces: capture the position the instant a link is clicked.
      ashNav.addEventListener("click", (e) => {
        if (e.target.closest("a")) sessionStorage.setItem(NAV_SCROLL_KEY, String(ashNav.scrollTop));
      });
    }

    (async () => {
      // In local dev the admin area renders without a login so it's previewable;
      // production stays gated by requireAdmin (which redirects when signed out).
      let session;
      if (import.meta.env.DEV) {
        session = (await supabase.auth.getSession()).data.session || { user: { email: "dev-preview@tmke.co.uk", id: "dev" } };
      } else {
        session = await requireAdmin();
        if (!session) return;
      }
      const email = session.user.email || "admin";

      /* Notifications. RLS only ever hands back the ones addressed to this
         person, so there is no filtering to do here and no way to read
         somebody else's list by accident. Read state is per person, which is
         why marking read appends rather than flips a flag. */
      (function notifications() {
        document.getElementById("ash-refresh")?.addEventListener("click", async (e) => {
          const b = e.currentTarget; b.disabled = true; b.classList.add("is-busy");
          try {
            if ("caches" in window) { const keys = await caches.keys(); await Promise.all(keys.map((k) => caches.delete(k))); }
            await fetch(location.href, { cache: "reload", credentials: "same-origin" });
          } catch (_) {}
          location.reload();
        });
        const btn = document.getElementById("ash-notif-btn");
        const panel = document.getElementById("ash-notif-panel");
        const list = document.getElementById("ash-notif-list");
        const dot = document.getElementById("ash-notif-dot");
        if (!btn || !panel || !list) return;
        const me = String(email).toLowerCase();
        let rows = [];

        const ago = (t) => {
          const m = Math.round((Date.now() - new Date(t).getTime()) / 60000);
          if (m < 1) return "just now";
          if (m < 60) return m + (m === 1 ? " minute ago" : " minutes ago");
          const h = Math.round(m / 60);
          if (h < 24) return h + (h === 1 ? " hour ago" : " hours ago");
          return new Date(t).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
        };
        const esc = (v) => String(v == null ? "" : v)
          .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
        const unread = (r) => !(r.read_by || []).map((x) => String(x).toLowerCase()).includes(me);
        // The pill on each one: its area in words, each in its own colour.
        const AREA_LABEL = { videography: "Videography", social: "Social", money: "Money", hub: "Hub", community: "Community", problem: "Problem", marketing: "Marketing" };
        const areaLabel = (a) => AREA_LABEL[a] || String(a || "Other").replace(/^./, (c) => c.toUpperCase());
        // How urgent, once known (meta.urgency, set by the Worker's Claude read).
        const urgencyOf = (r) => (r.meta && typeof r.meta.urgency === "number") ? r.meta.urgency : null;
        const itemHtml = (r) => {
          const u = urgencyOf(r);
          return `
                <a class="ash-notif-item${unread(r) ? " is-unread" : ""}" href="${esc(r.href || "#")}" data-id="${esc(r.id)}">
                  <span class="ash-notif-t"><span class="ash-notif-area is-${esc(r.area)}">${esc(areaLabel(r.area))}</span>${u != null && u >= 2 ? `<span class="ash-notif-urgent${u === 3 ? " is-3" : ""}"${r.meta.urgency_why ? ` title="${esc(r.meta.urgency_why)}"` : ""}>${u === 3 ? "Urgent" : "Needs you"}</span>` : ""}${esc(r.title)}</span>
                  ${r.body ? `<span class="ash-notif-b">${esc(r.body)}</span>` : ""}
                  <span class="ash-notif-w">${esc(ago(r.created_at))}</span>
                </a>`;
        };
        const wireReads = (box) => box.querySelectorAll("[data-id]").forEach((el) => {
          el.addEventListener("click", () => {
            // Opening it is reading it; the link carries on to the thing.
            supabase.rpc("notification_read", { p_id: el.getAttribute("data-id") }).then(() => {}, () => {});
          });
        });

        function paint() {
          const n = rows.filter(unread).length;
          dot.hidden = n === 0;
          list.innerHTML = rows.length
            ? rows.slice(0, 40).map(itemHtml).join("")
            : '<p class="ash-notif-empty">Nothing needs you right now.</p>';
          wireReads(list);
          if (!nx.hidden) paintNx();
        }

        /* ---- Popped out: filter by type, unread and how recent; sort by
           newest, oldest or most urgent. Urgency is asked for only when that
           sort is chosen, and only for the ones not yet judged. ---- */
        const nx = document.getElementById("ash-nx");
        // Out of the top bar, whose styling would otherwise pin a fixed
        // overlay inside it rather than over the page.
        if (nx && nx.parentElement !== document.body) document.body.appendChild(nx);
        const nxList = document.getElementById("ash-nx-list");
        const nxNote = document.getElementById("ash-nx-note");
        const NX = { type: "all", within: 0, unread: false, sort: "new" };
        const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
        let judging = false;
        function nxRows() {
          const since = NX.within ? Date.now() - NX.within * 3600e3 : 0;
          let out = rows.filter((r) => (NX.type === "all" || r.area === NX.type)
            && (!NX.unread || unread(r))
            && (!since || new Date(r.created_at).getTime() >= since));
          const t = (r) => new Date(r.created_at).getTime();
          if (NX.sort === "old") out = out.slice().sort((a, b) => t(a) - t(b));
          else if (NX.sort === "urgent") out = out.slice().sort((a, b) => ((urgencyOf(b) ?? 1) - (urgencyOf(a) ?? 1)) || (t(b) - t(a)));
          else out = out.slice().sort((a, b) => t(b) - t(a));
          return out;
        }
        function paintNx() {
          const areas = [...new Set(rows.map((r) => r.area).filter(Boolean))].sort((a, b) => areaLabel(a).localeCompare(areaLabel(b)));
          document.getElementById("ash-nx-types").innerHTML = [["all", "All types"], ...areas.map((a) => [a, areaLabel(a)])].map(([k, l]) =>
            `<button type="button" class="ash-nx-chip${NX.type === k ? " is-on" : ""}" data-type="${esc(k)}">${esc(l)} <b>${k === "all" ? rows.length : rows.filter((r) => r.area === k).length}</b></button>`).join("");
          const shown = nxRows();
          document.getElementById("ash-nx-count").textContent = `${shown.length} of ${rows.length}`;
          nxList.innerHTML = shown.length ? shown.map(itemHtml).join("")
            : '<p class="ash-notif-empty">Nothing matches. Try another type or a longer time.</p>';
          wireReads(nxList);
        }
        async function judgeUrgency() {
          const ids = rows.filter((r) => urgencyOf(r) == null).map((r) => r.id).slice(0, 80);
          if (!ids.length || judging || !WORKER) return;
          judging = true;
          nxNote.hidden = false; nxNote.textContent = `Reading ${ids.length} notification${ids.length === 1 ? "" : "s"} to see which are urgent…`;
          try {
            const { data: { session } } = await supabase.auth.getSession();
            const r = await fetch(`${WORKER}/admin/notifications/urgency`, {
              method: "POST",
              headers: { "Content-Type": "application/json", Authorization: "Bearer " + (session && session.access_token) },
              body: JSON.stringify({ ids }),
            });
            const j = r.ok ? await r.json() : {};
            const u = j.urgency || {};
            rows = rows.map((x) => u[x.id] ? Object.assign({}, x, { meta: Object.assign({}, x.meta || {}, { urgency: u[x.id].level, urgency_why: u[x.id].why }) }) : x);
            nxNote.hidden = true;
          } catch (_) {
            nxNote.textContent = "Couldn't work out urgency just now, so these are newest first.";
          }
          judging = false;
          paintNx();
          // More than one batch's worth: carry on with the rest.
          if (NX.sort === "urgent" && rows.some((r) => urgencyOf(r) == null) && nxNote.hidden) judgeUrgency();
        }
        function openNx() {
          panel.hidden = true; btn.setAttribute("aria-expanded", "false");
          nx.hidden = false; document.body.classList.add("ash-nx-open");
          paintNx();
          load(200);
        }
        function closeNx() { nx.hidden = true; document.body.classList.remove("ash-nx-open"); }
        document.getElementById("ash-notif-pop")?.addEventListener("click", (e) => { e.stopPropagation(); openNx(); });
        nx.addEventListener("click", (e) => {
          if (e.target.closest("[data-nx-close]")) { closeNx(); return; }
          const tb = e.target.closest("[data-type]");
          if (tb) { NX.type = tb.getAttribute("data-type"); paintNx(); return; }
          const wb = e.target.closest("[data-within]");
          if (wb) {
            NX.within = Number(wb.getAttribute("data-within")) || 0;
            nx.querySelectorAll("[data-within]").forEach((b) => b.classList.toggle("is-on", b === wb));
            paintNx(); return;
          }
          if (e.target.closest("#ash-nx-unread")) {
            NX.unread = !NX.unread;
            const ub = document.getElementById("ash-nx-unread");
            ub.classList.toggle("is-on", NX.unread); ub.setAttribute("aria-pressed", String(NX.unread));
            paintNx();
          }
        });
        document.getElementById("ash-nx-sort")?.addEventListener("change", (e) => {
          NX.sort = e.target.value;
          paintNx();
          if (NX.sort === "urgent") judgeUrgency();
        });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !nx.hidden) closeNx(); });
        document.getElementById("ash-nx-clear")?.addEventListener("click", () => document.getElementById("ash-notif-clear")?.click());

        // The bell needs the latest 40; the pop-out reads further back.
        let depth = 40;
        async function load(n) {
          if (n) depth = Math.max(depth, n);
          try {
            const { data, error } = await supabase
              .from("admin_notifications")
              .select("id, created_at, area, event, title, body, href, read_by, meta")
              .order("created_at", { ascending: false })
              .limit(depth);
            if (error) return;          // table not migrated yet: stay quiet
            rows = data || [];
            paint();
            if (!nx.hidden && NX.sort === "urgent") judgeUrgency();
          } catch (_) {}
        }

        btn.addEventListener("click", () => {
          const open = panel.hidden;
          panel.hidden = !open;
          btn.setAttribute("aria-expanded", String(open));
          if (open) load();
        });
        document.addEventListener("click", (e) => {
          if (!panel.hidden && !e.target.closest("#ash-notif")) {
            panel.hidden = true;
            btn.setAttribute("aria-expanded", "false");
          }
        });
        document.getElementById("ash-notif-clear")?.addEventListener("click", async () => {
          try { await supabase.rpc("notifications_read_all"); } catch (_) {}
          rows = rows.map((r) => Object.assign({}, r, { read_by: (r.read_by || []).concat(me) }));
          paint();
        });

        load();
        // Cheap: one small query, and only while the tab is actually in front.
        setInterval(() => { if (!document.hidden) load(); }, 120000);
      })();

      // Load this admin's profile (name + headshot). Falls back to email/initials.
      let profile = null;
      try {
        const { data } = await supabase.from("admin_profiles").select("full_name, role, avatar_url").eq("user_id", session.user.id).maybeSingle();
        profile = data;
      } catch (_) { /* table may not exist yet */ }

      const name = (profile && profile.full_name) || email.split("@")[0];
      const role = (profile && profile.role) || "Admin";
      const nameEl = document.getElementById("ash-user-name");
      const roleEl = document.getElementById("ash-user-role");
      const avatarEl = document.getElementById("ash-avatar");
      if (nameEl) nameEl.textContent = name;
      if (roleEl) roleEl.textContent = role;
      if (avatarEl) {
        if (profile && profile.avatar_url) {
          avatarEl.innerHTML = "";
          avatarEl.style.background = `center/cover url('${profile.avatar_url}')`;
        } else {
          avatarEl.textContent = (name[0] || "A").toUpperCase();
        }
      }
      // Dev preview counts as management too, so the fuller Dashboard view is
      // what you see by default when building against it locally.
      const isManagement = import.meta.env.DEV ? true : await isManagementUser(session.user);

      // Money is management-only: Payments (Stripe) and the parts of Invoicing
      // that show the ledger. Hidden here as well as refused by the Worker, so
      // an ordinary admin isn't shown a door that won't open.
      // Invoicing too (Danielle, 28 Oct 2026): the team see their own clients'
      // invoices in Social media and Videography, and resend them from there.
      if (!isManagement) {
        document.querySelectorAll('[data-navkey="payments"], [data-navkey="invoicing"]').forEach((el) => {
          const group = el.closest(".ash-group");
          el.remove();
          if (group && !group.querySelector(".ash-link")) group.remove();
        });
        const here = document.getElementById("ash")?.dataset.active;
        if (here === "payments" || here === "invoicing") { location.replace("/admin"); return; }
      }

      // Let pages react once auth + profile are ready.
      document.dispatchEvent(new CustomEvent("ash:ready", { detail: { session, profile, isManagement } }));
    })();
  </script>
</BaseLayout>
