---
// The Email section's tabs (Danielle, 25 Nov 2026; agreed on the "TMKE OS
// Email" mock-up). One underline bar, the same on every Email page. Only the
// tabs that exist are listed: Overview and One-off sends join when they are
// built, so nobody lands on an empty page.
interface Props { active: "campaigns" | "templates" | "automations" }
const { active } = Astro.props;
const TABS = [
  { k: "campaigns", label: "Campaigns", href: "/admin/email/campaigns" },
  { k: "templates", label: "Templates", href: "/admin/email" },
  { k: "automations", label: "Automations", href: "/admin/automations" },
];
---
<nav class="em-tabs" aria-label="Email sections">
  {TABS.map((t) => <a href={t.href} class:list={[active === t.k && "on"]} aria-current={active === t.k ? "page" : undefined}>{t.label}</a>)}
</nav>

<style is:global>
  .em-tabs { display: flex; gap: 26px; margin: 0 0 20px; overflow-x: auto; scrollbar-width: none; box-shadow: inset 0 -1px 0 #eae5e1; font-family: var(--sans); font-size: 14px; font-weight: 400; letter-spacing: 0; text-transform: none; }
  .em-tabs a { flex: none; display: inline-flex; align-items: center; height: 34px; border-bottom: 2px solid transparent; color: #7e6765; text-decoration: none; }
  .em-tabs a:hover { color: #371e28; }
  .em-tabs a.on { color: #371e28; border-bottom-color: #371e28; }
  .em-tabs a:focus-visible { outline: 2px solid #371e28; outline-offset: 2px; }
</style>
