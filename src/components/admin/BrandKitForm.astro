---
/* The brand kit form, shared by Brands (one per TEG brand) and Studio
   branding (the one TMKE designs in). It mirrors the member's own brand kit,
   because it IS their brand kit — the version we hand them pre-filled — and
   two forms for one thing is how the two drift apart.
 *
 * Markup only: each page wires its own load and save. */
interface Props { idPrefix?: string }
const { idPrefix = "bk" } = Astro.props;
---

<div class="bkf" data-kit>
  <section class="bkf-card">
    <h3 class="bkf-title">The brand</h3>
    <div class="bkf-row">
      <label class="bkf-field">
        <span>Company name</span>
        <input type="text" data-f="company" placeholder="e.g. The Property Experts" />
        <small>Printed wherever a template asks for {'{company name}'}.</small>
      </label>
      <label class="bkf-field">
        <span>Website</span>
        <input type="text" data-f="website" placeholder="e.g. thepropertyexperts.co.uk" />
      </label>
    </div>
    <label class="bkf-field">
      <span>Slogan</span>
      <input type="text" data-f="slogan" placeholder="e.g. Your move, made simple" />
      <small>Every brand has one. It fills {'{slogan}'}.</small>
    </label>
  </section>

  <section class="bkf-card">
    <h3 class="bkf-title">Tone of voice</h3>
    <label class="bkf-field">
      <span class="sr-only">Tone of voice</span>
      <textarea data-f="tone" rows="7" placeholder="How this brand sounds. Warm and straight-talking, never pushy. Says 'home', not 'property'. Short sentences. Never uses exclamation marks or estate-agent words like 'stunning' and 'nestled'."></textarea>
      <small>The Creative Assistant writes in this voice for everyone in the brand, so it is worth being specific — including what they never say.</small>
    </label>
  </section>

  <section class="bkf-card">
    <h3 class="bkf-title">Colours</h3>
    <div class="bkf-colors" data-colors></div>
    <small class="bkf-help">Six wells, in order. The first is the one the Studio reaches for first. Empty a hex box to drop that colour.</small>
  </section>

  <section class="bkf-card">
    <h3 class="bkf-title">Typography</h3>
    <div class="bkf-row bkf-row--three">
      <label class="bkf-field">
        <span>Heading</span>
        <input type="text" data-f="font_heading" placeholder="e.g. The Seasons" list={`${idPrefix}-fonts`} />
      </label>
      <label class="bkf-field">
        <span>Subheading</span>
        <input type="text" data-f="font_subheading" placeholder="e.g. Unitext" list={`${idPrefix}-fonts`} />
      </label>
      <label class="bkf-field">
        <span>Body</span>
        <input type="text" data-f="font_body" placeholder="e.g. Unitext" list={`${idPrefix}-fonts`} />
      </label>
    </div>
    <datalist id={`${idPrefix}-fonts`} data-fontlist></datalist>
    <small class="bkf-help">Any Google font, or one from Uploaded fonts — a family, not a cut: pick <em>The Seasons</em> and bold and italic come with it.</small>
  </section>

  <section class="bkf-card">
    <h3 class="bkf-title">Logos</h3>
    <div class="bkf-logos">
      <div class="bkf-logo" data-logo="0">
        <span class="bkf-logo-img"></span>
        <div class="bkf-logo-acts">
          <strong>Main logo</strong>
          <label class="admin-btn admin-btn-ghost admin-btn-sm">Upload<input type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" data-logo-file="0" hidden /></label>
          <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-logo-clear="0" hidden>Remove</button>
        </div>
      </div>
      <div class="bkf-logo" data-logo="1">
        <span class="bkf-logo-img"></span>
        <div class="bkf-logo-acts">
          <strong>Second logo</strong>
          <label class="admin-btn admin-btn-ghost admin-btn-sm">Upload<input type="file" accept="image/png,image/jpeg,image/svg+xml,image/webp" data-logo-file="1" hidden /></label>
          <button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-logo-clear="1" hidden>Remove</button>
        </div>
      </div>
    </div>
    <small class="bkf-help">A dark version and a light one, usually. PNG or SVG on a transparent background.</small>
  </section>

  <div class="bkf-save">
    <button type="button" class="admin-btn admin-btn-primary" data-save>Save</button>
    <span class="bkf-status" data-status></span>
  </div>
</div>

<style is:global>
  .bkf { display: grid; gap: 18px; max-width: 880px; }
  .bkf-card {
    background: #fff; border: 1px solid rgba(28,29,34,0.12); border-radius: 12px;
    padding: 24px 26px;
  }
  .bkf-title {
    font-family: var(--sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.5);
    margin: 0 0 16px;
  }
  .bkf-row { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; margin-bottom: 16px; }
  .bkf-row--three { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 900px) { .bkf-row--three { grid-template-columns: 1fr; } }
  .bkf-row:last-child { margin-bottom: 0; }
  @media (max-width: 720px) { .bkf-row { grid-template-columns: 1fr; } }

  .bkf-field { display: flex; flex-direction: column; gap: 7px; min-width: 0; }
  .bkf-field > span {
    font-family: var(--sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,29,34,0.55);
  }
  .bkf-field input, .bkf-field textarea {
    width: 100%; box-sizing: border-box; padding: 12px 14px;
    font-family: var(--sans); font-size: 14px; line-height: 1.6; color: var(--ink);
    background: #fff; border: 1px solid rgba(28,29,34,0.18); border-radius: 7px;
    resize: vertical;
  }
  .bkf-field textarea { min-height: 150px; }
  .bkf-field input:focus, .bkf-field textarea:focus {
    outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.12);
  }
  .bkf-field small, .bkf-help {
    font-family: var(--sans); font-size: 12px; line-height: 1.5; color: rgba(28,29,34,0.45);
    display: block;
  }
  .bkf-help { margin-top: 12px; }

  .bkf-colors { display: flex; gap: 14px; flex-wrap: wrap; }
  .bkf-swatch { display: flex; flex-direction: column; align-items: center; gap: 7px; }
  .bkf-swatch input[type="color"] {
    width: 58px; height: 58px; padding: 0; cursor: pointer;
    border: 1px solid rgba(28,29,34,0.2); border-radius: 10px; background: #fff;
  }
  .bkf-swatch input[type="text"] {
    width: 86px; padding: 6px; text-align: center; text-transform: uppercase;
    font-family: var(--sans); font-size: 11px; letter-spacing: 0.04em; color: rgba(28,29,34,0.65);
    border: 1px solid rgba(28,29,34,0.14); border-radius: 6px;
  }

  .bkf-logos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (max-width: 720px) { .bkf-logos { grid-template-columns: 1fr; } }
  .bkf-logo {
    display: flex; align-items: center; gap: 16px;
    border: 1px dashed rgba(28,29,34,0.22); border-radius: 10px; padding: 14px;
  }
  /* Split down the diagonal: paper on one side, wine on the other. Most brand
     logos come in a dark version and a white one, and a white mark on a white
     tile is invisible — which is exactly the file you most need to check you
     uploaded. Either version shows against one half. */
  .bkf-logo-img {
    flex: none; width: 116px; height: 78px; border-radius: 6px;
    background-image: linear-gradient(115deg, #faf9f8 0 50%, var(--english-violet, #371e28) 50% 100%);
    background-size: cover;
    position: relative;
  }
  .bkf-logo-img::after {
    content: ""; position: absolute; inset: 8px;
    background: var(--bkf-logo, none) center/contain no-repeat;
  }
  .bkf-logo-acts { display: flex; flex-direction: column; align-items: flex-start; gap: 7px; min-width: 0; }
  .bkf-logo-acts strong {
    font-family: var(--sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,29,34,0.55);
  }
  .admin-btn-sm { padding: 6px 12px; font-size: 10.5px; }

  .bkf-save { display: flex; align-items: center; gap: 12px; }
  .bkf-status { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
</style>
