---
/* The one-time offer, for a member who built their own kit before their brand
   had one to give. Nothing has been changed when this appears — it is a
   question, and both answers are real. Drawn by script only when the Worker
   says there is an offer to make. */
---

<div class="bko-scrim" id="bko" hidden>
  <div class="bko ws-card" role="dialog" aria-modal="true" aria-labelledby="bko-title">
    <div class="bko-eyebrow">Your brand kit</div>
    <h2 class="bko-title" id="bko-title">Introducing ready-made Brand Kits for <em id="bko-brand">your brand</em></h2>

    <p class="bko-lede">
      We've built a complete Brand Kit for every TEG brand, with the correct colours, fonts,
      logos, brand details and tone of voice already set up for you.
    </p>
    <p class="bko-lede">
      We've even added your own contact details, so it's ready to use from the moment you load it.
    </p>
    <p class="bko-lede">
      Load it and your current Brand Kit will be replaced with <strong id="bko-brand-2">your brand</strong>'s
      latest branding. As long as you keep the Brand Kit as supplied, we'll keep it updated
      whenever the brand changes.
    </p>
    <p class="bko-lede">
      You can still make it your own afterwards. Just bear in mind that once you customise the
      supplied branding, those details become yours and future brand updates won't automatically
      replace them.
    </p>

    <div class="bko-acts">
      <button type="button" class="ws-btn ws-btn--primary" id="bko-load">Load my brand's kit</button>
      <button type="button" class="ws-btn ws-btn--ghost" id="bko-keep">Keep the one I made</button>
    </div>
    <p class="bko-small">
      Keeping your own means future brand updates won't reach you. You can switch to the
      ready-made kit later if you change your mind.
    </p>
  </div>
</div>

<style is:global>
  /* The hub's own furniture: ws-card for the panel, ws-btn for the buttons,
     ws tokens for ink, line and accent. Nothing new invented — a dialog that
     arrives on someone's first visit should look like the place it arrived in. */
  .bko-scrim {
    /* The hub's tokens, declared here rather than inherited. This dialog is
       mounted outside the page's .ws wrapper -- which is where --ws-accent and
       friends live -- so every one of them came back undefined: the primary
       button computed to white text on no background and was, to the member,
       simply not there. A dialog has to carry its own clothes. */
    --ws-card: #ffffff;
    --ws-ink: #1c1d22;
    --ws-line: rgba(28, 29, 34, 0.13);
    --ws-accent: var(--english-violet, #5b4a55);
    --ws-r: 4px;
    --ws-btn-h: 30px;
    --ws-ease: cubic-bezier(.2, .8, .2, 1);
    position: fixed; inset: 0; z-index: 600;
    display: flex; align-items: center; justify-content: center; padding: 24px;
    background: rgba(16, 14, 22, 0.5);
    backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
  }
  .bko-scrim[hidden] { display: none; }
  .bko {
    width: 100%; max-width: 540px; box-sizing: border-box;
    background: var(--ws-card, #fff); color: var(--ws-ink, #1c1d22);
    border: 1px solid var(--ws-line, rgba(28,29,34,0.13));
    border-radius: 10px; padding: 34px 34px 28px;
    box-shadow: 0 30px 80px -24px rgba(16, 14, 22, 0.5);
    max-height: calc(100vh - 48px); overflow-y: auto;
  }
  .bko-eyebrow {
    font-family: var(--sans); font-size: 10.5px; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--ws-accent, #5b4a55); margin-bottom: 14px;
  }
  .bko-title {
    font-family: var(--serif); font-weight: 400;
    font-size: clamp(24px, 3.4vw, 30px); line-height: 1.18;
    margin: 0 0 16px; text-wrap: balance;
  }
  .bko-title em { font-style: normal; color: var(--ws-accent, #5b4a55); }
  .bko-lede {
    font-family: var(--sans); font-size: 14px; line-height: 1.7;
    color: rgba(28,29,34,0.72); margin: 0 0 12px;
  }
  .bko-lede strong { color: var(--ws-ink, #1c1d22); font-weight: 600; }
  .bko-acts { display: flex; gap: 10px; flex-wrap: wrap; align-items: center; margin: 22px 0 14px; }
  .bko-acts .ws-btn { text-decoration: none; }
  .bko-small {
    font-family: var(--sans); font-size: 12px; line-height: 1.6;
    color: rgba(28,29,34,0.5); margin: 0;
  }
</style>

<script>
  import { supabase } from '../lib/supabase.js';
  import { syncBrandKit, adoptBrandKit, keepOwnBrandKit } from '../lib/brand-sync.js';

  const scrim = document.getElementById('bko');
  const setBrand = (b) => {
    document.getElementById('bko-brand').textContent = b;
    document.getElementById('bko-brand-2').textContent = b;
  };

  syncBrandKit(supabase, {
    onOffer: (out, { token, uid }) => {
      setBrand(out.brand);
      scrim.hidden = false;

      document.getElementById('bko-load').addEventListener('click', async (e) => {
        e.currentTarget.disabled = true;
        e.currentTarget.textContent = 'Loading…';
        const res = await adoptBrandKit(token, out.brand);
        if (res && res.ok) {
          const { writeBrandCache } = await import('../lib/brand-cache.js');
          writeBrandCache(res.kit, uid);
          location.href = '/account/profile';
        } else {
          e.currentTarget.disabled = false;
          e.currentTarget.textContent = 'Load my brand’s kit';
        }
      });

      document.getElementById('bko-keep').addEventListener('click', async () => {
        scrim.hidden = true;
        await keepOwnBrandKit(token, out.brand, uid);
      });
    },
  });
</script>
