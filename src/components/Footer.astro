---
const year = new Date().getFullYear();
---

<footer id="contact" class="footer">
  <div class="footer-grid">
    <div>
      <div class="footer-mark">TMKE</div>
      <div class="footer-tag">The future of property marketing.</div>
      <p class="footer-blurb">A specialist social media and marketing agency for the UK property sector.</p>
    </div>

    <div>
      <h5>Services</h5>
      <ul>
        <li><a href="/services">Social Media Management</a></li>
        <li><a href="/edit">The Edit</a></li>
        <li><a href="/#brand-looks">Brand Looks</a></li>
        <li><a href="#free-assets" data-fa-open>Five &amp; Live</a></li>
      </ul>
    </div>

    <div>
      <h5>Company</h5>
      <ul>
        <li><a href="/about">About</a></li>
        <li><a href="/blog">Insights</a></li>
        <li><a href="/contact">Contact</a></li>
        <li><a href="/privacy">Privacy</a></li>
      </ul>
    </div>

    <div>
      <h5>Get in touch</h5>
      <ul>
        <li><a href="mailto:hello@tmke.co.uk">hello@tmke.co.uk</a></li>
        <li><a href="tel:+442012345678">+44 (0) 20 1234 5678</a></li>
        <li><a href="/contact">Book a discovery call</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom-left">
      <span>&copy; {year} The Marketing Experts Ltd. All rights reserved.</span>
      <a href="/admin" class="footer-admin">Admin</a>
    </div>
    <div class="footer-socials">
      <a href="#" aria-label="Instagram">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="18" height="18" rx="4" />
          <circle cx="12" cy="12" r="4" />
          <circle cx="17.5" cy="6.5" r="0.8" fill="currentColor" />
        </svg>
      </a>
      <a href="#" aria-label="LinkedIn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <rect x="3" y="3" width="18" height="18" rx="2" />
          <path d="M8 10v7M8 7v.01M12 17v-4a2 2 0 014 0v4M12 10v7" />
        </svg>
      </a>
      <a href="#" aria-label="Facebook">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
          <path d="M18 2h-3a5 5 0 00-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 011-1h3z" />
        </svg>
      </a>
    </div>
  </div>
</footer>
