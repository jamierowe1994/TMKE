---
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};

const links: { label: string; href: string }[] = [
  { label: "About", href: "/about" },
  { label: "The Edit", href: "/edit" },
  { label: "Social Media", href: "/services" },
  { label: "Insights", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<nav class="nav" id="nav">
  <a href="/" class="nav-logo">TMKE</a>
  <div class="nav-links">
    {
      links.map((l) => (
        <a href={l.href} class:list={["nav-link", isActive(l.href) && "is-active"]}>
          {l.label}
        </a>
      ))
    }
  </div>
  <div class="nav-actions">
    <a href="/login" id="nav-login" class="nav-cta" aria-label="Login to your TMKE account"><span>Login</span></a>
  </div>
</nav>

<script>
  // Splash is now a pure-CSS animation — no media to prefetch.

  // If the user already has a Supabase session, swap the Login button to take
  // them to their library. First-time logins (no brand kit yet) get routed via
  // the brand-kit profile, fronted by the brand splash overlay.
  import { supabase } from "../lib/supabase.js";
  (async () => {
    const btn = document.getElementById("nav-login");
    if (!btn) return;
    const { data: { session } } = await supabase.auth.getSession();
    if (!session) return;

    const label = btn.querySelector("span");
    if (label) label.textContent = "Library";
    btn.setAttribute("href", "/account");

    btn.addEventListener("click", function (e) {
      let firstTime = false;
      try {
        firstTime = !localStorage.getItem("tmke.brand") && !localStorage.getItem("tmke.brand.skipped");
      } catch (_) { /* ignore */ }
      const dest = firstTime ? "/profile?next=/account" : "/account";
      if (typeof window.tmkeSplash === "function") {
        e.preventDefault();
        window.tmkeSplash(dest);
      }
    });
  })();
</script>
