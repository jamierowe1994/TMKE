---
import NavDrawer from "./NavDrawer.astro";

/* drawer=false for a page that renders <NavDrawer /> itself. The .pf deck pages
   (/services, /videography) put this bar inside a wrapper that is display:none
   on a desktop, so a drawer rendered from here would be hidden with it — which
   is exactly the bug that made the videography burger do nothing. They keep
   their own, outside that wrapper, and there is still only ever one. */
interface Props { drawer?: boolean }
const { drawer = true } = Astro.props;

const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};

const links: { label: string; href: string }[] = [
  { label: "About", href: "/about" },
  { label: "Social Media", href: "/services" },
  /* One page, two ways in. Agents looking for stills were not going to click
     "Videography", and one line reading "Videography & Photography" would have
     been twice the length of everything else — so it is two (Dani, 7 Oct).
     The hash opens the deck on the photography route. */
  { label: "Property Videography", href: "/videography" },
  { label: "Property Photography", href: "/videography#photography" },
  { label: "The Edit", href: "/edit" },
  { label: "Insights", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<nav class="nav" id="nav">
  <a href="/" class="nav-logo">TMKE</a>
  <div class="nav-links">
    {
      links.map((l) => (
        <a href={l.href} class:list={["nav-link", isActive(l.href) && "is-active"]}>
          {l.label}
        </a>
      ))
    }
  </div>
  <div class="nav-actions">
    {/* "Create account" is no longer here: widening the members button (so Login and
        Members share one edge) brought it up against this link. It lives in the Menu
        drawer, which opens on desktop as well as mobile, so /join is still one click
        from every page. */}
    <a href="/login" id="nav-login" class="nav-cta js-nav-login" aria-label="Login to your TMKE account"><span>Login</span></a>
    <button
      type="button"
      class="nav-menu-btn"
      id="nav-burger"
      aria-label="Open menu"
      aria-controls="nav-drawer"
      aria-expanded="false"
      data-nav-drawer-open
    >
      {/* No "Menu" word, and three even bars: the same burger the deck pages
          (/services, /videography) carry, so every header on the site opens the
          same way (Dani, 7 Oct). The label is on aria-label for screen readers. */}
      <span class="nav-menu-btn-glyph" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>
  </div>
</nav>

<!-- The one drawer. This file used to carry a second copy with the same id;
     see NavDrawer.astro for what that broke. -->
{drawer && <NavDrawer />}

