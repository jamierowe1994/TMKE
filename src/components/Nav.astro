---
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};

const links: { label: string; href: string }[] = [
  { label: "About", href: "/about" },
  { label: "The Edit", href: "/edit" },
  { label: "Social Media", href: "/services" },
  { label: "Insights", href: "/blog" },
];
---

<nav class="nav" id="nav">
  <a href="/" class="nav-logo">TMKE</a>
  <div class="nav-links">
    {
      links.map((l) => (
        <a href={l.href} class:list={["nav-link", isActive(l.href) && "is-active"]}>
          {l.label}
        </a>
      ))
    }
  </div>
  <div class="nav-actions">
    <a href="/admin" class="nav-admin" aria-label="TMKE admin dashboard">Admin</a>
    <a href="/account" id="nav-login" class="nav-cta" aria-label="Login to your TMKE account"><span>Login</span></a>
  </div>
</nav>

<script is:inline>
  (function () {
    // Temporary auth shortcut: clicking Login auto-creates a demo session
    // and shows the brand splash whilst we navigate to the library.
    const btn = document.getElementById("nav-login");
    if (!btn) return;
    btn.addEventListener("click", function (e) {
      let firstTime = false;
      try {
        if (!localStorage.getItem("tmke.session")) {
          localStorage.setItem("tmke.session", JSON.stringify({
            email: "demo@agency.co.uk",
            name: "demo",
            signedInAt: Date.now(),
          }));
        }
        const hasBrand = localStorage.getItem("tmke.brand");
        const skipped = localStorage.getItem("tmke.brand.skipped");
        firstTime = !hasBrand && !skipped;
      } catch (err) { /* ignore */ }
      const dest = firstTime ? "/profile?next=/account" : "/account";
      if (typeof window.tmkeSplash === "function") {
        e.preventDefault();
        window.tmkeSplash(dest);
      } else {
        e.preventDefault();
        window.location.href = dest;
      }
    });
  })();
</script>
