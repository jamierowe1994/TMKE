---
const pathname = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  return pathname === href || pathname.startsWith(href + "/");
};

const links: { label: string; href: string }[] = [
  { label: "About", href: "/about" },
  { label: "The Edit", href: "/edit" },
  { label: "Social Media", href: "/services" },
  { label: "Insights", href: "/blog" },
];
---

<nav class="nav" id="nav">
  <a href="/" class="nav-logo">TMKE</a>
  <div class="nav-links">
    {
      links.map((l) => (
        <a href={l.href} class:list={["nav-link", isActive(l.href) && "is-active"]}>
          {l.label}
        </a>
      ))
    }
  </div>
  <div class="nav-actions">
    <a href="/admin" class="nav-admin" aria-label="TMKE admin dashboard">Admin</a>
    <a href="/login" id="nav-login" class="nav-cta" aria-label="Login to your TMKE account"><span>Login</span></a>
  </div>
</nav>

<script>
  // If the user already has a Supabase session, the Login button takes them
  // straight to their library instead of bouncing through the sign-in form.
  import { supabase } from "../lib/supabase.js";
  (async () => {
    const btn = document.getElementById("nav-login");
    if (!btn) return;
    const { data: { session } } = await supabase.auth.getSession();
    if (session) {
      btn.setAttribute("href", "/account");
      const label = btn.querySelector("span");
      if (label) label.textContent = "Library";
    }
  })();
</script>
