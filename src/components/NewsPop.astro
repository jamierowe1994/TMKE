---
/**
 * Phones only: the newsletter as a pop-up rather than a chapter. It appears once
 * a reader has been on the site for a while (POP_AFTER_SECONDS, counted across
 * pages while the tab is visible), once per visit, and not again for a month
 * after it has been closed. The frame is Chapter 03's: the picture inset 14px
 * from the screen with the paper box in its top-left.
 */
const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
const IMG = "https://assets.tmke.co.uk/TMKE%20Home%20Page/Homepage%20footer.png";
---
<div class="npop" id="npop" role="dialog" aria-modal="true" aria-label="Subscribe to the newsletter" hidden data-worker={WORKER}>
  <div class="npop-frame">
    <div class="npop-img" style={`background-image:url('${IMG}')`}></div>
    <button type="button" class="npop-close" data-npop-close aria-label="Close">&times;</button>
    <div class="npop-box">
      <div class="npop-chapter">Newsletter</div>
      <div class="npop-body">
        <h3 class="npop-h">For the days when you should post, but don&rsquo;t know what.</h3>
        <p class="npop-sub">Get clear, structured marketing insights for estate agents, straight to your inbox every month.</p>
        <form class="npop-form" id="npop-form">
          <input type="email" name="email" placeholder="Email address" autocomplete="email" required />
          <button type="submit">Subscribe</button>
        </form>
        <button type="button" class="npop-later" data-npop-close>Not now</button>
      </div>
      <div class="npop-done">
        <h3 class="npop-h">You&rsquo;re on the list.</h3>
        <p class="npop-sub">See you in your inbox.</p>
      </div>
    </div>
  </div>
</div>

<style>
  .npop { display: none; }
  @media (max-width: 600px) {
    .npop:not([hidden]) {
      display: block; position: fixed; inset: 0; z-index: 900;
      background: var(--paper);
    }
    .npop-frame {
      position: absolute; inset: 14px; overflow: hidden;
      transform: translateY(64px) scale(0.965); opacity: 0;
      transition: transform 1s cubic-bezier(.16,1,.3,1), opacity 0.8s ease;
    }
    .npop.is-in .npop-frame { transform: none; opacity: 1; }
    .npop-img { position: absolute; inset: 0; background-size: cover; background-position: center; background-color: #e9e4da; }
    .npop-close {
      position: absolute; top: 12px; right: 12px; z-index: 3;
      width: 36px; height: 36px; border-radius: 50%; border: none;
      background: var(--paper); color: var(--ink); font-size: 24px; line-height: 36px; text-align: center;
      padding: 0; cursor: pointer;
    }
    .npop-box {
      position: absolute; top: 64px; left: 16px; width: calc(100% - 32px); z-index: 2;   /* clear of the close button */
      box-sizing: border-box; border-radius: 8px; padding: 16px 18px 18px;
      background: var(--paper); color: var(--ink); font-family: var(--sans);
      box-shadow: inset 0 2px 8px rgba(28,29,34,0.10), inset 0 1px 3px rgba(28,29,34,0.06);
    }
    .npop-chapter {
      display: flex; align-items: center; gap: 8px; margin-bottom: 16px;
      font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--english-violet);
    }
    .npop-chapter::before { content: "\2014"; }
    .npop-h { margin: 0 0 8px; font-family: var(--sans); font-size: 18px; line-height: 1.2; font-weight: 600; letter-spacing: -0.01em; }
    .npop-sub { margin: 0; font-size: 13px; line-height: 1.5; color: rgba(28,29,34,0.72); }
    .npop-form { display: flex; flex-direction: column; gap: 10px; margin-top: 16px; }
    .npop-form input {
      width: 100%; box-sizing: border-box; padding: 13px 14px; border-radius: 6px;
      border: 1px solid rgba(28,29,34,0.22); background: #fff; color: var(--ink);
      font-family: var(--sans); font-size: 16px;
    }
    .npop-form input:focus { outline: none; border-color: var(--english-violet); }
    .npop-form button {
      padding: 13px 18px; border: none; border-radius: 6px;
      background: var(--english-violet); color: var(--paper);
      font-family: var(--sans); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer;
    }
    .npop-later {
      display: block; margin: 14px auto 0; padding: 0; border: none; background: none;
      font-family: var(--sans); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.55); cursor: pointer;
    }
    .npop-done { display: none; }
    .npop.is-done .npop-body { display: none; }
    .npop.is-done .npop-done { display: block; }
  }
</style>

<script>
  (function () {
    const POP_AFTER_SECONDS = 90;          // a minute and a half on the site
    const SNOOZE_DAYS = 30;                // after closing, not again for a month
    const pop = document.getElementById("npop");
    if (!pop) return;
    const phone = window.matchMedia("(max-width: 600px)");
    if (!phone.matches) return;
    const KEY_T = "tmke_npop_t", KEY_SHOWN = "tmke_npop_shown", KEY_DONE = "tmke_npop_done";
    const get = (store, k) => { try { return store.getItem(k); } catch (_) { return null; } };
    const set = (store, k, v) => { try { store.setItem(k, v); } catch (_) {} };
    const snoozedUntil = Number(get(localStorage, KEY_DONE) || 0);
    if (snoozedUntil > Date.now()) return;
    if (get(sessionStorage, KEY_SHOWN)) return;

    let lockedY = 0;
    const lock = () => {
      lockedY = window.scrollY || 0;
      document.body.style.position = "fixed"; document.body.style.top = "-" + lockedY + "px";
      document.body.style.left = "0"; document.body.style.right = "0"; document.body.style.width = "100%";
    };
    const unlock = () => {
      document.body.style.position = ""; document.body.style.top = "";
      document.body.style.left = ""; document.body.style.right = ""; document.body.style.width = "";
      window.scrollTo(0, lockedY);
    };
    const show = () => {
      set(sessionStorage, KEY_SHOWN, "1");
      pop.hidden = false;
      lock();
      setTimeout(() => pop.classList.add("is-in"), 20);
    };
    const close = (days) => {
      set(localStorage, KEY_DONE, String(Date.now() + days * 86400000));
      pop.classList.remove("is-in");
      unlock();
      setTimeout(() => { pop.hidden = true; }, 500);
    };
    pop.querySelectorAll("[data-npop-close]").forEach((b) => b.addEventListener("click", () => close(SNOOZE_DAYS)));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !pop.hidden) close(SNOOZE_DAYS); });
    const form = document.getElementById("npop-form");
    if (form) form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = (form.querySelector('input[name="email"]').value || "").trim();
      if (!email) return;
      const WORKER = pop.getAttribute("data-worker") || "";
      if (WORKER) { try { await fetch(WORKER + "/newsletter", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email }) }); } catch (_) {} }
      form.reset();
      pop.classList.add("is-done");
      setTimeout(() => close(365), 1800);
    });

    // Count seconds on the site (across pages, while the tab is visible).
    let t = Number(get(sessionStorage, KEY_T) || 0);
    const tick = () => {
      if (document.visibilityState !== "visible" || !phone.matches) return;
      t += 1; set(sessionStorage, KEY_T, String(t));
      if (t < POP_AFTER_SECONDS) return;
      // Not over the homepage opening or another sheet that is open.
      if (document.getElementById("hi-open") || document.querySelector(".msheet.is-open, .npanel.is-open, .sms-sheet.is-open")) return;
      clearInterval(timer);
      show();
    };
    const timer = setInterval(tick, 1000);
  })();
</script>
