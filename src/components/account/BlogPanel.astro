---
// Member-facing Blog section. Rendered both as a standalone page
// (/account/blog) and inside the side-drawer on /account.
// Member-exclusive — deeper dives on platform changes, sector insight, and
// tactics, separate from the marketing /blog. Posts come from the database
// (audience = 'members'); falls back to a built-in set until any are authored.
import { getMembersPosts } from "../../data/blog.js";

let posts = [];
try { posts = await getMembersPosts(); } catch (_) {}
const featured = posts[0] || null;
const rest = posts.slice(1, 7);
const meta = (p, lead) => [lead, p.category, p.readTime ? p.readTime + " min" : null].filter(Boolean).join(" · ");
---

<div class="acc-section">
  <header class="acc-section-head">
    <div class="acc-blog-head-row">
      <div>
        <p class="acc-section-eyebrow">Members only</p>
        <h2 class="acc-section-title">Inside The Edit</h2>
        <p class="acc-section-sub">Long-form pieces written for the agencies inside the platform. Platform changes, tactics that are working right now, and what we're testing behind the scenes.</p>
      </div>
      <span class="acc-blog-flag">Exclusive</span>
    </div>
  </header>

  {featured && (
    <a class="acc-blog-hero" href={`/account/blog#${featured.slug}`}>
      <div class="acc-blog-hero-art" style={`background-image:url('${featured.hero}')`}></div>
      <div class="acc-blog-hero-body">
        <span class="acc-blog-card-meta">{meta(featured, "Featured")}</span>
        <h3 class="acc-blog-hero-title">{featured.title}</h3>
        <p class="acc-blog-hero-desc">{featured.standfirst}</p>
        <span class="acc-blog-card-cta">Read the piece <em>&rarr;</em></span>
      </div>
    </a>
  )}

  <div class="acc-blog-grid">
    {rest.map((p) => (
      <a class="acc-blog-card" href={`/account/blog#${p.slug}`}>
        <div class="acc-blog-card-art" style={`background-image:url('${p.hero}')`}></div>
        <div class="acc-blog-card-body">
          <span class="acc-blog-card-meta">{meta(p)}</span>
          <h4 class="acc-blog-card-title">{p.title}</h4>
          <p class="acc-blog-card-desc">{p.standfirst}</p>
        </div>
      </a>
    ))}
  </div>

  <footer class="acc-section-foot">
    <span class="acc-section-foot-tag">New every two weeks</span>
    Members get the next piece in their inbox the day it goes live.
  </footer>
</div>

<style>
  /* Feature piece → plum with white text. The six topic cards (Tactics,
     Strategy, Channel, Brand, Content, AI) go from grey glass to clean white,
     framed with a light hairline so the grid feels airy. Plum is the brand
     #371e28 used literally (the account shell remaps --english-violet to the
     theme accent, which isn't what we want for the feature card). */
  .acc-blog-hero { background: #371e28; border-color: #2a161e; color: #fff; }
  .acc-blog-hero-title { color: #fff; }
  .acc-blog-hero-desc { color: rgba(255, 255, 255, 0.82); }
  .acc-blog-hero .acc-blog-card-meta { color: rgba(255, 255, 255, 0.72); }
  .acc-blog-hero .acc-blog-card-cta { color: #fff; }

  .acc-blog-card { background: #fff; border: 1px solid #d9d6d2; box-shadow: none; }
</style>
