---
/* Our latest Instagram posts in a row (Dani, 17 Oct, after Blanche Studio's
   foot): "Follow along on Instagram @handle" over a full-width line of square
   posts, each opening the post on Instagram.

   Where the posts come from, src/data/instagram-feed.js:
     INSTAGRAM_FEED_URL -- a Behold JSON feed (behold.so: connect the account,
                           make a JSON feed, paste its link). Read live.
     INSTAGRAM_POSTS    -- or listed by hand, { image, href }.
   With neither, nothing shows; while the feed loads, nothing shows either:
   the row appears once its pictures are in. */
import { INSTAGRAM_FEED_URL, INSTAGRAM_POSTS, INSTAGRAM_HANDLE } from "../../data/instagram-feed.js";
const on = !!INSTAGRAM_FEED_URL || INSTAGRAM_POSTS.length > 0;
const profile = INSTAGRAM_HANDLE ? `https://www.instagram.com/${INSTAGRAM_HANDLE}/` : "";
---
{on && (
  <section class="ig" aria-label="Our latest Instagram posts" data-ig={INSTAGRAM_FEED_URL} hidden>
    <p class="ig-h">Follow along on Instagram{INSTAGRAM_HANDLE && <> <a href={profile} target="_blank" rel="noopener">@{INSTAGRAM_HANDLE}</a></>}</p>
    <div class="ig-row" data-ig-row></div>
    <script type="application/json" data-ig-posts set:html={JSON.stringify(INSTAGRAM_POSTS)}></script>
  </section>
)}

<style is:global>
  .ig { flex: none; display: flex; flex-direction: column; gap: 12px; }
  .ig[hidden] { display: none; }
  .ig-h { margin: 0; text-align: center; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink, #1c1d22); }
  .ig-h a { color: #371e28; text-decoration: none; }
  .ig-h a:hover { text-decoration: underline; text-underline-offset: 3px; }
  /* Edge to edge, square, a hairline between: eight across, fewer on smaller screens. */
  .ig-row { display: grid; grid-template-columns: repeat(8, minmax(0, 1fr)); gap: 2px; }
  .ig-tile { position: relative; display: block; aspect-ratio: 1 / 1; overflow: hidden; background: #eae5e1; }
  .ig-tile img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(.2,.8,.2,1); }
  .ig-tile:hover img { transform: scale(1.05); }
  .ig-tile:focus-visible { outline: 2px solid #371e28; outline-offset: 2px; }
  @media (max-width: 1100px) { .ig-row { grid-template-columns: repeat(6, minmax(0, 1fr)); } .ig-tile:nth-child(n+7) { display: none; } }
  @media (max-width: 700px) { .ig-row { grid-template-columns: repeat(4, minmax(0, 1fr)); } .ig-tile:nth-child(n+5) { display: none; } }
</style>

<script>
  document.querySelectorAll("[data-ig]").forEach(async (box) => {
    const row = box.querySelector("[data-ig-row]");
    let posts = [];
    try { posts = JSON.parse(box.querySelector("[data-ig-posts]").textContent || "[]"); } catch (_) {}
    const url = box.getAttribute("data-ig");
    if (url) {
      try {
        const j = await fetch(url).then((r) => (r.ok ? r.json() : null));
        // Behold's feed is { posts: [...] } (older feeds, a bare array). Videos
        // carry a thumbnail; pictures their own sized copies.
        const list = Array.isArray(j) ? j : (j && Array.isArray(j.posts) ? j.posts : []);
        posts = list.map((p) => ({
          image: (p.sizes && (p.sizes.medium || p.sizes.small || p.sizes.large || {}).mediaUrl) || p.thumbnailUrl || (p.mediaType !== "VIDEO" ? p.mediaUrl : "") || "",
          href: p.permalink || "",
          alt: String(p.prunedCaption || p.caption || "Instagram post").slice(0, 120),
        }));
      } catch (_) { /* the hand-listed posts, if any */ }
    }
    posts = posts.filter((p) => p && p.image).slice(0, 8);
    if (!posts.length) return;
    // Shown once every picture has loaded (or failed), never half-filled.
    await Promise.all(posts.map((p) => new Promise((res) => { const i = new Image(); i.onload = i.onerror = res; i.src = p.image; })));
    posts.forEach((p) => {
      const a = document.createElement("a");
      a.className = "ig-tile"; a.target = "_blank"; a.rel = "noopener";
      a.href = p.href || "#";
      const img = document.createElement("img");
      img.src = p.image; img.alt = p.alt || "Instagram post"; img.loading = "lazy";
      a.appendChild(img);
      row.appendChild(a);
    });
    box.hidden = false;
  });
</script>
