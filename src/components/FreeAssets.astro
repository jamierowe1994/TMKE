---
/**
 * Floating "Five & Live" lead-capture tab. Sits fixed on the left edge once
 * the hero is out of view.
 *
 * Two states driven by `data-state`:
 *   - collapsed: vertical tab poking out of the left edge ("Five & Live")
 *   - preview:   wide preview panel — the five day-by-day templates in a
 *                strip + an email capture below. Submitting promises an
 *                editable link by email.
 *
 * The list-of-assets step has been removed: Five & Live is now the only
 * freebie, so the tab opens straight into its preview.
 */
---

<aside class="fa" id="free-assets" data-state="collapsed" aria-label="Five & Live preview">
  <!-- Collapsed: thin vertical tab poking out of the left edge -->
  <button type="button" class="fa-tab" aria-label="Open the Five &amp; Live preview" aria-expanded="false">
    <span>Five &amp; Live <em>— Free</em></span>
  </button>

  <!-- Preview: a wider panel showing what the asset is + email capture -->
  <div class="fa-preview" aria-hidden="true">
    <header class="fa-head">
      <div>
        <p class="fa-eyebrow">On the house — Limited drop</p>
        <h3>Five &amp; Live</h3>
      </div>
      <button type="button" class="fa-x" aria-label="Close">&times;</button>
    </header>
    <p class="fa-sub"><em>A week of posts</em> — five ready-to-edit templates for estate agents. Drop in your logo, post.</p>

    <!-- Preview strip — five day-by-day templates -->
    <div class="fa-preview-strip" aria-label="Preview of the five included templates">
      <article class="fa-preview-day" style="--i:1">
        <div class="fa-preview-img" style="background-image:url('/assets/asset%201.png')"></div>
        <div class="fa-preview-meta"><span>Mon</span><span>Carousel</span></div>
      </article>
      <article class="fa-preview-day" style="--i:2">
        <div class="fa-preview-img" style="background-image:url('/assets/asset%202.png')"></div>
        <div class="fa-preview-meta"><span>Tue</span><span>Static</span></div>
      </article>
      <article class="fa-preview-day" style="--i:3">
        <div class="fa-preview-img" style="background-image:url('/assets/asset%203.png')"></div>
        <div class="fa-preview-meta"><span>Wed</span><span>Reel</span></div>
      </article>
      <article class="fa-preview-day" style="--i:4">
        <div class="fa-preview-img" style="background-image:url('/assets/asset%201.png')"></div>
        <div class="fa-preview-meta"><span>Thu</span><span>Story</span></div>
      </article>
      <article class="fa-preview-day" style="--i:5">
        <div class="fa-preview-img" style="background-image:url('/assets/asset%202.png')"></div>
        <div class="fa-preview-meta"><span>Fri</span><span>Carousel</span></div>
      </article>
    </div>

    <ul class="fa-bullets">
      <li>Five editable Canva templates — one per weekday.</li>
      <li>A short guide on what to post when, written for property.</li>
      <li>Yours forever. No watermark, no subscription.</li>
    </ul>

    <!-- Email capture — keeps things to one field, expands on focus. -->
    <form id="fa-submit" class="fa-fields" novalidate>
      <label class="fa-field">
        <span>Your email</span>
        <input name="email" type="email" autocomplete="email" required placeholder="you@agency.co.uk" />
      </label>
      <button type="submit" class="fa-submit">
        <span data-label>Email me the editable link <em>&rarr;</em></span>
      </button>
      <p class="fa-error" id="fa-form-error" hidden></p>
      <p class="fa-ok" id="fa-form-ok" hidden>
        On its way — check your inbox for the editable link in the next few minutes.
      </p>
      <p class="fa-fine">No spam. One email, one link.</p>
    </form>
  </div>
</aside>

<style is:global>
  /* ============================================================
     FreeAssets floating tab — fixed to the left edge.
     Hidden by default; the inline script flips data-shown="true"
     once the hero is out of view.
     ============================================================ */
  .fa {
    position: fixed;
    left: 0;
    top: 38vh;
    z-index: 80;
    pointer-events: none;
    opacity: 0;
    transform: translateX(-20px);
    transition: opacity 0.5s ease, transform 0.5s cubic-bezier(.2,.7,.2,1);
  }
  .fa[data-shown="true"] {
    opacity: 1;
    transform: translateX(0);
    pointer-events: auto;
  }

  /* ===== Collapsed tab ===== */
  .fa-tab {
    appearance: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--english-violet);
    color: var(--paper);
    border: 0;
    margin: 0;
    padding: 28px 13px;
    border-radius: 0 8px 8px 0;
    cursor: pointer;
    box-shadow: 4px 4px 18px -4px rgba(28,29,34,0.3);
    transition: background 0.25s, padding 0.3s, box-shadow 0.3s,
                opacity 0.32s ease, transform 0.4s cubic-bezier(.2,.7,.2,1);
  }
  .fa-tab:hover {
    background: var(--ink);
    padding-right: 17px;
    box-shadow: 6px 4px 22px -4px rgba(28,29,34,0.4);
  }
  .fa-tab span {
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.32em;
    text-transform: uppercase;
  }
  .fa-tab span em {
    font-family: var(--serif);
    font-style: italic;
    letter-spacing: 0.02em;
    font-weight: 400;
    text-transform: none;
    margin-left: 10px;
    color: rgba(240, 238, 235, 0.7);
  }

  /* ===== Preview panel (larger than the old list panel) ===== */
  .fa-preview {
    position: absolute;
    top: -40px;
    left: 0;
    background: var(--english-violet);
    color: var(--paper);
    border-radius: 0 10px 10px 0;
    box-shadow: 16px 22px 70px -10px rgba(28,29,34,0.55);
    opacity: 0;
    pointer-events: none;
    transform: translateX(-16px);
    transition: opacity 0.32s ease, transform 0.45s cubic-bezier(.2,.7,.2,1);
    overflow: hidden;
    width: 520px;
    max-width: calc(100vw - 24px);
    padding: 30px 32px 32px;
  }

  /* State machine — only one of {tab | preview} is interactive at a time. */
  .fa[data-state="preview"] .fa-tab {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-30px);
  }
  .fa[data-state="preview"] .fa-preview {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  /* ===== Head ===== */
  .fa-head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    margin-bottom: 8px;
  }
  .fa-head > div {
    flex: 1;
    min-width: 0;
  }
  .fa-eyebrow {
    margin: 0;
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: rgba(240,238,235,0.55);
  }
  .fa-head h3 {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 32px;
    letter-spacing: -0.012em;
    margin: 4px 0 0;
  }
  .fa-sub {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    line-height: 1.5;
    color: rgba(240,238,235,0.75);
    margin: 8px 0 22px;
  }
  .fa-sub em { color: var(--paper); font-style: italic; }
  .fa-x {
    appearance: none;
    background: transparent;
    border: 1px solid rgba(240,238,235,0.25);
    border-radius: 50%;
    width: 36px; height: 36px;
    color: var(--paper);
    font-family: var(--sans);
    /* Centre the × glyph optically — its baseline metrics drift downward
       without an explicit flex centre + a tiny upward nudge. */
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 22px;
    line-height: 1;
    padding: 0 0 2px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    flex-shrink: 0;
  }
  .fa-x:hover { background: rgba(240,238,235,0.12); border-color: rgba(240,238,235,0.5); }

  /* ===== Preview strip ===== */
  .fa-preview-strip {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 8px;
    margin: 0 0 20px;
  }
  .fa-preview-day {
    display: flex;
    flex-direction: column;
    gap: 6px;
    animation: faPreviewIn 0.55s cubic-bezier(.2,.7,.2,1) backwards;
    animation-delay: calc(var(--i, 1) * 60ms);
  }
  @keyframes faPreviewIn {
    from { opacity: 0; transform: translateY(8px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .fa-preview-img {
    aspect-ratio: 4 / 5;
    background-size: cover;
    background-position: center;
    background-color: rgba(240,238,235,0.08);
    border-radius: 3px;
    box-shadow: 0 6px 16px -8px rgba(0,0,0,0.4);
    transition: transform 0.45s cubic-bezier(.2,.7,.2,1), box-shadow 0.45s;
  }
  .fa-preview-day:hover .fa-preview-img {
    transform: translateY(-3px) scale(1.02);
    box-shadow: 0 14px 28px -12px rgba(0,0,0,0.55);
  }
  .fa-preview-meta {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgba(240,238,235,0.7);
    text-align: center;
  }
  .fa-preview-meta > span:first-child {
    font-weight: 700;
    color: var(--paper);
  }

  /* ===== Bullets ===== */
  .fa-bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 22px;
    display: flex; flex-direction: column;
    gap: 5px;
    font-family: var(--sans);
    font-size: 13px;
    color: rgba(240,238,235,0.78);
  }
  .fa-bullets li {
    padding-left: 18px;
    position: relative;
  }
  .fa-bullets li::before {
    content: "—";
    position: absolute; left: 0;
    color: rgba(240,238,235,0.5);
  }

  /* ===== Form ===== */
  .fa-fields {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .fa-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .fa-field > span {
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(240,238,235,0.7);
  }
  .fa-field input {
    appearance: none;
    background: rgba(240,238,235,0.08);
    border: 1px solid rgba(240,238,235,0.2);
    border-radius: 3px;
    padding: 13px 14px;
    font-family: var(--sans);
    font-size: 15px;
    color: var(--paper);
    outline: none;
    transition: background 0.2s, border-color 0.2s;
  }
  .fa-field input::placeholder { color: rgba(240,238,235,0.4); }
  .fa-field input:focus {
    background: rgba(240,238,235,0.12);
    border-color: rgba(240,238,235,0.5);
  }
  .fa-submit {
    appearance: none;
    background: var(--paper);
    color: var(--english-violet);
    border: 0;
    margin-top: 6px;
    padding: 15px 18px;
    border-radius: 3px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .fa-submit:hover { background: var(--ink); color: var(--paper); }
  .fa-submit[disabled] { opacity: 0.6; cursor: progress; }
  .fa-submit em {
    font-family: var(--serif);
    font-style: italic;
    font-size: 15px;
    letter-spacing: 0;
    text-transform: none;
    margin-left: 6px;
  }
  .fa-error {
    margin: 0;
    padding: 8px 10px;
    background: rgba(184, 130, 106, 0.18);
    color: #f5d3c5;
    border-radius: 3px;
    font-family: var(--sans);
    font-size: 12px;
  }
  .fa-ok {
    margin: 0;
    padding: 10px 12px;
    background: rgba(80, 160, 100, 0.18);
    color: #c7e9d2;
    border-radius: 3px;
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.45;
  }
  .fa-fine {
    margin: 4px 0 0;
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.04em;
    color: rgba(240,238,235,0.5);
  }

  /* ===== Mobile: collapse to bottom-left, full-width panel ===== */
  @media (max-width: 640px) {
    .fa { top: auto; bottom: 14px; }
    .fa-tab { padding: 12px 7px; }
    .fa-tab span { font-size: 10px; }
    .fa-preview {
      width: calc(100vw - 28px);
      max-width: 380px;
      top: -160px;
      padding: 24px 22px 24px;
    }
    .fa-preview-strip { gap: 5px; }
    .fa-preview-meta { font-size: 9px; }
  }
</style>

<script is:inline>
  (function () {
    const wrap = document.getElementById("free-assets");
    if (!wrap) return;
    const tab = wrap.querySelector(".fa-tab");
    const panel = wrap.querySelector(".fa-preview");
    const xButtons = wrap.querySelectorAll(".fa-x");
    const form = wrap.querySelector("#fa-submit");
    const errEl = wrap.querySelector("#fa-form-error");
    const okEl = wrap.querySelector("#fa-form-ok");
    const submitBtn = form?.querySelector('button[type="submit"]');
    const label = submitBtn?.querySelector("[data-label]");
    const originalLabel = label?.innerHTML;

    function setState(s) {
      wrap.setAttribute("data-state", s);
      tab.setAttribute("aria-expanded", s === "preview" ? "true" : "false");
      panel.setAttribute("aria-hidden", s === "preview" ? "false" : "true");
    }

    tab.addEventListener("click", function () { setState("preview"); });
    xButtons.forEach(function (btn) {
      btn.addEventListener("click", function () { setState("collapsed"); });
    });

    // External openers — e.g. the footer "Five & Live" link.
    document.querySelectorAll("[data-fa-open]").forEach(function (el) {
      el.addEventListener("click", function (e) {
        e.preventDefault();
        wrap.setAttribute("data-shown", "true");
        setState("preview");
      });
    });

    document.addEventListener("keydown", function (e) {
      if (e.key === "Escape" && wrap.getAttribute("data-state") !== "collapsed") {
        setState("collapsed");
      }
    });

    form?.addEventListener("submit", async function (e) {
      e.preventDefault();
      errEl.hidden = true;
      okEl.hidden = true;
      const fd = new FormData(form);
      const email = String(fd.get("email") || "").trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        errEl.textContent = "Drop a valid email and we'll send the link.";
        errEl.hidden = false;
        return;
      }
      submitBtn.setAttribute("disabled", "true");
      label.textContent = "Sending…";
      try {
        const log = JSON.parse(localStorage.getItem("tmke.leads") || "[]");
        log.push({ asset: "five-and-live", email: email, at: Date.now() });
        localStorage.setItem("tmke.leads", JSON.stringify(log));
      } catch (_) { /* ignore */ }
      // Fake latency so the success state doesn't pop instantly.
      await new Promise(function (r) { setTimeout(r, 500); });
      submitBtn.removeAttribute("disabled");
      if (label && originalLabel) label.innerHTML = originalLabel;
      okEl.hidden = false;
      form.reset();
      // Auto-collapse after a beat so they get visual confirmation.
      setTimeout(function () { setState("collapsed"); }, 2800);
    });

    // ===== Show only past the hero =====
    const hero = document.querySelector(".hero, .contact-hero, .smm-hero, .page-hero");
    function show() { wrap.setAttribute("data-shown", "true"); }
    function hide() { wrap.setAttribute("data-shown", "false"); setState("collapsed"); }

    if (!hero) {
      show();
    } else if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) hide();
          else show();
        });
      }, { rootMargin: "-100px 0px 0px 0px", threshold: 0 });
      io.observe(hero);
    } else {
      show();
    }
  })();
</script>
