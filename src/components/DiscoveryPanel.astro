---
// Slide-in calendar panel for booking a Discovery Call. Used on /contact and
// /services. The panel slides in from the left half of the viewport, leaving
// the right side dimmed. Inline calendar grid + time slots; submission is
// stubbed for now (we'll wire to Cal.com / Resend when keys are available).
---

<aside class="dc-panel" id="dc-panel" aria-hidden="true">
  <div class="dc-panel-scrim" data-dc-close></div>

  <div class="dc-panel-stage">
    <header class="dc-panel-head">
      <button type="button" class="dc-panel-close" data-dc-close aria-label="Close">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
        <span>Close</span>
      </button>
      <div class="dc-panel-eyebrow">TMKE — Discovery call</div>
    </header>

    <div class="dc-panel-body">
      <div class="dc-panel-intro">
        <h2 class="dc-panel-title">
          Let's book your <em>discovery call.</em>
        </h2>
        <p class="dc-panel-sub">
          A 30-minute conversation about your brand, your channels, and where TMKE can take them.
          Pick a date and a time below — we'll confirm by email straight after.
        </p>

        <ul class="dc-panel-list">
          <li><strong>30 mins</strong> · video on Google Meet</li>
          <li>No prep needed — bring your questions</li>
          <li>Held weekdays between 9am and 5pm GMT</li>
        </ul>
      </div>

      <div class="dc-panel-pick">
        <div class="dc-cal">
          <header class="dc-cal-head">
            <button type="button" class="dc-cal-nav" id="dc-prev-month" aria-label="Previous month">&larr;</button>
            <div class="dc-cal-label" id="dc-cal-label">…</div>
            <button type="button" class="dc-cal-nav" id="dc-next-month" aria-label="Next month">&rarr;</button>
          </header>
          <div class="dc-cal-weekdays">
            <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
          </div>
          <div class="dc-cal-grid" id="dc-cal-grid"></div>
        </div>

        <div class="dc-slots">
          <div class="dc-slots-label" id="dc-slots-label">Pick a date to see times</div>
          <div class="dc-slots-grid" id="dc-slots-grid"></div>
        </div>
      </div>

      <form class="dc-panel-form" id="dc-form" hidden>
        <h3 class="dc-form-h">Just your details to confirm.</h3>
        <label class="dc-field"><span>Full name</span><input name="name" required /></label>
        <label class="dc-field"><span>Email</span><input name="email" type="email" required /></label>
        <label class="dc-field"><span>Company / Brand</span><input name="company" required /></label>
        <label class="dc-field"><span>What would you like to cover?</span><textarea name="agenda" rows="3"></textarea></label>
        <p class="dc-form-summary" id="dc-form-summary"></p>
        <button type="submit" class="dc-form-cta" id="dc-form-cta">
          Confirm booking <em>&rarr;</em>
        </button>
      </form>

      <div class="dc-success" id="dc-success" hidden>
        <div class="dc-success-mark">✓</div>
        <h3>You're booked in.</h3>
        <p id="dc-success-msg">We've sent a Google Calendar invite to your inbox.</p>
        <button type="button" class="dc-form-cta" data-dc-close>Lovely <em>&rarr;</em></button>
      </div>
    </div>
  </div>
</aside>

<style is:global>
  /* ============ Discovery call panel ============ */
  .dc-panel {
    position: fixed; inset: 0;
    z-index: 150;
    pointer-events: none;
  }
  .dc-panel.is-open { pointer-events: auto; }
  .dc-panel[aria-hidden="true"] .dc-panel-stage { transform: translateX(-100%); }
  .dc-panel[aria-hidden="true"] .dc-panel-scrim { opacity: 0; }

  .dc-panel-scrim {
    position: absolute; inset: 0;
    background: rgba(28,29,34,0.45);
    opacity: 1;
    transition: opacity 0.55s ease-out;
  }

  .dc-panel-stage {
    position: absolute;
    top: 0; bottom: 0; left: 0;
    width: min(700px, 92vw);
    background: var(--paper);
    transform: translateX(0);
    transition: transform 0.7s cubic-bezier(.2,.75,.2,1);
    overflow-y: auto;
    box-shadow: 30px 0 80px rgba(0,0,0,0.25);
  }

  .dc-panel-head {
    position: sticky;
    top: 0;
    z-index: 2;
    display: flex; justify-content: space-between; align-items: center;
    padding: 18px 32px;
    background: var(--paper);
    border-bottom: 1px solid rgba(28,29,34,0.08);
  }
  .dc-panel-close {
    appearance: none;
    background: transparent;
    border: 0;
    color: var(--english-violet);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    display: inline-flex; align-items: center; gap: 8px;
    cursor: pointer;
    padding: 0;
  }
  .dc-panel-close:hover { color: var(--ink); }
  .dc-panel-eyebrow {
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-weight: 700;
    color: rgba(28,29,34,0.5);
  }

  .dc-panel-body { padding: 36px 32px 56px; }
  .dc-panel-intro { margin-bottom: 36px; }
  .dc-panel-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(34px, 4vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.018em;
    color: var(--ink);
    margin: 0 0 16px;
  }
  .dc-panel-title em { font-style: italic; color: var(--english-violet); }
  .dc-panel-sub {
    font-family: var(--serif);
    font-style: italic;
    font-size: 18px;
    line-height: 1.5;
    color: rgba(28,29,34,0.65);
    margin: 0 0 18px;
    max-width: 56ch;
  }
  .dc-panel-list {
    list-style: none; padding: 0; margin: 0;
    display: flex; flex-direction: column; gap: 6px;
    font-family: var(--sans); font-size: 13px;
    color: rgba(28,29,34,0.6);
  }
  .dc-panel-list li { padding-left: 18px; position: relative; }
  .dc-panel-list li::before {
    content: "—"; position: absolute; left: 0; color: var(--english-violet);
  }

  /* Calendar */
  .dc-cal {
    background: #fff;
    border: 1px solid rgba(28,29,34,0.08);
    border-radius: 3px;
    padding: 16px 16px 18px;
    margin-bottom: 20px;
  }
  .dc-cal-head {
    display: flex; align-items: center; justify-content: space-between;
    margin-bottom: 14px;
  }
  .dc-cal-label {
    font-family: var(--serif);
    font-size: 20px;
    font-weight: 500;
    color: var(--ink);
  }
  .dc-cal-nav {
    appearance: none;
    background: transparent;
    border: 1px solid rgba(71,66,84,0.25);
    border-radius: 2px;
    width: 32px; height: 32px;
    color: var(--english-violet);
    cursor: pointer;
    transition: background 0.25s, border-color 0.25s;
  }
  .dc-cal-nav:hover { background: rgba(71,66,84,0.06); border-color: var(--english-violet); }
  .dc-cal-weekdays {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
    margin-bottom: 8px;
    font-family: var(--sans);
    font-size: 10px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    font-weight: 700;
    color: rgba(28,29,34,0.45);
    text-align: center;
  }
  .dc-cal-grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .dc-cal-day {
    appearance: none;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 2px;
    aspect-ratio: 1 / 1;
    font-family: var(--sans);
    font-size: 13px;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .dc-cal-day:hover:not([disabled]) { background: rgba(71,66,84,0.08); }
  .dc-cal-day[disabled] { color: rgba(28,29,34,0.25); cursor: not-allowed; }
  .dc-cal-day.is-today { font-weight: 700; color: var(--english-violet); }
  .dc-cal-day.is-active { background: var(--ink); color: var(--paper); }
  .dc-cal-day.is-other-month { color: rgba(28,29,34,0.25); }

  /* Time slots */
  .dc-slots {
    margin-bottom: 28px;
  }
  .dc-slots-label {
    font-family: var(--sans);
    font-size: 11px;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--english-violet);
    margin-bottom: 12px;
  }
  .dc-slots-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(96px, 1fr));
    gap: 8px;
  }
  .dc-slot {
    appearance: none;
    background: #fff;
    border: 1px solid rgba(71,66,84,0.25);
    border-radius: 2px;
    padding: 10px 12px;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 600;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .dc-slot:hover { border-color: var(--english-violet); }
  .dc-slot.is-active { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  /* Booking form */
  .dc-panel-form { display: flex; flex-direction: column; gap: 14px; }
  .dc-form-h {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 500;
    color: var(--ink);
    margin: 0 0 8px;
  }
  .dc-field { display: flex; flex-direction: column; gap: 6px; }
  .dc-field > span {
    font-family: var(--sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--english-violet);
  }
  .dc-field input,
  .dc-field textarea {
    font-family: var(--sans);
    font-size: 15px;
    padding: 12px 14px;
    border: 1px solid rgba(71,66,84,0.28);
    border-radius: 2px;
    background: #fff;
    color: var(--ink);
    transition: border-color 0.25s, box-shadow 0.25s;
    resize: vertical;
  }
  .dc-field input:focus,
  .dc-field textarea:focus {
    outline: none;
    border-color: var(--english-violet);
    box-shadow: 0 0 0 3px rgba(71,66,84,0.12);
  }
  .dc-form-summary {
    font-family: var(--sans);
    font-size: 13px;
    color: rgba(28,29,34,0.6);
    margin: 4px 0 0;
    padding: 12px 14px;
    background: rgba(71,66,84,0.07);
    border-left: 3px solid var(--english-violet);
  }
  .dc-form-cta {
    appearance: none;
    background: var(--ink);
    color: var(--paper);
    border: 0;
    padding: 16px 22px;
    border-radius: 2px;
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 0.25s;
    margin-top: 6px;
  }
  .dc-form-cta:hover { background: var(--english-violet); }
  .dc-form-cta em {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    letter-spacing: 0;
    text-transform: none;
    margin-left: 8px;
  }

  .dc-success {
    display: flex; flex-direction: column; gap: 14px;
    padding: 28px;
    background: rgba(46, 106, 74, 0.06);
    border: 1px solid rgba(46, 106, 74, 0.22);
    border-radius: 4px;
    align-items: flex-start;
  }
  .dc-success-mark {
    width: 44px; height: 44px;
    border-radius: 50%;
    background: #2e6a4a;
    color: var(--paper);
    display: inline-flex; align-items: center; justify-content: center;
    font-size: 22px;
    font-weight: 700;
  }
  .dc-success h3 { font-family: var(--serif); font-size: 26px; margin: 0; font-weight: 500; }
  .dc-success p { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.65); margin: 0; }
</style>

<script is:inline>
  (function () {
    const panel = document.getElementById("dc-panel");
    if (!panel) return;
    const calLabel = document.getElementById("dc-cal-label");
    const calGrid = document.getElementById("dc-cal-grid");
    const slotsLabel = document.getElementById("dc-slots-label");
    const slotsGrid = document.getElementById("dc-slots-grid");
    const form = document.getElementById("dc-form");
    const formSummary = document.getElementById("dc-form-summary");
    const success = document.getElementById("dc-success");
    const successMsg = document.getElementById("dc-success-msg");

    let viewMonth = new Date();
    viewMonth.setDate(1);
    let selectedDate = null;
    let selectedSlot = null;

    const SLOTS = ["09:00", "09:30", "10:00", "10:30", "11:00", "13:00", "14:00", "14:30", "15:00", "16:00"];
    const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];

    function open() {
      panel.setAttribute("aria-hidden", "false");
      panel.classList.add("is-open");
      document.documentElement.style.overflow = "hidden";
      renderCalendar();
    }
    function close() {
      panel.setAttribute("aria-hidden", "true");
      panel.classList.remove("is-open");
      document.documentElement.style.overflow = "";
    }

    function sameDay(a, b) {
      return a && b && a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
    }

    function renderCalendar() {
      calLabel.textContent = `${MONTHS[viewMonth.getMonth()]} ${viewMonth.getFullYear()}`;
      const first = new Date(viewMonth);
      // Start grid on Monday: shift by JS getDay (Sun=0) → Mon=0
      const startOffset = (first.getDay() + 6) % 7;
      const gridStart = new Date(first);
      gridStart.setDate(first.getDate() - startOffset);
      const today = new Date();
      today.setHours(0,0,0,0);

      const cells = [];
      for (let i = 0; i < 42; i++) {
        const d = new Date(gridStart);
        d.setDate(gridStart.getDate() + i);
        const inMonth = d.getMonth() === viewMonth.getMonth();
        const isPast = d < today;
        const isWeekend = d.getDay() === 0 || d.getDay() === 6;
        const disabled = isPast || isWeekend;
        const classes = ["dc-cal-day"];
        if (!inMonth) classes.push("is-other-month");
        if (sameDay(d, today)) classes.push("is-today");
        if (sameDay(d, selectedDate)) classes.push("is-active");
        cells.push(
          `<button type="button" class="${classes.join(" ")}" data-date="${d.toISOString()}" ${disabled ? "disabled" : ""}>${d.getDate()}</button>`
        );
      }
      calGrid.innerHTML = cells.join("");
    }

    function renderSlots() {
      if (!selectedDate) {
        slotsLabel.textContent = "Pick a date to see times";
        slotsGrid.innerHTML = "";
        return;
      }
      const dt = selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
      slotsLabel.textContent = `Available times — ${dt}`;
      slotsGrid.innerHTML = SLOTS.map((s) =>
        `<button type="button" class="dc-slot${s === selectedSlot ? " is-active" : ""}" data-slot="${s}">${s}</button>`
      ).join("");
    }

    function updateSummary() {
      if (!selectedDate || !selectedSlot) return;
      const dt = selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
      formSummary.textContent = `Your call: ${dt} at ${selectedSlot} GMT — 30 minutes.`;
      form.hidden = false;
      requestAnimationFrame(() => form.querySelector("input")?.focus());
    }

    // Calendar navigation
    document.getElementById("dc-prev-month").addEventListener("click", () => {
      viewMonth.setMonth(viewMonth.getMonth() - 1);
      renderCalendar();
    });
    document.getElementById("dc-next-month").addEventListener("click", () => {
      viewMonth.setMonth(viewMonth.getMonth() + 1);
      renderCalendar();
    });

    calGrid.addEventListener("click", (e) => {
      const btn = e.target.closest(".dc-cal-day");
      if (!btn || btn.hasAttribute("disabled")) return;
      selectedDate = new Date(btn.dataset.date);
      selectedSlot = null;
      renderCalendar();
      renderSlots();
    });

    slotsGrid.addEventListener("click", (e) => {
      const btn = e.target.closest(".dc-slot");
      if (!btn) return;
      selectedSlot = btn.dataset.slot;
      renderSlots();
      updateSummary();
    });

    form.addEventListener("submit", (e) => {
      e.preventDefault();
      // Stub: in production this submits to Cal.com / Resend via an edge function.
      const dt = selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
      successMsg.textContent = `We've reserved ${dt} at ${selectedSlot} GMT. A confirmation is on its way to your inbox.`;
      form.hidden = true;
      success.hidden = false;
      success.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    // Close handlers
    panel.addEventListener("click", (e) => {
      if (e.target.closest("[data-dc-close]")) close();
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && panel.classList.contains("is-open")) close();
    });

    // Wire openers: any [data-discovery-call] element opens the panel.
    document.addEventListener("click", (e) => {
      const opener = e.target.closest?.("[data-discovery-call]");
      if (!opener) return;
      e.preventDefault();
      open();
    });

    window.tmkeDiscoveryOpen = open;
  })();
</script>
