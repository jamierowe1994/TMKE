---
// Slide-in booking wizard — one choice at a time (onboarding style). Each step
// slides off as the next slides in. Three modes (data-dc-mode):
//   • "call"    — plain call (default; /contact, /services): day → time → details
//   • "consult" — videography consultation: interest → day → time → details
//   • "shoot"   — videography shoot: [service →] pack → day → time → CONTRACT → details
// Real availability + booking come from Jack's Microsoft 365 diary via the Worker
// (/ms/config, /ms/availability, /ms/book). The actual booking only happens on the
// final "Confirm booking" — with a spinner → animated tick micro-interaction.
const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
---

<aside class="dc-panel" id="dc-panel" aria-hidden="true" data-worker={WORKER}>
  <div class="dc-panel-scrim" data-dc-close></div>

  <div class="dc-panel-stage">
    <header class="dc-panel-head">
      <div class="dc-head-left">
        <button type="button" class="dc-panel-close" data-dc-close aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
          <span>Close</span>
        </button>
        <button type="button" class="dc-panel-back" id="dc-back" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          <span>Back</span>
        </button>
      </div>
      <div class="dc-panel-eyebrow" id="dc-eyebrow">TMKE — Booking</div>
    </header>

    <div class="dc-panel-body">
      <!-- interest (consult) -->
      <section class="dc-step" id="dc-step-interest" hidden>
        <h2 class="dc-step-title">What are you <em>interested in?</em></h2>
        <p class="dc-step-sub">Pick anything you'd like to talk through — choose as many as you like.</p>
        <div class="dc-choices dc-choices--multi" id="dc-interests"></div>
        <h3 class="dc-step-sub2">Rough scope?</h3>
        <div class="dc-scope" id="dc-scope">
          <button type="button" class="dc-pill is-active" data-scope="Not sure yet">Not sure yet</button>
          <button type="button" class="dc-pill" data-scope="Half day">Half day</button>
          <button type="button" class="dc-pill" data-scope="Full day">Full day</button>
        </div>
        <div class="dc-step-actions"><button type="button" class="dc-next" id="dc-interest-next">Continue <em>&rarr;</em></button></div>
      </section>

      <!-- service (shoot — generic) -->
      <section class="dc-step" id="dc-step-service" hidden>
        <h2 class="dc-step-title">Which <em>shoot?</em></h2>
        <p class="dc-step-sub">Choose what you'd like to book.</p>
        <div class="dc-choices" id="dc-services"></div>
      </section>

      <!-- pack (shoot) -->
      <section class="dc-step" id="dc-step-pack" hidden>
        <h2 class="dc-step-title">Pick your <em>package.</em></h2>
        <p class="dc-step-sub">Choose the option that fits — we'll confirm the final quote on the day.</p>
        <div class="dc-choices" id="dc-packs"></div>
      </section>

      <!-- day -->
      <section class="dc-step" id="dc-step-day" hidden>
        <h2 class="dc-step-title">Pick a <em>day.</em></h2>
        <p class="dc-step-sub" id="dc-day-sub">Choose a date that suits you — weekdays, 9am–5pm.</p>
        <div class="dc-cal">
          <header class="dc-cal-head">
            <button type="button" class="dc-cal-nav" id="dc-prev-month" aria-label="Previous month">&larr;</button>
            <div class="dc-cal-label" id="dc-cal-label">…</div>
            <button type="button" class="dc-cal-nav" id="dc-next-month" aria-label="Next month">&rarr;</button>
          </header>
          <div class="dc-cal-weekdays"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
          <div class="dc-cal-grid" id="dc-cal-grid"></div>
        </div>
      </section>

      <!-- time -->
      <section class="dc-step" id="dc-step-time" hidden>
        <h2 class="dc-step-title">Pick a <em>time.</em></h2>
        <p class="dc-step-sub" id="dc-time-sub">…</p>
        <div class="dc-slots-grid" id="dc-slots-grid"></div>
      </section>

      <!-- contract (shoot only) -->
      <section class="dc-step" id="dc-step-contract" hidden>
        <h2 class="dc-step-title">The <em>agreement.</em></h2>
        <p class="dc-step-sub">Almost there — please read the terms below, then sign to confirm your shoot.</p>
        <p class="dc-form-summary" id="dc-contract-summary"></p>
        <div class="dc-terms" id="dc-terms" tabindex="0">
          <h4>TMKE — Shoot booking terms</h4>
          <p class="dc-terms-note">A plain-English working agreement to confirm your booking and set expectations. It will be reviewed by legal counsel; it is provided for information and to record your agreement.</p>
          <h5>1. Booking &amp; confirmation</h5>
          <p>Your booking is confirmed once this agreement is signed and you receive our email confirmation. Your time is held in Jack's diary on a first-come basis.</p>
          <h5>2. Cancellations</h5>
          <p>We ask for a minimum of <strong>three (3) days' notice</strong> to cancel a shoot. To <strong>rearrange</strong>, please give at least <strong>two (2) days' notice</strong>. In genuinely exceptional circumstances (for example sudden severe weather, illness or an emergency) please contact Jack as soon as possible and we'll do everything we can to accommodate you. All cancellations and changes must be made <strong>in writing</strong> by email to jack@tmke.co.uk.</p>
          <h5>3. Rescheduling</h5>
          <p>If you need to reschedule, we'll send confirmation and a link to rebook by email so you can pick a new time that suits you.</p>
          <h5>4. Use of content</h5>
          <p>You agree that TMKE may use the content we produce for you as <strong>showcase and marketing material</strong> across our website, social media and portfolio. TMKE retains the right to use this content; we'll credit you where appropriate.</p>
          <h5>5. Access to your content &amp; payment</h5>
          <p>Final edited content remains the property of TMKE and is <strong>not released or licensed for your use until payment has been received in full</strong>. For example, a property tour or video will not be accessible to you until the invoice is settled.</p>
          <h5>6. Delivery</h5>
          <p>Edited content is typically delivered within a few working days of the shoot unless otherwise agreed.</p>
          <h5>7. On the day</h5>
          <p>Please ensure safe and timely access to the location, and that you have the consent of any people, tenants or properties featured. Travel beyond the local area may be itemised separately.</p>
          <h5>8. Liability &amp; circumstances beyond control</h5>
          <p>TMKE is not liable for delays or cancellations caused by circumstances beyond our reasonable control (including weather, illness or equipment failure); in such cases we'll reschedule at the earliest opportunity.</p>
          <h5>9. Governing law</h5>
          <p>This agreement is governed by the laws of England &amp; Wales.</p>
        </div>
        <label class="dc-agree-row">
          <input type="checkbox" id="dc-agree" disabled required />
          <span>I have read and agree to the Terms &amp; Conditions above.</span>
        </label>
        <div class="dc-sign">
          <label class="dc-field"><span>Sign — type your full name</span><input id="dc-sign-name" autocomplete="name" required /></label>
          <label class="dc-field"><span>Date</span><input id="dc-sign-date" type="date" required /></label>
        </div>
        <div class="dc-step-actions"><button type="button" class="dc-next" id="dc-contract-cta" disabled>Agree &amp; continue <em>&rarr;</em></button></div>
      </section>

      <!-- details (final step → books) -->
      <section class="dc-step" id="dc-step-details" hidden>
        <h2 class="dc-step-title">Your <em>details.</em></h2>
        <p class="dc-form-summary" id="dc-form-summary"></p>
        <form class="dc-panel-form" id="dc-form">
          <label class="dc-field"><span>Full name *</span><input name="name" required /></label>
          <div class="dc-field-row">
            <label class="dc-field"><span>Email *</span><input name="email" type="email" required /></label>
            <label class="dc-field"><span>Phone *</span><input name="phone" type="tel" required /></label>
          </div>
          <label class="dc-field"><span>Company / Brand *</span><input name="company" required /></label>
          <label class="dc-field"><span>Anything we should know?</span><textarea name="agenda" rows="3"></textarea></label>
          <button type="submit" class="dc-form-cta" id="dc-form-cta">Confirm booking <em>&rarr;</em></button>
        </form>
      </section>

      <!-- success -->
      <section class="dc-step dc-success" id="dc-success" hidden>
        <div class="dc-tick" aria-hidden="true">
          <svg viewBox="0 0 52 52"><circle class="dc-tick-circle" cx="26" cy="26" r="24"/><path class="dc-tick-path" fill="none" d="M14 27l8 8 16-18"/></svg>
        </div>
        <h3>Booking confirmed</h3>
        <p id="dc-success-msg">You'll shortly receive an email to confirm your booking.</p>
        <button type="button" class="dc-form-cta dc-success-done" data-dc-close>Done <em>&rarr;</em></button>
      </section>
    </div>
  </div>
</aside>

<style is:global>
  /* ============ Booking wizard ============ */
  .dc-panel { position: fixed; inset: 0; z-index: 400; pointer-events: none; }
  .dc-panel.is-open { pointer-events: auto; }
  .dc-panel[aria-hidden="true"] .dc-panel-stage { transform: translateX(-100%); }
  .dc-panel[aria-hidden="true"] .dc-panel-scrim { opacity: 0; }

  .dc-panel-scrim { position: absolute; inset: 0; background: rgba(28,29,34,0.5); opacity: 1; transition: opacity 0.55s ease-out; }

  .dc-panel-stage {
    position: absolute; top: 0; bottom: 0; left: 0;
    width: min(640px, 94vw); background: var(--paper);
    transform: translateX(0); transition: transform 0.7s cubic-bezier(.2,.75,.2,1);
    overflow-y: auto; scrollbar-width: none; -ms-overflow-style: none;
    box-shadow: 30px 0 80px rgba(0,0,0,0.28);
  }
  .dc-panel-stage::-webkit-scrollbar { width: 0; height: 0; display: none; }

  .dc-panel-head { position: sticky; top: 0; z-index: 2; display: flex; justify-content: space-between; align-items: center; padding: 18px 32px; background: rgba(242,239,233,0.92); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-bottom: 1px solid rgba(28,29,34,0.08); }
  .dc-head-left { display: flex; align-items: center; gap: 18px; }
  .dc-panel-close, .dc-panel-back { appearance: none; background: transparent; border: 0; color: var(--english-violet); font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; display: inline-flex; align-items: center; gap: 7px; cursor: pointer; padding: 0; transition: color .2s; }
  .dc-panel-close:hover, .dc-panel-back:hover { color: var(--ink); }
  .dc-panel-back[hidden] { display: none; }
  .dc-panel-eyebrow { font-family: var(--sans); font-size: 10px; letter-spacing: 0.3em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.5); text-align: right; max-width: 50%; }

  .dc-panel-body { padding: 44px 36px 72px; position: relative; }
  .dc-step[hidden] { display: none; }

  /* One-at-a-time slide transitions */
  @keyframes dcIn { from { opacity: 0; transform: translateX(34px); } to { opacity: 1; transform: none; } }
  @keyframes dcOut { from { opacity: 1; transform: none; } to { opacity: 0; transform: translateX(-34px); } }
  .dc-step.dc-anim-in { animation: dcIn 0.42s cubic-bezier(.16,1,.3,1) both; }
  .dc-step.dc-anim-out { animation: dcOut 0.24s ease both; }
  @media (prefers-reduced-motion: reduce) { .dc-step.dc-anim-in, .dc-step.dc-anim-out { animation-duration: 0.01ms; } }

  .dc-step-title { font-family: var(--serif); font-weight: 400; font-size: clamp(32px, 3.8vw, 48px); line-height: 1.04; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 12px; }
  .dc-step-title em { font-style: italic; color: var(--english-violet); }
  .dc-step-sub { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(28,29,34,0.65); margin: 0 0 26px; max-width: 52ch; }
  .dc-step-sub2 { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--english-violet); margin: 30px 0 14px; }

  /* Choice cards */
  .dc-choices { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 560px) { .dc-choices { grid-template-columns: 1fr; } }
  .dc-choice { text-align: left; cursor: pointer; padding: 22px 20px; border: 1px solid rgba(28,29,34,0.16); border-radius: 12px; background: #fff; transition: border-color 0.2s, box-shadow 0.2s, transform 0.2s; display: flex; flex-direction: column; gap: 5px; }
  .dc-choice:hover { border-color: var(--english-violet); transform: translateY(-3px); box-shadow: 0 14px 30px rgba(16,14,22,0.08); }
  .dc-choice.is-active { border-color: var(--english-violet); box-shadow: 0 0 0 2px var(--english-violet) inset; }
  .dc-choice-name { font-family: var(--serif); font-size: 21px; color: var(--ink); }
  .dc-choice-meta { font-family: var(--sans); font-size: 12px; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
  .dc-choice-price { font-family: var(--serif); font-size: 22px; font-weight: 500; color: var(--english-violet); margin-top: 4px; }
  .dc-choices--multi .dc-choice { flex-direction: row; align-items: center; gap: 14px; }
  .dc-choice-check { flex: none; width: 22px; height: 22px; border: 1px solid rgba(71,66,84,0.4); border-radius: 6px; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; color: transparent; transition: background .15s, color .15s, border-color .15s; }
  .dc-choices--multi .dc-choice.is-active { transform: none; box-shadow: none; }
  .dc-choice.is-active .dc-choice-check { background: var(--english-violet); border-color: var(--english-violet); color: var(--paper); }

  .dc-scope { display: flex; flex-wrap: wrap; gap: 8px; }
  .dc-pill { appearance: none; background: #fff; border: 1px solid rgba(71,66,84,0.25); border-radius: 999px; padding: 10px 18px; font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--ink); cursor: pointer; transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .dc-pill:hover { border-color: var(--english-violet); }
  .dc-pill.is-active { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  .dc-step-actions { margin-top: 32px; }
  .dc-next { appearance: none; background: var(--ink); color: var(--paper); border: 0; padding: 16px 28px; border-radius: 4px; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; cursor: pointer; transition: background 0.25s, opacity 0.25s; }
  .dc-next:hover { background: var(--english-violet); }
  .dc-next:disabled { opacity: 0.4; cursor: not-allowed; background: var(--ink); }
  .dc-next em { font-family: var(--serif); font-style: italic; font-size: 15px; letter-spacing: 0; text-transform: none; margin-left: 8px; }

  /* Calendar */
  .dc-cal { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 20px 20px 22px; }
  .dc-cal-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px; }
  .dc-cal-label { font-family: var(--serif); font-size: 22px; font-weight: 500; color: var(--ink); }
  .dc-cal-nav { appearance: none; background: transparent; border: 1px solid rgba(71,66,84,0.25); border-radius: 50%; width: 36px; height: 36px; color: var(--english-violet); cursor: pointer; transition: background 0.25s, border-color 0.25s; }
  .dc-cal-nav:hover { background: rgba(71,66,84,0.06); border-color: var(--english-violet); }
  .dc-cal-weekdays { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; margin-bottom: 8px; font-family: var(--sans); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.45); text-align: center; }
  .dc-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 5px; }
  .dc-cal-day { appearance: none; background: transparent; border: 1px solid transparent; border-radius: 8px; aspect-ratio: 1 / 1; font-family: var(--sans); font-size: 14px; color: var(--ink); cursor: pointer; transition: background 0.2s, border-color 0.2s, color 0.2s; }
  .dc-cal-day:hover:not([disabled]) { background: rgba(71,66,84,0.1); }
  .dc-cal-day[disabled] { color: rgba(28,29,34,0.22); cursor: not-allowed; }
  .dc-cal-day.is-today { font-weight: 700; color: var(--english-violet); }
  .dc-cal-day.is-active { background: var(--ink); color: var(--paper); }
  .dc-cal-day.is-other-month { color: rgba(28,29,34,0.22); }

  /* Time slots */
  .dc-slots-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 10px; }
  .dc-slots-empty { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); margin: 0; grid-column: 1 / -1; }
  .dc-slot { appearance: none; background: #fff; border: 1px solid rgba(71,66,84,0.25); border-radius: 8px; padding: 14px 12px; font-family: var(--sans); font-size: 14px; font-weight: 600; color: var(--ink); cursor: pointer; transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.15s; }
  .dc-slot:hover { border-color: var(--english-violet); transform: translateY(-2px); }
  .dc-slot.is-active { background: var(--ink); color: var(--paper); border-color: var(--ink); }

  /* Forms */
  .dc-panel-form { display: flex; flex-direction: column; gap: 16px; }
  .dc-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 560px) { .dc-field-row { grid-template-columns: 1fr; } }
  .dc-field { display: flex; flex-direction: column; gap: 7px; }
  .dc-field > span { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--english-violet); }
  .dc-field input, .dc-field textarea { font-family: var(--sans); font-size: 15px; padding: 13px 15px; border: 1px solid rgba(71,66,84,0.28); border-radius: 8px; background: #fff; color: var(--ink); transition: border-color 0.25s, box-shadow 0.25s; resize: vertical; }
  .dc-field input:focus, .dc-field textarea:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(71,66,84,0.12); }
  .dc-form-summary { font-family: var(--sans); font-size: 13px; line-height: 1.5; color: rgba(28,29,34,0.7); margin: 0 0 22px; padding: 14px 16px; background: rgba(71,66,84,0.07); border-left: 3px solid var(--english-violet); border-radius: 0 6px 6px 0; }
  .dc-form-summary:empty { display: none; }
  .dc-form-cta { appearance: none; background: var(--ink); color: var(--paper); border: 0; padding: 17px 24px; border-radius: 4px; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; cursor: pointer; transition: background 0.25s, opacity 0.25s; margin-top: 8px; display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 52px; }
  .dc-form-cta:hover { background: var(--english-violet); }
  .dc-form-cta:disabled { opacity: 0.45; cursor: not-allowed; background: var(--ink); }
  .dc-form-cta em { font-family: var(--serif); font-style: italic; font-size: 16px; letter-spacing: 0; text-transform: none; margin-left: 4px; }
  .dc-form-cta.is-loading { pointer-events: none; }

  .dc-spinner { display: inline-block; width: 18px; height: 18px; border: 2px solid rgba(240,238,235,0.35); border-top-color: var(--paper); border-radius: 50%; animation: dcSpin 0.7s linear infinite; }
  @keyframes dcSpin { to { transform: rotate(360deg); } }

  /* Contract */
  .dc-terms { max-height: 300px; overflow-y: auto; border: 1px solid rgba(71,66,84,0.25); border-radius: 10px; padding: 22px 24px; background: #fff; }
  .dc-terms:focus { outline: none; border-color: var(--english-violet); }
  .dc-terms.is-read { border-color: rgba(46,106,74,0.5); }
  .dc-terms h4 { font-family: var(--serif); font-size: 22px; font-weight: 500; color: var(--ink); margin: 0 0 8px; }
  .dc-terms h5 { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--ink); margin: 18px 0 6px; }
  .dc-terms p { font-family: var(--sans); font-size: 13.5px; line-height: 1.6; color: rgba(28,29,34,0.78); margin: 0 0 8px; }
  .dc-terms-note { font-style: italic; color: rgba(28,29,34,0.55) !important; }
  .dc-agree-row { display: flex; align-items: flex-start; gap: 12px; margin: 20px 0 6px; font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.85); cursor: pointer; }
  .dc-agree-row input { margin-top: 2px; width: 18px; height: 18px; accent-color: var(--english-violet); }
  .dc-agree-row input:disabled { cursor: not-allowed; }
  .dc-sign { display: grid; grid-template-columns: 2fr 1fr; gap: 16px; margin: 16px 0 0; }
  @media (max-width: 560px) { .dc-sign { grid-template-columns: 1fr; } }
  #dc-sign-name { font-family: var(--serif); font-style: italic; font-size: 22px; }

  /* Success */
  .dc-success { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 16px; padding: 40px 24px; }
  .dc-tick { width: 96px; height: 96px; border-radius: 50%; background: rgba(46,106,74,0.10); display: flex; align-items: center; justify-content: center; }
  .dc-tick svg { width: 56px; height: 56px; }
  .dc-tick-circle { fill: none; stroke: #2e6a4a; stroke-width: 2; stroke-dasharray: 151; stroke-dashoffset: 151; animation: dcDraw 0.55s ease forwards; }
  .dc-tick-path { stroke: #2e6a4a; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 48; stroke-dashoffset: 48; animation: dcDraw 0.4s 0.5s ease forwards; }
  @keyframes dcDraw { to { stroke-dashoffset: 0; } }
  .dc-success h3 { font-family: var(--serif); font-weight: 400; font-size: clamp(30px, 3.4vw, 42px); color: var(--ink); margin: 6px 0 0; }
  .dc-success p { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(28,29,34,0.65); margin: 0; max-width: 38ch; }
  .dc-success-done { margin-top: 12px; }
</style>

<script is:inline>
  (function () {
    const panel = document.getElementById("dc-panel");
    if (!panel) return;
    const WORKER = (panel.dataset.worker || "").replace(/\/+$/, "");
    const stage = panel.querySelector(".dc-panel-stage");
    const $ = (id) => document.getElementById(id);
    const eyebrow = $("dc-eyebrow"), backBtn = $("dc-back");
    const calLabel = $("dc-cal-label"), calGrid = $("dc-cal-grid");
    const slotsGrid = $("dc-slots-grid"), timeSub = $("dc-time-sub"), daySub = $("dc-day-sub");
    const form = $("dc-form"), formCta = $("dc-form-cta"), formSummary = $("dc-form-summary");
    const successMsg = $("dc-success-msg");
    const interestsWrap = $("dc-interests"), servicesWrap = $("dc-services"), packsWrap = $("dc-packs"), scopeWrap = $("dc-scope");
    const terms = $("dc-terms"), agree = $("dc-agree"), signName = $("dc-sign-name"), signDate = $("dc-sign-date"), contractCta = $("dc-contract-cta"), contractSummary = $("dc-contract-summary");

    const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
    const pad = (n) => String(n).padStart(2, "0");
    const localISO = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const fmtDur = (m) => (m >= 60 ? `${m / 60} hr${m >= 120 ? "s" : ""}` : `${m} mins`).replace(".5 hrs", "½ hrs");
    const parseList = (v) => { if (!v) return null; if (Array.isArray(v)) return v; try { return JSON.parse(v); } catch (_) { return null; } };
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

    let mode = "call", service = "Booking", duration = 30, serviceBase = "";
    let packs = null, services = null, interests = null;
    let chosenInterests = [], chosenScope = "Not sure yet", chosenPack = null;
    let viewMonth = new Date(); viewMonth.setDate(1);
    let selectedDate = null, selectedSlot = null;
    let availWeekdays = null, configFetched = false;
    let activeStep = null, history = [];

    // ---- step navigation (one at a time, sliding) ----
    function stepEl(name) { return name === "success" ? $("dc-success") : $("dc-step-" + name); }
    function goTo(name) { if (activeStep) history.push(activeStep); showStepRaw(name); }
    function showStepRaw(name) {
      const next = stepEl(name); if (!next) return;
      const cur = activeStep ? stepEl(activeStep) : null;
      const enter = () => {
        next.hidden = false; next.classList.remove("dc-anim-out", "dc-anim-in"); void next.offsetWidth; next.classList.add("dc-anim-in");
        if (stage) stage.scrollTop = 0; activeStep = name;
        backBtn.hidden = history.length === 0;
        if (name === "time") renderSlots();
      };
      if (cur && cur !== next) { cur.classList.remove("dc-anim-in"); cur.classList.add("dc-anim-out"); setTimeout(() => { cur.hidden = true; cur.classList.remove("dc-anim-out"); enter(); }, 230); }
      else enter();
    }
    function back() { const prev = history.pop(); if (prev) showStepRaw(prev); }
    backBtn.addEventListener("click", back);

    function hideAllSteps() {
      ["interest","service","pack","day","time","contract","details"].forEach((n) => { const e = stepEl(n); if (e) { e.hidden = true; e.classList.remove("dc-anim-in","dc-anim-out"); } });
      const s = stepEl("success"); if (s) { s.hidden = true; s.classList.remove("dc-anim-in","dc-anim-out"); }
    }

    async function fetchConfig() {
      if (configFetched) return; configFetched = true; if (!WORKER) return;
      try { const res = await fetch(`${WORKER}/ms/config`); if (!res.ok) return; const d = await res.json(); if (d && d.weekdays) availWeekdays = new Set(Object.keys(d.weekdays).map(Number)); } catch (_) {}
    }

    function open(opts) {
      opts = opts || {};
      mode = opts.mode || "call";
      packs = parseList(opts.packs); services = parseList(opts.services); interests = parseList(opts.interests);
      service = opts.service || (mode === "consult" ? "Consultation call" : mode === "shoot" ? "Shoot" : "Discovery call");
      serviceBase = service;
      duration = parseInt(opts.duration, 10) || (mode === "shoot" && packs && packs[0] ? packs[0].minutes : 30);
      chosenInterests = []; chosenScope = "Not sure yet"; chosenPack = null;
      selectedDate = null; selectedSlot = null; history = [];
      hideAllSteps(); activeStep = null;
      if (form) form.reset(); formSummary.textContent = ""; contractSummary.textContent = "";
      if (agree) { agree.checked = false; agree.disabled = true; } if (terms) terms.classList.remove("is-read");
      if (contractCta) contractCta.disabled = true;
      if (formCta) { formCta.disabled = false; formCta.classList.remove("is-loading"); formCta.innerHTML = 'Confirm booking <em>&rarr;</em>'; }
      eyebrow.textContent = `TMKE — ${service}`;
      panel.setAttribute("aria-hidden", "false"); panel.classList.add("is-open");
      document.documentElement.style.overflow = "hidden"; if (stage) stage.scrollTop = 0;
      renderCalendar(); fetchConfig().then(renderCalendar);

      if (mode === "consult") { renderInterests(); showStepRaw("interest"); }
      else if (mode === "shoot") {
        if (services && services.length) { renderServices(); showStepRaw("service"); }
        else if (packs && packs.length) { renderPacks(); showStepRaw("pack"); }
        else showStepRaw("day");
      } else showStepRaw("day");
    }
    function close() { panel.setAttribute("aria-hidden", "true"); panel.classList.remove("is-open"); document.documentElement.style.overflow = ""; }

    // ---- interest (consult) ----
    function renderInterests() {
      interestsWrap.innerHTML = (interests || []).map((n) => `<button type="button" class="dc-choice" data-name="${n}"><span class="dc-choice-check">✓</span><span class="dc-choice-name">${n}</span></button>`).join("");
      interestsWrap.querySelectorAll(".dc-choice").forEach((b) => b.addEventListener("click", () => {
        b.classList.toggle("is-active"); const n = b.dataset.name;
        if (b.classList.contains("is-active")) chosenInterests.push(n); else chosenInterests = chosenInterests.filter((x) => x !== n);
      }));
    }
    scopeWrap && scopeWrap.querySelectorAll(".dc-pill").forEach((b) => b.addEventListener("click", () => { scopeWrap.querySelectorAll(".dc-pill").forEach((x) => x.classList.remove("is-active")); b.classList.add("is-active"); chosenScope = b.dataset.scope; }));
    $("dc-interest-next") && $("dc-interest-next").addEventListener("click", () => goTo("day"));

    // ---- service (shoot generic) ----
    function renderServices() {
      servicesWrap.innerHTML = (services || []).map((s, i) => `<button type="button" class="dc-choice" data-i="${i}"><span class="dc-choice-name">${s.name}</span><span class="dc-choice-meta">${(s.packs || []).length} option${(s.packs || []).length === 1 ? "" : "s"}</span></button>`).join("");
      servicesWrap.querySelectorAll(".dc-choice").forEach((b) => b.addEventListener("click", () => { const s = services[+b.dataset.i]; serviceBase = s.name; packs = s.packs || []; eyebrow.textContent = `TMKE — ${serviceBase}`; renderPacks(); goTo("pack"); }));
    }

    // ---- pack (shoot) ----
    function renderPacks() {
      packsWrap.innerHTML = (packs || []).map((p, i) => `<button type="button" class="dc-choice" data-i="${i}"><span class="dc-choice-name">${p.label}</span><span class="dc-choice-meta">${fmtDur(p.minutes)}</span><span class="dc-choice-price">from ${p.price}</span></button>`).join("");
      packsWrap.querySelectorAll(".dc-choice").forEach((b) => b.addEventListener("click", () => {
        chosenPack = packs[+b.dataset.i]; duration = chosenPack.minutes; service = `${serviceBase} — ${chosenPack.label}`;
        eyebrow.textContent = `TMKE — ${service}`; selectedSlot = null;
        goTo("day");
      }));
    }

    // ---- calendar (day) ----
    function sameDay(a, b) { return a && b && a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate(); }
    function renderCalendar() {
      calLabel.textContent = `${MONTHS[viewMonth.getMonth()]} ${viewMonth.getFullYear()}`;
      const first = new Date(viewMonth), off = (first.getDay() + 6) % 7;
      const gs = new Date(first); gs.setDate(first.getDate() - off);
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const cells = [];
      for (let i = 0; i < 42; i++) {
        const d = new Date(gs); d.setDate(gs.getDate() + i);
        const inM = d.getMonth() === viewMonth.getMonth(), past = d < today;
        const closed = availWeekdays ? !availWeekdays.has(d.getDay()) : (d.getDay() === 0 || d.getDay() === 6);
        const cl = ["dc-cal-day"]; if (!inM) cl.push("is-other-month"); if (sameDay(d, today)) cl.push("is-today"); if (sameDay(d, selectedDate)) cl.push("is-active");
        cells.push(`<button type="button" class="${cl.join(" ")}" data-date="${localISO(d)}" ${past || closed ? "disabled" : ""}>${d.getDate()}</button>`);
      }
      calGrid.innerHTML = cells.join("");
    }
    $("dc-prev-month").addEventListener("click", () => { viewMonth.setMonth(viewMonth.getMonth() - 1); renderCalendar(); });
    $("dc-next-month").addEventListener("click", () => { viewMonth.setMonth(viewMonth.getMonth() + 1); renderCalendar(); });
    calGrid.addEventListener("click", (e) => {
      const btn = e.target.closest(".dc-cal-day"); if (!btn || btn.hasAttribute("disabled")) return;
      selectedDate = new Date(btn.dataset.date + "T12:00:00"); selectedSlot = null; renderCalendar();
      goTo("time");
    });

    // ---- time (slots) ----
    async function renderSlots() {
      if (!selectedDate) return;
      const dt = selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
      timeSub.textContent = `${service} · ${dt} · ${fmtDur(duration)}`;
      if (!WORKER) { slotsGrid.innerHTML = `<p class="dc-slots-empty">Booking is being set up — please check back shortly.</p>`; return; }
      slotsGrid.innerHTML = `<p class="dc-slots-empty">Finding times…</p>`;
      try {
        const res = await fetch(`${WORKER}/ms/availability?date=${localISO(selectedDate)}&duration=${duration}`);
        const data = await res.json(); if (!res.ok) throw new Error(data.error || "error");
        if (!data.slots || !data.slots.length) { slotsGrid.innerHTML = `<p class="dc-slots-empty">No times available that day — go back and try another.</p>`; return; }
        slotsGrid.innerHTML = data.slots.map((s) => `<button type="button" class="dc-slot" data-slot="${s}">${s}</button>`).join("");
      } catch (e) { slotsGrid.innerHTML = `<p class="dc-slots-empty">Couldn't load times. Please try again.</p>`; }
    }
    slotsGrid.addEventListener("click", (e) => {
      const btn = e.target.closest(".dc-slot"); if (!btn) return;
      selectedSlot = btn.dataset.slot;
      const dt = selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" });
      const summary = `${service} — ${dt} at ${selectedSlot} GMT (${fmtDur(duration)}).`;
      formSummary.textContent = summary; contractSummary.textContent = summary;
      if (mode === "shoot") {
        if (!signDate.value) signDate.value = localISO(new Date());
        if (terms && terms.scrollHeight <= terms.clientHeight + 4) { agree.disabled = false; terms.classList.add("is-read"); }
        refreshContract(); goTo("contract");
      } else { goTo("details"); }
    });

    // ---- contract ----
    function refreshContract() { if (contractCta) contractCta.disabled = !(agree && !agree.disabled && agree.checked && signName.value.trim() && signDate.value); }
    if (terms) terms.addEventListener("scroll", () => { if (terms.scrollTop + terms.clientHeight >= terms.scrollHeight - 8) { agree.disabled = false; terms.classList.add("is-read"); refreshContract(); } });
    agree && agree.addEventListener("change", refreshContract);
    signName && signName.addEventListener("input", refreshContract);
    signDate && signDate.addEventListener("input", refreshContract);
    contractCta && contractCta.addEventListener("click", () => { if (!contractCta.disabled) goTo("details"); });

    // ---- details → book (final) ----
    form.addEventListener("submit", (e) => { e.preventDefault(); book(); });

    async function book() {
      if (!selectedDate || !selectedSlot) { formSummary.textContent = "Please pick a date and time first."; return; }
      if (!WORKER) { formSummary.textContent = "Booking is being set up — please check back shortly."; return; }
      const fd = new FormData(form);
      const parts = [];
      if (mode === "consult") { parts.push("Consultation enquiry"); if (chosenInterests.length) parts.push("Interested in: " + chosenInterests.join(", ")); if (chosenScope) parts.push("Scope: " + chosenScope); }
      if (mode === "shoot" && chosenPack) parts.push(`Pack: ${chosenPack.label} (${fmtDur(chosenPack.minutes)}, from ${chosenPack.price})`);
      if (fd.get("company")) parts.push(`Company: ${fd.get("company")}`);
      if (fd.get("phone")) parts.push(`Phone: ${fd.get("phone")}`);
      if (fd.get("agenda")) parts.push(String(fd.get("agenda")));
      if (mode === "shoot") parts.push(`Agreement: signed "${signName.value.trim()}" on ${signDate.value} — agreed to TMKE shoot T&Cs.`);
      const notes = parts.join(" | ");

      formCta.disabled = true; formCta.classList.add("is-loading"); formCta.innerHTML = '<span class="dc-spinner"></span> Confirming…';
      const t0 = Date.now();
      try {
        const res = await fetch(`${WORKER}/ms/book`, { method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ date: localISO(selectedDate), start: selectedSlot, duration, service, name: fd.get("name"), email: fd.get("email"), phone: fd.get("phone"), notes }) });
        const data = await res.json(); if (!res.ok) throw new Error(data.error || "Booking failed");
        const wait = 1200 - (Date.now() - t0); if (wait > 0) await sleep(wait);
        const dt = selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
        successMsg.textContent = `We've held ${dt} at ${selectedSlot} GMT for ${service}. You'll shortly receive an email to confirm your booking.`;
        history = []; goTo("success"); history = []; backBtn.hidden = true;
        formCta.classList.remove("is-loading"); formCta.disabled = false; formCta.innerHTML = 'Confirm booking <em>&rarr;</em>';
      } catch (err) {
        formCta.classList.remove("is-loading"); formCta.disabled = false; formCta.innerHTML = 'Confirm booking <em>&rarr;</em>';
        formSummary.textContent = (err && err.message) || "Sorry, that didn't go through — please try another time.";
      }
    }

    // ---- close + openers ----
    panel.addEventListener("click", (e) => { if (e.target.closest("[data-dc-close]")) close(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && panel.classList.contains("is-open")) close(); });
    document.addEventListener("click", (e) => {
      const o = e.target.closest?.("[data-discovery-call]"); if (!o) return; e.preventDefault();
      open({ mode: o.getAttribute("data-dc-mode"), service: o.getAttribute("data-dc-service"), duration: o.getAttribute("data-dc-duration"), packs: o.getAttribute("data-dc-packs"), services: o.getAttribute("data-dc-services"), interests: o.getAttribute("data-dc-interests") });
    });
    window.tmkeDiscoveryOpen = open;
  })();
</script>
