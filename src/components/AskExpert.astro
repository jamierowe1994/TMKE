---
// Floating "Ask an Expert" chat widget for the Studio.
// Sits in the bottom-right corner; click to open a chat dialog
// that POSTs to /api/ask-expert. The endpoint is expected to
// proxy to an LLM (e.g. Anthropic Claude) and stream back text.
//
// Backend contract:
//   POST /api/ask-expert
//   Body: { messages: [{ role: 'user'|'assistant', content: string }] }
//   Returns: { reply: string } or text/event-stream of deltas
//
// Since Astro currently builds static, no /api route exists yet.
// A starter Supabase Edge Function is included at:
//   supabase/functions/ask-expert/index.ts
// Deploy it and set ANTHROPIC_API_KEY in the Supabase Functions
// secrets, then point the fetch URL at the function endpoint.
---

<button
  type="button"
  id="ask-expert-trigger"
  class="ae-trigger"
  aria-haspopup="dialog"
  aria-controls="ask-expert-panel"
  aria-expanded="false"
>
  <span class="ae-trigger-icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
  </span>
  <span class="ae-trigger-label">Ask an expert</span>
</button>

<aside
  id="ask-expert-panel"
  class="ae-panel"
  role="dialog"
  aria-modal="false"
  aria-labelledby="ae-panel-title"
  hidden
>
  <header class="ae-head">
    <div>
      <p class="ae-eyebrow">Studio support</p>
      <h3 id="ae-panel-title" class="ae-title">Ask an expert</h3>
    </div>
    <button type="button" id="ask-expert-close" class="ae-close" aria-label="Close">&times;</button>
  </header>

  <div id="ae-log" class="ae-log" aria-live="polite">
    <div class="ae-msg ae-msg--bot">
      <p>Hi! I'm here to help you get the most out of the Studio. Ask me how to do anything &mdash; resize a photo, change brand colours, add a logo, schedule a post &mdash; and I'll walk you through it.</p>
    </div>
  </div>

  <form id="ae-form" class="ae-form">
    <textarea
      id="ae-input"
      class="ae-input"
      rows="2"
      placeholder="How do I add my logo to a template?"
      aria-label="Your question"
    ></textarea>
    <button type="submit" class="ae-send" aria-label="Send">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="22" y1="2" x2="11" y2="13"/>
        <polygon points="22 2 15 22 11 13 2 9 22 2"/>
      </svg>
    </button>
  </form>

  <p class="ae-foot">Powered by AI &middot; replies may take a few seconds.</p>
</aside>

<style is:global>
  /* ===== Floating trigger — bottom-right of the Studio ===== */
  .ae-trigger {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 200;
    appearance: none;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 14px 20px 14px 16px;
    background: var(--english-violet);
    color: var(--paper);
    border: 0;
    border-radius: 999px;
    cursor: pointer;
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow:
      0 18px 36px -14px rgba(15, 12, 30, 0.55),
      0 6px 14px -8px rgba(15, 12, 30, 0.30);
    transition: transform 0.25s cubic-bezier(.2,.7,.2,1), box-shadow 0.25s, background 0.25s;
  }
  .ae-trigger:hover {
    transform: translateY(-2px);
    background: var(--ink);
    box-shadow:
      0 24px 44px -14px rgba(15, 12, 30, 0.65),
      0 10px 20px -10px rgba(15, 12, 30, 0.35);
  }
  .ae-trigger[aria-expanded="true"] {
    transform: scale(0.92);
    opacity: 0.85;
  }
  .ae-trigger-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 22px;
    height: 22px;
  }
  .ae-trigger-icon svg {
    width: 18px;
    height: 18px;
  }

  /* ===== Chat panel — slides up from bottom-right ===== */
  .ae-panel {
    position: fixed;
    right: 24px;
    bottom: 92px;
    z-index: 201;
    width: min(380px, calc(100vw - 48px));
    max-height: min(640px, calc(100vh - 140px));
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid rgba(28, 29, 34, 0.10);
    border-radius: 14px;
    box-shadow:
      0 32px 64px -16px rgba(15, 12, 30, 0.55),
      0 10px 20px -10px rgba(15, 12, 30, 0.30);
    opacity: 0;
    transform: translateY(16px) scale(0.98);
    transform-origin: bottom right;
    transition:
      opacity 0.3s cubic-bezier(.2,.7,.2,1),
      transform 0.3s cubic-bezier(.2,.7,.2,1);
    pointer-events: none;
  }
  .ae-panel[hidden] { display: none; }
  .ae-panel.is-open {
    opacity: 1;
    transform: translateY(0) scale(1);
    pointer-events: auto;
  }

  .ae-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 18px 20px 14px;
    border-bottom: 1px solid rgba(28, 29, 34, 0.08);
  }
  .ae-eyebrow {
    margin: 0;
    font-family: var(--sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--english-violet);
  }
  .ae-title {
    margin: 4px 0 0;
    font-family: var(--serif);
    font-weight: 500;
    font-size: 22px;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .ae-close {
    appearance: none;
    background: transparent;
    border: 0;
    font-size: 22px;
    line-height: 1;
    color: rgba(28, 29, 34, 0.55);
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 4px;
    transition: background 0.2s, color 0.2s;
  }
  .ae-close:hover {
    background: rgba(71, 66, 84, 0.08);
    color: var(--ink);
  }

  .ae-log {
    flex: 1;
    overflow-y: auto;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    scrollbar-width: thin;
    scrollbar-color: rgba(71,66,84,0.25) transparent;
  }
  .ae-msg {
    max-width: 88%;
    padding: 10px 14px;
    border-radius: 12px;
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.5;
  }
  .ae-msg p { margin: 0 0 6px; }
  .ae-msg p:last-child { margin-bottom: 0; }
  .ae-msg--bot {
    align-self: flex-start;
    background: rgba(71, 66, 84, 0.08);
    color: var(--ink);
    border-bottom-left-radius: 3px;
  }
  .ae-msg--user {
    align-self: flex-end;
    background: var(--english-violet);
    color: var(--paper);
    border-bottom-right-radius: 3px;
  }
  .ae-msg--typing {
    display: inline-flex;
    gap: 4px;
    padding: 12px 14px;
  }
  .ae-msg--typing span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(71, 66, 84, 0.6);
    animation: aeTyping 1.2s infinite ease-in-out;
  }
  .ae-msg--typing span:nth-child(2) { animation-delay: 0.18s; }
  .ae-msg--typing span:nth-child(3) { animation-delay: 0.36s; }
  @keyframes aeTyping {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30%           { transform: translateY(-4px); opacity: 1; }
  }
  .ae-msg--error {
    background: rgba(184, 130, 106, 0.14);
    color: #8a4d33;
    border: 1px solid rgba(184, 130, 106, 0.35);
    align-self: flex-start;
  }

  .ae-form {
    display: flex;
    gap: 8px;
    align-items: flex-end;
    padding: 12px 14px;
    border-top: 1px solid rgba(28, 29, 34, 0.08);
  }
  .ae-input {
    flex: 1;
    resize: none;
    padding: 10px 12px;
    background: #fff;
    border: 1px solid rgba(28, 29, 34, 0.14);
    border-radius: 8px;
    font-family: var(--sans);
    font-size: 13px;
    line-height: 1.5;
    color: var(--ink);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .ae-input:focus {
    outline: none;
    border-color: var(--english-violet);
    box-shadow: 0 0 0 3px rgba(71, 66, 84, 0.12);
  }
  .ae-send {
    appearance: none;
    width: 38px;
    height: 38px;
    border-radius: 8px;
    background: var(--english-violet);
    color: var(--paper);
    border: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
    flex-shrink: 0;
  }
  .ae-send:hover { background: var(--ink); transform: translateY(-1px); }
  .ae-send:disabled { opacity: 0.45; cursor: wait; transform: none; }
  .ae-send svg { width: 16px; height: 16px; }
  .ae-foot {
    margin: 0;
    padding: 6px 18px 12px;
    font-family: var(--sans);
    font-size: 10px;
    color: rgba(28, 29, 34, 0.45);
  }

  @media (prefers-reduced-motion: reduce) {
    .ae-trigger, .ae-panel { transition: none; }
    .ae-msg--typing span { animation: none; }
  }
</style>

<script>
  // Client-side controller for the Ask an Expert widget.
  // Keeps a rolling conversation in memory and POSTs to the
  // backend on every send. The fallback when no /api endpoint
  // exists yet just echoes a friendly stub so the UI is usable
  // for layout / interaction review.
  (function setupAskExpert() {
    const $trigger = document.getElementById("ask-expert-trigger");
    const $panel   = document.getElementById("ask-expert-panel");
    const $close   = document.getElementById("ask-expert-close");
    const $form    = document.getElementById("ae-form");
    const $input   = document.getElementById("ae-input") as HTMLTextAreaElement | null;
    const $log     = document.getElementById("ae-log");
    const $send    = $form ? ($form.querySelector(".ae-send") as HTMLButtonElement | null) : null;
    if (!$trigger || !$panel || !$form || !$input || !$log) return;

    const history: { role: "user" | "assistant"; content: string }[] = [];

    function openPanel() {
      $panel.hidden = false;
      requestAnimationFrame(() => {
        $panel.classList.add("is-open");
        $trigger.setAttribute("aria-expanded", "true");
        $input.focus();
      });
    }
    function closePanel() {
      $panel.classList.remove("is-open");
      $trigger.setAttribute("aria-expanded", "false");
      setTimeout(() => {
        if (!$panel.classList.contains("is-open")) $panel.hidden = true;
      }, 320);
    }

    function append(role: "user" | "assistant" | "error", text: string): HTMLDivElement {
      const div = document.createElement("div");
      div.className = "ae-msg ae-msg--" + (role === "user" ? "user" : role === "error" ? "error" : "bot");
      const p = document.createElement("p");
      p.textContent = text;
      div.appendChild(p);
      $log.appendChild(div);
      $log.scrollTop = $log.scrollHeight;
      return div;
    }
    function appendTyping(): HTMLDivElement {
      const div = document.createElement("div");
      div.className = "ae-msg ae-msg--bot ae-msg--typing";
      div.innerHTML = "<span></span><span></span><span></span>";
      $log.appendChild(div);
      $log.scrollTop = $log.scrollHeight;
      return div;
    }

    // Backend URL — points at the Supabase Edge Function in production
    // (set PUBLIC_ASK_EXPERT_URL in .env / Railway vars) or falls back
    // to a same-origin /api route when an SSR adapter is configured.
    const BACKEND_URL =
      (import.meta.env.PUBLIC_ASK_EXPERT_URL as string | undefined) ||
      "/api/ask-expert";

    async function askBackend(messages: typeof history): Promise<string> {
      try {
        const res = await fetch(BACKEND_URL, {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify({ messages }),
        });
        if (!res.ok) throw new Error("HTTP " + res.status);
        const data = await res.json();
        return data.reply || "(no reply)";
      } catch (err) {
        // No backend yet — return a stub so the UI is usable.
        return (
          "I'm not wired up to the AI service yet — but when I am, I'll " +
          "walk you through whatever you're trying to do. In the meantime, " +
          "drop us a line at hello@tmke.co.uk and we'll get you sorted."
        );
      }
    }

    $trigger.addEventListener("click", () => {
      if ($panel.hidden) openPanel();
      else closePanel();
    });
    $close.addEventListener("click", closePanel);
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !$panel.hidden) closePanel();
    });

    $form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const text = $input.value.trim();
      if (!text) return;
      append("user", text);
      history.push({ role: "user", content: text });
      $input.value = "";
      $input.style.height = "";
      if ($send) $send.disabled = true;
      const $typing = appendTyping();
      const reply = await askBackend(history);
      $typing.remove();
      append("assistant", reply);
      history.push({ role: "assistant", content: reply });
      if ($send) $send.disabled = false;
    });

    // Auto-grow textarea so multi-line questions fit.
    $input.addEventListener("input", () => {
      $input.style.height = "";
      $input.style.height = Math.min($input.scrollHeight, 120) + "px";
    });

    // Submit on Enter (Shift+Enter inserts a newline).
    $input.addEventListener("keydown", (e) => {
      if (e.key === "Enter" && !e.shiftKey) {
        e.preventDefault();
        $form.requestSubmit();
      }
    });
  })();
</script>
