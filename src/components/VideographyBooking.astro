---
// ============================================================================
// Videography service booking flow (brief v3.0) — replaces the waitlist flow for
// the videography services. Phase 1: Content Studio member happy-path +
// non-member "register interest". Property / Agent (add-ons, postcode, surcharge)
// layer onto the same component in later phases.
//
// Flow (member): work-email gate → route → session/package → day → time →
//   summary → T&Cs (sign) → details + account → confirm.
// Non-member (Content Studio is members-only): register-interest capture.
//
// Reuses the global `.dc-*` wizard styles (from DiscoveryPanel, present on the
// videography page) for visual consistency; uses `vb-` ids + its own module
// script so it never collides with the discovery/consult panel.
//
// Backend booking + account creation + emails are wired in Phase 3; for now the
// confirm step books into Jack's 365 diary via the existing Worker endpoint and
// carries the captured account/opt-in fields forward.
// ============================================================================
import "../styles/booking-wizard.css";  // shared .dc-* wizard chrome (self-contained — no DiscoveryPanel needed)
import { BROCHURE_URL } from "../lib/videography-config.js";
const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
---

<aside class="dc-panel vb-panel" id="vb-panel" aria-hidden="true" data-worker={WORKER}>
  <div class="dc-panel-scrim" data-vb-close></div>
  <!-- data-lenis-prevent: keep Lenis (smooth-scroll) off this container so the
       wheel natively scrolls the form when it overflows on shorter screens. -->
  <div class="dc-panel-stage" data-lenis-prevent>
    <header class="dc-panel-head">
      <div class="dc-head-left">
        <button type="button" class="dc-panel-close" data-vb-close aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
          <span>Close</span>
        </button>
        <button type="button" class="dc-panel-back" id="vb-back" hidden>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
          <span>Back</span>
        </button>
      </div>
      <div class="dc-panel-eyebrow" id="vb-eyebrow">TMKE — Booking</div>
    </header>

    <div class="dc-panel-body">
      <!-- 0. Service chooser ("Book a Shoot" generic entry) -->
      <section class="dc-step" id="vb-step-service" hidden>
        <h2 class="dc-step-title">What would you like to <em>book?</em></h2>
        <p class="dc-step-sub">Choose a service to get started.</p>
        <div class="dc-choices" id="vb-services"></div>
      </section>

      <!-- 1. Email gate -->
      <section class="dc-step" id="vb-step-email" hidden>
        <h2 class="dc-step-title">Let's get started</h2>
        <p class="dc-step-sub" id="vb-email-sub">Enter your business email for availability, pricing, and package options tailored to your membership.</p>
        <form class="dc-panel-form" id="vb-email-form">
          <label class="dc-field"><span>Work email address *</span><input name="email" type="email" autocomplete="email" required placeholder="you@thepropertyexperts.co.uk" /></label>
          <p class="dc-gate-error" id="vb-email-error" hidden></p>
          <button type="submit" class="dc-form-cta" id="vb-email-cta">Continue <em>&rarr;</em></button>
        </form>
      </section>

      <!-- 2. Register interest (non-member, members-only service) -->
      <section class="dc-step" id="vb-step-register" hidden>
        <h2 class="dc-step-title">Member Only</h2>
        <p class="dc-step-sub" id="vb-register-sub">The Content Studio is currently available exclusively to our affiliate members. If you're interested in future access, register your details below and we'll keep you updated.</p>
        <form class="dc-panel-form" id="vb-register-form">
          <label class="dc-field"><span>Email *</span><input name="email" type="email" required /></label>
          <label class="vb-optin"><input type="checkbox" name="optin" /><span>I'd like to receive updates on TMKE services, news and promotions.</span></label>
          <p class="dc-gate-error" id="vb-register-error" hidden></p>
          <button type="submit" class="dc-form-cta" id="vb-register-cta">Register interest <em>&rarr;</em></button>
        </form>
      </section>

      <!-- 3. Session / package -->
      <section class="dc-step" id="vb-step-options" hidden>
        <h2 class="dc-step-title" id="vb-options-title">Choose your <em>session.</em></h2>
        <p class="dc-step-sub" id="vb-options-sub">All prices are plus VAT.</p>
        <div id="vb-options"></div>
        <div class="dc-step-actions" id="vb-options-actions" hidden><button type="button" class="dc-next" id="vb-options-next">Continue <em>&rarr;</em></button></div>
        <p class="vb-brochure"><a href={BROCHURE_URL} target="_blank" rel="noopener">Prefer to browse first? Download our brochure (PDF) <em>&rarr;</em></a></p>
      </section>

      <!-- 2b. Enquiry (non-member, Property / Agent) -->
      <section class="dc-step" id="vb-step-enquiry" hidden>
        <h2 class="dc-step-title">Tell us about your <em>project.</em></h2>
        <p class="dc-step-sub" id="vb-enquiry-sub">Leave your details and Jack will be in touch with a tailored quote.</p>
        <form class="dc-panel-form" id="vb-enquiry-form">
          <label class="dc-field"><span>Full name *</span><input name="name" autocomplete="name" required /></label>
          <div class="dc-field-row">
            <label class="dc-field"><span>Email *</span><input name="email" type="email" autocomplete="email" required /></label>
            <label class="dc-field"><span>Phone *</span><input name="phone" type="tel" autocomplete="tel" required /></label>
          </div>
          <div class="dc-field-row">
            <label class="dc-field"><span>Company / Brand</span><input name="company" /></label>
            <label class="dc-field"><span>Property / shoot postcode</span><input name="postcode" autocomplete="postal-code" /></label>
          </div>
          <label class="dc-field"><span>What do you need? *</span><textarea name="message" rows="3" required placeholder="Tell us about the property or shoot, timings, and anything specific you're after."></textarea></label>
          <label class="vb-optin"><input type="checkbox" name="optin" /><span>Yes, I'd like to receive updates on TMKE services and news.</span></label>
          <p class="dc-gate-error" id="vb-enquiry-error" hidden></p>
          <button type="submit" class="dc-form-cta" id="vb-enquiry-cta">Send enquiry <em>&rarr;</em></button>
        </form>
      </section>

      <!-- 2c. Interests (Discovery call) -->
      <section class="dc-step" id="vb-step-interests" hidden>
        <h2 class="dc-step-title">What are you <em>interested in?</em></h2>
        <p class="dc-step-sub">Pick anything that applies — it just helps Jack prep for your call.</p>
        <div class="dc-choices dc-choices--multi" id="vb-interests"></div>
        <div class="dc-step-actions"><button type="button" class="dc-next" id="vb-interests-next">Continue <em>&rarr;</em></button></div>
      </section>

      <!-- 3b. Postcode (Property / Agent — for the travel surcharge) -->
      <section class="dc-step" id="vb-step-postcode" hidden>
        <h2 class="dc-step-title" id="vb-postcode-title">Property Location</h2>
        <p class="dc-step-sub" id="vb-postcode-sub">Enter the property postcode so we can calculate any travel costs before you confirm your booking.</p>
        <form class="dc-panel-form" id="vb-postcode-form">
          <label class="dc-field"><span>Postcode *</span><input name="postcode" autocomplete="postal-code" required placeholder="e.g. NN1 1AA" /></label>
          <p class="vb-surcharge-note" id="vb-surcharge-note" hidden></p>
          <p class="vb-hmrc-note">Any distance over 40 miles is charged at 55p per mile in line with HMRC approved mileage rates.</p>
          <p class="dc-gate-error" id="vb-postcode-error" hidden></p>
          <button type="submit" class="dc-form-cta" id="vb-postcode-cta">Check distance <em>&rarr;</em></button>
        </form>
      </section>

      <!-- 4. Day -->
      <section class="dc-step" id="vb-step-day" hidden>
        <h2 class="dc-step-title">Pick a Day</h2>
        <p class="dc-step-sub" id="vb-day-sub">Select the date you'd like your shoot to take place. Available dates are based on Jack's current diary.</p>
        <div class="dc-cal">
          <header class="dc-cal-head">
            <button type="button" class="dc-cal-nav" id="vb-prev-month" aria-label="Previous month">&larr;</button>
            <div class="dc-cal-label" id="vb-cal-label">…</div>
            <button type="button" class="dc-cal-nav" id="vb-next-month" aria-label="Next month">&rarr;</button>
          </header>
          <div class="dc-cal-weekdays"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
          <div class="dc-cal-grid" id="vb-cal-grid"></div>
        </div>
      </section>

      <!-- 5. Time -->
      <section class="dc-step" id="vb-step-time" hidden>
        <h2 class="dc-step-title">Pick a Time</h2>
        <p class="dc-step-sub" id="vb-time-sub">…</p>
        <div class="dc-slots-grid" id="vb-slots-grid"></div>
      </section>

      <!-- 6. Summary -->
      <section class="dc-step" id="vb-step-summary" hidden>
        <h2 class="dc-step-title">Almost There</h2>
        <p class="dc-step-sub" id="vb-summary-sub">Review your booking. If everything looks right, continue to confirm.</p>
        <div class="vb-summary" id="vb-summary"></div>
        <div class="vb-promo" id="vb-promo" hidden>
          <label class="dc-field"><span>Promo code</span>
            <div class="vb-promo-row">
              <input id="vb-promo-input" placeholder="Enter a code" autocomplete="off" />
              <button type="button" class="vb-promo-apply" id="vb-promo-apply">Apply</button>
            </div>
          </label>
          <p class="vb-promo-msg" id="vb-promo-msg" hidden></p>
        </div>
        <div class="dc-step-actions"><button type="button" class="dc-next" id="vb-summary-next">Continue <em>&rarr;</em></button></div>
      </section>

      <!-- 7. Terms -->
      <section class="dc-step" id="vb-step-terms" hidden>
        <h2 class="dc-step-title">The agreement</h2>
        <p class="dc-step-sub">Please read the terms, then sign to confirm your booking.</p>
        <!-- Populated per service by the script (renderTerms) so each flow shows
             its own agreement (Content Studio / Property / Agent). -->
        <div class="dc-terms" id="vb-terms" tabindex="0"></div>
        <label class="dc-agree-row">
          <input type="checkbox" id="vb-agree" disabled required />
          <span>I have read and agree to the Terms &amp; Conditions above.</span>
        </label>
        <div class="dc-sign">
          <label class="dc-field"><span>Sign — type your full name</span><input id="vb-sign-name" autocomplete="name" required /></label>
          <label class="dc-field"><span>Date</span><input id="vb-sign-date" type="date" required /></label>
        </div>
        <div class="dc-step-actions"><button type="button" class="dc-next" id="vb-terms-cta" disabled>Agree &amp; continue <em>&rarr;</em></button></div>
      </section>

      <!-- 7b. Call details (Discovery) — two stages, matching the SMM Book a
           Call: details first, then the account treatment decided by the email
           (signed in → books instantly · existing → enter password · new →
           create a password + newsletter opt-in). -->
      <section class="dc-step" id="vb-step-call-details" hidden>
        <h2 class="dc-step-title">Your <em>details.</em></h2>
        <p class="dc-form-summary" id="vb-call-summary"></p>
        <form class="dc-panel-form" id="vb-call-form">
          <div id="vb-call-fields">
            <label class="dc-field"><span>Full name *</span><input name="name" autocomplete="name" required /></label>
            <div class="dc-field-row">
              <label class="dc-field"><span>Email *</span><input name="email" type="email" autocomplete="email" required /></label>
              <label class="dc-field"><span>Phone *</span><input name="phone" type="tel" autocomplete="tel" required /></label>
            </div>
            <label class="dc-field"><span>Company / Brand</span><input name="company" /></label>
            <label class="dc-field"><span>Anything you'd like to cover?</span><textarea name="message" rows="2"></textarea></label>
          </div>
          <div id="vb-call-acct" hidden>
            <div id="vbc-signin" hidden>
              <p class="vb-signin-note">Welcome back — you already have a TMKE account. Enter your password and we&rsquo;ll link this call to it. <a href="/forgot-password" target="_blank" rel="noopener">Forgotten it?</a></p>
              <label class="dc-field"><span>Your password *</span><input name="signin_password" type="password" autocomplete="current-password" /></label>
            </div>
            <div id="vbc-create" hidden>
              <p class="vb-signin-note">We&rsquo;ll set up your TMKE account as part of the booking, so you can manage your call, bookings and downloads in one place.</p>
              <div class="dc-field-row">
                <label class="dc-field"><span>Create a password *</span><input name="password" type="password" autocomplete="new-password" /></label>
                <label class="dc-field"><span>Confirm password *</span><input name="password2" type="password" autocomplete="new-password" /></label>
              </div>
              <label class="vb-optin"><input type="checkbox" name="optin" /><span>Sign me up to the TMKE newsletter and marketing emails</span></label>
            </div>
            <button type="button" class="vmodal-consult" id="vbc-back">&larr; <strong>Edit your details</strong></button>
          </div>
          <p class="dc-privacy">We use your details to arrange your call. See our <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</p>
          <p class="dc-gate-error" id="vb-call-error" hidden></p>
          <button type="submit" class="dc-form-cta" id="vb-call-cta" data-stage="details">Continue <em>&rarr;</em></button>
        </form>
      </section>

      <!-- 8. Details + account -->
      <section class="dc-step" id="vb-step-details" hidden>
        <h2 class="dc-step-title">Your <em>details.</em></h2>
        <p class="dc-form-summary" id="vb-details-summary"></p>
        <form class="dc-panel-form" id="vb-details-form">
          <label class="dc-field"><span>Full name *</span><input name="name" autocomplete="name" required /></label>
          <div class="dc-field-row">
            <label class="dc-field"><span>Email</span><input name="email" type="email" readonly /></label>
            <label class="dc-field"><span>Phone *</span><input name="phone" type="tel" autocomplete="tel" required /></label>
          </div>
          <label class="dc-field"><span>Company / Brand *</span><input name="company" required /></label>
          <label class="dc-field"><span>Anything we should know?</span><textarea name="notes" rows="2"></textarea></label>
          <!-- New account: create a password. Existing account (detected at the
               email gate): sign in instead — toggled by the script. -->
          <p class="vb-signin-note" id="vb-signin-note" hidden>You already have a TMKE account — enter your password to sign in and we'll attach this booking to it. <a href="/forgot-password" target="_blank" rel="noopener">Forgotten it?</a></p>
          <p class="vb-signin-note" id="vb-signedin-note" hidden>You&rsquo;re signed in — no password needed. This booking will be added to your TMKE account.</p>
          <div class="dc-field-row" id="vb-pw-create">
            <label class="dc-field"><span>Create a password *</span><input name="password" type="password" autocomplete="new-password" minlength="8" /></label>
            <label class="dc-field"><span>Confirm password *</span><input name="password2" type="password" autocomplete="new-password" minlength="8" /></label>
          </div>
          <label class="dc-field" id="vb-pw-signin" hidden><span>Your password *</span><input name="signin_password" type="password" autocomplete="current-password" /></label>
          <label class="vb-optin"><input type="checkbox" name="optin" /><span>I'd like to receive information about TMKE services, updates and promotions.</span></label>
          <p class="dc-privacy">We use your details to manage your booking. See our <a href="/privacy" target="_blank" rel="noopener">Privacy Policy</a>.</p>
          <p class="dc-gate-error" id="vb-details-error" hidden></p>
          <button type="submit" class="dc-form-cta" id="vb-details-cta">Confirm booking <em>&rarr;</em></button>
        </form>
      </section>

      <!-- success -->
      <section class="dc-step dc-success" id="vb-success" hidden>
        <div class="dc-tick" aria-hidden="true">
          <svg viewBox="0 0 52 52"><circle class="dc-tick-circle" cx="26" cy="26" r="24"/><path class="dc-tick-path" fill="none" d="M14 27l8 8 16-18"/></svg>
        </div>
        <h3 id="vb-success-title">Booking confirmed</h3>
        <p id="vb-success-msg">You'll shortly receive an email to confirm your booking.</p>
        <button type="button" class="dc-form-cta dc-success-done" data-vb-close>Done <em>&rarr;</em></button>
      </section>
    </div>
  </div>
</aside>

<style is:global>
  /* Booking summary + opt-in (chrome reuses the global .dc-* styles). */
  .vb-summary { display: flex; flex-direction: column; gap: 2px; border: 1px solid rgba(var(--violet-rgb),0.16); border-radius: 12px; overflow: hidden; background: #fff; }
  .vb-srow { display: flex; justify-content: space-between; gap: 16px; padding: 14px 18px; font-family: var(--sans); font-size: 14px; color: var(--ink); border-bottom: 1px solid rgba(var(--violet-rgb),0.08); }
  .vb-srow:last-child { border-bottom: 0; }
  .vb-srow span:first-child { color: rgba(28,29,34,0.6); }
  .vb-srow.vb-total { background: rgba(var(--violet-rgb),0.05); }
  .vb-srow.vb-total span { font-family: var(--serif); font-size: 20px; font-weight: 500; color: var(--ink); }
  .vb-optin { display: flex; align-items: flex-start; gap: 11px; font-family: var(--sans); font-size: 13px; line-height: 1.5; color: rgba(28,29,34,0.78); cursor: pointer; }
  .vb-optin input { margin-top: 2px; width: 18px; height: 18px; accent-color: var(--english-violet); }
  .vb-signin-note { font-family: var(--sans); font-size: 13px; line-height: 1.5; color: rgba(28,29,34,0.7); background: rgba(var(--violet-rgb),0.06); border-radius: 8px; padding: 11px 13px; margin: 0; }
  .vb-signin-note[hidden] { display: none; }
  .vb-signin-note a { color: var(--english-violet); font-weight: 600; }
  #vb-pw-signin[hidden], #vb-pw-create[hidden] { display: none; }
  /* Call-details staging (details → account step). */
  #vb-call-fields[hidden], #vb-call-acct[hidden], #vbc-signin[hidden], #vbc-create[hidden] { display: none !important; }
  #vb-call-fields, #vb-call-acct { display: flex; flex-direction: column; gap: 16px; }
  #vbc-signin, #vbc-create { display: flex; flex-direction: column; gap: 16px; }
  #vbc-back {
    align-self: center; background: none; border: none; cursor: pointer; padding: 6px;
    font-family: var(--sans); font-size: 12px; letter-spacing: 0.04em; color: rgba(28,29,34,0.55);
    transition: color 0.2s;
  }
  #vbc-back:hover { color: var(--ink); }
  #vbc-back strong { font-weight: 600; color: inherit; }
  .dc-choice-output { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.6); margin-top: 2px; }
  .dc-choice-incl { font-family: var(--sans); font-size: 12px; line-height: 1.5; color: rgba(28,29,34,0.6); margin-top: 6px; }
  .vb-running { display: flex; justify-content: space-between; align-items: baseline; margin: 22px 0 0; padding: 14px 18px; background: rgba(var(--violet-rgb),0.05); border-radius: 10px; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); }
  .vb-running strong { font-family: var(--serif); font-size: 22px; font-weight: 500; color: var(--ink); }
  .vb-surcharge-note { font-family: var(--sans); font-size: 13.5px; line-height: 1.5; color: rgba(28,29,34,0.78); background: rgba(var(--violet-rgb),0.06); border-radius: 8px; padding: 12px 14px; margin: 2px 0 0; }
  .vb-surcharge-note[hidden] { display: none; }
  .vb-surcharge-note strong { color: var(--english-violet); }
  .vb-hmrc-note { font-family: var(--sans); font-size: 12px; line-height: 1.5; color: rgba(28,29,34,0.55); margin: 10px 0 0; }
  /* Promo code (members, Property / Agent summary) */
  .vb-promo { margin: 16px 0 0; }
  .vb-promo[hidden] { display: none; }
  .vb-promo-row { display: flex; gap: 8px; }
  .vb-promo-row input { flex: 1; text-transform: uppercase; }
  .vb-promo-apply { flex: none; padding: 0 18px; border: 1px solid var(--english-violet); background: transparent; color: var(--english-violet); border-radius: 8px; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; transition: background 0.2s, color 0.2s; }
  .vb-promo-apply:hover { background: var(--english-violet); color: var(--paper); }
  .vb-promo-apply[disabled] { opacity: 0.55; cursor: wait; }
  .vb-promo-msg { font-family: var(--sans); font-size: 13px; line-height: 1.5; margin: 8px 0 0; }
  .vb-promo-msg[hidden] { display: none; }
  .vb-promo-msg.is-ok { color: #2c7a4b; }
  .vb-promo-msg.is-err { color: #a23b3b; }
  .vb-brochure { margin: 22px 0 0; font-family: var(--sans); font-size: 13.5px; }
  .vb-brochure a { color: var(--english-violet); font-weight: 600; text-decoration: none; border-bottom: 1px solid rgba(var(--violet-rgb),0.3); padding-bottom: 1px; }
  .vb-brochure a:hover { border-bottom-color: var(--english-violet); }
  .vb-brochure em { font-style: normal; margin-left: 4px; }
</style>

<script>
  import {
    SERVICES, audienceForEmail, propertyTierForBrand,
    gbp, vatOf, withVat, surchargePence, SURCHARGE_DEFAULTS,
    termsForService, TERMS_NOTE,
  } from "../lib/videography-config.js";

  (function () {
    const panel = document.getElementById("vb-panel");
    if (!panel) return;
    const WORKER = (panel.dataset.worker || "").replace(/\/+$/, "");
    const stage = panel.querySelector(".dc-panel-stage");
    const $ = (id) => document.getElementById(id);
    const eyebrow = $("vb-eyebrow"), backBtn = $("vb-back");

    const MONTHS = ["January","February","March","April","May","June","July","August","September","October","November","December"];
    const pad = (n) => String(n).padStart(2, "0");
    const localISO = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    const sleep = (ms) => new Promise((r) => setTimeout(r, ms));

    // ---- state ----
    let svc = null;            // SERVICES entry
    let audience = null;       // { audience, brand, label, domain }
    let gateEmail = "";        // the validated work email from the gate
    let chosen = null;         // single selection (content-studio session / property package)
    let selectedAddOns = [];   // property add-ons
    let selectedPackages = []; // agent multi-select packages
    let postcode = "";         // shoot postcode (property/agent)
    let distanceMiles = null;  // distance from base
    let surchargeP = 0;        // travel surcharge in pence (ex-VAT)
    let flow = "booking";      // "booking" | "discovery"
    let promo = null;          // applied promo { code, discount_pence } | null
    let existingAccount = false; // gate email already has a TMKE account → sign in, don't create
    let sessionEmail = null;     // signed-in Supabase user's email (lowercase) — skips the password entirely
    let sessionToken = null;     // their access token — sent as a Bearer so the Worker links the record
    // Detect a live session up front; if the booker is already signed in under
    // the gate email, the details step asks for no password at all.
    (async () => {
      try {
        const m = await import("../lib/supabase.js");
        if (!m || !m.isConfigured || !m.supabase) return;
        const { data } = await m.supabase.auth.getSession();
        const s = data && data.session;
        sessionEmail = s && s.user && s.user.email ? String(s.user.email).toLowerCase() : null;
        sessionToken = (s && s.access_token) || null;
      } catch (_) { /* signed-out flow stays as-is */ }
    })();
    const signedInAsGate = () => !!(sessionEmail && gateEmail && sessionEmail === gateEmail.trim().toLowerCase());
    let selectedInterests = []; // discovery-call interests
    let duration = 90;         // minutes (for availability)
    let selectedDate = null, selectedSlot = null;
    let viewMonth = new Date(); viewMonth.setDate(1);
    let availWeekdays = null, configFetched = false;
    let activeStep = null, history = [];
    const SESSION_MINUTES = { single: 90, half: 180, full: 480 };

    // ---- step nav (one at a time, sliding — same feel as DiscoveryPanel) ----
    const stepEl = (name) => name === "success" ? $("vb-success") : $("vb-step-" + name);
    function goTo(name) { if (activeStep) history.push(activeStep); showStepRaw(name); }
    function showStepRaw(name) {
      const next = stepEl(name); if (!next) return;
      const cur = activeStep ? stepEl(activeStep) : null;
      const enter = () => {
        next.hidden = false; next.classList.remove("dc-anim-out", "dc-anim-in"); void next.offsetWidth; next.classList.add("dc-anim-in");
        if (stage) stage.scrollTop = 0; activeStep = name;
        backBtn.hidden = history.length === 0;
        if (name === "time") renderSlots();
        if (name === "day") setDaySub();
        if (name === "terms") renderTerms();
      };
      if (cur && cur !== next) { cur.classList.remove("dc-anim-in"); cur.classList.add("dc-anim-out"); setTimeout(() => { cur.hidden = true; cur.classList.remove("dc-anim-out"); enter(); }, 230); }
      else enter();
    }
    function back() { const prev = history.pop(); if (prev) showStepRaw(prev); }
    backBtn.addEventListener("click", back);
    function hideAll() { ["service","email","register","enquiry","interests","options","postcode","day","time","summary","terms","call-details","details"].forEach((n) => { const e = stepEl(n); if (e) { e.hidden = true; e.classList.remove("dc-anim-in","dc-anim-out"); } }); const s = stepEl("success"); if (s) { s.hidden = true; s.classList.remove("dc-anim-in","dc-anim-out"); } }

    async function fetchConfig() {
      if (configFetched) return; configFetched = true; if (!WORKER) return;
      try { const res = await fetch(`${WORKER}/ms/config`); if (!res.ok) return; const d = await res.json(); if (d && d.weekdays) availWeekdays = new Set(Object.keys(d.weekdays).map(Number)); } catch (_) {}
    }

    // ---- open / close ----
    function open(serviceKey) {
      audience = null; chosen = null; selectedAddOns = []; selectedPackages = [];
      postcode = ""; distanceMiles = null; surchargeP = 0; selectedInterests = []; flow = "booking";
      promo = null; existingAccount = false;
      duration = 90; selectedDate = null; selectedSlot = null; history = []; activeStep = null;
      hideAll();
      ["vb-email-form", "vb-register-form", "vb-details-form", "vb-enquiry-form", "vb-call-form"].forEach((id) => $(id)?.reset());
      ["vb-email-error", "vb-register-error", "vb-details-error", "vb-enquiry-error", "vb-call-error"].forEach((id) => { const e = $(id); if (e) e.hidden = true; });
      const agree = $("vb-agree"); if (agree) { agree.checked = false; agree.disabled = true; }
      $("vb-terms")?.classList.remove("is-read");
      $("vb-terms-cta").disabled = true;
      resetCta($("vb-details-cta"), "Confirm booking");
      // Reset promo + the details password toggle for a fresh run.
      const pin = $("vb-promo-input"); if (pin) pin.value = "";
      const pmsg = $("vb-promo-msg"); if (pmsg) { pmsg.hidden = true; pmsg.className = "vb-promo-msg"; }
      const pcreate = $("vb-pw-create"); if (pcreate) pcreate.hidden = false;
      const psignin = $("vb-pw-signin"); if (psignin) psignin.hidden = true;
      const snote = $("vb-signin-note"); if (snote) snote.hidden = true;
      panel.setAttribute("aria-hidden", "false"); panel.classList.add("is-open");
      document.documentElement.style.overflow = "hidden";
      if (stage) stage.scrollTop = 0;
      renderCalendar(); fetchConfig().then(renderCalendar);

      if (serviceKey === "choose") { svc = null; eyebrow.textContent = "TMKE — Booking"; renderServices(); showStepRaw("service"); return; }
      svc = SERVICES[serviceKey];
      if (!svc) return;
      eyebrow.textContent = `TMKE — ${svc.name}`;
      if (svc.key === "discovery") { flow = "discovery"; duration = 30; renderInterests(); showStepRaw("interests"); return; }
      showStepRaw("email");
    }

    // Service chooser (the generic "Book a Shoot" entry).
    function renderServices() {
      const wrap = $("vb-services"); if (!wrap) return;
      const subs = { "content-studio": "Studio sessions", "property": "Property packages", "agent": "Agent / location shoots" };
      wrap.innerHTML = ["content-studio", "property", "agent"].map((k) => {
        const s = SERVICES[k];
        return `<button type="button" class="dc-choice" data-svc="${k}"><span class="dc-choice-name" style="font-size:16px">${s.name}</span><span class="dc-choice-meta">${subs[k]}</span></button>`;
      }).join("");
      wrap.querySelectorAll("[data-svc]").forEach((b) => b.addEventListener("click", () => {
        svc = SERVICES[b.dataset.svc]; eyebrow.textContent = `TMKE — ${svc.name}`; goTo("email");
      }));
    }

    // Discovery interests (multi-select).
    function renderInterests() {
      const wrap = $("vb-interests"); if (!wrap || !svc.interests) return;
      selectedInterests = [];
      wrap.innerHTML = svc.interests.map((it, i) => `<button type="button" class="dc-choice" data-int="${i}"><span class="dc-choice-check">✓</span><span class="dc-choice-name" style="font-size:16px">${it.name}</span></button>`).join("");
      wrap.querySelectorAll("[data-int]").forEach((b) => b.addEventListener("click", () => {
        b.classList.toggle("is-active"); const name = svc.interests[+b.dataset.int].name;
        if (b.classList.contains("is-active")) selectedInterests.push(name); else selectedInterests = selectedInterests.filter((x) => x !== name);
      }));
    }
    $("vb-interests-next")?.addEventListener("click", () => { duration = 30; goTo("day"); });
    function close() {
      panel.setAttribute("aria-hidden", "true"); panel.classList.remove("is-open");
      document.documentElement.style.overflow = "";
    }
    function resetCta(btn, label) { if (!btn) return; btn.disabled = false; btn.classList.remove("is-loading"); btn.innerHTML = label + ' <em>&rarr;</em>'; }
    function loadingCta(btn, label) { if (!btn) return; btn.disabled = true; btn.classList.add("is-loading"); btn.innerHTML = '<span class="dc-spinner"></span> ' + label; }

    // Build the per-service agreement (Content Studio / Property / Agent). A
    // clause's `p` may be a string or an array of paragraphs (e.g. Property's
    // on-the-day clause carries a second drone paragraph).
    function renderTerms() {
      const box = $("vb-terms"); if (!box) return;
      const t = termsForService(svc && svc.key);
      const clauses = t.clauses.map((c, i) => {
        const paras = Array.isArray(c.p) ? c.p : [c.p];
        return `<h5>${i + 1}. ${c.h}</h5>` + paras.map((p) => `<p>${p}</p>`).join("");
      }).join("");
      box.innerHTML = `<h4>${t.title}</h4><p class="dc-terms-note">${TERMS_NOTE}</p>${clauses}`;
      box.scrollTop = 0;
      const agree = $("vb-agree");
      if (agree) {
        const short = box.scrollHeight <= box.clientHeight + 4;
        agree.disabled = !short;
        box.classList.toggle("is-read", short);
      }
      if (typeof refreshTerms === "function") refreshTerms();
    }

    // Day-step subheading, tailored to the service (or the discovery call).
    function setDaySub() {
      const sub = $("vb-day-sub"); if (!sub) return;
      if (flow === "discovery") { sub.textContent = "Pick a date that suits you for your call. Available times are based on Jack's current diary."; return; }
      const noun = svc && svc.key === "content-studio" ? "session" : svc && svc.key === "property" ? "property shoot" : "shoot";
      sub.textContent = `Select the date you'd like your ${noun} to take place. Available dates are based on Jack's current diary.`;
    }

    // Ask the Worker whether this email already has a TMKE account. Best-effort:
    // on any failure we assume "new" so the booking can still create an account.
    async function checkAccountExists(email) {
      if (!WORKER) return false;
      try {
        const res = await fetch(`${WORKER}/videography/account-exists?email=${encodeURIComponent(email)}`);
        if (!res.ok) return false;
        const d = await res.json();
        return !!(d && d.exists);
      } catch (_) { return false; }
    }

    // ---- 1. email gate + routing ----
    $("vb-email-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = String(new FormData(e.target).get("email") || "").trim();
      const err = $("vb-email-error"); err.hidden = true;
      if (!email) { err.textContent = "Please enter your work email."; err.hidden = false; return; }
      gateEmail = email;
      audience = audienceForEmail(email);
      if (audience.audience !== "member") {
        if (svc.membersOnly) {
          // Members-only service (Content Studio) → register interest.
          $("vb-register-form").querySelector('[name="email"]').value = email;
          goTo("register"); return;
        }
        // Non-member on Property / Agent → enquiry (Jack quotes manually).
        $("vb-enquiry-form").querySelector('[name="email"]').value = email;
        goTo("enquiry"); return;
      }
      // Member → check for an existing account (so the details step asks them to
      // sign in rather than create a duplicate), then show options.
      const cta = $("vb-email-cta"); loadingCta(cta, "Checking…");
      existingAccount = await checkAccountExists(email);
      resetCta(cta, "Continue");
      renderOptions();
      goTo("options");
    });

    // ---- 2b. enquiry (non-member, Property / Agent) ----
    $("vb-enquiry-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const err = $("vb-enquiry-error"); err.hidden = true;
      const email = String(fd.get("email") || gateEmail || "").trim();
      const btn = $("vb-enquiry-cta"); loadingCta(btn, "Sending…");
      try {
        if (!WORKER) throw new Error("This isn't quite live yet — please email jack@tmke.co.uk and we'll sort it.");
        const res = await fetch(`${WORKER}/videography/enquiry`, {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            service: svc.name, service_type: svc.key, name: fd.get("name"), email,
            phone: fd.get("phone"), company: fd.get("company"), postcode: fd.get("postcode"), message: fd.get("message"),
            marketing_opt_in: !!fd.get("optin"),
          }),
        });
        const data = await res.json().catch(() => ({})); if (!res.ok) throw new Error(data.error || "Couldn't send your enquiry");
        $("vb-success-title").textContent = "Thanks — enquiry received";
        $("vb-success-msg").textContent = `Jack will be in touch shortly about your ${svc.name.toLowerCase()} enquiry. We've sent a confirmation to ${email}.`;
        history = []; goTo("success"); history = []; backBtn.hidden = true;
        resetCta(btn, "Send enquiry");
      } catch (e2) {
        resetCta(btn, "Send enquiry");
        err.textContent = (e2 && e2.message) || "Sorry, that didn't send — please try again."; err.hidden = false;
      }
    });

    // ---- 2. register interest (members-only, non-member) ----
    $("vb-register-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const email = String(fd.get("email") || "").trim();
      const err = $("vb-register-error"); err.hidden = true;
      const btn = $("vb-register-cta");
      loadingCta(btn, "Registering…");
      try {
        if (WORKER) {
          await fetch(`${WORKER}/videography/register-interest`, {
            method: "POST", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ email, service: svc.key, marketing_opt_in: !!fd.get("optin") }),
          }).catch(() => {});
        }
        await sleep(700);
        $("vb-success-title").textContent = "Thanks — we'll be in touch";
        $("vb-success-msg").textContent = `We've noted your interest in the ${svc.name}. We'll email you the moment access opens up.`;
        history = []; goTo("success"); history = []; backBtn.hidden = true;
        resetCta(btn, "Register interest");
      } catch (_) { resetCta(btn, "Register interest"); err.textContent = "Sorry, that didn't go through — please try again."; err.hidden = false; }
    });

    // ---- 3. options (Content Studio sessions / Property + Agent: one included
    // package + optional add-ons) ----
    function renderOptions() {
      const wrap = $("vb-options"), actions = $("vb-options-actions"), sub = $("vb-options-sub");
      selectedAddOns = []; selectedPackages = []; chosen = null;

      if (svc.key === "content-studio") {
        $("vb-options-title").textContent = "Choose your session";
        if (sub) sub.textContent = "All prices are plus VAT.";
        actions.hidden = true;
        wrap.innerHTML = `<div class="dc-choices">` + svc.sessions.map((s, i) => `
          <button type="button" class="dc-choice" data-i="${i}">
            <span class="dc-choice-name">${s.name}</span>
            <span class="dc-choice-output">${s.output}</span>
            <span class="dc-choice-meta">${s.desc}</span>
            <span class="dc-choice-price">${gbp(s.price_pence)} +VAT</span>
          </button>`).join("") + `</div>`;
        wrap.querySelectorAll(".dc-choice").forEach((b) => b.addEventListener("click", () => {
          chosen = svc.sessions[+b.dataset.i];
          duration = SESSION_MINUTES[chosen.key] || 90;
          goTo("day");
        }));
        return;
      }

      // Property and Agent share one layout: a single included package shown as a
      // fixed card, then optional add-ons that update the running total. For
      // Property the package is set by membership tier; for Agent it's the Launch
      // Package (always included) with Lifestyle Portraits + B-Roll as add-ons.
      if (svc.key === "property" || svc.key === "agent") {
        $("vb-options-title").textContent = "Choose Your Package";
        if (sub) sub.textContent = "Here's what's included in your package. Select any add-ons you'd like to include and your total will update automatically.";

        let incl, addOnList, priceLabel;
        if (svc.key === "property") {
          const tier = propertyTierForBrand(audience && audience.brand) || "gold";
          chosen = svc.packagesByTier[tier];
          duration = 240; // property shoot block (interim — refined in scheduling phase)
          incl = chosen.inclusions.map((x) => "· " + x).join("<br>");
          addOnList = svc.addOns;
          priceLabel = `from ${gbp(chosen.from_pence)} +VAT`;
        } else {
          chosen = svc.packages.find((p) => p.key === "launch") || svc.packages[0];
          duration = 120;
          incl = "· " + chosen.desc;
          addOnList = svc.packages.filter((p) => p.key !== chosen.key);
          priceLabel = `${gbp(chosen.price_pence)} +VAT`;
        }
        const pkg = `<div class="dc-choice" style="cursor:default">
          <span class="dc-choice-name">${chosen.name}</span>
          <span class="dc-choice-price">${priceLabel}</span>
          <span class="dc-choice-incl">${incl}</span></div>`;
        const addons = addOnList.length ? `<p class="dc-step-sub" style="margin:22px 0 10px">Optional add-ons</p><div class="dc-choices dc-choices--multi">` +
          addOnList.map((a, i) => `<button type="button" class="dc-choice" data-addon="${i}">
            <span class="dc-choice-check">✓</span>
            <span style="display:flex;flex-direction:column;gap:3px">
              <span class="dc-choice-name" style="font-size:15px">${a.name}</span>
              <span class="dc-choice-meta">${gbp(a.price_pence)}${a.perImage ? " / image" : ""} +VAT</span></span>
          </button>`).join("") + `</div>` : "";
        wrap.innerHTML = pkg + addons + `<div class="vb-running" id="vb-running"></div>`;
        wrap.querySelectorAll("[data-addon]").forEach((b) => b.addEventListener("click", () => {
          b.classList.toggle("is-active");
          const a = addOnList[+b.dataset.addon];
          if (b.classList.contains("is-active")) selectedAddOns.push(a);
          else selectedAddOns = selectedAddOns.filter((x) => x.key !== a.key);
          renderRunning();
        }));
        renderRunning(); actions.hidden = false;
        return;
      }
    }

    function optionsBasePence() {
      if (svc && svc.key === "property") return chosen ? chosen.from_pence : 0;
      return chosen ? chosen.price_pence : 0; // content-studio session + agent Launch
    }
    function addOnsPence() { return selectedAddOns.reduce((s, a) => s + a.price_pence, 0); }
    function renderRunning() {
      const el = $("vb-running"); if (!el) return;
      el.innerHTML = `<span>Running total — ex VAT, before travel</span><strong>${gbp(optionsBasePence() + addOnsPence())}</strong>`;
    }

    // Property/Agent: Continue → postcode (surcharge) → day. (Content Studio jumps
    // straight to day from its session card above.) The Launch Package is always
    // included for Agent, so there's no minimum-selection gate any more.
    $("vb-options-next")?.addEventListener("click", () => {
      if (svc.key === "agent") duration = 120 + selectedAddOns.length * 30;
      $("vb-surcharge-note").hidden = true;
      // Per-service copy for the postcode step.
      const pcTitle = $("vb-postcode-title"), pcSub = $("vb-postcode-sub");
      if (svc.key === "agent") {
        if (pcTitle) pcTitle.textContent = "Shoot location";
        if (pcSub) pcSub.textContent = "Enter your postcode so we can calculate any travel costs before you confirm your booking.";
      } else {
        if (pcTitle) pcTitle.textContent = "Property Location";
        if (pcSub) pcSub.textContent = "Enter the property postcode so we can calculate any travel costs before you confirm your booking.";
      }
      if (svc.surcharge) { resetPostcode(); goTo("postcode"); } else { setDaySub(); goTo("day"); }
    });

    // ---- 3b. postcode + travel surcharge ----
    function haversineMiles(la1, lo1, la2, lo2) {
      const R = 3958.8, rad = (x) => (x * Math.PI) / 180;
      const dLa = rad(la2 - la1), dLo = rad(lo2 - lo1);
      const a = Math.sin(dLa / 2) ** 2 + Math.cos(rad(la1)) * Math.cos(rad(la2)) * Math.sin(dLo / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(a));
    }
    async function lookupDistance(pc) {
      // 1) Worker's Google Distance Matrix endpoint = accurate driving distance.
      if (WORKER) {
        try {
          const res = await fetch(`${WORKER}/videography/distance?to=${encodeURIComponent(pc)}`);
          if (res.ok) { const d = await res.json(); if (d && typeof d.miles === "number") return { ok: true, miles: d.miles, surcharge_pence: d.surcharge_pence, source: d.source || "drive" }; }
        } catch (_) {}
      }
      // 2) Fallback — straight-line estimate via postcodes.io (free, no key).
      try {
        const base = SURCHARGE_DEFAULTS.base_postcode.replace(/\s+/g, "");
        const [b, t] = await Promise.all([
          fetch("https://api.postcodes.io/postcodes/" + encodeURIComponent(base)).then((r) => r.json()),
          fetch("https://api.postcodes.io/postcodes/" + encodeURIComponent(pc.replace(/\s+/g, ""))).then((r) => r.json()),
        ]);
        if (!b.result || !t.result) return { ok: false, error: "We couldn't find that postcode — please check and try again." };
        const miles = haversineMiles(b.result.latitude, b.result.longitude, t.result.latitude, t.result.longitude);
        return { ok: true, miles, surcharge_pence: surchargePence(miles), source: "estimate" };
      } catch (_) { return { ok: false, error: "We couldn't check the distance just now — please try again." }; }
    }
    // Reset the postcode step so it asks to "Check distance" again. Called when
    // entering the step (and when the postcode is edited) so the result is always
    // recalculated for the address actually shown.
    let pcResolvedFor = "";
    function resetPostcode() {
      pcResolvedFor = ""; distanceMiles = null; surchargeP = 0;
      const note = $("vb-surcharge-note"); if (note) note.hidden = true;
      resetCta($("vb-postcode-cta"), "Check distance");
    }
    // Editing the postcode invalidates a previous result.
    $("vb-postcode-form")?.querySelector('[name="postcode"]')?.addEventListener("input", () => {
      if (pcResolvedFor) resetPostcode();
    });
    // First submit = calculate + show the result. The user reviews the surcharge,
    // THEN clicks Continue (now the same button) to proceed — we never auto-scroll
    // or auto-advance, so they can read the cost before moving on.
    $("vb-postcode-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      postcode = String(new FormData(e.target).get("postcode") || "").trim().toUpperCase();
      const err = $("vb-postcode-error"), note = $("vb-surcharge-note"); err.hidden = true;
      if (!postcode) { err.textContent = "Please enter the postcode."; err.hidden = false; return; }
      // Already calculated for this exact postcode → this press means "Continue".
      if (pcResolvedFor && pcResolvedFor === postcode) { setDaySub(); goTo("day"); return; }
      const btn = $("vb-postcode-cta"); loadingCta(btn, "Checking distance…");
      const r = await lookupDistance(postcode);
      if (!r.ok) { resetCta(btn, "Check distance"); err.textContent = r.error; err.hidden = false; return; }
      distanceMiles = r.miles; surchargeP = (r.surcharge_pence != null) ? r.surcharge_pence : surchargePence(r.miles);
      const approx = r.source === "estimate" ? "approx " : "";
      note.hidden = false;
      note.innerHTML = surchargeP > 0
        ? `This property is ${approx}<strong>${Math.round(r.miles)} miles</strong> from TMKE's studio. A travel surcharge of <strong>${gbp(surchargeP)} +VAT</strong> applies.`
        : `This property is ${approx}<strong>${Math.round(r.miles)} miles</strong> from TMKE's studio — <strong>within the free 40-mile radius</strong>, so there's no travel charge.`;
      pcResolvedFor = postcode;
      resetCta(btn, "Continue");   // a second press now proceeds (no auto-advance)
    });

    // ---- 4. calendar ----
    const sameDay = (a, b) => a && b && a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();
    function renderCalendar() {
      const calLabel = $("vb-cal-label"), calGrid = $("vb-cal-grid"); if (!calGrid) return;
      calLabel.textContent = `${MONTHS[viewMonth.getMonth()]} ${viewMonth.getFullYear()}`;
      const first = new Date(viewMonth), off = (first.getDay() + 6) % 7;
      const gs = new Date(first); gs.setDate(first.getDate() - off);
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const cells = [];
      for (let i = 0; i < 42; i++) {
        const d = new Date(gs); d.setDate(gs.getDate() + i);
        const inM = d.getMonth() === viewMonth.getMonth(), past = d < today;
        const closed = availWeekdays ? !availWeekdays.has(d.getDay()) : (d.getDay() === 0 || d.getDay() === 6);
        const cl = ["dc-cal-day"]; if (!inM) cl.push("is-other-month"); if (sameDay(d, today)) cl.push("is-today"); if (sameDay(d, selectedDate)) cl.push("is-active");
        cells.push(`<button type="button" class="${cl.join(" ")}" data-date="${localISO(d)}" ${past || closed ? "disabled" : ""}>${d.getDate()}</button>`);
      }
      calGrid.innerHTML = cells.join("");
    }
    $("vb-prev-month")?.addEventListener("click", () => { viewMonth.setMonth(viewMonth.getMonth() - 1); renderCalendar(); });
    $("vb-next-month")?.addEventListener("click", () => { viewMonth.setMonth(viewMonth.getMonth() + 1); renderCalendar(); });
    $("vb-cal-grid")?.addEventListener("click", (e) => {
      const btn = e.target.closest(".dc-cal-day"); if (!btn || btn.hasAttribute("disabled")) return;
      selectedDate = new Date(btn.dataset.date + "T12:00:00"); selectedSlot = null; renderCalendar(); goTo("time");
    });

    // ---- 5. time slots ----
    async function renderSlots() {
      const grid = $("vb-slots-grid"), sub = $("vb-time-sub"); if (!selectedDate) return;
      const dt = selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
      sub.textContent = `${svc.name} · ${dt}`;
      if (!WORKER) { grid.innerHTML = `<p class="dc-slots-empty">Booking is being set up — please check back shortly.</p>`; return; }
      grid.innerHTML = `<p class="dc-slots-empty">Finding times…</p>`;
      try {
        const res = await fetch(`${WORKER}/ms/availability?date=${localISO(selectedDate)}&duration=${duration}`);
        const data = await res.json(); if (!res.ok) throw new Error(data.error || "error");
        if (!data.slots || !data.slots.length) { grid.innerHTML = `<p class="dc-slots-empty">No times available that day — go back and try another.</p>`; return; }
        grid.innerHTML = data.slots.map((s) => `<button type="button" class="dc-slot" data-slot="${s}">${s}</button>`).join("");
      } catch (_) { grid.innerHTML = `<p class="dc-slots-empty">Couldn't load times. Please try again.</p>`; }
    }
    $("vb-slots-grid")?.addEventListener("click", (e) => {
      const btn = e.target.closest(".dc-slot"); if (!btn) return;
      selectedSlot = btn.dataset.slot;
      if (flow === "discovery") { renderCallSummary(); resetCallStage(); goTo("call-details"); }
      else { renderSummary(); goTo("summary"); }
    });
    function renderCallSummary() {
      const dt = selectedDate ? selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" }) : "";
      $("vb-call-summary").textContent = `Discovery call — ${dt} at ${selectedSlot} (about 30 minutes).`;
    }
    // ---- 7b. discovery call → account step → confirm (matches the SMM Book a
    //      Call: signed in books instantly · existing account signs in · new
    //      customers create a password). ----
    const PW_OK = (p) => /^(?=.*\d)(?=.*[^A-Za-z0-9]).{8,}$/.test(p);
    function resetCallStage() {
      const fields = $("vb-call-fields"), acct = $("vb-call-acct"), btn = $("vb-call-cta"), form = $("vb-call-form");
      if (!fields || !acct || !btn || !form) return;
      fields.hidden = false; acct.hidden = true;
      form.dataset.acctMode = "";
      btn.dataset.stage = "details";
      resetCta(btn, "Continue");
      const err = $("vb-call-error"); if (err) err.hidden = true;
    }
    $("vbc-back")?.addEventListener("click", resetCallStage);

    $("vb-call-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const form = e.target;
      const fd = new FormData(form);
      const err = $("vb-call-error"); err.hidden = true;
      const btn = $("vb-call-cta");
      const email = String(fd.get("email") || "").trim().toLowerCase();

      // Stage 1 — validate the details, then decide the account treatment.
      if ((btn.dataset.stage || "details") === "details") {
        if (!String(fd.get("name") || "").trim() || !/.+@.+\..+/.test(email) || !String(fd.get("phone") || "").trim()) {
          err.textContent = "Please add your name, a valid email, and a phone number."; err.hidden = false; return;
        }
        loadingCta(btn, "Checking…");
        let mode = "create";
        if (sessionEmail && sessionEmail === email) mode = "signedin";
        else if (await checkAccountExists(email)) mode = "signin";
        form.dataset.acctMode = mode;
        if (mode === "signedin") {
          // Continue IS the booking — straight through on the session token.
          btn.dataset.stage = "send";
          return bookCall(form, fd, btn, null);
        }
        $("vb-call-fields").hidden = true;
        $("vb-call-acct").hidden = false;
        $("vbc-signin").hidden = mode !== "signin";
        $("vbc-create").hidden = mode !== "create";
        btn.dataset.stage = "send";
        resetCta(btn, mode === "signin" ? "Sign in & book" : "Book the call");
        return;
      }

      // Stage 2 — sign in or create, then book.
      const mode = form.dataset.acctMode || "create";
      let pw = null;
      if (mode === "signin") {
        const sp = String(fd.get("signin_password") || "");
        if (!sp) { err.textContent = "Please enter your password."; err.hidden = false; return; }
        loadingCta(btn, "Signing in…");
        try {
          const m = await import("../lib/supabase.js");
          const { data: si, error: siErr } = await m.supabase.auth.signInWithPassword({ email, password: sp });
          if (siErr || !si || !si.session) { resetCta(btn, "Sign in & book"); err.textContent = "That password didn't match — please try again, or reset it via the link above."; err.hidden = false; return; }
          sessionEmail = email; sessionToken = si.session.access_token;
        } catch (_) { resetCta(btn, "Sign in & book"); err.textContent = "Couldn't sign you in just now — please try again."; err.hidden = false; return; }
      } else {
        pw = String(fd.get("password") || ""); const pw2 = String(fd.get("password2") || "");
        if (!PW_OK(pw)) { err.textContent = "Password must be at least 8 characters and include a number and a special character."; err.hidden = false; return; }
        if (pw !== pw2) { err.textContent = "Passwords don't match."; err.hidden = false; return; }
      }
      bookCall(form, fd, btn, pw);
    });

    async function bookCall(form, fd, btn, pw) {
      const err = $("vb-call-error");
      loadingCta(btn, "Booking…");
      const t0 = Date.now();
      const email = String(fd.get("email") || "").trim();
      try {
        if (!WORKER) throw new Error("Booking is being set up — please check back shortly.");
        const headers = { "Content-Type": "application/json" };
        if (sessionToken) headers.Authorization = "Bearer " + sessionToken;
        const res = await fetch(`${WORKER}/videography/discovery`, {
          method: "POST", headers,
          body: JSON.stringify({
            date: localISO(selectedDate), start: selectedSlot, duration: 30, interests: selectedInterests,
            name: fd.get("name"), email, phone: fd.get("phone"), company: fd.get("company"), message: fd.get("message"),
            password: pw || undefined, marketing_opt_in: !!fd.get("optin"),
          }),
        });
        const data = await res.json().catch(() => ({})); if (!res.ok) throw new Error(data.error || "Booking failed");
        // Best-effort: sign a brand-new account in so the portal works immediately.
        if (pw && data.account_created) { try { const m = await import("../lib/supabase.js"); if (m && m.isConfigured && m.supabase) await m.supabase.auth.signInWithPassword({ email, password: pw }); } catch (_) {} }
        const wait = 1100 - (Date.now() - t0); if (wait > 0) await sleep(wait);
        const dt = selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
        $("vb-success-title").textContent = "Call booked";
        $("vb-success-msg").textContent = `Your discovery call with Jack is set for ${dt} at ${selectedSlot}. A calendar invite is on its way.`;
        history = []; goTo("success"); history = []; backBtn.hidden = true;
        resetCallStage();
      } catch (e2) {
        resetCta(btn, (form.dataset.acctMode === "signin") ? "Sign in & book" : (btn.dataset.stage === "send" && form.dataset.acctMode === "create") ? "Book the call" : "Continue");
        err.textContent = (e2 && e2.message) || "Sorry, that didn't go through — please try another time."; err.hidden = false;
      }
    }

    // ---- 6. summary ----
    function bookingLabel() {
      // Agent's Launch Package is the included base; add-ons are listed separately.
      return chosen ? chosen.name : "—";
    }
    function preDiscountPence() { return optionsBasePence() + addOnsPence() + (surchargeP || 0); }
    function discountPence() { return promo ? Math.min(promo.discount_pence || 0, preDiscountPence()) : 0; }
    function subtotalPence() { return Math.max(0, preDiscountPence() - discountPence()); }
    function renderSummary() {
      // Per-service summary subheading + show the promo box for Property/Agent.
      const ssub = $("vb-summary-sub");
      if (ssub) ssub.textContent = svc.key === "content-studio"
        ? "Review your booking. If everything looks right, sign below to confirm."
        : "Review your booking. If everything looks right, continue to confirm.";
      const promoBox = $("vb-promo");
      if (promoBox) promoBox.hidden = !(svc.key === "property" || svc.key === "agent");

      const baseLabel = svc.key === "content-studio" ? "Session" : "Package";
      const sub = subtotalPence();
      const vat = vatOf(sub);
      const dt = selectedDate ? selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" }) : "—";
      const rows = [
        ["Service", svc.name],
        [baseLabel, bookingLabel()],
        ...(svc.key === "property" && optionsBasePence() ? [["Package price", gbp(optionsBasePence()) + " (from)"]] : []),
        ...selectedAddOns.map((a) => [`Add-on — ${a.name}`, gbp(a.price_pence)]),
        ...(postcode ? [["Shoot postcode", postcode]] : []),
        ...(svc.surcharge ? [["Travel" + (distanceMiles != null ? ` (${Math.round(distanceMiles)} mi)` : ""), surchargeP > 0 ? gbp(surchargeP) : "No charge"]] : []),
        ...(promo && discountPence() ? [[`Promo (${promo.code})`, "− " + gbp(discountPence())]] : []),
        ["Date", dt],
        ["Time", selectedSlot || "—"],
        ["Subtotal (ex VAT)", gbp(sub)],
        ["VAT (20%)", gbp(vat)],
      ];
      $("vb-summary").innerHTML = rows.map(([k, v]) => `<div class="vb-srow"><span>${k}</span><span>${v}</span></div>`).join("") +
        `<div class="vb-srow vb-total"><span>Total</span><span>${gbp(sub + vat)}</span></div>`;
      $("vb-details-summary").textContent = `${svc.name} — ${bookingLabel()}, ${dt} at ${selectedSlot}. ${gbp(withVat(sub))} inc. VAT.`;
    }

    // Promo code (Property / Agent): validate against the admin-managed table via
    // the Worker, then apply the discount to the running quote.
    async function validatePromo(code) {
      if (!WORKER) return { ok: false, error: "Promo codes aren't available right now." };
      try {
        const res = await fetch(`${WORKER}/videography/promo?code=${encodeURIComponent(code)}&service=${encodeURIComponent(svc.key)}`);
        const d = await res.json().catch(() => ({}));
        if (!res.ok || !d.ok) return { ok: false, error: d.error || "That code isn't valid." };
        return { ok: true, kind: d.kind, value: d.value, label: d.label, code: d.code || code };
      } catch (_) { return { ok: false, error: "Couldn't check that code — please try again." }; }
    }
    $("vb-promo-apply")?.addEventListener("click", async () => {
      const input = $("vb-promo-input"), msg = $("vb-promo-msg"), btn = $("vb-promo-apply");
      const code = String(input.value || "").trim().toUpperCase();
      msg.hidden = true; msg.className = "vb-promo-msg";
      if (!code) { promo = null; renderSummary(); return; }
      btn.disabled = true; btn.textContent = "…";
      const r = await validatePromo(code);
      btn.disabled = false; btn.textContent = "Apply";
      if (!r.ok) { promo = null; msg.textContent = r.error; msg.className = "vb-promo-msg is-err"; msg.hidden = false; renderSummary(); return; }
      const pre = preDiscountPence();
      const disc = r.kind === "percent" ? Math.round(pre * (Number(r.value) / 100)) : Number(r.value) || 0;
      promo = { code: r.code, discount_pence: Math.min(disc, pre), kind: r.kind, value: r.value };
      msg.textContent = `Code applied — ${gbp(promo.discount_pence)} off.`; msg.className = "vb-promo-msg is-ok"; msg.hidden = false;
      renderSummary();
    });

    $("vb-summary-next")?.addEventListener("click", () => {
      const sd = $("vb-sign-date"); if (sd && !sd.value) sd.value = localISO(new Date());
      goTo("terms");  // renderTerms() (in showStepRaw) populates + sets the agree state
    });

    // ---- 7. terms ----
    const terms = $("vb-terms"), agree = $("vb-agree"), signName = $("vb-sign-name"), signDate = $("vb-sign-date"), termsCta = $("vb-terms-cta");
    function refreshTerms() { termsCta.disabled = !(agree && !agree.disabled && agree.checked && signName.value.trim() && signDate.value); }
    terms?.addEventListener("scroll", () => { if (terms.scrollTop + terms.clientHeight >= terms.scrollHeight - 8) { agree.disabled = false; terms.classList.add("is-read"); refreshTerms(); } });
    agree?.addEventListener("change", refreshTerms);
    signName?.addEventListener("input", refreshTerms);
    signDate?.addEventListener("input", refreshTerms);
    termsCta?.addEventListener("click", () => {
      if (termsCta.disabled) return;
      const f = $("vb-details-form");
      if (f) f.querySelector('[name="email"]').value = gateEmail;   // pre-fill from the gate
      // Signed in under the gate email → no password at all. Existing account
      // (signed out) → sign in. Brand new → create a password.
      const signedIn = signedInAsGate();
      const create = $("vb-pw-create"), signin = $("vb-pw-signin"), note = $("vb-signin-note"), inNote = $("vb-signedin-note");
      if (create) create.hidden = existingAccount || signedIn;
      if (signin) signin.hidden = !existingAccount || signedIn;
      if (note) note.hidden = !existingAccount || signedIn;
      if (inNote) inNote.hidden = !signedIn;
      const dcta = $("vb-details-cta"); if (dcta) resetCta(dcta, (existingAccount && !signedIn) ? "Sign in & confirm" : "Confirm booking");
      goTo("details");
    });

    // ---- 8. details → confirm ----
    $("vb-details-form")?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      const err = $("vb-details-error"); err.hidden = true;
      const bookEmail0 = gateEmail || String(fd.get("email") || "");
      // Signed in under this email → no password step at all. Existing account
      // → sign in with one password; new account → create + confirm.
      let pw = null;
      if (signedInAsGate()) {
        // nothing to validate — the live session is the proof
      } else if (existingAccount) {
        pw = String(fd.get("signin_password") || "");
        if (!pw) { err.textContent = "Please enter your password to sign in."; err.hidden = false; return; }
        try {
          const m = await import("../lib/supabase.js");
          if (m && m.isConfigured && m.supabase) {
            const { error: signErr } = await m.supabase.auth.signInWithPassword({ email: bookEmail0, password: pw });
            if (signErr) { err.textContent = "That password didn't match — please try again or reset it."; err.hidden = false; return; }
          }
        } catch (_) { err.textContent = "Couldn't sign you in just now — please try again."; err.hidden = false; return; }
      } else {
        pw = String(fd.get("password") || ""); const pw2 = String(fd.get("password2") || "");
        if (pw.length < 8) { err.textContent = "Password must be at least 8 characters."; err.hidden = false; return; }
        if (pw !== pw2) { err.textContent = "Passwords don't match."; err.hidden = false; return; }
      }
      const btn = $("vb-details-cta");
      loadingCta(btn, "Confirming…");
      const t0 = Date.now();
      const sub = subtotalPence();
      const summaryLine = `${svc.name} — ${bookingLabel()}`;
      const notes = [
        summaryLine,
        selectedAddOns.length ? `Add-ons: ${selectedAddOns.map((a) => a.name).join(", ")}` : "",
        postcode ? `Shoot postcode: ${postcode}` : "",
        svc.surcharge ? `Travel: ${distanceMiles != null ? Math.round(distanceMiles) + " mi, " : ""}${surchargeP > 0 ? gbp(surchargeP) + " +VAT" : "no charge"}` : "",
        fd.get("company") ? `Company: ${fd.get("company")}` : "",
        fd.get("phone") ? `Phone: ${fd.get("phone")}` : "",
        fd.get("notes") ? String(fd.get("notes")) : "",
        `Agreement: signed "${signName.value.trim()}" on ${signDate.value}.`,
        promo ? `Promo: ${promo.code} (− ${gbp(discountPence())})` : "",
        fd.get("optin") ? "Marketing opt-in: yes" : "Marketing opt-in: no",
        `Total: ${gbp(withVat(sub))} inc VAT.`,
      ].filter(Boolean).join(" | ");
      const bookEmail = bookEmail0;
      try {
        if (!WORKER) throw new Error("Booking is being set up — please check back shortly.");
        // Books Jack's 365 diary, creates/links the account, writes the full
        // pipeline row, and sends the confirmation (with .ics) + Jack's notice.
        const res = await fetch(`${WORKER}/videography/book`, {
          method: "POST", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            date: localISO(selectedDate), start: selectedSlot, duration,
            service: svc.name, service_type: svc.key,
            audience: audience && audience.audience, brand: (audience && audience.brand) || null,
            package: (chosen && chosen.key) || null,
            package_label: bookingLabel(),
            add_ons: selectedAddOns.map((a) => ({ key: a.key, name: a.name, price_pence: a.price_pence })),
            postcode: postcode || null, distance_miles: distanceMiles, surcharge_pence: surchargeP || 0,
            promo_code: promo ? promo.code : null, discount_pence: discountPence() || 0,
            name: fd.get("name"), email: bookEmail, phone: fd.get("phone"), company: fd.get("company"), notes,
            signed_name: signName.value.trim(), signed_at: signDate.value ? `${signDate.value}T12:00:00` : null,
            marketing_opt_in: !!fd.get("optin"),
            // Existing members sign in client-side above (or are already signed
            // in); only send a password to CREATE an account for new customers.
            account_exists: existingAccount || signedInAsGate(), password: (existingAccount || signedInAsGate()) ? null : pw,
            total_pence: withVat(sub),
          }),
        });
        const data = await res.json().catch(() => ({})); if (!res.ok) throw new Error(data.error || "Booking failed");
        // Best-effort: sign a brand-new account in so the portal works immediately.
        if (!existingAccount && !signedInAsGate() && pw) { try { const m = await import("../lib/supabase.js"); if (m && m.isConfigured && m.supabase) await m.supabase.auth.signInWithPassword({ email: bookEmail, password: pw }); } catch (_) {} }
        const wait = 1100 - (Date.now() - t0); if (wait > 0) await sleep(wait);
        const dt = selectedDate.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
        $("vb-success-title").textContent = "Booking confirmed";
        $("vb-success-msg").textContent = `We've booked ${svc.name} for ${dt} at ${selectedSlot}, and set up your account so you can manage it any time. A confirmation email with a calendar invite is on its way.`;
        history = []; goTo("success"); history = []; backBtn.hidden = true;
        resetCta(btn, "Confirm booking");
      } catch (e2) {
        resetCta(btn, "Confirm booking");
        err.textContent = (e2 && e2.message) || "Sorry, that didn't go through — please try another time."; err.hidden = false;
      }
    });

    // ---- openers / close ----
    document.addEventListener("click", (e) => { if (e.target.closest("[data-vb-close]")) close(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && panel.classList.contains("is-open")) close(); });
    document.addEventListener("click", (e) => {
      const o = e.target.closest?.("[data-vbook]"); if (!o) return; e.preventDefault();
      open(o.getAttribute("data-vbook"));
    });
    window.tmkeVideographyBook = open;
  })();
</script>
