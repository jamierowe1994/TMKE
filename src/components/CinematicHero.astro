---
// Full-screen cinematic hero for the Social Media page. A slow, exaggerated
// intro (load → lists fill → 3 team portraits → lists clear → collapse to the
// middle portrait → flip to brand colour) settles into an interactive resting
// state: a wide fanned trio of photos, flanking copy aligned to the fan line,
// and an INFINITE template scroller (with a measuring ruler) along the bottom.
// Switching templates scrolls the names like a counter and changes the photos —
// the centre scrolls down, the sides push out from behind.
// Placeholders: R2 brand stills + Unsplash. Real team shots + a centre video
// (assets.tmke.co.uk/social-belgrave.mp4) drop straight in.
const R2 = (n) => `https://assets.tmke.co.uk/${n}.webp`;
const U = (id, w = 900, h = 900) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=${w}&h=${h}&q=80`;
const UP = (id) => U(id, 640, 880); // portrait

const PROJECTS = ["Belgrave Launch","Riverside Reveal","The Parade","Wold House","Harbour & Co","Crescent Lettings","Northgate","Lume Property","Atelier Homes","Maven Estates","Stari Living","Glasshouse","Marlow Quarter","Aven."];
const DIRECTORS = ["Jack Ellis","Zoe Donahue","Sean Thomas","Bergh // Moder","Jason Bergh","Marlow // Bergh","Joe Bressler","Harper // Dealy","Pol Kurucz","Nabil","Daniella Midenge","Clennon // Lamar","Bergh // Porat","Marlow // Bergh"];
const LOCATIONS = ["London, UK","Prime Central London","Manchester, UK","Cotswolds Estate","Notting Hill, London","Riverside, Henley","Knightsbridge, London","Cheshire, UK","Mayfair, London","Surrey Hills","On location — Bath","Edinburgh, UK","Sandbanks, Poole","Belgravia, London"];

// Three portrait team photos shown during the intro — the real About Us shots.
const TEAM = [
  { name: "Samantha", src: "https://assets.tmke.co.uk/TMKE%20About%20Us/Samantha%20-%20About%20Us.png" },
  { name: "Danielle", src: "https://assets.tmke.co.uk/TMKE%20About%20Us/Danni%20-%20About%20Us.png" },
  { name: "Abbie",    src: "https://assets.tmke.co.uk/TMKE%20About%20Us/Abbie%20-%20About%20Us.png" },
];

// Each template: 3 photos. First centre is a video.
const TEMPLATES = [
  { name: "Belgrave",     left: R2("kitchen-1"), centre: R2("living-1"), right: R2("white-1"), video: "https://assets.tmke.co.uk/social-belgrave.mp4" },
  { name: "Riverside",    left: R2("orange-1"),  centre: R2("table"),    right: R2("living-2") },
  { name: "The Parade",   left: R2("kitchen-2"), centre: R2("white-2"),  right: R2("orange-2") },
  { name: "Wold House",   left: U("1570129477492-45c003edd2be",1000,1200), centre: U("1600585154340-be6161a56a0c",1000,1200), right: U("1568605114967-8130f3a36994",1000,1200) },
  { name: "Harbour & Co", left: U("1484154218962-a197022b5858",1000,1200), centre: U("1493809842364-78817add7ffb",1000,1200), right: U("1600607687939-ce8a6c25118c",1000,1200) },
  { name: "Crescent",     left: U("1505693416388-ac5ce068fe85",1000,1200), centre: R2("vibes"), right: U("1586023492125-27b2c045efd7",1000,1200) },
];
const t0 = TEMPLATES[0];

// Cards for the rotating 3D ring — every template image becomes a card so the
// ring reads dense (like the reference). Each links back into /edit.
const CARDS = TEMPLATES.flatMap((t) => [
  { src: t.left, name: t.name },
  { src: t.centre, name: t.name },
  { src: t.right, name: t.name },
]);
const pad2 = (n) => String(n).padStart(2, "0");
---

<section class="sh" id="sh" aria-label="TMKE social media">
  <div class="sh-bg"></div>

  <!-- ============ INTRO ============ -->
  <div class="sh-intro" id="sh-intro">
    <div class="sh-load" id="sh-load">TMKE</div>

    <div class="sh-lists sh-lists--left">
      <div class="sh-row sh-row--head" style="--i:0">Project</div>
      {PROJECTS.map((p, i) => (
        <div class="sh-row" style={`--i:${i + 1}`}>{p}</div>
      ))}
    </div>

    <div class="sh-lists sh-lists--right">
      <div class="sh-row sh-row--head" style="--i:0">Director // Editor</div>
      {DIRECTORS.map((d, i) => (
        <div class="sh-row" style={`--i:${i + 1}`}>{d}</div>
      ))}
    </div>

    <!-- three portrait team photos -->
    <div class="sh-team" id="sh-team">
      {TEAM.map((m, i) => (
        <figure class={`sh-portrait${i === 1 ? " is-centre" : ""}`} style={`--i:${i};background-image:url('${m.src}')`}>
          <figcaption>{m.name}</figcaption>
        </figure>
      ))}
    </div>
  </div>

  <!-- ============ RESTING: rotating 3D card ring ============ -->
  <div class="cr" id="cr">
    <div class="cr-viewport" id="cr-viewport">
      <div class="cr-world" id="cr-world">
        <div class="cr-ring" id="cr-ring">
          {CARDS.map((c, i) => (
            <a class="cr-card" href="/edit" draggable={false} aria-label={c.name} style={`--i:${i};background-image:url('${c.src}')`}>
              <span class="cr-name">{c.name}</span>
            </a>
          ))}
        </div>
        <!-- title lives INSIDE the 3D scene at the ring's centre so the front
             cards occlude it and it shows through the gaps; pops out at the end -->
        <h2 class="cr-mid" id="cr-mid" aria-hidden="true">
          <span>Selected and</span><span>popular posts</span><span>on social media</span>
        </h2>
      </div>
    </div>

    <!-- the readable corner label it settles into -->
    <h2 class="cr-title" id="cr-title">
      <span>Selected and</span><span>popular posts</span><span>on social media</span>
    </h2>

    <div class="cr-controls" id="cr-controls">
      <button type="button" class="cr-arrow" id="cr-prev" aria-label="Previous">&#9664;</button>
      <button type="button" class="cr-arrow" id="cr-next" aria-label="Next">&#9654;</button>
    </div>
  </div>
</section>

<script is:inline define:vars={{ TEMPLATES }}>
  (function () {
    const sh = document.getElementById("sh");
    if (!sh) return;
    const lock = () => { document.documentElement.style.overflow = "hidden"; document.body.style.overflow = "hidden"; };
    const unlock = () => { document.documentElement.style.overflow = ""; document.body.style.overflow = ""; };

    // ---- intro timeline — plays ONCE per browser session ----
    // First visit gets the full cinematic intro; once it's been seen we skip
    // straight to the resting "Strategic thinkers / Smart strategy" state on
    // every later load (no TMKE loader, no team portraits). The flag lives in
    // sessionStorage, so closing the browser and returning replays the intro.
    const SEEN_KEY = "tmke.editIntroSeen";
    let introSeen = false;
    try { introSeen = sessionStorage.getItem(SEEN_KEY) === "1"; } catch (_) {}

    const restEls = [".cr-mid", ".cr-ring", ".cr-controls"];

    if (introSeen) {
      // Land directly on the resting state — fast, no intro, nav not locked.
      sh.classList.add("sh-instant", "s-lists", "s-clear", "s-collapse", "s-brand", "s-done");
      document.body.classList.remove("sh-lock");
      restEls.forEach((sel) => { const el = sh.querySelector(sel); if (el) el.classList.add("is-in"); });
    } else {
      try { sessionStorage.setItem(SEEN_KEY, "1"); } catch (_) {}
      lock(); document.body.classList.add("sh-lock");
      setTimeout(() => sh.classList.add("s-lists"), 900);
      setTimeout(() => sh.classList.add("s-clear"), 4400);
      setTimeout(() => sh.classList.add("s-collapse"), 5400);
      setTimeout(() => { sh.classList.add("s-brand"); document.body.classList.remove("sh-lock"); }, 6100); // nav drops in
      // gradual build of the resting state: centre → sides → copy → scroller
      const reveal = (sel, t) => setTimeout(() => { const el = sh.querySelector(sel); if (el) el.classList.add("is-in"); }, t);
      reveal(".cr-mid", 6500);
      reveal(".cr-ring", 6950);
      reveal(".cr-controls", 7800);
      setTimeout(() => { sh.classList.add("s-done"); unlock(); }, 8500);
      setTimeout(unlock, 10500); // safety
    }

    // ---- 3D rotating card ring ----
    const ring = document.getElementById("cr-ring");
    const world = document.getElementById("cr-world");
    const mid = document.getElementById("cr-mid");
    const crEl = document.getElementById("cr");
    const vp = document.getElementById("cr-viewport");
    const cards = ring ? Array.from(ring.children) : [];
    const N = cards.length || 1;
    const STEP = 360 / N;                 // degrees between cards
    ring.style.setProperty("--step", STEP + "deg");

    let radius = 600;
    function calcRadius() {
      const w = cards[0] ? cards[0].offsetWidth : 220;
      // radius of a regular N-gon whose facets are `w` wide, padded for air
      radius = Math.round((w / 2) / Math.tan(Math.PI / N) * 1.18);
      ring.style.setProperty("--radius", radius + "px");
      if (mid) mid.style.setProperty("--mid-z", -radius + "px"); // sit at ring centre
    }

    let rot = 0;            // live rotation (deg) — front card sits at angle 0
    let target = 0;         // snap target after a gesture
    let spinPaused = false;
    let dragging = null;

    // entrance: cards swing up into formation + ring spins to a stop.
    const ENTER_MS = 1650;
    let enterT0 = null;     // set the first frame the ring is revealed
    let formed = false;
    const easeOut = (x) => 1 - Math.pow(1 - x, 3);

    function emphasise(effRot) {
      const r = effRot == null ? rot : effRot;
      for (let i = 0; i < cards.length; i++) {
        let a = ((i * STEP + r) % 360 + 360) % 360;
        if (a > 180) a -= 360;            // -180..180, 0 = facing viewer
        const ad = Math.abs(a);
        // centre ~3 cards crisp (no fade), falling off smoothly toward the sides
        const op = Math.min(1, Math.max(0.08, 1.12 - Math.pow(ad / 90, 1.7)));
        cards[i].style.opacity = op.toFixed(3);
        cards[i].classList.toggle("is-front", ad < STEP * 0.6);
      }
    }
    function setRing(animate, effRot) {
      ring.style.transition = animate ? "transform .7s cubic-bezier(.4,0,.15,1)" : "none";
      ring.style.transform = `translateZ(${-radius}px) rotateY(${-(effRot == null ? rot : effRot)}deg)`;
    }
    function setWorld(tilt, scale) { world.style.transform = `rotateX(${tilt}deg) scale(${scale})`; }
    function step(delta) { spinPaused = true; target += delta * STEP; rot = target; setRing(true); emphasise(rot); idleResume(); }
    document.getElementById("cr-next").addEventListener("click", () => step(1));
    document.getElementById("cr-prev").addEventListener("click", () => step(-1));

    // ---- drag to spin (no native image/link grab; pull-left → ring goes left) ----
    let moved = false, suppressClick = false;
    vp.addEventListener("dragstart", (e) => e.preventDefault());
    vp.addEventListener("pointerdown", (e) => {
      dragging = { x: e.clientX, rot }; moved = false; spinPaused = true;
      ring.classList.add("is-dragging");
      try { vp.setPointerCapture(e.pointerId); } catch (_) {}
    });
    vp.addEventListener("pointermove", (e) => {
      if (!dragging) return;
      const dx = e.clientX - dragging.x;
      if (Math.abs(dx) > 4) moved = true;
      rot = dragging.rot - dx * 0.32;    // follow the finger
      setRing(false); emphasise(rot);
    });
    function endDrag() {
      if (!dragging) return;
      dragging = null; ring.classList.remove("is-dragging");
      if (moved) suppressClick = true;   // a drag shouldn't open the card
      target = Math.round(rot / STEP) * STEP; rot = target; setRing(true); emphasise(rot);
      idleResume();
    }
    vp.addEventListener("pointerup", endDrag);
    vp.addEventListener("pointercancel", endDrag);
    ring.addEventListener("click", (e) => {
      if (suppressClick) { e.preventDefault(); e.stopPropagation(); suppressClick = false; }
    }, true);

    // gentle idle auto-spin (the "circle that's spinning") until you touch it
    let idleTimer = null;
    function idleResume() { clearTimeout(idleTimer); idleTimer = setTimeout(() => { spinPaused = false; }, 3200); }
    let last = 0;
    function frame(ts) {
      if (!last) last = ts;
      const dt = Math.min(48, ts - last); last = ts;

      // hold for the reveal, then run the entrance once
      if (enterT0 == null && ring.classList.contains("is-in")) enterT0 = ts;

      if (enterT0 != null && !formed) {
        const p = Math.min(1, (ts - enterT0) / ENTER_MS);
        const e = easeOut(p);
        rot += dt * 0.0045;                       // base drift keeps accumulating
        const drawRot = rot + (1 - e) * 300;      // unwind ~300° into place
        setWorld((1 - e) * 72, 0.62 + 0.38 * e);  // swing down from above + grow
        setRing(false, drawRot);
        emphasise(drawRot);
        if (p >= 1) {
          formed = true; setWorld(0, 1); ring.classList.add("is-formed");
          // let the embedded title sit in the ring (seen through the gaps) for a
          // beat, then pop it out of the bottom into the corner label
          setTimeout(() => crEl.classList.add("cr-popped"), 950);
        }
      } else if (formed && !spinPaused && !dragging) {
        rot += dt * 0.0045; target = rot;
        setRing(false); emphasise(rot);
      }
      requestAnimationFrame(frame);
    }

    function init() { calcRadius(); setWorld(72, 0.62); setRing(false, 0); emphasise(0); requestAnimationFrame(frame); }
    window.addEventListener("resize", () => { calcRadius(); if (formed) setRing(false); });
    init();
  })();
</script>

<style is:global>
  body.sh-lock #nav { transform: translateY(-115%) !important; transition: none !important; }
  #nav { transition: transform 0.8s cubic-bezier(.2,.75,.2,1); }

  /* Returning visit (intro already seen this session) — snap to the resting
     "Strategic thinkers / Smart strategy" state: hide the intro instantly and
     bring the resting photos/copy/scroller in with a quick fade, no stagger. */
  .sh.sh-instant .sh-intro { transition: none !important; opacity: 0 !important; pointer-events: none; }
  .sh.sh-instant .cr-mid,
  .sh.sh-instant .cr-ring,
  .sh.sh-instant .cr-controls { transition-duration: 0.35s !important; transition-delay: 0s !important; }

  /* Template names — global because they're created in JS (no scoped attribute).
     Pure text, no button chrome. */
  .sh-name {
    position: absolute; top: 0; height: 100%;
    display: flex; align-items: center; justify-content: center;
    appearance: none; -webkit-appearance: none;
    background: transparent; border: 0; outline: 0; box-shadow: none;
    cursor: pointer; padding: 0; margin: 0; -webkit-tap-highlight-color: transparent;
    font-family: var(--serif); font-weight: 500; font-size: clamp(15px, 2vw, 30px);
    letter-spacing: -0.01em; color: rgba(28,29,34,0.24); white-space: nowrap;
    transition: color 0.35s;
  }
  .sh-name:focus, .sh-name:focus-visible { outline: 0; }
  .sh-name:hover { color: rgba(28,29,34,0.5); }
  .sh-name.is-active { color: var(--ink); }
</style>

<style>
  .sh { position: relative; height: 100vh; width: 100%; overflow: hidden; background: var(--english-violet); color: var(--paper); font-family: var(--sans); }
  .sh-bg { position: absolute; inset: 0; background: var(--english-violet); transition: background 1.1s ease; z-index: 0; }
  .sh.s-brand .sh-bg { background: var(--paper); }

  /* ---------- INTRO ---------- */
  .sh-intro { position: absolute; inset: 0; z-index: 2; }
  .sh.s-brand .sh-intro { opacity: 0; transition: opacity 0.7s ease; pointer-events: none; }

  .sh-load { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-family: var(--serif); font-weight: 600; font-size: clamp(44px, 6.5vw, 96px); letter-spacing: 0.04em; opacity: 0; transition: opacity 0.8s ease; }
  .sh:not(.s-lists) .sh-load { opacity: 1; }
  .sh.s-lists .sh-load { opacity: 0; }

  .sh-lists { position: absolute; top: 50%; transform: translateY(-50%); display: flex; flex-direction: column; gap: 7px; }
  .sh-lists--left { left: clamp(20px, 4vw, 72px); width: min(24vw, 320px); text-align: left; }
  .sh-lists--right { right: clamp(20px, 4vw, 72px); width: min(24vw, 320px); text-align: right; }
  .sh-row { font-size: clamp(11px, 0.9vw, 14px); letter-spacing: 0.05em; text-transform: uppercase; color: rgba(240,238,235,0.22); opacity: 0; transform: translateY(10px); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .sh-row--head { color: rgba(240,238,235,0.5); font-weight: 700; letter-spacing: 0.18em; margin-bottom: 10px; font-size: 10px; }
  .sh.s-lists .sh-row { opacity: 1; transform: none; color: rgba(240,238,235,0.9); transition: opacity 0.7s ease, color 0.8s ease, transform 0.7s ease; transition-delay: calc(var(--i) * 110ms); }
  .sh.s-clear .sh-row { opacity: 0; transform: translateY(-8px); transition: opacity 0.6s ease, transform 0.6s ease; transition-delay: calc(var(--i) * 60ms); }

  /* three portrait team photos */
  .sh-team { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); display: flex; gap: clamp(14px, 1.6vw, 28px); align-items: center; }
  .sh-portrait { position: relative; margin: 0; width: min(14vw, 26vh, 210px); aspect-ratio: 3 / 4.4; background-size: cover; background-position: center; background-color: #1a1a1d; border-radius: 3px; opacity: 0; transform: scale(0.82) translateY(18px); }
  .sh-portrait figcaption { position: absolute; left: 0; right: 0; bottom: 10px; text-align: center; font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(240,238,235,0.92); text-shadow: 0 1px 8px rgba(0,0,0,0.6); opacity: 0; transition: opacity 0.5s ease; }
  .sh.s-lists .sh-portrait { opacity: 1; transform: none; transition: opacity 0.9s ease, transform 0.9s cubic-bezier(.16,1,.3,1); transition-delay: calc(0.5s + var(--i) * 200ms); }
  .sh.s-lists .sh-portrait figcaption { opacity: 1; transition-delay: calc(1.1s + var(--i) * 200ms); }
  .sh.s-collapse .sh-portrait:not(.is-centre) { opacity: 0; transform: scale(0.8); transition: opacity 0.6s ease, transform 0.6s ease; }
  .sh.s-collapse .sh-portrait figcaption { opacity: 0; transition: opacity 0.4s ease; }
  .sh.s-brand .sh-portrait { opacity: 0; transition: opacity 0.6s ease; }

  /* ---------- RESTING ---------- */
  .sh-rest { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .sh.s-brand .sh-rest { pointer-events: auto; }

  /* copy aligned to the top of the fanned side photos; pops in from each side */
  /* Side wording removed per design — kept in the DOM (controller references it)
     but hidden so nothing breaks. */
  .sh-text { display: none; position: absolute; top: 24%; max-width: 26vw; color: var(--ink); opacity: 0; transition: opacity 0.7s ease, transform 0.7s cubic-bezier(.16,1,.3,1); }
  .sh-text.is-in { opacity: 1; transform: none; }
  .sh-text h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(22px, 2.2vw, 38px); line-height: 1.1; letter-spacing: -0.01em; margin: 0; }
  .sh-text h2 em { font-style: italic; color: var(--english-violet); }
  .sh-text--left { left: clamp(20px, 4vw, 84px); transform: translateX(-28px); }
  .sh-text--right { right: clamp(20px, 4vw, 84px); text-align: right; transform: translateX(28px); }

  .sh-stage { position: absolute; left: 50%; top: 46%; transform: translate(-50%, -50%); width: min(40vw, 520px); height: min(56vh, 520px); perspective: 1700px; }
  /* Photos scale with BOTH width and HEIGHT (vh) so they never sit on the copy
     on shorter laptop screens; the px value is the original (PC) cap. */
  .sh-photo { position: absolute; top: 50%; left: 50%; background-size: cover; background-position: center; background-color: #d8d3c8; border-radius: 4px; box-shadow: 0 22px 60px rgba(16,14,22,0.28); transition: transform 0.8s cubic-bezier(.16,1,.3,1), opacity 0.7s ease, filter 0.35s ease; }
  .sh-photo--centre { width: min(34vw, 46vh, 440px); aspect-ratio: 4 / 5; z-index: 3; overflow: hidden; background: none; opacity: 0; transform: translate(-50%, -50%) scale(0.86); }
  .sh-photo--centre.is-in { opacity: 1; transform: translate(-50%, -50%) scale(1); }
  /* Straight cards that cascade out sideways; a slight inward depth tilt
     (rotateY) pushes the outer edge back to reveal the card and add depth. */
  .sh-photo--left { width: min(24vw, 34vh, 300px); aspect-ratio: 4 / 5; z-index: 2; opacity: 0; transform: translate(-58%, -50%) rotateY(18deg); }
  .sh-photo--left.is-in { opacity: 0; transform: translate(-50%, -50%) rotateY(18deg) scale(0.82); }
  .sh-photo--right { width: min(24vw, 34vh, 300px); aspect-ratio: 4 / 5; z-index: 1; opacity: 0; transform: translate(-42%, -50%) rotateY(-18deg); }
  .sh-photo--right.is-in { opacity: 0; transform: translate(-50%, -50%) rotateY(-18deg) scale(0.82); }
  /* template change: dive back behind the centre, then cascade out with the new image */
  .sh-photo--left.is-emerging { transform: translate(-58%, -50%) rotateY(18deg); opacity: 0.3; transition: none; }
  .sh-photo--right.is-emerging { transform: translate(-42%, -50%) rotateY(-18deg); opacity: 0.3; transition: none; }

  /* hover: the pack BURSTS open — its photos fan out, small + sharp — and a
     "View …" button appears. (At rest only the centre image shows.) */
  .sh-stage:hover .sh-photo--centre.is-in { transform: translate(-50%, -50%) scale(0.78); }
  .sh-stage:hover .sh-photo--left.is-in  { opacity: 1; transform: translate(-120%, -50%) rotateY(18deg) scale(0.74); filter: brightness(0.97); }
  .sh-stage:hover .sh-photo--right.is-in { opacity: 1; transform: translate(20%, -50%) rotateY(-18deg) scale(0.74); filter: brightness(0.97); }
  .sh-view { position: absolute; left: 50%; top: 50%; z-index: 6; transform: translate(-50%, -42%); opacity: 0; pointer-events: none;
    background: var(--ink); color: var(--paper); text-decoration: none; padding: 15px 28px; border-radius: 3px;
    font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; white-space: nowrap;
    transition: opacity 0.3s ease, transform 0.4s cubic-bezier(.16,1,.3,1), background 0.25s; }
  .sh-view em { font-family: var(--serif); font-style: italic; font-size: 15px; letter-spacing: 0; text-transform: none; margin-left: 8px; }
  .sh-view:hover { background: var(--english-violet); }
  .sh-stage:hover .sh-view { opacity: 1; transform: translate(-50%, -50%); pointer-events: auto; }
  /* centre scroll layers */
  .sh-cl { position: absolute; inset: 0; background-size: cover; background-position: center; background-color: #d8d3c8; }
  .sh-cl--b { transform: translateY(-101%); }
  .sh-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 2; transition: opacity 0.5s ease; }

  /* ---------- INFINITE SCROLLER ---------- */
  .sh-scroller { position: absolute; left: 0; right: 0; bottom: 0; z-index: 4; padding-bottom: 22px; opacity: 0; transform: translateY(26px); pointer-events: none; transition: opacity 0.8s ease, transform 0.8s cubic-bezier(.16,1,.3,1); }
  .sh-scroller.is-in { opacity: 1; transform: none; pointer-events: auto; }

  .sh-track { position: relative; height: clamp(28px, 3.4vw, 46px); margin: 4px 0; }
  /* .sh-name styles are global (the names are created in JS, so they don't carry
     the scoped attribute) — see the is:global block below. */

  /* ruler ticks above + below; longer centre tick on each, aligned to the active name */
  .sh-ruler { position: relative; height: 9px; }
