<style>
  /* ---------- RESTING: rotating 3D card ring ---------- */
  .cr { position: absolute; inset: 0; z-index: 1; display: flex; align-items: center; justify-content: center; }

  /* perspective stage */
  .cr-viewport {
    position: relative; width: 100%; height: 100%; z-index: 1;
    display: flex; align-items: center; justify-content: center;
    perspective: 1500px; perspective-origin: 50% 47%;
    cursor: grab; touch-action: pan-y; user-select: none; -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
  }
  .cr-viewport:active { cursor: grabbing; }

  /* shared 3D space — ring + the embedded title depth-sort together */
  .cr-world { position: relative; transform-style: preserve-3d; will-change: transform; }

  .cr-ring {
    position: relative; transform-style: preserve-3d; will-change: transform;
    width: clamp(150px, 16vw, 230px); height: clamp(200px, 22vw, 300px);
    opacity: 0;
  }
  .cr-ring.is-in { opacity: 1; transition: opacity 1s ease; }

  .cr-card {
    position: absolute; inset: 0; display: block; border-radius: 16px; overflow: hidden;
    background-size: cover; background-position: center; background-color: #e9e6e1;
    box-shadow: 0 16px 38px rgba(28,29,34,0.18);
    transform: rotateY(calc(var(--i) * var(--step))) translateZ(var(--radius));
    transition: box-shadow 0.4s ease;
    user-select: none; -webkit-user-select: none; -webkit-user-drag: none;
  }
  /* keep every card visible while the ring swings into formation, then hide
     the back-facing half for a clean resting ring */
  .cr-ring.is-formed .cr-card { backface-visibility: hidden; }
  .cr-card.is-front { box-shadow: 0 34px 80px rgba(28,29,34,0.32); }

  /* per-card pack name: pushed out at rest, pressed in while dragging */
  .cr-name {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 32px 10px 13px;
    text-align: center; color: #fff; pointer-events: none;
    font-family: var(--sans); font-weight: 600; font-size: clamp(11px, 0.95vw, 14px);
    letter-spacing: 0.14em; text-transform: uppercase;
    text-shadow: 0 1px 10px rgba(0,0,0,0.45);
    background: linear-gradient(to top, rgba(18,16,14,0.55), rgba(18,16,14,0));
    border-radius: 0 0 16px 16px;
    opacity: 0; transform: translateY(10px) scale(0.84);
  }
  .cr-ring.is-formed .cr-name {
    opacity: 1; transform: translateY(0) scale(1);
    transition: opacity 0.5s ease, transform 0.6s cubic-bezier(.2,.9,.2,1.25);
  }
  .cr-ring.is-dragging .cr-name {
    opacity: 0.45; transform: translateY(6px) scale(0.84);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }

  /* title embedded at the ring centre — front cards occlude it (true perspective) */
  .cr-mid {
    position: absolute; left: 50%; top: 50%; margin: 0;
    transform: translate(-50%, -50%) translateZ(var(--mid-z, -600px));
    backface-visibility: hidden; pointer-events: none; opacity: 0;
    font-family: var(--serif); font-weight: 500; color: var(--ink);
    font-size: clamp(48px, 8vw, 122px); line-height: 1.0; letter-spacing: -0.02em;
    text-align: center; white-space: nowrap;
  }
  .cr-mid span { display: block; }
  .cr-mid.is-in { opacity: 1; transition: opacity 0.9s ease; }
  /* …then it pops out of the bottom and fades as the corner label rises in */
  .cr.cr-popped .cr-mid { animation: crMidOut 0.75s cubic-bezier(.5,0,.55,1) forwards; }
  @keyframes crMidOut {
    to { opacity: 0; transform: translate(-50%, -50%) translateZ(140px) translateY(46%); }
  }

  /* the readable corner label it settles into */
  .cr-title {
    position: absolute; left: clamp(24px, 5vw, 80px); bottom: clamp(30px, 8vh, 84px); z-index: 5;
    margin: 0; text-align: left; pointer-events: none;
    font-family: var(--serif); font-weight: 500; color: var(--ink);
    font-size: clamp(30px, 4.6vw, 70px); line-height: 1.02; letter-spacing: -0.02em;
    opacity: 0; transform: translateY(48px);
  }
  .cr-title span { display: block; }
  .cr.cr-popped .cr-title { animation: crRise 0.85s 0.18s cubic-bezier(.2,.72,.18,1) both; }
  @keyframes crRise {
    0%   { opacity: 0; transform: translateY(48px); }
    100% { opacity: 1; transform: translateY(0); }
  }

  .cr-controls {
    position: absolute; left: 50%; bottom: clamp(22px, 5vh, 60px); transform: translateX(-50%); z-index: 6;
    display: flex; align-items: center; gap: 24px; opacity: 0;
  }
  .cr-controls.is-in { opacity: 1; transition: opacity 0.8s ease; }
  .cr-arrow {
    appearance: none; -webkit-appearance: none; width: 46px; height: 46px; border-radius: 50%;
    border: 1px solid rgba(28,29,34,0.16); background: rgba(255,255,255,0.72); backdrop-filter: blur(8px);
    color: var(--ink); font-size: 13px; line-height: 1; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    transition: background 0.2s ease, transform 0.2s ease;
  }
  .cr-arrow:hover { background: #fff; transform: scale(1.06); }

  @media (max-width: 760px) {
    .cr-title { font-size: clamp(28px, 8vw, 46px); }
    .cr-mid { font-size: clamp(34px, 11vw, 60px); }
    .cr-ring { width: 46vw; height: 60vw; }
  }
</style>
