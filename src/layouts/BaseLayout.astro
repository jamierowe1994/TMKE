---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Override the canonical/og url. Defaults to Astro.url. */
  canonical?: string;
  /** Path to a 1200×630 OG image (relative to /public). */
  ogImage?: string;
  /** Hide the global nav (rarely useful — e.g. checkout pages later). */
  hideNav?: boolean;
  /** Hide the global footer. */
  hideFooter?: boolean;
}

const {
  title = "TMKE — The Marketing Experts",
  description = "A specialist social media and marketing agency for the UK property sector. Premium templates, fully managed channels, structured content.",
  canonical = Astro.url.href,
  ogImage = "/assets/hero.png",
  hideNav = false,
  hideFooter = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Darker+Grotesque:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Lenis — smooth, momentum-based scrolling -->
    <script
      src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"
      is:inline></script>
  </head>
  <body>
    {!hideNav && <Nav />}
    <slot />
    {!hideFooter && <Footer />}

    <script src="/scripts/app.js" is:inline></script>
  </body>
</html>
