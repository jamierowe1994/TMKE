---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Override the canonical/og url. Defaults to Astro.url. */
  canonical?: string;
  /** Path to a 1200×630 OG image (relative to /public). */
  ogImage?: string;
  /** Hide the global nav (rarely useful — e.g. checkout pages later). */
  hideNav?: boolean;
  /** Hide the global footer. */
  hideFooter?: boolean;
}

const {
  title = "TMKE — The Marketing Experts",
  description = "A specialist social media and marketing agency for the UK property sector. Premium templates, fully managed channels, structured content.",
  canonical = Astro.url.href,
  ogImage = "/assets/hero.png",
  hideNav = false,
  hideFooter = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="image" href="/assets/Door%20Closed.png" />
    <link rel="preload" as="image" href="/assets/Doors.png" />
    <link rel="preload" as="video" href="/assets/door%20open.mp4" type="video/mp4" />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Darker+Grotesque:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Lenis — smooth, momentum-based scrolling -->
    <script
      src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"
      is:inline></script>
  </head>
  <body>
    {!hideNav && <Nav />}
    <slot />
    {!hideFooter && <Footer />}

    <!-- Sign-in splash overlay — fired by window.tmkeSplash() -->
    <div class="splash" id="tmke-splash" aria-hidden="true">
      <img class="splash-bg splash-bg--closed" src="/assets/Door%20Closed.png" alt="" />
      <video class="splash-video" id="tmke-splash-video" muted playsinline preload="auto" poster="/assets/Door%20Closed.png">
        <source src="/assets/door%20open.mp4" type="video/mp4" />
      </video>
      <img class="splash-bg splash-bg--open" src="/assets/Doors.png" alt="" />
      <div class="splash-grain"></div>
      <div class="splash-inner">
        <div class="splash-eyebrow"><span>TMKE</span> &mdash; Members</div>
        <h1 class="splash-title">
          <span class="splash-word"><span>Welcome</span></span>
          <span class="splash-word"><span>to <em>good style.</em></span></span>
        </h1>
        <p class="splash-sub">Opening your library&hellip;</p>
        <div class="splash-bar"><div class="splash-bar-fill"></div></div>
      </div>
    </div>

    <script is:inline>
      window.tmkeSplash = function (destination, opts) {
        opts = opts || {};
        // ~5s video runtime + a short beat on the open-doors still.
        // If anything stalls, we settle on the open still by VIDEO_FALLBACK
        // and navigate by HARD_CAP — so the user is never stuck on a frozen
        // splash. HARD_CAP is the absolute backstop the user asked for.
        const HARD_CAP = opts.duration || 5800;
        const VIDEO_FALLBACK = 5200;
        const POST_HOLD = 500;
        const splash = document.getElementById("tmke-splash");
        if (!splash) { window.location.href = destination; return; }
        const video = document.getElementById("tmke-splash-video");

        splash.classList.add("is-on");
        document.documentElement.style.overflow = "hidden";

        let navigated = false;
        function navigate() {
          if (navigated) return;
          navigated = true;
          window.location.href = destination;
        }

        // Hard cap — splash never holds longer than HARD_CAP, no matter what
        const hardTimer = setTimeout(navigate, HARD_CAP);

        function settleToOpen() {
          if (splash.classList.contains("is-open")) return;
          splash.classList.add("is-open");
          // The open still is crossfading in; pause the video so it stops
          // burning frames while it's being covered.
          try { video && video.pause && video.pause(); } catch (_) {}
          // hold briefly on the open-doors still + text, then go
          setTimeout(function () {
            clearTimeout(hardTimer);
            navigate();
          }, POST_HOLD);
        }

        if (video && video.canPlayType && video.canPlayType("video/mp4")) {
          // Kick off playback as soon as the splash shows
          requestAnimationFrame(function () { splash.classList.add("is-playing"); });
          try { video.currentTime = 0; } catch (_) {}
          const p = video.play();
          if (p && p.catch) p.catch(function () {
            // Autoplay blocked / video failed — go straight to the open still
            settleToOpen();
          });
          video.addEventListener("ended", settleToOpen, { once: true });
          // Safety: if the video never fires "ended" (load issue, slow connection),
          // settle on the open still after VIDEO_FALLBACK
          setTimeout(settleToOpen, VIDEO_FALLBACK);
        } else {
          // No video support — skip straight to the open still
          settleToOpen();
        }
      };
    </script>

    <script src="/scripts/app.js" is:inline></script>
  </body>
</html>
