---
import Nav from "../components/Nav.astro";
import NewsPop from "../components/NewsPop.astro";
import Footer from "../components/Footer.astro";
import LoginState from "../components/LoginState.astro";
import { DEMO_BRAND } from "../data/demo-brand.js";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Override the canonical/og url. Defaults to Astro.url. */
  canonical?: string;
  /** Path to a 1200×630 OG image (relative to /public). */
  ogImage?: string;
  /** Hide the global nav (rarely useful — e.g. checkout pages later). */
  hideNav?: boolean;
  /** Hide the global footer. */
  hideFooter?: boolean;
  /** Emit a noindex,nofollow robots tag (for unlisted / WIP pages). */
  noindex?: boolean;
  /** Apply the customer-dashboard typography: The Seasons headers + Montserrat body. */
  dashboard?: boolean;
  /** Force the page-transition on/off, overriding the hideNav default. The deck
      pages (chrome-less but public) opt in so navigation stays consistent. */
  pageTransition?: boolean;
  /** The ready gate (src/lib/ready-gate.js): the page stays behind the
      loading cover until every section that shows real content says it is
      ready, then appears all at once. Off unless a page asks for it. */
  readyGate?: boolean;
  /** Only engage the gate when the address's query string matches this
      pattern (a RegExp source). The editor page is several pages in one: its
      pack and design library are gated, the canvas has a loader of its own. */
  readyGateIf?: string;
}

// Installable apps. The admin centre and the member hub are each their own
// desktop app — separate icons, separate windows, used by different people.
// The marketing site deliberately links no manifest, so it is never offered
// for install; the manifest link is what decides where the browser offers it,
// and `scope` is what keeps navigation inside the app window once installed.
// Both live under a single address prefix, which is why the hub moved to
// /account (30 Jul 2026) — an app is scoped to a path, not to a list of pages.
const _p = Astro.url.pathname;
const pwa = _p.startsWith("/admin")
  ? { manifest: "/admin/manifest.webmanifest", icon: "/icons/admin-192.png" }
  : _p.startsWith("/account")
  ? { manifest: "/account/manifest.webmanifest", icon: "/icons/hub-192.png" }
  : null;

const {
  title = "TMKE — The Marketing Experts",
  description = "A specialist social media and marketing agency for the UK property sector. Premium templates, fully managed channels, structured content.",
  canonical = Astro.url.href,
  ogImage = "/assets/hero.png",
  hideNav = false,
  hideFooter = false,
  noindex = false,
  dashboard = false,
  pageTransition = undefined,
  readyGate = false,
  readyGateIf = "",
} = Astro.props;

// Front-end-only page transition. Back-end tools — /admin/* and /editor (the
// Studio design editor) — keep their plain navigation. The /edit/* "Edit" shop
// is public front-end, so it opts in. Also skipped on chrome-less pages
// (hideNav) and whenever an inline content-edit session is in play (?edit=…),
// so clicks are never hijacked mid-edit.
const path = Astro.url.pathname;
/* The training-area kit, inlined into the hub's pages only. The marketing
   site never reads a brand kit, so there is no reason to carry it there. */
const inHub = path.startsWith("/account");
const TRAINING_KIT_JSON = inHub ? JSON.stringify({ ...DEMO_BRAND }) : "";
const isBackend = path.startsWith("/admin") || path === "/account/editor" || path === "/account/editor/";
const isEditing = Astro.url.searchParams.has("edit");
// Public chrome-less pages (the /services + /videography decks) opt in via
// pageTransition so the cover↔reveal handshake stays symmetric site-wide;
// otherwise default to "on unless hideNav". Backend/editing always off.
const enableTransition = !isBackend && !isEditing && (pageTransition ?? !hideNav);

// Keep the signed-in areas out of search. They are real, reachable pages, but
// what a crawler sees is the empty shell before anyone signs in - nothing worth
// showing, and a pile of near-identical blank pages is a poor signal for the
// site as a whole. Set here by path rather than page by page, so a new hub or
// admin page is covered the day it is added. Crawling is deliberately NOT
// blocked in robots.txt: a blocked page is never read, so this tag would never
// be seen and any already-known URL would linger in the results.
const privateArea = /^\/(account|admin|deliver)(\/|$)/.test(path);
const hideFromSearch = noindex || privateArea;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    {hideFromSearch && <meta name="robots" content="noindex,nofollow" />}
    <link rel="canonical" href={canonical} />

    {pwa && <link rel="manifest" href={pwa.manifest} />}
    {pwa && <meta name="theme-color" content="#371e28" />}
    {pwa && <link rel="apple-touch-icon" href={pwa.icon} />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Splash assets are prefetched on-demand (Nav.astro warms them on
         hover/focus of the Login button) so we don't burn ~11 MB on every
         page load. /login preloads the closed still directly since it's
         the page background. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Darker+Grotesque:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    {/* The Seasons (brand sub-heading font) — served by Typographer.io
        (licensed, hosted webfont; its CSS defines @font-face for family
        "The Seasons"). Loaded site-wide now the brand type system is global. */}
    <link rel="preconnect" href="https://typographer.io/" />
    <link
      rel="stylesheet"
      href="https://typographer.io/1/users/467c83a44f61441cb50105908eaff74438db1e54235bde171a5c44f6c7fc83aa/487431c25f60d82971ce153174b4c5091c0b39b71709285ba4d15aaa1a147485/css?token=b2fe187212"
    />
    <script type="module" is:inline>try{navigator.sendBeacon("https://use.typographer.io/1/users/467c83a44f61441cb50105908eaff74438db1e54235bde171a5c44f6c7fc83aa/487431c25f60d82971ce153174b4c5091c0b39b71709285ba4d15aaa1a147485/css?token=b2fe187212")}catch{}</script>


    <!-- Lenis — smooth, momentum-based scrolling.
         `defer` makes the CDN fetch non-blocking; Lenis still runs after
         DOMContentLoaded which is fine for scroll enhancement. -->
    <script
      defer
      src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"
      is:inline></script>

    {
      enableTransition && (
        <>
          <link rel="preload" as="image" href="/images/loading-tmke.webp" fetchpriority="low" />
          {/* Pre-cover: runs before the body paints. If we arrived via a
              transition, pin the panels over the screen so the new page never
              flashes before page-transition.js plays the reveal-out. */}
          <script is:inline>
            try {
              if (sessionStorage.getItem("tmke:pt") === "1") {
                document.documentElement.classList.add("pt-revealing");
              }
            } catch (e) {}
          </script>
          {/* Critical rules only — must apply before paint. The rest of the
              transition styling lives in global.css. */}
          <style is:inline>
            /* Burgundy is hard-coded here (NOT var(--english-violet)) because this
               inline block paints BEFORE global.css loads — with the variable the
               panels paint transparent for a frame and the page flashes white
               through them. The covering <html> also goes burgundy so there's no
               white in the gap before the .pt element parses. #371e28 = --english-violet. */
            /* overflow:hidden here (pre-paint, not waiting on the JS scroll-lock)
               removes the native scrollbar for the covered phase, so its gutter
               can't flash white beside the burgundy cover. */
            /* One cover, not two bars sweeping (Dani, 7 Oct): the bars took
               0.8s to meet, and for that whole 0.8s the page you were leaving
               was still on screen and still moving behind them — the flicker.
               A single sheet fades up over the lot in a third of the time. */
            html.pt-revealing { background: #371e28; overflow: hidden; }
            .pt { position: fixed; inset: 0; z-index: 9500; pointer-events: none; visibility: hidden; }
            /* The artwork Dani made: the wordmark blind-embossed into burgundy
               board, 2000x1125. Its flat ground is #371e28, the brand burgundy,
               so the colour behind it matches exactly and nothing shows a seam
               if the image has not arrived yet or is letterboxed.
               cover on anything wider than the artwork; contain below that, so
               a phone scales the mark down rather than cropping it in half. */
            .pt__veil {
              position: absolute; inset: 0; opacity: 0;
              background: #371e28 url("/images/loading-tmke.webp") center / cover no-repeat;
            }
            @media (max-aspect-ratio: 16 / 9) {
              .pt__veil { background-size: contain; }
            }
            html.pt-revealing .pt { visibility: visible; }
            html.pt-revealing .pt__veil { opacity: 1; }
          </style>
        </>
      )
    }

    {/* Whether this browser holds a session, decided before the body paints.
        Pages that ship sample content for signed-out visitors and swap it for
        the member's own once Supabase answers need to know which of the two
        they are about to show — otherwise a member watches somebody else's
        packs and designs for the length of a round trip, then sees them
        flip. This only says "a token is stored here", not that it is still
        valid; the fetch settles that, and clears the class if not. */}
    {/* THE TRAINING WINDOW. Every guides walkthrough opens in a pop-out
        (src/lib/tour.js, openStage), and the frame inside it is named
        "tmke-training". That frame is the training account and nothing else:
        Alex Mercer of Rimberio Homes, with storage of its own.

        Dani, 14 Oct: "You need to make the training environment a separate
        entity ... although it's not a real account, it's treating it like a
        real account." It was: the walkthrough ran in the member's own login
        and only the brand kit was swapped, by a switch kept in the member's
        own storage -- so a walk left half-way left their hub wearing the
        training kit, and their Brand Kit page not saving.

        Now the separation is the window itself, not a setting. Inside it,
        every read and write of localStorage, sessionStorage and IndexedDB goes
        to a space of its own (keys start "tmke-training:"), so the member's
        login, kit and drafts are not there to be seen, and nothing done in the
        window can reach them. Outside it, nothing changes at all: no flag of
        the training account's lives in the member's storage, so there is
        nothing to get stuck. A frame's name is kept by the frame as it moves
        between pages, and is never given to a tab of the member's own.

        In the head, ahead of every page script, so nothing reads first.
        The names are shared with src/lib/training.js. */}
    <script is:inline set:html={`
    (function () {
      var WIN = "tmke-training", PFX = "tmke-training:";
      var KIT = ${TRAINING_KIT_JSON || "null"};
      var sealed = false;
      try { sealed = window.name === WIN && window.self !== window.top; } catch (_) {}
      if (!sealed) {
        // Left by the walkthrough switch before 14 Oct; nothing reads it now.
        try { localStorage.removeItem("tmke.brand.training.scratch"); } catch (_) {}
        return;
      }
      window.__TMKE_TRAINING_WINDOW__ = true;
      var proto = Storage.prototype;
      var get = proto.getItem, set = proto.setItem, del = proto.removeItem, key = proto.key;
      var lenDesc = Object.getOwnPropertyDescriptor(proto, "length");
      var ours = function (st) { return st === window.localStorage || st === window.sessionStorage; };
      var mine = function (st) {
        var out = [], n = lenDesc.get.call(st);
        for (var i = 0; i < n; i++) { var k = key.call(st, i); if (k && k.indexOf(PFX) === 0) out.push(k.slice(PFX.length)); }
        return out;
      };
      proto.getItem = function (k) { return ours(this) ? get.call(this, PFX + k) : get.apply(this, arguments); };
      proto.setItem = function (k, v) { return ours(this) ? set.call(this, PFX + k, v) : set.apply(this, arguments); };
      proto.removeItem = function (k) { return ours(this) ? del.call(this, PFX + k) : del.apply(this, arguments); };
      proto.key = function (i) { if (!ours(this)) return key.apply(this, arguments); var m = mine(this); return i < m.length ? m[i] : null; };
      proto.clear = function () { var st = this; mine(st).forEach(function (k) { del.call(st, PFX + k); }); };
      Object.defineProperty(proto, "length", { configurable: true, get: function () { return ours(this) ? mine(this).length : lenDesc.get.call(this); } });
      // The member's own tab writing its storage is no news to this window.
      window.addEventListener("storage", function (e) {
        if (e.key == null || String(e.key).indexOf(PFX) !== 0) e.stopImmediatePropagation();
      }, true);
      // The Studio's clipboard and anything else kept in IndexedDB, likewise.
      try {
        var idb = IDBFactory.prototype, open = idb.open, drop = idb.deleteDatabase;
        idb.open = function (n) { var a = [].slice.call(arguments); a[0] = PFX + n; return open.apply(this, a); };
        idb.deleteDatabase = function (n) { return drop.call(this, PFX + n); };
      } catch (_) {}
      // The training account, every time: nobody signed in, the training demo
      // on, and Rimberio Homes' kit. Laid in once per walkthrough (the window's
      // space is emptied when the pop-out opens and when it closes).
      try {
        if (!localStorage.getItem("tmke_demo")) {
          localStorage.setItem("tmke_demo", JSON.stringify({ name: KIT && KIT.about ? KIT.about.name : "Alex Mercer", email: "", since: Date.now(), kind: "training", training: true }));
        }
        if (KIT && !localStorage.getItem("tmke.brand.training")) {
          var kit = JSON.stringify(Object.assign({}, KIT, { updatedAt: Date.now() }));
          localStorage.setItem("tmke.brand.training", kit);
          localStorage.setItem("tmke.brand", kit);
        }
      } catch (_) {}
    })();
    `} />
    <script is:inline>
      try {
        /* Which login this page belongs to (src/lib/supabase.js: two front
           doors). The admin side reads its own; the hub reads its own, or the
           old shared slot a member has not been moved out of yet. */
        var _q = new URLSearchParams(location.search);
        var _admin = /^\/admin(\/|$)/.test(location.pathname)
          || (location.pathname.replace(/\/+$/, "") === "/account/editor" && _q.get("mode") === "admin");
        if (_admin ? localStorage.getItem("tmke-admin-auth")
                   : (localStorage.getItem("tmke-member-auth") || localStorage.getItem("tmke-admin-auth"))) {
          document.documentElement.classList.add("has-session");
        }
        /* Admin opening a template in the editor: cover the page before the
           first paint. Set here, in the head, because an inline script lower
           in the body runs after everything above it has already been drawn —
           the member header and Studio chrome were flashing through. The veil
           itself and the lift live in account/editor.astro. */
        if (location.pathname.replace(/\/+$/, "") === "/account/editor") {
          var q = new URLSearchParams(location.search);
          if (q.get("mode") === "admin" && q.get("rebuildthumb") !== "1") {
            document.documentElement.classList.add("ed-booting");
          }
        }
      } catch (e) {}
    </script>
    {inHub && !readyGate && (
      /* The hub's entrance (ws-system.css, Entrances) waits for the banner's
         photograph, so the banner fades in whole instead of its picture
         landing after it. Never longer than 0.9s: a slow picture does not
         hold the page. */
      <script is:inline>
        (function () {
          var r = document.documentElement, done = false;
          /* The entrance (hub-entrance.css: Ink + Soft focus, Dani's pick,
             14 Oct). Not with reduced motion asked for: the page is shown
             still. */
          var still0 = false;
          try { still0 = window.matchMedia("(prefers-reduced-motion: reduce)").matches; } catch (_) {}
          if (!still0) r.classList.add("tmke-enter");
          /* The banner title, written in a letter at a time: each letter
             its own span with its own delay, kept inside its word so a line
             never breaks mid-word. --te is when the last letter lands; the
             intro, the button and the sections below are timed from it. */
          var ink = function () {
            var te = 0.6, START = 0.15, STEP = 0.028, n = 0;
            var t = document.querySelector(".ws-left > .ws-hero .ws-greeting, .lrn-hero .lrn-title, .bk-hero .bk-hero-title");
            if (t && !still0 && !t.getAttribute("data-inked")) {
              t.setAttribute("data-inked", "1");
              t.setAttribute("aria-label", (t.textContent || "").replace(/\s+/g, " ").trim());
              var walk = function (node) {
                [].slice.call(node.childNodes).forEach(function (c) {
                  if (c.nodeType === 1) { walk(c); return; }
                  if (c.nodeType !== 3) return;
                  var frag = document.createDocumentFragment();
                  c.nodeValue.split(/(\s+)/).forEach(function (part) {
                    if (!part) return;
                    if (/^\s+$/.test(part)) { frag.appendChild(document.createTextNode(" ")); return; }
                    var w = document.createElement("span");
                    w.className = "tmke-word"; w.setAttribute("aria-hidden", "true");
                    part.split("").forEach(function (ch) {
                      var sp = document.createElement("span");
                      sp.className = "tmke-ch"; sp.textContent = ch;
                      sp.style.animationDelay = (START + (n++) * STEP).toFixed(3) + "s";
                      w.appendChild(sp);
                    });
                    frag.appendChild(w);
                  });
                  c.parentNode.replaceChild(frag, c);
                });
              };
              walk(t);
              if (n) te = START + n * STEP + 0.7;
            }
            r.style.setProperty("--te", te.toFixed(2) + "s");
          };
          var go = function () {
            if (done) return; done = true;
            try { ink(); } catch (_) {}
            void r.offsetWidth;             // the measured --te is in place before anything starts
            r.classList.add("tmke-go");
            r.classList.remove("tmke-enter-wait");
          };
          r.classList.add("tmke-enter-wait");
          /* The page shows once it has SETTLED, then glides in once (Dani,
             14 Oct: "still very jumpy ... I'm not fussed if it's going to take
             a second for everything to load in"). Settled means: the banner's
             photograph is in, the fonts are in, and the page has stopped
             changing size for a quarter of a second -- the calendar, the
             orders, the dashboard's sections have arrived. Never longer than
             1.6s; a slow page shows what it has. */
          setTimeout(function () { if (!holds) go(); }, 1600);
          setTimeout(go, 3000);   // a held page still shows, if late
          var photo = false, fonts = false, still = false, holds = 0;
          var check = function () { if (photo && fonts && still && !holds) go(); };
          /* A page whose content takes longer than a quarter-second pause to
             arrive (the Planner's month) holds the entrance itself:
               var release = window.__tmkeEnterHold && window.__tmkeEnterHold();
               ...draw...; release && release();                            */
          window.__tmkeEnterHold = function () {
            if (done) return function () {};
            holds++;
            var once = false;
            return function () { if (once) return; once = true; holds--; check(); };
          };
          try { (document.fonts ? document.fonts.ready : Promise.resolve()).then(function () { fonts = true; check(); }); } catch (_) { fonts = true; }
          document.addEventListener("DOMContentLoaded", function () {
            var urls = [];
            document.querySelectorAll(".ws-hero-photo, .lrn-hero-bg, .bk-hero-bg, .mb-hero").forEach(function (el) {
              try {
                getComputedStyle(el).backgroundImage.replace(/url\(["']?([^"')]+)["']?\)/g, function (_, u) { urls.push(u); });
                el.querySelectorAll("img").forEach(function (i) { var u = i.currentSrc || i.getAttribute("src"); if (u) urls.push(u); });
              } catch (_) {}
            });
            if (!urls.length) { photo = true; check(); }
            else {
              var left = urls.length;
              urls.forEach(function (u) { var im = new Image(); im.onload = im.onerror = function () { if (--left <= 0) { photo = true; check(); } }; im.src = u; });
            }
            // Still for 250ms: no change in the size of the page's content.
            var main = document.querySelector(".ws-main, .lrn-main, .dash-main") || document.body;
            var timer = null;
            var calm = function () { clearTimeout(timer); still = false; timer = setTimeout(function () { still = true; check(); }, 250); };
            calm();
            try {
              var ro = new ResizeObserver(calm); ro.observe(main);
              var mo = new MutationObserver(calm); mo.observe(main, { childList: true, subtree: true });
              var stop = function () { try { ro.disconnect(); mo.disconnect(); } catch (_) {} };
              var t = setInterval(function () { if (done) { stop(); clearInterval(t); } }, 100);
            } catch (_) {}
          });
        })();
      </script>
    )}
    {readyGate && (
      <>
        {/* THE READY GATE. Dani, 14 Oct: no placeholders, ever -- "until a
            page is loaded, it does not appear ... card by card ... when they
            all go to yes, that's when you load the page."

            The page starts behind a cover that looks exactly like the page
            transition's (burgundy, the embossed wordmark), so arriving through
            a transition shows one unbroken loader. It is its own cover, not
            the transition's: that one lifts once fonts are in (500ms at most),
            whatever the data is doing, and its script is a public file
            Cloudflare can serve stale for hours.

            Every section that shows real content registers -- data-gate="name"
            in the markup, or gateWait("name") from a script -- and says
            gateReady("name", el) once its real content is in, pictures and
            all. When every one has, the cover lifts. A section that has not
            answered by GATE_MAX is marked data-gate-failed (the page shows its
            own "didn't load" message there, never sample content) and the
            cover lifts anyway. Helpers: src/lib/ready-gate.js. */}
        <style is:inline>
          html.tmke-gated { background: #371e28; overflow: hidden; }
          /* The loader, drawn rather than a picture (Dani, 14 Oct): flat
             burgundy board with a fine even grain, "The Studio" pressed into
             it, and a small TMKE under its last letter. */
          .tmke-gate { position: fixed; inset: 0; z-index: 9400; pointer-events: none; visibility: hidden; opacity: 0;
            display: grid; place-items: center; overflow: hidden; background: #371e28; }
          html.tmke-gated .tmke-gate { visibility: visible; opacity: 1; pointer-events: auto;
            /* Belt and braces: if the script never runs, the page still shows. */
            animation: tmke-gate-failsafe 0s 15s forwards; }
          html.tmke-gate-lifting .tmke-gate { visibility: visible; opacity: 0; transition: opacity .3s ease; }
          @keyframes tmke-gate-failsafe { to { visibility: hidden; opacity: 0; pointer-events: none; } }
          @media (prefers-reduced-motion: reduce) { html.tmke-gate-lifting .tmke-gate { transition: none; } }
          .tmke-gate-paper { position: absolute; inset: 0; pointer-events: none;
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='180' height='180'><filter id='t'><feTurbulence type='fractalNoise' baseFrequency='1.1' numOctaves='2' stitchTiles='stitch' seed='11'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23t)'/></svg>");
            background-size: 180px 180px; opacity: 0.07; mix-blend-mode: overlay; }
          /* The words wait for the brand serif, so they never appear in a
             stand-in font and change; if it is slow, the board shows alone. */
          .tmke-gate-words { position: relative; display: inline-flex; flex-direction: column; align-items: flex-end;
            font-size: clamp(31px, 5.04vw, 83px); opacity: 0; transition: opacity .25s ease; }
          .tmke-gate.has-type .tmke-gate-words { opacity: 1; }
          .tmke-gate-mark, .tmke-gate-sub { font-family: "The Seasons", "Cormorant Garamond", Georgia, serif; font-weight: 400;
            line-height: 1; color: #381f29; filter: url(#tmke-gate-press); }
          .tmke-gate-mark { font-size: 1em; letter-spacing: 0.01em; }
          /* A fixed share of the words above, so the E sits under the o at
             any size (measured from the font: the o's ink ends 0.053em short
             of its box, the E's 0.037em). */
          .tmke-gate-sub { margin-top: 0.55em; font-size: 0.26em; letter-spacing: 0.16em; margin-right: 0.007em; }
          /* On a phone "The Studio" spans about 45% of the screen (Dani,
             14 Oct); the small TMKE would be too small to read, so it goes. */
          @media (max-width: 640px) { .tmke-gate-words { font-size: 9.5vw; } .tmke-gate-mark { filter: url(#tmke-gate-press-sm); color: #3e2330; } .tmke-gate-sub { display: none; } }
        </style>
        <script is:inline define:vars={{ gateIf: readyGateIf }}>
          (function () {
            var GATE_MAX = 12000;
            /* Shown for at least a second from the start of the page, so a
               quick load reads as a deliberate moment rather than a flash of
               burgundy (Dani, 14 Oct). The page is finished behind it either
               way; this only decides when the cover lifts. */
            var MIN_SHOW = 1000;
            var root = document.documentElement;
            try { if (gateIf && !new RegExp(gateIf).test(location.search)) return; } catch (_) { return; }
            root.classList.add("tmke-gated", "tmke-gate-page");
            var waits = {}, holds = 0, opened = false, opening = false, domDone = false, after = [];
            function pending() { var out = []; for (var k in waits) if (!waits[k]) out.push(k); return out; }
            function open(timedOut) {
              if (opened || (opening && !timedOut)) return;
              var early = MIN_SHOW - (window.performance ? performance.now() : MIN_SHOW);
              if (!timedOut && early > 0) {
                opening = true;
                setTimeout(function () { opening = false; open(false); }, early);
                return;
              }
              opened = true;
              if (timedOut) {
                var left = pending();
                left.forEach(function (n) {
                  document.querySelectorAll('[data-gate="' + n + '"]').forEach(function (el) { el.setAttribute("data-gate-failed", ""); });
                });
                try { console.warn("[ready gate] opened without:", left.join(", ")); } catch (_) {}
              }
              try { document.body.removeAttribute("aria-busy"); } catch (_) {}
              root.classList.add("tmke-gate-lifting");
              root.classList.remove("tmke-gated");
              setTimeout(function () { root.classList.remove("tmke-gate-lifting"); }, 320);
              after.forEach(function (f) { try { f(!!timedOut); } catch (_) {} });
              after = [];
            }
            function check() { if (!opened && domDone && holds === 0 && pending().length === 0) open(false); }
            /* A section's pictures count as part of it: "loaded" with its
               thumbnails still arriving one by one is the flashing all over
               again. Every picture in it -- <img> and CSS backgrounds alike,
               which is how most of the hub draws its cards -- is fetched and
               waited for. Each gets four seconds; a broken one does not hold
               the page. */
            function urlsIn(el) {
              var out = [], nodes = [el].concat([].slice.call(el.querySelectorAll("*")));
              var grab = function (bg) { if (bg && bg !== "none") bg.replace(/url\(["']?([^"')]+)["']?\)/g, function (_, u) { out.push(u); }); };
              nodes.forEach(function (n) {
                if (n.tagName === "IMG") { var s = n.currentSrc || n.getAttribute("src"); if (s) out.push(s); }
                try { grab(getComputedStyle(n).backgroundImage); } catch (_) {}
              });
              return out;
            }
            function settle(el) {
              if (!el || !el.querySelectorAll) return Promise.resolve();
              return Promise.all(urlsIn(el).map(function (u) {
                var load = new Promise(function (r) { var im = new Image(); im.onload = im.onerror = function () { r(); }; im.src = u; if (im.complete) r(); });
                return Promise.race([load, new Promise(function (r) { setTimeout(r, 4000); })]);
              }));
            }
            window.__tmkeGate = {
              on: true,
              wait: function (name) { if (!opened && !(name in waits)) waits[name] = false; },
              ready: function (name, el) {
                if (!(name in waits)) waits[name] = false;
                holds++;
                settle(el).then(function () { holds--; waits[name] = true; check(); });
              },
              whenOpen: function (f) { if (opened) f(false); else after.push(f); },
              pending: pending,
              isOpen: function () { return opened; },
            };
            document.addEventListener("DOMContentLoaded", function () {
              try { document.body.setAttribute("aria-busy", "true"); } catch (_) {}
              document.querySelectorAll("[data-gate]").forEach(function (el) {
                var n = el.getAttribute("data-gate");
                if (n && !(n in waits)) waits[n] = false;
              });
              domDone = true;
              check();
            });
            setTimeout(function () { open(true); }, GATE_MAX);
          })();
        </script>
      </>
    )}
  </head>
  <body data-dashboard={dashboard ? "" : undefined}>
    {readyGate && (
      <div class="tmke-gate" aria-hidden="true">
        <svg width="0" height="0" style="position:absolute">
          {/* Pressed into the board, lit from the top left: the upper-left
              walls of each stroke in shadow, the lower-right catching the
              light, both inside the letter as on real debossed paper. */}
          <filter id="tmke-gate-press" x="-10%" y="-30%" width="120%" height="160%" color-interpolation-filters="sRGB">
            <feOffset in="SourceAlpha" dx="1.3" dy="1.6" result="dn" />
            <feGaussianBlur in="dn" stdDeviation="0.8" result="dnb" />
            <feComposite in="SourceAlpha" in2="dnb" operator="out" result="topWall" />
            <feFlood flood-color="#000" flood-opacity="0.52" />
            <feComposite in2="topWall" operator="in" result="shade" />
            <feOffset in="SourceAlpha" dx="-1" dy="-1.2" result="up" />
            <feGaussianBlur in="up" stdDeviation="0.7" result="upb" />
            <feComposite in="SourceAlpha" in2="upb" operator="out" result="lowWall" />
            <feFlood flood-color="#fff" flood-opacity="0.14" />
            <feComposite in2="lowWall" operator="in" result="lit" />
            <feMerge><feMergeNode in="SourceGraphic" /><feMergeNode in="shade" /><feMergeNode in="lit" /></feMerge>
          </filter>
          {/* The same press, deeper, for a phone: small type needs more to read as pressed. */}
          <filter id="tmke-gate-press-sm" x="-10%" y="-30%" width="120%" height="160%" color-interpolation-filters="sRGB">
            <feOffset in="SourceAlpha" dx="1.3" dy="1.6" result="dn" />
            <feGaussianBlur in="dn" stdDeviation="0.8" result="dnb" />
            <feComposite in="SourceAlpha" in2="dnb" operator="out" result="topWall" />
            <feFlood flood-color="#000" flood-opacity="0.78" />
            <feComposite in2="topWall" operator="in" result="shade" />
            <feOffset in="SourceAlpha" dx="-1" dy="-1.2" result="up" />
            <feGaussianBlur in="up" stdDeviation="0.7" result="upb" />
            <feComposite in="SourceAlpha" in2="upb" operator="out" result="lowWall" />
            <feFlood flood-color="#fff" flood-opacity="0.3" />
            <feComposite in2="lowWall" operator="in" result="lit" />
            <feMerge><feMergeNode in="SourceGraphic" /><feMergeNode in="shade" /><feMergeNode in="lit" /></feMerge>
          </filter>
        </svg>
        <div class="tmke-gate-words">
          <span class="tmke-gate-mark">The Studio</span>
          <span class="tmke-gate-sub">TMKE</span>
        </div>
        <div class="tmke-gate-paper"></div>
      </div>
    )}
    {readyGate && (
      <script is:inline>
        (function () {
          var g = document.querySelector(".tmke-gate"), tries = 0;
          if (!g || !document.fonts) return;
          (function look() {
            try { document.fonts.load('400 40px "The Seasons"'); } catch (_) {}
            /* Not fonts.check(): that also says yes before the font's
               stylesheet has even arrived, when it has no face to look for. */
            var ready = false;
            try { document.fonts.forEach(function (f) { if (String(f.family).replace(/["']/g, "") === "The Seasons" && f.status === "loaded") ready = true; }); } catch (_) {}
            if (ready) { g.classList.add("has-type"); return; }
            if (++tries < 40) setTimeout(look, 100);
          })();
        })();
      </script>
    )}
    {!hideNav && <Nav />}
    <slot />
    {!hideFooter && <Footer />}
    {!hideNav && !hideFooter && <NewsPop />}

    {/* Signed-in awareness for every login control (incl. the deck pages). */}
    <LoginState />

    {/* Front-end page-transition overlay — one burgundy sheet that fades up
        over the page, carrying the embossed wordmark artwork. */}
    {
      enableTransition && (
        <div class="pt" id="page-transition" aria-hidden="true">
          <div class="pt__veil" />
        </div>
      )
    }

    <!-- Static film-grain overlay — sits above the page, below the nav, adding
         a subtle texture across the whole site. Pointer-events: none so it
         never intercepts clicks. -->
    <div class="site-grain" aria-hidden="true"></div>

    <!-- Sign-in splash overlay — fired by window.tmkeSplash().
         All-CSS animation: aurora gradient, drifting confetti shapes, and
         a marquee wordmark. No video, no images — runs on any connection. -->
    <div class="splash" id="tmke-splash" aria-hidden="true">
      <div class="splash-glow"></div>
      <div class="splash-inner">
        <div class="splash-eyebrow">Members Only</div>
        <h1 class="splash-title">Studio&nbsp;Hub</h1>
        <p class="splash-sub">Built for better marketing</p>
        <div class="splash-dots" aria-hidden="true"><span></span><span></span><span></span></div>
      </div>
    </div>

    <script is:inline>
      window.tmkeSplash = function (destination, opts) {
        opts = opts || {};
        // CSS animation only — no video to wait on. Total runtime is short
        // and predictable: HOLD is how long the splash holds on screen.
        const HOLD = opts.duration || 2600;
        const splash = document.getElementById("tmke-splash");
        if (!splash) { window.location.href = destination; return; }

        splash.classList.add("is-on");
        document.documentElement.style.overflow = "hidden";

        setTimeout(function () {
          window.location.href = destination;
        }, HOLD);
      };
    </script>

    <script src="/scripts/app.js" is:inline></script>
    {enableTransition && <script src="/scripts/page-transition.js" is:inline />}

    <!-- Website Editor — Supabase bridge. Exposes window.tmkeStore (auth +
         per-page draft/published overrides) for the editor below. Falls back
         to localStorage when Supabase env vars aren't set. Requires a
         `site_overrides` table (see docs/website-editor-setup.md). -->
    <script>
      import { supabase, isConfigured } from "../lib/supabase.js";
      const TABLE = "site_overrides";
      const path = () => (location.pathname.replace(/\/+$/, "") || "/");
      window.tmkeStore = {
        configured: isConfigured,
        async hasSession() {
          try { const { data } = await supabase.auth.getSession(); return !!(data && data.session); }
          catch (e) { return false; }
        },
        async loadPublished() {
          try { const { data } = await supabase.from(TABLE).select("published").eq("path", path()).maybeSingle(); return (data && data.published) || {}; }
          catch (e) { return {}; }
        },
        async loadDraft() {
          try { const { data } = await supabase.from(TABLE).select("draft,published").eq("path", path()).maybeSingle(); return data ? (data.draft || data.published || {}) : {}; }
          catch (e) { return {}; }
        },
        async saveDraft(map) {
          try { await supabase.from(TABLE).upsert({ path: path(), draft: map, updated_at: new Date().toISOString() }, { onConflict: "path" }); } catch (e) {}
        },
        async publish(map) {
          const { error } = await supabase.from(TABLE).upsert({ path: path(), draft: map, published: map, updated_at: new Date().toISOString() }, { onConflict: "path" });
          if (error) throw error;
        },
        async uploadImage(file) {
          const ext = (file.name.split(".").pop() || "png").toLowerCase();
          const key = "uploads/" + Date.now() + "-" + Math.random().toString(36).slice(2, 8) + "." + ext;
          const { error } = await supabase.storage.from("site-media").upload(key, file, { cacheControl: "31536000", upsert: false });
          if (error) throw error;
          const { data } = supabase.storage.from("site-media").getPublicUrl(key);
          return data.publicUrl;
        },
        async listImages() {
          try {
            const { data } = await supabase.storage.from("site-media").list("uploads", { limit: 100, sortBy: { column: "created_at", order: "desc" } });
            return (data || []).map((f) => supabase.storage.from("site-media").getPublicUrl("uploads/" + f.name).data.publicUrl);
          } catch (e) { return []; }
        },
      };
      window.dispatchEvent(new Event("tmke:store-ready"));
    </script>

    <!-- Website Editor — RE-ENABLED for client editing across every page.
         Because this loader lives in BaseLayout, it applies to all pages (home,
         about, services, contact, ...) — not just the home page. Edit mode is
         gated by the ?edit query param + a Supabase login at /admin/login; the
         editor stores changes in the `site_overrides` table per page path as a
         draft, and only applies them to live visitors once "Publish" is used.

         REVERT / CLEAN-SLATE NOTES:
         - Design CODE baseline is git tag `clean-baseline-2026-06-02`.
         - Client CONTENT edits live in Supabase `site_overrides` (NOT in git),
           so reverting code does not undo published edits. To roll content
           back, use the editor's Restore / ResetAll, or clear the table's
           `published` (and `draft`) columns for the affected path.
         - This loader re-applies any rows already PUBLISHED in `site_overrides`.
           Confirm that table is empty before deploying so we start clean. -->
    <script src="/scripts/visual-editor.js" is:inline></script>

    <!-- Cookie / analytics consent banner (PECR). Shown on every front-end page
         until the visitor chooses (incl. chrome-less landing pages, so a direct
         arrival can still consent). Essential cookies (auth, security) are
         exempt; analytics in track.js stays off until "Accept all". -->
    <div class="cc-banner" id="cc-banner" hidden role="dialog" aria-label="Cookie consent" aria-live="polite">
      <div class="cc-inner">
        <p class="cc-text">
          We use essential cookies to make this site work and, with your consent, analytics to
          understand how it's used. See our <a href="/cookies">Cookie Policy</a> and
          <a href="/privacy">Privacy Policy</a>.
        </p>
        <div class="cc-actions">
          <button type="button" class="cc-btn cc-btn-ghost" id="cc-reject">Reject non-essential</button>
          <button type="button" class="cc-btn cc-btn-solid" id="cc-accept">Accept all</button>
        </div>
      </div>
    </div>

    <style>
      .cc-banner {
        position: fixed; left: 0; right: 0; bottom: 0; z-index: 9600;
        display: flex; justify-content: center; padding: 16px; pointer-events: none;
      }
      .cc-banner[hidden] { display: none; }
      .cc-inner {
        pointer-events: auto; width: 100%; max-width: 880px;
        display: flex; align-items: center; gap: 18px; flex-wrap: wrap;
        background: var(--ink, #1c1d22); color: #fff;
        border-radius: 14px; padding: 16px 20px;
        box-shadow: 0 18px 50px -12px rgba(0,0,0,0.5);
      }
      .cc-text {
        flex: 1 1 320px; margin: 0;
        font-family: var(--sans); font-size: 15px; line-height: 1.5; color: rgba(255,255,255,0.85);
      }
      .cc-text a { color: #fff; text-decoration: underline; }
      .cc-actions { display: flex; gap: 10px; flex: 0 0 auto; }
      .cc-btn {
        font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.04em;
        padding: 11px 18px; border-radius: 999px; cursor: pointer; border: 1px solid transparent;
        white-space: nowrap; transition: background 0.18s, color 0.18s, border-color 0.18s;
      }
      .cc-btn-ghost { background: transparent; color: #fff; border-color: rgba(255,255,255,0.4); }
      .cc-btn-ghost:hover { background: rgba(255,255,255,0.12); }
      .cc-btn-solid { background: #fff; color: var(--ink, #1c1d22); }
      .cc-btn-solid:hover { background: rgba(255,255,255,0.85); }
      @media (max-width: 560px) {
        .cc-inner { flex-direction: column; align-items: stretch; gap: 14px; }
        /* The 320px flex-basis is a WIDTH in the row layout above; once the
           box is a column it became a 320px HEIGHT, and the banner stood
           taller than the phone's screen with nothing in it. */
        .cc-text { flex: 0 0 auto; font-size: 14px; }
        .cc-actions { justify-content: stretch; }
        .cc-btn { flex: 1; }
      }
    </style>

    <!-- First-party analytics, gated behind consent. The banner re-fires the
         pageview after the visitor accepts. -->
    <script>
      import { trackPageview } from "../lib/track.js";
      import { getConsent, setConsent } from "../lib/consent.js";

      const banner = document.getElementById("cc-banner");
      const show = () => { if (banner) banner.hidden = false; };
      const hide = () => { if (banner) banner.hidden = true; };

      const choice = getConsent();
      if (choice === "granted") trackPageview();
      else if (choice === null) show(); // undecided → ask (denied → stay quiet)

      document.getElementById("cc-accept")?.addEventListener("click", () => {
        setConsent("granted"); hide(); trackPageview();
      });
      document.getElementById("cc-reject")?.addEventListener("click", () => {
        setConsent("denied"); hide();
      });

      // Let a "Cookie settings" link anywhere on the page reopen the banner so a
      // choice can be changed as easily as it was given.
      window.tmkeCookieSettings = show;
      document.querySelectorAll("[data-cookie-settings]").forEach((el) => {
        el.addEventListener("click", (e) => { e.preventDefault(); show(); });
      });
    </script>
  </body>
</html>
