---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Override the canonical/og url. Defaults to Astro.url. */
  canonical?: string;
  /** Path to a 1200×630 OG image (relative to /public). */
  ogImage?: string;
  /** Hide the global nav (rarely useful — e.g. checkout pages later). */
  hideNav?: boolean;
  /** Hide the global footer. */
  hideFooter?: boolean;
}

const {
  title = "TMKE — The Marketing Experts",
  description = "A specialist social media and marketing agency for the UK property sector. Premium templates, fully managed channels, structured content.",
  canonical = Astro.url.href,
  ogImage = "/assets/hero.png",
  hideNav = false,
  hideFooter = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Splash assets are prefetched on-demand (Nav.astro warms them on
         hover/focus of the Login button) so we don't burn ~11 MB on every
         page load. /login preloads the closed still directly since it's
         the page background. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Darker+Grotesque:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Lenis — smooth, momentum-based scrolling.
         `defer` makes the CDN fetch non-blocking; Lenis still runs after
         DOMContentLoaded which is fine for scroll enhancement. -->
    <script
      defer
      src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"
      is:inline></script>
  </head>
  <body>
    {!hideNav && <Nav />}
    <slot />
    {!hideFooter && <Footer />}

    <!-- Sign-in splash overlay — fired by window.tmkeSplash().
         All-CSS animation: aurora gradient, drifting confetti shapes, and
         a marquee wordmark. No video, no images — runs on any connection. -->
    <div class="splash" id="tmke-splash" aria-hidden="true">
      <div class="splash-aurora">
        <span class="splash-blob splash-blob--1"></span>
        <span class="splash-blob splash-blob--2"></span>
        <span class="splash-blob splash-blob--3"></span>
        <span class="splash-blob splash-blob--4"></span>
      </div>
      <div class="splash-confetti" aria-hidden="true">
        <!-- Twelve geometric pieces drifting up the screen -->
        <span class="splash-shape splash-shape--dot"   style="--x:8%;  --d:0.0s; --s:18px;"></span>
        <span class="splash-shape splash-shape--ring"  style="--x:18%; --d:0.5s; --s:34px;"></span>
        <span class="splash-shape splash-shape--bar"   style="--x:28%; --d:0.2s; --s:42px;"></span>
        <span class="splash-shape splash-shape--dot"   style="--x:38%; --d:0.9s; --s:14px;"></span>
        <span class="splash-shape splash-shape--ring"  style="--x:48%; --d:0.0s; --s:54px;"></span>
        <span class="splash-shape splash-shape--bar"   style="--x:55%; --d:0.7s; --s:60px;"></span>
        <span class="splash-shape splash-shape--dot"   style="--x:64%; --d:0.3s; --s:24px;"></span>
        <span class="splash-shape splash-shape--ring"  style="--x:72%; --d:1.1s; --s:30px;"></span>
        <span class="splash-shape splash-shape--bar"   style="--x:82%; --d:0.4s; --s:48px;"></span>
        <span class="splash-shape splash-shape--dot"   style="--x:90%; --d:0.0s; --s:20px;"></span>
        <span class="splash-shape splash-shape--ring"  style="--x:96%; --d:0.6s; --s:38px;"></span>
        <span class="splash-shape splash-shape--bar"   style="--x:13%; --d:1.2s; --s:36px;"></span>
      </div>
      <div class="splash-grain"></div>
      <div class="splash-inner">
        <div class="splash-eyebrow"><span>TMKE</span> &mdash; Members</div>
        <h1 class="splash-title">
          <span class="splash-word"><span>Welcome</span></span>
          <span class="splash-word"><span>to <em>good style.</em></span></span>
        </h1>
        <p class="splash-sub">Opening your library&hellip;</p>
        <div class="splash-bar"><div class="splash-bar-fill"></div></div>
      </div>
    </div>

    <script is:inline>
      window.tmkeSplash = function (destination, opts) {
        opts = opts || {};
        // CSS animation only — no video to wait on. Total runtime is short
        // and predictable: HOLD is how long the splash holds on screen.
        const HOLD = opts.duration || 2600;
        const splash = document.getElementById("tmke-splash");
        if (!splash) { window.location.href = destination; return; }

        splash.classList.add("is-on");
        document.documentElement.style.overflow = "hidden";

        setTimeout(function () {
          window.location.href = destination;
        }, HOLD);
      };
    </script>

    <script src="/scripts/app.js" is:inline></script>
  </body>
</html>
