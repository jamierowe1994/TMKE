---
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Override the canonical/og url. Defaults to Astro.url. */
  canonical?: string;
  /** Path to a 1200×630 OG image (relative to /public). */
  ogImage?: string;
  /** Hide the global nav (rarely useful — e.g. checkout pages later). */
  hideNav?: boolean;
  /** Hide the global footer. */
  hideFooter?: boolean;
  /** Emit robots noindex,nofollow — for hidden / WIP pages. */
  noindex?: boolean;
}

const {
  title = "TMKE — The Marketing Experts",
  description = "A specialist social media and marketing agency for the UK property sector. Premium templates, fully managed channels, structured content.",
  canonical = Astro.url.href,
  ogImage = "/assets/hero.png",
  hideNav = false,
  hideFooter = false,
  noindex = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).href} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).href} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Splash assets are prefetched on-demand (Nav.astro warms them on
         hover/focus of the Login button) so we don't burn ~11 MB on every
         page load. /login preloads the closed still directly since it's
         the page background. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Darker+Grotesque:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Lenis — smooth, momentum-based scrolling.
         `defer` makes the CDN fetch non-blocking; Lenis still runs after
         DOMContentLoaded which is fine for scroll enhancement. -->
    <script
      defer
      src="https://unpkg.com/lenis@1.1.20/dist/lenis.min.js"
      is:inline></script>
  </head>
  <body>
    {!hideNav && <Nav />}
    <slot />
    {!hideFooter && <Footer />}

    <!-- Sign-in splash overlay — fired by window.tmkeSplash().
         All-CSS animation: aurora gradient, drifting confetti shapes, and
         a marquee wordmark. No video, no images — runs on any connection. -->
    <div class="splash" id="tmke-splash" aria-hidden="true">
      <div class="splash-aurora">
        <span class="splash-blob splash-blob--1"></span>
        <span class="splash-blob splash-blob--2"></span>
        <span class="splash-blob splash-blob--3"></span>
        <span class="splash-blob splash-blob--4"></span>
      </div>
      <div class="splash-confetti" aria-hidden="true">
        <!-- Social icons drifting up the screen. Five platforms cycled
             across twelve positions so the screen feels populated without
             obvious repetition. Each SVG inherits currentColor + size from
             .splash-icon so positioning stays in the inline style. -->
        <span class="splash-icon" style="--x:8%;  --d:0.0s; --s:28px;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H8v-2.89h2.44V9.79c0-2.41 1.44-3.75 3.64-3.75 1.05 0 2.15.19 2.15.19v2.36h-1.21c-1.19 0-1.57.74-1.57 1.5v1.8h2.67l-.43 2.89h-2.24v6.99A10 10 0 0 0 22 12z"/></svg>
        </span>
        <span class="splash-icon" style="--x:18%; --d:0.5s; --s:38px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
        </span>
        <span class="splash-icon" style="--x:28%; --d:0.2s; --s:34px;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.36-1.85c3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
        </span>
        <span class="splash-icon" style="--x:38%; --d:0.9s; --s:24px;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82a4.28 4.28 0 0 1-1.06-2.82h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.6 2.6 0 0 1-2.6-2.6c0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z"/></svg>
        </span>
        <span class="splash-icon" style="--x:48%; --d:0.0s; --s:42px;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3.02 3.02 0 0 0-2.13-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.37.56A3.02 3.02 0 0 0 .5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3.02 3.02 0 0 0 2.13 2.14C4.5 20.5 12 20.5 12 20.5s7.5 0 9.37-.56a3.02 3.02 0 0 0 2.13-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.8zM9.6 15.6V8.4l6.24 3.6-6.24 3.6z"/></svg>
        </span>
        <span class="splash-icon" style="--x:55%; --d:0.7s; --s:32px;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H8v-2.89h2.44V9.79c0-2.41 1.44-3.75 3.64-3.75 1.05 0 2.15.19 2.15.19v2.36h-1.21c-1.19 0-1.57.74-1.57 1.5v1.8h2.67l-.43 2.89h-2.24v6.99A10 10 0 0 0 22 12z"/></svg>
        </span>
        <span class="splash-icon" style="--x:64%; --d:0.3s; --s:26px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
        </span>
        <span class="splash-icon" style="--x:72%; --d:1.1s; --s:36px;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.02-3.04-1.85-3.04-1.85 0-2.13 1.45-2.13 2.94v5.67H9.36V9h3.41v1.56h.05a3.74 3.74 0 0 1 3.36-1.85c3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
        </span>
        <span class="splash-icon" style="--x:82%; --d:0.4s; --s:30px;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M16.6 5.82a4.28 4.28 0 0 1-1.06-2.82h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5 2.6 2.6 0 0 1-2.6-2.6c0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z"/></svg>
        </span>
        <span class="splash-icon" style="--x:90%; --d:0.0s; --s:32px;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3.02 3.02 0 0 0-2.13-2.14C19.5 3.5 12 3.5 12 3.5s-7.5 0-9.37.56A3.02 3.02 0 0 0 .5 6.2C0 8.07 0 12 0 12s0 3.93.5 5.8a3.02 3.02 0 0 0 2.13 2.14C4.5 20.5 12 20.5 12 20.5s7.5 0 9.37-.56a3.02 3.02 0 0 0 2.13-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.8zM9.6 15.6V8.4l6.24 3.6-6.24 3.6z"/></svg>
        </span>
        <span class="splash-icon" style="--x:96%; --d:0.6s; --s:28px;">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H8v-2.89h2.44V9.79c0-2.41 1.44-3.75 3.64-3.75 1.05 0 2.15.19 2.15.19v2.36h-1.21c-1.19 0-1.57.74-1.57 1.5v1.8h2.67l-.43 2.89h-2.24v6.99A10 10 0 0 0 22 12z"/></svg>
        </span>
        <span class="splash-icon" style="--x:13%; --d:1.2s; --s:34px;">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1.2" fill="currentColor" stroke="none"/></svg>
        </span>
      </div>
      <div class="splash-grain"></div>
      <div class="splash-inner">
        <div class="splash-eyebrow">Members</div>
        <h1 class="splash-title">
          <span class="splash-word"><span>Welcome</span></span>
          <span class="splash-word"><span>to <em>good style.</em></span></span>
        </h1>
        <p class="splash-sub">Opening your library&hellip;</p>
        <div class="splash-bar"><div class="splash-bar-fill"></div></div>
      </div>
    </div>

    <script is:inline>
      window.tmkeSplash = function (destination, opts) {
        opts = opts || {};
        // CSS animation only — no video to wait on. Total runtime is short
        // and predictable: HOLD is how long the splash holds on screen.
        const HOLD = opts.duration || 2600;
        const splash = document.getElementById("tmke-splash");
        if (!splash) { window.location.href = destination; return; }

        splash.classList.add("is-on");
        document.documentElement.style.overflow = "hidden";

        setTimeout(function () {
          window.location.href = destination;
        }, HOLD);
      };
    </script>

    <script src="/scripts/app.js" is:inline></script>

    <!-- Website Editor — Supabase bridge. Exposes window.tmkeStore (auth +
         per-page draft/published overrides) for the editor below. Falls back
         to localStorage when Supabase env vars aren't set. Requires a
         `site_overrides` table (see docs/website-editor-setup.md). -->
    <script>
      import { supabase, isConfigured } from "../lib/supabase.js";
      const TABLE = "site_overrides";
      const path = () => (location.pathname.replace(/\/+$/, "") || "/");
      window.tmkeStore = {
        configured: isConfigured,
        async hasSession() {
          try { const { data } = await supabase.auth.getSession(); return !!(data && data.session); }
          catch (e) { return false; }
        },
        async loadPublished() {
          try { const { data } = await supabase.from(TABLE).select("published").eq("path", path()).maybeSingle(); return (data && data.published) || {}; }
          catch (e) { return {}; }
        },
        async loadDraft() {
          try { const { data } = await supabase.from(TABLE).select("draft,published").eq("path", path()).maybeSingle(); return data ? (data.draft || data.published || {}) : {}; }
          catch (e) { return {}; }
        },
        async saveDraft(map) {
          try { await supabase.from(TABLE).upsert({ path: path(), draft: map, updated_at: new Date().toISOString() }, { onConflict: "path" }); } catch (e) {}
        },
        async publish(map) {
          const { error } = await supabase.from(TABLE).upsert({ path: path(), draft: map, published: map, updated_at: new Date().toISOString() }, { onConflict: "path" });
          if (error) throw error;
        },
        async uploadImage(file) {
          const ext = (file.name.split(".").pop() || "png").toLowerCase();
          const key = "uploads/" + Date.now() + "-" + Math.random().toString(36).slice(2, 8) + "." + ext;
          const { error } = await supabase.storage.from("site-media").upload(key, file, { cacheControl: "31536000", upsert: false });
          if (error) throw error;
          const { data } = supabase.storage.from("site-media").getPublicUrl(key);
          return data.publicUrl;
        },
        async listImages() {
          try {
            const { data } = await supabase.storage.from("site-media").list("uploads", { limit: 100, sortBy: { column: "created_at", order: "desc" } });
            return (data || []).map((f) => supabase.storage.from("site-media").getPublicUrl("uploads/" + f.name).data.publicUrl);
          } catch (e) { return []; }
        },
      };
      window.dispatchEvent(new Event("tmke:store-ready"));
    </script>

    <!-- Website Editor — RE-ENABLED for client editing across every page.
         Because this loader lives in BaseLayout, it applies to all pages (home,
         about, services, contact, ...) — not just the home page. Edit mode is
         gated by the ?edit query param + a Supabase login at /admin/login; the
         editor stores changes in the `site_overrides` table per page path as a
         draft, and only applies them to live visitors once "Publish" is used.

         REVERT / CLEAN-SLATE NOTES:
         - Design CODE baseline is git tag `clean-baseline-2026-06-02`.
         - Client CONTENT edits live in Supabase `site_overrides` (NOT in git),
           so reverting code does not undo published edits. To roll content
           back, use the editor's Restore / ResetAll, or clear the table's
           `published` (and `draft`) columns for the affected path.
         - This loader re-applies any rows already PUBLISHED in `site_overrides`.
           Confirm that table is empty before deploying so we start clean. -->
    <script src="/scripts/visual-editor.js" is:inline></script>
  </body>
</html>
