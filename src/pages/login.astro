---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sign in — TMKE"
  description="Sign in to access your purchased template packs and downloads."
  hideFooter={true}
>
  <!-- Slide-up curtain that animates the user from /login to /edit -->
  <div class="login-curtain" id="login-curtain" aria-hidden="true">
    <div class="login-curtain-inner">
      <div class="login-curtain-eyebrow">Now opening</div>
      <div class="login-curtain-title">The Edit<span>.</span></div>
    </div>
  </div>

  <main class="login-shell">
    <div class="login-art" aria-hidden="true">
      <div class="login-art-overlay"></div>
      <div class="login-art-quote">
        <div class="chapter chapter--light">Members &middot; Sign in</div>
        <p class="login-art-line">
          Your library, <em>your studio,</em><br />always to hand.
        </p>
        <p class="login-art-sub">
          Every pack you've purchased — ready to open, edit and post.
        </p>
      </div>
    </div>

    <section class="login-panel">
      <a href="/" class="login-mark">TMKE</a>

      <div class="login-card">
        <div class="eyebrow">Welcome back</div>
        <h1 class="login-title">Sign in to your library</h1>
        <p class="login-sub">
          Enter your details below. Don't have an account?
          <a href="/edit" class="login-inline-link">Browse The Edit</a>.
        </p>

        <form id="login-form" class="login-form" novalidate>
          <label class="login-field">
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required placeholder="you@agency.co.uk" />
          </label>

          <label class="login-field">
            <span>Password</span>
            <input type="password" name="password" autocomplete="current-password" required placeholder="••••••••" />
          </label>

          <div class="login-row">
            <label class="login-check">
              <input type="checkbox" name="remember" checked />
              <span>Keep me signed in</span>
            </label>
            <a href="#" class="login-forgot">Forgot password?</a>
          </div>

          <button type="submit" class="btn btn--solid login-submit">
            Sign in <span class="btn-arrow">&rarr;</span>
          </button>

          <p id="login-error" class="login-error" hidden></p>

          <div class="login-divider"><span>or</span></div>

          <button type="button" class="login-sso" id="login-demo">
            Browse The Edit instead
          </button>

          <p class="login-hint">
            New here? <em>Buy a pack on The Edit and you'll be prompted to set a password — that's your account.</em>
          </p>
        </form>
      </div>

      <p class="login-meta">© 2026 TMKE — The Marketing Experts</p>
    </section>
  </main>

  <style>
    main.login-shell {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      min-height: 100vh;
      background: var(--paper);
    }

    .login-art {
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(180deg, rgba(28,29,34,0.25), rgba(28,29,34,0.75)),
        url("https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=1400&q=80") center/cover;
      color: var(--paper);
    }
    .login-art-overlay {
      position: absolute; inset: 0;
      background:
        radial-gradient(80% 60% at 50% 40%, rgba(0,0,0,0) 30%, rgba(0,0,0,0.35) 100%);
      pointer-events: none;
    }
    .login-art-quote {
      position: absolute;
      inset: auto 0 0 0;
      padding: 0 56px 80px;
    }
    .login-art-quote .chapter { margin-bottom: 48px; }
    .login-art-line {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(40px, 4.4vw, 68px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      margin: 0 0 18px;
      color: var(--paper);
      max-width: 12ch;
    }
    .login-art-line em { font-style: italic; color: var(--french-grey); }
    .login-art-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: 20px;
      line-height: 1.45;
      color: rgba(240, 238, 235, 0.72);
      max-width: 38ch;
    }

    .login-panel {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 48px 36px;
    }
    .login-mark {
      position: absolute;
      top: 32px;
      left: 36px;
      font-family: var(--serif);
      font-size: 24px;
      letter-spacing: 0.06em;
      color: var(--ink);
    }

    .login-card {
      width: 100%;
      max-width: 440px;
    }
    .login-card .eyebrow { margin-bottom: 14px; }
    .login-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(36px, 3.6vw, 52px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      color: var(--ink);
      margin: 0 0 18px;
    }
    .login-sub {
      font-size: 15px;
      color: rgba(28, 29, 34, 0.62);
      margin: 0 0 36px;
    }
    .login-inline-link {
      color: var(--english-violet);
      border-bottom: 1px solid currentColor;
    }

    .login-form { display: flex; flex-direction: column; gap: 18px; }
    .login-field { display: flex; flex-direction: column; gap: 8px; }
    .login-field > span {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.55);
    }
    .login-field input {
      font-family: var(--sans);
      font-size: 16px;
      padding: 14px 16px;
      border: 1px solid rgba(28, 29, 34, 0.18);
      border-radius: 2px;
      background: #fff;
      color: var(--ink);
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .login-field input:focus {
      outline: none;
      border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(71, 66, 84, 0.12);
    }

    .login-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: rgba(28, 29, 34, 0.7);
    }
    .login-check { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
    .login-check input { accent-color: var(--english-violet); }
    .login-forgot {
      color: var(--english-violet);
      font-weight: 600;
    }
    .login-forgot:hover { text-decoration: underline; }

    .login-submit {
      width: 100%;
      justify-content: center;
      padding: 16px;
      margin-top: 8px;
    }

    .login-divider {
      display: flex; align-items: center;
      gap: 16px;
      color: rgba(28, 29, 34, 0.4);
      font-size: 12px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin: 8px 0;
    }
    .login-divider::before, .login-divider::after {
      content: ""; flex: 1; height: 1px;
      background: rgba(28, 29, 34, 0.12);
    }

    .login-sso {
      width: 100%;
      padding: 14px;
      font-family: var(--sans);
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: transparent;
      border: 1px solid rgba(28, 29, 34, 0.25);
      border-radius: 1px;
      cursor: pointer;
      color: var(--ink);
      transition: background 0.3s, border-color 0.3s;
    }
    .login-sso:hover {
      background: rgba(71, 66, 84, 0.06);
      border-color: var(--english-violet);
    }

    .login-error {
      font-size: 13px;
      color: #a05a3c;
      background: rgba(160, 90, 60, 0.08);
      padding: 10px 14px;
      border-radius: 2px;
      margin: 0;
    }

    .login-hint {
      font-size: 12px;
      color: rgba(28, 29, 34, 0.5);
      line-height: 1.5;
      margin: 8px 0 0;
      padding: 14px 16px;
      background: rgba(71, 66, 84, 0.06);
      border-radius: 2px;
    }
    .login-hint strong { color: var(--english-violet); font-weight: 700; }
    .login-hint em { font-style: italic; color: rgba(28, 29, 34, 0.7); }

    .login-meta {
      position: absolute;
      bottom: 32px;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.35);
    }

    @media (max-width: 900px) {
      main.login-shell { grid-template-columns: 1fr; }
      .login-art { display: none; }
    }

    /* ============ Browse-packs slide-up curtain ============ */
    .login-curtain {
      position: fixed;
      inset: 0;
      z-index: 200;
      background: var(--paper);
      transform: translateY(100%);
      transition: transform 0.85s cubic-bezier(.7,0,.2,1);
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .login-curtain::before {
      content: "";
      position: absolute; inset: 0;
      background:
        linear-gradient(180deg, rgba(28,29,34,0.18), rgba(28,29,34,0.55)),
        url("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80") center/cover;
      opacity: 0;
      transition: opacity 0.6s 0.2s ease-out;
    }
    .login-curtain.is-up {
      transform: translateY(0);
      pointer-events: auto;
    }
    .login-curtain.is-up::before { opacity: 1; }
    .login-curtain-inner {
      position: relative;
      z-index: 1;
      text-align: center;
      color: var(--paper);
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.6s 0.45s ease-out, transform 0.6s 0.45s cubic-bezier(.2,.7,.2,1);
    }
    .login-curtain.is-up .login-curtain-inner {
      opacity: 1;
      transform: translateY(0);
    }
    .login-curtain-eyebrow {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 24px;
      opacity: 0.7;
    }
    .login-curtain-title {
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(56px, 9vw, 132px);
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .login-curtain-title span { color: var(--english-violet); }
  </style>

  <script>
    import { supabase } from "../lib/supabase.js";

    const form = document.getElementById("login-form");
    const errorEl = document.getElementById("login-error");
    const demoBtn = document.getElementById("login-demo");

    // Route a freshly-authed user to their destination, taking them through
    // the brand-kit setup on first sign-in and fronting it with the splash.
    function routeAfterSignIn() {
      const nextParam = new URLSearchParams(location.search).get("next");
      let firstTime = false;
      try {
        firstTime = !localStorage.getItem("tmke.brand") && !localStorage.getItem("tmke.brand.skipped");
      } catch (_) { /* ignore */ }
      const fallback = firstTime ? "/profile?next=/account" : "/account";
      const dest = nextParam || fallback;
      if (typeof window.tmkeSplash === "function") {
        window.tmkeSplash(dest);
      } else {
        window.location.href = dest;
      }
    }

    // If already signed in, skip the form.
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) routeAfterSignIn();
    })();

    function showError(msg) {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const data = new FormData(form);
      const email = String(data.get("email") || "").trim();
      const password = String(data.get("password") || "").trim();
      if (!email || !password) {
        showError("Enter an email and password to sign in.");
        return;
      }
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        showError(error.message);
        return;
      }
      routeAfterSignIn();
    });

    // No account yet — slide the paper curtain up over the login, then
    // navigate to The Edit. Gives the transition a deliberate, theatrical feel.
    const curtain = document.getElementById("login-curtain");
    demoBtn.addEventListener("click", () => {
      if (curtain) {
        curtain.classList.add("is-up");
        document.documentElement.style.overflow = "hidden";
        setTimeout(() => { window.location.href = "/edit"; }, 1100);
      } else {
        window.location.href = "/edit";
      }
    });
  </script>
</BaseLayout>
