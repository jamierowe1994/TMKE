---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sign in — TMKE"
  description="Sign in to access your purchased template packs and downloads."
  hideFooter={true}
>
  <main class="login-shell">
    <div class="login-art" aria-hidden="true">
      <div class="login-art-overlay"></div>
      <div class="login-art-quote">
        <div class="chapter chapter--light">Members &middot; Sign in</div>
        <p class="login-art-line">
          Your library, <em>your studio,</em><br />always to hand.
        </p>
        <p class="login-art-sub">
          Every pack you've purchased — ready to open, edit and post.
        </p>
      </div>
    </div>

    <section class="login-panel">
      <a href="/" class="login-mark">TMKE</a>

      <div class="login-card">
        <div class="eyebrow">Welcome back</div>
        <h1 class="login-title">Sign in to your library</h1>
        <p class="login-sub">
          Enter your details below. Don't have an account?
          <a href="/edit" class="login-inline-link">Browse The Edit</a>.
        </p>

        <form id="login-form" class="login-form" novalidate>
          <label class="login-field">
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required placeholder="you@agency.co.uk" />
          </label>

          <label class="login-field">
            <span>Password</span>
            <input type="password" name="password" autocomplete="current-password" required placeholder="••••••••" />
          </label>

          <div class="login-row">
            <label class="login-check">
              <input type="checkbox" name="remember" checked />
              <span>Keep me signed in</span>
            </label>
            <a href="#" class="login-forgot">Forgot password?</a>
          </div>

          <button type="submit" class="btn btn--solid login-submit">
            Sign in <span class="btn-arrow">&rarr;</span>
          </button>

          <p id="login-error" class="login-error" hidden></p>

          <div class="login-divider"><span>or</span></div>

          <button type="button" class="login-sso" id="login-demo">
            Continue as demo client
          </button>

          <p class="login-hint">
            <strong>Demo:</strong> use any email + password, or click
            <em>continue as demo client</em>.
          </p>
        </form>
      </div>

      <p class="login-meta">© 2026 TMKE — The Marketing Experts</p>
    </section>
  </main>

  <style>
    main.login-shell {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      min-height: 100vh;
      background: var(--paper);
    }

    .login-art {
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(180deg, rgba(28,29,34,0.25), rgba(28,29,34,0.75)),
        url("https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?auto=format&fit=crop&w=1400&q=80") center/cover;
      color: var(--paper);
    }
    .login-art-overlay {
      position: absolute; inset: 0;
      background:
        radial-gradient(80% 60% at 50% 40%, rgba(0,0,0,0) 30%, rgba(0,0,0,0.35) 100%);
      pointer-events: none;
    }
    .login-art-quote {
      position: absolute;
      inset: auto 0 0 0;
      padding: 0 56px 80px;
    }
    .login-art-quote .chapter { margin-bottom: 48px; }
    .login-art-line {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(40px, 4.4vw, 68px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      margin: 0 0 18px;
      color: var(--paper);
      max-width: 12ch;
    }
    .login-art-line em { font-style: italic; color: var(--french-grey); }
    .login-art-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: 20px;
      line-height: 1.45;
      color: rgba(240, 238, 235, 0.72);
      max-width: 38ch;
    }

    .login-panel {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 48px 36px;
    }
    .login-mark {
      position: absolute;
      top: 32px;
      left: 36px;
      font-family: var(--serif);
      font-size: 24px;
      letter-spacing: 0.06em;
      color: var(--ink);
    }

    .login-card {
      width: 100%;
      max-width: 440px;
    }
    .login-card .eyebrow { margin-bottom: 14px; }
    .login-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(36px, 3.6vw, 52px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      color: var(--ink);
      margin: 0 0 18px;
    }
    .login-sub {
      font-size: 15px;
      color: rgba(28, 29, 34, 0.62);
      margin: 0 0 36px;
    }
    .login-inline-link {
      color: var(--english-violet);
      border-bottom: 1px solid currentColor;
    }

    .login-form { display: flex; flex-direction: column; gap: 18px; }
    .login-field { display: flex; flex-direction: column; gap: 8px; }
    .login-field > span {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.55);
    }
    .login-field input {
      font-family: var(--sans);
      font-size: 16px;
      padding: 14px 16px;
      border: 1px solid rgba(28, 29, 34, 0.18);
      border-radius: 2px;
      background: #fff;
      color: var(--ink);
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .login-field input:focus {
      outline: none;
      border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(71, 66, 84, 0.12);
    }

    .login-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: rgba(28, 29, 34, 0.7);
    }
    .login-check { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
    .login-check input { accent-color: var(--english-violet); }
    .login-forgot {
      color: var(--english-violet);
      font-weight: 600;
    }
    .login-forgot:hover { text-decoration: underline; }

    .login-submit {
      width: 100%;
      justify-content: center;
      padding: 16px;
      margin-top: 8px;
    }

    .login-divider {
      display: flex; align-items: center;
      gap: 16px;
      color: rgba(28, 29, 34, 0.4);
      font-size: 12px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin: 8px 0;
    }
    .login-divider::before, .login-divider::after {
      content: ""; flex: 1; height: 1px;
      background: rgba(28, 29, 34, 0.12);
    }

    .login-sso {
      width: 100%;
      padding: 14px;
      font-family: var(--sans);
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: transparent;
      border: 1px solid rgba(28, 29, 34, 0.25);
      border-radius: 1px;
      cursor: pointer;
      color: var(--ink);
      transition: background 0.3s, border-color 0.3s;
    }
    .login-sso:hover {
      background: rgba(71, 66, 84, 0.06);
      border-color: var(--english-violet);
    }

    .login-error {
      font-size: 13px;
      color: #a05a3c;
      background: rgba(160, 90, 60, 0.08);
      padding: 10px 14px;
      border-radius: 2px;
      margin: 0;
    }

    .login-hint {
      font-size: 12px;
      color: rgba(28, 29, 34, 0.5);
      line-height: 1.5;
      margin: 8px 0 0;
      padding: 14px 16px;
      background: rgba(71, 66, 84, 0.06);
      border-radius: 2px;
    }
    .login-hint strong { color: var(--english-violet); font-weight: 700; }
    .login-hint em { font-style: italic; color: rgba(28, 29, 34, 0.7); }

    .login-meta {
      position: absolute;
      bottom: 32px;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.35);
    }

    @media (max-width: 900px) {
      main.login-shell { grid-template-columns: 1fr; }
      .login-art { display: none; }
    }
  </style>

  <script is:inline>
    (function () {
      const form = document.getElementById("login-form");
      const errorEl = document.getElementById("login-error");
      const demoBtn = document.getElementById("login-demo");

      function signIn(email) {
        const session = {
          email: email || "demo@agency.co.uk",
          name: (email || "demo").split("@")[0].replace(/\./g, " "),
          signedInAt: Date.now(),
        };
        try {
          localStorage.setItem("tmke.session", JSON.stringify(session));
        } catch (e) { /* ignore */ }
        window.location.href = "/account";
      }

      form.addEventListener("submit", function (e) {
        e.preventDefault();
        const data = new FormData(form);
        const email = String(data.get("email") || "").trim();
        const password = String(data.get("password") || "").trim();
        if (!email || !password) {
          errorEl.textContent = "Enter an email and password to sign in.";
          errorEl.hidden = false;
          return;
        }
        signIn(email);
      });

      demoBtn.addEventListener("click", function () {
        signIn("demo@agency.co.uk");
      });
    })();
  </script>
</BaseLayout>
