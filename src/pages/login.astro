---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sign in — TMKE"
  description="Sign in to access your purchased template packs and downloads."
  hideFooter={true}
>
  <main class="login-shell">
    <div class="login-art" aria-hidden="true">
      <div class="login-art-overlay"></div>
      <div class="login-art-quote">
        <div class="chapter chapter--light">Members &middot; Sign in</div>
        <p class="login-art-line">
          Your library, <em>your studio,</em><br />always to hand.
        </p>
        <p class="login-art-sub">
          Every pack you've purchased — ready to open, edit and post.
        </p>
      </div>
    </div>

    <section class="login-panel">
      <a href="/" class="login-mark">TMKE</a>

      <div class="login-card">
        <div class="login-tabs" role="tablist">
          <button type="button" class="login-tab is-active" data-tab="signin" role="tab" aria-selected="true">Sign in</button>
          <button type="button" class="login-tab" data-tab="signup" role="tab" aria-selected="false">Create account</button>
        </div>

        <!-- Sign in -->
        <div class="login-pane is-active" data-pane="signin">
          <div class="eyebrow">Welcome back</div>
          <h1 class="login-title">Sign in to your library</h1>
          <p class="login-sub">
            Enter your details below. New here?
            <button type="button" class="login-inline-link" data-go="signup">Create an account</button>.
          </p>

          <form id="login-form" class="login-form" novalidate>
            <label class="login-field">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required placeholder="you@agency.co.uk" />
            </label>

            <label class="login-field">
              <span>Password</span>
              <input type="password" name="password" autocomplete="current-password" required placeholder="••••••••" />
            </label>

            <div class="login-row">
              <label class="login-check">
                <input type="checkbox" name="remember" checked />
                <span>Keep me signed in</span>
              </label>
              <a href="/forgot-password" class="login-forgot">Forgot password?</a>
            </div>

            <button type="submit" class="btn btn--solid login-submit">
              <span data-label>Sign in</span> <span class="btn-arrow">&rarr;</span>
            </button>

            <p id="login-error" class="login-error" hidden></p>
          </form>
        </div>

        <!-- Sign up -->
        <div class="login-pane" data-pane="signup" hidden>
          <div class="eyebrow">Welcome to TMKE</div>
          <h1 class="login-title">Create your account</h1>
          <p class="login-sub">
            Set up your library so it's ready when you make a purchase.
            Already have one?
            <button type="button" class="login-inline-link" data-go="signin">Sign in</button>.
          </p>

          <form id="signup-form" class="login-form" novalidate>
            <label class="login-field">
              <span>Full name</span>
              <input type="text" name="name" autocomplete="name" required placeholder="Jamie Rowe" />
            </label>

            <label class="login-field">
              <span>Email</span>
              <input type="email" name="email" autocomplete="email" required placeholder="you@agency.co.uk" />
            </label>

            <label class="login-field">
              <span>Password</span>
              <input type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="At least 8 characters" />
            </label>

            <label class="login-check login-check--terms">
              <input type="checkbox" name="terms" required />
              <span>I agree to the <a href="#" class="login-inline-anchor">terms</a> and <a href="#" class="login-inline-anchor">privacy policy</a>.</span>
            </label>

            <button type="submit" class="btn btn--solid login-submit">
              <span data-label>Create account</span> <span class="btn-arrow">&rarr;</span>
            </button>

            <p id="signup-error" class="login-error" hidden></p>
          </form>
        </div>

        <!-- Post-signup confirmation state -->
        <div class="login-pane" data-pane="check-email" hidden>
          <div class="eyebrow">Almost there</div>
          <h1 class="login-title">Check your inbox.</h1>
          <p class="login-sub">
            We've sent a confirmation link to <strong id="signup-email-out"></strong>.
            Click it to verify your address and finish setting up your account.
          </p>
          <p class="login-hint">
            Didn't get it? Check spam — or
            <button type="button" class="login-inline-link" id="resend-confirm">resend the email</button>.
          </p>
        </div>
      </div>

      <p class="login-meta">© 2026 TMKE — The Marketing Experts</p>
    </section>
  </main>

  <style>
    main.login-shell {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      min-height: 100vh;
      background: var(--paper);
    }

    .login-art {
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(180deg, rgba(28,29,34,0.2), rgba(28,29,34,0.7)),
        url("/assets/door-closed.png") center/cover no-repeat;
      color: var(--paper);
    }
    .login-art-overlay {
      position: absolute; inset: 0;
      background:
        radial-gradient(80% 60% at 50% 40%, rgba(0,0,0,0) 30%, rgba(0,0,0,0.35) 100%);
      pointer-events: none;
    }
    .login-art-quote {
      position: absolute;
      inset: auto 0 0 0;
      padding: 0 56px 80px;
    }
    .login-art-quote .chapter { margin-bottom: 48px; }
    .login-art-line {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(40px, 4.4vw, 68px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      margin: 0 0 18px;
      color: var(--paper);
      max-width: 12ch;
    }
    .login-art-line em { font-style: italic; color: var(--french-grey); }
    .login-art-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: 20px;
      line-height: 1.45;
      color: rgba(240, 238, 235, 0.72);
      max-width: 38ch;
    }

    .login-panel {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 48px 36px;
    }
    .login-mark {
      position: absolute;
      top: 32px;
      left: 36px;
      font-family: var(--serif);
      font-size: 24px;
      letter-spacing: 0.06em;
      color: var(--ink);
    }

    .login-card {
      width: 100%;
      max-width: 440px;
    }
    .login-card .eyebrow { margin-bottom: 14px; }

    .login-tabs {
      display: inline-flex;
      gap: 0;
      margin-bottom: 36px;
      border-bottom: 1px solid rgba(28, 29, 34, 0.12);
    }
    .login-tab {
      padding: 10px 0;
      margin-right: 28px;
      background: transparent;
      border: 0;
      border-bottom: 2px solid transparent;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.45);
      cursor: pointer;
      transition: color 0.2s, border-color 0.2s;
    }
    .login-tab:hover { color: var(--ink); }
    .login-tab.is-active {
      color: var(--english-violet);
      border-bottom-color: var(--english-violet);
    }

    .login-pane[hidden] { display: none; }
    .login-pane.is-active { display: block; }

    .login-inline-link {
      background: transparent;
      border: 0;
      padding: 0;
      font: inherit;
      color: var(--english-violet);
      border-bottom: 1px solid currentColor;
      cursor: pointer;
    }
    .login-inline-anchor {
      color: var(--english-violet);
      border-bottom: 1px solid currentColor;
    }
    .login-check--terms {
      font-size: 13px;
      line-height: 1.55;
      align-items: flex-start;
      color: rgba(28, 29, 34, 0.7);
    }
    .login-check--terms input {
      margin-top: 3px;
    }
    .login-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(36px, 3.6vw, 52px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      color: var(--ink);
      margin: 0 0 18px;
    }
    .login-sub {
      font-size: 15px;
      color: rgba(28, 29, 34, 0.62);
      margin: 0 0 36px;
    }
    .login-inline-link {
      color: var(--english-violet);
      border-bottom: 1px solid currentColor;
    }

    .login-form { display: flex; flex-direction: column; gap: 18px; }
    .login-field { display: flex; flex-direction: column; gap: 8px; }
    .login-field > span {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.55);
    }
    .login-field input {
      font-family: var(--sans);
      font-size: 16px;
      padding: 14px 16px;
      border: 1px solid rgba(28, 29, 34, 0.18);
      border-radius: 2px;
      background: #fff;
      color: var(--ink);
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .login-field input:focus {
      outline: none;
      border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(71, 66, 84, 0.12);
    }

    .login-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: rgba(28, 29, 34, 0.7);
    }
    .login-check { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
    .login-check input { accent-color: var(--english-violet); }
    .login-forgot {
      color: var(--english-violet);
      font-weight: 600;
    }
    .login-forgot:hover { text-decoration: underline; }

    .login-submit {
      width: 100%;
      justify-content: center;
      padding: 16px;
      margin-top: 8px;
    }

    .login-divider {
      display: flex; align-items: center;
      gap: 16px;
      color: rgba(28, 29, 34, 0.4);
      font-size: 12px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin: 8px 0;
    }
    .login-divider::before, .login-divider::after {
      content: ""; flex: 1; height: 1px;
      background: rgba(28, 29, 34, 0.12);
    }

    .login-sso {
      width: 100%;
      padding: 14px;
      font-family: var(--sans);
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: transparent;
      border: 1px solid rgba(28, 29, 34, 0.25);
      border-radius: 1px;
      cursor: pointer;
      color: var(--ink);
      transition: background 0.3s, border-color 0.3s;
    }
    .login-sso:hover {
      background: rgba(71, 66, 84, 0.06);
      border-color: var(--english-violet);
    }

    .login-error {
      font-size: 13px;
      color: #a05a3c;
      background: rgba(160, 90, 60, 0.08);
      padding: 10px 14px;
      border-radius: 2px;
      margin: 0;
    }

    .login-hint {
      font-size: 12px;
      color: rgba(28, 29, 34, 0.5);
      line-height: 1.5;
      margin: 8px 0 0;
      padding: 14px 16px;
      background: rgba(71, 66, 84, 0.06);
      border-radius: 2px;
    }
    .login-hint strong { color: var(--english-violet); font-weight: 700; }
    .login-hint em { font-style: italic; color: rgba(28, 29, 34, 0.7); }

    .login-meta {
      position: absolute;
      bottom: 32px;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.35);
    }

    @media (max-width: 900px) {
      main.login-shell { grid-template-columns: 1fr; }
      .login-art { display: none; }
    }
  </style>

  <script>
    import { supabase } from "../lib/supabase.js";

    const signinForm = document.getElementById("login-form");
    const signupForm = document.getElementById("signup-form");
    const signinError = document.getElementById("login-error");
    const signupError = document.getElementById("signup-error");
    const signupEmailOut = document.getElementById("signup-email-out");
    const resendBtn = document.getElementById("resend-confirm");

    // ---- Tab switching ----
    function showPane(name) {
      document.querySelectorAll(".login-pane").forEach((p) => {
        const active = p.getAttribute("data-pane") === name;
        p.hidden = !active;
        p.classList.toggle("is-active", active);
      });
      document.querySelectorAll(".login-tab").forEach((b) => {
        const active = b.getAttribute("data-tab") === name;
        b.classList.toggle("is-active", active);
        b.setAttribute("aria-selected", active ? "true" : "false");
      });
    }
    document.querySelectorAll(".login-tab").forEach((b) =>
      b.addEventListener("click", () => showPane(b.getAttribute("data-tab")))
    );
    document.querySelectorAll("[data-go]").forEach((el) =>
      el.addEventListener("click", () => showPane(el.getAttribute("data-go")))
    );

    // Honour ?mode=signup link parameter (e.g. from /edit "create account first" CTA)
    const params = new URLSearchParams(location.search);
    if (params.get("mode") === "signup") showPane("signup");

    // ---- Post-auth routing ----
    function routeAfterSignIn() {
      const nextParam = new URLSearchParams(location.search).get("next");
      let firstTime = false;
      try {
        firstTime = !localStorage.getItem("tmke.brand") && !localStorage.getItem("tmke.brand.skipped");
      } catch (_) { /* ignore */ }
      const fallback = firstTime ? "/profile?next=/account" : "/account";
      const dest = nextParam || fallback;
      if (typeof window.tmkeSplash === "function") {
        window.tmkeSplash(dest);
      } else {
        window.location.href = dest;
      }
    }

    // If already signed in, skip the form.
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) routeAfterSignIn();
    })();

    function showError(el, msg) {
      el.textContent = msg;
      el.hidden = false;
    }
    function setBtnLoading(btn, isLoading, loadingText) {
      const label = btn.querySelector("[data-label]");
      if (!btn._origText) btn._origText = label ? label.textContent : btn.textContent;
      if (isLoading) {
        btn.setAttribute("disabled", "true");
        if (label) label.textContent = loadingText;
      } else {
        btn.removeAttribute("disabled");
        if (label) label.textContent = btn._origText;
      }
    }

    // ---- Sign in ----
    signinForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      signinError.hidden = true;
      const data = new FormData(signinForm);
      const email = String(data.get("email") || "").trim();
      const password = String(data.get("password") || "").trim();
      if (!email || !password) {
        showError(signinError, "Enter an email and password to sign in.");
        return;
      }
      const btn = signinForm.querySelector('button[type="submit"]');
      setBtnLoading(btn, true, "Signing in…");
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        setBtnLoading(btn, false);
        showError(signinError, error.message);
        return;
      }
      routeAfterSignIn();
    });

    // ---- Sign up ----
    let lastSignupEmail = null;
    signupForm.addEventListener("submit", async (e) => {
      e.preventDefault();
      signupError.hidden = true;
      const data = new FormData(signupForm);
      const name = String(data.get("name") || "").trim();
      const email = String(data.get("email") || "").trim();
      const password = String(data.get("password") || "");
      const terms = signupForm.querySelector('input[name="terms"]').checked;
      if (!name || !email || !password) {
        showError(signupError, "Please fill in every field.");
        return;
      }
      if (password.length < 8) {
        showError(signupError, "Choose a password with at least 8 characters.");
        return;
      }
      if (!terms) {
        showError(signupError, "Please agree to the terms and privacy policy.");
        return;
      }
      const btn = signupForm.querySelector('button[type="submit"]');
      setBtnLoading(btn, true, "Creating account…");
      const { data: signupData, error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: { name },
          emailRedirectTo: `${location.origin}/auth/callback?next=${encodeURIComponent("/profile?next=/account")}`,
        },
      });
      if (error) {
        setBtnLoading(btn, false);
        showError(signupError, error.message);
        return;
      }
      lastSignupEmail = email;
      // If the project has email confirmation OFF, Supabase returns a session
      // immediately — route them straight into the library.
      if (signupData.session) {
        routeAfterSignIn();
        return;
      }
      // Otherwise: show the "check your inbox" pane.
      if (signupEmailOut) signupEmailOut.textContent = email;
      showPane("check-email");
    });

    // ---- Resend confirmation ----
    if (resendBtn) {
      resendBtn.addEventListener("click", async () => {
        if (!lastSignupEmail) return;
        resendBtn.setAttribute("disabled", "true");
        resendBtn.textContent = "Sending…";
        const { error } = await supabase.auth.resend({
          type: "signup",
          email: lastSignupEmail,
          options: {
            emailRedirectTo: `${location.origin}/auth/callback?next=${encodeURIComponent("/profile?next=/account")}`,
          },
        });
        resendBtn.removeAttribute("disabled");
        resendBtn.textContent = error ? "Try again" : "Resent ✓";
      });
    }
  </script>
</BaseLayout>
