---
import BaseLayout from "../layouts/BaseLayout.astro";

// Same nine "what you can do in the hub" tiles as /join — brand placeholder
// imagery; swap `img` for the final shots when ready.
const TILES = [
  { key: "Design",   a: "Create scroll-stopping content in the Studio.", b: "Templates, tools and your brand kit, ready to go.", img: "/assets/signup/2.webp" },
  { key: "Plan",     a: "Map out your month in one view.",                 b: "Schedule posts and never scramble for content.",     img: "/assets/signup/7.webp" },
  { key: "Shop",     a: "Browse The Edit.",                                b: "Ready-made template packs for every moment.",         img: "/assets/signup/9.webp" },
  { key: "Learn",    a: "Guides and mini-courses.",                        b: "Sharpen your marketing, one lesson at a time.",       img: "/assets/signup/3.webp" },
  { key: "Book",     a: "Discover our videography packages.",              b: "Book a shoot or discovery call.",                     img: "/assets/signup/4.webp" },
  { key: "Track",    a: "See exactly what's working.",                     b: "Clear monthly SMM reports.",                          img: "/assets/signup/5.webp" },
  { key: "Manage",   a: "Everything in one place.",                        b: "Your orders, services and bookings at a glance.",     img: "/assets/signup/8.webp" },
  { key: "Discover", a: "Explore what's possible.",                        b: "Fresh ideas and resources to keep you moving.",       img: "/assets/signup/6.webp" },
];
---

<BaseLayout
  dashboard
  title="Sign in — TMKE"
  description="Sign in to your TMKE Studio account — your all-in-one workspace for designing content, planning marketing and managing bookings."
  hideNav={true}
  hideFooter={true}
>
  <main class="jn">
    <header class="jn-top">
      <a href="/" class="jn-top-back" aria-label="Back to site"><span aria-hidden="true">&larr;</span> Back</a>
      <a href="/" class="jn-top-mark" aria-label="TMKE — home">TMKE</a>
    </header>

    <div class="jn-grid">
      <!-- First cell: image + the chapter line + "Sign in", like the rest -->
      <button type="button" class="jn-cell jn-cell--tile jn-cell--join" data-open aria-label="Sign in to your account">
        <span class="jn-tile-inner">
          <span class="jn-thumb">
            <img class="jn-thumb-img" src="/assets/signup/1.webp" alt="" loading="lazy" />
          </span>
          <span class="jn-cap">
            <span class="jn-cap-key chapter">Sign in</span>
            <span class="jn-cap-lines">
              <span class="jn-cap-line">Sign in to your TMKE Studio account.</span>
              <span class="jn-cap-line">All-in-one space to design and plan.</span>
            </span>
          </span>
        </span>
      </button>

      {TILES.map((t) => (
        <button type="button" class:list={["jn-cell", "jn-cell--tile", `jn-t-${t.key.toLowerCase()}`]} data-open aria-label={`${t.key} — sign in`}>
          <span class="jn-tile-inner">
            <span class="jn-thumb">
              <img class="jn-thumb-img" src={t.img} alt="" loading="lazy" />
            </span>
            <span class="jn-cap">
              <span class="jn-cap-key chapter">{t.key}</span>
              <span class="jn-cap-lines">
                <span class="jn-cap-line">{t.a}</span>
                <span class="jn-cap-line">{t.b}</span>
              </span>
            </span>
          </span>
        </button>
      ))}
    </div>

    <!-- Custom "Click to sign in" cursor (hover devices only) -->
    <div class="jn-cursor" id="jn-cursor" aria-hidden="true"><span>[ Click to sign in ]</span></div>

    <!-- Slide-out: the sign-in box -->
    <div class="jn-drawer" id="jn-drawer" hidden aria-hidden="true">
      <div class="jn-drawer-scrim" data-close></div>
      <div class="jn-drawer-panel" role="dialog" aria-modal="true" aria-label="Sign in">
        <button type="button" class="jn-drawer-x" data-close aria-label="Close">&times;</button>
        <div class="chapter">Welcome back</div>
        <h2 class="jn-form-title">Built for Better Marketing</h2>
        <p class="jn-form-sub">Sign in to your account to access the Studio, your all-in-one workspace for designing content, planning your marketing, managing bookings, accessing resources, and getting more from your TMKE membership.</p>

        <form id="signin-form" class="jn-form" novalidate>
          <label class="jn-field"><span>Email</span>
            <input type="email" name="email" autocomplete="email" required placeholder="you@agency.co.uk" /></label>
          <label class="jn-field"><span>Password</span>
            <input type="password" name="password" autocomplete="current-password" required placeholder="••••••••" /></label>
          <div class="jn-row">
            <label class="jn-check jn-check--inline"><input type="checkbox" name="remember" checked /><span>Keep me signed in</span></label>
            <a href="/forgot-password" class="jn-forgot">Forgot password?</a>
          </div>
          <button type="submit" class="btn btn--solid jn-submit"><span data-label>Sign in</span> <span class="btn-arrow">&rarr;</span></button>
          <p id="signin-error" class="jn-error" hidden><span id="signin-error-text"></span> <button type="button" id="signin-resend" class="jn-linkbtn" hidden>Send me a link to get in</button></p>
        </form>

        <p class="jn-alt">New here? <a href="/join" class="jn-link">Create a free account</a></p>
        <p class="jn-alt jn-alt--shop">Visit <a href="/edit" class="jn-link">The Edit</a>, our social media template shop.</p>
      </div>
    </div>
  </main>

  <style>
    main.jn { --jn-line: rgba(28,29,34,0.12); background: var(--paper); min-height: 100vh; display: flex; flex-direction: column; }

    /* ---- Top bar (minimal, mukko-style) ---- */
    .jn-top { display: flex; align-items: center; justify-content: space-between; padding: 16px clamp(18px, 2.4vw, 34px); flex: none; }
    .jn-top-back { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .jn-top-back:hover { color: var(--ink); }
    .jn-top-mark { font-family: var(--serif); font-size: 22px; letter-spacing: 0.08em; color: var(--ink); }

    /* ---- The full-page grid ---- */
    .jn-grid { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--jn-line); border-left: 1px solid var(--jn-line); }
    .jn-cell { border-right: 1px solid var(--jn-line); border-bottom: 1px solid var(--jn-line); min-height: clamp(320px, 36vh, 440px); position: relative; }

    /* Custom "Click to sign in" cursor that follows the mouse over the grid */
    .jn-cursor { position: fixed; top: 0; left: 0; z-index: 2500; pointer-events: none; opacity: 0; transition: opacity 0.18s ease; }
    .jn-cursor.is-on { opacity: 1; }
    .jn-cursor span { position: absolute; transform: translate(-50%, -50%); color: var(--english-violet); font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; }
    .jn.jn-has-cursor .jn-grid, .jn.jn-has-cursor .jn-cell--tile { cursor: none; }
    @media (hover: none) { .jn-cursor { display: none; } }

    /* Image tile — image sits SMALL and centred; caption left-aligned to it. */
    .jn-cell--tile { display: flex; align-items: center; justify-content: center; padding: 30px 24px; cursor: pointer; background: none; }
    .jn-tile-inner { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; width: min(66%, 210px); }
    .jn-thumb { position: relative; width: 85%; aspect-ratio: 1080 / 1440; overflow: visible; }
    .jn-thumb-img { width: 100%; height: 100%; object-fit: cover; display: block; will-change: filter; transition: filter 0.5s ease, opacity 0.5s ease; }
    .jn-cell--tile:hover .jn-thumb-img, .jn-cell--tile:focus-visible .jn-thumb-img { filter: blur(11px); opacity: 0.5; }
    .jn-cap { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; text-align: left; width: 100%; }
    .jn-cap-key { margin: 0; color: var(--english-violet); }
    .jn-cap-lines { display: flex; flex-direction: column; gap: 2px; opacity: 0; transition: opacity 0.35s ease; }
    .jn-cell--tile:hover .jn-cap-lines, .jn-cell--tile:focus-visible .jn-cap-lines { opacity: 1; }
    .jn-cap-line { font-family: var(--sans); font-size: 12px; line-height: 1.2; color: rgba(28,29,34,0.6); }
    .jn-cell--tile:focus-visible { outline: 2px solid var(--english-violet); outline-offset: -2px; }

    /* ---- Slide-out sign-in ---- */
    .jn-drawer { position: fixed; inset: 0; z-index: 3000; }
    .jn-drawer[hidden] { display: none; }
    .jn-drawer-scrim { position: absolute; inset: 0; background: rgba(28,29,34,0.5); opacity: 0; transition: opacity 0.28s ease; }
    .jn-drawer.is-open .jn-drawer-scrim { opacity: 1; }
    .jn-drawer-panel { position: absolute; top: 0; right: 0; height: 100%; width: clamp(400px, 50vw, 720px); background: var(--paper); box-shadow: -18px 0 60px rgba(28,29,34,0.3); padding: 84px clamp(30px, 3.2vw, 52px) 48px; overflow-y: auto; transform: translateX(100%); transition: transform 0.34s cubic-bezier(0.22,0.61,0.36,1); }
    .jn-drawer.is-open .jn-drawer-panel { transform: translateX(0); }
    .jn-drawer-x { position: absolute; top: 16px; right: 16px; width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(28,29,34,0.14); background: #fff; color: rgba(28,29,34,0.55); font-size: 22px; line-height: 1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
    .jn-drawer-x:hover { color: var(--ink); }
    .jn-drawer-panel .chapter { margin-bottom: 36px; }
    .jn-form-title { font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 3.4vw, 36px); line-height: 1.05; letter-spacing: -0.015em; color: var(--ink); margin: 0 0 12px; }
    .jn-form-sub { font-family: var(--sans); font-size: 14px; font-weight: 500; line-height: 1.55; color: rgba(28,29,34,0.62); margin: 0 0 44px; }
    .jn-form { display: flex; flex-direction: column; gap: 14px; }
    .jn-field { display: flex; flex-direction: column; gap: 7px; }
    .jn-field > span { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .jn-field input { font-family: var(--sans); font-size: 16px; padding: 13px 15px; border: 1px solid rgba(28,29,34,0.18); border-radius: 3px; background: #fff; color: var(--ink); transition: border-color 0.2s, box-shadow 0.2s; }
    .jn-field input:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.12); }
    .jn-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 4px; }
    .jn-check { display: flex; align-items: flex-start; gap: 10px; font-family: var(--sans); font-size: 12.5px; line-height: 1.45; color: rgba(28,29,34,0.62); cursor: pointer; }
    .jn-check--inline { align-items: center; margin-top: 0; }
    .jn-check input { width: 17px; height: 17px; flex: none; accent-color: var(--english-violet); }
    .jn-forgot { font-family: var(--sans); font-size: 12.5px; font-weight: 700; color: rgba(28,29,34,0.55); white-space: nowrap; }
    .jn-forgot:hover { color: var(--english-violet); }
    .jn-submit { width: 100%; justify-content: center; padding: 15px; margin-top: 10px; }
    .jn-error { font-family: var(--sans); font-size: 13px; color: #a05a3c; background: rgba(160,90,60,0.08); padding: 10px 13px; border-radius: 3px; margin: 2px 0 0; }
    .jn-alt { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); text-align: center; margin: 22px 0 0; }
    .jn-alt--shop { margin-top: 6px; }
    .jn-link { color: var(--english-violet); font-weight: 700; border-bottom: 1px solid currentColor; }
    /* Reads as the link it is, but it's a button because it performs an action. */
    .jn-linkbtn {
      background: none; border: 0; padding: 0; cursor: pointer;
      font-family: inherit; font-size: inherit;
      color: var(--english-violet); font-weight: 700;
      border-bottom: 1px solid currentColor;
    }
    .jn-linkbtn[disabled] { opacity: 0.6; cursor: default; }

    /* ---- Responsive ---- */
    @media (max-width: 860px) {
      .jn-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      /* Mobile: clean 2-column grid — image + title only, no body text, no blur;
         drop Discover so it's an even 8. */
      .jn-grid { grid-template-columns: repeat(2, 1fr); }
      .jn-t-discover { display: none; }
      .jn-cell { min-height: clamp(200px, 44vw, 280px); }
      .jn-cell--tile { padding: 24px 16px; }
      .jn-tile-inner { width: min(82%, 150px); gap: 12px; }
      .jn-cap-lines { display: none; }
      .jn-cell--tile:hover .jn-thumb-img, .jn-cell--tile:focus-visible .jn-thumb-img { filter: none; opacity: 1; }
      .jn-drawer-panel { width: 100vw; }
    }
  </style>

  <script>
    import { supabase } from "../lib/supabase.js";

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").trim().replace(/\/+$/, "");

    const drawer = document.getElementById("jn-drawer");
    const form = document.getElementById("signin-form");
    const errEl = document.getElementById("signin-error");
    const errTextEl = document.getElementById("signin-error-text");
    const resendBtn = document.getElementById("signin-resend");

    resendBtn.addEventListener("click", async () => {
      const email = resendBtn.dataset.email || "";
      if (!email) return;
      resendBtn.setAttribute("disabled", "true");
      const orig = resendBtn.textContent;
      resendBtn.textContent = "Sending…";
      // The Worker, not supabase.auth.resend(): Supabase's own email carries a
      // link that a mail scanner consumes before the recipient sees it. This
      // sends a recovery link, which confirms the account and lets them set a
      // password in one go — the right destination for someone locked out.
      let failed = false;
      try {
        const res = await fetch(`${WORKER}/auth/reset-link`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ email }),
        });
        failed = !res.ok;
      } catch (_) { failed = true; }

      if (failed) {
        resendBtn.textContent = orig;
        resendBtn.removeAttribute("disabled");
        errTextEl.textContent = "We couldn't send that just now. Please try again in a moment.";
        return;
      }
      resendBtn.hidden = true;
      errTextEl.textContent = "A link is on its way. Open it and you'll be able to set a password and get straight in. Check your spam or quarantine folder if it's slow.";
    });
    let lastFocus = null;

    // ---- Post-auth routing (next param, else the dashboard via the splash) ----
    function routeAfterSignIn() {
      const nextParam = new URLSearchParams(location.search).get("next");
      const dest = nextParam || "/account";
      if (typeof window.tmkeSplash === "function") window.tmkeSplash(dest);
      else window.location.href = dest;
    }

    // Already signed in? Skip straight through.
    //
    // Two guards here, both from the same bug: signing out could land you back
    // inside the hub immediately.
    //
    // 1. If we've just signed out, don't route at all. Nothing to check.
    // 2. getSession() reads localStorage ONLY - it makes no network call - so a
    //    revoked or expired session still looks perfectly valid to it. Confirm
    //    with getUser(), which asks the server, before sending anyone through.
    (async () => {
      if (new URLSearchParams(location.search).get("signedout")) return;
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;
      const { data: { user }, error } = await supabase.auth.getUser();
      if (user && !error) routeAfterSignIn();
    })();

    function openDrawer() {
      document.getElementById("jn-cursor")?.classList.remove("is-on");
      lastFocus = document.activeElement;
      errEl.hidden = true;
      drawer.hidden = false; drawer.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => drawer.classList.add("is-open"));
      document.body.style.overflow = "hidden";
      setTimeout(() => {
        // Email already filled (they came from /join) — start them on the password.
        const em = form.querySelector('input[name="email"]');
        const pw = form.querySelector('input[name="password"]');
        const f = (em && em.value && pw) ? pw : em;
        if (f) f.focus();
      }, 80);
    }
    function closeDrawer() {
      drawer.classList.remove("is-open"); drawer.setAttribute("aria-hidden", "true");
      setTimeout(() => { drawer.hidden = true; }, 320);
      document.body.style.overflow = "";
      if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (_) {} }
    }

    document.querySelectorAll("[data-open]").forEach((el) => el.addEventListener("click", openDrawer));
    document.addEventListener("click", (e) => { if (e.target.closest("[data-close]")) closeDrawer(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && drawer.classList.contains("is-open")) closeDrawer(); });

    /* Sent here from /join because the address already has an account (?email=...).
       Prefill and open the drawer immediately — they clicked "Sign in instead",
       so landing them on the closed page would just make them click again. */
    (function prefillFromJoin() {
      const wanted = new URLSearchParams(location.search).get("email");
      if (!wanted) return;
      const field = form.querySelector('input[name="email"]');
      if (field && !field.value) field.value = wanted.trim();
      openDrawer();
    })();

    // Custom "Click to sign in" cursor over the grid (fine-pointer devices only).
    const jnMain = document.querySelector(".jn");
    const jnGrid = document.querySelector(".jn-grid");
    const jnCursor = document.getElementById("jn-cursor");
    if (jnMain && jnGrid && jnCursor && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      jnMain.classList.add("jn-has-cursor");
      jnGrid.addEventListener("mousemove", (e) => {
        jnCursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
        if (!drawer.classList.contains("is-open")) jnCursor.classList.add("is-on");
      });
      jnGrid.addEventListener("mouseleave", () => jnCursor.classList.remove("is-on"));
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errEl.hidden = true;
      const data = new FormData(form);
      const email = String(data.get("email") || "").trim();
      const password = String(data.get("password") || "").trim();
      if (!email || !password) { errEl.textContent = "Enter an email and password to sign in."; errEl.hidden = false; return; }
      const btn = form.querySelector('button[type="submit"]');
      const label = btn.querySelector("[data-label]");
      const orig = label.textContent;
      btn.setAttribute("disabled", "true"); label.textContent = "Signing in…";
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        btn.removeAttribute("disabled"); label.textContent = orig;
        // "Email not confirmed" is a dead end on its own: they can't sign in
        // until they confirm, and they can't register again because the
        // address is taken. Hand them the only thing that helps.
        const unconfirmed = /confirm/i.test(error.message || "");
        errTextEl.textContent = unconfirmed
          ? "This account hasn't been confirmed yet. Check your inbox for the link — including your spam or quarantine folder."
          : error.message;
        resendBtn.hidden = !unconfirmed;
        resendBtn.dataset.email = unconfirmed ? email : "";
        errEl.hidden = false;
        return;
      }
      routeAfterSignIn();
    });
  </script>
</BaseLayout>
