---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Sign in — TMKE"
  description="Sign in to access your purchased template packs and downloads."
  hideFooter={true}
>
  <!-- Slide-up curtain that animates the user from /login to /edit -->
  <div class="login-curtain" id="login-curtain" aria-hidden="true">
    <div class="login-curtain-inner">
      <div class="login-curtain-eyebrow">Now opening</div>
      <div class="login-curtain-title">The Edit<span>.</span></div>
    </div>
  </div>

  <main class="login-shell">
    <div class="login-art" aria-hidden="true">
      <div class="login-art-overlay"></div>
      <div class="login-art-quote">
        <div class="chapter chapter--light">Members &middot; Sign in</div>
        <p class="login-art-line">
          Your library, <em>your studio,</em><br />always to hand.
        </p>
        <p class="login-art-sub">
          Every pack you've purchased — ready to open, edit and post.
        </p>
      </div>
    </div>

    <section class="login-panel">
      <a href="/" class="login-mark">TMKE</a>

      <div class="login-card">
        <div class="eyebrow">Welcome back</div>
        <h1 class="login-title">Sign in to your library</h1>
        <p class="login-sub">
          Enter your details below. Don't have an account?
          <a href="/edit" class="login-inline-anchor">Browse The Edit</a>.
        </p>

        <form id="login-form" class="login-form" novalidate>
          <label class="login-field">
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required placeholder="you@agency.co.uk" />
          </label>

          <label class="login-field">
            <span>Password</span>
            <input type="password" name="password" autocomplete="current-password" required placeholder="••••••••" />
          </label>

          <div class="login-row">
            <label class="login-check">
              <input type="checkbox" name="remember" checked />
              <span>Keep me signed in</span>
            </label>
            <a href="/forgot-password" class="login-forgot">Forgot password?</a>
          </div>

          <button type="submit" class="btn btn--solid login-submit">
            <span data-label>Sign in</span> <span class="btn-arrow">&rarr;</span>
          </button>

          <p id="login-error" class="login-error" hidden></p>
        </form>

        <p class="login-hint">
          New here? <em>Accounts are created automatically when you purchase
          a pack on <a href="/edit" class="login-inline-anchor">The Edit</a> —
          you'll set your password at checkout.</em>
        </p>
      </div>

      <p class="login-meta">© 2026 TMKE — The Marketing Experts</p>
    </section>
  </main>

  <style>
    main.login-shell {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      min-height: 100vh;
      background: var(--paper);
    }

    .login-art {
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(180deg, rgba(28,29,34,0.2), rgba(28,29,34,0.7)),
        url("/assets/home-window.jpg") center/cover no-repeat;
      color: var(--paper);
    }
    .login-art-overlay {
      position: absolute; inset: 0;
      background:
        radial-gradient(80% 60% at 50% 40%, rgba(0,0,0,0) 30%, rgba(0,0,0,0.35) 100%);
      pointer-events: none;
    }
    .login-art-quote {
      position: absolute;
      inset: auto 0 0 0;
      padding: 0 56px 80px;
    }
    .login-art-quote .chapter { margin-bottom: 48px; }
    .login-art-line {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(40px, 4.4vw, 68px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      margin: 0 0 18px;
      color: var(--paper);
      max-width: 12ch;
    }
    .login-art-line em { font-style: italic; color: var(--french-grey); }
    .login-art-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: 20px;
      line-height: 1.45;
      color: rgba(240, 238, 235, 0.72);
      max-width: 38ch;
    }

    .login-panel {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      padding: 48px 36px;
      overflow: hidden;
      background:
        radial-gradient(60% 40% at 80% 0%, rgba(123, 91, 207, 0.18) 0%, rgba(123, 91, 207, 0) 70%),
        radial-gradient(50% 40% at 10% 100%, rgba(232, 155, 123, 0.18) 0%, rgba(232, 155, 123, 0) 70%),
        var(--paper);
    }
    .login-mark {
      position: absolute;
      top: 32px;
      left: 36px;
      font-family: var(--serif);
      font-size: 24px;
      letter-spacing: 0.06em;
      color: var(--ink);
      display: inline-flex; align-items: baseline; gap: 8px;
    }
    .login-mark::after {
      content: "";
      display: inline-block;
      width: 7px; height: 7px;
      border-radius: 999px;
      background: var(--gradient-violet);
      box-shadow: 0 0 14px rgba(123,91,207,0.7);
    }

    .login-card {
      position: relative;
      width: 100%;
      max-width: 460px;
      padding: 40px 40px 36px;
      background: rgba(255, 255, 255, 0.78);
      border: 1px solid rgba(123, 91, 207, 0.18);
      border-radius: 18px;
      box-shadow:
        0 30px 70px -30px rgba(46, 31, 84, 0.35),
        0 1px 0 rgba(255, 255, 255, 0.7) inset;
      backdrop-filter: blur(6px);
      overflow: hidden;
    }
    .login-card::before {
      content: "";
      position: absolute; inset: 0 0 auto 0;
      height: 3px;
      background: var(--gradient-brand);
    }
    .login-card .eyebrow {
      margin-bottom: 14px;
      background: var(--gradient-violet);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .login-inline-anchor {
      color: var(--violet);
      border-bottom: 1px solid rgba(123,91,207,0.55);
      transition: color 0.2s, border-color 0.2s;
    }
    .login-inline-anchor:hover { color: var(--violet-deep); border-bottom-color: var(--violet-deep); }
    .login-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(36px, 3.6vw, 52px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      color: var(--ink);
      margin: 0 0 18px;
    }
    .login-title::after {
      /* Decorative gradient stop next to the title — a tiny "live" dot. */
      content: ".";
      background: var(--gradient-violet);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .login-sub {
      font-size: 15px;
      color: rgba(28, 29, 34, 0.62);
      margin: 0 0 36px;
    }
    .login-inline-link {
      color: var(--english-violet);
      border-bottom: 1px solid currentColor;
    }

    .login-form { display: flex; flex-direction: column; gap: 18px; }
    .login-field { display: flex; flex-direction: column; gap: 8px; }
    .login-field > span {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.55);
    }
    .login-field input {
      font-family: var(--sans);
      font-size: 16px;
      padding: 14px 16px;
      border: 1px solid rgba(123, 91, 207, 0.22);
      border-radius: 10px;
      background: #fff;
      color: var(--ink);
      transition: border-color 0.25s, box-shadow 0.25s, transform 0.15s;
    }
    .login-field input:hover { border-color: rgba(123, 91, 207, 0.4); }
    .login-field input:focus {
      outline: none;
      border-color: var(--violet);
      box-shadow: 0 0 0 4px rgba(123, 91, 207, 0.18), 0 8px 22px -10px rgba(123, 91, 207, 0.4);
    }

    .login-row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 13px;
      color: rgba(28, 29, 34, 0.7);
    }
    .login-check { display: inline-flex; align-items: center; gap: 8px; cursor: pointer; }
    .login-check input { accent-color: var(--violet); }
    .login-forgot {
      color: var(--violet);
      font-weight: 600;
      transition: color 0.2s;
    }
    .login-forgot:hover { color: var(--violet-deep); text-decoration: underline; }

    /* Submit — gradient pill with a soft glow that lifts on hover. */
    .login-submit {
      width: 100%;
      justify-content: center;
      padding: 16px;
      margin-top: 8px;
      background: var(--gradient-violet);
      color: var(--ink);
      border: 0;
      border-radius: 999px;
      letter-spacing: 0.22em;
      box-shadow: 0 18px 36px -14px rgba(123, 91, 207, 0.6);
      transition: transform 0.25s, box-shadow 0.25s, filter 0.25s;
      position: relative;
      overflow: hidden;
    }
    .login-submit, .login-submit:hover { color: var(--ink); }
    .login-submit:hover {
      transform: translateY(-2px);
      box-shadow: 0 26px 48px -16px rgba(123, 91, 207, 0.75);
      filter: brightness(1.06);
    }
    .login-submit::after {
      /* slow sheen sweep — adds a "live" polished feel without dominating */
      content: "";
      position: absolute;
      top: 0; bottom: 0;
      left: -40%;
      width: 40%;
      background: linear-gradient(100deg, transparent 0%, rgba(255,255,255,0.35) 50%, transparent 100%);
      transform: skewX(-20deg);
      animation: loginSheen 5s ease-in-out infinite;
      pointer-events: none;
    }
    @keyframes loginSheen {
      0%   { left: -40%; }
      60%  { left: 120%; }
      100% { left: 120%; }
    }
    @media (prefers-reduced-motion: reduce) {
      .login-submit::after { animation: none; }
    }
    .login-submit[disabled] { filter: grayscale(0.4) brightness(0.92); transform: none; cursor: wait; }

    .login-divider {
      display: flex; align-items: center;
      gap: 16px;
      color: rgba(28, 29, 34, 0.4);
      font-size: 12px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      margin: 8px 0;
    }
    .login-divider::before, .login-divider::after {
      content: ""; flex: 1; height: 1px;
      background: rgba(28, 29, 34, 0.12);
    }

    .login-sso {
      width: 100%;
      padding: 14px;
      font-family: var(--sans);
      font-weight: 600;
      font-size: 14px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      background: transparent;
      border: 1px solid rgba(28, 29, 34, 0.25);
      border-radius: 1px;
      cursor: pointer;
      color: var(--ink);
      transition: background 0.3s, border-color 0.3s;
    }
    .login-sso:hover {
      background: rgba(71, 66, 84, 0.06);
      border-color: var(--english-violet);
    }

    .login-error {
      font-size: 13px;
      color: #a05a3c;
      background: linear-gradient(135deg, rgba(232,155,123,0.18), rgba(232,155,123,0.08));
      border: 1px solid rgba(232,155,123,0.35);
      padding: 10px 14px;
      border-radius: 10px;
      margin: 0;
    }

    .login-hint {
      font-size: 12px;
      color: rgba(28, 29, 34, 0.6);
      line-height: 1.55;
      margin: 24px 0 0;
      padding: 18px 18px 16px;
      background:
        radial-gradient(80% 100% at 100% 0%, rgba(232,155,123,0.12) 0%, rgba(232,155,123,0) 70%),
        linear-gradient(135deg, rgba(123, 91, 207, 0.10), rgba(123, 91, 207, 0.03));
      border: 1px solid rgba(123, 91, 207, 0.18);
      border-radius: 10px;
    }
    .login-hint strong { color: var(--violet); font-weight: 700; }
    .login-hint em { font-style: italic; color: rgba(28, 29, 34, 0.72); }

    .login-meta {
      position: absolute;
      bottom: 32px;
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.35);
    }

    @media (max-width: 900px) {
      main.login-shell { grid-template-columns: 1fr; }
      .login-art { display: none; }
    }

    /* ============ Browse-packs slide-up curtain ============ */
    .login-curtain {
      position: fixed;
      inset: 0;
      z-index: 200;
      background: var(--paper);
      transform: translateY(100%);
      transition: transform 0.85s cubic-bezier(.7,0,.2,1);
      pointer-events: none;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .login-curtain::before {
      content: "";
      position: absolute; inset: 0;
      background:
        linear-gradient(180deg, rgba(28,29,34,0.18), rgba(28,29,34,0.55)),
        url("https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=2000&q=80") center/cover;
      opacity: 0;
      transition: opacity 0.6s 0.2s ease-out;
    }
    .login-curtain.is-up {
      transform: translateY(0);
      pointer-events: auto;
    }
    .login-curtain.is-up::before { opacity: 1; }
    .login-curtain-inner {
      position: relative;
      z-index: 1;
      text-align: center;
      color: var(--paper);
      opacity: 0;
      transform: translateY(28px);
      transition: opacity 0.6s 0.45s ease-out, transform 0.6s 0.45s cubic-bezier(.2,.7,.2,1);
    }
    .login-curtain.is-up .login-curtain-inner {
      opacity: 1;
      transform: translateY(0);
    }
    .login-curtain-eyebrow {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.32em;
      text-transform: uppercase;
      font-weight: 700;
      margin-bottom: 24px;
      opacity: 0.7;
    }
    .login-curtain-title {
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(56px, 9vw, 132px);
      letter-spacing: -0.02em;
      line-height: 1;
    }
    .login-curtain-title span {
      background: var(--gradient-violet);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  </style>

  <script>
    import { supabase } from "../lib/supabase.js";

    const form = document.getElementById("login-form");
    const errorEl = document.getElementById("login-error");

    // ---- Post-auth routing ----
    function routeAfterSignIn() {
      const nextParam = new URLSearchParams(location.search).get("next");
      let firstTime = false;
      try {
        firstTime = !localStorage.getItem("tmke.brand") && !localStorage.getItem("tmke.brand.skipped");
      } catch (_) { /* ignore */ }
      const fallback = firstTime ? "/profile?next=/account" : "/account";
      const dest = nextParam || fallback;
      if (typeof window.tmkeSplash === "function") {
        window.tmkeSplash(dest);
      } else {
        window.location.href = dest;
      }
    }

    // If already signed in, skip the form.
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) routeAfterSignIn();
    })();

    function showError(msg) {
      errorEl.textContent = msg;
      errorEl.hidden = false;
    }
    function setBtnLoading(btn, isLoading, loadingText) {
      const label = btn.querySelector("[data-label]");
      if (!btn._origText) btn._origText = label ? label.textContent : btn.textContent;
      if (isLoading) {
        btn.setAttribute("disabled", "true");
        if (label) label.textContent = loadingText;
      } else {
        btn.removeAttribute("disabled");
        if (label) label.textContent = btn._origText;
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const data = new FormData(form);
      const email = String(data.get("email") || "").trim();
      const password = String(data.get("password") || "").trim();
      if (!email || !password) {
        showError("Enter an email and password to sign in.");
        return;
      }
      const btn = form.querySelector('button[type="submit"]');
      setBtnLoading(btn, true, "Signing in…");
      const { error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        setBtnLoading(btn, false);
        showError(error.message);
        return;
      }
      routeAfterSignIn();
    });

    // Slide-up curtain when the user taps a "Browse The Edit" inline link.
    // Gives the hand-off from sign-in to shop a deliberate theatrical feel.
    const curtain = document.getElementById("login-curtain");
    document.querySelectorAll('a[href="/edit"].login-inline-anchor').forEach((a) => {
      a.addEventListener("click", (e) => {
        if (!curtain) return; // graceful fallback to normal navigation
        e.preventDefault();
        curtain.classList.add("is-up");
        document.documentElement.style.overflow = "hidden";
        setTimeout(() => { window.location.href = "/edit"; }, 1100);
      });
    });
  </script>
</BaseLayout>
