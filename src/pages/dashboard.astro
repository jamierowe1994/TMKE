---
import BaseLayout from "../layouts/BaseLayout.astro";
import { templates } from "../data/library.js";

// "Continue working" falls back to templates the user can start from (so it's
// never blank) when they have no saved drafts. JS swaps in real drafts if any.
const recentTemplates = templates.slice(0, 4);
---

<!--
  TMKE workspace — Phase 2. Editorial, asymmetric composition (mock data).
  Standalone preview at /dashboard; the live /account is untouched.

  Hierarchy: ONE immersive hero (brief + dominant design preview) leads the eye,
  then a left "workflow" column (plan -> recent work) beside a lighter right
  "insights" column (idea, brand health, performance), finishing on a full-width
  discovery card. Sections are grouped by whitespace + depth, not borders.
-->
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Your TMKE — workspace"
  description="Your marketing brief, your designs in progress, and what's new — beautifully organised."
>
  <div class="ws">
    <!-- ============ Top navigation ============ -->
    <header class="ws-nav" aria-label="Primary">
      <!-- LEFT: hamburger holds everything we tuck away (Learn / Manage / Resources) -->
      <div class="ws-menu ws-burger" data-menu>
        <button type="button" class="ws-burgerbtn" data-menu-btn aria-expanded="false" aria-haspopup="true" aria-label="Menu">
          <svg viewBox="0 0 24 24" aria-hidden="true"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        </button>
        <div class="ws-dropdown ws-dropdown--mega" role="menu">
          <a role="menuitem" href="/account/guides">Learn</a>
          <p class="ws-dd-sec">Manage</p>
          <a role="menuitem" href="/profile">Brand Kit</a>
          <a role="menuitem" href="/account/services">Managed Socials</a>
          <a role="menuitem" href="/account/bookings">Bookings</a>
          <a role="menuitem" href="/account/orders">Orders</a>
          <a role="menuitem" href="/account/orders">Billing</a>
          <a role="menuitem" href="/profile">Settings</a>
          <p class="ws-dd-sec">Resources</p>
          <a role="menuitem" href="/account/guides">Guides</a>
          <a role="menuitem" href="/account/blog">Blog</a>
          <a role="menuitem" href="/contact">Contact</a>
          <a role="menuitem" href="/contact">Help Centre</a>
        </div>
      </div>

      <!-- CENTRE: the five core sections -->
      <nav class="ws-tabs" aria-label="Sections">
        <a class="ws-tab is-active" href="/dashboard" aria-current="page">Dashboard</a>
        <a class="ws-tab" href="/editor">Studio</a>
        <a class="ws-tab" href="/edit">Library</a>
        <a class="ws-tab" href="/account/schedule">Planner</a>
        <a class="ws-tab" href="/account">Analytics</a>
      </nav>

      <!-- RIGHT: search, notifications, you -->
      <div class="ws-nav-right">
        <button type="button" class="ws-navic" data-tip="Search anything"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg><span class="ws-sr">Search</span></button>
        <button type="button" class="ws-navic" data-tip="3 new updates"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg><span class="ws-dot"></span><span class="ws-sr">Notifications</span></button>
        <div class="ws-menu ws-who" data-menu>
          <button type="button" class="ws-whobtn" data-menu-btn aria-expanded="false" aria-haspopup="true">
            <span class="ws-whoav">DC</span>
            <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ws-dropdown ws-dropdown--right" role="menu">
            <div class="ws-dropdown-head"><strong>Danielle Carter</strong><span>danielle@marinaestates.co.uk</span></div>
            <a role="menuitem" href="/profile">Your profile</a>
            <a role="menuitem" href="/profile">Brand Kit</a>
            <a role="menuitem" href="/account/orders">Billing</a>
            <a role="menuitem" href="/login" class="ws-dropdown-out">Sign out</a>
          </div>
        </div>
      </div>
    </header>

    <main class="ws-main">
      <!-- ============ Left: the workflow ============ -->
      <div class="ws-left">
        <!-- HERO — brief + dominant design preview -->
        <section class="ws-hero ws-rise" style="--i:0">
          <div class="ws-hero-brief">
            <h1 class="ws-greeting"><span class="ws-greeting-sm">Good morning,</span><em>Danielle.</em></h1>
            <ul class="ws-brief">
              <li style="--d:1"><span class="ws-brief-ic ws-brief-ic--sched"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg></span><span><strong id="brief-sched">— posts</strong> scheduled this week</span></li>
              <li style="--d:2"><span class="ws-brief-ic ws-brief-ic--eng"><svg viewBox="0 0 24 24"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/></svg></span><span>Engagement <strong id="brief-eng">up 12%</strong> this week</span></li>
              <li style="--d:3"><span class="ws-brief-ic ws-brief-ic--time"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span>Best time to post <strong id="brief-time">6:30pm</strong></span></li>
              <li style="--d:4"><span class="ws-brief-ic ws-brief-ic--star"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2.6l2.72 5.52 6.08.88-4.4 4.29 1.04 6.06L12 16.98l-5.44 2.85 1.04-6.06-4.4-4.29 6.08-.88z"/></svg></span><span><strong>Wimbledon</strong> pack unlocks tomorrow</span></li>
            </ul>
            <div class="ws-hero-cta">
              <a class="ws-btn ws-btn--primary" href="/editor">Continue designing
                <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>

          <a class="ws-hero-preview" href="/editor" aria-label="Continue Just Listed — Marina Heights">
            <img src="/assets/cosy%20home.jpg" alt="Just Listed — Marina Heights design in progress" loading="eager" />
            <div class="ws-hero-preview-foot">
              <h3>Just Listed<br>Marina Heights</h3>
              <div class="ws-hero-progress">
                <span class="ws-hero-pct"><b data-count="80">0</b>%</span>
                <span class="ws-hero-track"><span class="ws-hero-fill" data-val="80"></span></span>
              </div>
            </div>
          </a>
        </section>

        <!-- PLAN -->
        <section class="ws-block ws-rise" style="--i:2" aria-labelledby="plan-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="plan-h">This Week</h2>
          </header>
          <div class="ws-week">
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Mon</span><span class="ws-day-type">Just Listed</span><span class="ws-day-thumb" style="background-image:url('/assets/home%20kitchen.jpg')"></span></a>
            <button class="ws-day ws-day--empty" type="button"><span class="ws-day-name">Tue</span><span class="ws-day-empty-msg">No content scheduled</span><span class="ws-day-plus" aria-hidden="true">+</span></button>
            <a class="ws-day is-today" href="/account/schedule"><span class="ws-day-name">Wed <i>Today</i></span><span class="ws-day-type">Market Update</span><span class="ws-day-thumb" style="background-image:url('/assets/sitting%20chair.jpg')"></span></a>
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Thu</span><span class="ws-day-type">Personal Branding</span><span class="ws-day-thumb" style="background-image:url('/assets/home%20chair.jpg')"></span></a>
            <button class="ws-day ws-day--empty" type="button"><span class="ws-day-name">Fri</span><span class="ws-day-empty-msg">No content scheduled</span><span class="ws-day-plus" aria-hidden="true">+</span></button>
          </div>
        </section>

        <!-- RECENT DESIGNS -->
        <section class="ws-block ws-rise" style="--i:3" aria-labelledby="recent-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="recent-h">Continue working</h2>
          </header>
          <div class="ws-reel">
            {recentTemplates.map((t) => (
              <a class="ws-thumb" href={`/editor?template=${encodeURIComponent(t.id)}`} style={`background-image:url('${t.thumb}')`}><span class="ws-thumb-tag">Template</span></a>
            ))}
            <a class="ws-thumb ws-thumb--new" href="/editor"><span class="ws-thumb-plus">+</span><span>New design</span></a>
          </div>
        </section>
      </div>

      <!-- ============ Right: the insights ============ -->
      <div class="ws-right">
        <!-- TODAY'S IDEA -->
        <section class="ws-widget ws-rise" style="--i:1" aria-labelledby="idea-h">
          <header class="ws-widget-head">
            <span class="ws-wtitle"><span class="ws-spark">✦</span> Today's prompt</span>
          </header>
          <p class="ws-idea" id="idea-h">“Three questions every buyer asks during a viewing — and how you answer them.”</p>
          <div class="ws-widget-foot">
            <a class="ws-btn ws-btn--primary ws-btn--sm" href="/editor">Create post
              <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <button type="button" class="ws-iconround" data-tip="Another idea" aria-label="Another idea">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5l2 2M20 12a8 8 0 0 1-14 5l-2-2"/><path d="M20 4v5h-5M4 20v-5h5"/></svg>
            </button>
          </div>
        </section>

        <!-- BRAND HEALTH -->
        <section class="ws-widget ws-rise" style="--i:2" aria-labelledby="brand-h">
          <header class="ws-widget-head">
            <span class="ws-wtitle">Brand Health</span>
            <span class="ws-ring" data-tip="Finish your Brand Kit so every design is on-brand automatically">
              <svg viewBox="0 0 36 36" aria-hidden="true"><circle class="ws-ring-bg" cx="18" cy="18" r="15.5"/><circle class="ws-ring-fg" cx="18" cy="18" r="15.5" data-ring="66"/></svg>
              <b data-count="66">0</b><i>%</i>
            </span>
          </header>
          <ul class="ws-journey" id="brand-h">
            <li class="is-done"><span class="ws-check"></span>Logo</li>
            <li class="is-done"><span class="ws-check"></span>Colours</li>
            <li class="is-done"><span class="ws-check"></span>Fonts</li>
            <li class="is-done"><span class="ws-check"></span>Instagram</li>
            <li><span class="ws-check"></span>Facebook</li>
            <li><span class="ws-check"></span>Google Business</li>
          </ul>
          <a class="ws-textlink ws-textlink--accent" href="/profile">Finish setup →</a>
        </section>

        <!-- INSTAGRAM SNAPSHOT -->
        <section class="ws-widget ws-rise" style="--i:3" aria-labelledby="ig-h">
          <header class="ws-widget-head">
            <span class="ws-wtitle"><svg class="ws-ig-svg" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none"/></svg> Instagram</span>
          </header>
          <div class="ws-metrics" id="ig-h">
            <div class="ws-metric"><span class="ws-metric-val"><b data-count="8420">0</b></span><span class="ws-metric-label">Reach <i class="ws-trend">▲ 12%</i></span></div>
            <div class="ws-metric"><span class="ws-metric-val"><b data-count="14">0</b></span><span class="ws-metric-label">Posts</span></div>
            <div class="ws-metric"><span class="ws-metric-val">+<b data-count="63">0</b></span><span class="ws-metric-label">Followers</span></div>
          </div>
          <a class="ws-best" href="/account">
            <span class="ws-best-thumb" style="background-image:url('/assets/outside.jpg')"></span>
            <span class="ws-best-text"><b>Best performer</b><i>Open house · 1,240 reach</i></span>
            <span class="ws-best-arrow">→</span>
          </a>
        </section>
      </div>

      <!-- ============ Discovery — full width ============ -->
      <a class="ws-discover ws-rise" style="--i:4" href="/edit" aria-label="Preview the Wimbledon seasonal pack">
        <div class="ws-discover-art" style="background-image:url('/assets/outside.jpg')"></div>
        <div class="ws-discover-body">
          <span class="ws-discover-flag">Unlocks tomorrow</span>
          <h2 class="ws-discover-h">Wimbledon seasonal pack</h2>
          <p class="ws-discover-desc">12 timely templates to ride the tournament buzz in your local feed.</p>
          <span class="ws-discover-cta">Preview the pack <em>→</em></span>
        </div>
      </a>
    </main>
  </div>

  <style is:global>
    /* =====================================================================
       Workspace Phase 2 — editorial, asymmetric, layered. White cards float
       on a softly textured off-white page; supporting widgets recede. Borders
       give way to whitespace + depth. Colour only for meaning.
       ===================================================================== */
    body[data-dashboard] { background: #ffffff; }
    .ws {
      --ws-bg: #ffffff;
      --ws-card: #ffffff;
      --ws-soft: #ffffff;
      --ws-ink: #1c1d22;
      --ws-tx: rgba(28, 29, 34, 0.64);
      --ws-faint: rgba(28, 29, 34, 0.46);
      --ws-line: rgba(28, 29, 34, 0.13);   /* the one light-grey outline everything shares */
      --ws-accent: var(--english-violet, #5b4a55);
      --ws-success: #3f9468;
      --ws-r-lg: 16px; --ws-r: 16px; --ws-r-sm: 12px;
      --ws-sh-hero: none;   /* no shadows — hierarchy comes from outline + space */
      --ws-sh: none;
      --ws-ease: cubic-bezier(.2, .8, .2, 1);
      min-height: 100vh;
      color: var(--ws-ink);
      font-family: var(--sans);
      background: #ffffff;
    }

    /* ---------- Navigation — clean, no chrome, not sticky ---------- */
    .ws-nav {
      position: relative;
      display: flex; align-items: center; gap: clamp(14px, 2.4vw, 36px);
      padding: 22px clamp(22px, 2.6vw, 56px) 16px;
      background: transparent;
    }
    .ws-burger { flex: 0 0 auto; }
    .ws-burgerbtn {
      width: 46px; height: 46px; border: 0; border-radius: 12px; background: transparent;
      color: var(--ws-ink); cursor: pointer; display: inline-flex; align-items: center; justify-content: center;
      transition: background 0.2s;
    }
    .ws-burgerbtn:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-burgerbtn svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }

    .ws-tabs { flex: 1; display: flex; align-items: center; justify-content: center; gap: clamp(12px, 1.9vw, 36px); }
    .ws-tab {
      position: relative; display: inline-flex; align-items: center;
      padding: 6px 2px; font-size: clamp(15px, 1.1vw, 17px); font-weight: 500;
      color: var(--ws-tx); text-decoration: none; border: 0; background: transparent; cursor: pointer; font-family: inherit;
      transition: color 0.2s;
    }
    .ws-tab:hover { color: var(--ws-ink); }
    .ws-tab.is-active { color: var(--ws-ink); font-weight: 600; }
    .ws-tab.is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -7px; height: 2px; border-radius: 2px; background: var(--ws-ink); }
    .ws-caret { width: 9px; height: 6px; opacity: 0.55; transition: transform 0.25s var(--ws-ease); }

    .ws-nav-right { flex: 0 0 auto; display: flex; align-items: center; gap: 10px; }
    .ws-navic {
      position: relative; width: 42px; height: 42px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      background: transparent; border: 0; cursor: pointer; color: var(--ws-tx);
      transition: background 0.2s, color 0.2s, transform 0.2s var(--ws-ease);
    }
    .ws-navic:hover { background: rgba(28, 29, 34, 0.05); color: var(--ws-ink); }
    .ws-navic svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-dot { position: absolute; top: 9px; right: 11px; width: 7px; height: 7px; border-radius: 50%; background: var(--ws-accent); box-shadow: 0 0 0 2px #fff; }
    .ws-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

    .ws-whobtn { display: inline-flex; align-items: center; gap: 7px; padding: 4px 8px 4px 4px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; font-family: inherit; transition: background 0.2s; }
    .ws-whobtn:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-whoav { width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; letter-spacing: 0.03em; color: #fff; background: linear-gradient(140deg, color-mix(in srgb, var(--ws-accent) 70%, #fff), var(--ws-accent)); background-size: cover; background-position: center; }

    /* ---------- Dropdowns ---------- */
    .ws-menu { position: relative; }
    .ws-dropdown { position: absolute; top: calc(100% + 10px); left: 0; min-width: 210px; padding: 8px; background: #fff; border: 1px solid var(--ws-line); border-radius: 14px; box-shadow: 0 24px 50px -22px rgba(28,29,34,0.28); opacity: 0; transform: translateY(-6px) scale(0.98); transform-origin: top left; pointer-events: none; transition: opacity 0.2s var(--ws-ease), transform 0.2s var(--ws-ease); z-index: 50; }
    .ws-menu.is-open .ws-dropdown { opacity: 1; transform: none; pointer-events: auto; }
    .ws-menu.is-open .ws-caret { transform: rotate(180deg); }
    .ws-dropdown a { display: block; padding: 10px 12px; border-radius: 9px; font-size: 13.5px; color: var(--ws-tx); text-decoration: none; transition: background 0.16s, color 0.16s; }
    .ws-dropdown a:hover { background: rgba(28, 29, 34, 0.05); color: var(--ws-ink); }
    .ws-dropdown-head { padding: 8px 12px 10px; border-bottom: 1px solid var(--ws-line); margin-bottom: 6px; display: flex; flex-direction: column; gap: 2px; }
    .ws-dropdown-head strong { font-size: 14px; color: var(--ws-ink); }
    .ws-dropdown-head span { font-size: 12px; color: var(--ws-faint); }
    .ws-dropdown-out { color: var(--ws-accent) !important; font-weight: 600; }
    .ws-dropdown--mega { min-width: 232px; }
    .ws-dd-sec { margin: 10px 12px 2px; font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-faint); }

    /* Widget titles — black, plain-case, optional leading glyph */
    .ws-wtitle { display: inline-flex; align-items: center; gap: 8px; font-family: var(--subhead); font-size: 17px; font-weight: 500; letter-spacing: -0.01em; color: var(--ws-ink); }
    .ws-spark { color: #e3a008; font-size: 14px; }
    .ws-ig-svg { width: 17px; height: 17px; fill: none; stroke: #E1306C; stroke-width: 1.7; }
    .ws-iconround { width: 38px; height: 38px; flex: 0 0 auto; border-radius: 50%; border: 1px solid var(--ws-line); background: #fff; color: var(--ws-tx); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: transform 0.2s var(--ws-ease), color 0.2s, border-color 0.2s; }
    .ws-iconround:hover { transform: rotate(-90deg); color: var(--ws-ink); border-color: rgba(28,29,34,0.28); }
    .ws-iconround svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

    /* ---------- Layout: asymmetric two columns + full-width discovery ---------- */
    .ws-main {
      max-width: 1840px; margin: 0 auto;
      padding: clamp(24px, 3.4vh, 44px) clamp(22px, 2.6vw, 56px) 120px;
      display: grid; grid-template-columns: minmax(0, 1fr) clamp(300px, 24vw, 384px);
      gap: clamp(22px, 2.4vw, 40px);
      align-items: start;
    }
    .ws-left, .ws-right { display: flex; flex-direction: column; gap: clamp(22px, 3vh, 40px); min-width: 0; }
    .ws-discover { grid-column: 1 / -1; }
    @media (max-width: 940px) { .ws-main { grid-template-columns: 1fr; } }

    /* ---------- Common bits ---------- */
    .ws-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 0; }
    .ws-textlink { font-size: 13px; font-weight: 600; color: var(--ws-tx); background: none; border: 0; padding: 0; cursor: pointer; font-family: inherit; text-decoration: none; transition: color 0.2s; }
    .ws-textlink:hover { color: var(--ws-ink); }
    .ws-textlink--accent { color: var(--ws-accent); }
    .ws-btn { display: inline-flex; align-items: center; gap: 9px; padding: 13px 22px; border-radius: 13px; font-family: inherit; font-size: 14px; font-weight: 600; text-decoration: none; cursor: pointer; border: 1px solid transparent; transition: transform 0.22s var(--ws-ease), box-shadow 0.22s, background 0.2s; }
    .ws-btn svg { width: 15px; height: 15px; }
    .ws-btn--sm { padding: 10px 16px; font-size: 13px; border-radius: 11px; }
    .ws-btn--primary { background: var(--ws-accent); color: #fff; box-shadow: 0 12px 24px -12px color-mix(in srgb, var(--ws-accent) 80%, transparent); }
    .ws-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 18px 32px -12px color-mix(in srgb, var(--ws-accent) 75%, transparent); }
    .ws-btn--primary svg { transition: transform 0.25s var(--ws-ease); }
    .ws-btn--primary:hover svg { transform: translateX(3px); }
    .ws-pilltag { font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 12%, #fff); padding: 5px 10px; border-radius: 999px; }
    .ws-pilltag--soft { color: var(--ws-faint); background: rgba(28,29,34,0.05); }

    /* ---------- HERO — no box; brief as text beside a square design photo ---------- */
    .ws-hero {
      display: grid; grid-template-columns: 0.82fr 1.18fr; align-items: stretch;
      gap: clamp(24px, 3vw, 52px); background: transparent;
    }
    .ws-hero-brief { display: flex; flex-direction: column; padding: 4px 0; }
    .ws-greeting { font-family: var(--subhead); margin: 0; line-height: 1.0; color: var(--ws-ink); }
    .ws-greeting-sm { display: block; font-size: clamp(20px, 1.9vw, 26px); font-weight: 500; font-style: normal; color: var(--ws-ink); margin-bottom: 3px; }
    .ws-greeting em { font-style: italic; font-weight: 500; font-size: clamp(40px, 4.6vw, 60px); letter-spacing: -0.02em; color: var(--ws-ink); }
    .ws-brief { list-style: none; margin: 28px 0 0; padding: 0; display: flex; flex-direction: column; gap: 14px; }
    .ws-brief li { display: flex; align-items: center; gap: 13px; font-size: 15px; color: var(--ws-tx); opacity: 0; transform: translateX(-8px); animation: wsBriefIn 0.6s var(--ws-ease) forwards; animation-delay: calc(0.4s + var(--d) * 0.09s); }
    .ws-brief strong { color: var(--ws-ink); font-weight: 600; }
    .ws-brief-ic { flex: 0 0 auto; width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; background: #fff; border: 1px solid var(--ws-line); color: var(--ws-tx); }
    .ws-brief-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    /* Each brief icon its own colour, on a soft tint of that colour. */
    .ws-brief-ic--sched { color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 13%, #fff); border-color: color-mix(in srgb, var(--ws-accent) 22%, var(--ws-line)); }
    .ws-brief-ic--eng { color: #2f9e5e; background: rgba(47,158,94,0.12); border-color: rgba(47,158,94,0.26); }
    .ws-brief-ic--time { color: #2f7dc4; background: rgba(47,125,196,0.12); border-color: rgba(47,125,196,0.24); }
    .ws-brief-ic--star { color: #e3a008; background: rgba(227,160,8,0.15); border-color: rgba(227,160,8,0.30); }
    .ws-brief-ic--star svg { fill: currentColor; stroke: none; }   /* a star fills, it doesn't stroke */
    .ws-brief-ic--eng.is-down { color: #c0392b; background: rgba(192,57,43,0.10); border-color: rgba(192,57,43,0.24); }
    @keyframes wsBriefIn { to { opacity: 1; transform: none; } }
    .ws-hero-cta { margin-top: auto; padding-top: 28px; }

    .ws-hero-preview { position: relative; display: block; overflow: hidden; background: #e9e6e2; text-decoration: none; min-height: 340px; border-radius: 0; }
    .ws-hero-preview img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.3s var(--ws-ease); }
    .ws-hero-preview:hover img { transform: scale(1.05); }
    .ws-hero-preview::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,12,18,0) 42%, rgba(15,12,18,0.72) 100%); }
    .ws-hero-preview-foot { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 28px 30px; color: #fff; }
    .ws-hero-preview-foot h3 { font-family: var(--subhead); font-weight: 500; font-size: clamp(24px, 2.4vw, 34px); line-height: 1.06; letter-spacing: -0.01em; margin: 0 0 16px; }
    .ws-hero-progress { display: flex; align-items: center; gap: 14px; }
