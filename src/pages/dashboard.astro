    /* Planner week */
    .ws-week { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
    @media (max-width: 560px) { .ws-week { grid-template-columns: 1fr 1fr; } }
    .ws-day { display: flex; flex-direction: column; gap: 10px; padding: 14px; min-height: 130px; border-radius: var(--ws-r-sm); background: transparent; border: 1px solid var(--ws-line); text-decoration: none; color: var(--ws-ink); cursor: pointer; font-family: inherit; text-align: left; transition: border-color 0.25s var(--ws-ease), transform 0.25s var(--ws-ease); }
    .ws-day:hover { transform: translateY(-3px); border-color: rgba(28, 29, 34, 0.22); }
    .ws-day-name { font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ws-faint); display: flex; align-items: center; gap: 6px; }
    .ws-day-name i { font-style: normal; font-size: 9px; color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 12%, #fff); padding: 2px 6px; border-radius: 999px; }
    .ws-day-type { font-size: 13px; font-weight: 600; color: var(--ws-ink); line-height: 1.25; }
    .ws-day-thumb { height: 56px; border-radius: 9px; background-size: cover; background-position: center; background-color: #e9e6e2; margin-top: auto; transition: height 0.28s var(--ws-ease); }
    .ws-day:hover .ws-day-thumb { height: 64px; }
    .ws-day--empty { justify-content: space-between; position: relative; }
    .ws-day--empty:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--ws-accent) 40%, var(--ws-line)); }
    .ws-day-empty-msg { font-size: 12px; font-weight: 500; color: var(--ws-faint); margin-top: auto; transition: opacity 0.2s; }
    .ws-day-plus { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 30px; font-weight: 200; line-height: 1; color: var(--ws-accent); opacity: 0; transition: opacity 0.2s; pointer-events: none; }
    .ws-day--empty:hover .ws-day-empty-msg { opacity: 0; }
    .ws-day--empty:hover .ws-day-plus { opacity: 1; }

    /* Recent designs reel — portrait, fan out on hover */
    .ws-reel { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
    @media (max-width: 720px) { .ws-reel { grid-template-columns: repeat(3, 1fr); } }
    .ws-thumb { position: relative; aspect-ratio: 4 / 5; border-radius: 13px; overflow: hidden; background-size: cover; background-position: center; background-color: #e9e6e2; text-decoration: none; display: block; box-shadow: var(--ws-sh); transform-origin: bottom center; transition: transform 0.32s var(--ws-ease), box-shadow 0.32s; }
    .ws-reel:hover .ws-thumb:nth-child(1) { transform: rotate(-3deg) translateY(-2px); }
    .ws-reel:hover .ws-thumb:nth-child(2) { transform: rotate(-1.5deg) translateY(-2px); }
    .ws-reel:hover .ws-thumb:nth-child(4) { transform: rotate(1.5deg) translateY(-2px); }
    .ws-reel:hover .ws-thumb:nth-child(5) { transform: rotate(3deg) translateY(-2px); }
    .ws-reel .ws-thumb:hover { transform: translateY(-7px) rotate(0deg) scale(1.03); box-shadow: 0 22px 38px -16px rgba(28,29,34,0.45); z-index: 2; }
    .ws-thumb-tag { position: absolute; bottom: 8px; left: 8px; padding: 3px 8px; border-radius: 999px; background: rgba(255,255,255,0.92); font-size: 10px; font-weight: 700; color: var(--ws-accent); }
    .ws-thumb-tag--done { color: var(--ws-success); }
    .ws-thumb--new { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px; background: transparent; box-shadow: inset 0 0 0 1.5px var(--ws-line); font-size: 12px; font-weight: 600; color: var(--ws-faint); }
    .ws-thumb--new:hover { box-shadow: inset 0 0 0 1.5px var(--ws-accent); color: var(--ws-accent); transform: translateY(-7px); }
    .ws-thumb-plus { font-size: 26px; line-height: 1; font-weight: 300; }

    /* ---------- Right column widgets — lighter, recede ---------- */
    .ws-widget { background: transparent; border: 1px solid var(--ws-line); border-radius: var(--ws-r); padding: 22px 24px; display: flex; flex-direction: column; gap: 14px; transition: border-color 0.25s var(--ws-ease); }
    .ws-widget:hover { border-color: rgba(28, 29, 34, 0.22); }
    .ws-widget-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .ws-idea { font-family: var(--subhead); font-style: italic; font-size: clamp(18px, 1.7vw, 21px); line-height: 1.4; color: var(--ws-ink); margin: 0; }
    .ws-widget-foot { display: flex; align-items: center; gap: 16px; margin-top: 2px; }

    /* Brand health */
    .ws-ring { position: relative; width: 50px; height: 50px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; }
    .ws-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
    .ws-ring-bg { fill: none; stroke: rgba(28,29,34,0.1); stroke-width: 3; }
    .ws-ring-fg { fill: none; stroke: var(--ws-success); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 97.4; stroke-dashoffset: 97.4; transition: stroke-dashoffset 1.2s var(--ws-ease); }
    .ws-ring b { font-family: var(--subhead); font-size: 14px; color: var(--ws-ink); }
    .ws-ring i { font-size: 8px; color: var(--ws-faint); font-style: normal; }
    .ws-journey { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
    .ws-journey li { display: flex; align-items: center; gap: 11px; font-size: 13.5px; color: var(--ws-faint); }
    .ws-journey li.is-done { color: var(--ws-ink); }
    .ws-check { flex: 0 0 auto; width: 17px; height: 17px; border-radius: 50%; border: 1.5px solid var(--ws-line); position: relative; }
    .ws-journey li.is-done .ws-check { background: var(--ws-success); border-color: var(--ws-success); }
    .ws-journey li.is-done .ws-check::after { content: ""; position: absolute; left: 5px; top: 2.5px; width: 4px; height: 7px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }

    /* Instagram snapshot */
    .ws-metrics { display: flex; gap: 20px; }
    .ws-metric { display: flex; flex-direction: column; gap: 3px; }
    .ws-metric-val { font-family: var(--subhead); font-size: clamp(24px, 2.4vw, 30px); line-height: 1; letter-spacing: -0.02em; color: var(--ws-ink); }
    .ws-metric-label { font-size: 11px; color: var(--ws-faint); display: flex; align-items: center; gap: 5px; }
    .ws-trend { font-style: normal; font-size: 10px; font-weight: 700; color: var(--ws-success); }
    .ws-best { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: var(--ws-r-sm); background: transparent; border: 1px solid var(--ws-line); text-decoration: none; color: var(--ws-ink); transition: border-color 0.22s var(--ws-ease); }
    .ws-best:hover { border-color: rgba(28, 29, 34, 0.22); }
    .ws-best-thumb { width: 44px; height: 44px; border-radius: 10px; background-size: cover; background-position: center; flex: 0 0 auto; }
    .ws-best-text { display: flex; flex-direction: column; gap: 1px; flex: 1; }
    .ws-best-text b { font-size: 13px; font-weight: 600; }
    .ws-best-text i { font-style: normal; font-size: 11.5px; color: var(--ws-faint); }
    .ws-best-arrow { color: var(--ws-faint); font-size: 16px; transition: transform 0.25s var(--ws-ease); }
    .ws-best:hover .ws-best-arrow { transform: translateX(3px); color: var(--ws-accent); }

    /* ---------- Discovery — full-width finish ---------- */
    .ws-discover { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; min-height: 230px; border-radius: var(--ws-r-lg); overflow: hidden; background: #2a2530; box-shadow: var(--ws-sh-hero); text-decoration: none; }
    .ws-discover-art { position: relative; background-size: cover; background-position: center; transition: transform 1.2s var(--ws-ease); }
    .ws-discover:hover .ws-discover-art { transform: scale(1.05); }
    .ws-discover-body { position: relative; padding: clamp(28px, 3vw, 44px); display: flex; flex-direction: column; justify-content: center; gap: 10px; color: #fff; background: linear-gradient(110deg, #2a2530 60%, rgba(42,37,48,0.85)); }
    .ws-discover-flag { position: absolute; top: clamp(20px, 2.2vw, 30px); right: clamp(20px, 2.2vw, 30px); align-self: auto; padding: 6px 12px; border-radius: 8px; background: #fff; border: 1px solid rgba(28,29,34,0.14); color: #1c1d22; font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
    .ws-discover-h { font-family: var(--subhead); font-weight: 500; font-size: clamp(26px, 2.8vw, 38px); letter-spacing: -0.015em; margin: 0; }
    .ws-discover-desc { font-size: 14.5px; line-height: 1.55; color: rgba(255,255,255,0.72); margin: 0; max-width: 40ch; }
    .ws-discover-cta { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: #fff; margin-top: 8px; }
    .ws-discover-cta em { font-style: normal; display: inline-block; transition: transform 0.25s var(--ws-ease); }
    .ws-discover:hover .ws-discover-cta em { transform: translateX(4px); }
    @media (max-width: 620px) { .ws-discover { grid-template-columns: 1fr; } .ws-discover-art { min-height: 180px; } .ws-discover-body { background: #2a2530; } }

    /* ---------- Tooltips ---------- */
    [data-tip] { position: relative; }
    [data-tip]::after { content: attr(data-tip); position: absolute; bottom: calc(100% + 9px); left: 50%; transform: translateX(-50%) translateY(4px); width: max-content; max-width: 220px; padding: 9px 12px; border-radius: 10px; background: #1c1d22; color: #fff; font-size: 12px; font-weight: 500; line-height: 1.4; letter-spacing: 0; text-transform: none; text-align: center; white-space: normal; opacity: 0; pointer-events: none; z-index: 60; box-shadow: 0 12px 28px -10px rgba(0,0,0,0.4); transition: opacity 0.22s var(--ws-ease), transform 0.22s var(--ws-ease); }
    [data-tip]:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* ---------- Entrance ---------- */
    .ws-rise { opacity: 0; transform: translateY(24px); }
    body.ws-ready .ws-rise { animation: wsRise 0.8s var(--ws-ease) both; animation-delay: calc(var(--i) * 0.1s); }
    @keyframes wsRise { to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .ws-rise, .ws-brief li { opacity: 1 !important; transform: none !important; animation: none !important; } .ws-hero-fill, .ws-ring-fg { transition: none !important; } }
  </style>

  <script>
    requestAnimationFrame(() => document.body.classList.add('ws-ready'));

    // Dropdowns
    const menus = [...document.querySelectorAll('[data-menu]')];
    function closeAll(except) { menus.forEach((m) => { if (m !== except) { m.classList.remove('is-open'); m.querySelector('[data-menu-btn]')?.setAttribute('aria-expanded', 'false'); } }); }
    menus.forEach((m) => { const b = m.querySelector('[data-menu-btn]'); b?.addEventListener('click', (e) => { e.stopPropagation(); const open = m.classList.toggle('is-open'); b.setAttribute('aria-expanded', String(open)); closeAll(m); }); });
    document.addEventListener('click', () => closeAll(null));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(null); });

    // Count-up + bars/ring on view
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function animateCount(el) {
      const target = parseFloat(el.getAttribute('data-count')) || 0;
      const dur = 1100, start = performance.now(), fmt = (n) => Math.round(n).toLocaleString('en-GB');
      function tick(now) { const p = Math.min(1, (now - start) / dur); el.textContent = fmt(target * (1 - Math.pow(1 - p, 3))); if (p < 1) requestAnimationFrame(tick); else el.textContent = fmt(target); }
      requestAnimationFrame(tick);
    }
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return; obs.unobserve(e.target); const t = e.target;
        if (reduce) t.querySelectorAll('[data-count]').forEach((n) => { n.textContent = (parseFloat(n.getAttribute('data-count')) || 0).toLocaleString('en-GB'); });
        else t.querySelectorAll('[data-count]').forEach(animateCount);
        t.querySelectorAll('[data-val]').forEach((b) => { b.style.width = (b.getAttribute('data-val') || 0) + '%'; });
        t.querySelectorAll('[data-ring]').forEach((r) => { const pct = parseFloat(r.getAttribute('data-ring')) || 0; r.style.strokeDashoffset = String(2 * Math.PI * 15.5 * (1 - pct / 100)); });
      });
    }, { threshold: 0.25 });
    document.querySelectorAll('.ws-hero, .ws-widget').forEach((el) => io.observe(el));
  </script>

  <!-- Stage A migration: wire the real signed-in identity. Falls back to the
       mock preview when signed out (the hard login-gate lands at go-live). -->
  <script>
    import { supabase } from '../lib/supabase.js';

    const titleCase = (s) => String(s || '').replace(/\b\w+/g, (w) => w.charAt(0).toUpperCase() + w.slice(1));
    const escapeHtml = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    (async () => {
      try {
        const isDemo = import.meta.env.DEV && location.search.includes('demo=1');
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          // Live workspace — require sign-in. (Dev ?demo=1 still previews the mock.)
          if (!isDemo) { location.replace('/login?next=' + encodeURIComponent('/dashboard')); return; }
          return;
        }

        const email = session.user.email ?? '';
        const meta = session.user.user_metadata ?? {};
        const fullName = titleCase(meta.name || email.split('@')[0].replace(/[._]/g, ' '));
        const firstName = fullName.split(' ')[0];
        const initials = fullName.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase() || 'T';

        const hour = new Date().getHours();
        let greeting = 'Welcome back';
        if (hour >= 5 && hour < 12) greeting = 'Good morning';
        else if (hour >= 12 && hour < 17) greeting = 'Good afternoon';
        else if (hour >= 17 && hour < 22) greeting = 'Good evening';
        else greeting = 'Burning the midnight oil';

        const g = document.querySelector('.ws-greeting');
        if (g) g.innerHTML = `<span class="ws-greeting-sm">${escapeHtml(greeting)},</span><em>${escapeHtml(firstName)}.</em>`;

        document.querySelectorAll('.ws-whoav').forEach((e) => { e.textContent = initials; });
        const setText = (sel, val) => { const el = document.querySelector(sel); if (el && val) el.textContent = val; };
        setText('.ws-whotext strong', fullName);
        setText('.ws-whotext span', email);
        setText('.ws-dropdown-head strong', fullName);
        setText('.ws-dropdown-head span', email);

        // Headshot from the brand kit, if they've set one.
        try {
          const bk = JSON.parse(localStorage.getItem('tmke.brand') || 'null');
          if (bk && typeof bk.headshot === 'string' && bk.headshot) {
            document.querySelectorAll('.ws-whoav').forEach((e) => {
              e.textContent = '';
              e.style.backgroundImage = 'url(' + JSON.stringify(bk.headshot) + ')';
              e.style.backgroundSize = 'cover';
              e.style.backgroundPosition = 'center';
            });
          }
        } catch (_) {}
      } catch (_) { /* keep the mock preview on any error */ }
    })();

    // ---- Stage A.2: real recent designs (local editor drafts) ----
    function readLocalDrafts() {
      const drafts = [];
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (!key || !key.startsWith('tmke.editor.')) continue;
          const id = key.replace('tmke.editor.', '');
          try {
            const v = JSON.parse(localStorage.getItem(key) || 'null');
            if (!v) continue;
            drafts.push({ id, filename: v.filename || id, savedAt: v.savedAt || 0, thumb: v.thumb || null });
          } catch (_) {}
        }
      } catch (_) {}
      drafts.sort((a, b) => b.savedAt - a.savedAt);
      return drafts;
    }
    const fmtSaved = (ts) => ts ? new Date(ts).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Saved locally';
    const editHref = (id) => '/editor?template=' + encodeURIComponent(id);

    (function wireWork() {
      const drafts = readLocalDrafts();
      if (!drafts.length) return; // no saved work yet → keep the starter templates

      // Hero preview = the most recently edited draft.
      const top = drafts[0];
      const heroImg = document.querySelector('.ws-hero-preview img');
      const heroTitle = document.querySelector('.ws-hero-preview-foot h3');
      const heroLink = document.querySelector('.ws-hero-preview');
      const heroProg = document.querySelector('.ws-hero-progress');
      const heroCta = document.querySelector('.ws-hero-cta a.ws-btn--primary');
      if (top.thumb && heroImg) { heroImg.src = top.thumb; heroImg.alt = top.filename; }
      if (heroTitle) heroTitle.textContent = top.filename;
      if (heroLink) heroLink.setAttribute('href', editHref(top.id));
      if (heroCta) heroCta.setAttribute('href', editHref(top.id));
      if (heroProg) heroProg.innerHTML = `<span class="ws-hero-pct">Last edited ${escapeHtml(fmtSaved(top.savedAt))}</span>`;

      // Recent designs reel = the latest drafts + a "New design" tile.
      const reel = document.querySelector('.ws-reel');
      if (reel) {
        const cards = drafts.slice(0, 4).map((d) => `
          <a class="ws-thumb" href="${editHref(d.id)}"${d.thumb ? ` style="background-image:url('${escapeHtml(d.thumb)}')"` : ''}>
            <span class="ws-thumb-tag">Draft</span>
          </a>`).join('');
        reel.innerHTML = cards + `
          <a class="ws-thumb ws-thumb--new" href="/editor"><span class="ws-thumb-plus">+</span><span>New design</span></a>`;
      }
    })();

    // ---- Stage A.5: real Brand Health (from the saved brand kit) ----
    (function wireBrandHealth() {
      let brand;
      try { brand = JSON.parse(localStorage.getItem('tmke.brand') || 'null'); } catch (_) { brand = null; }
      if (!brand) return; // no brand kit saved yet → keep the mock

      const hasLogo = (brand.logos || []).length > 0;
      const hasColours = (brand.colors || []).filter((c) => c && c.hex).length > 0;
      const hasFonts = !!(brand.fonts && (brand.fonts.heading || brand.fonts.body));
      const items = [...document.querySelectorAll('.ws-journey li')];
      if (items.length < 3) return;
      items[0].classList.toggle('is-done', hasLogo);
      items[1].classList.toggle('is-done', hasColours);
      items[2].classList.toggle('is-done', hasFonts);
      // Social connections aren't wired to a live source yet → show as to-do.
      items.slice(3).forEach((li) => li.classList.remove('is-done'));

      const done = items.filter((li) => li.classList.contains('is-done')).length;
      const pct = Math.round((done / items.length) * 100);
      // Hand the real % to the same observer that animates the ring + number.
      const ring = document.querySelector('.ws-ring-fg');
      if (ring) ring.setAttribute('data-ring', String(pct));
      const num = document.querySelector('.ws-ring b');
      if (num) num.setAttribute('data-count', String(pct));
    })();

    // ---- Stage A.4: real planner (this week from calendar_items) ----
    (async function wirePlanner() {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return; // signed out → keep the mock week

        const ymd = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        const now = new Date();
        const monday = new Date(now);
        monday.setDate(now.getDate() - ((now.getDay() + 6) % 7)); // back to Monday
        monday.setHours(0, 0, 0, 0);
        const weekEnd = new Date(monday); weekEnd.setDate(monday.getDate() + 5); // Mon..Fri

        const { data, error } = await supabase
          .from('calendar_items')
          .select('*')
          .eq('user_id', session.user.id)
          .gte('scheduled_date', ymd(monday))
          .lt('scheduled_date', ymd(weekEnd))
          .in('status', ['scheduled', 'reminder_sent', 'done'])
          .order('scheduled_date', { ascending: true });
        if (error) return;

        const byDate = {};
        (data || []).forEach((it) => { if (it.scheduled_date && !byDate[it.scheduled_date]) byDate[it.scheduled_date] = it; });

        const week = document.querySelector('.ws-week');
        if (!week) return;
        const todayYmd = ymd(new Date());
        const names = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
        week.innerHTML = names.map((nm, i) => {
          const d = new Date(monday); d.setDate(monday.getDate() + i);
          const dYmd = ymd(d);
          const isToday = dYmd === todayYmd ? ' is-today' : '';
          const nameHtml = `<span class="ws-day-name">${nm}${dYmd === todayYmd ? ' <i>Today</i>' : ''}</span>`;
          const href = `/account/schedule?focus=${dYmd}`;
          const it = byDate[dYmd];
          if (it) {
            const thumb = it.thumbnail_url || it.asset_url || '';
            const label = it.title || it.caption || it.content_type || it.name || 'Scheduled';
            return `<a class="ws-day${isToday}" href="${href}"><span class="ws-day-name">${nm}${dYmd === todayYmd ? ' <i>Today</i>' : ''}</span><span class="ws-day-type">${escapeHtml(String(label))}</span><span class="ws-day-thumb"${thumb ? ` style="background-image:url('${escapeHtml(thumb)}')"` : ''}></span></a>`;
          }
          return `<a class="ws-day ws-day--empty${isToday}" href="${href}">${nameHtml}<span class="ws-day-empty-msg">No content scheduled</span><span class="ws-day-plus" aria-hidden="true">+</span></a>`;
        }).join('');

        // Hero brief: live count of posts scheduled this week.
        const schedCount = (data || []).length;
        const sb = document.getElementById('brief-sched');
        if (sb) sb.textContent = schedCount + (schedCount === 1 ? ' post' : ' posts');

        // Best time to post: their most common scheduled hour if they have a
        // pattern; otherwise the evening slot Instagram currently favours.
        const tb = document.getElementById('brief-time');
        if (tb) {
          const hours = {};
          (data || []).forEach((it) => {
            const t = it.scheduled_time || it.scheduled_at || '';
            const m = String(t).match(/(\d{1,2}):(\d{2})/);
            if (m) { const h = m[1] + ':' + m[2]; hours[h] = (hours[h] || 0) + 1; }
          });
          const top = Object.keys(hours).sort((a, b) => hours[b] - hours[a])[0];
          if (top) {
            const [H, M] = top.split(':').map(Number);
            const ap = H >= 12 ? 'pm' : 'am'; const h12 = ((H + 11) % 12) + 1;
            tb.textContent = h12 + (M ? ':' + String(M).padStart(2, '0') : '') + ap;
          }
        }
      } catch (_) { /* keep the mock week */ }
    })();

    // ---- Stage A.3: real discovery card (a pack from The Edit) ----
    (async function wireDiscovery() {
      try {
        const { data } = await supabase
          .from('packs')
          .select('slug, title, description, cover_image_url, status, sort_order, created_at')
          .eq('status', 'active')
          .order('sort_order', { ascending: true })
          .order('created_at', { ascending: false })
          .limit(1);
        const pack = (data || [])[0];
        if (!pack) return; // no live packs → keep the mock Wimbledon card

        const card = document.querySelector('.ws-discover');
        if (card && pack.slug) card.setAttribute('href', '/edit/' + encodeURIComponent(pack.slug));
        const art = document.querySelector('.ws-discover-art');
        if (art && pack.cover_image_url) art.style.backgroundImage = `url('${pack.cover_image_url}')`;
        const h = document.querySelector('.ws-discover-h');
        if (h) h.textContent = pack.title;
        const desc = document.querySelector('.ws-discover-desc');
        if (desc && pack.description) desc.textContent = pack.description;
        const flag = document.querySelector('.ws-discover-flag');
        if (flag) flag.textContent = 'New in The Edit';
      } catch (_) { /* keep the mock */ }
    })();
  </script>
</BaseLayout>
