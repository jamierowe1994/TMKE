    @media (max-width: 620px) { .ws-hero { grid-template-columns: 1fr; } .ws-hero-preview { min-height: 300px; } }

    /* ---------- Section blocks (plan, recent) — borderless, grouped by space ---------- */
    .ws-block { display: flex; flex-direction: column; gap: 16px; }
    .ws-block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 0 2px; }
