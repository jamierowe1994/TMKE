---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<!--
  New TMKE workspace — a calm, action-first "creative operating system" for
  estate agents. Standalone preview (mock data) so the live /account stays
  untouched until this direction is signed off.

  Curated against the brief's "show less" rule. The page answers three
  questions, top to bottom:
    1. What should I create today?  → brief + the big Continue-editing card
    2. What have I been working on?  → recent designs + Instagram snapshot
    3. What's new?                   → seasonal pack + brand-health journey
  Everything else (Manage / Resources) is tucked into nav dropdowns.
-->
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Your TMKE — workspace"
  description="Your marketing brief for the day, your designs in progress, and what's new — all in one calm place."
>
  <div class="ws">
    <!-- ============ Top navigation ============ -->
    <header class="ws-nav" aria-label="Primary">
      <!-- LEFT: the person -->
      <div class="ws-menu ws-who" data-menu>
        <button type="button" class="ws-whobtn" data-menu-btn aria-expanded="false" aria-haspopup="true">
          <span class="ws-whoav">D</span>
          <span class="ws-whotext">
            <strong>Danielle Carter</strong>
            <span>Marina Estates</span>
          </span>
          <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
        <div class="ws-dropdown" role="menu">
          <div class="ws-dropdown-head">
            <strong>Danielle Carter</strong>
            <span>danielle@marinaestates.co.uk</span>
          </div>
          <a role="menuitem" href="/profile">Your profile</a>
          <a role="menuitem" href="/profile">Brand Kit</a>
          <a role="menuitem" href="/account/orders">Billing</a>
          <a role="menuitem" href="/login" class="ws-dropdown-out">Sign out</a>
        </div>
      </div>

      <nav class="ws-tabs" aria-label="Sections">
        <a class="ws-tab is-active" href="/dashboard" aria-current="page">Dashboard</a>
        <a class="ws-tab" href="/editor">Studio</a>
        <a class="ws-tab" href="/edit">Library</a>
        <a class="ws-tab" href="/account/schedule">Planner</a>
        <a class="ws-tab" href="/account/guides">Learn</a>
        <a class="ws-tab" href="/account">Analytics</a>

        <div class="ws-menu" data-menu>
          <button type="button" class="ws-tab ws-tab--menu" data-menu-btn aria-expanded="false" aria-haspopup="true">
            Manage <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ws-dropdown" role="menu">
            <a role="menuitem" href="/profile">Brand Kit</a>
            <a role="menuitem" href="/account/services">Managed Socials</a>
            <a role="menuitem" href="/account/bookings">Bookings</a>
            <a role="menuitem" href="/account/orders">Orders</a>
            <a role="menuitem" href="/account/orders">Billing</a>
            <a role="menuitem" href="/profile">Settings</a>
          </div>
        </div>

        <div class="ws-menu" data-menu>
          <button type="button" class="ws-tab ws-tab--menu" data-menu-btn aria-expanded="false" aria-haspopup="true">
            Resources <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ws-dropdown" role="menu">
            <a role="menuitem" href="/account/guides">Guides</a>
            <a role="menuitem" href="/account/blog">Blog</a>
            <a role="menuitem" href="/contact">Contact</a>
            <a role="menuitem" href="/contact">Help Centre</a>
          </div>
        </div>
      </nav>

      <div class="ws-nav-right">
        <button type="button" class="ws-circ" data-tip="Search anything — designs, packs, guides">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg>
          <span class="ws-sr">Search</span>
        </button>
        <button type="button" class="ws-circ" data-tip="3 new updates">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg>
          <span class="ws-dot" aria-hidden="true"></span>
          <span class="ws-sr">Notifications</span>
        </button>
        <button type="button" class="ws-circ" data-tip="Help &amp; guides">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.6 9a2.4 2.4 0 1 1 3.4 2.2c-.8.4-1 .8-1 1.6"/><line x1="12" y1="16.5" x2="12" y2="16.5"/></svg>
          <span class="ws-sr">Help</span>
        </button>
      </div>
    </header>

    <main class="ws-main">
      <!-- ============ Hero — the morning brief ============ -->
      <section class="ws-hero ws-rise" style="--i:0">
        <p class="ws-eyebrow" id="ws-date">Friday, 27 June</p>
        <h1 class="ws-greeting">Good morning, <em>Danielle.</em></h1>
        <p class="ws-hero-sub">Here's your marketing brief for today.</p>

        <ul class="ws-brief">
          <li class="ws-brief-item" style="--d:1">
            <span class="ws-brief-ic ws-brief-ic--due">
              <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg>
            </span>
            <span>Your <strong>Market Update</strong> is due to post today.</span>
          </li>
          <li class="ws-brief-item" style="--d:2">
            <span class="ws-brief-ic ws-brief-ic--good">
              <svg viewBox="0 0 24 24" aria-hidden="true"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/></svg>
            </span>
            <span>Instagram engagement is <strong>up 12%</strong> this week.</span>
          </li>
          <li class="ws-brief-item" style="--d:3">
            <span class="ws-brief-ic">
              <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            </span>
            <span>Best time to post today: <strong>6:30pm</strong>.</span>
          </li>
          <li class="ws-brief-item" style="--d:4">
            <span class="ws-brief-ic ws-brief-ic--soon">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.4 5.3 5.6.5-4.2 3.7 1.3 5.5L12 20.7 6.9 23.5l1.3-5.5L4 14.3l5.6-.5z" transform="scale(0.9) translate(1.3 -1)"/></svg>
            </span>
            <span>Your <strong>Wimbledon</strong> seasonal pack unlocks tomorrow.</span>
          </li>
        </ul>

        <div class="ws-hero-actions">
          <a class="ws-btn ws-btn--primary" href="/editor">
            Continue Designing
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <span class="ws-hero-hint">Picks up your “Just Listed” design at 80%.</span>
        </div>
      </section>

      <!-- ============ Primary card — pick up where you left off ============ -->
      <section class="ws-feature ws-rise" style="--i:1" aria-label="Continue your work">
        <div class="ws-feature-art">
          <img src="/assets/cosy%20home.jpg" alt="Just Listed — Marina Heights design preview" loading="eager" />
          <span class="ws-feature-chip">In progress</span>
        </div>
        <div class="ws-feature-body">
          <p class="ws-card-eyebrow">Pick up where you left off</p>
          <h2 class="ws-feature-title">Just Listed — Marina Heights</h2>
          <p class="ws-feature-meta">Instagram post · 4:5 · edited 14 minutes ago</p>

          <div class="ws-progress" data-tip="Almost there — finish the caption and you're ready to schedule.">
            <div class="ws-progress-track"><span class="ws-progress-fill" data-val="80"></span></div>
            <span class="ws-progress-label"><b data-count="80">0</b>% complete</span>
          </div>

          <div class="ws-feature-actions">
            <a class="ws-btn ws-btn--primary" href="/editor">Continue Designing
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <a class="ws-btn ws-btn--ghost" href="/editor">Start something new</a>
          </div>
        </div>
      </section>

      <!-- ============ Modular widget grid ============ -->
      <div class="ws-grid">
        <!-- Today's content idea -->
        <section class="ws-card ws-span-2 ws-rise" style="--i:2" aria-labelledby="idea-h">
          <div class="ws-card-head">
            <div>
              <p class="ws-card-eyebrow">Today's content idea</p>
              <h3 class="ws-card-title" id="idea-h">A prompt to get you posting</h3>
            </div>
            <span class="ws-card-tag">Fresh daily</span>
          </div>
          <p class="ws-idea">“Three questions every buyer asks during a viewing — and how you answer them.”</p>
          <div class="ws-card-foot">
            <a class="ws-btn ws-btn--primary ws-btn--sm" href="/editor">Create this post
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <button type="button" class="ws-textlink" data-tip="We'll suggest a different angle">Give me another</button>
          </div>
        </section>

        <!-- Brand health -->
        <section class="ws-card ws-rise" style="--i:3" aria-labelledby="brand-h">
          <div class="ws-card-head">
            <div>
              <p class="ws-card-eyebrow">Brand health</p>
              <h3 class="ws-card-title" id="brand-h">Finish your setup</h3>
            </div>
            <span class="ws-ring" data-tip="Complete your Brand Kit so every design is on-brand automatically">
              <svg viewBox="0 0 36 36" aria-hidden="true">
                <circle class="ws-ring-bg" cx="18" cy="18" r="15.5"/>
                <circle class="ws-ring-fg" cx="18" cy="18" r="15.5" data-ring="66"/>
              </svg>
              <b data-count="66">0</b><i>%</i>
            </span>
          </div>
          <ul class="ws-journey">
            <li class="is-done"><span class="ws-check"></span>Logo uploaded</li>
            <li class="is-done"><span class="ws-check"></span>Brand colours added</li>
            <li class="is-done"><span class="ws-check"></span>Fonts uploaded</li>
            <li class="is-done"><span class="ws-check"></span>Instagram connected</li>
            <li><span class="ws-check"></span>Facebook connected</li>
            <li><span class="ws-check"></span>Google Business connected</li>
          </ul>
          <a class="ws-textlink ws-textlink--accent" href="/profile">Connect Facebook next →</a>
        </section>

        <!-- Content planner -->
        <section class="ws-card ws-span-2 ws-rise" style="--i:4" aria-labelledby="plan-h">
          <div class="ws-card-head">
            <div>
              <p class="ws-card-eyebrow">This week</p>
              <h3 class="ws-card-title" id="plan-h">Your content planner</h3>
            </div>
            <a class="ws-textlink" href="/account/schedule">Open planner →</a>
          </div>
          <div class="ws-week">
            <div class="ws-day">
              <span class="ws-day-name">Mon</span>
              <span class="ws-pill ws-pill--listed">Just Listed</span>
            </div>
            <div class="ws-day">
              <span class="ws-day-name">Tue</span>
              <button class="ws-day-add" type="button">+ Add</button>
            </div>
            <div class="ws-day is-today">
              <span class="ws-day-name">Wed <i>Today</i></span>
              <span class="ws-pill ws-pill--update">Market Update</span>
            </div>
            <div class="ws-day">
              <span class="ws-day-name">Thu</span>
              <button class="ws-day-add" type="button">+ Add</button>
            </div>
            <div class="ws-day">
              <span class="ws-day-name">Fri</span>
              <span class="ws-pill ws-pill--brand">Personal Branding</span>
            </div>
          </div>
        </section>

        <!-- Instagram snapshot -->
        <section class="ws-card ws-rise" style="--i:5" aria-labelledby="ig-h">
          <div class="ws-card-head">
            <div>
              <p class="ws-card-eyebrow">Instagram snapshot</p>
              <h3 class="ws-card-title" id="ig-h">Last 30 days</h3>
            </div>
            <span class="ws-tip-q" data-tip="An estimate from the designs you've published. Connect Instagram for live figures.">?</span>
          </div>
          <div class="ws-metrics">
            <div class="ws-metric">
              <span class="ws-metric-val"><b data-count="8420">0</b></span>
              <span class="ws-metric-label">Est. reach <i class="ws-trend ws-trend--up">▲ 12%</i></span>
            </div>
            <div class="ws-metric">
              <span class="ws-metric-val"><b data-count="14">0</b></span>
              <span class="ws-metric-label">Posts published</span>
            </div>
            <div class="ws-metric">
              <span class="ws-metric-val">+<b data-count="63">0</b></span>
              <span class="ws-metric-label">New followers</span>
            </div>
          </div>
          <a class="ws-textlink" href="/account">See the best performer →</a>
        </section>

        <!-- Recent designs -->
        <section class="ws-card ws-span-2 ws-rise" style="--i:6" aria-labelledby="recent-h">
          <div class="ws-card-head">
            <div>
              <p class="ws-card-eyebrow">Your work</p>
              <h3 class="ws-card-title" id="recent-h">Recent designs</h3>
            </div>
            <a class="ws-textlink" href="/account">View all →</a>
          </div>
          <div class="ws-reel">
            <a class="ws-thumb" href="/editor" style="background-image:url('/assets/cosy%20home.jpg')"><span class="ws-thumb-tag">80%</span></a>
            <a class="ws-thumb" href="/editor" style="background-image:url('/assets/home%20window.jpg')"><span class="ws-thumb-tag ws-thumb-tag--done">Done</span></a>
            <a class="ws-thumb" href="/editor" style="background-image:url('/assets/sitting%20chair.jpg')"><span class="ws-thumb-tag ws-thumb-tag--done">Done</span></a>
            <a class="ws-thumb" href="/editor" style="background-image:url('/assets/home%20forest.jpg')"><span class="ws-thumb-tag">35%</span></a>
            <a class="ws-thumb ws-thumb--new" href="/editor">
              <span class="ws-thumb-plus">+</span>
              <span>New design</span>
            </a>
          </div>
        </section>

        <!-- What's new -->
        <section class="ws-card ws-card--feature ws-rise" style="--i:7" aria-labelledby="new-h">
          <div class="ws-new-art" style="background-image:url('/assets/outside.jpg')">
            <span class="ws-new-flag">Unlocks tomorrow</span>
          </div>
          <div class="ws-new-body">
            <p class="ws-card-eyebrow">What's new</p>
            <h3 class="ws-card-title" id="new-h">Wimbledon seasonal pack</h3>
            <p class="ws-new-desc">12 timely templates to ride the tournament buzz in your local feed.</p>
            <a class="ws-textlink ws-textlink--accent" href="/edit">Preview the pack →</a>
          </div>
        </section>
      </div>
    </main>
  </div>

  <style is:global>
    /* ====================================================================
       New workspace — calm, neutral, editorial. White page, off-white
       cards, hairline borders, soft shadows, generous breathing room.
       Colour appears ONLY for meaning (success / featured / brand CTA).
       ==================================================================== */
    body[data-dashboard] { background: var(--ws-bg); }
    .ws {
      --ws-bg: #ffffff;
      --ws-card: #f6f5f3;
      --ws-line: rgba(28, 29, 34, 0.09);
      --ws-ink: #1c1d22;
      --ws-soft: rgba(28, 29, 34, 0.60);
      --ws-faint: rgba(28, 29, 34, 0.40);
      --ws-accent: var(--english-violet, #5b4a55);
      --ws-success: #3f9468;
      --ws-radius: 20px;
      --ws-shadow: 0 1px 2px rgba(28, 29, 34, 0.03), 0 14px 30px -22px rgba(28, 29, 34, 0.18);
      --ws-shadow-lift: 0 2px 4px rgba(28, 29, 34, 0.04), 0 26px 50px -26px rgba(28, 29, 34, 0.26);
      --ws-ease: cubic-bezier(.2, .8, .2, 1);
      min-height: 100vh;
      background: var(--ws-bg);
      color: var(--ws-ink);
      font-family: var(--sans);
    }

    /* ---------- Top navigation — bled-in (no bar / no line). Floating pill tabs
       + circular icon "cutouts". Person on the left, icons on the right. ---------- */
    .ws-nav {
      position: sticky;
      top: 0;
      z-index: 40;
      display: flex;
      align-items: center;
      gap: clamp(12px, 2vw, 28px);
      padding: 14px clamp(20px, 4vw, 56px);
      background: var(--ws-bg);   /* same as the page — no border, no frosted bar */
    }

    /* LEFT — the person */
    .ws-who { flex: 0 0 auto; }
    .ws-whobtn {
      display: inline-flex; align-items: center; gap: 11px;
      padding: 6px 14px 6px 6px; border: 0; border-radius: 999px;
      background: transparent; cursor: pointer; font-family: inherit;
      transition: background 0.2s;
    }
    .ws-whobtn:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-whoav {
      width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto;
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--serif); font-size: 17px; font-weight: 600; color: #fff;
      background: linear-gradient(140deg, color-mix(in srgb, var(--ws-accent) 70%, #fff), var(--ws-accent));
    }
    .ws-whotext { display: flex; flex-direction: column; line-height: 1.25; text-align: left; }
    .ws-whotext strong { font-size: 14px; font-weight: 600; color: var(--ws-ink); }
    .ws-whotext span { font-size: 11.5px; color: var(--ws-faint); }
    @media (max-width: 760px) { .ws-whotext { display: none; } }

    /* CENTRE — floating pill tabs */
    .ws-tabs { flex: 1; display: flex; align-items: center; justify-content: center; gap: 5px; flex-wrap: wrap; }
    .ws-tab {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 9px 16px; border-radius: 999px;
      font-size: 13.5px; font-weight: 500; color: var(--ws-soft);
      text-decoration: none; border: 0; background: transparent; cursor: pointer; font-family: inherit;
      transition: color 0.2s, background 0.2s, transform 0.2s var(--ws-ease);
    }
    .ws-tab:hover { color: var(--ws-ink); background: rgba(28, 29, 34, 0.06); transform: translateY(-1px); }
    .ws-tab.is-active,
    .ws-tab.is-active:hover { color: #fff; background: var(--ws-ink); font-weight: 600; transform: none; }
    .ws-caret { width: 9px; height: 6px; opacity: 0.55; transition: transform 0.25s var(--ws-ease); }

    /* RIGHT — circular icon buttons */
    .ws-nav-right { flex: 0 0 auto; display: flex; align-items: center; gap: 9px; }
    .ws-circ {
      position: relative;
      width: 42px; height: 42px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      background: #fff; border: 1px solid var(--ws-line); cursor: pointer;
      color: var(--ws-soft);
      box-shadow: 0 1px 2px rgba(28, 29, 34, 0.03);
      transition: transform 0.2s var(--ws-ease), box-shadow 0.2s, color 0.2s, border-color 0.2s;
    }
    .ws-circ:hover { transform: translateY(-2px); color: var(--ws-ink); border-color: rgba(28, 29, 34, 0.18); box-shadow: 0 9px 20px -10px rgba(28, 29, 34, 0.3); }
    .ws-circ svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-dot {
      position: absolute; top: 9px; right: 10px;
      width: 8px; height: 8px; border-radius: 50%;
      background: var(--ws-accent); box-shadow: 0 0 0 2px #fff;
    }
    .ws-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

    /* ---------- Dropdown menus ---------- */
    .ws-menu { position: relative; }
    .ws-dropdown {
      position: absolute; top: calc(100% + 10px); left: 0;
      min-width: 210px;
      padding: 8px;
      background: #fff;
      border: 1px solid var(--ws-line);
      border-radius: 14px;
      box-shadow: var(--ws-shadow-lift);
      opacity: 0; transform: translateY(-6px) scale(0.98);
      transform-origin: top left;
      pointer-events: none;
      transition: opacity 0.2s var(--ws-ease), transform 0.2s var(--ws-ease);
      z-index: 50;
    }
    .ws-dropdown--right { left: auto; right: 0; transform-origin: top right; }
    .ws-menu.is-open .ws-dropdown { opacity: 1; transform: translateY(0) scale(1); pointer-events: auto; }
    .ws-menu.is-open .ws-caret { transform: rotate(180deg); }
    .ws-dropdown a {
      display: block; padding: 10px 12px; border-radius: 9px;
      font-size: 13.5px; color: var(--ws-soft); text-decoration: none;
      transition: background 0.16s, color 0.16s;
    }
    .ws-dropdown a:hover { background: rgba(28, 29, 34, 0.05); color: var(--ws-ink); }
    .ws-dropdown-head { padding: 8px 12px 10px; border-bottom: 1px solid var(--ws-line); margin-bottom: 6px; display: flex; flex-direction: column; gap: 2px; }
    .ws-dropdown-head strong { font-size: 14px; color: var(--ws-ink); }
    .ws-dropdown-head span { font-size: 12px; color: var(--ws-faint); }
    .ws-dropdown-out { color: var(--ws-accent) !important; font-weight: 600; }

    /* ---------- Main column ---------- */
    .ws-main {
      max-width: 1180px;
      margin: 0 auto;
      padding: clamp(36px, 6vh, 72px) clamp(20px, 4vw, 56px) 120px;
      display: flex; flex-direction: column;
      gap: clamp(28px, 4vh, 48px);
    }

    /* ---------- Hero brief ---------- */
    .ws-eyebrow {
      font-size: 12px; font-weight: 600; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--ws-faint); margin: 0 0 14px;
    }
    .ws-greeting {
      font-family: var(--serif); font-weight: 500;
      font-size: clamp(36px, 5vw, 60px); line-height: 1.0;
      letter-spacing: -0.02em; margin: 0; color: var(--ws-ink);
    }
    .ws-greeting em { font-style: italic; color: var(--ws-accent); }
    .ws-hero-sub { font-size: clamp(16px, 1.5vw, 19px); color: var(--ws-soft); margin: 14px 0 0; }

    .ws-brief { list-style: none; margin: 26px 0 0; padding: 0; display: flex; flex-direction: column; gap: 13px; max-width: 640px; }
    .ws-brief-item {
      display: flex; align-items: center; gap: 14px;
      font-size: 15.5px; color: var(--ws-soft);
      opacity: 0; transform: translateX(-8px);
      animation: wsBriefIn 0.6s var(--ws-ease) forwards;
      animation-delay: calc(0.35s + var(--d) * 0.09s);
    }
    .ws-brief-item strong { color: var(--ws-ink); font-weight: 600; }
    .ws-brief-ic {
      flex: 0 0 auto; width: 34px; height: 34px; border-radius: 10px;
      display: inline-flex; align-items: center; justify-content: center;
      background: rgba(28, 29, 34, 0.05); color: var(--ws-soft);
    }
    .ws-brief-ic svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-brief-ic--good { background: rgba(63, 148, 104, 0.12); color: var(--ws-success); }
    .ws-brief-ic--due  { background: color-mix(in srgb, var(--ws-accent) 14%, #fff); color: var(--ws-accent); }
    .ws-brief-ic--soon { background: rgba(196, 154, 74, 0.15); color: #b3852f; }
    @keyframes wsBriefIn { to { opacity: 1; transform: none; } }

    .ws-hero-actions { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 30px; }
    .ws-hero-hint { font-size: 13px; color: var(--ws-faint); }

    /* ---------- Buttons ---------- */
    .ws-btn {
      display: inline-flex; align-items: center; gap: 9px;
      padding: 13px 22px; border-radius: 13px;
      font-family: inherit; font-size: 14px; font-weight: 600;
      text-decoration: none; cursor: pointer; border: 1px solid transparent;
      transition: transform 0.22s var(--ws-ease), box-shadow 0.22s, background 0.2s, color 0.2s;
    }
    .ws-btn svg { width: 15px; height: 15px; }
    .ws-btn--sm { padding: 10px 16px; font-size: 13px; border-radius: 11px; }
    .ws-btn--primary {
      background: var(--ws-accent); color: #fff;
      box-shadow: 0 10px 22px -12px color-mix(in srgb, var(--ws-accent) 80%, transparent);
    }
    .ws-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 16px 30px -12px color-mix(in srgb, var(--ws-accent) 75%, transparent); }
    .ws-btn--primary:active { transform: translateY(0); }
    .ws-btn--primary svg { transition: transform 0.25s var(--ws-ease); }
    .ws-btn--primary:hover svg { transform: translateX(3px); }
    .ws-btn--ghost { background: transparent; color: var(--ws-ink); border-color: var(--ws-line); }
    .ws-btn--ghost:hover { background: rgba(28, 29, 34, 0.04); transform: translateY(-2px); }

    /* ---------- Cards (shared) ---------- */
    .ws-card,
    .ws-feature {
      background: var(--ws-card);
      border: 1px solid var(--ws-line);
      border-radius: var(--ws-radius);
      box-shadow: var(--ws-shadow);
      transition: transform 0.3s var(--ws-ease), box-shadow 0.3s var(--ws-ease);
    }
    .ws-card { padding: 24px 26px; display: flex; flex-direction: column; gap: 16px; }
    .ws-card:hover { transform: translateY(-3px); box-shadow: var(--ws-shadow-lift); }
    .ws-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
    .ws-card-eyebrow {
      font-size: 11px; font-weight: 700; letter-spacing: 0.18em;
      text-transform: uppercase; color: var(--ws-accent); margin: 0 0 6px;
    }
    .ws-card-title { font-family: var(--serif); font-weight: 500; font-size: 21px; letter-spacing: -0.01em; margin: 0; color: var(--ws-ink); }
    .ws-card-tag {
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--ws-faint); padding: 5px 10px; border: 1px solid var(--ws-line); border-radius: 999px;
    }
    .ws-card-foot { display: flex; align-items: center; gap: 18px; margin-top: auto; }

    /* ---------- Feature card (continue editing) ---------- */
    .ws-feature {
      display: grid; grid-template-columns: 300px 1fr; align-items: stretch;
      overflow: hidden; padding: 0;
    }
    .ws-feature:hover { transform: translateY(-3px); box-shadow: var(--ws-shadow-lift); }
    .ws-feature-art { position: relative; overflow: hidden; background: #e9e6e2; }
    .ws-feature-art img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s var(--ws-ease); }
    .ws-feature:hover .ws-feature-art img { transform: scale(1.04); }
    .ws-feature-chip {
      position: absolute; top: 16px; left: 16px;
      padding: 6px 12px; border-radius: 999px;
      background: rgba(255, 255, 255, 0.92); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
      font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-accent);
    }
    .ws-feature-body { padding: 30px 34px; display: flex; flex-direction: column; gap: 8px; }
    .ws-feature-title { font-family: var(--serif); font-weight: 500; font-size: clamp(24px, 2.4vw, 32px); letter-spacing: -0.015em; margin: 2px 0 0; }
    .ws-feature-meta { font-size: 13px; color: var(--ws-faint); margin: 0; }
    .ws-progress { display: flex; align-items: center; gap: 14px; margin: 18px 0 22px; }
    .ws-progress-track { flex: 1; height: 7px; border-radius: 999px; background: rgba(28, 29, 34, 0.08); overflow: hidden; }
    .ws-progress-fill { display: block; height: 100%; width: 0; border-radius: 999px; background: var(--ws-accent); transition: width 1.1s var(--ws-ease); }
    .ws-progress-label { font-size: 13px; color: var(--ws-soft); white-space: nowrap; }
    .ws-progress-label b { color: var(--ws-ink); }
    .ws-feature-actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: auto; }

    /* ---------- Grid ---------- */
    .ws-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(16px, 1.6vw, 22px); }
    .ws-span-2 { grid-column: span 2; }
    @media (max-width: 920px) {
      .ws-grid { grid-template-columns: 1fr 1fr; }
      .ws-span-2 { grid-column: span 2; }
      .ws-feature { grid-template-columns: 240px 1fr; }
    }
    @media (max-width: 680px) {
      .ws-grid, .ws-span-2 { grid-template-columns: 1fr; grid-column: auto; }
      .ws-feature { grid-template-columns: 1fr; }
      .ws-feature-art { min-height: 220px; }
    }

    /* ---------- Today's idea ---------- */
    .ws-idea { font-family: var(--serif); font-style: italic; font-size: clamp(19px, 1.9vw, 24px); line-height: 1.4; color: var(--ws-ink); margin: 4px 0 2px; }

    /* ---------- Text links ---------- */
    .ws-textlink {
      font-size: 13px; font-weight: 600; color: var(--ws-soft);
      background: none; border: 0; padding: 0; cursor: pointer; font-family: inherit;
      text-decoration: none; transition: color 0.2s;
    }
    .ws-textlink:hover { color: var(--ws-ink); }
    .ws-textlink--accent { color: var(--ws-accent); }
    .ws-textlink--accent:hover { color: color-mix(in srgb, var(--ws-accent) 70%, #000); }

    /* ---------- Brand-health journey + ring ---------- */
    .ws-ring { position: relative; width: 52px; height: 52px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; }
    .ws-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
    .ws-ring-bg { fill: none; stroke: rgba(28, 29, 34, 0.1); stroke-width: 3; }
    .ws-ring-fg { fill: none; stroke: var(--ws-success); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 97.4; stroke-dashoffset: 97.4; transition: stroke-dashoffset 1.2s var(--ws-ease); }
    .ws-ring b { font-family: var(--serif); font-size: 15px; color: var(--ws-ink); }
    .ws-ring i { font-size: 9px; color: var(--ws-faint); font-style: normal; }
    .ws-journey { list-style: none; margin: 4px 0 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
    .ws-journey li { display: flex; align-items: center; gap: 11px; font-size: 14px; color: var(--ws-faint); }
    .ws-journey li.is-done { color: var(--ws-ink); }
    .ws-check { flex: 0 0 auto; width: 18px; height: 18px; border-radius: 50%; border: 1.5px solid var(--ws-line); position: relative; transition: background 0.2s, border-color 0.2s; }
    .ws-journey li.is-done .ws-check { background: var(--ws-success); border-color: var(--ws-success); }
    .ws-journey li.is-done .ws-check::after { content: ""; position: absolute; left: 5.5px; top: 2.5px; width: 4px; height: 8px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }

    /* ---------- Content planner ---------- */
    .ws-week { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
    @media (max-width: 560px) { .ws-week { grid-template-columns: 1fr 1fr; } }
    .ws-day {
      display: flex; flex-direction: column; gap: 10px;
      padding: 14px 14px 16px; min-height: 96px;
      background: #fff; border: 1px solid var(--ws-line); border-radius: 13px;
      transition: border-color 0.2s, transform 0.2s var(--ws-ease);
    }
    .ws-day:hover { transform: translateY(-2px); border-color: rgba(28, 29, 34, 0.16); }
    .ws-day.is-today { border-color: color-mix(in srgb, var(--ws-accent) 45%, var(--ws-line)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ws-accent) 30%, transparent); }
    .ws-day-name { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ws-faint); display: flex; align-items: center; gap: 6px; }
    .ws-day-name i { font-style: normal; font-size: 9px; color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 12%, #fff); padding: 2px 6px; border-radius: 999px; letter-spacing: 0.06em; }
    .ws-pill { font-size: 12px; font-weight: 600; padding: 8px 11px; border-radius: 9px; line-height: 1.25; }
    .ws-pill--listed { background: rgba(63, 148, 104, 0.12); color: #2f7c54; }
    .ws-pill--update { background: color-mix(in srgb, var(--ws-accent) 13%, #fff); color: var(--ws-accent); }
    .ws-pill--brand  { background: rgba(196, 154, 74, 0.16); color: #9a6f24; }
    .ws-day-add { margin-top: auto; align-self: flex-start; font-size: 12px; font-weight: 600; color: var(--ws-faint); background: none; border: 0; padding: 4px 0; cursor: pointer; font-family: inherit; transition: color 0.2s; }
    .ws-day-add:hover { color: var(--ws-accent); }

    /* ---------- Instagram snapshot ---------- */
    .ws-metrics { display: flex; gap: 22px; margin: 2px 0; }
    .ws-metric { display: flex; flex-direction: column; gap: 4px; }
    .ws-metric-val { font-family: var(--serif); font-size: clamp(26px, 2.6vw, 34px); line-height: 1; letter-spacing: -0.02em; color: var(--ws-ink); }
    .ws-metric-label { font-size: 11.5px; color: var(--ws-faint); display: flex; align-items: center; gap: 6px; }
    .ws-trend { font-style: normal; font-size: 10.5px; font-weight: 700; }
    .ws-trend--up { color: var(--ws-success); }
    .ws-tip-q {
      flex: 0 0 auto; width: 22px; height: 22px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 12px; font-weight: 700; color: var(--ws-faint);
      border: 1px solid var(--ws-line); cursor: help;
    }

    /* ---------- Recent designs reel (portrait, true aspect) ---------- */
    .ws-reel { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
    @media (max-width: 720px) { .ws-reel { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 460px) { .ws-reel { grid-template-columns: repeat(2, 1fr); } }
    .ws-thumb {
      position: relative; aspect-ratio: 4 / 5; border-radius: 12px; overflow: hidden;
      background-size: cover; background-position: center; background-color: #e9e6e2;
      text-decoration: none; display: block;
      box-shadow: 0 8px 18px -12px rgba(28, 29, 34, 0.4);
      transition: transform 0.28s var(--ws-ease), box-shadow 0.28s;
    }
    .ws-thumb:hover { transform: translateY(-4px); box-shadow: 0 16px 28px -14px rgba(28, 29, 34, 0.5); }
    .ws-thumb-tag {
      position: absolute; bottom: 8px; left: 8px;
      padding: 3px 8px; border-radius: 999px;
      background: rgba(255, 255, 255, 0.92);
      font-size: 10px; font-weight: 700; letter-spacing: 0.04em; color: var(--ws-accent);
    }
    .ws-thumb-tag--done { color: #2f7c54; }
    .ws-thumb--new {
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px;
      background: #fff; border: 1.5px dashed var(--ws-line); box-shadow: none;
      font-size: 12px; font-weight: 600; color: var(--ws-faint);
    }
    .ws-thumb--new:hover { border-color: var(--ws-accent); color: var(--ws-accent); transform: translateY(-4px); box-shadow: none; }
    .ws-thumb-plus { font-size: 26px; line-height: 1; font-weight: 300; }

    /* ---------- What's new feature card ---------- */
    .ws-card--feature { padding: 0; overflow: hidden; }
    .ws-new-art { position: relative; min-height: 150px; background-size: cover; background-position: center; }
    .ws-new-flag {
      position: absolute; top: 14px; left: 14px; padding: 5px 11px; border-radius: 999px;
      background: rgba(28, 29, 34, 0.82); color: #fff;
      font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
    }
    .ws-new-body { padding: 20px 24px 24px; display: flex; flex-direction: column; gap: 7px; }
    .ws-new-desc { font-size: 14px; line-height: 1.55; color: var(--ws-soft); margin: 0 0 4px; }

    /* ---------- Tooltips ---------- */
    [data-tip] { position: relative; }
    [data-tip]::after {
      content: attr(data-tip);
      position: absolute; bottom: calc(100% + 9px); left: 50%; transform: translateX(-50%) translateY(4px);
      width: max-content; max-width: 230px;
      padding: 9px 12px; border-radius: 10px;
      background: #1c1d22; color: #fff;
      font-size: 12px; font-weight: 500; line-height: 1.4; letter-spacing: 0; text-transform: none;
      text-align: center; white-space: normal;
      opacity: 0; pointer-events: none; z-index: 60;
      box-shadow: 0 12px 28px -10px rgba(0, 0, 0, 0.4);
      transition: opacity 0.22s var(--ws-ease), transform 0.22s var(--ws-ease);
    }
    [data-tip]:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* ---------- Entrance ---------- */
    .ws-rise { opacity: 0; transform: translateY(22px); }
    body.ws-ready .ws-rise { animation: wsRise 0.75s var(--ws-ease) both; animation-delay: calc(var(--i) * 0.08s); }
    @keyframes wsRise { to { opacity: 1; transform: none; } }

    @media (prefers-reduced-motion: reduce) {
      .ws-rise, .ws-brief-item { opacity: 1 !important; transform: none !important; animation: none !important; }
      .ws-progress-fill, .ws-ring-fg { transition: none !important; }
    }
  </style>

  <script>
    // Entrance
    requestAnimationFrame(() => document.body.classList.add('ws-ready'));

    // Dropdown menus — click to toggle, click-away / Esc to close.
    const menus = [...document.querySelectorAll('[data-menu]')];
    function closeAll(except) {
      menus.forEach((m) => { if (m !== except) { m.classList.remove('is-open'); m.querySelector('[data-menu-btn]')?.setAttribute('aria-expanded', 'false'); } });
    }
    menus.forEach((m) => {
      const btn = m.querySelector('[data-menu-btn]');
      btn?.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = m.classList.toggle('is-open');
        btn.setAttribute('aria-expanded', String(open));
        closeAll(m);
      });
    });
    document.addEventListener('click', () => closeAll(null));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(null); });

    // Count-up numbers + progress/ring fills, kicked off when in view.
    function animateCount(el) {
      const target = parseFloat(el.getAttribute('data-count')) || 0;
      const dur = 1100, start = performance.now();
      const fmt = (n) => Math.round(n).toLocaleString('en-GB');
      function tick(now) {
        const p = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = fmt(target * eased);
        if (p < 1) requestAnimationFrame(tick);
        else el.textContent = fmt(target);
      }
      requestAnimationFrame(tick);
    }
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        obs.unobserve(e.target);
        const t = e.target;
        if (reduce) {
          t.querySelectorAll('[data-count]').forEach((n) => { n.textContent = (parseFloat(n.getAttribute('data-count')) || 0).toLocaleString('en-GB'); });
        } else {
          t.querySelectorAll('[data-count]').forEach(animateCount);
        }
        t.querySelectorAll('[data-val]').forEach((b) => { b.style.width = (b.getAttribute('data-val') || 0) + '%'; });
        t.querySelectorAll('[data-ring]').forEach((r) => {
          const pct = parseFloat(r.getAttribute('data-ring')) || 0;
          const len = 2 * Math.PI * 15.5;
          r.style.strokeDashoffset = String(len * (1 - pct / 100));
        });
      });
    }, { threshold: 0.3 });
    document.querySelectorAll('.ws-feature, .ws-card, .ws-metrics').forEach((el) => io.observe(el));
  </script>
</BaseLayout>
