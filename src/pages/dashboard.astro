---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<!--
  TMKE workspace — Phase 2. Editorial, asymmetric composition (mock data).
  Standalone preview at /dashboard; the live /account is untouched.

  Hierarchy: ONE immersive hero (brief + dominant design preview) leads the eye,
  then a left "workflow" column (plan -> recent work) beside a lighter right
  "insights" column (idea, brand health, performance), finishing on a full-width
  discovery card. Sections are grouped by whitespace + depth, not borders.
-->
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Your TMKE — workspace"
  description="Your marketing brief, your designs in progress, and what's new — beautifully organised."
>
  <div class="ws">
    <!-- ============ Top navigation ============ -->
    <header class="ws-nav" aria-label="Primary">
      <div class="ws-brand">
        <a class="ws-logo" href="/dashboard">TMKE</a>
        <div class="ws-menu ws-who" data-menu>
          <button type="button" class="ws-whobtn" data-menu-btn aria-expanded="false" aria-haspopup="true">
            <span class="ws-whoav">DC</span>
            <span class="ws-whotext"><strong>Danielle Carter</strong><span>Marina Estates</span></span>
            <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ws-dropdown" role="menu">
            <div class="ws-dropdown-head"><strong>Danielle Carter</strong><span>danielle@marinaestates.co.uk</span></div>
            <a role="menuitem" href="/profile">Your profile</a>
            <a role="menuitem" href="/profile">Brand Kit</a>
            <a role="menuitem" href="/account/orders">Billing</a>
            <a role="menuitem" href="/login" class="ws-dropdown-out">Sign out</a>
          </div>
        </div>
      </div>

      <nav class="ws-tabs" aria-label="Sections">
        <a class="ws-tab is-active" href="/dashboard" aria-current="page">Dashboard</a>
        <a class="ws-tab" href="/studio">Studio</a>
        <a class="ws-tab" href="/edit">Library</a>
        <a class="ws-tab" href="/account/schedule">Planner</a>
        <a class="ws-tab" href="/account/guides">Learn</a>
        <a class="ws-tab" href="/account">Analytics</a>
        <div class="ws-menu" data-menu>
          <button type="button" class="ws-tab ws-tab--menu" data-menu-btn aria-expanded="false" aria-haspopup="true">Manage <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <div class="ws-dropdown" role="menu">
            <a role="menuitem" href="/profile">Brand Kit</a>
            <a role="menuitem" href="/account/services">Managed Socials</a>
            <a role="menuitem" href="/account/bookings">Bookings</a>
            <a role="menuitem" href="/account/orders">Orders</a>
            <a role="menuitem" href="/account/orders">Billing</a>
            <a role="menuitem" href="/profile">Settings</a>
          </div>
        </div>
        <div class="ws-menu" data-menu>
          <button type="button" class="ws-tab ws-tab--menu" data-menu-btn aria-expanded="false" aria-haspopup="true">Resources <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          <div class="ws-dropdown" role="menu">
            <a role="menuitem" href="/account/guides">Guides</a>
            <a role="menuitem" href="/account/blog">Blog</a>
            <a role="menuitem" href="/contact">Contact</a>
            <a role="menuitem" href="/contact">Help Centre</a>
          </div>
        </div>
      </nav>

      <div class="ws-nav-right">
        <button type="button" class="ws-circ" data-tip="Search anything"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg><span class="ws-sr">Search</span></button>
        <button type="button" class="ws-circ" data-tip="3 new updates"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg><span class="ws-dot"></span><span class="ws-sr">Notifications</span></button>
        <button type="button" class="ws-circ" data-tip="Help &amp; guides"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.6 9a2.4 2.4 0 1 1 3.4 2.2c-.8.4-1 .8-1 1.6"/><line x1="12" y1="16.5" x2="12" y2="16.5"/></svg><span class="ws-sr">Help</span></button>
      </div>
    </header>

    <main class="ws-main">
      <!-- ============ Left: the workflow ============ -->
      <div class="ws-left">
        <!-- HERO — brief + dominant design preview -->
        <section class="ws-hero ws-rise" style="--i:0">
          <div class="ws-hero-brief">
            <p class="ws-eyebrow">Your marketing brief</p>
            <h1 class="ws-greeting">Good morning,<br><em>Danielle.</em></h1>
            <ul class="ws-brief">
              <li style="--d:1"><span class="ws-brief-ic ws-brief-ic--due"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg></span><span>Your <strong>Market Update</strong> is due today.</span></li>
              <li style="--d:2"><span class="ws-brief-ic ws-brief-ic--good"><svg viewBox="0 0 24 24"><polyline points="3 17 9 11 13 15 21 7"/><polyline points="15 7 21 7 21 13"/></svg></span><span>Instagram engagement is <strong>up 12%</strong>.</span></li>
              <li style="--d:3"><span class="ws-brief-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span><span>Best time to post today: <strong>6:30pm</strong>.</span></li>
            </ul>
            <div class="ws-hero-cta">
              <a class="ws-btn ws-btn--primary" href="/studio">Continue Designing
                <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </div>

          <a class="ws-hero-preview" href="/studio" aria-label="Continue Just Listed — Marina Heights">
            <img src="/assets/cosy%20home.jpg" alt="Just Listed — Marina Heights design in progress" loading="eager" />
            <span class="ws-hero-chip">In progress</span>
            <div class="ws-hero-preview-foot">
              <h3>Just Listed —<br>Marina Heights</h3>
              <div class="ws-hero-progress">
                <span class="ws-hero-pct"><b data-count="80">0</b>% complete</span>
                <span class="ws-hero-track"><span class="ws-hero-fill" data-val="80"></span></span>
              </div>
            </div>
          </a>
        </section>

        <!-- PLAN -->
        <section class="ws-block ws-rise" style="--i:2" aria-labelledby="plan-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="plan-h">This week's plan</h2>
            <a class="ws-textlink" href="/account/schedule">Open planner →</a>
          </header>
          <div class="ws-week">
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Mon</span><span class="ws-day-type">Just Listed</span><span class="ws-day-thumb" style="background-image:url('/assets/home%20kitchen.jpg')"></span></a>
            <button class="ws-day ws-day--empty" type="button"><span class="ws-day-name">Tue</span><span class="ws-day-add">+ Add content</span></button>
            <a class="ws-day is-today" href="/account/schedule"><span class="ws-day-name">Wed <i>Today</i></span><span class="ws-day-type">Market Update</span><span class="ws-day-thumb" style="background-image:url('/assets/sitting%20chair.jpg')"></span></a>
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Thu</span><span class="ws-day-type">Personal Branding</span><span class="ws-day-thumb" style="background-image:url('/assets/home%20chair.jpg')"></span></a>
            <button class="ws-day ws-day--empty" type="button"><span class="ws-day-name">Fri</span><span class="ws-day-add">+ Add content</span></button>
          </div>
        </section>

        <!-- RECENT DESIGNS -->
        <section class="ws-block ws-rise" style="--i:3" aria-labelledby="recent-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="recent-h">Your recent designs</h2>
            <a class="ws-textlink" href="/account">View all →</a>
          </header>
          <div class="ws-reel">
            <a class="ws-thumb" href="/studio" style="background-image:url('/assets/cosy%20home.jpg')"><span class="ws-thumb-tag">80%</span></a>
            <a class="ws-thumb" href="/studio" style="background-image:url('/assets/home%20window.jpg')"><span class="ws-thumb-tag ws-thumb-tag--done">Done</span></a>
            <a class="ws-thumb" href="/studio" style="background-image:url('/assets/sitting%20chair.jpg')"><span class="ws-thumb-tag ws-thumb-tag--done">Done</span></a>
            <a class="ws-thumb" href="/studio" style="background-image:url('/assets/home%20forest.jpg')"><span class="ws-thumb-tag">35%</span></a>
            <a class="ws-thumb ws-thumb--new" href="/studio"><span class="ws-thumb-plus">+</span><span>New design</span></a>
          </div>
        </section>
      </div>

      <!-- ============ Right: the insights ============ -->
      <div class="ws-right">
        <!-- TODAY'S IDEA -->
        <section class="ws-widget ws-rise" style="--i:1" aria-labelledby="idea-h">
          <header class="ws-widget-head">
            <span class="ws-eyebrow">Today's content idea</span>
            <span class="ws-pilltag">Fresh daily</span>
          </header>
          <p class="ws-idea" id="idea-h">“Three questions every buyer asks during a viewing — and how you answer them.”</p>
          <div class="ws-widget-foot">
            <a class="ws-btn ws-btn--primary ws-btn--sm" href="/studio">Create this post
              <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <button type="button" class="ws-textlink" data-tip="A fresh angle, on tap">Another idea ↻</button>
          </div>
        </section>

        <!-- BRAND HEALTH -->
        <section class="ws-widget ws-rise" style="--i:2" aria-labelledby="brand-h">
          <header class="ws-widget-head">
            <span class="ws-eyebrow">Brand health</span>
            <span class="ws-ring" data-tip="Finish your Brand Kit so every design is on-brand automatically">
              <svg viewBox="0 0 36 36" aria-hidden="true"><circle class="ws-ring-bg" cx="18" cy="18" r="15.5"/><circle class="ws-ring-fg" cx="18" cy="18" r="15.5" data-ring="66"/></svg>
              <b data-count="66">0</b><i>%</i>
            </span>
          </header>
          <ul class="ws-journey" id="brand-h">
            <li class="is-done"><span class="ws-check"></span>Logo uploaded</li>
            <li class="is-done"><span class="ws-check"></span>Brand colours added</li>
            <li class="is-done"><span class="ws-check"></span>Fonts uploaded</li>
            <li class="is-done"><span class="ws-check"></span>Instagram connected</li>
            <li><span class="ws-check"></span>Facebook connected</li>
            <li><span class="ws-check"></span>Google Business</li>
          </ul>
          <a class="ws-textlink ws-textlink--accent" href="/profile">Complete your setup →</a>
        </section>

        <!-- INSTAGRAM SNAPSHOT -->
        <section class="ws-widget ws-rise" style="--i:3" aria-labelledby="ig-h">
          <header class="ws-widget-head">
            <span class="ws-eyebrow">Instagram snapshot</span>
            <span class="ws-pilltag ws-pilltag--soft">Last 30 days</span>
          </header>
          <div class="ws-metrics" id="ig-h">
            <div class="ws-metric"><span class="ws-metric-val"><b data-count="8420">0</b></span><span class="ws-metric-label">Reach <i class="ws-trend">▲ 12%</i></span></div>
            <div class="ws-metric"><span class="ws-metric-val"><b data-count="14">0</b></span><span class="ws-metric-label">Posts</span></div>
            <div class="ws-metric"><span class="ws-metric-val">+<b data-count="63">0</b></span><span class="ws-metric-label">Followers</span></div>
          </div>
          <a class="ws-best" href="/account">
            <span class="ws-best-thumb" style="background-image:url('/assets/outside.jpg')"></span>
            <span class="ws-best-text"><b>Best performer</b><i>Open house · 1,240 reach</i></span>
            <span class="ws-best-arrow">→</span>
          </a>
        </section>
      </div>

      <!-- ============ Discovery — full width ============ -->
      <a class="ws-discover ws-rise" style="--i:4" href="/edit" aria-label="Preview the Wimbledon seasonal pack">
        <div class="ws-discover-art" style="background-image:url('/assets/outside.jpg')"></div>
        <div class="ws-discover-body">
          <span class="ws-discover-flag">Unlocks tomorrow</span>
          <h2 class="ws-discover-h">Wimbledon seasonal pack</h2>
          <p class="ws-discover-desc">12 timely templates to ride the tournament buzz in your local feed.</p>
          <span class="ws-discover-cta">Preview the pack <em>→</em></span>
        </div>
      </a>
    </main>
  </div>

  <style is:global>
    /* =====================================================================
       Workspace Phase 2 — editorial, asymmetric, layered. White cards float
       on a softly textured off-white page; supporting widgets recede. Borders
       give way to whitespace + depth. Colour only for meaning.
       ===================================================================== */
    body[data-dashboard] { background: var(--ws-bg); }
    .ws {
      --ws-bg: #f5f4f1;
      --ws-card: #ffffff;
      --ws-soft: #fbfaf8;          /* supporting widgets — recede a touch */
      --ws-ink: #1c1d22;
      --ws-tx: rgba(28, 29, 34, 0.60);
      --ws-faint: rgba(28, 29, 34, 0.40);
      --ws-line: rgba(28, 29, 34, 0.07);
      --ws-accent: var(--english-violet, #5b4a55);
      --ws-success: #3f9468;
      --ws-r-lg: 26px; --ws-r: 20px; --ws-r-sm: 14px;
      --ws-sh-hero: 0 2px 4px rgba(28,29,34,0.03), 0 34px 64px -34px rgba(28,29,34,0.30), 0 14px 30px -22px rgba(28,29,34,0.20);
      --ws-sh: 0 1px 2px rgba(28,29,34,0.02), 0 18px 40px -30px rgba(28,29,34,0.16);
      --ws-ease: cubic-bezier(.2, .8, .2, 1);
      min-height: 100vh;
      color: var(--ws-ink);
      font-family: var(--sans);
      background:
        radial-gradient(120% 80% at 100% -5%, rgba(91, 74, 85, 0.055), transparent 55%),
        radial-gradient(100% 70% at -5% 105%, rgba(91, 74, 85, 0.045), transparent 52%),
        var(--ws-bg);
    }

    /* ---------- Navigation — utility, almost invisible ---------- */
    .ws-nav {
      position: sticky; top: 0; z-index: 40;
      display: flex; align-items: center; gap: clamp(12px, 2vw, 28px);
      padding: 14px clamp(20px, 4vw, 52px);
      background: color-mix(in srgb, var(--ws-bg) 78%, transparent);
      -webkit-backdrop-filter: saturate(1.1) blur(14px); backdrop-filter: saturate(1.1) blur(14px);
    }
    .ws-brand { display: flex; align-items: center; gap: 14px; flex: 0 0 auto; }
    .ws-logo { font-family: var(--serif); font-size: 20px; font-weight: 600; letter-spacing: 0.05em; color: var(--ws-ink); text-decoration: none; }
    .ws-whobtn { display: inline-flex; align-items: center; gap: 10px; padding: 5px 12px 5px 5px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; font-family: inherit; transition: background 0.2s; }
    .ws-whobtn:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-whoav { width: 34px; height: 34px; border-radius: 50%; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: #fff; background: linear-gradient(140deg, color-mix(in srgb, var(--ws-accent) 70%, #fff), var(--ws-accent)); }
    .ws-whotext { display: flex; flex-direction: column; line-height: 1.2; text-align: left; }
    .ws-whotext strong { font-size: 13px; font-weight: 600; color: var(--ws-ink); }
    .ws-whotext span { font-size: 11px; color: var(--ws-faint); }
    @media (max-width: 980px) { .ws-whotext { display: none; } }

    .ws-tabs { flex: 1; display: flex; align-items: center; justify-content: center; gap: 3px; flex-wrap: wrap; }
    .ws-tab { display: inline-flex; align-items: center; gap: 6px; padding: 8px 15px; border-radius: 999px; font-size: 13.5px; font-weight: 500; color: var(--ws-tx); text-decoration: none; border: 0; background: transparent; cursor: pointer; font-family: inherit; transition: color 0.2s, background 0.2s, box-shadow 0.2s, transform 0.2s var(--ws-ease); }
    .ws-tab:hover { color: var(--ws-ink); background: rgba(28, 29, 34, 0.05); }
    .ws-tab.is-active { color: var(--ws-ink); font-weight: 600; background: var(--ws-card); box-shadow: 0 1px 2px rgba(28,29,34,0.04), 0 6px 16px -10px rgba(28,29,34,0.2); }
    .ws-caret { width: 9px; height: 6px; opacity: 0.55; transition: transform 0.25s var(--ws-ease); }

    .ws-nav-right { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; }
    .ws-circ { position: relative; width: 40px; height: 40px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--ws-card) 70%, transparent); border: 1px solid var(--ws-line); cursor: pointer; color: var(--ws-tx); transition: transform 0.2s var(--ws-ease), box-shadow 0.2s, color 0.2s, background 0.2s; }
    .ws-circ:hover { transform: translateY(-2px); color: var(--ws-ink); background: var(--ws-card); box-shadow: 0 9px 20px -10px rgba(28,29,34,0.3); }
    .ws-circ svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-dot { position: absolute; top: 9px; right: 10px; width: 7px; height: 7px; border-radius: 50%; background: var(--ws-accent); box-shadow: 0 0 0 2px var(--ws-bg); }
    .ws-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

    /* ---------- Dropdowns ---------- */
    .ws-menu { position: relative; }
    .ws-dropdown { position: absolute; top: calc(100% + 10px); left: 0; min-width: 210px; padding: 8px; background: #fff; border: 1px solid var(--ws-line); border-radius: 14px; box-shadow: 0 24px 50px -22px rgba(28,29,34,0.28); opacity: 0; transform: translateY(-6px) scale(0.98); transform-origin: top left; pointer-events: none; transition: opacity 0.2s var(--ws-ease), transform 0.2s var(--ws-ease); z-index: 50; }
    .ws-menu.is-open .ws-dropdown { opacity: 1; transform: none; pointer-events: auto; }
    .ws-menu.is-open .ws-caret { transform: rotate(180deg); }
    .ws-dropdown a { display: block; padding: 10px 12px; border-radius: 9px; font-size: 13.5px; color: var(--ws-tx); text-decoration: none; transition: background 0.16s, color 0.16s; }
    .ws-dropdown a:hover { background: rgba(28, 29, 34, 0.05); color: var(--ws-ink); }
    .ws-dropdown-head { padding: 8px 12px 10px; border-bottom: 1px solid var(--ws-line); margin-bottom: 6px; display: flex; flex-direction: column; gap: 2px; }
    .ws-dropdown-head strong { font-size: 14px; color: var(--ws-ink); }
    .ws-dropdown-head span { font-size: 12px; color: var(--ws-faint); }
    .ws-dropdown-out { color: var(--ws-accent) !important; font-weight: 600; }

    /* ---------- Layout: asymmetric two columns + full-width discovery ---------- */
    .ws-main {
      max-width: 1240px; margin: 0 auto;
      padding: clamp(28px, 4vh, 52px) clamp(20px, 4vw, 52px) 120px;
      display: grid; grid-template-columns: minmax(0, 1.62fr) minmax(0, 1fr);
      gap: clamp(20px, 2.2vw, 34px);
      align-items: start;
    }
    .ws-left, .ws-right { display: flex; flex-direction: column; gap: clamp(22px, 3vh, 40px); min-width: 0; }
    .ws-discover { grid-column: 1 / -1; }
    @media (max-width: 940px) { .ws-main { grid-template-columns: 1fr; } }

    /* ---------- Common bits ---------- */
    .ws-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 0; }
    .ws-textlink { font-size: 13px; font-weight: 600; color: var(--ws-tx); background: none; border: 0; padding: 0; cursor: pointer; font-family: inherit; text-decoration: none; transition: color 0.2s; }
    .ws-textlink:hover { color: var(--ws-ink); }
    .ws-textlink--accent { color: var(--ws-accent); }
    .ws-btn { display: inline-flex; align-items: center; gap: 9px; padding: 13px 22px; border-radius: 13px; font-family: inherit; font-size: 14px; font-weight: 600; text-decoration: none; cursor: pointer; border: 1px solid transparent; transition: transform 0.22s var(--ws-ease), box-shadow 0.22s, background 0.2s; }
    .ws-btn svg { width: 15px; height: 15px; }
    .ws-btn--sm { padding: 10px 16px; font-size: 13px; border-radius: 11px; }
    .ws-btn--primary { background: var(--ws-accent); color: #fff; box-shadow: 0 12px 24px -12px color-mix(in srgb, var(--ws-accent) 80%, transparent); }
    .ws-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 18px 32px -12px color-mix(in srgb, var(--ws-accent) 75%, transparent); }
    .ws-btn--primary svg { transition: transform 0.25s var(--ws-ease); }
    .ws-btn--primary:hover svg { transform: translateX(3px); }
    .ws-pilltag { font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 12%, #fff); padding: 5px 10px; border-radius: 999px; }
    .ws-pilltag--soft { color: var(--ws-faint); background: rgba(28,29,34,0.05); }

    /* ---------- HERO — the emotional centre ---------- */
    .ws-hero {
      display: grid; grid-template-columns: 0.92fr 1.08fr; align-items: stretch;
      background: var(--ws-card); border-radius: var(--ws-r-lg);
      box-shadow: var(--ws-sh-hero); overflow: hidden; min-height: 380px;
    }
    .ws-hero-brief { padding: clamp(26px, 3vw, 40px); display: flex; flex-direction: column; }
    .ws-greeting { font-family: var(--serif); font-weight: 500; font-size: clamp(34px, 3.6vw, 52px); line-height: 1.0; letter-spacing: -0.02em; margin: 14px 0 0; color: var(--ws-ink); }
    .ws-greeting em { font-style: italic; color: var(--ws-accent); }
    .ws-brief { list-style: none; margin: 24px 0 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
    .ws-brief li { display: flex; align-items: center; gap: 12px; font-size: 14.5px; color: var(--ws-tx); opacity: 0; transform: translateX(-8px); animation: wsBriefIn 0.6s var(--ws-ease) forwards; animation-delay: calc(0.4s + var(--d) * 0.09s); }
    .ws-brief strong { color: var(--ws-ink); font-weight: 600; }
    .ws-brief-ic { flex: 0 0 auto; width: 30px; height: 30px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; background: rgba(28,29,34,0.05); color: var(--ws-tx); }
    .ws-brief-ic svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-brief-ic--good { background: rgba(63,148,104,0.12); color: var(--ws-success); }
    .ws-brief-ic--due { background: color-mix(in srgb, var(--ws-accent) 13%, #fff); color: var(--ws-accent); }
    @keyframes wsBriefIn { to { opacity: 1; transform: none; } }
    .ws-hero-cta { margin-top: auto; padding-top: 26px; }

    .ws-hero-preview { position: relative; display: block; overflow: hidden; background: #e9e6e2; text-decoration: none; min-height: 300px; }
    .ws-hero-preview img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 1.2s var(--ws-ease); }
    .ws-hero-preview:hover img { transform: scale(1.05); }
    .ws-hero-preview::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,12,18,0) 38%, rgba(15,12,18,0.78) 100%); }
    .ws-hero-chip { position: absolute; top: 18px; left: 18px; z-index: 2; padding: 6px 13px; border-radius: 999px; background: rgba(255,255,255,0.9); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-accent); }
    .ws-hero-preview-foot { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; padding: 26px 28px; color: #fff; }
    .ws-hero-preview-foot h3 { font-family: var(--serif); font-weight: 500; font-size: clamp(22px, 2.2vw, 30px); line-height: 1.05; letter-spacing: -0.01em; margin: 0 0 14px; }
    .ws-hero-progress { display: flex; flex-direction: column; gap: 8px; }
    .ws-hero-pct { font-size: 12px; font-weight: 600; color: rgba(255,255,255,0.92); }
    .ws-hero-track { height: 5px; border-radius: 999px; background: rgba(255,255,255,0.28); overflow: hidden; }
    .ws-hero-fill { display: block; height: 100%; width: 0; border-radius: 999px; background: #fff; transition: width 1.2s var(--ws-ease); }
    @media (max-width: 620px) { .ws-hero { grid-template-columns: 1fr; } .ws-hero-preview { min-height: 300px; } }

    /* ---------- Section blocks (plan, recent) — borderless, grouped by space ---------- */
    .ws-block { display: flex; flex-direction: column; gap: 16px; }
    .ws-block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 0 2px; }
    .ws-block-h { font-family: var(--serif); font-weight: 500; font-size: 20px; letter-spacing: -0.01em; margin: 0; color: var(--ws-ink); }

    /* Planner week */
    .ws-week { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
    @media (max-width: 560px) { .ws-week { grid-template-columns: 1fr 1fr; } }
    .ws-day { display: flex; flex-direction: column; gap: 8px; padding: 14px; border-radius: var(--ws-r-sm); background: var(--ws-card); box-shadow: var(--ws-sh); text-decoration: none; color: var(--ws-ink); cursor: pointer; border: 0; font-family: inherit; text-align: left; transition: transform 0.28s var(--ws-ease), box-shadow 0.28s; }
    .ws-day:hover { transform: translateY(-4px); box-shadow: 0 2px 4px rgba(28,29,34,0.04), 0 26px 44px -26px rgba(28,29,34,0.3); }
    .ws-day-name { font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ws-faint); display: flex; align-items: center; gap: 6px; }
    .ws-day-name i { font-style: normal; font-size: 9px; color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 12%, #fff); padding: 2px 6px; border-radius: 999px; }
    .ws-day-type { font-size: 13px; font-weight: 600; color: var(--ws-ink); line-height: 1.25; }
    .ws-day-thumb { height: 56px; border-radius: 9px; background-size: cover; background-position: center; background-color: #e9e6e2; margin-top: auto; transition: height 0.28s var(--ws-ease); }
    .ws-day:hover .ws-day-thumb { height: 64px; }
    .ws-day--empty { justify-content: space-between; min-height: 120px; background: transparent; box-shadow: inset 0 0 0 1.5px var(--ws-line); }
    .ws-day--empty:hover { box-shadow: inset 0 0 0 1.5px color-mix(in srgb, var(--ws-accent) 40%, var(--ws-line)); transform: translateY(-2px); }
    .ws-day-add { font-size: 12px; font-weight: 600; color: var(--ws-faint); margin-top: auto; transition: color 0.2s; }
    .ws-day--empty:hover .ws-day-add { color: var(--ws-accent); }

    /* Recent designs reel — portrait, fan out on hover */
    .ws-reel { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
    @media (max-width: 720px) { .ws-reel { grid-template-columns: repeat(3, 1fr); } }
    .ws-thumb { position: relative; aspect-ratio: 4 / 5; border-radius: 13px; overflow: hidden; background-size: cover; background-position: center; background-color: #e9e6e2; text-decoration: none; display: block; box-shadow: var(--ws-sh); transform-origin: bottom center; transition: transform 0.32s var(--ws-ease), box-shadow 0.32s; }
    .ws-reel:hover .ws-thumb:nth-child(1) { transform: rotate(-3deg) translateY(-2px); }
    .ws-reel:hover .ws-thumb:nth-child(2) { transform: rotate(-1.5deg) translateY(-2px); }
    .ws-reel:hover .ws-thumb:nth-child(4) { transform: rotate(1.5deg) translateY(-2px); }
    .ws-reel:hover .ws-thumb:nth-child(5) { transform: rotate(3deg) translateY(-2px); }
    .ws-reel .ws-thumb:hover { transform: translateY(-7px) rotate(0deg) scale(1.03); box-shadow: 0 22px 38px -16px rgba(28,29,34,0.45); z-index: 2; }
    .ws-thumb-tag { position: absolute; bottom: 8px; left: 8px; padding: 3px 8px; border-radius: 999px; background: rgba(255,255,255,0.92); font-size: 10px; font-weight: 700; color: var(--ws-accent); }
    .ws-thumb-tag--done { color: var(--ws-success); }
    .ws-thumb--new { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px; background: transparent; box-shadow: inset 0 0 0 1.5px var(--ws-line); font-size: 12px; font-weight: 600; color: var(--ws-faint); }
    .ws-thumb--new:hover { box-shadow: inset 0 0 0 1.5px var(--ws-accent); color: var(--ws-accent); transform: translateY(-7px); }
    .ws-thumb-plus { font-size: 26px; line-height: 1; font-weight: 300; }

    /* ---------- Right column widgets — lighter, recede ---------- */
    .ws-widget { background: var(--ws-soft); border-radius: var(--ws-r); padding: 22px 24px; display: flex; flex-direction: column; gap: 14px; box-shadow: var(--ws-sh); transition: transform 0.3s var(--ws-ease), box-shadow 0.3s; }
    .ws-widget:hover { transform: translateY(-2px); box-shadow: 0 1px 2px rgba(28,29,34,0.03), 0 24px 46px -28px rgba(28,29,34,0.22); }
    .ws-widget-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .ws-idea { font-family: var(--serif); font-style: italic; font-size: clamp(18px, 1.7vw, 21px); line-height: 1.4; color: var(--ws-ink); margin: 0; }
    .ws-widget-foot { display: flex; align-items: center; gap: 16px; margin-top: 2px; }

    /* Brand health */
    .ws-ring { position: relative; width: 50px; height: 50px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; }
    .ws-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
    .ws-ring-bg { fill: none; stroke: rgba(28,29,34,0.1); stroke-width: 3; }
    .ws-ring-fg { fill: none; stroke: var(--ws-success); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 97.4; stroke-dashoffset: 97.4; transition: stroke-dashoffset 1.2s var(--ws-ease); }
    .ws-ring b { font-family: var(--serif); font-size: 14px; color: var(--ws-ink); }
    .ws-ring i { font-size: 8px; color: var(--ws-faint); font-style: normal; }
    .ws-journey { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
    .ws-journey li { display: flex; align-items: center; gap: 11px; font-size: 13.5px; color: var(--ws-faint); }
    .ws-journey li.is-done { color: var(--ws-ink); }
    .ws-check { flex: 0 0 auto; width: 17px; height: 17px; border-radius: 50%; border: 1.5px solid var(--ws-line); position: relative; }
    .ws-journey li.is-done .ws-check { background: var(--ws-success); border-color: var(--ws-success); }
    .ws-journey li.is-done .ws-check::after { content: ""; position: absolute; left: 5px; top: 2.5px; width: 4px; height: 7px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }

    /* Instagram snapshot */
    .ws-metrics { display: flex; gap: 20px; }
    .ws-metric { display: flex; flex-direction: column; gap: 3px; }
    .ws-metric-val { font-family: var(--serif); font-size: clamp(24px, 2.4vw, 30px); line-height: 1; letter-spacing: -0.02em; color: var(--ws-ink); }
    .ws-metric-label { font-size: 11px; color: var(--ws-faint); display: flex; align-items: center; gap: 5px; }
    .ws-trend { font-style: normal; font-size: 10px; font-weight: 700; color: var(--ws-success); }
    .ws-best { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: 13px; background: var(--ws-card); text-decoration: none; color: var(--ws-ink); box-shadow: var(--ws-sh); transition: transform 0.22s var(--ws-ease); }
    .ws-best:hover { transform: translateY(-2px); }
    .ws-best-thumb { width: 44px; height: 44px; border-radius: 10px; background-size: cover; background-position: center; flex: 0 0 auto; }
    .ws-best-text { display: flex; flex-direction: column; gap: 1px; flex: 1; }
    .ws-best-text b { font-size: 13px; font-weight: 600; }
    .ws-best-text i { font-style: normal; font-size: 11.5px; color: var(--ws-faint); }
    .ws-best-arrow { color: var(--ws-faint); font-size: 16px; transition: transform 0.25s var(--ws-ease); }
    .ws-best:hover .ws-best-arrow { transform: translateX(3px); color: var(--ws-accent); }

    /* ---------- Discovery — full-width finish ---------- */
    .ws-discover { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; min-height: 230px; border-radius: var(--ws-r-lg); overflow: hidden; background: #2a2530; box-shadow: var(--ws-sh-hero); text-decoration: none; }
    .ws-discover-art { position: relative; background-size: cover; background-position: center; transition: transform 1.2s var(--ws-ease); }
    .ws-discover:hover .ws-discover-art { transform: scale(1.05); }
    .ws-discover-body { position: relative; padding: clamp(28px, 3vw, 44px); display: flex; flex-direction: column; justify-content: center; gap: 10px; color: #fff; background: linear-gradient(110deg, #2a2530 60%, rgba(42,37,48,0.85)); }
    .ws-discover-flag { align-self: flex-start; font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.7); }
    .ws-discover-h { font-family: var(--serif); font-weight: 500; font-size: clamp(26px, 2.8vw, 38px); letter-spacing: -0.015em; margin: 0; }
    .ws-discover-desc { font-size: 14.5px; line-height: 1.55; color: rgba(255,255,255,0.72); margin: 0; max-width: 40ch; }
    .ws-discover-cta { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: #fff; margin-top: 8px; }
    .ws-discover-cta em { font-style: normal; display: inline-block; transition: transform 0.25s var(--ws-ease); }
    .ws-discover:hover .ws-discover-cta em { transform: translateX(4px); }
    @media (max-width: 620px) { .ws-discover { grid-template-columns: 1fr; } .ws-discover-art { min-height: 180px; } .ws-discover-body { background: #2a2530; } }

    /* ---------- Tooltips ---------- */
    [data-tip] { position: relative; }
    [data-tip]::after { content: attr(data-tip); position: absolute; bottom: calc(100% + 9px); left: 50%; transform: translateX(-50%) translateY(4px); width: max-content; max-width: 220px; padding: 9px 12px; border-radius: 10px; background: #1c1d22; color: #fff; font-size: 12px; font-weight: 500; line-height: 1.4; letter-spacing: 0; text-transform: none; text-align: center; white-space: normal; opacity: 0; pointer-events: none; z-index: 60; box-shadow: 0 12px 28px -10px rgba(0,0,0,0.4); transition: opacity 0.22s var(--ws-ease), transform 0.22s var(--ws-ease); }
    [data-tip]:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* ---------- Entrance ---------- */
    .ws-rise { opacity: 0; transform: translateY(24px); }
    body.ws-ready .ws-rise { animation: wsRise 0.8s var(--ws-ease) both; animation-delay: calc(var(--i) * 0.1s); }
    @keyframes wsRise { to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .ws-rise, .ws-brief li { opacity: 1 !important; transform: none !important; animation: none !important; } .ws-hero-fill, .ws-ring-fg { transition: none !important; } }
  </style>

  <script>
    requestAnimationFrame(() => document.body.classList.add('ws-ready'));

    // Dropdowns
    const menus = [...document.querySelectorAll('[data-menu]')];
    function closeAll(except) { menus.forEach((m) => { if (m !== except) { m.classList.remove('is-open'); m.querySelector('[data-menu-btn]')?.setAttribute('aria-expanded', 'false'); } }); }
    menus.forEach((m) => { const b = m.querySelector('[data-menu-btn]'); b?.addEventListener('click', (e) => { e.stopPropagation(); const open = m.classList.toggle('is-open'); b.setAttribute('aria-expanded', String(open)); closeAll(m); }); });
    document.addEventListener('click', () => closeAll(null));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(null); });

    // Count-up + bars/ring on view
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function animateCount(el) {
      const target = parseFloat(el.getAttribute('data-count')) || 0;
      const dur = 1100, start = performance.now(), fmt = (n) => Math.round(n).toLocaleString('en-GB');
      function tick(now) { const p = Math.min(1, (now - start) / dur); el.textContent = fmt(target * (1 - Math.pow(1 - p, 3))); if (p < 1) requestAnimationFrame(tick); else el.textContent = fmt(target); }
      requestAnimationFrame(tick);
    }
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return; obs.unobserve(e.target); const t = e.target;
        if (reduce) t.querySelectorAll('[data-count]').forEach((n) => { n.textContent = (parseFloat(n.getAttribute('data-count')) || 0).toLocaleString('en-GB'); });
        else t.querySelectorAll('[data-count]').forEach(animateCount);
        t.querySelectorAll('[data-val]').forEach((b) => { b.style.width = (b.getAttribute('data-val') || 0) + '%'; });
        t.querySelectorAll('[data-ring]').forEach((r) => { const pct = parseFloat(r.getAttribute('data-ring')) || 0; r.style.strokeDashoffset = String(2 * Math.PI * 15.5 * (1 - pct / 100)); });
      });
    }, { threshold: 0.25 });
    document.querySelectorAll('.ws-hero, .ws-widget').forEach((el) => io.observe(el));
  </script>
</BaseLayout>
