---
// Standalone booking page for TEG new-starter FREE videography shoots.
// Unlisted (not in nav) — reached only via the personalised link emailed to a
// new starter (carries their ?code=, which pre-fills their details and marks the
// booking as free / bill-to-TPE, skipping payment entirely).
//
// Mirrors the website's booking UX: a personalised one-pager ("Hi Jane") with a
// Book button that opens the SAME slide-in pop-out (shared booking-wizard.css)
// and clicks through step by step — but tailored to the free flow (fixed dates,
// no pricing, create-a-password since they won't have an account, lenient terms).
//
// ⚠️ EXAMPLE / WORK-IN-PROGRESS placeholders (clearly marked below): the two
// bookable dates (NEW_STARTER_DATES), the session length (SLOT_MINUTES), the
// terms copy, and the Confirm step is stubbed to a success screen. Next: wire
// Confirm to the Worker (create the account + videography_booking bill_to=TPE,
// block Jack's Outlook, redeem the code, send the confirmation).
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/booking-wizard.css";
const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
---

<BaseLayout title="Book your videography shoot — TMKE" description="Book your complimentary videography shoot." hideNav hideFooter>
  <div class="ns" data-worker={WORKER}>
    <header class="ns-top">
      <span class="ns-logo">TMKE</span>
      <span class="ns-top-tag">Videography</span>
    </header>

    <main class="ns-hero">
      <p class="ns-eyebrow"><span class="ns-eyebrow-line"></span> Your welcome gift</p>
      <h1 class="ns-title" id="ns-greeting">Your complimentary <em>videography shoot</em></h1>
      <p class="ns-lead" id="ns-lead">As part of your induction, Jack will film your first piece of content in our Content Studio — completely on us. It takes two minutes to book.</p>
      <div class="ns-codepill" id="ns-codepill" hidden>Your booking code: <code id="ns-code">—</code></div>
      <button type="button" class="ns-cta" id="ns-open">Book your shoot <em>&rarr;</em></button>
      <p class="ns-note">Nothing to pay — it's covered by your agency.</p>
    </main>
  </div>

  <!-- Slide-in booking pop-out (same chrome as the website booking) -->
  <aside class="dc-panel" id="ns-panel" aria-hidden="true">
    <div class="dc-panel-scrim" data-ns-close></div>
    <div class="dc-panel-stage">
      <header class="dc-panel-head">
        <div class="dc-head-left">
          <button type="button" class="dc-panel-close" data-ns-close aria-label="Close">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18"/></svg>
            <span>Close</span>
          </button>
          <button type="button" class="dc-panel-back" id="ns-back" hidden>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
            <span>Back</span>
          </button>
        </div>
        <div class="dc-panel-eyebrow" id="ns-eyebrow">TMKE — Your shoot</div>
      </header>

      <div class="dc-panel-body">
        <!-- 1. Day -->
        <section class="dc-step" id="ns-step-day" hidden>
          <h2 class="dc-step-title">Choose your <em>day.</em></h2>
          <p class="dc-step-sub">Two studio days are available this month. <span class="ns-ph">(placeholder dates — set per month in admin)</span></p>
          <div class="dc-choices" id="ns-days"></div>
        </section>

        <!-- 2. Time -->
        <section class="dc-step" id="ns-step-time" hidden>
          <h2 class="dc-step-title">Pick a <em>time.</em></h2>
          <p class="dc-step-sub">Sessions run 9:00–5:00. <span class="ns-ph">(placeholder length — session length TBC)</span></p>
          <div class="dc-slots-grid" id="ns-slots"></div>
        </section>

        <!-- 3. Details + create a password -->
        <section class="dc-step" id="ns-step-details" hidden>
          <h2 class="dc-step-title">Your <em>details.</em></h2>
          <p class="dc-step-sub">Pre-filled from your booking link — just check they're right, and set a password so you can manage your booking.</p>
          <form class="dc-panel-form" id="ns-details-form">
            <label class="dc-field"><span>Full name *</span><input name="name" autocomplete="name" required /></label>
            <div class="dc-field-row">
              <label class="dc-field"><span>Email *</span><input name="email" type="email" autocomplete="email" required /></label>
              <label class="dc-field"><span>Phone *</span><input name="phone" type="tel" autocomplete="tel" required /></label>
            </div>
            <p class="ns-acct-note">You won't have a TMKE account yet, so we'll create one as part of your booking — just choose a password.</p>
            <div class="dc-field-row">
              <label class="dc-field"><span>Create a password *</span><input name="password" type="password" autocomplete="new-password" minlength="8" required /></label>
              <label class="dc-field"><span>Confirm password *</span><input name="password2" type="password" autocomplete="new-password" minlength="8" required /></label>
            </div>
            <label class="dc-field"><span>Anything Jack should know? (optional)</span><textarea name="notes" rows="2"></textarea></label>
            <p class="dc-gate-error" id="ns-details-error" hidden></p>
            <button type="submit" class="dc-form-cta" id="ns-details-cta">Continue <em>&rarr;</em></button>
          </form>
        </section>

        <!-- 4. Terms -->
        <section class="dc-step" id="ns-step-terms" hidden>
          <h2 class="dc-step-title">A few <em>terms.</em></h2>
          <p class="dc-step-sub">Please have a read — there's nothing to sign.</p>
          <div class="dc-terms" id="ns-terms" tabindex="0">
            <h4>Your complimentary shoot</h4>
            <p>This videography session is provided free of charge as part of your induction with The Experts Group, and is billed directly to your agency — there's nothing for you to pay.</p>
            <h5>Cancelling or rescheduling</h5>
            <p>Life happens. If you need to move or cancel your session, just let us know as early as you can — ideally at least 48 hours before. You can rebook onto another available studio day at no cost.</p>
            <h5>If you can't make it</h5>
            <p>If a session is missed without notice, we may ask your agency to cover the studio time — but it's never charged to you personally, and it won't affect your standing on the programme.</p>
            <p class="dc-terms-note">Placeholder wording — the final terms will be confirmed before this goes live.</p>
          </div>
          <label class="dc-agree-row">
            <input type="checkbox" id="ns-agree" disabled />
            <span>I've read and understood the terms above.</span>
          </label>
          <div class="dc-step-actions"><button type="button" class="dc-next" id="ns-confirm" disabled>Confirm my booking <em>&rarr;</em></button></div>
        </section>

        <!-- success -->
        <section class="dc-step dc-success" id="ns-step-success" hidden>
          <div class="dc-tick" aria-hidden="true">
            <svg viewBox="0 0 52 52"><circle class="dc-tick-circle" cx="26" cy="26" r="24"/><path class="dc-tick-path" fill="none" d="M14 27l8 8 16-18"/></svg>
          </div>
          <h3>You're booked in</h3>
          <p id="ns-success-msg">—</p>
          <p class="ns-success-sub">We've sent a confirmation to your email. Jack will see you then!</p>
          <button type="button" class="dc-form-cta dc-success-done" data-ns-close>Done <em>&rarr;</em></button>
        </section>
      </div>
    </div>
  </aside>

  <style is:global>
    .ns { min-height: 100vh; background: var(--paper); color: var(--ink); font-family: var(--sans); }
    .ns-top { display: flex; align-items: center; justify-content: space-between; padding: 20px clamp(18px, 5vw, 48px); border-bottom: 1px solid rgba(28,29,34,0.08); }
    .ns-logo { font-weight: 800; letter-spacing: 0.22em; color: var(--english-violet); font-size: 18px; }
    .ns-top-tag { font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.45); }

    .ns-hero { max-width: 620px; margin: 0 auto; padding: clamp(48px, 10vw, 100px) clamp(20px, 5vw, 24px); text-align: center; }
    .ns-eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet); margin: 0 0 18px; }
    .ns-eyebrow-line { width: 26px; height: 1px; background: var(--english-violet); display: inline-block; }
    /* Title in INK (brand: wine is a sparing accent, not the body of a heading). */
    .ns-title { font-family: var(--serif); font-weight: 500; font-size: clamp(30px, 6vw, 46px); line-height: 1.08; letter-spacing: -0.015em; color: var(--ink); margin: 0 0 18px; }
    .ns-title em { font-style: italic; color: var(--english-violet); }
    .ns-lead { font-size: 16px; line-height: 1.6; color: rgba(28,29,34,0.72); margin: 0 auto 26px; max-width: 46ch; }
    .ns-codepill { display: inline-block; font-size: 13px; color: rgba(28,29,34,0.7); background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 999px; padding: 7px 15px; margin-bottom: 26px; }
    .ns-codepill code { font-family: ui-monospace, Menlo, monospace; font-weight: 700; color: var(--english-violet); }
    .ns-cta { display: inline-flex; align-items: center; gap: 6px; appearance: none; cursor: pointer; background: var(--ink); color: var(--paper); border: 0; border-radius: 4px; padding: 18px 34px; font-size: 12px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; transition: background 0.25s; }
    .ns-cta:hover { background: var(--english-violet); }
    .ns-cta em { font-family: var(--serif); font-style: italic; font-size: 16px; letter-spacing: 0; text-transform: none; }
    .ns-note { font-size: 13px; color: rgba(28,29,34,0.5); margin: 16px 0 0; }

    .ns-ph { color: rgba(126,103,101,0.8); font-style: italic; font-size: 0.85em; }
    .ns-acct-note, .ns-success-sub { font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: rgba(28,29,34,0.6); margin: 0; }
    #ns-days .dc-choice-title { font-family: var(--serif); font-size: 22px; color: var(--ink); }
  </style>

  <script>
    // ---- Placeholders (to be replaced when the real values land) ----
    const NEW_STARTER_DATES = ["2026-08-13", "2026-08-27"]; // PLACEHOLDER — admin-set per month
    const DAY_START = 9 * 60, DAY_END = 17 * 60, SLOT_MINUTES = 60; // PLACEHOLDER length

    const $ = (id) => document.getElementById(id);
    const state = { date: null, time: null };
    const panel = $("ns-panel");

    // Pre-fill from the personalised link (?code=, ?name=, ?email=, ?phone=).
    const params = new URLSearchParams(location.search);
    const code = params.get("code");
    if (code) { $("ns-codepill").hidden = false; $("ns-code").textContent = code; }
    const f = $("ns-details-form");
    if (params.get("name")) f.name.value = params.get("name");
    if (params.get("email")) f.email.value = params.get("email");
    if (params.get("phone")) f.phone.value = params.get("phone");
    if (f.name.value) { const first = f.name.value.trim().split(/\s+/)[0]; $("ns-greeting").innerHTML = `Hi ${first} — your <em>complimentary shoot.</em>`; }

    const fmtDay = (iso) => { const d = new Date(iso + "T00:00:00"); return { dow: d.toLocaleDateString("en-GB", { weekday: "long" }), short: d.toLocaleDateString("en-GB", { weekday: "short" }), day: d.toLocaleDateString("en-GB", { day: "numeric", month: "long" }), full: d.toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" }) }; };
    const hm = (min) => `${String(Math.floor(min / 60)).padStart(2, "0")}:${String(min % 60).padStart(2, "0")}`;

    // ---- Panel open/close ----
    function openPanel() { panel.setAttribute("aria-hidden", "false"); panel.classList.add("is-open"); document.body.style.overflow = "hidden"; history.length = 0; showStep("day", false); }
    function closePanel() { panel.setAttribute("aria-hidden", "true"); panel.classList.remove("is-open"); document.body.style.overflow = ""; }
    $("ns-open").addEventListener("click", openPanel);
    document.querySelectorAll("[data-ns-close]").forEach((el) => el.addEventListener("click", closePanel));

    // ---- Step navigation (mirrors the website's one-at-a-time transitions) ----
    let activeStep = null; const history = [];
    const stepEl = (n) => $("ns-step-" + n);
    function showStep(name, push) {
      const next = stepEl(name); if (!next) return;
      const cur = activeStep ? stepEl(activeStep) : null;
      if (push && activeStep) history.push(activeStep);
      const enter = () => { next.hidden = false; next.classList.remove("dc-anim-out", "dc-anim-in"); void next.offsetWidth; next.classList.add("dc-anim-in"); activeStep = name; updateBack(); if (name === "terms") checkRead(); };
      if (cur && cur !== next) { cur.classList.remove("dc-anim-in"); cur.classList.add("dc-anim-out"); setTimeout(() => { cur.hidden = true; cur.classList.remove("dc-anim-out"); enter(); }, 230); }
      else enter();
    }
    function updateBack() { $("ns-back").hidden = history.length === 0 || activeStep === "success"; }
    $("ns-back").addEventListener("click", () => { const p = history.pop(); if (p) showStep(p, false); });

    // ---- Step 1: days ----
    $("ns-days").innerHTML = NEW_STARTER_DATES.map((iso) => { const d = fmtDay(iso); return `<button type="button" class="dc-choice" data-date="${iso}"><span class="dc-choice-meta">${d.dow}</span><span class="dc-choice-title">${d.day}</span></button>`; }).join("");
    $("ns-days").addEventListener("click", (e) => {
      const b = e.target.closest(".dc-choice"); if (!b) return;
      state.date = b.getAttribute("data-date"); state.time = null;
      document.querySelectorAll("#ns-days .dc-choice").forEach((x) => x.classList.toggle("is-active", x === b));
      renderSlots();
      showStep("time", true);
    });

    // ---- Step 2: times ----
    function renderSlots() {
      const out = [];
      for (let m = DAY_START; m + SLOT_MINUTES <= DAY_END; m += SLOT_MINUTES) out.push(hm(m));
      $("ns-slots").innerHTML = out.map((t) => `<button type="button" class="dc-slot" data-time="${t}">${t}</button>`).join("");
    }
    $("ns-slots").addEventListener("click", (e) => {
      const b = e.target.closest(".dc-slot"); if (!b) return;
      state.time = b.getAttribute("data-time");
      document.querySelectorAll("#ns-slots .dc-slot").forEach((x) => x.classList.toggle("is-active", x === b));
      showStep("details", true);
    });

    // ---- Step 3: details + password ----
    $("ns-details-form").addEventListener("submit", (e) => {
      e.preventDefault();
      const err = $("ns-details-error"); err.hidden = true;
      const fail = (m) => { err.textContent = m; err.hidden = false; };
      if (!f.name.value.trim() || !f.email.value.trim() || !f.phone.value.trim()) return fail("Please fill in your name, email and phone.");
      if ((f.password.value || "").length < 8) return fail("Please choose a password of at least 8 characters.");
      if (f.password.value !== f.password2.value) return fail("Those passwords don't match.");
      showStep("terms", true);
    });

    // ---- Step 4: terms (agree gate) ----
    const termsBox = $("ns-terms");
    function checkRead() { const box = termsBox; const read = box.scrollHeight - box.scrollTop - box.clientHeight < 24; if (read) { box.classList.add("is-read"); $("ns-agree").disabled = false; } }
    termsBox.addEventListener("scroll", checkRead);
    $("ns-agree").addEventListener("change", (e) => { $("ns-confirm").disabled = !e.target.checked; });

    $("ns-confirm").addEventListener("click", () => {
      if ($("ns-confirm").disabled) return;
      // TODO(stage ②): POST to the Worker — create the account (password) +
      // videography_booking (bill_to = TPE, £295+VAT, no Stripe), block Jack's
      // Outlook, redeem the code, send the confirmation email. Stubbed for now.
      const d = fmtDay(state.date);
      $("ns-success-msg").innerHTML = `<strong>${d.full}, ${state.time}</strong>`;
      showStep("success", true);
    });
  </script>
</BaseLayout>
