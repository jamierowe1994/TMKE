---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiscoveryPanel from "../../components/DiscoveryPanel.astro";
import { STUDIO } from "../../data/videography.js";
---

<BaseLayout
  title={`${STUDIO.name} — TMKE`}
  description={STUDIO.summary}
  noindex
>
  <!-- Access gate: hidden until we confirm the visitor is a partner or has the
       access code. Everything below stays in the DOM but covered by the gate
       overlay until cleared. Real entitlement-based gating arrives with the
       account/partner model; this keeps the page genuinely unlisted now. -->
  <div class="studio-gate" id="studio-gate">
    <div class="studio-gate-card">
      <div class="studio-gate-eyebrow">Private · partners only</div>
      <h1 class="studio-gate-title">The Rugby Studio</h1>
      <p class="studio-gate-sub">This page is shared by invitation. Enter your partner access code to continue.</p>
      <form id="studio-gate-form" class="studio-gate-form">
        <input type="text" id="studio-code" placeholder="Access code" autocomplete="off" />
        <button type="submit" class="btn btn--solid">Enter <span class="btn-arrow">&rarr;</span></button>
      </form>
      <p class="studio-gate-err" id="studio-gate-err" hidden>That code wasn't recognised.</p>
      <p class="studio-gate-help">Don't have a code? <button type="button" data-discovery-call class="studio-gate-link">Get in touch</button>.</p>
    </div>
  </div>

  <div class="studio-content" id="studio-content" hidden>
    <section
      class="studio-hero"
      style={`background-image: linear-gradient(180deg, rgba(12,11,10,0.5), rgba(12,11,10,0.84)), url(${STUDIO.poster})`}
    >
      <div class="studio-hero-inner">
        <div class="studio-hero-eyebrow">Partners only</div>
        <h1 class="studio-hero-title">{STUDIO.name}</h1>
        <p class="studio-hero-tag">{STUDIO.tagline}</p>
      </div>
    </section>

    <section class="studio-body wrap">
      <p class="studio-summary">{STUDIO.summary}</p>
      <h2 class="studio-sub">What's included</h2>
      <ul class="studio-list">
        {STUDIO.deliverables.map((d) => <li>{d}</li>)}
      </ul>
      <button type="button" data-discovery-call class="btn btn--solid studio-book">Book the studio <span class="btn-arrow">&rarr;</span></button>
    </section>
  </div>

  <DiscoveryPanel />

  <style>
    .studio-gate {
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
      padding: 120px 24px; background: var(--paper);
    }
    .studio-gate[hidden] { display: none; }
    .studio-gate-card { max-width: 440px; text-align: center; }
    .studio-gate-eyebrow {
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.28em;
      text-transform: uppercase; font-weight: 700; color: var(--english-violet); margin-bottom: 20px;
    }
    .studio-gate-title { font-family: var(--serif); font-weight: 400; font-size: clamp(40px, 6vw, 64px); letter-spacing: -0.02em; color: var(--ink); margin: 0 0 16px; }
    .studio-gate-sub { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(28,29,34,0.65); margin: 0 0 28px; }
    .studio-gate-form { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }
    #studio-code {
      padding: 12px 16px; border: 1px solid rgba(71,66,84,0.35); border-radius: 2px;
      font-family: var(--sans); font-size: 15px; color: var(--ink); background: var(--paper); min-width: 200px;
    }
    #studio-code:focus { outline: none; border-color: var(--english-violet); }
    .studio-gate-err { font-family: var(--sans); font-size: 13px; color: #a05a3c; margin: 16px 0 0; }
    .studio-gate-help { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); margin: 22px 0 0; }
    .studio-gate-link { background: none; border: none; padding: 0; color: var(--english-violet); font: inherit; text-decoration: underline; cursor: pointer; }

    .studio-content[hidden] { display: none; }
    .studio-hero {
      position: relative; min-height: 64vh; background-size: cover; background-position: center;
      color: var(--paper); display: flex; align-items: flex-end; padding: 160px 36px 64px;
    }
    .studio-hero-inner { position: relative; z-index: 2; max-width: 1280px; margin: 0 auto; width: 100%; }
    .studio-hero-eyebrow { font-family: var(--sans); font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; font-weight: 700; color: rgba(240,238,235,0.85); margin-bottom: 20px; }
    .studio-hero-title { font-family: var(--serif); font-weight: 400; font-size: clamp(44px, 6vw, 92px); line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 16px; color: var(--paper); }
    .studio-hero-tag { font-family: var(--serif); font-style: italic; font-size: clamp(18px, 2vw, 28px); color: rgba(240,238,235,0.85); margin: 0; max-width: 30ch; }

    .studio-body { max-width: 860px; margin: 0 auto; padding: 80px 36px 200px; }
    .studio-summary { font-family: var(--serif); font-weight: 400; font-size: clamp(22px, 2.4vw, 32px); line-height: 1.42; color: var(--ink); margin: 0 0 48px; }
    .studio-sub { font-family: var(--sans); font-weight: 700; font-size: 16px; color: var(--ink); margin: 0 0 18px; }
    .studio-list { list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 12px; }
    .studio-list li { display: grid; grid-template-columns: 24px 1fr; gap: 12px; align-items: baseline; font-family: var(--sans); font-size: 16px; color: rgba(28,29,34,0.8); }
    .studio-list li::before { content: "→"; font-family: var(--serif); font-style: italic; color: var(--english-violet); font-size: 18px; }
    @media (max-width: 720px) { .studio-body { padding: 56px 24px 120px; } }
  </style>

  <script>
    import { resolvePartnerSlug } from "../../data/videography.js";

    // Accepted access codes (placeholder — moves to entitlement checks against
    // the account/partner model in a later phase). Case-insensitive.
    const CODES = ["tmke-studio", "partner", "rugby"];
    const GRANT_KEY = "tmke.studio.access";

    function grant() {
      try { sessionStorage.setItem(GRANT_KEY, "1"); } catch (_) {}
      document.getElementById("studio-gate").hidden = true;
      document.getElementById("studio-content").hidden = false;
    }

    // Auto-grant if the visitor already arrived as a known partner (vanity link)
    // or has been granted this session.
    let allowed = false;
    try { allowed = sessionStorage.getItem(GRANT_KEY) === "1"; } catch (_) {}
    if (!allowed && resolvePartnerSlug() !== "direct") allowed = true;
    if (allowed) grant();

    document.getElementById("studio-gate-form")?.addEventListener("submit", (e) => {
      e.preventDefault();
      const input = document.getElementById("studio-code");
      const err = document.getElementById("studio-gate-err");
      const val = (input?.value || "").trim().toLowerCase();
      if (CODES.includes(val)) { grant(); }
      else if (err) { err.hidden = false; }
    });
  </script>
</BaseLayout>
