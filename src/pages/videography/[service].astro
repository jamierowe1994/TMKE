---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiscoveryPanel from "../../components/DiscoveryPanel.astro";
import VideoShowcase from "../../components/VideoShowcase.astro";
import { SERVICES, priceFor } from "../../data/videography.js";
import { gbpFromPence } from "../../lib/supabase.js";

export function getStaticPaths() {
  return SERVICES.map((s) => ({ params: { service: s.slug }, props: { service: s } }));
}

const { service } = Astro.props;
---

<BaseLayout
  title={`${service.name} — Videography · TMKE`}
  description={service.summary}
>
  <!-- ============ HERO ============ -->
  <section
    class="svc-hero"
    style={`background-image: linear-gradient(180deg, rgba(12,11,10,0.5), rgba(12,11,10,0.82)), url(${service.poster})`}
  >
    <div class="svc-hero-inner">
      <a href="/videography" class="svc-back">&larr; All videography</a>
      <h1 class="svc-hero-title">{service.name}</h1>
      <p class="svc-hero-tag">{service.tagline}</p>
    </div>
  </section>

  <!-- ============ PARTNER BANNER ============ -->
  <div class="vid-partner-banner wrap" id="vid-partner-banner" hidden>
    <span id="vid-partner-text"></span>
  </div>

  <!-- ============ BODY ============ -->
  <section class="svc-body wrap">
    <div class="svc-grid">
      <div class="svc-main">
        <div class="chapter">What it is</div>
        <p class="svc-summary">{service.summary}</p>

        <h2 class="svc-sub">What you get</h2>
        <ul class="svc-deliverables">
          {service.deliverables.map((d) => <li>{d}</li>)}
        </ul>
      </div>

      <aside class="svc-aside">
        <div class="svc-price-card">
          <div class="svc-price-label">From</div>
          <div class="svc-price-amount" data-price-svc={service.slug}>
            {gbpFromPence(priceFor(service, "direct"))}
          </div>
          <div class="svc-price-note" id="svc-price-note">Standard rates</div>
          <button type="button" data-discovery-call class="btn btn--solid svc-book">
            Book this <span class="btn-arrow">&rarr;</span>
          </button>
          <p class="svc-price-fine">Final quote confirmed after a quick call — travel &amp; extras itemised separately.</p>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============ SHOWCASE ============ -->
  <VideoShowcase heading="Recent work" items={service.showcase || []} />

  <DiscoveryPanel />

  <style>
    .svc-hero {
      position: relative; min-height: 64vh;
      background-size: cover; background-position: center;
      color: var(--paper); display: flex; align-items: flex-end;
      padding: 160px 36px 64px; overflow: hidden;
    }
    .svc-hero-inner { position: relative; z-index: 2; max-width: 1280px; margin: 0 auto; width: 100%; }
    .svc-back {
      font-family: var(--sans); font-size: 12px; letter-spacing: 0.22em;
      text-transform: uppercase; font-weight: 700; color: rgba(240,238,235,0.85);
      display: inline-block; margin-bottom: 28px;
    }
    .svc-back:hover { color: var(--paper); }
    .svc-hero-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(44px, 6vw, 92px); line-height: 1.02;
      letter-spacing: -0.02em; margin: 0 0 16px; color: var(--paper);
    }
    .svc-hero-tag {
      font-family: var(--serif); font-style: italic;
      font-size: clamp(18px, 2vw, 28px); color: rgba(240,238,235,0.85); margin: 0; max-width: 28ch;
    }

    .vid-partner-banner { max-width: 1280px; margin: 0 auto; padding: 18px 36px 0; }
    .vid-partner-banner[hidden] { display: none; }
    #vid-partner-text {
      display: inline-flex; align-items: center; gap: 10px;
      padding: 10px 18px; border-radius: 999px;
      background: rgba(71, 66, 84, 0.1); color: var(--english-violet);
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
    }

    .svc-body { max-width: 1280px; margin: 0 auto; padding: 80px 36px 40px; }
    .svc-grid { display: grid; grid-template-columns: 1.6fr 1fr; gap: 64px; align-items: start; }
    @media (max-width: 900px) { .svc-grid { grid-template-columns: 1fr; gap: 40px; } }
    .svc-main .chapter { margin-bottom: 28px; }
    .svc-summary {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(22px, 2.4vw, 32px); line-height: 1.42;
      letter-spacing: -0.008em; color: var(--ink); margin: 0 0 48px; max-width: 30ch;
    }
    .svc-sub { font-family: var(--sans); font-weight: 700; font-size: 16px; color: var(--ink); margin: 0 0 18px; }
    .svc-deliverables { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
    .svc-deliverables li {
      display: grid; grid-template-columns: 24px 1fr; gap: 12px; align-items: baseline;
      font-family: var(--sans); font-size: 16px; color: rgba(28,29,34,0.8);
    }
    .svc-deliverables li::before { content: "→"; font-family: var(--serif); font-style: italic; color: var(--english-violet); font-size: 18px; }

    .svc-price-card {
      border: 1px solid rgba(28,29,34,0.18); border-radius: 4px;
      padding: 32px 30px; position: sticky; top: 110px;
    }
    .svc-price-label { font-family: var(--sans); font-size: 12px; letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.55); }
    .svc-price-amount { font-family: var(--serif); font-weight: 500; font-size: clamp(40px, 5vw, 56px); color: var(--ink); line-height: 1; margin: 8px 0 6px; }
    .svc-price-note { font-family: var(--sans); font-size: 13px; color: var(--english-violet); font-weight: 700; letter-spacing: 0.04em; margin-bottom: 24px; }
    .svc-book { width: 100%; justify-content: center; }
    .svc-price-fine { font-family: var(--sans); font-size: 12px; line-height: 1.55; color: rgba(28,29,34,0.55); margin: 16px 0 0; }

    @media (max-width: 720px) { .svc-body { padding: 56px 24px; } .svc-price-card { position: static; } }
  </style>

  <script>
    import { SERVICES, priceFor, resolvePartnerSlug, getPartner } from "../../data/videography.js";
    import { gbpFromPence } from "../../lib/supabase.js";

    const slug = resolvePartnerSlug();
    const partner = getPartner(slug);

    SERVICES.forEach((s) => {
      const el = document.querySelector(`[data-price-svc="${s.slug}"]`);
      if (el) el.textContent = gbpFromPence(priceFor(s, slug));
    });

    const note = document.getElementById("svc-price-note");
    if (note) note.textContent = partner.note;

    if (slug !== "direct") {
      const banner = document.getElementById("vid-partner-banner");
      const text = document.getElementById("vid-partner-text");
      if (banner && text) {
        text.textContent = `${partner.name} · ${partner.note}`;
        banner.hidden = false;
      }
    }
  </script>
</BaseLayout>
