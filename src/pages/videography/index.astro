  <style>
    .pf {
      position: fixed; inset: 0;
      background: var(--paper);
      color: var(--ink);
      overflow: hidden;
    }

    /* First slide entrance — auto-plays on load (pure CSS, no JS dependency):
       the hero image slowly settles, then the dictionary wording rises in. */
    #pf-deck .pf-panel:first-child .vh-lede-media { animation: pfImgIn 2.4s cubic-bezier(.16,1,.3,1) 0.2s both; }
    #pf-deck .pf-panel:first-child .vh-lede-copy { animation: pfTextIn 1.6s cubic-bezier(.16,1,.3,1) 0.6s both; }
    @keyframes pfImgIn { from { opacity: 0; transform: scale(1.08); } to { opacity: 1; transform: none; } }
    @keyframes pfTextIn { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
      #pf-deck .pf-panel:first-child .vh-lede-media,
      #pf-deck .pf-panel:first-child .vh-lede-copy { animation-duration: 0.01ms; }
    }

    /* ---- Slide 1: copied from /services slide 1 (the About lede pinned to the
       top — copy left, photo right, ink on paper), with one long element below
       that rises up over the header into a full-page on scroll. Here that long
       element is the VIDEO (the .mov), not an image. ---- */
    /* The old rule here also said display/overflow/padding and, being later in
       the file at the same specificity, it won — which is why page one could
       not scroll at all and Why it matters was unreachable. Those three now
       live once, at the top of this stylesheet. */
    .pf-panel.vh { background: var(--paper); color: var(--ink); }
    .vh-header { position: relative; z-index: 1; padding: clamp(84px, 10vh, 106px) var(--page-gutter) clamp(40px, 5vh, 56px); }
    .vh-wrap { max-width: none; }
    .vh-lede-grid { display: grid; grid-template-columns: 1fr auto; gap: clamp(32px, 5vw, 80px); align-items: stretch; }
    .vh-lede-copy { max-width: 540px; display: flex; flex-direction: column; justify-content: space-between; }
    /* Caps, like TMKE and SMM — the other two dictionary heroes (Dani, 7 Oct). */
    .vh-lede-mark { font-family: var(--serif); font-weight: 500; font-size: clamp(40px, 4.6vw, 66px); text-transform: uppercase; line-height: 0.94; letter-spacing: 0.02em; margin: 0; color: var(--ink); }
    .vh-lede-pron { display: flex; align-items: baseline; gap: 12px; margin: 12px 0 0; }
    .vh-lede-phon { font-family: var(--serif); font-size: clamp(14px, 1.1vw, 17px); letter-spacing: 0.06em; color: rgba(28,29,34,0.6); }
    .vh-lede-pos { font-family: var(--serif); font-style: normal; font-size: clamp(13px, 1vw, 15px); color: rgba(28,29,34,0.5); }
    /* 44ch (the About hero's measure) put this longer lede over FOUR lines where
       About's runs to three, so the two heroes ended at different heights.
       Stretched until it wraps to three as well (Dani, 7 Oct). */
    .vh-lede-text { font-family: var(--sans); font-size: clamp(13px, 1vw, 15px); font-weight: 400; line-height: 1.6; color: rgba(28,29,34,0.78); margin: 0; max-width: 62ch; }
    .vh-lede-btn { display: inline-flex; align-items: center; gap: 10px; margin-top: 20px; padding: 8px 24px; border: 1px solid var(--ink); background: none; cursor: pointer; color: var(--ink); font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; transition: background 0.3s, color 0.3s; }
    .vh-lede-btn:hover { background: var(--ink); color: var(--paper); }
    .vh-lede-btn span { transition: transform 0.3s; }
    .vh-lede-btn:hover span { transform: translateX(4px); }
    .vh-lede-media { margin: 0; justify-self: end; }
    .vh-lede-media img { display: block; height: clamp(300px, 36vh, 372px); width: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 2px; }
    .vh .pf-partner { margin: 14px 0 0; }
    /* The long VIDEO — inset like the About photos at rest; the deck JS grows its
       inset to full-bleed as you scroll (top/left/right/radius set by JS), rising
       up over the header into a full-page video, then advances across. */
    .vh-pic { position: absolute; z-index: 2; margin: 0; overflow: hidden; top: 52%; left: var(--page-gutter); right: var(--page-gutter); bottom: 0; border-radius: 2px; background: #1a1822; }
    .vh-pic video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 0%; }

    /* ---- Why it matters ----
       Every rule here used to be written against a .vintro wrapper. Page one
       has no such wrapper — the block is .vintro-inner on its own — so none of
       it applied: no left margin (the words sat on the screen edge) and no
       type (they fell back to the global p, which is why this one paragraph
       was in a different face from every other body on the site). Dani, 7 Oct. */
    .vintro-inner { max-width: 680px; margin-inline: var(--page-gutter); }
    /* "Why it matters" eyebrow — chapter-style decorative line, then the word. */
    .vintro-inner .pf-panel-cat {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
      color: var(--english-violet);
    }
    .vintro-inner .pf-panel-cat::before {
      content: "";
      display: block;
      width: 48px;
      height: 1px;
      background: currentColor;
      opacity: 0.45;
      flex-shrink: 0;
    }
    /* The same type as Social Media's three points (.sm-open-h — "Reach That
       Matters", "Property first, always."): The Seasons, 700, the same size,
       line-height and tracking, in burgundy. Dani, 7 Oct. */
    .vintro-lead {
      font-family: var(--subhead) !important; font-style: normal;
      font-weight: 700 !important; letter-spacing: -0.01em !important;
      font-size: clamp(18px, 1.35vw, 21px) !important; line-height: 1.25 !important;
      color: var(--english-violet) !important; margin: 0 0 18px !important;
    }
    /* Same body as .vh-route-body and .sm-way-copy. */
    .vintro-inner p {
      font-family: var(--sans); font-size: 14px; line-height: 1.75;
      color: rgba(28,29,34,0.7); margin: 0 0 14px;
    }

    /* Blurb under the slide one-liner */
    .pf-panel-sub { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.5; color: var(--ink); max-width: 50ch; margin: 0 0 24px; }
    .pf-panel-price em { font-style: normal; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-left: 2px; }

    /* ---- Cover/stack deck (mirrors the Social Media page) ----
       Panels are stacked and absolutely positioned; the controller slides each
       one OVER the previous from the right (floaty, free-scroll, stop-anywhere)
       rather than using a native horizontal scroll-snap. Every panel is opaque
       so it cleanly covers the one beneath. */
    .pf-deck { position: absolute; inset: 0; overflow: hidden; }
    .pf-panel {
      position: absolute; inset: 0;
      background: var(--paper);
      will-change: transform;
      backface-visibility: hidden;
      transform: translateX(100%);   /* pre-parked off-screen until the deck JS runs */
    }
    /* Slide 1 shows first; the rest stay off-screen, so a direct load/refresh
       never flashes the top (last) panel. The controller overrides on frame 1. */
    .pf-panel:first-child { transform: translateX(0); }

    /* ---- Shared slide layout: wording (left) + image (right) ---- */
    .pf-panel--slide { display: flex; }
    .pf-panel-text {
      width: 42%; min-width: 340px;
      padding: 0 56px 72px 40px;
      display: flex; flex-direction: column; justify-content: flex-end;
    }
    .pf-panel-img {
      flex: 1; align-self: stretch; border: none; padding: 0;
      margin: 0;
      background-size: cover; background-position: center;
      background-color: #e9e4da;
    }
    button.pf-panel-img { cursor: pointer; }

    /* Statement panels (intro + closing) — larger type, same column */
    .pf-eyebrow {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--english-violet); margin: 0 0 24px;
    }
    .pf-statement-h {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(38px, 3.8vw, 54px); line-height: 1.04;
      letter-spacing: -0.02em; margin: 0 0 24px;
    }
    .pf-statement-h em { font-style: italic; color: var(--english-violet); }
    .pf-statement-sub {
      font-family: var(--sans); font-size: 16px;
      line-height: 1.6; color: rgba(28,29,34,0.7); max-width: 52ch; margin: 0 0 36px;
    }
    .pf-scroll-hint {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.24em; text-transform: uppercase; color: rgba(28,29,34,0.5);
    }
    .pf-scroll-hint em { font-style: normal; margin-left: 8px; }
    .pf-book { align-self: flex-start; }
    .pf-partner { margin: 0 0 32px; }
    .pf-partner[hidden] { display: none; }
    #vid-partner-text {
      display: inline-flex; align-items: center; gap: 10px; padding: 9px 16px;
      border-radius: 999px; background: rgba(var(--violet-rgb), 0.1); color: var(--english-violet);
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
    }

    /* Product slides */
    /* 11px, not 12px — the size every other eyebrow on the site uses. */
    .pf-panel-cat {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--english-violet); margin-bottom: 18px;
    }
    .pf-panel-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(38px, 3.8vw, 54px); line-height: 1.04;
      letter-spacing: -0.02em; margin: 0 0 20px;
      color: var(--english-violet); /* TMKE burgundy wine #371e28 */
    }
    .pf-panel-copy {
      font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.5;
      color: var(--ink); max-width: 52ch; margin: 0 0 24px;
    }
    .pf-panel-meta { margin-bottom: 26px; }
    .pf-panel-price { font-family: var(--sans); font-size: 13px; letter-spacing: 0.04em; color: rgba(28,29,34,0.6); }
    .pf-panel-price strong { font-family: var(--serif); font-size: 24px; font-weight: 500; color: var(--ink); margin-left: 4px; }
    .pf-cta {
      align-self: flex-start; background: none; border: none; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);
      padding: 12px 0; border-bottom: 1px solid #7e6765; /* brand secondary shade */
      transition: color 0.25s, border-color 0.25s;
    }
    .pf-cta em { font-style: normal; margin-left: 10px; transition: margin 0.25s; display: inline-block; }
    .pf-cta:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .pf-cta:hover em { margin-left: 16px; }

    /* Product-slide actions: a solid "Book Now" + a matching ghost "Discover".
       Both are real buttons so the pair looks balanced; vertical padding is kept
       tight so they're not too tall. */
    .pf-panel-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .pf-act-btn {
      align-self: center; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase;
      padding: 10px 22px; border-radius: 2px; border: 1px solid var(--english-violet);
      display: inline-flex; align-items: center;
      transition: background .25s, color .25s, border-color .25s;
    }
    .pf-act-btn--solid { background: var(--english-violet); color: var(--paper); }
    .pf-act-btn--solid:hover { background: var(--ink); border-color: var(--ink); }
    .pf-act-btn--ghost { background: none; color: var(--english-violet); }
    .pf-act-btn--ghost:hover { background: var(--english-violet); color: var(--paper); }
    .pf-act-btn .btn-arrow { margin-left: 10px; display: inline-block; transition: margin .25s; }
    .pf-act-btn:hover .btn-arrow { margin-left: 16px; }

    /* Pull-up handle at the bottom edge of each product slide — opens its pop-out
       (which slides up from the bottom). Mirrors the newsletter reveal tab. */
    .pf-pullup {
      position: absolute; left: 50%; bottom: 0; transform: translateX(-50%);
      z-index: 6; width: 110px; height: 38px; border: none; cursor: pointer;
      background: var(--english-violet); color: var(--paper);
      border-radius: 10px 10px 0 0; display: flex; align-items: center; justify-content: center;
      transition: background .25s, transform .4s cubic-bezier(.16,1,.3,1);
    }
    .pf-pullup:hover { background: var(--ink); transform: translateX(-50%) translateY(-5px); }
    .pf-pullup-arrow { font-size: 18px; line-height: 1; animation: pfPullupBob 2.2s ease-in-out infinite; }
    @keyframes pfPullupBob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
    @media (prefers-reduced-motion: reduce) { .pf-pullup-arrow { animation: none; } }

    /* Clickable "Scroll" (slide 1) + "Our services" (slide 2) hints — styled and
       positioned to match the .pf-cta "Discover ..." buttons on the other slides. */
    .pf-advance {
      align-self: flex-start; background: none; border: none; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);
      padding: 12px 0; border-bottom: 1px solid #7e6765; /* brand secondary shade */
      transition: color 0.25s, border-color 0.25s;
    }
    .pf-advance em { font-style: normal; margin-left: 10px; transition: margin 0.25s; display: inline-block; }
    .pf-advance:hover { color: var(--english-violet); border-bottom-color: var(--english-violet); }
    .pf-advance:hover em { margin-left: 16px; }
    /* Hero slide (dark video) — pin to the bottom-left at 72px (matching the
       Discover buttons) and switch to light, since it sits over the footage. */
    .vh .pf-advance--hero {
      position: absolute; left: clamp(28px, 6vw, 120px); bottom: 72px;
      color: var(--paper); border-bottom-color: rgba(244,242,241,0.45);
    }
    .vh .pf-advance--hero:hover { color: var(--paper); border-bottom-color: var(--paper); }

    /* ---- Final panels: a photograph, then the ways in ----
       Both Get Starteds (film and stills) are the same stack /services uses:
       a full-width picture under the bar, then the list, sitting on the page's
       own bottom margin. position/inset come from .pf-panel. */
    .pf-final, .pf-panel.vpcontact {
      display: flex; flex-direction: column; justify-content: flex-start;
      gap: clamp(20px, 3vh, 34px);
      padding: 0 0 var(--page-gutter); box-sizing: border-box; overflow: hidden;
    }
    .pf-cta-card {
      flex: 0 0 33.3333vw; height: 100%; box-sizing: border-box;
      /* Bottom-aligned with the SAME paddings as the /services social-media cards
         so they sit at the same height (and stay level — matching content). */
      display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start;
      gap: 22px; padding: clamp(96px, 12vh, 150px) clamp(28px, 3vw, 56px) 72px;
    }
    /* Divider line between the two cards (matches the /services layout). */
    .pf-cta-card:not(:last-of-type) { border-right: 1px solid rgba(28, 29, 34, 0.10); }
    .pf-cta-img {
      /* Fixed (no flex-shrink) + capped height so both cards' images match —
         a longer description no longer shrinks one image and drops its title. */
      flex: 0 0 auto;
      width: 100%; max-width: 360px; height: clamp(150px, 24vh, 280px);
      background-size: cover; background-position: center; background-color: #e9e4da;
    }
    .pf-cta-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; width: 100%; max-width: 360px; }
