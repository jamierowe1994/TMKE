---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import VideographyBooking from "../../components/VideographyBooking.astro";
import VideoShowcase from "../../components/VideoShowcase.astro";
import NavDrawer from "../../components/NavDrawer.astro";
import VideographyBrochureForm from "../../components/VideographyBrochureForm.astro";
import { PRODUCTS, tierPrice, VIDEOGRAPHY_BROCHURE } from "../../data/videography.js";
import { gbpFromPence } from "../../lib/supabase.js";

// Deck panels: dictionary hero + intro/why + one per product + closing booking.
const total = PRODUCTS.length + 3;

// Opening + closing imagery — the site's own on-brand R2 stills.
const R2 = (name) => `https://assets.tmke.co.uk/${name}.webp`;

// Map a product to its booking-flow service key (Studio = Content Studio).
const serviceKey = (p) => (p.slug === "studio" ? "content-studio" : p.slug);
// Dictionary-hero backdrop — the client's "Camera View" still on R2.
const HERO_IMG = "https://assets.tmke.co.uk/camera%20view.jpg";
// Slide-1 hero (SMM-style): full-bleed background VIDEO + a right-hand static
// image box (placeholder pulled from the site; client to replace).
const VID_HERO_VIDEO = "https://assets.tmke.co.uk/Jack%20Photos%20-%20Homepage/Property%20Edit%20Video%201%20.mov";
const VID_BOX_IMG = (await getImage({
  src: "https://assets.tmke.co.uk/camera%20view.jpg",
  width: 700, height: 933, quality: 78, format: "webp",
})).src;

const navLinks = [
  { label: "About", href: "/about" },
  { label: "Social Media", href: "/services" },
  { label: "Videography", href: "/videography", current: true },
  { label: "The Edit", href: "/edit" },
  { label: "Insights", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<BaseLayout
  title="Videography — TMKE"
  description="Professional property video and photography — The Studio, The Property and The Agent. Presenter-led tours, drone, 360, short-form content and headshots, produced and delivered by TMKE."
  hideNav
  hideFooter
  pageTransition
>
  <div class="pf">
    <!-- Top nav — TMKE (left) + Menu (right); hover the top strip to reveal links. -->
    <header class="pf-top" id="pf-top">
      <a href="/" class="pf-top-logo">TMKE</a>
      <nav class="pf-top-links" aria-label="Primary">
        {navLinks.map((l) => (
          <a href={l.href} class:list={[l.current && "is-current"]}>{l.label}</a>
        ))}
        <a href="/login" class="pf-top-login js-nav-login">Login</a>
      </nav>
      <button type="button" class="pf-top-menu" id="pf-top-menu" aria-label="Menu" aria-expanded="false" data-nav-drawer-open><span></span><span></span><span></span></button>
    </header>

    <!-- Horizontal deck — each panel is one "page"; scroll right to advance. -->
    <div class="pf-deck" id="pf-deck">
      <!-- Slide 1 — like /services slide 1 (About lede pinned to the top: copy
           left, photo right) with one long element below that rises up over the
           header into a full-page on scroll, then advances across. Here that long
           element is the VIDEO (the .mov), not an image. -->
      <section class="pf-panel vh">
        <div class="vh-header">
          <div class="vh-wrap">
            <div class="vh-lede-grid">
              <div class="vh-lede-copy">
                <div class="vh-lede-top">
                  <h1 class="vh-lede-mark">Videography</h1>
                  <p class="vh-lede-pron">
                    <span class="vh-lede-phon">/&thinsp;vid.i&#712;&#594;g.r&#601;.fi&thinsp;/</span>
                    <span class="vh-lede-pos"><em>noun</em></span>
                  </p>
                </div>
                <div class="vh-lede-bottom">
                  <p class="vh-lede-text">Professional property video and photography for agents who understand that first impressions are made online. From tours to short-form content, delivered to a standard that wins instructions.</p>
                  <div class="pf-partner" id="vid-partner-banner" hidden><span id="vid-partner-text"></span></div>
                  <button type="button" class="vh-lede-btn" data-deck-next>Discover <span aria-hidden="true">&rarr;</span></button>
                </div>
              </div>
              <figure class="vh-lede-media">
                <img src={VID_BOX_IMG} alt="TMKE videography" />
              </figure>
            </div>
          </div>
        </div>
        <figure class="vh-pic">
          <video class="vh-pic-vid" src={VID_HERO_VIDEO} autoplay muted loop playsinline preload="auto" aria-hidden="true"></video>
        </figure>
      </section>

      <!-- Slide 2 — Intro & Why -->
      <section class="pf-panel vintro">
        <div class="vintro-inner">
          <span class="pf-panel-cat">Why it matters</span>
          <p class="vintro-lead">Before anyone reads a word of your listing, they've already formed an opinion. That opinion is shaped by one thing, the quality of the media in front of them.</p>
          <p>Poor photography loses instructions. Weak video loses viewings. And in a market where buyers scroll through dozens of listings before shortlisting a single one, the properties that get attention are the ones that look the part.</p>
          <p>But professional media isn't just about listings — it's about you. The agents who build lasting visibility in their local market aren't always the most experienced; they're the ones who show up consistently, look credible, and make the right impression before they ever walk through the door.</p>
          <p>Strong visuals work harder across every channel. They improve click-through rates on property portals, elevate your printed marketing, strengthen your valuation packs, and build the kind of brand presence that wins more instructions over time.</p>
          <button type="button" class="pf-advance vintro-next" data-deck-next aria-label="Go to our services">Our services <em aria-hidden="true">&rarr;</em></button>
        </div>
      </section>

      <!-- Product panels — wording (left) + image (right) -->
      {PRODUCTS.map((p) => (
        <section class="pf-panel pf-panel--slide">
          <div class="pf-panel-text">
            <span class="pf-panel-cat">Videography — {p.num}</span>
            <h2 class="pf-panel-title">{p.name}</h2>
            <p class="pf-panel-copy">{p.slideCopy}</p>
            <p class="pf-panel-sub">{p.slideBlurb}</p>
            <div class="pf-panel-meta">
              <span class="pf-panel-price">from <strong data-price-svc={p.slug} data-tier="0">{gbpFromPence(tierPrice(p.priceTiers[0], "direct"))}</strong> <em>+VAT</em></span>
            </div>
            <div class="pf-panel-actions">
              <button type="button" class="pf-act-btn pf-act-btn--solid" data-vbook={serviceKey(p)}>Book Now <span class="btn-arrow">&rarr;</span></button>
              <button type="button" class="pf-act-btn pf-act-btn--ghost" data-open={p.slug}>{p.ctaLabel} <span class="btn-arrow">&rarr;</span></button>
            </div>
          </div>
          <button
            type="button"
            class="pf-panel-img"
            data-open={p.slug}
            style={`background-image:url('${p.hero}')`}
            aria-label={`${p.ctaLabel} — ${p.name}`}
          ></button>
          <!-- Pull-up handle — a bottom-edge arrow that opens the slide-up pop-out. -->
          <button type="button" class="pf-pullup" data-open={p.slug} aria-label={`Open ${p.name}`}>
            <span class="pf-pullup-arrow" aria-hidden="true">&uarr;</span>
          </button>
        </section>
      ))}

      <!-- Closing panel — brochure + two booking cards + a slide-in newsletter reveal -->
      <section class="pf-panel pf-final" id="pf-final">
        <div class="pf-final-track" id="pf-final-track">
          <article class="pf-cta-card">
            <div class="pf-cta-img" style={`background-image:url('${R2("white-1")}')`}></div>
            <div class="pf-cta-head">
              <h2 class="pf-cta-title">Download a Brochure</h2>
            </div>
            <p class="pf-cta-desc">{VIDEOGRAPHY_BROCHURE.cardBody}</p>
            <button type="button" data-vid-brochure class="pf-cta-btn">Download a brochure <span class="btn-arrow">&rarr;</span></button>
          </article>

          <article class="pf-cta-card">
            <div class="pf-cta-img" style={`background-image:url('${R2("living-1")}')`}></div>
            <div class="pf-cta-head">
              <h2 class="pf-cta-title">Book a Consultation</h2>
            </div>
            <p class="pf-cta-desc">Not sure which service is right for you, or want to talk through what you need before committing to a booking? Jump on a quick call with Jack directly — no pressure and no sales pitch.</p>
            <button type="button" data-vbook="discovery" class="pf-cta-btn">Book a time that suits you <span class="btn-arrow">&rarr;</span></button>
          </article>

          <article class="pf-cta-card">
            <div class="pf-cta-img" style={`background-image:url('${R2("table")}')`}></div>
            <div class="pf-cta-head">
              <h2 class="pf-cta-title">Book a Shoot</h2>
              <span class="pf-cta-meta">A day with the team</span>
            </div>
            <p class="pf-cta-desc">Ready to go? Browse our full range of videography and photography services, choose what works for you, and secure your session in minutes.</p>
            <button type="button" data-vbook="choose" class="pf-cta-btn">Book a shoot <span class="btn-arrow">&rarr;</span></button>
          </article>

          <aside class="pf-news" aria-label="Newsletter sign-up">
            <h2 class="pf-news-title">Sign up for our<br />newsletter</h2>
            <form class="pf-news-form" id="pf-news-form" novalidate>
              <input type="text" name="first" placeholder="First name" autocomplete="given-name" />
              <input type="text" name="last" placeholder="Surname" autocomplete="family-name" />
              <input type="email" name="email" placeholder="Email" autocomplete="email" required />
              <button type="submit" class="pf-news-send">Send <span class="btn-arrow">&rarr;</span></button>
            </form>
            <div class="pf-news-meta">
              <span>Follow us</span>
              <a href="https://instagram.com/" target="_blank" rel="noopener">@tmke</a>
            </div>
          </aside>
        </div>

        <button type="button" class="pf-reveal-tab" id="pf-reveal-tab" aria-label="Reveal newsletter">
          <span class="pf-reveal-arrow" aria-hidden="true">&rarr;</span>
        </button>
      </section>
    </div>

    <!-- Counter -->
    <div class="pf-counter"><span id="pf-cur">01</span> <span class="pf-counter-sep">/</span> {String(total).padStart(2, "0")}</div>
  </div>

  <!-- ============ SHOWCASE POP-UPS (inset modal; sticky image + scrolling info) ============ -->
  <div class="vmodal-scrim" id="vmodal-scrim" hidden></div>
  <button type="button" class="vmodal-x" id="vmodal-x" data-close aria-label="Close" hidden>&times;</button>
  {PRODUCTS.map((p) => {
    // Unified, ordered media list for the pop-out gallery. Prefer an explicit
    // `media` list (hand-ordered mix of stills + film); otherwise fall back to
    // the legacy heroVideo + gallery images.
    const galItems = p.media
      ? p.media
      : [
          ...(p.heroVideo ? [{ type: "video", src: p.heroVideo }] : []),
          ...((p.gallery || []).map((src) => ({ type: "image", src }))),
        ];
    const firstIsVideo = galItems[0] && galItems[0].type === "video";
    const anyVideo = galItems.some((m) => m.type === "video");
    const firstImg = (galItems.find((m) => m.type === "image") || {}).src || p.hero;
    return (
    <section
      class="vdraw"
      data-product={p.slug}
      data-from="bottom"
      role="dialog"
      aria-modal="true"
      aria-label={p.name}
      hidden
    >
      <div class="vdraw-scroll">
        <div class="vdraw-grid">
          <!-- LEFT (40%): scrolling info — intro, included, extras, pricing, about -->
          <div class="vdraw-left">
            <div class="vmodal-eyebrow">Videography {p.num}</div>
            <h2 class="vmodal-title">{p.name}</h2>
            <p class="vmodal-lede">{p.popLede}</p>
            {p.popIntro.map((para) => <p class="vmodal-summary">{para}</p>)}

            <div class="vmodal-divider" aria-hidden="true"></div>

            <h3 class="vmodal-sub">{p.includedHeading || "What's Included"}</h3>
            <ul class="vmodal-included">
              {p.included.map((d) => <li>{d}</li>)}
            </ul>

            {p.extras && p.extras.length > 0 && (
              <>
                <h3 class="vmodal-sub">{p.extrasHeading}</h3>
                <ul class="vmodal-extras">
                  {p.extras.map((x) => (
                    <li>
                      <span class="vmodal-extra-label">{x.label}</span>
                      <span class="vmodal-extra-price">{x.price}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}

            <div class="vmodal-price-card">
              <h3 class="vmodal-sub vmodal-sub--card">{p.pricingHeading}</h3>

              {p.pricingMode === "tiers" ? (
                <div class="vmodal-price-tiers">
                  {p.priceTiers.map((t, i) => (
                    <div class="vmodal-tier">
                      <span class="vmodal-tier-info">
                        <span class="vmodal-tier-label">{t.label}</span>
                        {t.sub && <span class="vmodal-tier-sub">{t.sub}</span>}
                      </span>
                      <span class="vmodal-tier-price">from <b data-price-svc={p.slug} data-tier={i}>{gbpFromPence(tierPrice(t, "direct"))}</b> +VAT</span>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="vmodal-price-prose">
                  {p.pricingProse.map((para) => <p>{para}</p>)}
                </div>
              )}

              {p.pricingMode === "tiers" && (
                <div class="vmodal-price-note" data-note-svc={p.slug}>Standard rates</div>
              )}

              <button type="button" data-vbook={serviceKey(p)} class="btn btn--solid vmodal-book">
                {p.bookCtaLabel} <span class="btn-arrow">&rarr;</span>
              </button>
              <button type="button" data-vbook="discovery" class="vmodal-consult">
                Not quite sure about something? <strong>Book a consultation call.</strong>
              </button>
            </div>

            <h3 class="vmodal-sub">{p.aboutHeading}</h3>
            {p.about.map((para) => <p class="vmodal-bio">{para}</p>)}

            {p.showcase && p.showcase.length > 0 && (
              <VideoShowcase heading="Recent work" items={p.showcase} />
            )}
          </div>

          <!-- RIGHT (60%): sticky media stage + showcase thumbnails. When a
               product has heroVideo, the video is the main media (default) and
               the thumbnails (video first) swap an image in over it. -->
          <div class="vdraw-right" data-product-right={p.slug} data-media-gallery={p.media ? "1" : undefined}>
            <div class={`vdraw-stage${firstIsVideo ? "" : " show-img"}`}>
              {anyVideo && (
                <video class="vdraw-hero-video" autoplay muted loop playsinline preload="metadata">
                  {firstIsVideo && <source src={galItems[0].src} type="video/mp4" />}
                </video>
              )}
              <div class="vdraw-hero-img is-active" style={`background-image:url('${firstImg}')`}></div>
              <div class="vdraw-hero-img"></div>
              {galItems.length > 1 && (
                <div class="vmodal-nav">
                  <button type="button" class="vmodal-arrow" data-dir="-1" aria-label="Previous">&larr;</button>
                  <span class="vmodal-count"><b class="vmodal-count-cur">1</b> / <b class="vmodal-count-total">{galItems.length}</b></span>
                  <button type="button" class="vmodal-arrow" data-dir="1" aria-label="Next">&rarr;</button>
                </div>
              )}
            </div>
            {galItems.length > 0 && (
              <div class="vmodal-gallery">
                {galItems.map((m, i) => (
                  m.type === "video" ? (
                    <button type="button" class={`vmodal-thumb vmodal-thumb--video ${i === 0 ? "is-active" : ""}`} data-video data-video-src={m.src} aria-label={`Video ${i + 1}`}><span class="vmodal-thumb-play" aria-hidden="true">&#9658;</span></button>
                  ) : (
                    <button type="button" class={`vmodal-thumb ${i === 0 ? "is-active" : ""}`} data-full={m.src} style={`background-image:url('${m.src}')`} aria-label={`View photo ${i + 1}`}></button>
                  )
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
    );
  })}

  <VideographyBooking />
  <VideographyBrochureForm />
  <NavDrawer />

  <style>
    .pf {
      position: fixed; inset: 0;
      background: var(--paper);
      color: var(--ink);
      overflow: hidden;
    }

    /* First slide entrance — auto-plays on load (pure CSS, no JS dependency):
       the hero image slowly settles, then the dictionary wording rises in. */
    #pf-deck .pf-panel:first-child .vh-lede-media { animation: pfImgIn 2.4s cubic-bezier(.16,1,.3,1) 0.2s both; }
    #pf-deck .pf-panel:first-child .vh-lede-copy { animation: pfTextIn 1.6s cubic-bezier(.16,1,.3,1) 0.6s both; }
    @keyframes pfImgIn { from { opacity: 0; transform: scale(1.08); } to { opacity: 1; transform: none; } }
    @keyframes pfTextIn { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
      #pf-deck .pf-panel:first-child .vh-lede-media,
      #pf-deck .pf-panel:first-child .vh-lede-copy { animation-duration: 0.01ms; }
    }

    /* ---- Slide 1: copied from /services slide 1 (the About lede pinned to the
       top — copy left, photo right, ink on paper), with one long element below
       that rises up over the header into a full-page on scroll. Here that long
       element is the VIDEO (the .mov), not an image. ---- */
    .pf-panel.vh { display: block; overflow: hidden; padding: 0; background: var(--paper); color: var(--ink); }
    .vh-header { position: relative; z-index: 1; padding: clamp(84px, 10vh, 106px) 76px clamp(40px, 5vh, 56px); }
    .vh-wrap { max-width: 1360px; margin: 0 auto; }
    .vh-lede-grid { display: grid; grid-template-columns: 1fr auto; gap: clamp(32px, 5vw, 80px); align-items: stretch; }
    .vh-lede-copy { max-width: 480px; display: flex; flex-direction: column; justify-content: space-between; }
    .vh-lede-mark { font-family: var(--serif); font-weight: 500; font-size: clamp(40px, 4.6vw, 66px); line-height: 0.94; letter-spacing: 0.02em; margin: 0; color: var(--ink); }
    .vh-lede-pron { display: flex; align-items: baseline; gap: 12px; margin: 12px 0 0; }
    .vh-lede-phon { font-family: var(--serif); font-size: clamp(14px, 1.1vw, 17px); letter-spacing: 0.06em; color: rgba(28,29,34,0.6); }
    .vh-lede-pos { font-family: var(--serif); font-style: italic; font-size: clamp(13px, 1vw, 15px); color: rgba(28,29,34,0.5); }
    .vh-lede-text { font-family: var(--sans); font-size: clamp(13px, 1vw, 15px); font-weight: 400; line-height: 1.6; color: rgba(28,29,34,0.78); margin: 0; max-width: 44ch; }
    .vh-lede-btn { display: inline-flex; align-items: center; gap: 10px; margin-top: 20px; padding: 8px 24px; border: 1px solid var(--ink); background: none; cursor: pointer; color: var(--ink); font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; transition: background 0.3s, color 0.3s; }
    .vh-lede-btn:hover { background: var(--ink); color: var(--paper); }
    .vh-lede-btn span { transition: transform 0.3s; }
    .vh-lede-btn:hover span { transform: translateX(4px); }
    .vh-lede-media { margin: 0; justify-self: end; }
    .vh-lede-media img { display: block; height: clamp(300px, 36vh, 372px); width: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 2px; }
    .vh .pf-partner { margin: 14px 0 0; }
    /* The long VIDEO — inset like the About photos at rest; the deck JS grows its
       inset to full-bleed as you scroll (top/left/right/radius set by JS), rising
       up over the header into a full-page video, then advances across. */
    .vh-pic { position: absolute; z-index: 2; margin: 0; overflow: hidden; top: 52%; left: 76px; right: 76px; bottom: 0; border-radius: 2px; background: #1a1822; }
    .vh-pic video { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 0%; }

    /* ---- Slide 2: Intro & Why ---- */
    .vintro { display: flex; align-items: flex-end; padding: 96px clamp(28px, 8vw, 140px) 72px; background: #eae5e1; }
    .vintro-inner { max-width: 680px; }
    /* "Why it matters" eyebrow — chapter-style decorative line, then the word. */
    .vintro .pf-panel-cat {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 20px;
      color: var(--english-violet);
    }
    .vintro .pf-panel-cat::before {
      content: "";
      display: block;
      width: 48px;
      height: 1px;
      background: currentColor;
      opacity: 0.45;
      flex-shrink: 0;
    }
    .vintro-lead {
      font-family: var(--serif) !important; font-style: italic;
      font-size: clamp(22px, 2.4vw, 32px) !important; line-height: 1.32 !important;
      color: var(--ink) !important; margin: 0 0 24px !important;
    }
    .vintro p { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.5; color: var(--ink); margin: 0 0 16px; }
    .vintro p:not(.vintro-lead) { text-align: justify; }
    .vintro .vintro-next { display: inline-block; margin-top: 16px; }

    /* Blurb under the slide one-liner */
    .pf-panel-sub { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.5; color: var(--ink); max-width: 50ch; margin: 0 0 24px; }
    .pf-panel-price em { font-style: normal; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-left: 2px; }

    /* ---- Cover/stack deck (mirrors the Social Media page) ----
       Panels are stacked and absolutely positioned; the controller slides each
       one OVER the previous from the right (floaty, free-scroll, stop-anywhere)
       rather than using a native horizontal scroll-snap. Every panel is opaque
       so it cleanly covers the one beneath. */
    .pf-deck { position: absolute; inset: 0; overflow: hidden; }
    .pf-panel {
      position: absolute; inset: 0;
      background: var(--paper);
      will-change: transform;
      backface-visibility: hidden;
      transform: translateX(100%);   /* pre-parked off-screen until the deck JS runs */
    }
    /* Slide 1 shows first; the rest stay off-screen, so a direct load/refresh
       never flashes the top (last) panel. The controller overrides on frame 1. */
    .pf-panel:first-child { transform: translateX(0); }

    /* ---- Shared slide layout: wording (left) + image (right) ---- */
    .pf-panel--slide { display: flex; }
    .pf-panel-text {
      width: 42%; min-width: 340px;
      padding: 0 56px 72px 40px;
      display: flex; flex-direction: column; justify-content: flex-end;
    }
    .pf-panel-img {
      flex: 1; align-self: stretch; border: none; padding: 0;
      margin: 0;
      background-size: cover; background-position: center;
      background-color: #e9e4da;
    }
    button.pf-panel-img { cursor: pointer; }

    /* Statement panels (intro + closing) — larger type, same column */
    .pf-eyebrow {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--english-violet); margin: 0 0 24px;
    }
    .pf-statement-h {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(38px, 3.8vw, 54px); line-height: 1.04;
      letter-spacing: -0.02em; margin: 0 0 24px;
    }
    .pf-statement-h em { font-style: italic; color: var(--english-violet); }
    .pf-statement-sub {
      font-family: var(--sans); font-size: 16px;
      line-height: 1.6; color: rgba(28,29,34,0.7); max-width: 52ch; margin: 0 0 36px;
    }
    .pf-scroll-hint {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.24em; text-transform: uppercase; color: rgba(28,29,34,0.5);
    }
    .pf-scroll-hint em { font-style: normal; margin-left: 8px; }
    .pf-book { align-self: flex-start; }
    .pf-partner { margin: 0 0 32px; }
    .pf-partner[hidden] { display: none; }
    #vid-partner-text {
      display: inline-flex; align-items: center; gap: 10px; padding: 9px 16px;
      border-radius: 999px; background: rgba(var(--violet-rgb), 0.1); color: var(--english-violet);
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
    }

    /* Product slides */
    .pf-panel-cat {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--english-violet); margin-bottom: 18px;
    }
    .pf-panel-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(38px, 3.8vw, 54px); line-height: 1.04;
      letter-spacing: -0.02em; margin: 0 0 20px;
      color: var(--english-violet); /* TMKE burgundy wine #371e28 */
    }
    .pf-panel-copy {
      font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.5;
      color: var(--ink); max-width: 52ch; margin: 0 0 24px;
    }
    .pf-panel-meta { margin-bottom: 26px; }
    .pf-panel-price { font-family: var(--sans); font-size: 13px; letter-spacing: 0.04em; color: rgba(28,29,34,0.6); }
    .pf-panel-price strong { font-family: var(--serif); font-size: 24px; font-weight: 500; color: var(--ink); margin-left: 4px; }
    .pf-cta {
      align-self: flex-start; background: none; border: none; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);
      padding: 12px 0; border-bottom: 1px solid #7e6765; /* brand secondary shade */
      transition: color 0.25s, border-color 0.25s;
    }
    .pf-cta em { font-style: normal; margin-left: 10px; transition: margin 0.25s; display: inline-block; }
    .pf-cta:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .pf-cta:hover em { margin-left: 16px; }

    /* Product-slide actions: a solid "Book Now" + a matching ghost "Discover".
       Both are real buttons so the pair looks balanced; vertical padding is kept
       tight so they're not too tall. */
    .pf-panel-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .pf-act-btn {
      align-self: center; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase;
      padding: 10px 22px; border-radius: 2px; border: 1px solid var(--english-violet);
      display: inline-flex; align-items: center;
      transition: background .25s, color .25s, border-color .25s;
    }
    .pf-act-btn--solid { background: var(--english-violet); color: var(--paper); }
    .pf-act-btn--solid:hover { background: var(--ink); border-color: var(--ink); }
    .pf-act-btn--ghost { background: none; color: var(--english-violet); }
    .pf-act-btn--ghost:hover { background: var(--english-violet); color: var(--paper); }
    .pf-act-btn .btn-arrow { margin-left: 10px; display: inline-block; transition: margin .25s; }
    .pf-act-btn:hover .btn-arrow { margin-left: 16px; }

    /* Pull-up handle at the bottom edge of each product slide — opens its pop-out
       (which slides up from the bottom). Mirrors the newsletter reveal tab. */
    .pf-pullup {
      position: absolute; left: 50%; bottom: 0; transform: translateX(-50%);
      z-index: 6; width: 110px; height: 38px; border: none; cursor: pointer;
      background: var(--english-violet); color: var(--paper);
      border-radius: 10px 10px 0 0; display: flex; align-items: center; justify-content: center;
      transition: background .25s, transform .4s cubic-bezier(.16,1,.3,1);
    }
    .pf-pullup:hover { background: var(--ink); transform: translateX(-50%) translateY(-5px); }
    .pf-pullup-arrow { font-size: 18px; line-height: 1; animation: pfPullupBob 2.2s ease-in-out infinite; }
    @keyframes pfPullupBob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
    @media (prefers-reduced-motion: reduce) { .pf-pullup-arrow { animation: none; } }

    /* Clickable "Scroll" (slide 1) + "Our services" (slide 2) hints — styled and
       positioned to match the .pf-cta "Discover ..." buttons on the other slides. */
    .pf-advance {
      align-self: flex-start; background: none; border: none; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);
      padding: 12px 0; border-bottom: 1px solid #7e6765; /* brand secondary shade */
      transition: color 0.25s, border-color 0.25s;
    }
    .pf-advance em { font-style: normal; margin-left: 10px; transition: margin 0.25s; display: inline-block; }
    .pf-advance:hover { color: var(--english-violet); border-bottom-color: var(--english-violet); }
    .pf-advance:hover em { margin-left: 16px; }
    /* Hero slide (dark video) — pin to the bottom-left at 72px (matching the
       Discover buttons) and switch to light, since it sits over the footage. */
    .vh .pf-advance--hero {
      position: absolute; left: clamp(28px, 6vw, 120px); bottom: 72px;
      color: var(--paper); border-bottom-color: rgba(244,242,241,0.45);
    }
    .vh .pf-advance--hero:hover { color: var(--paper); border-bottom-color: var(--paper); }

    /* ---- Final panel: two booking cards + slide-in newsletter ---- */
    /* position/inset come from .pf-panel (absolute, stacked); keep overflow so
       the slide-in newsletter track stays clipped. */
    .pf-final { overflow: hidden; }
    .pf-final-track {
      display: flex; height: 100%; width: max-content;
      transition: transform 0.75s cubic-bezier(.16,1,.3,1);
      will-change: transform;
    }
    .pf-cta-card {
      flex: 0 0 33.3333vw; height: 100%; box-sizing: border-box;
      /* Bottom-aligned with the SAME paddings as the /services social-media cards
         so they sit at the same height (and stay level — matching content). */
      display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start;
      gap: 22px; padding: clamp(96px, 12vh, 150px) clamp(28px, 3vw, 56px) 72px;
    }
    /* Divider line between the two cards (matches the /services layout). */
    .pf-cta-card:not(:last-of-type) { border-right: 1px solid rgba(28, 29, 34, 0.10); }
    .pf-cta-img {
      /* Fixed (no flex-shrink) + capped height so both cards' images match —
         a longer description no longer shrinks one image and drops its title. */
      flex: 0 0 auto;
      width: 100%; max-width: 360px; height: clamp(150px, 24vh, 280px);
      background-size: cover; background-position: center; background-color: #e9e4da;
    }
    .pf-cta-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; width: 100%; max-width: 360px; }
    .pf-cta-title { font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 2.4vw, 40px); letter-spacing: -0.02em; margin: 0; white-space: nowrap; color: var(--english-violet); /* burgundy #371e28 */ }
    .pf-cta-meta { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.5); white-space: nowrap; }
    .pf-cta-desc { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(28,29,34,0.7); max-width: 360px; margin: 0; }
    .pf-cta-btn {
      align-self: flex-start; background: none; border: none; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--ink); padding: 12px 0; border-bottom: 1px solid #7e6765; /* brand secondary shade */
      transition: color .25s, border-color .25s;
    }
    .pf-cta-btn:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .pf-cta-btn .btn-arrow { margin-left: 10px; display: inline-block; transition: margin .25s; }
    .pf-cta-btn:hover .btn-arrow { margin-left: 16px; }

    /* Newsletter footer (revealed by the tab) */
    .pf-news {
      flex: 0 0 40vw; height: 100%;
      background: var(--english-violet); color: var(--paper);
      display: flex; flex-direction: column; justify-content: center;
      gap: 28px; padding: 96px clamp(40px,4vw,72px) 56px;
    }
    .pf-news-title { font-family: var(--serif); font-weight: 400; font-size: clamp(30px, 2.8vw, 46px); line-height: 1.05; letter-spacing: -0.02em; margin: 0; }
    .pf-news-form { display: flex; flex-direction: column; gap: 20px; max-width: 380px; }
    .pf-news-form input {
      background: none; border: none; border-bottom: 1px solid rgba(240,238,235,0.4);
      color: var(--paper); font-family: var(--sans); font-size: 13px; letter-spacing: 0.12em;
      text-transform: uppercase; padding: 10px 0;
    }
    .pf-news-form input::placeholder { color: rgba(240,238,235,0.55); }
    .pf-news-form input:focus { outline: none; border-bottom-color: var(--paper); }
    .pf-news-send {
      margin-top: 10px; align-self: flex-start; background: var(--paper); color: var(--ink);
      border: none; cursor: pointer; font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; padding: 14px 30px; transition: opacity .25s;
    }
    .pf-news-send:hover { opacity: 0.85; }
    .pf-news-send .btn-arrow { margin-left: 10px; }
    .pf-news-meta { font-family: var(--sans); font-size: 12px; letter-spacing: 0.08em; color: rgba(240,238,235,0.7); display: flex; gap: 14px; }
    .pf-news-meta a { color: var(--paper); }

    /* Reveal tab — a handle on the right edge that slides the newsletter in */
    .pf-reveal-tab {
      position: absolute; top: 50%; right: 0; transform: translateY(-50%);
      z-index: 6; width: 40px; height: 104px; border: none; cursor: pointer;
      background: var(--english-violet); color: var(--paper);
      border-radius: 10px 0 0 10px; display: flex; align-items: center; justify-content: center;
      transition: right 0.75s cubic-bezier(.16,1,.3,1), background .25s;
    }
    .pf-reveal-tab:hover { background: var(--ink); }
    .pf-reveal-arrow { font-size: 18px; transition: transform .5s cubic-bezier(.16,1,.3,1); }
    .pf-final.is-revealed .pf-reveal-arrow { transform: rotate(180deg); }

    @media (max-width: 760px) {
      .pf-cta-card { flex: 0 0 100vw; padding: 90px 28px 40px; }
      .pf-cta-card:first-child { padding-left: 28px; border-right: none; }
      .pf-cta-img { max-width: none; height: 46vh; }
      .pf-news { flex: 0 0 100vw; padding: 90px 28px 40px; }
      /* Slide-1 lede stacks on mobile (matches /services). */
      .vh-header { padding: 88px 24px 26px; }
      .vh-lede-grid { grid-template-columns: 1fr; gap: 26px; align-items: start; }
      .vh-lede-copy { display: block; width: auto; max-width: none; }
      .vh-lede-bottom { margin-top: 24px; }
      .vh-lede-media { justify-self: stretch; }
      .vh-lede-media img { width: 100%; height: auto; aspect-ratio: 16 / 10; }
      .vh-lede-mark { font-size: clamp(34px, 9vw, 54px); }
    }

    /* ---- Top nav (logo left, Menu right; hover the strip to reveal links) ---- */
    .pf-top {
      position: fixed; top: 0; left: 0; right: 0; z-index: 60;
      display: flex; align-items: flex-start; justify-content: space-between;
      padding: 22px 40px;
      min-height: 78px;
      transition: background 0.35s ease, backdrop-filter 0.35s ease, border-color 0.35s ease;
      border-bottom: 1px solid transparent;
    }
    .pf-top.is-open {
      background: rgba(244, 242, 241, 0.92);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      border-bottom-color: rgba(28,29,34,0.08);
    }
    body.pf-modal-open .pf-top { pointer-events: none; }
    /* Logo + burger are the brand burgundy so they read on the light slides;
       on the dark dictionary hero (slide 1) the deck adds .on-dark and they go
       white. The current slide is tracked by the deck controller. */
    .pf-top-logo {
      font-family: var(--serif); font-size: 22px; letter-spacing: 0.08em;
      color: var(--english-violet); line-height: 1; position: relative; z-index: 2;
      transition: color 0.35s ease;
    }
    .pf-top.on-dark .pf-top-logo { color: var(--paper); }
    /* Burger button (top-right) — replaces the old hover-reveal + "Menu" text. */
    .pf-top-menu {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 30px; height: 22px; padding: 0; background: none; border: none; cursor: pointer;
      position: relative; z-index: 2;
    }
    .pf-top-menu span {
      display: block; width: 100%; height: 2px; border-radius: 2px;
      background: var(--english-violet);
      transition: transform 0.3s ease, opacity 0.25s ease, background 0.35s ease;
    }
    .pf-top.on-dark .pf-top-menu span { background: var(--paper); }
    .pf-top.is-open .pf-top-menu span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .pf-top.is-open .pf-top-menu span:nth-child(2) { opacity: 0; }
    .pf-top.is-open .pf-top-menu span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
    .pf-top-links {
      position: absolute; left: 50%; top: 0; transform: translateX(-50%);
      min-height: 78px; display: flex; align-items: center; gap: 30px;
      opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
    }
    .pf-top.is-open .pf-top-links { opacity: 1; pointer-events: auto; }
    body.pf-modal-open .pf-top-links { opacity: 0 !important; pointer-events: none !important; }
    .pf-top-links a {
      font-family: var(--sans); font-size: 14px; font-weight: 500; color: var(--ink); white-space: nowrap;
    }
    .pf-top-links a:hover { color: var(--english-violet); }
    .pf-top-links a.is-current { color: var(--english-violet); font-weight: 700; }
    .pf-top-login {
      font-weight: 700 !important; letter-spacing: 0.14em; text-transform: uppercase; font-size: 12px !important;
    }

    /* ---- Counter ---- */
    .pf-counter {
      display: none;
      position: fixed; right: 36px; bottom: 30px; z-index: 55;
      font-family: var(--sans); font-size: 13px; font-weight: 700;
      letter-spacing: 0.18em; color: rgba(28,29,34,0.6);
    }
    .pf-counter-sep { margin: 0 6px; opacity: 0.5; }

    @media (max-width: 760px) {
      .pf-panel--slide { flex-direction: column; }
      .pf-panel-text { width: 100%; min-width: 0; padding: 80px 28px 36px; justify-content: flex-end; }
      .pf-panel-img { width: auto; flex: 1; margin: 0; }
      .pf-top { padding: 18px 22px; min-height: 64px; }
      .pf-top-links { display: none; }
    }

    /* ===================== Showcase pop-up (inset modal) ===================== */
    .vmodal-scrim { position: fixed; inset: 0; z-index: 290; background: rgba(16, 14, 22, 0.62); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); opacity: 0; transition: opacity 0.6s ease; }
    .vmodal-scrim[hidden] { display: none; }
    .vmodal-scrim.is-open { opacity: 1; }

    /* Bottom sheet — full width, flush to the bottom, gap at the top so the
       page shows above it. Rises from the bottom edge of the screen. */
    .vdraw {
      position: fixed; top: 30px; left: 30px; right: 30px; bottom: 0; z-index: 300;
      background: var(--paper); border-radius: 18px 18px 0 0; overflow: hidden;
      box-shadow: 0 -24px 90px rgba(16, 14, 22, 0.42);
      transform: translateY(100%);
      transition: transform 0.85s cubic-bezier(.16,1,.3,1);
      will-change: transform;
    }
    .vdraw[hidden] { display: none; }
    .vdraw.is-open { transform: translateY(0); }
    .vdraw-scroll { height: 100%; overflow: hidden; }

    /* 40 / 60 — wording left, photo right; both fill the sheet height */
    .vdraw-grid { display: grid; grid-template-columns: 40% 60%; height: 100%; }

    /* LEFT — the ONLY scrolling area (right stays fixed) */
    .vdraw-left {
      height: 100%; overflow-y: auto; overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch; scrollbar-width: none; -ms-overflow-style: none;
      padding: clamp(40px, 4vw, 76px) clamp(34px, 3.4vw, 64px);
    }
    .vdraw-left::-webkit-scrollbar { width: 0; height: 0; display: none; }
    .vmodal-eyebrow { font-family: var(--sans); font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); margin-bottom: 14px; }
    .vmodal-title { font-family: var(--serif); font-weight: 400; font-size: clamp(36px, 3.6vw, 60px); line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 12px; color: var(--ink); }
    .vmodal-lede { font-family: var(--serif); font-style: normal; font-size: 20px; line-height: 1.3; color: var(--english-violet); margin: 0 0 26px; }
    .vmodal-summary { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.65; color: rgba(28,29,34,0.78); margin: 0 0 18px; }
    .vmodal-summary:last-of-type { margin-bottom: 0; }
    /* Section break between the intro and What's Included. */
    .vmodal-divider { height: 1px; background: rgba(28,29,34,0.14); margin: 32px 0; }
    .vmodal-sub { font-family: var(--sans); font-weight: 700; font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); margin: 0 0 18px; }
    .vmodal-included { list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 5px; }
    .vmodal-included li { display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: baseline; font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.45; color: rgba(28,29,34,0.8); }
    .vmodal-included li::before { content: "→"; font-family: var(--serif); font-style: italic; color: var(--english-violet); font-size: 17px; }

    /* Optional extras / add-ons — label + price rows */
    .vmodal-extras { list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 0; }
    .vmodal-extras li { display: flex; justify-content: space-between; align-items: baseline; gap: 16px; padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.1); }
    .vmodal-extras li:last-child { border-bottom: none; }
    .vmodal-extra-label { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.45; color: rgba(28,29,34,0.8); }
    .vmodal-extra-price { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.02em; color: var(--english-violet); white-space: nowrap; }

    .vmodal-price-card { border: 1px solid rgba(28,29,34,0.18); border-radius: 10px; padding: 28px 26px 24px; margin-bottom: 40px; }
    .vmodal-sub--card { margin-bottom: 18px; }
    .vmodal-price-tiers { display: grid; gap: 14px; }
    .vmodal-tier { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding-bottom: 14px; border-bottom: 1px solid rgba(28,29,34,0.1); }
    .vmodal-tier:last-child { border-bottom: none; padding-bottom: 0; }
    .vmodal-tier-info { display: flex; flex-direction: column; gap: 4px; }
    .vmodal-tier-label { font-family: var(--serif); font-size: 19px; font-weight: 500; color: var(--ink); }
    .vmodal-tier-sub { font-family: var(--sans); font-size: 12px; line-height: 1.4; color: rgba(28,29,34,0.6); }
    .vmodal-tier-price { font-family: var(--sans); font-size: 12px; letter-spacing: 0.04em; color: rgba(28,29,34,0.55); white-space: nowrap; text-align: right; padding-top: 4px; }
    .vmodal-tier-price b { font-family: var(--serif); font-size: 22px; font-weight: 500; color: var(--ink); display: block; }
    .vmodal-price-prose p { font-family: var(--sans); font-size: 14px; line-height: 1.6; color: rgba(28,29,34,0.74); margin: 0 0 14px; }
    .vmodal-price-prose p:last-child { margin-bottom: 0; }
    .vmodal-price-note { font-family: var(--sans); font-size: 12px; color: var(--english-violet); font-weight: 700; letter-spacing: 0.04em; margin: 16px 0 0; }
    .vmodal-book { width: 100%; justify-content: center; margin-top: 22px; }
    /* Nudged right (indented from the left) so it sits in from the edge and
       reads as secondary to the primary "Book a shoot" button above it. */
    .vmodal-consult { display: block; width: calc(100% - 56px); margin-top: 12px; margin-left: 56px; background: none; border: none; cursor: pointer; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); text-align: center; padding: 4px 0; transition: color .2s; }
    .vmodal-consult strong { color: var(--english-violet); font-weight: 700; }
    .vmodal-consult:hover { color: var(--ink); }
    .vmodal-consult:hover strong { text-decoration: underline; }
    .vmodal-bio { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.65; color: rgba(28,29,34,0.72); margin: 0 0 18px; }
    .vdraw-left :global(.vshow) { padding: 32px 0 0; }
    .vdraw-left :global(.vshow-heading) { font-size: clamp(20px, 2vw, 26px); margin-bottom: 18px; }

    /* RIGHT — sticky image + showcase thumbnails */
    .vdraw-right {
      height: 100%;
      display: flex; flex-direction: column;
      background: #e9e4da;
    }
    .vdraw-stage { position: relative; flex: 1; overflow: hidden; }
    .vdraw-hero-img { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 0; transition: opacity 0.8s ease; }
    .vdraw-hero-img.is-active { opacity: 1; }
    /* Video main media — sits over the image layers; hidden when a thumbnail
       (headshot) image is selected. */
    .vdraw-hero-video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 3; transition: opacity 0.5s ease; }
    .vdraw-stage.show-img .vdraw-hero-video { opacity: 0; visibility: hidden; }
    .vmodal-thumb--video { position: relative; background: #1c1d22; }
    .vmodal-thumb-play { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; color: var(--paper); font-size: 13px; }
    .vmodal-nav { position: absolute; right: 18px; bottom: 18px; z-index: 4; display: flex; align-items: center; gap: 2px; padding: 5px; border-radius: 999px; background: rgba(16,14,22,0.42); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    .vmodal-arrow { width: 34px; height: 34px; border-radius: 50%; border: none; background: transparent; color: var(--paper); font-size: 15px; line-height: 1; cursor: pointer; transition: background 0.2s; }
    .vmodal-arrow:hover { background: rgba(255,255,255,0.2); }
    .vmodal-count { font-family: var(--sans); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; color: var(--paper); padding: 0 8px; min-width: 44px; text-align: center; }
    .vmodal-count b { font-weight: 700; }
    .vmodal-gallery { flex: 0 0 auto; display: flex; gap: 10px; padding: 14px; background: rgba(28,29,34,0.05); overflow-x: auto; scrollbar-width: none; }
    .vmodal-gallery::-webkit-scrollbar { display: none; }
    .vmodal-thumb { flex: 0 0 116px; height: 82px; border-radius: 4px; border: 2px solid transparent; cursor: pointer; background-size: cover; background-position: center; padding: 0; transition: border-color 0.25s, transform 0.25s; }
    /* Headshot galleries: uniform height, width follows each image's own aspect
       (set in JS), so headshots show fully instead of a squashed cover-crop. */
    .vdraw-right[data-media-gallery] .vmodal-gallery .vmodal-thumb { flex: 0 0 auto; width: auto; height: 116px; aspect-ratio: 16 / 9; background-position: center; }
    .vmodal-thumb:hover { transform: translateY(-2px); }
    .vmodal-thumb.is-active { border-color: var(--english-violet); }

    .vmodal-x { position: fixed; top: 48px; right: 48px; z-index: 320; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(240, 238, 235, 0.55); background: rgba(16, 14, 22, 0.35); color: var(--paper); font-size: 30px; line-height: 1; cursor: pointer; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); transition: background 0.25s, transform 0.4s, opacity 0.4s; }
    .vmodal-x[hidden] { display: none; }
    .vmodal-x:hover { background: var(--english-violet); border-color: var(--english-violet); transform: rotate(90deg); }

    @media (max-width: 900px) {
      .vdraw { top: 16px; left: 16px; right: 16px; }
      .vdraw-scroll { overflow-y: auto; }
      .vdraw-grid { grid-template-columns: 1fr; height: auto; }
      .vdraw-left { height: auto; overflow: visible; }
      .vdraw-right { height: 56vh; order: -1; }
      .vmodal-x { top: 28px; right: 24px; }
    }

    /* ===== MOBILE-ONLY (phones ≤600px) — videography deck ===== */
    @media (max-width: 600px) {
      /* Slide 1: drop the static camera still — just the text, the Discover
         button, then it flows into the rising video. */
      .vh-lede-media { display: none; }

      /* Product slides: Book Now + Discover the same size (full-width, stacked). */
      .pf-panel-actions { flex-direction: column; align-items: stretch; gap: 12px; }
      .pf-act-btn { width: 100%; justify-content: center; }

      /* Pop-outs: the single grid column was blowing out to ~915px inside a
         ~358px sheet (min-content overflow), so everything looked zoomed in.
         minmax(0,1fr) + min-width:0 pins the content to the sheet width. */
      .vdraw-grid { grid-template-columns: minmax(0, 1fr); }
      .vdraw-left, .vdraw-right, .vdraw-stage, .vmodal-gallery { min-width: 0; max-width: 100%; }
    }
  </style>

  <!-- Deck controller + partner pricing + showcase pop-ups. Lenis is stopped on
       this page so it doesn't fight the horizontal scroll. -->
  <script>
    import { PRODUCTS, tierPrice, resolvePartnerSlug, getPartner } from "../../data/videography.js";
    import { gbpFromPence } from "../../lib/supabase.js";

    const slug = resolvePartnerSlug();
    const partner = getPartner(slug);

    // --- Partner pricing ---
    (function applyPartnerPricing() {
      PRODUCTS.forEach((p) => {
        p.priceTiers.forEach((t, i) => {
          document.querySelectorAll(`[data-price-svc="${p.slug}"][data-tier="${i}"]`).forEach((el) => {
            el.textContent = gbpFromPence(tierPrice(t, slug));
          });
        });
        const note = document.querySelector(`[data-note-svc="${p.slug}"]`);
        if (note) note.textContent = partner.note;
      });
      if (slug !== "direct") {
        const banner = document.getElementById("vid-partner-banner");
        const text = document.getElementById("vid-partner-text");
        if (banner && text) { text.textContent = `${partner.name} · ${partner.note}`; banner.hidden = false; }
      }
    })();

    // --- Showcase pop-ups ---
    const scrim = document.getElementById("vmodal-scrim");
    const closeX = document.getElementById("vmodal-x");
    let openSlug = null;
    let closeTimer = null;

    function openProduct(s) {
      const draw = document.querySelector(`.vdraw[data-product="${s}"]`);
      if (!draw || !scrim) return;
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      openSlug = s;
      scrim.hidden = false;
      draw.hidden = false;
      if (draw.__resetScroll) draw.__resetScroll();
      document.documentElement.style.overflow = "hidden";
      document.body.classList.add("pf-modal-open");
      if (closeX) closeX.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        scrim.classList.add("is-open");
        draw.classList.add("is-open");
      }));
      draw.__galIdx = 0;
      startRotation(draw); // begin the 5s auto-rotate
      if (location.hash !== `#${s}`) history.replaceState(null, "", `#${s}`);
    }

    function closeProduct() {
      if (!openSlug || !scrim) return;
      const draw = document.querySelector(`.vdraw[data-product="${openSlug}"]`);
      stopRotation();
      scrim.classList.remove("is-open");
      if (draw) draw.classList.remove("is-open");
      if (closeX) closeX.hidden = true;
      document.documentElement.style.overflow = "";
      document.body.classList.remove("pf-modal-open");
      closeTimer = setTimeout(() => { scrim.hidden = true; if (draw) draw.hidden = true; }, 880);
      openSlug = null;
      if (location.hash) history.replaceState(null, "", location.pathname + location.search);
    }

    function bindOpen(el) {
      el.addEventListener("click", (e) => { e.stopPropagation(); openProduct(el.getAttribute("data-open")); });
    }
    document.querySelectorAll("[data-open]").forEach(bindOpen);
    document.querySelectorAll("[data-close]").forEach((btn) => btn.addEventListener("click", closeProduct));
    scrim?.addEventListener("click", closeProduct);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && openSlug) closeProduct(); });

    // Booking from inside a showcase: slide the showcase down and out of the
    // way first, THEN bring the booking flow in on top. Capture phase pre-empts
    // VideographyBooking's own opener (only while a showcase is open) so the two
    // don't stack; when nothing is open, its global opener handles the click.
    document.addEventListener("click", (e) => {
      const btn = e.target.closest && e.target.closest("[data-vbook]");
      if (!btn || !openSlug) return; // only intercept while a showcase is open
      e.preventDefault();
      e.stopImmediatePropagation();
      const key = btn.getAttribute("data-vbook");
      closeProduct();
      setTimeout(() => {
        if (typeof window.tmkeVideographyBook === "function") window.tmkeVideographyBook(key);
      }, 720);
    }, true);

    // --- Top nav: burger opens the shared off-canvas side menu (NavDrawer) ---
    // Wiring lives in that component, keyed off [data-nav-drawer-open].

    // --- Showcase gallery: crossfade hero, auto-rotate, arrows + thumbs ---
    const ROTATE_MS = 5000;
    let galTimer = null;

    function setGalleryIndex(draw, i) {
      const thumbs = draw.querySelectorAll(".vmodal-thumb");
      const n = thumbs.length;
      if (!n) return;
      i = ((i % n) + n) % n;
      const stage = draw.querySelector(".vdraw-stage");
      const thumb = thumbs[i];
      thumbs.forEach((t) => t.classList.remove("is-active"));
      thumb.classList.add("is-active");
      const gal = draw.querySelector(".vmodal-gallery");
      if (gal) {
        gal.scrollTo({ left: thumb.offsetLeft - gal.clientWidth / 2 + thumb.clientWidth / 2, behavior: "smooth" });
      }
      const cur = draw.querySelector(".vmodal-count-cur");
      if (cur) cur.textContent = String(i + 1);
      draw.__galIdx = i;
      // Video thumbs show the film over the stage; image thumbs swap an image in
      // over it (stage.show-img hides the video). Live folders carry a per-thumb
      // video source; a legacy fixed video has none (its <source> is baked in).
      if (thumb.hasAttribute("data-video")) {
        const vsrc = thumb.getAttribute("data-video-src");
        const vid = stage.querySelector(".vdraw-hero-video");
        if (vsrc && vid && vid.getAttribute("data-src") !== vsrc) {
          vid.setAttribute("data-src", vsrc);
          vid.src = vsrc;
          try { vid.load(); const pl = vid.play(); if (pl && pl.catch) pl.catch(() => {}); } catch (_) {}
        }
        stage.classList.remove("show-img");
        return;
      }
      stage.classList.add("show-img");
      const layers = stage.querySelectorAll(".vdraw-hero-img");
      const full = thumb.getAttribute("data-full");
      if (!full || !layers.length) return;
      const active = stage.querySelector(".vdraw-hero-img.is-active") || layers[0];
      const next = active === layers[0] ? layers[1] : layers[0];
      next.style.backgroundImage = `url('${full}')`;
      next.classList.add("is-active");
      active.classList.remove("is-active");
    }

    function stopRotation() { if (galTimer) { clearInterval(galTimer); galTimer = null; } }
    function startRotation(draw) {
      stopRotation();
      if (draw.querySelector(".vdraw-hero-video")) return;   // video products: keep the video, no auto-rotate
      if (draw.querySelectorAll(".vmodal-thumb").length <= 1) return;
      galTimer = setInterval(() => setGalleryIndex(draw, (draw.__galIdx || 0) + 1), ROTATE_MS);
    }

    // Smooth-scroll the LEFT info column from ANYWHERE in the modal (over the
    // text or the image), with a rAF lerp so it matches the site's smooth feel
    // and never depends on what the cursor is hovering.
    document.querySelectorAll(".vdraw").forEach((draw) => {
      const left = draw.querySelector(".vdraw-left");
      if (!left) return;
      let target = 0, current = 0, raf = null;
      const maxScroll = () => Math.max(0, left.scrollHeight - left.clientHeight);
      const tick = () => {
        current += (target - current) * 0.14;
        if (Math.abs(target - current) < 0.4) current = target;
        left.scrollTop = current;
        raf = current !== target ? requestAnimationFrame(tick) : null;
      };
      draw.addEventListener("wheel", (e) => {
        if (window.innerWidth <= 900) return; // mobile: native touch scroll
        e.preventDefault();
        target = Math.max(0, Math.min(maxScroll(), target + e.deltaY));
        if (!raf) raf = requestAnimationFrame(tick);
      }, { passive: false });
      draw.__resetScroll = () => {
        target = 0; current = 0; left.scrollTop = 0;
        if (raf) { cancelAnimationFrame(raf); raf = null; }
      };
    });

    document.querySelectorAll(".vmodal-arrow").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const draw = btn.closest(".vdraw");
        const dir = parseInt(btn.getAttribute("data-dir"), 10) || 1;
        setGalleryIndex(draw, (draw.__galIdx || 0) + dir);
        startRotation(draw); // reset the 5s timer after a manual step
      });
    });
    // Delegated so dynamically-added thumbs (live headshots) work too.
    document.querySelectorAll(".vmodal-gallery").forEach((gal) => {
      gal.addEventListener("click", (e) => {
        const thumb = e.target.closest(".vmodal-thumb");
        if (!thumb) return;
        e.stopPropagation();
        const draw = thumb.closest(".vdraw");
        const thumbs = Array.from(draw.querySelectorAll(".vmodal-thumb"));
        setGalleryIndex(draw, thumbs.indexOf(thumb));
        startRotation(draw);
      });
    });

    // Size each image thumbnail in a hand-ordered media gallery to its own
    // image's aspect (the strip keeps a uniform height; the width follows the
    // image) so photos show fully in either orientation instead of a squashed
    // cover-crop. Video thumbs keep the 16:9 default from CSS.
    (function sizeMediaThumbs() {
      document.querySelectorAll('.vdraw-right[data-media-gallery] .vmodal-thumb[data-full]').forEach((btn) => {
        const src = btn.getAttribute("data-full");
        if (!src) return;
        const im = new Image();
        im.onload = () => { if (im.naturalWidth && im.naturalHeight) btn.style.aspectRatio = im.naturalWidth + " / " + im.naturalHeight; };
        im.src = src;
      });
    })();

    // --- Horizontal deck controller ---------------------------------------
    // Play the first-slide entrance once we're on the page (after it loads in),
    // not while it's still loading — so the animation isn't missed.
    if (window.__lenis && typeof window.__lenis.destroy === "function") {
      try { window.__lenis.destroy(); } catch (e) {}
    }
    (function deck() {
      const stage = document.getElementById("pf-deck");
      if (!stage) return;
      const panels = [...stage.querySelectorAll(".pf-panel")];
      const curEl = document.getElementById("pf-cur");
      const topBar = document.querySelector(".pf-top");   // nav: white on the dark hero, burgundy elsewhere
      const pad = (n) => String(n + 1).padStart(2, "0");
      const last = panels.length - 1;
      // Every slide enters from the right and covers the previous one (the deck
      // "slides across"), mirroring the Social Media cover engine.
      const ENTRY = panels.map((_, i) => (i === 0 ? [0, 0] : [1, 0]));
      panels.forEach((p, i) => { p.style.zIndex = String(i); });

      // Final-panel newsletter reveal (slides the track to push a card off-screen).
      const finalPanel = document.getElementById("pf-final");
      const finalTrack = document.getElementById("pf-final-track");
      const revealTab = document.getElementById("pf-reveal-tab");
      const newsEl = finalPanel ? finalPanel.querySelector(".pf-news") : null;
      let revealed = false;
      const revealAmt = () => (finalTrack ? Math.max(0, finalTrack.scrollWidth - finalPanel.clientWidth) : 0);
      // Phones step through the final panel one column at a time (card 1 → 2 → 3
      // → newsletter) instead of jumping straight to the newsletter.
      const isPhone = () => window.innerWidth <= 600;
      const finalItems = () => (finalTrack ? finalTrack.children.length : 1);
      let finalStep = 0;
      function setFinalStep(n) {
        if (!finalTrack) return;
        n = Math.max(0, Math.min(finalItems() - 1, n));
        finalStep = n;
        finalTrack.style.transform = `translateX(-${n * finalPanel.clientWidth}px)`;
        revealed = n >= finalItems() - 1;
        finalPanel.classList.toggle("is-revealed", revealed);
        if (revealTab) revealTab.style.right = (revealed && newsEl) ? newsEl.offsetWidth + "px" : "0px";
      }
      function setReveal(on) {
        if (!finalTrack) return;
        if (isPhone()) { setFinalStep(on ? finalItems() - 1 : 0); return; }
        revealed = on;
        finalTrack.style.transform = on ? `translateX(-${revealAmt()}px)` : "translateX(0)";
        if (revealTab) revealTab.style.right = on && newsEl ? newsEl.offsetWidth + "px" : "0px";
        finalPanel.classList.toggle("is-revealed", on);
      }

      // ---- Floaty cover engine (ported from the Social Media deck) ----
      const SENS = 0.001;     // wheel → progress (slow, ~one slide per scroll)
      const EASE = 0.055;     // lerp toward target (lower = floatier)
      const SLOW_EASE = 0.03; // slower glide for the final couple of slides
      const THRESH = 3;       // slides 1–4 float freely; the last two snap + settle
      const PAUSE = 800;      // ms hold after a snap so it settles before the next
      let acc = 0, display = 0, lastCur = -1, anchor = THRESH, lockUntil = 0;
      const clamp = (v) => Math.max(0, Math.min(last, v));

      // Slide-1 long video: heroP (target, 0→1) eases to heroDisp; the video's
      // inset grows from the rest box (inset like the About photos) to full-bleed,
      // so on scroll it rises up over the header into a full-page video. Only once
      // heroP hits 1 does a further scroll advance the deck (see the wheel handler).
      const HEROSENS = 0.0012, HERO_HOLD = 1200;   // ms dwell once the video is full-page
      let heroP = 0, heroDisp = 0, heroApplied = -1, heroHold = 0;
      const heroPanel = stage.querySelector(".vh");
      const heroHeader = heroPanel && heroPanel.querySelector(".vh-header");
      const heroWrap = heroPanel && heroPanel.querySelector(".vh-wrap");
      const heroPic = heroPanel && heroPanel.querySelector(".vh-pic");
      const heroMedia = heroPic && heroPic.querySelector("video, img");
      let heroGeo = null;
      const measureHero = () => {
        if (!heroPanel) return;
        const pr = heroPanel.getBoundingClientRect();
        const wr = heroWrap.getBoundingClientRect();
        heroGeo = { hH: heroHeader.offsetHeight, gx: wr.left - pr.left, rgx: pr.right - wr.right };
      };
      const applyHero = (p) => {
        if (!heroPic) return;
        if (!heroGeo) measureHero();
        const g = heroGeo, q = 1 - p;
        heroPic.style.top = (g.hH * q).toFixed(1) + "px";
        heroPic.style.left = (g.gx * q).toFixed(1) + "px";
        heroPic.style.right = (g.rgx * q).toFixed(1) + "px";
        heroPic.style.bottom = "0px";
        heroPic.style.borderRadius = (2 * q).toFixed(1) + "px";
        if (heroMedia) heroMedia.style.objectPosition = "center " + (p * 100).toFixed(1) + "%";
      };
      measureHero(); applyHero(0);
      window.addEventListener("resize", () => { measureHero(); applyHero(heroDisp); });
      window.addEventListener("load", () => { measureHero(); applyHero(heroDisp); });
      const targetOf = (now) => {
        if (acc < THRESH + 0.5) { anchor = THRESH; return Math.min(acc, THRESH); }
        if (anchor < THRESH + 1) { anchor = THRESH + 1; lockUntil = now + PAUSE; return anchor; }
        if (now >= lockUntil) {
          if (acc > anchor + 0.5 && anchor < last) { anchor += 1; lockUntil = now + PAUSE; }
          else if (acc < anchor - 0.5 && anchor > THRESH + 1) { anchor -= 1; lockUntil = now + PAUSE; }
        }
        return anchor;
      };

      const render = () => {
        for (let i = 0; i < panels.length; i++) {
          const f = Math.max(0, Math.min(1, i - display));   // 1 = off (entry edge) · 0 = covering
          const e = ENTRY[i] || [0, 0];
          panels[i].style.transform = `translate(${(e[0] * f * 100).toFixed(3)}%, ${(e[1] * f * 100).toFixed(3)}%)`;
        }
        const cur = clamp(Math.round(display));
        if (cur !== lastCur) {
          lastCur = cur;
          panels.forEach((p, i) => p.classList.toggle("is-in", i === cur));
          if (curEl) curEl.textContent = pad(cur);
          if (topBar) topBar.classList.toggle("on-dark", false);   // slide 1 is now light (About-style) — nav stays ink
          if (cur !== last && (revealed || (isPhone() && finalStep !== 0))) setReveal(false);
        }
      };
      const tick = () => {
        acc = Math.max(display - 1, Math.min(display + 1, acc));   // never flick PAST a slide
        const t = targetOf(performance.now());
        const ease = t >= last - 1 ? SLOW_EASE : EASE;            // last two glide slower
        display += (t - display) * ease;
        if (Math.abs(t - display) < 0.0004) display = t;
        heroDisp += (heroP - heroDisp) * 0.16;
        if (Math.abs(heroP - heroDisp) < 0.0008) heroDisp = heroP;
        if (heroDisp !== heroApplied) { applyHero(heroDisp); heroApplied = heroDisp; }
        render();
        requestAnimationFrame(tick);
      };
      render(); requestAnimationFrame(tick);

      // On the final slide, scrolling forward reveals the newsletter (back hides it).
      const atLast = () => display > last - 0.05;

      stage.addEventListener("wheel", (ev) => {
        if (openSlug) return;                       // a showcase pop-up is open
        ev.preventDefault();
        const d = Math.abs(ev.deltaY) >= Math.abs(ev.deltaX) ? ev.deltaY : ev.deltaX;
        // Slide 1: scroll first raises the long video to a full-page video; only
        // once it's full does a further scroll advance the deck across.
        if (display < 0.5) {
          if (d > 0 && heroP < 1) {
            heroP = Math.max(0, Math.min(1, heroP + d * HEROSENS));
            if (heroP >= 1) heroHold = performance.now() + HERO_HOLD;   // just landed full → start the dwell
            return;
          }
          if (d < 0 && heroP > 0) { heroP = Math.max(0, Math.min(1, heroP + d * HEROSENS)); return; }
          // Full-page video — hold a beat before a forward scroll advances, so the
          // viewer registers it's a video and can choose to watch it.
          if (d > 0 && performance.now() < heroHold) return;
        }
        if (atLast() && d > 0) { if (!revealed) setReveal(true); return; }
        if (atLast() && revealed && d < 0) { setReveal(false); return; }
        acc = clamp(acc + d * SENS);
      }, { passive: false });

      window.addEventListener("keydown", (ev) => {
        if (openSlug) return;
        if (["ArrowRight", "ArrowDown", "PageDown"].includes(ev.key)) {
          ev.preventDefault();
          if (atLast()) { if (!revealed) setReveal(true); return; }
          acc = clamp(Math.round(acc) + 1);
        } else if (["ArrowLeft", "ArrowUp", "PageUp"].includes(ev.key)) {
          ev.preventDefault();
          if (atLast() && revealed) { setReveal(false); return; }
          acc = clamp(Math.round(acc) - 1);
        }
      });

      // touch — drag continuously (swipe left/up advances)
      let tx = 0, ty = 0, tp = 0, thp = 0, finalStepped = false;
      stage.addEventListener("touchstart", (ev) => {
        const t = ev.touches[0]; tx = t.clientX; ty = t.clientY; tp = acc; thp = heroP; finalStepped = false;
      }, { passive: true });
      stage.addEventListener("touchmove", (ev) => {
        if (openSlug) return;
        const t = ev.touches[0]; const dx = t.clientX - tx, dy = t.clientY - ty;
        const dom = Math.abs(dx) > Math.abs(dy) ? dx : dy;
        // Slide 1: a drag raises the long video to full-page first (then advance).
        if (display < 0.5) {
          const np = Math.max(0, Math.min(1, thp - dom * 0.0024));
          if (np >= 1 && heroP < 1) heroHold = performance.now() + HERO_HOLD;   // just landed full → start the dwell
          heroP = np;
          if (np >= 1 && dom < 0 && performance.now() >= heroHold) acc = clamp(Math.round(display) + 1);
          return;
        }
        // Phones: on the final panel, step one column per swipe (card → card →
        // newsletter) rather than jumping straight to the newsletter.
        if (isPhone() && atLast()) {
          if (dom < -24) {   // swipe left → next column
            if (!finalStepped && finalStep < finalItems() - 1) { finalStepped = true; setFinalStep(finalStep + 1); }
            return;
          }
          if (dom > 24 && finalStep > 0) {   // swipe right → previous column
            if (!finalStepped) { finalStepped = true; setFinalStep(finalStep - 1); }
            return;
          }
          // at column 0 swiping right → fall through to move the deck back a slide
        }
        if (atLast() && dom < -24) { if (!revealed) setReveal(true); return; }
        if (atLast() && revealed && dom > 24) { setReveal(false); return; }
        acc = clamp(tp - dom * 0.004);
      }, { passive: true });

      // Clickable "Scroll" / "Our services" hints → advance one panel.
      stage.querySelectorAll("[data-deck-next]").forEach((el) => {
        el.addEventListener("click", (e) => {
          e.preventDefault(); e.stopPropagation();
          acc = clamp(Math.round(acc) + 1);
        });
      });

      if (revealTab) revealTab.addEventListener("click", (e) => { e.stopPropagation(); setReveal(!revealed); });
      window.addEventListener("resize", () => { if (revealed) setReveal(true); });
    })();

    // Newsletter footer form (UI only, matches the site's other sign-up forms).
    (function newsForm() {
      const form = document.getElementById("pf-news-form");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const email = form.querySelector('input[type="email"]');
        if (!email || !email.value) return;
        const btn = form.querySelector(".pf-news-send");
        const original = btn.innerHTML;
        btn.textContent = "You're in ✓";
        setTimeout(() => { btn.innerHTML = original; form.reset(); }, 2400);
      });
    })();

    // --- Deep link (open a showcase from #slug) ---
    (function openFromHash() {
      const h = (location.hash || "").replace("#", "");
      if (h && PRODUCTS.some((p) => p.slug === h)) openProduct(h);
    })();
  </script>
</BaseLayout>
