      .sms-swipe { margin: 22px 0 0; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
      .sms-tiers { display: flex; flex-direction: column; margin-top: 4px; }
      .sms-tier { display: grid; grid-template-columns: auto 1fr auto; gap: 12px; align-items: start; width: 100%; padding: 14px 0; background: none; border: 0; border-bottom: 1px solid rgba(28,29,34,0.1); text-align: left; cursor: pointer; font-family: var(--sans); }
      .sms-tier:last-child { border-bottom: 0; }
      .sms-tier-num { font-size: 11px; font-weight: 700; letter-spacing: 0.12em; color: var(--english-violet); padding-top: 3px; }
      .sms-tier-body { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
      .sms-tier-name { font-family: var(--serif); font-weight: 500; font-size: 18px; color: var(--ink); }
      .sms-tier-sub { font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet); }
