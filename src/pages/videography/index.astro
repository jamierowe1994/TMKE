      /* Product slides: Book Now + Discover the same size (full-width, stacked). */
      .pf-panel-actions { flex-direction: column; align-items: stretch; gap: 12px; }
      .pf-act-btn { width: 100%; justify-content: center; }

      /* Pop-outs: the single grid column was blowing out to ~915px inside a
         ~358px sheet (min-content overflow), so everything looked zoomed in.
