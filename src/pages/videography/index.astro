    .vmodal-sound.is-on .vs-waves { display: block; }
    .vmodal-sound.is-on .vs-mute { display: none; }
    .vdraw-stage.show-img .vmodal-sound { opacity: 0; pointer-events: none; }
    .vmodal-arrow { width: 34px; height: 34px; border-radius: 50%; border: none; background: transparent; color: var(--paper); font-size: 15px; line-height: 1; cursor: pointer; transition: background 0.2s; }
    .vmodal-arrow:hover { background: rgba(255,255,255,0.2); }
    .vmodal-count { font-family: var(--sans); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; color: var(--paper); padding: 0 8px; min-width: 44px; text-align: center; }
    .vmodal-count b { font-weight: 700; }
    .vmodal-gallery { flex: 0 0 auto; display: flex; gap: 10px; padding: 14px; background: rgba(28,29,34,0.05); overflow-x: auto; scrollbar-width: none; }
    .vmodal-gallery::-webkit-scrollbar { display: none; }
    .vmodal-thumb { flex: 0 0 116px; height: 82px; border-radius: 4px; border: 2px solid transparent; cursor: pointer; background-size: cover; background-position: center; padding: 0; transition: border-color 0.25s, transform 0.25s; }
    /* Headshot galleries: uniform height, width follows each image's own aspect
       (set in JS), so headshots show fully instead of a squashed cover-crop. */
    .vdraw-right[data-media-gallery] .vmodal-gallery .vmodal-thumb { flex: 0 0 auto; width: auto; height: 116px; aspect-ratio: 16 / 9; background-position: center; }
    .vmodal-thumb:hover { transform: translateY(-2px); }
