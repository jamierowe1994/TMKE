      .vh-lede-media { display: none; }

      /* Slide 1: no slow video rise on phones — the video sits as a static
         framed block under the lede (autoplaying), and a swipe advances
         straight to slide 2. The JS rise mechanic is bypassed on phones so no
         inline geometry fights this layout. */
      .pf-panel.vh { display: flex; flex-direction: column; }
      .vh-header { padding: 84px 24px 18px; }
