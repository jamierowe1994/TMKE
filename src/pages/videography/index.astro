---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiscoveryPanel from "../../components/DiscoveryPanel.astro";
import VideoShowcase from "../../components/VideoShowcase.astro";
import { PRODUCTS, tierPrice } from "../../data/videography.js";
import { gbpFromPence } from "../../lib/supabase.js";

const pad2 = (n) => String(n + 1).padStart(2, "0");
---

<BaseLayout
  title="Videography — TMKE"
  description="In-house property videography — podcast studio, personal branded content, property tours, photography and headshots. Produced, edited and delivered by TMKE."
>
  <!-- ============ HERO (framed showpiece — house breaks out of the window) ============ -->
  <section class="vid-hero">
    <div class="vid-hero-card">
      <div class="vid-hero-scene"></div>
      <div class="vid-hero-textbox">
        <div class="vid-hero-top">
          <div class="vid-hero-kicker">— In-house film team</div>
          <div class="vid-hero-word">Videography</div>
        </div>
        <div class="vid-hero-bottom">
          <h1 class="vid-hero-headline">Property,<br /><em>in&nbsp;motion.</em></h1>
          <a href="#flow" class="btn btn--solid vid-hero-btn">Explore the work <span class="btn-arrow">&rarr;</span></a>
        </div>
      </div>
      <div class="vid-hero-window" aria-hidden="true"></div>
      <img class="vid-hero-cut" src="/assets/house-own.png" alt="" aria-hidden="true" />
    </div>
  </section>

  <!-- ============ PARTNER BANNER ============ -->
  <div class="vid-partner-banner wrap" id="vid-partner-banner" hidden>
    <span id="vid-partner-text"></span>
  </div>

  <!-- ============ INTRO (oversized statement) ============ -->
  <section class="vid-intro" id="flow">
    <div class="vid-intro-inner">
      <div class="chapter">In-house. End to end.</div>
      <p class="vid-intro-lede">
        Jack and the team shoot, edit and deliver everything under one roof —
        <em>consistent, on-brand, and handled.</em>
      </p>
    </div>
    <div class="vid-marquee" aria-hidden="true">
      <div class="vid-marquee-track">
        {[...PRODUCTS, ...PRODUCTS].map((p) => (
          <span class="vid-marquee-item">{p.name} <span class="vid-marquee-dot">&bull;</span></span>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ BREAK-THE-BOX BANDS ============ -->
  {PRODUCTS.map((p, i) => (
    <section
      class={`vband ${i % 2 === 0 ? "is-immersive" : "is-offset"} ${i % 4 >= 2 ? "flip" : ""}`}
      data-reveal
    >
      <div class="vband-frame" data-open={p.slug} role="button" tabindex="0" aria-label={`Explore ${p.name}`}>
        <span class="vband-img" style={`background-image:url('${p.hero}')`}></span>
        {i % 2 === 0 && <span class="vband-ghost" aria-hidden="true">{pad2(i)}</span>}
        {i % 2 === 0 && (
          <div class={`vband-content${p.slug === "studio" ? " vband-content--glass" : ""}`}>
            <div class="vband-kicker">Videography — {pad2(i)}</div>
            <h2 class="vband-name">{p.name}</h2>
            <p class="vband-tag">{p.tagline}</p>
            <div class="vband-foot">
              <span class="vband-price">from <strong data-price-svc={p.slug} data-tier="0">{gbpFromPence(tierPrice(p.priceTiers[0], "direct"))}</strong></span>
              <button type="button" class="btn btn--solid vband-btn" data-open={p.slug}>Explore <span class="btn-arrow">&rarr;</span></button>
            </div>
          </div>
        )}
      </div>
      {i % 2 !== 0 && (
        <div class="vband-content">
          <span class="vband-ghost" aria-hidden="true">{pad2(i)}</span>
          <div class="vband-kicker">Videography — {pad2(i)}</div>
          <h2 class="vband-name">{p.name}</h2>
          <p class="vband-tag">{p.tagline}</p>
          <p class="vband-sum">{p.summary}</p>
          <div class="vband-foot">
            <span class="vband-price">from <strong data-price-svc={p.slug} data-tier="0">{gbpFromPence(tierPrice(p.priceTiers[0], "direct"))}</strong></span>
            <button type="button" class="btn btn--solid vband-btn" data-open={p.slug}>Explore <span class="btn-arrow">&rarr;</span></button>
          </div>
        </div>
      )}
    </section>
  ))}

  <!-- ============ CTA ============ -->
  <section class="vid-cta">
    <div class="vid-cta-inner">
      <h2 class="vid-cta-title">Let's make something<em>.</em></h2>
      <p class="vid-cta-sub">Tell us what you're shooting and we'll put a plan together.</p>
      <button type="button" data-discovery-call class="btn btn--solid">Book a call <span class="btn-arrow">&rarr;</span></button>
    </div>
  </section>

  <!-- ============ DIRECTIONAL MODAL DRAWERS ============ -->
  <div class="vmodal-scrim" id="vmodal-scrim" hidden></div>
  <button type="button" class="vmodal-x" id="vmodal-x" data-close aria-label="Close" hidden>&times;</button>
  {PRODUCTS.map((p) => (
    <section
      class={`vdraw vdraw--from-${p.modal.from} vdraw--${p.modal.size}`}
      data-product={p.slug}
      data-from={p.modal.from}
      role="dialog"
      aria-modal="true"
      aria-label={p.name}
      hidden
    >
      <div class="vdraw-scroll">
        <div class="vdraw-hero">
          <div class="vdraw-hero-img" id={`hero-${p.slug}`} style={`background-image:url('${p.hero}')`}></div>
          <div class="vdraw-hero-cap">
            <div class="vmodal-eyebrow">Videography</div>
            <h2 class="vmodal-title">{p.name}</h2>
            <p class="vmodal-tagline">{p.tagline}</p>
          </div>
        </div>

        {p.gallery && p.gallery.length > 0 && (
          <div class="vmodal-gallery" data-hero-target={`hero-${p.slug}`}>
            {p.gallery.map((src, i) => (
              <button type="button" class={`vmodal-thumb ${i === 0 ? "is-active" : ""}`} data-full={src} style={`background-image:url('${src}')`} aria-label={`View photo ${i + 1}`}></button>
            ))}
          </div>
        )}

        <div class="vmodal-body">
          <div class="vmodal-main">
            <p class="vmodal-summary">{p.summary}</p>
            <h3 class="vmodal-sub">What's included</h3>
            <ul class="vmodal-included">
              {p.included.map((d) => <li>{d}</li>)}
            </ul>
          </div>
          <aside class="vmodal-aside">
            <div class="vmodal-price-card">
              <div class="vmodal-price-tiers">
                {p.priceTiers.map((t, i) => (
                  <div class="vmodal-tier">
                    <span class="vmodal-tier-label">{t.label}</span>
                    <span class="vmodal-tier-price" data-price-svc={p.slug} data-tier={i}>{gbpFromPence(tierPrice(t, "direct"))}</span>
                  </div>
                ))}
              </div>
              <div class="vmodal-price-note" data-note-svc={p.slug}>Standard rates</div>
              <button type="button" data-discovery-call class="btn btn--solid vmodal-book">
                {p.bookable ? "Book this" : "Enquire about availability"} <span class="btn-arrow">&rarr;</span>
              </button>
              <p class="vmodal-fine">Final quote confirmed after a quick call — travel &amp; extras itemised separately.</p>
            </div>
          </aside>
        </div>

        <VideoShowcase heading="Recent work" items={p.showcase || []} />
      </div>
    </section>
  ))}

  <DiscoveryPanel />

  <style>
    /* ===================== HERO (framed showpiece) ===================== */
    /* Outer = scene image, near full-screen with a small margin + slight radius.
       A paper text box sits left; a bordered "window" sits right; the house
       cut-out breaks out of that window — partly inside, partly outside. */
    .vid-hero { padding: clamp(92px, 12vh, 150px) clamp(14px, 2.4vw, 30px) clamp(28px, 5vh, 56px); }
    .vid-hero-card {
      --hr: 18px; position: relative; max-width: 1640px; margin: 0 auto;
      height: min(82vh, 780px); border-radius: var(--hr); overflow: hidden;
      border: 1px solid rgba(28,29,34,0.12); box-shadow: 0 30px 90px rgba(16,14,22,0.18);
    }
    .vid-hero-scene { position: absolute; inset: 0; background: url("/assets/house-water.png") center/cover no-repeat; }
    .vid-hero-scene::after { content: ""; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(12,11,10,0.28), transparent 55%); }

    /* Left: solid paper text box */
    .vid-hero-textbox {
      position: absolute; z-index: 2; left: clamp(14px, 1.8vw, 30px);
      top: clamp(14px, 1.8vw, 30px); bottom: clamp(14px, 1.8vw, 30px);
      width: clamp(280px, 49%, 780px); background: var(--paper);
      border-radius: calc(var(--hr) - 4px); padding: clamp(30px, 3.4vw, 58px);
      display: flex; flex-direction: column; justify-content: space-between;
    }
    .vid-hero-kicker { font-family: var(--sans); font-size: 13px; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); margin-bottom: 12px; }
    .vid-hero-word { font-family: var(--serif); font-weight: 400; font-style: italic; font-size: clamp(28px, 3.4vw, 52px); line-height: 1; color: var(--ink); }
    .vid-hero-headline { font-family: var(--serif); font-weight: 400; font-size: clamp(48px, 7vw, 108px); line-height: 0.94; letter-spacing: -0.025em; margin: 0 0 28px; color: var(--ink); }
    .vid-hero-headline em { font-style: italic; color: var(--english-violet); }
    .vid-hero-bottom { display: flex; flex-direction: column; align-items: flex-start; }
    .vid-hero-btn { align-self: flex-start; }

    /* Right: bordered "window" onto the scene */
    .vid-hero-window {
      position: absolute; z-index: 3; right: clamp(14px, 1.8vw, 30px);
      top: clamp(36px, 5vw, 76px); bottom: clamp(36px, 5vw, 76px);
      width: clamp(220px, 39%, 600px);
      border: 2px solid rgba(255,255,255,0.85); border-radius: calc(var(--hr) - 4px);
      pointer-events: none;
    }
    /* The house — sized/placed (via measured PNG alpha bounds: cabin lives at
       43–65% x, 25–68% y) so its peak rises above the window's top edge and its
       left side crosses the window's left border: partly in, partly out. */
    .vid-hero-cut {
      position: absolute; z-index: 4; left: -15%; top: -42%; right: auto; bottom: auto;
      width: 144%; height: auto; pointer-events: none;
      filter: drop-shadow(0 34px 50px rgba(0,0,0,0.55));
    }

    /* ===================== PARTNER BANNER ===================== */
    .vid-partner-banner { max-width: 1280px; margin: 0 auto; padding: 22px 36px 0; }
    .vid-partner-banner[hidden] { display: none; }
    #vid-partner-text { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border-radius: 999px; background: rgba(71, 66, 84, 0.1); color: var(--english-violet); font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }

    /* ===================== INTRO + MARQUEE ===================== */
    .vid-intro { padding: 130px 0 40px; }
    .vid-intro-inner { max-width: 1280px; margin: 0 auto; padding: 0 36px; }
    .vid-intro .chapter { margin-bottom: 36px; }
    .vid-intro-lede { font-family: var(--serif); font-weight: 400; font-size: clamp(30px, 4.6vw, 72px); line-height: 1.2; letter-spacing: -0.018em; color: var(--ink); max-width: 20ch; margin: 0; }
    .vid-intro-lede em { font-style: italic; color: var(--english-violet); }
    .vid-marquee { margin-top: 64px; overflow: hidden; border-top: 1px solid rgba(28,29,34,0.14); border-bottom: 1px solid rgba(28,29,34,0.14); padding: 22px 0; mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent); -webkit-mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent); }
    .vid-marquee-track { display: flex; gap: 40px; width: max-content; animation: vmarquee 30s linear infinite; }
    .vid-marquee-item { font-family: var(--serif); font-style: italic; font-size: clamp(26px, 3vw, 44px); color: rgba(28,29,34,0.32); letter-spacing: -0.01em; white-space: nowrap; display: inline-flex; gap: 40px; align-items: center; }
    .vid-marquee-dot { color: var(--english-violet); font-style: normal; }
    @keyframes vmarquee { from { transform: translateX(0); } to { transform: translateX(-50%); } }

    /* ===================== FRAMED BANDS ===================== */
    [data-reveal] { opacity: 0; transform: translateY(48px); transition: opacity 1s cubic-bezier(.16,1,.3,1), transform 1s cubic-bezier(.16,1,.3,1); }
    [data-reveal].is-in { opacity: 1; transform: none; }

    /* Each band is inset from the screen edges and spaced from its neighbours */
    .vband { --vr: 8px; position: relative; max-width: 1340px; margin: 44px auto; padding: 0 28px; }
    .vband-frame { position: relative; overflow: hidden; border-radius: var(--vr); cursor: pointer; }
    .vband-frame:focus-visible { outline: 3px solid var(--english-violet); outline-offset: 3px; }
    .vband-img { position: absolute; inset: -3%; background-size: cover; background-position: center; transition: transform 1.1s cubic-bezier(.16,1,.3,1); }
    .vband-ghost { font-family: var(--serif); font-weight: 400; line-height: 0.8; pointer-events: none; }
    .vband-kicker { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.28em; text-transform: uppercase; }
    .vband-name { font-family: var(--serif); font-weight: 400; letter-spacing: -0.022em; margin: 0; }
    .vband-tag { font-family: var(--serif); font-style: italic; }
    .vband-sum { font-family: var(--sans); line-height: 1.7; }
    .vband-foot { display: flex; align-items: center; gap: 24px; flex-wrap: wrap; }
    .vband-price { font-family: var(--sans); font-size: 13px; letter-spacing: 0.04em; }
    .vband-price strong { font-family: var(--serif); font-size: 26px; font-weight: 500; }

    /* ---- IMMERSIVE: framed image, text overlaid ---- */
    .vband.is-immersive .vband-frame { height: 80vh; min-height: 560px; border: 1px solid rgba(240,238,235,0.22); }
    .vband.is-immersive .vband-frame::after { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(12,11,10,0.12) 30%, rgba(12,11,10,0.45) 62%, rgba(12,11,10,0.85) 100%); pointer-events: none; }
    .vband.is-immersive:hover .vband-img { transform: scale(1.045); }
    .vband.is-immersive .vband-ghost { position: absolute; top: 6%; right: 5%; z-index: 2; font-size: clamp(140px, 22vw, 360px); color: rgba(240,238,235,0.09); }
    .vband.is-immersive .vband-content { position: absolute; z-index: 3; left: 0; right: 0; bottom: 0; padding: 0 clamp(28px, 4vw, 56px) clamp(34px, 5vw, 60px); color: var(--paper); }
    .vband.is-immersive .vband-kicker { color: rgba(240,238,235,0.8); margin-bottom: 16px; }
    .vband.is-immersive .vband-name { font-size: clamp(44px, 7vw, 116px); line-height: 0.98; color: var(--paper); margin-bottom: 14px; }
    .vband.is-immersive .vband-tag { font-size: clamp(19px, 2.2vw, 32px); color: rgba(240,238,235,0.92); margin: 0 0 18px; max-width: 26ch; }
    .vband.is-immersive .vband-price { color: rgba(240,238,235,0.85); }
    .vband.is-immersive .vband-price strong { color: var(--paper); }

    /* ---- GLASS panel (Studio) — bends the background, doesn't reflect ---- */
    .vband.is-immersive .vband-content--glass {
      left: clamp(28px, 4vw, 56px); right: auto; bottom: clamp(34px, 5vw, 60px);
      max-width: min(540px, 84%); padding: 34px 38px;
      background: rgba(255, 255, 255, 0.10);
      -webkit-backdrop-filter: blur(22px) saturate(180%) brightness(1.08);
      backdrop-filter: blur(22px) saturate(180%) brightness(1.08);
      border: 1px solid rgba(255, 255, 255, 0.30);
      border-radius: var(--vr);
      box-shadow: inset 0 1px 1px rgba(255,255,255,0.55), inset 0 -10px 24px rgba(255,255,255,0.05), 0 30px 70px rgba(0,0,0,0.4);
    }

    /* ---- OFFSET: framed image + bordered text panel, clear gap ---- */
    .vband.is-offset { display: grid; grid-template-columns: 1.04fr 0.96fr; gap: clamp(28px, 4vw, 64px); align-items: center; }
    .vband.is-offset .vband-frame { min-height: 60vh; border: 1px solid rgba(28,29,34,0.16); }
    .vband.is-offset:hover .vband-img { transform: scale(1.04); }
    .vband.is-offset .vband-content { position: relative; padding-left: clamp(10px, 2.4vw, 44px); }
    .vband.is-offset .vband-ghost { position: absolute; top: -0.42em; left: -6px; z-index: 0; font-size: clamp(110px, 14vw, 220px); color: rgba(71,66,84,0.08); }
    .vband.is-offset .vband-kicker { color: var(--english-violet); margin-bottom: 16px; position: relative; }
    .vband.is-offset .vband-name { font-size: clamp(36px, 4.6vw, 72px); line-height: 1.02; color: var(--ink); margin-bottom: 16px; position: relative; }
    .vband.is-offset .vband-tag { font-size: clamp(18px, 2vw, 27px); color: var(--english-violet); margin: 0 0 22px; position: relative; }
    .vband.is-offset .vband-sum { font-size: 16px; color: rgba(28,29,34,0.7); margin: 0 0 30px; max-width: 46ch; position: relative; }
    .vband.is-offset .vband-price { color: rgba(28,29,34,0.6); }
    .vband.is-offset .vband-price strong { color: var(--ink); }
    /* Flip: image on the right, text panel on the left */
    .vband.is-offset.flip .vband-frame { order: 2; }
    .vband.is-offset.flip .vband-content { order: 1; padding-left: 0; padding-right: clamp(10px, 2.4vw, 44px); }
    .vband.is-offset.flip .vband-ghost { left: auto; right: -6px; }

    /* ===================== CTA ===================== */
    .vid-cta { padding: 130px 36px 200px; text-align: center; }
    .vid-cta-inner { max-width: 1280px; margin: 0 auto; }
    .vid-cta-title { font-family: var(--serif); font-weight: 400; font-size: clamp(44px, 6vw, 96px); letter-spacing: -0.02em; color: var(--ink); margin: 0 0 16px; }
    .vid-cta-title em { font-style: italic; color: var(--english-violet); }
    .vid-cta-sub { font-family: var(--serif); font-style: italic; font-size: clamp(18px, 1.8vw, 24px); color: rgba(28,29,34,0.65); margin: 0 0 32px; }

    @media (max-width: 900px) {
      .vband { padding: 0 18px; margin: 28px auto; }
      .vband.is-offset { grid-template-columns: 1fr; gap: 0; }
      .vband.is-offset .vband-frame { min-height: 52vh; }
      .vband.is-offset .vband-content,
      .vband.is-offset.flip .vband-content { order: 2; padding: 28px 6px 0; }
      .vband.is-immersive .vband-frame { height: 74vh; }
      .vband.is-immersive .vband-content { padding: 0 24px 36px; }
      .vband.is-immersive .vband-content--glass { left: 18px; right: 18px; max-width: none; }
    }

    /* ===================== Scrim + directional drawers ===================== */
    .vmodal-scrim { position: fixed; inset: 0; z-index: 290; background: rgba(16, 14, 22, 0.62); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); opacity: 0; transition: opacity 0.6s ease; }
    .vmodal-scrim[hidden] { display: none; }
    .vmodal-scrim.is-open { opacity: 1; }

    .vdraw { position: fixed; z-index: 300; background: var(--paper); overflow: hidden; box-shadow: 0 40px 140px rgba(16, 14, 22, 0.55); transition: transform 0.85s cubic-bezier(.16,1,.3,1), opacity 0.6s ease; will-change: transform; }
    .vdraw[hidden] { display: none; }
    .vdraw-scroll { height: 100%; overflow-y: auto; -webkit-overflow-scrolling: touch; scrollbar-width: none; -ms-overflow-style: none; }
    .vdraw-scroll::-webkit-scrollbar { width: 0; height: 0; display: none; }

    .vdraw--three-quarter { top: 0; height: 100vh; width: min(82vw, 1320px); }
    .vdraw--tall { left: 0; width: 100vw; height: 92vh; border-radius: 14px 14px 0 0; }
    .vdraw--from-left { left: 0; transform: translateX(-102%); }
    .vdraw--from-left.is-open { transform: translateX(0); }
    .vdraw--from-right { right: 0; transform: translateX(102%); }
    .vdraw--from-right.is-open { transform: translateX(0); }
    .vdraw--from-bottom { bottom: 0; transform: translateY(102%); }
    .vdraw--from-bottom.is-open { transform: translateY(0); }

    .vmodal-x { position: fixed; top: 26px; z-index: 320; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(240, 238, 235, 0.55); background: rgba(16, 14, 22, 0.3); color: var(--paper); font-size: 30px; line-height: 1; cursor: pointer; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); transition: background 0.25s, transform 0.4s, opacity 0.4s; }
    .vmodal-x[hidden] { display: none; }
    .vmodal-x:hover { background: var(--english-violet); border-color: var(--english-violet); transform: rotate(90deg); }
    .vmodal-x.at-right { right: 26px; }
    .vmodal-x.at-left  { left: 26px; }

    .vdraw-hero { position: relative; aspect-ratio: 16/7; min-height: 340px; overflow: hidden; display: flex; align-items: flex-end; }
    .vdraw-hero-img { position: absolute; inset: -2%; background-size: cover; background-position: center; transform: scale(1.0); transition: transform 9s ease-out; }
    .vdraw.is-open .vdraw-hero-img { transform: scale(1.09); }
    .vdraw-hero::after { content: ""; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(12,11,10,0.15) 30%, rgba(12,11,10,0.78) 100%), radial-gradient(120% 80% at 50% 30%, transparent 55%, rgba(12,11,10,0.45) 100%); }
    .vdraw-hero-cap { position: relative; z-index: 2; padding: 44px 48px; color: var(--paper); }
    .vmodal-eyebrow { font-family: var(--sans); font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; font-weight: 700; color: rgba(240,238,235,0.85); margin-bottom: 12px; }
    .vmodal-title { font-family: var(--serif); font-weight: 400; font-size: clamp(36px, 5vw, 68px); line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 10px; color: var(--paper); }
    .vmodal-tagline { font-family: var(--serif); font-style: italic; font-size: clamp(16px, 1.8vw, 24px); color: rgba(240,238,235,0.9); margin: 0; max-width: 34ch; }

    .vmodal-gallery { display: grid; grid-auto-flow: column; grid-auto-columns: 130px; gap: 10px; padding: 20px 48px; overflow-x: auto; scrollbar-width: none; }
    .vmodal-gallery::-webkit-scrollbar { display: none; }
    .vmodal-thumb { aspect-ratio: 4/3; border-radius: 3px; border: 2px solid transparent; cursor: pointer; background-size: cover; background-position: center; padding: 0; transition: border-color 0.25s, transform 0.25s; }
    .vmodal-thumb:hover { transform: translateY(-2px); }
    .vmodal-thumb.is-active { border-color: var(--english-violet); }

    .vmodal-body { display: grid; grid-template-columns: 1.5fr 1fr; gap: 56px; padding: 28px 48px 8px; align-items: start; }
    @media (max-width: 900px) { .vmodal-body { grid-template-columns: 1fr; gap: 32px; } }
    .vmodal-summary { font-family: var(--serif); font-weight: 400; font-size: clamp(20px, 2.2vw, 30px); line-height: 1.45; color: var(--ink); margin: 0 0 36px; }
    .vmodal-sub { font-family: var(--sans); font-weight: 700; font-size: 15px; color: var(--ink); margin: 0 0 16px; }
    .vmodal-included { list-style: none; padding: 0; margin: 0; display: grid; gap: 12px; }
    .vmodal-included li { display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: baseline; font-family: var(--sans); font-size: 15px; color: rgba(28,29,34,0.8); }
    .vmodal-included li::before { content: "→"; font-family: var(--serif); font-style: italic; color: var(--english-violet); font-size: 17px; }
    .vmodal-price-card { border: 1px solid rgba(28,29,34,0.18); border-radius: 4px; padding: 26px 26px 24px; position: sticky; top: 8px; }
    .vmodal-price-tiers { display: grid; gap: 12px; }
    .vmodal-tier { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 12px; border-bottom: 1px solid rgba(28,29,34,0.1); }
    .vmodal-tier:last-child { border-bottom: none; padding-bottom: 0; }
    .vmodal-tier-label { font-family: var(--sans); font-size: 13px; letter-spacing: 0.04em; color: rgba(28,29,34,0.7); font-weight: 600; }
    .vmodal-tier-price { font-family: var(--serif); font-size: 28px; font-weight: 500; color: var(--ink); }
    .vmodal-price-note { font-family: var(--sans); font-size: 12px; color: var(--english-violet); font-weight: 700; letter-spacing: 0.04em; margin: 16px 0 20px; }
    .vmodal-book { width: 100%; justify-content: center; }
    .vmodal-fine { font-family: var(--sans); font-size: 12px; line-height: 1.55; color: rgba(28,29,34,0.55); margin: 14px 0 0; }
    .vdraw :global(.vshow) { padding: 24px 48px 56px; }
    .vdraw :global(.vshow-heading) { font-size: clamp(24px, 3vw, 36px); margin-bottom: 24px; }

    @media (max-width: 720px) {
      .vid-hero { padding: 100px 14px 48px; }
      .vid-hero-card { height: auto; display: flex; flex-direction: column; gap: 12px; overflow: visible; border: none; box-shadow: none; }
      .vid-hero-textbox { position: relative; inset: auto; left: auto; top: auto; bottom: auto; width: auto; order: 1; border: 1px solid rgba(28,29,34,0.12); }
      .vid-hero-scene { position: relative; height: 56vh; order: 2; border-radius: var(--hr); border: 1px solid rgba(28,29,34,0.12); }
      .vid-hero-window { display: none; }
      .vid-hero-cut { z-index: 4; left: auto; top: auto; right: 2%; bottom: -2%; width: 80%; }
      .vid-hero-headline { font-size: clamp(40px, 13vw, 72px); }
      .vdraw--three-quarter, .vdraw--tall { top: auto; bottom: 0; left: 0; width: 100vw; height: 96vh; border-radius: 14px 14px 0 0; }
      .vdraw--from-left, .vdraw--from-right { transform: translateY(102%); }
      .vdraw--from-left.is-open, .vdraw--from-right.is-open { transform: translateY(0); }
      .vdraw-hero-cap, .vmodal-gallery, .vmodal-body { padding-left: 24px; padding-right: 24px; }
      .vdraw :global(.vshow) { padding: 24px; }
    }
    @media (prefers-reduced-motion: reduce) {
      [data-reveal], .vband-img, .vdraw, .vmodal-scrim, .vdraw-hero-img, .vid-marquee-track, .vid-hero-scroll span { transition-duration: 0.01ms !important; animation: none !important; }
      [data-reveal] { opacity: 1; transform: none; }
    }
  </style>

  <script>
    import { PRODUCTS, tierPrice, resolvePartnerSlug, getPartner } from "../../data/videography.js";
    import { gbpFromPence } from "../../lib/supabase.js";

    const slug = resolvePartnerSlug();
    const partner = getPartner(slug);

    // --- Partner pricing ---
    (function applyPartnerPricing() {
      PRODUCTS.forEach((p) => {
        p.priceTiers.forEach((t, i) => {
          document.querySelectorAll(`[data-price-svc="${p.slug}"][data-tier="${i}"]`).forEach((el) => {
            el.textContent = gbpFromPence(tierPrice(t, slug));
          });
        });
        const note = document.querySelector(`[data-note-svc="${p.slug}"]`);
        if (note) note.textContent = partner.note;
      });
      if (slug !== "direct") {
        const banner = document.getElementById("vid-partner-banner");
        const text = document.getElementById("vid-partner-text");
        if (banner && text) { text.textContent = `${partner.name} · ${partner.note}`; banner.hidden = false; }
      }
    })();

    // --- Scroll reveal ---
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("is-in"); io.unobserve(e.target); } });
      }, { threshold: 0.15 });
      document.querySelectorAll("[data-reveal]").forEach((el) => io.observe(el));
    } else {
      document.querySelectorAll("[data-reveal]").forEach((el) => el.classList.add("is-in"));
    }

    // --- Directional drawers ---
    const scrim = document.getElementById("vmodal-scrim");
    const closeX = document.getElementById("vmodal-x");
    let openSlug = null;
    let closeTimer = null;

    function openProduct(s) {
      const draw = document.querySelector(`.vdraw[data-product="${s}"]`);
      if (!draw || !scrim) return;
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      openSlug = s;
      scrim.hidden = false;
      draw.hidden = false;
      draw.querySelector(".vdraw-scroll").scrollTop = 0;
      document.documentElement.style.overflow = "hidden";
      if (closeX) {
        const from = draw.getAttribute("data-from");
        closeX.classList.remove("at-left", "at-right");
        closeX.classList.add(from === "right" ? "at-left" : "at-right");
        closeX.hidden = false;
      }
      requestAnimationFrame(() => requestAnimationFrame(() => {
        scrim.classList.add("is-open");
        draw.classList.add("is-open");
      }));
      if (location.hash !== `#${s}`) history.replaceState(null, "", `#${s}`);
    }

    function closeProduct() {
      if (!openSlug || !scrim) return;
      const draw = document.querySelector(`.vdraw[data-product="${openSlug}"]`);
      scrim.classList.remove("is-open");
      if (draw) draw.classList.remove("is-open");
      if (closeX) closeX.hidden = true;
      document.documentElement.style.overflow = "";
      closeTimer = setTimeout(() => { scrim.hidden = true; if (draw) draw.hidden = true; }, 880);
      openSlug = null;
      if (location.hash) history.replaceState(null, "", location.pathname + location.search);
    }

    function bindOpen(el) {
      el.addEventListener("click", (e) => { e.stopPropagation(); openProduct(el.getAttribute("data-open")); });
      if (el.getAttribute("role") === "button") {
        el.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openProduct(el.getAttribute("data-open")); } });
      }
    }
    document.querySelectorAll("[data-open]").forEach(bindOpen);
    document.querySelectorAll("[data-close]").forEach((btn) => btn.addEventListener("click", closeProduct));
    scrim?.addEventListener("click", closeProduct);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && openSlug) closeProduct(); });

    // --- Gallery thumb → swap drawer hero ---
    document.querySelectorAll(".vmodal-gallery").forEach((gal) => {
      const heroId = gal.getAttribute("data-hero-target");
      const hero = heroId ? document.getElementById(heroId) : null;
      gal.querySelectorAll(".vmodal-thumb").forEach((thumb) => {
        thumb.addEventListener("click", () => {
          const full = thumb.getAttribute("data-full");
          if (hero && full) hero.style.backgroundImage = `url('${full}')`;
          gal.querySelectorAll(".vmodal-thumb").forEach((t) => t.classList.remove("is-active"));
          thumb.classList.add("is-active");
        });
      });
    });

    // --- Deep link ---
    (function openFromHash() {
      const h = (location.hash || "").replace("#", "");
      if (h && PRODUCTS.some((p) => p.slug === h)) openProduct(h);
    })();
  </script>
</BaseLayout>
