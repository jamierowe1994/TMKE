---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiscoveryPanel from "../../components/DiscoveryPanel.astro";
import VideoShowcase from "../../components/VideoShowcase.astro";
import { PRODUCTS, tierPrice, GATED_DOMAINS } from "../../data/videography.js";
import { gbpFromPence } from "../../lib/supabase.js";

const domainsJSON = JSON.stringify(GATED_DOMAINS);

// Deck panels: dictionary hero + intro/why + one per product + closing booking.
const total = PRODUCTS.length + 3;

// Opening + closing imagery — the site's own on-brand R2 stills.
const R2 = (name) => `https://assets.tmke.co.uk/${name}.webp`;

// Booking data passed to the wizard (DiscoveryPanel) via data attributes.
const packsOf = (p) => p.priceTiers.map((t) => ({ label: t.label, minutes: t.minutes, price: gbpFromPence(tierPrice(t, "direct")) }));
const packsJSON = (p) => JSON.stringify(packsOf(p));
const interestsJSON = JSON.stringify(PRODUCTS.map((p) => p.name));
const servicesJSON = JSON.stringify(PRODUCTS.map((p) => ({ name: p.name, packs: packsOf(p) })));
// Dictionary-hero backdrop — the client's "Camera View" still on R2.
const HERO_IMG = "https://assets.tmke.co.uk/camera%20view.jpg";

const navLinks = [
  { label: "About", href: "/about" },
  { label: "Social Media", href: "/services" },
  { label: "Videography", href: "/videography", current: true },
  { label: "The Edit", href: "/edit" },
  { label: "Insights", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<BaseLayout
  title="Videography — TMKE"
  description="Professional property video and photography — The Studio, The Property and The Agent. Presenter-led tours, drone, 360, short-form content and headshots, produced and delivered by TMKE."
  hideNav
  hideFooter
>
  <div class="pf">
    <!-- Top nav — TMKE (left) + Menu (right); hover the top strip to reveal links. -->
    <header class="pf-top" id="pf-top">
      <a href="/" class="pf-top-logo">TMKE</a>
      <nav class="pf-top-links" aria-label="Primary">
        {navLinks.map((l) => (
          <a href={l.href} class:list={[l.current && "is-current"]}>{l.label}</a>
        ))}
        <a href="/login" class="pf-top-login">Login</a>
      </nav>
      <button type="button" class="pf-top-menu" id="pf-top-menu" aria-label="Show menu">Menu</button>
    </header>

    <!-- Horizontal deck — each panel is one "page"; scroll right to advance. -->
    <div class="pf-deck" id="pf-deck">
      <!-- Slide 1 — full-screen dictionary hero (About / SMM style) -->
      <section class="pf-panel vh">
        <video class="vh-bg vh-video" autoplay muted loop playsinline preload="metadata" poster={HERO_IMG}>
          <source src="https://assets.tmke.co.uk/MainTour.mp4" type="video/mp4" />
        </video>
        <div class="vh-overlay"></div>
        <div class="vh-inner">
          <h1 class="vh-word">Videography</h1>
          <div class="vh-pron"><span class="vh-phon">/&thinsp;vid.i&#712;&#594;g.r&#601;.fi&thinsp;/</span> <em>noun</em></div>
          <p class="vh-lead">Professional property video and photography for agents who understand that first impressions are made online.</p>
          <div class="pf-partner" id="vid-partner-banner" hidden><span id="vid-partner-text"></span></div>
          <span class="pf-scroll-hint" aria-hidden="true">Scroll <em>&rarr;</em></span>
        </div>
      </section>

      <!-- Slide 2 — Intro & Why -->
      <section class="pf-panel vintro">
        <div class="vintro-inner">
          <span class="pf-panel-cat">Why it matters</span>
          <p class="vintro-lead">Before anyone reads a word of your listing, they've already formed an opinion. That opinion is shaped by one thing, the quality of the media in front of them.</p>
          <p>Poor photography loses instructions. Weak video loses viewings. And in a market where buyers scroll through dozens of listings before shortlisting a single one, the properties that get attention are the ones that look the part.</p>
          <p>But professional media isn't just about listings — it's about you. The agents who build lasting visibility in their local market aren't always the most experienced; they're the ones who show up consistently, look credible, and make the right impression before they ever walk through the door.</p>
          <p>Strong visuals work harder across every channel. They improve click-through rates on property portals, elevate your printed marketing, strengthen your valuation packs, and build the kind of brand presence that wins more instructions over time.</p>
          <span class="pf-scroll-hint vintro-next" aria-hidden="true">Our services <em>&rarr;</em></span>
        </div>
      </section>

      <!-- Product panels — wording (left) + image (right) -->
      {PRODUCTS.map((p) => (
        <section class="pf-panel pf-panel--slide">
          <div class="pf-panel-text">
            <span class="pf-panel-cat">Videography — {p.num}</span>
            <h2 class="pf-panel-title">{p.name}</h2>
            <p class="pf-panel-copy">{p.slideCopy}</p>
            <p class="pf-panel-sub">{p.slideBlurb}</p>
            <div class="pf-panel-meta">
              <span class="pf-panel-price">from <strong data-price-svc={p.slug} data-tier="0">{gbpFromPence(tierPrice(p.priceTiers[0], "direct"))}</strong> <em>+VAT</em></span>
            </div>
            <button type="button" class="pf-cta" data-open={p.slug}>{p.ctaLabel} <em>&rarr;</em></button>
          </div>
          <button
            type="button"
            class="pf-panel-img"
            data-open={p.slug}
            style={`background-image:url('${p.hero}')`}
            aria-label={`${p.ctaLabel} — ${p.name}`}
          ></button>
        </section>
      ))}

      <!-- Closing panel — two booking cards + a slide-in newsletter reveal -->
      <section class="pf-panel pf-final" id="pf-final">
        <div class="pf-final-track" id="pf-final-track">
          <article class="pf-cta-card">
            <div class="pf-cta-img" style={`background-image:url('${R2("living-1")}')`}></div>
            <div class="pf-cta-head">
              <h2 class="pf-cta-title">Book a consultation<br />with Jack</h2>
            </div>
            <p class="pf-cta-desc">Not sure which service is right for you, or want to talk through what you need before committing to a booking? Jump on a quick call with Jack directly — no pressure, no sales pitch, just a straightforward conversation to make sure you get the right result.</p>
            <button type="button" data-discovery-call data-dc-mode="consult" data-dc-interests={interestsJSON} class="pf-cta-btn">Book a time that suits you <span class="btn-arrow">&rarr;</span></button>
          </article>

          <article class="pf-cta-card">
            <div class="pf-cta-img" style={`background-image:url('${R2("table")}')`}></div>
            <div class="pf-cta-head">
              <h2 class="pf-cta-title">Book a shoot</h2>
              <span class="pf-cta-meta">A day with the team</span>
            </div>
            <p class="pf-cta-desc">Ready to go? Browse our full range of videography and photography services, choose what works for you, and secure your session in minutes.</p>
            <button type="button" data-discovery-call data-dc-mode="shoot" data-dc-services={servicesJSON} class="pf-cta-btn">Book a shoot <span class="btn-arrow">&rarr;</span></button>
          </article>

          <aside class="pf-news" aria-label="Newsletter sign-up">
            <h2 class="pf-news-title">Sign up for our<br />newsletter</h2>
            <form class="pf-news-form" id="pf-news-form" novalidate>
              <input type="text" name="first" placeholder="First name" autocomplete="given-name" />
              <input type="text" name="last" placeholder="Surname" autocomplete="family-name" />
              <input type="email" name="email" placeholder="Email" autocomplete="email" required />
              <button type="submit" class="pf-news-send">Send <span class="btn-arrow">&rarr;</span></button>
            </form>
            <div class="pf-news-meta">
              <span>Follow us</span>
              <a href="https://instagram.com/" target="_blank" rel="noopener">@tmke</a>
            </div>
          </aside>
        </div>

        <button type="button" class="pf-reveal-tab" id="pf-reveal-tab" aria-label="Reveal newsletter">
          <span class="pf-reveal-arrow" aria-hidden="true">&rarr;</span>
        </button>
      </section>
    </div>

    <!-- Counter -->
    <div class="pf-counter"><span id="pf-cur">01</span> <span class="pf-counter-sep">/</span> {String(total).padStart(2, "0")}</div>
  </div>

  <!-- ============ SHOWCASE POP-UPS (inset modal; sticky image + scrolling info) ============ -->
  <div class="vmodal-scrim" id="vmodal-scrim" hidden></div>
  <button type="button" class="vmodal-x" id="vmodal-x" data-close aria-label="Close" hidden>&times;</button>
  {PRODUCTS.map((p) => (
    <section
      class="vdraw"
      data-product={p.slug}
      data-from="bottom"
      role="dialog"
      aria-modal="true"
      aria-label={p.name}
      hidden
    >
      <div class="vdraw-scroll">
        <div class="vdraw-grid">
          <!-- LEFT (40%): scrolling info — intro, included, extras, pricing, about -->
          <div class="vdraw-left">
            <div class="vmodal-eyebrow">Videography {p.num}</div>
            <h2 class="vmodal-title">{p.name}</h2>
            <p class="vmodal-lede">{p.popLede}</p>
            {p.popIntro.map((para) => <p class="vmodal-summary">{para}</p>)}

            <h3 class="vmodal-sub">{p.includedHeading || "What's Included"}</h3>
            <ul class="vmodal-included">
              {p.included.map((d) => <li>{d}</li>)}
            </ul>

            {p.extras && p.extras.length > 0 && (
              <>
                <h3 class="vmodal-sub">{p.extrasHeading}</h3>
                <ul class="vmodal-extras">
                  {p.extras.map((x) => (
                    <li>
                      <span class="vmodal-extra-label">{x.label}</span>
                      <span class="vmodal-extra-price">{x.price}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}

            <div class="vmodal-price-card">
              <h3 class="vmodal-sub vmodal-sub--card">{p.pricingHeading}</h3>

              {p.pricingMode === "tiers" ? (
                <div class="vmodal-price-tiers">
                  {p.priceTiers.map((t, i) => (
                    <div class="vmodal-tier">
                      <span class="vmodal-tier-info">
                        <span class="vmodal-tier-label">{t.label}</span>
                        {t.sub && <span class="vmodal-tier-sub">{t.sub}</span>}
                      </span>
                      <span class="vmodal-tier-price">from <b data-price-svc={p.slug} data-tier={i}>{gbpFromPence(tierPrice(t, "direct"))}</b> +VAT</span>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="vmodal-price-prose">
                  {p.pricingProse.map((para) => <p>{para}</p>)}
                </div>
              )}

              {p.pricingMode === "tiers" && (
                <div class="vmodal-price-note" data-note-svc={p.slug}>Standard rates</div>
              )}

              <button type="button" data-discovery-call data-dc-mode={p.bookMode || "shoot"} data-dc-service={p.name} data-dc-packs={packsJSON(p)} data-dc-domains={p.bookMode === "waitlist" ? domainsJSON : undefined} class="btn btn--solid vmodal-book">
                {p.bookCtaLabel} <span class="btn-arrow">&rarr;</span>
              </button>
              <button type="button" data-discovery-call data-dc-mode="consult" data-dc-interests={interestsJSON} class="vmodal-consult">
                Not quite sure about something? <strong>Book a consultation call.</strong>
              </button>
            </div>

            <h3 class="vmodal-sub">{p.aboutHeading}</h3>
            {p.about.map((para) => <p class="vmodal-bio">{para}</p>)}

            {p.showcase && p.showcase.length > 0 && (
              <VideoShowcase heading="Recent work" items={p.showcase} />
            )}
          </div>

          <!-- RIGHT (60%): sticky media stage + showcase thumbnails. When a
               product has heroVideo, the video is the main media (default) and
               the thumbnails (video first) swap an image in over it. -->
          <div class="vdraw-right" data-product-right={p.slug} data-live-headshots={p.liveHeadshots ? "1" : undefined}>
            <div class="vdraw-stage">
              {p.heroVideo && (
                <video class="vdraw-hero-video" autoplay muted loop playsinline preload="metadata">
                  <source src={p.heroVideo} type="video/mp4" />
                </video>
              )}
              <div class="vdraw-hero-img is-active" style={`background-image:url('${(p.gallery && p.gallery[0]) || p.hero}')`}></div>
              <div class="vdraw-hero-img"></div>
              {((p.gallery && p.gallery.length > 1) || p.heroVideo) && (
                <div class="vmodal-nav">
                  <button type="button" class="vmodal-arrow" data-dir="-1" aria-label="Previous photo">&larr;</button>
                  <span class="vmodal-count"><b class="vmodal-count-cur">1</b> / <b class="vmodal-count-total">{(p.gallery ? p.gallery.length : 0) + (p.heroVideo ? 1 : 0)}</b></span>
                  <button type="button" class="vmodal-arrow" data-dir="1" aria-label="Next photo">&rarr;</button>
                </div>
              )}
            </div>
            {((p.gallery && p.gallery.length > 0) || p.heroVideo) && (
              <div class="vmodal-gallery">
                {p.heroVideo && (
                  <button type="button" class="vmodal-thumb vmodal-thumb--video is-active" data-video aria-label="Intro video"><span class="vmodal-thumb-play" aria-hidden="true">&#9658;</span></button>
                )}
                {p.gallery && p.gallery.map((src, i) => (
                  <button type="button" class={`vmodal-thumb ${(!p.heroVideo && i === 0) ? "is-active" : ""}`} data-full={src} style={`background-image:url('${src}')`} aria-label={`View photo ${i + 1}`}></button>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <DiscoveryPanel />

  <style>
    .pf {
      position: fixed; inset: 0;
      background: var(--paper);
      color: var(--ink);
      overflow: hidden;
    }

    /* First slide entrance — auto-plays on load (pure CSS, no JS dependency):
       the hero image slowly settles, then the dictionary wording rises in. */
    #pf-deck .pf-panel:first-child .vh-bg { animation: pfImgIn 2.4s cubic-bezier(.16,1,.3,1) 0.2s both; }
    #pf-deck .pf-panel:first-child .vh-inner { animation: pfTextIn 1.6s cubic-bezier(.16,1,.3,1) 0.9s both; }
    @keyframes pfImgIn { from { opacity: 0; transform: scale(1.08); } to { opacity: 1; transform: none; } }
    @keyframes pfTextIn { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
      #pf-deck .pf-panel:first-child .vh-bg,
      #pf-deck .pf-panel:first-child .vh-inner { animation-duration: 0.01ms; }
    }

    /* ---- Slide 1: dictionary hero (About / SMM style) ---- */
    .vh { position: relative; overflow: hidden; display: flex; flex-direction: column; justify-content: flex-end; }
    .vh-bg { position: absolute; inset: 0; background-size: cover; background-position: center; background-color: #2a2733; }
    .vh-video { width: 100%; height: 100%; object-fit: cover; display: block; }
    .vh-overlay {
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(20,18,26,0.55) 0%, rgba(20,18,26,0.42) 45%, rgba(20,18,26,0.68) 100%);
    }
    .vh-inner {
      position: relative; z-index: 2; max-width: 820px;
      margin: auto 0 0; padding: 0 clamp(28px, 6vw, 120px) clamp(72px, 12vh, 130px);
      color: var(--paper);
    }
    .vh-chapter { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(240,238,235,0.85); margin: 0 0 18px; }
    .vh-chapter span { opacity: 0.55; margin: 0 6px; }
    /* The word is the headline; the pronunciation sits small beneath it on one
       line (matches /social-media's SMM hero). */
    .vh-word { font-family: var(--serif); font-weight: 500; font-size: clamp(46px, 11vw, 152px); line-height: 0.95; letter-spacing: -0.03em; color: var(--paper); margin: 0; }
    .vh-pron { display: flex; align-items: baseline; flex-wrap: wrap; gap: 14px; margin: 16px 0 30px; }
    .vh-phon { font-family: var(--serif); font-style: italic; font-size: clamp(18px, 2vw, 28px); line-height: 1; color: rgba(240,238,235,0.78); letter-spacing: -0.01em; }
    .vh-pron em { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(240,238,235,0.7); font-style: normal; }
    .vh-lead { font-family: var(--sans); font-size: 20px; font-weight: 500; line-height: 1.6; color: rgba(240,238,235,0.92); max-width: 50ch; margin: 0 0 36px; }
    .vh .pf-scroll-hint { color: rgba(240,238,235,0.7); }
    .vh .pf-partner { margin: 0 0 28px; }

    /* ---- Slide 2: Intro & Why ---- */
    .vintro { display: flex; align-items: center; padding: 96px clamp(28px, 8vw, 140px) 80px; background: #eae5e1; }
    .vintro-inner { max-width: 680px; }
    /* "Why it matters" eyebrow — block so its 20px under-margin applies. */
    .vintro .pf-panel-cat { display: block; margin-bottom: 20px; }
    .vintro-lead {
      font-family: var(--serif) !important; font-style: italic;
      font-size: clamp(22px, 2.4vw, 32px) !important; line-height: 1.32 !important;
      color: var(--ink) !important; margin: 0 0 24px !important;
    }
    .vintro p { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.7; color: rgba(28,29,34,0.72); margin: 0 0 16px; }
    .vintro-next { display: inline-block; margin-top: 16px; color: var(--english-violet); }
    .vintro-next em { font-style: normal; margin-left: 8px; }

    /* Blurb under the slide one-liner */
    .pf-panel-sub { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(28,29,34,0.62); max-width: 50ch; margin: 0 0 24px; }
    .pf-panel-price em { font-style: normal; font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-left: 2px; }

    /* ---- Horizontal deck ---- */
    .pf-deck {
      display: flex;
      height: 100vh;
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .pf-deck::-webkit-scrollbar { display: none; }
    .pf-panel {
      flex: 0 0 100vw;
      width: 100vw;
      height: 100vh;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    /* ---- Shared slide layout: wording (left) + image (right) ---- */
    .pf-panel--slide { display: flex; }
    .pf-panel-text {
      width: 42%; min-width: 340px;
      padding: 0 56px 72px 40px;
      display: flex; flex-direction: column; justify-content: flex-end;
    }
    .pf-panel-img {
      flex: 1; align-self: stretch; border: none; padding: 0;
      margin: 0;
      background-size: cover; background-position: center;
      background-color: #e9e4da;
    }
    button.pf-panel-img { cursor: pointer; }

    /* Statement panels (intro + closing) — larger type, same column */
    .pf-eyebrow {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--english-violet); margin: 0 0 24px;
    }
    .pf-statement-h {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(38px, 3.8vw, 54px); line-height: 1.04;
      letter-spacing: -0.02em; margin: 0 0 24px;
    }
    .pf-statement-h em { font-style: italic; color: var(--english-violet); }
    .pf-statement-sub {
      font-family: var(--sans); font-size: 16px;
      line-height: 1.6; color: rgba(28,29,34,0.7); max-width: 52ch; margin: 0 0 36px;
    }
    .pf-scroll-hint {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.24em; text-transform: uppercase; color: rgba(28,29,34,0.5);
    }
    .pf-scroll-hint em { font-style: normal; margin-left: 8px; }
    .pf-book { align-self: flex-start; }
    .pf-partner { margin: 0 0 32px; }
    .pf-partner[hidden] { display: none; }
    #vid-partner-text {
      display: inline-flex; align-items: center; gap: 10px; padding: 9px 16px;
      border-radius: 999px; background: rgba(55, 30, 40, 0.1); color: var(--english-violet);
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
    }

    /* Product slides */
    .pf-panel-cat {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--english-violet); margin-bottom: 18px;
    }
    .pf-panel-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(38px, 3.8vw, 54px); line-height: 1.04;
      letter-spacing: -0.02em; margin: 0 0 20px;
    }
    .pf-panel-copy {
      font-family: var(--sans); font-size: 16px; line-height: 1.6;
      color: rgba(28,29,34,0.7); max-width: 52ch; margin: 0 0 24px;
    }
    .pf-panel-meta { margin-bottom: 26px; }
    .pf-panel-price { font-family: var(--sans); font-size: 13px; letter-spacing: 0.04em; color: rgba(28,29,34,0.6); }
    .pf-panel-price strong { font-family: var(--serif); font-size: 24px; font-weight: 500; color: var(--ink); margin-left: 4px; }
    .pf-cta {
      align-self: flex-start; background: none; border: none; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);
      padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.25);
      transition: color 0.25s, border-color 0.25s;
    }
    .pf-cta em { font-style: normal; margin-left: 10px; transition: margin 0.25s; display: inline-block; }
    .pf-cta:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .pf-cta:hover em { margin-left: 16px; }

    /* ---- Final panel: two booking cards + slide-in newsletter ---- */
    .pf-final { position: relative; overflow: hidden; }
    .pf-final-track {
      display: flex; height: 100%; width: max-content;
      transition: transform 0.75s cubic-bezier(.16,1,.3,1);
      will-change: transform;
    }
    .pf-cta-card {
      flex: 0 0 50vw; height: 100%;
      /* Top-aligned so the two cards' images + titles line up across the pair
         (a longer description no longer pushes one card's content up/down). */
      display: flex; flex-direction: column; justify-content: flex-start; align-items: flex-start;
      gap: 22px; padding: clamp(96px, 12vh, 150px) 48px 56px;
    }
    /* Consultation card nudged in from the left edge (~150px on desktop) so it
       sits closer to the "Book a shoot" card and off the screen edge. */
    .pf-cta-card:first-child { padding-left: clamp(40px, 10vw, 190px); }
    .pf-cta-img {
      /* Fixed (no flex-shrink) + capped height so both cards' images match —
         a longer description no longer shrinks one image and drops its title. */
      flex: 0 0 auto;
      width: 100%; max-width: 360px; height: clamp(200px, 34vh, 380px);
      background-size: cover; background-position: center; background-color: #e9e4da;
    }
