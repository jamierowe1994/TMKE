---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import VideographyBooking from "../../components/VideographyBooking.astro";
import VideoShowcase from "../../components/VideoShowcase.astro";
import NavDrawer from "../../components/NavDrawer.astro";
import Nav from "../../components/Nav.astro";
import VideographyBrochureForm from "../../components/VideographyBrochureForm.astro";
import { PRODUCTS, tierPrice, VIDEOGRAPHY_BROCHURE } from "../../data/videography.js";
import { PHOTOGRAPHY, photoInclusions } from "../../lib/videography-config.js";
import { gbpFromPence } from "../../lib/supabase.js";

// Deck panels: dictionary hero + intro/why + one per product + closing booking.
const total = 7;   // home, then two routes of three: services, our work, get started

// Opening + closing imagery — the site's own on-brand R2 stills.
const R2 = (name) => `https://assets.tmke.co.uk/${name}.webp`;

// Map a product to its booking-flow service key (Studio = Content Studio).
const serviceKey = (p) => (p.slug === "studio" ? "content-studio" : p.slug);
// Dictionary-hero backdrop — the client's "Camera View" still on R2.
const HERO_IMG = "https://assets.tmke.co.uk/camera%20view.jpg";
// Slide-1 hero (SMM-style): full-bleed background VIDEO + a right-hand static
// image box (placeholder pulled from the site; client to replace).
const VID_HERO_VIDEO = "https://assets.tmke.co.uk/Jack%20Photos%20-%20Homepage/Property%20Edit%20Video%201%20.mov";
const VID_BOX_IMG = (await getImage({
  src: "https://assets.tmke.co.uk/camera%20view.jpg",
  width: 700, height: 933, quality: 78, format: "webp",
})).src;

const navLinks = [
  { label: "About", href: "/about" },
  { label: "Social Media", href: "/services" },
  { label: "Property Videography", href: "/videography", current: true },
  { label: "Property Photography", href: "/videography#photography", current: true },
  { label: "The Edit", href: "/edit" },
  { label: "Insights", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<BaseLayout
  title="Videography — TMKE"
  description="Professional property video and photography — The Studio, The Property and The Agent. Presenter-led tours, drone, 360, short-form content and headshots, produced and delivered by TMKE."
  hideNav
  hideFooter
  pageTransition
>
  <div class="pf">
    <!-- Top nav — TMKE (left) + Menu (right); hover the top strip to reveal links. -->
    <header class="pf-top" id="pf-top">
      <a href="/" class="pf-top-logo">TMKE</a>
      <nav class="pf-top-links" aria-label="Primary">
        {navLinks.map((l) => (
          <a href={l.href} class:list={[l.current && "is-current"]}>{l.label}</a>
        ))}
        <a href="/login" class="pf-top-login js-nav-login">Login</a>
      </nav>
      <button type="button" class="pf-top-menu" id="pf-top-menu" aria-label="Menu" aria-expanded="false" data-nav-drawer-open><span></span><span></span><span></span></button>
    </header>

    <!-- Horizontal deck — each panel is one "page"; scroll right to advance. -->
    <!-- Phones: The Edit's stack instead of the deck. A title screen, then a
         bar per service and Get in touch, each opening in place. A service
         shows its slide first; a swipe across is the full story. -->
    <div class="sm-sitenav"><Nav drawer={false} /></div>
    <div class="sms" id="sms" aria-label="Videography">
      <section class="sms-p is-open" data-i="0">
        <div class="sms-body sms-title">
          <h1 class="sms-mark">Videography</h1>
          <p class="sms-pron"><span>/&thinsp;vid.i&#712;&#594;g.r&#601;.fi&thinsp;/</span> <em>noun</em></p>
          <p class="sms-lede">Professional property video and photography for agents who understand that first impressions are made online. From tours to short-form content, delivered to a standard that wins instructions.</p>
          <div class="sms-row" aria-hidden="true">
            {[...PRODUCTS.map((p) => p.hero), VID_BOX_IMG].slice(0, 4).map((src) => <span class="sms-row-tile" style={`background-image:url('${src}')`}></span>)}
          </div>
        </div>
      </section>

      {PRODUCTS.map((p, pi) => (
        <section class="sms-p" data-i={pi + 1}>
          <button type="button" class="sms-bar"><span class="sms-dash"></span><span class="sms-name">{p.name}</span><span class="sms-chev" aria-hidden="true">&#9662;</span></button>
          <div class="sms-body sms-body--flush">
            <div class="sms-hscroll">
              <div class="sms-hslide">
                <h2 class="sms-h sms-h--dash">{p.name}</h2>
                {(() => { const v = (p.media || []).find((m) => m.type === "video"); return v
                  ? <video class="sms-vid" src={v.src} poster={v.thumb || p.hero} autoplay muted loop playsinline preload="metadata" aria-label={p.name}></video>
                  : <div class="sms-pic sms-pic--cta" style={`background-image:url('${p.hero}')`} role="img" aria-label={p.name}></div>; })()}
                <p class="sms-p-copy"><strong>{p.slideCopy}</strong></p>
                <p class="sms-p-copy">{p.slideBlurb}</p>
                <p class="sms-price">from <strong data-price-svc={p.slug} data-tier="0">{gbpFromPence(tierPrice(p.priceTiers[0], "direct"))}</strong> +VAT</p>
                <button type="button" class="sms-btn" data-vbook={serviceKey(p)}>Book now <span aria-hidden="true">&rarr;</span></button>
                <p class="sms-swipe">Swipe to {p.ctaLabel.replace(/^Discover /i, "discover ")} &rarr;</p>
              </div>
              <div class="sms-hslide">
                <h2 class="sms-h sms-h--dash">{p.name}</h2>
                <p class="sms-lede">{p.popLede}</p>
                {p.popIntro.map((para) => <p class="sms-p-copy">{para}</p>)}
                <h3 class="sms-sub">{p.includedHeading || "What's Included"}</h3>
                <ul class="sms-included">{p.included.map((d) => <li>{d}</li>)}</ul>
                {p.extras && p.extras.length > 0 && (
                  <>
                    <h3 class="sms-sub">{p.extrasHeading}</h3>
                    <ul class="sms-extras">{p.extras.map((x) => <li><span>{x.label}</span><span>{x.price}</span></li>)}</ul>
                  </>
                )}
                <h3 class="sms-sub">{p.pricingHeading}</h3>
                {p.pricingMode === "tiers" ? (
                  <div>
                    {p.priceTiers.map((t, i) => (
                      <div class="sms-tierrow">
                        <span class="sms-tierrow-label">{t.label}{t.sub && <small>{t.sub}</small>}</span>
                        <span class="sms-tierrow-price">from <b data-price-svc={p.slug} data-tier={i}>{gbpFromPence(tierPrice(t, "direct"))}</b> +VAT</span>
                      </div>
                    ))}
                    <p class="sms-note" data-note-svc={p.slug}>Standard rates</p>
                  </div>
                ) : (
                  <div>{p.pricingProse.map((para) => <p class="sms-p-copy">{para}</p>)}</div>
                )}
                <button type="button" class="sms-btn" data-vbook={serviceKey(p)}>{p.bookCtaLabel} <span aria-hidden="true">&rarr;</span></button>
                <h3 class="sms-sub">{p.aboutHeading}</h3>
                {p.about.map((para) => <p class="sms-p-copy">{para}</p>)}
              </div>
            </div>
          </div>
        </section>
      ))}

      <section class="sms-p" data-i={PRODUCTS.length + 1}>
        <button type="button" class="sms-bar"><span class="sms-dash"></span><span class="sms-name">Get in touch</span><span class="sms-chev" aria-hidden="true">&#9662;</span></button>
        <div class="sms-body">
          <div class="sms-block">
            <h2 class="sms-h">Download a Brochure</h2>
            <p class="sms-p-copy">See our services, how a shoot works and what it costs.</p>
            <button type="button" class="sms-btn" data-vid-brochure>Download a brochure <span aria-hidden="true">&rarr;</span></button>
          </div>
          <div class="sms-block">
            <h2 class="sms-h">Book a Consultation</h2>
            <p class="sms-p-copy">Not sure which service is right for you? Jump on a quick call with Jack and talk it through, no pressure.</p>
            <button type="button" class="sms-btn" data-vbook="discovery">Book a time that suits you <span aria-hidden="true">&rarr;</span></button>
          </div>
          <div class="sms-block">
            <h2 class="sms-h">Book a Shoot</h2>
            <p class="sms-p-copy">Ready to go? Choose the service that works for you and secure your session in minutes.</p>
            <button type="button" class="sms-btn" data-vbook="choose">Book a shoot <span aria-hidden="true">&rarr;</span></button>
          </div>
        </div>
      </section>
      <div class="sms-foot" aria-hidden="true"></div>
    </div>
    <div class="pf-deck" id="pf-deck">
      <!-- Slide 1 — like /services slide 1 (About lede pinned to the top: copy
           left, photo right) with one long element below that rises up over the
           header into a full-page on scroll, then advances across. Here that long
           element is the VIDEO (the .mov), not an image. -->
      <!-- Page one: the term, the two ways in, and why it matters — one page
           that scrolls inside itself. At its bottom edge the deck pages across,
           the same handover /services uses. -->
      <section class="pf-panel vh">
        <div class="vh-header">
          <div class="vh-wrap">
            <div class="vh-lede-grid">
              <div class="vh-lede-copy">
                <div class="vh-lede-top">
                  <h1 class="vh-lede-mark">Videography</h1>
                  <p class="vh-lede-pron">
                    <span class="vh-lede-phon">/&thinsp;vid.i&#712;&#594;g.r&#601;.fi&thinsp;/</span>
                    <span class="vh-lede-pos"><em>noun</em></span>
                  </p>
                </div>
                <div class="vh-lede-bottom">
                  <p class="vh-lede-text">Professional property video and photography for agents who understand that first impressions are made online. From tours to short-form content, delivered to a standard that wins instructions.</p>
                  <div class="pf-partner" id="vid-partner-banner" hidden><span id="vid-partner-text"></span></div>
                  <button type="button" class="vh-lede-btn" data-deck-next>Discover <span aria-hidden="true">&rarr;</span></button>
                </div>
              </div>
              <figure class="vh-lede-media">
                <img src={VID_BOX_IMG} alt="TMKE videography" />
              </figure>
            </div>
          </div>
        </div>

        <!-- The two ways in. Hovering one widens it and brings its words up. -->
        <div
          class="vh-routes"
          style={`--vh-route-video:url('${PRODUCTS[0].hero}');--vh-route-photo:url('${R2("white-1")}')`}
        >
          <article class="vh-route" data-route="video">
            <div class="vh-route-face">
              <span class="vh-route-lead">Film</span>
              <h2 class="vh-route-title">Videography</h2>
            </div>
            <div class="vh-route-open"><div class="vh-route-inner">
              <p class="vh-route-body">Tours, short-form content and presenter-led film, shot in the studio, at the property, or with you in front of the camera.</p>
              <button type="button" class="vh-route-cta" data-deck-next>See what we film <span aria-hidden="true">&rsaquo;</span></button>
            </div></div>
          </article>
          <article class="vh-route" data-route="photo">
            <div class="vh-route-face">
              <span class="vh-route-lead">Stills</span>
              <h2 class="vh-route-title">Photography</h2>
            </div>
            <div class="vh-route-open"><div class="vh-route-inner">
              <p class="vh-route-body">Portal-ready property photography including drone, delivered in the sizes the portals and your socials actually use.</p>
              <button type="button" class="vh-route-cta" data-photo-open>See the packages <span aria-hidden="true">&rsaquo;</span></button>
            </div></div>
          </article>
        </div>

        <div class="vintro-inner">
          <span class="pf-panel-cat">Why it matters</span>
          <p class="vintro-lead">&ldquo;People judge your marketing before they judge your service.&rdquo;</p>
          <p>The photography. The videography. The way your properties, and your brand, are presented.</p>
          <p>Buyers scroll quickly. Sellers notice how you market property just as quickly. If your marketing looks professional, they&rsquo;ll expect your service to be the same.</p>
          <p>Every listing is an advert for your next instruction.</p>
        </div>
      </section>

      <!-- The three, on one page: the list left, a picture right, as /services
           does. They were three separate pages, which was three sideways moves
           to read one list. -->
      <section class="pf-panel vsvcs">
        <div class="vsvcs-text">
          <p class="pf-panel-cat">Our services</p>
          <div class="vsvcs-list">
            {PRODUCTS.map((p) => (
              <article class="vsvc" data-svc={p.slug}>
                <h3 class="vsvc-name">{p.name}</h3>
                <p class="vsvc-meta">
                  <span class="vsvc-price">From {gbpFromPence(tierPrice(p.priceTiers[0], "direct"))} +VAT</span>
                </p>
                <p class="vsvc-body">{p.slideCopy}</p>
                <div class="vsvc-actions">
                  <button type="button" class="vsvc-cta" data-vbook={serviceKey(p)}>Book now <span aria-hidden="true">&rsaquo;</span></button>
                  <button type="button" class="vsvc-cta vsvc-cta--ghost" data-open={p.slug}>{p.ctaLabel} <span aria-hidden="true">&rsaquo;</span></button>
                </div>
              </article>
            ))}
          </div>
        </div>
        <div class="vsvcs-media" id="vsvcs-media">
          {PRODUCTS.map((p, i) => (
            <div class={`vsvc-img${i === 0 ? " is-active" : ""}`} data-img={i} style={`background-image:url('${p.hero}')`}></div>
          ))}
        </div>
      </section>

      <!-- Our work — one full-bleed film, inside the page margins. -->
      <section class="pf-panel vwork">
        <figure class="vwork-frame">
          <video class="vwork-vid" src={VID_HERO_VIDEO} autoplay muted loop playsinline preload="auto" aria-label="TMKE videography showreel"></video>
          <figcaption class="vwork-cap">Our work</figcaption>
        </figure>
      </section>


      <!-- Closing panel — a photograph, then the ways in, sitting on the page's
           own bottom margin. The newsletter used to slide in from a tab on the
           right edge, which is what pushed this page's margins out of line with
           every other one; it lives in the footer everywhere else (Dani, 7 Oct). -->
      <section class="pf-panel pf-final" id="pf-final">
          <figure class="sm-ways-pic" style={`background-image:url('${R2("orange-1")}')`} role="img" aria-label=""></figure>
          <!-- The same list /services uses: a heading left, the ways in right,
               each opening in place. Four rows — the fourth crosses to the other
               route. The three big image cards this replaces said the same
               things in three times the space. -->
          <div class="sm-ways">
            <div class="sm-ways-head">
              <p class="pf-panel-cat">Get started</p>
              <h2 class="sm-ways-h">Start With the Right Support.</h2>
              <p class="sm-ways-note">Tell us what you need filming and we&rsquo;ll tell you what makes sense &mdash; including if the honest answer is a conversation first.</p>
            </div>
            <div class="sm-ways-list" data-ways>
              {[
                { t: "Download a Brochure", lead: "The full breakdown, in writing.", body: VIDEOGRAPHY_BROCHURE.cardBody, cta: "Download a brochure", attr: "data-vid-brochure" },
                { t: "Book a Consultation", lead: "Twenty minutes, no pitch.", body: "Not sure which service is right for you, or want to talk it through before committing? Jump on a quick call with Jack directly \u2014 no pressure and no sales pitch.", cta: "Book a time that suits you", attr: 'data-vbook="discovery"' },
                { t: "Book a Shoot", lead: "A day with the team.", body: "Ready to go? Browse our full range of videography and photography services, choose what works for you, and secure your session in minutes.", cta: "Book a shoot", attr: 'data-vbook="choose"' },
                { t: "Discover our Photography", lead: "Stills, including drone.", body: "Portal-ready property photography in three packages, by how many photographs you need, delivered in the sizes the portals and your socials actually use.", cta: "See the photography packages", attr: 'data-goto-route="photo"' },
              ].map((w, i) => (
                <div class="sm-way" data-way={i}>
                  <button type="button" class="sm-way-head" aria-expanded={i === 0 ? "true" : "false"}>
                    <span class="sm-way-title">{w.t}</span>
                    <span class="sm-way-lead">{w.lead}</span>
                    <span class="sm-way-sign" aria-hidden="true"></span>
                  </button>
                  <div class="sm-way-body"><div class="sm-way-inner">
                    <p class="sm-way-copy">{w.body}</p>
                    <button type="button" class="sm-way-cta" set:html={`${w.cta} <span aria-hidden="true">&rsaquo;</span>`} {...(w.attr.includes("=") ? { [w.attr.split("=")[0]]: w.attr.split('"')[1] } : { [w.attr]: true })}></button>
                  </div></div>
                </div>
              ))}
            </div>
          </div>
      </section>

      <!-- Photography — the packages, then the work. Reached from the opening's
           Photography card; the deck pages here as it does anywhere else. -->
      <section class="pf-panel vphoto" id="vphoto">
        <div class="vphoto-text">
          <p class="pf-panel-cat">Photography</p>
          <p class="vphoto-lede">Portal-ready property photography including drone, delivered in the sizes the portals and your socials actually use. Three packages, by how many photographs you need.</p>
          <div class="vphoto-list">
            {PHOTOGRAPHY.packages.map((pk) => (
              <article class="vphoto-pk">
                <h3 class="vphoto-pk-name">{pk.name}</h3>
                <p class="vphoto-pk-meta"><span class="vphoto-pk-price">From {gbpFromPence(pk.member_pence)} +VAT</span></p>
                <p class="vphoto-pk-body">{photoInclusions(pk)}</p>
                <button type="button" class="vsvc-cta" data-vbook="photography" data-photo-pk={pk.key}>Book this package <span aria-hidden="true">&rsaquo;</span></button>
              </article>
            ))}
          </div>
        </div>
        <div class="vphoto-media" style={`background-image:url('${R2("white-1")}')`}></div>
      </section>

      <!-- The work: a full page of property photography. -->
      <section class="pf-panel vgrid">
        <div class="vgrid-inner">
          {[R2("white-1"), R2("living-1"), R2("kitchen-1"), R2("orange-1"), R2("table"), R2("white-2"), R2("kitchen-2"), R2("living-2")].map((src) => (
            <span class="vgrid-cell" style={`background-image:url('${src}')`}></span>
          ))}
        </div>
      </section>
      <!-- Photography's ways in — the same list, crossing back to the film. -->
      <section class="pf-panel vpcontact">
        <figure class="sm-ways-pic" style={`background-image:url('${R2("living-2")}')`} role="img" aria-label=""></figure>
        <div class="sm-ways">
          <div class="sm-ways-head">
            <p class="pf-panel-cat">Get started</p>
            <h2 class="sm-ways-h">Book Your Photography.</h2>
            <p class="sm-ways-note">Tell us the property and when it needs shooting, and we&rsquo;ll do the rest.</p>
          </div>
          <div class="sm-ways-list" data-ways>
            {[
              { t: "Download a Brochure", lead: "The full breakdown, in writing.", body: VIDEOGRAPHY_BROCHURE.cardBody, cta: "Download a brochure", attr: "data-vid-brochure" },
              { t: "Book a Consultation", lead: "Twenty minutes, no pitch.", body: "Not sure which package is right for the property, or want to talk it through first? Jump on a quick call with Jack directly \u2014 no pressure and no sales pitch.", cta: "Book a time that suits you", attr: 'data-vbook="discovery"' },
              { t: "Book a Shoot", lead: "Pick a package and a date.", body: "Ready to go? Choose the package that fits the property, tell us where it is, and secure your session in minutes.", cta: "Book a shoot", attr: 'data-vbook="photography"' },
              { t: "Discover our Videography", lead: "Film, from tour to Reel.", body: "The Studio, The Property and The Agent \u2014 presenter-led tours, short-form content and the filming days behind them.", cta: "See the videography packages", attr: 'data-goto-route="video"' },
            ].map((w, i) => (
              <div class="sm-way" data-way={i}>
                <button type="button" class="sm-way-head" aria-expanded={i === 0 ? "true" : "false"}>
                  <span class="sm-way-title">{w.t}</span>
                  <span class="sm-way-lead">{w.lead}</span>
                  <span class="sm-way-sign" aria-hidden="true"></span>
                </button>
                <div class="sm-way-body"><div class="sm-way-inner">
                  <p class="sm-way-copy">{w.body}</p>
                  <button type="button" class="sm-way-cta" set:html={`${w.cta} <span aria-hidden="true">&rsaquo;</span>`} {...(w.attr.includes("=") ? { [w.attr.split("=")[0]]: w.attr.split('"')[1] } : { [w.attr]: true })}></button>
                </div></div>
              </div>
            ))}
          </div>
        </div>
      </section>
    </div>

    <!-- Counter -->
    <div class="pf-counter"><span id="pf-cur">01</span> <span class="pf-counter-sep">/</span> {String(total).padStart(2, "0")}</div>
  </div>

  <!-- ============ SHOWCASE POP-UPS (inset modal; sticky image + scrolling info) ============ -->
  <div class="vmodal-scrim" id="vmodal-scrim" hidden></div>
  <button type="button" class="vmodal-x" id="vmodal-x" data-close aria-label="Close" hidden>&times;</button>
  {PRODUCTS.map((p) => {
    // Unified, ordered media list for the pop-out gallery. Prefer an explicit
    // `media` list (hand-ordered mix of stills + film); otherwise fall back to
    // the legacy heroVideo + gallery images.
    const galItems = p.media
      ? p.media
      : [
          ...(p.heroVideo ? [{ type: "video", src: p.heroVideo }] : []),
          ...((p.gallery || []).map((src) => ({ type: "image", src }))),
        ];
    const firstIsVideo = galItems[0] && galItems[0].type === "video";
    const anyVideo = galItems.some((m) => m.type === "video");
    const firstImg = (galItems.find((m) => m.type === "image") || {}).src || p.hero;
    return (
    <section
      class="vdraw"
      data-product={p.slug}
      data-from="bottom"
      role="dialog"
      aria-modal="true"
      aria-label={p.name}
      hidden
    >
      <div class="vdraw-scroll">
        <div class="vdraw-grid">
          <!-- LEFT (40%): scrolling info — intro, included, extras, pricing, about -->
          <div class="vdraw-left">
            <div class="vmodal-eyebrow">Videography {p.num}</div>
            <h2 class="vmodal-title">{p.name}</h2>
            <p class="vmodal-lede">{p.popLede}</p>
            {p.popIntro.map((para) => <p class="vmodal-summary">{para}</p>)}

            <div class="vmodal-divider" aria-hidden="true"></div>

            <h3 class="vmodal-sub">{p.includedHeading || "What's Included"}</h3>
            <ul class="vmodal-included">
              {p.included.map((d) => <li>{d}</li>)}
            </ul>

            {p.extras && p.extras.length > 0 && (
              <>
                <h3 class="vmodal-sub">{p.extrasHeading}</h3>
                <ul class="vmodal-extras">
                  {p.extras.map((x) => (
                    <li>
                      <span class="vmodal-extra-label">{x.label}</span>
                      <span class="vmodal-extra-price">{x.price}</span>
                    </li>
                  ))}
                </ul>
              </>
            )}

            <div class="vmodal-price-card">
              <h3 class="vmodal-sub vmodal-sub--card">{p.pricingHeading}</h3>

              {p.pricingMode === "tiers" ? (
                <div class="vmodal-price-tiers">
                  {p.priceTiers.map((t, i) => (
                    <div class="vmodal-tier">
                      <span class="vmodal-tier-info">
                        <span class="vmodal-tier-label">{t.label}</span>
                        {t.sub && <span class="vmodal-tier-sub">{t.sub}</span>}
                      </span>
                      <span class="vmodal-tier-price">from <b data-price-svc={p.slug} data-tier={i}>{gbpFromPence(tierPrice(t, "direct"))}</b> +VAT</span>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="vmodal-price-prose">
                  {p.pricingProse.map((para) => <p>{para}</p>)}
                </div>
              )}

              {p.pricingMode === "tiers" && (
                <div class="vmodal-price-note" data-note-svc={p.slug}>Standard rates</div>
              )}

              <button type="button" data-vbook={serviceKey(p)} class="btn btn--solid vmodal-book">
                {p.bookCtaLabel} <span class="btn-arrow">&rarr;</span>
              </button>
              <button type="button" data-vbook="discovery" class="vmodal-consult">
                Not quite sure about something? <strong>Book a consultation call.</strong>
              </button>
            </div>

            <h3 class="vmodal-sub">{p.aboutHeading}</h3>
            {p.about.map((para) => <p class="vmodal-bio">{para}</p>)}

            {p.showcase && p.showcase.length > 0 && (
              <VideoShowcase heading="Recent work" items={p.showcase} />
            )}
          </div>

          <!-- RIGHT (60%): sticky media stage + showcase thumbnails. When a
               product has heroVideo, the video is the main media (default) and
               the thumbnails (video first) swap an image in over it. -->
          <div class="vdraw-right" data-product-right={p.slug} data-media-gallery={p.media ? "1" : undefined}>
            <div class={`vdraw-stage${firstIsVideo ? "" : " show-img"}`}>
              {anyVideo && (
                <video class="vdraw-hero-video" autoplay muted loop playsinline preload="metadata">
                  {firstIsVideo && <source src={galItems[0].src} type="video/mp4" />}
                </video>
              )}
              <div class="vdraw-hero-img is-active" style={`background-image:url('${firstImg}')`}></div>
              <div class="vdraw-hero-img"></div>
              {galItems.length > 1 && (
                <div class="vmodal-nav">
                  <button type="button" class="vmodal-arrow" data-dir="-1" aria-label="Previous">&larr;</button>
                  <span class="vmodal-count"><b class="vmodal-count-cur">1</b> / <b class="vmodal-count-total">{galItems.length}</b></span>
                  <button type="button" class="vmodal-arrow" data-dir="1" aria-label="Next">&rarr;</button>
                </div>
              )}
              {anyVideo && (
                <button type="button" class="vmodal-sound" data-sound aria-label="Turn sound on" aria-pressed="false">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5" fill="currentColor" stroke="none"></polygon>
                    <g class="vs-waves"><path d="M15.5 8.5a5 5 0 0 1 0 7"></path><path d="M18.5 5.5a9 9 0 0 1 0 13"></path></g>
                    <g class="vs-mute"><line x1="16" y1="9" x2="22" y2="15"></line><line x1="22" y1="9" x2="16" y2="15"></line></g>
                  </svg>
                </button>
              )}
            </div>
            {galItems.length > 0 && (
              <div class="vmodal-gallery">
                {galItems.map((m, i) => (
                  m.type === "video" ? (
                    <button type="button" class={`vmodal-thumb vmodal-thumb--video ${i === 0 ? "is-active" : ""}`} data-video data-video-src={m.src} style={m.thumb ? `background-image:url('${m.thumb}')` : undefined} aria-label={`Video ${i + 1}`}><span class="vmodal-thumb-play" aria-hidden="true">&#9658;</span></button>
                  ) : (
                    <button type="button" class={`vmodal-thumb ${i === 0 ? "is-active" : ""}`} data-full={m.src} style={`background-image:url('${m.src}')`} aria-label={`View photo ${i + 1}`}></button>
                  )
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
    );
  })}

  <VideographyBooking />
  <VideographyBrochureForm />
  <NavDrawer />

  <style>
    /* ===== Page one scrolls inside itself ============================== */
    .pf-panel.vh {
      display: block; align-items: stretch; padding: 0 0 72px;
      overflow-y: auto; overscroll-behavior: contain; scrollbar-width: none;
    }
    .pf-panel.vh::-webkit-scrollbar { display: none; }
    /* 40px between blocks, as About and /services use. */
    .pf-panel.vh > * + * { margin-top: 40px; }
    .pf-panel.vh .vh-header { padding-bottom: 0; }

    /* ===== The two ways in ============================================= */
    .vh-routes { display: flex; gap: 10px; height: clamp(300px, 46vh, 460px); margin-inline: var(--page-gutter); }
    .vh-route {
      position: relative; flex: 1 1 0; min-width: 0; overflow: hidden;
      background-size: cover; background-position: center; border-radius: 2px;
      display: flex; flex-direction: column; justify-content: flex-end;
      padding: 26px; cursor: pointer; background-color: #2a2126;
      transition: flex-grow 0.55s cubic-bezier(.2,.8,.2,1);
    }
    .vh-route[data-route="video"] { background-image: var(--vh-route-video); }
    .vh-route[data-route="photo"] { background-image: var(--vh-route-photo); }
    .vh-route::before {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(to top, rgba(28,20,24,0.88), rgba(28,20,24,0.35) 58%, rgba(28,20,24,0.12));
      opacity: 0; transition: opacity 0.45s ease;
    }
    .vh-route:hover, .vh-route:focus-within { flex-grow: 2.1; }
    .vh-route:hover::before, .vh-route:focus-within::before { opacity: 1; }
    .vh-route-face { position: relative; z-index: 1; }
    .vh-route-lead {
      display: block; margin-bottom: 8px; font-family: var(--sans);
      font-size: 11px; font-weight: 700; letter-spacing: 0.18em;
      text-transform: uppercase; color: rgba(244,242,241,0.75);
    }
    .vh-route-title {
      margin: 0; font-family: var(--serif); font-weight: 700;
      font-size: clamp(22px, 2.1vw, 31px); line-height: 1.1;
      letter-spacing: -0.05em; color: var(--paper);
    }
    .vh-route-open {
      position: relative; z-index: 1; display: grid; grid-template-rows: 0fr; opacity: 0;
      transition: grid-template-rows 0.5s cubic-bezier(.2,.8,.2,1), opacity 0.35s ease, margin-top 0.5s ease;
    }
    .vh-route:hover .vh-route-open, .vh-route:focus-within .vh-route-open {
      grid-template-rows: 1fr; opacity: 1; margin-top: 14px;
    }
    .vh-route-inner { overflow: hidden; min-height: 0; }
    .vh-route-body {
      margin: 0 0 14px; max-width: 46ch; font-family: var(--sans);
      font-size: 14px; line-height: 1.7; color: rgba(244,242,241,0.88);
    }
    .vh-route-cta {
      display: inline-flex; align-items: center; gap: 9px; background: none; border: 0;
      padding: 0; cursor: pointer; font-family: var(--sans); font-size: 11px;
      font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--paper);
    }

    /* Shared with /services: the ways-in list. Same markup, same rules. */
    /* ===== The ways in — a picture, then the list, sitting low ========== */
    .sm-ctas--stack { flex-direction: column; justify-content: flex-start; gap: clamp(20px, 3vh, 34px); padding: 0 0 var(--page-gutter); box-sizing: border-box; }
    .sm-ways-pic {
      margin: 0; width: 100%; flex: 0 0 auto; height: clamp(300px, 44vh, 460px);
      background-size: cover; background-position: center;
    }

    /* The flat gutter, not clamp(28px,4vw,64px) — that put this list on a
       different line from the bar above it and from page one (Dani, 7 Oct). */
    .sm-ways {
      width: 100%; flex: 1 1 auto; align-content: end; display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
      gap: clamp(32px, 5vw, 96px); align-items: start;
      padding: 0 var(--page-gutter);
    }
    .sm-ways-h {
      margin: 10px 0 14px; font-family: var(--serif); font-weight: 700;
      font-size: clamp(22px, 2.1vw, 31px); line-height: 1.1; letter-spacing: -0.05em; color: var(--ink);
    }
    .sm-ways-note {
      margin: 0; max-width: 42ch;
      font-family: var(--sans); font-size: 13.5px; line-height: 1.7; color: rgba(28,29,34,0.65);
    }
    .sm-ways-list { display: flex; flex-direction: column; }
    .sm-way { border-bottom: 1px solid rgba(28,29,34,0.14); }
    .sm-way:first-child { border-top: 1px solid rgba(28,29,34,0.14); }
    .sm-way-head {
      width: 100%; display: grid; grid-template-columns: minmax(0, 1fr) auto 18px;
      align-items: baseline; gap: 18px; text-align: left;
      background: none; border: 0; padding: 20px 0; cursor: pointer;
    }
    .sm-way-title {
      font-family: var(--sans); font-size: 15px; font-weight: 700;
      letter-spacing: 0.01em; color: var(--ink);
    }
    /* Sits with the sign, not with the paragraph below it. */
    .sm-way-lead { justify-self: end; font-family: var(--sans); font-size: 13.5px; color: rgba(28,29,34,0.55); }
    .sm-way-sign { position: relative; width: 11px; height: 11px; justify-self: end; align-self: center; }
    .sm-way-sign::before, .sm-way-sign::after {
      content: ""; position: absolute; background: rgba(28,29,34,0.5);
      left: 0; top: 5px; width: 11px; height: 1px; transition: transform 0.3s ease;
    }
    .sm-way-sign::after { transform: rotate(90deg); }
    .sm-way.is-open .sm-way-sign::after { transform: rotate(0deg); }
    .sm-way-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.4s cubic-bezier(.2,.8,.2,1); }
    .sm-way.is-open .sm-way-body { grid-template-rows: 1fr; }
    .sm-way-inner { overflow: hidden; display: flex; flex-direction: column; align-items: flex-start; }
    /* Full width of the list. At 75% every row ran a line or two longer than it
       needed to, which is what pushed the last border past the bottom margin. */
    .sm-way-copy {
      margin: 0 0 14px; max-width: none;
      font-family: var(--sans); font-size: 13.5px; line-height: 1.75; color: rgba(28,29,34,0.7);
    }
    .sm-way-cta {
      display: inline-flex; align-items: center; gap: 9px; margin-bottom: 22px;
      /* Left, under the copy. Right-aligned it hung off on its own now that
         every row's sentence fits on one line (Dani, 7 Oct). */
      align-self: flex-start;
      background: none; border: 0; padding: 0; cursor: pointer;
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--english-violet);
      transition: gap 0.25s ease;
    }
    .sm-way-cta:hover { gap: 15px; }
    @media (max-width: 900px) {
      .sm-ways { grid-template-columns: 1fr; gap: 26px; }
      .sm-way-head { grid-template-columns: minmax(0, 1fr) 18px; }
      .sm-way-lead { display: none; }
    }

    /* ===== Our work — one film, inside the margins ===================== */
    .pf-panel.vwork { display: block; padding: 0; }
    .vwork-frame {
      position: relative; margin: 0; height: 100%; box-sizing: border-box;
      padding: var(--page-gutter);
    }
    .vwork-vid {
      display: block; width: 100%; height: 100%;
      object-fit: cover; border-radius: 2px; background: #1a1822;
    }
    .vwork-cap {
      position: absolute; left: calc(var(--page-gutter) + 22px); bottom: calc(var(--page-gutter) + 20px);
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--paper);
    }

    /* ===== Photography's ways in ======================================= */
    /* display/padding live with .pf-final, where both Get Starteds share them. */
    .vpc {
      height: 100%; box-sizing: border-box; padding: var(--page-gutter);
      display: flex; flex-direction: column; justify-content: center; gap: clamp(22px, 4vh, 44px);
    }
    .vpc-h {
      margin: 10px 0 12px; font-family: var(--serif); font-weight: 700;
      font-size: clamp(22px, 2.1vw, 31px); line-height: 1.1;
      letter-spacing: -0.05em; color: var(--ink);
    }
    .vpc-note {
      margin: 0; max-width: 52ch; font-family: var(--sans);
      font-size: 14px; line-height: 1.7; color: rgba(28,29,34,0.7);
    }
    .vpc-row { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .vpc-card {
      display: flex; flex-direction: column; align-items: flex-start; gap: 7px;
      text-align: left; cursor: pointer; background: none;
      border: 1px solid rgba(28,29,34,0.16); border-radius: 2px;
      padding: 22px; transition: border-color 0.25s ease, transform 0.25s ease;
    }
    .vpc-card:hover { border-color: var(--english-violet); transform: translateY(-2px); }
    .vpc-card-t {
      font-family: var(--subhead); font-weight: 700; font-size: 18px;
      letter-spacing: -0.01em; color: var(--english-violet);
    }
    .vpc-card-s { font-family: var(--sans); font-size: 13.5px; color: rgba(28,29,34,0.65); }
    .vpc-cross {
      align-self: flex-start; display: inline-flex; align-items: center; gap: 9px;
      background: none; border: 0; padding: 0; cursor: pointer;
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--english-violet);
      transition: gap 0.25s ease;
    }
    .vpc-cross:hover { gap: 15px; }
    @media (max-width: 900px) { .vpc-row { grid-template-columns: 1fr; } }

    /* ===== Photography — packages left, a picture right ================ */
    .pf-panel.vphoto { display: flex; align-items: stretch; padding: 0; }
    /* Bottom of the column, level with the bottom of the photograph beside it
       — the same line the Get Starteds finish on (Dani, 7 Oct). */
    .vphoto-text {
      flex: 1 1 0; min-width: 0; display: flex; flex-direction: column;
      justify-content: flex-end; gap: clamp(14px, 2vh, 22px);
      padding: var(--page-gutter) clamp(28px, 4vw, 64px) var(--page-gutter) var(--page-gutter);
    }
    .vphoto-lede {
      margin: 0; max-width: none; font-family: var(--sans);
      font-size: 14px; line-height: 1.55; color: rgba(28,29,34,0.72);
    }
    .vphoto-list { display: flex; flex-direction: column; }
    .vphoto-pk { padding: 13px 0; border-bottom: 1px solid rgba(28,29,34,0.14); }
    .vphoto-pk:first-child { border-top: 1px solid rgba(28,29,34,0.14); }
    .vphoto-pk-name {
      margin: 0 0 6px; font-family: var(--subhead); font-weight: 700;
      font-size: clamp(18px, 1.35vw, 21px); line-height: 1.25;
      letter-spacing: -0.01em; color: var(--english-violet);
    }
    .vphoto-pk-meta {
      margin: 0 0 8px; font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet);
    }
    .vphoto-pk-body {
      margin: 0 0 12px; font-family: var(--sans); font-size: 14px;
      line-height: 1.4; color: rgba(28,29,34,0.72);
    }
    .vphoto-media {
      flex: 0 0 42%; align-self: center;
      height: calc(100% - 2 * var(--page-gutter)); margin-right: var(--page-gutter);
      background-size: cover; background-position: center;
      background-color: #e9e4da; border-radius: 2px;
    }

    /* ===== The work — a page of photographs ============================ */
    .pf-panel.vgrid { display: block; padding: 0; }
    .vgrid-inner {
      height: 100%; box-sizing: border-box; padding: var(--page-gutter);
      display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
      grid-auto-rows: 1fr; gap: 10px;
    }
    .vgrid-cell { background-size: cover; background-position: center; background-color: #e9e4da; border-radius: 2px; }
    @media (max-width: 900px) {
      .pf-panel.vphoto { flex-direction: column; }
      .vphoto-media { display: none; }
      .vgrid-inner { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }

    /* ===== Our services — list left, picture right ===================== */
    /* .pf-panel here is not a flex container (only .pf-panel--slide is), so
       this page has to say so itself or the list and the picture stack. */
    .pf-panel.vsvcs { display: flex; align-items: stretch; padding: 0; }
    .vsvcs-text {
      /* basis 0 + min-width 0, or the column sizes to its content and pushes
         the picture past the right edge. */
      flex: 1 1 0; min-width: 0; display: flex; flex-direction: column;
      justify-content: space-between; gap: 18px;
      padding: var(--page-gutter) clamp(28px, 4vw, 64px) var(--page-gutter) var(--page-gutter);
    }
    .vsvcs-list { display: flex; flex-direction: column; }
    .vsvc { padding: 13px 0; border-bottom: 1px solid rgba(28,29,34,0.14); }
    .vsvc:first-child { border-top: 1px solid rgba(28,29,34,0.14); }
    .vsvc-name {
      margin: 0 0 6px; font-family: var(--subhead); font-weight: 700;
      font-size: clamp(18px, 1.35vw, 21px); line-height: 1.25;
      letter-spacing: -0.01em; color: var(--english-violet);
    }
    .vsvc-meta {
      margin: 0 0 8px; font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet);
    }
    .vsvc-body {
      margin: 0 0 12px; font-family: var(--sans); font-size: 14px;
      line-height: 1.4; color: rgba(28,29,34,0.72);
    }
    .vsvc-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; }
    .vsvc-cta {
      display: inline-flex; align-items: center; gap: 9px; background: none; border: 0;
      padding: 0; cursor: pointer; font-family: var(--sans); font-size: 11px;
      font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--english-violet); transition: gap 0.25s ease;
    }
    .vsvc-cta:hover { gap: 15px; }
    /* The Discover link is a small wine chip, pushed to the right of the row,
       so it reads as "there is more behind this" rather than a second link. */
    /* min-width + space-between so Studio, Packages and Agent Edit are all the
       same chip, whatever the word count (Dani, 7 Oct). */
    .vsvc-cta--ghost {
      margin-left: auto; color: var(--paper);
      background: var(--english-violet); border-radius: 2px;
      padding: 8px 14px; font-size: 10px; letter-spacing: 0.16em;
      min-width: 230px; justify-content: space-between;
    }
    .vsvc-cta--ghost:hover { gap: 13px; }
    .vsvcs-media {
      position: relative; flex: 0 0 42%; align-self: center;
      height: calc(100% - 2 * var(--page-gutter)); margin-right: var(--page-gutter);
      overflow: hidden; background: #e9e4da; border-radius: 2px;
    }
    .vsvc-img {
      position: absolute; inset: 0; background-size: cover; background-position: center;
      opacity: 0; transition: opacity 0.6s ease;
    }
    .vsvc-img.is-active { opacity: 1; }
    @media (max-width: 900px) {
      .vh-routes { flex-direction: column; height: auto; }
      .vh-route { min-height: 200px; }
      .vh-route::before { opacity: 1; }
      .vh-route-open { grid-template-rows: 1fr; opacity: 1; margin-top: 12px; }
      .pf-panel.vsvcs { flex-direction: column; }
      .vsvcs-media { display: none; }
    }


    .sm-sitenav { display: none; }
    @media (max-width: 600px) { .pf-top { display: none !important; } .sm-sitenav { display: block; } }
    /* ===== Phones: The Edit's stack ===================================
       The deck is hidden; this is the page. One 100svh screen: the title,
       then three wine bars in the homepage's chapter-line type. A tapped
       bar's section grows to fill the screen (flex-grow does the slide) and
       scrolls inside itself; tap the bar again and the title comes back. */
    .sms { display: none; }
    @media (max-width: 600px) {
      .pf-deck, .pf-counter { display: none !important; }
      .sms {
        --bar: 40px;
        display: flex; flex-direction: column;
        position: fixed; inset: 0; height: 100svh; box-sizing: border-box; padding-top: 68px;
        background: var(--paper); color: var(--ink); font-family: var(--sans);
      }
      .sms-p { display: flex; flex-direction: column; min-height: 0; overflow: hidden; flex: 0 1 var(--bar); transition: flex-grow 0.7s cubic-bezier(.2,.8,.2,1); }
      .sms-p.is-open { flex-grow: 1; }
      .sms-p[data-i="0"] { flex-basis: 0; }
      /* A short grey row under the last bar, half a bar tall, so the stack
         does not sit hard on the browser's own controls. */
      .sms-foot { flex: none; height: 20px; background: var(--paper); }
      .sms-bar {
        flex: none; height: var(--bar); box-sizing: border-box;
        display: grid; grid-template-columns: auto 1fr 14px; align-items: center; gap: 8px;
        padding: 0 22px; border: 0; border-top: 1px solid rgba(244,242,241,0.16);
        background: var(--english-violet); color: var(--paper); cursor: pointer; text-align: left;
        font-family: var(--sans); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase;
      }
      .sms-dash::before { content: "\2014"; }
      .sms-meta { justify-self: end; text-align: right; color: rgba(244,242,241,0.62); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
      .sms-chev { justify-self: end; font-size: 10px; color: rgba(244,242,241,0.62); transition: transform 0.4s ease; }
      .sms-p.is-open .sms-chev { transform: rotate(180deg); }
      .sms-body { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: 24px 22px 32px; -webkit-overflow-scrolling: touch; touch-action: pan-y; }
      .sms-body--flush { padding: 0; overflow: hidden; }
      /* The title screen, on the About page's line. */
      .sms-title { padding-top: 24px; display: flex; flex-direction: column; }
      .sms-row { margin-top: auto; padding-top: 28px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
      .sms-row-tile { display: block; aspect-ratio: 3 / 4; background-size: cover; background-position: center; background-color: #e9e4da; box-shadow: inset 0 0 0 1px rgba(28,29,34,0.14); }
      .sms-p[data-i="1"] .sms-body { padding-top: 64px; }
      /* Get in touch, as on Social Media: three short blocks, each action's
         line the full width, the copy close above it. */
      .sms-p[data-i="4"] .sms-block { margin-bottom: 22px; }
      .sms-p[data-i="4"] .sms-h { font-size: 20px; margin-bottom: 6px; }
      .sms-p[data-i="4"] .sms-p-copy { margin-bottom: 0; }
