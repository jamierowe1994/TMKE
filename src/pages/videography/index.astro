---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DiscoveryPanel from "../../components/DiscoveryPanel.astro";
import VideoShowcase from "../../components/VideoShowcase.astro";
import { PRODUCTS, tierPrice } from "../../data/videography.js";
import { gbpFromPence } from "../../lib/supabase.js";

const pad2 = (n) => String(n + 1).padStart(2, "0");
// Deck panels: intro + one per product + closing booking panel.
const total = PRODUCTS.length + 2;

// Opening + closing imagery — the site's own on-brand R2 stills.
const R2 = (name) => `https://assets.tmke.co.uk/${name}.webp`;

// Booking data passed to the wizard (DiscoveryPanel) via data attributes.
const packsOf = (p) => p.priceTiers.map((t) => ({ label: t.label, minutes: t.minutes, price: gbpFromPence(tierPrice(t, "direct")) }));
const packsJSON = (p) => JSON.stringify(packsOf(p));
const interestsJSON = JSON.stringify(PRODUCTS.map((p) => p.name));
const servicesJSON = JSON.stringify(PRODUCTS.map((p) => ({ name: p.name, packs: packsOf(p) })));
const INTRO_IMG = R2("vibes");
const CLOSING_IMG = R2("living-2");

const navLinks = [
  { label: "About", href: "/about" },
  { label: "Social Media", href: "/services" },
  { label: "Videography", href: "/videography", current: true },
  { label: "The Edit", href: "/edit" },
  { label: "Insights", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
---

<BaseLayout
  title="Videography — TMKE"
  description="In-house property videography — podcast studio, personal branded content, property tours, photography and headshots. A scroll-through showcase of our work, produced and delivered by TMKE."
  hideNav
  hideFooter
>
  <div class="pf">
    <!-- Top nav — TMKE (left) + Menu (right); hover the top strip to reveal links. -->
    <header class="pf-top" id="pf-top">
      <a href="/" class="pf-top-logo">TMKE</a>
      <nav class="pf-top-links" aria-label="Primary">
        {navLinks.map((l) => (
          <a href={l.href} class:list={[l.current && "is-current"]}>{l.label}</a>
        ))}
        <a href="/login" class="pf-top-login">Login</a>
      </nav>
      <button type="button" class="pf-top-menu" id="pf-top-menu" aria-label="Show menu">Menu</button>
    </header>

    <!-- Horizontal deck — each panel is one "page"; scroll right to advance. -->
    <div class="pf-deck" id="pf-deck">
      <!-- Intro panel (same split layout as the rest) -->
      <section class="pf-panel pf-panel--slide pf-panel--statement">
        <div class="pf-panel-text">
          <p class="pf-eyebrow">— In-house film team</p>
          <h1 class="pf-statement-h">Property,<br /><em>in&nbsp;motion.</em></h1>
          <p class="pf-statement-sub">Jack and the team shoot, edit and deliver everything under one roof — consistent, on-brand, and handled. Scroll through the work.</p>
          <div class="pf-partner" id="vid-partner-banner" hidden><span id="vid-partner-text"></span></div>
          <span class="pf-scroll-hint" aria-hidden="true">Scroll <em>&rarr;</em></span>
        </div>
        <div class="pf-panel-img" style={`background-image:url('${INTRO_IMG}')`}></div>
      </section>

      <!-- Product panels — wording (left) + image (right) -->
      {PRODUCTS.map((p, i) => (
        <section class="pf-panel pf-panel--slide">
          <div class="pf-panel-text">
            <span class="pf-panel-cat">Videography — {pad2(i)}</span>
            <h2 class="pf-panel-title">{p.name}</h2>
            <p class="pf-panel-copy">{p.tagline}</p>
            <div class="pf-panel-meta">
              <span class="pf-panel-price">from <strong data-price-svc={p.slug} data-tier="0">{gbpFromPence(tierPrice(p.priceTiers[0], "direct"))}</strong></span>
            </div>
            <button type="button" class="pf-cta" data-open={p.slug}>See showcase <em>&rarr;</em></button>
          </div>
          <button
            type="button"
            class="pf-panel-img"
            data-open={p.slug}
            style={`background-image:url('${p.hero}')`}
            aria-label={`See showcase — ${p.name}`}
          ></button>
        </section>
      ))}

      <!-- Closing panel — two booking cards + a slide-in newsletter reveal -->
      <section class="pf-panel pf-final" id="pf-final">
        <div class="pf-final-track" id="pf-final-track">
          <article class="pf-cta-card">
            <div class="pf-cta-img" style={`background-image:url('${R2("living-1")}')`}></div>
            <div class="pf-cta-head">
              <h2 class="pf-cta-title">Book a consultation</h2>
              <span class="pf-cta-meta">With Jack</span>
            </div>
            <p class="pf-cta-desc">A relaxed call to talk through your goals, your patch and what you want your content to do — then we'll map out a plan.</p>
            <button type="button" data-discovery-call data-dc-mode="consult" data-dc-interests={interestsJSON} class="pf-cta-btn">Book a consultation <span class="btn-arrow">&rarr;</span></button>
          </article>

          <article class="pf-cta-card">
            <div class="pf-cta-img" style={`background-image:url('${R2("table")}')`}></div>
            <div class="pf-cta-head">
              <h2 class="pf-cta-title">Book a shoot</h2>
              <span class="pf-cta-meta">A day with the team</span>
            </div>
            <p class="pf-cta-desc">Lock in a shoot day — studio, property tour, headshots or branded content — and we'll handle it end to end, from setup to delivery.</p>
            <button type="button" data-discovery-call data-dc-mode="shoot" data-dc-services={servicesJSON} class="pf-cta-btn">Book a shoot <span class="btn-arrow">&rarr;</span></button>
          </article>

          <aside class="pf-news" aria-label="Newsletter sign-up">
            <h2 class="pf-news-title">Sign up for our<br />newsletter</h2>
            <form class="pf-news-form" id="pf-news-form" novalidate>
              <input type="text" name="first" placeholder="First name" autocomplete="given-name" />
              <input type="text" name="last" placeholder="Surname" autocomplete="family-name" />
              <input type="email" name="email" placeholder="Email" autocomplete="email" required />
              <button type="submit" class="pf-news-send">Send <span class="btn-arrow">&rarr;</span></button>
            </form>
            <div class="pf-news-meta">
              <span>Follow us</span>
              <a href="https://instagram.com/" target="_blank" rel="noopener">@tmke</a>
            </div>
          </aside>
        </div>

        <button type="button" class="pf-reveal-tab" id="pf-reveal-tab" aria-label="Reveal newsletter">
          <span class="pf-reveal-arrow" aria-hidden="true">&rarr;</span>
        </button>
      </section>
    </div>

    <!-- Counter -->
    <div class="pf-counter"><span id="pf-cur">01</span> <span class="pf-counter-sep">/</span> {String(total).padStart(2, "0")}</div>
  </div>

  <!-- ============ SHOWCASE POP-UPS (inset modal; sticky image + scrolling info) ============ -->
  <div class="vmodal-scrim" id="vmodal-scrim" hidden></div>
  <button type="button" class="vmodal-x" id="vmodal-x" data-close aria-label="Close" hidden>&times;</button>
  {PRODUCTS.map((p) => (
    <section
      class="vdraw"
      data-product={p.slug}
      data-from="bottom"
      role="dialog"
      aria-modal="true"
      aria-label={p.name}
      hidden
    >
      <div class="vdraw-scroll">
        <div class="vdraw-grid">
          <!-- LEFT (40%): scrolling info — title, summary, included, pricing, bio -->
          <div class="vdraw-left">
            <div class="vmodal-eyebrow">Videography</div>
            <h2 class="vmodal-title">{p.name}</h2>
            <p class="vmodal-tagline">{p.tagline}</p>
            <p class="vmodal-summary">{p.summary}</p>

            <h3 class="vmodal-sub">What's included</h3>
            <ul class="vmodal-included">
              {p.included.map((d) => <li>{d}</li>)}
            </ul>

            <div class="vmodal-price-card">
              <div class="vmodal-price-tiers">
                {p.priceTiers.map((t, i) => (
                  <div class="vmodal-tier">
                    <span class="vmodal-tier-label">{t.label}</span>
                    <span class="vmodal-tier-price" data-price-svc={p.slug} data-tier={i}>{gbpFromPence(tierPrice(t, "direct"))}</span>
                  </div>
                ))}
              </div>
              <div class="vmodal-price-note" data-note-svc={p.slug}>Standard rates</div>
              <button type="button" data-discovery-call data-dc-mode="shoot" data-dc-service={p.name} data-dc-packs={packsJSON(p)} class="btn btn--solid vmodal-book">
                {p.bookable ? "Book this" : "Enquire about availability"} <span class="btn-arrow">&rarr;</span>
              </button>
              <button type="button" data-discovery-call data-dc-mode="consult" data-dc-interests={interestsJSON} class="vmodal-consult">
                Not quite sure about something? <strong>Book a consultation call.</strong>
              </button>
              <p class="vmodal-fine">Final quote confirmed after a quick call — travel &amp; extras itemised separately.</p>
            </div>

            <h3 class="vmodal-sub">About</h3>
            <p class="vmodal-bio">Placeholder bio — a couple of lines on the team, kit and approach behind {p.name}. We'll write this properly once the real copy lands.</p>

            {p.showcase && p.showcase.length > 0 && (
              <VideoShowcase heading="Recent work" items={p.showcase} />
            )}
          </div>

          <!-- RIGHT (60%): sticky, auto-rotating image + showcase thumbnails -->
          <div class="vdraw-right">
            <div class="vdraw-stage">
              <div class="vdraw-hero-img is-active" style={`background-image:url('${(p.gallery && p.gallery[0]) || p.hero}')`}></div>
              <div class="vdraw-hero-img"></div>
              {p.gallery && p.gallery.length > 1 && (
                <div class="vmodal-nav">
                  <button type="button" class="vmodal-arrow" data-dir="-1" aria-label="Previous photo">&larr;</button>
                  <span class="vmodal-count"><b class="vmodal-count-cur">1</b> / {p.gallery.length}</span>
                  <button type="button" class="vmodal-arrow" data-dir="1" aria-label="Next photo">&rarr;</button>
                </div>
              )}
            </div>
            {p.gallery && p.gallery.length > 0 && (
              <div class="vmodal-gallery">
                {p.gallery.map((src, i) => (
                  <button type="button" class={`vmodal-thumb ${i === 0 ? "is-active" : ""}`} data-full={src} style={`background-image:url('${src}')`} aria-label={`View photo ${i + 1}`}></button>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  ))}

  <DiscoveryPanel />

  <style>
    .pf {
      position: fixed; inset: 0;
      background: var(--paper);
      color: var(--ink);
      overflow: hidden;
    }

    /* ---- Horizontal deck ---- */
    .pf-deck {
      display: flex;
      height: 100vh;
      width: 100%;
      overflow-x: auto;
      overflow-y: hidden;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .pf-deck::-webkit-scrollbar { display: none; }
    .pf-panel {
      flex: 0 0 100vw;
      width: 100vw;
      height: 100vh;
      scroll-snap-align: start;
      scroll-snap-stop: always;
    }

    /* ---- Shared slide layout: wording (left) + image (right) ---- */
    .pf-panel--slide { display: flex; }
    .pf-panel-text {
      width: 42%; min-width: 340px;
      padding: 0 56px 72px 40px;
      display: flex; flex-direction: column; justify-content: flex-end;
    }
    .pf-panel-img {
      flex: 1; align-self: stretch; border: none; padding: 0;
      margin: 30px 30px 30px 0;
      background-size: cover; background-position: center;
      background-color: #e9e4da;
    }
    button.pf-panel-img { cursor: pointer; }

    /* Statement panels (intro + closing) — larger type, same column */
    .pf-eyebrow {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--english-violet); margin: 0 0 24px;
    }
    .pf-statement-h {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(38px, 3.8vw, 54px); line-height: 1.04;
      letter-spacing: -0.02em; margin: 0 0 24px;
    }
    .pf-statement-h em { font-style: italic; color: var(--english-violet); }
    .pf-statement-sub {
      font-family: var(--sans); font-size: 16px;
      line-height: 1.6; color: rgba(28,29,34,0.7); max-width: 52ch; margin: 0 0 36px;
    }
    .pf-scroll-hint {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.24em; text-transform: uppercase; color: rgba(28,29,34,0.5);
    }
    .pf-scroll-hint em { font-style: normal; margin-left: 8px; }
    .pf-book { align-self: flex-start; }
    .pf-partner { margin: 0 0 32px; }
    .pf-partner[hidden] { display: none; }
    #vid-partner-text {
      display: inline-flex; align-items: center; gap: 10px; padding: 9px 16px;
      border-radius: 999px; background: rgba(71, 66, 84, 0.1); color: var(--english-violet);
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
    }

    /* Product slides */
    .pf-panel-cat {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--english-violet); margin-bottom: 18px;
    }
    .pf-panel-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(38px, 3.8vw, 54px); line-height: 1.04;
      letter-spacing: -0.02em; margin: 0 0 20px;
    }
    .pf-panel-copy {
      font-family: var(--sans); font-size: 16px; line-height: 1.6;
      color: rgba(28,29,34,0.7); max-width: 52ch; margin: 0 0 24px;
    }
    .pf-panel-meta { margin-bottom: 26px; }
    .pf-panel-price { font-family: var(--sans); font-size: 13px; letter-spacing: 0.04em; color: rgba(28,29,34,0.6); }
    .pf-panel-price strong { font-family: var(--serif); font-size: 24px; font-weight: 500; color: var(--ink); margin-left: 4px; }
    .pf-cta {
      align-self: flex-start; background: none; border: none; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);
      padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.25);
      transition: color 0.25s, border-color 0.25s;
    }
    .pf-cta em { font-style: normal; margin-left: 10px; transition: margin 0.25s; display: inline-block; }
    .pf-cta:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .pf-cta:hover em { margin-left: 16px; }

    /* ---- Final panel: two booking cards + slide-in newsletter ---- */
    .pf-final { position: relative; overflow: hidden; }
    .pf-final-track {
      display: flex; height: 100%; width: max-content;
      transition: transform 0.75s cubic-bezier(.16,1,.3,1);
      will-change: transform;
    }
    .pf-cta-card {
      flex: 0 0 50vw; height: 100%;
      display: flex; flex-direction: column; justify-content: center; align-items: flex-start;
      gap: 22px; padding: 96px 48px 56px;
    }
    .pf-cta-card:first-child { padding-left: 40px; }
    .pf-cta-img {
      width: 100%; max-width: 360px; height: 52vh;
      background-size: cover; background-position: center; background-color: #e9e4da;
    }
    .pf-cta-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; width: 100%; max-width: 360px; }
    .pf-cta-title { font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 2.4vw, 40px); letter-spacing: -0.02em; margin: 0; }
    .pf-cta-meta { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.5); white-space: nowrap; }
    .pf-cta-desc { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(28,29,34,0.7); max-width: 360px; margin: 0; }
    .pf-cta-btn {
      align-self: flex-start; background: none; border: none; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--ink); padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.25);
      transition: color .25s, border-color .25s;
    }
    .pf-cta-btn:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .pf-cta-btn .btn-arrow { margin-left: 10px; display: inline-block; transition: margin .25s; }
    .pf-cta-btn:hover .btn-arrow { margin-left: 16px; }

    /* Newsletter footer (revealed by the tab) */
    .pf-news {
      flex: 0 0 40vw; height: 100%;
      background: var(--english-violet); color: var(--paper);
      display: flex; flex-direction: column; justify-content: center;
      gap: 28px; padding: 96px clamp(40px,4vw,72px) 56px;
    }
    .pf-news-title { font-family: var(--serif); font-weight: 400; font-size: clamp(30px, 2.8vw, 46px); line-height: 1.05; letter-spacing: -0.02em; margin: 0; }
    .pf-news-form { display: flex; flex-direction: column; gap: 20px; max-width: 380px; }
    .pf-news-form input {
      background: none; border: none; border-bottom: 1px solid rgba(240,238,235,0.4);
      color: var(--paper); font-family: var(--sans); font-size: 13px; letter-spacing: 0.12em;
      text-transform: uppercase; padding: 10px 0;
    }
    .pf-news-form input::placeholder { color: rgba(240,238,235,0.55); }
    .pf-news-form input:focus { outline: none; border-bottom-color: var(--paper); }
    .pf-news-send {
      margin-top: 10px; align-self: flex-start; background: var(--paper); color: var(--ink);
      border: none; cursor: pointer; font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; padding: 14px 30px; transition: opacity .25s;
    }
    .pf-news-send:hover { opacity: 0.85; }
    .pf-news-send .btn-arrow { margin-left: 10px; }
    .pf-news-meta { font-family: var(--sans); font-size: 12px; letter-spacing: 0.08em; color: rgba(240,238,235,0.7); display: flex; gap: 14px; }
    .pf-news-meta a { color: var(--paper); }

    /* Reveal tab — a handle on the right edge that slides the newsletter in */
    .pf-reveal-tab {
      position: absolute; top: 50%; right: 0; transform: translateY(-50%);
      z-index: 6; width: 40px; height: 104px; border: none; cursor: pointer;
      background: var(--english-violet); color: var(--paper);
      border-radius: 10px 0 0 10px; display: flex; align-items: center; justify-content: center;
      transition: right 0.75s cubic-bezier(.16,1,.3,1), background .25s;
    }
    .pf-reveal-tab:hover { background: var(--ink); }
    .pf-reveal-arrow { font-size: 18px; transition: transform .5s cubic-bezier(.16,1,.3,1); }
    .pf-final.is-revealed .pf-reveal-arrow { transform: rotate(180deg); }

    @media (max-width: 760px) {
      .pf-cta-card { flex: 0 0 100vw; padding: 90px 28px 40px; }
      .pf-cta-card:first-child { padding-left: 28px; }
      .pf-cta-img { max-width: none; height: 46vh; }
      .pf-news { flex: 0 0 100vw; padding: 90px 28px 40px; }
    }

    /* ---- Top nav (logo left, Menu right; hover the strip to reveal links) ---- */
    .pf-top {
      position: fixed; top: 0; left: 0; right: 0; z-index: 60;
      display: flex; align-items: flex-start; justify-content: space-between;
      padding: 22px 40px;
      min-height: 78px;
      transition: background 0.35s ease, backdrop-filter 0.35s ease, border-color 0.35s ease;
      border-bottom: 1px solid transparent;
    }
    .pf-top:hover, .pf-top.is-open {
      background: rgba(242, 239, 233, 0.92);
      backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
      border-bottom-color: rgba(28,29,34,0.08);
    }
    body.pf-modal-open .pf-top { pointer-events: none; }
    .pf-top-logo {
      font-family: var(--serif); font-size: 22px; letter-spacing: 0.08em;
      color: var(--ink); line-height: 1; position: relative; z-index: 2;
    }
    .pf-top-menu {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink);
      background: none; border: none; cursor: pointer; padding: 4px 0; line-height: 1;
      position: relative; z-index: 2; transition: opacity 0.25s;
    }
    .pf-top:hover .pf-top-menu, .pf-top.is-open .pf-top-menu { opacity: 0; }
    .pf-top-links {
      position: absolute; left: 50%; top: 0; transform: translateX(-50%);
      min-height: 78px; display: flex; align-items: center; gap: 30px;
      opacity: 0; pointer-events: none; transition: opacity 0.3s ease;
    }
    .pf-top:hover .pf-top-links, .pf-top.is-open .pf-top-links { opacity: 1; pointer-events: auto; }
    body.pf-modal-open .pf-top-links { opacity: 0 !important; pointer-events: none !important; }
    .pf-top-links a {
      font-family: var(--sans); font-size: 14px; font-weight: 500; color: var(--ink); white-space: nowrap;
    }
    .pf-top-links a:hover { color: var(--english-violet); }
    .pf-top-links a.is-current { color: var(--english-violet); font-weight: 700; }
    .pf-top-login {
      font-weight: 700 !important; letter-spacing: 0.14em; text-transform: uppercase; font-size: 12px !important;
    }

    /* ---- Counter ---- */
    .pf-counter {
      position: fixed; right: 36px; bottom: 30px; z-index: 55;
      font-family: var(--sans); font-size: 13px; font-weight: 700;
      letter-spacing: 0.18em; color: rgba(28,29,34,0.6);
    }
    .pf-counter-sep { margin: 0 6px; opacity: 0.5; }

    @media (max-width: 760px) {
      .pf-panel--slide { flex-direction: column; }
      .pf-panel-text { width: 100%; min-width: 0; padding: 80px 28px 36px; justify-content: flex-end; }
      .pf-panel-img { width: auto; flex: 1; margin: 0 16px 16px; }
      .pf-top { padding: 18px 22px; min-height: 64px; }
      .pf-top-links { display: none; }
    }

    /* ===================== Showcase pop-up (inset modal) ===================== */
    .vmodal-scrim { position: fixed; inset: 0; z-index: 290; background: rgba(16, 14, 22, 0.62); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); opacity: 0; transition: opacity 0.6s ease; }
    .vmodal-scrim[hidden] { display: none; }
    .vmodal-scrim.is-open { opacity: 1; }

    /* Bottom sheet — full width, flush to the bottom, gap at the top so the
       page shows above it. Rises from the bottom edge of the screen. */
    .vdraw {
      position: fixed; top: 30px; left: 30px; right: 30px; bottom: 0; z-index: 300;
      background: var(--paper); border-radius: 18px 18px 0 0; overflow: hidden;
      box-shadow: 0 -24px 90px rgba(16, 14, 22, 0.42);
      transform: translateY(100%);
      transition: transform 0.85s cubic-bezier(.16,1,.3,1);
      will-change: transform;
    }
    .vdraw[hidden] { display: none; }
    .vdraw.is-open { transform: translateY(0); }
    .vdraw-scroll { height: 100%; overflow: hidden; }

    /* 40 / 60 — wording left, photo right; both fill the sheet height */
    .vdraw-grid { display: grid; grid-template-columns: 40% 60%; height: 100%; }

    /* LEFT — the ONLY scrolling area (right stays fixed) */
    .vdraw-left {
      height: 100%; overflow-y: auto; overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch; scrollbar-width: none; -ms-overflow-style: none;
      padding: clamp(40px, 4vw, 76px) clamp(34px, 3.4vw, 64px);
    }
    .vdraw-left::-webkit-scrollbar { width: 0; height: 0; display: none; }
    .vmodal-eyebrow { font-family: var(--sans); font-size: 11px; letter-spacing: 0.28em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); margin-bottom: 14px; }
    .vmodal-title { font-family: var(--serif); font-weight: 400; font-size: clamp(36px, 3.6vw, 60px); line-height: 1.02; letter-spacing: -0.02em; margin: 0 0 12px; color: var(--ink); }
    .vmodal-tagline { font-family: var(--serif); font-style: italic; font-size: clamp(18px, 1.8vw, 26px); color: var(--english-violet); margin: 0 0 28px; }
    .vmodal-summary { font-family: var(--sans); font-size: clamp(16px, 1.2vw, 18px); line-height: 1.6; color: rgba(28,29,34,0.78); margin: 0 0 40px; }
    .vmodal-sub { font-family: var(--sans); font-weight: 700; font-size: 13px; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink); margin: 0 0 18px; }
    .vmodal-included { list-style: none; padding: 0; margin: 0 0 40px; display: grid; gap: 12px; }
    .vmodal-included li { display: grid; grid-template-columns: 22px 1fr; gap: 12px; align-items: baseline; font-family: var(--sans); font-size: 15px; color: rgba(28,29,34,0.8); }
    .vmodal-included li::before { content: "→"; font-family: var(--serif); font-style: italic; color: var(--english-violet); font-size: 17px; }
    .vmodal-price-card { border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; padding: 26px 26px 24px; margin-bottom: 40px; }
    .vmodal-price-tiers { display: grid; gap: 12px; }
    .vmodal-tier { display: flex; justify-content: space-between; align-items: baseline; padding-bottom: 12px; border-bottom: 1px solid rgba(28,29,34,0.1); }
    .vmodal-tier:last-child { border-bottom: none; padding-bottom: 0; }
    .vmodal-tier-label { font-family: var(--sans); font-size: 13px; letter-spacing: 0.04em; color: rgba(28,29,34,0.7); font-weight: 600; }
    .vmodal-tier-price { font-family: var(--serif); font-size: 28px; font-weight: 500; color: var(--ink); }
    .vmodal-price-note { font-family: var(--sans); font-size: 12px; color: var(--english-violet); font-weight: 700; letter-spacing: 0.04em; margin: 16px 0 20px; }
    .vmodal-book { width: 100%; justify-content: center; }
    .vmodal-consult { display: block; width: 100%; margin-top: 12px; background: none; border: none; cursor: pointer; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); text-align: center; padding: 4px 0; transition: color .2s; }
    .vmodal-consult strong { color: var(--english-violet); font-weight: 700; }
    .vmodal-consult:hover { color: var(--ink); }
    .vmodal-consult:hover strong { text-decoration: underline; }
    .vmodal-fine { font-family: var(--sans); font-size: 12px; line-height: 1.55; color: rgba(28,29,34,0.55); margin: 14px 0 0; }
    .vmodal-bio { font-family: var(--sans); font-size: 15px; line-height: 1.65; color: rgba(28,29,34,0.72); margin: 0 0 8px; }
    .vdraw-left :global(.vshow) { padding: 32px 0 0; }
    .vdraw-left :global(.vshow-heading) { font-size: clamp(20px, 2vw, 26px); margin-bottom: 18px; }

    /* RIGHT — sticky image + showcase thumbnails */
    .vdraw-right {
      height: 100%;
      display: flex; flex-direction: column;
      background: #e9e4da;
    }
    .vdraw-stage { position: relative; flex: 1; overflow: hidden; }
    .vdraw-hero-img { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 0; transition: opacity 0.8s ease; }
    .vdraw-hero-img.is-active { opacity: 1; }
    .vmodal-nav { position: absolute; right: 18px; bottom: 18px; z-index: 4; display: flex; align-items: center; gap: 2px; padding: 5px; border-radius: 999px; background: rgba(16,14,22,0.42); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); }
    .vmodal-arrow { width: 34px; height: 34px; border-radius: 50%; border: none; background: transparent; color: var(--paper); font-size: 15px; line-height: 1; cursor: pointer; transition: background 0.2s; }
    .vmodal-arrow:hover { background: rgba(255,255,255,0.2); }
    .vmodal-count { font-family: var(--sans); font-size: 12px; font-weight: 600; letter-spacing: 0.08em; color: var(--paper); padding: 0 8px; min-width: 44px; text-align: center; }
    .vmodal-count b { font-weight: 700; }
    .vmodal-gallery { flex: 0 0 auto; display: flex; gap: 10px; padding: 14px; background: rgba(28,29,34,0.05); overflow-x: auto; scrollbar-width: none; }
    .vmodal-gallery::-webkit-scrollbar { display: none; }
    .vmodal-thumb { flex: 0 0 116px; height: 82px; border-radius: 4px; border: 2px solid transparent; cursor: pointer; background-size: cover; background-position: center; padding: 0; transition: border-color 0.25s, transform 0.25s; }
    .vmodal-thumb:hover { transform: translateY(-2px); }
    .vmodal-thumb.is-active { border-color: var(--english-violet); }

    .vmodal-x { position: fixed; top: 48px; right: 48px; z-index: 320; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(240, 238, 235, 0.55); background: rgba(16, 14, 22, 0.35); color: var(--paper); font-size: 30px; line-height: 1; cursor: pointer; backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px); transition: background 0.25s, transform 0.4s, opacity 0.4s; }
    .vmodal-x[hidden] { display: none; }
    .vmodal-x:hover { background: var(--english-violet); border-color: var(--english-violet); transform: rotate(90deg); }

    @media (max-width: 900px) {
      .vdraw { top: 16px; left: 16px; right: 16px; }
      .vdraw-scroll { overflow-y: auto; }
      .vdraw-grid { grid-template-columns: 1fr; height: auto; }
      .vdraw-left { height: auto; overflow: visible; }
      .vdraw-right { height: 56vh; order: -1; }
      .vmodal-x { top: 28px; right: 24px; }
    }
  </style>

  <!-- Deck controller + partner pricing + showcase pop-ups. Lenis is stopped on
       this page so it doesn't fight the horizontal scroll. -->
  <script>
    import { PRODUCTS, tierPrice, resolvePartnerSlug, getPartner } from "../../data/videography.js";
    import { gbpFromPence } from "../../lib/supabase.js";

    const slug = resolvePartnerSlug();
    const partner = getPartner(slug);

    // --- Partner pricing ---
    (function applyPartnerPricing() {
      PRODUCTS.forEach((p) => {
        p.priceTiers.forEach((t, i) => {
          document.querySelectorAll(`[data-price-svc="${p.slug}"][data-tier="${i}"]`).forEach((el) => {
            el.textContent = gbpFromPence(tierPrice(t, slug));
          });
        });
        const note = document.querySelector(`[data-note-svc="${p.slug}"]`);
        if (note) note.textContent = partner.note;
      });
      if (slug !== "direct") {
        const banner = document.getElementById("vid-partner-banner");
        const text = document.getElementById("vid-partner-text");
        if (banner && text) { text.textContent = `${partner.name} · ${partner.note}`; banner.hidden = false; }
      }
    })();

    // --- Showcase pop-ups ---
    const scrim = document.getElementById("vmodal-scrim");
    const closeX = document.getElementById("vmodal-x");
    let openSlug = null;
    let closeTimer = null;

    function openProduct(s) {
      const draw = document.querySelector(`.vdraw[data-product="${s}"]`);
      if (!draw || !scrim) return;
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      openSlug = s;
      scrim.hidden = false;
      draw.hidden = false;
      if (draw.__resetScroll) draw.__resetScroll();
      document.documentElement.style.overflow = "hidden";
      document.body.classList.add("pf-modal-open");
      if (closeX) closeX.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        scrim.classList.add("is-open");
        draw.classList.add("is-open");
      }));
      draw.__galIdx = 0;
      startRotation(draw); // begin the 5s auto-rotate
      if (location.hash !== `#${s}`) history.replaceState(null, "", `#${s}`);
    }

    function closeProduct() {
      if (!openSlug || !scrim) return;
      const draw = document.querySelector(`.vdraw[data-product="${openSlug}"]`);
      stopRotation();
      scrim.classList.remove("is-open");
      if (draw) draw.classList.remove("is-open");
      if (closeX) closeX.hidden = true;
      document.documentElement.style.overflow = "";
      document.body.classList.remove("pf-modal-open");
      closeTimer = setTimeout(() => { scrim.hidden = true; if (draw) draw.hidden = true; }, 880);
      openSlug = null;
      if (location.hash) history.replaceState(null, "", location.pathname + location.search);
    }

    function bindOpen(el) {
      el.addEventListener("click", (e) => { e.stopPropagation(); openProduct(el.getAttribute("data-open")); });
    }
    document.querySelectorAll("[data-open]").forEach(bindOpen);
    document.querySelectorAll("[data-close]").forEach((btn) => btn.addEventListener("click", closeProduct));
    scrim?.addEventListener("click", closeProduct);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && openSlug) closeProduct(); });

    // Booking from inside a showcase: slide the showcase down and out of the
    // way first, THEN bring the discovery diary in on top. Capture phase
    // pre-empts DiscoveryPanel's own opener so the two don't stack.
    document.addEventListener("click", (e) => {
      const btn = e.target.closest && e.target.closest("[data-discovery-call]");
      if (!btn || !openSlug) return; // only intercept while a showcase is open
      e.preventDefault();
      e.stopImmediatePropagation();
      const opts = {
        mode: btn.getAttribute("data-dc-mode") || undefined,
        service: btn.getAttribute("data-dc-service") || undefined,
        duration: btn.getAttribute("data-dc-duration") || undefined,
        packs: btn.getAttribute("data-dc-packs") || undefined,
        services: btn.getAttribute("data-dc-services") || undefined,
        interests: btn.getAttribute("data-dc-interests") || undefined,
      };
      closeProduct();
      setTimeout(() => {
        if (typeof window.tmkeDiscoveryOpen === "function") window.tmkeDiscoveryOpen(opts);
      }, 720);
    }, true);

    // --- Top nav: click "Menu" toggles links (touch); hover handles desktop ---
    const topBar = document.getElementById("pf-top");
    const topMenu = document.getElementById("pf-top-menu");
    if (topBar && topMenu) {
      topMenu.addEventListener("click", (e) => {
        e.stopPropagation();
        if (openSlug) return; // no menu while a showcase is open
        topBar.classList.toggle("is-open");
      });
      document.addEventListener("click", (e) => {
        if (!topBar.contains(e.target)) topBar.classList.remove("is-open");
      });
    }

    // --- Showcase gallery: crossfade hero, auto-rotate, arrows + thumbs ---
    const ROTATE_MS = 5000;
    let galTimer = null;

    function setGalleryIndex(draw, i) {
      const thumbs = draw.querySelectorAll(".vmodal-thumb");
      const n = thumbs.length;
      if (!n) return;
      i = ((i % n) + n) % n;
      const stage = draw.querySelector(".vdraw-stage");
      const layers = stage.querySelectorAll(".vdraw-hero-img");
      const full = thumbs[i].getAttribute("data-full");
      const active = stage.querySelector(".vdraw-hero-img.is-active") || layers[0];
      const next = active === layers[0] ? layers[1] : layers[0];
      next.style.backgroundImage = `url('${full}')`;
      next.classList.add("is-active");
      active.classList.remove("is-active");
      thumbs.forEach((t) => t.classList.remove("is-active"));
      thumbs[i].classList.add("is-active");
      const gal = draw.querySelector(".vmodal-gallery");
      if (gal) {
        const th = thumbs[i];
        gal.scrollTo({ left: th.offsetLeft - gal.clientWidth / 2 + th.clientWidth / 2, behavior: "smooth" });
      }
      const cur = draw.querySelector(".vmodal-count-cur");
      if (cur) cur.textContent = String(i + 1);
      draw.__galIdx = i;
    }

    function stopRotation() { if (galTimer) { clearInterval(galTimer); galTimer = null; } }
    function startRotation(draw) {
      stopRotation();
      if (draw.querySelectorAll(".vmodal-thumb").length <= 1) return;
      galTimer = setInterval(() => setGalleryIndex(draw, (draw.__galIdx || 0) + 1), ROTATE_MS);
    }

    // Smooth-scroll the LEFT info column from ANYWHERE in the modal (over the
    // text or the image), with a rAF lerp so it matches the site's smooth feel
    // and never depends on what the cursor is hovering.
    document.querySelectorAll(".vdraw").forEach((draw) => {
      const left = draw.querySelector(".vdraw-left");
      if (!left) return;
      let target = 0, current = 0, raf = null;
      const maxScroll = () => Math.max(0, left.scrollHeight - left.clientHeight);
      const tick = () => {
        current += (target - current) * 0.14;
        if (Math.abs(target - current) < 0.4) current = target;
        left.scrollTop = current;
        raf = current !== target ? requestAnimationFrame(tick) : null;
      };
      draw.addEventListener("wheel", (e) => {
        if (window.innerWidth <= 900) return; // mobile: native touch scroll
        e.preventDefault();
        target = Math.max(0, Math.min(maxScroll(), target + e.deltaY));
        if (!raf) raf = requestAnimationFrame(tick);
      }, { passive: false });
      draw.__resetScroll = () => {
        target = 0; current = 0; left.scrollTop = 0;
        if (raf) { cancelAnimationFrame(raf); raf = null; }
      };
    });

    document.querySelectorAll(".vmodal-arrow").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const draw = btn.closest(".vdraw");
        const dir = parseInt(btn.getAttribute("data-dir"), 10) || 1;
        setGalleryIndex(draw, (draw.__galIdx || 0) + dir);
        startRotation(draw); // reset the 5s timer after a manual step
      });
    });
    document.querySelectorAll(".vmodal-thumb").forEach((thumb) => {
      thumb.addEventListener("click", (e) => {
        e.stopPropagation();
        const draw = thumb.closest(".vdraw");
        const thumbs = Array.from(draw.querySelectorAll(".vmodal-thumb"));
        setGalleryIndex(draw, thumbs.indexOf(thumb));
        startRotation(draw);
      });
    });

    // --- Horizontal deck controller ---------------------------------------
    if (window.__lenis && typeof window.__lenis.destroy === "function") {
      try { window.__lenis.destroy(); } catch (e) {}
    }
    (function deck() {
      const deck = document.getElementById("pf-deck");
      if (!deck) return;
      const panels = deck.querySelectorAll(".pf-panel");
      const curEl = document.getElementById("pf-cur");
      const pad = (n) => String(n + 1).padStart(2, "0");
      const last = panels.length - 1;
      let idx = 0, cooling = false, settle;

      // Final-panel newsletter reveal (slides the track to push a card off-screen).
      const finalPanel = document.getElementById("pf-final");
      const finalTrack = document.getElementById("pf-final-track");
      const revealTab = document.getElementById("pf-reveal-tab");
      const newsEl = finalPanel ? finalPanel.querySelector(".pf-news") : null;
      let revealed = false;
      const revealAmt = () => (finalTrack ? Math.max(0, finalTrack.scrollWidth - finalPanel.clientWidth) : 0);
      function setReveal(on) {
        if (!finalTrack) return;
        revealed = on;
        finalTrack.style.transform = on ? `translateX(-${revealAmt()}px)` : "translateX(0)";
        if (revealTab) revealTab.style.right = on && newsEl ? newsEl.offsetWidth + "px" : "0px";
        finalPanel.classList.toggle("is-revealed", on);
      }

      const go = (i) => {
        idx = Math.max(0, Math.min(last, i));
        if (idx !== last && revealed) setReveal(false);
        deck.scrollTo({ left: idx * deck.clientWidth, behavior: "smooth" });
        if (curEl) curEl.textContent = pad(idx);
      };

      // Mouse wheel → advance exactly one panel per gesture (sharp).
      deck.addEventListener("wheel", (e) => {
        if (openSlug) return; // a showcase pop-up is open — leave the deck alone
        e.preventDefault();
        if (cooling) return;
        const d = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        if (Math.abs(d) < 6) return;
        cooling = true;
        setTimeout(() => { cooling = false; }, 620);
        if (d > 0) {
          if (idx === last) { if (!revealed) setReveal(true); } else go(idx + 1);
        } else {
          if (idx === last && revealed) setReveal(false); else go(idx - 1);
        }
      }, { passive: false });

      window.addEventListener("keydown", (e) => {
        if (openSlug) return;
        if (e.key === "ArrowRight" || e.key === "PageDown") {
          e.preventDefault();
          if (idx === last) { if (!revealed) setReveal(true); } else go(idx + 1);
        } else if (e.key === "ArrowLeft" || e.key === "PageUp") {
          e.preventDefault();
          if (idx === last && revealed) setReveal(false); else go(idx - 1);
        }
      });

      if (revealTab) revealTab.addEventListener("click", (e) => { e.stopPropagation(); setReveal(!revealed); });

      window.addEventListener("resize", () => {
        deck.scrollTo({ left: idx * deck.clientWidth });
        if (revealed) setReveal(true);
      });

      deck.addEventListener("scroll", () => {
        clearTimeout(settle);
        settle = setTimeout(() => {
          const i = Math.round(deck.scrollLeft / deck.clientWidth);
          if (i !== idx) { idx = i; if (curEl) curEl.textContent = pad(idx); if (idx !== last && revealed) setReveal(false); }
        }, 120);
      }, { passive: true });
    })();

    // Newsletter footer form (UI only, matches the site's other sign-up forms).
    (function newsForm() {
      const form = document.getElementById("pf-news-form");
      if (!form) return;
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const email = form.querySelector('input[type="email"]');
        if (!email || !email.value) return;
        const btn = form.querySelector(".pf-news-send");
        const original = btn.innerHTML;
        btn.textContent = "You're in ✓";
        setTimeout(() => { btn.innerHTML = original; form.reset(); }, 2400);
      });
    })();

    // --- Deep link (open a showcase from #slug) ---
    (function openFromHash() {
      const h = (location.hash || "").replace("#", "");
      if (h && PRODUCTS.some((p) => p.slug === h)) openProduct(h);
    })();
  </script>
</BaseLayout>
