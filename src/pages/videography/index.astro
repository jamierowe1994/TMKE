  <!-- Deck controller + partner pricing + showcase pop-ups. Lenis is stopped on
       this page so it doesn't fight the horizontal scroll. -->
  <script src="/scripts/stack-swipe.js" is:inline></script>
  <script>
    import { PRODUCTS, tierPrice, resolvePartnerSlug, getPartner } from "../../data/videography.js";
    import { gbpFromPence } from "../../lib/supabase.js";

    const slug = resolvePartnerSlug();
    const partner = getPartner(slug);

    // --- Partner pricing ---
    (function applyPartnerPricing() {
      PRODUCTS.forEach((p) => {
        p.priceTiers.forEach((t, i) => {
          document.querySelectorAll(`[data-price-svc="${p.slug}"][data-tier="${i}"]`).forEach((el) => {
            el.textContent = gbpFromPence(tierPrice(t, slug));
          });
        });
        const note = document.querySelector(`[data-note-svc="${p.slug}"]`);
        if (note) note.textContent = partner.note;
      });
      if (slug !== "direct") {
        const banner = document.getElementById("vid-partner-banner");
        const text = document.getElementById("vid-partner-text");
        if (banner && text) { text.textContent = `${partner.name} · ${partner.note}`; banner.hidden = false; }
      }
    })();

    // --- Showcase pop-ups ---
    const scrim = document.getElementById("vmodal-scrim");
    const closeX = document.getElementById("vmodal-x");
    let openSlug = null;
    let closeTimer = null;

    function openProduct(s) {
      const draw = document.querySelector(`.vdraw[data-product="${s}"]`);
      if (!draw || !scrim) return;
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      openSlug = s;
      scrim.hidden = false;
      draw.hidden = false;
      if (draw.__resetScroll) draw.__resetScroll();
      document.documentElement.style.overflow = "hidden";
      document.body.classList.add("pf-modal-open");
      if (closeX) closeX.hidden = false;
      requestAnimationFrame(() => requestAnimationFrame(() => {
        scrim.classList.add("is-open");
        draw.classList.add("is-open");
      }));
      draw.__galIdx = 0;
      startRotation(draw); // begin the 5s auto-rotate
      if (location.hash !== `#${s}`) history.replaceState(null, "", `#${s}`);
    }

    function closeProduct() {
      if (!openSlug || !scrim) return;
      const draw = document.querySelector(`.vdraw[data-product="${openSlug}"]`);
      stopRotation();
      // Re-mute so reopening a pop-out never starts with sound blaring.
      document.querySelectorAll(".vdraw-hero-video").forEach((v) => { v.muted = true; });
      document.querySelectorAll(".vmodal-sound").forEach((b) => {
        b.classList.remove("is-on");
        b.setAttribute("aria-pressed", "false");
        b.setAttribute("aria-label", "Turn sound on");
      });
      scrim.classList.remove("is-open");
      if (draw) draw.classList.remove("is-open");
      if (closeX) closeX.hidden = true;
      document.documentElement.style.overflow = "";
      document.body.classList.remove("pf-modal-open");
      closeTimer = setTimeout(() => { scrim.hidden = true; if (draw) draw.hidden = true; }, 880);
      openSlug = null;
      if (location.hash) history.replaceState(null, "", location.pathname + location.search);
    }

    function bindOpen(el) {
      el.addEventListener("click", (e) => { e.stopPropagation(); openProduct(el.getAttribute("data-open")); });
    }
    document.querySelectorAll("[data-open]").forEach(bindOpen);
    document.querySelectorAll("[data-close]").forEach((btn) => btn.addEventListener("click", closeProduct));
    scrim?.addEventListener("click", closeProduct);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && openSlug) closeProduct(); });

    // Booking from inside a showcase: slide the showcase down and out of the
    // way first, THEN bring the booking flow in on top. Capture phase pre-empts
    // VideographyBooking's own opener (only while a showcase is open) so the two
    // don't stack; when nothing is open, its global opener handles the click.
    document.addEventListener("click", (e) => {
      const btn = e.target.closest && e.target.closest("[data-vbook]");
      if (!btn || !openSlug) return; // only intercept while a showcase is open
      e.preventDefault();
      e.stopImmediatePropagation();
      const key = btn.getAttribute("data-vbook");
      closeProduct();
      setTimeout(() => {
        if (typeof window.tmkeVideographyBook === "function") window.tmkeVideographyBook(key);
      }, 720);
    }, true);

    // --- Top nav: burger opens the shared off-canvas side menu (NavDrawer) ---
    // Wiring lives in that component, keyed off [data-nav-drawer-open].

    // --- Showcase gallery: crossfade hero, auto-rotate, arrows + thumbs ---
    const ROTATE_MS = 5000;
    let galTimer = null;

    function setGalleryIndex(draw, i) {
      const thumbs = draw.querySelectorAll(".vmodal-thumb");
      const n = thumbs.length;
      if (!n) return;
      i = ((i % n) + n) % n;
      const stage = draw.querySelector(".vdraw-stage");
      const thumb = thumbs[i];
      thumbs.forEach((t) => t.classList.remove("is-active"));
      thumb.classList.add("is-active");
      const gal = draw.querySelector(".vmodal-gallery");
      if (gal) {
        gal.scrollTo({ left: thumb.offsetLeft - gal.clientWidth / 2 + thumb.clientWidth / 2, behavior: "smooth" });
      }
      const cur = draw.querySelector(".vmodal-count-cur");
      if (cur) cur.textContent = String(i + 1);
      draw.__galIdx = i;
      // Video thumbs show the film over the stage; image thumbs swap an image in
      // over it (stage.show-img hides the video). Live folders carry a per-thumb
      // video source; a legacy fixed video has none (its <source> is baked in).
      if (thumb.hasAttribute("data-video")) {
        const vsrc = thumb.getAttribute("data-video-src");
        const vid = stage.querySelector(".vdraw-hero-video");
        if (vsrc && vid && vid.getAttribute("data-src") !== vsrc) {
          vid.setAttribute("data-src", vsrc);
          vid.src = vsrc;
          try { vid.load(); const pl = vid.play(); if (pl && pl.catch) pl.catch(() => {}); } catch (_) {}
        }
        stage.classList.remove("show-img");
        return;
      }
      stage.classList.add("show-img");
      const layers = stage.querySelectorAll(".vdraw-hero-img");
      const full = thumb.getAttribute("data-full");
      if (!full || !layers.length) return;
      const active = stage.querySelector(".vdraw-hero-img.is-active") || layers[0];
      const next = active === layers[0] ? layers[1] : layers[0];
      next.style.backgroundImage = `url('${full}')`;
      next.classList.add("is-active");
      active.classList.remove("is-active");
    }

    function stopRotation() { if (galTimer) { clearInterval(galTimer); galTimer = null; } }
    function startRotation(draw) {
      stopRotation();
      if (draw.querySelector(".vdraw-hero-video")) return;   // video products: keep the video, no auto-rotate
      if (draw.querySelectorAll(".vmodal-thumb").length <= 1) return;
      galTimer = setInterval(() => setGalleryIndex(draw, (draw.__galIdx || 0) + 1), ROTATE_MS);
    }

    // Smooth-scroll the LEFT info column from ANYWHERE in the modal (over the
    // text or the image), with a rAF lerp so it matches the site's smooth feel
    // and never depends on what the cursor is hovering.
    document.querySelectorAll(".vdraw").forEach((draw) => {
      const left = draw.querySelector(".vdraw-left");
      if (!left) return;
      let target = 0, current = 0, raf = null;
      const maxScroll = () => Math.max(0, left.scrollHeight - left.clientHeight);
      const tick = () => {
        current += (target - current) * 0.14;
        if (Math.abs(target - current) < 0.4) current = target;
        left.scrollTop = current;
        raf = current !== target ? requestAnimationFrame(tick) : null;
      };
      draw.addEventListener("wheel", (e) => {
        if (window.innerWidth <= 900) return; // mobile: native touch scroll
        e.preventDefault();
        target = Math.max(0, Math.min(maxScroll(), target + e.deltaY));
        if (!raf) raf = requestAnimationFrame(tick);
      }, { passive: false });
      draw.__resetScroll = () => {
        target = 0; current = 0; left.scrollTop = 0;
        if (raf) { cancelAnimationFrame(raf); raf = null; }
      };
    });

    document.querySelectorAll(".vmodal-arrow").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const draw = btn.closest(".vdraw");
        const dir = parseInt(btn.getAttribute("data-dir"), 10) || 1;
        setGalleryIndex(draw, (draw.__galIdx || 0) + dir);
        startRotation(draw); // reset the 5s timer after a manual step
      });
    });
    // Delegated so dynamically-added thumbs (live headshots) work too.
    document.querySelectorAll(".vmodal-gallery").forEach((gal) => {
      gal.addEventListener("click", (e) => {
        const thumb = e.target.closest(".vmodal-thumb");
        if (!thumb) return;
        e.stopPropagation();
        const draw = thumb.closest(".vdraw");
        const thumbs = Array.from(draw.querySelectorAll(".vmodal-thumb"));
        setGalleryIndex(draw, thumbs.indexOf(thumb));
        startRotation(draw);
      });
    });

    // Sound toggle — unmute/mute the stage video. Videos start muted (autoplay
    // requirement); the toggle is a user gesture so unmuting is allowed.
    document.querySelectorAll(".vmodal-sound").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const vid = btn.closest(".vdraw-stage").querySelector(".vdraw-hero-video");
        if (!vid) return;
        vid.muted = !vid.muted;
        btn.classList.toggle("is-on", !vid.muted);
        btn.setAttribute("aria-pressed", String(!vid.muted));
        btn.setAttribute("aria-label", vid.muted ? "Turn sound on" : "Turn sound off");
      });
    });

    // Size each image thumbnail in a hand-ordered media gallery to its own
    // image's aspect (the strip keeps a uniform height; the width follows the
    // image) so photos show fully in either orientation instead of a squashed
    // cover-crop. Video thumbs keep the 16:9 default from CSS.
    (function sizeMediaThumbs() {
      document.querySelectorAll('.vdraw-right[data-media-gallery] .vmodal-thumb[data-full]').forEach((btn) => {
        const src = btn.getAttribute("data-full");
        if (!src) return;
        const im = new Image();
        im.onload = () => { if (im.naturalWidth && im.naturalHeight) btn.style.aspectRatio = im.naturalWidth + " / " + im.naturalHeight; };
        im.src = src;
      });
    })();

    // --- Horizontal deck controller ---------------------------------------
    // Play the first-slide entrance once we're on the page (after it loads in),
    // not while it's still loading — so the animation isn't missed.
    // Phones: the stack. Tap a bar to open its section; tap it again to go
    // back to the title.
    (function stack() {
      const sms = document.getElementById("sms");
      if (!sms) return;
      const panels = Array.from(sms.querySelectorAll(".sms-p"));
      let open = 0;
      const setOpen = (i) => { open = i; panels.forEach((p, n) => p.classList.toggle("is-open", n === i)); };
      panels.forEach((p, i) => {
        const bar = p.querySelector(".sms-bar");
        if (bar) bar.addEventListener("click", () => setOpen(open === i ? 0 : i));
      });
    })();
    if (window.__lenis && typeof window.__lenis.destroy === "function") {
      try { window.__lenis.destroy(); } catch (e) {}
    }
    (function deck() {
      const stage = document.getElementById("pf-deck");
      if (!stage) return;
      const panels = [...stage.querySelectorAll(".pf-panel")];
      const curEl = document.getElementById("pf-cur");
      const topBar = document.querySelector(".pf-top");   // nav: white on the dark hero, burgundy elsewhere
      const pad = (n) => String(n + 1).padStart(2, "0");
      const last = panels.length - 1;
      // Every slide enters from the right and covers the previous one (the deck
      // "slides across"), mirroring the Social Media cover engine.
      const ENTRY = panels.map((_, i) => (i === 0 ? [0, 0] : [1, 0]));
      panels.forEach((p, i) => { p.style.zIndex = String(i); });

      /* The final panel's newsletter reveal lived here — a track that slid
         sideways behind a tab on the right edge. Both are gone: the newsletter
         is in the footer everywhere else, and the tab was what put this page's
         right margin out of step with every other one (Dani, 7 Oct). */

      // ---- Floaty cover engine (ported from the Social Media deck) ----
      const SENS = 0.001;     // wheel → progress (slow, ~one slide per scroll)
      const EASE = 0.055;     // lerp toward target (lower = floatier)
      const SLOW_EASE = 0.03; // slower glide for the final couple of slides
      const PAUSE = 800;      // ms hold after a snap so it settles before the next
      /* anchor starts at HOME. It used to start at THRESH (3) — a leftover from
         the old deck, where it meant "the slide after which things snap" rather
         than "the slide we are on". Once targetOf became () => anchor, that 3
         became the page the site opened on: the brochure page, every time. */
      let acc = 0, display = 0, lastCur = -1, anchor = 0, lockUntil = 0;
      /* Set by the home page's own scroll listener below. Declared up here
         because render() runs on the first frame, before that listener is
         wired, and a `let` read before its declaration throws. */
      let homeScrolled = false;
      const clamp = (v) => Math.max(0, Math.min(last, v));

      /* Panels being jumped OVER. Choosing Photography from the home page is a
         move from panel 0 to panel 4, and display eases the whole way — so the
         three videography pages flicked past on the way (Dani, 7 Oct). These
         are pinned at the entry edge for the length of the move instead, so
         the page you asked for is the only one that arrives.
         Pinning is invisible at the moment it happens: going forward they are
         already off-screen, and coming back the panel on top still covers them
         for that frame. */
      let skipped = new Set();

      const targetOf = () => anchor;

      const render = () => {
        for (let i = 0; i < panels.length; i++) {
          const f = skipped.has(i) ? 1 : Math.max(0, Math.min(1, i - display));   // 1 = off (entry edge) · 0 = covering
          const e = ENTRY[i] || [0, 0];
          panels[i].style.transform = `translate(${(e[0] * f * 100).toFixed(3)}%, ${(e[1] * f * 100).toFixed(3)}%)`;
        }
        const cur = clamp(Math.round(display));
        if (cur !== lastCur) {
          lastCur = cur;
          panels.forEach((p, i) => p.classList.toggle("is-in", i === cur));
          if (curEl) curEl.textContent = pad(cur);
          if (topBar) {
            topBar.classList.toggle("on-dark", false);   // page one is light — nav stays ink
            // The wordmark belongs to the home page; inside a route the burger
            // is enough, and the mark was crossing the words.
            topBar.classList.toggle("is-markless", cur > 0 || homeScrolled);
          }
        }
      };
      const tick = () => {
        const t = targetOf();
        const ease = t >= last - 1 ? SLOW_EASE : EASE;            // last two glide slower
        display += (t - display) * ease;
        if (Math.abs(t - display) < 0.0004) {
          display = t;
          // Landed — the pages in between go back to being ordinary pages, so
          // scrolling on from here still works one page at a time.
          if (skipped.size) skipped = new Set();
        }
        render();
        requestAnimationFrame(tick);
      };
      render(); requestAnimationFrame(tick);

      const atLast = () => display > last - 0.05;

      /* HOME (0) and two routes of three: videography 1-3, photography 4-6.
         Home never pages on scroll — you choose a route by clicking a card.
         Inside a route, scrolling moves one page at a time and stops at its
         end; scrolling back from a route's first page returns home. That is
         what stops a scroll running through every slide and what makes "back"
         mean something. */
      const VIDEO = [1, 2, 3], PHOTO = [4, 5, 6];
      const routeOf = (i) => (PHOTO.includes(i) ? PHOTO : VIDEO.includes(i) ? VIDEO : null);
      const nextOf = (i) => { const r = routeOf(i); if (!r) return i; const n = r.indexOf(i) + 1; return n < r.length ? r[n] : i; };
      const prevOf = (i) => { const r = routeOf(i); if (!r) return i; const p = r.indexOf(i) - 1; return p >= 0 ? r[p] : 0; };
      const openPanel = stage.querySelector(".vh");
      const topBarEl = document.getElementById("pf-top");
      const openEdge = (dir) => {
        if (!openPanel || Math.round(display) !== 0) return false;
        const atTop = openPanel.scrollTop <= 0;
        const atBottom = openPanel.scrollTop + openPanel.clientHeight >= openPanel.scrollHeight - 1;
        return !((dir > 0 && atBottom) || (dir < 0 && atTop));
      };
      /* The wordmark belongs to the top of the home page. Once you start
         scrolling it, the mark crosses the picture below — so it goes, and the
         burger stays as the only thing you need up there (Dani, 7 Oct). The
         old handler hid the WHOLE bar with .is-away, a class this page's
         stylesheet does not define, so nothing happened. */
      const syncMark = () => {
        if (topBarEl) topBarEl.classList.toggle("is-markless", lastCur > 0 || homeScrolled);
      };
      if (openPanel && topBarEl) {
        openPanel.addEventListener("scroll", () => {
          const away = Math.round(display) === 0 && openPanel.scrollTop > 8;
          if (away === homeScrolled) return;
          homeScrolled = away;
          syncMark();
        }, { passive: true });
      }
      /* A discrete stepper: the wheel fills a bucket, and crossing it steps one
         page through the route's own order. Home's bucket goes nowhere, so the
         page simply scrolls. */
      let bucket = 0;
      const STEP_AT = 420;          // wheel pixels to commit to the next page
      /* Every move goes through this. Anything more than one page away pins
         the pages in between so they are never drawn mid-move. */
      const goto = (i) => {
        const to = clamp(i);
        const from = Math.round(display);
        if (to === from) return;
        const lo = Math.min(from, to), hi = Math.max(from, to);
        const next = new Set();
        for (let k = lo + 1; k < hi; k++) next.add(k);
        skipped = next;
        anchor = to; acc = to; bucket = 0;
        lockUntil = performance.now() + PAUSE;
      };
      const step = (dir) => {
        const from = Math.round(anchor);
        goto(dir > 0 ? nextOf(from) : prevOf(from));
      };
      stage.addEventListener("wheel", (ev) => {
        if (openSlug) return;                       // a showcase pop-up is open
        const d = Math.abs(ev.deltaY) >= Math.abs(ev.deltaX) ? ev.deltaY : ev.deltaX;
        if (openEdge(d)) return;                    // home scrolls itself first
        if (Math.round(anchor) === 0) return;       // home never pages on scroll
        ev.preventDefault();
        if (performance.now() < lockUntil) return;  // the hold between pages
        bucket += d;
        if (Math.abs(bucket) >= STEP_AT) step(bucket);
      }, { passive: false });

      window.addEventListener("keydown", (ev) => {
        if (openSlug) return;
        if (["ArrowRight", "ArrowDown", "PageDown"].includes(ev.key)) {
          ev.preventDefault();
          acc = clamp(Math.round(acc) + 1);
        } else if (["ArrowLeft", "ArrowUp", "PageUp"].includes(ev.key)) {
          ev.preventDefault();
          acc = clamp(Math.round(acc) - 1);
        }
      });

      // touch — drag continuously (swipe left/up advances)
      let tx = 0, ty = 0, tp = 0;
      stage.addEventListener("touchstart", (ev) => {
        const t = ev.touches[0]; tx = t.clientX; ty = t.clientY; tp = acc;
      }, { passive: true });
      stage.addEventListener("touchmove", (ev) => {
        if (openSlug) return;
        const t = ev.touches[0]; const dx = t.clientX - tx, dy = t.clientY - ty;
        const dom = Math.abs(dx) > Math.abs(dy) ? dx : dy;
        // Page one scrolls itself until it runs out, as the wheel does.
        if (openEdge(dom)) return;
        acc = clamp(tp - dom * 0.004);
      }, { passive: true });

      // Clickable "Scroll" / "Our services" hints → advance one panel, and the
      // Photography card jumps straight to its own page rather than the next.
      const goTo = (i) => goto(i);
      stage.querySelectorAll("[data-deck-next]").forEach((el) => {
        el.addEventListener("click", (e) => {
          e.preventDefault(); e.stopPropagation();
          goTo(Math.round(anchor) + 1);
        });
      });
      /* The whole card is the target, not just its link — Dani, 7 Oct. */
      const routeStart = (name) => (name === "photo" ? PHOTO[0] : VIDEO[0]);
      const enter = (name) => goto(routeStart(name));
      stage.querySelectorAll(".vh-route").forEach((card) => {
        card.addEventListener("click", () => enter(card.getAttribute("data-route")));
      });
      // Cross-links at the end of each route, and anything else that names one.
      stage.querySelectorAll("[data-goto-route]").forEach((el) => {
        el.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); enter(el.getAttribute("data-goto-route")); });
      });
      stage.querySelectorAll("[data-photo-open]").forEach((el) => {
        el.addEventListener("click", (e) => { e.preventDefault(); e.stopPropagation(); enter("photo"); });
      });
      /* The nav's "Property Photography" is this page at #photography. A
         separate <script> is a separate module, so the hash handler cannot
         reach `enter` — it goes on window instead. Landing straight on the
         route (no ease) is the point: arriving from the menu should look like
         the page opened there. */
      window.tmkeVidRoute = (name, instant) => {
        const i = routeStart(name);
        if (instant) { anchor = i; acc = i; display = i; lastCur = -1; skipped = new Set(); render(); }
        else enter(name);
      };
      if ((location.hash || "").toLowerCase() === "#photography") window.tmkeVidRoute("photo", true);
      // The wordmark goes home from anywhere in the deck.
      document.querySelector(".pf-top-logo")?.addEventListener("click", (e) => {
        if (Math.round(anchor) === 0) return;       // already home — let the link work
        e.preventDefault();
        goto(0);
      });

    })();

    // --- Deep link (open a showcase from #slug) ---
    (function openFromHash() {
      const h = (location.hash || "").replace("#", "");
      if (h && PRODUCTS.some((p) => p.slug === h)) openProduct(h);
    })();

    /* Already on this page and the menu's Property Photography is clicked:
       the hash does not change the document, so move the deck ourselves. */
    window.addEventListener("hashchange", () => {
      if ((location.hash || "").toLowerCase() === "#photography" && typeof window.tmkeVidRoute === "function") {
        window.tmkeVidRoute("photo", false);
      }
    });

    /* Our services — hovering a row crossfades its picture. */
    (function vsvcs() {
      const list = document.querySelector(".vsvcs-list");
      const media = document.getElementById("vsvcs-media");
      if (!list || !media) return;
      const rows = [...list.querySelectorAll(".vsvc")];
      const imgs = [...media.querySelectorAll(".vsvc-img")];
      const show = (i) => imgs.forEach((im, n) => im.classList.toggle("is-active", n === i));
      rows.forEach((r, i) => {
        r.addEventListener("mouseenter", () => show(i));
        r.addEventListener("focusin", () => show(i));
      });
      list.addEventListener("mouseleave", () => show(0));
    })();

    /* The ways-in lists (both routes). One row always open: closing the open
       one falls back to the first, as on /services. */
    document.querySelectorAll("[data-ways]").forEach((list) => {
      const rows = [...list.querySelectorAll(".sm-way")];
      const open = (row) => rows.forEach((r) => {
        const on = r === row;
        r.classList.toggle("is-open", on);
        r.querySelector(".sm-way-head").setAttribute("aria-expanded", on ? "true" : "false");
      });
      rows.forEach((r) => r.querySelector(".sm-way-head").addEventListener("click", () => {
        open(r.classList.contains("is-open") ? rows[0] : r);
      }));
      open(rows[0]);
    });
  </script>
</BaseLayout>
