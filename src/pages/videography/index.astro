      .sms-extras { list-style: none; margin: 0 0 18px; padding: 0; }
      .sms-extras li { display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid rgba(28,29,34,0.1); font-size: 13.5px; color: rgba(28,29,34,0.78); }
      .sms-tierrow { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.1); }
      .sms-tierrow-label { display: flex; flex-direction: column; gap: 2px; font-size: 14px; font-weight: 600; color: var(--ink); }
      .sms-tierrow-label small { font-weight: 400; font-size: 12px; color: rgba(28,29,34,0.55); }
      .sms-tierrow-price { white-space: nowrap; font-size: 12.5px; color: rgba(28,29,34,0.65); }
      .sms-tierrow-price b { font-family: var(--serif); font-size: 18px; font-weight: 500; color: var(--ink); }
      .sms-note { margin: 8px 0 0; font-size: 12px; color: rgba(28,29,34,0.5); }
      /* No serif headings on the service screens: the name and every
         sub-head take the chapter line's type, with the dash. */
      .sms-h--dash, .sms-sub { margin: 0 0 12px; font-family: var(--sans); font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--english-violet); line-height: 1.4; }
      .sms-sub { margin-top: 22px; }
      .sms-h--dash::before, .sms-sub::before { content: "\2014"; margin-right: 8px; }
      .sms-hslide .sms-lede { margin: 0 0 12px; font-size: 15.5px; line-height: 1.5; color: var(--ink); }
