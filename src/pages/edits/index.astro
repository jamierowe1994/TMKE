---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Request edits — TMKE"
  description="Ask TMKE for edits to your videography shoot, or add a twilight conversion or extra images."
  hideNav
  noindex
>
  <main class="edr">
    <header class="edr-head">
      <a href="/" class="edr-mark">TMKE</a>
      <span class="edr-head-tag">Videography</span>
    </header>

    <section class="edr-stage" id="edr-stage">
      <p class="edr-loading" id="edr-loading">Loading…</p>
    </section>
  </main>

  <style is:global>
    /* Astro's default scoped CSS only matches elements written directly in
       this file's template - it adds a data-astro-cid attribute to those,
       and rewrites every selector below to require it. Everything on this
       page except the outer shell (header, #edr-stage container) is built
       by the script at the bottom via innerHTML, so none of it ever gets
       that attribute - scoped mode would silently style nothing. Global
       mode drops the attribute requirement; the edr- prefix throughout
       keeps it from colliding with any other page's classes. */
    .edr { min-height: 100vh; background: var(--paper); }
    .edr-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 22px 36px; border-bottom: 1px solid rgba(28,29,34,0.1);
    }
    .edr-mark { font-family: var(--serif); font-size: 24px; font-weight: 600; letter-spacing: 0.04em; color: var(--ink); }
    .edr-head-tag { font-family: var(--sans); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); }

    /* Wider column, tighter side gutter - the previous 640px/36px left the
       page reading as three empty-feeling columns with content crammed into
       the middle one. */
    .edr-stage { max-width: 780px; margin: 0 auto; padding: 56px 27px 120px; }
    .edr-loading, .edr-msg { font-family: var(--sans); font-size: 15px; color: rgba(28,29,34,0.6); padding: 60px 0; text-align: center; }

    .edr-eyebrow { font-family: var(--sans); font-size: 12px; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); margin-bottom: 14px; }
    .edr-title { font-family: var(--serif); font-weight: 400; font-size: clamp(30px, 4.5vw, 44px); line-height: 1.08; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 24px; }
    /* No max-width here on purpose now - a constrained measure on the
       paragraphs while the boxes below run full width read as a margin bug,
       not a deliberate choice. Per-instance spacing (tight between the two
       intro sentences, tighter again down into the textarea) is set inline
       in the markup below rather than here, since the same class is used in
       three places that each need a different gap. */
    .edr-note { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(28,29,34,0.7); margin: 0 0 36px; }

    .edr-banner { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border-radius: 2px; background: rgba(44,122,75,0.12); color: #2c7a4b; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 28px; }

    .edr-section { margin-bottom: 34px; }
    .edr-label { display: block; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); margin-bottom: 10px; }
    .edr-sub { font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: rgba(28,29,34,0.6); margin: -4px 0 14px; }

    /* Corner radius, borders and padding below all match the admin centre's
       own .vid-field input / .admin-btn tokens (2px radius, violet-tinted
       border), so this page reads as the same product as the admin side
       rather than a separately-designed one. */
    textarea.edr-notes {
      width: 100%; min-height: 120px; padding: 12px 14px; font-family: var(--sans); font-size: 14.5px;
      border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 2px; resize: vertical; background: #fff; color: var(--ink);
    }
    textarea.edr-notes:focus { outline: none; border-color: var(--english-violet); }
    .edr-hint { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); margin-top: 6px; }

    /* Buttons - the admin centre's own .admin-btn tokens, plus one variant
       (edr-btn-invert) for use on the violet submit box, where the standard
       primary (violet-on-paper) would disappear against a violet background. */
    .edr-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 16px;
      border-radius: 2px; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700;
      cursor: pointer; border: 1px solid transparent; background: none;
      transition: background 0.2s, color 0.2s, border-color 0.2s; text-decoration: none;
    }
    .edr-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .edr-btn-ghost { background: transparent; border-color: rgba(var(--violet-rgb), 0.4); color: var(--english-violet); }
    .edr-btn-ghost:hover { background: rgba(var(--violet-rgb), 0.06); }
    .edr-btn-invert { background: var(--paper); color: var(--english-violet); }
    .edr-btn-invert:hover { background: var(--ink); color: var(--paper); }

    /* Two separate CTAs, not one combined bar - leaving feedback and buying
       an extra are different actions, so each gets its own small banner
       right where it applies, rather than one oversized bar doing both. */
    .edr-cta {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px;
      background: var(--english-violet); color: var(--paper);
      border-radius: 2px; padding: 12px 16px; margin-top: 16px;
    }
    .edr-cta-msg { font-family: var(--sans); font-size: 13px; }

    /* Twilight: an input + Add button that commits a filename to a list,
       rather than counting whatever's currently typed - so the running total
       only ever reflects images actually added, matching what gets charged. */
    .edr-twilight-input-row { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
    .edr-twilight-input-row input {
      flex: 1; padding: 9px 12px; font-family: var(--sans); font-size: 14px;
      border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 2px; background: #fff; color: var(--ink);
    }
    .edr-twilight-input-row input:focus { outline: none; border-color: var(--english-violet); }
    .edr-twilight-item {
      display: flex; justify-content: space-between; align-items: center; gap: 10px;
      padding: 9px 12px; border: 1px solid rgba(28,29,34,0.1); border-radius: 2px; background: rgba(28,29,34,0.02);
      margin-bottom: 6px;
    }
    .edr-twilight-item-name { font-family: var(--sans); font-size: 13.5px; color: var(--ink); word-break: break-all; }
    .edr-row-del {
      width: 28px; height: 28px; flex: none; border-radius: 2px; border: 1px solid rgba(28,29,34,0.14);
      background: transparent; color: rgba(28,29,34,0.5); cursor: pointer; font-size: 16px; line-height: 1;
    }
    .edr-row-del:hover { border-color: rgba(180,40,40,0.4); color: #b42828; }
    .edr-twilight-total { font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--ink); margin-top: 10px; }

    .edr-bundle {
      display: flex; align-items: center; gap: 12px; padding: 14px 16px;
      border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 2px; background: #fff;
    }
    .edr-bundle input { width: 18px; height: 18px; accent-color: var(--english-violet); flex: none; }
    .edr-bundle label { font-family: var(--sans); font-size: 14px; color: var(--ink); cursor: pointer; }
    .edr-bundle strong { color: var(--english-violet); }

    .edr-checkout-row { position: sticky; bottom: 20px; margin-top: 28px; }
    .edr-checkout-row .edr-cta { box-shadow: 0 14px 34px rgba(28,29,34,0.24); }
    .edr-error { font-family: var(--sans); font-size: 13px; color: #b42828; margin-top: 10px; }
    .edr-thanks { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: var(--ink); padding: 40px 0; }

    /* "Want to add anything else?" - a proper section heading, distinct from
       the compact uppercase .edr-label field labels, since it introduces a
       new part of the page rather than naming a single field. */
    .edr-subhead { font-family: var(--serif); font-weight: 400; font-size: 24px; line-height: 1.2; color: var(--ink); margin: 0 0 10px; }
    .edr-pay-note { font-family: var(--sans); font-size: 12.5px; line-height: 1.55; color: rgba(28,29,34,0.55); margin: 4px 0 0; }

    @media (max-width: 720px) { .edr-stage { padding: 36px 20px 100px; } .edr-head { padding: 18px 20px; } }
  </style>

  <script>
    import { gbpFromPence } from "../../lib/supabase.js";
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");

    const stage = document.getElementById("edr-stage");
    const token = new URLSearchParams(location.search).get("token") || "";
    const justPaid = new URLSearchParams(location.search).get("paid") === "1";

    function esc(s) { return String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }

    // Committed filenames only - not whatever's currently sitting in the
    // input box. The running total, and what actually gets submitted, both
    // read from this array, so what they see is exactly what gets charged.
    let twilightItems = [];
    let twilightPricePence = 0;
    // True once the free-text feedback has gone through its own banner - so
    // a later Checkout click (a separate submission) never re-sends the same
    // notes as a duplicate, but still catches them if Checkout is used first.
    let feedbackSent = false;

    function renderTwilightList() {
      const listEl = document.getElementById("edr-twilight-list");
      if (!listEl) return;
      listEl.innerHTML = twilightItems.map((name, i) => `
        <div class="edr-twilight-item">
          <span class="edr-twilight-item-name">${esc(name)}</span>
          <button type="button" class="edr-row-del" data-remove="${i}" aria-label="Remove">&times;</button>
        </div>`).join("");
      listEl.querySelectorAll("[data-remove]").forEach((btn) => btn.addEventListener("click", () => {
        twilightItems.splice(Number(btn.getAttribute("data-remove")), 1);
        renderTwilightList();
        updateCheckoutTotal();
      }));
    }

    function addTwilightItem() {
      const input = document.getElementById("edr-twilight-input");
      const val = input.value.trim();
      if (!val) return;
      twilightItems.push(val);
      input.value = "";
      input.focus();
      renderTwilightList();
      updateCheckoutTotal();
    }

    function updateCheckoutTotal() {
      const filled = twilightItems.length;
      const total = document.getElementById("edr-twilight-total");
      const checkoutMsg = document.getElementById("edr-checkout-total");
      const bundle = document.getElementById("edr-bundle-check");
      const bundlePence = (bundle && bundle.checked) ? window.__edrExtraPrice : 0;
      const twilightPence = filled * twilightPricePence;
      const pence = twilightPence + bundlePence;
      if (total) total.textContent = filled ? `${filled} image${filled === 1 ? "" : "s"} — ${gbpFromPence(twilightPence)} +VAT` : "";
      if (checkoutMsg) checkoutMsg.textContent = pence ? `${gbpFromPence(pence)} +VAT` : "Nothing added yet";
      const checkoutErr = document.getElementById("edr-checkout-error");
      if (checkoutErr) checkoutErr.hidden = true;
    }

    function render(d) {
      const banner = justPaid ? `<div class="edr-banner">✓ Payment received — thank you</div>` : "";
      const upsell = d.upsell;
      twilightPricePence = d.twilight_price_pence || 0;
      window.__edrExtraPrice = (d.extra_images && d.extra_images.price_pence) || 0;

      const twilightBlock = upsell === "twilight" ? `
        <div class="edr-section">
          <span class="edr-label">Twilight Photos</span>
          <p class="edr-sub">Turn your chosen exterior shots into twilight images, perfect for giving your listing a different look across portals and social media. ${esc(gbpFromPence(twilightPricePence))} +VAT per photo.</p>
          <p class="edr-hint" style="margin:-6px 0 12px">Click an image on your gallery and Pixieset shows the filename at the bottom — paste it below, then press Add.</p>
          <div class="edr-twilight-input-row">
            <input type="text" id="edr-twilight-input" placeholder="Pixieset image filename" />
            <button type="button" class="edr-btn edr-btn-ghost" id="edr-twilight-add">Add</button>
          </div>
          <div id="edr-twilight-list"></div>
          <p class="edr-twilight-total" id="edr-twilight-total"></p>
        </div>` : "";

      const bundleBlock = upsell === "extra_images" ? `
        <div class="edr-section">
          <span class="edr-label">Too many favourites?</span>
          <div class="edr-bundle">
            <input type="checkbox" id="edr-bundle-check" />
            <label for="edr-bundle-check">Add another <strong>${d.extra_images.qty}</strong> photos to your final selection for <strong>${esc(gbpFromPence(d.extra_images.price_pence))} +VAT</strong>, saving you 20% on the gallery price.</label>
          </div>
        </div>` : "";

      const extrasSection = upsell ? `
        <div class="edr-section">
          <h2 class="edr-subhead">Want to add anything else?</h2>
          <p class="edr-note" style="margin-bottom:20px">While we're making your edits, you can also add a little extra to your finished content.</p>
          ${twilightBlock}
          ${bundleBlock}
          <p class="edr-pay-note">These extras are added to your gallery once payment has been received — nothing is created before then.</p>
          <div class="edr-checkout-row">
            <div class="edr-cta">
              <span class="edr-cta-msg" id="edr-checkout-total">Nothing added yet</span>
              <button type="button" class="edr-btn edr-btn-invert" id="edr-checkout-submit">Checkout</button>
            </div>
            <p class="edr-error" id="edr-checkout-error" hidden></p>
          </div>
        </div>` : "";

      stage.innerHTML = `
        <div class="edr-eyebrow">Videography</div>
        <h1 class="edr-title">${d.client_name ? esc(d.client_name) + ", " : ""}let us know what you'd like changed.</h1>
        <p class="edr-note" style="margin-bottom:8px">Had a look through your content and spotted something you'd like changed? No problem!</p>
        <p class="edr-note" style="margin-bottom:16px">Add all of your requested changes below and send them through. Once they're submitted, Jack will make the updates and we'll let you know when your revised content is ready to review.</p>
        ${banner}
        <div class="edr-section">
          <textarea class="edr-notes" id="edr-notes" placeholder="Describe the edits you'd like — as much detail as helps"></textarea>
          <p class="edr-hint">A quick note: as your package includes one round of edits, please make sure you've reviewed all of your content and included everything you'd like changed before submitting your request.</p>
          <div class="edr-cta" id="edr-feedback-cta">
            <span class="edr-cta-msg" id="edr-feedback-msg">Ready to send this through to Jack?</span>
            <button type="button" class="edr-btn edr-btn-invert" id="edr-feedback-submit">Send Feedback</button>
          </div>
          <p class="edr-error" id="edr-feedback-error" hidden></p>
        </div>
        ${extrasSection}`;

      if (upsell === "twilight") {
        const input = document.getElementById("edr-twilight-input");
        document.getElementById("edr-twilight-add").addEventListener("click", addTwilightItem);
        input.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); addTwilightItem(); } });
      }
      if (upsell === "extra_images") {
        document.getElementById("edr-bundle-check").addEventListener("change", updateCheckoutTotal);
      }

      document.getElementById("edr-feedback-submit").addEventListener("click", async () => {
        const btn = document.getElementById("edr-feedback-submit");
        const msgEl = document.getElementById("edr-feedback-msg");
        const errEl = document.getElementById("edr-feedback-error");
        errEl.hidden = true;
        const notes = document.getElementById("edr-notes").value.trim();
        if (!notes) { errEl.textContent = "Add a note before sending."; errEl.hidden = false; return; }

        btn.disabled = true;
        const label = btn.textContent; btn.textContent = "Sending…";
        try {
          const res = await fetch(`${WORKER}/videography/edit-request`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, notes, twilight_filenames: [], extra_images: false }),
          });
          const out = await res.json().catch(() => ({}));
          if (!res.ok) { errEl.textContent = out.error || "Something went wrong. Please try again."; errEl.hidden = false; btn.disabled = false; btn.textContent = label; return; }
          feedbackSent = true;
          document.getElementById("edr-notes").disabled = true;
          msgEl.textContent = "✓ Sent — Jack will pick this up.";
          btn.remove();
        } catch (e) {
          errEl.textContent = "Couldn't reach TMKE. Please try again in a moment.";
          errEl.hidden = false;
          btn.disabled = false; btn.textContent = label;
        }
      });

      const checkoutBtn = document.getElementById("edr-checkout-submit");
      if (checkoutBtn) checkoutBtn.addEventListener("click", async () => {
        const btn = checkoutBtn;
        const errEl = document.getElementById("edr-checkout-error");
        errEl.hidden = true;
        const twilight_filenames = upsell === "twilight" ? twilightItems.slice() : [];
        const extra_images = upsell === "extra_images" && !!document.getElementById("edr-bundle-check")?.checked;

        if (!twilight_filenames.length && !extra_images) {
          errEl.textContent = "Add something above before checking out.";
          errEl.hidden = false;
          return;
        }

        // Carries any feedback typed but not yet sent along with checkout,
        // rather than silently dropping it if Checkout is used first.
        const notes = feedbackSent ? "" : document.getElementById("edr-notes").value.trim();

        btn.disabled = true;
        const label = btn.textContent; btn.textContent = "Redirecting…";
        try {
          const res = await fetch(`${WORKER}/videography/edit-request`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, notes, twilight_filenames, extra_images }),
          });
          const out = await res.json().catch(() => ({}));
          if (!res.ok) { errEl.textContent = out.error || "Something went wrong. Please try again."; errEl.hidden = false; btn.disabled = false; btn.textContent = label; return; }
          if (out.checkout_url) { location.href = out.checkout_url; return; }
          errEl.textContent = "Something went wrong. Please try again.";
          errEl.hidden = false; btn.disabled = false; btn.textContent = label;
        } catch (e) {
          errEl.textContent = "Couldn't reach TMKE. Please try again in a moment.";
          errEl.hidden = false;
          btn.disabled = false; btn.textContent = label;
        }
      });

      updateCheckoutTotal();
    }

    (async () => {
      if (!token) { stage.innerHTML = `<p class="edr-msg">This link is missing its code. Please use the full link from your email.</p>`; return; }
      if (!WORKER) { stage.innerHTML = `<p class="edr-msg">This page is being set up — please try again shortly.</p>`; return; }
      try {
        const res = await fetch(`${WORKER}/videography/edit-request/context?token=${encodeURIComponent(token)}`);
        const d = await res.json().catch(() => ({}));
        if (!res.ok) { stage.innerHTML = `<p class="edr-msg">${esc(d.error || "We couldn't find this booking. Please use the link from your email, or contact TMKE.")}</p>`; return; }
        render(d);
      } catch (e) {
        stage.innerHTML = `<p class="edr-msg">Something went wrong loading this page. Please try again or contact TMKE.</p>`;
      }
    })();
  </script>
</BaseLayout>
