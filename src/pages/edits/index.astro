---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Request edits — TMKE"
  description="Ask TMKE for edits to your videography shoot, or add a twilight conversion or extra images."
  hideNav
  noindex
>
  <main class="edr">
    <header class="edr-head">
      <a href="/" class="edr-mark">TMKE</a>
      <span class="edr-head-tag">Videography</span>
    </header>

    <section class="edr-stage" id="edr-stage">
      <p class="edr-loading" id="edr-loading">Loading…</p>
    </section>
  </main>

  <style is:global>
    /* Astro's default scoped CSS only matches elements written directly in
       this file's template - it adds a data-astro-cid attribute to those,
       and rewrites every selector below to require it. Everything on this
       page except the outer shell (header, #edr-stage container) is built
       by the script at the bottom via innerHTML, so none of it ever gets
       that attribute - scoped mode would silently style nothing. Global
       mode drops the attribute requirement; the edr- prefix throughout
       keeps it from colliding with any other page's classes. */
    .edr { min-height: 100vh; background: var(--paper); }
    .edr-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 22px 36px; border-bottom: 1px solid rgba(28,29,34,0.1);
    }
    .edr-mark { font-family: var(--serif); font-size: 24px; font-weight: 600; letter-spacing: 0.04em; color: var(--ink); }
    .edr-head-tag { font-family: var(--sans); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); }

    .edr-stage { max-width: 640px; margin: 0 auto; padding: 56px 36px 120px; }
    .edr-loading, .edr-msg { font-family: var(--sans); font-size: 15px; color: rgba(28,29,34,0.6); padding: 60px 0; text-align: center; }

    .edr-eyebrow { font-family: var(--sans); font-size: 12px; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); margin-bottom: 14px; }
    .edr-title { font-family: var(--serif); font-weight: 400; font-size: clamp(30px, 4.5vw, 44px); line-height: 1.08; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 14px; }
    .edr-note { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(28,29,34,0.7); max-width: 56ch; margin: 0 0 36px; }

    .edr-banner { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border-radius: 999px; background: rgba(44,122,75,0.12); color: #2c7a4b; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 28px; }

    .edr-section { margin-bottom: 34px; }
    .edr-label { display: block; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); margin-bottom: 10px; }
    .edr-sub { font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: rgba(28,29,34,0.6); margin: -4px 0 14px; }
    textarea.edr-notes {
      width: 100%; min-height: 120px; padding: 14px 16px; font-family: var(--sans); font-size: 14.5px;
      border: 1px solid rgba(28,29,34,0.16); border-radius: 10px; resize: vertical; background: #fff; color: var(--ink);
    }
    textarea.edr-notes:focus { outline: none; border-color: var(--english-violet); }

    .edr-twilight-row { display: flex; gap: 8px; align-items: center; margin-bottom: 8px; }
    .edr-twilight-row input {
      flex: 1; padding: 11px 14px; font-family: var(--sans); font-size: 14px;
      border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; background: #fff; color: var(--ink);
    }
    .edr-twilight-row input:focus { outline: none; border-color: var(--english-violet); }
    .edr-row-del {
      width: 32px; height: 32px; flex: none; border-radius: 8px; border: 1px solid rgba(28,29,34,0.14);
      background: transparent; color: rgba(28,29,34,0.5); cursor: pointer; font-size: 16px; line-height: 1;
    }
    .edr-row-del:hover { border-color: rgba(180,40,40,0.4); color: #b42828; }
    .edr-add-row {
      font-family: var(--sans); font-size: 12.5px; font-weight: 700; letter-spacing: 0.08em;
      color: var(--english-violet); background: none; border: 0; cursor: pointer; padding: 6px 0;
    }
    .edr-add-row:hover { text-decoration: underline; }
    .edr-twilight-total { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); margin-top: 10px; }
    .edr-hint { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); margin-top: 6px; }

    .edr-bundle {
      display: flex; align-items: center; gap: 12px; padding: 14px 16px;
      border: 1px solid rgba(28,29,34,0.14); border-radius: 10px; background: #fff;
    }
    .edr-bundle input { width: 18px; height: 18px; accent-color: var(--english-violet); }
    .edr-bundle label { font-family: var(--sans); font-size: 14px; color: var(--ink); cursor: pointer; }
    .edr-bundle strong { color: var(--english-violet); }

    .edr-submit-row { position: sticky; bottom: 20px; margin-top: 40px; }
    .edr-submit-inner {
      display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px;
      background: var(--english-violet); color: var(--paper);
      border-radius: 14px; padding: 20px 26px; box-shadow: 0 18px 44px rgba(28,29,34,0.28);
    }
    .edr-submit-total { font-family: var(--serif); font-size: 22px; }
    .edr-submit-btn {
      font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      background: var(--paper); color: var(--english-violet); border: 0; border-radius: 999px;
      padding: 15px 26px; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s;
    }
    .edr-submit-btn:hover { transform: translateY(-1px); box-shadow: 0 10px 22px rgba(0,0,0,0.22); }
    .edr-submit-btn:disabled { opacity: 0.6; cursor: default; transform: none; box-shadow: none; }
    .edr-error { font-family: var(--sans); font-size: 13px; color: #b42828; margin-top: 12px; }
    .edr-thanks { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: var(--ink); padding: 40px 0; }

    @media (max-width: 720px) { .edr-stage { padding: 36px 20px 100px; } .edr-head { padding: 18px 20px; } }
  </style>

  <script>
    import { gbpFromPence } from "../../lib/supabase.js";
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");

    const stage = document.getElementById("edr-stage");
    const token = new URLSearchParams(location.search).get("token") || "";
    const justPaid = new URLSearchParams(location.search).get("paid") === "1";

    function esc(s) { return String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;"); }

    function addTwilightRow(list) {
      const row = document.createElement("div");
      row.className = "edr-twilight-row";
      row.innerHTML = `<input type="text" placeholder="Pixieset image filename" data-twilight-file />
        <button type="button" class="edr-row-del" aria-label="Remove">&times;</button>`;
      row.querySelector(".edr-row-del").addEventListener("click", () => { row.remove(); updateTotal(); });
      row.querySelector("[data-twilight-file]").addEventListener("input", updateTotal);
      list.appendChild(row);
      return row;
    }

    let twilightPricePence = 0;
    function updateTotal() {
      const rows = document.querySelectorAll("[data-twilight-file]");
      const filled = Array.from(rows).filter((el) => el.value.trim()).length;
      const total = document.getElementById("edr-twilight-total");
      const submitTotal = document.getElementById("edr-submit-total");
      const submitBtn = document.getElementById("edr-submit");
      const bundle = document.getElementById("edr-bundle-check");
      const bundlePence = (bundle && bundle.checked) ? window.__edrExtraPrice : 0;
      const pence = filled * twilightPricePence + bundlePence;
      if (total) total.textContent = filled ? `${filled} image${filled === 1 ? "" : "s"} — ${gbpFromPence(pence - bundlePence)}` : "";
      if (submitTotal) submitTotal.textContent = pence ? gbpFromPence(pence) : "";
      if (submitBtn) submitBtn.textContent = pence ? "Continue to payment" : "Send request";
    }

    function render(d) {
      const banner = justPaid ? `<div class="edr-banner">✓ Payment received — thank you</div>` : "";
      const upsell = d.upsell;
      twilightPricePence = d.twilight_price_pence || 0;
      window.__edrExtraPrice = (d.extra_images && d.extra_images.price_pence) || 0;

      const twilightBlock = upsell === "twilight" ? `
        <div class="edr-section">
          <span class="edr-label">Fancy a twilight shot?</span>
          <p class="edr-sub">We can turn any of your property photos into a twilight version — ${esc(gbpFromPence(twilightPricePence))}+VAT each. Click an image on your gallery and Pixieset shows the filename at the bottom — paste it below.</p>
          <div id="edr-twilight-rows"></div>
          <button type="button" class="edr-add-row" id="edr-add-row">+ Add another image</button>
          <p class="edr-twilight-total" id="edr-twilight-total"></p>
        </div>` : "";

      const bundleBlock = upsell === "extra_images" ? `
        <div class="edr-section">
          <span class="edr-label">Want more images?</span>
          <div class="edr-bundle">
            <input type="checkbox" id="edr-bundle-check" />
            <label for="edr-bundle-check">Add <strong>${d.extra_images.qty} extra images</strong> for <strong>${esc(gbpFromPence(d.extra_images.price_pence))}</strong></label>
          </div>
        </div>` : "";

      stage.innerHTML = `
        <div class="edr-eyebrow">Videography</div>
        <h1 class="edr-title">${d.client_name ? esc(d.client_name) + ", " : ""}let us know what you'd like.</h1>
        <p class="edr-note">Tell us about any edits you'd like to your content${upsell ? ", or add something extra below." : "."}</p>
        ${banner}
        <div class="edr-section">
          <span class="edr-label">What would you like changed?</span>
          <textarea class="edr-notes" id="edr-notes" placeholder="Describe the edits you'd like — as much detail as helps"></textarea>
          <p class="edr-hint">Leave this blank if you're only after the extras below.</p>
        </div>
        ${twilightBlock}
        ${bundleBlock}
        <div class="edr-submit-row">
          <div class="edr-submit-inner">
            <span class="edr-submit-total" id="edr-submit-total"></span>
            <button type="button" class="edr-submit-btn" id="edr-submit">Send request</button>
          </div>
        </div>
        <p class="edr-error" id="edr-error" hidden></p>`;

      if (upsell === "twilight") {
        const list = document.getElementById("edr-twilight-rows");
        addTwilightRow(list);
        document.getElementById("edr-add-row").addEventListener("click", () => addTwilightRow(list));
      }
      if (upsell === "extra_images") {
        document.getElementById("edr-bundle-check").addEventListener("change", updateTotal);
      }

      document.getElementById("edr-submit").addEventListener("click", async () => {
        const btn = document.getElementById("edr-submit");
        const errEl = document.getElementById("edr-error");
        errEl.hidden = true;
        const notes = document.getElementById("edr-notes").value.trim();
        const twilight_filenames = upsell === "twilight"
          ? Array.from(document.querySelectorAll("[data-twilight-file]")).map((el) => el.value.trim()).filter(Boolean)
          : [];
        const extra_images = upsell === "extra_images" && !!document.getElementById("edr-bundle-check")?.checked;

        if (!notes && !twilight_filenames.length && !extra_images) {
          errEl.textContent = "Add a note, or choose something to buy, before sending.";
          errEl.hidden = false;
          return;
        }

        btn.disabled = true;
        const label = btn.textContent; btn.textContent = "Sending…";
        try {
          const res = await fetch(`${WORKER}/videography/edit-request`, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ token, notes, twilight_filenames, extra_images }),
          });
          const out = await res.json().catch(() => ({}));
          if (!res.ok) { errEl.textContent = out.error || "Something went wrong. Please try again."; errEl.hidden = false; btn.disabled = false; btn.textContent = label; return; }
          if (out.checkout_url) { location.href = out.checkout_url; return; }
          stage.innerHTML = `<div class="edr-thanks"><p><strong>Thanks — that's with us.</strong></p><p>Jack will pick this up and be in touch once it's sorted.</p></div>`;
        } catch (e) {
          errEl.textContent = "Couldn't reach TMKE. Please try again in a moment.";
          errEl.hidden = false;
          btn.disabled = false; btn.textContent = label;
        }
      });

      updateTotal();
    }

    (async () => {
      if (!token) { stage.innerHTML = `<p class="edr-msg">This link is missing its code. Please use the full link from your email.</p>`; return; }
      if (!WORKER) { stage.innerHTML = `<p class="edr-msg">This page is being set up — please try again shortly.</p>`; return; }
      try {
        const res = await fetch(`${WORKER}/videography/edit-request/context?token=${encodeURIComponent(token)}`);
        const d = await res.json().catch(() => ({}));
        if (!res.ok) { stage.innerHTML = `<p class="edr-msg">${esc(d.error || "We couldn't find this booking. Please use the link from your email, or contact TMKE.")}</p>`; return; }
        render(d);
      } catch (e) {
        stage.innerHTML = `<p class="edr-msg">Something went wrong loading this page. Please try again or contact TMKE.</p>`;
      }
    })();
  </script>
</BaseLayout>
