---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Forgot password — TMKE"
  description="Reset the password for your TMKE library."
  hideFooter={true}
>
  <main class="login-shell">
    <div class="login-art" aria-hidden="true">
      <div class="login-art-overlay"></div>
      <div class="login-art-quote">
        <div class="chapter chapter--light">Members &middot; Reset</div>
        <p class="login-art-line">
          A new password,<br />
          <em>a fresh start.</em>
        </p>
        <p class="login-art-sub">
          Enter your email and we'll send a secure link to set a new password.
        </p>
      </div>
    </div>

    <section class="login-panel">
      <a href="/" class="login-mark">TMKE</a>

      <div class="login-card">
        <div class="eyebrow">Forgot password</div>
        <h1 class="login-title">Reset your password.</h1>
        <p class="login-sub">
          We'll email a one-time link. Click it, set a new password, you're back in.
          <button type="button" class="login-inline-link" id="back-to-signin">Back to sign in</button>.
        </p>

        <form id="forgot-form" class="login-form" novalidate>
          <label class="login-field">
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required placeholder="you@agency.co.uk" />
          </label>

          <button type="submit" class="btn btn--solid login-submit">
            <span data-label>Send reset link</span> <span class="btn-arrow">&rarr;</span>
          </button>

          <p id="forgot-error" class="login-error" hidden></p>
        </form>

        <div id="forgot-success" class="login-success" hidden>
          <p>
            <strong>Check your inbox.</strong> If the address is registered, you'll have a reset
            link from us in the next minute or two.
          </p>
          <p class="login-hint">
            Didn't get it? Check spam, or
            <button type="button" class="login-inline-link" id="forgot-retry">try again</button>.
          </p>
        </div>
      </div>

      <p class="login-meta">© 2026 TMKE — The Marketing Experts</p>
    </section>
  </main>

  <style>
    main.login-shell {
      display: grid;
      grid-template-columns: 1.05fr 1fr;
      min-height: 100vh;
      background: var(--paper);
    }
    .login-art {
      position: relative;
      overflow: hidden;
      background:
        linear-gradient(180deg, rgba(28,29,34,0.2), rgba(28,29,34,0.7)),
        url("/assets/door-closed.png") center/cover no-repeat;
      color: var(--paper);
    }
    .login-art-overlay {
      position: absolute; inset: 0;
      background: radial-gradient(80% 60% at 50% 40%, rgba(0,0,0,0) 30%, rgba(0,0,0,0.35) 100%);
      pointer-events: none;
    }
    .login-art-quote { position: absolute; inset: auto 0 0 0; padding: 0 56px 80px; }
    .login-art-quote .chapter { margin-bottom: 48px; }
    .login-art-line {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(40px, 4.4vw, 68px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      margin: 0 0 18px;
      color: var(--paper);
      max-width: 12ch;
    }
    .login-art-line em { font-style: italic; color: var(--french-grey); }
    .login-art-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: 20px;
      line-height: 1.45;
      color: rgba(240, 238, 235, 0.72);
      max-width: 38ch;
    }
    .login-panel {
      position: relative;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      padding: 48px 36px;
    }
    .login-mark {
      position: absolute; top: 32px; left: 36px;
      font-family: var(--serif); font-size: 24px;
      letter-spacing: 0.06em; color: var(--ink);
    }
    .login-card { width: 100%; max-width: 440px; }
    .login-card .eyebrow { margin-bottom: 14px; }
    .login-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(36px, 3.6vw, 52px);
      line-height: 1.05; letter-spacing: -0.015em;
      color: var(--ink); margin: 0 0 18px;
    }
    .login-sub {
      font-size: 15px; color: rgba(28, 29, 34, 0.62);
      margin: 0 0 36px;
    }
    .login-inline-link {
      background: transparent; border: 0; padding: 0; font: inherit;
      color: var(--english-violet);
      border-bottom: 1px solid currentColor;
      cursor: pointer;
    }
    .login-form { display: flex; flex-direction: column; gap: 18px; }
    .login-field { display: flex; flex-direction: column; gap: 8px; }
    .login-field > span {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(28, 29, 34, 0.55);
    }
    .login-field input {
      font-family: var(--sans); font-size: 16px;
      padding: 14px 16px;
      border: 1px solid rgba(28, 29, 34, 0.18);
      border-radius: 2px;
      background: #fff; color: var(--ink);
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .login-field input:focus {
      outline: none;
      border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(71, 66, 84, 0.12);
    }
    .login-submit {
      width: 100%; justify-content: center;
      padding: 16px; margin-top: 8px;
    }
    .login-error {
      font-size: 13px; color: #a05a3c;
      background: rgba(160, 90, 60, 0.08);
      padding: 10px 14px; border-radius: 2px; margin: 0;
    }
    .login-success {
      padding: 18px 18px 14px;
      background: rgba(71, 66, 84, 0.06);
      border-left: 2px solid var(--english-violet);
      border-radius: 2px;
    }
    .login-success p { margin: 0 0 8px; font-size: 14px; line-height: 1.6; color: rgba(28,29,34,0.75); }
    .login-success p:last-child { margin-bottom: 0; }
    .login-success strong { color: var(--ink); font-weight: 700; }
    .login-hint {
      font-size: 12px;
      color: rgba(28, 29, 34, 0.5);
      line-height: 1.5;
    }
    .login-meta {
      position: absolute; bottom: 32px;
      font-size: 11px; letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.35);
    }
    @media (max-width: 900px) {
      main.login-shell { grid-template-columns: 1fr; }
      .login-art { display: none; }
    }
  </style>

  <script>
    import { supabase } from "../lib/supabase.js";
    const form = document.getElementById("forgot-form");
    const errorEl = document.getElementById("forgot-error");
    const successEl = document.getElementById("forgot-success");
    const retryBtn = document.getElementById("forgot-retry");
    const backBtn = document.getElementById("back-to-signin");

    backBtn?.addEventListener("click", () => { location.href = "/login"; });

    function showError(msg) { errorEl.textContent = msg; errorEl.hidden = false; }
    function reset() {
      form.hidden = false; successEl.hidden = true; errorEl.hidden = true;
      form.reset();
    }
    retryBtn?.addEventListener("click", reset);

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const email = String(new FormData(form).get("email") || "").trim();
      if (!email) { showError("Enter your email."); return; }

      const btn = form.querySelector('button[type="submit"]');
      const label = btn.querySelector("[data-label]");
      btn.setAttribute("disabled", "true");
      const orig = label.textContent;
      label.textContent = "Sending…";

      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: `${location.origin}/reset-password`,
      });

      btn.removeAttribute("disabled");
      label.textContent = orig;

      if (error) { showError(error.message); return; }

      // Always show the same success message — don't leak whether the email exists
      form.hidden = true;
      successEl.hidden = false;
    });
  </script>
</BaseLayout>
