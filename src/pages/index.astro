---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="TMKE â€” The Marketing Experts"
  description="A specialist social media and marketing agency for the UK property sector. Premium templates, fully managed channels, structured content."
>
  <!-- ============================== HERO (TMKE fold-out)
       Centre: "TMKE" with the image showing through the letterforms + a dark
       outline. As you scroll the full image unfolds from the centre of the word
       to fill the screen (30px cream frame). Three bottom labels sit on top and
       shift dark->light as the photo passes under them. -->
  <section id="top" class="hero-zoom" data-reveal-root>
    <div class="hero-zoom-pin">
      <!-- Layer A â€” the photo that unfolds to full screen -->
      <div class="hero-zoom-media">
        <img class="hero-zoom-img" src="/assets/vibes.jpg" alt="A TMKE interior" />
      </div>
      <!-- Layer B â€” TMKE wordmark (brand serif), dead centre -->
      <h1 class="hero-zoom-word" aria-label="TMKE">TMKE</h1>
      <!-- Layer C â€” sofa-cushion cut-out, ABOVE the word so the E tucks behind
           it; revealed by the same iris clip as the photo. -->
      <div class="hero-zoom-fg">
        <img class="hero-zoom-fg-img" src="/assets/sofa%20invis.png" alt="" />
      </div>
      <!-- Bottom labels: left / centre / right -->
      <div class="hero-zoom-foot">
        <span class="hz-foot hz-foot--l">Established in 2025</span>
        <span class="hz-foot hz-foot--m">Marketing that actually works</span>
        <span class="hz-foot hz-foot--r">Chapter One</span>
      </div>
    </div>
  </section>

  <!-- ============================== SERVICES GRID
       Chapter 02. The four real cards line up with the page wrap; ghost
       cards on either side bleed off the viewport edges so the row reads
       as a continuous scroll-off rather than a contained set. -->
  <section class="services" data-reveal-root>
    <div class="wrap">
      <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 02 &mdash; The Studio</div>
      <div class="services-eyebrow reveal" data-reveal data-reveal-dir="up">
        <h2>
          <span class="services-eyebrow-line">A small studio with a sharp focus.</span>
          <em class="services-eyebrow-sub">Four ways in.</em>
        </h2>
      </div>
    </div>

    <!-- Bleed container â€” sits outside .wrap so the ghost cards can extend
         past both edges of the page. The inner grid still lines its real
         children up with .wrap's content rect via a calc-based gutter. -->
    <div class="services-bleed">
      <div class="services-grid" data-reveal>
        <!-- Ghost cards (left bleed) â€” outline only, no content. They imply
             a longer row scrolling in from off-screen. -->
        <span class="svc-card svc-card--ghost" aria-hidden="true"></span>
        <span class="svc-card svc-card--ghost svc-card--ghost-near" aria-hidden="true"></span>

        <a class="svc-card" href="/about">
          <div class="svc-hover-img" style="background-image:url('/assets/sunglasse.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">01</span>
          <div class="svc-num">01</div>
          <div class="svc-body">
            <h3 class="svc-title">TMKE<br /><span class="svc-title-amp">&amp;</span> The Studio</h3>
            <div class="svc-tag">For the story</div>
          </div>
          <div class="svc-action">About <span class="svc-arrow">&rarr;</span></div>
        </a>
        <a class="svc-card" href="/edit">
          <div class="svc-hover-img" style="background-image:url('/assets/dog.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">02</span>
          <div class="svc-num">02</div>
          <div class="svc-body">
            <h3 class="svc-title">The Edit<br /><span class="svc-title-amp">&amp;</span> Templates</h3>
            <div class="svc-tag">For the toolkit</div>
          </div>
          <div class="svc-action">Shop <span class="svc-arrow">&rarr;</span></div>
        </a>
        <a class="svc-card" href="/services">
          <div class="svc-hover-img" style="background-image:url('/assets/home%20window.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">03</span>
          <div class="svc-num">03</div>
          <div class="svc-body">
            <h3 class="svc-title">SMM<br /><span class="svc-title-amp">&amp;</span> Management</h3>
            <div class="svc-tag">For the handoff</div>
          </div>
          <div class="svc-action">Book <span class="svc-arrow">&rarr;</span></div>
        </a>
        <a class="svc-card" href="/contact">
          <div class="svc-hover-img" style="background-image:url('/assets/phone%20me.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">04</span>
          <div class="svc-num">04</div>
          <div class="svc-body">
            <h3 class="svc-title">Let&rsquo;s Chat<br /><span class="svc-title-amp">&amp;</span> Discover</h3>
            <div class="svc-tag">For the start</div>
          </div>
          <div class="svc-action">Talk <span class="svc-arrow">&rarr;</span></div>
        </a>

        <!-- Ghost cards (right bleed) -->
        <span class="svc-card svc-card--ghost svc-card--ghost-near" aria-hidden="true"></span>
        <span class="svc-card svc-card--ghost" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- ============================== EDITORIAL INTRO
       Chapter 03. Layout shifts to a two-row stack: the editorial lead
       fills the upper-left, then below it on the right sits the
       "We don't do generic marketing" block with its own heading. The
       bottom padding below buys breathing room before Chapter 04 pins. -->
  <section id="about" class="editorial wrap" data-reveal-root>
    <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 03 &mdash; On Marketing</div>
    <div class="editorial-grid editorial-grid--stack">
      <div class="editorial-lead-col">
        <p class="editorial-lead split" data-reveal data-reveal-dir="up">
          <span class="split-line"><span>We work with estate agents, lettings businesses,</span></span>
          <span class="split-line"><span>and property brands across the UK to <em>improve</em></span></span>
          <span class="split-line"><span>how they show up online. Building a clear,</span></span>
          <span class="split-line"><span>consistent presence that reflects the quality</span></span>
          <span class="split-line"><span>of their service. Whatever their budget,</span></span>
          <span class="split-line"><span>whatever their starting point.</span></span>
        </p>
      </div>
      <aside class="editorial-side editorial-side--below" data-reveal data-reveal-dir="right">
        <h3 class="editorial-side-heading">We don&rsquo;t do generic marketing.</h3>
        <p>TMKE is built specifically for the property sector, combining industry understanding with a clear, structured approach to content.</p>
        <p>And because great marketing shouldn&rsquo;t only be available to agencies with big budgets, we&rsquo;ve built two ways to work with us, so every agent can access the same quality of thinking, at the level that works for them right now.</p>
      </aside>
    </div>
  </section>

  <!-- ============================== APPROACH â€” zoom-takeover (v3)
       Chapter 04, round-4 redesign. Inspired by the CUUB reference the
       user shared: a single hero photo starts as a contained panel
       beneath a title block, scrolls open to fill the viewport
       (sticky-takeover), then runs through four stages where the photo
       crossfades behind the same overlay layout, then finally zooms
       back out to a contained panel before handing off to Chapter 05.
       The controller in app.js drives one master --progress (0â†’1)
       across the whole section, and the CSS derives every animation
       from it via clip-path interpolation + targeted opacity stages.
       The .approach-stage/.approach-visual legacy CSS rules from the
       previous cinematic-stages design stay in the stylesheet but no
       longer match any markup. -->
  <!-- ============================== CHAPTER 04 â€” paired property scroller
       50/50 split: the left panel travels up while the right travels down,
       each pair two views of one property. A centre statement holds while a
       corner label fades in per stage. Driven by the controller near the foot
       of this file. -->
  <section id="for-agents" class="ch4" data-reveal-root>
    <div class="ch4-pin">
      <div class="ch4-panels">
        <div class="ch4-col ch4-col--left">
          <div class="ch4-strip" data-ch4="left">
            <div class="ch4-cell"><img src="/assets/orange%201.jpg" alt="" /></div>
            <div class="ch4-cell"><img src="/assets/white%201.jpg" alt="" /></div>
            <div class="ch4-cell"><img src="/assets/kitchen%201.jpg" alt="" /></div>
            <div class="ch4-cell"><img src="/assets/living%201.jpg" alt="" /></div>
          </div>
        </div>
        <div class="ch4-col ch4-col--right">
          <!-- reversed order so this column travels DOWN as the left goes up -->
          <div class="ch4-strip" data-ch4="right">
            <div class="ch4-cell"><img src="/assets/living%202.jpg" alt="" /></div>
            <div class="ch4-cell"><img src="/assets/kitchen%202.jpg" alt="" /></div>
            <div class="ch4-cell"><img src="/assets/white%202.jpg" alt="" /></div>
            <div class="ch4-cell"><img src="/assets/orange%202.jpg" alt="" /></div>
          </div>
        </div>
      </div>

      <div class="ch4-overlay">
        <div class="ch4-eyebrow">Chapter 04 &mdash; Approach</div>
        <div class="ch4-box">
          <p class="ch4-statement">Built for agents who want<br />more than just property posts</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================================
       CH 05 â€” THE EDIT (records on a shelf)
       Full-screen wall + shelf (shelf3.png). The template assets sit on the
       three shelves like records, leaning back with directional shadows, and
       lift off on hover. Copy top-left, CTA bottom-right.
       ============================================================ -->
  <section id="edit" class="shelf-scene">
    <div class="shelf-copy">
      <div class="chapter">Chapter 05 &mdash; The Edit</div>
      <h2 class="shelf-title">The Edit</h2>
      <p class="shelf-sub">Ready-made templates, lined up and ready. Hover to lift one off the shelf.</p>
    </div>

    <div class="shelf-stage">
      <!-- Two shelves (shelf2.png), four records on each = eight in total.
           The records sit in front of the shelf image, resting on each shelf
           and leaning back. Even columns at 6 / 28.67 / 51.33 / 74%. -->
      <img class="shelf-bg" src="/assets/shelf2.png" alt="" aria-hidden="true" />

      <a class="shelf-rec shelf-rec--s1" style="--x:6%;"     href="/edit" aria-label="Browse The Edit"><img src="/assets/4.png" alt="A TMKE template" loading="lazy" decoding="async" /></a>
      <a class="shelf-rec shelf-rec--s1" style="--x:28.67%;" href="/edit" aria-label="Browse The Edit"><img src="/assets/5.png" alt="A TMKE template" loading="lazy" decoding="async" /></a>
      <a class="shelf-rec shelf-rec--s1" style="--x:51.33%;" href="/edit" aria-label="Browse The Edit"><img src="/assets/6.png" alt="A TMKE template" loading="lazy" decoding="async" /></a>
      <a class="shelf-rec shelf-rec--s1" style="--x:74%;"    href="/edit" aria-label="Browse The Edit"><img src="/assets/7.png" alt="A TMKE template" loading="lazy" decoding="async" /></a>

      <a class="shelf-rec shelf-rec--s2" style="--x:6%;"     href="/edit" aria-label="Browse The Edit"><img src="/assets/8.png" alt="A TMKE template" loading="lazy" decoding="async" /></a>
      <a class="shelf-rec shelf-rec--s2" style="--x:28.67%;" href="/edit" aria-label="Browse The Edit"><img src="/assets/9.png" alt="A TMKE template" loading="lazy" decoding="async" /></a>
      <a class="shelf-rec shelf-rec--s2" style="--x:51.33%;" href="/edit" aria-label="Browse The Edit"><img src="/assets/10.png" alt="A TMKE template" loading="lazy" decoding="async" /></a>
      <a class="shelf-rec shelf-rec--s2" style="--x:74%;"    href="/edit" aria-label="Browse The Edit"><img src="/assets/5.png" alt="A TMKE template" loading="lazy" decoding="async" /></a>
    </div>

    <!-- CTA parked in the bottom-right corner to balance the top-left copy. -->
    <a class="edit-cta shelf-cta shelf-cta-corner" href="/edit">
      <span class="edit-cta-label">Browse the Edit</span>
      <span class="edit-cta-arrow" aria-hidden="true">&rarr;</span>
    </a>
  </section>

  <!-- Template-pack showcase. Clicking a record opens a full-screen lightbox
       that steps through the pack's designs one big image at a time (placeholder
       Unsplash shots for now), with a checkout CTA (inert until checkout exists). -->
  <div class="edit-modal" id="edit-modal" hidden>
    <div class="edit-modal-scrim" data-edit-close></div>
    <button type="button" class="edit-modal-close" data-edit-close aria-label="Close">&times;</button>
    <button type="button" class="edit-modal-arrow edit-modal-arrow--prev" id="edit-prev" aria-label="Previous design">&lsaquo;</button>
    <figure class="edit-modal-stage" role="dialog" aria-modal="true" aria-label="Template showcase">
      <img class="edit-modal-img" id="edit-modal-img" alt="Template preview" />
    </figure>
    <button type="button" class="edit-modal-arrow edit-modal-arrow--next" id="edit-next" aria-label="Next design">&rsaquo;</button>
    <div class="edit-modal-bar">
      <div class="edit-modal-meta">
        <span id="edit-modal-title">Template Pack</span>
        <span class="edit-modal-dot">&middot;</span>
        <span id="edit-modal-count">1 / 5</span>
      </div>
      <button type="button" class="btn btn--solid edit-modal-buy" title="Checkout coming soon">
        Download &amp; Buy <span class="btn-arrow" aria-hidden="true">&rarr;</span>
      </button>
    </div>
  </div>

  <script is:inline>
    (function () {
      var modal = document.getElementById("edit-modal");
      if (!modal) return;
      var imgEl = document.getElementById("edit-modal-img");
      var titleEl = document.getElementById("edit-modal-title");
      var countEl = document.getElementById("edit-modal-count");
      var recs = Array.prototype.slice.call(document.querySelectorAll(".shelf-rec"));
      var U = function (id) {
        return "https://images.unsplash.com/photo-" + id + "?auto=format&fit=crop&w=1600&q=80";
      };
      // Generic, on-brand placeholders â€” swapped for real showcase shots later.
      var GENERIC = [
        U("1505691938895-1758d7feb511"), U("1493809842364-78817add7ffb"),
        U("1484154218962-a197022b5858"), U("1522708323590-d24dbb6b0267"),
        U("1556909114-f6e7ad7d3136"),    U("1513161455079-7dc1de15ef3e"),
        U("1567016432779-094069958ea5"), U("1524758631624-e2822e304c36"),
      ];
      var list = [], idx = 0;
      function render() {
        imgEl.src = list[idx];
        countEl.textContent = (idx + 1) + " / " + list.length;
      }
      function open(i) {
        var rec = recs[i];
        var cover = rec && rec.querySelector("img") ? rec.querySelector("img").getAttribute("src") : null;
        titleEl.textContent = "Template Pack " + (i + 1);
        list = [];
        if (cover) list.push(cover);
        for (var k = 0; list.length < 5; k++) list.push(GENERIC[(i + k) % GENERIC.length]);
        idx = 0; render();
        modal.hidden = false;
        document.body.classList.add("edit-modal-open");
        requestAnimationFrame(function () { modal.classList.add("is-open"); });
      }
      function close() {
        modal.classList.remove("is-open");
        document.body.classList.remove("edit-modal-open");
        setTimeout(function () { modal.hidden = true; }, 300);
      }
      function step(d) { if (!list.length) return; idx = (idx + d + list.length) % list.length; render(); }
      recs.forEach(function (rec, i) {
        rec.addEventListener("click", function (e) { e.preventDefault(); open(i); });
      });
      document.getElementById("edit-prev").addEventListener("click", function () { step(-1); });
      document.getElementById("edit-next").addEventListener("click", function () { step(1); });
      modal.querySelectorAll("[data-edit-close]").forEach(function (el) {
        el.addEventListener("click", close);
      });
      document.addEventListener("keydown", function (e) {
        if (modal.hidden) return;
        if (e.key === "Escape") close();
        else if (e.key === "ArrowLeft") step(-1);
        else if (e.key === "ArrowRight") step(1);
      });
    })();
  </script>

  <!-- ============================== CH 06 â€” SOCIAL MEDIA
       Mirrors the Ch 05 pattern: copy on the left, image on the right,
       and the SMM coda block sits below tucked under the image column so
       it reads as part of the same composition. -->
  <section id="social" class="quote quote--split" data-reveal-root>
    <div class="quote-split-grid">
      <div class="quote-left">
        <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 06 &mdash; Social Media</div>
        <div class="quote-mark" aria-hidden="true">&ldquo;</div>
        <blockquote class="quote-text split" data-reveal data-reveal-dir="up">
          <span class="split-line"><span>We work with agencies who know their</span></span>
          <span class="split-line"><span>marketing matters, they just don&rsquo;t have</span></span>
          <span class="split-line"><span>the time or headspace to do it properly.</span></span>
          <span class="split-line"><span>If you care about how your brand shows</span></span>
          <span class="split-line"><span>up but don&rsquo;t want to manage it day to day &mdash;</span></span>
          <span class="split-line"><span><em>this is where we step in.</em></span></span>
        </blockquote>
      </div>

      <div class="quote-right">
        <figure class="quote-photo quote-photo--full quote-photo--table" data-reveal data-reveal-dir="right">
          <div class="quote-photo-frame">
            <img src="/assets/table.jpg" alt="" loading="lazy" />
          </div>
          <figcaption class="quote-photo-caption">
            <span class="quote-photo-line"></span>
            <span>The Studio &middot; London</span>
          </figcaption>
        </figure>

        <!-- SMM coda â€” sits below the image, kept in line with the image
             column. Matches the layout in the client mockup where the
             "Social Media Management" block tucks underneath the photo. -->
        <div class="quote-coda" data-reveal data-reveal-dir="up">
          <h3 class="quote-coda-heading">Social Media Management.</h3>
          <p class="quote-coda-copy">We plan, create, and deliver consistent, on-brand content that reflects your business and supports long-term growth, without adding to your workload.</p>
          <p class="quote-coda-copy">One point of contact. One calendar. One brand that finally looks like the service you deliver.</p>
          <a href="/contact" class="btn btn--solid">Get Started <span class="btn-arrow">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Five & Live now lives exclusively in the floating Free Assets tab on the left edge. -->

  <!-- ============================== NEWS / SUBSCRIBE -->
  <section id="news" class="news" data-reveal-root>
    <div class="news-bg" style="background-image:url('https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=2400&q=80')"></div>
    <div class="news-content">
      <div class="chapter chapter--light">Chapter 07 &mdash; News</div>
      <div class="news-eyebrow">TMKE</div>
      <div class="news-title">News</div>
      <p class="news-lead">For the days you know you should post, but don&rsquo;t know what.</p>
      <p class="news-copy">Get clear, structured marketing insights for estate agents, straight to your inbox every month.</p>
      <form class="news-form" id="news-form">
        <input type="email" placeholder="your@email.com" required />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- Five & Live floating tab removed for now (per design review). -->

  <!-- ===================== TMKE fold-out hero styles ===================== -->
  <style>
    .hero-zoom {
      position: relative;
      height: 260vh;            /* scroll length of the unfold */
      background: var(--paper);
    }
    .hero-zoom-pin {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    /* Layer A â€” the photo, revealed by a circle that irises out from the centre
       of the word to fill a 30px-framed full screen. */
    .hero-zoom-media {
      position: absolute;
      /* Image runs all the way to the top (under the nav); 30px frame on the
         other three sides. */
      inset: 0 30px 30px 30px;
      z-index: 2;
      overflow: hidden;
      clip-path: circle(0px at 50% 50%);  /* JS grows the radius */
      will-change: clip-path;
    }
    .hero-zoom-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Layer B â€” TMKE, solid dark purple, dead centre; recolours to white as the
       photo irises out behind it (colour set by the controller). */
    .hero-zoom-word {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      z-index: 3;
      margin: 0;
      /* Brand wordmark font â€” matches the top-left logo (Cormorant) */
      font-family: var(--serif);
      font-weight: 600;
      font-size: clamp(96px, 15vw, 230px);
      line-height: 1;
      letter-spacing: 0.04em;
      text-align: center;
      color: var(--english-violet);
      will-change: color;
    }

    /* Layer C â€” sofa cushions over the word (same iris clip, set by the
       controller). object-fit/position mirror the photo so they line up. */
    .hero-zoom-fg {
      position: absolute;
      inset: 0 30px 30px 30px;
      z-index: 4;
      overflow: hidden;
      clip-path: circle(0px at 50% 50%);
      pointer-events: none;
      will-change: clip-path;
    }
    .hero-zoom-fg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Keep the nav transparent while the hero fills the viewport so the photo
       bleeds up behind it (toggled by the controller). */
    :global(.nav.nav--over-hero) {
      background: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border-bottom: none !important;
      /* hold the base height so the scrolled-state padding never makes the bar
         grow / "drop down" over the hero */
      padding-top: 9px !important;
      padding-bottom: 9px !important;
    }
    /* Once the photo has risen behind the nav, flip the logo / links / login /
       burger to white so they stay legible over the image. */
    :global(.nav.nav--on-image) { color: #fff !important; }
    :global(.nav.nav--on-image .nav-burger span) { background: #fff !important; }

    /* Bottom labels â€” sit on top of everything; shift dark->light as the photo
       passes under them (colour set by the controller). */
    .hero-zoom-foot {
      position: absolute;
      left: 0; right: 0;
      bottom: 40px;
      z-index: 4;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
      gap: 24px;
      padding: 0 48px;
      color: var(--ink);
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }
    .hero-zoom-foot .hz-foot--l { justify-self: start; }
    .hero-zoom-foot .hz-foot--m { justify-self: center; letter-spacing: 0.14em; text-align: center; }
    .hero-zoom-foot .hz-foot--r { justify-self: end; text-align: right; }

    @media (max-width: 860px) {
      .hero-zoom { height: 200vh; }
      .hero-zoom-word { font-size: clamp(64px, 24vw, 150px); -webkit-text-stroke-width: 1.5px; }
      .hero-zoom-foot { font-size: 10px; padding: 0 22px; gap: 12px; bottom: 28px; }
    }

    /* Reduced motion: present the full framed photo + labels, no scrub. */
    @media (prefers-reduced-motion: reduce) {
      .hero-zoom { height: 100vh; }
      .hero-zoom-media { clip-path: inset(30px round 0) !important; }
      .hero-zoom-word { display: none; }
      .hero-zoom-foot { color: var(--paper); }
    }
  </style>

  <!-- Fold-out controller: the photo unfolds from the centre of the TMKE
       lettering to a 30px-framed full screen; the word fades as it goes, and
       the bottom labels shift dark->light as the photo arrives under them. -->
  <script>
    (function () {
      const hero = document.querySelector(".hero-zoom");
      if (!hero) return;
      const media = hero.querySelector(".hero-zoom-media");
      const fg = hero.querySelector(".hero-zoom-fg");
      const word = hero.querySelector(".hero-zoom-word");
      const foot = hero.querySelector(".hero-zoom-foot");
      const nav = document.getElementById("nav");
      const smooth = (t) => t * t * (3 - 2 * t);
      const clamp01 = (t) => Math.max(0, Math.min(1, t));
      const lerp = (a, b, t) => a + (b - a) * t;
      const update = () => {
        const rect = hero.getBoundingClientRect();
        const total = hero.offsetHeight - window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top, 0), total);
        const p = total > 0 ? scrolled / total : 0;
        const e = smooth(clamp01(p / 0.82));             // iris out over first ~82%
        const vw = window.innerWidth, vh = window.innerHeight;
        // circle irises out from the viewport centre (where the word sits) until
        // it covers the box (top:0, 30px on the other sides â†’ top corners reach last)
        const halfW = vw / 2 - 30, halfH = vh / 2;
        const rMax = Math.sqrt(halfW * halfW + halfH * halfH);
        const clip = "circle(" + (e * rMax).toFixed(1) + "px at 50% " + (vh / 2).toFixed(0) + "px)";
        media.style.clipPath = clip;
        if (fg) fg.style.clipPath = clip;     // cushions reveal in lockstep
        // word: dark purple -> white as the photo irises past it
        const wc = smooth(clamp01((e - 0.04) / 0.42));
        word.style.color =
          "rgb(" + Math.round(lerp(71, 255, wc)) + "," + Math.round(lerp(66, 255, wc)) + "," + Math.round(lerp(84, 255, wc)) + ")";
        // bottom labels: ink -> paper as the photo reaches them (late)
        const t = smooth(clamp01((e - 0.55) / 0.4));
        foot.style.color =
          "rgb(" + Math.round(lerp(28, 242, t)) + "," + Math.round(lerp(29, 239, t)) + "," + Math.round(lerp(34, 233, t)) + ")";
        // nav: transparent while the hero covers the viewport; flip to white once
        // the photo has risen behind it
        if (nav) {
          nav.classList.toggle("nav--over-hero", rect.bottom > vh + 1);
          nav.classList.toggle("nav--on-image", rect.bottom > vh + 1 && e > 0.5);
        }
      };
      update();
      if (window.__lenis && typeof window.__lenis.on === "function") {
        window.__lenis.on("scroll", update);
      } else {
        window.addEventListener("scroll", update, { passive: true });
      }
      window.addEventListener("resize", update, { passive: true });
    })();
  </script>

  <!-- ===================== Chapter 04 paired-scroller styles ===================== -->
  <style>
    .ch4 { position: relative; height: 600vh; background: var(--paper); }
    .ch4-pin { position: sticky; top: 0; height: 100vh; overflow: hidden; }
    .ch4-panels {
      position: absolute;
      inset: 30px;                       /* 30px frame, like the hero */
      display: grid;
      grid-template-columns: 1fr 1fr;    /* 50 / 50 */
      overflow: hidden;
    }
    .ch4-col { position: relative; overflow: hidden; height: 100%; }
    .ch4-strip {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 400%;                      /* four full-height cells */
      display: flex;
      flex-direction: column;
      will-change: transform;
    }
    .ch4-cell { height: 25%; overflow: hidden; }
    .ch4-cell img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* Centre overlay â€” eyebrow + double-line box around the statement.
       Faded by the controller as the panels start to move. */
    .ch4-overlay {
      position: absolute;
      left: 50%; top: 50%;
      transform: translate(-50%, -50%);
      z-index: 3;
      width: min(720px, 86vw);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
      pointer-events: none;
    }
    .ch4-eyebrow {
      display: flex; align-items: center; gap: 16px;
      font-family: var(--sans);
      font-size: 12px; font-weight: 700;
      letter-spacing: 0.3em; text-transform: uppercase;
      color: rgba(255, 255, 255, 0.78);
    }
    .ch4-eyebrow::before, .ch4-eyebrow::after {
      content: ""; width: 40px; height: 1px; background: currentColor; opacity: 0.5;
    }
    /* Double-line box: outer border + an inset inner border, with a subtle
       blurred/dimmed backdrop so the white text reads over any image. */
    .ch4-box {
      position: relative;
      width: 100%;
      padding: 54px 48px;
      border: 1px solid rgba(255, 255, 255, 0.55);
      background: rgba(14, 14, 17, 0.22);
      backdrop-filter: blur(8px) brightness(0.82);
      -webkit-backdrop-filter: blur(8px) brightness(0.82);
    }
    .ch4-box::before {
      content: "";
      position: absolute; inset: 7px;
      border: 1px solid rgba(255, 255, 255, 0.32);
      pointer-events: none;
    }
    .ch4-statement {
      margin: 0;
      text-align: center;
      color: #fff;
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(26px, 3.2vw, 46px);
      line-height: 1.12;
      letter-spacing: -0.01em;
    }

    @media (max-width: 860px) {
      .ch4 { height: 480vh; }
      .ch4-box { padding: 36px 26px; }
      .ch4-statement { font-size: clamp(20px, 5.4vw, 30px); }
    }
    @media (prefers-reduced-motion: reduce) {
      .ch4 { height: 100vh; }
    }
  </style>

  <!-- Chapter 04 controller: left strip travels up, right strip travels down
       (reversed DOM order keeps the property pairs aligned). Corner labels fade
       in around their stage. Continuous/scroll-driven for now; snap-to-stage is
       a follow-up. -->
  <script>
    (function () {
      const ch4 = document.querySelector(".ch4");
      if (!ch4) return;
      const left = ch4.querySelector('[data-ch4="left"]');
      const right = ch4.querySelector('[data-ch4="right"]');
      const overlay = ch4.querySelector(".ch4-overlay");
      const N = 4;
      const DWELL = 0.22;        // entry dead-zone: holds longer so you can read
      const clamp01 = (t) => Math.max(0, Math.min(1, t));
      const smooth = (t) => t * t * (3 - 2 * t);
      const lenis = window.__lenis;
      let snapping = false, snapTimer = 0;

      const prog = () => {
        const rect = ch4.getBoundingClientRect();
        const total = ch4.offsetHeight - window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top, 0), total);
        return { p: total > 0 ? scrolled / total : 0, rect, total };
      };

      const update = () => {
        const { p } = prog();
        const pe = clamp01((p - DWELL) / (1 - DWELL));   // effective progress after the dwell
        const pos = pe * (N - 1);                        // 0 .. 3
        left.style.transform = "translateY(" + (-pos * 25).toFixed(3) + "%)";
        right.style.transform = "translateY(" + (-(N - 1 - pos) * 25).toFixed(3) + "%)";
        // boxed statement holds through the dwell, then fades as panels move
        overlay.style.opacity = (1 - smooth(clamp01((pe - 0.06) / 0.4))).toFixed(3);
      };

      // scroll Y that lands the section on stage i
      const stageY = (i) => {
        const total = ch4.offsetHeight - window.innerHeight;
        const top = ch4.getBoundingClientRect().top + window.scrollY;
        return top + (DWELL + (i / (N - 1)) * (1 - DWELL)) * total;
      };

      // when scrolling stops over the pinned section, snap to the nearest stage
      const scheduleSnap = () => {
        if (snapping) return;
        clearTimeout(snapTimer);
        snapTimer = setTimeout(() => {
          const { p, rect } = prog();
          // only while fully pinned â€” lets you enter from the top / exit past the
          // bottom without being trapped
          if (rect.top > 0 || rect.bottom < window.innerHeight) return;
          const pe = clamp01((p - DWELL) / (1 - DWELL));
          const y = stageY(Math.round(pe * (N - 1)));
          snapping = true;
          const done = () => { snapping = false; };
          if (lenis && typeof lenis.scrollTo === "function") lenis.scrollTo(y, { duration: 0.45, onComplete: done });
          else { window.scrollTo({ top: y, behavior: "smooth" }); setTimeout(done, 450); }
          setTimeout(done, 900);   // safety: always release, even if a snap is interrupted
        }, 90);
      };

      const onScroll = () => { update(); scheduleSnap(); };
      update();
      if (lenis && typeof lenis.on === "function") lenis.on("scroll", onScroll);
      else window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", update, { passive: true });
    })();
  </script>

  <!-- ===================== Chapter 06 â€” Table photo ===================== -->
  <style>
    /* No shadow, no darkening gradient on the table photo. */
    #social .quote-photo--table .quote-photo-frame { box-shadow: none; }
    #social .quote-photo--table .quote-photo-frame::after { display: none; }
    #social .quote-photo--table .quote-photo-frame img {
      object-position: center;
      transform: none;
      animation: none;
    }
    /* Keep the fade-in, but let the parallax transform update untransitioned. */
    #social .quote-photo--table {
      transition: opacity 0.8s ease;
      will-change: transform;
    }
  </style>

  <!-- Chapter 06: the table photo rises up from off-screen bottom-right, comes
       over into line with the studio caption, then carries on up and off the
       top â€” a scroll-driven parallax. -->
  <script>
    (function () {
      const section = document.getElementById("social");
      if (!section) return;
      const photo = section.querySelector(".quote-photo--table");
      if (!photo) return;
      const MAG_Y = 240, MAG_X = 90;
      const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
      const update = () => {
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        const center = rect.top + rect.height / 2;
        // +1 when the section sits below the fold, 0 centred, -1 when above
        const t = clamp((center - vh / 2) / (vh / 2 + rect.height / 2), -1, 1);
        const x = (t > 0 ? t : 0) * MAG_X;   // slides in from the right on the way up
        const y = t * MAG_Y;                 // down on entry, aligned at centre, up on exit
        photo.style.transform = "translate(" + x.toFixed(1) + "px," + y.toFixed(1) + "px)";
      };
      update();
      if (window.__lenis && typeof window.__lenis.on === "function") window.__lenis.on("scroll", update);
      else window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update, { passive: true });
    })();
  </script>
</BaseLayout>
