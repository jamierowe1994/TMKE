---
import BaseLayout from "../layouts/BaseLayout.astro";
import FreeAssets from "../components/FreeAssets.astro";
---

<BaseLayout
  title="TMKE — The Marketing Experts"
  description="A specialist social media and marketing agency for the UK property sector. Premium templates, fully managed channels, structured content."
>
  <!-- ============================== HERO -->
  <section id="top" class="hero" data-reveal-root>
    <video
      class="hero-video"
      src="/assets/Hero%20smaller.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="auto"></video>
    <div class="hero-vignette"></div>
    <div class="hero-grain"></div>

    <div class="hero-bar hero-bar--top"></div>
    <div class="hero-bar hero-bar--bottom"></div>

    <div class="hero-content">
      <div class="hero-chapter">Chapter 01 &mdash; The Marketing Experts</div>
      <h1 class="hero-mark">TMKE</h1>
      <div class="hero-rule"></div>
      <p class="hero-sub">The future of property marketing.</p>
    </div>

    <div class="hero-foot">
      <div>
        London<br />
        <small>Est. MMXXIV</small>
      </div>
      <div class="hero-scroll-cue">
        <span class="hero-scroll-cue-line"></span>
        Scroll
      </div>
    </div>
  </section>

  <!-- ============================== SERVICES GRID -->
  <section class="services wrap">
    <div class="chapter reveal" data-reveal>Chapter 02 &mdash; The Studio</div>
    <div class="services-eyebrow reveal" data-reveal>
      <h2>
        A small studio with a sharp focus.<br />
        <em>Four ways in.</em>
      </h2>
      <p>Pick your path &mdash; we&rsquo;ll meet you there. From a single template to a fully managed channel.</p>
    </div>

    <div class="services-grid" data-reveal>
      <a class="svc-card" href="/about">
        <div class="svc-hover-img" style="background-image:url('/assets/sunglasse.jpg')" aria-hidden="true"></div>
        <span class="svc-watermark" aria-hidden="true">01</span>
        <div class="svc-num">01</div>
        <div class="svc-body">
          <h3 class="svc-title">TMKE<br /><span class="svc-title-amp">&amp;</span> The Studio</h3>
          <div class="svc-tag">For the story</div>
        </div>
        <div class="svc-action">About <span class="svc-arrow">&rarr;</span></div>
      </a>
      <a class="svc-card" href="/edit">
        <div class="svc-hover-img" style="background-image:url('/assets/dog.jpg')" aria-hidden="true"></div>
        <span class="svc-watermark" aria-hidden="true">02</span>
        <div class="svc-num">02</div>
        <div class="svc-body">
          <h3 class="svc-title">The Edit<br /><span class="svc-title-amp">&amp;</span> Templates</h3>
          <div class="svc-tag">For the toolkit</div>
        </div>
        <div class="svc-action">Shop <span class="svc-arrow">&rarr;</span></div>
      </a>
      <a class="svc-card" href="/services">
        <div class="svc-hover-img" style="background-image:url('/assets/home%20window.jpg')" aria-hidden="true"></div>
        <span class="svc-watermark" aria-hidden="true">03</span>
        <div class="svc-num">03</div>
        <div class="svc-body">
          <h3 class="svc-title">SMM<br /><span class="svc-title-amp">&amp;</span> Management</h3>
          <div class="svc-tag">For the handoff</div>
        </div>
        <div class="svc-action">Book <span class="svc-arrow">&rarr;</span></div>
      </a>
      <a class="svc-card" href="/contact">
        <div class="svc-hover-img" style="background-image:url('/assets/phone%20me.jpg')" aria-hidden="true"></div>
        <span class="svc-watermark" aria-hidden="true">04</span>
        <div class="svc-num">04</div>
        <div class="svc-body">
          <h3 class="svc-title">Let&rsquo;s Chat<br /><span class="svc-title-amp">&amp;</span> Discover</h3>
          <div class="svc-tag">For the start</div>
        </div>
        <div class="svc-action">Talk <span class="svc-arrow">&rarr;</span></div>
      </a>
    </div>
  </section>

  <!-- ============================== EDITORIAL INTRO -->
  <section id="about" class="editorial wrap">
    <div class="chapter reveal" data-reveal>Chapter 03 &mdash; On Marketing</div>
    <div class="editorial-grid">
      <div>
        <p class="editorial-lead split" data-reveal>
          <span class="split-line"><span>We work with estate agents, lettings businesses,</span></span>
          <span class="split-line"><span>and property brands across the UK to <em>improve</em></span></span>
          <span class="split-line"><span>how they show up online. Building a clear,</span></span>
          <span class="split-line"><span>consistent presence that reflects the quality</span></span>
          <span class="split-line"><span>of their service &mdash; never second-guessed.</span></span>
        </p>
      </div>
      <aside class="editorial-side reveal reveal-delay-2" data-reveal>
        <h3>We don&rsquo;t do generic marketing.</h3>
        <p>TMKE is built specifically for the property sector, combining industry understanding with a clear, structured approach to content.</p>
        <p>Everything is designed to be consistent, commercially focused, and easy to execute. No guesswork. Just marketing that reflects the standard of your business.</p>
      </aside>
    </div>
  </section>

  <!-- ============================== APPROACH — pinned cinematic stages -->
  <section id="for-agents" class="approach" data-stages="5">
    <div class="approach-pin">
      <div class="approach-frame">
        <div class="approach-stage is-active" data-stage="0">
          <div class="approach-intro">
            <div class="chapter chapter--center">Chapter 04 &mdash; Approach</div>
            <h2 class="approach-title">
              Built for Agents Who Want <em>More</em> Than Just Property Posts.
            </h2>
            <div class="approach-scroll-hint">
              <span class="approach-scroll-hint-line"></span>
              Keep scrolling
            </div>
          </div>
        </div>

        <div class="approach-stage" data-stage="1">
          <div class="approach-card-stack approach-card-stack--hero">
            <div class="approach-visual approach-visual--hero">
              <div class="approach-visual-img" style="background-image:url('/assets/bag.jpg')"></div>
            </div>
            <div class="approach-hero-text">
              <h3 class="approach-h">Templates that mean <em>business.</em></h3>
              <p class="approach-p">Ready-made social media assets designed specifically for the property sector. Professional, polished, and built to reflect the standard of your agency &mdash; not just fill a feed.</p>
              <div class="approach-step">01 / 04</div>
            </div>
          </div>
        </div>

        <div class="approach-stage" data-stage="2">
          <div class="approach-card-stack approach-card-stack--hero">
            <div class="approach-visual approach-visual--hero">
              <div class="approach-visual-img" style="background-image:url('/assets/rush.jpg')"></div>
            </div>
            <div class="approach-hero-text">
              <h3 class="approach-h">Made for <em>agents</em>, not anyone.</h3>
              <p class="approach-p">TMKE works exclusively in the property sector. That means we understand the market, the audience, and what actually resonates &mdash; no generalist guesswork, no learning curve at your expense.</p>
              <div class="approach-step">02 / 04</div>
            </div>
          </div>
        </div>

        <div class="approach-stage" data-stage="3">
          <div class="approach-card-stack approach-card-stack--hero">
            <div class="approach-visual approach-visual--hero">
              <div class="approach-visual-img" style="background-image:url('/assets/outside.jpg')"></div>
            </div>
            <div class="approach-hero-text">
              <h3 class="approach-h">Intentional <em>by design.</em></h3>
              <p class="approach-p">Every piece of content has a reason to exist. Strategy-led and structured from the start, so your social media works as a system rather than a series of disconnected posts.</p>
              <div class="approach-step">03 / 04</div>
            </div>
          </div>
        </div>

        <div class="approach-stage" data-stage="4">
          <div class="approach-card-stack approach-card-stack--hero">
            <div class="approach-visual approach-visual--hero">
              <div class="approach-visual-img" style="background-image:url('/assets/lay%20down.jpg')"></div>
            </div>
            <div class="approach-hero-text">
              <h3 class="approach-h">Done with you. Or <em>done for you.</em></h3>
              <p class="approach-p">Whether you want ready-made assets from The Edit or a fully managed service through Social Media Management, there's a level of support that fits where your business is right now.</p>
              <div class="approach-step">04 / 04</div>
            </div>
          </div>
        </div>

        <div class="approach-rail" aria-hidden="true">
          <span class="approach-rail-track"></span>
          <span class="approach-rail-fill" id="approach-rail-fill"></span>
          <span class="approach-rail-dots">
            <span class="approach-rail-dot" data-stage="0"></span>
            <span class="approach-rail-dot" data-stage="1"></span>
            <span class="approach-rail-dot" data-stage="2"></span>
            <span class="approach-rail-dot" data-stage="3"></span>
            <span class="approach-rail-dot" data-stage="4"></span>
          </span>
        </div>

        <div class="approach-grain" aria-hidden="true"></div>
      </div>
    </div>
  </section>

  <!-- ============================== THE EDIT FEATURE -->
  <section id="edit" class="feature feature--clean" data-reveal-root>
    <div class="feature-text wrap">
      <div class="chapter">Chapter 05 &mdash; The Edit</div>
      <h2 class="feature-title" id="edit-typewriter" aria-label="The Edit">
        <span class="feature-eyebrow">The</span>
        <span class="typewriter-text"></span><span class="typewriter-cursor" aria-hidden="true"></span>
      </h2>
      <div class="feature-lead">Ready-made social media assets, built for estate agents.</div>
      <p class="feature-copy">
        The Edit is a curated shop of social media templates designed specifically for the property sector. Each asset is on-brand, easy to customise, and built around content that actually works. Pick what you need, make it yours, and post with confidence.
      </p>
    </div>

    <div class="edit-marquee-wrap wrap" data-reveal>
      <div class="edit-marquee" aria-label="Template showcase">
        <div class="edit-marquee-track">
          <figure class="edit-marquee-item"><img src="/assets/asset%201.png" alt="" loading="lazy" /><figcaption>01 &middot; Carousel</figcaption></figure>
          <figure class="edit-marquee-item"><img src="/assets/asset%202.png" alt="" loading="lazy" /><figcaption>02 &middot; Static</figcaption></figure>
          <figure class="edit-marquee-item"><img src="/assets/asset%203.png" alt="" loading="lazy" /><figcaption>03 &middot; Reel</figcaption></figure>
          <figure class="edit-marquee-item"><img src="/assets/asset%201.png" alt="" loading="lazy" /><figcaption>04 &middot; Carousel</figcaption></figure>
          <figure class="edit-marquee-item"><img src="/assets/asset%202.png" alt="" loading="lazy" /><figcaption>05 &middot; Static</figcaption></figure>
          <figure class="edit-marquee-item"><img src="/assets/asset%203.png" alt="" loading="lazy" /><figcaption>06 &middot; Reel</figcaption></figure>
          <figure class="edit-marquee-item" aria-hidden="true"><img src="/assets/asset%201.png" alt="" loading="lazy" /><figcaption>01 &middot; Carousel</figcaption></figure>
          <figure class="edit-marquee-item" aria-hidden="true"><img src="/assets/asset%202.png" alt="" loading="lazy" /><figcaption>02 &middot; Static</figcaption></figure>
          <figure class="edit-marquee-item" aria-hidden="true"><img src="/assets/asset%203.png" alt="" loading="lazy" /><figcaption>03 &middot; Reel</figcaption></figure>
          <figure class="edit-marquee-item" aria-hidden="true"><img src="/assets/asset%201.png" alt="" loading="lazy" /><figcaption>04 &middot; Carousel</figcaption></figure>
          <figure class="edit-marquee-item" aria-hidden="true"><img src="/assets/asset%202.png" alt="" loading="lazy" /><figcaption>05 &middot; Static</figcaption></figure>
          <figure class="edit-marquee-item" aria-hidden="true"><img src="/assets/asset%203.png" alt="" loading="lazy" /><figcaption>06 &middot; Reel</figcaption></figure>
        </div>
        <div class="edit-marquee-fade edit-marquee-fade--left" aria-hidden="true"></div>
        <div class="edit-marquee-fade edit-marquee-fade--right" aria-hidden="true"></div>
      </div>
      <div class="edit-showcase-meta">
        <a class="edit-cta" href="/edit">
          <span class="edit-cta-mark" aria-hidden="true"></span>
          <span class="edit-cta-label">Browse the Edit</span>
          <span class="edit-cta-arrow" aria-hidden="true">&rarr;</span>
        </a>
        <div class="edit-showcase-meta-info">
          <span class="edit-showcase-count">37 templates</span>
          <span class="edit-showcase-dot"></span>
          <span>Updated monthly</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================== QUOTE / FOUNDER NOTE -->
  <section class="quote wrap">
    <div class="chapter reveal" data-reveal>Chapter 06 &mdash; Founder Note</div>
    <div class="quote-mark">&ldquo;</div>
    <div class="quote-grid">
      <blockquote class="quote-text split" data-reveal>
        <span class="split-line"><span>We work with agencies who know their</span></span>
        <span class="split-line"><span>marketing matters, they just don&rsquo;t have</span></span>
        <span class="split-line"><span>the time or headspace to do it properly.</span></span>
        <span class="split-line"><span>If you care about how your brand shows</span></span>
        <span class="split-line"><span>up but don&rsquo;t want to manage it day to day &mdash;</span></span>
        <span class="split-line"><span><em>this is where we step in.</em></span></span>
      </blockquote>
      <aside class="quote-side reveal reveal-delay-2" data-reveal>
        <figure class="quote-photo">
          <div class="quote-photo-frame">
            <img src="/assets/sitting%20chair.jpg" alt="" loading="lazy" />
          </div>
          <figcaption class="quote-photo-caption">
            <span class="quote-photo-line"></span>
            <span>The Studio &middot; London</span>
          </figcaption>
        </figure>

        <div class="quote-side-block">
          <div class="eyebrow" style="margin-bottom:14px;">Founder Note</div>
          <p class="quote-side-note">
            TMKE started inside a property business &mdash; so we already know the rhythm of valuations, instructions, viewings, and the social posts that get left until Friday. We built the agency we wished existed.
          </p>
          <div class="quote-attribution">Danni Law &mdash; Founder</div>
        </div>
      </aside>
    </div>
  </section>

  <!-- ============================== SMM SECTION -->
  <section id="smm" class="wrap smm">
    <div class="chapter reveal" data-reveal>Chapter 07 &mdash; Social Media</div>
    <div class="smm-grid">
      <div class="smm-imgwrap" data-reveal>
        <!-- Swapped from an Unsplash hotlink to a local PNG so the page
             doesn't depend on a third-party request to render the SMM
             section above the fold. -->
        <img src="/assets/social-media.png" alt="Social media management" loading="lazy" decoding="async" />
        <div class="smm-tag">Done-for-you</div>
      </div>
      <div class="reveal reveal-delay-2" data-reveal>
        <h3 class="serif smm-heading">A fully managed service for agencies ready to hand it over.</h3>
        <p class="smm-copy">We plan, create, and deliver consistent, on-brand content that reflects your business and supports long-term growth &mdash; without adding to your workload.</p>
        <p class="smm-copy smm-copy--last">One point of contact. One calendar. One brand that finally looks like the service you deliver.</p>
        <a href="/contact" class="btn btn--solid">Get Started <span class="btn-arrow">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- Five & Live now lives exclusively in the floating Free Assets tab on the left edge. -->

  <!-- ============================== NEWS / SUBSCRIBE -->
  <section id="news" class="news" data-reveal-root>
    <div class="news-bg" style="background-image:url('https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=2400&q=80')"></div>
    <div class="news-content">
      <div class="chapter chapter--light">Chapter 09 &mdash; News</div>
      <div class="news-eyebrow">TMKE</div>
      <div class="news-title">News</div>
      <p class="news-lead">For the days you know you should post, but don&rsquo;t know what.</p>
      <p class="news-copy">Get clear, structured marketing insights for estate agents, straight to your inbox every month.</p>
      <form class="news-form" id="news-form">
        <input type="email" placeholder="your@email.com" required />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- Floating lead-capture tab. Hidden on the hero; fades in past it. -->
  <FreeAssets />
</BaseLayout>
