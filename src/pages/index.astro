    }

    /* Reduced motion: present the full framed photo + labels, no scrub. */
  </style>

  <!-- Static hero — keep only the nav treatment: the bar stays transparent +
       light-on-image while the hero image covers the top of the viewport. -->
  <script>
    (function () {
      const hero = document.querySelector(".hero-static");
      const nav = document.getElementById("nav");
      if (!hero || !nav) return;
      const pb = document.querySelector(".page-body");
      const update = () => {
        // nav stays light while the hero is still showing above the page body
        const overHero = pb ? pb.getBoundingClientRect().top > 80 : hero.getBoundingClientRect().bottom > 80;
        nav.classList.toggle("nav--over-hero", overHero);
        nav.classList.toggle("nav--on-image", overHero);
      };
      update();
      if (window.__lenis && typeof window.__lenis.on === "function") {
        window.__lenis.on("scroll", update);
      } else {
        window.addEventListener("scroll", update, { passive: true });
      }
      window.addEventListener("resize", update, { passive: true });

      // When the hero video finishes, nudge the next section so it peeks up into
      // the bottom of the viewport (mild rounded top edge) — a quiet hint to move
      // on. They can then scroll/pull it up and it snaps into place as normal.
      const heroVid = hero.querySelector(".hero-static-img");
      if (heroVid) {
        let peeked = false;
        const peek = () => {
          if (peeked) return;
          peeked = true;
          if (window.scrollY > 80) return;            // already scrolled away
          const y = 52;
          if (window.__lenis && typeof window.__lenis.scrollTo === "function") {
            window.__lenis.scrollTo(y, { duration: 1.1 });
          } else {
            window.scrollTo({ top: y, behavior: "smooth" });
          }
        };
        heroVid.addEventListener("ended", peek);
      }
    })();
  </script>

  <!-- Trigger the hero intro animation on load (deferred a frame so the
       viewport-based split transforms are measured correctly). Reduced-motion
       users skip the animation (the CSS media query shows the final state). -->
  <script>
