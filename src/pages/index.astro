---
import BaseLayout from "../layouts/BaseLayout.astro";

// Chapter 05 — The Edit gallery. Template mockup images from Cloudflare assets.
// The centre cell (index 2 → top row, middle column) is the "The Edit" brand cell.
// 14 slots total; one becomes the brand cell (spliced at index 2), one becomes
// the CTA cell (replaces "Tip Tuesday"), leaving 13 visible template images.
const T = (n) => `https://assets.tmke.co.uk/TMKE%20Home%20Page/Templates/${n}.png`;
const EDIT_IMGS = [T(1),T(2),T(3),T(4),T(5),T(6),T(7),T(8),T(9),T(10),T(11),T(12),T(13),T(13)];
const EDIT_NAMES = [
  "New to Market", "Book a Viewing", "Market Insights", "Market Insights", "Sold In",
  "Local Recommendation", "Open House", "Just Sold", "A Day In",
  "Local Favourite", "Market Insights", "Coming Soon", "Tip Tuesday", "Latest Listing",
];
const EDIT_FORMATS = ["STATIC"];
// Build the cell list and drop the brand cell into the centre of the top row.
const editCells = EDIT_IMGS.map((src, i) => ({
  src, name: EDIT_NAMES[i], fmt: EDIT_FORMATS[i % EDIT_FORMATS.length],
}));
editCells.splice(2, 0, { brand: true });
// Swap the "Tip Tuesday" tile (lower-right of the grid) for a call-to-action
// cell: an outlined box matching the brand cell, with a "View The Edit" link
// near the bottom that sends people through to The Edit.
const ctaIdx = editCells.findIndex((c) => c.name === "Tip Tuesday");
if (ctaIdx !== -1) editCells[ctaIdx] = { cta: true };
---

<BaseLayout
  title="TMKE — The Marketing Experts"
  description="A specialist social media and marketing agency for the UK property sector. Premium templates, fully managed channels, structured content."
>
  <!-- ============================== HERO — "TMKE Agency" split reveal
       On load the wordmark floats into the centre, eases back, then "TMKE"
       slides left / "Agency" slides right, splitting the screen down a centre
       divider to reveal two images. The four agency sections sit in the centre
       (replacing the old services grid below). Inspired by Particolare Studio. -->
  <section id="top" class="hero-static hero-intro" aria-label="TMKE Agency">
    <!-- Two images behind, split L/R, revealed once the words part. -->
    <div class="hi-bg" aria-hidden="true">
      <span class="hi-img hi-img--l" style="background-image:url('https://assets.tmke.co.uk/Table%201.jpg')"></span>
      <span class="hi-img hi-img--r" style="background-image:url('https://assets.tmke.co.uk/TMKE%20Bag.jpg')"></span>
    </div>
    <span class="hi-divider" aria-hidden="true"></span>

    <p class="hi-tagline">We blend strategy, design and content to<br />help property brands show up better online.</p>

    <!-- The wordmark joins as one word "#TMKEAgency" in the centre; on the split
         the # drops and TMKE/Agency part to the edges. -->
    <span class="hi-word hi-word--l"><span class="hi-hash" aria-hidden="true">#</span>TMKE</span>
    <span class="hi-word hi-word--r">Agency</span>

    <!-- The four sections, centred on the wordmark, flanking the divider. -->
    <nav class="hi-center" aria-label="Sections">
      <span class="hi-pair hi-pair--l">
        <a href="/about">Studio</a>
        <a href="/edit">Templates</a>
      </span>
      <span class="hi-pair hi-pair--r">
        <a href="/services">Management</a>
        <a href="/contact">Discover</a>
      </span>
    </nav>

    <span class="hi-scroll">(Scroll)</span>
  </section>

  <!-- Everything below slides UP over the pinned hero (sticky reveal). -->
  <div class="page-body">

  <!-- (The "Chapter 02 — The Agency" services grid was removed — its four
       sections now live in the hero centre above.) -->

  <!-- ============================== EDITORIAL INTRO
       Chapter 03. Layout shifts to a two-row stack: the editorial lead
       fills the upper-left, then below it on the right sits the
       "We don't do generic marketing" block with its own heading. The
       bottom padding below buys breathing room before Chapter 04 pins. -->
  <section id="about" class="editorial wrap" data-reveal-root>
    <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 03 &mdash; Philosophy</div>
    <div class="editorial-grid editorial-grid--stack">
      <div class="editorial-lead-col">
        <p class="editorial-lead split" data-reveal data-reveal-dir="up">
          <span class="split-line"><span>We work with estate agents, lettings businesses, and property brands across the UK to <em>improve</em> how they show up online.</span></span>
        </p>
        <p class="editorial-lead-sub" data-reveal data-reveal-dir="up">Building a clear, consistent presence that reflects the quality of their service. Whatever their budget, whatever their starting point, there&rsquo;s a way in, and a way to grow.</p>
      </div>
      <aside class="editorial-side editorial-side--below" data-reveal data-reveal-dir="up">
        <h3 class="editorial-side-heading">We don&rsquo;t do generic marketing.</h3>
        <p>TMKE is built specifically for the property sector, combining industry understanding with a clear, structured approach to content.</p>
        <p>And because great marketing shouldn&rsquo;t only be available to agencies with big budgets, we&rsquo;ve built two ways to work with us, so every agent can access the same quality of thinking, at the level that works for them right now.</p>
      </aside>
    </div>
  </section>

  <!-- ============================== APPROACH — zoom-takeover (v3)
       Chapter 04, round-4 redesign. Inspired by the CUUB reference the
       user shared: a single hero photo starts as a contained panel
       beneath a title block, scrolls open to fill the viewport
       (sticky-takeover), then runs through four stages where the photo
       crossfades behind the same overlay layout, then finally zooms
       back out to a contained panel before handing off to Chapter 05.
       The controller in app.js drives one master --progress (0→1)
       across the whole section, and the CSS derives every animation
       from it via clip-path interpolation + targeted opacity stages.
       The .approach-stage/.approach-visual legacy CSS rules from the
       previous cinematic-stages design stay in the stylesheet but no
       longer match any markup. -->
  <!-- ============================== CHAPTER 04 — paired property scroller
       50/50 split: the left panel travels up while the right travels down,
       each pair two views of one property. A centre statement holds while a
       corner label fades in per stage. Driven by the controller near the foot
       of this file. -->
  <section id="for-agents" class="ch4" data-reveal-root>
    <div class="ch4-pin">
      <div class="ch4-panels">
        <div class="ch4-col ch4-col--left">
          <div class="ch4-strip" data-ch4="left">
            <div class="ch4-cell">
              <img src="https://assets.tmke.co.uk/TMKE%20Home%20Page/Slider%201.png" alt="" />
              <div class="ch4-label ch4-label--first">
                <span class="ch4-label-chapter">Chapter 04 &mdash; Approach</span>
                <span class="ch4-label-heading">More Than Just Property Posts</span>
                <span class="ch4-label-sub">Every piece of content has a reason to exist &mdash; strategy-led and structured from the start, so your social works as a system, not a series of disconnected posts.</span>
              </div>
            </div>
            <div class="ch4-cell">
              <img src="https://assets.tmke.co.uk/TMKE%20Home%20Page/Slider%205.png" alt="" />
              <div class="ch4-label">
                <span class="ch4-label-chapter">Chapter 04 &mdash; Approach</span>
                <span class="ch4-label-heading">Templates That Mean Business</span>
                <span class="ch4-label-sub">Ready-made templates, fully editable in our online editor. Professional, polished, and designed to reflect the standard of your agency, not just fill a feed.</span>
              </div>
            </div>
            <div class="ch4-cell">
              <img src="https://assets.tmke.co.uk/TMKE%20Home%20Page/Slider%203.png" alt="" />
              <div class="ch4-label">
                <span class="ch4-label-chapter">Chapter 04 &mdash; Approach</span>
                <span class="ch4-label-heading">Made For Agents, Not Anyone</span>
                <span class="ch4-label-sub">TMKE works exclusively in the property sector. We already understand the market, the audience, and what resonates, so you&rsquo;re never paying for generic content and someone else&rsquo;s learning curve.</span>
              </div>
            </div>
            <div class="ch4-cell">
              <img src="https://assets.tmke.co.uk/TMKE%20Home%20Page/Slider%207.png" alt="" />
              <div class="ch4-label">
                <span class="ch4-label-chapter">Chapter 04 &mdash; Approach</span>
                <span class="ch4-label-heading">Done With You, Or Done For You</span>
                <span class="ch4-label-sub">Whether you start with The Edit or go all-in with our fully managed social media services, there&rsquo;s a level of support designed to fit where your business is right now.</span>
              </div>
            </div>
          </div>
        </div>
        <div class="ch4-col ch4-col--right">
          <!-- reversed order so this column travels DOWN as the left goes up -->
          <div class="ch4-strip" data-ch4="right">
            <div class="ch4-cell"><img src="https://assets.tmke.co.uk/TMKE%20Home%20Page/Slider%208.png" alt="" /></div>
            <div class="ch4-cell"><img src="https://assets.tmke.co.uk/TMKE%20Home%20Page/Slider%204.png" alt="" /></div>
            <div class="ch4-cell"><img src="https://assets.tmke.co.uk/TMKE%20Home%20Page/Slider%206.png" alt="" /></div>
            <div class="ch4-cell"><img src="https://assets.tmke.co.uk/TMKE%20Home%20Page/Slider%202.png" alt="" /></div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================== CH 05 — THE EDIT (gallery)
       Full-width product-style gallery (House of Corto inspired). Edge tiles
       bleed off so ~4 read across; the centre top cell is the "The Edit" brand
       cell. Tiles zoom in together on enter; the grid fades out before Ch 06.
       Placeholder Unsplash interiors for now. -->
  <section id="edit" class="edit-gallery" data-reveal-root>
    <div class="edit-grid" id="edit-grid">
      {editCells.map((c) => (
        c.brand ? (
          <div class="edit-cell edit-cell--brand">
            <div class="edit-brand-box">
              <span class="edit-brand-title">The Edit</span>
              <span class="edit-brand-chapter">Chapter 05</span>
            </div>
          </div>
        ) : c.cta ? (
          <a class="edit-cell edit-cell--cta" href="/edit" aria-label="Shop The Edit">
            <div class="edit-cta-box">
              <span class="edit-cta-link">Shop The Edit <em class="edit-cta-arrow" aria-hidden="true">&rarr;</em></span>
            </div>
          </a>
        ) : (
          <a class="edit-cell" href="/edit" aria-label={`The Edit — ${c.name}`}>
            <div class="edit-cell-img" style={`background-image:url('${c.src}')`}></div>
            <div class="edit-cell-label"><span>{c.fmt}</span><span>{c.name}</span></div>
          </a>
        )
      ))}
    </div>
  </section>

  <style>
    .edit-gallery {
      position: relative;
      background: var(--paper);
      padding: 100px 0 100px;
      overflow: hidden;            /* clip the bleeding edge tiles */
    }
    .edit-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      /* loads of padding around small tiles, like the reference */
      gap: 150px 6vw;
      width: 110vw;
      margin-left: -5vw;
    }
    .edit-cell {
      display: block;
      text-decoration: none;
      /* scale + opacity are scrubbed by the controller from each tile's scroll
         position, so rows grow in as you scroll down and shrink back as you
         scroll up. */
      transform: translateY(100px) scale(0.16);
      opacity: 0;
      will-change: transform, opacity;
    }
    .edit-cell-img {
      width: 100%;
      aspect-ratio: 3 / 4;
      background-size: cover; background-position: center;
      background-color: #e9e4da;
      box-shadow: inset 0 0 0 1px rgba(28, 29, 34, 0.14);
    }
    .edit-cell-label {
      display: flex; justify-content: space-between; gap: 10px;
      margin-top: 12px;
      font-family: var(--sans);
      font-size: clamp(10px, 0.85vw, 13px);
      font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--english-violet);
    }
    /* Brand cell — a tile-sized box (same as the image tiles) with the chapter
       above "The Edit" and no image inside. */
    .edit-cell--brand { display: block; }
    .edit-brand-box {
      aspect-ratio: 3 / 4;            /* matches the image tiles */
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 4px;
      padding: 0 0 20px 20px;
      background: var(--paper);
      box-shadow: inset 0 0 0 1px rgba(28, 29, 34, 0.14);
    }
    .edit-brand-chapter {
      display: flex;
      align-items: center;
      gap: 16px;
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.36em;
      text-transform: uppercase;
      color: var(--english-violet);
    }
    .edit-brand-chapter::before {
      content: "";
      display: block;
      width: 48px;
      height: 1px;
      background: currentColor;
      opacity: 0.45;
      flex-shrink: 0;
    }
    .edit-brand-title {
      font-family: var(--serif);
      font-weight: 500;
      font-size: clamp(22px, 2.2vw, 40px);
      letter-spacing: 0.02em;
      color: var(--ink);
      line-height: 1;
    }
    /* CTA cell — same outlined box as the brand cell, with a link sitting
       towards the bottom that sends people through to The Edit. */
    .edit-cell--cta { display: block; }
    .edit-cta-box {
      aspect-ratio: 3 / 4;            /* matches the image + brand tiles */
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: flex-end;
      padding: 0 20px 20px 0;
      background: var(--paper);
      box-shadow: inset 0 0 0 1px rgba(28, 29, 34, 0.14);
      transition: box-shadow 0.3s, background 0.3s;
    }
    .edit-cta-eyebrow {
      font-family: var(--sans);
      font-size: clamp(10px, 0.85vw, 12px);
      font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase;
      color: var(--english-violet);
    }
    .edit-cta-link {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--sans);
      font-size: clamp(12px, 1vw, 15px);
      font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--ink);
      transition: color 0.3s;
    }
    .edit-cta-arrow { font-style: normal; transition: transform 0.3s cubic-bezier(.2,.7,.2,1); }
    .edit-cell--cta:hover .edit-cta-box {
      box-shadow: inset 0 0 0 1.5px var(--english-violet);
      background: rgba(var(--violet-rgb), 0.03);
    }
    .edit-cell--cta:hover .edit-cta-link { color: var(--english-violet); }
    .edit-cell--cta:hover .edit-cta-arrow { transform: translateX(5px); }
    @media (max-width: 860px) {
      .edit-grid { grid-template-columns: repeat(3, 1fr); width: 132vw; margin-left: -16vw; gap: 36px 4vw; }
      .edit-gallery { padding: 64px 0; }
    }
  </style>

  <!-- The Edit gallery fades out as it nears Chapter 06, revealing it. -->
  <script>
    (function () {
      const section = document.querySelector(".edit-gallery");
      if (!section) return;
      const grid = section.querySelector(".edit-grid");
      const cells = Array.prototype.slice.call(section.querySelectorAll(".edit-cell"));
      const clamp01 = (t) => Math.max(0, Math.min(1, t));
      const smooth = (t) => t * t * (3 - 2 * t);
      const lenis = window.__lenis;
      const update = () => {
        const vh = window.innerHeight;
        // Skip all the per-tile work unless the gallery is near the viewport —
        // keeps scrolling elsewhere on the page smooth.
        const sr = section.getBoundingClientRect();
        if (sr.bottom < -vh * 0.3 || sr.top > vh * 1.3) return;
        // Scroll-scrubbed reveal: each tile grows AND drifts up into place as
        // its row rises through the viewport, starting while still below the
        // fold. It LATCHES — once a tile is in, it stays in (no reverse on the
        // way back up). No fade-out; once they're there, they're there.
        const start = vh * 1.15;   // tile top here -> just beginning (below fold)
        const end = vh * 0.55;     // tile top here -> fully in place
        cells.forEach((c) => {
          const eNow = smooth(clamp01((start - c.getBoundingClientRect().top) / (start - end)));
          const e = Math.max(c.__editE || 0, eNow);   // latch: never decreases
          c.__editE = e;
          const lift = (1 - e) * 100;   // px: starts lower, flows up to its spot
          c.style.transform = "translateY(" + lift.toFixed(1) + "px) scale(" + (0.16 + 0.84 * e).toFixed(3) + ")";
          c.style.opacity = e.toFixed(3);
        });
      };
      update();
      if (lenis && typeof lenis.on === "function") lenis.on("scroll", update);
      else window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update, { passive: true });
    })();
  </script>


  <!-- ============================== CH 06 — SOCIAL MEDIA
       Mirrors the Ch 05 pattern: copy on the left, image on the right,
       and the SMM coda block sits below tucked under the image column so
       it reads as part of the same composition. -->
  <section id="social" class="quote quote--split" data-reveal-root>
    <div class="quote-split-grid">
      <div class="quote-left">
        <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 06 &mdash; Social Media Management</div>
        <div class="quote-mark" aria-hidden="true">&ldquo;</div>
        <blockquote class="quote-text split" data-reveal data-reveal-dir="up">
          <span class="split-line"><span>We work with agents who know their</span></span>
          <span class="split-line"><span>marketing matters, they just don&rsquo;t have</span></span>
          <span class="split-line"><span>the time or headspace to do it properly.</span></span>
        </blockquote>

        <!-- SMM coda — on the left, in line with the bleeding table photo. -->
        <div class="quote-coda">
          <p class="quote-coda-copy">If you care about how your brand shows up but don&rsquo;t want to manage it day to day, this is where we step in.</p>
          <p class="quote-coda-copy">TMKE plan, create and deliver consistent, on-brand content that reflects your business and supports long-term growth, without adding to your workload.</p>
          <p class="quote-coda-copy">One point of contact, one calendar, one brand that finally looks like the service you deliver.</p>
          <a href="/contact" class="btn btn--solid">Get Started <span class="btn-arrow">&rarr;</span></a>
        </div>
      </div>
    </div>

    <!-- Square table photo, held to the right edge and bleeding ~25% off it,
         in line with the Social Media Management piece. Static (no parallax). -->
    <figure class="quote-photo quote-photo--table">
      <div class="quote-photo-frame">
        <img src="https://assets.tmke.co.uk/TMKE%20Home%20Page/Home%20page%20section%206.jpg" alt="" loading="lazy" />
      </div>
    </figure>
  </section>

  <!-- Five & Live now lives exclusively in the floating Free Assets tab on the left edge. -->

  <!-- ============================== NEWS / SUBSCRIBE -->
  <section id="news" class="news" data-reveal-root>
    <div class="news-bg" style="background-image:url('https://assets.tmke.co.uk/TMKE%20Home%20Page/Homepage%20footer.png')"></div>
    <!-- Top-left: chapter line -->
    <div class="news-tl">
      <div class="chapter chapter--light news-chapter">Chapter 07 &mdash; News</div>
    </div>

    <!-- Bottom-right: line + subtext + newsletter form -->
    <div class="news-br">
      <p class="news-lead">For the days you know you should post but don&rsquo;t know what.</p>
      <p class="news-copy">Get clear, structured marketing insights for estate agents,<br />straight to your inbox every month.</p>
      <form class="news-form" id="news-form">
        <input type="email" placeholder="Email" required />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>
  </div><!-- /.page-body -->

  <!-- Five & Live floating tab removed for now (per design review). -->

  <!-- ===================== TMKE hero styles ===================== -->
  <style>
    /* Static hero — one fixed image at full width and its natural aspect ratio
       (not zoomed or cropped); the section is as tall as the image. */
    /* Full-screen hero — the video fills the whole section (cover). */
    /* Hero is PINNED (sticky); the page body slides up over the top of it. */
    .hero-static { position: sticky; top: 0; height: 100vh; overflow: hidden; background: var(--paper); z-index: 0; }
    .hero-static-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
    /* the rest of the page rides over the pinned hero, with a soft rounded top edge.
       display:flow-root contains descendant margins so its paper bg covers the
       full height (no gap near the footer where the pinned hero would bleed). */
    .page-body { position: relative; z-index: 1; background: var(--paper); border-radius: 5px 5px 0 0; display: flow-root; }
    /* Bottom labels overlaid on the video — light + shadowed so they stand out. */
    .hs-foot { position: absolute; left: 0; right: 0; bottom: 40px; z-index: 4; display: grid; grid-template-columns: 1fr auto 1fr; align-items: end; gap: 24px; padding: 0 48px; color: var(--paper); font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; text-shadow: 0 1px 14px rgba(0,0,0,0.5); pointer-events: none; }
    .hs-foot-l { justify-self: start; }
    .hs-foot-m { justify-self: center; letter-spacing: 0.14em; text-align: center; }
    .hs-foot-r { justify-self: end; text-align: right; }
    @media (max-width: 860px) { .hs-foot { font-size: 10px; padding: 0 22px; gap: 12px; bottom: 28px; } }

    /* ===================== HERO — "TMKE Agency" split reveal ===================== */
    .hero-intro {
      background: #141310; color: var(--paper);
      --hi-pad: clamp(24px, 4vw, 80px);
      --hi-gap: 0.07em;               /* a hair of space so the joined words sit
                                         adjacent (one word) without crossing */
      --hi-font: clamp(44px, 7vw, 116px);
    }
    /* Two images behind, split L/R. */
    .hi-bg { position: absolute; inset: 0; display: flex; z-index: 1; }
    .hi-img { flex: 1; background-size: cover; background-position: center; opacity: 0; }
    /* Subtle darken so the cream wordmark stays legible over the photos. */
    .hi-bg::after { content: ""; position: absolute; inset: 0; background: rgba(20,19,16,0.34); pointer-events: none; }
    .hi-divider {
      position: absolute; left: 50%; top: 0; bottom: 0; width: 1px; z-index: 2;
      background: rgba(242,239,233,0.32); transform: translateX(-0.5px) scaleY(0); transform-origin: center;
    }
    /* The splitting wordmark. Default = intro START (centred, large, hidden);
       JS adds .is-playing to animate to the final split; reduced-motion / no-JS
       jump straight to the final state. */
    .hi-word {
      position: absolute; top: 50%; z-index: 3;
      font-family: var(--sans), "Helvetica Neue", Arial, sans-serif; font-weight: 400;
      font-size: var(--hi-font); line-height: 1; letter-spacing: -0.01em; white-space: nowrap;
      color: var(--paper); text-shadow: 0 2px 34px rgba(0,0,0,0.38);
      opacity: 0; transform: translate(var(--join-big), -50%) scale(1.8); will-change: transform, opacity;
    }
    /* --join-big / --join-small place each word so the pair TOUCHES (one word) at
       scale 1.8 and at scale 1.0 — factor = (1 + scale)/2 tracks half the SCALED
       width. The word recedes big→small while staying joined, then slides to the
       edge. */
    .hi-word--l { left: var(--hi-pad);
      --join-big:   calc(50vw - var(--hi-gap) - var(--hi-pad) - 1.4 * 100%);
      --join-small: calc(50vw - var(--hi-gap) - var(--hi-pad) - 1.0 * 100%); }
    .hi-word--r { right: var(--hi-pad);
      --join-big:   calc(-50vw + var(--hi-gap) + var(--hi-pad) + 1.4 * 100%);
      --join-small: calc(-50vw + var(--hi-gap) + var(--hi-pad) + 1.0 * 100%); }
    /* Hashtag rides just left of "TMKE" (out of flow), then drops on the split. */
    .hi-hash { position: absolute; right: 100%; top: 0; }

    /* Centre sections — symmetric around the page centre (= centred on the
       wordmark), the two pairs flanking the divider. */
    .hi-center {
      position: absolute; left: 0; right: 0; top: 50%; transform: translateY(-50%); z-index: 3;
      display: grid; grid-template-columns: 1fr 1fr; align-items: center;
      opacity: 0; pointer-events: none;
    }
    .hi-pair { display: flex; gap: clamp(22px, 2.6vw, 52px); pointer-events: auto; }
    .hi-pair--l { justify-self: end; padding-right: clamp(40px, 7vw, 130px); }
    .hi-pair--r { justify-self: start; padding-left: clamp(40px, 7vw, 130px); }
    .hi-center a {
      font-family: var(--sans), "Helvetica Neue", Arial, sans-serif; font-size: clamp(15px, 1.2vw, 18px); font-weight: 500;
      letter-spacing: 0.04em; color: var(--paper); text-decoration: none; opacity: 0.8;
      transition: opacity 0.3s ease; white-space: nowrap;
    }
    .hi-center a:hover { opacity: 1; }

    .hi-tagline {
      position: absolute; top: clamp(26px, 6vh, 64px); left: 50%; transform: translateX(-50%); z-index: 3;
      margin: 0; text-align: center; color: var(--paper);
      font-family: var(--sans), "Helvetica Neue", Arial, sans-serif; font-size: 12px; font-weight: 600;
      letter-spacing: 0.08em; text-transform: uppercase; line-height: 1.55; opacity: 0;
    }
    .hi-scroll {
      position: absolute; bottom: clamp(24px, 5vh, 50px); left: 50%; transform: translateX(-50%); z-index: 3;
      color: var(--paper); font-family: var(--sans), "Helvetica Neue", Arial, sans-serif;
      font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; opacity: 0;
    }

    /* ---- Play (JS adds .is-playing) ---- */
    @keyframes hiWord {
      0%   { opacity: 0; transform: translate(var(--join-big), -50%) scale(1.8); }
      14%  { opacity: 1; }
      52%  { opacity: 1; transform: translate(var(--join-small), -50%) scale(1); }  /* receded — still one word */
      64%  { opacity: 1; transform: translate(var(--join-small), -50%) scale(1); }  /* hold (recede done) */
      100% { opacity: 1; transform: translate(0, -50%) scale(1); }                   /* split to the edges */
    }
    @keyframes hiHash {
      0%, 52% { opacity: 1; transform: translateY(0); }
      72%, 100% { opacity: 0; transform: translateY(0.24em); }
    }
    @keyframes hiFade { from { opacity: 0; } to { opacity: 1; } }
    @keyframes hiDivider { from { transform: translateX(-0.5px) scaleY(0); } to { transform: translateX(-0.5px) scaleY(1); } }
    /* Smooth ease-out so the recede isn't jerky. Recede + split first; the
       divider draws as the split begins; the IMAGES only reveal once the words
       have reached the edges (nothing "changes" until the transition is done). */
    .hero-intro.is-playing .hi-word { animation: hiWord 3.4s cubic-bezier(.22, 1, .36, 1) both; }
    .hero-intro.is-playing .hi-hash { animation: hiHash 3.4s cubic-bezier(.22, 1, .36, 1) both; }
    .hero-intro.is-playing .hi-divider { animation: hiDivider 1s cubic-bezier(.16, 1, .3, 1) 1.9s both; }
    .hero-intro.is-playing .hi-img { animation: hiFade 1.2s ease 3.4s both; }
    .hero-intro.is-playing .hi-tagline { animation: hiFade 0.9s ease 3.5s both; }
    .hero-intro.is-playing .hi-center { animation: hiFade 0.9s ease 3.65s both; }
    .hero-intro.is-playing .hi-scroll { animation: hiFade 0.9s ease 3.9s both; }

    /* ---- Final state for reduced-motion / no-JS (skip the animation) ---- */
    .hero-intro.is-final .hi-word { opacity: 1; transform: translate(0, -50%) scale(1); animation: none; }
    .hero-intro.is-final .hi-hash { opacity: 0; animation: none; }
    .hero-intro.is-final .hi-img,
    .hero-intro.is-final .hi-center,
    .hero-intro.is-final .hi-tagline,
    .hero-intro.is-final .hi-scroll { opacity: 1; animation: none; }
    .hero-intro.is-final .hi-divider { transform: translateX(-0.5px) scaleY(1); animation: none; }
    @media (prefers-reduced-motion: reduce) {
      .hero-intro .hi-word { opacity: 1; transform: translate(0, -50%) scale(1); animation: none; }
      .hero-intro .hi-hash { opacity: 0; animation: none; }
      .hero-intro .hi-img, .hero-intro .hi-center, .hero-intro .hi-tagline, .hero-intro .hi-scroll { opacity: 1; animation: none; }
      .hero-intro .hi-divider { transform: translateX(-0.5px) scaleY(1); animation: none; }
    }
    @media (max-width: 720px) {
      .hero-intro { --hi-font: clamp(30px, 9vw, 52px); }
      .hi-center { gap: clamp(40px, 12vw, 120px); }
      .hi-center a { font-size: 11px; }
      .hi-tagline { font-size: 10px; max-width: 80vw; }
    }

    .hero-zoom {
      position: relative;
      height: 260vh;            /* scroll length of the unfold */
      background: var(--paper);
    }
    .hero-zoom-pin {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    /* Layer A — the photo, revealed by a circle that irises out from the centre
       of the word to fill a 30px-framed full screen. */
    .hero-zoom-media {
      position: absolute;
      /* Image runs all the way to the top (under the nav); 30px frame on the
         other three sides. */
      inset: 0 30px 30px 30px;
      z-index: 2;
      overflow: hidden;
      clip-path: circle(0px at 50% 50%);  /* JS grows the radius */
      will-change: clip-path;
      transform: translateZ(0);           /* isolate the clip-path repaint */
    }
    .hero-zoom-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Layer B — TMKE, solid dark purple, dead centre; recolours to white as the
       photo irises out behind it (colour set by the controller). */
    .hero-zoom-word {
      display: none;
      position: absolute;
      left: 50%;
      top: 50%;
      /* Nudged down a few px so, once the photo opens, the wordmark rests on the
         shelf just beneath it. */
      transform: translate(-50%, calc(-50% + 5px));
      z-index: 3;
      margin: 0;
      /* Brand wordmark font — matches the top-left logo (Cormorant) */
      font-family: var(--serif);
      font-weight: 600;
      font-size: clamp(80px, 12vw, 190px);
      line-height: 1;
      letter-spacing: 0.04em;
      text-align: center;
      /* Resting state = debossed wordmark in secondary #eae5e1 (a shade darker
         than the paper) for carved depth; the controller lerps this to the
         secondary taupe #7e6765 and swaps the carve shadows for a drop shadow
         as the fold-out photo irises open. */
      color: rgba(255, 252, 248, 0.18);
      text-shadow:
        -1px -1px 1px rgba(255, 252, 245, 0.70),
        -2px -2px 5px rgba(255, 252, 245, 0.35),
        1px 1px 1px rgba(18, 12, 8, 0.28),
        2px 2px 6px rgba(18, 12, 8, 0.15);
      /* Drop shadow is applied by the controller — only once the photo is behind
         the letters (no shadow on the blank starter wall). */
      will-change: color, text-shadow;
    }
    /* Snakeskin resting surface — fills the hero behind the photo. Opacity is
       driven by the controller (full at rest, fades as the photo irises in).
       Only painted once the image loads (.has-snakeskin). */
    .hero-zoom-skin {
      position: absolute;
      inset: 0;
      z-index: 1;
      background-position: center;
      background-size: cover;
      opacity: 0;
      pointer-events: none;
    }
    .hero-zoom.has-snakeskin .hero-zoom-skin { background-image: var(--snakeskin); }
    /* TMKE embossed OUT of the leather: the letters are raised, so the fill
       is near-transparent warm so the texture shows through the faces.
       Light on the TOP edge, shadow on the BOTTOM edge. Toggled on (.is-skin)
       only at rest; removed as the fold-out begins. */
    .hero-zoom-word.is-skin {
      color: rgba(255, 252, 248, 0.06);
      -webkit-text-fill-color: rgba(255, 252, 248, 0.06);
    }

    /* Layer C — sofa cushions over the word (same iris clip, set by the
       controller). object-fit/position mirror the photo so they line up. */
    .hero-zoom-fg {
      position: absolute;
      inset: 0 30px 30px 30px;
      z-index: 4;
      overflow: hidden;
      clip-path: circle(0px at 50% 50%);
      pointer-events: none;
      will-change: clip-path;
    }
    .hero-zoom-fg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Keep the nav transparent while the hero fills the viewport so the photo
       bleeds up behind it (toggled by the controller). */
    :global(.nav.nav--over-hero) {
      background: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border-bottom: none !important;
      /* hold the base height so the scrolled-state padding never makes the bar
         grow / "drop down" over the hero */
      padding-top: 9px !important;
      padding-bottom: 9px !important;
    }
    /* Once the photo has risen behind the nav, flip the logo / links / login /
       burger to white so they stay legible over the image. */
    :global(.nav.nav--on-image) { color: #fff !important; }
    :global(.nav.nav--on-image .nav-burger span) { background: #fff !important; }

    /* Bottom labels — sit on top of everything; shift dark->light as the photo
       passes under them (colour set by the controller). */
    .hero-zoom-foot {
      position: absolute;
      left: 0; right: 0;
      bottom: 40px;
      z-index: 4;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
      gap: 24px;
      padding: 0 48px;
      color: var(--ink);
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }
    .hero-zoom-foot .hz-foot--l { justify-self: start; }
    .hero-zoom-foot .hz-foot--m { justify-self: center; letter-spacing: 0.14em; text-align: center; }
    .hero-zoom-foot .hz-foot--r { justify-self: end; text-align: right; }

    @media (max-width: 860px) {
      .hero-zoom { height: 200vh; }
      .hero-zoom-word { font-size: clamp(72px, 24vw, 168px); }
      .hero-zoom-foot { font-size: 10px; padding: 0 22px; gap: 12px; bottom: 28px; }
    }

    /* Reduced motion: present the full framed photo + labels, no scrub. */
  </style>

  <!-- Static hero — keep only the nav treatment: the bar stays transparent +
       light-on-image while the hero image covers the top of the viewport. -->
  <script>
    (function () {
      const hero = document.querySelector(".hero-static");
      const nav = document.getElementById("nav");
      if (!hero || !nav) return;
      const pb = document.querySelector(".page-body");
      const update = () => {
        // nav stays light while the hero is still showing above the page body
        const overHero = pb ? pb.getBoundingClientRect().top > 80 : hero.getBoundingClientRect().bottom > 80;
        nav.classList.toggle("nav--over-hero", overHero);
        nav.classList.toggle("nav--on-image", overHero);
      };
      update();
      if (window.__lenis && typeof window.__lenis.on === "function") {
        window.__lenis.on("scroll", update);
      } else {
        window.addEventListener("scroll", update, { passive: true });
      }
      window.addEventListener("resize", update, { passive: true });

      // When the hero video finishes, nudge the next section so it peeks up into
      // the bottom of the viewport (mild rounded top edge) — a quiet hint to move
      // on. They can then scroll/pull it up and it snaps into place as normal.
      const heroVid = hero.querySelector(".hero-static-img");
      if (heroVid) {
        let peeked = false;
        const peek = () => {
          if (peeked) return;
          peeked = true;
          if (window.scrollY > 80) return;            // already scrolled away
          const y = 52;
          if (window.__lenis && typeof window.__lenis.scrollTo === "function") {
            window.__lenis.scrollTo(y, { duration: 1.1 });
          } else {
            window.scrollTo({ top: y, behavior: "smooth" });
          }
        };
        heroVid.addEventListener("ended", peek);
      }
    })();
  </script>

  <!-- Trigger the hero intro animation on load (deferred a frame so the
       viewport-based split transforms are measured correctly). Reduced-motion
       users skip the animation (the CSS media query shows the final state). -->
  <script>
    (function () {
      var hero = document.querySelector(".hero-intro");
      if (!hero) return;
      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
      requestAnimationFrame(function () { requestAnimationFrame(function () { hero.classList.add("is-playing"); }); });
    })();
  </script>
  <noscript>
    <style>
      .hero-intro .hi-word { opacity: 1 !important; transform: translate(0, -50%) scale(1) !important; }
      .hero-intro .hi-hash { opacity: 0 !important; }
      .hero-intro .hi-img, .hero-intro .hi-center, .hero-intro .hi-tagline, .hero-intro .hi-scroll { opacity: 1 !important; }
      .hero-intro .hi-divider { transform: translateX(-0.5px) scaleY(1) !important; }
    </style>
  </noscript>

  <!-- ===================== Chapter 04 paired-scroller styles ===================== -->
  <style>
    .ch4 { position: relative; height: 580vh; background: var(--paper); }
    .ch4-pin { position: sticky; top: 0; height: 100vh; overflow: hidden; }
    .ch4-panels {
      position: absolute;
      inset: 30px;                       /* 30px frame, like the hero */
      display: grid;
      grid-template-columns: 1fr 1fr;    /* 50 / 50 */
      overflow: hidden;
    }
    .ch4-col { position: relative; overflow: hidden; height: 100%; }
    .ch4-strip {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 400%;                      /* four full-height cells */
      display: flex;
      flex-direction: column;
      will-change: transform;
    }
    .ch4-cell { position: relative; height: 25%; overflow: hidden; }
    .ch4-cell img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* Per-image label — a paper-coloured box in the bottom-left of each left
       cell, 30px in from the photo edges (matching the frame). It scrolls up
       with the panel, revealing the next one. */
    /* All label boxes are the same size (set by the fullest one — the chapter
       box), and the heading + subtext fit inside. */
    .ch4-label {
      position: absolute;
      left: 30px;
      bottom: 30px;
      width: min(480px, 46vw);
      box-sizing: border-box;
      border-radius: 8px;
      display: flex;
      flex-direction: column;
      background: var(--paper);
      box-shadow: inset 0 2px 8px rgba(28, 29, 34, 0.10), inset 0 1px 3px rgba(28, 29, 34, 0.06);
      color: var(--ink);
      padding: 20px 40px 30px 20px;
      font-family: var(--sans);
    }
    .ch4-label-chapter {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.36em;
      text-transform: uppercase;
      color: var(--english-violet);
      margin-bottom: 12px;
    }
    .ch4-label-chapter::before {
      content: "";
      display: block;
      width: 48px;
      height: 1px;
      background: currentColor;
      opacity: 0.45;
      flex-shrink: 0;
    }
    .ch4-label-heading {
      font-weight: 600;
      font-size: clamp(18px, 1.5vw, 24px);
      line-height: 1.14;
      letter-spacing: -0.01em;
    }
    .ch4-label-sub {
      margin-top: 12px;
      font-weight: 400;
      font-size: 16px;
      line-height: 1.4;
      color: rgba(28, 29, 34, 0.72);
    }

    @media (max-width: 860px) {
      .ch4 { height: 460vh; }
      .ch4-label {
        left: 22px; bottom: 22px; padding: 16px 18px;
        width: min(78vw, 360px); min-height: 0;
      }
      .ch4-label-heading { font-size: clamp(16px, 4.4vw, 22px); }
    }
  </style>

  <!-- Chapter 04 controller: left strip travels up, right strip travels down
       (reversed DOM order keeps the property pairs aligned). Corner labels fade
       in around their stage. Continuous/scroll-driven for now; snap-to-stage is
       a follow-up. -->
  <script>
    (function () {
      const ch4 = document.querySelector(".ch4");
      if (!ch4) return;
      const left = ch4.querySelector('[data-ch4="left"]');
      const right = ch4.querySelector('[data-ch4="right"]');
      const N = 4;
      // Stepped scroll: each stage gets a SHORT flat HOLD band (the image rests
      // briefly so it still "clicks" into place) then a LONGER TRANS band, so the
      // panels glide slowly and seamlessly between stages instead of stop-start.
      const HOLD = 0.7, TRANS = 1.25;
      const UNITS = N * HOLD + (N - 1) * TRANS;
      const clamp01 = (t) => Math.max(0, Math.min(1, t));
      const smooth = (t) => t * t * (3 - 2 * t);
      const lenis = window.__lenis;
      let snapping = false, snapTimer = 0;

      const prog = () => {
        const rect = ch4.getBoundingClientRect();
        const total = ch4.offsetHeight - window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top, 0), total);
        return { p: total > 0 ? scrolled / total : 0, rect, total };
      };

      // stepped position 0..N-1: flat during holds, eased during transitions
      const posFromP = (p) => {
        let u = p * UNITS, acc = 0;
        for (let i = 0; i < N; i++) {
          if (u <= acc + HOLD) return i;
          acc += HOLD;
          if (i < N - 1) {
            if (u <= acc + TRANS) return i + smooth((u - acc) / TRANS);
            acc += TRANS;
          }
        }
        return N - 1;
      };

      const update = () => {
        const { p, rect } = prog();
        // Only move the panels while the section is on screen.
        if (rect.bottom < 0 || rect.top > window.innerHeight) return;
        const pos = posFromP(p);
        left.style.transform = "translateY(" + (-pos * 25).toFixed(3) + "%)";
        right.style.transform = "translateY(" + (-(N - 1 - pos) * 25).toFixed(3) + "%)";
      };

      // scroll Y that lands on stage i's hold centre
      const stageY = (i) => {
        const total = ch4.offsetHeight - window.innerHeight;
        const top = ch4.getBoundingClientRect().top + window.scrollY;
        const u = i * (HOLD + TRANS) + HOLD / 2;
        return top + (u / UNITS) * total;
      };

      // when scrolling stops over the pinned section, snap to the nearest hold
      const scheduleSnap = () => {
        if (snapping) return;
        clearTimeout(snapTimer);
        snapTimer = setTimeout(() => {
          const { p, rect } = prog();
          if (rect.top > 0 || rect.bottom < window.innerHeight) return;  // free entry/exit
          const y = stageY(Math.round(posFromP(p)));
          snapping = true;
          const done = () => { snapping = false; };
          // easeOutCubic — travels decisively then settles, so the two panels
          // can be felt clicking into place together.
          if (lenis && typeof lenis.scrollTo === "function") lenis.scrollTo(y, { duration: 0.62, easing: (t) => 1 - Math.pow(1 - t, 3), onComplete: done });
          else { window.scrollTo({ top: y, behavior: "smooth" }); setTimeout(done, 500); }
          setTimeout(done, 1000);   // safety release
        }, 90);
      };

      const onScroll = () => { update(); scheduleSnap(); };
      update();
      if (lenis && typeof lenis.on === "function") lenis.on("scroll", onScroll);
      else window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", update, { passive: true });
    })();
  </script>

  <!-- ===================== Chapter 06 — Table photo ===================== -->
  <style>
    /* Ch06 holds the bleeding photo. Capped + centred on wide screens so the
       composition scales with the viewport up to 1800px, then sits centred
       (the photo bleeds off the capped section edge, not off into dead space). */
    #social.quote--split { position: relative; overflow: hidden; min-height: min(52vw, 936px); max-width: 1800px; margin-left: auto; margin-right: auto; }
    /* Square table photo, static, anchored to the right and ~25% off the section
       edge, vertically centred so it's in line with the SMM piece on the left.
       vw is capped (min/max) so it stops growing/bleeding once the section caps. */
    #social .quote-photo--table {
      position: absolute;
      /* Bottom-anchored so the image's bottom edge lines up with the Get
         Started button's bottom (button sits ~112px above the section base). */
      bottom: 112px;
      right: max(-207px, -11.5vw);    /* ~25% of the square sits off the edge */
      width: min(46vw, 828px);
      margin: 0;
      max-width: none;
      z-index: 1;
    }
    #social .quote-photo--table .quote-photo-frame {
      aspect-ratio: 1 / 1;            /* square */
      border-radius: 0;               /* no arch */
      box-shadow: none;
    }
    #social .quote-photo--table .quote-photo-frame::after { display: none; }
    #social .quote-photo--table .quote-photo-frame img {
      object-position: center;
      transform: none;
      animation: none;
    }
    #social .quote-photo--table .quote-photo-caption { justify-content: flex-start; }
    @media (max-width: 980px) {
      /* stack: photo full-width below the text, no bleed */
      #social.quote--split { min-height: 0; overflow: visible; }
      #social .quote-photo--table {
        position: static; transform: none; width: auto; right: auto;
        margin: 40px 22px 0;
      }
    }
  </style>
</BaseLayout>
