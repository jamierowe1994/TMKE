---
import BaseLayout from "../layouts/BaseLayout.astro";
import FreeAssets from "../components/FreeAssets.astro";
---

<BaseLayout
  title="TMKE — The Marketing Experts"
  description="A specialist social media and marketing agency for the UK property sector. Premium templates, fully managed channels, structured content."
>
  <!-- ============================== HERO -->
  <section id="top" class="hero" data-reveal-root>
    <video
      class="hero-video"
      src="/assets/Hero%20smaller.mp4"
      autoplay
      muted
      loop
      playsinline
      preload="auto"></video>
    <div class="hero-vignette"></div>
    <div class="hero-grain"></div>

    <div class="hero-bar hero-bar--top"></div>
    <div class="hero-bar hero-bar--bottom"></div>
    <div class="hero-bar hero-bar--left"></div>
    <div class="hero-bar hero-bar--right"></div>

    <div class="hero-content">
      <div class="hero-chapter">Chapter 01 &mdash; The Marketing Experts</div>
      <h1 class="hero-mark">TMKE</h1>
      <div class="hero-rule"></div>
      <p class="hero-sub">The future of property marketing.</p>
    </div>

    <div class="hero-foot">
      <div>
        Established<br />
        <small>2025</small>
      </div>
      <div class="hero-scroll-cue">
        <span class="hero-scroll-cue-line"></span>
        Scroll
      </div>
    </div>
  </section>

  <!-- ============================== SERVICES GRID
       Chapter 02. The four real cards line up with the page wrap; ghost
       cards on either side bleed off the viewport edges so the row reads
       as a continuous scroll-off rather than a contained set. -->
  <section class="services" data-reveal-root>
    <div class="wrap">
      <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 02 &mdash; The Studio</div>
      <div class="services-eyebrow reveal" data-reveal data-reveal-dir="up">
        <h2>
          <span class="services-eyebrow-line">A small studio with a sharp focus.</span>
          <em class="services-eyebrow-sub">Four ways in.</em>
        </h2>
      </div>
    </div>

    <!-- Bleed container — sits outside .wrap so the ghost cards can extend
         past both edges of the page. The inner grid still lines its real
         children up with .wrap's content rect via a calc-based gutter. -->
    <div class="services-bleed">
      <div class="services-grid" data-reveal>
        <!-- Ghost cards (left bleed) — outline only, no content. They imply
             a longer row scrolling in from off-screen. -->
        <span class="svc-card svc-card--ghost" aria-hidden="true"></span>
        <span class="svc-card svc-card--ghost svc-card--ghost-near" aria-hidden="true"></span>

        <a class="svc-card" href="/about">
          <div class="svc-hover-img" style="background-image:url('/assets/sunglasse.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">01</span>
          <div class="svc-num">01</div>
          <div class="svc-body">
            <h3 class="svc-title">TMKE<br /><span class="svc-title-amp">&amp;</span> The Studio</h3>
            <div class="svc-tag">For the story</div>
          </div>
          <div class="svc-action">About <span class="svc-arrow">&rarr;</span></div>
        </a>
        <a class="svc-card" href="/edit">
          <div class="svc-hover-img" style="background-image:url('/assets/dog.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">02</span>
          <div class="svc-num">02</div>
          <div class="svc-body">
            <h3 class="svc-title">The Edit<br /><span class="svc-title-amp">&amp;</span> Templates</h3>
            <div class="svc-tag">For the toolkit</div>
          </div>
          <div class="svc-action">Shop <span class="svc-arrow">&rarr;</span></div>
        </a>
        <a class="svc-card" href="/services">
          <div class="svc-hover-img" style="background-image:url('/assets/home%20window.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">03</span>
          <div class="svc-num">03</div>
          <div class="svc-body">
            <h3 class="svc-title">SMM<br /><span class="svc-title-amp">&amp;</span> Management</h3>
            <div class="svc-tag">For the handoff</div>
          </div>
          <div class="svc-action">Book <span class="svc-arrow">&rarr;</span></div>
        </a>
        <a class="svc-card" href="/contact">
          <div class="svc-hover-img" style="background-image:url('/assets/phone%20me.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">04</span>
          <div class="svc-num">04</div>
          <div class="svc-body">
            <h3 class="svc-title">Let&rsquo;s Chat<br /><span class="svc-title-amp">&amp;</span> Discover</h3>
            <div class="svc-tag">For the start</div>
          </div>
          <div class="svc-action">Talk <span class="svc-arrow">&rarr;</span></div>
        </a>

        <!-- Ghost cards (right bleed) -->
        <span class="svc-card svc-card--ghost svc-card--ghost-near" aria-hidden="true"></span>
        <span class="svc-card svc-card--ghost" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- ============================== EDITORIAL INTRO
       Chapter 03. Layout shifts to a two-row stack: the editorial lead
       fills the upper-left, then below it on the right sits the
       "We don't do generic marketing" block with its own heading. The
       bottom padding below buys breathing room before Chapter 04 pins. -->
  <section id="about" class="editorial wrap" data-reveal-root>
    <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 03 &mdash; On Marketing</div>
    <div class="editorial-grid editorial-grid--stack">
      <div class="editorial-lead-col">
        <p class="editorial-lead split" data-reveal data-reveal-dir="up">
          <span class="split-line"><span>We work with estate agents, lettings businesses,</span></span>
          <span class="split-line"><span>and property brands across the UK to <em>improve</em></span></span>
          <span class="split-line"><span>how they show up online. Building a clear,</span></span>
          <span class="split-line"><span>consistent presence that reflects the quality</span></span>
          <span class="split-line"><span>of their service. Whatever their budget,</span></span>
          <span class="split-line"><span>whatever their starting point.</span></span>
        </p>
      </div>
      <aside class="editorial-side editorial-side--below" data-reveal data-reveal-dir="right">
        <h3 class="editorial-side-heading">We don&rsquo;t do generic marketing.</h3>
        <p>TMKE is built specifically for the property sector, combining industry understanding with a clear, structured approach to content.</p>
        <p>And because great marketing shouldn&rsquo;t only be available to agencies with big budgets, we&rsquo;ve built two ways to work with us, so every agent can access the same quality of thinking, at the level that works for them right now.</p>
      </aside>
    </div>
  </section>

  <!-- ============================== APPROACH — zoom-takeover (v3)
       Chapter 04, round-4 redesign. Inspired by the CUUB reference the
       user shared: a single hero photo starts as a contained panel
       beneath a title block, scrolls open to fill the viewport
       (sticky-takeover), then runs through four stages where the photo
       crossfades behind the same overlay layout, then finally zooms
       back out to a contained panel before handing off to Chapter 05.
       The controller in app.js drives one master --progress (0→1)
       across the whole section, and the CSS derives every animation
       from it via clip-path interpolation + targeted opacity stages.
       The .approach-stage/.approach-visual legacy CSS rules from the
       previous cinematic-stages design stay in the stylesheet but no
       longer match any markup. -->
  <section id="for-agents" class="approach approach--takeover" data-reveal-root>
    <div class="approach-pin">
      <div class="approach-frame">

        <!-- Photo layer — full-viewport stack of crossfading photos,
             masked by clip-path so it reads as a contained panel at
             the top and tail of the section and a fullscreen takeover
             in the middle. Photo 0 is the *intro hero* (the original
             Chapter-04 image that used to sit behind the title); it
             holds through the contained state + zoom-in, then crossfades
             to photo 1 as stage 1 takes over. Photos 1-4 then pair with
             overlays 1-4. -->
        <div class="approach-photo-layer" aria-hidden="true">
          <div class="approach-photo approach-photo--intro" data-photo="0" style="background-image:url('/assets/chapter%204.png')"></div>
          <div class="approach-photo" data-photo="1" style="background-image:url('/assets/bag.jpg')"></div>
          <div class="approach-photo" data-photo="2" style="background-image:url('/assets/rush.jpg')"></div>
          <div class="approach-photo" data-photo="3" style="background-image:url('/assets/outside.jpg')"></div>
          <div class="approach-photo" data-photo="4" style="background-image:url('/assets/lay%20down.jpg')"></div>
          <!-- Soft scrim over the photos so the white overlay text stays
               legible even on bright frames. -->
          <div class="approach-photo-scrim"></div>
        </div>

        <!-- Dark-bottom scrim with backdrop-blur — sits above the photo
             layer (so it isn't clipped by the photo's clip-path) and
             below the overlay text. Heaviest at the bottom-left where
             the overlay copy lives, fading to clear as it travels up
             the viewport. Its opacity scales with --takeover so it only
             appears once the photo has gone fullscreen. -->
        <div class="approach-bottom-scrim" aria-hidden="true"></div>

        <!-- Intro overlay — sits above the contained photo at the
             start, fades out as the photo expands to fullscreen. -->
        <div class="approach-overlay approach-overlay--intro" data-overlay="intro">
          <div class="chapter chapter--center">Chapter 04 &mdash; Approach</div>
          <h2 class="approach-takeover-title">
            Built for Agents Who Want <em>More</em> Than Just Property Posts.
          </h2>
          <div class="approach-scroll-hint">
            <span class="approach-scroll-hint-line"></span>
            Keep scrolling
          </div>
        </div>

        <!-- Stage overlays — same layout, crossfading content. Each is
             visible during its own slot of the master progress. The
             overlay column sits bottom-left so it sells the sticky-
             takeover feeling: photo behind, text always in the same
             place. -->
        <div class="approach-overlay approach-overlay--stage" data-overlay="1">
          <div class="approach-overlay-inner">
            <h3 class="approach-overlay-h">Templates that mean <em>business.</em></h3>
            <p class="approach-overlay-p">Ready-made social media assets designed specifically for the property sector. Professional, polished, and built to reflect the standard of your agency &mdash; not just fill a feed.</p>
          </div>
        </div>

        <div class="approach-overlay approach-overlay--stage" data-overlay="2">
          <div class="approach-overlay-inner">
            <h3 class="approach-overlay-h">Made for <em>agents</em>, not anyone.</h3>
            <p class="approach-overlay-p">TMKE works exclusively in the property sector. That means we understand the market, the audience, and what actually resonates &mdash; no generalist guesswork, no learning curve at your expense.</p>
          </div>
        </div>

        <div class="approach-overlay approach-overlay--stage" data-overlay="3">
          <div class="approach-overlay-inner">
            <h3 class="approach-overlay-h">Intentional <em>by design.</em></h3>
            <p class="approach-overlay-p">Every piece of content has a reason to exist. Strategy-led and structured from the start, so your social media works as a system rather than a series of disconnected posts.</p>
          </div>
        </div>

        <div class="approach-overlay approach-overlay--stage" data-overlay="4">
          <div class="approach-overlay-inner">
            <h3 class="approach-overlay-h">Done with you. Or <em>done for you.</em></h3>
            <p class="approach-overlay-p">Whether you want ready-made assets from The Edit or a fully managed service through Social Media Management, there&rsquo;s a level of support that fits where your business is right now.</p>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ============================== CH 05 — THE EDIT (pinned scene)
       Full-screen, scroll-snapping "device" scene inspired by the Luffu
       reference. A hand holds a phone (green-screen asset; the screen
       content is layered exactly over the chroma area). The phone screen
       and the headline crossfade across three snap stages while a soft
       gradient drifts behind. Snapping is handled in JS via Lenis (the
       site's smooth-scroll engine), scoped to this section only, so the
       rest of the page still scrolls freely. -->
  <section id="edit" class="edit-scene" data-stage="0">
    <div class="edit-pin">
      <div class="edit-bg" aria-hidden="true">
        <span class="edit-blob edit-blob--a"></span>
        <span class="edit-blob edit-blob--b"></span>
      </div>

      <div class="edit-head">
        <div class="chapter chapter--center edit-head-chapter">Chapter 05 &mdash; The Edit</div>
        <div class="edit-head-stages">
          <div class="edit-head-stage" data-stage="0">
            <h2 class="edit-head-title">The Edit</h2>
            <p class="edit-head-copy">Ready-made social media assets, built for estate agents &mdash; professional, polished, and ready to make yours.</p>
          </div>
          <div class="edit-head-stage" data-stage="1">
            <h2 class="edit-head-title">Designed for property. <em>Made yours.</em></h2>
            <p class="edit-head-copy">Every asset is built around the content pillars that actually work for the sector. Pick a template, drop in your brand, and it&rsquo;s ready to post.</p>
          </div>
          <div class="edit-head-stage" data-stage="2">
            <h2 class="edit-head-title">Templates. <em>Updated monthly.</em></h2>
            <p class="edit-head-copy">A curated shop that keeps growing. Pick what you need and post with confidence.</p>
            <a class="edit-cta edit-head-cta" href="/edit">
              <span class="edit-cta-label">Browse the Edit</span>
              <span class="edit-cta-arrow" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>
      </div>

      <div class="edit-stage-wrap">
        <div class="edit-hand">
          <img class="edit-hand-img" src="/assets/hand.png" alt="A hand holding a phone showing the TMKE Edit" />
          <div class="edit-phone">
            <!-- Horizontal strip of screens; translated by --screen-pos so
                 the phone reads as scrolling sideways between stages. -->
            <div class="edit-track">
              <!-- Screen 0 — the editor: an "active" template with a live
                   flowing colour and a scrolling brand-palette strip. -->
              <div class="edit-screen edit-screen--editor">
                <div class="ph-status"><span>9:41</span><span class="ph-status-ic" aria-hidden="true"></span></div>
                <div class="ph-body">
                  <div class="ph-head">
                    <span class="ph-eyebrow">The Edit</span>
                    <span class="ph-chip">Live</span>
                  </div>
                  <div class="ph-feature">
                    <span class="ph-feature-tag">Just Listed</span>
                    <span class="ph-feature-title">Set the tone</span>
                  </div>
                  <div class="ph-thumbs">
                    <span class="ph-thumb"></span>
                    <span class="ph-thumb"></span>
                    <span class="ph-thumb"></span>
                  </div>
                  <div class="ph-palette">
                    <span class="ph-palette-label">Brand colour</span>
                    <div class="ph-palette-strip" aria-hidden="true">
                      <div class="ph-palette-track">
                        <i style="background:#5b4b7a"></i><i style="background:#7a4933"></i><i style="background:#1c1d22"></i><i style="background:#c9b79c"></i><i style="background:#8a6f4e"></i><i style="background:#473f54"></i>
                        <i style="background:#5b4b7a"></i><i style="background:#7a4933"></i><i style="background:#1c1d22"></i><i style="background:#c9b79c"></i><i style="background:#8a6f4e"></i><i style="background:#473f54"></i>
                      </div>
                    </div>
                  </div>
                  <div class="ph-btn">Make it yours <span aria-hidden="true">&rarr;</span></div>
                </div>
              </div>

              <!-- Screen 1 — the catalogue: pick a pack, browse the assets
                   (the filmstrip scrolls to suggest a live, browsable shop). -->
              <div class="edit-screen edit-screen--catalog">
                <div class="ph-status"><span>9:41</span><span class="ph-status-ic" aria-hidden="true"></span></div>
                <div class="ph-body">
                  <div class="ph-head">
                    <span class="ph-eyebrow">Packs</span>
                    <span class="ph-chip">12</span>
                  </div>
                  <div class="ph-packs" aria-hidden="true">
                    <span class="ph-pack is-on">Just Listed</span><span class="ph-pack">Sold</span><span class="ph-pack">Open House</span><span class="ph-pack">Lettings</span><span class="ph-pack">Market Tips</span>
                  </div>
                  <div class="ph-film" aria-hidden="true">
                    <div class="ph-film-track">
                      <span class="ph-tile" style="--g:linear-gradient(135deg,#5b4b7a,#9a86b8)"><b>New to Market</b></span>
                      <span class="ph-tile" style="--g:linear-gradient(135deg,#7a4933,#c9a07a)"><b>Price Reduced</b></span>
                      <span class="ph-tile" style="--g:linear-gradient(135deg,#2f2b3a,#6a6080)"><b>Open House</b></span>
                      <span class="ph-tile" style="--g:linear-gradient(135deg,#9a86b8,#e7ddef)"><b>Just Sold</b></span>
                      <span class="ph-tile" style="--g:linear-gradient(135deg,#5b4b7a,#9a86b8)"><b>New to Market</b></span>
                      <span class="ph-tile" style="--g:linear-gradient(135deg,#7a4933,#c9a07a)"><b>Price Reduced</b></span>
                      <span class="ph-tile" style="--g:linear-gradient(135deg,#2f2b3a,#6a6080)"><b>Open House</b></span>
                      <span class="ph-tile" style="--g:linear-gradient(135deg,#9a86b8,#e7ddef)"><b>Just Sold</b></span>
                    </div>
                  </div>
                  <div class="ph-btn">Pick this pack <span aria-hidden="true">&rarr;</span></div>
                </div>
              </div>

              <!-- Screen 2 — the templates collage (the right-hand image). -->
              <div class="edit-screen edit-screen--collage">
                <img src="/assets/image.webp" alt="A selection of TMKE social media templates" loading="lazy" decoding="async" />
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Invisible scroll-snap anchors — each marks a rest point / stage. -->
    <div class="edit-snap" data-stage="0" aria-hidden="true"></div>
    <div class="edit-snap" data-stage="1" aria-hidden="true"></div>
    <div class="edit-snap" data-stage="2" aria-hidden="true"></div>
  </section>

  <!-- Ch 05 controller — drives the pinned Edit scene:
       1. IntersectionObserver flips data-stage on the section as each
          invisible anchor crosses the viewport centre (crossfades the
          headline + phone screen via CSS).
       2. A debounced Lenis scrollTo "pings" the page to the nearest stage
          once scrolling settles inside the pinned region — the snap feel
          from the reference, scoped so the rest of the page scrolls free. -->
  <script is:inline>
    (function () {
      const scene = document.getElementById('edit');
      if (!scene) return;
      const anchors = scene.querySelectorAll('.edit-snap');
      const STAGES = anchors.length - 1; // max stage index

      const io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) scene.setAttribute('data-stage', e.target.dataset.stage);
        });
      }, { rootMargin: '-50% 0px -50% 0px', threshold: 0 });
      anchors.forEach(function (a) { io.observe(a); });

      function sectionScroll() {
        return window.scrollY - (scene.getBoundingClientRect().top + window.scrollY);
      }
      // Continuous horizontal position of the phone strip (0..STAGES), tied
      // to scroll so the screen reads as sliding sideways between stages.
      function updatePos() {
        const vh = window.innerHeight;
        let pos = sectionScroll() / vh;
        pos = Math.max(0, Math.min(STAGES, pos));
        scene.style.setProperty('--screen-pos', pos.toFixed(4));
      }
      updatePos();
      window.addEventListener('resize', updatePos);

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const easeOutExpo = function (t) { return t === 1 ? 1 : 1 - Math.pow(2, -10 * t); };
      let timer = null, snapping = false;

      function nearestSnap() {
        const lenis = window.__lenis;
        if (!lenis || snapping) return;
        const vh = window.innerHeight;
        const s = sectionScroll();
        if (s < -0.5 * vh || s > (STAGES + 0.5) * vh) return; // only near the pin
        const docTop = scene.getBoundingClientRect().top + window.scrollY;
        const stage = Math.max(0, Math.min(STAGES, Math.round(s / vh)));
        const targetY = docTop + stage * vh;
        if (Math.abs(window.scrollY - targetY) < 6) return;
        snapping = true;
        lenis.scrollTo(targetY, { duration: 0.8, easing: easeOutExpo });
        setTimeout(function () { snapping = false; }, 880);
      }
      function onScroll() {
        updatePos();
        if (reduce || snapping) return;
        clearTimeout(timer);
        timer = setTimeout(nearestSnap, 150);
      }
      if (window.__lenis && typeof window.__lenis.on === 'function') {
        window.__lenis.on('scroll', onScroll);
      } else {
        window.addEventListener('scroll', onScroll, { passive: true });
      }
    })();
  </script>

  <!-- ============================== CH 06 — SOCIAL MEDIA
       Mirrors the Ch 05 pattern: copy on the left, image on the right,
       and the SMM coda block sits below tucked under the image column so
       it reads as part of the same composition. -->
  <section id="social" class="quote quote--split" data-reveal-root>
    <div class="quote-split-grid">
      <div class="quote-left">
        <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 06 &mdash; Social Media</div>
        <div class="quote-mark" aria-hidden="true">&ldquo;</div>
        <blockquote class="quote-text split" data-reveal data-reveal-dir="up">
          <span class="split-line"><span>We work with agencies who know their</span></span>
          <span class="split-line"><span>marketing matters, they just don&rsquo;t have</span></span>
          <span class="split-line"><span>the time or headspace to do it properly.</span></span>
          <span class="split-line"><span>If you care about how your brand shows</span></span>
          <span class="split-line"><span>up but don&rsquo;t want to manage it day to day &mdash;</span></span>
          <span class="split-line"><span><em>this is where we step in.</em></span></span>
        </blockquote>
      </div>

      <div class="quote-right">
        <figure class="quote-photo quote-photo--full" data-reveal data-reveal-dir="right">
          <div class="quote-photo-frame">
            <img src="/assets/sitting%20chair.jpg" alt="" loading="lazy" />
          </div>
          <figcaption class="quote-photo-caption">
            <span class="quote-photo-line"></span>
            <span>The Studio &middot; London</span>
          </figcaption>
        </figure>

        <!-- SMM coda — sits below the image, kept in line with the image
             column. Matches the layout in the client mockup where the
             "Social Media Management" block tucks underneath the photo. -->
        <div class="quote-coda" data-reveal data-reveal-dir="up">
          <h3 class="quote-coda-heading">Social Media Management.</h3>
          <p class="quote-coda-copy">We plan, create, and deliver consistent, on-brand content that reflects your business and supports long-term growth, without adding to your workload.</p>
          <p class="quote-coda-copy">One point of contact. One calendar. One brand that finally looks like the service you deliver.</p>
          <a href="/contact" class="btn btn--solid">Get Started <span class="btn-arrow">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- Five & Live now lives exclusively in the floating Free Assets tab on the left edge. -->

  <!-- ============================== NEWS / SUBSCRIBE -->
  <section id="news" class="news" data-reveal-root>
    <div class="news-bg" style="background-image:url('https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=2400&q=80')"></div>
    <div class="news-content">
      <div class="chapter chapter--light">Chapter 07 &mdash; News</div>
      <div class="news-eyebrow">TMKE</div>
      <div class="news-title">News</div>
      <p class="news-lead">For the days you know you should post, but don&rsquo;t know what.</p>
      <p class="news-copy">Get clear, structured marketing insights for estate agents, straight to your inbox every month.</p>
      <form class="news-form" id="news-form">
        <input type="email" placeholder="your@email.com" required />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- Floating lead-capture tab. Hidden on the hero; fades in past it. -->
  <FreeAssets />
</BaseLayout>
