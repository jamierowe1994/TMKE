---
import BaseLayout from "../layouts/BaseLayout.astro";

// Chapter 05 — The Edit gallery. Placeholder Unsplash interiors for now; the
// centre cell (index 2 → top row, middle column) is the "The Edit" brand cell.
const U = (id) => `https://images.unsplash.com/photo-${id}?auto=format&fit=crop&w=1100&q=80`;
const EDIT_IMG_IDS = [
  "1505691938895-1758d7feb511", "1493809842364-78817add7ffb",
  "1484154218962-a197022b5858", "1522708323590-d24dbb6b0267",
  "1556909114-f6e7ad7d3136",    "1513161455079-7dc1de15ef3e",
  "1567016432779-094069958ea5", "1524758631624-e2822e304c36",
  "1586023492125-27b2c045efd7", "1540574163026-643ea20ade25",
  "1538688525198-9b88f6f53126", "1503602642458-232111445657",
  "1616137466211-f939a420be84", "1567538096630-e0c55bd6374c",
];
const EDIT_NAMES = [
  "Just Listed", "Open House", "Sold", "Price Drop", "Coming Soon",
  "Testimonial", "Meet the Team", "Market Update", "New Instruction",
  "Viewing", "Offer Accepted", "Area Guide", "Tip Tuesday", "The Reveal",
];
const EDIT_FORMATS = ["POST", "REEL", "STORY", "CAROUSEL"];
// Build the cell list and drop the brand cell into the centre of the top row.
const editCells = EDIT_IMG_IDS.map((id, i) => ({
  src: U(id), name: EDIT_NAMES[i], fmt: EDIT_FORMATS[i % EDIT_FORMATS.length],
}));
editCells.splice(2, 0, { brand: true });
// Swap the "Tip Tuesday" tile (lower-right of the grid) for a call-to-action
// cell: an outlined box matching the brand cell, with a "View The Edit" link
// near the bottom that sends people through to The Edit.
const ctaIdx = editCells.findIndex((c) => c.name === "Tip Tuesday");
if (ctaIdx !== -1) editCells[ctaIdx] = { cta: true };
---

<BaseLayout
  title="TMKE — The Marketing Experts"
  description="A specialist social media and marketing agency for the UK property sector. Premium templates, fully managed channels, structured content."
>
  <!-- ============================== HERO (TMKE fold-out)
       Centre: "TMKE" with the image showing through the letterforms + a dark
       outline. As you scroll the full image unfolds from the centre of the word
       to fill the screen (30px cream frame). Three bottom labels sit on top and
       shift dark->light as the photo passes under them. -->
  <section id="top" class="hero-zoom" data-reveal-root>
    <div class="hero-zoom-pin">
      <!-- Snakeskin resting surface — the texture the home page opens on, behind
           the photo. The controller fades it out as the photo irises in, so the
           snakeskin is only there BEFORE the animation. Only shown once the image
           loads (.has-snakeskin), so nothing breaks if the asset is missing. -->
      <div class="hero-zoom-skin" aria-hidden="true"></div>
      <!-- Layer A — the photo that unfolds to full screen -->
      <div class="hero-zoom-media">
        <img class="hero-zoom-img" src="https://assets.tmke.co.uk/vibes.webp" alt="A TMKE interior" />
      </div>
      <!-- Layer B — TMKE wordmark (brand serif), dead centre -->
      <h1 class="hero-zoom-word" aria-label="TMKE">TMKE</h1>
      <!-- Layer C — sofa-cushion cut-out, ABOVE the word so the E tucks behind
           it; revealed by the same iris clip as the photo. -->
      <div class="hero-zoom-fg">
        <img class="hero-zoom-fg-img" src="https://assets.tmke.co.uk/sofa-invis.webp" alt="" />
      </div>
      <!-- Bottom labels: left / centre / right -->
      <div class="hero-zoom-foot">
        <span class="hz-foot hz-foot--l">Established in 2025</span>
        <span class="hz-foot hz-foot--m">Marketing that actually works</span>
        <span class="hz-foot hz-foot--r">Chapter One</span>
      </div>
    </div>
  </section>

  <!-- ============================== SERVICES GRID
       Chapter 02. The four real cards line up with the page wrap; ghost
       cards on either side bleed off the viewport edges so the row reads
       as a continuous scroll-off rather than a contained set. -->
  <section class="services" data-reveal-root>
    <div class="wrap">
      <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 02 &mdash; The Agency</div>
    </div>

    <!-- Bleed container — sits outside .wrap so the ghost cards can extend
         past both edges of the page. The inner grid still lines its real
         children up with .wrap's content rect via a calc-based gutter. -->
    <div class="services-bleed">
      <div class="services-grid">
        <!-- Ghost cards (left bleed) — outline only, no content. They imply
             a longer row scrolling in from off-screen. -->
        <span class="svc-card svc-card--ghost" aria-hidden="true"></span>
        <span class="svc-card svc-card--ghost svc-card--ghost-near" aria-hidden="true"></span>

        <a class="svc-card" href="/about">
          <div class="svc-hover-img" style="background-image:url('/assets/sunglasse.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">01</span>
          <div class="svc-num">01</div>
          <div class="svc-body">
            <h3 class="svc-title">TMKE<br /><span class="svc-title-amp">&amp;</span> The Studio</h3>
            <div class="svc-tag">For the story</div>
          </div>
          <div class="svc-action">About <span class="svc-arrow">&rarr;</span></div>
        </a>
        <a class="svc-card" href="/edit">
          <div class="svc-hover-img" style="background-image:url('/assets/dog.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">02</span>
          <div class="svc-num">02</div>
          <div class="svc-body">
            <h3 class="svc-title">The Edit<br /><span class="svc-title-amp">&amp;</span> Templates</h3>
            <div class="svc-tag">For the toolkit</div>
          </div>
          <div class="svc-action">Shop <span class="svc-arrow">&rarr;</span></div>
        </a>
        <a class="svc-card" href="/services">
          <div class="svc-hover-img" style="background-image:url('/assets/home%20window.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">03</span>
          <div class="svc-num">03</div>
          <div class="svc-body">
            <h3 class="svc-title">SMM<br /><span class="svc-title-amp">&amp;</span> Management</h3>
            <div class="svc-tag">For the handoff</div>
          </div>
          <div class="svc-action">Book <span class="svc-arrow">&rarr;</span></div>
        </a>
        <a class="svc-card" href="/contact">
          <div class="svc-hover-img" style="background-image:url('/assets/phone%20me.jpg')" aria-hidden="true"></div>
          <span class="svc-watermark" aria-hidden="true">04</span>
          <div class="svc-num">04</div>
          <div class="svc-body">
            <h3 class="svc-title">Let&rsquo;s Chat<br /><span class="svc-title-amp">&amp;</span> Discover</h3>
            <div class="svc-tag">For the start</div>
          </div>
          <div class="svc-action">Talk <span class="svc-arrow">&rarr;</span></div>
        </a>

        <!-- Ghost cards (right bleed) -->
        <span class="svc-card svc-card--ghost svc-card--ghost-near" aria-hidden="true"></span>
        <span class="svc-card svc-card--ghost" aria-hidden="true"></span>
      </div>
    </div>
  </section>

  <!-- ============================== EDITORIAL INTRO
       Chapter 03. Layout shifts to a two-row stack: the editorial lead
       fills the upper-left, then below it on the right sits the
       "We don't do generic marketing" block with its own heading. The
       bottom padding below buys breathing room before Chapter 04 pins. -->
  <section id="about" class="editorial wrap" data-reveal-root>
    <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 03 &mdash; Philosophy</div>
    <div class="editorial-grid editorial-grid--stack">
      <div class="editorial-lead-col">
        <p class="editorial-lead split" data-reveal data-reveal-dir="up">
          <span class="split-line"><span>We work with estate agents, lettings businesses, and property brands across the UK to <em>improve</em> how they show up online. Building a clear, consistent presence that reflects the quality of their service. Whatever their budget, whatever their starting point, there&rsquo;s a way in, and a way to grow.</span></span>
        </p>
      </div>
      <aside class="editorial-side editorial-side--below" data-reveal data-reveal-dir="up">
        <h3 class="editorial-side-heading">We don&rsquo;t do generic marketing.</h3>
        <p>TMKE is built specifically for the property sector, combining industry understanding with a clear, structured approach to content.</p>
        <p>And because great marketing shouldn&rsquo;t only be available to agencies with big budgets, we&rsquo;ve built two ways to work with us, so every agent can access the same quality of thinking, at the level that works for them right now.</p>
      </aside>
    </div>
  </section>

  <!-- ============================== APPROACH — zoom-takeover (v3)
       Chapter 04, round-4 redesign. Inspired by the CUUB reference the
       user shared: a single hero photo starts as a contained panel
       beneath a title block, scrolls open to fill the viewport
       (sticky-takeover), then runs through four stages where the photo
       crossfades behind the same overlay layout, then finally zooms
       back out to a contained panel before handing off to Chapter 05.
       The controller in app.js drives one master --progress (0→1)
       across the whole section, and the CSS derives every animation
       from it via clip-path interpolation + targeted opacity stages.
       The .approach-stage/.approach-visual legacy CSS rules from the
       previous cinematic-stages design stay in the stylesheet but no
       longer match any markup. -->
  <!-- ============================== CHAPTER 04 — paired property scroller
       50/50 split: the left panel travels up while the right travels down,
       each pair two views of one property. A centre statement holds while a
       corner label fades in per stage. Driven by the controller near the foot
       of this file. -->
  <section id="for-agents" class="ch4" data-reveal-root>
    <div class="ch4-pin">
      <div class="ch4-panels">
        <div class="ch4-col ch4-col--left">
          <div class="ch4-strip" data-ch4="left">
            <div class="ch4-cell">
              <img src="https://assets.tmke.co.uk/orange-1.webp" alt="" />
              <div class="ch4-label ch4-label--first">
                <span class="ch4-label-chapter">Chapter 04 &mdash; Approach</span>
                <span class="ch4-label-heading">Built for agents who want more than just property posts</span>
                <span class="ch4-label-sub">Every piece of content has a reason to exist &mdash; strategy-led and structured from the start, so your social works as a system, not a series of disconnected posts.</span>
              </div>
            </div>
            <div class="ch4-cell">
              <img src="https://assets.tmke.co.uk/white-1.webp" alt="" />
              <div class="ch4-label">
                <span class="ch4-label-chapter">Chapter 04 &mdash; Approach</span>
                <span class="ch4-label-heading">Templates that mean business</span>
                <span class="ch4-label-sub">Ready-made templates, fully editable in our online editor. Professional, polished, and designed to reflect the standard of your agency, not just fill a feed.</span>
              </div>
            </div>
            <div class="ch4-cell">
              <img src="https://assets.tmke.co.uk/kitchen-1.webp" alt="" />
              <div class="ch4-label">
                <span class="ch4-label-chapter">Chapter 04 &mdash; Approach</span>
                <span class="ch4-label-heading">Made for agents, not anyone</span>
                <span class="ch4-label-sub">TMKE works exclusively in property, so we understand the market, the audience, and what actually resonates &mdash; no generalist guesswork.</span>
              </div>
            </div>
            <div class="ch4-cell">
              <img src="https://assets.tmke.co.uk/living-1.webp" alt="" />
              <div class="ch4-label">
                <span class="ch4-label-chapter">Chapter 04 &mdash; Approach</span>
                <span class="ch4-label-heading">Done with you, or done for you</span>
                <span class="ch4-label-sub">Whether you want ready-made assets from The Edit or a fully managed service, there&rsquo;s a level of support that fits where your business is right now.</span>
              </div>
            </div>
          </div>
        </div>
        <div class="ch4-col ch4-col--right">
          <!-- reversed order so this column travels DOWN as the left goes up -->
          <div class="ch4-strip" data-ch4="right">
            <div class="ch4-cell"><img src="https://assets.tmke.co.uk/living-2.webp" alt="" /></div>
            <div class="ch4-cell"><img src="https://assets.tmke.co.uk/kitchen-2.webp" alt="" /></div>
            <div class="ch4-cell"><img src="https://assets.tmke.co.uk/white-2.webp" alt="" /></div>
            <div class="ch4-cell"><img src="https://assets.tmke.co.uk/orange-2.webp" alt="" /></div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ============================== CH 05 — THE EDIT (gallery)
       Full-width product-style gallery (House of Corto inspired). Edge tiles
       bleed off so ~4 read across; the centre top cell is the "The Edit" brand
       cell. Tiles zoom in together on enter; the grid fades out before Ch 06.
       Placeholder Unsplash interiors for now. -->
  <section id="edit" class="edit-gallery" data-reveal-root>
    <div class="edit-grid" id="edit-grid">
      {editCells.map((c) => (
        c.brand ? (
          <div class="edit-cell edit-cell--brand">
            <div class="edit-brand-box">
              <span class="edit-brand-chapter">Chapter 05</span>
              <span class="edit-brand-title">The Edit</span>
            </div>
          </div>
        ) : c.cta ? (
          <a class="edit-cell edit-cell--cta" href="/edit" aria-label="Shop The Edit">
            <div class="edit-cta-box">
              <span class="edit-cta-eyebrow">Templates</span>
              <span class="edit-cta-link">Shop The Edit <em class="edit-cta-arrow" aria-hidden="true">&rarr;</em></span>
            </div>
          </a>
        ) : (
          <a class="edit-cell" href="/edit" aria-label={`The Edit — ${c.name}`}>
            <div class="edit-cell-img" style={`background-image:url('${c.src}')`}></div>
            <div class="edit-cell-label"><span>{c.fmt}</span><span>{c.name}</span></div>
          </a>
        )
      ))}
    </div>
  </section>

  <style>
    .edit-gallery {
      position: relative;
      background: var(--paper);
      padding: 100px 0 100px;
      overflow: hidden;            /* clip the bleeding edge tiles */
    }
    .edit-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      /* loads of padding around small tiles, like the reference */
      gap: 150px 6vw;
      width: 110vw;
      margin-left: -5vw;
    }
    .edit-cell {
      display: block;
      text-decoration: none;
      /* scale + opacity are scrubbed by the controller from each tile's scroll
         position, so rows grow in as you scroll down and shrink back as you
         scroll up. */
      transform: translateY(100px) scale(0.16);
      opacity: 0;
      will-change: transform, opacity;
    }
    .edit-cell-img {
      width: 100%;
      aspect-ratio: 3 / 4;
      background-size: cover; background-position: center;
      background-color: #e9e4da;
    }
    .edit-cell-label {
      display: flex; justify-content: space-between; gap: 10px;
      margin-top: 12px;
      font-family: var(--sans);
      font-size: clamp(10px, 0.85vw, 13px);
      font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
      color: var(--english-violet);
    }
    /* Brand cell — a tile-sized box (same as the image tiles) with the chapter
       above "The Edit" and no image inside. */
    .edit-cell--brand { display: block; }
    .edit-brand-box {
      aspect-ratio: 3 / 4;            /* matches the image tiles */
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: flex-end;
      gap: 14px;
      padding: 0 0 40px 20px;
      background: var(--paper);
      box-shadow: inset 0 0 0 1px rgba(28, 29, 34, 0.14);
    }
    .edit-brand-chapter {
      display: flex;
      align-items: center;
      gap: 16px;
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.36em;
      text-transform: uppercase;
      color: var(--english-violet);
    }
    .edit-brand-chapter::before {
      content: "";
      display: block;
      width: 48px;
      height: 1px;
      background: currentColor;
      opacity: 0.45;
      flex-shrink: 0;
    }
    .edit-brand-title {
      font-family: var(--serif);
      font-weight: 500;
      font-size: clamp(22px, 2.2vw, 40px);
      letter-spacing: 0.02em;
      color: var(--ink);
      line-height: 1;
    }
    /* CTA cell — same outlined box as the brand cell, with a link sitting
       towards the bottom that sends people through to The Edit. */
    .edit-cell--cta { display: block; }
    .edit-cta-box {
      aspect-ratio: 3 / 4;            /* matches the image + brand tiles */
      display: flex;
      flex-direction: column;
      justify-content: space-between; /* eyebrow at top, link at the bottom */
      align-items: flex-start;
      padding: clamp(14px, 1.4vw, 22px);
      background: var(--paper);
      box-shadow: inset 0 0 0 1px rgba(28, 29, 34, 0.14);
      transition: box-shadow 0.3s, background 0.3s;
    }
    .edit-cta-eyebrow {
      font-family: var(--sans);
      font-size: clamp(10px, 0.85vw, 12px);
      font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase;
      color: var(--english-violet);
    }
    .edit-cta-link {
      display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--sans);
      font-size: clamp(12px, 1vw, 15px);
      font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      color: var(--ink);
      transition: color 0.3s;
    }
    .edit-cta-arrow { font-style: normal; transition: transform 0.3s cubic-bezier(.2,.7,.2,1); }
    .edit-cell--cta:hover .edit-cta-box {
      box-shadow: inset 0 0 0 1.5px var(--english-violet);
      background: rgba(55, 30, 40, 0.03);
    }
    .edit-cell--cta:hover .edit-cta-link { color: var(--english-violet); }
    .edit-cell--cta:hover .edit-cta-arrow { transform: translateX(5px); }
    @media (max-width: 860px) {
      .edit-grid { grid-template-columns: repeat(3, 1fr); width: 132vw; margin-left: -16vw; gap: 36px 4vw; }
      .edit-gallery { padding: 64px 0; }
    }
  </style>

  <!-- The Edit gallery fades out as it nears Chapter 06, revealing it. -->
  <script>
    (function () {
      const section = document.querySelector(".edit-gallery");
      if (!section) return;
      const grid = section.querySelector(".edit-grid");
      const cells = Array.prototype.slice.call(section.querySelectorAll(".edit-cell"));
      const clamp01 = (t) => Math.max(0, Math.min(1, t));
      const smooth = (t) => t * t * (3 - 2 * t);
      const lenis = window.__lenis;
      const update = () => {
        const vh = window.innerHeight;
        // Skip all the per-tile work unless the gallery is near the viewport —
        // keeps scrolling elsewhere on the page smooth.
        const sr = section.getBoundingClientRect();
        if (sr.bottom < -vh * 0.3 || sr.top > vh * 1.3) return;
        // Scroll-scrubbed reveal: each tile grows AND drifts up into place as
        // its row rises through the viewport, starting while still below the
        // fold. It LATCHES — once a tile is in, it stays in (no reverse on the
        // way back up). No fade-out; once they're there, they're there.
        const start = vh * 1.15;   // tile top here -> just beginning (below fold)
        const end = vh * 0.55;     // tile top here -> fully in place
        cells.forEach((c) => {
          const eNow = smooth(clamp01((start - c.getBoundingClientRect().top) / (start - end)));
          const e = Math.max(c.__editE || 0, eNow);   // latch: never decreases
          c.__editE = e;
          const lift = (1 - e) * 100;   // px: starts lower, flows up to its spot
          c.style.transform = "translateY(" + lift.toFixed(1) + "px) scale(" + (0.16 + 0.84 * e).toFixed(3) + ")";
          c.style.opacity = e.toFixed(3);
        });
      };
      update();
      if (lenis && typeof lenis.on === "function") lenis.on("scroll", update);
      else window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update, { passive: true });
    })();
  </script>


  <!-- ============================== CH 06 — SOCIAL MEDIA
       Mirrors the Ch 05 pattern: copy on the left, image on the right,
       and the SMM coda block sits below tucked under the image column so
       it reads as part of the same composition. -->
  <section id="social" class="quote quote--split" data-reveal-root>
    <div class="quote-split-grid">
      <div class="quote-left">
        <div class="chapter reveal" data-reveal data-reveal-dir="left">Chapter 06 &mdash; Social Media Management</div>
        <div class="quote-mark" aria-hidden="true">&ldquo;</div>
        <blockquote class="quote-text split" data-reveal data-reveal-dir="up">
          <span class="split-line"><span>We work with agents who know their</span></span>
          <span class="split-line"><span>marketing matters, they just don&rsquo;t have</span></span>
          <span class="split-line"><span>the time or headspace to do it properly.</span></span>
        </blockquote>

        <!-- SMM coda — on the left, in line with the bleeding table photo. -->
        <div class="quote-coda">
          <p class="quote-coda-copy">If you care about how your brand shows up but don&rsquo;t want to manage it day to day, this is where we step in.</p>
          <p class="quote-coda-copy">TMKE plan, create and deliver consistent, on-brand content that reflects your business and supports long-term growth, without adding to your workload.</p>
          <p class="quote-coda-copy">One point of contact, one calendar, one brand that finally looks like the service you deliver.</p>
          <a href="/contact" class="btn btn--solid">Get Started <span class="btn-arrow">&rarr;</span></a>
        </div>
      </div>
    </div>

    <!-- Square table photo, held to the right edge and bleeding ~25% off it,
         in line with the Social Media Management piece. Static (no parallax). -->
    <figure class="quote-photo quote-photo--table">
      <div class="quote-photo-frame">
        <img src="https://assets.tmke.co.uk/table.webp" alt="" loading="lazy" />
      </div>
      <figcaption class="quote-photo-caption">
        <span class="quote-photo-line"></span>
        <span>The Studio &middot; London</span>
      </figcaption>
    </figure>
  </section>

  <!-- Five & Live now lives exclusively in the floating Free Assets tab on the left edge. -->

  <!-- ============================== NEWS / SUBSCRIBE -->
  <section id="news" class="news" data-reveal-root>
    <div class="news-bg" style="background-image:url('https://images.unsplash.com/photo-1521737711867-e3b97375f902?auto=format&fit=crop&w=2400&q=80')"></div>
    <!-- Top-left: chapter line -->
    <div class="news-tl">
      <div class="chapter chapter--light news-chapter">Chapter 07 &mdash; News</div>
    </div>

    <!-- Bottom-right: line + subtext + newsletter form -->
    <div class="news-br">
      <p class="news-lead">For the days you know you should post but don&rsquo;t know what.</p>
      <p class="news-copy">Get clear, structured marketing insights for estate agents,<br />straight to your inbox every month.</p>
      <form class="news-form" id="news-form">
        <input type="email" placeholder="Email" required />
        <button type="submit">Subscribe</button>
      </form>
    </div>
  </section>

  <!-- Five & Live floating tab removed for now (per design review). -->

  <!-- ===================== TMKE fold-out hero styles ===================== -->
  <style>
    .hero-zoom {
      position: relative;
      height: 260vh;            /* scroll length of the unfold */
      background: var(--paper);
    }
    .hero-zoom-pin {
      position: sticky;
      top: 0;
      height: 100vh;
      overflow: hidden;
    }

    /* Layer A — the photo, revealed by a circle that irises out from the centre
       of the word to fill a 30px-framed full screen. */
    .hero-zoom-media {
      position: absolute;
      /* Image runs all the way to the top (under the nav); 30px frame on the
         other three sides. */
      inset: 0 30px 30px 30px;
      z-index: 2;
      overflow: hidden;
      clip-path: circle(0px at 50% 50%);  /* JS grows the radius */
      will-change: clip-path;
      transform: translateZ(0);           /* isolate the clip-path repaint */
    }
    .hero-zoom-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Layer B — TMKE, solid dark purple, dead centre; recolours to white as the
       photo irises out behind it (colour set by the controller). */
    .hero-zoom-word {
      position: absolute;
      left: 50%;
      top: 50%;
      /* Nudged down a few px so, once the photo opens, the wordmark rests on the
         shelf just beneath it. */
      transform: translate(-50%, calc(-50% + 5px));
      z-index: 3;
      margin: 0;
      /* Brand wordmark font — matches the top-left logo (Cormorant) */
      font-family: var(--serif);
      font-weight: 600;
      font-size: clamp(104px, 16vw, 250px);
      line-height: 1;
      /* tighter than before so the trailing E isn't clipped */
      letter-spacing: -0.01em;
      text-align: center;
      /* Resting state = debossed wordmark in secondary #eae5e1 (a shade darker
         than the paper) for carved depth; the controller lerps this to the
         secondary taupe #7e6765 and swaps the carve shadows for a drop shadow
         as the fold-out photo irises open. */
      color: #eae5e1;
      text-shadow:
        0 -1px 1px rgba(36, 30, 18, 0.34),
        0 -2px 4px rgba(36, 30, 18, 0.18),
        0 -4px 7px rgba(36, 30, 18, 0.10),
        0 1px 1px rgba(255, 255, 255, 0.98),
        0 2px 4px rgba(255, 255, 255, 0.6),
        0 4px 8px rgba(255, 255, 255, 0.4);
      /* Drop shadow is applied by the controller — only once the photo is behind
         the letters (no shadow on the blank starter wall). */
      will-change: color, text-shadow;
    }
    /* Snakeskin resting surface — fills the hero behind the photo. Opacity is
       driven by the controller (full at rest, fades as the photo irises in).
       Only painted once the image loads (.has-snakeskin). */
    .hero-zoom-skin {
      position: absolute;
      inset: 0;
      z-index: 1;
      background-position: center;
      background-size: cover;
      opacity: 0;
      pointer-events: none;
    }
    .hero-zoom.has-snakeskin .hero-zoom-skin { background-image: var(--snakeskin); }
    /* TMKE embossed UP out of the leather: the letters are the same snakeskin
       surface raised, so we keep the fill near-transparent (the texture shows
       straight through the letter faces). A faint warm-light tint lets the
       raised faces read as catching the light slightly. The controller's relief
       shadows light the edges (highlight on the TOP edge, shadow on the BOTTOM
       edge) to complete the raised look. Toggled on (.is-skin) only at rest;
       removed as the fold-out begins so the word transitions normally after. */
    .hero-zoom-word.is-skin {
      /* Faint warm-light fill so the raised letter faces sit at (almost) full
         snakeskin texture, just catching a touch more light than the surround.
         The relief edges (controller) do the "raised" work, so it reads as the
         SAME leather pushed OUT, not a light word over the top. */
      color: rgba(255, 249, 242, 0.10);
      -webkit-text-fill-color: rgba(255, 249, 242, 0.10);
    }

    /* Layer C — sofa cushions over the word (same iris clip, set by the
       controller). object-fit/position mirror the photo so they line up. */
    .hero-zoom-fg {
      position: absolute;
      inset: 0 30px 30px 30px;
      z-index: 4;
      overflow: hidden;
      clip-path: circle(0px at 50% 50%);
      pointer-events: none;
      will-change: clip-path;
    }
    .hero-zoom-fg-img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Keep the nav transparent while the hero fills the viewport so the photo
       bleeds up behind it (toggled by the controller). */
    :global(.nav.nav--over-hero) {
      background: transparent !important;
      backdrop-filter: none !important;
      -webkit-backdrop-filter: none !important;
      border-bottom: none !important;
      /* hold the base height so the scrolled-state padding never makes the bar
         grow / "drop down" over the hero */
      padding-top: 9px !important;
      padding-bottom: 9px !important;
    }
    /* Once the photo has risen behind the nav, flip the logo / links / login /
       burger to white so they stay legible over the image. */
    :global(.nav.nav--on-image) { color: #fff !important; }
    :global(.nav.nav--on-image .nav-burger span) { background: #fff !important; }

    /* Bottom labels — sit on top of everything; shift dark->light as the photo
       passes under them (colour set by the controller). */
    .hero-zoom-foot {
      position: absolute;
      left: 0; right: 0;
      bottom: 40px;
      z-index: 4;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: end;
      gap: 24px;
      padding: 0 48px;
      color: var(--ink);
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
    }
    .hero-zoom-foot .hz-foot--l { justify-self: start; }
    .hero-zoom-foot .hz-foot--m { justify-self: center; letter-spacing: 0.14em; text-align: center; }
    .hero-zoom-foot .hz-foot--r { justify-self: end; text-align: right; }

    @media (max-width: 860px) {
      .hero-zoom { height: 200vh; }
      .hero-zoom-word { font-size: clamp(72px, 24vw, 168px); }
      .hero-zoom-foot { font-size: 10px; padding: 0 22px; gap: 12px; bottom: 28px; }
    }

    /* Reduced motion: present the full framed photo + labels, no scrub. */
  </style>

  <!-- Fold-out controller: the photo unfolds from the centre of the TMKE
       lettering to a 30px-framed full screen; the word fades as it goes, and
       the bottom labels shift dark->light as the photo arrives under them. -->
  <script>
    (function () {
      const hero = document.querySelector(".hero-zoom");
      if (!hero) return;
      const media = hero.querySelector(".hero-zoom-media");
      const fg = hero.querySelector(".hero-zoom-fg");
      const word = hero.querySelector(".hero-zoom-word");
      const skin = hero.querySelector(".hero-zoom-skin");
      // Snakeskin texture — set on the hero (so the surface layer + the wordmark
      // both inherit --snakeskin) only once the image actually loads, so nothing
      // breaks if the asset is missing. Tries the known filename + fallbacks.
      (function () {
        const urls = [
          "https://assets.tmke.co.uk/snake%20skin.png",
          "https://assets.tmke.co.uk/snakeskin.webp",
          "https://assets.tmke.co.uk/snakeskin.jpg",
          "https://assets.tmke.co.uk/snakeskin.png",
        ];
        let i = 0;
        (function next() {
          if (i >= urls.length) return;
          const url = urls[i++];
          const im = new Image();
          im.onload = () => { hero.style.setProperty("--snakeskin", "url('" + url + "')"); hero.classList.add("has-snakeskin"); update(); };
          im.onerror = next;
          im.src = url;
        })();
      })();
      const foot = hero.querySelector(".hero-zoom-foot");
      const nav = document.getElementById("nav");
      const smooth = (t) => t * t * (3 - 2 * t);
      const clamp01 = (t) => Math.max(0, Math.min(1, t));
      const lerp = (a, b, t) => a + (b - a) * t;
      const update = () => {
        const rect = hero.getBoundingClientRect();
        // Once the hero has fully scrolled past, stop touching it (the nav was
        // already cleared on the way out) — no per-frame clip-path work.
        if (rect.bottom < -10) return;
        const total = hero.offsetHeight - window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top, 0), total);
        const p = total > 0 ? scrolled / total : 0;
        const e = smooth(clamp01(p / 0.82));             // iris out over first ~82%
        const vw = window.innerWidth, vh = window.innerHeight;
        // circle irises out from the viewport centre (where the word sits) until
        // it covers the box (top:0, 30px on the other sides → top corners reach last)
        const halfW = vw / 2 - 30, halfH = vh / 2;
        const rMax = Math.sqrt(halfW * halfW + halfH * halfH);
        const clip = "circle(" + (e * rMax).toFixed(1) + "px at 50% " + (vh / 2).toFixed(0) + "px)";
        media.style.clipPath = clip;
        if (fg) fg.style.clipPath = clip;     // cushions reveal in lockstep
        // Snakeskin resting surface: full at rest, fades out as the photo opens
        // (snakeskin is only there BEFORE the animation). The wordmark is stamped
        // into it only while resting (.is-skin); once the fold-out begins we drop
        // the snakeskin so the word transitions to its normal state.
        const hasSkin = hero.classList.contains("has-snakeskin");
        if (skin) skin.style.opacity = hasSkin ? clamp01(1 - e / 0.18).toFixed(3) : "0";
        if (word) { if (hasSkin && e < 0.06) word.classList.add("is-skin"); else word.classList.remove("is-skin"); }
        // word: embossed #eae5e1 at rest -> secondary taupe #7e6765 as the photo irises past it
        const wc = smooth(clamp01((e - 0.04) / 0.42));
        word.style.color =
          "rgb(" + Math.round(lerp(234, 126, wc)) + "," + Math.round(lerp(229, 103, wc)) + "," + Math.round(lerp(225, 101, wc)) + ")";
        // Relief edges (the emboss) are full at rest and fade out over the first
        // sliver of scroll; the drop shadow fades in once the photo is behind.
        const carve = clamp01(1 - e / 0.1);
        const sh = smooth(clamp01((e - 0.12) / 0.4));
        // Raised-out-of-leather edges (light from above): a warm highlight on the
        // TOP edge where the raised face catches the light, and a soft shadow on
        // the BOTTOM edge that the raised letter casts down onto the surround.
        word.style.textShadow =
          "0 -1px 1px rgba(255,248,238," + (0.65 * carve).toFixed(3) + ")," +
          "0 -2px 4px rgba(255,248,238," + (0.40 * carve).toFixed(3) + ")," +
          "0 -4px 9px rgba(255,248,238," + (0.20 * carve).toFixed(3) + ")," +
          "0 1px 1px rgba(18,12,8," + (0.58 * carve).toFixed(3) + ")," +
          "0 3px 6px rgba(18,12,8," + (0.42 * carve).toFixed(3) + ")," +
          "0 6px 13px rgba(18,12,8," + (0.22 * carve).toFixed(3) + ")," +
          "0 3px 8px rgba(0,0,0," + (0.30 * sh).toFixed(3) + ")," +
          "0 12px 34px rgba(0,0,0," + (0.22 * sh).toFixed(3) + ")";
        // bottom labels: ink -> paper as the photo reaches them (late)
        const t = smooth(clamp01((e - 0.55) / 0.4));
        foot.style.color =
          "rgb(" + Math.round(lerp(28, 242, t)) + "," + Math.round(lerp(29, 239, t)) + "," + Math.round(lerp(34, 233, t)) + ")";
        // Nav: stay fully transparent the ENTIRE time the hero image still
        // covers the top of the viewport — including the held-full state and the
        // scroll-away — so the cream bar never "drops in" over the finished
        // image. It only gains its background once the hero has scrolled past
        // the top and the next section reaches it (rect.bottom near 0).
        if (nav) {
          const heroAtTop = rect.bottom > 80;
          nav.classList.toggle("nav--over-hero", heroAtTop);
          nav.classList.toggle("nav--on-image", heroAtTop && e > 0.5);
        }
      };
      update();
      if (window.__lenis && typeof window.__lenis.on === "function") {
        window.__lenis.on("scroll", update);
      } else {
        window.addEventListener("scroll", update, { passive: true });
      }
      window.addEventListener("resize", update, { passive: true });
    })();
  </script>

  <!-- ===================== Chapter 04 paired-scroller styles ===================== -->
  <style>
    .ch4 { position: relative; height: 760vh; background: var(--paper); }
    .ch4-pin { position: sticky; top: 0; height: 100vh; overflow: hidden; }
    .ch4-panels {
      position: absolute;
      inset: 30px;                       /* 30px frame, like the hero */
      display: grid;
      grid-template-columns: 1fr 1fr;    /* 50 / 50 */
      overflow: hidden;
    }
    .ch4-col { position: relative; overflow: hidden; height: 100%; }
    .ch4-strip {
      position: absolute;
      top: 0; left: 0;
      width: 100%;
      height: 400%;                      /* four full-height cells */
      display: flex;
      flex-direction: column;
      will-change: transform;
    }
    .ch4-cell { position: relative; height: 25%; overflow: hidden; }
    .ch4-cell img { width: 100%; height: 100%; object-fit: cover; display: block; }

    /* Per-image label — a paper-coloured box in the bottom-left of each left
       cell, 30px in from the photo edges (matching the frame). It scrolls up
       with the panel, revealing the next one. */
    /* All label boxes are the same size (set by the fullest one — the chapter
       box), and the heading + subtext fit inside. */
    .ch4-label {
      position: absolute;
      left: 30px;
      bottom: 30px;
      width: min(400px, 40vw);
      min-height: 232px;
      box-sizing: border-box;
      display: flex;
      flex-direction: column;
      background: var(--paper);
      color: var(--ink);
      padding: 22px 26px;
      font-family: var(--sans);
    }
    .ch4-label-chapter {
      display: flex;
      align-items: center;
      gap: 16px;
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.36em;
      text-transform: uppercase;
      color: var(--english-violet);
      margin-bottom: 12px;
    }
    .ch4-label-chapter::before {
      content: "";
      display: block;
      width: 48px;
      height: 1px;
      background: currentColor;
      opacity: 0.45;
      flex-shrink: 0;
    }
    .ch4-label-heading {
      font-weight: 800;
      font-size: clamp(18px, 1.5vw, 24px);
      line-height: 1.14;
      letter-spacing: -0.01em;
    }
    .ch4-label-sub {
      margin-top: 12px;
      font-weight: 400;
      font-size: clamp(12.5px, 0.95vw, 14.5px);
      line-height: 1.5;
      color: rgba(28, 29, 34, 0.72);
    }

    @media (max-width: 860px) {
      .ch4 { height: 560vh; }
      .ch4-label {
        left: 22px; bottom: 22px; padding: 16px 18px;
        width: min(78vw, 360px); min-height: 0;
      }
      .ch4-label-heading { font-size: clamp(16px, 4.4vw, 22px); }
    }
  </style>

  <!-- Chapter 04 controller: left strip travels up, right strip travels down
       (reversed DOM order keeps the property pairs aligned). Corner labels fade
       in around their stage. Continuous/scroll-driven for now; snap-to-stage is
       a follow-up. -->
  <script>
    (function () {
      const ch4 = document.querySelector(".ch4");
      if (!ch4) return;
      const left = ch4.querySelector('[data-ch4="left"]');
      const right = ch4.querySelector('[data-ch4="right"]');
      const N = 4;
      // Stepped scroll: each stage gets a flat HOLD band (image sits still) then
      // a TRANS band (panels move to the next). Long holds = a "viewport break".
      const HOLD = 1.5, TRANS = 1.0;
      const UNITS = N * HOLD + (N - 1) * TRANS;
      const clamp01 = (t) => Math.max(0, Math.min(1, t));
      const smooth = (t) => t * t * (3 - 2 * t);
      const lenis = window.__lenis;
      let snapping = false, snapTimer = 0;

      const prog = () => {
        const rect = ch4.getBoundingClientRect();
        const total = ch4.offsetHeight - window.innerHeight;
        const scrolled = Math.min(Math.max(-rect.top, 0), total);
        return { p: total > 0 ? scrolled / total : 0, rect, total };
      };

      // stepped position 0..N-1: flat during holds, eased during transitions
      const posFromP = (p) => {
        let u = p * UNITS, acc = 0;
        for (let i = 0; i < N; i++) {
          if (u <= acc + HOLD) return i;
          acc += HOLD;
          if (i < N - 1) {
            if (u <= acc + TRANS) return i + smooth((u - acc) / TRANS);
            acc += TRANS;
          }
        }
        return N - 1;
      };

      const update = () => {
        const { p, rect } = prog();
        // Only move the panels while the section is on screen.
        if (rect.bottom < 0 || rect.top > window.innerHeight) return;
        const pos = posFromP(p);
        left.style.transform = "translateY(" + (-pos * 25).toFixed(3) + "%)";
        right.style.transform = "translateY(" + (-(N - 1 - pos) * 25).toFixed(3) + "%)";
      };

      // scroll Y that lands on stage i's hold centre
      const stageY = (i) => {
        const total = ch4.offsetHeight - window.innerHeight;
        const top = ch4.getBoundingClientRect().top + window.scrollY;
        const u = i * (HOLD + TRANS) + HOLD / 2;
        return top + (u / UNITS) * total;
      };

      // when scrolling stops over the pinned section, snap to the nearest hold
      const scheduleSnap = () => {
        if (snapping) return;
        clearTimeout(snapTimer);
        snapTimer = setTimeout(() => {
          const { p, rect } = prog();
          if (rect.top > 0 || rect.bottom < window.innerHeight) return;  // free entry/exit
          const y = stageY(Math.round(posFromP(p)));
          snapping = true;
          const done = () => { snapping = false; };
          if (lenis && typeof lenis.scrollTo === "function") lenis.scrollTo(y, { duration: 0.5, onComplete: done });
          else { window.scrollTo({ top: y, behavior: "smooth" }); setTimeout(done, 500); }
          setTimeout(done, 1000);   // safety release
        }, 90);
      };

      const onScroll = () => { update(); scheduleSnap(); };
      update();
      if (lenis && typeof lenis.on === "function") lenis.on("scroll", onScroll);
      else window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", update, { passive: true });
    })();
  </script>

  <!-- ===================== Chapter 06 — Table photo ===================== -->
  <style>
    /* Ch06 holds the bleeding photo. Capped + centred on wide screens so the
       composition scales with the viewport up to 1800px, then sits centred
       (the photo bleeds off the capped section edge, not off into dead space). */
    #social.quote--split { position: relative; overflow: hidden; min-height: min(52vw, 936px); max-width: 1800px; margin-left: auto; margin-right: auto; }
    /* Square table photo, static, anchored to the right and ~25% off the section
       edge, vertically centred so it's in line with the SMM piece on the left.
       vw is capped (min/max) so it stops growing/bleeding once the section caps. */
    #social .quote-photo--table {
      position: absolute;
      top: 50%;
      right: max(-207px, -11.5vw);    /* ~25% of the square sits off the edge */
      transform: translateY(-50%);
      width: min(46vw, 828px);
      margin: 0;
      max-width: none;
      z-index: 1;
    }
    #social .quote-photo--table .quote-photo-frame {
      aspect-ratio: 1 / 1;            /* square */
      border-radius: 0;               /* no arch */
      box-shadow: none;
    }
    #social .quote-photo--table .quote-photo-frame::after { display: none; }
    #social .quote-photo--table .quote-photo-frame img {
      object-position: center;
      transform: none;
      animation: none;
    }
    #social .quote-photo--table .quote-photo-caption { justify-content: flex-start; }
    @media (max-width: 980px) {
      /* stack: photo full-width below the text, no bleed */
      #social.quote--split { min-height: 0; overflow: visible; }
      #social .quote-photo--table {
        position: static; transform: none; width: auto; right: auto;
        margin: 40px 22px 0;
      }
    }
  </style>
</BaseLayout>
