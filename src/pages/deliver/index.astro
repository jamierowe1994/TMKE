---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Your shoot — TMKE"
  description="Your TMKE videography delivery."
  hideNav
  noindex
>
  <main class="dlv">
    <header class="dlv-head">
      <a href="/" class="dlv-mark">TMKE</a>
      <span class="dlv-head-tag">Videography delivery</span>
    </header>

    <section class="dlv-stage" id="dlv-stage">
      <p class="dlv-loading" id="dlv-loading">Loading your gallery…</p>
    </section>
  </main>

  <style>
    .dlv { min-height: 100vh; background: var(--paper); }
    .dlv-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 22px 36px; border-bottom: 1px solid rgba(28,29,34,0.1);
    }
    .dlv-mark { font-family: var(--serif); font-size: 24px; font-weight: 600; letter-spacing: 0.04em; color: var(--ink); }
    .dlv-head-tag { font-family: var(--sans); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); }

    .dlv-stage { max-width: 1280px; margin: 0 auto; padding: 56px 36px 160px; }
    .dlv-loading, .dlv-msg { font-family: var(--sans); font-size: 15px; color: rgba(28,29,34,0.6); padding: 60px 0; text-align: center; }

    .dlv-intro { margin-bottom: 40px; }
    .dlv-eyebrow { font-family: var(--sans); font-size: 12px; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); margin-bottom: 14px; }
    .dlv-title { font-family: var(--serif); font-weight: 400; font-size: clamp(36px, 5vw, 64px); line-height: 1.04; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 14px; }
    .dlv-title em { font-style: italic; color: var(--english-violet); }
    .dlv-note { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(28,29,34,0.7); max-width: 60ch; margin: 0; }

    .dlv-filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 22px; }
    .dlv-chip {
      appearance: none; cursor: pointer;
      font-family: var(--sans); font-size: 13px; font-weight: 600;
      padding: 8px 14px; border-radius: 999px;
      border: 1px solid rgba(28,29,34,0.18); background: #fff; color: var(--ink);
      transition: border-color 0.2s, background 0.2s, color 0.2s;
    }
    .dlv-chip span { opacity: 0.5; margin-left: 4px; font-weight: 700; }
    .dlv-chip:hover { border-color: var(--english-violet); }
    .dlv-chip.is-on { background: var(--english-violet); color: var(--paper); border-color: var(--english-violet); }
    .dlv-chip.is-on span { opacity: 0.75; }

    .dlv-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 14px; }
    .dlv-tile { position: relative; aspect-ratio: 4/3; border-radius: 6px; overflow: hidden; background: rgba(28,29,34,0.06); border: 1px solid rgba(28,29,34,0.1); }
    .dlv-tile img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .dlv-tile-locked { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; height: 100%; color: rgba(28,29,34,0.5); }
    .dlv-tile-locked .dlv-blur { position: absolute; inset: 0; background: repeating-linear-gradient(45deg, rgba(71,66,84,0.06), rgba(71,66,84,0.06) 12px, rgba(71,66,84,0.12) 12px, rgba(71,66,84,0.12) 24px); }
    .dlv-lock-ico { position: relative; z-index: 2; }
    .dlv-lock-txt { position: relative; z-index: 2; font-family: var(--sans); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700; }
    .dlv-tile-foot { position: absolute; left: 0; right: 0; bottom: 0; z-index: 3; display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 10px 12px; background: linear-gradient(0deg, rgba(12,11,10,0.75), transparent); }
    .dlv-tile-name { font-family: var(--sans); font-size: 11px; color: var(--paper); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dlv-dl { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--paper); background: rgba(255,255,255,0.18); border: 1px solid rgba(255,255,255,0.5); border-radius: 999px; padding: 5px 11px; text-decoration: none; white-space: nowrap; }
    .dlv-dl:hover { background: var(--paper); color: var(--ink); }
    .dlv-vid { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: 8px; color: rgba(28,29,34,0.6); }

    .dlv-pay { position: sticky; bottom: 0; z-index: 10; margin-top: 36px; }
    .dlv-pay-inner {
      display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap;
      background: var(--ink); color: var(--paper); border-radius: 8px; padding: 22px 28px;
      box-shadow: 0 20px 50px rgba(20,18,26,0.3);
    }
    .dlv-pay-text { font-family: var(--sans); font-size: 14px; line-height: 1.5; }
    .dlv-pay-text strong { font-family: var(--serif); font-size: 24px; font-weight: 500; display: block; }
    .dlv-pay-break { font-size: 12px; color: rgba(240,238,235,0.7); margin-top: 4px; }
    .dlv-pay-btn { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; background: var(--paper); color: var(--ink); border: none; border-radius: 999px; padding: 14px 26px; cursor: pointer; transition: background 0.2s, color 0.2s; }
    .dlv-pay-btn:hover { background: var(--english-violet); color: var(--paper); }

    .dlv-paid-banner { display: inline-flex; align-items: center; gap: 10px; padding: 10px 18px; border-radius: 999px; background: rgba(44,122,75,0.12); color: #2c7a4b; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; margin-bottom: 28px; }

    @media (max-width: 720px) { .dlv-stage { padding: 36px 20px 140px; } .dlv-head { padding: 18px 20px; } }
  </style>

  <script>
    import { gbpFromPence } from "../../lib/supabase.js";
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");

    const stage = document.getElementById("dlv-stage");
    const token = new URLSearchParams(location.search).get("d") || "";

    function esc(s) { return String(s ?? "").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }
    function fileUrl(key, dl) { return `${WORKER}/g/file?token=${encodeURIComponent(token)}&key=${encodeURIComponent(key)}${dl ? "&dl=1" : ""}`; }
    const LOCK_SVG = '<svg class="dlv-lock-ico" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="11" width="16" height="9" rx="2"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';

    function tile(f) {
      const cat = esc(f.category || "Other");
      if (!f.unlocked) {
        return `<figure class="dlv-tile" data-cat="${cat}"><div class="dlv-blur"></div><div class="dlv-tile-locked">${LOCK_SVG}<span class="dlv-lock-txt">Locked</span></div></figure>`;
      }
      if (f.kind === "image") {
        return `<figure class="dlv-tile" data-cat="${cat}">
          <img src="${fileUrl(f.key)}" alt="${esc(f.name)}" loading="lazy" />
          <figcaption class="dlv-tile-foot"><span class="dlv-tile-name">${esc(f.name)}</span><a class="dlv-dl" href="${fileUrl(f.key, true)}">Save</a></figcaption>
        </figure>`;
      }
      // video / other
      return `<figure class="dlv-tile" data-cat="${cat}"><div class="dlv-vid">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polygon points="5 3 19 12 5 21 5 3"/></svg>
        <span class="dlv-lock-txt">${esc(f.kind || "file")}</span></div>
        <figcaption class="dlv-tile-foot"><span class="dlv-tile-name">${esc(f.name)}</span>
        <span><a class="dlv-dl" href="${fileUrl(f.key)}" target="_blank" rel="noopener">View</a> <a class="dlv-dl" href="${fileUrl(f.key, true)}">Save</a></span></figcaption>
      </figure>`;
    }

    // Filter chips — "All" + each category present (with counts). Clicking one
    // shows only that category. Built in a stable, sensible order.
    const CAT_ORDER = ["Headshots", "Exteriors", "Interiors", "Twilight", "Drone", "Video", "Other"];
    function filterBar(files) {
      const counts = {};
      files.forEach((f) => { const c = f.category || "Other"; counts[c] = (counts[c] || 0) + 1; });
      const cats = Object.keys(counts);
      if (cats.length < 2) return ""; // nothing to filter
      const ordered = CAT_ORDER.filter((c) => counts[c]).concat(cats.filter((c) => !CAT_ORDER.includes(c)));
      const chips = [`<button class="dlv-chip is-on" data-filter="*">All <span>${files.length}</span></button>`]
        .concat(ordered.map((c) => `<button class="dlv-chip" data-filter="${esc(c)}">${esc(c)} <span>${counts[c]}</span></button>`));
      return `<div class="dlv-filters" id="dlv-filters">${chips.join("")}</div>`;
    }

    function render(d) {
      const locked = d.files.filter((f) => !f.unlocked).length;
      const paidBanner = d.paid ? `<div class="dlv-paid-banner">✓ Paid — full gallery unlocked</div>` : "";
      const extrasLine = (d.extras || []).length
        ? d.extras.map((e) => `${esc(e.label)} ${gbpFromPence(e.amount_pence)}`).join(" · ")
        : "";
      const payBar = d.paid ? "" : `
        <div class="dlv-pay">
          <div class="dlv-pay-inner">
            <div class="dlv-pay-text">
              Unlock the full gallery &amp; downloads
              <strong>${gbpFromPence(d.totalPence)}</strong>
              <div class="dlv-pay-break">Shoot ${gbpFromPence(d.basePence)}${extrasLine ? " · " + extrasLine : ""}</div>
            </div>
            <button class="dlv-pay-btn" id="dlv-pay">Pay &amp; unlock</button>
          </div>
        </div>`;

      stage.innerHTML = `
        <div class="dlv-intro">
          <div class="dlv-eyebrow">${d.paid ? "Delivered" : "Preview"}</div>
          <h1 class="dlv-title">${d.clientName ? esc(d.clientName) + ", your" : "Your"} shoot is <em>ready.</em></h1>
          <p class="dlv-note">${d.message ? esc(d.message) : (d.paid ? "Everything's unlocked — view and download below." : `Here's a preview. ${locked} more ${locked === 1 ? "file is" : "files are"} ready — unlock the full gallery to view and download everything in full resolution.`)}</p>
        </div>
        ${paidBanner}
        ${filterBar(d.files)}
        <div class="dlv-grid" id="dlv-grid">${d.files.map(tile).join("")}</div>
        ${payBar}`;

      // Category filtering — show only the chosen category's tiles.
      const filters = document.getElementById("dlv-filters");
      if (filters) {
        const grid = document.getElementById("dlv-grid");
        filters.addEventListener("click", (e) => {
          const chip = e.target.closest(".dlv-chip");
          if (!chip) return;
          filters.querySelectorAll(".dlv-chip").forEach((c) => c.classList.remove("is-on"));
          chip.classList.add("is-on");
          const f = chip.getAttribute("data-filter");
          grid.querySelectorAll(".dlv-tile").forEach((t) => {
            t.style.display = (f === "*" || t.getAttribute("data-cat") === f) ? "" : "none";
          });
        });
      }

      const pay = document.getElementById("dlv-pay");
      if (pay) pay.addEventListener("click", () => {
        // Stripe checkout slots in here (Phase 5). Until then:
        alert("Card payment is being set up. Please contact TMKE to complete payment and we'll unlock your gallery straight away.");
      });
    }

    (async () => {
      if (!token) { stage.innerHTML = `<p class="dlv-msg">This delivery link is missing its code. Please use the full link we sent you.</p>`; return; }
      if (!WORKER) { stage.innerHTML = `<p class="dlv-msg">Gallery is being set up — please try again shortly.</p>`; return; }
      try {
        const res = await fetch(`${WORKER}/g/meta?token=${encodeURIComponent(token)}`);
        if (!res.ok) { stage.innerHTML = `<p class="dlv-msg">We couldn't find this delivery. The link may have expired — please contact TMKE.</p>`; return; }
        const d = await res.json();
        render(d);
      } catch (e) {
        stage.innerHTML = `<p class="dlv-msg">Something went wrong loading your gallery. Please try again or contact TMKE.</p>`;
      }
    })();
  </script>
</BaseLayout>
