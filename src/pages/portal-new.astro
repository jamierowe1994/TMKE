---
// The new client portal (Danielle, 7 Nov 2026; agreed on the mock-up). Here at a
// preview address until she has checked it with real folders, then it replaces
// /portal. Same private link (?c=…) and passcode. The Worker checks the passcode
// and signs every file link; this page holds nothing but the sign-in it's given,
// kept in this browser for a week, shared with the old page.
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Client portal — TMKE" description="Your TMKE content." hideNav hideFooter noindex>
  <div id="pn">
    <div id="pn-app"></div>
    <div class="toast" id="pn-toast" role="status"></div>
  </div>

  <style is:global>
    body:has(#pn) .site-grain { display: none; }
    html.pn-held, html.pn-held body { height: 100%; overflow: hidden; }
    @media (max-width: 1000px), (max-height: 520px), (hover: none) {
      html.pn-held, html.pn-held body { height: auto; overflow: auto; }
    }
    /* One held-still screen in four columns: mark and title, the list, a wall of
       full boxes that scrolls, and a quiet edge. Home is white; a shoot goes wine. */
    #pn {
      --wine: #371e28; --taupe: #7e6765; --stone: #c9bcb7; --linen: #eae5e1; --white: #fff;
      --bg: var(--white); --fg: var(--wine); --dim: var(--stone); --soft: var(--taupe); --line: var(--linen);
      min-height: 100%; background: var(--bg); color: var(--fg); font: 400 16px/1.35 var(--sans); letter-spacing: normal; transition: background .55s ease, color .55s ease;
    }
    html.pn-held #pn { height: 100%; }
    #pn-app { height: 100%; }
    #pn *, #pn *::before, #pn *::after { box-sizing: border-box; }
    #pn.dark { --bg: var(--wine); --fg: var(--linen); --dim: var(--taupe); --soft: var(--stone); --line: #4d3540; }
    #pn button { font: inherit; color: inherit; background: none; border: 0; padding: 0; margin: 0; cursor: pointer; text-align: left; letter-spacing: inherit; }
    #pn a { color: inherit; }
    #pn button:focus-visible, #pn a:focus-visible, #pn input:focus-visible, #pn textarea:focus-visible { outline: 2px solid var(--soft); outline-offset: 2px; }
    #pn h1, #pn h2, #pn p { margin: 0; }
    #pn .cap { font-weight: 700; font-size: 14px; letter-spacing: .05em; text-transform: uppercase; line-height: 1.15; }
    #pn .mark { display: block; width: 104px; height: auto; }
    #pn.dark .mark { filter: invert(1) sepia(.2) brightness(.96); }
    #pn .wall { height: 100%; height: 100dvh; display: grid; grid-template-columns: minmax(0,1.55fr) minmax(0,.9fr) minmax(0,2.2fr) 128px; padding-left: max(24px,env(safe-area-inset-left,0px)); }
    #pn .c1, #pn .c2, #pn .c4 { display: flex; flex-direction: column; justify-content: space-between; padding-block: 24px; min-height: 0; min-width: 0; }
    #pn .c4 { align-items: flex-end; padding-right: max(24px,env(safe-area-inset-right,0px)); text-align: right; }
    #pn .big { font: 300 52px/1.05 var(--serif); letter-spacing: -.02em; text-wrap: balance; opacity: 0; transform: translateY(6px); transition: opacity .25s, transform .25s; padding-right: 24px; color: inherit; }
    #pn .big.on { opacity: 1; transform: none; }
    #pn .info { min-height: 136px; padding-right: 24px; display: flex; flex-direction: column; justify-content: flex-end; }
    #pn .info > b { display: block; font-weight: 700; }
    #pn .list { display: grid; gap: 2px; transition: opacity .25s; align-content: start; }
    #pn .list .lab { margin-bottom: 6px; }
    #pn .list button { color: var(--soft); transition: color .15s; }
    #pn .list button:hover, #pn .list button.on { color: var(--fg); }
    #pn .wall.hov .list { opacity: .45; }
    #pn .tiles { height: 100%; overflow: auto; display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: calc(50% - 5px); gap: 10px; scrollbar-width: none; }
    #pn .tiles::-webkit-scrollbar { display: none; }
    #pn .tile { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; background: var(--line); }
    #pn .tile img { display: block; width: 100%; height: 100%; object-fit: cover; transition: opacity .28s, filter .28s, transform .9s cubic-bezier(.2,.7,.2,1); }
    #pn .tile:hover img { transform: scale(1.025); }
    #pn .wall.hov .tile:not(.on) img { opacity: .14; filter: grayscale(1); }
    #pn .tile i { position: absolute; right: 10px; top: 8px; font: 300 14px var(--serif); font-style: normal; color: #fff; opacity: 0; transition: opacity .2s; text-shadow: 0 1px 8px rgba(0,0,0,.4); }
    #pn .tile.on i { opacity: 1; }
    #pn .tile .tcap { display: none; }
    #pn .fill { width: 100%; height: 100%; transition: opacity .28s; }
    #pn .wall.hov .fill { opacity: .14; }
    #pn .play { position: absolute; left: 50%; top: 50%; width: 56px; height: 56px; margin: -28px 0 0 -28px; border-radius: 50%; background: rgba(55,30,40,.72); display: grid; place-items: center; }
    #pn .play::after { content: ""; margin-left: 4px; border-left: 15px solid #fff; border-top: 9px solid transparent; border-bottom: 9px solid transparent; }
    #pn .back { color: var(--soft); }
    #pn .back:hover { color: var(--fg); }
    #pn .note { font-size: 13px; color: var(--soft); max-width: 112px; }
    #pn .state { padding: 40px max(24px,env(safe-area-inset-left,0px)); color: var(--soft); }
    /* Inside a folder */
    #pn .folder { height: 100%; height: 100dvh; display: grid; grid-template-columns: minmax(0,1fr) min(600px,47vw); grid-template-rows: minmax(0,1fr); }
    #pn .side, #pn .main { min-height: 0; }
    #pn .main { --line: var(--linen); height: 100%; overflow: auto; min-width: 0; padding-right: 10px; background: var(--white); scrollbar-width: thin; scrollbar-color: var(--stone) transparent; }
    #pn .side { background: var(--wine); height: 100%; display: flex; flex-direction: column; justify-content: space-between; gap: 18px; padding: 24px max(24px,env(safe-area-inset-right,0px)) 24px 18px; min-width: 0; }
    #pn .low { height: 54%; min-height: 340px; display: flex; flex-direction: column; justify-content: space-between; gap: 16px; }
    #pn .side h2 { font: 300 34px/1.08 var(--serif); letter-spacing: -.015em; margin: 0 0 4px; text-wrap: balance; color: inherit; }
    #pn .stop { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    #pn .toggle { display: inline-flex; border: 1px solid var(--dim); border-radius: 4px; overflow: hidden; }
    #pn .toggle button { padding: 6px 12px; font-size: 13px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--soft); }
    #pn .toggle button[aria-pressed="true"] { background: var(--fg); color: var(--bg); }
    #pn .flist { display: grid; gap: 2px; margin-top: 14px; }
    #pn .flist button { color: var(--soft); }
    #pn .flist button:hover, #pn .flist button.on { color: var(--fg); }
    #pn .meta { display: grid; gap: 8px; }
    #pn .meta.two { grid-template-columns: 1fr 1fr; gap: 8px 16px; }
    #pn .meta.crew { align-content: space-between; gap: 14px; }
    #pn .meta div b { display: block; font-weight: 700; font-size: 14px; letter-spacing: .05em; text-transform: uppercase; line-height: 1.1; }
    #pn .acts { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    #pn .acts.one { grid-template-columns: 1fr; }
    #pn .btn { display: block; width: 100%; text-align: center; padding: 9px 12px; border-radius: 4px; border: 1px solid var(--dim); font-weight: 600; font-size: 14px; letter-spacing: .04em; text-transform: uppercase; color: var(--fg); background: none; transition: background .15s, color .15s; }
    #pn .btn:hover { background: var(--fg); color: var(--bg); border-color: var(--fg); }
    #pn .btn.pri { background: var(--fg); color: var(--bg); border-color: var(--fg); }
    #pn .btn:disabled { opacity: .6; cursor: default; }
    #pn .roll { display: grid; gap: 10px; padding-bottom: 10px; }
    #pn .shot { position: relative; display: block; width: 100%; overflow: hidden; background: var(--line); cursor: pointer; }
    #pn .shot img, #pn .shot video { display: block; width: 100%; height: auto; }
    #pn .prow { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 10px; }
    #pn .prow .shot img, #pn .prow .shot video { aspect-ratio: 2/3; object-fit: cover; }
    #pn .dl { position: absolute; right: 10px; bottom: 10px; background: rgba(55,30,40,.85); color: #fff; font-size: 13px; font-weight: 600; padding: 5px 10px; border-radius: 4px; opacity: 0; transition: opacity .15s; text-decoration: none; }
    #pn .shot:hover .dl, #pn .thumb:hover .dl { opacity: 1; }
    #pn .thumbs { display: grid; grid-template-columns: repeat(auto-fill,minmax(320px,1fr)); gap: 10px; padding-block: 0 10px; }
    #pn .thumb { position: relative; display: block; width: 100%; aspect-ratio: 3/2; overflow: hidden; background: var(--line); cursor: pointer; }
    #pn .thumb.sel { outline: 3px solid var(--wine); outline-offset: -3px; }
    #pn .thumb img, #pn .thumb video { display: block; width: 100%; height: 100%; object-fit: cover; }
    #pn .thumb .ext { display: grid; place-items: center; width: 100%; height: 100%; font-weight: 700; text-transform: uppercase; color: var(--taupe); }
    #pn .tick { position: absolute; left: 10px; top: 10px; width: 22px; height: 22px; border-radius: 4px; background: #fff; border: 1px solid var(--stone); display: grid; place-items: center; }
    #pn .tick.on { background: var(--wine); border-color: var(--wine); }
    #pn .tick.on::after { content: ""; width: 10px; height: 5px; border-left: 2px solid #fff; border-bottom: 2px solid #fff; transform: translateY(-1px) rotate(-45deg); }
    #pn .selline { display: flex; justify-content: space-between; gap: 12px; font-size: 14px; color: var(--soft); margin-bottom: 8px; }
    #pn .selline span { display: inline-flex; gap: 12px; }
    #pn .selline button { color: var(--fg); text-decoration: underline; text-underline-offset: 2px; }
    #pn .jack { display: flex; gap: 6px; margin-top: 6px; }
    #pn .jack a { width: 28px; height: 28px; display: grid; place-items: center; border: 1px solid var(--dim); border-radius: 4px; color: var(--fg); }
    #pn .jack a:hover { background: var(--fg); color: var(--bg); border-color: var(--fg); }
    /* Request edits */
    #pn .side.editing { justify-content: flex-start; gap: 0; }
    #pn .ehead h2 { margin: 28px 0 14px; }
    #pn .elead { color: var(--soft); max-width: 60ch; }
    #pn .ehead .elead { margin: 0 0 26px; }
    #pn .side .elist { flex: 1 1 auto; min-height: 0; overflow: auto; display: grid; gap: 10px; padding-right: 6px; align-content: start; scrollbar-width: thin; scrollbar-color: var(--dim) transparent; }
    #pn .erow { display: grid; grid-template-columns: 96px minmax(0,1fr); gap: 12px; align-items: center; }
    #pn .erow img, #pn .erow .noimg { display: block; width: 96px; height: 64px; object-fit: cover; background: var(--taupe); }
    #pn .erow b { display: block; font-weight: 700; font-size: 14px; letter-spacing: .05em; text-transform: uppercase; line-height: 1.1; margin-bottom: 4px; }
    #pn .erow input[type="text"], #pn .efoot textarea { display: block; width: 100%; font: inherit; color: var(--wine); background: var(--linen); border: 1px solid var(--linen); border-radius: 4px; padding: 6px 9px; }
    #pn .erow input::placeholder, #pn .efoot textarea::placeholder { color: var(--taupe); }
    #pn .tw { display: flex; align-items: center; gap: 6px; margin-top: 6px; font-size: 16px; cursor: pointer; }
    #pn .tw input { width: 16px; height: 16px; accent-color: var(--linen); margin: 0; }
    #pn .tw.bundle { margin: 0 0 10px; }
    #pn .efoot { flex: none; display: grid; gap: 6px; padding-top: 16px; }
    #pn .efoot textarea { resize: none; }
    #pn .efoot .btn { margin-top: 8px; }
    #pn .ecap { display: block; font-weight: 700; font-size: 14px; letter-spacing: .05em; text-transform: uppercase; margin-bottom: 4px; }
    #pn .eerr { color: var(--stone); }
    /* Viewer */
    #pn .viewer { position: fixed; inset: 0; background: rgba(32,17,24,.96); z-index: 30; display: grid; grid-template-rows: minmax(0,1fr) auto; padding: 20px max(20px,env(safe-area-inset-right,0px)) 16px max(20px,env(safe-area-inset-left,0px)); color: var(--linen); }
    #pn .viewer img, #pn .viewer video { width: 100%; height: 100%; object-fit: contain; display: block; min-height: 0; }
    #pn .vbar { display: flex; justify-content: space-between; align-items: center; gap: 14px; padding-top: 12px; flex-wrap: wrap; }
    #pn .vbar div { display: flex; gap: 14px; }
    #pn .vbar a { text-decoration: none; }
    #pn .fly { position: fixed; z-index: 20; object-fit: cover; pointer-events: none; margin: 0; }
    #pn .toast { position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%); background: var(--wine); color: #fff; padding: 8px 14px; border-radius: 4px; font-size: 14px; z-index: 40; opacity: 0; transition: opacity .2s; pointer-events: none; box-shadow: 0 0 0 1px var(--taupe); max-width: 90vw; }
    #pn .toast.on { opacity: 1; }
    #pn .infobtn, #pn .lx, #pn .smark { display: none; }
    #pn .snap { position: fixed; left: 0; right: 0; min-height: 100%; pointer-events: none; background: var(--bg); color: var(--fg); }
    #pn .snaplight { --bg: var(--white); --fg: var(--wine); --dim: var(--stone); --soft: var(--taupe); --line: var(--linen); }
    #pn .snapdark { --bg: var(--wine); --fg: var(--linen); --dim: var(--taupe); --soft: var(--stone); --line: #4d3540; }
    #pn .ipanel { position: fixed; inset: 0; z-index: 25; background: var(--wine); color: var(--linen); overflow: auto; padding: 24px max(16px,env(safe-area-inset-right,0px)) calc(24px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px)); display: flex; flex-direction: column; justify-content: flex-end; gap: 22px; --fg: var(--linen); --bg: var(--wine); --dim: var(--taupe); --soft: var(--stone); }
    #pn .ipanel .ih { position: absolute; left: max(16px,env(safe-area-inset-left,0px)); right: max(16px,env(safe-area-inset-right,0px)); top: 50%; transform: translateY(-50%); display: flex; justify-content: space-between; align-items: baseline; gap: 14px; }
    #pn .ipanel h2 { font: 300 34px/1.08 var(--serif); letter-spacing: -.015em; text-wrap: balance; color: inherit; }
    /* The passcode */
    #pn .gate { min-height: 100vh; min-height: 100dvh; background: var(--wine); color: var(--linen); display: flex; flex-direction: column; justify-content: center; padding: 32px max(24px,env(safe-area-inset-right,0px)) 32px max(24px,env(safe-area-inset-left,0px)); --fg: var(--linen); --bg: var(--wine); --soft: var(--stone); }
    #pn .gate .inner { width: 100%; max-width: 460px; margin: 0 auto; display: grid; gap: 14px; }
    #pn .gate .mark { filter: invert(1) sepia(.2) brightness(.96); margin-bottom: 26px; }
    #pn .gate h1 { font: 300 44px/1.08 var(--serif); letter-spacing: -.02em; color: inherit; }
    #pn .gate p { color: var(--stone); }
    #pn .gate .row { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 8px; margin-top: 8px; }
    #pn .gate input { font: inherit; color: var(--wine); background: var(--linen); border: 1px solid var(--linen); border-radius: 4px; padding: 9px 12px; text-transform: uppercase; letter-spacing: .12em; width: 100%; }
    #pn .gate .btn { width: auto; padding-inline: 18px; background: var(--linen); color: var(--wine); border-color: var(--linen); }
    #pn .gate .err { color: var(--linen); }

    @media (max-width: 1000px), (max-height: 520px), (hover: none) {
      #pn { transition: none; min-height: 100vh; }
      #pn-app { background: var(--bg); }
      /* First page: mark top left; Sign out and the list top right; the count; photos two across, the first row and a third of the next on screen. */
      #pn .wall { --t: calc((100vw - 36px)*.75); display: grid; grid-template-columns: auto minmax(0,1fr); grid-template-rows: minmax(max(120px,calc(100svh - var(--t)*1.33 - 92px)),auto) auto auto; position: relative; height: auto; padding: 16px max(16px,env(safe-area-inset-right,0px)) 28px max(16px,env(safe-area-inset-left,0px)); }
      #pn .c1, #pn .c4 { padding-block: 0; display: block; text-align: left; }
      #pn .c2 { display: contents; }
      #pn .mark { width: 60px; }
      #pn .c4 { position: absolute; top: 16px; right: max(16px,env(safe-area-inset-right,0px)); padding-right: 0; }
      #pn .c4 .cap { font-size: 15px; }
      #pn .note, #pn .info, #pn .big { display: none; padding: 0; }
      #pn .list { grid-column: 2; display: block; text-align: right; padding-top: 30px; }
      #pn .list .lab { margin: 0 0 3px; font-weight: 700; font-size: 15px; color: var(--fg); }
      #pn .list button { display: block; width: 100%; text-align: right; color: var(--soft); font-weight: 600; font-size: 14px; letter-spacing: .05em; line-height: 1.3; }
      #pn .wall.hov .list { opacity: 1; }
      #pn .c2 .bottom { grid-column: 1/-1; margin: 0 0 8px; display: flex; justify-content: space-between; align-items: baseline; font-size: 15px; }
      #pn .tiles { grid-column: 1/-1; display: grid; height: auto; overflow: visible; grid-template-columns: repeat(2,minmax(0,1fr)); grid-auto-rows: auto; gap: 8px 4px; }
      #pn .tile { height: auto; background: none; overflow: visible; }
      #pn .tile img, #pn .tile .noimg { display: block; width: 100%; aspect-ratio: 2/3; height: auto; background: var(--line); }
      #pn .tile:hover img { transform: none; }
      #pn .tile i { display: none; }
      #pn .wall.hov .tile:not(.on) img { opacity: 1; filter: none; }
      #pn .wall.hov .fill { opacity: 1; }
      #pn .tile .tcap { display: block; padding-top: 3px; }
      #pn .tn { display: flex; justify-content: space-between; align-items: baseline; gap: 6px; }
      #pn .tn b { font-weight: 700; font-size: 12px; letter-spacing: .04em; text-transform: uppercase; line-height: 1.2; min-width: 0; }
      #pn .tn u { text-decoration: none; font-size: 12px; line-height: 1.2; color: var(--soft); white-space: nowrap; }
      #pn .fill { height: auto; aspect-ratio: 2/3; align-self: start; }
      #pn .play { top: 40%; width: 44px; height: 44px; margin: -22px 0 0 -22px; }
      /* Second page: the same, on wine, with the shoot's name and a cross. */
      #pn.dark .list button:not(.lx) { display: none; }
      #pn .list .lx { display: inline !important; width: auto !important; margin-left: 10px; font-weight: 400; font-size: 18px; line-height: 1; color: var(--fg) !important; }
      #pn .infobtn { display: block; position: absolute; right: 0; top: 8px; color: var(--fg); }
      #pn .bottom .infobtn { position: static; }
      #pn .infobtn.float { position: fixed; top: calc(12px + env(safe-area-inset-top,0px)); right: max(16px,env(safe-area-inset-right,0px)); z-index: 12; background: var(--wine); color: var(--linen); padding: 6px 10px; border-radius: 4px; }
      /* Folder: all white, photos edge to edge in Portfolio, the buttons held at the bottom. */
      #pn .folder { display: flex; flex-direction: column-reverse; height: auto; min-height: 100dvh; background: var(--white); }
      #pn .main { flex: 1 1 auto; height: auto; overflow: visible; padding: 8px max(16px,env(safe-area-inset-right,0px)) 118px max(16px,env(safe-area-inset-left,0px)); }
      #pn .main.pf { padding-inline: 0; padding-top: 0; }
      #pn .main.pf .roll, #pn .main.pf .prow { gap: 8px; }
      #pn .side { height: auto; gap: 0; padding: 16px max(16px,env(safe-area-inset-right,0px)) 14px max(16px,env(safe-area-inset-left,0px)); }
      #pn .side:not(.editing) { --fg: var(--wine); --bg: var(--white); --dim: var(--stone); --soft: var(--taupe); background: var(--white); color: var(--wine); }
      #pn .side:not(.editing) .smark { filter: none; }
      #pn .stop { display: grid; grid-template-columns: 1fr auto; row-gap: 10px; justify-items: end; align-items: start; }
      #pn .smark { display: block; width: 60px; grid-row: 1/3; justify-self: start; }
      #pn .stop .toggle { grid-column: 2; }
      #pn .low { height: auto; min-height: 0; gap: 0; margin-top: 56px; }
      #pn .low > div:first-child { position: relative; }
      #pn .side h2 { font-size: 30px; margin: 0 60px 0 0; }
      #pn .side .meta.two { display: none; }
      #pn .ipanel .meta.two { display: grid; }
      #pn .flist { display: flex; gap: 16px; overflow-x: auto; margin-top: 10px; scrollbar-width: none; }
      #pn .flist button { white-space: nowrap; }
      #pn .prow { grid-template-columns: repeat(3,minmax(0,1fr)); }
      #pn .thumbs { grid-template-columns: 1fr 1fr; gap: 8px; padding-block: 0; }
      #pn .thumb .dl { display: none; }
      #pn .shot .dl { opacity: 1; }
      #pn #actsbox { position: fixed; left: 0; right: 0; bottom: 0; z-index: 10; background: var(--white); border-top: 1px solid var(--linen); padding: 10px max(16px,env(safe-area-inset-right,0px)) calc(10px + env(safe-area-inset-bottom,0px)) max(16px,env(safe-area-inset-left,0px)); }
      #pn .btn { padding: 11px 6px; font-size: 13px; }
      /* Request edits takes the whole screen; the files scroll, Anything else and Send stay put. */
      #pn .side.editing { position: fixed; inset: 0; z-index: 15; height: 100%; height: 100dvh; padding-bottom: calc(14px + env(safe-area-inset-bottom,0px)); }
      #pn .ehead h2 { margin: 18px 0 10px; font-size: 30px; }
      #pn .ehead .elead { margin-bottom: 18px; }
      #pn .erow { grid-template-columns: 72px minmax(0,1fr); gap: 10px; align-items: start; }
      #pn .erow img, #pn .erow .noimg { width: 72px; height: 54px; }
      #pn .efoot textarea { height: 64px; }
      #pn .viewer button, #pn .viewer a { padding: 8px 0; }
      #pn .gate h1 { font-size: 36px; }
    }
    @media (min-width: 700px) and (hover: none), (min-width: 700px) and (max-width: 1000px) {
      #pn .thumbs { grid-template-columns: repeat(3,minmax(0,1fr)); }
      #pn .ipanel .meta { max-width: 560px; }
    }
    @media (prefers-reduced-motion: reduce) { #pn, #pn * { transition: none !important; } }
  </style>

  <script>
    import { downloadZip } from "client-zip";

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").trim().replace(/\/+$/, "");
    const params = new URLSearchParams(location.search);
    const TOKEN = params.get("c") || "";
    const KEY = "tmke.portal." + TOKEN;
    const MARK = "/email/tmke-mark.png";
    const JACK_EMAIL = "jack@tmke.co.uk";
    const JACK_WA = "https://wa.me/447702559724";
    const ZIP_BLOB_LIMIT = 2 * 1024 * 1024 * 1024;   // past this a browser may not hold it in memory
    const SHARE_LIMIT = 300 * 1024 * 1024;           // what a phone can sensibly save at once

    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const root = $("#pn"), app = $("#pn-app");
    const TOUCH_Q = "(max-width:1000px),(max-height:520px),(hover:none)";
    const TOUCH = () => matchMedia(TOUCH_Q).matches;
    const DL = () => (TOUCH() ? "Save" : "Download");
    const isVideo = (f) => /^video\//.test(f.contentType || "") || /\.(mp4|mov|m4v|webm)$/i.test(f.name);
    const cleanName = (n) => String(n).replace(/^\d{10,}-/, "");
    const isImage = (f) => /^image\/(jpeg|png|webp|gif|avif)/.test(f.contentType || "") || /\.(jpe?g|png|webp|avif|gif)$/i.test(f.name);

    const session = {
      get() { try { const s = JSON.parse(localStorage.getItem(KEY) || "null"); return s && s.expires > Date.now() ? s.session : ""; } catch (_) { return ""; } },
      set(v, expires) { try { localStorage.setItem(KEY, JSON.stringify({ session: v, expires })); } catch (_) {} },
      clear() { try { localStorage.removeItem(KEY); } catch (_) {} },
    };
    async function call(path, opts = {}) {
      const res = await fetch(WORKER + path, { ...opts, headers: { ...(opts.headers || {}), ...(session.get() ? { Authorization: "Bearer " + session.get() } : {}) } });
      const body = await res.json().catch(() => ({}));
      if (res.status === 401 && body.code === "signed_out") { session.clear(); drawGate(); throw new Error("signed out"); }
      if (!res.ok) { const e = new Error(body.code || body.error || String(res.status)); e.body = body; throw e; }
      return body;
    }

    /* ---------- What we hold ---------- */
    let HOME = null;
    const SHOOTS = new Map();   // shoot prefix -> its parts
    const FILES = new Map();    // part prefix -> its files, landscape first
    const S = { view: "home", shoot: null, part: 0, mode: "thumbs", editing: false };
    const SEL = new Map();      // chosen files, across the shoot's folders: edits are one round, sent together
    const NOTES = {};           // what they've typed, kept while they pick files from another folder
    const shootOf = () => HOME.folders.find((f) => f.prefix === S.shoot);
    const partsOf = () => SHOOTS.get(S.shoot) || [];
    const partOf = () => partsOf()[S.part];

    // A folder that isn't tied to a booking keeps the old reading of its name.
    function details(f) {
      if (f.shoot) return { title: f.title || f.name, service: f.service, date: f.date, location: f.location };
      const bits = String(f.name).split(" - ").map((x) => x.trim()).filter(Boolean);
      const at = bits.findIndex((x) => /^\d{4}-\d{2}-\d{2}$/.test(x));
      if (at < 1) return { title: f.name, service: "", date: "", location: "" };
      let date = "";
      try { date = new Date(bits[at] + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "long" }); } catch (_) {}
      return { title: bits[at - 1], service: bits.slice(0, at - 1).join(" - "), date, location: bits.slice(at + 1).join(" - ") };
    }
    const countText = (p) => [p.images ? `${p.images} ${p.images === 1 ? "Image" : "Images"}` : "", p.videos ? `${p.videos} ${p.videos === 1 ? "Video" : "Videos"}` : "", p.others ? `${p.others} ${p.others === 1 ? "File" : "Files"}` : ""].filter(Boolean).join(", ");
    const metaRows = (d) => [d.service ? `<div><b>Service</b>${esc(d.service)}</div>` : "", d.date ? `<div><b>Shoot date</b>${esc(d.date)}</div>` : "", d.location ? `<div><b>Location</b>${esc(d.location)}</div>` : ""].join("");
    const lines = (d) => `<div class="meta">${metaRows(d)}</div>`;
    const ICON_MAIL = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3.5 7l8.5 6 8.5-6"/></svg>';
    const ICON_WA = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20l1.3-4.2A8 8 0 1 1 8.4 19L4 20z"/><path d="M9 8.6c-.5.5-.6 1.300-.2 2.300.7 1.700 2.500 3.400 4.200 4 1 .3 1.700.2 2.200-.3l.5-.7-1.900-1.200-.8.7c-1-.4-1.800-1.200-2.300-2.200l.7-.8-1.200-1.900-.2.100z"/></svg>';
    const barLines = (d, p, f) => `<div class="meta two"><div class="meta">${metaRows(d)}</div><div class="meta crew">${f.shoot ? `<div><b>Videographer/Photographer</b>Jack Bell<div class="jack"><a href="mailto:${JACK_EMAIL}" aria-label="Email Jack" title="Email Jack">${ICON_MAIL}</a><a href="${JACK_WA}" target="_blank" rel="noopener" aria-label="WhatsApp Jack" title="WhatsApp Jack">${ICON_WA}</a></div></div>` : ""}<div><b>Content</b>${esc(countText(p))}</div></div></div>`;

    async function whileLoading(work) {
      const t = setTimeout(() => toast("Loading…", 60000), 250);
      try { return await work; }
      finally { clearTimeout(t); $("#pn-toast").classList.remove("on"); }
    }
    let toastT;
    function toast(t, ms = 2800) { const e = $("#pn-toast"); e.textContent = t; e.classList.add("on"); clearTimeout(toastT); toastT = setTimeout(() => e.classList.remove("on"), ms); }
    function held(on) { document.documentElement.classList.toggle("pn-held", on); }
    function loading(text = "Loading…") { root.classList.remove("dark"); app.innerHTML = `<p class="state">${esc(text)}</p>`; }

    /* ---------- The passcode ---------- */
    function gateMessage(body) {
      const n = Number(body && (body.left ?? body.minutes)) || 0;
      switch (body && body.code) {
        case "wrong": return `That passcode didn't match. You have ${n} ${n === 1 ? "try" : "tries"} left before the portal locks for 15 minutes.`;
        case "locked": return `There have been too many wrong passcodes, so the portal is locked for now. Try again in ${n} ${n === 1 ? "minute" : "minutes"}.`;
        case "closed": return "This link is no longer active. If you still need the content, please get in touch.";
        case "unknown": return "We don't recognise this link. Check you've copied the whole link from your email.";
        default: return "We couldn't connect just now. Please try again.";
      }
    }
    function drawGate(message) {
      held(false); root.classList.remove("dark");
      app.innerHTML = `<form class="gate" id="pn-gate"><div class="inner"><img class="mark" src="${MARK}" alt="TMKE"><h1>Enter Your Passcode.</h1><p>Use the passcode we sent you to see what we've shared. Capitals don't matter.</p>
        <div class="row"><input id="pn-code" type="text" autocomplete="one-time-code" aria-label="Passcode" spellcheck="false"><button type="submit" class="btn" id="pn-go">View content</button></div>
        <p class="err" id="pn-err" role="alert"${message ? "" : " hidden"}>${esc(message || "")}</p></div></form>`;
      setTimeout(() => $("#pn-code")?.focus(), 30);
      $("#pn-gate").addEventListener("submit", async (e) => {
        e.preventDefault();
        const code = $("#pn-code").value.trim();
        if (!code) return;
        $("#pn-go").disabled = true; $("#pn-err").hidden = true;
        try {
          const res = await fetch(WORKER + "/portal/open", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token: TOKEN, passcode: code }) });
          const body = await res.json().catch(() => ({}));
          if (!res.ok || !body.session) {
            $("#pn-err").textContent = gateMessage(body); $("#pn-err").hidden = false;
            if (body.code === "closed" || body.code === "unknown") $("#pn-code").disabled = true;
            return;
          }
          session.set(body.session, body.expires);
          HOME = body;
          route();
        } catch (_) { $("#pn-err").textContent = gateMessage(null); $("#pn-err").hidden = false; }
        finally { const g = $("#pn-go"); if (g) g.disabled = false; }
      });
    }

    /* ---------- The walls ---------- */
    const fills = (n, cols) => { const want = Math.max(4, n + n % 2) - n; return Array.from({ length: want }, (_, i) => `<div class="fill" style="background:${cols[i % cols.length]}" aria-hidden="true"></div>`); };
    const wallOf = (tiles, cols) => { const b = fills(tiles.length, cols); return (tiles.length === 2 ? [tiles[0], b[0], b[1], tiles[1]] : [...tiles, ...b]).join(""); };
    const tileHtml = (i, title, sub, img, play) => `<button class="tile" data-t="${i}" aria-label="Open ${esc(title)}">${img ? `<img src="${esc(img)}" alt="" loading="lazy">` : `<span class="noimg"></span>`}${play ? '<span class="play"></span>' : ""}<i>${String(i + 1).padStart(2, "0")}</i><span class="tcap"><span class="tn"><b>${esc(title)}</b><u>${esc(sub)}</u></span></span></button>`;
    function wireWall(items, rest, open, restTitle) {
      const wall = $(".wall"), big = $("#big"), info = $("#info");
      const on = (i) => { if (TOUCH()) return; wall.classList.add("hov"); $$(".tile").forEach((t) => t.classList.toggle("on", +t.dataset.t === i)); $$(".list [data-t]").forEach((t) => t.classList.toggle("on", +t.dataset.t === i)); big.textContent = items[i].t; big.classList.add("on"); info.innerHTML = items[i].h; };
      const off = () => { wall.classList.remove("hov"); $$(".on", wall).forEach((t) => { if (t !== big) t.classList.remove("on"); }); if (restTitle) big.textContent = restTitle; else big.classList.remove("on"); info.innerHTML = rest; };
      $$("[data-t]").forEach((el) => { const i = +el.dataset.t; el.addEventListener("mouseenter", () => on(i)); el.addEventListener("mouseleave", off); el.addEventListener("focus", () => on(i)); el.addEventListener("blur", off); el.addEventListener("click", () => open(i, $(`.tile[data-t="${i}"]`))); });
    }
    function openInfo(title, html) {
      $(".ipanel")?.remove();
      const p = document.createElement("div"); p.className = "ipanel"; p.setAttribute("role", "dialog"); p.setAttribute("aria-label", "Shoot details");
      p.innerHTML = `<div class="ih"><h2>${esc(title)}</h2><button class="cap" id="ix">Close</button></div>${html}`;
      root.appendChild(p); $("#ix").onclick = () => p.remove();
    }

    function drawHome() {
      held(true); root.classList.remove("dark"); SEL.clear();
      const list = HOME.folders || [];
      if (!list.length) { app.innerHTML = `<div class="wall"><div class="c1"><img class="mark" src="${MARK}" alt="TMKE"></div><div class="c2"><p class="state" style="padding:0">Nothing has been shared with you yet. When we share something, it'll appear here.</p></div></div>`; return; }
      const rows = list.map((f) => ({ f, d: details(f) }));
      const rest = `<b>${esc(HOME.name || "Your content")}</b>${list.length} ${list.length === 1 ? "shoot" : "shoots"} shared with you.`;
      app.innerHTML = `<div class="wall"><div class="c1"><img class="mark" src="${MARK}" alt="TMKE"><h1 class="big" id="big"></h1><div class="info" id="info">${rest}</div></div>
        <div class="c2"><div class="list"><div class="cap lab">All work</div>${rows.map((r, i) => `<button class="cap" data-t="${i}">${esc(r.d.title)}</button>`).join("")}</div><div class="cap bottom">Shoots (${list.length})</div></div>
        <div class="tiles" data-lenis-prevent>${wallOf(rows.map((r, i) => tileHtml(i, r.d.title, String(i + 1).padStart(2, "0"), r.f.cover, false)), ["var(--wine)", "var(--stone)", "var(--taupe)"])}</div>
        <div class="c4"><div class="note">Client portal</div><button class="cap back" id="out">Sign out</button></div></div>`;
      wireWall(rows.map((r) => ({ t: r.d.title, h: lines(r.d) })), rest, (i, el) => openShoot(rows[i].f.prefix, el));
      $("#out").onclick = () => { session.clear(); HOME = null; SHOOTS.clear(); FILES.clear(); history.replaceState(null, "", "?c=" + encodeURIComponent(TOKEN)); drawGate(); };
      // No cover chosen: the newest picture in the shoot's folders. Fetched as it's needed, not all at once.
      const missing = rows.map((r, i) => ({ r, i })).filter((x) => !x.r.f.cover);
      if (missing.length) {
        const see = new IntersectionObserver((hits) => hits.forEach(async (h) => {
          if (!h.isIntersecting) return; see.unobserve(h.target);
          const r = rows[+h.target.dataset.t];
          try { const parts = await loadShoot(r.f.prefix); const c = parts.find((p) => p.coverUrl); if (c && h.target.isConnected) { r.f.cover = c.coverUrl; const hole = $(".noimg", h.target); if (hole) hole.outerHTML = `<img src="${esc(c.coverUrl)}" alt="">`; } } catch (_) {}
        }));
        missing.forEach((x) => { const el = $(`.tile[data-t="${x.i}"]`); if (el) see.observe(el); });
      }
    }
    async function loadShoot(prefix) {
      if (SHOOTS.has(prefix)) return SHOOTS.get(prefix);
      const d = await call(`/portal/shoot?prefix=${encodeURIComponent(prefix)}`);
      SHOOTS.set(prefix, d.parts || []);
      return d.parts || [];
    }
    async function openShoot(prefix, el) {
      let parts;
      try { parts = await whileLoading(loadShoot(prefix)); } catch (e) { if (e.message !== "signed out") toast("We couldn't open that just now. Please try again."); return; }
      if (!parts.length) { toast("There's nothing in this folder yet."); return; }
      S.shoot = prefix; S.part = 0; S.editing = false; S.mode = "thumbs";
      if (parts.length <= 1) { await openPart(0, el); return; }   // nothing to choose between: straight to the photos
      push(prefix); go("shoot", el);
    }
    function drawShoot() {
      held(true); root.classList.add("dark");
      const f = shootOf(), d = details(f), parts = partsOf();
      const rest = lines(d);
      app.innerHTML = `<div class="wall"><div class="c1"><img class="mark" src="${MARK}" alt="TMKE"><h1 class="big on" id="big">${esc(d.title)}</h1><div class="info" id="info">${rest}</div></div>
        <div class="c2"><div class="list"><div class="cap lab">${esc(d.title)}<button class="lx" id="bx" aria-label="Back to all work">&times;</button></div>${parts.map((p, i) => `<button class="cap" data-t="${i}">${esc(p.name)}</button>`).join("")}</div><div class="cap bottom"><span>Folders (${parts.length})</span><button class="cap infobtn" id="sinfo">Info</button></div></div>
        <div class="tiles" data-lenis-prevent>${wallOf(parts.map((p, i) => tileHtml(i, p.name, countText(p), p.coverUrl, !p.images && p.videos)), ["var(--taupe)", "var(--linen)", "var(--stone)"])}</div>
        <div class="c4"><div class="note">Client portal</div><button class="cap back" id="b">Back</button></div></div>`;
      wireWall(parts.map((p) => ({ t: d.title, h: `<div class="meta"><div><b>Folder</b>${esc(p.name)}</div><div><b>Content</b>${esc(countText(p))}</div></div>` })), rest, (i, el) => openPart(i, el), d.title);
      const toHome = () => { push(""); go("home"); };
      $("#b").onclick = toHome; $("#bx").onclick = toHome;
      $("#sinfo").onclick = () => openInfo(d.title, lines(d));
    }

    /* ---------- One folder ---------- */
    // Landscape first, then portrait. Each file's shape comes from its small picture.
    function shapeOf(f) {
      return new Promise((res) => {
        const src = f.thumbUrl || (isImage(f) ? f.url : "");
        if (!src) { res("l"); return; }
        const i = new Image(); let settled = false;
        const end = (v) => { if (!settled) { settled = true; res(v); } };
        i.onload = () => end(i.naturalHeight > i.naturalWidth ? "p" : "l");
        i.onerror = () => end("l");
        setTimeout(() => end("l"), 6000);
        i.src = src;
      });
    }
    async function loadPart(p) {
      if (FILES.has(p.prefix)) return FILES.get(p.prefix);
      const d = await call(`/portal/list?prefix=${encodeURIComponent(p.prefix)}`);
      const files = d.files || [];
      await Promise.all(files.map(async (f) => { f.shape = await shapeOf(f); f.part = p; f.id = p.prefix + f.name; }));
      const sorted = [...files.filter((f) => f.shape === "l"), ...files.filter((f) => f.shape === "p")];
      FILES.set(p.prefix, sorted);
      return sorted;
    }
    async function openPart(i, el) {
      S.part = i; S.editing = false;
      const p = partOf();
      if (!p) { loading("There's nothing in this folder yet."); return; }
      try { await whileLoading(loadPart(p)); } catch (e) { if (e.message !== "signed out") toast("We couldn't open that folder just now. Please try again."); return; }
      push(S.shoot, p.prefix);
      go("folder", el);
    }
    const media = (f, cls) => (f.thumbUrl || isImage(f)) ? `<img src="${esc(f.thumbUrl || f.url)}" alt="" loading="lazy"${cls ? ` class="${cls}"` : ""}>` : isVideo(f) ? `<video src="${esc(f.url)}#t=1" preload="metadata" muted playsinline></video>` : `<span class="ext">${esc((f.name.split(".").pop() || "File").slice(0, 5))}</span>`;
    function rollHtml(files) {
      const pic = (f) => isImage(f) ? `<img src="${esc(f.url)}" alt="" loading="lazy">` : f.thumbUrl ? `<img src="${esc(f.thumbUrl)}" alt="" loading="lazy">` : `<video src="${esc(f.url)}#t=1" preload="metadata" muted playsinline></video>`;
      const shot = (f) => `<div class="shot" data-v="${esc(f.id)}" role="button" tabindex="0" aria-label="View ${esc(cleanName(f.name))}">${pic(f)}${isVideo(f) ? '<span class="play"></span>' : ""}<a class="dl" href="${esc(f.downloadUrl)}" data-one="${esc(f.id)}">${DL()}</a></div>`;
      const land = files.filter((f) => (isImage(f) || isVideo(f)) && f.shape === "l"), port = files.filter((f) => (isImage(f) || isVideo(f)) && f.shape === "p");
      let out = land.map(shot).join("");
      for (let i = 0; i < port.length; i += 3) out += `<div class="prow">${port.slice(i, i + 3).map(shot).join("")}</div>`;
      return `<div class="roll">${out}</div>`;
    }
    function thumbsHtml(files) {
      return `<div class="thumbs">${files.map((f) => { const on = SEL.has(f.id); return `<div class="thumb${on ? " sel" : ""}" data-v="${esc(f.id)}" tabindex="0">${media(f)}${isVideo(f) ? '<span class="play"></span>' : ""}<button class="tick${on ? " on" : ""}" data-k="${esc(f.id)}" role="checkbox" aria-checked="${on}" aria-label="Select ${esc(f.name)}"></button><a class="dl" href="${esc(f.downloadUrl)}" data-one="${esc(f.id)}">${DL()}</a></div>`; }).join("")}</div>`;
    }
    function acts(files) {
      const n = SEL.size, gallery = S.mode === "thumbs", f = shootOf();
      const send = f.editsToken ? `<button class="btn" id="edits">${n ? `Request edits (${n})` : "Request edits"}</button>` : "";
      return `${gallery ? `<div class="selline"><span>${n ? `${n} selected` : "Tick the boxes to choose files"}</span><span>${n ? '<button id="clr">Clear</button>' : ""}<button id="selall">Select all</button></span></div>` : ""}<div class="acts${send ? "" : " one"}"><button class="btn pri" id="all">${n ? `${DL()} selected (${n})` : `${DL()} this folder`}</button>${send}</div>`;
    }
    function wireActs(files) {
      const w = $("#actsbox"); if (!w) return;
      w.innerHTML = acts(files);
      $("#all").onclick = (e) => saveFiles(SEL.size ? [...SEL.values()] : files, e.currentTarget);
      const ed = $("#edits"); if (ed) ed.onclick = () => { S.editing = true; drawEdits(); };
      const sa = $("#selall"); if (sa) sa.onclick = () => { files.forEach((f) => SEL.set(f.id, f)); drawFolder(); };
      const c = $("#clr"); if (c) c.onclick = () => { SEL.clear(); drawFolder(); };
    }
    function drawFolder() {
      held(true); root.classList.add("dark");
      const f = shootOf(), d = details(f), parts = partsOf(), p = partOf(), files = FILES.get(p.prefix) || [];
      app.innerHTML = `<div class="folder"><div class="main${S.mode === "portfolio" ? " pf" : ""}" id="main" data-lenis-prevent>${S.mode === "portfolio" ? rollHtml(files) : thumbsHtml(files)}</div>
        <aside class="side"><div class="stop"><img class="mark smark" src="${MARK}" alt="TMKE"><button class="cap back" id="b">Back</button><div class="toggle" role="group" aria-label="View"><button id="vt" aria-pressed="${S.mode === "thumbs"}">Gallery</button><button id="vp" aria-pressed="${S.mode === "portfolio"}">Portfolio</button></div></div>
        <div class="low"><div><h2>${esc(d.title)}</h2><button class="cap infobtn" id="finfo">Info</button>${parts.length > 1 ? `<div class="flist">${parts.map((x, i) => `<button class="cap${i === S.part ? " on" : ""}" data-f="${i}">${esc(x.name)}</button>`).join("")}</div>` : ""}</div>
        ${barLines(d, p, f)}
        <div id="actsbox"></div></div></aside></div>`;
      $("#b").onclick = () => { if (parts.length > 1) { push(S.shoot); go("shoot"); } else { push(""); go("home"); } };
      $("#vp").onclick = () => { S.mode = "portfolio"; drawFolder(); };
      $("#vt").onclick = () => { S.mode = "thumbs"; drawFolder(); };
      $$("[data-f]").forEach((b) => (b.onclick = async () => { const i = +b.dataset.f; S.part = i; try { await whileLoading(loadPart(partOf())); } catch (_) { toast("We couldn't open that folder just now."); return; } push(S.shoot, partOf().prefix); drawFolder(); }));
      wireActs(files);
      $("#finfo").onclick = () => openInfo(d.title, barLines(d, p, f));
      const byId = (id) => files.find((x) => x.id === id);
      $$(".tick").forEach((t) => t.addEventListener("click", (e) => { e.stopPropagation(); const fl = byId(t.dataset.k), on = !SEL.has(fl.id); if (on) SEL.set(fl.id, fl); else SEL.delete(fl.id); t.classList.toggle("on", on); t.setAttribute("aria-checked", on); t.parentElement.classList.toggle("sel", on); wireActs(files); }));
      $$("[data-one]").forEach((a) => a.addEventListener("click", (e) => { e.stopPropagation(); if (!TOUCH()) return; e.preventDefault(); saveFiles([byId(a.dataset.one)], null); }));
      $$("[data-v]").forEach((b) => {
        const open = () => { const fl = byId(b.dataset.v); if (isImage(fl) || isVideo(fl)) view(files.filter((x) => isImage(x) || isVideo(x)), fl); else location.href = fl.downloadUrl; };
        b.addEventListener("click", open);
        b.addEventListener("keydown", (e) => { if ((e.key === "Enter" || e.key === " ") && e.target === b) { e.preventDefault(); open(); } });
      });
      if (S.editing) drawEdits();
    }

    /* ---------- Saving: a zip on a computer, to Photos on a phone ---------- */
    function linkOut(url) { const a = document.createElement("a"); a.href = url; a.rel = "noopener"; a.style.display = "none"; document.body.appendChild(a); a.click(); a.remove(); }
    async function saveFiles(files, btn) {
      if (!files.length) return;
      const was = btn && btn.textContent;
      const busy = (t) => { if (btn) { btn.disabled = true; btn.textContent = t; } };
      const idle = () => { if (btn) { btn.disabled = false; btn.textContent = was; } };
      const total = files.reduce((t, f) => t + (f.size || 0), 0);
      try {
        if (TOUCH() && navigator.canShare && total <= SHARE_LIMIT) {
          busy("Preparing…");
          const ready = [];
          for (const f of files) { const b = await (await fetch(f.url)).blob(); ready.push(new File([b], cleanName(f.name), { type: b.type || f.contentType || "application/octet-stream" })); }
          idle();
          if (navigator.canShare({ files: ready })) { offerShare(ready); return; }
        }
        if (files.length === 1) { linkOut(files[0].downloadUrl); return; }
        busy("Preparing your zip…");
        await zipFiles(files, total);
      } catch (err) {
        if (err && err.name === "AbortError") return;
        toast("We couldn't prepare that just now. Please try again.");
      } finally { idle(); }
    }
    // A phone only lets a page open its Save sheet straight from a tap, so once the
    // files are fetched there's one more button to press.
    function offerShare(ready) {
      $(".ipanel")?.remove();
      const p = document.createElement("div"); p.className = "ipanel"; p.setAttribute("role", "dialog"); p.setAttribute("aria-label", "Save your files");
      const n = ready.length;
      p.innerHTML = `<div class="ih"><h2>${n} ${n === 1 ? "File" : "Files"} Ready.</h2><button class="cap" id="ix">Close</button></div><div class="acts one"><button class="btn pri" id="ishare" style="background:var(--linen);color:var(--wine);border-color:var(--linen)">Save to my phone</button></div>`;
      root.appendChild(p);
      $("#ix").onclick = () => p.remove();
      $("#ishare").onclick = async () => { try { await navigator.share({ files: ready }); p.remove(); } catch (e) { if (e.name !== "AbortError") toast("We couldn't open Save on this phone. Please try again."); } };
    }
    async function zipFiles(files, total) {
      const seen = new Set();
      const named = files.map((f) => { let name = cleanName(f.name); const folder = f.part && f.part.name; if (folder && folder !== "All files") name = folder + "/" + name; while (seen.has(name)) name = name.replace(/(\.[^.]*)?$/, " copy$1"); seen.add(name); return { f, name }; });
      async function* entries() { for (const { f, name } of named) { const res = await fetch(f.url); if (!res.ok) throw new Error("file"); yield { name, input: res, lastModified: f.uploaded ? new Date(f.uploaded) : undefined }; } }
      const title = details(shootOf()).title.replace(/[\\/:*?"<>|]+/g, " ").trim() || "TMKE";
      const res = downloadZip(entries());
      if (window.showSaveFilePicker && total > 200 * 1024 * 1024) {
        const handle = await window.showSaveFilePicker({ suggestedName: title + ".zip", types: [{ description: "Zip file", accept: { "application/zip": [".zip"] } }] });
        await res.body.pipeTo(await handle.createWritable());
        toast("Your zip has been saved.");
        return;
      }
      if (total > ZIP_BLOB_LIMIT) {
        toast("That's too big to zip in this browser, so each file will download on its own. Your browser may ask to allow several.", 6000);
        for (const f of files) { linkOut(f.downloadUrl); await new Promise((r) => setTimeout(r, 900)); }
        return;
      }
      const url = URL.createObjectURL(await res.blob());
      const a = document.createElement("a"); a.href = url; a.download = title + ".zip"; document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 60000);
    }

    /* ---------- Request edits ---------- */
    let EDIT_CTX = null;
    async function drawEdits() {
      const f = shootOf(), side = $(".side"), picked = [...SEL.values()];
      if (!EDIT_CTX || EDIT_CTX.token !== f.editsToken) {
        try { EDIT_CTX = { token: f.editsToken, ...(await (await fetch(`${WORKER}/videography/edit-request/context?token=${encodeURIComponent(f.editsToken)}`)).json()) }; }
        catch (_) { EDIT_CTX = { token: f.editsToken, upsell: null }; }
      }
      const gbp = (p) => "£" + (p / 100).toLocaleString("en-GB", { minimumFractionDigits: p % 100 ? 2 : 0 });
      const twilight = EDIT_CTX.upsell === "twilight" && EDIT_CTX.twilight_price_pence, bundle = EDIT_CTX.upsell === "extra_images" && EDIT_CTX.extra_images;
      const until = f.editsUntil ? `, open until ${esc(f.editsUntil)}` : "";
      side.classList.add("editing");
      side.innerHTML = `<div><button class="cap back" id="eb">Add more files</button></div>
        <div class="ehead"><h2>Request Edits.</h2><p class="elead">Your package includes one round of edits${until}. Add files from any folder in this shoot, then send them all at once.</p></div>
        <div class="elist" data-lenis-prevent>${picked.length ? picked.map((x) => `<div class="erow">${x.thumbUrl || isImage(x) ? `<img src="${esc(x.thumbUrl || x.url)}" alt="">` : `<span class="noimg"></span>`}<span><b>${esc(x.part.name)}</b><input type="text" data-note="${esc(x.id)}" aria-label="What would you like changed?" placeholder="What would you like changed?" value="${esc(NOTES[x.id] || "")}">${twilight && isImage(x) ? `<label class="tw"><input type="checkbox" data-tw="${esc(x.id)}"${NOTES["tw" + x.id] ? " checked" : ""}> Add faux twilight, ${gbp(EDIT_CTX.twilight_price_pence)} +VAT</label>` : ""}</span></div>`).join("") : `<p class="elead">No files selected yet. Press Add more files and tick the ones you'd like changed, or describe it below.</p>`}</div>
        <div class="efoot">${bundle ? `<label class="tw bundle"><input type="checkbox" id="ebundle"${NOTES.bundle ? " checked" : ""}> Add another ${bundle.qty} photos to your selection, ${gbp(bundle.price_pence)} +VAT</label>` : ""}<label class="ecap" for="enote">Anything else</label><textarea id="enote" rows="3" placeholder="Anything that applies to the whole shoot">${esc(NOTES.all || "")}</textarea><p class="eerr" id="eerr" role="alert" hidden></p><button class="btn pri" id="esend">Send my edit requests</button></div>`;
      $("#eb").onclick = () => { S.editing = false; S.mode = "thumbs"; drawFolder(); };
      $$("[data-note]").forEach((i) => i.addEventListener("input", () => { NOTES[i.dataset.note] = i.value; }));
      $$("[data-tw]").forEach((i) => i.addEventListener("change", () => { NOTES["tw" + i.dataset.tw] = i.checked; }));
      $("#enote").addEventListener("input", (e) => { NOTES.all = e.target.value; });
      const eb2 = $("#ebundle"); if (eb2) eb2.addEventListener("change", () => { NOTES.bundle = eb2.checked; });
      $("#esend").onclick = async (e) => {
        const btn = e.currentTarget, err = $("#eerr");
        const lines = picked.filter((x) => (NOTES[x.id] || "").trim()).map((x) => `${x.part.name} / ${cleanName(x.name)}: ${NOTES[x.id].trim()}`);
        const named = picked.filter((x) => !(NOTES[x.id] || "").trim() && !NOTES["tw" + x.id]).map((x) => `${x.part.name} / ${cleanName(x.name)}`);
        if (named.length) lines.push(`Also selected, with no comment: ${named.join(", ")}`);
        if ((NOTES.all || "").trim()) lines.push(`Anything else: ${NOTES.all.trim()}`);
        btn.disabled = true; err.hidden = true;
        try {
          const res = await fetch(`${WORKER}/videography/edit-request`, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ token: f.editsToken, notes: lines.join("\n"), twilight_filenames: picked.filter((x) => NOTES["tw" + x.id]).map((x) => `${x.part.name} / ${cleanName(x.name)}`), extra_images: !!NOTES.bundle }) });
          const out = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(out.error || "");
          if (out.checkout_url) { location.href = out.checkout_url; return; }
          Object.keys(NOTES).forEach((k) => delete NOTES[k]); SEL.clear(); S.editing = false;
          drawFolder(); toast("Sent. Jack has your edit requests.", 5000);
        } catch (x) { btn.disabled = false; err.textContent = x.message || "We couldn't send that just now. Please try again."; err.hidden = false; }
      };
    }

    /* ---------- The viewer ---------- */
    function view(list, f) {
      $(".viewer")?.remove();
      const i = list.indexOf(f), v = document.createElement("div");
      v.className = "viewer"; v.setAttribute("role", "dialog"); v.setAttribute("aria-label", "Viewing a file");
      v.innerHTML = `${isVideo(f) ? `<video controls autoplay playsinline src="${esc(f.url)}"></video>` : `<img src="${esc(f.url)}" alt="">`}<div class="vbar"><span>${i + 1} of ${list.length}</span><div>${list.length > 1 ? '<button id="vprev">Previous</button><button id="vnext">Next</button>' : ""}<a href="${esc(f.downloadUrl)}" id="vdl">${DL()}</a><button id="vx">Close</button></div></div>`;
      root.appendChild(v);
      const step = (d) => view(list, list[(i + d + list.length) % list.length]);
      const pv = $("#vprev"), nx = $("#vnext");
      if (pv) pv.onclick = () => step(-1);
      if (nx) nx.onclick = () => step(1);
      $("#vx").onclick = () => v.remove();
      $("#vdl").onclick = (e) => { if (TOUCH()) { e.preventDefault(); saveFiles([f], null); } };
    }

    /* ---------- Moving between pages ---------- */
    const DRAW = { home: drawHome, shoot: drawShoot, folder: drawFolder };
    const ORDER = ["home", "shoot", "folder"];
    function slide(to, reduce) {
      const back = ORDER.indexOf(to) < ORDER.indexOf(S.view), old = app.firstElementChild, wasDark = root.classList.contains("dark");
      const snap = document.createElement("div"); snap.className = "snap " + (wasDark ? "snapdark" : "snaplight"); snap.style.top = (-scrollY) + "px";
      if (old) snap.appendChild(old.cloneNode(true));
      S.view = to; DRAW[to](); scrollTo(0, 0);
      if (reduce || !old) return;
      root.appendChild(snap);
      const opts = { duration: 620, easing: "cubic-bezier(.22,.8,.2,1)", fill: "both" };
      let a;
      if (back) { snap.style.zIndex = 8; a = snap.animate([{ transform: "translateY(0)" }, { transform: "translateY(100vh)" }], opts); app.animate([{ transform: "translateY(-18vh)" }, { transform: "translateY(0)" }], opts); }
      else { snap.style.zIndex = 4; app.style.position = "relative"; app.style.zIndex = 6; a = app.animate([{ transform: "translateY(100vh)" }, { transform: "translateY(0)" }], opts); snap.animate([{ transform: "translateY(0)" }, { transform: "translateY(-18vh)" }], opts); }
      let ended = false;
      const done = () => { if (ended) return; ended = true; snap.remove(); app.getAnimations().forEach((x) => x.cancel()); app.style.position = ""; app.style.zIndex = ""; };
      a.onfinish = done; setTimeout(done, 900);
    }
    function go(to, fromEl) {
      const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches, img = fromEl && $("img", fromEl);
      if (TOUCH()) { slide(to, reduce); return; }
      if (!img || reduce) { S.view = to; DRAW[to](); scrollTo(0, 0); return; }
      const a = img.getBoundingClientRect(), c = document.createElement("img");
      c.src = img.src; c.className = "fly"; Object.assign(c.style, { left: a.left + "px", top: a.top + "px", width: a.width + "px", height: a.height + "px" });
      root.appendChild(c);
      S.view = to; DRAW[to]();
      const t = $(to === "folder" ? ".main img" : ".tile img");
      if (!t) { c.remove(); return; }
      t.style.visibility = "hidden";
      const finish = () => { t.style.visibility = ""; c.remove(); };
      const fin = () => { const b = t.getBoundingClientRect(); const an = c.animate([{ left: a.left + "px", top: a.top + "px", width: a.width + "px", height: a.height + "px" }, { left: b.left + "px", top: b.top + "px", width: b.width + "px", height: b.height + "px" }], { duration: 680, easing: "cubic-bezier(.22,.8,.2,1)", fill: "forwards" }); an.onfinish = finish; setTimeout(finish, 1000); };
      if (t.complete) fin(); else { t.addEventListener("load", fin, { once: true }); setTimeout(finish, 2500); }
      $$(to === "folder" ? ".side" : ".c1 .big,.c1 .info,.list,.bottom,.c4,.tile:not(:first-child)").forEach((o) => o.animate([{ opacity: 0 }, { opacity: 0, offset: .45 }, { opacity: 1 }], { duration: 720 }));
    }

    /* ---------- Where we are: ?c=…&f=…&p=… so the browser's Back works ---------- */
    function push(f, p) {
      const q = "?c=" + encodeURIComponent(TOKEN) + (f ? "&f=" + encodeURIComponent(f) : "") + (p ? "&p=" + encodeURIComponent(p) : "");
      history.pushState(null, "", q);
    }
    async function route() {
      if (!session.get()) { drawGate(); return; }
      if (!HOME) {
        loading();
        try { HOME = await call("/portal/home"); }
        catch (err) { if (err.message !== "signed out") loading("We couldn't connect just now. Please try again."); return; }
      }
      const q = new URLSearchParams(location.search), f = q.get("f"), p = q.get("p");
      $(".viewer")?.remove(); $(".ipanel")?.remove();
      const shoot = f && (HOME.folders || []).find((x) => f === x.prefix || f.startsWith(x.prefix));
      if (!shoot) { S.view = "home"; drawHome(); return; }
      try {
        const parts = await loadShoot(shoot.prefix);
        if (!parts.length) { S.view = "home"; drawHome(); toast("There's nothing in this folder yet."); return; }
        S.shoot = shoot.prefix;
        const at = p ? parts.findIndex((x) => x.prefix === p) : parts.length <= 1 ? 0 : -1;
        if (at >= 0 && parts[at]) { S.part = at; await loadPart(parts[at]); S.view = "folder"; drawFolder(); }
        else { S.view = "shoot"; drawShoot(); }
      } catch (err) { if (err.message !== "signed out") { S.view = "home"; drawHome(); toast("We couldn't open that just now. Please try again."); } }
    }
    addEventListener("popstate", route);
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const v = $(".viewer"), i = $(".ipanel");
      if (v) v.remove(); if (i) i.remove();
    });
    addEventListener("scroll", () => { const b = $("#finfo"), h = $(".side h2"); if (b && h) b.classList.toggle("float", h.getBoundingClientRect().bottom < 0); }, { passive: true });

    if (!TOKEN) loading("We don't recognise this link. Check you've copied the whole link from your email.");
    else if (!WORKER) loading("We couldn't connect just now. Please try again.");
    else route();
  </script>
</BaseLayout>
