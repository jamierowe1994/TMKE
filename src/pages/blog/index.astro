---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../data/blog.js";

// Pulled from Supabase if configured, otherwise from the static fallback.
const allPosts = await getPublishedPosts();
const posts = [...allPosts]
  .sort((a, b) => (a.date < b.date ? 1 : -1))
  .slice(0, 16);

// A deliberately jumbled size/position sequence so the grid reads scattered, not
// choreographed — no obvious repeating rhythm across the posts, and big/small
// tiles interleaved rather than sorted top-to-bottom. Length is coprime-ish to
// the post count so it doesn't visibly loop.
const SCATTER = [3, 7, 0, 9, 4, 1, 10, 6, 2, 8, 5, 0, 7, 9, 1, 4, 6, 2];

function fmtDate(iso) {
  if (!iso) return "";
  const d = new Date(iso);
  if (isNaN(d)) return "";
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}

// Lightweight data for the reader (bodies are embedded as <template>s below so
// the post opens IN A FRAME — no navigation away from the grid).
const lite = posts.map((p) => ({
  slug: p.slug,
  title: p.title,
  eyebrow: p.eyebrow || p.category || "",
  date: fmtDate(p.date),
  readTime: p.readTime || null,
  hero: p.hero,
}));
---

<BaseLayout
  title="Insights — TMKE"
  description="Structured insights on social media, brand positioning, content systems, and the future of estate agency marketing — written for UK property professionals."
  hideFooter
>
  <div class="flow-grain" aria-hidden="true"></div>

  <section class="flow-page">
    <header class="flow-head">
      <span class="flow-eyebrow">Insights</span>
      <span class="flow-eyebrow flow-eyebrow--muted">Notes from the desk</span>
    </header>

    <!-- Scattered FLOW grid — image + title only. Hover fades the rest;
         clicking flies the image to the centre and opens the reader. -->
    <div class="flow" id="flow">
      {posts.map((p, i) => (
        <button class="flow-item" type="button" data-slug={p.slug} data-variant={SCATTER[i % SCATTER.length]}>
          <span class="flow-media">
            <img src={p.hero} alt={p.title} loading={i < 6 ? "eager" : "lazy"} />
          </span>
          <span class="flow-cap">
            <span class="flow-title">{p.title}</span>
            {p.readTime ? <span class="flow-count">[ {p.readTime} ]</span> : null}
          </span>
        </button>
      ))}
    </div>
  </section>

  <!-- Reader — opens in-frame over the grid. -->
  <div class="reader" id="reader" hidden>
    <button class="reader-x" id="reader-x" type="button" aria-label="Close">&times;</button>
    <div class="reader-frame" role="dialog" aria-modal="true" aria-labelledby="reader-title">
      <div class="reader-hero" id="reader-hero">
        <img id="reader-hero-img" src="" alt="" />
      </div>
      <div class="reader-col">
        <div class="reader-meta" id="reader-meta"></div>
        <h2 class="reader-title" id="reader-title"></h2>
        <div class="reader-content" id="reader-content"></div>
      </div>
    </div>
  </div>

  <!-- Flying clone used for the grid → centre transition. -->
  <img class="flow-fly" id="flow-fly" alt="" aria-hidden="true" />

  <!-- Embedded post bodies (cloned into the reader on open). -->
  {posts.map((p) => (
    <template data-post={p.slug} set:html={p.body}></template>
  ))}

  <script type="application/json" id="flow-data" set:html={JSON.stringify(lite)}></script>

  <style>
    /* Insights — FLOW scattered grid + in-frame reader. */
    /* ============== PAGE ============== */
    .flow-grain {
      position: fixed; inset: 0; z-index: 60; pointer-events: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23g)'/></svg>");
      background-size: 240px 240px; opacity: 0.1; mix-blend-mode: overlay;
    }
    .flow-page {
      max-width: 1680px; margin: 0 auto;
      padding: clamp(96px, 11vh, 132px) clamp(20px, 4vw, 72px) clamp(80px, 10vh, 140px);
    }
    .flow-head {
      display: flex; align-items: center; gap: 18px;
      margin-bottom: clamp(34px, 5vh, 64px);
    }
    .flow-eyebrow {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.24em; text-transform: uppercase; color: var(--english-violet);
      display: inline-flex; align-items: center; gap: 14px;
    }
    .flow-eyebrow::before {
      content: ""; width: 42px; height: 1px; background: currentColor; opacity: 0.4;
    }
    .flow-eyebrow--muted { color: rgba(28, 29, 34, 0.4); }

    /* ============== FLOW GRID (column masonry → scattered) ============== */
    .flow {
      column-count: 5;
      column-gap: clamp(34px, 3.6vw, 78px);
      transition: opacity 0.6s ease, transform 0.6s cubic-bezier(.2,.7,.2,1), filter 0.6s ease;
    }
    @media (max-width: 1320px) { .flow { column-count: 4; } }
    @media (max-width: 1000px) { .flow { column-count: 3; } }
    @media (max-width: 680px)  { .flow { column-count: 2; } }
    @media (max-width: 440px)  { .flow { column-count: 1; } }

    /* Reader open → grid stays lightly visible behind (single-page feel). */
    .flow.is-away {
      opacity: 0.4; transform: scale(0.99); filter: blur(2.5px);
      pointer-events: none;
    }

    .flow-item {
      -webkit-appearance: none; appearance: none; border: 0; background: none;
      padding: 0; margin: 0 0 clamp(56px, 6vw, 124px); width: 100%;
      display: block; text-align: left; cursor: pointer;
      break-inside: avoid; color: var(--ink);
      transition: opacity 0.4s ease;
    }
    /* Hover any tile → fade the others out. */
    .flow:hover .flow-item { opacity: 0.28; }
    .flow:hover .flow-item:hover { opacity: 1; }

    /* Size + position variety → the semi-random scatter. Horizontal padding
       shrinks the tile within its column (smaller images, big range) and offsets
       it left/right; aspect-ratio varies the height; and the top/bottom margins
       vary independently so tiles sit closer or further apart unevenly — not on
       a tidy rhythm. */
    .flow-item[data-variant="0"] .flow-media { aspect-ratio: 3 / 4; }
    .flow-item[data-variant="0"] { margin-bottom: clamp(70px, 8vw, 150px); }

    .flow-item[data-variant="1"] { padding-right: 38%; margin-top: clamp(54px, 6.5vw, 118px); margin-bottom: clamp(34px, 3.8vw, 70px); }
    .flow-item[data-variant="1"] .flow-media { aspect-ratio: 1 / 1; }

    .flow-item[data-variant="2"] { padding-left: 20%; margin-top: clamp(10px, 1.4vw, 26px); margin-bottom: clamp(56px, 6vw, 120px); }
    .flow-item[data-variant="2"] .flow-media { aspect-ratio: 4 / 5; }

    .flow-item[data-variant="3"] { margin-top: clamp(84px, 10vw, 172px); margin-bottom: clamp(44px, 5vw, 90px); }
    .flow-item[data-variant="3"] .flow-media { aspect-ratio: 2 / 3; }

    .flow-item[data-variant="4"] { padding-right: 13%; margin-top: clamp(22px, 2.8vw, 52px); margin-bottom: clamp(76px, 8.6vw, 158px); }
    .flow-item[data-variant="4"] .flow-media { aspect-ratio: 4 / 3; }

    .flow-item[data-variant="5"] { padding-left: 42%; margin-top: clamp(18px, 2.4vw, 46px); margin-bottom: clamp(28px, 3.2vw, 58px); }
    .flow-item[data-variant="5"] .flow-media { aspect-ratio: 1 / 1; }

    .flow-item[data-variant="6"] { margin-top: clamp(4px, 0.8vw, 16px); margin-bottom: clamp(92px, 10.5vw, 184px); }
    .flow-item[data-variant="6"] .flow-media { aspect-ratio: 3 / 4; }

    .flow-item[data-variant="7"] { padding-right: 30%; margin-top: clamp(64px, 7.6vw, 142px); margin-bottom: clamp(48px, 5.4vw, 102px); }
    .flow-item[data-variant="7"] .flow-media { aspect-ratio: 3 / 2; }

    .flow-item[data-variant="8"] { padding-left: 12%; margin-top: clamp(40px, 4.6vw, 92px); margin-bottom: clamp(66px, 7.2vw, 138px); }
    .flow-item[data-variant="8"] .flow-media { aspect-ratio: 5 / 6; }

    .flow-item[data-variant="9"] { padding-right: 26%; margin-top: clamp(8px, 1.2vw, 22px); margin-bottom: clamp(34px, 3.8vw, 68px); }
    .flow-item[data-variant="9"] .flow-media { aspect-ratio: 1 / 1; }

    .flow-item[data-variant="10"] { margin-top: clamp(50px, 5.8vw, 110px); margin-bottom: clamp(58px, 6.4vw, 124px); }
    .flow-item[data-variant="10"] .flow-media { aspect-ratio: 5 / 7; }

    /* On narrow screens drop the horizontal offset so tiles stay legible. */
    @media (max-width: 1000px) { .flow-item { padding-left: 0 !important; padding-right: 0 !important; } }

    .flow-media {
      display: block; overflow: hidden; background: rgba(28, 29, 34, 0.05);
      border-radius: 4px;
    }
    .flow-media img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 1.3s cubic-bezier(.2,.7,.2,1);
    }
    .flow-item:hover .flow-media img { transform: scale(1.045); }

    .flow-cap {
      display: flex; align-items: baseline; justify-content: space-between; gap: 12px;
      margin-top: 14px;
    }
    .flow-title {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase; line-height: 1.35;
      color: var(--ink); transition: color 0.3s ease;
    }
    .flow-item:hover .flow-title { color: var(--english-violet); }
    .flow-count {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.1em; color: rgba(28, 29, 34, 0.4); flex-shrink: 0;
    }

    /* ============== FLYING CLONE ============== */
    .flow-fly {
      position: fixed; z-index: 210; object-fit: cover; border-radius: 4px;
      opacity: 0; pointer-events: none; will-change: left, top, width, height;
      box-shadow: 0 40px 110px -30px rgba(0,0,0,0.45);
    }

    /* While the reader is open the body is pinned so the background can't move. */
    :global(body.reader-locked) { position: fixed; left: 0; right: 0; width: 100%; overflow: hidden; }

    /* ============== READER (in-frame) ============== */
    .reader {
      position: fixed; inset: 0; z-index: 200;
      display: grid; place-items: center; padding: clamp(20px, 4vh, 56px);
      background: rgba(244, 242, 240, 0); backdrop-filter: blur(0px);
      transition: background 0.45s ease, backdrop-filter 0.45s ease;
    }
    .reader[hidden] { display: none; }
    .reader.is-open { background: rgba(244, 242, 240, 0.42); backdrop-filter: blur(5px); }

    .reader-frame {
      width: min(1060px, 94vw); height: 88vh;
      display: grid; grid-template-columns: minmax(0, 0.74fr) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr);
      gap: clamp(26px, 3vw, 56px);
      background: var(--paper, #fff); border-radius: 6px;
      padding: clamp(22px, 2.6vw, 44px);
      box-shadow: 0 50px 130px -36px rgba(0,0,0,0.5);
      overflow: hidden;
      /* The box expands outward from behind the hero image (origin sits over the
         left-hand hero), so it grows to "fit" around the picture as it lands. */
      opacity: 0; transform: scale(0.58);
      transform-origin: 26% 46%;
      transition: opacity 0.46s ease, transform 0.74s cubic-bezier(.16,.84,.3,1);
    }
    .reader.is-open .reader-frame { opacity: 1; transform: scale(1); }

    /* Fills the full frame height and stays put while the right column scrolls. */
    .reader-hero {
      height: 100%; overflow: hidden; border-radius: 4px;
      background: rgba(28, 29, 34, 0.06);
    }
    .reader-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }

    .reader-col {
      min-width: 0; min-height: 0; height: 100%; overflow-y: auto; overscroll-behavior: contain; padding-right: 6px;
      /* Copy fades in just after the box has opened. */
      opacity: 0; transform: translateY(10px);
      transition: opacity 0.5s ease 0.2s, transform 0.6s cubic-bezier(.2,.7,.2,1) 0.2s;
    }
    .reader.is-open .reader-col { opacity: 1; transform: none; }
    .reader-meta {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.2em; text-transform: uppercase; color: var(--english-violet);
      margin-bottom: 14px;
    }
    .reader-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(26px, 2.6vw, 40px); line-height: 1.06; letter-spacing: -0.02em;
      color: var(--ink); margin: 0 0 18px;
    }
    .reader-content {
      font-family: var(--sans); font-size: 15.5px; line-height: 1.66;
      color: rgba(28, 29, 34, 0.82);
    }
    .reader-content :global(h2) {
      font-family: var(--serif); font-weight: 400; font-size: 21px; line-height: 1.2;
      color: var(--ink); margin: 26px 0 10px; letter-spacing: -0.01em;
    }
    .reader-content :global(p) { margin: 0 0 14px; }
    .reader-content :global(p.lede) { font-size: 17px; color: var(--ink); }
    .reader-content :global(ul) { margin: 0 0 16px; padding-left: 20px; }
    .reader-content :global(li) { margin: 0 0 7px; }
    .reader-content :global(blockquote) {
      margin: 22px 0; padding: 4px 0 4px 20px; border-left: 2px solid var(--english-violet);
      font-family: var(--serif); font-style: italic; font-size: 18px; color: var(--ink);
    }
    .reader-content :global(strong) { color: var(--ink); }

    .reader-x {
      position: fixed; top: clamp(16px, 3vh, 30px); right: clamp(16px, 3vw, 34px);
      z-index: 220; width: 48px; height: 48px; border-radius: 50%; border: 0;
      background: var(--ink); color: var(--paper); font-size: 24px; line-height: 1;
      display: grid; place-items: center; cursor: pointer;
      opacity: 0; transform: scale(0.8); transition: opacity 0.4s ease 0.15s, transform 0.4s ease 0.15s, background 0.2s;
    }
    .reader.is-open .reader-x { opacity: 1; transform: none; }
    .reader-x:hover { background: var(--english-violet); }

    @media (max-width: 760px) {
      /* Stack: image on top (fixed), text scrolls beneath. */
      .reader-frame {
        grid-template-columns: minmax(0, 1fr);
        grid-template-rows: auto minmax(0, 1fr);
        height: auto; max-height: 90vh;
        gap: 20px;
      }
      .reader-hero { height: auto; aspect-ratio: 16 / 10; }
    }

    @media (prefers-reduced-motion: reduce) {
      .flow, .flow.is-away, .reader-frame, .reader, .flow-fly, .reader-x { transition: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const flow = document.getElementById("flow");
      const reader = document.getElementById("reader");
      const frameHero = document.getElementById("reader-hero");
      const heroImg = document.getElementById("reader-hero-img");
      const metaEl = document.getElementById("reader-meta");
      const titleEl = document.getElementById("reader-title");
      const contentEl = document.getElementById("reader-content");
      const closeBtn = document.getElementById("reader-x");
      const fly = document.getElementById("flow-fly");
      if (!flow || !reader || !heroImg) return;

      let data = {};
      try { data = (JSON.parse(document.getElementById("flow-data").textContent || "[]") || []).reduce((m, p) => (m[p.slug] = p, m), {}); } catch (_) {}
      const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let isOpen = false;
      let flyTimer = null;
      let scrollLockY = 0;

      function populate(slug) {
        const p = data[slug]; if (!p) return false;
        metaEl.textContent = [p.eyebrow, p.date, p.readTime ? p.readTime + " min read" : ""].filter(Boolean).join("  ·  ");
        titleEl.textContent = p.title;
        heroImg.src = p.hero; heroImg.alt = p.title;
        contentEl.innerHTML = "";
        const tpl = document.querySelector('template[data-post="' + (window.CSS && CSS.escape ? CSS.escape(slug) : slug) + '"]');
        if (tpl && tpl.content) contentEl.appendChild(tpl.content.cloneNode(true));
        return true;
      }

      function open(slug, imgEl) {
        if (isOpen || !populate(slug)) return;
        isOpen = true;
        // Fully lock the background: pin the body in place (the reliable
        // cross-browser lock — overflow:hidden alone leaves the page scrollable
        // here). The modal is position:fixed, so it stays put; we restore the
        // exact scroll position on close.
        scrollLockY = window.scrollY || window.pageYOffset || 0;
        document.body.style.top = `-${scrollLockY}px`;
        document.body.classList.add("reader-locked");
        reader.hidden = false;
        reader.scrollTop = 0; contentEl.scrollTop = 0;
        var rcol = reader.querySelector(".reader-col"); if (rcol) rcol.scrollTop = 0;

        if (reduce || !imgEl) {
          flow.classList.add("is-away");
          requestAnimationFrame(() => reader.classList.add("is-open"));
          return;
        }

        // FLIP: fly the clicked image from its grid slot to the hero target.
        const s = imgEl.getBoundingClientRect();
        const p = data[slug];
        const frame = reader.querySelector(".reader-frame");

        // Measure the hero's FINAL rect (box at full size) before it animates,
        // so the flying image lands exactly where the hero settles.
        frame.style.transition = "none";
        frame.style.transform = "none";
        const t = frameHero.getBoundingClientRect();
        frame.style.transform = "";       // back to the CSS start scale
        frame.getBoundingClientRect();    // reflow
        frame.style.transition = "";

        // Place the flying clone over the clicked image, tilted slightly.
        fly.src = p.hero;
        fly.style.transition = "none";
        fly.style.transformOrigin = "50% 50%";
        fly.style.transform = "rotate(-5deg)";
        fly.style.opacity = "1";
        fly.style.left = s.left + "px"; fly.style.top = s.top + "px";
        fly.style.width = s.width + "px"; fly.style.height = s.height + "px";
        frameHero.style.opacity = "0";
        fly.getBoundingClientRect();      // reflow

        // Open the box (expands outward from behind the image) while the image
        // glides + rotates to the hero spot.
        flow.classList.add("is-away");
        requestAnimationFrame(() => {
          reader.classList.add("is-open");
          fly.style.transition =
            "left .74s cubic-bezier(.16,.84,.3,1), top .74s cubic-bezier(.16,.84,.3,1), " +
            "width .74s cubic-bezier(.16,.84,.3,1), height .74s cubic-bezier(.16,.84,.3,1), " +
            "transform .74s cubic-bezier(.16,.84,.3,1), opacity .3s ease";
          fly.style.left = t.left + "px"; fly.style.top = t.top + "px";
          fly.style.width = t.width + "px"; fly.style.height = t.height + "px";
          fly.style.transform = "rotate(0deg)";
        });

        // Hand off to the real hero once the box has finished expanding.
        clearTimeout(flyTimer);
        flyTimer = setTimeout(function () {
          if (!isOpen) return;
          frameHero.style.opacity = "1";
          fly.style.opacity = "0";
        }, 760);
      }

      function close() {
        if (!isOpen) return;
        isOpen = false;
        clearTimeout(flyTimer);
        reader.classList.remove("is-open");
        flow.classList.remove("is-away");
        fly.style.opacity = "0";
        document.body.classList.remove("reader-locked");
        document.body.style.top = "";
        window.scrollTo(0, scrollLockY);
        setTimeout(() => { if (!isOpen) { reader.hidden = true; contentEl.innerHTML = ""; } }, 540);
      }

      flow.addEventListener("click", function (e) {
        const item = e.target.closest(".flow-item");
        if (!item) return;
        const img = item.querySelector(".flow-media img");
        open(item.getAttribute("data-slug"), img);
      });
      closeBtn.addEventListener("click", close);
      reader.addEventListener("click", function (e) { if (e.target === reader) close(); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape" && isOpen) close(); });
    })();
  </script>
</BaseLayout>
