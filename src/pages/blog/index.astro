---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../data/blog.js";

// Pulled from Supabase if configured, otherwise from the static fallback.
const allPosts = await getPublishedPosts();
const sorted = [...allPosts].sort((a, b) => (a.date < b.date ? 1 : -1));
const featured = sorted[0]; // → right column (newest / feature post)
const rest = sorted.slice(1); // → left list

// Pad the feed with duplicates so the columns are tall enough to actually show
// the counter-scroll while there are only a handful of real posts. Remove the
// padding (use `rest` directly) once there are ~9+ published posts.
const feed = rest.length >= 9 ? rest : [...rest, ...rest, ...rest].slice(0, 9);

// The left side is a double column whose two halves counter-scroll. Alternate
// posts between them so both stay populated and balanced.
const colUp = feed.filter((_, i) => i % 2 === 0);   // left-left column → drifts UP
const colDown = feed.filter((_, i) => i % 2 === 1); // left-right column → drifts DOWN

// The feature card shows a slightly shorter display title (≈2 lines)
// without changing the article's canonical title. Keyed by slug so it only
// applies to the intended post; falls back to the real title otherwise.
const FEATURE_TITLE = {
  "why-personal-branding-works-in-estate-agency": "Why personal branding works in estate agency",
};
const featTitle = FEATURE_TITLE[featured.slug] || featured.title;

function fmtDate(iso) {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}
---

<BaseLayout
  title="Insights — TMKE"
  description="Structured insights on social media, brand positioning, content systems, and the future of estate agency marketing — written for UK property professionals."
>
  <!-- Page-wide film grain — fixed, sits above the content but below the nav,
       blended so it adds texture without tinting. Purely decorative. -->
  <div class="insights-grain" aria-hidden="true"></div>

  <!-- ============================== TWO-COLUMN SPLIT -->
  <section class="insights2" id="insights2">
    <!-- LEFT: double column — the two halves counter-scroll (left up, right down) -->
    <div class="ins-list" id="ins-list">
      <div class="ins-list-head">
        <div class="eyebrow">Insights</div>
        <h1 class="ins-list-title">Notes from <em>the desk.</em></h1>
      </div>

      <div class="ins-cols">
        <div class="ins-col ins-col--up" id="ins-col-up">
          {colUp.map((p) => (
            <a class="ins-item" href={`/blog/${p.slug}`}>
              <h3 class="ins-item-title">{p.title}</h3>
              <div class="ins-item-media"><img src={p.hero} alt={p.title} loading="lazy" /></div>
              <p class="ins-item-brief">{p.standfirst}</p>
            </a>
          ))}
        </div>
        <div class="ins-col ins-col--down" id="ins-col-down">
          {colDown.map((p) => (
            <a class="ins-item" href={`/blog/${p.slug}`}>
              <h3 class="ins-item-title">{p.title}</h3>
              <div class="ins-item-media"><img src={p.hero} alt={p.title} loading="lazy" /></div>
              <p class="ins-item-brief">{p.standfirst}</p>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- RIGHT: pinned feature (newest post) -->
    <aside class="ins-feature" id="ins-feature">
      <a class="ins-feature-inner" href={`/blog/${featured.slug}`}>
        <div class="ins-feature-head">
          <div class="ins-feature-eyebrow">Latest <span class="ins-dot">·</span> {featured.category}</div>
          <h2 class="ins-feature-title">{featTitle}</h2>
        </div>
        <div class="ins-feature-media">
          <!-- Feature video (/public/assets/book reading.mp4). The poster
               (the post's hero image) shows until the clip loads. -->
          <video
            class="ins-feature-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={featured.hero}
          >
            <source src="/assets/book%20reading.mp4" type="video/mp4" />
          </video>
          <span class="ins-feature-tag">Read the feature <em>&rarr;</em></span>
        </div>
        <p class="ins-feature-sub">{featured.standfirst}</p>
      </a>
    </aside>
  </section>

  <!-- ============================== NEWSLETTER -->
  <section class="insights-news">
    <div class="news-box">
      <div class="news-eyebrow">/ Newsletter /</div>
      <h3 class="news-title">Get the next insight <em>in your inbox.</em></h3>
      <p class="news-sub">One considered email every other Friday. No filler, no automation — written by the TMKE desk for UK property professionals.</p>
      <form class="news-form" id="insights-news-form" novalidate>
        <input type="email" name="email" placeholder="you@agency.co.uk" required autocomplete="email" />
        <button type="submit" class="btn btn--solid">Subscribe <span class="btn-arrow">&rarr;</span></button>
      </form>
      <p class="news-fine">No spam. Unsubscribe in one click.</p>
    </div>
  </section>

  <style>
    /* ============== PAGE GRAIN ============== */
    .insights-grain {
      position: fixed;
      inset: 0;
      z-index: 60; /* above content (z-index:2), below nav (100) */
      pointer-events: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23g)'/></svg>");
      background-size: 240px 240px;
      opacity: 0.15;
      mix-blend-mode: overlay;
    }

    /* ============== TWO-COLUMN SPLIT ============== */
    .insights2 {
      display: grid;
      /* minmax(0,1fr) keeps both halves a true 50/50 — without the `0` floor
         the nowrap card titles inflate the left track past half. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(28px, 3.2vw, 60px);
      align-items: start;
      max-width: 1640px;
      margin: 0 auto;
      padding: clamp(92px, 10vh, 124px) clamp(22px, 4vw, 64px) clamp(80px, 8vw, 120px);
    }

    /* ---- LEFT: double column (the two halves counter-scroll) ---- */
    .ins-list {
      display: flex;
      flex-direction: column;
      /* Pull the blogs in from the centre so the video has breathing room. */
      padding-right: clamp(10px, 1.8vw, 36px);
    }
    .ins-list-head { margin-bottom: clamp(20px, 3vw, 40px); }
    .ins-list-head .eyebrow { margin-bottom: 16px; }
    .ins-list-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(30px, 3.4vw, 48px);
      line-height: 1.04;
      letter-spacing: -0.018em;
      color: var(--ink);
      margin: 0;
    }
    .ins-list-title em { font-style: italic; color: var(--english-violet); }

    .ins-cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(14px, 1.6vw, 24px);
      align-items: start;
    }
    .ins-col {
      display: flex;
      flex-direction: column;
      gap: clamp(26px, 3vw, 44px);
      will-change: transform;
    }
    /* Stagger the down column so the two halves interleave (masonry feel). */
    .ins-col--down { margin-top: clamp(40px, 6vw, 96px); }

    .ins-item {
      display: block;
      color: var(--ink);
      text-decoration: none;
    }
    .ins-item-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(16px, 1.25vw, 20px);
      line-height: 1.15;
      letter-spacing: -0.01em;
      color: var(--ink);
      margin: 0 0 12px;
      /* One line maximum. */
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color 0.3s ease;
    }
    .ins-item:hover .ins-item-title { color: var(--english-violet); }

    .ins-item-media {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 14px;
      background: rgba(28, 29, 34, 0.06);
      margin-bottom: 12px;
    }
    .ins-item-media img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 1.4s cubic-bezier(.2, .7, .2, 1);
    }
    .ins-item:hover .ins-item-media img { transform: scale(1.05); }

    .ins-item-brief {
      font-family: var(--sans);
      font-size: clamp(12.5px, 0.95vw, 14px);
      line-height: 1.35;
      color: rgba(28, 29, 34, 0.6);
      margin: 0;
      /* Two lines, tight. */
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .ins-dot { opacity: 0.5; }

    /* ---- RIGHT: pinned feature ---- */
    .ins-feature {
      position: sticky;
      top: clamp(80px, 9vh, 104px);
      height: calc(100vh - clamp(80px, 9vh, 104px) - clamp(32px, 4vh, 56px));
      min-height: 540px;
    }
    .ins-feature-inner {
      display: flex;
      flex-direction: column;
      height: 100%;
      color: var(--ink);
      text-decoration: none;
      will-change: transform;
    }
    .ins-feature-head { flex: 0 0 auto; margin-bottom: clamp(16px, 1.8vw, 26px); }
    .ins-feature-eyebrow {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.55);
      margin-bottom: 18px;
    }
    .ins-feature-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(34px, 3.6vw, 62px);
      line-height: 1.04;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 0;
      max-width: 24ch;
    }
    .ins-feature-sub {
      flex: 0 0 auto;
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(17px, 1.5vw, 22px);
      line-height: 1.5;
      color: rgba(28, 29, 34, 0.7);
      margin: clamp(16px, 1.6vw, 24px) 0 0;
      max-width: 60ch;
    }
    .ins-feature-media {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      overflow: hidden;
      border-radius: 14px;
      background: rgba(28, 29, 34, 0.06);
    }
    .ins-feature-media img,
    .ins-feature-media video {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 1.6s cubic-bezier(.2, .7, .2, 1);
    }
    .ins-feature-inner:hover .ins-feature-media img,
    .ins-feature-inner:hover .ins-feature-media video { transform: scale(1.04); }
    .ins-feature-tag {
      position: absolute;
      left: 18px; bottom: 18px;
      display: inline-flex; align-items: center; gap: 8px;
      padding: 9px 16px;
      background: rgba(28, 29, 34, 0.85);
      color: var(--paper);
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-radius: 999px;
      backdrop-filter: blur(4px);
    }
    .ins-feature-tag em {
      font-style: normal;
      transition: transform 0.3s ease;
    }
    .ins-feature-inner:hover .ins-feature-tag em { transform: translateX(4px); }

    /* ---- Responsive: stack, un-pin, no parallax ---- */
    @media (max-width: 900px) {
      .insights2 {
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(56px, 10vw, 88px);
        padding-top: clamp(120px, 22vw, 160px);
      }
      .ins-list { padding-right: 0; }
      .ins-feature {
        position: static;
        height: auto;
        min-height: 0;
        order: -1; /* feature first on mobile */
      }
      .ins-feature-media { aspect-ratio: 4 / 3; flex: 0 0 auto; height: auto; }
      /* Collapse the double column to one; no counter-scroll on small screens. */
      .ins-cols { grid-template-columns: minmax(0, 1fr); gap: clamp(26px, 6vw, 44px); }
      .ins-col--down { margin-top: clamp(26px, 6vw, 44px); }
      /* Parallax transforms are skipped in JS below this width. */
      .ins-col, .ins-feature-inner { transform: none !important; }
    }

    /* ============== NEWSLETTER ============== */
    .insights-news {
      max-width: 1360px;
      margin: 0 auto;
      padding: 40px 36px 160px;
    }
    .news-box {
      background: var(--ink);
      color: var(--paper);
      padding: 80px 64px;
      text-align: center;
      border-radius: 2px;
      position: relative;
      overflow: hidden;
    }
    @media (max-width: 720px) { .news-box { padding: 56px 28px; } }
    .news-eyebrow {
      font-family: var(--serif);
      font-style: italic;
      font-size: 16px;
      color: rgba(240, 238, 235, 0.6);
      margin-bottom: 18px;
    }
    .news-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(32px, 3.4vw, 48px);
      letter-spacing: -0.015em;
      color: var(--paper);
      margin: 0 0 14px;
    }
    .news-title em { font-style: italic; color: var(--french-grey); }
    .news-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(16px, 1.4vw, 19px);
      line-height: 1.5;
      color: rgba(240, 238, 235, 0.7);
      max-width: 52ch;
      margin: 0 auto 28px;
    }
    .news-form {
      display: flex;
      gap: 8px;
      max-width: 480px;
      margin: 0 auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    .news-form input {
      flex: 1;
      min-width: 220px;
      padding: 14px 18px;
      font-family: var(--sans);
      font-size: 15px;
      background: transparent;
      border: 1px solid rgba(240, 238, 235, 0.3);
      color: var(--paper);
      border-radius: 1px;
    }
    .news-form input::placeholder { color: rgba(240, 238, 235, 0.4); }
    .news-form input:focus { outline: none; border-color: var(--paper); }
    .news-form .btn--solid {
      background: var(--paper);
      color: var(--ink);
      border-color: var(--paper);
    }
    .news-form .btn--solid:hover {
      background: var(--accent);
      color: var(--paper);
      border-color: var(--accent);
    }
    .news-fine {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(240, 238, 235, 0.4);
      margin-top: 18px;
    }
  </style>

  <!-- Counter-scroll parallax. Only the two LEFT columns move: left-left drifts
       UP, left-right drifts DOWN as the section scrolls. The right-hand video
       stays put (sticky, no transform). Hooks the site's global Lenis instance
       when present, else a passive scroll listener. Skipped on small screens
       and under reduced-motion. -->
  <script is:inline>
    (function () {
      const colUp = document.getElementById("ins-col-up");
      const colDown = document.getElementById("ins-col-down");
      const section = document.getElementById("insights2");
      if (!colUp || !colDown || !section) return;

      const reduce =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const isMobile = () => window.matchMedia("(max-width: 900px)").matches;

      // Max drift each column travels from the neutral mid-scroll position.
      const RANGE_COL = 90;
      let ticking = false;

      function apply() {
        ticking = false;
        if (reduce || isMobile()) {
          colUp.style.transform = "";
          colDown.style.transform = "";
          return;
        }
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        // progress: 0 when the section first enters from the bottom, 1 when it
        // has fully passed the top. 0.5 ≈ centred → neutral (no drift).
        const total = rect.height + vh;
        const p = Math.max(0, Math.min(1, (vh - rect.top) / total));
        const col = (p - 0.5) * 2 * RANGE_COL; // -RANGE … +RANGE
        // As you scroll down (p↑): left-left rises, left-right sinks.
        colUp.style.transform = "translate3d(0," + (-col).toFixed(2) + "px,0)";
        colDown.style.transform = "translate3d(0," + col.toFixed(2) + "px,0)";
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      }

      if (window.__lenis && typeof window.__lenis.on === "function") {
        window.__lenis.on("scroll", onScroll);
      } else {
        window.addEventListener("scroll", onScroll, { passive: true });
      }
      window.addEventListener("resize", onScroll);
      apply();
    })();
  </script>

  <script is:inline>
    (function () {
      const form = document.getElementById("insights-news-form");
      if (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          const input = form.querySelector("input");
          const btn = form.querySelector("button");
          if (!input.value) return;
          const original = btn.innerHTML;
          btn.textContent = "You're in ✓";
          setTimeout(function () {
            btn.innerHTML = original;
            input.value = "";
          }, 2400);
        });
      }
    })();
  </script>
</BaseLayout>
