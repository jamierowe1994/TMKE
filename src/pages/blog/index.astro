---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../data/blog.js";

// Pulled from Supabase if configured, otherwise the static fallback.
const allPosts = await getPublishedPosts();
const posts = [...allPosts].sort((a, b) => (a.date < b.date ? 1 : -1));

const featured = posts[0] || null;     // newest = featured (auto)
const archivePosts = posts.slice(1);   // everything else
const recent3 = archivePosts.slice(0, 3); // the right-hand "peek" strip

function fmtDate(iso) {
  if (!iso) return "";
  const d = new Date(iso);
  if (isNaN(d)) return "";
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}

// Decorative, NON-post tiles — brand photos for now (swap later). Reused across
// the grid; fine for placeholders.
const STATIC_POOL = [
  "/assets/sitting%20chair.jpg", "/assets/home%20kitchen.jpg", "/assets/vibes.jpg",
  "/assets/home%20window.jpg", "/assets/Doors.jpg", "/assets/tea.jpg",
  "/assets/home%20chair.jpg", "/assets/home%20forest.jpg", "/assets/home%20deer.jpg",
  "/assets/outside.jpg", "/assets/glasses.jpg", "/assets/cosy%20home.jpg",
  "/assets/lay%20down.jpg", "/assets/home%20ginger.jpg",
];

// Lay out a 6-col grid: ~2 posts per row at SCATTERED columns (no obvious
// pattern / no column alignment), every other cell a static photo.
const COLS = 6;
const ROW_POST_COLS = [[0, 3], [2, 5], [1, 4], [0, 4], [2, 3], [1, 5]];
const gridItems = [];
let pi = 0, gi = 0;
for (let r = 0; pi < archivePosts.length; r++) {
  const cols = ROW_POST_COLS[r % ROW_POST_COLS.length];
  for (let c = 0; c < COLS; c++) {
    if (cols.includes(c) && pi < archivePosts.length) {
      const p = archivePosts[pi++];
      gridItems.push({ type: "post", post: p, num: String(pi).padStart(2, "0") });
    } else {
      gridItems.push({ type: "image", img: STATIC_POOL[gi++ % STATIC_POOL.length] });
    }
  }
}

// Lite data for the reader (full bodies embedded as <template>s below).
const lite = posts.map((p) => ({
  slug: p.slug, title: p.title, eyebrow: p.eyebrow || p.category || "",
  date: fmtDate(p.date), readTime: p.readTime || null, hero: p.hero,
}));
const featMeta = featured
  ? [featured.eyebrow || featured.category, fmtDate(featured.date), featured.readTime ? featured.readTime + " min read" : ""].filter(Boolean).join("  ·  ")
  : "";
---

<BaseLayout
  title="Insights — TMKE"
  description="Structured insights on social media, brand positioning, content systems, and the future of estate agency marketing — written for UK property professionals."
  hideFooter
>
  <section class="ins">
    <!-- ===== Left: static title + intro ===== -->
    <div class="ins-intro">
      <span class="ins-eyebrow">Insights</span>
      <div class="ins-intro-foot">
        <p class="ins-intro-note">Structured thinking on social media, brand and content — written for UK property professionals.</p>
        <h1 class="ins-bigtitle">Notes from the desk</h1>
      </div>
    </div>

    <!-- ===== Middle: featured article ===== -->
    <div class="ins-feature">
      <span class="ins-label">Featured Article</span>
      {featured && (
        <button class="ins-feature-card" type="button" data-slug={featured.slug}>
          <span class="ins-feature-headline">
            <span class="ins-feature-eyebrow">{featured.eyebrow || featured.category}</span>
            <span class="ins-feature-title">{featured.title}</span>
          </span>
          <span class="ins-feature-media"><img src={featured.hero} alt={featured.title} loading="eager" /></span>
          <span class="ins-feature-foot">
            <span class="ins-feature-meta">{featMeta}</span>
            <span class="ins-feature-stand">{featured.standfirst}</span>
          </span>
        </button>
      )}
    </div>

    <!-- ===== Right: recent strip → hover expands the archive ===== -->
    <div class="ins-strip" id="ins-strip" tabindex="0" role="button" aria-label="Open the article archive">
      <span class="ins-label ins-label--strip">Article Archive <em aria-hidden="true">&rarr;</em></span>
      <div class="ins-strip-imgs">
        {recent3.map((p) => (
          <span class="ins-strip-img" style={`background-image:url('${p.hero}')`}></span>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== Archive overlay — the expanded grid ===== -->
  <div class="arc" id="arc" hidden>
    <div class="arc-head">
      <span class="ins-label">Article Archive</span>
      <button class="arc-close" id="arc-close" type="button" aria-label="Close archive">&times;</button>
    </div>
    <div class="arc-scroll" data-lenis-prevent>
    <div class="arc-grid">
      {gridItems.map((it) => (
        it.type === "post" ? (
          <button class="arc-tile arc-tile--post" type="button" data-slug={it.post.slug}>
            <span class="arc-tile-img"><img src={it.post.hero} alt={it.post.title} loading="lazy" /></span>
            <span class="arc-tile-cap">
              <span class="arc-tile-num">Article {it.num}</span>
              <span class="arc-tile-name">{it.post.title}</span>
            </span>
          </button>
        ) : (
          <div class="arc-tile arc-tile--image" style={`background-image:url('${it.img}')`}></div>
        )
      ))}
    </div>
    </div>
  </div>

  <!-- ===== Reader — opens in-frame over everything ===== -->
  <div class="reader" id="reader" hidden>
    <button class="reader-x" id="reader-x" type="button" aria-label="Close">&times;</button>
    <div class="reader-frame" role="dialog" aria-modal="true" aria-labelledby="reader-title">
      <div class="reader-hero" id="reader-hero"><img id="reader-hero-img" src="" alt="" /></div>
      <div class="reader-col" data-lenis-prevent>
        <div class="reader-meta" id="reader-meta"></div>
        <h2 class="reader-title" id="reader-title"></h2>
        <div class="reader-content" id="reader-content"></div>
      </div>
    </div>
  </div>

  <img class="flow-fly" id="flow-fly" alt="" aria-hidden="true" />

  {posts.map((p) => (<template data-post={p.slug} set:html={p.body}></template>))}
  <script type="application/json" id="flow-data" set:html={JSON.stringify(lite)}></script>

  <style>
    /* ============ Insights — one-screen, three sections ============ */
    .ins {
      height: 100vh; min-height: 0;
      display: grid; grid-template-columns: 1.25fr 1.18fr clamp(170px, 15vw, 230px);
      grid-template-rows: minmax(0, 1fr);   /* constrain columns to the viewport so they shrink, never overflow */
      gap: 6px;
      padding: clamp(68px, 9vh, 100px) clamp(24px, 3.4vw, 60px) clamp(22px, 3.5vh, 48px);
      background: var(--paper); color: var(--ink); overflow: hidden;
    }
    /* Each column manages its own overflow so nothing spills past the screen. */
    .ins-intro, .ins-feature, .ins-strip { min-height: 0; }
    .ins-label, .ins-eyebrow {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--english-violet);
    }

    /* Left intro */
    .ins-intro { display: flex; flex-direction: column; justify-content: space-between; min-width: 0; }
    .ins-intro-foot { display: flex; flex-direction: column; gap: clamp(16px, 2vh, 26px); }
    .ins-intro-note {
      font-family: var(--sans); font-size: clamp(13px, 1vw, 15px); line-height: 1.5;
      color: rgba(28,29,34,0.7); margin: 0; max-width: 34ch;
    }
    .ins-bigtitle {
      font-family: var(--serif); font-weight: 400; font-size: clamp(64px, 9vw, 168px);
      line-height: 0.86; letter-spacing: -0.02em; color: var(--ink); margin: 0;
    }

    /* Middle featured */
    .ins-feature { display: flex; flex-direction: column; gap: 14px; min-width: 0; }
    .ins-feature-card {
      flex: 1; min-height: 0; -webkit-appearance: none; appearance: none; border: 0; background: none;
      padding: 0; margin: 0; text-align: left; cursor: pointer; color: var(--ink);
      display: flex; flex-direction: column; gap: clamp(12px, 1.6vh, 22px);
      border-top: 1px solid rgba(28,29,34,0.16); padding-top: clamp(14px, 1.8vh, 22px);
    }
    .ins-feature-headline { display: flex; flex-direction: column; gap: 4px; }
    .ins-feature-eyebrow {
      font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--english-violet);
    }
    .ins-feature-title {
      font-family: var(--serif); font-weight: 400; font-size: clamp(22px, 2.1vw, 32px);
      line-height: 1.08; letter-spacing: -0.015em; color: var(--ink);
    }
    .ins-feature-media {
      flex: 1; min-height: 0; display: block; overflow: hidden; border-radius: 3px;
      background: rgba(28,29,34,0.05);
    }
    .ins-feature-media img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 1.2s cubic-bezier(.2,.7,.2,1);
    }
    .ins-feature-card:hover .ins-feature-media img { transform: scale(1.035); }
    .ins-feature-foot { display: flex; flex-direction: column; gap: 6px; }
    .ins-feature-meta {
      font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: rgba(28,29,34,0.45);
    }
    .ins-feature-stand {
      font-family: var(--sans); font-size: clamp(12.5px, 1vw, 14px); line-height: 1.5;
      color: rgba(28,29,34,0.72); max-width: 62ch;
      display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
    }

    /* Right strip */
    .ins-strip {
      display: flex; flex-direction: column; gap: 12px; min-width: 0; cursor: pointer;
      border: 0; background: none; outline: none;
    }
    .ins-label--strip { color: var(--english-violet); display: inline-flex; gap: 8px; align-items: center; }
    .ins-label--strip em { font-style: normal; transition: transform 0.3s; }
    .ins-strip:hover .ins-label--strip em { transform: translateX(4px); }
    .ins-strip-imgs { flex: 1; min-height: 0; display: flex; flex-direction: column; gap: 6px; overflow: hidden; }
    .ins-strip-img {
      flex: 0 0 auto; aspect-ratio: 3 / 4; background-size: cover; background-position: center;
      background-color: rgba(28,29,34,0.06); border-radius: 2px;
      transition: transform 0.5s cubic-bezier(.2,.7,.2,1), opacity 0.4s ease;
    }
    .ins-strip:hover .ins-strip-img { transform: translateX(-6px); }

    /* ============ Archive overlay ============ */
    .arc {
      position: fixed; inset: 0; z-index: 150; background: var(--paper);
      padding: 8px 8px 8px;
      display: flex; flex-direction: column; gap: 8px;
      transform: translateX(-100%);
      transition: transform 0.42s cubic-bezier(.16, 1, .3, 1);
    }
    .arc[hidden] { display: none; }
    .arc.is-open { transform: translateX(0); }
    .arc-head { display: flex; align-items: center; justify-content: space-between; flex: 0 0 auto; padding: 6px 6px 0; }
    .arc-close {
      width: 42px; height: 42px; border-radius: 50%; border: 1px solid rgba(28,29,34,0.2);
      background: none; color: var(--ink); font-size: 24px; line-height: 1; cursor: pointer;
      display: grid; place-items: center; transition: background 0.25s, color 0.25s, transform 0.4s;
    }
    .arc-close:hover { background: var(--ink); color: var(--paper); transform: rotate(90deg); }

    .arc-scroll { flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
    .arc-grid {
      display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px;
      align-content: start; padding: 0 6px 6px;
    }
    @media (max-width: 1200px) { .arc-grid { grid-template-columns: repeat(4, 1fr); } }
    @media (max-width: 760px)  { .arc-grid { grid-template-columns: repeat(2, 1fr); } }

    .arc-tile { position: relative; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 2px; }

    /* Post tiles — off-white box, title bottom-left; hover reveals the image. */
    .arc-tile--post {
      -webkit-appearance: none; appearance: none; border: 0; text-align: left; cursor: pointer;
      background: var(--paper); color: var(--english-violet);
    }
    .arc-tile-img { position: absolute; inset: 0; opacity: 0; transition: opacity 0.5s ease; }
    .arc-tile-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .arc-tile-img::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(20,18,22,0) 38%, rgba(20,18,22,0.72) 100%);
    }
    .arc-tile--post:hover .arc-tile-img { opacity: 1; }

    .arc-tile-cap {
      position: absolute; left: 14px; right: 14px; bottom: 14px; z-index: 2;
      display: flex; flex-direction: column; gap: 4px;
    }
    .arc-tile-num {
      font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--english-violet); transition: color 0.4s ease;
    }
    .arc-tile-name {
      font-family: var(--sans); font-weight: 600; font-size: clamp(15px, 1.1vw, 19px);
      line-height: 1.12; letter-spacing: -0.005em; color: var(--english-violet); transition: color 0.4s ease;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .arc-tile--post:hover .arc-tile-num { color: rgba(244,242,240,0.75); }
    .arc-tile--post:hover .arc-tile-name { color: var(--paper); }

    /* Static image tiles */
    .arc-tile--image { background-size: cover; background-position: center; background-color: rgba(28,29,34,0.06); }
    .arc-tile-cap--static {
      position: absolute; left: 14px; bottom: 14px; right: auto; z-index: 2;
      font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--paper); text-shadow: 0 1px 10px rgba(0,0,0,0.5);
    }

    /* ============ Flying clone + reader (reused) ============ */
    .flow-fly {
      position: fixed; z-index: 260; object-fit: cover; border-radius: 4px;
      opacity: 0; pointer-events: none; will-change: left, top, width, height;
      box-shadow: 0 40px 110px -30px rgba(0,0,0,0.45);
    }
    :global(body.reader-locked) { position: fixed; left: 0; right: 0; width: 100%; overflow: hidden; }

    .reader {
      position: fixed; inset: 0; z-index: 250; display: grid; place-items: center;
      padding: clamp(20px, 4vh, 56px);
      background: rgba(244,242,240,0); backdrop-filter: blur(0px);
      transition: background 0.45s ease, backdrop-filter 0.45s ease;
    }
    .reader[hidden] { display: none; }
    .reader.is-open { background: rgba(244,242,240,0.5); backdrop-filter: blur(6px); }
    .reader-frame {
      width: min(1060px, 94vw); height: 88vh;
      display: grid; grid-template-columns: minmax(0, 0.74fr) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr); gap: clamp(26px, 3vw, 56px);
      background: var(--paper, #fff); border-radius: 6px; padding: clamp(22px, 2.6vw, 44px);
      box-shadow: 0 50px 130px -36px rgba(0,0,0,0.5); overflow: hidden;
      opacity: 0; transform: scale(0.58); transform-origin: 26% 46%;
      transition: opacity 0.46s ease, transform 0.74s cubic-bezier(.16,.84,.3,1);
    }
    .reader.is-open .reader-frame { opacity: 1; transform: scale(1); }
    .reader-hero { height: 100%; overflow: hidden; border-radius: 4px; background: rgba(28,29,34,0.06); }
    .reader-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .reader-col {
      min-width: 0; min-height: 0; height: 100%; overflow-y: auto; overscroll-behavior: contain; padding-right: 6px;
      opacity: 0; transform: translateY(10px);
      transition: opacity 0.5s ease 0.2s, transform 0.6s cubic-bezier(.2,.7,.2,1) 0.2s;
    }
    .reader.is-open .reader-col { opacity: 1; transform: none; }
    .reader-meta { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--english-violet); margin-bottom: 14px; }
    .reader-title { font-family: var(--serif); font-weight: 400; font-size: clamp(26px, 2.6vw, 40px); line-height: 1.06; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 18px; }
    .reader-content { font-family: var(--sans); font-size: 15.5px; line-height: 1.66; color: rgba(28,29,34,0.82); }
    .reader-content :global(h2) { font-family: var(--serif); font-weight: 400; font-size: 21px; line-height: 1.2; color: var(--ink); margin: 26px 0 10px; letter-spacing: -0.01em; }
    .reader-content :global(p) { margin: 0 0 14px; }
    .reader-content :global(p.lede) { font-size: 17px; color: var(--ink); }
    .reader-content :global(ul) { margin: 0 0 16px; padding-left: 20px; }
    .reader-content :global(li) { margin: 0 0 7px; }
    .reader-content :global(blockquote) { margin: 22px 0; padding: 4px 0 4px 20px; border-left: 2px solid var(--english-violet); font-family: var(--serif); font-style: italic; font-size: 18px; color: var(--ink); }
    .reader-content :global(strong) { color: var(--ink); }
    .reader-x {
      position: fixed; top: clamp(16px, 3vh, 30px); right: clamp(16px, 3vw, 34px); z-index: 270;
      width: 48px; height: 48px; border-radius: 50%; border: 0; background: var(--ink); color: var(--paper);
      font-size: 24px; line-height: 1; display: grid; place-items: center; cursor: pointer;
      opacity: 0; transform: scale(0.8); transition: opacity 0.4s ease 0.15s, transform 0.4s ease 0.15s, background 0.2s;
    }
    .reader.is-open .reader-x { opacity: 1; transform: none; }
    .reader-x:hover { background: var(--english-violet); }

    /* ============ Responsive ============ */
    @media (max-width: 1000px) {
      .ins { height: auto; min-height: 0; grid-template-columns: 1fr; gap: 40px; padding-top: 96px; }
      .ins-bigtitle { font-size: clamp(56px, 16vw, 110px); }
      .ins-strip-imgs { flex-direction: row; height: 30vh; }
    }
    @media (max-width: 760px) {
      .reader-frame { grid-template-columns: minmax(0,1fr); grid-template-rows: auto minmax(0,1fr); height: auto; max-height: 90vh; gap: 20px; }
      .reader-hero { height: auto; aspect-ratio: 16 / 10; }
    }
    @media (prefers-reduced-motion: reduce) {
      .arc, .arc-tile, .reader, .reader-frame, .flow-fly, .reader-x, .ins-strip-img { transition: none !important; animation: none !important; opacity: 1 !important; transform: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const strip = document.getElementById("ins-strip");
      const arc = document.getElementById("arc");
      const arcClose = document.getElementById("arc-close");
      const reader = document.getElementById("reader");
      const heroImg = document.getElementById("reader-hero-img");
      const frameHero = document.getElementById("reader-hero");
      const metaEl = document.getElementById("reader-meta");
      const titleEl = document.getElementById("reader-title");
      const contentEl = document.getElementById("reader-content");
      const closeBtn = document.getElementById("reader-x");
      const fly = document.getElementById("flow-fly");
      if (!reader || !heroImg) return;

      let data = {};
      try { data = (JSON.parse(document.getElementById("flow-data").textContent || "[]") || []).reduce((m, p) => (m[p.slug] = p, m), {}); } catch (_) {}
      const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // ----- Archive overlay (hover the strip to expand) -----
      let arcOpen = false, closeT = null;
      // stagger index for the tile entrance
      arc && arc.querySelectorAll(".arc-tile").forEach((t, i) => t.style.setProperty("--i", i));
      function openArc() {
        if (closeT) { clearTimeout(closeT); closeT = null; }
        if (arcOpen) return; arcOpen = true;
        try { window.__lenis && window.__lenis.stop(); } catch (_) {}
        arc.hidden = false;
        requestAnimationFrame(() => arc.classList.add("is-open"));
      }
      function closeArc(now) {
        if (!arcOpen) return; arcOpen = false;
        try { window.__lenis && window.__lenis.start(); } catch (_) {}
        arc.classList.remove("is-open");
        setTimeout(() => { if (!arcOpen) arc.hidden = true; }, now ? 0 : 480);
      }
      if (strip && arc) {
        strip.addEventListener("mouseenter", openArc);
        strip.addEventListener("click", openArc);
        strip.addEventListener("keydown", (e) => { if (e.key === "Enter" || e.key === " ") { e.preventDefault(); openArc(); } });
        // Keep open while over the overlay; close shortly after leaving it.
        arc.addEventListener("mouseenter", () => { if (closeT) { clearTimeout(closeT); closeT = null; } });
        arc.addEventListener("mouseleave", () => { closeT = setTimeout(() => closeArc(false), 140); });
        arcClose && arcClose.addEventListener("click", () => closeArc(true));
      }

      // ----- Reader -----
      let isOpen = false, flyTimer = null, scrollLockY = 0;
      function populate(slug) {
        const p = data[slug]; if (!p) return false;
        metaEl.textContent = [p.eyebrow, p.date, p.readTime ? p.readTime + " min read" : ""].filter(Boolean).join("  ·  ");
        titleEl.textContent = p.title;
        heroImg.src = p.hero; heroImg.alt = p.title;
        contentEl.innerHTML = "";
        const tpl = document.querySelector('template[data-post="' + (window.CSS && CSS.escape ? CSS.escape(slug) : slug) + '"]');
        if (tpl && tpl.content) contentEl.appendChild(tpl.content.cloneNode(true));
        return true;
      }
      function openReader(slug, imgEl) {
        if (isOpen || !populate(slug)) return;
        isOpen = true;
        scrollLockY = window.scrollY || window.pageYOffset || 0;
        document.body.style.top = "-" + scrollLockY + "px";
        document.body.classList.add("reader-locked");
        reader.hidden = false; reader.scrollTop = 0; contentEl.scrollTop = 0;
        const rcol = reader.querySelector(".reader-col"); if (rcol) rcol.scrollTop = 0;

        if (reduce || !imgEl) { requestAnimationFrame(() => reader.classList.add("is-open")); return; }
        const s = imgEl.getBoundingClientRect();
        const p = data[slug];
        const frame = reader.querySelector(".reader-frame");
        frame.style.transition = "none"; frame.style.transform = "none";
        const t = frameHero.getBoundingClientRect();
        frame.style.transform = ""; frame.getBoundingClientRect(); frame.style.transition = "";
        fly.src = p.hero; fly.style.transition = "none"; fly.style.transformOrigin = "50% 50%";
        fly.style.transform = "rotate(-5deg)"; fly.style.opacity = "1";
        fly.style.left = s.left + "px"; fly.style.top = s.top + "px";
        fly.style.width = s.width + "px"; fly.style.height = s.height + "px";
        frameHero.style.opacity = "0"; fly.getBoundingClientRect();
        requestAnimationFrame(() => {
          reader.classList.add("is-open");
          fly.style.transition = "left .74s cubic-bezier(.16,.84,.3,1), top .74s cubic-bezier(.16,.84,.3,1), width .74s cubic-bezier(.16,.84,.3,1), height .74s cubic-bezier(.16,.84,.3,1), transform .74s cubic-bezier(.16,.84,.3,1), opacity .3s ease";
          fly.style.left = t.left + "px"; fly.style.top = t.top + "px";
          fly.style.width = t.width + "px"; fly.style.height = t.height + "px";
          fly.style.transform = "rotate(0deg)";
        });
        clearTimeout(flyTimer);
        flyTimer = setTimeout(() => { if (!isOpen) return; frameHero.style.opacity = "1"; fly.style.opacity = "0"; }, 760);
      }
      function closeReader() {
        if (!isOpen) return; isOpen = false; clearTimeout(flyTimer);
        reader.classList.remove("is-open"); fly.style.opacity = "0";
        document.body.classList.remove("reader-locked"); document.body.style.top = "";
        window.scrollTo(0, scrollLockY);
        setTimeout(() => { if (!isOpen) { reader.hidden = true; contentEl.innerHTML = ""; } }, 540);
      }

      // Any element with a data-slug opens the reader (featured card + grid tiles).
      document.addEventListener("click", function (e) {
        const el = e.target.closest("[data-slug]");
        if (!el) return;
        const img = el.querySelector("img");
        openReader(el.getAttribute("data-slug"), img);
      });
      closeBtn.addEventListener("click", closeReader);
      reader.addEventListener("click", function (e) { if (e.target === reader) closeReader(); });
      document.addEventListener("keydown", function (e) {
        if (e.key !== "Escape") return;
        if (isOpen) closeReader(); else if (arcOpen) closeArc(true);
      });
    })();
  </script>
</BaseLayout>
