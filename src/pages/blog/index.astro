---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import { getPublishedPosts } from "../../data/blog.js";

// Pulled from Supabase if configured, otherwise the static fallback.
const allPosts = await getPublishedPosts();
// The client archived 7 seed posts (added in PR #201) — exclude them so only the
// real blogs show. On the live site the admin/Supabase drives the list and these
// slugs aren't there, so this filter is a harmless no-op.
const ARCHIVED_SEED = new Set([
  "hyperlocal-facebook-groups-win-instructions",
  "the-follow-method-done-properly",
  "how-long-to-build-a-property-following",
  "five-video-editing-tools-for-estate-agents",
  "filming-a-property-walkthrough-on-your-phone",
  "the-reviews-engine-google-business-profile",
  "showing-up-offline-local-events",
]);
const posts = [...allPosts].filter((p) => !ARCHIVED_SEED.has(p.slug)).sort((a, b) => (a.date < b.date ? 1 : -1));

const featured = posts[0] || null;     // newest = featured (auto)
const archivePosts = posts.slice(1);   // everything else

function fmtDate(iso) {
  if (!iso) return "";
  const d = new Date(iso);
  if (isNaN(d)) return "";
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}

// Decorative, NON-article tiles = the client's 16 static photos (R2 "Blog Static
// Images/1–16.png"). Originals are large PNGs, so optimise each (downscale +
// crop to the 3:4 tile + WebP) so the grid stays light. Articles themselves
// carry NO photo until hovered (see the grid markup) — only these change.
const STATIC_POOL = await Promise.all(
  Array.from({ length: 16 }, (_, i) =>
    getImage({
      src: `https://assets.tmke.co.uk/Blog%20Static%20Images/${i + 1}.png`,
      width: 700, height: 933, quality: 72, format: "webp",
    }).then((r) => r.src)
  )
);

// 6-col grid: exactly 2 articles + 4 stock photos per row, articles scattered.
// Rows are only created while articles remain — no image-only rows, no padding.
const COLS = 6;
const ROW_POST_COLS = [[0, 3], [2, 5], [1, 4], [0, 4], [2, 3], [1, 5]];
const gridItems = [];
let pi = 0, gi = 0;
for (let r = 0; pi < archivePosts.length; r++) {
  const cols = ROW_POST_COLS[r % ROW_POST_COLS.length];
  for (let c = 0; c < COLS; c++) {
    if (cols.includes(c) && pi < archivePosts.length) {
      const p = archivePosts[pi++];
      gridItems.push({ type: "post", post: p, num: String(pi).padStart(2, "0") });
    } else {
      gridItems.push({ type: "image", img: STATIC_POOL[gi++ % STATIC_POOL.length] });
    }
  }
}

// Lite data for the reader (full bodies embedded as <template>s below).
const lite = posts.map((p) => ({
  slug: p.slug, title: p.title, eyebrow: p.eyebrow || p.category || "",
  date: fmtDate(p.date), readTime: p.readTime || null, hero: p.hero,
  stand: p.standfirst || "", styles: p.styles || {},
}));
// The reader re-reads the published article when it opens, as the article
// page does: the site is built ahead, so saved edits would otherwise wait for
// the next deploy. The anon key is public, the same one the build reads with.
const sbCfg = { url: import.meta.env.PUBLIC_SUPABASE_URL || "", key: import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "" };
const featMeta = featured
  ? [featured.eyebrow || featured.category, fmtDate(featured.date), featured.readTime ? featured.readTime + " min read" : ""].filter(Boolean).join("  ·  ")
  : "";
---

<BaseLayout
  title="Insights — TMKE"
  description="Structured insights on social media, brand positioning, content systems, and the future of estate agency marketing — written for UK property professionals."
  hideFooter
>
  <section class="ins" data-lenis-prevent>
    <!-- One horizontal rail: home (intro + featured) then the archive grid.
         Scroll drags the rail left — the home is pushed off and the grid (led
         by its first column, the 3 images peeking on the right) comes across. -->
    <div class="ins-rail" id="ins-rail">

      <!-- ===== Home: intro + featured ===== -->
      <div class="ins-home">
        <!-- The board. Its title and standfirst are embossed into the artwork
             rather than set in live type. The link at the foot turns the board
             over: the emboss fades off to the blank board and the membership
             pitch comes up in its place. -->
        <div class="ins-intro" id="ins-intro">
          <span class="ins-eyebrow">Insights</span>

          <button type="button" class="ins-unlock" id="ins-unlock">
            Discover our exclusive blogs <span aria-hidden="true">&rsaquo;</span>
          </button>

          <div class="ins-member" id="ins-member" hidden>
            <button type="button" class="ins-member-x" id="ins-member-x" aria-label="Back">&times;</button>
            <p class="ins-member-lede">Become a member, free, for exclusive TMKE blog content and training courses.</p>
            <form class="ins-member-form" id="ins-join" novalidate>
              <label class="ins-field"><span>Full name</span>
                <input type="text" name="full_name" autocomplete="name" required placeholder="Jane Smith" /></label>
              <label class="ins-field"><span>Email</span>
                <input type="email" name="email" autocomplete="email" required placeholder="you@agency.co.uk" /></label>
              <label class="ins-field"><span>Password</span>
                <input type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="At least 8 characters" /></label>
              <label class="ins-check">
                <input type="checkbox" name="marketing" />
                <span>Keep me updated with tips, guides and offers. Unsubscribe anytime.</span>
              </label>
              <button type="submit" class="ins-join-btn"><span data-label>Join</span> <span aria-hidden="true">&rarr;</span></button>
              <p class="ins-join-err" id="ins-join-err" hidden></p>
            </form>
            <div class="ins-join-done" id="ins-join-done" hidden>
              <p class="ins-member-lede">Check your inbox. We&rsquo;ve sent a confirmation link &mdash; open it in this browser to activate your account.</p>
            </div>
            <p class="ins-member-alt">Already a member? <a href="/login">Sign in here</a></p>
          </div>
        </div>

        <div class="ins-feature">
          <span class="ins-label">Featured Article</span>
          <!-- Picture first, so its top edge starts on the same line as the first
               tile of the archive beside it; then the title, then the meta and
               the standfirst (Dani, 7 Oct). -->
          {featured && (
            <button class="ins-feature-card" type="button" data-slug={featured.slug}>
              <span class="ins-feature-media"><img src={featured.hero} alt={featured.title} loading="eager" /></span>
              <span class="ins-feature-headline">
                {/* Category eyebrow removed — it's already shown in the meta line
                    under the picture (avoids the duplicate above the title). */}
                <span class="ins-feature-title">{featured.title}</span>
              </span>
              <span class="ins-feature-foot">
                <span class="ins-feature-meta">{featMeta}</span>
                <span class="ins-feature-stand">{featured.standfirst}</span>
              </span>
            </button>
          )}
        </div>
      </div>

      <!-- ===== Archive: the draggable grid, led by the 3 images ===== -->
      <div class="ins-archive" id="ins-archive">
        <span class="ins-label arc-title">Article Archive</span>
        <div class="arc-scroll" id="arc-scroll" data-lenis-prevent>
          <div class="arc-grid">
          {gridItems.map((it) => (
            it.type === "post" ? (
              <button class="arc-tile arc-tile--post" type="button" data-slug={it.post.slug}>
                <span class="arc-tile-img"><img src={it.post.hero} alt={it.post.title} loading="lazy" /></span>
                <span class="arc-tile-cap">
                  <span class="arc-tile-num">Article {it.num}</span>
                  <span class="arc-tile-name">{it.post.title}</span>
                </span>
              </button>
            ) : (
              <div class="arc-tile arc-tile--image" style={`background-image:url('${it.img}')`}></div>
            )
          ))}
          </div>
        </div>
      </div>
    </div>

    <!-- "back to home" appears once the grid is dragged in -->
    <button class="arc-back" id="arc-back" type="button" aria-label="Back">&times;</button>
  </section>

  <!-- ===== Reader — opens in-frame over everything ===== -->
  <div class="reader" id="reader" hidden>
    <button class="reader-x" id="reader-x" type="button" aria-label="Close">&times;</button>
    <div class="reader-frame" role="dialog" aria-modal="true" aria-labelledby="reader-title">
      <div class="reader-hero" id="reader-hero"><img id="reader-hero-img" src="" alt="" /></div>
      <div class="reader-col" data-lenis-prevent>
        <div class="reader-meta" id="reader-meta"></div>
        <h2 class="reader-title" id="reader-title"></h2>
        <p class="reader-stand" id="reader-stand"></p>
        <!-- Who wrote it and when, with sharing: the same strip as the article page. -->
        <div class="reader-by">
          <div class="reader-by-author">
            <span class="reader-avatar" aria-hidden="true">TMKE</span>
            <div>
              <div class="reader-by-name">The TMKE Desk</div>
              <div class="reader-by-date" id="reader-date"></div>
            </div>
          </div>
          <div class="reader-share">
            <button type="button" class="reader-share-btn" id="reader-copy">Copy link</button>
            <a class="reader-share-btn" id="reader-tweet" target="_blank" rel="noopener" href="#">Share</a>
          </div>
        </div>
        <style is:inline id="reader-style"></style>
        <div class="reader-content" id="reader-content"></div>
      </div>
    </div>
  </div>

  <img class="flow-fly" id="flow-fly" alt="" aria-hidden="true" />

  {posts.map((p) => (<template data-post={p.slug} set:html={p.body}></template>))}
  <script type="application/json" id="flow-data" set:html={JSON.stringify(lite)}></script>
  <script type="application/json" id="reader-sb" set:html={JSON.stringify(sbCfg)}></script>

  <style>
    /* Insights carries the mark and the menu only (Dani, 5 Oct). */
    :global(.nav-cta) { display: none; }
    /* ============ Insights — drag-across archive ============ */
    .ins {
      /* How much of the grid peeks at rest — and it sets where the archive starts,
         so it's what aligns the first cards with the nav's members button.
         232 = that button's fixed 212px offset from the right edge + the archive's own
         20px left pad, so the first card's left edge lands exactly on the button's at
         EVERY width. Two things had to be true for this to hold: the button is now one
         width in both signed-in states (see .nav-cta in global.css — it used to grow
         19px for "Members"), and the peek is a fixed px rather than the old
         clamp(150px, 16vw, 224px), which was a percentage of the viewport and so
         drifted out of alignment as you resized. */
      --peek: 232px;
      --arc-inset: clamp(68px, 9vh, 100px); /* archive band TOP — aligned with the labels (clears the nav) */
      --arc-bottom: clamp(36px, 5.5vh, 80px); /* archive band BOTTOM — matches the home text bottom margin (seamless) */
      --hairline: rgba(28,29,34,0.16);      /* the featured-article rule: reused for the archive line + tile outlines */
      position: relative; height: 100vh; overflow: hidden;
      background: var(--paper); color: var(--ink);
    }
    .ins-rail { display: flex; height: 100%; will-change: transform; }

    .ins-label, .ins-eyebrow {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--english-violet);
    }

    /* ----- Home panel ----- */
    .ins-home {
      flex: 0 0 calc(100vw - var(--peek)); height: 100%; box-sizing: border-box;
      display: grid; grid-template-columns: minmax(0, 1.18fr) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr); gap: clamp(28px, 3.4vw, 60px);
      /* Right padding 21px = the second rule's 20px of air + its own 1px, so the
         featured pulls left just enough for the line to sit between it and the
         archive with 20px either side (the archive's own 20px left pad is the
         other half). */
      /* Left edge tracks the About/SMM 1360 content wrap so the intro starts at
         the same x as every other page. Measured rather than reasoned: those
         pages centre a 1360 container and start their hero text at its EDGE
         (.about-lede-wrap has no inner padding), so adding .wrap's 76px on top
         here pushed Insights a full step right of everywhere else on a wide
         screen. Below 1360 the container stops shrinking and 76px takes over,
         which is the same inset the narrow layouts use.
         Bigger bottom pad lifts the title + shrinks the featured image a touch. */
      padding: clamp(68px, 9vh, 100px) 21px clamp(36px, 5.5vh, 80px) var(--page-gutter);
    }
    /* The intro is a wine panel — the one block of colour on a page that was
       paper on paper top to bottom. Its own padding, because the panel's edge
       is now a visible edge rather than the page's. */
    /* ---- The board ----
       Two pieces of artwork, same 1600x2000 board, same #371e28 ground: one
       with NOTES FROM THE DESK blind-embossed into it, one blank. They are
       stacked and cross-faded, so turning the board over is one transition
       rather than a swap. The violet behind them is that same colour again, so
       nothing flashes while they load. The title and the standfirst used to be
       live type here; they are in the emboss now (Dani, 7 Oct). */
    .ins-intro {
      position: relative; overflow: hidden; min-width: 0;
      display: flex; flex-direction: column; justify-content: space-between;
      background: var(--english-violet); color: var(--paper);
      padding: 21px; border-radius: 2px;
    }
    .ins-intro::before, .ins-intro::after {
      content: ""; position: absolute; inset: 0; z-index: 0;
      background-size: cover; background-position: center;
      transition: opacity 0.6s ease;
    }
    .ins-intro::before { background-image: url("/images/insights-board-emboss.webp"); opacity: 1; }
    .ins-intro::after  { background-image: url("/images/insights-board-blank.webp"); opacity: 0; }
    .ins-intro.is-member::before { opacity: 0; }
    .ins-intro.is-member::after  { opacity: 1; }
    .ins-intro > * { position: relative; z-index: 1; }
    .ins-intro .ins-eyebrow { color: rgba(244,242,241,0.62); }

    /* The way in, at the foot of the board, in the Insights eyebrow's own type. */
    .ins-unlock {
      align-self: center; display: inline-flex; align-items: center; gap: 9px;
      appearance: none; background: none; border: 0; padding: 10px 2px; cursor: pointer;
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(244,242,241,0.78); transition: color 0.25s ease, gap 0.25s ease;
    }
    .ins-unlock:hover { color: var(--paper); gap: 15px; }
    /* Faded, not display:none — the board and the words on it have to move as
       one thing, and something that is not there cannot fade (Dani, 7 Oct).
       It keeps its place in the layout so nothing jumps either. */
    .ins-eyebrow, .ins-unlock { transition: opacity 0.35s ease; }
    .ins-intro.is-quiet .ins-eyebrow,
    .ins-intro.is-quiet .ins-unlock { opacity: 0; pointer-events: none; }

    /* ---- The membership pitch, once the board has turned over ---- */
    .ins-member {
      margin: auto 0; display: flex; flex-direction: column; gap: 14px;
      opacity: 0; transition: opacity 0.3s ease;
    }
    .ins-member.is-on { opacity: 1; }
    /* display:flex beats the browser's own [hidden] rule, so this has to say so
       or the join form is on screen from the moment the page loads. */
    .ins-member[hidden], .ins-member-form[hidden] { display: none; }
    .ins-member-x {
      position: absolute; top: 0; right: 0; z-index: 2;
      appearance: none; background: none; border: 0; padding: 4px 6px; cursor: pointer;
      font-size: 20px; line-height: 1; color: rgba(244,242,241,0.6);
    }
    .ins-member-x:hover { color: var(--paper); }
    .ins-member-lede {
      /* Right pad clears the close control, which sits in this block's own
         top-right corner — it was landing on the second line. */
      margin: 0; padding-right: 30px;
      font-family: var(--sans); font-size: clamp(14px, 1.1vw, 16px);
      line-height: 1.55; color: rgba(244,242,241,0.88); max-width: 36ch;
    }
    .ins-member-form { display: flex; flex-direction: column; gap: 11px; }
    .ins-field[hidden] { display: none; }
    .ins-field { display: flex; flex-direction: column; gap: 5px; }
    .ins-field > span {
      font-family: var(--sans); font-size: 10px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: rgba(244,242,241,0.55);
    }
    .ins-field input {
      appearance: none; background: none; border: 0;
      border-bottom: 1px solid rgba(244,242,241,0.3);
      padding: 7px 0; color: var(--paper);
      font-family: var(--sans); font-size: 14px;
    }
    .ins-field input::placeholder { color: rgba(244,242,241,0.35); }
    .ins-field input:focus { outline: none; border-bottom-color: var(--paper); }
    .ins-check {
      display: flex; align-items: flex-start; gap: 9px; margin-top: 2px;
      font-family: var(--sans); font-size: 12px; line-height: 1.45; color: rgba(244,242,241,0.6);
    }
    .ins-check input { margin: 2px 0 0; accent-color: var(--paper); }
    .ins-join-btn {
      align-self: flex-start; margin-top: 6px; display: inline-flex; align-items: center; gap: 10px;
      appearance: none; border: 0; cursor: pointer;
      background: var(--paper); color: var(--english-violet);
      padding: 11px 24px; border-radius: 2px;
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; transition: opacity 0.25s;
    }
    .ins-join-btn:hover { opacity: 0.85; }
    .ins-join-btn[disabled] { opacity: 0.55; cursor: default; }
    .ins-join-err {
      margin: 0; font-family: var(--sans); font-size: 12.5px; line-height: 1.45; color: #f2c6c6;
    }
    .ins-join-err a { color: var(--paper); text-decoration: underline; }
    .ins-member-alt {
      margin: 2px 0 0; font-family: var(--sans); font-size: 12.5px; color: rgba(244,242,241,0.6);
    }
    .ins-member-alt a { color: var(--paper); text-decoration: underline; text-underline-offset: 3px; }

    .ins-feature { position: relative; display: flex; flex-direction: column; gap: 14px; min-width: 0; }
    /* The featured column is bracketed by two full-height rules: one sectioning it
       off from the title, one from the archive. Each runs the whole screen, not just
       the column — the top offset cancels .ins-home's padding-top (so they start at
       the screen edge) and 100vh carries them to the bottom; .ins clips, so they
       can't spill. Same hairline as the rule under the featured article and the
       archive, so all four read as one set. */
    .ins-feature::before,
    .ins-feature::after {
      content: ""; position: absolute; z-index: 0; pointer-events: none;
      width: 1px;
      top: calc(-1 * clamp(68px, 9vh, 100px));
      height: 100vh;
      background: var(--hairline);
    }
    .ins-feature::before { left: -20px; }
    /* 20px of air on the featured's side; the archive's own 20px left pad is the
       other side, so the line sits centred in a 41px channel. */
    .ins-feature::after { left: calc(100% + 20px); }
    .ins-feature-card {
      flex: 1; min-height: 0; -webkit-appearance: none; appearance: none; border: 0; background: none;
      padding: 0; margin: 0; text-align: left; cursor: pointer; color: var(--ink);
      display: flex; flex-direction: column; gap: clamp(12px, 1.6vh, 22px);
      border-top: 1px solid var(--hairline); padding-top: clamp(14px, 1.8vh, 22px);
    }
    .ins-feature-headline { display: flex; flex-direction: column; gap: 4px; }
    .ins-feature-eyebrow {
      font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--english-violet);
    }
    /* Darker Grotesque at its own natural tracking, not the heading face
       with a negative one (Dani, 7 Oct). */
    .ins-feature-title {
      font-family: var(--sans); font-weight: 400; font-size: clamp(22px, 2.1vw, 32px);
      line-height: 1.08; letter-spacing: normal; color: var(--ink);
    }
    .ins-feature-media {
      flex: 1; min-height: 0; display: block; overflow: hidden; border-radius: 3px; background: rgba(28,29,34,0.05);
    }
    .ins-feature-media img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 1.2s cubic-bezier(.2,.7,.2,1);
    }
    .ins-feature-card:hover .ins-feature-media img { transform: scale(1.035); }
    .ins-feature-foot { display: flex; flex-direction: column; gap: 6px; }
    .ins-feature-meta {
      font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em;
      text-transform: uppercase; color: rgba(28,29,34,0.45);
    }
    .ins-feature-stand {
      font-family: var(--sans); font-size: clamp(12.5px, 1vw, 14px); line-height: 1.5;
      color: rgba(28,29,34,0.72); max-width: none; text-align: justify;   /* full image width, justified */
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }

    /* ----- Archive panel (the grid) ----- */
    .ins-archive {
      flex: 0 0 100vw; box-sizing: border-box;
      /* inset band: top margin = bottom margin, top aligned with the Insights /
         Featured-article labels, so the grid clears the nav (login/menu) and its
         content never scrolls up underneath it. Laid out like the featured column:
         a label, then a hairline rule, then the grid. */
      align-self: flex-start; margin-top: var(--arc-inset);
      height: calc(100% - var(--arc-inset) - var(--arc-bottom));   /* bottom comes down to the home text margin */
      display: flex; flex-direction: column; gap: 14px;
      /* Left pad IS the gap between the featured article and the first cards. It
         matched the 6px card gap, which read as cramped against a full-height
         featured column. */
      padding: 0 10px 0 20px;
    }
    /* "Article Archive" label — on from the start, sitting above the first cards
       like every other label on the page. */
    .arc-title { flex: 0 0 auto; opacity: 1; }
    .arc-scroll {
      flex: 1 1 auto; min-height: 0;
      overflow-y: auto; overflow-x: hidden; overscroll-behavior: contain;
      scrollbar-width: none; -ms-overflow-style: none;   /* scrollable, but no visible scrollbar */
      border-top: 1px solid var(--hairline);            /* same line as under the featured article */
      padding-top: clamp(14px, 1.8vh, 22px);
    }
    .arc-scroll::-webkit-scrollbar { width: 0; height: 0; display: none; }
    .arc-grid {
      display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px;
      grid-auto-flow: row dense; align-content: start;
    }
    @media (max-width: 1200px) { .arc-grid { grid-template-columns: repeat(4, 1fr); } }

    .arc-tile { position: relative; aspect-ratio: 3 / 4; overflow: hidden; border-radius: 2px; }

    /* Lead tiles — the 3 images: hero shown, caption over a soft gradient. */
    .arc-tile--lead {
      -webkit-appearance: none; appearance: none; border: 0; padding: 0; margin: 0;
      text-align: left; cursor: pointer; color: var(--paper); background-color: rgba(28,29,34,0.06);
    }
    .arc-tile--lead img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .arc-tile--lead::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(180deg, rgba(20,18,22,0) 42%, rgba(20,18,22,0.74) 100%);
    }
    .arc-tile--lead .arc-tile-num { color: rgba(244,242,240,0.8); }
    .arc-tile--lead .arc-tile-name { color: var(--paper); }

    /* Post tiles — off-white box, title bottom-left; hover reveals the image. */
    .arc-tile--post {
      -webkit-appearance: none; appearance: none; box-sizing: border-box;
      border: 1px solid var(--hairline);   /* same weight/colour as the featured-article rule */
      text-align: left; cursor: pointer;
      background: var(--paper); color: var(--english-violet);
    }
    .arc-tile-img { position: absolute; inset: 0; opacity: 0; transition: opacity 0.5s ease; }
    .arc-tile-img img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .arc-tile-img::after {
      content: ""; position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(20,18,22,0) 38%, rgba(20,18,22,0.72) 100%);
    }
    .arc-tile--post:hover .arc-tile-img { opacity: 1; }

    .arc-tile-cap {
      position: absolute; left: 14px; right: 14px; bottom: 14px; z-index: 2;
      display: flex; flex-direction: column; gap: 4px;
    }
    .arc-tile-num {
      font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--english-violet); transition: color 0.4s ease;
    }
    /* Regular, the same weight as the featured article's title — these were
       SemiBold, so the small cards read heavier than the big one (Dani, 7 Oct). */
    .arc-tile-name {
      font-family: var(--sans); font-weight: 400; font-size: 16px;
      line-height: 1.12; letter-spacing: -0.005em; color: var(--english-violet); transition: color 0.4s ease;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .arc-tile--post:hover .arc-tile-num { color: rgba(244,242,240,0.75); }
    .arc-tile--post:hover .arc-tile-name { color: var(--paper); }

    .arc-tile--image { background-size: cover; background-position: center; background-color: rgba(28,29,34,0.06); }

    /* Back-to-home control (appears once the grid is dragged in) */
    .arc-back {
      /* top-right; the bottom of the circle sits in line with the bottom of the
         "Article Archive" label (label top = --arc-inset, ~17px tall, X is 32px). */
      position: fixed; top: calc(var(--arc-inset) - 15px); right: clamp(16px, 3vw, 34px); z-index: 160;
      width: 32px; height: 32px; border-radius: 50%; border: 1px solid rgba(28,29,34,0.2);
      background: var(--paper); color: var(--ink); font-size: 19px; line-height: 1; cursor: pointer;
      display: grid; place-items: center; opacity: 0; pointer-events: none;
      transition: opacity 0.3s ease, background 0.25s, color 0.25s, transform 0.4s;
    }
    .arc-back:hover { background: var(--ink); color: var(--paper); transform: rotate(90deg); }

    /* ============ Flying clone + reader (reused) ============ */
    .flow-fly {
      position: fixed; z-index: 260; object-fit: cover; border-radius: 4px;
      opacity: 0; pointer-events: none; will-change: left, top, width, height;
      box-shadow: 0 40px 110px -30px rgba(0,0,0,0.45);
    }
    :global(body.reader-locked) { position: fixed; left: 0; right: 0; width: 100%; overflow: hidden; }
    /* While reading an article, strip the nav back to just the menu (drop the logo
       and the login control) so the reader feels like a focused pop-out. */
    :global(body.reader-locked .nav-logo),
    :global(body.reader-locked #nav-login) { display: none; }
    /* Same idea on the archive, but a fade rather than a cut — you drag into it. */
    :global(.nav-logo) { transition: opacity 0.3s ease; }
    :global(body.arc-across .nav-logo) { opacity: 0; pointer-events: none; }

    .reader {
      position: fixed; inset: 0; z-index: 250; display: grid; place-items: center;
      padding: clamp(20px, 4vh, 56px);
      background: rgba(244,242,240,0); backdrop-filter: blur(0px);
      transition: background 0.45s ease, backdrop-filter 0.45s ease;
    }
    .reader[hidden] { display: none; }
    .reader.is-open { background: rgba(244,242,240,0.5); backdrop-filter: blur(6px); }
    .reader-frame {
      width: min(1060px, 94vw); height: 88vh;
      display: grid; grid-template-columns: minmax(0, 0.74fr) minmax(0, 1fr);
      grid-template-rows: minmax(0, 1fr); gap: clamp(26px, 3vw, 56px);
      background: var(--paper, #fff); border-radius: 6px; padding: clamp(22px, 2.6vw, 44px);
      box-shadow: 0 50px 130px -36px rgba(0,0,0,0.5); overflow: hidden;
      opacity: 0; transform: scale(0.58); transform-origin: 26% 46%;
      transition: opacity 0.46s ease, transform 0.74s cubic-bezier(.16,.84,.3,1);
    }
    .reader.is-open .reader-frame { opacity: 1; transform: scale(1); }
    .reader-hero { height: 100%; overflow: hidden; border-radius: 4px; background: rgba(28,29,34,0.06); }
    .reader-hero img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .reader-col {
      min-width: 0; min-height: 0; height: 100%; overflow-y: auto; overscroll-behavior: contain; padding-right: 6px;
      opacity: 0; transform: translateY(10px);
      transition: opacity 0.5s ease 0.2s, transform 0.6s cubic-bezier(.2,.7,.2,1) 0.2s;
    }
    .reader.is-open .reader-col { opacity: 1; transform: none; }
    .reader-meta { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--english-violet); margin-bottom: 14px; }
    .reader-title { font-family: var(--serif); font-weight: 400; font-size: clamp(26px, 2.6vw, 40px); line-height: 1.06; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 16px; }
    .reader-stand { font-family: var(--sans); font-size: 17px; font-weight: 400; line-height: 1.45; color: rgba(28,29,34,0.66); margin: 0 0 24px; }
    .reader-stand:empty { display: none; }
    .reader-by { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px; padding: 16px 0; border-top: 1px solid rgba(28,29,34,0.12); border-bottom: 1px solid rgba(28,29,34,0.12); margin: 0 0 30px; }
    .reader-by-author { display: flex; align-items: center; gap: 12px; }
    .reader-avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--english-violet); color: var(--paper); display: inline-flex; align-items: center; justify-content: center; font-family: var(--serif); font-size: 10px; letter-spacing: 0.06em; font-weight: 500; flex: none; }
    .reader-by-name { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); }
    .reader-by-date { font-family: var(--sans); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .reader-share { display: flex; gap: 8px; }
    .reader-share-btn { padding: 8px 14px; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; background: transparent; border: 1px solid rgba(28,29,34,0.18); color: var(--ink); border-radius: 999px; cursor: pointer; text-decoration: none; line-height: 1.2; }
    .reader-share-btn:hover { background: rgba(28,29,34,0.06); border-color: rgba(28,29,34,0.4); }
    .reader-content { font-family: var(--sans); font-size: 15.5px; line-height: 1.66; color: rgba(28,29,34,0.82); }
    .reader-content :global(h2) { font-family: var(--serif); font-weight: 400; font-size: 21px; line-height: 1.2; color: var(--ink); margin: 26px 0 10px; letter-spacing: -0.01em; }
    .reader-content :global(p) { margin: 0 0 14px; }
    .reader-content :global(p.lede) { font-size: 17px; color: var(--ink); }
    .reader-content :global(ul) { margin: 0 0 16px; padding-left: 20px; }
    .reader-content :global(li) { margin: 0 0 7px; }
    .reader-content :global(blockquote) { margin: 22px 0; padding: 4px 0 4px 20px; border-left: 2px solid var(--english-violet); font-family: var(--serif); font-style: italic; font-size: 18px; color: var(--ink); }
    .reader-content :global(strong) { color: var(--ink); }
    .reader-x {
      position: fixed; top: clamp(16px, 3vh, 30px); right: clamp(16px, 3vw, 34px); z-index: 270;
      width: 48px; height: 48px; border-radius: 50%; border: 0; background: var(--ink); color: var(--paper);
      font-size: 24px; line-height: 1; display: grid; place-items: center; cursor: pointer;
      opacity: 0; transform: scale(0.8); transition: opacity 0.4s ease 0.15s, transform 0.4s ease 0.15s, background 0.2s;
    }
    .reader.is-open .reader-x { opacity: 1; transform: none; }
    .reader-x:hover { background: var(--english-violet); }

    /* ============ Responsive — mobile stacks, no drag ============ */
    @media (max-width: 1000px) {
      .ins { height: auto; overflow: visible; }
      /* One column here, so there's nothing either side to section off — and .ins
         stops clipping, so a 100vh rule would hang off the stack. */
      .ins-feature::before, .ins-feature::after { display: none; }
      .ins-rail { flex-direction: column; transform: none !important; height: auto; }
      .ins-home { flex: none; width: 100%; height: auto; min-height: 90vh; grid-template-columns: 1fr; gap: 40px; padding: 90px 24px 48px; }
      .ins-archive { flex: none; width: 100%; height: auto; overflow: visible; margin-top: 0; }
      .arc-scroll { overflow: visible; }
      .arc-title { opacity: 1; }
      .arc-grid { grid-template-columns: repeat(2, 1fr); }
      .arc-tile--lead { grid-column: auto !important; grid-row: auto !important; }
      .arc-back { display: none; }
    }
    @media (max-width: 600px) {
      .arc-tile { aspect-ratio: 3 / 2; }
      /* The featured article without its picture on a phone. */
      .ins-feature-media { display: none; }
    }
    @media (max-width: 760px) {
      .reader-frame { grid-template-columns: minmax(0,1fr); grid-template-rows: auto minmax(0,1fr); height: auto; max-height: 90vh; gap: 20px; }
      .reader-hero { height: auto; aspect-ratio: 16 / 10; }
    }
    @media (prefers-reduced-motion: reduce) {
      .reader, .reader-frame, .flow-fly, .reader-x { transition: none !important; animation: none !important; opacity: 1 !important; transform: none !important; }
    }
  </style>

  <script is:inline>
    (function () {
      const reader = document.getElementById("reader");
      const heroImg = document.getElementById("reader-hero-img");
      const frameHero = document.getElementById("reader-hero");
      const metaEl = document.getElementById("reader-meta");
      const titleEl = document.getElementById("reader-title");
      const contentEl = document.getElementById("reader-content");
      const closeBtn = document.getElementById("reader-x");
      const fly = document.getElementById("flow-fly");
      if (!reader || !heroImg) return;

      let data = {};
      try { data = (JSON.parse(document.getElementById("flow-data").textContent || "[]") || []).reduce((m, p) => (m[p.slug] = p, m), {}); } catch (_) {}
      const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // ----- Drag the archive across (single transform, tracks the scroll) -----
      // No reveal animation: the rail's position follows the scroll directly, so
      // it feels like dragging the grid across. A light follow smooths the steps
      // between mouse-wheel notches; it doesn't add a separate slide.
      const ins = document.querySelector(".ins");
      const rail = document.getElementById("ins-rail");
      const archive = document.getElementById("arc-scroll");   // the grid's vertical scroll container
      const backBtn = document.getElementById("arc-back");
      const desktop = window.matchMedia("(min-width: 1001px)");
      const DRAG = 1100;                  // wheel px to drag fully across
      let prog = 0, progTarget = 0, maxShift = 0;
      let isOpen = false;                 // reader state (read by the wheel handler)

      function measure() { maxShift = rail ? (rail.scrollWidth - ins.clientWidth) : 0; }
      measure();
      window.addEventListener("resize", measure);
      function setProg(v) { progTarget = Math.min(1, Math.max(0, v)); }

      function paint() {
        if (!rail) return;
        if (!desktop.matches) { rail.style.transform = ""; return; }
        rail.style.transform = "translate3d(" + (-prog * maxShift).toFixed(1) + "px,0,0)";
        if (backBtn) {
          const on = prog > 0.6;
          backBtn.style.opacity = on ? "1" : "0";
          backBtn.style.pointerEvents = on ? "auto" : "none";
        }
        /* Across on the archive, the wordmark sits directly on top of the
           "Article Archive" label. It goes; the burger is the way out, and
           the X in the corner is the way back (Dani, 7 Oct). */
        document.body.classList.toggle("arc-across", prog > 0.6);
        // The "Article Archive" label used to fade in from prog 0.5, so it was
        // invisible until you'd dragged half way across — it now just sits above
        // the first cards from the start, so nothing drives its opacity.
      }
      (function raf() {
        prog += (progTarget - prog) * (reduce ? 1 : 0.3);   // tight follow = drag feel
        if (Math.abs(progTarget - prog) < 0.0006) prog = progTarget;
        paint();
        requestAnimationFrame(raf);
      })();

      // The same gesture that drags the grid across shouldn't also fling it to the
      // bottom. After it lands we LOCK the grid at the top and only release once the
      // scroll settles (a brief pause), so moving down needs a fresh, deliberate scroll.
      let gridLocked = false, settleTimer = 0;
      function onWheel(e) {
        if (!desktop.matches || isOpen) return;     // mobile = native scroll; reader open = let it scroll
        if (progTarget < 1) {                        // dragging across
          e.preventDefault();
          setProg(progTarget + e.deltaY / DRAG);
          if (archive) archive.scrollTop = 0;        // keep the grid pinned at the top during the drag
          if (progTarget >= 1) gridLocked = true;    // just landed → lock at the top
          return;
        }
        // fully across
        if (e.deltaY < 0 && archive && archive.scrollTop <= 0) {
          e.preventDefault();                        // at the top, scrolling up → drag it back
          gridLocked = false;
          setProg(progTarget + e.deltaY / DRAG);
          return;
        }
        if (gridLocked) {                            // hold at the top until the scroll pauses,
          e.preventDefault();                        // absorbing the carry-over momentum
          if (archive) archive.scrollTop = 0;
          clearTimeout(settleTimer);
          settleTimer = setTimeout(() => { gridLocked = false; }, 150);
          return;
        }
        // otherwise native vertical grid scroll
      }
      window.addEventListener("wheel", onWheel, { passive: false });
      if (backBtn) backBtn.addEventListener("click", () => { setProg(0); gridLocked = false; if (archive) archive.scrollTop = 0; });

      // ----- Reader -----
      let flyTimer = null, scrollLockY = 0;
      /* Each article's own typography (font, size, line height and
         paragraph spacing, set in the editor), scoped to the reader. Mirrors
         blogStyleCss in src/data/blog.js. The !important on spacing beats the
         margin:0 Word writes on every paragraph it pastes. */
      const standEl = document.getElementById("reader-stand");
      const dateEl = document.getElementById("reader-date");
      const styleEl = document.getElementById("reader-style");
      function readerCss(st) {
        const safe = (x) => String(x || "").replace(/[;{}<>"]/g, "").trim();
        const sel = { p: "#reader-content p", h2: "#reader-content h2", h3: "#reader-content h3", blockquote: "#reader-content blockquote", stand: "#reader-stand" };
        return Object.keys(sel).map((k) => {
          const v = (st || {})[k]; if (!v || typeof v !== "object") return "";
          const d = [];
          if (v.font) d.push("font-family:" + safe(v.font));
          if (v.size) d.push("font-size:" + safe(v.size));
          if (v.lh) d.push("line-height:" + safe(v.lh));
          if (k === "p" && /^(0|\d(\.\d+)?em)$/.test(v.gap || "")) d.push("margin:0 0 " + v.gap + " !important");
          return d.length ? sel[k] + "{" + d.join(";") + "}" : "";
        }).filter(Boolean).join("\n");
      }
      let readerSlug = null;
      function populate(slug) {
        const p = data[slug]; if (!p) return false;
        readerSlug = slug;
        metaEl.textContent = p.eyebrow || "";
        titleEl.textContent = p.title;
        standEl.textContent = p.stand || "";
        dateEl.textContent = [p.date, p.readTime ? p.readTime + " min read" : ""].filter(Boolean).join(" · ");
        document.getElementById("reader-tweet").href = "https://twitter.com/intent/tweet?text=" + encodeURIComponent(p.title) + "&url=" + encodeURIComponent(location.origin + "/blog/" + slug);
        styleEl.textContent = readerCss(p.styles);
        heroImg.src = p.hero; heroImg.alt = p.title;
        contentEl.innerHTML = "";
        const tpl = document.querySelector('template[data-post="' + (window.CSS && CSS.escape ? CSS.escape(slug) : slug) + '"]');
        if (tpl && tpl.content) contentEl.appendChild(tpl.content.cloneNode(true));
        refresh(slug);
        return true;
      }
      // The latest published version, patched in if it has changed since the build.
      let sb = {};
      try { sb = JSON.parse(document.getElementById("reader-sb").textContent || "{}") || {}; } catch (_) {}
      function refresh(slug) {
        if (!sb.url || !sb.key) return;
        fetch(sb.url.replace(/\/$/, "") + "/rest/v1/blog_posts?slug=eq." + encodeURIComponent(slug) + "&status=eq.published&limit=1&select=title,standfirst,body_html,body_styles,audience",
          { headers: { apikey: sb.key, Authorization: "Bearer " + sb.key } })
          .then((r) => (r.ok ? r.json() : null))
          .then((rows) => {
            const row = rows && rows[0];
            if (!row || !isOpen || readerSlug !== slug) return;
            if (row.audience && row.audience !== "public" && row.audience !== "both") return;
            if (row.title) titleEl.textContent = row.title;
            standEl.textContent = row.standfirst || "";
            styleEl.textContent = readerCss(row.body_styles);
            if (row.body_html && row.body_html.trim() && contentEl.innerHTML.trim() !== row.body_html.trim()) contentEl.innerHTML = row.body_html;
          })
          .catch(() => {});
      }
      document.getElementById("reader-copy").addEventListener("click", (e) => {
        const btn = e.currentTarget;
        if (!readerSlug || !navigator.clipboard) return;
        navigator.clipboard.writeText(location.origin + "/blog/" + readerSlug).then(() => {
          btn.textContent = "Copied ✓";
          setTimeout(() => { btn.textContent = "Copy link"; }, 1800);
        });
      });
      function openReader(slug, imgEl) {
        if (isOpen || !populate(slug)) return;
        isOpen = true;
        scrollLockY = window.scrollY || window.pageYOffset || 0;
        document.body.style.top = "-" + scrollLockY + "px";
        document.body.classList.add("reader-locked");
        reader.hidden = false; reader.scrollTop = 0; contentEl.scrollTop = 0;
        const rcol = reader.querySelector(".reader-col"); if (rcol) rcol.scrollTop = 0;

        if (reduce || !imgEl) { requestAnimationFrame(() => reader.classList.add("is-open")); return; }
        const s = imgEl.getBoundingClientRect();
        const p = data[slug];
        const frame = reader.querySelector(".reader-frame");
        frame.style.transition = "none"; frame.style.transform = "none";
        const t = frameHero.getBoundingClientRect();
        frame.style.transform = ""; frame.getBoundingClientRect(); frame.style.transition = "";
        fly.src = p.hero; fly.style.transition = "none"; fly.style.transformOrigin = "50% 50%";
        fly.style.transform = "rotate(-5deg)"; fly.style.opacity = "1";
        fly.style.left = s.left + "px"; fly.style.top = s.top + "px";
        fly.style.width = s.width + "px"; fly.style.height = s.height + "px";
        frameHero.style.opacity = "0"; fly.getBoundingClientRect();
        requestAnimationFrame(() => {
          reader.classList.add("is-open");
          fly.style.transition = "left .74s cubic-bezier(.16,.84,.3,1), top .74s cubic-bezier(.16,.84,.3,1), width .74s cubic-bezier(.16,.84,.3,1), height .74s cubic-bezier(.16,.84,.3,1), transform .74s cubic-bezier(.16,.84,.3,1), opacity .3s ease";
          fly.style.left = t.left + "px"; fly.style.top = t.top + "px";
          fly.style.width = t.width + "px"; fly.style.height = t.height + "px";
          fly.style.transform = "rotate(0deg)";
        });
        clearTimeout(flyTimer);
        flyTimer = setTimeout(() => { if (!isOpen) return; frameHero.style.opacity = "1"; fly.style.opacity = "0"; }, 760);
      }
      function closeReader() {
        if (!isOpen) return; isOpen = false; clearTimeout(flyTimer);
        reader.classList.remove("is-open"); fly.style.opacity = "0";
        document.body.classList.remove("reader-locked"); document.body.style.top = "";
        window.scrollTo(0, scrollLockY);
        setTimeout(() => { if (!isOpen) { reader.hidden = true; contentEl.innerHTML = ""; } }, 540);
      }

      // Any element with a data-slug opens the reader (featured + grid tiles).
      document.addEventListener("click", function (e) {
        const el = e.target.closest("[data-slug]");
        if (!el) return;
        const img = el.querySelector("img");
        openReader(el.getAttribute("data-slug"), img);
      });
      closeBtn.addEventListener("click", closeReader);
      reader.addEventListener("click", function (e) { if (e.target === reader) closeReader(); });
      document.addEventListener("keydown", function (e) {
        if (e.key !== "Escape") return;
        if (isOpen) closeReader();
        else if (progTarget > 0) { setProg(0); if (archive) archive.scrollTop = 0; }
      });
    })();
  </script>

  {/* Turning the board over, and the join it carries. A bundled module rather
      than is:inline so it can use the same signUpMember the /join page does —
      one signup path, one set of error messages. */}
  <script>
    import { signUpMember } from "../../lib/member-signup.js";

    const board = document.getElementById("ins-intro");
    const unlock = document.getElementById("ins-unlock");
    const member = document.getElementById("ins-member");
    const closeBtn = document.getElementById("ins-member-x");
    const form = document.getElementById("ins-join");
    const errEl = document.getElementById("ins-join-err");
    const doneEl = document.getElementById("ins-join-done");

    if (board && unlock && member && form) {
      const alt = member.querySelector(".ins-member-alt");

      /* Three beats each way, so the board and the words on it read as one
         thing rather than two that happen to overlap (Dani, 7 Oct).
         Out: the join goes first and quickly · then the emboss comes back ·
         and as it does, Insights and the link come back with it.
         In is the same three in reverse. */
      let busy = false;
      const open = () => {
        if (busy || board.classList.contains("is-member")) return;
        busy = true;
        board.classList.add("is-quiet");                 // 1. Insights + the link go
        setTimeout(() => {
          member.hidden = false;
          void member.offsetWidth;                       // commit opacity 0 before the class
          board.classList.add("is-member");              // 2. the board turns over
          setTimeout(() => {
            member.classList.add("is-on");               // 3. the join comes up with it
            busy = false;
            const f = form.querySelector('input[name="full_name"]');
            if (f) f.focus({ preventScroll: true });
          }, 240);
        }, 300);
      };
      const close = () => {
        if (busy || !board.classList.contains("is-member")) return;
        busy = true;
        member.classList.remove("is-on");                // 1. the join goes, quickly
        setTimeout(() => {
          board.classList.remove("is-member");           // 2. the emboss fades back
          setTimeout(() => board.classList.remove("is-quiet"), 180);  // 3. and these with it
          setTimeout(() => { member.hidden = true; busy = false; }, 620);
        }, 240);
      };

      unlock.addEventListener("click", open);
      if (closeBtn) closeBtn.addEventListener("click", close);
      board.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && board.classList.contains("is-member")) { e.stopPropagation(); close(); }
      });

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        errEl.hidden = true;
        const data = new FormData(form);
        const btn = form.querySelector('button[type="submit"]');
        const label = btn.querySelector("[data-label]");
        const orig = label.textContent;
        btn.setAttribute("disabled", "true");
        label.textContent = "Joining\u2026";

        const res = await signUpMember({
          fullName: data.get("full_name"),
          email: data.get("email"),
          password: data.get("password"),
          marketing: !!data.get("marketing"),
        });

        btn.removeAttribute("disabled");
        label.textContent = orig;

        if (res.error) {
          // Already registered isn't a mistake — it's a way in, so it gets a
          // link to sign in with the address already carried across.
          if (res.existing) {
            const em = encodeURIComponent(String(data.get("email") || "").trim());
            errEl.innerHTML = res.error + ' <a href="/login?email=' + em + '">Sign in instead</a>';
          } else {
            errEl.textContent = res.error;
          }
          errEl.hidden = false;
          return;
        }

        if (res.needsConfirm) {
          form.hidden = true;
          if (alt) alt.hidden = true;
          if (doneEl) doneEl.hidden = false;
        } else if (typeof window.tmkeSplash === "function") {
          window.tmkeSplash("/account");
        } else {
          window.location.href = "/account";
        }
      });
    }
  </script>
</BaseLayout>
