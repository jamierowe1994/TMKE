---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout
  title="The Blog — TMKE"
  description="Insights on social media, brand positioning and content systems for the UK property sector. Fortnightly, no fluff."
>
  <PageHero
    chapter="Insights"
    title="I'm an Estate Agent, <em>not a content creator.</em>"
    sub="Fortnightly writing on social media, brand positioning, and content systems for the UK property sector."
  />

  <!-- Coming soon — but honest and useful. -->
  <section class="blog-hero wrap">
    <div class="blog-hero-grid">
      <div>
        <p class="blog-eyebrow">Launching August 2026</p>
        <h2 class="blog-h">The first issue is being written right now.</h2>
        <p class="blog-lead">
          We're a small team writing slowly and on purpose. The first cornerstone piece —
          <em>"What estate agents get wrong about Instagram"</em> — lands in your inbox the moment it's published.
        </p>
        <p class="blog-lead">
          Until then, here's what's coming.
        </p>
      </div>

      <aside class="blog-signup">
        <div class="blog-signup-tag">Get notified</div>
        <h3>One email per issue. No tracking pixels.</h3>
        <p>Drop your email and we'll send the first piece the day it goes live. Unsubscribe in one click, no questions asked.</p>
        <form id="blog-signup-form" class="blog-form" novalidate>
          <label class="blog-field">
            <span>Email</span>
            <input type="email" name="email" required autocomplete="email" placeholder="you@agency.co.uk" />
          </label>
          <label class="blog-field">
            <span>Company (optional)</span>
            <input type="text" name="company" autocomplete="organization" placeholder="The Agency Co." />
          </label>
          <button type="submit" class="blog-submit">
            <span data-label>Notify me</span>
          </button>
          <p class="blog-form-error" id="blog-form-error" hidden></p>
          <p class="blog-form-ok" id="blog-form-ok" hidden>
            You're on the list — first issue lands soon.
          </p>
        </form>
      </aside>
    </div>
  </section>

  <!-- Topics planned -->
  <section class="blog-section wrap">
    <header class="blog-section-head">
      <p class="blog-eyebrow">Topics in the queue</p>
      <h2 class="blog-h">What we'll be writing about.</h2>
      <p class="blog-section-sub">Five themes we keep coming back to in client work — turned into proper, long-form pieces.</p>
    </header>

    <div class="blog-topics">
      <article class="blog-topic">
        <div class="blog-topic-num">01</div>
        <h3>Strategy</h3>
        <p>Why most property social fails before the first post — and the planning frameworks that turn the channel into a listing driver.</p>
      </article>
      <article class="blog-topic">
        <div class="blog-topic-num">02</div>
        <h3>Content systems</h3>
        <p>Templates, calendars and processes the busiest agencies use to stay consistent without burning out a junior.</p>
      </article>
      <article class="blog-topic">
        <div class="blog-topic-num">03</div>
        <h3>Branding</h3>
        <p>The visual mistakes that make agents look the same as everyone else — and the cheap fixes that don't.</p>
      </article>
      <article class="blog-topic">
        <div class="blog-topic-num">04</div>
        <h3>Industry</h3>
        <p>What the data really says about social-driven instructions, viewing-day conversions and vendor decision making.</p>
      </article>
      <article class="blog-topic">
        <div class="blog-topic-num">05</div>
        <h3>Tools</h3>
        <p>Honest reviews of the platforms property marketers actually use — Reapit, Jupix, Canva, Pretzel — when they help, when they hurt.</p>
      </article>
    </div>
  </section>

  <section class="blog-foot wrap">
    <p>Already signed up? Forward the first issue when it lands — and tell us what you wish we'd cover next.</p>
    <a href="/contact" class="blog-foot-link">Suggest a topic &rarr;</a>
  </section>

  <style is:global>
    .blog-hero {
      max-width: 1280px;
      margin: 0 auto;
      padding: 80px 36px;
    }
    .blog-hero-grid {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 80px;
      align-items: start;
    }
    @media (max-width: 980px) {
      .blog-hero { padding: 56px 22px; }
      .blog-hero-grid { grid-template-columns: 1fr; gap: 40px; }
    }
    .blog-eyebrow {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--english-violet);
      margin: 0 0 12px;
    }
    .blog-h {
      font-family: var(--serif);
      font-size: clamp(36px, 4.5vw, 60px);
      line-height: 1.04;
      letter-spacing: -0.02em;
      margin: 0 0 24px;
      color: var(--ink);
      font-weight: 500;
    }
    .blog-h em { color: var(--english-violet); font-style: italic; }
    .blog-lead {
      font-family: var(--serif);
      font-size: 19px;
      line-height: 1.6;
      color: rgba(28,29,34,0.78);
      margin: 0 0 16px;
      max-width: 56ch;
    }
    .blog-lead em { font-style: italic; color: var(--english-violet); }

    .blog-signup {
      padding: 32px;
      background: rgba(71, 66, 84, 0.05);
      border: 1px solid rgba(71, 66, 84, 0.2);
      border-radius: 3px;
    }
    .blog-signup-tag {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--english-violet);
      margin-bottom: 16px;
    }
    .blog-signup h3 {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 500;
      letter-spacing: -0.015em;
      margin: 0 0 12px;
    }
    .blog-signup p {
      font-size: 14px;
      line-height: 1.55;
      color: rgba(28,29,34,0.65);
      margin: 0 0 20px;
    }
    .blog-form { display: flex; flex-direction: column; gap: 14px; }
    .blog-field { display: flex; flex-direction: column; gap: 6px; }
    .blog-field span {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.6);
    }
    .blog-field input {
      padding: 12px 14px;
      font-family: var(--sans);
      font-size: 14px;
      border: 1px solid rgba(28,29,34,0.18);
      border-radius: 2px;
      background: #fff;
      outline: none;
      transition: border-color 0.2s;
    }
    .blog-field input:focus { border-color: var(--english-violet); }
    .blog-submit {
      margin-top: 8px;
      padding: 14px;
      background: var(--ink);
      color: var(--paper);
      border: 0;
      border-radius: 2px;
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.25s;
    }
    .blog-submit:hover { background: var(--english-violet); }
    .blog-submit[disabled] { opacity: 0.55; cursor: progress; }
    .blog-form-error {
      margin: 0;
      font-size: 13px;
      color: #a05a3c;
      font-family: var(--sans);
    }
    .blog-form-ok {
      margin: 0;
      padding: 10px 12px;
      background: #e6efe5;
      color: #2e6a4a;
      border-radius: 2px;
      font-family: var(--sans);
      font-size: 13px;
    }

    .blog-section {
      max-width: 1280px;
      margin: 0 auto;
      padding: 80px 36px;
      border-top: 1px solid rgba(28,29,34,0.1);
    }
    @media (max-width: 980px) { .blog-section { padding: 56px 22px; } }
    .blog-section-head {
      max-width: 720px;
      margin: 0 auto 60px;
      text-align: center;
    }
    .blog-section-sub {
      font-family: var(--serif);
      font-size: 17px;
      color: rgba(28,29,34,0.6);
      margin: 14px 0 0;
      line-height: 1.55;
    }

    .blog-topics {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 22px;
    }
    @media (max-width: 1080px) { .blog-topics { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 720px) { .blog-topics { grid-template-columns: 1fr; } }
    .blog-topic {
      padding: 24px 22px;
      background: rgba(255,255,255,0.55);
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 3px;
      min-height: 200px;
      display: flex; flex-direction: column; gap: 8px;
    }
    .blog-topic-num {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.32em;
      color: var(--english-violet);
    }
    .blog-topic h3 {
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 500;
      letter-spacing: -0.015em;
      margin: 4px 0 6px;
    }
    .blog-topic p {
      font-family: var(--sans);
      font-size: 13px;
      line-height: 1.6;
      color: rgba(28,29,34,0.65);
      margin: 0;
      flex: 1;
    }

    .blog-foot {
      max-width: 880px;
      margin: 0 auto;
      padding: 60px 36px 200px;
      text-align: center;
    }
    .blog-foot p {
      font-family: var(--serif);
      font-style: italic;
      font-size: 18px;
      color: rgba(28,29,34,0.65);
      margin: 0 0 18px;
    }
    .blog-foot-link {
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--english-violet);
      text-decoration: none;
      border-bottom: 1px solid currentColor;
    }
    .blog-foot-link:hover { color: var(--ink); }
  </style>

  <script>
    // Lightweight client-side signup with localStorage persistence. Wire to
    // a real mailing list (Mailerlite / Buttondown) in a later pass.
    const form = document.getElementById('blog-signup-form');
    const err = document.getElementById('blog-form-error');
    const ok = document.getElementById('blog-form-ok');
    const submit = form?.querySelector('button[type="submit"]');
    const label = submit?.querySelector('[data-label]');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      err.hidden = true;
      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        err.textContent = 'Drop a valid email and we’ll do the rest.';
        err.hidden = false;
        return;
      }
      submit.setAttribute('disabled', 'true');
      label.textContent = 'Adding…';
      try {
        const existing = JSON.parse(localStorage.getItem('tmke.blog.signups') || '[]');
        existing.push({ email, company: fd.get('company') || '', at: Date.now() });
        localStorage.setItem('tmke.blog.signups', JSON.stringify(existing));
      } catch (_) {}
      // Pretend latency so the success state doesn't pop instantly.
      await new Promise((r) => setTimeout(r, 350));
      form.querySelectorAll('input').forEach((i) => i.value = '');
      submit.removeAttribute('disabled');
      label.textContent = 'Notify me';
      ok.hidden = false;
      setTimeout(() => (ok.hidden = true), 6000);
    });
  </script>
</BaseLayout>
