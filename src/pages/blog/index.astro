---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../data/blog.js";

// Pulled from Supabase if configured, otherwise from the static fallback.
const allPosts = await getPublishedPosts();
const sorted = [...allPosts].sort((a, b) => (a.date < b.date ? 1 : -1));
const featured = sorted[0]; // → right column (newest / feature post)
const rest = sorted.slice(1); // → left list

// Pad the feed with duplicates so the columns are tall enough to actually show
// the counter-scroll while there are only a handful of real posts. Remove the
// padding (use `rest` directly) once there are ~9+ published posts.
const feed = rest.length >= 9 ? rest : [...rest, ...rest, ...rest].slice(0, 9);

// The left side is a double column whose two halves counter-scroll. Alternate
// posts between them so both stay populated and balanced.
const colUp = feed.filter((_, i) => i % 2 === 0);   // left-left column → drifts UP
const colDown = feed.filter((_, i) => i % 2 === 1); // left-right column → drifts DOWN

// The feature card shows a slightly shorter display title (≈2 lines)
// without changing the article's canonical title. Keyed by slug so it only
// applies to the intended post; falls back to the real title otherwise.
const FEATURE_TITLE = {
  "why-personal-branding-works-in-estate-agency": "Why personal branding works in estate agency",
};
const featTitle = FEATURE_TITLE[featured.slug] || featured.title;

function fmtDate(iso) {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}
---

<BaseLayout
  title="Insights — TMKE"
  description="Structured insights on social media, brand positioning, content systems, and the future of estate agency marketing — written for UK property professionals."
  hideFooter
>
  <!-- Page-wide film grain — fixed, sits above the content but below the nav,
       blended so it adds texture without tinting. Purely decorative. -->
  <div class="insights-grain" aria-hidden="true"></div>

  <!-- ============================== TWO-COLUMN SPLIT -->
  <section class="insights2" id="insights2">
    <!-- LEFT: double column — the two halves counter-scroll (left up, right down) -->
    <div class="ins-list" id="ins-list">
      <div class="ins-list-head">
        <h1 class="ins-list-title">Notes from <em>the desk.</em></h1>
      </div>

      <div class="ins-cols">
        <div class="ins-col ins-col--up" id="ins-col-up">
          {colUp.map((p) => (
            <a class="ins-item" href={`/blog/${p.slug}`}>
              <div class="ins-item-media">
                {p.video
                  ? <video autoplay muted loop playsinline preload="metadata" poster={p.hero}><source src={p.video} type="video/mp4" /></video>
                  : <img src={p.hero} alt={p.title} loading="lazy" />}
              </div>
              <h3 class="ins-item-title">{p.title}</h3>
              <p class="ins-item-brief">{p.standfirst}</p>
            </a>
          ))}
        </div>
        <div class="ins-col ins-col--down" id="ins-col-down">
          {colDown.map((p) => (
            <a class="ins-item" href={`/blog/${p.slug}`}>
              <div class="ins-item-media">
                {p.video
                  ? <video autoplay muted loop playsinline preload="metadata" poster={p.hero}><source src={p.video} type="video/mp4" /></video>
                  : <img src={p.hero} alt={p.title} loading="lazy" />}
              </div>
              <h3 class="ins-item-title">{p.title}</h3>
              <p class="ins-item-brief">{p.standfirst}</p>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- RIGHT: pinned feature (newest post) -->
    <aside class="ins-feature" id="ins-feature">
      <a class="ins-feature-inner" href={`/blog/${featured.slug}`}>
        <div class="ins-feature-head">
          <div class="ins-feature-eyebrow">Latest news</div>
        </div>
        <div class="ins-feature-media">
          <!-- Feature video (/public/assets/book reading.mp4). The poster
               (the post's hero image) shows until the clip loads. -->
          <video
            class="ins-feature-video"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            poster={featured.hero}
          >
            <source src="/assets/book%20reading.mp4" type="video/mp4" />
          </video>
          <span class="ins-feature-tag">Read the feature <em>&rarr;</em></span>
        </div>
        <h2 class="ins-feature-title">{featTitle}</h2>
        <p class="ins-feature-sub">{featured.standfirst}</p>
      </a>
    </aside>
  </section>

  <!-- Newsletter + footer removed — Insights is a fixed one-pager. -->


  <style>
    /* ============== PAGE GRAIN ============== */
    .insights-grain {
      position: fixed;
      inset: 0;
      z-index: 60; /* above content (z-index:2), below nav (100) */
      pointer-events: none;
      background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='240' height='240'><filter id='g'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/><feColorMatrix type='saturate' values='0'/></filter><rect width='100%25' height='100%25' filter='url(%23g)'/></svg>");
      background-size: 240px 240px;
      opacity: 0.15;
      mix-blend-mode: overlay;
    }

    /* ============== TWO-COLUMN SPLIT ============== */
    .insights2 {
      display: grid;
      /* minmax(0,1fr) keeps both halves a true 50/50 — without the `0` floor
         the nowrap card titles inflate the left track past half. */
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(28px, 3.2vw, 60px);
      align-items: stretch;
      max-width: 1640px;
      margin: 0 auto;
      position: relative;
      /* Shared metrics so the divider lines land exactly between the header
         band and the content below it. */
      --ins-pad-top: clamp(92px, 10vh, 116px);
      --ins-pad-x: clamp(22px, 4vw, 64px);
      --ins-pad-bot: clamp(28px, 4vh, 56px);
      --ins-head-h: clamp(40px, 3.8vw, 56px);
      --ins-head-gap: clamp(16px, 2vw, 26px);
      --ins-line: rgba(28, 29, 34, 0.14);
      /* Fixed one-pager — fills the viewport, never scrolls. */
      height: 100vh;
      overflow: hidden;
      padding: var(--ins-pad-top) var(--ins-pad-x) var(--ins-pad-bot);
    }

    /* Thin, faint divider lines forming a "T": a full-width rule under the
       header band, plus a vertical rule down the centre gap separating the
       left article columns from the right feature. */
    .insights2::before,
    .insights2::after {
      content: "";
      position: absolute;
      background: var(--ins-line);
      pointer-events: none;
    }
    .insights2::before {
      /* horizontal — under both headers, edge to edge */
      left: 0;
      right: 0;
      top: calc(var(--ins-pad-top) + var(--ins-head-h) + var(--ins-head-gap) / 2);
      height: 1px;
    }
    .insights2::after {
      /* vertical — down the centre, from the horizontal line to the content base */
      left: 50%;
      transform: translateX(-0.5px);
      top: calc(var(--ins-pad-top) + var(--ins-head-h) + var(--ins-head-gap) / 2);
      bottom: var(--ins-pad-bot);
      width: 1px;
    }

    /* ---- LEFT: double column (the two halves counter-scroll) ---- */
    .ins-list {
      display: flex;
      flex-direction: column;
      min-height: 0; /* allow the marquee area to clip inside the fixed page */
      /* Pull the blogs in from the centre so the video has breathing room. */
      padding-right: clamp(10px, 1.8vw, 36px);
    }
    .ins-list-head {
      height: var(--ins-head-h);
      margin-bottom: var(--ins-head-gap);
      display: flex;
      align-items: center;
    }
    .ins-list-head .eyebrow {
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 16px;
      color: var(--english-violet);
    }
    .ins-list-head .eyebrow::before {
      content: "";
      display: block;
      width: 48px;
      height: 1px;
      background: currentColor;
      opacity: 0.45;
      flex-shrink: 0;
    }
    .ins-list-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(30px, 3.4vw, 48px);
      line-height: 1.04;
      letter-spacing: -0.018em;
      color: var(--ink);
      margin: 0;
    }
    .ins-list-title em { font-style: normal; color: var(--english-violet); }

    .ins-cols {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(14px, 1.6vw, 24px);
      align-items: start;
      /* Clipped marquee viewport — fills the remaining height, no page scroll. */
      flex: 1;
      min-height: 0;
      overflow: hidden;
      position: relative;
    }
    .ins-col {
      display: flex;
      flex-direction: column;
      gap: 0;
      will-change: transform;
    }
    /* The two columns counter-scroll on wheel (driven by JS) — left drifts up,
       right drifts down — instead of auto-scrolling. */

    .ins-item {
      display: block;
      color: var(--ink);
      text-decoration: none;
      margin-bottom: 30px; /* gap below the block before the next image */
    }
    .ins-item-title {
      /* Helios heading stack — set explicitly because the global h3 rule
         re-points --serif to The Seasons. */
      font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-weight: 400;
      font-size: clamp(16px, 1.25vw, 20px);
      line-height: 1.15;
      letter-spacing: -0.01em;
      color: var(--ink);
      margin: 0 0 6px;
      /* One line maximum. */
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      transition: color 0.3s ease;
    }
    .ins-item:hover .ins-item-title { color: var(--english-violet); }

    .ins-item-media {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      border-radius: 6px;
      background: rgba(28, 29, 34, 0.06);
      margin-bottom: 20px;
    }
    .ins-item-media img,
    .ins-item-media video {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 1.4s cubic-bezier(.2, .7, .2, 1);
    }
    .ins-item:hover .ins-item-media img,
    .ins-item:hover .ins-item-media video { transform: scale(1.05); }

    .ins-item-brief {
      font-family: var(--sans);
      font-size: clamp(12.5px, 0.95vw, 14px);
      line-height: 1.35;
      color: rgba(28, 29, 34, 0.6);
      margin: 0;
      /* Two lines, tight. */
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .ins-dot { opacity: 0.5; }

    /* ---- RIGHT: pinned feature ---- */
    .ins-feature {
      position: sticky;
      top: clamp(80px, 9vh, 104px);
      height: calc(100vh - clamp(80px, 9vh, 104px) - clamp(32px, 4vh, 56px));
      min-height: 540px;
    }
    .ins-feature-inner {
      display: flex;
      flex-direction: column;
      height: 100%;
      color: var(--ink);
      text-decoration: none;
      will-change: transform;
    }
    /* Same height + gap as the left header so both columns' content starts on
       the same line and "Latest news" centres on the title. */
    .ins-feature-head {
      flex: 0 0 auto;
      height: var(--ins-head-h);
      margin-bottom: var(--ins-head-gap);
      display: flex;
      align-items: center;
    }
    .ins-feature-eyebrow {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--english-violet);
      margin-bottom: 0;
      display: flex;
      align-items: center;
      gap: 16px;
    }
    .ins-feature-eyebrow::before {
      content: "";
      display: block;
      width: 48px;
      height: 1px;
      background: currentColor;
      opacity: 0.45;
      flex-shrink: 0;
    }
    .ins-feature-title {
      flex: 0 0 auto;
      font-family: var(--serif);
      font-weight: 400;
      font-size: 32px;
      line-height: 1.04;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: clamp(16px, 1.6vw, 24px) 0 0;
      white-space: nowrap;
    }
    .ins-feature-sub {
      flex: 0 0 auto;
      font-family: var(--sans);
      font-style: normal;
      font-size: 18px;
      line-height: 1.5;
      color: rgba(28, 29, 34, 0.7);
      margin: 10px 0 0;
      max-width: 60ch;
      text-align: justify;
    }
    .ins-feature-media {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      overflow: hidden;
      border-radius: 6px;
      background: rgba(28, 29, 34, 0.06);
    }
    .ins-feature-media img,
    .ins-feature-media video {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 1.6s cubic-bezier(.2, .7, .2, 1);
    }
    .ins-feature-inner:hover .ins-feature-media img,
    .ins-feature-inner:hover .ins-feature-media video { transform: scale(1.04); }
    .ins-feature-tag {
      position: absolute;
      left: 18px; bottom: 18px;
      display: inline-flex; align-items: center; gap: 8px;
      padding: 9px 16px;
      background: rgba(28, 29, 34, 0.85);
      color: var(--paper);
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-radius: 999px;
      backdrop-filter: blur(4px);
    }
    .ins-feature-tag em {
      font-style: normal;
      transition: transform 0.3s ease;
    }
    .ins-feature-inner:hover .ins-feature-tag em { transform: translateX(4px); }

    /* ---- Responsive: stack, un-pin, no parallax ---- */
    @media (max-width: 900px) {
      .insights2 {
        grid-template-columns: minmax(0, 1fr);
        gap: clamp(56px, 10vw, 88px);
        padding-top: clamp(120px, 22vw, 160px);
        /* Mobile scrolls normally — drop the fixed one-pager. */
        height: auto;
        overflow: visible;
      }
      /* The T-divider only makes sense in the two-column desktop layout. */
      .insights2::before, .insights2::after { display: none; }
      .ins-cols { overflow: visible; }
      .ins-list { padding-right: 0; }
      .ins-feature {
        position: static;
        height: auto;
        min-height: 0;
        order: -1; /* feature first on mobile */
      }
      .ins-feature-media { aspect-ratio: 4 / 3; flex: 0 0 auto; height: auto; }
      /* Collapse the double column to one; no counter-scroll on small screens. */
      .ins-cols { grid-template-columns: minmax(0, 1fr); gap: clamp(26px, 6vw, 44px); }
      .ins-col--down { margin-top: clamp(26px, 6vw, 44px); }
      /* Parallax transforms are skipped in JS below this width. */
      .ins-col, .ins-feature-inner { transform: none !important; }
    }

    /* ============== NEWSLETTER ============== */
    .insights-news {
      max-width: 1360px;
      margin: 0 auto;
      padding: 40px 36px 160px;
    }
    .news-box {
      background: var(--ink);
      color: var(--paper);
      padding: 80px 64px;
      text-align: center;
      border-radius: 2px;
      position: relative;
      overflow: hidden;
    }
    @media (max-width: 720px) { .news-box { padding: 56px 28px; } }
    .news-eyebrow {
      font-family: var(--serif);
      font-style: italic;
      font-size: 16px;
      color: rgba(240, 238, 235, 0.6);
      margin-bottom: 18px;
    }
    .news-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(32px, 3.4vw, 48px);
      letter-spacing: -0.015em;
      color: var(--paper);
      margin: 0 0 14px;
    }
    .news-title em { font-style: italic; color: var(--french-grey); }
    .news-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(16px, 1.4vw, 19px);
      line-height: 1.5;
      color: rgba(240, 238, 235, 0.7);
      max-width: 52ch;
      margin: 0 auto 28px;
    }
    .news-form {
      display: flex;
      gap: 8px;
      max-width: 480px;
      margin: 0 auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    .news-form input {
      flex: 1;
      min-width: 220px;
      padding: 14px 18px;
      font-family: var(--sans);
      font-size: 15px;
      background: transparent;
      border: 1px solid rgba(240, 238, 235, 0.3);
      color: var(--paper);
      border-radius: 1px;
    }
    .news-form input::placeholder { color: rgba(240, 238, 235, 0.4); }
    .news-form input:focus { outline: none; border-color: var(--paper); }
    .news-form .btn--solid {
      background: var(--paper);
      color: var(--ink);
      border-color: var(--paper);
    }
    .news-form .btn--solid:hover {
      background: var(--accent);
      color: var(--paper);
      border-color: var(--accent);
    }
    .news-fine {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(240, 238, 235, 0.4);
      margin-top: 18px;
    }
  </style>

  <!-- Insights is a fixed one-pager. The page doesn't scroll; the wheel drives
       the two left columns in OPPOSITE directions (left up, right down) with a
       little smoothing. Desktop only — mobile scrolls normally. -->
  <script is:inline>
    (function () {
      const colUp = document.getElementById("ins-col-up");
      const colDown = document.getElementById("ins-col-down");
      const cols = document.querySelector(".ins-cols");
      if (!colUp || !colDown || !cols) return;
      const isMobile = () => window.matchMedia("(max-width: 900px)").matches;
      const reduce = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      let target = 0, current = 0, raf = null;
      const rng = (c) => Math.max(0, c.scrollHeight - cols.clientHeight);
      function render() {
        colUp.style.transform = "translate3d(0," + (-current * rng(colUp)).toFixed(1) + "px,0)";
        colDown.style.transform = "translate3d(0," + (-(1 - current) * rng(colDown)).toFixed(1) + "px,0)";
      }
      function tick() {
        current += (target - current) * 0.12;
        if (Math.abs(target - current) < 0.0008) current = target;
        render();
        raf = current !== target ? requestAnimationFrame(tick) : null;
      }
      render();
      window.addEventListener("wheel", function (e) {
        if (isMobile()) return;
        const span = Math.max(rng(colUp), rng(colDown)) || 1;
        target = Math.min(1, Math.max(0, target + e.deltaY / span));
        if (reduce) { current = target; render(); }
        else if (!raf) raf = requestAnimationFrame(tick);
      }, { passive: true });
      window.addEventListener("resize", function () {
        if (isMobile()) { colUp.style.transform = ""; colDown.style.transform = ""; }
        else render();
      });
    })();
  </script>
</BaseLayout>
