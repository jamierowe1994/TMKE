---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts } from "../../data/blog.js";

// Pulled from Supabase if configured, otherwise from the static fallback.
const allPosts = await getPublishedPosts();
const sorted = [...allPosts].sort((a, b) => (a.date < b.date ? 1 : -1));
const featured = sorted[0]; // → right column (newest / feature post)
const rest = sorted.slice(1); // → left scrolling list

function fmtDate(iso) {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
}
---

<BaseLayout
  title="Insights — TMKE"
  description="Structured insights on social media, brand positioning, content systems, and the future of estate agency marketing — written for UK property professionals."
>
  <!-- ============================== TWO-COLUMN SPLIT -->
  <section class="insights2" id="insights2">
    <!-- LEFT: scrolling list of every other post -->
    <div class="ins-list" id="ins-list">
      <div class="ins-list-head">
        <div class="eyebrow">Insights</div>
        <h1 class="ins-list-title">Notes from <em>the desk.</em></h1>
      </div>

      {rest.map((p) => (
        <a class="ins-item" href={`/blog/${p.slug}`}>
          <h3 class="ins-item-title">{p.title}</h3>
          <div class="ins-item-media">
            <img src={p.hero} alt={p.title} loading="lazy" />
          </div>
          <div class="ins-item-foot">
            <span class="ins-item-cat">{p.category}</span>
            <p class="ins-item-brief">{p.standfirst}</p>
            <div class="ins-item-meta">
              <span>{fmtDate(p.date)}</span>
              <span class="ins-dot">·</span>
              <span>{p.readTime} min read</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- RIGHT: pinned feature (newest post) -->
    <aside class="ins-feature" id="ins-feature">
      <a class="ins-feature-inner" href={`/blog/${featured.slug}`}>
        <div class="ins-feature-head">
          <div class="ins-feature-eyebrow">Latest <span class="ins-dot">·</span> {featured.category}</div>
          <h2 class="ins-feature-title">{featured.title}</h2>
          <p class="ins-feature-sub">{featured.standfirst}</p>
        </div>
        <!-- Video-ready: drop in a <video autoplay muted loop playsinline> here
             later; the <img> placeholder uses the post's existing hero for now. -->
        <div class="ins-feature-media">
          <img src={featured.hero} alt={featured.title} loading="eager" />
          <span class="ins-feature-tag">Read the feature <em>&rarr;</em></span>
        </div>
      </a>
    </aside>
  </section>

  <!-- ============================== NEWSLETTER -->
  <section class="insights-news">
    <div class="news-box">
      <div class="news-eyebrow">/ Newsletter /</div>
      <h3 class="news-title">Get the next insight <em>in your inbox.</em></h3>
      <p class="news-sub">One considered email every other Friday. No filler, no automation — written by the TMKE desk for UK property professionals.</p>
      <form class="news-form" id="insights-news-form" novalidate>
        <input type="email" name="email" placeholder="you@agency.co.uk" required autocomplete="email" />
        <button type="submit" class="btn btn--solid">Subscribe <span class="btn-arrow">&rarr;</span></button>
      </form>
      <p class="news-fine">No spam. Unsubscribe in one click.</p>
    </div>
  </section>

  <style>
    /* ============== TWO-COLUMN SPLIT ============== */
    .insights2 {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(32px, 4vw, 72px);
      align-items: start;
      max-width: 1640px;
      margin: 0 auto;
      padding: clamp(140px, 16vh, 200px) clamp(22px, 4vw, 64px) clamp(80px, 8vw, 120px);
    }

    /* ---- LEFT: scrolling list ---- */
    .ins-list {
      display: flex;
      flex-direction: column;
      gap: clamp(64px, 8vw, 120px);
      will-change: transform;
    }
    .ins-list-head { margin-bottom: clamp(8px, 2vw, 24px); }
    .ins-list-head .eyebrow { margin-bottom: 16px; }
    .ins-list-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(34px, 4vw, 56px);
      line-height: 1.04;
      letter-spacing: -0.018em;
      color: var(--ink);
      margin: 0;
    }
    .ins-list-title em { font-style: italic; color: var(--english-violet); }

    .ins-item {
      display: block;
      color: var(--ink);
      text-decoration: none;
    }
    .ins-item-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(24px, 2.4vw, 38px);
      line-height: 1.08;
      letter-spacing: -0.015em;
      color: var(--ink);
      margin: 0 0 22px;
      max-width: 20ch;
      transition: color 0.3s ease;
    }
    .ins-item:hover .ins-item-title { color: var(--english-violet); }

    .ins-item-media {
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: rgba(28, 29, 34, 0.06);
      margin-bottom: 22px;
    }
    .ins-item-media img {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 1.4s cubic-bezier(.2, .7, .2, 1);
    }
    .ins-item:hover .ins-item-media img { transform: scale(1.05); }

    .ins-item-cat {
      display: inline-block;
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--english-violet);
      margin-bottom: 12px;
    }
    .ins-item-brief {
      font-family: var(--sans);
      font-size: clamp(14px, 1.05vw, 16px);
      line-height: 1.55;
      color: rgba(28, 29, 34, 0.62);
      margin: 0 0 14px;
      max-width: 52ch;
    }
    .ins-item-meta {
      display: flex; gap: 8px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      color: rgba(28, 29, 34, 0.5);
    }
    .ins-dot { opacity: 0.5; }

    /* ---- RIGHT: pinned feature ---- */
    .ins-feature {
      position: sticky;
      top: clamp(96px, 12vh, 140px);
      height: calc(100vh - clamp(96px, 12vh, 140px) - clamp(40px, 5vh, 72px));
      min-height: 520px;
    }
    .ins-feature-inner {
      display: flex;
      flex-direction: column;
      height: 100%;
      color: var(--ink);
      text-decoration: none;
      will-change: transform;
    }
    .ins-feature-head { flex: 0 0 auto; margin-bottom: clamp(18px, 2vw, 30px); }
    .ins-feature-eyebrow {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.55);
      margin-bottom: 18px;
    }
    .ins-feature-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(34px, 3.6vw, 62px);
      line-height: 1.02;
      letter-spacing: -0.02em;
      color: var(--ink);
      margin: 0 0 18px;
      max-width: 18ch;
    }
    .ins-feature-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(17px, 1.5vw, 22px);
      line-height: 1.5;
      color: rgba(28, 29, 34, 0.7);
      margin: 0;
      max-width: 56ch;
    }
    .ins-feature-media {
      position: relative;
      flex: 1 1 auto;
      min-height: 0;
      overflow: hidden;
      background: rgba(28, 29, 34, 0.06);
    }
    .ins-feature-media img,
    .ins-feature-media video {
      width: 100%; height: 100%; object-fit: cover; display: block;
      transition: transform 1.6s cubic-bezier(.2, .7, .2, 1);
    }
    .ins-feature-inner:hover .ins-feature-media img { transform: scale(1.04); }
    .ins-feature-tag {
      position: absolute;
      left: 18px; bottom: 18px;
      display: inline-flex; align-items: center; gap: 8px;
      padding: 9px 16px;
      background: rgba(28, 29, 34, 0.85);
      color: var(--paper);
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-radius: 999px;
      backdrop-filter: blur(4px);
    }
    .ins-feature-tag em {
      font-style: normal;
      transition: transform 0.3s ease;
    }
    .ins-feature-inner:hover .ins-feature-tag em { transform: translateX(4px); }

    /* ---- Responsive: stack, un-pin, no parallax ---- */
    @media (max-width: 900px) {
      .insights2 {
        grid-template-columns: 1fr;
        gap: clamp(56px, 10vw, 88px);
        padding-top: clamp(120px, 22vw, 160px);
      }
      .ins-feature {
        position: static;
        height: auto;
        min-height: 0;
        order: -1; /* feature first on mobile */
      }
      .ins-feature-media { aspect-ratio: 4 / 3; flex: 0 0 auto; height: auto; }
      /* Parallax transforms are skipped in JS below this width. */
      .ins-list, .ins-feature-inner { transform: none !important; }
    }

    /* ============== NEWSLETTER ============== */
    .insights-news {
      max-width: 1360px;
      margin: 0 auto;
      padding: 40px 36px 160px;
    }
    .news-box {
      background: var(--ink);
      color: var(--paper);
      padding: 80px 64px;
      text-align: center;
      border-radius: 2px;
      position: relative;
      overflow: hidden;
    }
    @media (max-width: 720px) { .news-box { padding: 56px 28px; } }
    .news-eyebrow {
      font-family: var(--serif);
      font-style: italic;
      font-size: 16px;
      color: rgba(240, 238, 235, 0.6);
      margin-bottom: 18px;
    }
    .news-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(32px, 3.4vw, 48px);
      letter-spacing: -0.015em;
      color: var(--paper);
      margin: 0 0 14px;
    }
    .news-title em { font-style: italic; color: var(--french-grey); }
    .news-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(16px, 1.4vw, 19px);
      line-height: 1.5;
      color: rgba(240, 238, 235, 0.7);
      max-width: 52ch;
      margin: 0 auto 28px;
    }
    .news-form {
      display: flex;
      gap: 8px;
      max-width: 480px;
      margin: 0 auto;
      flex-wrap: wrap;
      justify-content: center;
    }
    .news-form input {
      flex: 1;
      min-width: 220px;
      padding: 14px 18px;
      font-family: var(--sans);
      font-size: 15px;
      background: transparent;
      border: 1px solid rgba(240, 238, 235, 0.3);
      color: var(--paper);
      border-radius: 1px;
    }
    .news-form input::placeholder { color: rgba(240, 238, 235, 0.4); }
    .news-form input:focus { outline: none; border-color: var(--paper); }
    .news-form .btn--solid {
      background: var(--paper);
      color: var(--ink);
      border-color: var(--paper);
    }
    .news-form .btn--solid:hover {
      background: var(--accent);
      color: var(--paper);
      border-color: var(--accent);
    }
    .news-fine {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(240, 238, 235, 0.4);
      margin-top: 18px;
    }
  </style>

  <!-- Opposite-direction parallax: left list drifts DOWN, right feature drifts
       UP as the section scrolls. Hooks the site's global Lenis instance when
       present, else a passive scroll listener. Skipped on small screens and
       under prefers-reduced-motion. -->
  <script is:inline>
    (function () {
      const list = document.getElementById("ins-list");
      const featureInner = document.querySelector("#ins-feature .ins-feature-inner");
      const section = document.getElementById("insights2");
      if (!list || !featureInner || !section) return;

      const reduce =
        window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const isMobile = () => window.matchMedia("(max-width: 900px)").matches;

      // Max drift each column travels from the neutral mid-scroll position.
      const RANGE = 46;
      let ticking = false;

      function apply() {
        ticking = false;
        if (reduce || isMobile()) {
          list.style.transform = "";
          featureInner.style.transform = "";
          return;
        }
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight;
        // progress: 0 when the section first enters from the bottom, 1 when it
        // has fully passed the top. 0.5 ≈ centred → neutral (no drift).
        const total = rect.height + vh;
        const p = Math.max(0, Math.min(1, (vh - rect.top) / total));
        const drift = (p - 0.5) * 2 * RANGE; // -RANGE … +RANGE
        list.style.transform = "translate3d(0," + drift.toFixed(2) + "px,0)";
        featureInner.style.transform = "translate3d(0," + (-drift).toFixed(2) + "px,0)";
      }

      function onScroll() {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      }

      if (window.__lenis && typeof window.__lenis.on === "function") {
        window.__lenis.on("scroll", onScroll);
      } else {
        window.addEventListener("scroll", onScroll, { passive: true });
      }
      window.addEventListener("resize", onScroll);
      apply();
    })();
  </script>

  <script is:inline>
    (function () {
      const form = document.getElementById("insights-news-form");
      if (form) {
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          const input = form.querySelector("input");
          const btn = form.querySelector("button");
          if (!input.value) return;
          const original = btn.innerHTML;
          btn.textContent = "You're in ✓";
          setTimeout(function () {
            btn.innerHTML = original;
            input.value = "";
          }, 2400);
        });
      }
    })();
  </script>
</BaseLayout>
