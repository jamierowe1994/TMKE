---
import BaseLayout from "../layouts/BaseLayout.astro";

// The nine "what you can do in the hub" tiles. Portrait (1080×1440) imagery —
// brand placeholders; swap `img` for the final shots when ready.
const TILES = [
  { key: "Design",   a: "Create scroll-stopping content in the Studio.", b: "Templates, tools and your brand kit, ready to go.", img: "/assets/signup/2.webp" },
  { key: "Plan",     a: "Map out your month in one view.",                 b: "Schedule posts and never scramble for content.",     img: "/assets/signup/7.webp" },
  { key: "Shop",     a: "Browse The Edit.",                                b: "Ready-made template packs for every moment.",         img: "/assets/signup/9.webp" },
  { key: "Learn",    a: "Guides and mini-courses.",                        b: "Sharpen your marketing, one lesson at a time.",       img: "/assets/signup/3.webp" },
  { key: "Book",     a: "Discover our videography packages.",              b: "Book a shoot or discovery call.",                     img: "/assets/signup/4.webp" },
  { key: "Track",    a: "See exactly what's working.",                     b: "Clear monthly SMM reports.",                          img: "/assets/signup/5.webp" },
  { key: "Manage",   a: "Everything in one place.",                        b: "Your orders, services and bookings at a glance.",     img: "/assets/signup/8.webp" },
  { key: "Discover", a: "Explore what's possible.",                        b: "Fresh ideas and resources to keep you moving.",       img: "/assets/signup/6.webp" },
];
---

<BaseLayout
  dashboard
  title="Create your account — TMKE"
  description="Join the Studio — your all-in-one TMKE workspace for designing content, planning marketing, managing bookings and more."
  hideNav={true}
  hideFooter={true}
>
  <main class="jn">
    <header class="jn-top">
      <a href="/" class="jn-top-back" aria-label="Back to site"><span aria-hidden="true">&larr;</span> Back</a>
      <a href="/" class="jn-top-mark" aria-label="TMKE — home">TMKE</a>
    </header>

    <div class="jn-grid">
      <!-- First cell: image + the chapter line + "Join", like the rest -->
      <button type="button" class="jn-cell jn-cell--tile jn-cell--join" data-signup-open aria-label="Create your account">
        <span class="jn-tile-inner">
          <span class="jn-thumb">
            <img class="jn-thumb-img" src="/assets/signup/1.webp" alt="" loading="lazy" />
          </span>
          <span class="jn-cap">
            <span class="jn-cap-key chapter">Join</span>
            <span class="jn-cap-lines">
              <span class="jn-cap-line">Create an account to access the Studio.</span>
              <span class="jn-cap-line">All-in-one space to design and plan.</span>
            </span>
          </span>
        </span>
      </button>

      {TILES.map((t) => (
        <button type="button" class:list={["jn-cell", "jn-cell--tile", `jn-t-${t.key.toLowerCase()}`]} data-signup-open aria-label={`${t.key} — create your free account`}>
          <span class="jn-tile-inner">
            <span class="jn-thumb">
              <img class="jn-thumb-img" src={t.img} alt="" loading="lazy" />
            </span>
            <span class="jn-cap">
              <span class="jn-cap-key chapter">{t.key}</span>
              <span class="jn-cap-lines">
                <span class="jn-cap-line">{t.a}</span>
                <span class="jn-cap-line">{t.b}</span>
              </span>
            </span>
          </span>
        </button>
      ))}
    </div>

    <!-- Custom "Click to join" cursor (hover devices only) -->
    <div class="jn-cursor" id="jn-cursor" aria-hidden="true"><span>[ Click to join ]</span></div>

    <!-- Slide-out: the sign-up box -->
    <div class="jn-drawer" id="jn-drawer" hidden aria-hidden="true">
      <div class="jn-drawer-scrim" data-signup-close></div>
      <div class="jn-drawer-panel" role="dialog" aria-modal="true" aria-label="Create your account">
        <button type="button" class="jn-drawer-x" data-signup-close aria-label="Close">&times;</button>
        <div class="chapter">Join the Studio</div>
        <h2 class="jn-form-title">Built for Better Marketing</h2>
        <p class="jn-form-sub">Create your account to access the Studio, your all-in-one workspace for designing content, planning your marketing, managing bookings, accessing resources, and getting more from your TMKE membership.</p>

        <form id="jn-form" class="jn-form" novalidate>
          <label class="jn-field"><span>Full name</span>
            <input type="text" name="full_name" autocomplete="name" required placeholder="Jane Smith" /></label>
          <label class="jn-field"><span>Email</span>
            <input type="email" name="email" autocomplete="email" required placeholder="you@agency.co.uk" /></label>
          <label class="jn-field"><span>Password</span>
            <input type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="At least 8 characters" /></label>
          <label class="jn-check">
            <input type="checkbox" name="marketing" />
            <span>Keep me updated with tips, guides and offers. Unsubscribe anytime.</span>
          </label>
          <button type="submit" class="btn btn--solid jn-submit"><span data-label>Create account</span> <span class="btn-arrow">&rarr;</span></button>
          <p id="jn-error" class="jn-error" hidden><span id="jn-error-text"></span> <a id="jn-error-signin" class="jn-link" href="/login" hidden>Sign in instead</a></p>
        </form>

        <div id="jn-done" class="jn-done" hidden>
          <div class="jn-done-mark" aria-hidden="true">&#10003;</div>
          <h3 class="jn-done-h">Check your inbox</h3>
          <p class="jn-done-p">We've sent a confirmation link to your email. Click it to activate your account, then sign in.</p>
          <a href="/login" class="btn btn--solid jn-submit" style="text-decoration:none;justify-content:center;display:inline-flex"><span>Go to sign in</span></a>
        </div>

        <p class="jn-alt" id="jn-alt">Already a member? <a href="/login" class="jn-link">Sign in</a></p>
      </div>
    </div>
  </main>

  <style>
    main.jn { --jn-line: rgba(28,29,34,0.12); background: var(--paper); min-height: 100vh; display: flex; flex-direction: column; }

    /* ---- Top bar (minimal, mukko-style) ---- */
    .jn-top { display: flex; align-items: center; justify-content: space-between; padding: 16px clamp(18px, 2.4vw, 34px); flex: none; }
    .jn-top-back { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .jn-top-back:hover { color: var(--ink); }
    .jn-top-mark { font-family: var(--serif); font-size: 22px; letter-spacing: 0.08em; color: var(--ink); }

    /* ---- The full-page grid ---- */
    .jn-grid { flex: 1; display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--jn-line); border-left: 1px solid var(--jn-line); }
    .jn-cell { border-right: 1px solid var(--jn-line); border-bottom: 1px solid var(--jn-line); min-height: clamp(320px, 36vh, 440px); position: relative; }

    /* Custom "Click to join" cursor that follows the mouse over the grid */
    .jn-cursor { position: fixed; top: 0; left: 0; z-index: 2500; pointer-events: none; opacity: 0; transition: opacity 0.18s ease; }
    .jn-cursor.is-on { opacity: 1; }
    .jn-cursor span { position: absolute; transform: translate(-50%, -50%); color: var(--english-violet); font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; }
    /* Hide the native cursor over the grid so the pill stands in for it. */
    .jn.jn-has-cursor .jn-grid, .jn.jn-has-cursor .jn-cell--tile { cursor: none; }
    @media (hover: none) { .jn-cursor { display: none; } }

    /* Image tile — image sits SMALL and centred; caption left-aligned to it.
       The cell is roomy and the phrases are always in flow (just fade in), so
       hovering never nudges the layout. */
    .jn-cell--tile { display: flex; align-items: center; justify-content: center; padding: 30px 24px; cursor: pointer; background: none; }
    .jn-tile-inner { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; width: min(66%, 210px); }
    /* overflow visible so the hover blur feathers softly past the edges (a
       natural, shadow-like fuzz) rather than clipping to a hard rectangle. */
    .jn-thumb { position: relative; width: 85%; aspect-ratio: 1080 / 1440; overflow: visible; }
    /* will-change keeps the blur on its own composited layer (sized to include
       the blur's soft overflow) so it renders as a consistent feathered fade and
       never snaps back to a hard-clipped square while you keep hovering. */
    .jn-thumb-img { width: 100%; height: 100%; object-fit: cover; display: block; will-change: filter; transition: filter 0.5s ease, opacity 0.5s ease; }
    .jn-cell--tile:hover .jn-thumb-img, .jn-cell--tile:focus-visible .jn-thumb-img { filter: blur(11px); opacity: 0.5; }
    .jn-cap { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; text-align: left; width: 100%; }
    .jn-cap-key { margin: 0; color: var(--english-violet); }
    .jn-cap-lines { display: flex; flex-direction: column; gap: 2px; opacity: 0; transition: opacity 0.35s ease; }
    .jn-cell--tile:hover .jn-cap-lines, .jn-cell--tile:focus-visible .jn-cap-lines { opacity: 1; }
    .jn-cap-line { font-family: var(--sans); font-size: 12px; line-height: 1.2; color: rgba(28,29,34,0.6); }
    .jn-cell--tile:focus-visible { outline: 2px solid var(--english-violet); outline-offset: -2px; }


    /* ---- Slide-out sign-up ---- */
    .jn-drawer { position: fixed; inset: 0; z-index: 3000; }
    .jn-drawer[hidden] { display: none; }
    .jn-drawer-scrim { position: absolute; inset: 0; background: rgba(28,29,34,0.5); opacity: 0; transition: opacity 0.28s ease; }
    .jn-drawer.is-open .jn-drawer-scrim { opacity: 1; }
    .jn-drawer-panel { position: absolute; top: 0; right: 0; height: 100%; width: clamp(400px, 50vw, 720px); background: var(--paper); box-shadow: -18px 0 60px rgba(28,29,34,0.3); padding: 84px clamp(30px, 3.2vw, 52px) 48px; overflow-y: auto; transform: translateX(100%); transition: transform 0.34s cubic-bezier(0.22,0.61,0.36,1); }
    .jn-drawer.is-open .jn-drawer-panel { transform: translateX(0); }
    .jn-drawer-x { position: absolute; top: 16px; right: 16px; width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(28,29,34,0.14); background: #fff; color: rgba(28,29,34,0.55); font-size: 22px; line-height: 1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
    .jn-drawer-x:hover { color: var(--ink); }
    .jn-drawer-panel .chapter { margin-bottom: 36px; }
    .jn-form-title { font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 3.4vw, 36px); line-height: 1.05; letter-spacing: -0.015em; color: var(--ink); margin: 0 0 12px; }
    .jn-form-sub { font-family: var(--sans); font-size: 14px; font-weight: 500; line-height: 1.55; color: rgba(28,29,34,0.62); margin: 0 0 44px; }
    .jn-form { display: flex; flex-direction: column; gap: 14px; }
    .jn-field { display: flex; flex-direction: column; gap: 7px; }
    .jn-field > span { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .jn-field input { font-family: var(--sans); font-size: 16px; padding: 13px 15px; border: 1px solid rgba(28,29,34,0.18); border-radius: 3px; background: #fff; color: var(--ink); transition: border-color 0.2s, box-shadow 0.2s; }
    .jn-field input:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.12); }
    .jn-check { display: flex; align-items: flex-start; gap: 10px; font-family: var(--sans); font-size: 12.5px; line-height: 1.45; color: rgba(28,29,34,0.62); cursor: pointer; margin-top: 2px; }
    .jn-check input { width: 17px; height: 17px; flex: none; margin-top: 1px; accent-color: var(--english-violet); }
    .jn-submit { width: 100%; justify-content: center; padding: 15px; margin-top: 6px; }
    .jn-error { font-family: var(--sans); font-size: 13px; color: #a05a3c; background: rgba(160,90,60,0.08); padding: 10px 13px; border-radius: 3px; margin: 2px 0 0; }
    .jn-error--info { color: var(--english-violet); background: rgba(78,42,90,0.07); }
    .jn-alt { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); text-align: center; margin: 18px 0 0; }
    .jn-link { color: var(--english-violet); font-weight: 700; border-bottom: 1px solid currentColor; }
    .jn-done { text-align: center; padding: 8px 0; }
    .jn-done-mark { width: 52px; height: 52px; margin: 0 auto 14px; border-radius: 50%; background: rgba(60,150,90,0.14); color: #2e6b40; font-size: 26px; display: flex; align-items: center; justify-content: center; }
    .jn-done-h { font-family: var(--serif); font-weight: 400; font-size: 26px; color: var(--ink); margin: 0 0 8px; }
    .jn-done-p { font-family: var(--sans); font-size: 14px; line-height: 1.55; color: rgba(28,29,34,0.62); margin: 0 0 20px; }

    /* ---- Responsive ---- */
    @media (max-width: 860px) {
      .jn-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 640px) {
      /* Mobile: clean 2-column grid — image + title only. No body text, no blur
         (there's no pointer to hover), and drop Discover so it's an even 8. */
      .jn-grid { grid-template-columns: repeat(2, 1fr); }
      .jn-t-discover { display: none; }
      .jn-cell { min-height: clamp(200px, 44vw, 280px); }
      .jn-cell--tile { padding: 24px 16px; }
      .jn-tile-inner { width: min(82%, 150px); gap: 12px; }
      .jn-cap-lines { display: none; }
      .jn-cell--tile:hover .jn-thumb-img, .jn-cell--tile:focus-visible .jn-thumb-img { filter: none; opacity: 1; }
      .jn-drawer-panel { width: 100vw; }
    }
  </style>

  <script>
    import { supabase } from "../lib/supabase.js";
    import { signUpMember } from "../lib/member-signup.js";

    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) location.replace("/account");
    })();

    /* Arrived from an email we sent them (?email=...). Prefilling is not just a
       courtesy here: a booking joins itself to an account by matching this
       address, so someone who signs up with a different one gets an account
       their shoot is not in. Editable, in case that address is not the one they
       want to log in with. */
    (function prefillEmail() {
      const wanted = new URLSearchParams(location.search).get("email");
      if (!wanted) return;
      const field = document.querySelector('input[name="email"]');
      if (field && !field.value) field.value = wanted.trim();
    })();

    const drawer = document.getElementById("jn-drawer");
    const form = document.getElementById("jn-form");
    const errEl = document.getElementById("jn-error");
    const errTextEl = document.getElementById("jn-error-text");
    const errSignin = document.getElementById("jn-error-signin");
    const doneEl = document.getElementById("jn-done");
    const altEl = document.getElementById("jn-alt");
    let lastFocus = null;

    function openDrawer() {
      document.getElementById("jn-cursor")?.classList.remove("is-on");
      lastFocus = document.activeElement;
      form.hidden = false; doneEl.hidden = true; altEl.hidden = false; errEl.hidden = true;
      drawer.hidden = false; drawer.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => drawer.classList.add("is-open"));
      document.body.style.overflow = "hidden";
      setTimeout(() => { const f = form.querySelector('input[name="full_name"]'); if (f) f.focus(); }, 80);
    }
    function closeDrawer() {
      drawer.classList.remove("is-open"); drawer.setAttribute("aria-hidden", "true");
      setTimeout(() => { drawer.hidden = true; }, 320);
      document.body.style.overflow = "";
      if (lastFocus && lastFocus.focus) { try { lastFocus.focus(); } catch (_) {} }
    }

    document.querySelectorAll("[data-signup-open]").forEach((el) => el.addEventListener("click", openDrawer));
    document.addEventListener("click", (e) => { if (e.target.closest("[data-signup-close]")) closeDrawer(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && drawer.classList.contains("is-open")) closeDrawer(); });

    // Custom "Click to join" cursor over the grid (fine-pointer devices only).
    const jnMain = document.querySelector(".jn");
    const jnGrid = document.querySelector(".jn-grid");
    const jnCursor = document.getElementById("jn-cursor");
    if (jnMain && jnGrid && jnCursor && window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      jnMain.classList.add("jn-has-cursor");
      jnGrid.addEventListener("mousemove", (e) => {
        jnCursor.style.transform = `translate3d(${e.clientX}px, ${e.clientY}px, 0)`;
        if (!drawer.classList.contains("is-open")) jnCursor.classList.add("is-on");
      });
      jnGrid.addEventListener("mouseleave", () => jnCursor.classList.remove("is-on"));
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errEl.hidden = true;
      const data = new FormData(form);
      const btn = form.querySelector('button[type="submit"]');
      const label = btn.querySelector("[data-label]");
      const orig = label.textContent;
      btn.setAttribute("disabled", "true"); label.textContent = "Creating…";

      const res = await signUpMember({
        fullName: data.get("full_name"), email: data.get("email"),
        password: data.get("password"), marketing: !!data.get("marketing"),
      });

      btn.removeAttribute("disabled"); label.textContent = orig;
      if (res.error) {
        errTextEl.textContent = res.error;
        // Already registered isn't a mistake they made, so it doesn't get the
        // error styling — it gets a way out. Carry the address across so the
        // sign-in form is ready rather than asking them to type it twice.
        errEl.classList.toggle("jn-error--info", !!res.existing);
        if (res.existing) errSignin.href = "/login?email=" + encodeURIComponent(String(data.get("email") || "").trim());
        errSignin.hidden = !res.existing;
        errEl.hidden = false;
        return;
      }
      if (res.needsConfirm) { form.hidden = true; altEl.hidden = true; doneEl.hidden = false; }
      else if (typeof window.tmkeSplash === "function") window.tmkeSplash("/account");
      else location.href = "/account";
    });
  </script>
</BaseLayout>
