---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  dashboard
  title="Create your account — TMKE"
  description="Join the TMKE member hub — free. Manage your services, guides and the studio in one place."
  hideNav={true}
  hideFooter={true}
>
  <main class="login-shell">
    <div class="login-art" aria-hidden="true">
      <div class="login-art-overlay"></div>
      <div class="login-art-quote">
        <div class="chapter chapter--light">Members &middot; Free</div>
        <p class="login-art-line">
          A home for <em>everything</em><br />you make with us.
        </p>
        <p class="login-art-sub">
          Your services, your reports, guides and the studio — one login, no purchase needed.
        </p>
      </div>
    </div>

    <section class="login-panel">
      <a href="/" class="login-mark">TMKE</a>
      <a href="/" class="login-back" aria-label="Go back"><span aria-hidden="true">&larr;</span> Back</a>

      <div class="login-card">
        <div class="eyebrow">Create account</div>
        <h1 class="login-title">Join the TMKE hub.</h1>
        <p class="login-sub">
          Already a member?
          <a href="/login" class="login-inline-anchor">Sign in</a>.
        </p>

        <form id="signup-page-form" class="login-form" novalidate>
          <label class="login-field">
            <span>Full name</span>
            <input type="text" name="full_name" autocomplete="name" required placeholder="Jane Smith" />
          </label>
          <label class="login-field">
            <span>Email</span>
            <input type="email" name="email" autocomplete="email" required placeholder="you@agency.co.uk" />
          </label>
          <label class="login-field">
            <span>Password</span>
            <input type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="At least 8 characters" />
          </label>
          <label class="signup-check">
            <input type="checkbox" name="marketing" />
            <span>Keep me updated with tips, guides and offers. You can unsubscribe anytime.</span>
          </label>

          <button type="submit" class="btn btn--solid login-submit">
            <span data-label>Create account</span> <span class="btn-arrow">&rarr;</span>
          </button>

          <p id="signup-page-error" class="login-error" hidden></p>
        </form>

        <div id="signup-page-done" class="signup-done" hidden>
          <div class="signup-done-mark" aria-hidden="true">&#10003;</div>
          <h2 class="signup-done-h">Check your inbox</h2>
          <p class="signup-done-p">We've sent a confirmation link to your email. Click it to activate your account, then sign in.</p>
          <a href="/login" class="btn btn--solid login-submit" style="text-decoration:none;justify-content:center;display:inline-flex"><span>Go to sign in</span></a>
        </div>
      </div>

      <p class="login-meta">© 2026 TMKE — The Marketing Experts</p>
    </section>
  </main>

  <style>
    main.login-shell { display: grid; grid-template-columns: 1.05fr 1fr; min-height: 100vh; background: var(--paper); }
    .login-art {
      position: relative; overflow: hidden;
      background:
        linear-gradient(180deg, rgba(28,29,34,0.2), rgba(28,29,34,0.7)),
        url("/assets/door-closed.png") center/cover no-repeat;
      color: var(--paper);
    }
    .login-art-overlay { position: absolute; inset: 0; background: radial-gradient(80% 60% at 50% 40%, rgba(0,0,0,0) 30%, rgba(0,0,0,0.35) 100%); pointer-events: none; }
    .login-art-quote { position: absolute; inset: auto 0 0 0; padding: 0 56px 80px; }
    .login-art-quote .chapter { margin-bottom: 48px; }
    .login-art-line { font-family: var(--serif); font-weight: 400; font-size: clamp(40px, 4.4vw, 64px); line-height: 1.05; letter-spacing: -0.015em; margin: 0 0 18px; color: var(--paper); max-width: 15ch; }
    .login-art-line em { font-style: italic; color: var(--french-grey); }
    .login-art-sub { font-family: var(--sans); font-size: 15px; line-height: 1.55; color: rgba(244,242,241,0.72); margin: 0; max-width: 34ch; }
    .login-panel { position: relative; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48px 36px; }
    .login-mark { position: absolute; top: 32px; left: 36px; font-family: var(--serif); font-size: 24px; letter-spacing: 0.06em; color: var(--ink); }
    .login-back { position: absolute; top: 34px; right: 36px; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .login-back:hover { color: var(--ink); }
    .login-card { width: 100%; max-width: 440px; }
    .login-card .eyebrow { margin-bottom: 14px; }
    .login-title { font-family: var(--serif); font-weight: 400; font-size: clamp(34px, 3.6vw, 50px); line-height: 1.05; letter-spacing: -0.015em; color: var(--ink); margin: 0 0 16px; }
    .login-sub { font-size: 15px; color: rgba(28, 29, 34, 0.62); margin: 0 0 32px; }
    .login-inline-anchor { color: var(--english-violet); border-bottom: 1px solid currentColor; font-weight: 600; }
    .login-form { display: flex; flex-direction: column; gap: 16px; }
    .login-field { display: flex; flex-direction: column; gap: 8px; }
    .login-field > span { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: rgba(28, 29, 34, 0.55); }
    .login-field input { font-family: var(--sans); font-size: 16px; padding: 14px 16px; border: 1px solid rgba(28, 29, 34, 0.18); border-radius: 2px; background: #fff; color: var(--ink); transition: border-color 0.25s, box-shadow 0.25s; }
    .login-field input:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(var(--violet-rgb), 0.12); }
    .signup-check { display: flex; align-items: flex-start; gap: 10px; font-family: var(--sans); font-size: 13px; line-height: 1.45; color: rgba(28,29,34,0.62); cursor: pointer; }
    .signup-check input { width: 17px; height: 17px; flex: none; margin-top: 1px; accent-color: var(--english-violet); }
    .login-submit { width: 100%; justify-content: center; padding: 16px; margin-top: 8px; }
    .login-error { font-size: 13px; color: #a05a3c; background: rgba(160, 90, 60, 0.08); padding: 10px 14px; border-radius: 2px; margin: 0; }
    .login-meta { position: absolute; bottom: 32px; font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(28, 29, 34, 0.35); }
    .signup-done { text-align: center; padding: 8px 0; }
    .signup-done-mark { width: 54px; height: 54px; margin: 0 auto 16px; border-radius: 50%; background: rgba(60,150,90,0.14); color: #2e6b40; font-size: 27px; display: flex; align-items: center; justify-content: center; }
    .signup-done-h { font-family: var(--serif); font-weight: 400; font-size: 30px; color: var(--ink); margin: 0 0 10px; }
    .signup-done-p { font-size: 15px; line-height: 1.55; color: rgba(28,29,34,0.62); margin: 0 0 24px; }
    @media (max-width: 900px) { main.login-shell { grid-template-columns: 1fr; } .login-art { display: none; } }
  </style>

  <script>
    import { supabase } from "../lib/supabase.js";
    import { signUpMember } from "../lib/member-signup.js";

    // Already signed in? Send them to the hub.
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (session) location.replace("/account");
    })();

    const form = document.getElementById("signup-page-form");
    const errEl = document.getElementById("signup-page-error");
    const doneEl = document.getElementById("signup-page-done");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errEl.hidden = true;
      const data = new FormData(form);
      const btn = form.querySelector('button[type="submit"]');
      const label = btn.querySelector("[data-label]");
      const orig = label.textContent;
      btn.setAttribute("disabled", "true"); label.textContent = "Creating…";

      const res = await signUpMember({
        fullName: data.get("full_name"), email: data.get("email"),
        password: data.get("password"), marketing: !!data.get("marketing"),
      });

      btn.removeAttribute("disabled"); label.textContent = orig;
      if (res.error) { errEl.textContent = res.error; errEl.hidden = false; return; }
      if (res.needsConfirm) {
        form.hidden = true; doneEl.hidden = false;
      } else if (typeof window.tmkeSplash === "function") {
        window.tmkeSplash("/account");
      } else {
        location.href = "/account";
      }
    });
  </script>
</BaseLayout>
