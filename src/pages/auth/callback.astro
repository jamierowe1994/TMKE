---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Signing you in… — TMKE"
  description="Finishing your TMKE sign-in."
  hideNav={true}
  hideFooter={true}
>
  <main class="cb-wrap">
    <div class="cb-card">
      <div class="cb-eyebrow">TMKE &middot; Members</div>
      <h1 class="cb-title">
        <span id="cb-headline">Confirming your email…</span>
      </h1>
      <p id="cb-sub" class="cb-sub">
        One moment — we're verifying the link and signing you in.
      </p>
      <p id="cb-error" class="cb-error" hidden></p>

      <!-- "Back to sign in" is a dead end on its own: an unconfirmed account
           can't sign in, and the address is taken so they can't register
           again. The way out of a dead link is another link. -->
      <form id="cb-resend" class="cb-resend" hidden>
        <label class="cb-label" for="cb-email">Send yourself a new link</label>
        <div class="cb-resend-row">
          <input type="email" id="cb-email" name="email" required autocomplete="email" placeholder="you@agency.co.uk" class="cb-input" />
          <button type="submit" class="cb-btn"><span data-label>Send</span></button>
        </div>
        <p id="cb-resend-msg" class="cb-resend-msg" hidden></p>
      </form>

      <a href="/login" id="cb-retry" class="cb-cta" hidden>Back to sign in <span>&rarr;</span></a>
    </div>
  </main>

  <style>
    main.cb-wrap {
      min-height: 100vh;
      display: flex; align-items: center; justify-content: center;
      background: var(--paper); padding: 24px;
    }
    .cb-card {
      max-width: 520px; text-align: center;
    }
    .cb-eyebrow {
      font-family: var(--sans);
      font-size: 12px; font-weight: 600;
      letter-spacing: 0.42em; text-transform: uppercase;
      color: rgba(28,29,34,0.5);
      margin-bottom: 28px;
    }
    .cb-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(36px, 4vw, 56px);
      line-height: 1.05; letter-spacing: -0.015em;
      color: var(--ink); margin: 0 0 16px;
    }
    .cb-sub {
      font-family: var(--serif); font-style: italic;
      font-size: clamp(16px, 1.4vw, 19px);
      color: rgba(28,29,34,0.62);
      margin: 0 0 24px;
    }
    .cb-error {
      font-family: var(--sans); font-size: 14px;
      color: #a05a3c;
      background: rgba(160, 90, 60, 0.08);
      padding: 12px 16px; border-radius: 2px;
      margin: 0 0 18px;
    }
    .cb-resend { margin: 22px 0 18px; text-align: left; }
    .cb-label {
      display: block; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700;
      color: rgba(28,29,34,0.55); margin-bottom: 8px;
    }
    .cb-resend-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .cb-input {
      flex: 1 1 200px; min-width: 0; padding: 11px 13px;
      border: 1px solid rgba(28,29,34,0.2); border-radius: 3px;
      font-family: var(--sans); font-size: 14px; color: var(--ink); background: #fff;
    }
    .cb-input:focus { outline: none; border-color: var(--english-violet); }
    .cb-btn {
      flex: none; padding: 11px 22px; border: 0; border-radius: 3px; cursor: pointer;
      background: var(--english-violet); color: #fff;
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase;
    }
    .cb-btn[disabled] { opacity: 0.55; cursor: default; }
    .cb-resend-msg {
      font-family: var(--sans); font-size: 13px; line-height: 1.5;
      margin: 10px 0 0; color: #2e6b40;
    }
    .cb-resend-msg.is-bad { color: #a05a3c; }

    .cb-cta {
      display: inline-flex; align-items: center; gap: 10px;
      font-family: var(--sans); font-size: 12px;
      font-weight: 700; letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--english-violet);
      border-bottom: 1px solid currentColor;
      padding-bottom: 3px;
    }
  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";

    const $headline = document.getElementById("cb-headline");
    const $sub = document.getElementById("cb-sub");
    const $error = document.getElementById("cb-error");
    const $retry = document.getElementById("cb-retry");

    const $resend = document.getElementById("cb-resend");
    const $resendMsg = document.getElementById("cb-resend-msg");

    function fail(msg) {
      $headline.textContent = "That link didn't work.";
      $sub.textContent = "It may have expired, been used already, or been opened in a different browser from the one you signed up in. Any of those is fixable — send yourself a fresh one.";
      $error.textContent = msg;
      $error.hidden = false;
      $resend.hidden = false;
      $retry.hidden = false;
    }

    // Neutral wording whatever the outcome: this form is public, so it must not
    // become a way of finding out which addresses have accounts.
    $resend.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = String(document.getElementById("cb-email").value || "").trim();
      if (!email) return;
      const btn = $resend.querySelector("button");
      const label = btn.querySelector("[data-label]");
      const orig = label.textContent;
      btn.setAttribute("disabled", "true");
      label.textContent = "Sending…";
      $resendMsg.hidden = true;
      $resendMsg.classList.remove("is-bad");

      const { error } = await supabase.auth.resend({
        type: "signup",
        email,
        options: { emailRedirectTo: location.origin + "/auth/callback" },
      });

      label.textContent = orig;
      $resendMsg.hidden = false;
      if (error && /rate|limit|seconds/i.test(error.message || "")) {
        // Worth saying plainly - otherwise it reads as another broken thing.
        $resendMsg.classList.add("is-bad");
        $resendMsg.textContent = "That was a moment ago — give it a minute and try again.";
        btn.removeAttribute("disabled");
        return;
      }
      $resendMsg.textContent = "If that address needs confirming, a new link is on its way. Open it in this browser.";
    });

    function routeAfter() {
      const params = new URLSearchParams(location.search);
      const next = params.get("next") || "/account";
      if (typeof window.tmkeSplash === "function") {
        window.tmkeSplash(next);
      } else {
        location.replace(next);
      }
    }

    // The supabase-js client auto-handles tokens that appear in the URL
    // fragment (e.g. ?code=... or #access_token=...). Wait for either an
    // auth event or an existing session.
    let routed = false;
    const sub = supabase.auth.onAuthStateChange((event, session) => {
      if (routed) return;
      if (event === "SIGNED_IN" || (event === "PASSWORD_RECOVERY" && session)) {
        routed = true;
        if (event === "PASSWORD_RECOVERY") {
          location.replace("/reset-password");
          return;
        }
        routeAfter();
      }
    });

    (async () => {
      const params = new URLSearchParams(location.search);

      // token_hash first, because it is the only route that survives being
      // opened in a different browser from the one that signed up.
      //
      // The ?code= exchange below is PKCE: it needs a code_verifier that only
      // exists in the localStorage of the browser that STARTED the sign-up. Open
      // the email on your laptop after signing up on your phone and there is no
      // verifier, so the exchange cannot complete and the link looks broken
      // through no fault of the user's. verifyOtp carries everything it needs in
      // the URL, so it works anywhere.
      //
      // Dormant until the Supabase email template sends token_hash — see
      // AUTH_SETUP.md. Harmless while it doesn't; nothing else changes.
      const tokenHash = params.get("token_hash");
      if (tokenHash) {
        const type = params.get("type") || "email";
        const { error } = await supabase.auth.verifyOtp({ type, token_hash: tokenHash });
        if (error) { fail(error.message); return; }
        if (!routed) {
          routed = true;
          // Recovery links land here too; they need the password form, not the hub.
          if (type === "recovery") location.replace("/reset-password");
          else routeAfter();
        }
        return;
      }

      // Some flows return a `?code=` instead of a fragment — exchange it explicitly.
      const code = params.get("code");
      if (code) {
        const { error } = await supabase.auth.exchangeCodeForSession(code);
        if (error) { fail(error.message); return; }
        if (!routed) {
          routed = true;
          routeAfter();
        }
        return;
      }
      // Fallback: poll briefly for a session, then give up.
      let tries = 0;
      const id = setInterval(async () => {
        tries++;
        const { data: { session } } = await supabase.auth.getSession();
        if (session && !routed) {
          routed = true;
          clearInterval(id);
          routeAfter();
        } else if (tries > 12) {
          clearInterval(id);
          if (!routed) fail("The link is missing the auth token.");
        }
      }, 250);
    })();
  </script>
</BaseLayout>
