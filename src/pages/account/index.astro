---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { templates } from "../../data/library.js";

// "Continue working" falls back to templates the user can start from (so it's
// never blank) when they have no saved drafts. JS swaps in real drafts if any.
const recentTemplates = templates.slice(0, 4);

// The hero shows a mini Studio with a real pack template on the canvas; it
// rotates to the next template on each visit (see the rotate script below).
const heroTemplates = templates.map((t) => ({ id: t.id, thumb: t.thumb, name: t.name }));
const heroFirst = heroTemplates[0];
---

<!--
  TMKE workspace — Phase 2. Editorial, asymmetric composition (mock data).
  Standalone preview at /dashboard; the live /account is untouched.

  Hierarchy: ONE immersive hero (brief + dominant design preview) leads the eye,
  then a left "workflow" column (plan -> recent work) beside a lighter right
  "insights" column (idea, brand health, performance), finishing on a full-width
  discovery card. Sections are grouped by whitespace + depth, not borders.
-->
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Your TMKE — workspace"
  description="Your marketing brief, your designs in progress, and what's new — beautifully organised."
>
  <div class="ws">
    <!-- ============ Top navigation ============ -->
    <header class="ws-nav" aria-label="Primary">
      <!-- LEFT: hamburger opens the off-canvas drawer -->
      <button type="button" class="ws-burger" data-drawer-open aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <!-- CENTRE: the six core sections -->
      <nav class="ws-tabs" aria-label="Sections">
        <a class="ws-tab is-active" href="/account" aria-current="page">Dashboard</a>
        <a class="ws-tab" href="/account/studio">Studio</a>
        <a class="ws-tab" href="/account/schedule">Planner</a>
        <a class="ws-tab" href="/account/orders">Orders</a>
        <a class="ws-tab" href="/account/bookings">Bookings</a>
        <a class="ws-tab" href="/account/social">Your SMM</a>
        <a class="ws-tab" href="/edit">Shop</a>
      </nav>

      <!-- RIGHT: notifications, log out, you -->
      <div class="ws-nav-right">
        <div class="ws-menu ws-notif" data-menu>
          <button type="button" class="ws-navic" data-menu-btn aria-expanded="false" aria-haspopup="true" aria-label="Notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg><span class="ws-dot" data-notif-dot></span></button>
          <div class="ws-dropdown ws-dropdown--right ws-dropdown--notif" role="menu">
            <div class="ws-notif-head"><strong>Notifications</strong><button type="button" class="ws-notif-clear" data-notif-clear>Mark all read</button></div>
            <div class="ws-notif-list">
              <a class="ws-notif-item" role="menuitem" href="/account/orders">
                <span class="ws-notif-ic ws-notif-ic--order"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
                <span class="ws-notif-txt"><b>Order confirmed</b><i>Your “City Centre” pack is ready to edit</i></span>
                <span class="ws-notif-time">2h</span>
              </a>
              <a class="ws-notif-item" role="menuitem" href="/account/bookings">
                <span class="ws-notif-ic ws-notif-ic--booking"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg></span>
                <span class="ws-notif-txt"><b>Booking confirmed</b><i>Content Studio — Wed 9 Jul, 10:00</i></span>
                <span class="ws-notif-time">5h</span>
              </a>
              <a class="ws-notif-item" role="menuitem" href="/account/blog">
                <span class="ws-notif-ic ws-notif-ic--blog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
                <span class="ws-notif-txt"><b>New on the blog</b><i>5 hooks that stop the scroll</i></span>
                <span class="ws-notif-time">1d</span>
              </a>
              <a class="ws-notif-item" role="menuitem" href="/account/guides">
                <span class="ws-notif-ic ws-notif-ic--news"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="13" x2="14" y2="13"/></svg></span>
                <span class="ws-notif-txt"><b>What’s new</b><i>Scheduling just got faster in the Planner</i></span>
                <span class="ws-notif-time">2d</span>
              </a>
            </div>
          </div>
        </div>
        <a class="ws-navic ws-logout" href="/login" data-logout data-tip="Log out" aria-label="Log out"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"/><path d="M10 17l5-5-5-5"/><line x1="15" y1="12" x2="3" y2="12"/></svg></a>
        <div class="ws-menu ws-who" data-menu>
          <button type="button" class="ws-whobtn" data-menu-btn aria-expanded="false" aria-haspopup="true">
            <span class="ws-whoav">DC</span>
            <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ws-dropdown ws-dropdown--right" role="menu">
            <div class="ws-dropdown-head"><strong>Danielle Carter</strong><span>danielle@marinaestates.co.uk</span></div>
            <a role="menuitem" href="/account/profile">Your profile</a>
            <a role="menuitem" href="/account/profile">Brand Kit</a>
            <a role="menuitem" href="/account/orders">Billing</a>
            <a role="menuitem" href="/login" class="ws-dropdown-out">Sign out</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Off-canvas drawer — slides in from the left (everything that isn't a tab) -->
    <div class="ws-drawer" data-drawer hidden>
      <div class="ws-drawer-scrim" data-drawer-close></div>
      <aside class="ws-drawer-panel" aria-label="More menu">
        <div class="ws-drawer-top">
          <a class="ws-logo" href="/account">TMKE</a>
          <button type="button" class="ws-navic ws-drawer-x" data-drawer-close aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button>
        </div>
        <nav class="ws-drawer-nav" aria-label="All sections">
          <span class="ws-drawer-label">Workspace</span>
          <a href="/account" class="is-active" aria-current="page">Dashboard</a>
          <a href="/account/studio">Studio</a>
          <a href="/account/schedule">Planner</a>
          <a href="/account/orders">Orders</a>
          <a href="/account/bookings">Bookings</a>
          <a href="/edit">Shop</a>
          <span class="ws-drawer-label">Learn</span>
          <a href="/account/guides">Guides</a>
          <a href="/account/blog">Blog</a>
          <span class="ws-drawer-label">Manage</span>
          <a href="/account/profile">Brand Kit</a>
          <a href="/account/social">Your SMM</a>
          <a href="/account/orders">Billing</a>
          <a href="/account/profile">Settings</a>
          <span class="ws-drawer-label">Help</span>
          <a href="/contact">Contact</a>
          <a href="/contact">Help Centre</a>
        </nav>
        <a class="ws-drawer-out" href="/login" data-logout>Sign out</a>
      </aside>
    </div>

    <main class="ws-main">
      <!-- ============ Left: the workflow ============ -->
      <div class="ws-left">
        <!-- HERO — compact greeting band: one-line greeting + brief stats on a row -->
        <section class="ws-hero">
          <div class="ws-hero-top">
            <h1 class="ws-greeting">Good Evening, <em>Danielle</em>.</h1>
          </div>
          <ul class="ws-brief">
            <li style="--d:1"><span class="ws-brief-ic ws-brief-ic--sched"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg></span><span><strong id="brief-sched">— posts</strong> planned this week</span></li>
            <li style="--d:3"><span class="ws-brief-ic ws-brief-ic--star"><svg viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M12 2.6l2.72 5.52 6.08.88-4.4 4.29 1.04 6.06L12 16.98l-5.44 2.85 1.04-6.06-4.4-4.29 6.08-.88z"/></svg></span><span><strong>Wimbledon</strong> pack unlocks tomorrow</span></li>
          </ul>
          <a class="ws-btn ws-btn--primary ws-hero-cta-btn" href="/account/editor">Continue designing
            <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </section>

        <!-- PLAN -->
        <section class="ws-block" aria-labelledby="plan-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="plan-h">This Week</h2>
          </header>
          <div class="ws-week">
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Mon</span><span class="ws-day-type">Just Listed</span><span class="ws-day-thumb" style="background-image:url('/assets/home%20window.jpg')"></span></a>
            <button class="ws-day ws-day--empty" type="button"><span class="ws-day-name">Tue</span><span class="ws-day-empty-msg">No content planned</span><span class="ws-day-plus" aria-hidden="true">+</span></button>
            <a class="ws-day is-today" href="/account/schedule"><span class="ws-day-name">Wed <i>Today</i></span><span class="ws-day-type">Market Update</span><span class="ws-day-thumb" style="background-image:url('/assets/sitting%20chair.jpg')"></span></a>
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Thu</span><span class="ws-day-type">Personal Branding</span><span class="ws-day-thumb" style="background-image:url('/assets/home%20chair.jpg')"></span></a>
            <button class="ws-day ws-day--empty" type="button"><span class="ws-day-name">Fri</span><span class="ws-day-empty-msg">No content planned</span><span class="ws-day-plus" aria-hidden="true">+</span></button>
          </div>
        </section>

        <!-- RECENT DESIGNS -->
        <section class="ws-block" aria-labelledby="recent-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="recent-h">Continue Working</h2>
          </header>
          <div class="ws-reel">
            {recentTemplates.map((t) => (
              <a class="ws-thumb" href={`/account/editor?template=${encodeURIComponent(t.id)}`} style={`background-image:url('${t.thumb}')`}><span class="ws-thumb-tag">Template</span></a>
            ))}
            <a class="ws-thumb ws-thumb--new" href="/account/editor"><span class="ws-thumb-new-msg">New design</span><span class="ws-thumb-plus" aria-hidden="true">+</span></a>
          </div>
        </section>
      </div>

      <!-- ============ Right: the insights ============ -->
      <div class="ws-right">
        <!-- TODAY'S IDEA -->
        <section class="ws-widget ws-rise" style="--delay:1.8s" aria-labelledby="idea-h">
          <header class="ws-widget-head">
            <span class="ws-wtitle ws-wtitle--chapter">Today's prompt</span>
          </header>
          <p class="ws-idea" id="idea-h">“Three questions every buyer asks during a viewing — and how you answer them.”</p>
          <div class="ws-widget-foot">
            <a class="ws-btn ws-btn--primary ws-btn--sm" href="/account/editor">Create post
              <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
            <button type="button" class="ws-iconround ws-tip-right" data-tip="Another idea" aria-label="Another idea">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5l2 2M20 12a8 8 0 0 1-14 5l-2-2"/><path d="M20 4v5h-5M4 20v-5h5"/></svg>
            </button>
          </div>
        </section>

        <!-- BRAND HEALTH -->
        <section class="ws-widget ws-rise" style="--delay:1.95s" aria-labelledby="brand-h">
          <header class="ws-widget-head">
            <span class="ws-wtitle">Brand Health</span>
            <span class="ws-ring" data-tip="Finish your Brand Kit so every design is on-brand automatically">
              <svg viewBox="0 0 36 36" aria-hidden="true"><circle class="ws-ring-bg" cx="18" cy="18" r="15.5"/><circle class="ws-ring-fg" cx="18" cy="18" r="15.5" data-ring="66"/></svg>
              <b data-count="66">0</b><i>%</i>
            </span>
          </header>
          <ul class="ws-journey" id="brand-h">
            <li class="is-done"><span class="ws-check"></span>Logo</li>
            <li class="is-done"><span class="ws-check"></span>Colours</li>
            <li><span class="ws-check"></span>Fonts</li>
          </ul>
          <a class="ws-textlink ws-textlink--accent" href="/account/profile">Finish setup →</a>
        </section>

        <!-- BOOKINGS -->
        <section class="ws-widget ws-widget--fill ws-rise" style="--delay:2.1s" aria-labelledby="bk-h">
          <header class="ws-widget-head">
            <span class="ws-wtitle" id="bk-h">Bookings</span>
            <a class="ws-textlink ws-textlink--accent ws-wlink" href="/account/bookings">View all →</a>
          </header>
          <div class="ws-bk">
            <div class="ws-bk-track" id="ws-bk-track">
              <div class="ws-bk-empty">Loading…</div>
            </div>
            <div class="ws-bk-nav" id="ws-bk-nav" hidden>
              <button type="button" class="ws-bk-arrow" data-bk-prev aria-label="Previous booking">&lsaquo;</button>
              <div class="ws-bk-dots" id="ws-bk-dots"></div>
              <button type="button" class="ws-bk-arrow" data-bk-next aria-label="Next booking">&rsaquo;</button>
            </div>
          </div>
        </section>
      </div>

      <!-- ============ Discovery — full width ============ -->
      <a class="ws-discover ws-rise" style="--delay:1.65s" href="/edit" aria-label="Preview the Wimbledon seasonal pack">
        <div class="ws-discover-art" style="background-image:url('/assets/outside.jpg')"></div>
        <div class="ws-discover-body">
          <span class="ws-discover-flag">Unlocks tomorrow</span>
          <h2 class="ws-discover-h">Wimbledon seasonal pack</h2>
          <p class="ws-discover-desc">12 timely templates to ride the tournament buzz in your local feed.</p>
          <span class="ws-discover-cta">Preview the pack <span aria-hidden="true">→</span></span>
        </div>
      </a>
    </main>

    <!-- Contextual coach — one state-driven nudge, anchored to the relevant
         element, shown after the entrance settles. Rule list in the script. -->
    <div id="ws-coach" class="ws-coach" role="status" aria-live="polite" hidden>
      <span class="ws-coach-spark" aria-hidden="true">✦</span>
      <span class="ws-coach-msg" id="ws-coach-msg"></span>
      <button type="button" class="ws-coach-x" id="ws-coach-x" aria-label="Dismiss tip">&times;</button>
    </div>
  </div>

  <style is:global>
    /* =====================================================================
       Workspace Phase 2 — editorial, asymmetric, layered. White cards float
       on a softly textured off-white page; supporting widgets recede. Borders
       give way to whitespace + depth. Colour only for meaning.
       ===================================================================== */
    body[data-dashboard] { background: #ffffff; }
    .ws {
      --ws-bg: #ffffff;
      --ws-card: #ffffff;
      --ws-soft: #ffffff;
      --ws-ink: #1c1d22;
      --ws-tx: rgba(28, 29, 34, 0.64);
      --ws-faint: rgba(28, 29, 34, 0.46);
      --ws-line: rgba(28, 29, 34, 0.13);   /* the one light-grey outline everything shares */
      --ws-accent: var(--english-violet, #5b4a55);
      --ws-success: #3f9468;
      --ws-r-lg: 4px; --ws-r: 4px; --ws-r-sm: 4px;   /* near-square boxes; images keep their own larger radius */
      --ws-sh-hero: none;   /* no shadows — hierarchy comes from outline + space */
      --ws-sh: none;
      --ws-ease: cubic-bezier(.2, .8, .2, 1);
      min-height: 100vh;
      color: var(--ws-ink);
      font-family: var(--sans);
      background: #ffffff;
    }

    /* ---------- Navigation — clean, no chrome, not sticky ---------- */
    .ws-nav {
      position: relative;
      z-index: 60;   /* header (and its dropdowns) stack above the page content */
      display: flex; align-items: center; gap: clamp(14px, 2.4vw, 36px);
      padding: 22px clamp(22px, 2.6vw, 56px) 16px;
      background: transparent;
    }
    /* Hamburger — staggered lines, short middle line grows on hover; opens the drawer */
    .ws-burger { flex: 0 0 auto; width: 42px; height: 42px; border-radius: 12px; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; background: transparent; border: 0; cursor: pointer; transition: background 0.2s; }
    .ws-burger:hover { background: rgba(28, 29, 34, 0.06); }
    .ws-burger span { display: block; width: 19px; height: 1.8px; border-radius: 2px; background: var(--ws-ink); transition: width 0.3s var(--ws-ease); }
    .ws-burger span:nth-child(2) { width: 13px; align-self: flex-start; margin-left: 11.5px; }
    .ws-burger:hover span:nth-child(2) { width: 19px; }

    /* Off-canvas drawer (the cool slide-in) */
    .ws-drawer { position: fixed; inset: 0; z-index: 90; }
    .ws-drawer[hidden] { display: none; }
    .ws-drawer-scrim { position: absolute; inset: 0; background: rgba(20,16,22,0.42); opacity: 0; -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); transition: opacity 0.3s var(--ws-ease); }
    .ws-drawer.is-open .ws-drawer-scrim { opacity: 1; }
    .ws-drawer-panel { position: absolute; top: 0; left: 0; bottom: 0; width: min(320px, 86vw); display: flex; flex-direction: column; padding: 18px 18px 22px; background: #fff; box-shadow: 0 0 60px -10px rgba(28,29,34,0.45); transform: translateX(-100%); transition: transform 0.34s var(--ws-ease); overflow-y: auto; }
    .ws-drawer.is-open .ws-drawer-panel { transform: none; }
    .ws-drawer-top { display: flex; align-items: center; justify-content: space-between; padding: 6px 2px 14px; margin-bottom: 8px; border-bottom: 1px solid var(--ws-line); }
    .ws-logo { font-family: var(--subhead, Georgia, serif); font-size: 20px; font-weight: 600; letter-spacing: 0.05em; color: var(--ws-ink); text-decoration: none; }
    .ws-drawer-x svg { width: 18px; height: 18px; }
    .ws-drawer-nav { display: flex; flex-direction: column; gap: 1px; }
    .ws-drawer-label { font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-faint); padding: 16px 10px 6px; }
    .ws-drawer-nav a { display: block; padding: 9px 12px; border-radius: 10px; font-size: 14px; font-weight: 500; color: var(--ws-tx); text-decoration: none; transition: background 0.16s, color 0.16s; }
    .ws-drawer-nav a:hover { background: rgba(28,29,34,0.05); color: var(--ws-ink); }
    .ws-drawer-nav a.is-active { background: color-mix(in srgb, var(--ws-accent) 10%, #fff); color: var(--ws-accent); font-weight: 600; }
    .ws-drawer-out { margin-top: auto; padding: 12px; border-radius: 11px; text-align: center; font-size: 13.5px; font-weight: 600; color: var(--ws-accent); text-decoration: none; border: 1px solid var(--ws-line); transition: background 0.18s; }
    .ws-drawer-out:hover { background: rgba(28,29,34,0.05); }

    .ws-tabs { flex: 1; display: flex; align-items: center; justify-content: center; gap: clamp(12px, 1.9vw, 36px); }
    .ws-tab {
      position: relative; display: inline-flex; align-items: center;
      padding: 6px 2px; font-size: clamp(15px, 1.1vw, 17px); font-weight: 500;
      color: var(--ws-tx); text-decoration: none; border: 0; background: transparent; cursor: pointer; font-family: inherit;
      transition: color 0.2s;
    }
    .ws-tab:hover { color: var(--ws-ink); }
    .ws-tab.is-active { color: var(--ws-ink); font-weight: 600; }
    .ws-tab.is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -7px; height: 2px; border-radius: 2px; background: var(--ws-ink); }
    .ws-caret { width: 9px; height: 6px; opacity: 0.55; transition: transform 0.25s var(--ws-ease); }

    .ws-nav-right { flex: 0 0 auto; display: flex; align-items: center; gap: 10px; }
    .ws-navic {
      position: relative; width: 42px; height: 42px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      background: transparent; border: 0; cursor: pointer; color: var(--ws-tx);
      transition: background 0.2s, color 0.2s, transform 0.2s var(--ws-ease);
    }
    .ws-navic:hover { background: rgba(28, 29, 34, 0.05); color: var(--ws-ink); }
    .ws-navic svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-dot { position: absolute; top: 9px; right: 11px; width: 7px; height: 7px; border-radius: 50%; background: var(--ws-accent); box-shadow: 0 0 0 2px #fff; }
    .ws-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

    .ws-whobtn { display: inline-flex; align-items: center; gap: 7px; padding: 4px 8px 4px 4px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; font-family: inherit; transition: background 0.2s; }
    .ws-whobtn:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-whoav { width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; font-weight: 700; letter-spacing: 0.03em; color: #fff; background: linear-gradient(140deg, color-mix(in srgb, var(--ws-accent) 70%, #fff), var(--ws-accent)); background-size: cover; background-position: center; }

    /* ---------- Dropdowns ---------- */
    .ws-menu { position: relative; }
    .ws-dropdown { position: absolute; top: calc(100% + 10px); left: 0; min-width: 210px; padding: 8px; background: #fff; border: 1px solid var(--ws-line); border-radius: 14px; box-shadow: 0 24px 50px -22px rgba(28,29,34,0.28); opacity: 0; transform: translateY(-10px) scale(0.9); transform-origin: top left; pointer-events: none; transition: opacity 0.22s var(--ws-ease), transform 0.38s cubic-bezier(.34, 1.56, .4, 1); z-index: 50; }
    .ws-menu.is-open .ws-dropdown { opacity: 1; transform: none; pointer-events: auto; }
    /* Mega-menu items cascade in — the lively "bubble out" reveal */
    .ws-menu.is-open .ws-caret { transform: rotate(180deg); }
    .ws-dropdown a { display: block; padding: 10px 12px; border-radius: 9px; font-size: 13.5px; color: var(--ws-tx); text-decoration: none; transition: background 0.16s, color 0.16s; }
    .ws-dropdown a:hover { background: rgba(28, 29, 34, 0.05); color: var(--ws-ink); }
    .ws-dropdown-head { padding: 8px 12px 10px; border-bottom: 1px solid var(--ws-line); margin-bottom: 6px; display: flex; flex-direction: column; gap: 2px; }
    .ws-dropdown-head strong { font-size: 14px; color: var(--ws-ink); }
    .ws-dropdown-head span { font-size: 12px; color: var(--ws-faint); }
    .ws-dropdown-out { color: var(--ws-accent) !important; font-weight: 600; }
    /* Right-anchored dropdowns (notifications, account) stay on-screen at the page edge */
    .ws-dropdown--right { left: auto; right: 0; transform-origin: top right; }

    /* Notifications panel */
    .ws-dropdown--notif { width: 332px; min-width: 332px; padding: 8px; }
    .ws-notif-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 10px 10px; border-bottom: 1px solid var(--ws-line); margin-bottom: 4px; }
    .ws-notif-head strong { font-size: 14px; color: var(--ws-ink); }
    .ws-notif-clear { font-family: inherit; font-size: 11.5px; font-weight: 600; color: var(--ws-accent); background: none; border: 0; padding: 0; cursor: pointer; }
    .ws-notif-clear:hover { text-decoration: underline; }
    .ws-notif-list { display: flex; flex-direction: column; }
    .ws-notif-item { display: flex; align-items: flex-start; gap: 11px; padding: 10px 10px; border-radius: 10px; text-decoration: none; transition: background 0.16s; }
    .ws-notif-item:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-notif-item.is-unread { background: color-mix(in srgb, var(--ws-accent) 7%, transparent); }
    .ws-notif-item.is-unread .ws-notif-txt b::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--ws-accent); margin-right: 6px; vertical-align: middle; }
    .ws-notif-empty { padding: 22px 12px; text-align: center; font-size: 13px; color: var(--ws-faint); }

    /* Bookings widget — a slide-across carousel of active bookings that grows to
       fill the right column so its base lines up with the left column. */
    .ws-right { align-self: stretch; }
    .ws-widget--fill { flex: 1 1 auto; }
    .ws-widget--fill .ws-bk { flex: 1; }
    .ws-wlink { font-size: 12px; }
    .ws-bk { position: relative; display: flex; flex-direction: column; }
    .ws-bk-track { display: flex; gap: 10px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; -ms-overflow-style: none; margin: 0 -2px; padding: 2px; flex: 1; }
    .ws-bk-track::-webkit-scrollbar { display: none; }
    .ws-bk-card { flex: 0 0 100%; scroll-snap-align: start; box-sizing: border-box; display: flex; flex-direction: column; justify-content: space-between; gap: 14px; min-height: 132px; padding: 16px; border-radius: var(--ws-r); border: 1px solid var(--ws-line); background: var(--ws-soft); text-decoration: none; transition: border-color .18s, transform .18s; }
    .ws-bk-card:hover { border-color: var(--ws-accent); transform: translateY(-1px); }
    .ws-bk-top { display: flex; flex-direction: column; align-items: flex-start; gap: 7px; }
    .ws-bk-bot { display: flex; flex-direction: column; gap: 3px; }
    .ws-bk-pill { font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 12%, #fff); padding: 4px 9px; border-radius: 999px; }
    .ws-bk-pill.is-call { color: #2f9e5e; background: rgba(47,158,94,0.12); }
    .ws-bk-title { font-size: 15px; font-weight: 600; color: var(--ws-ink); line-height: 1.2; }
    .ws-bk-loc { display: inline-flex; align-items: center; gap: 5px; font-size: 12px; color: var(--ws-tx); }
    .ws-bk-loc svg { width: 13px; height: 13px; flex: 0 0 auto; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-bk-when { font-size: 12.5px; color: var(--ws-tx); }
    .ws-bk-count { font-size: 12px; color: var(--ws-faint); }
    .ws-bk-empty { flex: 0 0 100%; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 18px 12px; font-size: 13px; color: var(--ws-faint); line-height: 1.6; }
    .ws-bk-empty a { color: var(--ws-accent); font-weight: 600; text-decoration: none; }
    .ws-bk-nav { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 12px; }
    .ws-bk-arrow { width: 26px; height: 26px; border-radius: 50%; border: 1px solid var(--ws-line); background: #fff; color: var(--ws-ink); font-size: 15px; line-height: 1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: border-color .18s; }
    .ws-bk-arrow:hover { border-color: var(--ws-accent); }
    .ws-bk-dots { display: flex; gap: 6px; }
    .ws-bk-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--ws-line); border: 0; padding: 0; cursor: pointer; transition: background .18s, transform .18s; }
    .ws-bk-dot.is-active { background: var(--ws-accent); transform: scale(1.25); }
    .ws-notif-ic { flex: 0 0 auto; width: 34px; height: 34px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; }
    .ws-notif-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-notif-ic--order { color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 13%, #fff); }
    .ws-notif-ic--booking { color: #2f9e5e; background: rgba(47, 158, 94, 0.12); }
    .ws-notif-ic--blog { color: #2f7dc4; background: rgba(47, 125, 196, 0.12); }
    .ws-notif-ic--news { color: #e3a008; background: rgba(227, 160, 8, 0.15); }
    .ws-notif-txt { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
    .ws-notif-txt b { font-size: 13px; font-weight: 600; color: var(--ws-ink); }
    .ws-notif-txt i { font-style: normal; font-size: 12px; line-height: 1.4; color: var(--ws-faint); }
    .ws-notif-time { flex: 0 0 auto; font-size: 11px; color: var(--ws-faint); padding-top: 1px; }
    /* When all read, the unread dot hides */
    .ws-notif.is-read .ws-dot { display: none; }
    .ws-logout svg { width: 19px; height: 19px; }

    /* Widget titles — black, plain-case, optional leading glyph */
    .ws-wtitle { display: inline-flex; align-items: center; gap: 8px; font-family: var(--subhead); font-size: 17px; font-weight: 500; letter-spacing: -0.01em; color: var(--ws-ink); }
    .ws-spark { color: #e3a008; font-size: 14px; }
    /* "Today's prompt" in the home-page chapter style: Darker Grotesque, uppercase, wine, with a leading line. */
    .ws-wtitle.ws-wtitle--chapter { font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: 0.36em; text-transform: uppercase; color: var(--ws-accent); gap: 12px; }
    .ws-wtitle--chapter::before { content: ""; display: block; width: 34px; height: 1px; background: currentColor; opacity: 0.45; }
    .ws-ig-svg { width: 17px; height: 17px; fill: none; stroke: #E1306C; stroke-width: 1.7; }
    .ws-iconround { width: 46px; height: 46px; flex: 0 0 auto; border-radius: 50%; border: 1px solid var(--ws-line); background: #fff; color: var(--ws-tx); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: color 0.2s, border-color 0.2s; }
    .ws-iconround:hover { color: var(--ws-ink); border-color: rgba(28,29,34,0.28); }
    .ws-iconround svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.35s var(--ws-ease); }
    .ws-iconround:hover svg { transform: rotate(-90deg); }

    /* ---------- Layout: asymmetric two columns + full-width discovery ---------- */
    .ws-main {
      max-width: 1840px; margin: 0 auto;
      padding: clamp(36px, 4.8vh, 64px) clamp(22px, 2.6vw, 56px) 120px;
      display: grid; grid-template-columns: minmax(0, 1fr) clamp(300px, 24vw, 384px);
      gap: clamp(22px, 2.4vw, 40px);
      align-items: start;
    }
    .ws-left, .ws-right { display: flex; flex-direction: column; gap: clamp(22px, 3vh, 40px); min-width: 0; }
    .ws-discover { grid-column: 1 / -1; }
    @media (max-width: 940px) { .ws-main { grid-template-columns: 1fr; } }

    /* ---------- Common bits ---------- */
    .ws-eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 0; }
    .ws-textlink { font-size: 13px; font-weight: 600; color: var(--ws-tx); background: none; border: 0; padding: 0; cursor: pointer; font-family: inherit; text-decoration: none; transition: color 0.2s; }
    .ws-textlink:hover { color: var(--ws-ink); }
    .ws-textlink--accent { color: var(--ws-accent); }
    .ws-btn { display: inline-flex; align-items: center; gap: 9px; padding: 13px 22px; border-radius: 13px; font-family: inherit; font-size: 14px; font-weight: 600; text-decoration: none; cursor: pointer; border: 1px solid transparent; transition: transform 0.22s var(--ws-ease), box-shadow 0.22s, background 0.2s; }
    .ws-btn svg { width: 15px; height: 15px; }
    .ws-btn--sm { padding: 10px 16px; font-size: 13px; border-radius: 11px; }
    .ws-btn--primary { background: var(--ws-accent); color: #fff; box-shadow: 0 12px 24px -12px color-mix(in srgb, var(--ws-accent) 80%, transparent); }
    .ws-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 18px 32px -12px color-mix(in srgb, var(--ws-accent) 75%, transparent); }
    .ws-btn--primary svg { transition: transform 0.25s var(--ws-ease); }
    .ws-btn--primary:hover svg { transform: translateX(3px); }
    .ws-pilltag { font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 12%, #fff); padding: 5px 10px; border-radius: 999px; }
    .ws-pilltag--soft { color: var(--ws-faint); background: rgba(28,29,34,0.05); }

    /* ---------- HERO — compact greeting band; brief stats on one row ---------- */
    .ws-hero { display: flex; flex-direction: column; gap: clamp(28px, 4vh, 48px); background: transparent; padding: clamp(20px, 3.6vh, 52px) 0 clamp(32px, 5.2vh, 70px); }
    .ws-hero-top { display: flex; flex-direction: column; align-items: flex-start; gap: clamp(24px, 3.2vh, 38px); }
    .ws-greeting { font-family: var(--subhead); margin: 0; line-height: 1.0; font-weight: 500; font-size: clamp(40px, 4.6vw, 60px); letter-spacing: -0.02em; color: var(--ws-ink); }
    .ws-greeting em { font-style: normal; font-weight: 500; color: var(--ws-ink); }
    .ws-hero-cta-btn { flex: 0 0 auto; align-self: flex-start; }
    .ws-brief { list-style: none; margin: 0; padding: 0; display: flex; flex-flow: row wrap; gap: 13px clamp(20px, 2.4vw, 38px); }
    .ws-brief li { display: flex; align-items: center; gap: 13px; font-size: 15px; color: var(--ws-tx); opacity: 0; transform: translateY(14px); animation: wsBriefIn 0.55s var(--ws-ease) forwards; animation-delay: calc(0.5s + var(--d) * 0.1s); }
    .ws-brief strong { color: var(--ws-ink); font-weight: 600; }
    .ws-brief-ic { flex: 0 0 auto; width: 34px; height: 34px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; background: #fff; border: 1px solid var(--ws-line); color: var(--ws-tx); }
    .ws-brief-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    /* Each brief icon its own colour, on a soft tint of that colour. */
    .ws-brief-ic--sched { color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 13%, #fff); border-color: color-mix(in srgb, var(--ws-accent) 22%, var(--ws-line)); }
    .ws-brief-ic--eng { color: #2f9e5e; background: rgba(47,158,94,0.12); border-color: rgba(47,158,94,0.26); }
    .ws-brief-ic--time { color: #2f7dc4; background: rgba(47,125,196,0.12); border-color: rgba(47,125,196,0.24); }
    .ws-brief-ic--star { color: #e3a008; background: rgba(227,160,8,0.15); border-color: rgba(227,160,8,0.30); }
    .ws-brief-ic--star svg { fill: currentColor; stroke: none; }   /* a star fills, it doesn't stroke */
    .ws-brief-ic--eng.is-down { color: #c0392b; background: rgba(192,57,43,0.10); border-color: rgba(192,57,43,0.24); }
    @keyframes wsBriefIn { to { opacity: 1; transform: none; } }

    /* Hero = a mini Studio window (landscape) with a rotating pack template on the canvas. */
    .ws-edmock { position: relative; display: flex; flex-direction: column; width: 100%; max-width: 600px; margin-left: auto; aspect-ratio: 4 / 3; border-radius: 14px; overflow: hidden; background: var(--paper, #f4f2f1); border: 1px solid var(--ws-line); box-shadow: 0 30px 60px -34px rgba(28,29,34,0.4); text-decoration: none; transition: transform 0.3s var(--ws-ease), box-shadow 0.3s; }
    .ws-edmock:hover { transform: translateY(-4px); box-shadow: 0 42px 72px -34px rgba(28,29,34,0.46); }
    .ws-edmock-top { display: flex; align-items: center; gap: 10px; padding: 9px 14px; background: #fff; border-bottom: 1px solid var(--ws-line); }
    .ws-edmock-dots { display: inline-flex; gap: 5px; }
    .ws-edmock-dots i { width: 8px; height: 8px; border-radius: 50%; background: rgba(28,29,34,0.14); }
    .ws-edmock-title { flex: 1; text-align: center; font-size: 11px; font-weight: 600; color: var(--ws-tx); overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
    .ws-edmock-acts { display: inline-flex; gap: 6px; }
    .ws-edmock-pill { font-size: 9.5px; font-weight: 600; color: var(--ws-tx); border: 1px solid var(--ws-line); border-radius: 999px; padding: 3px 9px; }
    .ws-edmock-pill--solid { background: var(--ws-accent); color: #fff; border-color: var(--ws-accent); }
    .ws-edmock-body { flex: 1; display: flex; gap: 10px; padding: 12px; min-height: 0; }
    .ws-edmock-rail { display: flex; flex-direction: column; gap: 6px; padding: 8px 6px; background: #fff; border: 1px solid var(--ws-line); border-radius: 10px; }
    .ws-em-ic { width: 30px; height: 30px; border-radius: 7px; display: inline-flex; align-items: center; justify-content: center; color: var(--ws-faint); }
    .ws-em-ic.is-active { background: color-mix(in srgb, var(--ws-accent) 12%, #fff); color: var(--ws-accent); }
    .ws-em-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .ws-edmock-stage { flex: 1; display: flex; align-items: center; justify-content: center; min-width: 0; }
    .ws-edmock-canvas { height: 100%; aspect-ratio: 3 / 4; max-width: 100%; border-radius: 4px; overflow: hidden; background: #fff; box-shadow: 0 12px 26px -14px rgba(28,29,34,0.45); transition: transform 0.32s var(--ws-ease), box-shadow 0.32s; }
    .ws-edmock:hover .ws-edmock-canvas { transform: translateY(-7px) scale(1.035); box-shadow: 0 24px 42px -16px rgba(28,29,34,0.5); }
    .ws-edmock-canvas img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ws-edmock-panel { display: flex; flex-direction: column; gap: 10px; width: 92px; padding: 9px; background: #fff; border: 1px solid var(--ws-line); border-radius: 10px; }
    .ws-emp-sec { display: flex; flex-direction: column; gap: 5px; }
    .ws-emp-sec b { font-size: 8px; font-weight: 600; color: var(--ws-tx); }
    .ws-emp-row { display: flex; gap: 4px; }
    .ws-emp-aa { width: 20px; height: 18px; border-radius: 4px; border: 1px solid var(--ws-line); display: inline-flex; align-items: center; justify-content: center; font-family: var(--subhead); font-size: 10px; color: var(--ws-ink); }
    .ws-emp-sw, .ws-emp-bg, .ws-emp-sz { width: 18px; height: 18px; border-radius: 4px; flex: 0 0 auto; }
    .ws-emp-bg { background: #efece6; }
    .ws-emp-sz { border: 1px solid var(--ws-line); }
    .ws-edmock-hint { position: absolute; left: 50%; bottom: 16px; transform: translateX(-50%) translateY(6px); font-size: 11px; font-weight: 600; color: #fff; background: rgba(28,25,22,0.72); padding: 7px 14px; border-radius: 999px; opacity: 0; pointer-events: none; transition: opacity 0.25s, transform 0.25s; }
    .ws-edmock:hover .ws-edmock-hint { opacity: 1; transform: translateX(-50%); }
    @media (max-width: 880px) { .ws-edmock { max-width: 100%; } }
    @media (max-width: 620px) { .ws-hero { grid-template-columns: 1fr; } .ws-hero-preview { margin: 0 auto; max-height: 400px; } }

    /* ---------- Section blocks (plan, recent) — borderless, grouped by space ---------- */
    .ws-block { display: flex; flex-direction: column; gap: 16px; }
    .ws-block-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 0 2px; }
    .ws-block-h { font-family: var(--subhead); font-weight: 500; font-size: 20px; letter-spacing: -0.01em; margin: 0; color: var(--ws-ink); }

    /* Planner week */
    .ws-week { display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
    @media (max-width: 560px) { .ws-week { grid-template-columns: 1fr 1fr; } }
    .ws-day { display: flex; flex-direction: column; gap: 10px; padding: 14px; min-height: 130px; border-radius: var(--ws-r-sm); background: transparent; border: 1px solid var(--ws-line); text-decoration: none; color: var(--ws-ink); cursor: pointer; font-family: inherit; text-align: left; transition: border-color 0.25s var(--ws-ease), transform 0.25s var(--ws-ease); }
    .ws-day:hover { transform: translateY(-3px); border-color: rgba(28, 29, 34, 0.22); }
    .ws-day-name { font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ws-faint); display: flex; align-items: center; gap: 6px; }
    .ws-day-name i { font-style: normal; font-size: 9px; color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 12%, #fff); padding: 2px 6px; border-radius: 999px; }
    .ws-day-type { font-size: 13px; font-weight: 600; color: var(--ws-ink); line-height: 1.25; }
    .ws-day-thumb { height: 56px; border-radius: 9px; background-size: cover; background-position: center; background-color: #e9e6e2; margin-top: auto; transition: height 0.28s var(--ws-ease); }
    .ws-day:hover .ws-day-thumb { height: 64px; }
    .ws-day--empty { justify-content: space-between; position: relative; }
    .ws-day--empty:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--ws-accent) 40%, var(--ws-line)); }
    .ws-day-empty-msg { font-size: 12px; font-weight: 500; color: var(--ws-faint); margin-top: auto; transition: opacity 0.2s; }
    .ws-day-plus { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 30px; font-weight: 200; line-height: 1; color: var(--ws-accent); opacity: 0; transition: opacity 0.2s; pointer-events: none; }
    .ws-day--empty:hover .ws-day-empty-msg { opacity: 0; }
    .ws-day--empty:hover .ws-day-plus { opacity: 1; }

    /* Recent designs reel — portrait, fan out on hover */
    .ws-reel { display: grid; grid-template-columns: repeat(5, 1fr); gap: 14px; }
    @media (max-width: 720px) { .ws-reel { grid-template-columns: repeat(3, 1fr); } }
    .ws-thumb { position: relative; aspect-ratio: 4 / 5; border-radius: var(--ws-r); overflow: hidden; background-size: cover; background-position: center; background-color: transparent; text-decoration: none; display: block; box-shadow: inset 0 0 0 1px var(--ws-line); transform-origin: center; transition: transform 0.32s var(--ws-ease), box-shadow 0.32s; }
    .ws-reel .ws-thumb:hover { transform: translateY(-7px) scale(1.03); box-shadow: 0 22px 38px -16px rgba(28,29,34,0.45); z-index: 2; }
    .ws-thumb-tag { position: absolute; bottom: 8px; left: 8px; padding: 3px 8px; border-radius: 999px; background: rgba(255,255,255,0.92); font-size: 10px; font-weight: 700; color: var(--ws-accent); }
    .ws-thumb-tag--done { color: var(--ws-success); }
    .ws-thumb--new { position: relative; display: flex; align-items: center; justify-content: center; background: transparent; box-shadow: inset 0 0 0 1.5px var(--ws-line); font-size: 12px; font-weight: 600; color: var(--ws-faint); transition: box-shadow 0.22s var(--ws-ease), color 0.22s, transform 0.28s var(--ws-ease); }
    .ws-thumb--new:hover { box-shadow: inset 0 0 0 1.5px var(--ws-accent); color: var(--ws-accent); transform: translateY(-7px); }
    .ws-thumb-new-msg { transition: opacity 0.2s; }
    .ws-thumb--new:hover .ws-thumb-new-msg { opacity: 0; }
    .ws-thumb-plus { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: 42px; line-height: 1; font-weight: 200; color: var(--ws-accent); opacity: 0; transform: scale(0.78); transition: opacity 0.2s, transform 0.28s var(--ws-ease); pointer-events: none; }
    .ws-thumb--new:hover .ws-thumb-plus { opacity: 1; transform: scale(1); }

    /* ---------- Right column widgets — lighter, recede ---------- */
    .ws-widget { background: transparent; border: 1px solid var(--ws-line); border-radius: var(--ws-r); padding: 22px 24px; display: flex; flex-direction: column; gap: 14px; transition: border-color 0.25s var(--ws-ease); }
    .ws-widget:hover { border-color: rgba(28, 29, 34, 0.22); }
    .ws-widget-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .ws-idea { font-family: var(--subhead); font-style: normal; font-size: clamp(18px, 1.7vw, 21px); line-height: 1.4; color: var(--ws-ink); margin: 0; }
    .ws-widget-foot { display: flex; align-items: center; gap: 16px; margin-top: 2px; }

    /* Brand health */
    .ws-ring { position: relative; width: 50px; height: 50px; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; }
    .ws-ring svg { position: absolute; inset: 0; width: 100%; height: 100%; transform: rotate(-90deg); }
    .ws-ring-bg { fill: none; stroke: rgba(28,29,34,0.1); stroke-width: 3; }
    .ws-ring-fg { fill: none; stroke: var(--ws-success); stroke-width: 3; stroke-linecap: round; stroke-dasharray: 97.4; stroke-dashoffset: 97.4; transition: stroke-dashoffset 1.2s var(--ws-ease); }
    .ws-ring b { font-family: var(--subhead); font-size: 14px; color: var(--ws-ink); }
    .ws-ring i { font-size: 8px; color: var(--ws-faint); font-style: normal; }
    .ws-journey { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
    .ws-journey li { display: flex; align-items: center; gap: 11px; font-size: 13.5px; color: var(--ws-faint); }
    .ws-journey li.is-done { color: var(--ws-ink); }
    .ws-check { flex: 0 0 auto; width: 17px; height: 17px; border-radius: 50%; border: 1.5px solid var(--ws-line); position: relative; }
    .ws-journey li.is-done .ws-check { background: var(--ws-success); border-color: var(--ws-success); }
    .ws-journey li.is-done .ws-check::after { content: ""; position: absolute; left: 5px; top: 2.5px; width: 4px; height: 7px; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }

    /* Instagram snapshot */
    .ws-metrics { display: flex; gap: 20px; }
    .ws-metric { display: flex; flex-direction: column; gap: 3px; }
    .ws-metric-val { font-family: var(--subhead); font-size: clamp(24px, 2.4vw, 30px); line-height: 1; letter-spacing: -0.02em; color: var(--ws-ink); }
    .ws-metric-label { font-size: 11px; color: var(--ws-faint); display: flex; align-items: center; gap: 5px; }
    .ws-trend { font-style: normal; font-size: 10px; font-weight: 700; color: var(--ws-success); }
    .ws-best { display: flex; align-items: center; gap: 12px; padding: 10px; border-radius: var(--ws-r-sm); background: transparent; border: 1px solid var(--ws-line); text-decoration: none; color: var(--ws-ink); transition: border-color 0.22s var(--ws-ease); }
    .ws-best:hover { border-color: rgba(28, 29, 34, 0.22); }
    .ws-best-thumb { width: 44px; height: 44px; border-radius: 10px; background-size: cover; background-position: center; flex: 0 0 auto; }
    .ws-best-text { display: flex; flex-direction: column; gap: 1px; flex: 1; }
    .ws-best-text b { font-size: 13px; font-weight: 600; }
    .ws-best-text i { font-style: normal; font-size: 11.5px; color: var(--ws-faint); }
    .ws-best-arrow { color: var(--ws-faint); font-size: 16px; transition: transform 0.25s var(--ws-ease); }
    .ws-best:hover .ws-best-arrow { transform: translateX(3px); color: var(--ws-accent); }

    /* ---------- Discovery — full-width finish ---------- */
    .ws-discover { position: relative; display: grid; grid-template-columns: 1.1fr 1fr; min-height: 230px; border-radius: var(--ws-r-lg); overflow: hidden; background: transparent; border: 1px solid var(--ws-line); text-decoration: none; transition: border-color 0.25s var(--ws-ease); }
    .ws-discover:hover { border-color: rgba(28, 29, 34, 0.22); }
    .ws-discover-art { position: relative; background-size: cover; background-position: center; transition: transform 1.2s var(--ws-ease); }
    .ws-discover:hover .ws-discover-art { transform: scale(1.05); }
    .ws-discover-body { position: relative; padding: clamp(28px, 3vw, 44px); display: flex; flex-direction: column; justify-content: center; gap: 10px; color: var(--ws-ink); background: transparent; }
    .ws-discover-flag { position: absolute; top: clamp(20px, 2.2vw, 30px); right: clamp(20px, 2.2vw, 30px); align-self: auto; padding: 6px 12px; border-radius: 8px; background: #fff; border: 1px solid var(--ws-line); color: var(--ws-accent); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
    .ws-discover-h { font-family: var(--subhead); font-weight: 500; font-size: clamp(26px, 2.8vw, 38px); letter-spacing: -0.015em; margin: 0; color: var(--ws-ink); }
    .ws-discover-desc { font-size: 14.5px; line-height: 1.55; color: var(--ws-tx); margin: 0; max-width: 40ch; }
    .ws-discover-cta { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--ws-accent); margin-top: 8px; }
    .ws-discover-cta em { font-style: normal; display: inline-block; transition: transform 0.25s var(--ws-ease); }
    .ws-discover:hover .ws-discover-cta em { transform: translateX(4px); }
    @media (max-width: 620px) { .ws-discover { grid-template-columns: 1fr; } .ws-discover-art { min-height: 180px; } }

    /* ---------- Tooltips ---------- */
    [data-tip] { position: relative; }
    [data-tip]::after { content: attr(data-tip); position: absolute; bottom: calc(100% + 9px); left: 50%; transform: translateX(-50%) translateY(4px); width: max-content; max-width: 220px; padding: 9px 12px; border-radius: 10px; background: #1c1d22; color: #fff; font-size: 12px; font-weight: 500; line-height: 1.4; letter-spacing: 0; text-transform: none; text-align: center; white-space: normal; opacity: 0; pointer-events: none; z-index: 60; box-shadow: 0 12px 28px -10px rgba(0,0,0,0.4); transition: opacity 0.22s var(--ws-ease), transform 0.22s var(--ws-ease); }
    [data-tip]:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }
    /* Right-popping variant — white box, grey outline, upright (used on the
       rotating "Another idea" button, where an overhead dark tip reads awkwardly). */
    .ws-tip-right[data-tip]::after { bottom: auto; top: 50%; left: calc(100% + 12px); right: auto; transform: translateY(-50%) translateX(-4px); background: #fff; color: var(--ws-ink); border: 1px solid var(--ws-line); box-shadow: 0 12px 28px -12px rgba(28,29,34,0.22); }
    .ws-tip-right[data-tip]:hover::after { transform: translateY(-50%) translateX(0); }

    /* ---------- Entrance ---------- */
    /* ===== Entrance choreography — greeting → stats → button → This Week +
       Continue working (tiles bubble in column-by-column) → property pack →
       right widgets one-by-one → nav drops in last with a bounce. ===== */
    .ws-rise { opacity: 0; transform: translateY(24px); }
    body.ws-ready .ws-rise { animation: wsRise 0.7s var(--ws-ease) both; animation-delay: var(--delay, 0s); }
    @keyframes wsRise { to { opacity: 1; transform: none; } }
    @keyframes wsIn { from { opacity: 0; transform: translateY(20px) scale(.985); } to { opacity: 1; transform: none; } }
    @keyframes wsNavDrop { from { opacity: 0; transform: translateY(-100%); } to { opacity: 1; transform: none; } }

    /* hero greeting + CTA (brief stats keep their own stagger between them) */
    .ws-greeting, .ws-hero-cta-btn { opacity: 0; }
    body.ws-ready .ws-greeting { animation: wsIn 0.6s var(--ws-ease) both; animation-delay: 0.12s; }
    body.ws-ready .ws-hero-cta-btn { animation: wsIn 0.55s var(--ws-ease) both; animation-delay: 1.0s; }

    /* This Week + Continue working: headers, then tiles bubble in column-by-column (parallel) */
    .ws-block-head { opacity: 0; }
    body.ws-ready .ws-block-head { animation: wsIn 0.5s var(--ws-ease) both; animation-delay: 1.1s; }
    .ws-week .ws-day, .ws-reel .ws-thumb { opacity: 0; }
    body.ws-ready .ws-week .ws-day, body.ws-ready .ws-reel .ws-thumb { animation: wsIn 0.55s var(--ws-ease) both; }
    body.ws-ready .ws-week .ws-day:nth-child(1), body.ws-ready .ws-reel .ws-thumb:nth-child(1) { animation-delay: 1.18s; }
    body.ws-ready .ws-week .ws-day:nth-child(2), body.ws-ready .ws-reel .ws-thumb:nth-child(2) { animation-delay: 1.28s; }
    body.ws-ready .ws-week .ws-day:nth-child(3), body.ws-ready .ws-reel .ws-thumb:nth-child(3) { animation-delay: 1.38s; }
    body.ws-ready .ws-week .ws-day:nth-child(4), body.ws-ready .ws-reel .ws-thumb:nth-child(4) { animation-delay: 1.48s; }
    body.ws-ready .ws-week .ws-day:nth-child(5), body.ws-ready .ws-reel .ws-thumb:nth-child(5) { animation-delay: 1.58s; }

    /* nav drops in last, bouncy (real-world spring) */
    .ws-nav { opacity: 0; }
    body.ws-ready .ws-nav { animation: wsNavDrop 0.72s cubic-bezier(.3, 1.55, .5, 1) both; animation-delay: 2.35s; }

    @media (prefers-reduced-motion: reduce) {
      .ws-rise, .ws-brief li, .ws-greeting, .ws-hero-cta-btn, .ws-block-head, .ws-week .ws-day, .ws-reel .ws-thumb, .ws-nav { opacity: 1 !important; transform: none !important; animation: none !important; }
      .ws-hero-fill, .ws-ring-fg { transition: none !important; }
    }

    /* ===== Contextual coach bubble ===== */
    .ws-coach { position: absolute; z-index: 80; max-width: 280px; display: flex; align-items: flex-start; gap: 9px; padding: 12px 12px 12px 13px; background: #fff; border: 1px solid var(--ws-line); border-radius: 13px; box-shadow: 0 20px 44px -18px rgba(28,29,34,0.32); opacity: 0; transform: translateY(-6px) scale(0.92); transform-origin: top center; transition: opacity 0.25s var(--ws-ease), transform 0.5s cubic-bezier(.34, 1.56, .4, 1); }
    .ws-coach.is-in { opacity: 1; transform: none; }
    .ws-coach::before { content: ""; position: absolute; top: -6px; left: var(--arrow-x, 26px); width: 11px; height: 11px; background: #fff; border-left: 1px solid var(--ws-line); border-top: 1px solid var(--ws-line); transform: translateX(-50%) rotate(45deg); }
    .ws-coach-spark { flex: 0 0 auto; color: #e3a008; font-size: 14px; line-height: 1.5; }
    .ws-coach-msg { flex: 1; font-size: 13px; line-height: 1.5; color: var(--ws-ink); }
    .ws-coach-x { flex: 0 0 auto; border: 0; background: transparent; color: var(--ws-faint); font-size: 18px; line-height: 1; cursor: pointer; padding: 0 2px; transition: color 0.2s; }
    .ws-coach-x:hover { color: var(--ws-ink); }
    @media (prefers-reduced-motion: reduce) { .ws-coach { transition: opacity 0.2s; transform: none; } }
  </style>

  <script>
    requestAnimationFrame(() => document.body.classList.add('ws-ready'));

    // Off-canvas drawer (hamburger → everything that isn't a tab)
    const drawer = document.querySelector('[data-drawer]');
    const burger = document.querySelector('[data-drawer-open]');
    let drawerTimer;
    function openDrawer() { if (!drawer) return; clearTimeout(drawerTimer); drawer.hidden = false; requestAnimationFrame(() => drawer.classList.add('is-open')); burger?.setAttribute('aria-expanded', 'true'); }
    function closeDrawer() { if (!drawer) return; drawer.classList.remove('is-open'); burger?.setAttribute('aria-expanded', 'false'); drawerTimer = setTimeout(() => { drawer.hidden = true; }, 340); }
    burger?.addEventListener('click', openDrawer);
    document.querySelectorAll('[data-drawer-close]').forEach((b) => b.addEventListener('click', closeDrawer));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer && !drawer.hidden) closeDrawer(); });

    // Dropdowns
    const menus = [...document.querySelectorAll('[data-menu]')];
    function closeAll(except) { menus.forEach((m) => { if (m !== except) { m.classList.remove('is-open'); m.querySelector('[data-menu-btn]')?.setAttribute('aria-expanded', 'false'); } }); }
    menus.forEach((m) => { const b = m.querySelector('[data-menu-btn]'); b?.addEventListener('click', (e) => { e.stopPropagation(); const open = m.classList.toggle('is-open'); b.setAttribute('aria-expanded', String(open)); closeAll(m); }); });
    document.addEventListener('click', () => closeAll(null));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(null); });

    // Notifications are wired in the module script below (initNotifications).

    // Today's prompt — "Another idea" cycles a curated pool of content ideas.
    // (A simple, free pool for now; can be swapped for AI generation via the
    // Worker later without touching this markup.)
    const TMKE_PROMPTS = [
      "Three questions every buyer asks during a viewing — and how you answer them.",
      "The one room that sells the home. Show buyers why.",
      "What a little styling actually adds to a sale price.",
      "A 60-second tour of your favourite listing this week.",
      "Five things buyers notice in the first ten seconds of a viewing.",
      "Behind the scenes: how we shoot a property that sells.",
      "Sell the lifestyle, not just the house — the cafe, the school, the park.",
      "Just listed: tease it before the portal goes live.",
      "A day in the life of an agent who actually answers the phone.",
      "Why the right asking price sells faster than the highest one.",
      "Myth vs fact: what really adds value before you sell.",
      "Client win of the week — let the result do the talking.",
      "Your honest take on the local market this month, in 30 seconds.",
      "First-time buyer? The one thing to sort before you offer.",
      "Sold fast — the story behind the result.",
      "Three quick wins to get a home viewing-ready this weekend.",
    ];
    (function wirePrompt() {
      const idea = document.querySelector('.ws-idea');
      const btn = document.querySelector('.ws-iconround');
      if (!idea || !btn) return;
      // Daily prompt — everyone sees the same one each day, rotating through the
      // pool by day-of-year (no manual writing needed). "Another idea" shuffles.
      const _now = new Date();
      const _doy = Math.floor((_now - new Date(_now.getFullYear(), 0, 0)) / 86400000);
      idea.textContent = '“' + TMKE_PROMPTS[_doy % TMKE_PROMPTS.length] + '”';
      let current = idea.textContent.replace(/[“”"]/g, '').trim();
      btn.addEventListener('click', () => {
        let next = current;
        for (let i = 0; i < 8 && next === current; i++) {
          next = TMKE_PROMPTS[Math.floor(Math.random() * TMKE_PROMPTS.length)];
        }
        current = next;
        idea.style.transition = 'opacity 0.22s cubic-bezier(.2,.8,.2,1), transform 0.22s cubic-bezier(.2,.8,.2,1)';
        idea.style.opacity = '0';
        idea.style.transform = 'translateY(8px)';
        setTimeout(() => {
          idea.textContent = '“' + next + '”';
          idea.style.opacity = '1';
          idea.style.transform = 'none';
        }, 220);
      });
    })();

    // Count-up + bars/ring on view
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function animateCount(el) {
      const target = parseFloat(el.getAttribute('data-count')) || 0;
      const dur = 1100, start = performance.now(), fmt = (n) => Math.round(n).toLocaleString('en-GB');
      function tick(now) { const p = Math.min(1, (now - start) / dur); el.textContent = fmt(target * (1 - Math.pow(1 - p, 3))); if (p < 1) requestAnimationFrame(tick); else el.textContent = fmt(target); }
      requestAnimationFrame(tick);
    }
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return; obs.unobserve(e.target); const t = e.target;
        if (reduce) t.querySelectorAll('[data-count]').forEach((n) => { n.textContent = (parseFloat(n.getAttribute('data-count')) || 0).toLocaleString('en-GB'); });
        else t.querySelectorAll('[data-count]').forEach(animateCount);
        t.querySelectorAll('[data-val]').forEach((b) => { b.style.width = (b.getAttribute('data-val') || 0) + '%'; });
        t.querySelectorAll('[data-ring]').forEach((r) => { const pct = parseFloat(r.getAttribute('data-ring')) || 0; r.style.strokeDashoffset = String(2 * Math.PI * 15.5 * (1 - pct / 100)); });
      });
    }, { threshold: 0.25 });
    document.querySelectorAll('.ws-hero, .ws-widget').forEach((el) => io.observe(el));
  </script>

  <!-- Stage A migration: wire the real signed-in identity. Falls back to the
       mock preview when signed out (the hard login-gate lands at go-live). -->
  <script>
    import { supabase, signOutEverywhere} from '../../lib/supabase.js';
    import { initNotifications } from '../../lib/notifications.js';
    import { bookingLocation } from '../../lib/videography-config.js';

    // Notifications — real booking correspondence, unread dot + deep links.
    initNotifications();

    const titleCase = (s) => String(s || '').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
    const escapeHtml = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // Log out (top-bar icon + drawer): clear the Supabase session, then /login.
    document.querySelectorAll('[data-logout]').forEach((el) => el.addEventListener('click', async (e) => {
      e.preventDefault();
      await signOutEverywhere();
    }));

    // ---- Bookings widget (right-column carousel of active bookings) ----
    const bkFmt = (iso) => { try { return new Date(iso).toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch (_) { return ''; } };
    const bkCountdown = (iso) => { const ts = new Date(iso).getTime(); if (isNaN(ts)) return ''; const d = Math.ceil((ts - Date.now()) / 86400000); return d <= 0 ? 'Today' : d === 1 ? 'Tomorrow' : `In ${d} days`; };
    function renderBookings(items) {
      const track = document.getElementById('ws-bk-track');
      const nav = document.getElementById('ws-bk-nav');
      const dots = document.getElementById('ws-bk-dots');
      if (!track) return;
      if (!items.length) {
        track.innerHTML = `<div class="ws-bk-empty">No upcoming bookings.<br><a href="/videography">Book a shoot or call →</a></div>`;
        if (nav) nav.hidden = true;
        return;
      }
      track.innerHTML = items.map((b) => {
        const isCall = b.source === 'smm' || b.service_type === 'discovery';
        const loc = bookingLocation(b);
        return `<a class="ws-bk-card" href="/account/bookings?open=${encodeURIComponent(b.source + ':' + b.id)}">
          <span class="ws-bk-top">
            <span class="ws-bk-pill${isCall ? ' is-call' : ''}">${isCall ? 'Call booked' : 'Booked'}</span>
            <span class="ws-bk-title">${escapeHtml(b.title)}</span>
            ${loc ? `<span class="ws-bk-loc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>${escapeHtml(loc)}</span>` : ''}
          </span>
          <span class="ws-bk-bot">
            <span class="ws-bk-when">${escapeHtml(bkFmt(b.when))}</span>
            <span class="ws-bk-count">${escapeHtml(bkCountdown(b.when))}</span>
          </span>
        </a>`;
      }).join('');
      if (items.length > 1 && nav && dots) {
        nav.hidden = false;
        dots.innerHTML = items.map((_, i) => `<button type="button" class="ws-bk-dot${i === 0 ? ' is-active' : ''}" data-bk-dot="${i}" aria-label="Booking ${i + 1}"></button>`).join('');
        const dotEls = [...dots.querySelectorAll('[data-bk-dot]')];
        const cardW = () => track.firstElementChild ? track.firstElementChild.getBoundingClientRect().width + 10 : track.clientWidth;
        const current = () => Math.round(track.scrollLeft / cardW());
        const go = (i) => track.scrollTo({ left: Math.max(0, Math.min(items.length - 1, i)) * cardW(), behavior: 'smooth' });
        document.querySelector('[data-bk-prev]')?.addEventListener('click', () => go(current() - 1));
        document.querySelector('[data-bk-next]')?.addEventListener('click', () => go(current() + 1));
        dotEls.forEach((d, i) => d.addEventListener('click', () => go(i)));
        track.addEventListener('scroll', () => { const i = current(); dotEls.forEach((d, j) => d.classList.toggle('is-active', j === i)); }, { passive: true });
      } else if (nav) {
        nav.hidden = true;
      }
    }
    async function initBookingsWidget(session) {
      let items = [];
      const now = Date.now();
      if (session) {
        const email = session.user.email ?? '';
        try {
          const [v, s] = await Promise.all([
            supabase.from('videography_bookings').select('id, service, service_type, shoot_date, stage, postcode').or(`account_user_id.eq.${session.user.id},client_email.eq.${email}`),
            supabase.from('smm_leads').select('id, call_at, stage').eq('kind', 'discovery').or(`account_user_id.eq.${session.user.id},email.eq.${email}`),
          ]);
          const vid = (v.data || []).map((r) => ({ source: 'videography', id: r.id, title: r.service || 'Videography booking', service_type: r.service_type, when: r.shoot_date, stage: r.stage, postcode: r.postcode }));
          const smm = (s.data || []).map((r) => ({ source: 'smm', id: r.id, title: 'Social media discovery call', service_type: 'discovery', when: r.call_at, stage: r.stage || 'discovery_call_booked' }));
          items = vid.concat(smm);
        } catch (_) {}
      } else {
        items = [
          { source: 'videography', id: 'demo-1', title: 'Property shoot', service_type: 'property', when: new Date(now + 6 * 86400000).toISOString(), stage: 'booked', postcode: 'NN1 1AA' },
          { source: 'videography', id: 'demo-3', title: 'Content Studio session', service_type: 'content', when: new Date(now + 9 * 86400000).toISOString(), stage: 'booked' },
          { source: 'smm', id: 'demo-2', title: 'Social media discovery call', service_type: 'discovery', when: new Date(now + 2 * 86400000).toISOString(), stage: 'discovery_call_booked' },
        ];
      }
      items = items
        .filter((b) => b.stage !== 'cancelled' && b.when && new Date(b.when).getTime() > now)
        .sort((a, b) => new Date(a.when) - new Date(b.when));
      renderBookings(items);
    }

    (async () => {
      try {
        const isDemo = import.meta.env.DEV;
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          // Live workspace — require sign-in. (Dev ?demo=1 still previews the mock.)
          if (!isDemo) { location.replace('/login?next=' + encodeURIComponent('/account')); return; }
          initBookingsWidget(null);
          return;
        }
        initBookingsWidget(session);

        const email = session.user.email ?? '';
        const meta = session.user.user_metadata ?? {};
        const fullName = titleCase(meta.name || email.split('@')[0].replace(/[._]/g, ' '));
        const firstName = fullName.split(' ')[0];
        const initials = fullName.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase() || 'T';

        const hour = new Date().getHours();
        let greeting = 'Welcome Back';
        if (hour >= 5 && hour < 12) greeting = 'Good Morning';
        else if (hour >= 12 && hour < 17) greeting = 'Good Afternoon';
        else if (hour >= 17 && hour < 22) greeting = 'Good Evening';
        else greeting = 'Burning the Midnight Oil';

        const g = document.querySelector('.ws-greeting');
        if (g) g.innerHTML = `${escapeHtml(greeting)}, <em>${escapeHtml(firstName)}</em>.`;

        document.querySelectorAll('.ws-whoav').forEach((e) => { e.textContent = initials; });
        const setText = (sel, val) => { const el = document.querySelector(sel); if (el && val) el.textContent = val; };
        setText('.ws-whotext strong', fullName);
        setText('.ws-whotext span', email);
        setText('.ws-dropdown-head strong', fullName);
        setText('.ws-dropdown-head span', email);

        // Headshot from the brand kit, if they've set one.
        try {
          const bk = JSON.parse(localStorage.getItem('tmke.brand') || 'null');
          if (bk && typeof bk.headshot === 'string' && bk.headshot) {
            document.querySelectorAll('.ws-whoav').forEach((e) => {
              e.textContent = '';
              e.style.backgroundImage = 'url(' + JSON.stringify(bk.headshot) + ')';
              e.style.backgroundSize = 'cover';
              e.style.backgroundPosition = 'center';
            });
          }
        } catch (_) {}
      } catch (_) { /* keep the mock preview on any error */ }
    })();

    // ---- Stage A.2: real recent designs (local editor drafts) ----
    function readLocalDrafts() {
      const drafts = [];
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (!key || !key.startsWith('tmke.editor.')) continue;
          const id = key.replace('tmke.editor.', '');
          try {
            const v = JSON.parse(localStorage.getItem(key) || 'null');
            if (!v) continue;
            drafts.push({ id, filename: v.filename || id, savedAt: v.savedAt || 0, thumb: v.thumb || null });
          } catch (_) {}
        }
      } catch (_) {}
      drafts.sort((a, b) => b.savedAt - a.savedAt);
      return drafts;
    }
    const fmtSaved = (ts) => ts ? new Date(ts).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Saved locally';
    const editHref = (id) => '/account/editor?design=' + encodeURIComponent(id);

    // Recent designs = the member's saved copies (user_designs), newest first —
    // the SAME source as the Studio's "Your designs", so the two line up.
    (async function wireWork() {
      let designs = [];
      try {
        const { data } = await supabase
          .from('user_designs')
          .select('id, name, thumb_url, updated_at')
          .order('updated_at', { ascending: false })
          .limit(4);
        designs = data || [];
      } catch (_) {}
      if (!designs.length) return; // no saved work yet → keep the starter templates

      // Hero preview = the most recently edited design.
      const top = designs[0];
      const name = top.name || 'Untitled design';
      const heroImg = document.querySelector('.ws-hero-preview img');
      const heroTitle = document.querySelector('.ws-hero-preview-foot h3');
      const heroLink = document.querySelector('.ws-hero-preview');
      const heroProg = document.querySelector('.ws-hero-progress');
      const heroCta = document.querySelector('.ws-hero-cta-btn');
      if (top.thumb_url && heroImg) { heroImg.src = top.thumb_url; heroImg.alt = name; }
      if (heroTitle) heroTitle.textContent = name;
      if (heroLink) heroLink.setAttribute('href', editHref(top.id));
      if (heroCta) heroCta.setAttribute('href', editHref(top.id));
      if (heroProg) heroProg.innerHTML = `<span class="ws-hero-pct">Last edited ${escapeHtml(fmtSaved(top.updated_at))}</span>`;

      // Recent designs reel = the latest saved designs + a "New design" tile.
      const reel = document.querySelector('.ws-reel');
      if (reel) {
        const cards = designs.map((d) => `
          <a class="ws-thumb" href="${editHref(d.id)}"${d.thumb_url ? ` style="background-image:url('${escapeHtml(d.thumb_url)}')"` : ''}>
            <span class="ws-thumb-tag">Saved</span>
          </a>`).join('');
        reel.innerHTML = cards + `
          <a class="ws-thumb ws-thumb--new" href="/account/editor"><span class="ws-thumb-new-msg">New design</span><span class="ws-thumb-plus" aria-hidden="true">+</span></a>`;
      }
    })();

    // ---- Stage A.5: real Brand Health (from the saved brand kit) ----
    (function wireBrandHealth() {
      let brand;
      try { brand = JSON.parse(localStorage.getItem('tmke.brand') || 'null'); } catch (_) { brand = null; }
      if (!brand) return; // no brand kit saved yet → keep the mock

      const hasLogo = (brand.logos || []).length > 0;
      const hasColours = (brand.colors || []).filter((c) => c && c.hex).length > 0;
      const hasFonts = !!(brand.fonts && (brand.fonts.heading || brand.fonts.body));
      const items = [...document.querySelectorAll('.ws-journey li')];
      if (items.length < 3) return;
      items[0].classList.toggle('is-done', hasLogo);
      items[1].classList.toggle('is-done', hasColours);
      items[2].classList.toggle('is-done', hasFonts);
      // Social connections aren't wired to a live source yet → show as to-do.
      items.slice(3).forEach((li) => li.classList.remove('is-done'));

      const done = items.filter((li) => li.classList.contains('is-done')).length;
      const pct = Math.round((done / items.length) * 100);
      // Hand the real % to the same observer that animates the ring + number.
      const ring = document.querySelector('.ws-ring-fg');
      if (ring) ring.setAttribute('data-ring', String(pct));
      const num = document.querySelector('.ws-ring b');
      if (num) num.setAttribute('data-count', String(pct));
    })();

    // ---- Stage A.4: real planner (this week from calendar_items) ----
    (async function wirePlanner() {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return; // signed out → keep the mock week

        const ymd = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        const now = new Date();
        const monday = new Date(now);
        monday.setDate(now.getDate() - ((now.getDay() + 6) % 7)); // back to Monday
        monday.setHours(0, 0, 0, 0);
        const weekEnd = new Date(monday); weekEnd.setDate(monday.getDate() + 5); // Mon..Fri

        const { data, error } = await supabase
          .from('calendar_items')
          .select('*')
          .eq('user_id', session.user.id)
          .gte('scheduled_date', ymd(monday))
          .lt('scheduled_date', ymd(weekEnd))
          .in('status', ['scheduled', 'reminder_sent', 'done'])
          .order('scheduled_date', { ascending: true });
        if (error) return;

        const byDate = {};
        (data || []).forEach((it) => { if (it.scheduled_date && !byDate[it.scheduled_date]) byDate[it.scheduled_date] = it; });

        const week = document.querySelector('.ws-week');
        if (!week) return;
        const todayYmd = ymd(new Date());
        const names = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri'];
        week.innerHTML = names.map((nm, i) => {
          const d = new Date(monday); d.setDate(monday.getDate() + i);
          const dYmd = ymd(d);
          const isToday = dYmd === todayYmd ? ' is-today' : '';
          const nameHtml = `<span class="ws-day-name">${nm}${dYmd === todayYmd ? ' <i>Today</i>' : ''}</span>`;
          const href = `/account/schedule?focus=${dYmd}`;
          const it = byDate[dYmd];
          if (it) {
            const thumb = it.thumbnail_url || it.asset_url || '';
            const label = it.title || it.caption || it.content_type || it.name || 'Scheduled';
            return `<a class="ws-day${isToday}" href="${href}"><span class="ws-day-name">${nm}${dYmd === todayYmd ? ' <i>Today</i>' : ''}</span><span class="ws-day-type">${escapeHtml(String(label))}</span><span class="ws-day-thumb"${thumb ? ` style="background-image:url('${escapeHtml(thumb)}')"` : ''}></span></a>`;
          }
          return `<a class="ws-day ws-day--empty${isToday}" href="${href}">${nameHtml}<span class="ws-day-empty-msg">No content planned</span><span class="ws-day-plus" aria-hidden="true">+</span></a>`;
        }).join('');

        // Hero brief: live count of posts scheduled this week.
        const schedCount = (data || []).length;
        const sb = document.getElementById('brief-sched');
        if (sb) sb.textContent = schedCount + (schedCount === 1 ? ' post' : ' posts');
      } catch (_) { /* keep the mock week */ }
    })();

    // ---- Stage A.3: real discovery card (a pack from The Edit) ----
    (async function wireDiscovery() {
      try {
        const { data } = await supabase
          .from('packs')
          .select('slug, title, description, cover_image_url, status, sort_order, created_at')
          .eq('status', 'active')
          .order('sort_order', { ascending: true })
          .order('created_at', { ascending: false })
          .limit(1);
        const pack = (data || [])[0];
        if (!pack) return; // no live packs → keep the mock Wimbledon card

        const card = document.querySelector('.ws-discover');
        if (card && pack.slug) card.setAttribute('href', '/edit/' + encodeURIComponent(pack.slug));
        const art = document.querySelector('.ws-discover-art');
        if (art && pack.cover_image_url) art.style.backgroundImage = `url('${pack.cover_image_url}')`;
        const h = document.querySelector('.ws-discover-h');
        if (h) h.textContent = pack.title;
        const desc = document.querySelector('.ws-discover-desc');
        if (desc && pack.description) desc.textContent = pack.description;
        const flag = document.querySelector('.ws-discover-flag');
        if (flag) flag.textContent = 'New in The Edit';
      } catch (_) { /* keep the mock */ }
    })();
  </script>

  <script define:vars={{ heroTemplates }}>
    // Rotate the hero Studio canvas through the published pack templates — a new
    // one each visit (index persisted in localStorage so it advances per sign-in).
    (function rotateHero() {
      if (!Array.isArray(heroTemplates) || !heroTemplates.length) return;
      let idx = 0;
      try { idx = parseInt(localStorage.getItem('tmke.dashHeroIdx') || '0', 10) || 0; } catch (_) {}
      const t = heroTemplates[idx % heroTemplates.length];
      try { localStorage.setItem('tmke.dashHeroIdx', String((idx + 1) % heroTemplates.length)); } catch (_) {}
      const img = document.getElementById('ws-edmock-img');
      if (img && t.thumb) { img.src = t.thumb; img.alt = t.name || ''; }
      const title = document.getElementById('ws-edmock-title');
      if (title && t.name) title.textContent = t.name;
      const link = document.getElementById('ws-edmock');
      if (link && t.id) link.setAttribute('href', '/account/editor?template=' + encodeURIComponent(t.id));
    })();
  </script>

  <script>
    // ===== Contextual coach =====
    // Picks the single most relevant, not-yet-dismissed tip from a prioritised
    // rule list, anchors it to the related element, and shows it once the
    // entrance settles. State is read locally (drafts / brand kit) so it works
    // signed-out in the preview; remembers dismissals in localStorage. The rule
    // shape (id / when / target / text) is ready for Claude to fill `text` later.
    (function coach() {
      const coach = document.getElementById('ws-coach');
      const msgEl = document.getElementById('ws-coach-msg');
      const xBtn = document.getElementById('ws-coach-x');
      if (!coach || !msgEl) return;

      const SEEN_KEY = 'tmke.coach.seen';
      let seen = [];
      try { seen = JSON.parse(localStorage.getItem(SEEN_KEY) || '[]'); } catch (_) {}

      const hasDraft = (() => {
        try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k && k.startsWith('tmke.editor.')) return true; } } catch (_) {}
        return false;
      })();
      const brand = (() => { try { return JSON.parse(localStorage.getItem('tmke.brand') || 'null'); } catch (_) { return null; } })();
      const brandDone = !!(brand && (brand.logos || []).length && (brand.colors || []).some((c) => c && c.hex) && brand.fonts && (brand.fonts.heading || brand.fonts.body));

      const RULES = [
        { id: 'brand-health', when: () => !brandDone, target: '.ws-textlink--accent', text: 'Finishing your Brand Kit means every design comes out on-brand automatically — worth a couple of minutes.' },
        { id: 'continue-draft', when: () => hasDraft, target: '.ws-reel .ws-thumb', text: 'Pick up where you left off — your most recent design is right here.' },
        { id: 'first-studio', when: () => !hasDraft, target: '.ws-tab[href="/account/studio"]', text: 'New here? Hop into Studio to make your first design — it only takes a minute.' },
        { id: 'prompt-hint', when: () => true, target: '.ws-iconround', text: "Not feeling today's prompt? Tap here for another idea." },
        { id: 'schedule', when: () => true, target: '#plan-h', text: "Nothing planned yet this week — a midweek post tends to land well." },
      ];

      const pick = RULES.find((r) => !seen.includes(r.id) && r.when() && document.querySelector(r.target));
      if (!pick) return;
      const target = document.querySelector(pick.target);
      msgEl.textContent = pick.text;

      function place() {
        coach.hidden = false;
        const r = target.getBoundingClientRect();
        const cx = r.left + r.width / 2 + window.scrollX;
        coach.style.top = (r.bottom + window.scrollY + 12) + 'px';
        coach.style.left = '0px';
        const cw = coach.offsetWidth;
        const maxLeft = document.documentElement.clientWidth - cw - 16;
        const left = Math.max(16, Math.min(cx - cw / 2, maxLeft));
        coach.style.left = left + 'px';
        coach.style.setProperty('--arrow-x', Math.max(16, Math.min(cx - left, cw - 16)) + 'px');
      }
      function dismiss() {
        coach.classList.remove('is-in');
        setTimeout(() => { coach.hidden = true; }, 320);
        if (!seen.includes(pick.id)) { seen.push(pick.id); try { localStorage.setItem(SEEN_KEY, JSON.stringify(seen)); } catch (_) {} }
      }
      xBtn?.addEventListener('click', dismiss);
      window.addEventListener('resize', () => { if (!coach.hidden) place(); });

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      setTimeout(() => { place(); requestAnimationFrame(() => coach.classList.add('is-in')); }, reduce ? 400 : 3300);
    })();
  </script>
</BaseLayout>
