---
import BaseLayout from "../../layouts/BaseLayout.astro";
import HubFootBar from "../../components/account/HubFootBar.astro";
import BrandKitOffer from "../../components/BrandKitOffer.astro";
import { learnSlides } from "../../data/dashboard-slides.js";
import { getMembersPosts } from "../../data/blog.js";
import "../../styles/ws-system.css";
import "../../styles/reel.css";
import "../../styles/hub-entrance.css";   // the dashboard draws its own header
import NewDesignModal from "../../components/account/NewDesignModal.astro";
import StudioInspo from "../../components/account/StudioInspo.astro";
import { WHATS_NEW } from "../../data/whats-new.js";

// The What's new card shows the latest update's picture and headline.
const latestNews = WHATS_NEW[0];
const HUB_NEWS = latestNews;   // the menu's "What's new to the Hub" card
import { MENU_CARDS } from "../../data/menu-cards.js";
const HUB_NEWS_IMG = MENU_CARDS.news || HUB_NEWS.media;

// Named on the "from the blog" starter card. Build-time is fine: the card
// links to the blog either way, so a stale title is a stale title, not a
// broken link.
const latestPost = (await getMembersPosts())[0] ?? null;
// The members blog opens a piece at /account/blog#<slug>, so the dashboard links there too.
const latestPostHref = latestPost?.slug ? `/account/blog#${latestPost.slug}` : "/account/blog";

// Chapter 04's folder: the Getting Started series, then the latest blog.
const LEARN_SLIDES = learnSlides({ blogTitle: latestPost?.title, blogHref: latestPostHref });

---

<!--
  The member dashboard. This IS the live page: /dashboard redirects here and
  every nav in the hub points at /account.

  One full-width column, read as numbered chapters:

    hero        date, greeting, three stats, one call to action, photograph
    chapter 01  your Studio: five portrait doors, the fifth the last design
    chapter 02  the week, seven days, today outlined darker
    chapter 03  be inspired: the reel of pack designs, with today's prompt
                and the next booking stacked beside it
    chapter 04  learn: a folder, the titles its tabs (src/data/dashboard-slides.js)
    chapter 05  what is new

  Reordered on 16 Oct 2026 (Dani): the Studio first, because it is what
  people come here for.

  The third hero stat is claimed by whatever most needs attention - see
  claimSlot() for the ranking. Everything else on the page is fixed.

  "New in The Studio" is three cards: the Property Pack (The Edit), What's new
  in the Member Hub (the latest five updates, src/data/whats-new.js, opened in
  the StudioInspo pop-out), and next month's content calendar.
-->
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Your TMKE — workspace"
  description="Your marketing brief, your designs in progress, and what's new — beautifully organised."
>
  <div class="ws">
    <!-- ============ Top navigation ============ -->
    <header class="ws-nav" aria-label="Primary">
      <!-- LEFT: hamburger opens the off-canvas drawer -->
      <button type="button" class="ws-burger" data-drawer-open aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <!-- CENTRE: the six core sections -->
      <nav class="ws-tabs" aria-label="Sections">
        <a class="ws-tab is-active" href="/account" aria-current="page">Dashboard</a>
        <a class="ws-tab" href="/account/studio">Studio</a>
        <a class="ws-tab" href="/account/schedule">Marketing Planner</a>
        <a class="ws-tab" href="/account/orders">Orders</a>
        <a class="ws-tab" href="/account/bookings">Bookings</a>
        <a class="ws-tab" href="/account/social">Your SMM</a>
        <a class="ws-tab" href="/account/community">Community</a>
        <a class="ws-tab" href="/edit">Shop</a>
      </nav>

      <!-- RIGHT: notifications, log out, you -->
      <div class="ws-nav-right">
        <div class="ws-menu ws-notif is-read" data-menu>
          <button type="button" class="ws-navic" data-menu-btn aria-expanded="false" aria-haspopup="true" aria-label="Notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg><span class="ws-dot" data-notif-dot></span></button>
          <div class="ws-dropdown ws-dropdown--right ws-dropdown--notif" role="menu">
            <div class="ws-notif-head"><strong>Notifications</strong><button type="button" class="ws-notif-clear" data-notif-clear>Mark all read</button></div>
            <div class="ws-notif-list">
              <!-- Filled by lib/notifications.js. Never sample items: they used to sit
                   here and stayed on screen whenever the real ones failed to load. -->
              <div class="ws-notif-empty">You&rsquo;re all caught up.</div>
            </div>
          </div>
        </div>
        <a class="ws-navic ws-logout" href="/login" data-logout data-tip="Log out" aria-label="Log out"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"/><path d="M10 17l5-5-5-5"/><line x1="15" y1="12" x2="3" y2="12"/></svg></a>
        <div class="ws-menu ws-who" data-menu>
          <button type="button" class="ws-whobtn" data-menu-btn aria-expanded="false" aria-haspopup="true">
            <span class="ws-whoav"></span>
            <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ws-dropdown ws-dropdown--right" role="menu">
            <div class="ws-dropdown-head"><strong></strong><span></span></div>
            <a role="menuitem" href="/account/profile">Your profile</a>
            <a role="menuitem" href="/account/profile">Brand Kit</a>
            <a role="menuitem" href="/account/orders">Billing</a>
            <a role="menuitem" href="/login" class="ws-dropdown-out" data-logout>Sign out</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Off-canvas drawer — slides in from the left (everything that isn't a tab) -->
    <div class="ws-drawer" data-drawer hidden>
      <div class="ws-drawer-scrim" data-drawer-close></div>
      <aside class="ws-drawer-panel" data-lenis-prevent aria-label="More menu">
        <div class="ws-drawer-top">
          <a class="ws-logo" href="/account">TMKE</a>
          <span class="ws-drawer-acts">
            <button type="button" class="ws-navic ws-notif is-read ws-drawer-bell" data-drawer-bell aria-expanded="false" aria-label="Notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg><span class="ws-dot"></span></button>
            <button type="button" class="ws-navic ws-drawer-x" data-drawer-close aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button>
          </span>
        </div>
        <!-- The notifications, in the menu (Dani, 17 Oct): filled by
             lib/notifications.js like the bell's own list. -->
        <section class="ws-drawer-notifs" data-drawer-notifs hidden aria-label="Notifications">
          <div class="ws-notif-head"><strong>Notifications</strong><button type="button" class="ws-notif-clear" data-notif-clear>Mark all read</button></div>
          <div class="ws-notif-list"><div class="ws-notif-empty">You&rsquo;re all caught up.</div></div>
        </section>
        <nav class="ws-drawer-nav" aria-label="All sections">
          <span class="ws-drawer-label">Workspace</span>
          <a href="/account" class="is-active" aria-current="page">Dashboard</a>
          <a href="/account/studio">Studio</a>
          <a href="/account/profile">Brand Kit</a>
          <a href="/account/schedule">Marketing Planner</a>
          <a href="/edit">Shop</a>
          <span class="ws-drawer-label">Learn</span>
          <a href="/account/guides">Training Studio</a>
          <a href="/account/blog">Blog</a>
          <span class="ws-drawer-label">Community</span>
          <a href="/account/community">Community</a>
          <a href="/account/community?new=discussion">Start a conversation</a>
          <span class="ws-drawer-label">Manage</span>
          <a href="/account/orders">Orders</a>
          <a href="/account/bookings">Bookings</a>
          <a href="/account/social">Your SMM</a>
          <a href="/account/orders">Billing</a>
          <a href="/account/profile">Settings</a>
          <span class="ws-drawer-label">Help</span>
          <a href="/account/contact">Contact</a>
          <a href="/account/help">Help Centre</a>
          <!-- Highlights, turning on their own (lib/drawer-extras.js): the newest pack, What's New, the latest blog post, and a print or demo pack. -->
          <div data-drawer-carousel data-news-img={HUB_NEWS_IMG} hidden></div>
        </nav>
        <a class="ws-drawer-out" href="/login" data-logout>Sign out</a>
      </aside>
    </div>

    <main class="ws-main">
      <!-- ============ Left: the workflow ============ -->
      <div class="ws-left">
        <!-- HERO — straight on the page, no card and no photograph (Dani,
             16 Oct): the date, greeting and intro, then "Continue creating" at
             the bottom left and the three stats side by side on the right. -->
        <section class="ws-hero">
          <div class="ws-hero-copy">
            <p class="ws-hero-date" id="ws-hero-date">&nbsp;</p>
            <h1 class="ws-greeting" style="visibility:hidden"><span class="ws-greet-line"></span> <span class="ws-greet-name"></span></h1>
            <script is:inline>
              /* The greeting is written before the page is drawn, from the
                 sign-in this browser already holds. It used to arrive as
                 "Good morning, Danielle." -- the mock-up's placeholder --
                 and flick to the member's own name a moment later (Dani,
                 14 Oct: no placeholders, ever). The line stays hidden until
                 it holds the real name -- here, or from the module below once
                 the session is checked. */
              (function () {
                try {
                  var h = new Date().getHours();
                  var g = h >= 5 && h < 12 ? "Good morning" : h >= 12 && h < 17 ? "Good afternoon" : h >= 17 && h < 22 ? "Good evening" : "Burning the midnight oil";
                  var name = "", email = "";
                  var demo = JSON.parse(localStorage.getItem("tmke_demo") || "null");
                  var member = JSON.parse(localStorage.getItem("tmke-member-auth") || "null");
                  // A public demo left in this browser is over once a member is
                  // signed in (src/lib/demo.js): their name, not the visitor's.
                  if (demo && !(demo.kind === "training" || demo.training) && member && (member.access_token || (member.currentSession && member.currentSession.access_token))) demo = null;
                  if (demo) { name = demo.name || ""; email = demo.email || ""; }
                  else {
                    var s = JSON.parse(localStorage.getItem("tmke-member-auth") || "null");
                    var u = s && (s.user || (s.currentSession && s.currentSession.user));
                    if (u) {
                      email = u.email || "";
                      name = (u.user_metadata && u.user_metadata.name) || email.split("@")[0].replace(/[._]/g, " ");
                      name = String(name).toLowerCase().replace(/\b\w/g, function (c) { return c.toUpperCase(); });
                    }
                  }
                  var first = name.trim().split(/\s+/)[0];
                  var q = function (sel) { return document.querySelector(sel); };
                  q(".ws-greet-line").textContent = g + ",";
                  // Shown only once the real name is in it; until then, nothing.
                  if (first) { q(".ws-greet-name").textContent = first + "."; q(".ws-greeting").style.visibility = ""; }
                  if (name) {
                    var dh = q(".ws-dropdown-head strong"); if (dh) dh.textContent = name;
                    var av = q(".ws-whoav"); if (av) av.textContent = name.trim().split(/\s+/).slice(0, 2).map(function (w) { return w[0]; }).join("").toUpperCase();
                  }
                  if (email) { var de = q(".ws-dropdown-head span"); if (de) de.textContent = email; }
                } catch (_) {}
              })();
            </script>
            <p class="ws-hero-sub">Your marketing's looking pretty organised. <br />Here's what needs your attention today.</p>
            <ul class="ws-brief">
              <li style="--d:1">
                <a class="ws-brief-slot" href="/account/schedule">
                  <span class="ws-brief-ic ws-brief-ic--sched"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg></span>
                  <span class="ws-brief-tx"><strong id="brief-sched">—</strong><span>planned this week</span></span>
                </a>
              </li>
              <li style="--d:2">
                <!-- No href until there is a booking worth going to look at. An
                     anchor without one is inert, which beats a link to nothing. -->
                <a class="ws-brief-slot" id="brief-bookings-link">
                  <span class="ws-brief-ic ws-brief-ic--time"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><path d="M8 14h4"/></svg></span>
                  <span class="ws-brief-tx"><strong id="brief-bookings">—</strong><span id="brief-bookings-sub">coming up</span></span>
                </a>
              </li>
              <li style="--d:3">
                <a class="ws-brief-slot" id="brief-slot" href="/account/profile">
                  <span class="ws-brief-ic ws-brief-ic--kit" id="brief-slot-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.2 2.4 2.4 4.6-4.9"/></svg></span>
                  <span class="ws-brief-tx"><strong id="brief-slot-v">Brand kit</strong><span id="brief-slot-l">—</span></span>
                </a>
              </li>
            </ul>
            <a class="ws-btn ws-btn--primary ws-hero-cta-btn" href="/account/editor">Continue creating
              <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </section>

        <!-- YOUR STUDIO — five ways in, portrait, shading down from the brand
             secondary (Dani, 16 Oct). The fifth is the last design, so its
             card is the shape a post is and the design can be seen. -->
        <section class="ws-block" aria-labelledby="studio-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="studio-h"><span class="ws-block-ch">Chapter 01</span>Your Studio</h2>
            <a class="ws-block-link" href="/account/studio">View All Tools
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </header>
          <div class="ws-tools ws-doors">
            <a class="ws-tool ws-door" href="/account/editor?new=1" data-new-design>
              <span class="ws-door-img" aria-hidden="true" style="background-image:url('/images/dashboard/door-create-v1.webp')"></span>
              <span class="ws-door-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L20 8a2.8 2.8 0 0 0-4-4L4 16z"/><path d="M14 6l4 4"/></svg></span>
              <span class="ws-door-tx"><strong>Create something</strong><span>Start with a blank canvas.</span></span>
              <span class="ws-door-go" aria-hidden="true">&rarr;</span>
            </a>
            <a class="ws-tool ws-door" href="/account/studio">
              <!-- A template from the demo pack, set by wireDoorPack(). -->
              <span class="ws-door-img" id="ws-door-pack-img" aria-hidden="true"></span>
              <span class="ws-door-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
              <span class="ws-door-tx"><strong>Your packs</strong><span id="tool-packs">Templates ready to edit.</span></span>
              <span class="ws-door-go" aria-hidden="true">&rarr;</span>
            </a>
            <a class="ws-tool ws-door" href="/account/profile">
              <span class="ws-door-img" aria-hidden="true" style="background-image:url('/images/dashboard/door-brand-kit-v1.webp')"></span>
              <span class="ws-door-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg></span>
              <span class="ws-door-tx"><strong>Brand kit</strong><span id="tool-kit">Everything looking like you.</span></span>
              <span class="ws-door-go" aria-hidden="true">&rarr;</span>
            </a>
            <a class="ws-tool ws-door" href="/account/schedule">
              <span class="ws-door-img" aria-hidden="true" style="background-image:url('/images/dashboard/door-planner-v1.webp')"></span>
              <span class="ws-door-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg></span>
              <span class="ws-door-tx"><strong>Content planner</strong><span>See what's coming up.</span></span>
              <span class="ws-door-go" aria-hidden="true">&rarr;</span>
            </a>
            <!-- The last design, once we know what it is: until then the card
                 is its shade and nothing else, never a stand-in picture that
                 swaps out (wireWork fills it). -->
            <a class="ws-tool ws-door ws-resume" id="ws-resume" href="/account/studio">
              <span class="ws-resume-img" id="ws-resume-img" aria-hidden="true"></span>
              <span class="ws-door-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5l2 2"/><path d="M20 4v5h-5"/><path d="M12 8v4l3 2"/></svg></span>
              <span class="ws-door-tx"><strong>Continue design</strong><span id="ws-resume-name">&nbsp;</span></span>
              <span class="ws-door-go" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </section>

        <section class="ws-block" aria-labelledby="plan-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="plan-h"><span class="ws-block-ch">Chapter 02</span>Your week</h2>
            <a class="ws-block-link" href="/account/schedule">View Marketing Planner
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </header>
          <div class="ws-week">
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Mon</span><span class="ws-day-num">10</span><span class="ws-day-thumb" style="background-image:url('/assets/home%20window.jpg')"></span></a>
            <a class="ws-day ws-day--empty" href="/account/schedule"><span class="ws-day-name">Tue</span><span class="ws-day-num">11</span><span class="ws-day-empty-msg">No post planned</span></a>
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Wed</span><span class="ws-day-num">12</span><span class="ws-day-thumb" style="background-image:url('/assets/sitting%20chair.jpg')"></span></a>
            <a class="ws-day is-today" href="/account/schedule"><span class="ws-day-name">Thu <i>Today</i></span><span class="ws-day-num">13</span><span class="ws-day-empty-msg">No post planned</span></a>
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Fri</span><span class="ws-day-num">14</span><span class="ws-day-thumb" style="background-image:url('/assets/home%20chair.jpg')"></span></a>
            <a class="ws-day ws-day--empty" href="/account/schedule"><span class="ws-day-name">Sat</span><span class="ws-day-num">15</span><span class="ws-day-empty-msg">No post planned</span></a>
            <a class="ws-day ws-day--empty" href="/account/schedule"><span class="ws-day-name">Sun</span><span class="ws-day-num">16</span><span class="ws-day-empty-msg">No post planned</span></a>
          </div>

          <!-- The starter ideas are written into the empty day cards above when
               the week is genuinely quiet - see fillStarterDays(). The blog
               title is carried here because it is only known at build time. -->
          <span id="ws-starters" hidden data-blog-title={latestPost?.title ?? ""} data-blog-href={latestPostHref}></span>
        </section>

        <!-- BE INSPIRED — the packs going by, and today's prompt and the next
             booking stacked at the right (Dani, 16 Oct). -->
        <section class="ws-block" aria-labelledby="inspire-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="inspire-h"><span class="ws-block-ch">Chapter 03</span>Be inspired</h2>
            <a class="ws-block-link" href="/edit">Browse The Edit
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </header>
          <div class="ws-inspire">
            <!-- Filled by wireReel(): Dani's mockups (src/data/inspiration-reel.js)
                 or, until there are any, the packs' own templates. Empty and
                 dark until they've loaded; nothing stands in for them. -->
            <div class="ws-reel" id="ws-reel" aria-label="Templates from our packs" aria-busy="true">
              <div class="ws-reel-track" id="ws-reel-track"></div>
            </div>

            <div class="ws-inspire-side">
              <div class="ws-side">
                <span class="ws-side-eyebrow">Today's prompt</span>
                <div class="ws-idea-wrap">
                  <p class="ws-idea" id="idea-h">&nbsp;</p>
                  <p class="ws-idea-hint" id="idea-hint">&nbsp;</p>
                </div>
                <div class="ws-side-foot">
                  <a class="ws-btn ws-btn--primary ws-btn--sm" href="/account/editor?blank=1">Create this post
                    <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                  <button type="button" class="ws-iconround ws-tip-right ws-idea-again" data-tip="Another idea" aria-label="Another idea">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5l2 2M20 12a8 8 0 0 1-14 5l-2-2"/><path d="M20 4v5h-5M4 20v-5h5"/></svg>
                  </button>
                </div>
              </div>

              <div class="ws-side">
                <span class="ws-side-eyebrow">Coming up</span>
                <div id="ws-next-bk">
                  <p class="ws-side-h">&nbsp;</p>
                </div>
                <div class="ws-side-foot">
                  <a class="ws-btn ws-btn--ghost ws-btn--sm" href="/account/bookings">View bookings
                    <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- ============ Chapter 04 — Learn ============
           A row of buttons, one per title, over a picture that fills the
           width; a button slides across to its own picture, with the title,
           what it's about and its lessons on it (Dani, 16 Oct). -->
      <section class="ws-block ws-folder" aria-labelledby="learn-h" data-folder>
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="learn-h"><span class="ws-block-ch">Chapter 04</span>Training Studio</h2>
          <a class="ws-block-link" href="/account/guides">All guides
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </header>
        <div class="ws-folder-wrap">
          <div class="ws-folder-tabs" role="tablist" aria-label="Training Studio">
            {LEARN_SLIDES.map((sl, i) => (
              <button type="button" role="tab" class={`ws-folder-tab${i === 0 ? " is-on" : ""}`} id={`ws-ftab-${i}`} aria-controls={`ws-fslide-${i}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-folder-tab={i} style={`--i:${i}`}>{sl.title}</button>
            ))}
          </div>
          <div class="ws-folder-body">
            <div class="ws-folder-track" data-folder-track>
              {LEARN_SLIDES.map((sl, i) => (
                <a class="ws-folder-slide" href={sl.href} id={`ws-fslide-${i}`} role="tabpanel" aria-labelledby={`ws-ftab-${i}`} aria-hidden={i === 0 ? undefined : "true"} tabindex={i === 0 ? undefined : -1} data-blog={sl.blog ? "" : undefined}>
                  <span class="ws-folder-pic" style={`background-image:url('${sl.art}')`}></span>
                  <span class="ws-folder-card">
                    <span class="ws-folder-flag">{sl.flag}</span>
                    <strong class="ws-folder-h">{sl.title}</strong>
                    <span class="ws-folder-about" data-blog-sum={sl.blog ? "" : undefined}>{sl.summary}</span>
                    <span class="ws-btn ws-btn--sm ws-folder-cta">{sl.cta} <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
                    <span class="ws-folder-lessons">{sl.lessons.map((t) => <span>{t}</span>)}</span>
                  </span>
                  {sl.foot.length > 0 && <span class="ws-folder-foot">{sl.foot.join(" · ")}</span>}
                </a>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ============ New in The Studio — full width ============ -->
      <section class="ws-block" aria-labelledby="new-h">
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="new-h"><span class="ws-block-ch">Chapter 05</span>New in The Studio</h2>
          <a class="ws-block-link" href="#" data-inspo="news">What's New
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </header>
        <!-- Keywords on the left, the latest three on the right (Dani, 16 Oct,
             from a reference she liked). Leads straight into Learn below. -->
        <div class="ws-wn">
          <div class="ws-wn-col ws-wn-col--keys">
            <p class="ws-wn-label">Explore</p>
            <nav class="ws-wn-pills" aria-label="Explore">
              <!-- Three lines, two to a line, whatever the width (Dani: Guides
                   starts the third line, so it isn't crowded). -->
              <span class="ws-wn-row"><a class="ws-wn-pill" href="/edit">Template packs</a><a class="ws-wn-pill" href="#" data-inspo="news">Hub updates</a></span>
              <span class="ws-wn-row"><a class="ws-wn-pill" href="#" data-inspo="trending">See what's working</a><a class="ws-wn-pill" href="/account/schedule">Content calendar</a></span>
              <span class="ws-wn-row"><a class="ws-wn-pill" href="/account/guides">Training Studio</a><a class="ws-wn-pill" href="/account/blog">Blog</a><a class="ws-wn-pill" href="/account/community">Community</a></span>
            </nav>
          </div>
          <div class="ws-wn-col">
            <p class="ws-wn-label">Latest</p>
            <div class="ws-wn-cards">
              <!-- First, always: What's New in the hub (Dani, 17 Oct), with the
                   latest entry's picture. -->
              <a class="ws-wn-card" href="#" data-inspo="news">
                <span class="ws-wn-art" style={`background-image:url('${latestNews.media}')`}></span>
                <span class="ws-wn-tx">
                  <span class="ws-wn-flag">Just landed</span>
                  <strong class="ws-wn-h">What&rsquo;s New in Your Member Hub</strong>
                </span>
              </a>
              <a class="ws-wn-card" href="/edit">
                <span class="ws-wn-art" style="background-image:url('https://assets.tmke.co.uk/TMKE%20Member%20Hub/Property%20Pack%20-%20Dashboard.png')"></span>
                <span class="ws-wn-tx">
                  <span class="ws-wn-flag">Template pack</span>
                  <strong class="ws-wn-h">The Property<br />Pack</strong>
                </span>
              </a>
              <!-- Month, picture and link are set by wireNextMonth(): a card
                   built in September is wrong the rest of the year, so it holds
                   nothing until it knows. -->
              <a class="ws-wn-card ws-news-cal" id="ws-news-cal" href="/account/schedule">
                <span class="ws-wn-art ws-news-art"></span>
                <span class="ws-wn-tx">
                  <span class="ws-wn-flag">Seasonal content</span>
                  <strong class="ws-wn-h" id="ws-news-cal-h">&nbsp;</strong>
                </span>
