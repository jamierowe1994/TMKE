    body.ws-ready .ws-greeting { animation: wsIn 0.6s var(--ws-ease) both; animation-delay: 0.12s; }
    body.ws-ready .ws-hero-cta-btn { animation: wsIn 0.55s var(--ws-ease) both; animation-delay: 1.0s; }
    body.ws-ready .ws-block-head { animation: wsIn 0.5s var(--ws-ease) both; animation-delay: 1.1s; }
    .ws-week .ws-day, .ws-tools .ws-tool { opacity: 0; }
    body.ws-ready .ws-week .ws-day, body.ws-ready .ws-tools .ws-tool { animation: wsIn 0.55s var(--ws-ease) both; }
    body.ws-ready .ws-week .ws-day:nth-child(1), body.ws-ready .ws-tools .ws-tool:nth-child(1) { animation-delay: 1.18s; }
    body.ws-ready .ws-week .ws-day:nth-child(2), body.ws-ready .ws-tools .ws-tool:nth-child(2) { animation-delay: 1.25s; }
    body.ws-ready .ws-week .ws-day:nth-child(3), body.ws-ready .ws-tools .ws-tool:nth-child(3) { animation-delay: 1.32s; }
    body.ws-ready .ws-week .ws-day:nth-child(4), body.ws-ready .ws-tools .ws-tool:nth-child(4) { animation-delay: 1.39s; }
    body.ws-ready .ws-week .ws-day:nth-child(5), body.ws-ready .ws-tools .ws-tool:nth-child(5) { animation-delay: 1.46s; }
    body.ws-ready .ws-week .ws-day:nth-child(6), body.ws-ready .ws-tools .ws-tool:nth-child(6) { animation-delay: 1.53s; }
    body.ws-ready .ws-week .ws-day:nth-child(7), body.ws-ready .ws-tools .ws-tool:nth-child(7) { animation-delay: 1.60s; }
    /* nav drops in last, bouncy (real-world spring) */
