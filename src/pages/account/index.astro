---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { templates } from "../../data/library.js";
import { getMembersPosts } from "../../data/blog.js";
import "../../styles/ws-system.css";
import NewDesignModal from "../../components/account/NewDesignModal.astro";

// Named on the "from the blog" starter card. Build-time is fine: the card
// links to the blog either way, so a stale title is a stale title, not a
// broken link.
const latestPost = (await getMembersPosts())[0] ?? null;
// BlogPanel links posts as /account/blog#<slug>, so the dashboard does too.
const latestPostHref = latestPost?.slug ? `/account/blog#${latestPost.slug}` : "/account/blog";

// "Pick up where you left off" falls back to a template the member can start
// from, so the card is never empty. wireWork() swaps in their most recently
// edited design as soon as there is one.
const recentTemplates = templates.slice(0, 4);
---

<!--
  The member dashboard. This IS the live page: /dashboard redirects here and
  every nav in the hub points at /account.

  One full-width column, read as numbered chapters:

    hero        date, greeting, three stats, one call to action, photograph
    chapter 01  the week, seven days, today outlined darker
    chapter 02  four ways into the Studio
    chapter 03  the last thing worked on, today's prompt, the next booking
    chapter 04  a guide (the full-bleed banner)
    chapter 05  what is new

  The third hero stat is claimed by whatever most needs attention - see
  claimSlot() for the ranking. Everything else on the page is fixed.

  Still placeholder, for a later content pass: the four "New in The Studio"
  cards. Their links go to real pages but nothing fetches the items.
-->
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Your TMKE — workspace"
  description="Your marketing brief, your designs in progress, and what's new — beautifully organised."
>
  <div class="ws">
    <!-- ============ Top navigation ============ -->
    <header class="ws-nav" aria-label="Primary">
      <!-- LEFT: hamburger opens the off-canvas drawer -->
      <button type="button" class="ws-burger" data-drawer-open aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <!-- CENTRE: the six core sections -->
      <nav class="ws-tabs" aria-label="Sections">
        <a class="ws-tab is-active" href="/account" aria-current="page">Dashboard</a>
        <a class="ws-tab" href="/account/studio">Studio</a>
        <a class="ws-tab" href="/account/schedule">Planner</a>
        <a class="ws-tab" href="/account/orders">Orders</a>
        <a class="ws-tab" href="/account/bookings">Bookings</a>
        <a class="ws-tab" href="/account/social">Your SMM</a>
        <a class="ws-tab" href="/edit">Shop</a>
      </nav>

      <!-- RIGHT: notifications, log out, you -->
      <div class="ws-nav-right">
        <div class="ws-menu ws-notif" data-menu>
          <button type="button" class="ws-navic" data-menu-btn aria-expanded="false" aria-haspopup="true" aria-label="Notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg><span class="ws-dot" data-notif-dot></span></button>
          <div class="ws-dropdown ws-dropdown--right ws-dropdown--notif" role="menu">
            <div class="ws-notif-head"><strong>Notifications</strong><button type="button" class="ws-notif-clear" data-notif-clear>Mark all read</button></div>
            <div class="ws-notif-list">
              <a class="ws-notif-item" role="menuitem" href="/account/orders">
                <span class="ws-notif-ic ws-notif-ic--order"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><line x1="3" y1="6" x2="21" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg></span>
                <span class="ws-notif-txt"><b>Order confirmed</b><i>Your “City Centre” pack is ready to edit</i></span>
                <span class="ws-notif-time">2h</span>
              </a>
              <a class="ws-notif-item" role="menuitem" href="/account/bookings">
                <span class="ws-notif-ic ws-notif-ic--booking"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg></span>
                <span class="ws-notif-txt"><b>Booking confirmed</b><i>Content Studio — Wed 9 Jul, 10:00</i></span>
                <span class="ws-notif-time">5h</span>
              </a>
              <a class="ws-notif-item" role="menuitem" href="/account/blog">
                <span class="ws-notif-ic ws-notif-ic--blog"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
                <span class="ws-notif-txt"><b>New on the blog</b><i>5 hooks that stop the scroll</i></span>
                <span class="ws-notif-time">1d</span>
              </a>
              <a class="ws-notif-item" role="menuitem" href="/account/guides">
                <span class="ws-notif-ic ws-notif-ic--news"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 4h16v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2z"/><line x1="8" y1="9" x2="16" y2="9"/><line x1="8" y1="13" x2="14" y2="13"/></svg></span>
                <span class="ws-notif-txt"><b>What’s new</b><i>Scheduling just got faster in the Planner</i></span>
                <span class="ws-notif-time">2d</span>
              </a>
            </div>
          </div>
        </div>
        <a class="ws-navic ws-logout" href="/login" data-logout data-tip="Log out" aria-label="Log out"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3"/><path d="M10 17l5-5-5-5"/><line x1="15" y1="12" x2="3" y2="12"/></svg></a>
        <div class="ws-menu ws-who" data-menu>
          <button type="button" class="ws-whobtn" data-menu-btn aria-expanded="false" aria-haspopup="true">
            <span class="ws-whoav">DC</span>
            <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ws-dropdown ws-dropdown--right" role="menu">
            <div class="ws-dropdown-head"><strong>Danielle Carter</strong><span>danielle@marinaestates.co.uk</span></div>
            <a role="menuitem" href="/account/profile">Your profile</a>
            <a role="menuitem" href="/account/profile">Brand Kit</a>
            <a role="menuitem" href="/account/orders">Billing</a>
            <a role="menuitem" href="/login" class="ws-dropdown-out">Sign out</a>
          </div>
        </div>
      </div>
    </header>

    <!-- Off-canvas drawer — slides in from the left (everything that isn't a tab) -->
    <div class="ws-drawer" data-drawer hidden>
      <div class="ws-drawer-scrim" data-drawer-close></div>
      <aside class="ws-drawer-panel" aria-label="More menu">
        <div class="ws-drawer-top">
          <a class="ws-logo" href="/account">TMKE</a>
          <button type="button" class="ws-navic ws-drawer-x" data-drawer-close aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button>
        </div>
        <nav class="ws-drawer-nav" aria-label="All sections">
          <span class="ws-drawer-label">Workspace</span>
          <a href="/account" class="is-active" aria-current="page">Dashboard</a>
          <a href="/account/studio">Studio</a>
          <a href="/account/schedule">Planner</a>
          <a href="/account/orders">Orders</a>
          <a href="/account/bookings">Bookings</a>
          <a href="/edit">Shop</a>
          <span class="ws-drawer-label">Learn</span>
          <a href="/account/guides">Guides</a>
          <a href="/account/blog">Blog</a>
          <span class="ws-drawer-label">Manage</span>
          <a href="/account/profile">Brand Kit</a>
          <a href="/account/social">Your SMM</a>
          <a href="/account/orders">Billing</a>
          <a href="/account/profile">Settings</a>
          <span class="ws-drawer-label">Help</span>
          <a href="/contact">Contact</a>
          <a href="/contact">Help Centre</a>
        </nav>
        <a class="ws-drawer-out" href="/login" data-logout>Sign out</a>
      </aside>
    </div>

    <main class="ws-main">
      <!-- ============ Left: the workflow ============ -->
      <div class="ws-left">
        <!-- HERO — date, greeting over two lines, subtext, three stat tiles,
             the call to action, and the photograph on the right. -->
        <section class="ws-hero">
          <div class="ws-hero-copy">
            <p class="ws-hero-date" id="ws-hero-date">&nbsp;</p>
            <h1 class="ws-greeting"><span class="ws-greet-line">Good evening,</span> <span class="ws-greet-name">Danielle.</span></h1>
            <p class="ws-hero-sub">Your marketing's looking pretty organised.<br />Here's what needs your attention today.</p>
            <ul class="ws-brief">
              <li style="--d:1">
                <a class="ws-brief-slot" href="/account/schedule">
                  <span class="ws-brief-ic ws-brief-ic--sched"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg></span>
                  <span class="ws-brief-tx"><strong id="brief-sched">—</strong><span>planned this week</span></span>
                </a>
              </li>
              <li style="--d:2">
                <!-- No href until there is a booking worth going to look at. An
                     anchor without one is inert, which beats a link to nothing. -->
                <a class="ws-brief-slot" id="brief-bookings-link">
                  <span class="ws-brief-ic ws-brief-ic--time"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><path d="M8 14h4"/></svg></span>
                  <span class="ws-brief-tx"><strong id="brief-bookings">—</strong><span id="brief-bookings-sub">coming up</span></span>
                </a>
              </li>
              <li style="--d:3">
                <a class="ws-brief-slot" id="brief-slot" href="/account/profile">
                  <span class="ws-brief-ic ws-brief-ic--kit" id="brief-slot-ic"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m8.5 12.2 2.4 2.4 4.6-4.9"/></svg></span>
                  <span class="ws-brief-tx"><strong id="brief-slot-v">Brand kit</strong><span id="brief-slot-l">—</span></span>
                </a>
              </li>
            </ul>
            <a class="ws-btn ws-btn--primary ws-hero-cta-btn" href="/account/editor">Continue creating
              <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
          <div class="ws-hero-photo" role="img" aria-label="A styled living room with a marble table"></div>
        </section>

        <!-- PLAN -->
        <section class="ws-block" aria-labelledby="plan-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="plan-h"><span class="ws-block-ch">Chapter 01</span>Your week</h2>
            <a class="ws-block-link" href="/account/schedule">View Planner
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </header>
          <div class="ws-week">
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Mon</span><span class="ws-day-num">10</span><span class="ws-day-thumb" style="background-image:url('/assets/home%20window.jpg')"></span></a>
            <a class="ws-day ws-day--empty" href="/account/schedule"><span class="ws-day-name">Tue</span><span class="ws-day-num">11</span><span class="ws-day-empty-msg">No post planned</span></a>
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Wed</span><span class="ws-day-num">12</span><span class="ws-day-thumb" style="background-image:url('/assets/sitting%20chair.jpg')"></span></a>
            <a class="ws-day is-today" href="/account/schedule"><span class="ws-day-name">Thu <i>Today</i></span><span class="ws-day-num">13</span><span class="ws-day-empty-msg">No post planned</span></a>
            <a class="ws-day" href="/account/schedule"><span class="ws-day-name">Fri</span><span class="ws-day-num">14</span><span class="ws-day-thumb" style="background-image:url('/assets/home%20chair.jpg')"></span></a>
            <a class="ws-day ws-day--empty" href="/account/schedule"><span class="ws-day-name">Sat</span><span class="ws-day-num">15</span><span class="ws-day-empty-msg">No post planned</span></a>
            <a class="ws-day ws-day--empty" href="/account/schedule"><span class="ws-day-name">Sun</span><span class="ws-day-num">16</span><span class="ws-day-empty-msg">No post planned</span></a>
          </div>

          <!-- The starter ideas are written into the empty day cards above when
               the week is genuinely quiet - see fillStarterDays(). The blog
               title is carried here because it is only known at build time. -->
          <span id="ws-starters" hidden data-blog-title={latestPost?.title ?? ""} data-blog-href={latestPostHref}></span>
        </section>

        <!-- YOUR STUDIO — four ways in, wider than they are tall -->
        <section class="ws-block" aria-labelledby="studio-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="studio-h"><span class="ws-block-ch">Chapter 02</span>Your Studio</h2>
            <a class="ws-block-link" href="/account/studio">View All Tools
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </header>
          <div class="ws-tools">
            <a class="ws-tool" href="/account/editor?new=1" data-new-design>
              <span class="ws-tool-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4L20 8a2.8 2.8 0 0 0-4-4L4 16z"/><path d="M14 6l4 4"/></svg></span>
              <span class="ws-tool-tx"><strong>Create something</strong><span>Start with a blank canvas.</span></span>
              <span class="ws-tool-go" aria-hidden="true">→</span>
            </a>
            <a class="ws-tool" href="/account/studio">
              <span class="ws-tool-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg></span>
              <span class="ws-tool-tx"><strong>Your packs</strong><span id="tool-packs">Templates ready to edit.</span></span>
              <span class="ws-tool-go" aria-hidden="true">→</span>
            </a>
            <a class="ws-tool" href="/account/profile">
              <span class="ws-tool-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4z"/></svg></span>
              <span class="ws-tool-tx"><strong>Brand kit</strong><span id="tool-kit">Everything looking like you.</span></span>
              <span class="ws-tool-go" aria-hidden="true">→</span>
            </a>
            <a class="ws-tool" href="/account/schedule">
              <span class="ws-tool-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="16" y1="2" x2="16" y2="6"/></svg></span>
              <span class="ws-tool-tx"><strong>Content planner</strong><span>See what's coming up.</span></span>
              <span class="ws-tool-go" aria-hidden="true">→</span>
            </a>
          </div>
        </section>

        <!-- PICK UP WHERE YOU LEFT OFF — the last thing worked on at half
             width, then the prompt and the next booking beside it -->
        <section class="ws-block" aria-labelledby="pickup-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="pickup-h"><span class="ws-block-ch">Chapter 03</span>Pick up where you left off</h2>
          </header>
          <div class="ws-pickup">
            <a class="ws-resume" id="ws-resume" href={`/account/editor?template=${encodeURIComponent(recentTemplates[0].id)}`} style={`background-image:url('${recentTemplates[0].thumb}')`}>
              <span class="ws-resume-body">
                <strong class="ws-resume-h" id="ws-resume-name">{recentTemplates[0].name}</strong>
                <span class="ws-resume-cta">Continue with this pack <em aria-hidden="true">→</em></span>
              </span>
            </a>

            <div class="ws-side">
              <span class="ws-side-eyebrow">Today's prompt</span>
              <div class="ws-idea-wrap">
                <p class="ws-idea" id="idea-h">“Three questions every buyer asks during a viewing — and how you answer them.”</p>
                <p class="ws-idea-hint" id="idea-hint">Talk straight to camera. One question per line on screen.</p>
              </div>
              <div class="ws-side-foot">
                <a class="ws-btn ws-btn--primary ws-btn--sm" href="/account/editor?blank=1">Create this post
                  <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
                <button type="button" class="ws-iconround ws-tip-right ws-idea-again" data-tip="Another idea" aria-label="Another idea">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12a8 8 0 0 1 14-5l2 2M20 12a8 8 0 0 1-14 5l-2-2"/><path d="M20 4v5h-5M4 20v-5h5"/></svg>
                </button>
              </div>
            </div>

            <div class="ws-side">
              <span class="ws-side-eyebrow">Coming up</span>
              <div id="ws-next-bk">
                <p class="ws-side-h">Loading…</p>
              </div>
              <div class="ws-side-foot">
                <a class="ws-btn ws-btn--ghost ws-btn--sm" href="/account/bookings">View bookings
                  <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </a>
              </div>
            </div>
          </div>
        </section>
      </div>

      <!-- ============ Chapter 04 — full width ============ -->
      <a class="ws-discover ws-rise" style="--delay:1.65s" href="/account/guides" aria-label="Read the guide: five minutes well spent">
        <div class="ws-discover-body">
          <span class="ws-discover-flag">Chapter 04 — Learn</span>
          <h2 class="ws-discover-h">Five minutes well spent.</h2>
          <p class="ws-discover-desc">Why your listing posts aren't getting saved.</p>
          <span class="ws-discover-cta">Read the guide <span aria-hidden="true">→</span></span>
        </div>
        <div class="ws-discover-art" style="background-image:url('/assets/chapter-04.jpg')"></div>
      </a>
      <!-- ============ New in The Studio — full width ============ -->
      <section class="ws-block" aria-labelledby="new-h">
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="new-h"><span class="ws-block-ch">Chapter 05</span>New in The Studio</h2>
          <a class="ws-block-link" href="/account/guides">View All Updates
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </header>
        <div class="ws-news">
          <a class="ws-news-card" href="/edit">
            <span class="ws-news-tx">
              <span class="ws-news-flag">Template pack</span>
              <strong class="ws-news-h">The Property Pack</strong>
              <span class="ws-news-desc">Our most-used pack — listings, from teaser to sold.</span>
            </span>
            <span class="ws-news-art" style="background-image:url('/assets/cosy%20home.jpg')"></span>
          </a>
          <a class="ws-news-card" href="/account/guides">
            <span class="ws-news-tx">
              <span class="ws-news-flag">New guide</span>
              <strong class="ws-news-h">Reels that actually get watched</strong>
              <span class="ws-news-desc">Practical tips to boost reach and saves.</span>
            </span>
            <span class="ws-news-art" style="background-image:url('/assets/home%20video.jpg')"></span>
          </a>
          <!-- Month and link are set at runtime by wireNextMonth(): a card
               hard-coded to "September" is wrong for eleven months of the year. -->
          <a class="ws-news-card" id="ws-news-cal" href="/account/schedule">
            <span class="ws-news-tx">
              <span class="ws-news-flag">Seasonal content</span>
              <strong class="ws-news-h" id="ws-news-cal-h">Next month's Content Calendar</strong>
              <span class="ws-news-desc">Plan your month with done-for-you ideas.</span>
            </span>
            <span class="ws-news-art" style="background-image:url('/assets/home%20kitchen.jpg')"></span>
          </a>
          <a class="ws-news-card" href="/account/schedule">
            <span class="ws-news-tx">
              <span class="ws-news-flag">New feature</span>
              <strong class="ws-news-h">Bulk schedule your posts</strong>
              <span class="ws-news-desc">Plan, schedule and publish with ease.</span>
            </span>
            <span class="ws-news-art" style="background-image:url('/assets/social%20media.jpg')"></span>
          </a>
        </div>
      </section>
    </main>

    <NewDesignModal />

    <!-- Contextual coach — one state-driven nudge, anchored to the relevant
         element, shown after the entrance settles. Rule list in the script. -->
    <div id="ws-coach" class="ws-coach" role="status" aria-live="polite" hidden>
      <span class="ws-coach-spark" aria-hidden="true">✦</span>
      <span class="ws-coach-msg" id="ws-coach-msg"></span>
      <button type="button" class="ws-coach-x" id="ws-coach-x" aria-label="Dismiss tip">&times;</button>
    </div>
  </div>

  <style is:global>
    /* =====================================================================
       Workspace Phase 2 — editorial, asymmetric, layered. White cards float
       on a softly textured off-white page; supporting widgets recede. Borders
       give way to whitespace + depth. Colour only for meaning.
       ===================================================================== */
    body[data-dashboard] { background: #ffffff; }
    /* ---------- Navigation — clean, no chrome, not sticky ---------- */
    .ws-nav {
      position: relative;
      z-index: 60;   /* header (and its dropdowns) stack above the page content */
      display: flex; align-items: center; gap: clamp(14px, 2.4vw, 36px);
      padding: 22px clamp(22px, 2.6vw, 56px) 16px;
      background: transparent;
    }
    /* Hamburger — staggered lines, short middle line grows on hover; opens the drawer */
    .ws-burger { flex: 0 0 auto; width: 42px; height: 42px; border-radius: 12px; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; background: transparent; border: 0; cursor: pointer; transition: background 0.2s; }
    .ws-burger:hover { background: rgba(28, 29, 34, 0.06); }
    .ws-burger span { display: block; width: 19px; height: 1.8px; border-radius: 2px; background: var(--ws-ink); transition: width 0.3s var(--ws-ease); }
    .ws-burger span:nth-child(2) { width: 13px; align-self: flex-start; margin-left: 11.5px; }
    .ws-burger:hover span:nth-child(2) { width: 19px; }
    /* Off-canvas drawer (the cool slide-in) */
    .ws-drawer { position: fixed; inset: 0; z-index: 90; }
    .ws-drawer[hidden] { display: none; }
    .ws-drawer-scrim { position: absolute; inset: 0; background: rgba(20,16,22,0.42); opacity: 0; -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); transition: opacity 0.3s var(--ws-ease); }
    .ws-drawer.is-open .ws-drawer-scrim { opacity: 1; }
    .ws-drawer-panel { position: absolute; top: 0; left: 0; bottom: 0; width: min(320px, 86vw); display: flex; flex-direction: column; padding: 18px 18px 22px; background: #fff; box-shadow: 0 0 60px -10px rgba(28,29,34,0.45); transform: translateX(-100%); transition: transform 0.34s var(--ws-ease); overflow-y: auto; }
    .ws-drawer.is-open .ws-drawer-panel { transform: none; }
    .ws-drawer-top { display: flex; align-items: center; justify-content: space-between; padding: 6px 2px 14px; margin-bottom: 8px; border-bottom: 1px solid var(--ws-line); }
    .ws-logo { font-family: var(--subhead, Georgia, serif); font-size: 20px; font-weight: 600; letter-spacing: 0.05em; color: var(--ws-ink); text-decoration: none; }
    .ws-drawer-x svg { width: 18px; height: 18px; }
    .ws-drawer-nav { display: flex; flex-direction: column; gap: 1px; }
    .ws-drawer-label { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-faint); padding: 16px 10px 6px; }
    .ws-drawer-nav a { display: block; padding: 9px 12px; border-radius: 10px; font-size: var(--ws-t-row); font-weight: 500; color: var(--ws-tx); text-decoration: none; transition: background 0.16s, color 0.16s; }
    .ws-drawer-nav a:hover { background: rgba(28,29,34,0.05); color: var(--ws-ink); }
    .ws-drawer-nav a.is-active { background: color-mix(in srgb, var(--ws-accent) 10%, #fff); color: var(--ws-accent); font-weight: 600; }
    .ws-drawer-out { margin-top: auto; padding: 12px; border-radius: 11px; text-align: center; font-size: var(--ws-t-body); font-weight: 600; color: var(--ws-accent); text-decoration: none; border: 1px solid var(--ws-line); transition: background 0.18s; }
    .ws-drawer-out:hover { background: rgba(28,29,34,0.05); }
    .ws-tabs { flex: 1; display: flex; align-items: center; justify-content: center; gap: clamp(12px, 1.9vw, 36px); }
    .ws-tab {
      position: relative; display: inline-flex; align-items: center;
      padding: 6px 2px; font-size: clamp(15px, 1.1vw, 17px); font-weight: 500;
      color: var(--ws-tx); text-decoration: none; border: 0; background: transparent; cursor: pointer; font-family: inherit;
      transition: color 0.2s;
    }
    .ws-tab:hover { color: var(--ws-ink); }
    .ws-tab.is-active { color: var(--ws-ink); font-weight: 600; }
    .ws-tab.is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -7px; height: 2px; border-radius: 2px; background: var(--ws-ink); }
    .ws-caret { width: 9px; height: 6px; opacity: 0.55; transition: transform 0.25s var(--ws-ease); }
    .ws-nav-right { flex: 0 0 auto; display: flex; align-items: center; gap: 10px; }
    .ws-navic {
      position: relative; width: 42px; height: 42px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      background: transparent; border: 0; cursor: pointer; color: var(--ws-tx);
      transition: background 0.2s, color 0.2s, transform 0.2s var(--ws-ease);
    }
    .ws-navic:hover { background: rgba(28, 29, 34, 0.05); color: var(--ws-ink); }
    .ws-navic svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-dot { position: absolute; top: 9px; right: 11px; width: 7px; height: 7px; border-radius: 50%; background: var(--ws-accent); box-shadow: 0 0 0 2px #fff; }
    .ws-whobtn { display: inline-flex; align-items: center; gap: 7px; padding: 4px 8px 4px 4px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; font-family: inherit; transition: background 0.2s; }
    .ws-whobtn:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-whoav { width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; font-size: var(--ws-t-body); font-weight: 700; letter-spacing: 0.03em; color: #fff; background: linear-gradient(140deg, color-mix(in srgb, var(--ws-accent) 70%, #fff), var(--ws-accent)); background-size: cover; background-position: center; }
    /* ---------- Dropdowns ---------- */
    .ws-menu { position: relative; }
    .ws-dropdown { position: absolute; top: calc(100% + 10px); left: 0; min-width: 210px; padding: 8px; background: #fff; border: 1px solid var(--ws-line); border-radius: 14px; box-shadow: 0 24px 50px -22px rgba(28,29,34,0.28); opacity: 0; transform: translateY(-10px) scale(0.9); transform-origin: top left; pointer-events: none; transition: opacity 0.22s var(--ws-ease), transform 0.38s cubic-bezier(.34, 1.56, .4, 1); z-index: 50; }
    .ws-menu.is-open .ws-dropdown { opacity: 1; transform: none; pointer-events: auto; }
    /* Mega-menu items cascade in — the lively "bubble out" reveal */
    .ws-menu.is-open .ws-caret { transform: rotate(180deg); }
    .ws-dropdown a { display: block; padding: 10px 12px; border-radius: 9px; font-size: var(--ws-t-body); color: var(--ws-tx); text-decoration: none; transition: background 0.16s, color 0.16s; }
    .ws-dropdown a:hover { background: rgba(28, 29, 34, 0.05); color: var(--ws-ink); }
    .ws-dropdown-head { padding: 8px 12px 10px; border-bottom: 1px solid var(--ws-line); margin-bottom: 6px; display: flex; flex-direction: column; gap: 2px; }
    .ws-dropdown-head strong { font-size: var(--ws-t-row); color: var(--ws-ink); }
    .ws-dropdown-head span { font-size: var(--ws-t-meta); color: var(--ws-faint); }
    .ws-dropdown-out { color: var(--ws-accent) !important; font-weight: 600; }
    /* Right-anchored dropdowns (notifications, account) stay on-screen at the page edge */
    .ws-dropdown--right { left: auto; right: 0; transform-origin: top right; }
    /* Notifications panel */
    .ws-dropdown--notif { width: 332px; min-width: 332px; padding: 8px; }
    .ws-notif-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 10px 10px; border-bottom: 1px solid var(--ws-line); margin-bottom: 4px; }
    .ws-notif-head strong { font-size: var(--ws-t-row); color: var(--ws-ink); }
    .ws-notif-clear { font-family: inherit; font-size: var(--ws-t-meta); font-weight: 600; color: var(--ws-accent); background: none; border: 0; padding: 0; cursor: pointer; }
    .ws-notif-clear:hover { text-decoration: underline; }
    .ws-notif-list { display: flex; flex-direction: column; }
    .ws-notif-item { display: flex; align-items: flex-start; gap: 11px; padding: 10px 10px; border-radius: 10px; text-decoration: none; transition: background 0.16s; }
    .ws-notif-item:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-notif-item.is-unread { background: color-mix(in srgb, var(--ws-accent) 7%, transparent); }
    .ws-notif-item.is-unread .ws-notif-txt b::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--ws-accent); margin-right: 6px; vertical-align: middle; }
    .ws-notif-ic { flex: 0 0 auto; width: 34px; height: 34px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; }
    .ws-notif-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-notif-ic--order { color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 13%, #fff); }
    .ws-notif-ic--booking { color: #2f9e5e; background: rgba(47, 158, 94, 0.12); }
    .ws-notif-ic--blog { color: #2f7dc4; background: rgba(47, 125, 196, 0.12); }
    .ws-notif-ic--news { color: #e3a008; background: rgba(227, 160, 8, 0.15); }
    .ws-notif-txt { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
    .ws-notif-txt b { font-size: var(--ws-t-body); font-weight: 600; color: var(--ws-ink); }
    .ws-notif-txt i { font-style: normal; font-size: var(--ws-t-meta); line-height: 1.4; color: var(--ws-faint); }
    .ws-notif-time { flex: 0 0 auto; font-size: var(--ws-t-label); color: var(--ws-faint); padding-top: 1px; }
    /* When all read, the unread dot hides */
    .ws-notif.is-read .ws-dot { display: none; }
    .ws-logout svg { width: 19px; height: 19px; }
    .ws-iconround { width: 46px; height: 46px; flex: 0 0 auto; border-radius: 50%; border: 1px solid var(--ws-line); background: #fff; color: var(--ws-tx); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: color 0.2s, border-color 0.2s; }
    .ws-iconround:hover { color: var(--ws-ink); border-color: rgba(28,29,34,0.28); }
    .ws-iconround svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.35s var(--ws-ease); }
    .ws-iconround:hover svg { transform: rotate(-90deg); }
    .ws-hero { --ws-hero-img: url('/assets/table.jpg'); }
    .ws-hero-cta-btn { flex: 0 0 auto; align-self: flex-start; margin-top: var(--ws-gap); }
    /* Three stats side by side in outlined boxes - drawn, not filled, so they
       read as three objects without a block of grey pulling focus off the
       numbers inside them. */
    .ws-brief { list-style: none; margin: clamp(30px, 8vh, 76px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; width: 100%; }
    .ws-brief li { position: relative; display: flex; align-items: center; gap: 11px; padding: 13px 14px; border: 1px solid var(--ws-line); border-radius: var(--ws-r); font-size: var(--ws-t-body); line-height: 1.3; color: var(--ws-tx); opacity: 0; transform: translateY(14px); animation: wsBriefIn 0.55s var(--ws-ease) forwards; animation-delay: calc(0.5s + var(--d) * 0.1s); }
    /* Every stat is the same two lines - the value, then what it counts - so
       the row reads as one row and not three different shapes. */
    .ws-brief-tx { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .ws-brief-tx strong { color: var(--ws-ink); font-weight: 600; font-size: var(--ws-t-row); }
    .ws-brief-tx span { font-size: var(--ws-t-meta); color: var(--ws-tx); }
    /* The rotating slot is a link - it is the one tile that is usually asking
       you to go and do something about it. */
    .ws-brief-slot { display: flex; align-items: center; gap: 11px; text-decoration: none; color: inherit; }
    /* Only a slot with somewhere to go covers its box or reacts to a pointer.
       No underline on hover - the whole box lighting up says it already. */
    .ws-brief-slot[href] { cursor: pointer; }
    .ws-brief-slot[href]::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
    .ws-brief li { transition: border-color 0.2s var(--ws-ease); }
    .ws-brief li:has(.ws-brief-slot[href]:hover) { border-color: rgba(28,29,34,0.3); }
    .ws-brief-ic--due { color: #b4553f; }
    .ws-brief-ic--gallery { color: var(--ws-accent); }
    @media (max-width: 620px) { .ws-brief { grid-template-columns: 1fr; } }
    .ws-brief strong { color: var(--ws-ink); font-weight: 600; }
    .ws-brief-ic--kit { color: var(--ws-success); }
    .ws-brief-ic { flex: 0 0 auto; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; background: none; border: 0; color: var(--ws-tx); }
    .ws-brief-ic svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    /* Each brief icon its own colour, on a soft tint of that colour. */
    .ws-brief-ic--sched { color: var(--ws-accent); }
    .ws-brief-ic--eng { color: #2f9e5e; background: rgba(47,158,94,0.12); border-color: rgba(47,158,94,0.26); }
    .ws-brief-ic--time { color: #2f7dc4; }
    .ws-brief-ic--star { color: #e3a008; background: rgba(227,160,8,0.15); border-color: rgba(227,160,8,0.30); }
    .ws-brief-ic--star svg { fill: currentColor; stroke: none; }
   /* a star fills, it doesn't stroke */
    .ws-brief-ic--eng.is-down { color: #c0392b; background: rgba(192,57,43,0.10); border-color: rgba(192,57,43,0.24); }
    @media (max-width: 880px) { }
    @media (max-width: 620px) { .ws-hero { grid-template-columns: 1fr; } }
    /* Planner week — all seven days on one line, each near enough square.
       The date is the loud thing: you scan a week by number, not by label. */
    .ws-week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: var(--ws-gap); }
    @media (max-width: 900px) { .ws-week { grid-template-columns: repeat(4, 1fr); } }
    @media (max-width: 520px) { .ws-week { grid-template-columns: repeat(2, 1fr); } }
    .ws-day { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 14px; aspect-ratio: 1 / 1.25; border-radius: var(--ws-r-sm); background: #fff; border: 1px solid var(--ws-line); text-decoration: none; color: var(--ws-ink); cursor: pointer; font-family: inherit; text-align: left; transition: border-color 0.25s var(--ws-ease), transform 0.25s var(--ws-ease); }
    .ws-day:hover { transform: translateY(-3px); border-color: rgba(28, 29, 34, 0.22); }
    .ws-day-name { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-faint); display: flex; align-items: center; gap: 6px; }
    .ws-day-name i { display: none; }
   /* the darker outline says "today" on its own */
    .ws-day-num { font-family: var(--subhead); font-size: clamp(20px, 1.7vw, 27px); font-weight: 500; line-height: 1; letter-spacing: -0.02em; color: var(--ws-ink); }
    /* Square, pinned to the bottom: the extra card height goes to the picture
       staying a picture rather than stretching into a letterbox. */
    .ws-day-thumb { flex: none; width: 100%; aspect-ratio: 1 / 1; margin-top: auto; border-radius: 4px; background-size: cover; background-position: center; background-color: #e9e6e2; }
    /* Today is the same card with a darker edge - enough to find, without
       colouring it in or labelling it. */
    .ws-day.is-today { border-color: rgba(28,29,34,0.42); }
    .ws-day--empty { justify-content: flex-start; }
    .ws-day-empty-msg { margin-top: auto; font-size: var(--ws-t-meta); font-weight: 500; color: var(--ws-faint); }
    /* Recent designs reel — portrait, fan out on hover */
    /* A day carrying a starter idea. Tinted in the brand plum rather than left
       white: an untouched week was seven identical blank boxes, which is a poor
       first thing to hand somebody who has just signed up. */
    .ws-day--idea {
      background: color-mix(in srgb, var(--ws-accent) 9%, #fff);
      border-color: color-mix(in srgb, var(--ws-accent) 22%, var(--ws-line));
    }
    .ws-day--idea:hover { border-color: color-mix(in srgb, var(--ws-accent) 45%, var(--ws-line)); }
    .ws-day-flag { margin-top: 10px; font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-accent); }
    .ws-day-idea { margin-top: 3px; font-family: var(--serif); font-size: var(--ws-t-meta); font-weight: 600; line-height: 1.28; letter-spacing: -0.01em; color: var(--ws-ink); }
    .ws-day-hint { margin-top: 5px; font-size: var(--ws-t-label); line-height: 1.4; color: var(--ws-tx); }
    .ws-day-cta { margin-top: auto; font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-accent); }
    .ws-day-cta em { font-style: normal; display: inline-block; transition: transform 0.25s var(--ws-ease); }
    .ws-day--idea:hover .ws-day-cta em { transform: translateX(3px); }
    /* Your Studio — four ways in, wider than they are tall so they read as a
       row of doors rather than as more day squares. */
    /* Pick up where you left off — the last thing worked on at half width,
       then the prompt and the next booking at a quarter each. */
    .ws-pickup { display: grid; grid-template-columns: 2fr 1fr 1fr; gap: var(--ws-gap); align-items: stretch; }
    @media (max-width: 1000px) { .ws-pickup { grid-template-columns: 1fr 1fr; } .ws-resume { grid-column: 1 / -1; } }
    @media (max-width: 620px) { .ws-pickup { grid-template-columns: 1fr; } }
    .ws-resume { position: relative; display: flex; align-items: flex-end; min-height: 240px; padding: 26px; border-radius: var(--ws-r); overflow: hidden; background-size: cover; background-position: center; background-color: #2a2126; text-decoration: none; color: #fff; }
    /* A wash rather than a flat panel: the template underneath still has to be
       recognisable, which is the whole point of showing it. */
    .ws-resume::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20,16,20,0.82) 0%, rgba(20,16,20,0.36) 46%, rgba(20,16,20,0.06) 100%); }
    .ws-resume-body { position: relative; z-index: 1; display: flex; flex-direction: column; gap: 4px; }
    /* The same size as the prompt beside it — it was reading as a headline
       against a body-sized neighbour. */
    .ws-resume-h { font-family: var(--serif); font-size: clamp(15px, 1.3vw, 17px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.35; }
    .ws-resume-cta { display: inline-flex; align-items: center; gap: 8px; font-size: var(--ws-t-body); font-weight: 600; }
    .ws-resume-cta em { font-style: normal; transition: transform 0.25s var(--ws-ease); }
    .ws-resume:hover .ws-resume-cta em { transform: translateX(4px); }
    .ws-side { display: flex; flex-direction: column; gap: 12px; padding: 22px; border: 1px solid var(--ws-line); border-radius: var(--ws-r); background: #fff; }
    .ws-side-eyebrow { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-faint); }
    .ws-side-h { margin: 0; font-family: var(--serif); font-size: var(--ws-t-title); font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; color: var(--ws-ink); }
    .ws-side-meta { margin: 4px 0 0; font-size: var(--ws-t-body); color: var(--ws-tx); }
    .ws-side-foot { display: flex; align-items: center; gap: 12px; margin-top: auto; }
    /* The prompt sits in the middle of the card, not at the top: it is the
       reason the card exists, so it gets the space rather than the eyebrow. */
    .ws-idea-wrap { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 9px; padding: 6px 0; }
    .ws-idea-hint { margin: 0; font-size: var(--ws-t-meta); line-height: 1.45; color: var(--ws-faint); }
    /* Pushed to the far edge so it is a quiet second option, not a twin of the
       button it used to sit against. */
    .ws-idea-again { margin-left: auto; width: 33px; height: 33px; }
    .ws-idea-again svg { width: 15px; height: 15px; }
    .ws-idea { font-family: var(--serif); font-style: normal; font-size: clamp(15px, 1.3vw, 17px); font-weight: 600; line-height: 1.45; letter-spacing: -0.01em; color: var(--ws-ink); margin: 0; }
    /* ---------- Discovery — full-width finish ---------- */
    .ws-discover { position: relative; display: grid; grid-template-columns: 1fr 1.15fr; min-height: 268px; border-radius: var(--ws-r-lg); overflow: hidden; background: transparent; border: 1px solid var(--ws-line); text-decoration: none; transition: border-color 0.25s var(--ws-ease); }
    .ws-discover:hover { border-color: rgba(28, 29, 34, 0.22); }
    .ws-discover-art { position: relative; background-size: cover; background-position: center; transition: transform 1.2s var(--ws-ease); }
    /* The plum panel bleeds into the photograph instead of butting against it,
       and the whole image sits under a wash so the two halves are one picture.
       On the art rather than the body so the zoom on hover carries it along. */
    .ws-discover-art::after {
      content: ""; position: absolute; inset: 0; pointer-events: none;
      background:
        linear-gradient(to right, #2f1b25 0%, rgba(47,27,37,0.86) 14%, rgba(47,27,37,0.34) 38%, rgba(47,27,37,0) 62%),
        rgba(35,22,29,0.24);
    }
    .ws-discover:hover .ws-discover-art { transform: scale(1.05); }
    .ws-discover-body { position: relative; padding: clamp(28px, 3vw, 48px); padding-bottom: 32px; display: flex; flex-direction: column; justify-content: flex-start; gap: 0; color: #fff; background: #2f1b25; }
    .ws-discover-flag { align-self: flex-start; padding: 0; background: none; border: 0; color: rgba(255,255,255,0.6); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
    /* One line at this size in this column - measured, not hoped. */
    .ws-discover-h { font-family: var(--subhead); font-weight: 500; font-size: clamp(24px, 2.5vw, 36px); line-height: 1.06; letter-spacing: -0.015em; margin: clamp(16px, 2vw, 26px) 0 0; color: #fff; white-space: nowrap; }
    @media (max-width: 900px) { .ws-discover-h { white-space: normal; } }
    .ws-discover-desc { font-size: var(--ws-t-row); line-height: 1.55; color: rgba(255,255,255,0.72); margin: 7px 0 0; max-width: 34ch; }
    .ws-discover-cta { display: inline-flex; align-items: center; justify-content: center; gap: 8px; align-self: flex-start; margin-top: auto; height: 37px; box-sizing: border-box; padding: 0 20px; border-radius: var(--ws-r); background: #fff; color: var(--ws-ink); font-family: var(--serif); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
    .ws-discover-cta em { font-style: normal; display: inline-block; transition: transform 0.25s var(--ws-ease); }
    .ws-discover:hover .ws-discover-cta em { transform: translateX(4px); }
    @media (max-width: 620px) { .ws-discover { grid-template-columns: 1fr; } .ws-discover-art { min-height: 180px; } }
    /* ---------- Tooltips ---------- */
    [data-tip] { position: relative; }
    [data-tip]::after { content: attr(data-tip); position: absolute; bottom: calc(100% + 9px); left: 50%; transform: translateX(-50%) translateY(4px); width: max-content; max-width: 220px; padding: 9px 12px; border-radius: 10px; background: #1c1d22; color: #fff; font-size: var(--ws-t-meta); font-weight: 500; line-height: 1.4; letter-spacing: 0; text-transform: none; text-align: center; white-space: normal; opacity: 0; pointer-events: none; z-index: 60; box-shadow: 0 12px 28px -10px rgba(0,0,0,0.4); transition: opacity 0.22s var(--ws-ease), transform 0.22s var(--ws-ease); }
    [data-tip]:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }
    body.ws-ready .ws-rise { animation: wsRise 0.7s var(--ws-ease) both; animation-delay: var(--delay, 0s); }
    @keyframes wsNavDrop { from { opacity: 0; transform: translateY(-100%); } to { opacity: 1; transform: none; } }
    /* hero greeting + CTA (brief stats keep their own stagger between them) */
    .ws-greeting, .ws-hero-cta-btn { opacity: 0; }
    body.ws-ready .ws-greeting { animation: wsIn 0.6s var(--ws-ease) both; animation-delay: 0.12s; }
    body.ws-ready .ws-hero-cta-btn { animation: wsIn 0.55s var(--ws-ease) both; animation-delay: 1.0s; }
    body.ws-ready .ws-block-head { animation: wsIn 0.5s var(--ws-ease) both; animation-delay: 1.1s; }
    .ws-week .ws-day, .ws-tools .ws-tool { opacity: 0; }
    body.ws-ready .ws-week .ws-day, body.ws-ready .ws-tools .ws-tool { animation: wsIn 0.55s var(--ws-ease) both; }
    body.ws-ready .ws-week .ws-day:nth-child(1), body.ws-ready .ws-tools .ws-tool:nth-child(1) { animation-delay: 1.18s; }
    body.ws-ready .ws-week .ws-day:nth-child(2), body.ws-ready .ws-tools .ws-tool:nth-child(2) { animation-delay: 1.25s; }
    body.ws-ready .ws-week .ws-day:nth-child(3), body.ws-ready .ws-tools .ws-tool:nth-child(3) { animation-delay: 1.32s; }
    body.ws-ready .ws-week .ws-day:nth-child(4), body.ws-ready .ws-tools .ws-tool:nth-child(4) { animation-delay: 1.39s; }
    body.ws-ready .ws-week .ws-day:nth-child(5), body.ws-ready .ws-tools .ws-tool:nth-child(5) { animation-delay: 1.46s; }
    body.ws-ready .ws-week .ws-day:nth-child(6), body.ws-ready .ws-tools .ws-tool:nth-child(6) { animation-delay: 1.53s; }
    body.ws-ready .ws-week .ws-day:nth-child(7), body.ws-ready .ws-tools .ws-tool:nth-child(7) { animation-delay: 1.60s; }
    /* nav drops in last, bouncy (real-world spring) */
    .ws-nav { opacity: 0; }
    body.ws-ready .ws-nav { animation: wsNavDrop 0.72s cubic-bezier(.3, 1.55, .5, 1) both; animation-delay: 2.35s; }
    @media (prefers-reduced-motion: reduce) {
      .ws-rise, .ws-brief li, .ws-greeting, .ws-hero-cta-btn, .ws-block-head, .ws-week .ws-day, .ws-tools .ws-tool, .ws-nav { opacity: 1 !important; transform: none !important; animation: none !important; }
    }
    /* ===== Contextual coach bubble ===== */
    .ws-coach { position: absolute; z-index: 80; max-width: 280px; display: flex; align-items: flex-start; gap: 9px; padding: 12px 12px 12px 13px; background: #fff; border: 1px solid var(--ws-line); border-radius: 13px; box-shadow: 0 20px 44px -18px rgba(28,29,34,0.32); opacity: 0; transform: translateY(-6px) scale(0.92); transform-origin: top center; transition: opacity 0.25s var(--ws-ease), transform 0.5s cubic-bezier(.34, 1.56, .4, 1); }
    .ws-coach.is-in { opacity: 1; transform: none; }
    .ws-coach::before { content: ""; position: absolute; top: -6px; left: var(--arrow-x, 26px); width: 11px; height: 11px; background: #fff; border-left: 1px solid var(--ws-line); border-top: 1px solid var(--ws-line); transform: translateX(-50%) rotate(45deg); }
    .ws-coach-spark { flex: 0 0 auto; color: #e3a008; font-size: var(--ws-t-row); line-height: 1.5; }
    .ws-coach-msg { flex: 1; font-size: var(--ws-t-body); line-height: 1.5; color: var(--ws-ink); }
    .ws-coach-x { flex: 0 0 auto; border: 0; background: transparent; color: var(--ws-faint); font-size: var(--ws-t-title); line-height: 1; cursor: pointer; padding: 0 2px; transition: color 0.2s; }
    .ws-coach-x:hover { color: var(--ws-ink); }
    @media (prefers-reduced-motion: reduce) { .ws-coach { transition: opacity 0.2s; transform: none; } }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import { loadPrompts, keyForEvergreen, canvasForPrompt, findPromptIn } from '../../data/content-calendar.js';

    requestAnimationFrame(() => document.body.classList.add('ws-ready'));

    // Off-canvas drawer (hamburger → everything that isn't a tab)
    const drawer = document.querySelector('[data-drawer]');
    const burger = document.querySelector('[data-drawer-open]');
    let drawerTimer;
    function openDrawer() { if (!drawer) return; clearTimeout(drawerTimer); drawer.hidden = false; requestAnimationFrame(() => drawer.classList.add('is-open')); burger?.setAttribute('aria-expanded', 'true'); }
    function closeDrawer() { if (!drawer) return; drawer.classList.remove('is-open'); burger?.setAttribute('aria-expanded', 'false'); drawerTimer = setTimeout(() => { drawer.hidden = true; }, 340); }
    burger?.addEventListener('click', openDrawer);
    document.querySelectorAll('[data-drawer-close]').forEach((b) => b.addEventListener('click', closeDrawer));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer && !drawer.hidden) closeDrawer(); });

    // Dropdowns
    const menus = [...document.querySelectorAll('[data-menu]')];
    function closeAll(except) { menus.forEach((m) => { if (m !== except) { m.classList.remove('is-open'); m.querySelector('[data-menu-btn]')?.setAttribute('aria-expanded', 'false'); } }); }
    menus.forEach((m) => { const b = m.querySelector('[data-menu-btn]'); b?.addEventListener('click', (e) => { e.stopPropagation(); const open = m.classList.toggle('is-open'); b.setAttribute('aria-expanded', String(open)); closeAll(m); }); });
    document.addEventListener('click', () => closeAll(null));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(null); });

    // Notifications are wired in the module script below (initNotifications).

    // Today's prompt — "Another idea" cycles a curated pool of content ideas.
    // (A simple, free pool for now; can be swapped for AI generation via the
    // Worker later without touching this markup.)
    (async function wirePrompt() {
      // Insights > Prompts is the source; loadPrompts falls back to the code
      // file, so this works whether or not the table has been seeded.
      const PROMPTS = await loadPrompts(supabase);
      const POOL = PROMPTS.evergreen;
      const idea = document.querySelector('.ws-idea');
      const hint = document.getElementById('idea-hint');
      const btn = document.querySelector('.ws-idea-again');
      if (!idea || !hint || !btn) return;

      const paint = (pair, animate) => {
        const write = () => {
          idea.textContent = '\u201C' + pair[0] + '\u201D';
          hint.textContent = pair[1];
        };
        if (!animate) return write();
        [idea, hint].forEach((el) => {
          el.style.transition = 'opacity 0.22s cubic-bezier(.2,.8,.2,1), transform 0.22s cubic-bezier(.2,.8,.2,1)';
          el.style.opacity = '0';
          el.style.transform = 'translateY(8px)';
        });
        setTimeout(() => {
          write();
          [idea, hint].forEach((el) => { el.style.opacity = '1'; el.style.transform = 'none'; });
        }, 220);
      };

      // Daily prompt — everyone sees the same one each day, rotating through the
      // pool by day-of-year (no manual writing needed). "Another idea" shuffles.
      const _now = new Date();
      const _doy = Math.floor((_now - new Date(_now.getFullYear(), 0, 0)) / 86400000);
      if (!POOL.length) return;
      let current = POOL[_doy % POOL.length];
      paint(current, false);
      // The "Create this post" button opens the editor on this same prompt.
      const cta = document.querySelector('.ws-side .ws-btn--primary');
      const pointCta = () => {
        if (!cta) return;
        const key = keyForEvergreen(current);
        cta.setAttribute('href', `/account/editor?blank=${canvasForPrompt(findPromptIn(PROMPTS, key))}&prompt=${key}`);
      };
      pointCta();

      btn.addEventListener('click', () => {
        let next = current;
        for (let i = 0; i < 8 && next === current; i++) {
          next = POOL[Math.floor(Math.random() * POOL.length)];
        }
        current = next;
        pointCta();
        paint(next, true);
      });
    })();

    // Count-up + bars/ring on view
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function animateCount(el) {
      const target = parseFloat(el.getAttribute('data-count')) || 0;
      const dur = 1100, start = performance.now(), fmt = (n) => Math.round(n).toLocaleString('en-GB');
      function tick(now) { const p = Math.min(1, (now - start) / dur); el.textContent = fmt(target * (1 - Math.pow(1 - p, 3))); if (p < 1) requestAnimationFrame(tick); else el.textContent = fmt(target); }
      requestAnimationFrame(tick);
    }
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return; obs.unobserve(e.target); const t = e.target;
        if (reduce) t.querySelectorAll('[data-count]').forEach((n) => { n.textContent = (parseFloat(n.getAttribute('data-count')) || 0).toLocaleString('en-GB'); });
        else t.querySelectorAll('[data-count]').forEach(animateCount);
        t.querySelectorAll('[data-val]').forEach((b) => { b.style.width = (b.getAttribute('data-val') || 0) + '%'; });
        t.querySelectorAll('[data-ring]').forEach((r) => { const pct = parseFloat(r.getAttribute('data-ring')) || 0; r.style.strokeDashoffset = String(2 * Math.PI * 15.5 * (1 - pct / 100)); });
      });
    }, { threshold: 0.25 });
    document.querySelectorAll('.ws-hero, .ws-widget').forEach((el) => io.observe(el));
  </script>

  <!-- Stage A migration: wire the real signed-in identity. Falls back to the
       mock preview when signed out (the hard login-gate lands at go-live). -->
  <script>
    import { supabase, signOutEverywhere} from '../../lib/supabase.js';
    import { initNotifications } from '../../lib/notifications.js';
    import { bookingLocation } from '../../lib/videography-config.js';
    import { loadPrompts, upcomingFrom, keyForDay, keyForEvergreen, canvasForPrompt } from '../../data/content-calendar.js';

    // Notifications — real booking correspondence, unread dot + deep links.
    initNotifications();

    const titleCase = (s) => String(s || '').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
    const escapeHtml = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // Log out (top-bar icon + drawer): clear the Supabase session, then /login.
    document.querySelectorAll('[data-logout]').forEach((el) => el.addEventListener('click', async (e) => {
      e.preventDefault();
      await signOutEverywhere();
    }));

    // ---- Bookings widget (right-column carousel of active bookings) ----
    const bkFmt = (iso) => { try { return new Date(iso).toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch (_) { return ''; } };
    const bkCountdown = (iso) => { const ts = new Date(iso).getTime(); if (isNaN(ts)) return ''; const d = Math.ceil((ts - Date.now()) / 86400000); return d <= 0 ? 'Today' : d === 1 ? 'Tomorrow' : `In ${d} days`; };
    function renderBookings(items) {
      // The bookings widget is gone; its numbers live in the hero tile now.
      // Set before the guard below, which returns as soon as it finds no track.
      const bn = document.getElementById('brief-bookings');
      const bs = document.getElementById('brief-bookings-sub');
      if (bn && bs) {
        // Zero is a real answer, not a blank: "No bookings" reads as a state,
        // where "0 bookings" reads as something that failed to load.
        bn.textContent = items.length ? `${items.length} booking${items.length === 1 ? '' : 's'}` : 'No bookings';
        bs.textContent = items.length ? 'coming up' : 'in the diary';
        const bl = document.getElementById('brief-bookings-link');
        if (bl) { if (items.length) bl.setAttribute('href', '/account/bookings'); else bl.removeAttribute('href'); }
      }
      // "Coming up" in the pick-up row: the very next booking, or a plain
      // statement that there are none. Set before the old widget's guard.
      const nx = document.getElementById('ws-next-bk');
      if (nx) {
        const next = items[0];
        nx.innerHTML = next
          ? `<p class="ws-side-h">${escapeHtml(String(next.title || 'Booking'))}</p><p class="ws-side-meta">${escapeHtml(bkFmt(next.when) || '')}</p>`
          : `<p class="ws-side-h">No bookings yet</p><p class="ws-side-meta">Nothing in the diary.</p>`;
      }
      reportQuiet('bookings', items.length === 0);
      const track = document.getElementById('ws-bk-track');
      const nav = document.getElementById('ws-bk-nav');
      const dots = document.getElementById('ws-bk-dots');
      if (!track) return;
      if (!items.length) {
        track.innerHTML = `<div class="ws-bk-empty">No upcoming bookings.<br><a href="/videography">Book a shoot or call →</a></div>`;
        if (nav) nav.hidden = true;
        return;
      }
      track.innerHTML = items.map((b) => {
        const isCall = b.source === 'smm' || b.service_type === 'discovery';
        const loc = bookingLocation(b);
        return `<a class="ws-bk-card" href="/account/bookings?open=${encodeURIComponent(b.source + ':' + b.id)}">
          <span class="ws-bk-top">
            <span class="ws-bk-pill${isCall ? ' is-call' : ''}">${isCall ? 'Call booked' : 'Booked'}</span>
            <span class="ws-bk-title">${escapeHtml(b.title)}</span>
            ${loc ? `<span class="ws-bk-loc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>${escapeHtml(loc)}</span>` : ''}
          </span>
          <span class="ws-bk-bot">
            <span class="ws-bk-when">${escapeHtml(bkFmt(b.when))}</span>
            <span class="ws-bk-count">${escapeHtml(bkCountdown(b.when))}</span>
          </span>
        </a>`;
      }).join('');
      if (items.length > 1 && nav && dots) {
        nav.hidden = false;
        dots.innerHTML = items.map((_, i) => `<button type="button" class="ws-bk-dot${i === 0 ? ' is-active' : ''}" data-bk-dot="${i}" aria-label="Booking ${i + 1}"></button>`).join('');
        const dotEls = [...dots.querySelectorAll('[data-bk-dot]')];
        const cardW = () => track.firstElementChild ? track.firstElementChild.getBoundingClientRect().width + 10 : track.clientWidth;
        const current = () => Math.round(track.scrollLeft / cardW());
        const go = (i) => track.scrollTo({ left: Math.max(0, Math.min(items.length - 1, i)) * cardW(), behavior: 'smooth' });
        document.querySelector('[data-bk-prev]')?.addEventListener('click', () => go(current() - 1));
        document.querySelector('[data-bk-next]')?.addEventListener('click', () => go(current() + 1));
        dotEls.forEach((d, i) => d.addEventListener('click', () => go(i)));
        track.addEventListener('scroll', () => { const i = current(); dotEls.forEach((d, j) => d.classList.toggle('is-active', j === i)); }, { passive: true });
      } else if (nav) {
        nav.hidden = true;
      }
    }
    // ---- Starter ideas, for a week with nothing in it ----
    // Three reporters have to agree the week is quiet before this shows:
    // nothing planned, nothing booked, nothing owed. Anything that fails to
    // report leaves the row hidden, which is the right way round - showing
    // "nothing planned" to someone with a full diary is the worse mistake.
    const quiet = {};
    function reportQuiet(key, isQuiet) {
      quiet[key] = isQuiet;
      const box = document.getElementById('ws-starters');
      if (!box) return;
      const keys = ['posts', 'bookings', 'due'];
      if (!keys.every((k) => k in quiet)) return;
      if (!keys.every((k) => quiet[k])) return;
      fillStarterDays(box);
    }

    // Monday-based week number, used only to rotate the third card - so a
    // member does not see the same suggestion every week they are quiet.
    function weekIndex(d) {
      const t = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      t.setDate(t.getDate() - ((t.getDay() + 6) % 7));
      return Math.floor((t - new Date(t.getFullYear(), 0, 1)) / 604800000);
    }
    const ymdOf = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    // Starter ideas are written INTO the empty day cards, not in a row beneath
    // them. A week nobody has touched is otherwise seven identical white boxes,
    // which is the worst thing a new member can open.
    async function fillStarterDays(box) {
      const PROMPTS = await loadPrompts(supabase);
      const all = [...document.querySelectorAll('.ws-week .ws-day')];
      if (!all.length) return;
      // From today onwards: there is no use suggesting Monday's post on
      // Thursday. Falls back to the whole week if today is not in it.
      const todayAt = all.findIndex((d) => d.classList.contains('is-today'));
      const from = todayAt < 0 ? 0 : todayAt;
      const targets = all.slice(from).filter((d) => d.classList.contains('ws-day--empty')).slice(0, 3);
      if (!targets.length) return;

      const wk = weekIndex(new Date());
      const dated = upcomingFrom(PROMPTS.days, new Date(), 8);

      // Occasions first, wherever they fall. A dated hook is the best thing we
      // have to offer and must not be displaced by a card that happens to sit
      // last - which is exactly what used to happen to World Photography Day.
      const spare = [];
      targets.forEach((card) => {
        const occasion = dated.find((d) => ymdOf(d.when) === card.getAttribute('data-date'));
        if (occasion) {
          paintStarter(card, { flag: occasion.name, title: occasion.angle, hint: occasion.brief || occasion.hint,
            cta: occasion.video ? 'Design the cover' : 'Design this post',
            href: `/account/editor?blank=${canvasForPrompt(occasion)}&prompt=${keyForDay(occasion)}` });
        } else {
          spare.push(card);
        }
      });

      // Of what is left, the last points somewhere useful rather than at a
      // post, and rotates weekly so a quiet fortnight does not repeat itself.
      spare.forEach((card, i) => {
        if (i === spare.length - 1 && (spare.length > 1 || targets.length === 1)) {
          const blog = box && box.getAttribute('data-blog-title');
          const blogHref = (box && box.getAttribute('data-blog-href')) || '/account/blog';
          const rot = wk % 3;
          paintStarter(card, rot === 0
            ? { flag: 'The Edit', title: 'Browse the template shop', hint: 'Packs built for estate agents.', cta: 'View templates', href: '/edit' }
            : (rot === 1 && blog)
              ? { flag: 'From the blog', title: blog, hint: 'A few minutes, something you can use.', cta: 'Read it', href: blogHref }
              : { flag: 'Learn', title: 'Get more out of the hub', hint: 'Short guides on content and reach.', cta: 'Start a guide', href: '/account/guides' });
          return;
        }
        const pool = PROMPTS.evergreen;
        if (!pool.length) return;
        const pr = pool[(wk + i) % pool.length];
        paintStarter(card, { flag: 'Nothing planned', title: pr[0], hint: pr[1],
          cta: pr[2] ? 'Design the cover' : 'Design this post',
          href: `/account/editor?blank=${pr[2] ? '1080x1920' : '1'}&prompt=${keyForEvergreen(pr)}` });
      });
    }

    function paintStarter(card, pick) {
      const head = (card.querySelector('.ws-day-name')?.outerHTML || '') + (card.querySelector('.ws-day-num')?.outerHTML || '');
      card.classList.add('ws-day--idea');
      card.classList.remove('ws-day--empty');
      card.setAttribute('href', pick.href);
      card.innerHTML = `${head}
        <span class="ws-day-flag">${escapeHtml(pick.flag)}</span>
        <span class="ws-day-idea">${escapeHtml(pick.title)}</span>
        <span class="ws-day-hint">${escapeHtml(pick.hint)}</span>
        <span class="ws-day-cta">${escapeHtml(pick.cta)} <em aria-hidden="true">&rarr;</em></span>`;
    }

    // ---- The third hero slot ----
    // Two of the three stats are fixed (posts, bookings); this one is claimed by
    // whatever most needs attention. Everything that can claim it reports in
    // when its own data lands, and the lowest rank on the board wins - so it
    // does not matter which query finishes first.
    const SLOT_ICONS = {
      due:     '<path d="M12 2 2 20h20z"/><line x1="12" y1="9" x2="12" y2="14"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
      gallery: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>',
      kit:     '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.2 2.4 2.4 4.6-4.9"/>',
      empty:   '<rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="12" y1="13" x2="12" y2="17"/><line x1="10" y1="15" x2="14" y2="15"/>',
    };
    const slotClaims = [];
    function claimSlot(rank, icon, value, label, href) {
      slotClaims.push({ rank, icon, value, label, href });
      slotClaims.sort((a, b) => a.rank - b.rank);
      const win = slotClaims[0];
      const v = document.getElementById('brief-slot-v');
      const l = document.getElementById('brief-slot-l');
      const ic = document.getElementById('brief-slot-ic');
      const a = document.getElementById('brief-slot');
      if (!v || !l || !ic || !a) return;
      v.textContent = win.value;
      l.textContent = win.label;
      a.setAttribute('href', win.href);
      ic.className = 'ws-brief-ic ws-brief-ic--' + win.icon;
      ic.innerHTML = `<svg viewBox="0 0 24 24">${SLOT_ICONS[win.icon] || ''}</svg>`;
    }

    // Payment owed and a gallery waiting both come off the bookings we already
    // fetch. Rank 1 and 2: an unpaid shoot is the only thing here that actively
    // blocks the member - their content stays locked until it is settled.
    function claimFromBookings(vid) {
      const unpaid = vid.filter((b) => !b.paid_at && b.stage && b.stage !== 'booked');
      reportQuiet('due', unpaid.length === 0);
      if (unpaid.length) {
        claimSlot(1, 'due', `${unpaid.length} payment${unpaid.length === 1 ? '' : 's'}`, 'due on your shoots', '/account/bookings');
      }
      const live = vid.filter((b) => b.gallery_url && b.gallery_sent_at);
      if (live.length) {
        const exp = live.map((b) => b.gallery_expires_on).filter(Boolean).sort()[0];
        const days = exp ? Math.ceil((new Date(exp).getTime() - Date.now()) / 86400000) : null;
        claimSlot(2, 'gallery', live.length === 1 ? 'Gallery ready' : `${live.length} galleries`,
          days && days > 0 ? `${days} days to download` : 'ready to download', '/account/bookings');
      }
    }

    // The seasonal-content card names next month and opens the planner there.
    (function wireNextMonth() {
      const card = document.getElementById('ws-news-cal');
      const head = document.getElementById('ws-news-cal-h');
      if (!card || !head) return;
      const now = new Date();
      const next = new Date(now.getFullYear(), now.getMonth() + 1, 1);
      head.textContent = next.toLocaleDateString('en-GB', { month: 'long' }) + ' Content Calendar';
      card.setAttribute('href', `/account/schedule?focus=${next.getFullYear()}-${String(next.getMonth() + 1).padStart(2, '0')}`);
    })();

    // The date above the name. Set on load and not touched again - nobody has
    // this page open across midnight often enough to justify a timer.
    (function wireHeroDate() {
      const el = document.getElementById('ws-hero-date');
      if (!el) return;
      el.textContent = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
    })();

    async function initBookingsWidget(session) {
      let items = [];
      const now = Date.now();
      if (session) {
        const email = session.user.email ?? '';
        try {
          const [v, s] = await Promise.all([
            supabase.from('videography_bookings').select('id, service, service_type, shoot_date, stage, postcode, paid_at, gallery_url, gallery_sent_at, gallery_expires_on').or(`account_user_id.eq.${session.user.id},client_email.eq.${email}`),
            supabase.from('smm_leads').select('id, call_at, stage').eq('kind', 'discovery').or(`account_user_id.eq.${session.user.id},email.eq.${email}`),
          ]);
          const vid = (v.data || []).map((r) => ({ source: 'videography', id: r.id, title: r.service || 'Videography booking', service_type: r.service_type, when: r.shoot_date, stage: r.stage, postcode: r.postcode, paid_at: r.paid_at, gallery_url: r.gallery_url, gallery_sent_at: r.gallery_sent_at, gallery_expires_on: r.gallery_expires_on }));
          claimFromBookings(vid);
          const smm = (s.data || []).map((r) => ({ source: 'smm', id: r.id, title: 'Social media discovery call', service_type: 'discovery', when: r.call_at, stage: r.stage || 'discovery_call_booked' }));
          items = vid.concat(smm);
        } catch (_) {}
      } else {
        items = [
          { source: 'videography', id: 'demo-1', title: 'Property shoot', service_type: 'property', when: new Date(now + 6 * 86400000).toISOString(), stage: 'booked', postcode: 'NN1 1AA' },
          { source: 'videography', id: 'demo-3', title: 'Content Studio session', service_type: 'content', when: new Date(now + 9 * 86400000).toISOString(), stage: 'booked' },
          { source: 'smm', id: 'demo-2', title: 'Social media discovery call', service_type: 'discovery', when: new Date(now + 2 * 86400000).toISOString(), stage: 'discovery_call_booked' },
        ];
      }
      items = items
        .filter((b) => b.stage !== 'cancelled' && b.when && new Date(b.when).getTime() > now)
        .sort((a, b) => new Date(a.when) - new Date(b.when));
      renderBookings(items);
    }

    (async () => {
      try {
        const isDemo = import.meta.env.DEV;
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          // Live workspace — require sign-in. (Dev ?demo=1 still previews the mock.)
          if (!isDemo) { location.replace('/login?next=' + encodeURIComponent('/account')); return; }
          initBookingsWidget(null);
          return;
        }
        // getSession() is local-only - a cleared/revoked session can still
        // look valid to it. Confirm with the server before letting anyone in.
        if (!isDemo) {
          const { data: { user }, error } = await supabase.auth.getUser();
          if (!user || error) { location.replace('/login?next=' + encodeURIComponent('/account')); return; }
        }
        initBookingsWidget(session);

        const email = session.user.email ?? '';
        const meta = session.user.user_metadata ?? {};
        const fullName = titleCase(meta.name || email.split('@')[0].replace(/[._]/g, ' '));
        const firstName = fullName.split(' ')[0];
        const initials = fullName.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase() || 'T';

        const hour = new Date().getHours();
        // Sentence case: the name is the capital that matters on this line.
        let greeting = 'Welcome back';
        if (hour >= 5 && hour < 12) greeting = 'Good morning';
        else if (hour >= 12 && hour < 17) greeting = 'Good afternoon';
        else if (hour >= 17 && hour < 22) greeting = 'Good evening';
        else greeting = 'Burning the midnight oil';

        const gLine = document.querySelector('.ws-greet-line');
        const gName = document.querySelector('.ws-greet-name');
        if (gLine) gLine.textContent = greeting + ',';
        if (gName) gName.textContent = firstName + '.';

        document.querySelectorAll('.ws-whoav').forEach((e) => { e.textContent = initials; });
        const setText = (sel, val) => { const el = document.querySelector(sel); if (el && val) el.textContent = val; };
        setText('.ws-whotext strong', fullName);
        setText('.ws-whotext span', email);
        setText('.ws-dropdown-head strong', fullName);
        setText('.ws-dropdown-head span', email);

        // Headshot from the brand kit, if they've set one.
        try {
          const bk = JSON.parse(localStorage.getItem('tmke.brand') || 'null');
          if (bk && typeof bk.headshot === 'string' && bk.headshot) {
            document.querySelectorAll('.ws-whoav').forEach((e) => {
              e.textContent = '';
              e.style.backgroundImage = 'url(' + JSON.stringify(bk.headshot) + ')';
              e.style.backgroundSize = 'cover';
              e.style.backgroundPosition = 'center';
            });
          }
        } catch (_) {}
      } catch (_) { /* keep the mock preview on any error */ }
    })();

    // ---- Stage A.2: real recent designs (local editor drafts) ----
    function readLocalDrafts() {
      const drafts = [];
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (!key || !key.startsWith('tmke.editor.')) continue;
          const id = key.replace('tmke.editor.', '');
          try {
            const v = JSON.parse(localStorage.getItem(key) || 'null');
            if (!v) continue;
            drafts.push({ id, filename: v.filename || id, savedAt: v.savedAt || 0, thumb: v.thumb || null });
          } catch (_) {}
        }
      } catch (_) {}
      drafts.sort((a, b) => b.savedAt - a.savedAt);
      return drafts;
    }
    const fmtSaved = (ts) => ts ? new Date(ts).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Saved locally';
    const editHref = (id) => '/account/editor?design=' + encodeURIComponent(id);

    // Recent designs = the member's saved copies (user_designs), newest first —
    // the SAME source as the Studio's "Your designs", so the two line up.
    (async function wireWork() {
      let designs = [];
      try {
        const { data } = await supabase
          .from('user_designs')
          .select('id, name, thumb_url, updated_at')
          .order('updated_at', { ascending: false })
          .limit(4);
        designs = data || [];
      } catch (_) {}
      if (!designs.length) return; // no saved work yet → keep the starter templates

      // Hero preview = the most recently edited design.
      const top = designs[0];
      const name = top.name || 'Untitled design';
      const heroImg = document.querySelector('.ws-hero-preview img');
      const heroTitle = document.querySelector('.ws-hero-preview-foot h3');
      const heroLink = document.querySelector('.ws-hero-preview');
      const heroProg = document.querySelector('.ws-hero-progress');
      const heroCta = document.querySelector('.ws-hero-cta-btn');
      if (top.thumb_url && heroImg) { heroImg.src = top.thumb_url; heroImg.alt = name; }
      if (heroTitle) heroTitle.textContent = name;
      if (heroLink) heroLink.setAttribute('href', editHref(top.id));
      if (heroProg) heroProg.innerHTML = `<span class="ws-hero-pct">Last edited ${escapeHtml(fmtSaved(top.updated_at))}</span>`;

      // "Pick up where you left off" = the most recently edited design. The
      // starter template rendered at build time stays put until there is real
      // saved work to show, so the card is never empty.
      const resume = document.getElementById('ws-resume');
      if (resume) {
        resume.setAttribute('href', editHref(top.id));
        if (top.thumb_url) resume.style.backgroundImage = `url('${top.thumb_url}')`;
        const rn = document.getElementById('ws-resume-name');
        if (rn) rn.textContent = name;
      }
    })();

    // ---- Stage A.5: real Brand Health (from the saved brand kit) ----
    (function wireBrandHealth() {
      let brand;
      try { brand = JSON.parse(localStorage.getItem('tmke.brand') || 'null'); } catch (_) { brand = null; }
      // Nothing saved at all is the strongest case for showing the tile, not a
      // reason to stay quiet - so claim first, then bail out of the widget work.
      if (!brand) { claimSlot(3, 'kit', 'Brand kit', 'not set up yet', '/account/profile'); return; }

      const hasLogo = (brand.logos || []).length > 0;
      const hasColours = (brand.colors || []).filter((c) => c && c.hex).length > 0;
      const hasFonts = !!(brand.fonts && (brand.fonts.heading || brand.fonts.body));
      // The brand-health widget is gone; the hero slot carries its state, but
      // only while there is something to finish. Once it is done it drops to
      // the fallback rank, where it shows only if nothing else is asking.
      const kitDone = [hasLogo, hasColours, hasFonts].filter(Boolean).length;
      if (kitDone < 3) claimSlot(3, 'kit', 'Brand kit', `${kitDone} of 3 done`, '/account/profile');
      else claimSlot(9, 'kit', 'Brand kit', 'complete', '/account/profile');
      const items = [...document.querySelectorAll('.ws-journey li')];
      if (items.length < 3) return;
      items[0].classList.toggle('is-done', hasLogo);
      items[1].classList.toggle('is-done', hasColours);
      items[2].classList.toggle('is-done', hasFonts);
      // Social connections aren't wired to a live source yet → show as to-do.
      items.slice(3).forEach((li) => li.classList.remove('is-done'));

      const done = items.filter((li) => li.classList.contains('is-done')).length;
      const pct = Math.round((done / items.length) * 100);
      // Hand the real % to the same observer that animates the ring + number.
      const ring = document.querySelector('.ws-ring-fg');
      if (ring) ring.setAttribute('data-ring', String(pct));
      const num = document.querySelector('.ws-ring b');
      if (num) num.setAttribute('data-count', String(pct));
    })();

    // ---- Stage A.4: real planner (this week from calendar_items) ----
    (async function wirePlanner() {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return; // signed out → keep the mock week

        const ymd = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        const now = new Date();
        const monday = new Date(now);
        monday.setDate(now.getDate() - ((now.getDay() + 6) % 7)); // back to Monday
        monday.setHours(0, 0, 0, 0);
        const weekEnd = new Date(monday); weekEnd.setDate(monday.getDate() + 7); // Mon..Sun

        const { data, error } = await supabase
          .from('calendar_items')
          .select('*')
          .eq('user_id', session.user.id)
          .gte('scheduled_date', ymd(monday))
          .lt('scheduled_date', ymd(weekEnd))
          .in('status', ['scheduled', 'reminder_sent', 'done'])
          .order('scheduled_date', { ascending: true });
        if (error) return;

        const byDate = {};
        (data || []).forEach((it) => { if (it.scheduled_date && !byDate[it.scheduled_date]) byDate[it.scheduled_date] = it; });

        const week = document.querySelector('.ws-week');
        if (!week) return;
        const todayYmd = ymd(new Date());
        const names = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
        week.innerHTML = names.map((nm, i) => {
          const d = new Date(monday); d.setDate(monday.getDate() + i);
          const dYmd = ymd(d);
          const isToday = dYmd === todayYmd ? ' is-today' : '';
          const nameHtml = `<span class="ws-day-name">${nm}${dYmd === todayYmd ? ' <i>Today</i>' : ''}</span><span class="ws-day-num">${d.getDate()}</span>`;
          const href = `/account/schedule?focus=${dYmd}`;
          const dateAttr = ` data-date="${dYmd}"`;
          const it = byDate[dYmd];
          if (it) {
            const thumb = it.thumbnail_url || it.asset_url || '';
            // The card shows the date and the picture; what the post actually
            // is lives in the tooltip, because seven of these across one line
            // has no room for a title without shrinking the date.
            const label = it.title || it.caption || it.content_type || it.name || 'Scheduled';
            return `<a class="ws-day${isToday}" href="${href}"${dateAttr} title="${escapeHtml(String(label))}">${nameHtml}<span class="ws-day-thumb"${thumb ? ` style="background-image:url('${escapeHtml(thumb)}')"` : ''}></span></a>`;
          }
          return `<a class="ws-day ws-day--empty${isToday}" href="${href}"${dateAttr}>${nameHtml}<span class="ws-day-empty-msg">No post planned</span></a>`;
        }).join('');

        // Hero brief: live count of posts scheduled this week.
        const schedCount = (data || []).length;
        const sb = document.getElementById('brief-sched');
        if (sb) sb.textContent = schedCount ? `${schedCount} post${schedCount === 1 ? '' : 's'}` : 'No posts';
        reportQuiet('posts', schedCount === 0);

        // Days still to come this week with nothing on them. Counted forward
        // from today, because a gap on Monday is not something anyone can act
        // on by Thursday.
        let empty = 0;
        for (let i = 0; i < 7; i++) {
          const d = new Date(monday); d.setDate(monday.getDate() + i);
          const k = ymd(d);
          if (k >= todayYmd && !byDate[k]) empty++;
        }
        if (empty) claimSlot(4, 'empty', `${empty} empty day${empty === 1 ? '' : 's'}`, 'left this week', '/account/schedule');
      } catch (_) { /* keep the mock week */ }
    })();

    // The full-width card is a guide (Chapter 04), not a pack, so nothing
    // fetches into it any more - the old wireDiscovery would have replaced its
    // title, art and link with whatever pack sorted first.

  </script>


  <script>
    // ===== Contextual coach =====
    // Picks the single most relevant, not-yet-dismissed tip from a prioritised
    // rule list, anchors it to the related element, and shows it once the
    // entrance settles. State is read locally (drafts / brand kit) so it works
    // signed-out in the preview; remembers dismissals in localStorage. The rule
    // shape (id / when / target / text) is ready for Claude to fill `text` later.
    (function coach() {
      const coach = document.getElementById('ws-coach');
      const msgEl = document.getElementById('ws-coach-msg');
      const xBtn = document.getElementById('ws-coach-x');
      if (!coach || !msgEl) return;

      const SEEN_KEY = 'tmke.coach.seen';
      let seen = [];
      try { seen = JSON.parse(localStorage.getItem(SEEN_KEY) || '[]'); } catch (_) {}

      const hasDraft = (() => {
        try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k && k.startsWith('tmke.editor.')) return true; } } catch (_) {}
        return false;
      })();
      const brand = (() => { try { return JSON.parse(localStorage.getItem('tmke.brand') || 'null'); } catch (_) { return null; } })();
      const brandDone = !!(brand && (brand.logos || []).length && (brand.colors || []).some((c) => c && c.hex) && brand.fonts && (brand.fonts.heading || brand.fonts.body));

      const RULES = [
        { id: 'brand-health', when: () => !brandDone, target: '.ws-textlink--accent', text: 'Finishing your Brand Kit means every design comes out on-brand automatically — worth a couple of minutes.' },
        { id: 'continue-draft', when: () => hasDraft, target: '.ws-resume', text: 'Pick up where you left off — your most recent design is right here.' },
        { id: 'first-studio', when: () => !hasDraft, target: '.ws-tab[href="/account/studio"]', text: 'New here? Hop into Studio to make your first design — it only takes a minute.' },
        { id: 'prompt-hint', when: () => true, target: '.ws-iconround', text: "Not feeling today's prompt? Tap here for another idea." },
        { id: 'schedule', when: () => true, target: '#plan-h', text: "Nothing planned yet this week — a midweek post tends to land well." },
      ];

      const pick = RULES.find((r) => !seen.includes(r.id) && r.when() && document.querySelector(r.target));
      if (!pick) return;
      const target = document.querySelector(pick.target);
      msgEl.textContent = pick.text;

      function place() {
        coach.hidden = false;
        const r = target.getBoundingClientRect();
        const cx = r.left + r.width / 2 + window.scrollX;
        coach.style.top = (r.bottom + window.scrollY + 12) + 'px';
        coach.style.left = '0px';
        const cw = coach.offsetWidth;
        const maxLeft = document.documentElement.clientWidth - cw - 16;
        const left = Math.max(16, Math.min(cx - cw / 2, maxLeft));
        coach.style.left = left + 'px';
        coach.style.setProperty('--arrow-x', Math.max(16, Math.min(cx - left, cw - 16)) + 'px');
      }
      function dismiss() {
        coach.classList.remove('is-in');
        setTimeout(() => { coach.hidden = true; }, 320);
        if (!seen.includes(pick.id)) { seen.push(pick.id); try { localStorage.setItem(SEEN_KEY, JSON.stringify(seen)); } catch (_) {} }
      }
      xBtn?.addEventListener('click', dismiss);
      window.addEventListener('resize', () => { if (!coach.hidden) place(); });

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      setTimeout(() => { place(); requestAnimationFrame(() => coach.classList.add('is-in')); }, reduce ? 400 : 3300);
    })();
  </script>
</BaseLayout>
