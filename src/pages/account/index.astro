            </div>
          </div>
        </div>
      </section>

      <HubFootBar />
    </main>

    <NewDesignModal />
    <StudioInspo />

    <!-- Contextual coach — one state-driven nudge, anchored to the relevant
         element, shown after the entrance settles. Rule list in the script. -->
    <div id="ws-coach" class="ws-coach" role="status" aria-live="polite" hidden>
      <span class="ws-coach-spark" aria-hidden="true">✦</span>
      <span class="ws-coach-msg" id="ws-coach-msg"></span>
      <button type="button" class="ws-coach-x" id="ws-coach-x" aria-label="Dismiss tip">&times;</button>
    </div>
  </div>

  <style is:global>
    /* =====================================================================
       Workspace Phase 2 — editorial, asymmetric, layered. White cards float
       on a softly textured off-white page; supporting widgets recede. Borders
       give way to whitespace + depth. Colour only for meaning.
       ===================================================================== */
    body[data-dashboard] { background: #ffffff; }
    /* Twice the space between one chapter and the next heading, so the page
       feels less dense (Dani, 16 Oct): the gaps in ws-system.css, doubled. */
    /* One value for both, so every chapter sits the same distance from the
       next: the main column's gap went by width and ran larger on a wide
       screen than the Studio-to-week gaps above it (Dani, 16 Oct). */
    body[data-dashboard] { --ws-chapter-gap: clamp(28px, min(6.8vh, 4.2vw), 92px); }
    body[data-dashboard] .ws-main { gap: var(--ws-chapter-gap); }
    body[data-dashboard] .ws-left { gap: var(--ws-chapter-gap); }
    /* Below the foot bar, only a little page: the bar is the end. */
    body[data-dashboard] .ws-main { padding-bottom: clamp(22px, 2.6vw, 40px); }
    /* The bar to the date as much as Continue creating to Chapter 01 (Dani). */
    body[data-dashboard] .ws-main { padding-top: calc(clamp(28px, min(6.8vh, 4.2vw), 92px) + 10px); }
    body[data-dashboard] .ws-left > .ws-hero > .ws-hero-copy { padding-top: 0; padding-bottom: 0; }
    /* ---------- Navigation — clean, no chrome, not sticky ---------- */
    .ws-nav {
      position: relative;
      z-index: 60;   /* header (and its dropdowns) stack above the page content */
      display: flex; align-items: center; gap: clamp(14px, 2.4vw, 36px);
      padding: 22px clamp(22px, 2.6vw, 56px) 10px;   /* a shallower bar (Dani, 14 Oct) */
      background: transparent;
    }
    /* Hamburger — staggered lines, short middle line grows on hover; opens the drawer */
    .ws-burger { flex: 0 0 auto; width: 42px; height: 42px; border-radius: 12px; display: inline-flex; flex-direction: column; align-items: center; justify-content: center; gap: 4px; background: transparent; border: 0; cursor: pointer; transition: background 0.2s; }
    .ws-burger:hover { background: rgba(28, 29, 34, 0.06); }
    .ws-burger span { display: block; width: 19px; height: 1.8px; border-radius: 2px; background: var(--ws-ink); transition: width 0.3s var(--ws-ease); }
    .ws-burger span:nth-child(2) { width: 13px; align-self: flex-start; margin-left: 11.5px; }
    .ws-burger:hover span:nth-child(2) { width: 19px; }
    /* Off-canvas drawer (the cool slide-in) */
    .ws-drawer { position: fixed; inset: 0; z-index: 90; }
    .ws-drawer[hidden] { display: none; }
    .ws-drawer-scrim { position: absolute; inset: 0; background: rgba(20,16,22,0.42); opacity: 0; -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px); transition: opacity 0.3s var(--ws-ease); }
    .ws-drawer.is-open .ws-drawer-scrim { opacity: 1; }
    .ws-drawer-panel { position: absolute; top: 0; left: 0; bottom: 0; width: min(405px, 90vw); display: flex; flex-direction: column; padding: 18px 18px 22px; background: #f4f2f1;   /* the paper grey, wider (Dani, 17 Oct) */ box-shadow: 0 0 60px -10px rgba(28,29,34,0.45); transform: translateX(-100%); transition: transform 0.34s var(--ws-ease); overflow-y: auto; }
    .ws-drawer.is-open .ws-drawer-panel { transform: none; }
    .ws-drawer-top { display: flex; align-items: center; justify-content: space-between; padding: 6px 2px 14px; margin-bottom: 8px; border-bottom: 1px solid var(--ws-line); }
    .ws-logo { font-family: var(--subhead, Georgia, serif); font-size: 20px; font-weight: 400; letter-spacing: 0.05em; color: var(--ws-ink); text-decoration: none; }
    .ws-drawer-x svg { width: 18px; height: 18px; }
    /* The menu (Dani, 17 Oct): each section's name a small wine bar like the
    chapter heads, so it can be found at a glance; the links closer together;
    the page you're on marked in wine. */
    /* The menu's top: the bell beside the close (Dani, 17 Oct). */
    .ws-drawer-acts { display: flex; align-items: center; gap: 2px; }
    .ws-drawer-bell svg { width: 19px; height: 19px; }
    .ws-drawer-bell.is-on { background: rgba(55,30,40,0.08); color: #371e28; }
    .ws-drawer-nav[hidden], .ws-drawer-notifs[hidden] { display: none; }
    .ws-drawer-notifs { display: flex; flex-direction: column; gap: 4px; }
    /* The two picture cards: a picture, its words on a wine band. */
    /* The picture only; its words come up over it on hover (Dani, 17 Oct). */
.ws-drawer-nav a.ws-drawer-card { position: relative; display: block; margin: 6px 0 4px; padding: 0; border-radius: 4px; overflow: hidden; background: #371e28; color: #fff; font-weight: 400; text-decoration: none; transition: transform 0.25s, box-shadow 0.25s; }
    .ws-drawer-nav a.ws-drawer-card[hidden] { display: none; }
    .ws-drawer-nav a.ws-drawer-card:hover { background: #371e28; color: #fff; transform: translateY(-2px); box-shadow: 0 14px 26px -18px rgba(55,30,40,0.6); }
    .ws-drawer-card-pic { display: block; height: 77px; background: #e6e1de center / cover no-repeat; }   /* a strip, so the menu fits on one screen */
    .ws-drawer-card-tx { position: absolute; left: 0; right: 0; bottom: 0; display: flex; flex-direction: column; gap: 2px; padding: 9px 12px 10px; background: #371e28; opacity: 0; transform: translateY(100%); transition: opacity 0.3s, transform 0.35s cubic-bezier(.2,.8,.2,1); }
.ws-drawer-nav a.ws-drawer-card:hover .ws-drawer-card-tx, .ws-drawer-nav a.ws-drawer-card:focus-visible .ws-drawer-card-tx { opacity: 1; transform: none; }
    .ws-drawer-card-tx em { font-style: normal; font-size: 9.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.65); }
    .ws-drawer-card-tx strong { font-size: 13.5px; font-weight: 600; line-height: 1.25; }
    /* The two cards (Dani, 17 Oct): words on the brand's #c9bcb7, in the wine,
       no picture. Links 20% further apart; twice the room under each heading. */
    .ws-drawer-nav a.ws-drawer-card, .ws-drawer-nav a.ws-drawer-card:hover { background: #c9bcb7; color: #371e28; }
    .ws-drawer-card-pic { display: none; }
    .ws-drawer-card-tx { position: static; opacity: 1; transform: none; background: transparent; padding: 12px 14px 13px; }
    .ws-drawer-card-tx em { color: rgba(55,30,40,0.62); }
    .ws-drawer-card-tx strong { color: #371e28; }
    /* Sign out: the section bars' size, as a button (Dani, 17 Oct). */
    .ws-drawer-nav { margin-bottom: 44px; }   /* room above Sign out, doubled (Dani, 17 Oct) */
.ws-drawer-out { display: block; margin-top: auto; padding: 6px 12px; border: 1px solid #371e28; border-radius: 4px; background: transparent; color: #371e28; text-align: center; text-decoration: none; font-family: var(--serif); font-size: 10px; font-weight: 700; line-height: 15px; letter-spacing: 0.18em; text-transform: uppercase; transition: background 0.18s, color 0.18s; }
    .ws-drawer-out:hover { background: #371e28; color: #fff; }
    .ws-drawer-nav { display: flex; flex-direction: column; gap: 1px; }   /* a quarter closer (Dani, 17 Oct) */
    .ws-drawer-label { display: block; margin: 12px 0 8px; padding: 6px 12px; border-radius: 4px; background: #371e28; color: #fff; font-family: var(--serif); font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
    .ws-drawer-label:first-child { margin-top: 2px; }
    .ws-drawer-nav a { display: block; padding: 5px 12px; line-height: 1.35; border-radius: 4px; font-size: 14px; font-weight: 500; color: var(--ws-ink, #1c1d22); text-decoration: none; transition: background 0.16s, color 0.16s; }
    .ws-drawer-nav a:hover { background: rgba(55,30,40,0.07); color: #371e28; }
    .ws-drawer-nav a.is-active { background: rgba(55,30,40,0.08); color: #371e28; font-weight: 600; box-shadow: inset 3px 0 0 #371e28; }
    .ws-tabs { flex: 1; display: flex; align-items: center; justify-content: center; gap: clamp(12px, 1.9vw, 36px); }
    .ws-tab {
      position: relative; display: inline-flex; align-items: center;
      padding: 6px 2px; font-size: clamp(15px, 1.1vw, 17px); font-weight: 500;
      color: var(--ws-tx); text-decoration: none; border: 0; background: transparent; cursor: pointer; font-family: inherit;
      transition: color 0.2s;
    }
    .ws-tab:hover { color: var(--ws-ink); }
    .ws-tab.is-active { color: var(--ws-ink); font-weight: 600; }
    .ws-tab.is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 2px; border-radius: 2px; background: var(--ws-ink); }   /* half as far below the word as it was (Dani, 14 Oct) */
    .ws-caret { width: 9px; height: 6px; opacity: 0.55; transition: transform 0.25s var(--ws-ease); }
    .ws-nav-right { flex: 0 0 auto; display: flex; align-items: center; gap: 10px; }
    /* Phone: the same treatment the shared header gets (WorkspaceHeader.astro)
       — the sections live in the burger and only there, and signing out is in
       the account menu under their own name. This page keeps its own copy of
       the header's CSS, so both have to say it. */
    @media (max-width: 820px) {
      .ws-nav { gap: 10px; padding: 14px 16px 10px; }
      .ws-tabs { display: none; }
      .ws-navic.ws-logout { display: none; }
      .ws-nav-right { flex: 1 1 auto; justify-content: flex-end; gap: 4px; }
    }
    .ws-navic {
      position: relative; width: 42px; height: 42px; border-radius: 50%;
      display: inline-flex; align-items: center; justify-content: center;
      background: transparent; border: 0; cursor: pointer; color: var(--ws-tx);
      transition: background 0.2s, color 0.2s, transform 0.2s var(--ws-ease);
    }
    .ws-navic:hover { background: rgba(28, 29, 34, 0.05); color: var(--ws-ink); }
    .ws-navic svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-dot { position: absolute; top: 9px; right: 11px; width: 7px; height: 7px; border-radius: 50%; background: var(--ws-accent); box-shadow: 0 0 0 2px #fff; }
    .ws-whobtn { display: inline-flex; align-items: center; gap: 7px; padding: 4px 8px 4px 4px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; font-family: inherit; transition: background 0.2s; }
    .ws-whobtn:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-whoav { width: 38px; height: 38px; border-radius: 50%; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; font-size: var(--ws-t-body); font-weight: 700; letter-spacing: 0.03em; color: #fff; background: linear-gradient(140deg, color-mix(in srgb, var(--ws-accent) 70%, #fff), var(--ws-accent)); background-size: cover; background-position: center; }
    /* ---------- Dropdowns ---------- */
    .ws-menu { position: relative; }
    .ws-dropdown { position: absolute; top: calc(100% + 10px); left: 0; min-width: 210px; padding: 8px; background: #fff; border: 1px solid var(--ws-line); border-radius: 14px; box-shadow: 0 24px 50px -22px rgba(28,29,34,0.28); opacity: 0; transform: translateY(-10px) scale(0.9); transform-origin: top left; pointer-events: none; transition: opacity 0.22s var(--ws-ease), transform 0.38s cubic-bezier(.34, 1.56, .4, 1); z-index: 50; }
    .ws-menu.is-open .ws-dropdown { opacity: 1; transform: none; pointer-events: auto; }
    /* Mega-menu items cascade in — the lively "bubble out" reveal */
    .ws-menu.is-open .ws-caret { transform: rotate(180deg); }
    .ws-dropdown a { display: block; padding: 10px 12px; border-radius: 9px; font-size: var(--ws-t-body); color: var(--ws-tx); text-decoration: none; transition: background 0.16s, color 0.16s; }
    .ws-dropdown a:hover { background: rgba(28, 29, 34, 0.05); color: var(--ws-ink); }
    .ws-dropdown-head { padding: 8px 12px 10px; border-bottom: 1px solid var(--ws-line); margin-bottom: 6px; display: flex; flex-direction: column; gap: 2px; }
    .ws-dropdown-head strong { font-size: var(--ws-t-row); color: var(--ws-ink); }
    .ws-dropdown-head span { font-size: var(--ws-t-meta); color: var(--ws-faint); }
    .ws-dropdown-out { color: var(--ws-accent) !important; font-weight: 600; }
    /* Right-anchored dropdowns (notifications, account) stay on-screen at the page edge */
    .ws-dropdown--right { left: auto; right: 0; transform-origin: top right; }
    /* Notifications panel */
    .ws-dropdown--notif { width: 332px; min-width: 332px; padding: 8px; }
    .ws-notif-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 8px 10px 10px; border-bottom: 1px solid var(--ws-line); margin-bottom: 4px; }
    .ws-notif-head strong { font-size: var(--ws-t-row); color: var(--ws-ink); }
    /* "All caught up": the heading's size, not bold, starting under its N (Dani, 17 Oct). */
    .ws-notif-empty { padding: 10px 10px 6px; font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 400; line-height: 1.4; color: var(--ws-tx, rgba(28,29,34,0.64)); }
    .ws-notif-clear { font-family: inherit; font-size: var(--ws-t-meta); font-weight: 600; color: var(--ws-accent); background: none; border: 0; padding: 0; cursor: pointer; }
    .ws-notif-clear:hover { text-decoration: underline; }
    .ws-notif-list { display: flex; flex-direction: column; }
    .ws-notif-item { display: flex; align-items: flex-start; gap: 11px; padding: 10px 10px; border-radius: 10px; text-decoration: none; transition: background 0.16s; }
    .ws-notif-item:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-notif-item.is-unread { background: color-mix(in srgb, var(--ws-accent) 7%, transparent); }
    .ws-notif-item.is-unread .ws-notif-txt b::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: var(--ws-accent); margin-right: 6px; vertical-align: middle; }
    .ws-notif-ic { flex: 0 0 auto; width: 34px; height: 34px; border-radius: 9px; display: inline-flex; align-items: center; justify-content: center; }
    .ws-notif-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-notif-ic--order { color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 13%, #fff); }
    .ws-notif-ic--booking { color: #2f9e5e; background: rgba(47, 158, 94, 0.12); }
    .ws-notif-ic--blog { color: #2f7dc4; background: rgba(47, 125, 196, 0.12); }
    .ws-notif-ic--news { color: #e3a008; background: rgba(227, 160, 8, 0.15); }
    .ws-notif-txt { display: flex; flex-direction: column; gap: 2px; flex: 1; min-width: 0; }
    .ws-notif-txt b { font-size: var(--ws-t-body); font-weight: 600; color: var(--ws-ink); }
    .ws-notif-txt i { font-style: normal; font-size: var(--ws-t-meta); line-height: 1.4; color: var(--ws-faint); }
    .ws-notif-cta { font-style: normal; margin-top: 3px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--english-violet, #371e28); }
    .ws-notif-time { flex: 0 0 auto; font-size: var(--ws-t-label); color: var(--ws-faint); padding-top: 1px; }
    /* When all read, the unread dot hides */
    .ws-notif.is-read .ws-dot { display: none; }
    .ws-logout svg { width: 19px; height: 19px; }
    .ws-iconround { width: 46px; height: 46px; flex: 0 0 auto; border-radius: 50%; border: 1px solid var(--ws-line); background: #fff; color: var(--ws-tx); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: color 0.2s, border-color 0.2s; }
    .ws-iconround:hover { color: var(--ws-ink); border-color: rgba(28,29,34,0.28); }
    .ws-iconround svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.35s var(--ws-ease); }
    .ws-iconround:hover svg { transform: rotate(-90deg); }
    .ws-hero { --ws-hero-img: url('/assets/table.jpg'); }
    .ws-hero-cta-btn { flex: 0 0 auto; align-self: flex-start; margin-top: var(--ws-gap); }
    /* Three stats side by side in outlined boxes - drawn, not filled, so they
       read as three objects without a block of grey pulling focus off the
       numbers inside them. */
    /* Laid out like every other banner (Dani, 14 Oct): the date in the top
       left corner, and the greeting, intro, stats and button together in the
       bottom left, on the other banners' padding. */
    .ws-left > .ws-hero { grid-template-columns: minmax(0, 1fr); background: none; border: 0; border-radius: 0; overflow: visible; }
    .ws-left > .ws-hero > .ws-hero-copy { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: clamp(24px, 3vw, 48px); align-items: end; padding: clamp(6px, 1vw, 14px) 0 clamp(4px, 0.6vw, 8px); }
    .ws-left > .ws-hero .ws-hero-date { grid-column: 1 / -1; margin: 0; padding-bottom: clamp(16px, 2.2vh, 26px); }
    .ws-left > .ws-hero .ws-greeting, .ws-left > .ws-hero .ws-hero-sub { grid-column: 1 / -1; }
    .ws-left > .ws-hero .ws-hero-cta-btn { grid-column: 1; grid-row: 4; align-self: end; justify-self: start; margin-top: clamp(20px, 2.6vh, 30px); }
    .ws-left > .ws-hero .ws-brief { grid-column: 2; grid-row: 4; align-self: end; width: auto; margin: 0; grid-template-columns: repeat(3, minmax(170px, auto)); }
    @media (max-width: 900px) {
      .ws-left > .ws-hero > .ws-hero-copy { grid-template-columns: minmax(0, 1fr); }
      .ws-left > .ws-hero .ws-brief { grid-column: 1; grid-row: 4; margin-top: clamp(18px, 2.4vh, 26px); grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .ws-left > .ws-hero .ws-hero-cta-btn { grid-row: 5; }
    }
    @media (max-width: 620px) { .ws-left > .ws-hero .ws-brief { grid-template-columns: 1fr; } }
    .ws-brief { list-style: none; margin: clamp(20px, 2.6vh, 28px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; width: 100%; }
    .ws-brief li { position: relative; display: flex; align-items: center; gap: 11px; padding: 13px 14px; border: 1px solid var(--ws-line); border-radius: var(--ws-r); font-size: var(--ws-t-body); line-height: 1.3; color: var(--ws-tx); opacity: 0; transform: translateY(14px); animation: wsBriefIn 0.55s var(--ws-ease) forwards; animation-delay: calc(0.5s + var(--d) * 0.1s); }
    /* Every stat is the same two lines - the value, then what it counts - so
       the row reads as one row and not three different shapes. */
    .ws-brief-tx { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .ws-brief-tx strong { color: var(--ws-ink); font-weight: 600; font-size: var(--ws-t-row); }
    .ws-brief-tx span { font-size: var(--ws-t-meta); color: var(--ws-tx); }
    /* The rotating slot is a link - it is the one tile that is usually asking
       you to go and do something about it. */
    .ws-brief-slot { display: flex; align-items: center; gap: 11px; text-decoration: none; color: inherit; }
    /* Only a slot with somewhere to go covers its box or reacts to a pointer.
       No underline on hover - the whole box lighting up says it already. */
    .ws-brief-slot[href] { cursor: pointer; }
    .ws-brief-slot[href]::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
    .ws-brief li { transition: border-color 0.2s var(--ws-ease); }
    .ws-brief li:has(.ws-brief-slot[href]:hover) { border-color: rgba(28,29,34,0.3); }
    .ws-brief-ic--due { color: #b4553f; }
    .ws-brief-ic--gallery { color: var(--ws-accent); }
    @media (max-width: 620px) {
      .ws-brief { grid-template-columns: 1fr; }
      /* The gap under the greeting was set for a desktop hero standing beside
         a photograph. On a phone the photograph is below, so the space read as
         a hole between the greeting and the first thing it is talking about. */
      .ws-brief { margin-top: clamp(16px, 4vh, 36px); }
      /* The line break belongs to the two-column hero. On a phone the first
         sentence already wraps, so the break made three lines of two. */
      .ws-hero-sub br { display: none; }
      .ws-hero-sub { font-size: 15px; line-height: 1.5; }
    }
    .ws-brief strong { color: var(--ws-ink); font-weight: 600; }
    .ws-brief-ic--kit { color: var(--ws-success); }
    .ws-brief-ic { flex: 0 0 auto; width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center; background: none; border: 0; color: var(--ws-tx); }
    .ws-brief-ic svg { width: 19px; height: 19px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    /* Each brief icon its own colour, on a soft tint of that colour. */
    .ws-brief-ic--sched { color: var(--ws-accent); }
    .ws-brief-ic--eng { color: #2f9e5e; background: rgba(47,158,94,0.12); border-color: rgba(47,158,94,0.26); }
    .ws-brief-ic--time { color: #2f7dc4; }
    .ws-brief-ic--star { color: #e3a008; background: rgba(227,160,8,0.15); border-color: rgba(227,160,8,0.30); }
    .ws-brief-ic--star svg { fill: currentColor; stroke: none; }
   /* a star fills, it doesn't stroke */
    .ws-brief-ic--eng.is-down { color: #c0392b; background: rgba(192,57,43,0.10); border-color: rgba(192,57,43,0.24); }
    @media (max-width: 880px) { }
    @media (max-width: 620px) { .ws-hero { grid-template-columns: 1fr; } }
    /* Planner week — all seven days on one line, each near enough square.
       The date is the loud thing: you scan a week by number, not by label. */
    .ws-week { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: var(--ws-gap); }
    @media (max-width: 900px) { .ws-week { grid-template-columns: repeat(4, 1fr); } }
    /* On a phone, seven cards two-up is four rows of scrolling before the page
       has said anything. A swipe strip showing two and the edge of the third
       keeps the week to one band and makes the rest obviously reachable. */
    @media (max-width: 520px) {
      .ws-week {
        display: flex; overflow-x: auto; scroll-snap-type: x proximity;
        scrollbar-width: none; -webkit-overflow-scrolling: touch;
      }
      .ws-week::-webkit-scrollbar { display: none; }
      .ws-week .ws-day { flex: 0 0 43%; scroll-snap-align: start; }
    }
    /* Every day as tall as the busiest one, so the line at the foot — "No post
       planned", "Design this post" — sits level across all seven and only the
       gap above it varies with the length of the prompt.

       Both declarations earn their place. `align-self: stretch` because the
       default `align-items: normal` deliberately does NOT stretch an item that
       carries an aspect-ratio; for those it behaves as `start`, to protect the
       ratio. And `width: 100%` because once stretching makes the height
       definite, an auto width lets the ratio run backwards and compute the
       WIDTH from that height — cards then grow past their column, close the
       gaps and overlap. Pinning the width to the column leaves the ratio with
       no free axis, so it only ever sets the shape of a quiet week.

       `min-width: 0` for the same reason one step further down: a grid item's
       automatic minimum size takes the width the ratio implies from its
       height, which at four columns pushed cards past their track — that one
       predates any of this and was already overflowing at tablet width. */
    .ws-day { position: relative; display: flex; flex-direction: column; gap: 6px; padding: 14px; aspect-ratio: 1 / 1.25; width: 100%; min-width: 0; align-self: stretch; border-radius: var(--ws-r-sm); background: #fff; border: 1px solid var(--ws-line); text-decoration: none; color: var(--ws-ink); cursor: pointer; font-family: inherit; text-align: left; transition: border-color 0.25s var(--ws-ease), transform 0.25s var(--ws-ease); }
    .ws-day:hover { transform: translateY(-3px); border-color: rgba(28, 29, 34, 0.22); }
    .ws-day-name { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-faint); display: flex; align-items: center; gap: 6px; }
    .ws-day-name i { display: none; }
   /* the darker outline says "today" on its own */
    .ws-day-num { font-family: var(--subhead); font-size: clamp(20px, 1.7vw, 27px); font-weight: 400; line-height: 1; letter-spacing: -0.02em; color: var(--ws-ink); }
    /* Square, pinned to the bottom: the extra card height goes to the picture
       staying a picture rather than stretching into a letterbox. */
    .ws-day-thumb { flex: none; width: 100%; aspect-ratio: 1 / 1; margin-top: auto; border-radius: 4px; background-size: cover; background-position: center; background-color: #e9e6e2; }
    /* Today is the same card with a darker edge - enough to find, without
       colouring it in or labelling it. */
    .ws-day.is-today { border-color: rgba(28,29,34,0.42); }
    .ws-day--empty { justify-content: flex-start; }
    .ws-day-empty-msg { margin-top: auto; font-size: var(--ws-t-meta); font-weight: 500; color: var(--ws-faint); }
    /* A day whose plan is an activity rather than a post: its name, in the
       wine of the calendar, where a post would show its picture. */
    .ws-day-act { margin-top: auto; padding: 8px 10px; border-radius: 4px; background: color-mix(in srgb, var(--ws-accent) 8%, #fff); color: var(--ws-accent); font-size: var(--ws-t-meta); font-weight: 600; line-height: 1.3; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; }
    /* Recent designs reel — portrait, fan out on hover */
    /* A day carrying a starter idea. Tinted in the brand plum rather than left
       white: an untouched week was seven identical blank boxes, which is a poor
       first thing to hand somebody who has just signed up. */
    .ws-day--idea {
      background: color-mix(in srgb, var(--ws-accent) 9%, #fff);
      border-color: color-mix(in srgb, var(--ws-accent) 22%, var(--ws-line));
    }
    .ws-day--idea:hover { border-color: color-mix(in srgb, var(--ws-accent) 45%, var(--ws-line)); }
    .ws-day-flag { margin-top: 10px; font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-accent); }
    /* Darker Grotesque semi-bold, the face of the doors' titles and the hero's
       stats: softer than the heading face (Dani, 16 Oct). */
    .ws-day-idea { margin-top: 3px; font-family: var(--sans); font-size: calc(var(--ws-t-meta) + 2px); font-weight: 600; line-height: 1.2; letter-spacing: 0; color: var(--ws-ink); }
    .ws-day-hint { margin-top: 5px; font-size: var(--ws-t-meta);   /* Today's prompt's hint size (Dani, 16 Oct) */ line-height: 1.4; color: var(--ws-tx); }
    .ws-day-cta { margin-top: auto; font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-accent); }
    .ws-day-cta em { font-style: normal; display: inline-block; transition: transform 0.25s var(--ws-ease); }
    .ws-day--idea:hover .ws-day-cta em { transform: translateX(3px); }
    /* Your Studio — five doors, portrait, shading down from the brand
       secondary (#7e6765, the colour the wordmark settles to) towards paper.
       White words on all five (Dani, 16 Oct). The fifth is the last design: its picture fills the card once
       it's known; until then it is its shade. */
    /* .ws-tools.ws-doors, not .ws-doors: ws-system.css's four columns load
       after this on the live build and won (Dani's screen, 16 Oct). */
    .ws-tools.ws-doors { grid-template-columns: repeat(5, minmax(0, 1fr)); }
    .ws-tool.ws-door {
      --door: #7e6765; --door-ink: #fff;
      position: relative; overflow: hidden; isolation: isolate;
      flex-direction: column; align-items: stretch; gap: 0;
      aspect-ratio: 4 / 5; min-height: 0; padding: clamp(16px, 1.5vw, 22px);
      border: 0; background: var(--door); color: var(--door-ink);
      transition: transform 0.35s var(--ws-ease), box-shadow 0.35s var(--ws-ease);
    }
    .ws-door:nth-child(2) { --door: color-mix(in srgb, #7e6765 84%, #fff); }
    .ws-door:nth-child(3) { --door: color-mix(in srgb, #7e6765 68%, #fff); }
    .ws-door:nth-child(4) { --door: color-mix(in srgb, #7e6765 54%, #fff); }
    .ws-door:nth-child(5) { --door: color-mix(in srgb, #7e6765 42%, #fff); }
    .ws-tool.ws-door:hover { transform: translateY(-4px); border-color: transparent; box-shadow: 0 22px 40px -24px rgba(55,30,40,0.55); }
    /* A soft light that drifts across on hover, so the doors feel like
       something to open rather than five swatches. */
    .ws-door::before { content: ""; position: absolute; inset: -40% -60%; z-index: -1; pointer-events: none;
      background: radial-gradient(closest-side, rgba(255,255,255,0.22), rgba(255,255,255,0));
      transform: translate(-40%, 30%); opacity: 0; transition: transform 0.9s var(--ws-ease), opacity 0.5s var(--ws-ease); }
    .ws-door:hover::before { transform: translate(10%, -10%); opacity: 1; }
    .ws-door-ic { flex: none; width: 38px; height: 38px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;
      background: color-mix(in srgb, var(--door-ink) 14%, transparent); color: var(--door-ink); transition: transform 0.45s var(--ws-ease); }
    .ws-door:hover .ws-door-ic { transform: rotate(-8deg) scale(1.06); }
    .ws-door-ic svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    /* The words sit in a band at the foot, wine once there's a picture above
       them: on hover for the first four, always for a last design that shows
       (Dani, 16 Oct). Laid out the same either way, so nothing moves. */
    .ws-door { --pad: clamp(16px, 1.5vw, 22px); }
    /* The band is always there, in the card's own colour, so at rest it is
       just the card; on hover the picture comes up above it and the band
       stays exactly as it was (Dani, 17 Oct: it used to fade in with the
       picture, so the whole card seemed to blink). */
    .ws-door-tx { position: relative; margin: auto calc(-1 * var(--pad)) calc(-1 * var(--pad)); padding: 12px 40px var(--pad) var(--pad); display: flex; flex-direction: column; gap: 5px; min-width: 0; background: var(--door); }
    /* On hover the picture covers the whole card, words and band included;
       off it, the card and its words come back (Dani, 17 Oct). */
    .ws-door-img { position: absolute; inset: 0; z-index: 3; background-size: cover; background-position: center; opacity: 0; transform: scale(1.04);
      transition: opacity 0.5s var(--ws-ease), transform 1.2s var(--ws-ease); pointer-events: none; }
    @media (hover: hover) {
      .ws-door:hover .ws-door-img, .ws-door:focus-visible .ws-door-img { opacity: 1; transform: none; }
    }
    .ws-door-tx strong { font-size: clamp(15px, 1.15vw, 18px); font-weight: 600; line-height: 1.2; letter-spacing: -0.005em; }
    .ws-door-tx span { font-size: var(--ws-t-meta); line-height: 1.4; opacity: 0.82; overflow: hidden; text-overflow: ellipsis; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
    .ws-door-go { position: absolute; right: clamp(16px, 1.5vw, 22px); bottom: clamp(16px, 1.5vw, 22px); font-size: 16px; line-height: 1; transition: transform 0.3s var(--ws-ease); }
    .ws-door:hover .ws-door-go { transform: translateX(4px); }
    /* Continue design: the picture, with its words on a wine band at the foot. */
    .ws-resume-img { position: absolute; inset: 0; z-index: -1; background-size: cover; background-position: center; opacity: 0; transform: scale(1.04);
      transition: opacity 0.6s var(--ws-ease), transform 1.2s var(--ws-ease); }
    .ws-resume.has-img .ws-resume-img { opacity: 1; transform: none; }
    .ws-resume.has-img:hover .ws-resume-img { transform: scale(1.04); }
    .ws-resume.has-img { --door-ink: #fff; }
    .ws-tool.ws-door.ws-resume.is-wine { --door: var(--english-violet); }
    .ws-resume.has-img .ws-door-ic { background: rgba(55,30,40,0.72); }
    /* Below 1000px the five fit across, smaller (Dani, 17 Oct: in the training
       pop-out they ran off past the bar); a swipe strip only on a phone. */
    @media (max-width: 620px) {
      .ws-tools.ws-doors { display: flex; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; padding-bottom: 4px; }
      .ws-doors::-webkit-scrollbar { display: none; }
      .ws-doors .ws-door { flex: 0 0 calc((100% - 2 * var(--ws-gap)) / 3.3); scroll-snap-align: start; }
    }
    @media (max-width: 560px) { .ws-doors .ws-door { flex-basis: 58%; } }

    /* Be inspired — the reel takes three quarters, today's prompt and the next
       booking stack in the last quarter. */
    .ws-inspire { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: var(--ws-gap); align-items: stretch; }
    .ws-inspire-side { display: flex; flex-direction: column; gap: var(--ws-gap); min-width: 0; }
    .ws-inspire-side .ws-side { flex: 1 1 0; }
    /* "Another idea" sits at the right edge of the page now, and its tooltip
       opened further right, past the window: unseen, but wide enough that the
       whole page could be pushed sideways (Dani, 16 Oct). It opens leftwards. */
    .ws-inspire-side .ws-tip-right[data-tip]::after { left: auto; right: calc(100% + 12px); transform: translateY(-50%) translateX(4px); }
    .ws-inspire-side .ws-tip-right[data-tip]:hover::after { transform: translateY(-50%) translateX(0); }
    /* And nothing on the dashboard may make it wider than the window. clip, not
       hidden: hidden would make this a scroll box and stop Learn holding still. */
    .ws { overflow-x: clip; }
    @media (max-width: 1000px) { .ws-inspire { grid-template-columns: 1fr; } .ws-inspire-side { flex-direction: row; } .ws-inspire-side .ws-side { flex: 1 1 0; min-width: 0; } }
    @media (max-width: 620px) { .ws-inspire-side { flex-direction: column; } }
    .ws-inspire.is-no-reel { grid-template-columns: 1fr; }
    .ws-inspire.is-no-reel .ws-reel { display: none; }
    .ws-inspire.is-no-reel .ws-inspire-side { flex-direction: row; }
    .ws-side { display: flex; flex-direction: column; gap: 12px; padding: 22px; border: 1px solid var(--ws-line); border-radius: var(--ws-r); background: #fff; }
    .ws-side-eyebrow { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-faint); }
    .ws-side-h { margin: 0; font-family: var(--serif); font-size: var(--ws-t-title); font-weight: 400; line-height: 1.25; letter-spacing: -0.01em; color: var(--ws-ink); }
    .ws-side-meta { margin: 4px 0 0; font-size: var(--ws-t-body); color: var(--ws-tx); }
    .ws-side-foot { display: flex; align-items: center; gap: 12px; margin-top: auto; }
    /* The prompt sits in the middle of the card, not at the top: it is the
       reason the card exists, so it gets the space rather than the eyebrow. */
    .ws-idea-wrap { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 9px; padding: 6px 0; }
    .ws-idea-hint { margin: 0; font-size: var(--ws-t-meta); line-height: 1.45; color: var(--ws-faint); }
    /* Pushed to the far edge so it is a quiet second option, not a twin of the
       button it used to sit against. */
    .ws-idea-again { margin-left: auto; width: 33px; height: 33px; }
    .ws-idea-again svg { width: 15px; height: 15px; }
    .ws-idea { font-family: var(--serif); font-style: normal; font-size: clamp(15px, 1.3vw, 17px); font-weight: 400; line-height: 1.45; letter-spacing: -0.01em; color: var(--ws-ink); margin: 0; }
    /* ---------- Chapter 04 — Learn ----------
       Buttons along the top, the Explore ones' shape, the chosen one filled;
       the picture under them fills the width, no frame (Dani, 16 Oct). Its
       words sit on a wine panel the same size on every slide, so a pale
       picture stays readable and nothing jumps as they change. */
    .ws-folder-wrap { display: flex; flex-direction: column; gap: 12px; }
    .ws-folder-tabs { display: flex; flex-wrap: wrap; gap: 6px; }
    .ws-folder-tab { all: unset; box-sizing: border-box; cursor: pointer; display: inline-flex; align-items: center; height: 30px; padding: 0 12px; border: 1px solid rgba(55,30,40,0.45); border-radius: 6px;
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet); white-space: nowrap;
      transition: background 0.2s var(--ws-ease), color 0.2s var(--ws-ease), border-color 0.2s; }
    .ws-folder-tab:hover { border-color: var(--english-violet); }
    .ws-folder-tab.is-on { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .ws-folder-tab:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
    .ws-folder-body { position: relative; overflow: hidden; border-radius: var(--ws-r); }
    .ws-folder-track { display: flex; transition: transform 0.75s cubic-bezier(.65, 0, .25, 1); }
    .ws-folder-slide { position: relative; flex: 0 0 100%; display: block; aspect-ratio: 21 / 9; min-height: 360px; overflow: hidden; color: #fff; text-decoration: none; }
    .ws-folder-pic { position: absolute; inset: 0; background-size: cover; background-position: center; transition: transform 1.4s var(--ws-ease); }
    .ws-folder-slide:hover .ws-folder-pic { transform: scale(1.03); }
    .ws-folder-card { position: absolute; left: clamp(16px, 2.4vw, 36px); bottom: clamp(16px, 2.4vw, 36px); width: min(690px, calc(100% - 32px)); box-sizing: border-box; display: flex; flex-direction: column; gap: 8px;
      padding: clamp(18px, 1.8vw, 26px); border-radius: var(--ws-r); background: rgba(47, 27, 37, 0.9); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
    .ws-folder-flag { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.65); }
    .ws-folder-h { font-family: var(--serif); font-size: clamp(19px, 1.6vw, 24px); font-weight: 500; line-height: 1.2; letter-spacing: -0.01em; }
    /* "Nothing in the diary"'s size and voice; two lines kept for it on every
       slide, so the panels are all one height. */
    .ws-folder-about { font-size: var(--ws-t-body); line-height: 1.45; color: rgba(255,255,255,0.8); min-height: calc(2 * 1.45em); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    /* "Create this post"'s button, in white on the wine. */
    .ws-folder-card .ws-folder-cta { align-self: flex-start; margin-top: 6px; background: #fff; border-color: #fff; color: var(--ws-ink); }
    .ws-folder-cta svg { width: 13px; height: 13px; transition: transform 0.25s var(--ws-ease); }
    .ws-folder-slide:hover .ws-folder-cta svg { transform: translateX(3px); }
    /* The lessons on one line under the button; the line is kept even when a
       slide has none. */
    .ws-folder-lessons { display: flex; gap: 16px; min-height: 1.3em; margin-top: 4px; white-space: nowrap; overflow: hidden; font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.12em; line-height: 1.3; text-transform: uppercase; color: rgba(255,255,255,0.72); }
    .ws-folder-foot { position: absolute; right: clamp(16px, 2.4vw, 36px); bottom: clamp(16px, 2.4vw, 36px); font-size: var(--ws-t-body); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; text-shadow: 0 1px 12px rgba(0,0,0,0.55), 0 0 2px rgba(0,0,0,0.3); }
    @media (max-width: 760px) {
      .ws-folder-tabs { flex-wrap: nowrap; overflow-x: auto; scrollbar-width: none; }
      .ws-folder-tabs::-webkit-scrollbar { display: none; }
      .ws-folder-slide { aspect-ratio: 4 / 5; min-height: 0; }
      .ws-folder-card { left: 10px; right: 10px; bottom: 10px; width: auto; }
