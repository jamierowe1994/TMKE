    .ws-coach.is-corner::before { display: none; }
    .ws-coach::before { content: ""; position: absolute; top: -6px; left: var(--arrow-x, 26px); width: 11px; height: 11px; background: #fff; border-left: 1px solid var(--ws-line); border-top: 1px solid var(--ws-line); transform: translateX(-50%) rotate(45deg); }
    .ws-coach-spark { flex: 0 0 auto; color: #e3a008; font-size: var(--ws-t-row); line-height: 1.5; }
    .ws-coach-msg { flex: 1; font-size: var(--ws-t-body); line-height: 1.5; color: var(--ws-ink); }
    .ws-coach-x { flex: 0 0 auto; border: 0; background: transparent; color: var(--ws-faint); font-size: var(--ws-t-title); line-height: 1; cursor: pointer; padding: 0 2px; transition: color 0.2s; }
    .ws-coach-x:hover { color: var(--ws-ink); }
