    body.ws-ready .ws-nav { animation: wsNavDrop 0.72s cubic-bezier(.3, 1.55, .5, 1) both; animation-delay: 2.35s; }
    @media (prefers-reduced-motion: reduce) {
      .ws-rise, .ws-brief li, .ws-greeting, .ws-hero-cta-btn, .ws-block-head, .ws-week .ws-day, .ws-tools .ws-tool, .ws-nav { opacity: 1 !important; transform: none !important; animation: none !important; }
    }
    /* Chapter 05's card titles in Today's Prompt's voice, to the letter: the
       same serif, size, weight and leading as .ws-idea one section up. */
    .ws-news--three .ws-news-h { font-size: clamp(15px, 1.3vw, 17px); font-weight: 400; line-height: 1.45; letter-spacing: -0.01em; }
    /* The description used to be pushed to the foot of the card (margin-top:
       auto), so a one-line one sat a long way under its title and a two-line
       one did not - three cards, three different gaps. It follows the title
       now, and every card reads the same from the top down. */
    .ws-news--three .ws-news-desc { margin-top: 0; }

    /* ===== Contextual coach bubble ===== */
    .ws-coach { position: absolute; z-index: 80; max-width: 280px; display: flex; align-items: flex-start; gap: 9px; padding: 12px 12px 12px 13px; background: #fff; border: 1px solid var(--ws-line); border-radius: 13px; box-shadow: 0 20px 44px -18px rgba(28,29,34,0.32); opacity: 0; transform: translateY(-6px) scale(0.92); transform-origin: top center; transition: opacity 0.25s var(--ws-ease), transform 0.5s cubic-bezier(.34, 1.56, .4, 1); }
    .ws-coach.is-in { opacity: 1; transform: none; }
    /* Tucked into a card's corner: no arrow (there is nothing below it to point
