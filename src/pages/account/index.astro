  <script>
    import { supabase } from '../../lib/supabase.js';
    import { loadPrompts, keyForEvergreen, canvasForPrompt, findPromptIn } from '../../data/content-calendar.js';

    requestAnimationFrame(() => document.body.classList.add('ws-ready'));

    // Off-canvas drawer (hamburger → everything that isn't a tab)
    const drawer = document.querySelector('[data-drawer]');
    const burger = document.querySelector('[data-drawer-open]');
    let drawerTimer;
    function openDrawer() { if (!drawer) return; clearTimeout(drawerTimer); drawer.hidden = false; requestAnimationFrame(() => drawer.classList.add('is-open')); burger?.setAttribute('aria-expanded', 'true'); window.__lenis?.stop?.(); }   // the wheel scrolls the menu, not the page behind (Dani, 17 Oct)
    function closeDrawer() { if (!drawer) return; drawer.classList.remove('is-open'); burger?.setAttribute('aria-expanded', 'false'); window.__lenis?.start?.(); drawerTimer = setTimeout(() => { drawer.hidden = true; }, 340); }
    burger?.addEventListener('click', openDrawer);
    document.querySelectorAll('[data-drawer-close]').forEach((b) => b.addEventListener('click', closeDrawer));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && drawer && !drawer.hidden) closeDrawer(); });

    // Dropdowns
    const menus = [...document.querySelectorAll('[data-menu]')];
    function closeAll(except) { menus.forEach((m) => { if (m !== except) { m.classList.remove('is-open'); m.querySelector('[data-menu-btn]')?.setAttribute('aria-expanded', 'false'); } }); }
    menus.forEach((m) => { const b = m.querySelector('[data-menu-btn]'); b?.addEventListener('click', (e) => { e.stopPropagation(); const open = m.classList.toggle('is-open'); b.setAttribute('aria-expanded', String(open)); closeAll(m); }); });
    document.addEventListener('click', () => closeAll(null));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeAll(null); });

    // Notifications are wired in the module script below (initNotifications).

    // Today's prompt — "Another idea" cycles a curated pool of content ideas.
    // (A simple, free pool for now; can be swapped for AI generation via the
    // Worker later without touching this markup.)
    (async function wirePrompt() {
      // Insights > Prompts is the source; loadPrompts falls back to the code
      // file, so this works whether or not the table has been seeded.
      const PROMPTS = await loadPrompts(supabase);
      const POOL = PROMPTS.evergreen;
      const idea = document.querySelector('.ws-idea');
      const hint = document.getElementById('idea-hint');
      const btn = document.querySelector('.ws-idea-again');
      if (!idea || !hint || !btn) return;

      const paint = (pair, animate) => {
        const write = () => {
          idea.textContent = '\u201C' + pair[0] + '\u201D';
          hint.textContent = pair[1];
        };
        if (!animate) return write();
        [idea, hint].forEach((el) => {
          el.style.transition = 'opacity 0.22s cubic-bezier(.2,.8,.2,1), transform 0.22s cubic-bezier(.2,.8,.2,1)';
          el.style.opacity = '0';
          el.style.transform = 'translateY(8px)';
        });
        setTimeout(() => {
          write();
          [idea, hint].forEach((el) => { el.style.opacity = '1'; el.style.transform = 'none'; });
        }, 220);
      };

      // Daily prompt — everyone sees the same one each day, rotating through the
      // pool by day-of-year (no manual writing needed). "Another idea" shuffles.
      const _now = new Date();
      const _doy = Math.floor((_now - new Date(_now.getFullYear(), 0, 0)) / 86400000);
      if (!POOL.length) return;
      let current = POOL[_doy % POOL.length];
      paint(current, false);
      // The "Create this post" button opens the editor on this same prompt.
      const cta = document.querySelector('.ws-side .ws-btn--primary');
      const pointCta = () => {
        if (!cta) return;
        const key = keyForEvergreen(current);
        cta.setAttribute('href', `/account/editor?blank=${canvasForPrompt(findPromptIn(PROMPTS, key))}&prompt=${key}`);
      };
      pointCta();

      btn.addEventListener('click', () => {
        let next = current;
        for (let i = 0; i < 8 && next === current; i++) {
          next = POOL[Math.floor(Math.random() * POOL.length)];
        }
        current = next;
        pointCta();
        paint(next, true);
      });
    })();

    // Count-up + bars/ring on view
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function animateCount(el) {
      const target = parseFloat(el.getAttribute('data-count')) || 0;
      const dur = 1100, start = performance.now(), fmt = (n) => Math.round(n).toLocaleString('en-GB');
      function tick(now) { const p = Math.min(1, (now - start) / dur); el.textContent = fmt(target * (1 - Math.pow(1 - p, 3))); if (p < 1) requestAnimationFrame(tick); else el.textContent = fmt(target); }
      requestAnimationFrame(tick);
    }
    const io = new IntersectionObserver((entries, obs) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return; obs.unobserve(e.target); const t = e.target;
        if (reduce) t.querySelectorAll('[data-count]').forEach((n) => { n.textContent = (parseFloat(n.getAttribute('data-count')) || 0).toLocaleString('en-GB'); });
        else t.querySelectorAll('[data-count]').forEach(animateCount);
        t.querySelectorAll('[data-val]').forEach((b) => { b.style.width = (b.getAttribute('data-val') || 0) + '%'; });
        t.querySelectorAll('[data-ring]').forEach((r) => { const pct = parseFloat(r.getAttribute('data-ring')) || 0; r.style.strokeDashoffset = String(2 * Math.PI * 15.5 * (1 - pct / 100)); });
      });
    }, { threshold: 0.25 });
    document.querySelectorAll('.ws-hero, .ws-widget').forEach((el) => io.observe(el));
  </script>

  <!-- Stage A migration: wire the real signed-in identity. Falls back to the
       mock preview when signed out (the hard login-gate lands at go-live). -->
  <script>
    import { isDemo as demoOn, initDemoChrome, lockClicks } from "../../lib/demo.js";
    import { adoptBrandCacheOrReload, claimDemoBrandKit, syncBrandCache } from "../../lib/brand-cache.js";
    import { EVERGREEN_PROMPTS as DEMO_EVERGREEN, keyForEvergreen as demoKeyFor } from '../../data/content-calendar.js';
    // The dashboard draws its own header, so the demo chrome is set up here.
    if (initDemoChrome()) {
      // Nothing saved yet, so the "pick up where you left off" card becomes
      // the way in: a wine block that opens the Studio.
      // Nothing saved in the demo, so Continue design is the way into the packs.
      const rn = document.getElementById('ws-resume-name'); if (rn) rn.textContent = 'Start from one of your packs.';
      // The week: two sample posts stay; two empty days carry a prompt each,
      // so the strip shows what "idea ready" looks like.
      const days = Array.from(document.querySelectorAll('.ws-week .ws-day'));
      const esc = (v) => String(v ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
      [[days[1], DEMO_EVERGREEN[1]], [days[5], DEMO_EVERGREEN[6]], [days[4], null]].forEach(([card, pr]) => {
        if (!card) return;
        if (!pr) { // the third sample post goes, so the week reads two posts, two prompts
          const head = (card.querySelector('.ws-day-name')?.outerHTML || '') + (card.querySelector('.ws-day-num')?.outerHTML || '');
          card.classList.add('ws-day--empty'); card.innerHTML = `${head}<span class="ws-day-empty-msg">No post planned</span>`;
          return;
        }
        const head = (card.querySelector('.ws-day-name')?.outerHTML || '') + (card.querySelector('.ws-day-num')?.outerHTML || '');
        card.classList.add('ws-day--idea'); card.classList.remove('ws-day--empty');
        card.setAttribute('href', `/account/editor?blank=1&prompt=${demoKeyFor(pr)}`);
        card.innerHTML = `${head}
          <span class="ws-day-flag">Idea ready</span>
          <span class="ws-day-idea">${esc(pr[0])}</span>
          <span class="ws-day-hint">${esc(pr[1])}</span>
          <span class="ws-day-cta">Design this post <em aria-hidden="true">&rarr;</em></span>`;
      });
      // Two of the Studio cards are for members.
      document.querySelectorAll('[data-demo-lock]').forEach((a) => a.classList.add('is-demo-locked'));
      lockClicks('[data-demo-lock]', 'That one is for members.', 'Reels guides and scheduling come with membership. In the demo, try the Studio, the Marketing Planner and the Getting Started guides.');
    }
    import { supabase, signOutEverywhere} from '../../lib/supabase.js';
    import { designStore, plannerStore } from '../../lib/design-store.js';
    import { initNotifications } from '../../lib/notifications.js';
    // The menu's bell and its new-pack card (lib/drawer-extras.js).
    import { wireDrawerBell, fillDrawerCarousel } from "../../lib/drawer-extras.js";
    wireDrawerBell();
    fillDrawerCarousel(supabase);
    import { initTour } from '../../lib/tour.js';
    // The dashboard carries its own copy of the workspace header, so it
    // resumes a training walkthrough itself.
    initTour();
    import { bookingLocation } from '../../lib/videography-config.js';
    import { loadPrompts, upcomingFrom, keyForDay, keyForEvergreen, canvasForPrompt } from '../../data/content-calendar.js';

    // Notifications — real booking correspondence, unread dot + deep links.
    initNotifications();

    const titleCase = (s) => String(s || '').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
    const escapeHtml = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

    // Log out (top-bar icon + drawer): clear the Supabase session, then /login.
    document.querySelectorAll('[data-logout]').forEach((el) => el.addEventListener('click', async (e) => {
      e.preventDefault();
      await signOutEverywhere();
    }));

    // ---- Bookings widget (right-column carousel of active bookings) ----
    const bkFmt = (iso) => { try { return new Date(iso).toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }); } catch (_) { return ''; } };
    const bkCountdown = (iso) => { const ts = new Date(iso).getTime(); if (isNaN(ts)) return ''; const d = Math.ceil((ts - Date.now()) / 86400000); return d <= 0 ? 'Today' : d === 1 ? 'Tomorrow' : `In ${d} days`; };
    function renderBookings(items) {
      // The bookings widget is gone; its numbers live in the hero tile now.
      // Set before the guard below, which returns as soon as it finds no track.
      const bn = document.getElementById('brief-bookings');
      const bs = document.getElementById('brief-bookings-sub');
      if (bn && bs) {
        // Zero is a real answer, not a blank: "No bookings" reads as a state,
        // where "0 bookings" reads as something that failed to load.
        bn.textContent = items.length ? `${items.length} booking${items.length === 1 ? '' : 's'}` : 'No bookings';
        bs.textContent = items.length ? 'coming up' : 'in the diary';
        const bl = document.getElementById('brief-bookings-link');
        if (bl) { if (items.length) bl.setAttribute('href', '/account/bookings'); else bl.removeAttribute('href'); }
      }
      // "Coming up" in the pick-up row: the very next booking, or a plain
      // statement that there are none. Set before the old widget's guard.
      const nx = document.getElementById('ws-next-bk');
      if (nx) {
        const next = items[0];
        nx.innerHTML = next
          ? `<p class="ws-side-h">${escapeHtml(String(next.title || 'Booking'))}</p><p class="ws-side-meta">${escapeHtml(bkFmt(next.when) || '')}</p>`
          : `<p class="ws-side-h">No bookings yet</p><p class="ws-side-meta">Nothing in the diary.</p>`;
      }
      reportQuiet('bookings', items.length === 0);
      const track = document.getElementById('ws-bk-track');
      const nav = document.getElementById('ws-bk-nav');
      const dots = document.getElementById('ws-bk-dots');
      if (!track) return;
      if (!items.length) {
        track.innerHTML = `<div class="ws-bk-empty">No upcoming bookings.<br><a href="/videography">Book a shoot or call →</a></div>`;
        if (nav) nav.hidden = true;
        return;
      }
      track.innerHTML = items.map((b) => {
        const isCall = b.source === 'smm' || b.service_type === 'discovery';
        const loc = bookingLocation(b);
        return `<a class="ws-bk-card" href="/account/bookings?open=${encodeURIComponent(b.source + ':' + b.id)}">
          <span class="ws-bk-top">
            <span class="ws-bk-pill${isCall ? ' is-call' : ''}">${isCall ? 'Call booked' : 'Booked'}</span>
            <span class="ws-bk-title">${escapeHtml(b.title)}</span>
            ${loc ? `<span class="ws-bk-loc"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>${escapeHtml(loc)}</span>` : ''}
          </span>
          <span class="ws-bk-bot">
            <span class="ws-bk-when">${escapeHtml(bkFmt(b.when))}</span>
            <span class="ws-bk-count">${escapeHtml(bkCountdown(b.when))}</span>
          </span>
        </a>`;
      }).join('');
      if (items.length > 1 && nav && dots) {
        nav.hidden = false;
        dots.innerHTML = items.map((_, i) => `<button type="button" class="ws-bk-dot${i === 0 ? ' is-active' : ''}" data-bk-dot="${i}" aria-label="Booking ${i + 1}"></button>`).join('');
        const dotEls = [...dots.querySelectorAll('[data-bk-dot]')];
        const cardW = () => track.firstElementChild ? track.firstElementChild.getBoundingClientRect().width + 10 : track.clientWidth;
        const current = () => Math.round(track.scrollLeft / cardW());
        const go = (i) => track.scrollTo({ left: Math.max(0, Math.min(items.length - 1, i)) * cardW(), behavior: 'smooth' });
        document.querySelector('[data-bk-prev]')?.addEventListener('click', () => go(current() - 1));
        document.querySelector('[data-bk-next]')?.addEventListener('click', () => go(current() + 1));
        dotEls.forEach((d, i) => d.addEventListener('click', () => go(i)));
        track.addEventListener('scroll', () => { const i = current(); dotEls.forEach((d, j) => d.classList.toggle('is-active', j === i)); }, { passive: true });
      } else if (nav) {
        nav.hidden = true;
      }
    }
    // ---- Starter ideas, on the days still to come with nothing on them ----
    // They used to wait until the whole week was quiet -- nothing planned,
    // nothing booked, nothing owed -- so one booking in the diary took every
    // idea off the week (Dani, 16 Oct: "I seem to be losing prompts"). An
    // empty day is an empty day whatever else is going on, so they fill as
    // soon as the week itself has loaded. The others still report in, for
    // anything that wants to know.
    const quiet = {};
    let startersDone = false;
    function reportQuiet(key, isQuiet) {
      quiet[key] = isQuiet;
      if (key !== 'posts' || startersDone) return;
      const box = document.getElementById('ws-starters');
      if (!box) return;
      startersDone = true;
      fillStarterDays(box);
    }

    // Monday-based week number, used only to rotate the third card - so a
    // member does not see the same suggestion every week they are quiet.
    function weekIndex(d) {
      const t = new Date(d.getFullYear(), d.getMonth(), d.getDate());
      t.setDate(t.getDate() - ((t.getDay() + 6) % 7));
      return Math.floor((t - new Date(t.getFullYear(), 0, 1)) / 604800000);
    }
    const ymdOf = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    // Starter ideas are written INTO the empty day cards, not in a row beneath
    // them. A week nobody has touched is otherwise seven identical white boxes,
    // which is the worst thing a new member can open.
    async function fillStarterDays(box) {
      const PROMPTS = await loadPrompts(supabase);
      // The newest members' piece, read now rather than at the last deploy.
      try {
        const { data: latest } = await supabase.from('blog_posts').select('slug,title')
          .eq('status', 'published').in('audience', ['members', 'both'])
          .order('publish_date', { ascending: false }).limit(1);
        if (latest && latest[0] && box) {
          box.setAttribute('data-blog-title', latest[0].title || '');
          box.setAttribute('data-blog-href', '/account/blog#' + latest[0].slug);
        }
      } catch (_) {}
      const all = [...document.querySelectorAll('.ws-week .ws-day')];
      if (!all.length) return;
      // From today onwards: there is no use suggesting Monday's post on
      // Thursday. Falls back to the whole week if today is not in it.
      const todayAt = all.findIndex((d) => d.classList.contains('is-today'));
      const from = todayAt < 0 ? 0 : todayAt;
      const targets = all.slice(from).filter((d) => d.classList.contains('ws-day--empty')).slice(0, 3);
      if (!targets.length) return;

      const wk = weekIndex(new Date());
      const dated = upcomingFrom(PROMPTS.days, new Date(), 8);

      // Occasions first, wherever they fall. A dated hook is the best thing we
      // have to offer and must not be displaced by a card that happens to sit
      // last - which is exactly what used to happen to World Photography Day.
      const spare = [];
      targets.forEach((card) => {
        const occasion = dated.find((d) => ymdOf(d.when) === card.getAttribute('data-date'));
        if (occasion) {
          paintStarter(card, { flag: occasion.name, title: occasion.angle, hint: occasion.brief || occasion.hint,
            cta: occasion.video ? 'Design the cover' : 'Design this post',
            href: `/account/editor?blank=${canvasForPrompt(occasion)}&prompt=${keyForDay(occasion)}` });
        } else {
          spare.push(card);
        }
      });

      // Of what is left, the last points somewhere useful rather than at a
      // post, and rotates weekly so a quiet fortnight does not repeat itself.
      spare.forEach((card, i) => {
        if (i === spare.length - 1 && (spare.length > 1 || targets.length === 1)) {
          const blog = box && box.getAttribute('data-blog-title');
          const blogHref = (box && box.getAttribute('data-blog-href')) || '/account/blog';
          const rot = wk % 3;
          paintStarter(card, rot === 0
            ? { flag: 'The Edit', title: 'Browse the template shop', hint: 'Packs built for estate agents.', cta: 'View templates', href: '/edit' }
            : (rot === 1 && blog)
              ? { flag: 'From the blog', title: blog, hint: 'A few minutes, something you can use.', cta: 'Read it', href: blogHref, blog: true }
              : { flag: 'Learn', title: 'Get more out of the hub', hint: 'Short guides on content and reach.', cta: 'Start a guide', href: '/account/guides' });
          return;
        }
        const pool = PROMPTS.evergreen;
        if (!pool.length) return;
        const pr = pool[(wk + i) % pool.length];
        paintStarter(card, { flag: 'Idea ready', title: pr[0], hint: pr[1],
          cta: pr[2] ? 'Design the cover' : 'Design this post',
          href: `/account/editor?blank=${pr[2] ? '1080x1920' : '1'}&prompt=${keyForEvergreen(pr)}` });
      });
    }

    function paintStarter(card, pick) {
      const head = (card.querySelector('.ws-day-name')?.outerHTML || '') + (card.querySelector('.ws-day-num')?.outerHTML || '');
      card.classList.add('ws-day--idea');
      card.classList.remove('ws-day--empty');
      card.classList.toggle('ws-day--blog', !!pick.blog);
      card.setAttribute('href', pick.href);
      card.innerHTML = `${head}
        <span class="ws-day-flag">${escapeHtml(pick.flag)}</span>
        <span class="ws-day-idea">${escapeHtml(pick.title)}</span>
        <span class="ws-day-hint">${escapeHtml(pick.hint)}</span>
        <span class="ws-day-cta">${escapeHtml(pick.cta)} <em aria-hidden="true">&rarr;</em></span>`;
    }

    // ---- The third hero slot ----
    // Two of the three stats are fixed (posts, bookings); this one is claimed by
    // whatever most needs attention. Everything that can claim it reports in
    // when its own data lands, and the lowest rank on the board wins - so it
    // does not matter which query finishes first.
    const SLOT_ICONS = {
      due:     '<path d="M12 2 2 20h20z"/><line x1="12" y1="9" x2="12" y2="14"/><line x1="12" y1="17" x2="12.01" y2="17"/>',
      gallery: '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/>',
      kit:     '<circle cx="12" cy="12" r="9"/><path d="m8.5 12.2 2.4 2.4 4.6-4.9"/>',
      empty:   '<rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="12" y1="13" x2="12" y2="17"/><line x1="10" y1="15" x2="14" y2="15"/>',
    };
    const slotClaims = [];
    function claimSlot(rank, icon, value, label, href) {
      slotClaims.push({ rank, icon, value, label, href });
      slotClaims.sort((a, b) => a.rank - b.rank);
      const win = slotClaims[0];
      const v = document.getElementById('brief-slot-v');
      const l = document.getElementById('brief-slot-l');
      const ic = document.getElementById('brief-slot-ic');
      const a = document.getElementById('brief-slot');
      if (!v || !l || !ic || !a) return;
      v.textContent = win.value;
      l.textContent = win.label;
      a.setAttribute('href', win.href);
      ic.className = 'ws-brief-ic ws-brief-ic--' + win.icon;
      ic.innerHTML = `<svg viewBox="0 0 24 24">${SLOT_ICONS[win.icon] || ''}</svg>`;
    }

    /* Rank 1: payment due. Counted from the invoices themselves (16 Oct): a
       shoot's, from Bookings, and the social media retainer's, from Your SMM
       - the same two routes those pages use, so what's counted is what they
       show. It used to guess from shoots with no paid date, which missed the
       retainer altogether and counted shoots a package covers, which are never
       "paid". If neither route answers, it falls back to that guess, without
       the package shoots. */
    const DASH_WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');
    async function claimPaymentsDue(session, vid) {
      const get = (route) => fetch(`${DASH_WORKER}${route}`, { headers: { Authorization: 'Bearer ' + session.access_token } })
        .then((r) => (r.ok ? r.json() : null)).catch(() => null);
      const [shootInv, smmInv] = DASH_WORKER ? await Promise.all([get('/booking/invoices/mine'), get('/smm/invoices')]) : [null, null];
      if (!shootInv && !smmInv) {
        const unpaid = vid.filter((b) => !b.paid_at && b.payment_route !== 'smm_package' && b.stage && b.stage !== 'booked');
        reportQuiet('due', unpaid.length === 0);
        if (unpaid.length) claimSlot(1, 'due', `${unpaid.length} payment${unpaid.length === 1 ? '' : 's'}`, 'due on your shoots', '/account/bookings');
        return;
      }
      const open = (j) => ((j && j.invoices) || []).filter((i) => i.status === 'sent');
      const shoots = open(shootInv), retainer = open(smmInv);
      const n = shoots.length + retainer.length;
      reportQuiet('due', n === 0);
      if (!n) return;
      const label = !shoots.length ? 'due for your social media' : !retainer.length ? 'due on your shoots' : 'to pay';
      claimSlot(1, 'due', `${n} invoice${n === 1 ? '' : 's'}`, label, shoots.length ? '/account/bookings' : '/account/social');
    }

    // A gallery waiting comes off the bookings we already fetch.
    function claimFromBookings(vid) {
      const live = vid.filter((b) => b.gallery_url && b.gallery_sent_at);
      if (live.length) {
        const exp = live.map((b) => b.gallery_expires_on).filter(Boolean).sort()[0];
        const days = exp ? Math.ceil((new Date(exp).getTime() - Date.now()) / 86400000) : null;
        claimSlot(2, 'gallery', live.length === 1 ? 'Gallery ready' : `${live.length} galleries`,
          days && days > 0 ? `${days} days to download` : 'ready to download', '/account/bookings');
      }
    }

    /* The seasonal-content card names the month the hub is working on, and
       opens the planner there. It used to always name NEXT month, so on the
       7th of October it read November — a month nobody was planning yet.
       The hand-over is the 21st: the 1st to the 20th is this month, the 21st
       onward is the next one (Dani, 8 Oct).
       The picture is seasonal too. Only the months we have artwork for are
       listed; any other month keeps the still already on the card. */
    /* Only the Content Calendar card follows the month. The Studio page has a
       "Seasonal moments" card too — that one is the seasonal PACK and is left
       alone deliberately; don't wire it to this. */
    const CAL_ART = {
      9:  'October Content - Dashboard.png',    // getMonth() is 0-based
      10: 'November Content - Dashboard.png',
      11: 'December Content - Dashboard.png',
    };
    (function wireCalendarMonth() {
      const card = document.getElementById('ws-news-cal');
      const head = document.getElementById('ws-news-cal-h');
      if (!card || !head) return;
      const now = new Date();
      const m = new Date(now.getFullYear(), now.getMonth() + (now.getDate() >= 21 ? 1 : 0), 1);
      // Two lines on a desktop, like its neighbours: "October Content / Calendar".
      head.innerHTML = m.toLocaleDateString('en-GB', { month: 'long' }) + ' Content <br class="ws-br-desk" />Calendar';
      card.setAttribute('href', `/account/schedule?view=posts&focus=${m.getFullYear()}-${String(m.getMonth() + 1).padStart(2, '0')}`);
      const art = CAL_ART[m.getMonth()];
      const slot = card.querySelector('.ws-news-art');
      if (slot) {
        slot.style.backgroundImage = art ? `url('https://assets.tmke.co.uk/TMKE%20Member%20Hub/${encodeURIComponent(art)}')` : "url('/assets/home%20kitchen.jpg')";
      }
    })();

    // The date above the name. Set on load and not touched again - nobody has
    // this page open across midnight often enough to justify a timer.
    (function wireHeroDate() {
      const el = document.getElementById('ws-hero-date');
      if (!el) return;
      el.textContent = new Date().toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
    })();

    async function initBookingsWidget(session) {
      let items = [];
      const now = Date.now();
      if (session) {
        const email = session.user.email ?? '';
        // The page waits for the payment count, so the stat doesn't change
        // after it's on show (the entrance caps any wait at 3 seconds).
        const releaseDue = window.__tmkeEnterHold ? window.__tmkeEnterHold() : null;
        let dueAsked = false;
        try {
          const [v, s] = await Promise.all([
            supabase.from('videography_bookings').select('id, service, service_type, shoot_date, stage, postcode, paid_at, payment_route, gallery_url, gallery_sent_at, gallery_expires_on').or(`account_user_id.eq.${session.user.id},client_email.eq.${email}`),
            supabase.from('smm_leads').select('id, call_at, stage').eq('kind', 'discovery').or(`account_user_id.eq.${session.user.id},email.eq.${email}`),
          ]);
          const vid = (v.data || []).map((r) => ({ source: 'videography', id: r.id, title: r.service || 'Videography booking', service_type: r.service_type, when: r.shoot_date, stage: r.stage, postcode: r.postcode, paid_at: r.paid_at, payment_route: r.payment_route, gallery_url: r.gallery_url, gallery_sent_at: r.gallery_sent_at, gallery_expires_on: r.gallery_expires_on }));
          claimFromBookings(vid);
          dueAsked = true;
          claimPaymentsDue(session, vid).finally(() => releaseDue && releaseDue());
          const smm = (s.data || []).map((r) => ({ source: 'smm', id: r.id, title: 'Social media discovery call', service_type: 'discovery', when: r.call_at, stage: r.stage || 'discovery_call_booked' }));
          items = vid.concat(smm);
        } catch (_) {}
        if (!dueAsked && releaseDue) releaseDue();
      } else {
        items = [
          { source: 'videography', id: 'demo-1', title: 'Property shoot', service_type: 'property', when: new Date(now + 6 * 86400000).toISOString(), stage: 'booked', postcode: 'NN1 1AA' },
          { source: 'videography', id: 'demo-3', title: 'Content Studio session', service_type: 'content', when: new Date(now + 9 * 86400000).toISOString(), stage: 'booked' },
          { source: 'smm', id: 'demo-2', title: 'Social media discovery call', service_type: 'discovery', when: new Date(now + 2 * 86400000).toISOString(), stage: 'discovery_call_booked' },
        ];
      }
      items = items
        .filter((b) => b.stage !== 'cancelled' && b.when && new Date(b.when).getTime() > now)
        .sort((a, b) => new Date(a.when) - new Date(b.when));
      renderBookings(items);
    }

    (async () => {
      try {
        const isDemo = import.meta.env.DEV || demoOn();
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) {
          // Live workspace — require sign-in. (Dev ?demo=1 still previews the mock.)
          if (!isDemo) { location.replace('/login?next=' + encodeURIComponent('/account')); return; }
          initBookingsWidget(null);
          return;
        }
        // getSession() is local-only - a cleared/revoked session can still
        // look valid to it. Confirm with the server before letting anyone in.
        if (!isDemo) {
          const { data: { user }, error } = await supabase.auth.getUser();
          if (!user || error) { location.replace('/login?next=' + encodeURIComponent('/account')); return; }
        }
        initBookingsWidget(session);
        // The cached brand kit must be this login's; a stranger's is dropped
        // (and the page redrawn) before anything reads it.
        adoptBrandCacheOrReload(session.user.id);
        if (await claimDemoBrandKit(supabase, session.user.id)) { location.reload(); return; }
        // A new device has no kit cached, and the brand tiles have already been
        // drawn from that empty cache ("not set up yet"). Fetch it, and if one
        // arrives, redraw once - the next visit reads it straight from cache.
        if (await syncBrandCache(supabase, session.user.id)) {
          try {
            if (!sessionStorage.getItem('tmke.brand.synced')) { sessionStorage.setItem('tmke.brand.synced', '1'); location.reload(); return; }
          } catch (_) {}
        }

        const email = session.user.email ?? '';
        const meta = session.user.user_metadata ?? {};
        const fullName = titleCase(meta.name || email.split('@')[0].replace(/[._]/g, ' '));
        const firstName = fullName.split(' ')[0];
        const initials = fullName.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase() || 'T';

        const hour = new Date().getHours();
        // Sentence case: the name is the capital that matters on this line.
        let greeting = 'Welcome back';
        if (hour >= 5 && hour < 12) greeting = 'Good morning';
        else if (hour >= 12 && hour < 17) greeting = 'Good afternoon';
        else if (hour >= 17 && hour < 22) greeting = 'Good evening';
        else greeting = 'Burning the midnight oil';

        const gLine = document.querySelector('.ws-greet-line');
        const gName = document.querySelector('.ws-greet-name');
        if (gLine) gLine.textContent = greeting + ',';
        if (gName) gName.textContent = firstName + '.';
        { const gH = document.querySelector('.ws-greeting'); if (gH) gH.style.visibility = ''; }

        document.querySelectorAll('.ws-whoav').forEach((e) => { e.textContent = initials; });
        const setText = (sel, val) => { const el = document.querySelector(sel); if (el && val) el.textContent = val; };
        setText('.ws-whotext strong', fullName);
        setText('.ws-whotext span', email);
        setText('.ws-dropdown-head strong', fullName);
        setText('.ws-dropdown-head span', email);

        // Headshot from the brand kit, if they've set one.
        try {
          const bk = JSON.parse(localStorage.getItem('tmke.brand') || 'null');
          if (bk && typeof bk.headshot === 'string' && bk.headshot) {
            document.querySelectorAll('.ws-whoav').forEach((e) => {
              e.textContent = '';
              e.style.backgroundImage = 'url(' + JSON.stringify(bk.headshot) + ')';
              e.style.backgroundSize = 'cover';
              e.style.backgroundPosition = 'center';
            });
          }
        } catch (_) {}
      } catch (_) { /* keep the mock preview on any error */ }
    })();

    // ---- Stage A.2: real recent designs (local editor drafts) ----
    function readLocalDrafts() {
      const drafts = [];
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (!key || !key.startsWith('tmke.editor.')) continue;
          const id = key.replace('tmke.editor.', '');
          try {
            const v = JSON.parse(localStorage.getItem(key) || 'null');
            if (!v) continue;
            drafts.push({ id, filename: v.filename || id, savedAt: v.savedAt || 0, thumb: v.thumb || null });
          } catch (_) {}
        }
      } catch (_) {}
      drafts.sort((a, b) => b.savedAt - a.savedAt);
      return drafts;
    }
    const fmtSaved = (ts) => ts ? new Date(ts).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Saved locally';
    const editHref = (id) => '/account/editor?design=' + encodeURIComponent(id);

    // Recent designs = the member's saved copies (user_designs), newest first —
    // the SAME source as the Studio's "Your designs", so the two line up.
    (async function wireWork() {
      let designs = [];
      try {
        // A member's own, or the training account's (src/lib/design-store.js).
        const store = await designStore();
        if (store && !store.blocked) {
          const { data } = await store.db
            .from(store.table)
            .select('id, name, thumb_url, updated_at')
            .eq('user_id', store.uid)
            .order('updated_at', { ascending: false })
            .limit(4);
          designs = data || [];
        }
      } catch (_) {}
      const resume = document.getElementById('ws-resume');
      const rn = document.getElementById('ws-resume-name');
      // Nothing saved yet: the card is the way into the packs instead.
      if (!designs.length) {
        if (rn && rn.textContent.trim() === '') rn.textContent = 'Start from one of your packs.';
        return;
      }

      // Hero preview = the most recently edited design.
      const top = designs[0];
      const name = top.name || 'Untitled design';
      const heroImg = document.querySelector('.ws-hero-preview img');
      const heroTitle = document.querySelector('.ws-hero-preview-foot h3');
      const heroLink = document.querySelector('.ws-hero-preview');
      const heroProg = document.querySelector('.ws-hero-progress');
      const heroCta = document.querySelector('.ws-hero-cta-btn');
      if (top.thumb_url && heroImg) { heroImg.src = top.thumb_url; heroImg.alt = name; }
      if (heroTitle) heroTitle.textContent = name;
      if (heroLink) heroLink.setAttribute('href', editHref(top.id));
      if (heroProg) heroProg.innerHTML = `<span class="ws-hero-pct">Last edited ${escapeHtml(fmtSaved(top.updated_at))}</span>`;

      // Continue design = the most recently edited design. Its picture fades
      // in once it has loaded, so the card never shows a broken one.
      if (resume) {
        resume.setAttribute('href', editHref(top.id));
        if (rn) rn.textContent = name;
        const img = document.getElementById('ws-resume-img');
        if (top.thumb_url && img) {
          const pre = new Image();
          pre.onload = () => {
            // A landscape design doesn't sit in a portrait card: plain wine
            // instead. Portrait and square ones show (Dani, 16 Oct).
            if (pre.naturalWidth > pre.naturalHeight * 1.02) { resume.classList.add('is-wine'); return; }
            img.style.backgroundImage = `url('${top.thumb_url}')`; resume.classList.add('has-img');
          };
          pre.src = top.thumb_url;
        }
      }
    })();

    // ---- Stage A.5: real Brand Health (from the saved brand kit) ----
    (function wireBrandHealth() {
      let brand;
      try { brand = JSON.parse(localStorage.getItem('tmke.brand') || 'null'); } catch (_) { brand = null; }
      // Nothing saved at all is the strongest case for showing the tile, not a
      // reason to stay quiet - so claim first, then bail out of the widget work.
      if (!brand) { claimSlot(3, 'kit', 'Brand kit', 'not set up yet', '/account/profile'); return; }

      const hasLogo = (brand.logos || []).length > 0;
      const hasColours = (brand.colors || []).filter((c) => c && c.hex).length > 0;
      const hasFonts = !!(brand.fonts && (brand.fonts.heading || brand.fonts.subheading || brand.fonts.body));
      // The brand-health widget is gone; the hero slot carries its state, but
      // only while there is something to finish. Once it is done it drops to
      // the fallback rank, where it shows only if nothing else is asking.
      const kitDone = [hasLogo, hasColours, hasFonts].filter(Boolean).length;
      if (kitDone < 3) claimSlot(3, 'kit', 'Brand kit', `${kitDone} of 3 done`, '/account/profile');
      else claimSlot(9, 'kit', 'Brand kit', 'complete', '/account/profile');
      const items = [...document.querySelectorAll('.ws-journey li')];
      if (items.length < 3) return;
      items[0].classList.toggle('is-done', hasLogo);
      items[1].classList.toggle('is-done', hasColours);
      items[2].classList.toggle('is-done', hasFonts);
      // Social connections aren't wired to a live source yet → show as to-do.
      items.slice(3).forEach((li) => li.classList.remove('is-done'));

      const done = items.filter((li) => li.classList.contains('is-done')).length;
      const pct = Math.round((done / items.length) * 100);
      // Hand the real % to the same observer that animates the ring + number.
      const ring = document.querySelector('.ws-ring-fg');
      if (ring) ring.setAttribute('data-ring', String(pct));
      const num = document.querySelector('.ws-ring b');
      if (num) num.setAttribute('data-count', String(pct));
    })();

    // ---- Stage A.4: real planner (this week from calendar_items) ----
    (async function wirePlanner() {
      try {
        // A member's week, or the training account's (Dani's login).
        const acct = await plannerStore();
        if (!acct || acct.blocked) return; // signed out → keep the mock week

        const ymd = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        const now = new Date();
        const monday = new Date(now);
        monday.setDate(now.getDate() - ((now.getDay() + 6) % 7)); // back to Monday
        monday.setHours(0, 0, 0, 0);
        const weekEnd = new Date(monday); weekEnd.setDate(monday.getDate() + 7); // Mon..Sun

        const { data, error } = await acct.db
          .from(acct.table)
          .select('*')
          .eq('user_id', acct.uid)
          .gte('scheduled_date', ymd(monday))
          .lt('scheduled_date', ymd(weekEnd))
          .in('status', ['scheduled', 'reminder_sent', 'done'])
          .order('scheduled_date', { ascending: true });
        if (error) return;

        /* One entry per day: a post with its picture if the day has one,
           otherwise the first thing planned (the Planner is a marketing
           calendar now -- a canvassing round has no picture, Dani, 15 Oct). */
        const byDate = {};
        (data || []).forEach((it) => {
          if (!it.scheduled_date) return;
          const cur = byDate[it.scheduled_date];
          const pic = (x) => !!(x && (x.thumbnail_url || x.asset_url));
          if (!cur || (!pic(cur) && pic(it))) byDate[it.scheduled_date] = it;
        });

        const week = document.querySelector('.ws-week');
        if (!week) return;
        const todayYmd = ymd(new Date());
        const names = ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'];
        week.innerHTML = names.map((nm, i) => {
          const d = new Date(monday); d.setDate(monday.getDate() + i);
          const dYmd = ymd(d);
          const isToday = dYmd === todayYmd ? ' is-today' : '';
          const nameHtml = `<span class="ws-day-name">${nm}${dYmd === todayYmd ? ' <i>Today</i>' : ''}</span><span class="ws-day-num">${d.getDate()}</span>`;
          const dateAttr = ` data-date="${dYmd}"`;
          const it = byDate[dYmd];
          // An activity opens the Marketing Planner; a post, or no post yet, the Content Calendar.
          const href = `/account/schedule?${it && it.activity && it.activity !== 'social_post' ? '' : 'view=posts&'}focus=${dYmd}`;
          if (it) {
            const thumb = it.thumbnail_url || it.asset_url || '';
            // The card shows the date and the picture; what the post actually
            // is lives in the tooltip, because seven of these across one line
            // has no room for a title without shrinking the date.
            const label = it.title || it.caption || it.content_type || it.name || 'Scheduled';
            if (!thumb && it.activity && it.activity !== 'social_post') {
              return `<a class="ws-day ws-day--act${isToday}" href="${href}"${dateAttr} title="${escapeHtml(String(label))}">${nameHtml}<span class="ws-day-act">${escapeHtml(String(label))}</span></a>`;
            }
            return `<a class="ws-day${isToday}" href="${href}"${dateAttr} title="${escapeHtml(String(label))}">${nameHtml}<span class="ws-day-thumb"${thumb ? ` style="background-image:url('${escapeHtml(thumb)}')"` : ''}></span></a>`;
          }
          return `<a class="ws-day ws-day--empty${isToday}" href="${href}"${dateAttr}>${nameHtml}<span class="ws-day-empty-msg">No post planned</span></a>`;
        }).join('');

        // A pack that has just gone live takes a day nobody has planned.
        try {
          const { pickNewPackDay } = await import('../../lib/new-pack-card.js');
          const { visibleToMember } = await import('../../lib/pack-access.js');
          const { data: packAll } = await supabase.from('packs').select('*').eq('status', 'active');
          /* Staff can read every brand's packs, so without this the hub could
             announce a Property Experts pack to somebody who is not one. In
             here they are a member like anybody else. */
          let packBrand;
          packBrand = await (await import('../../lib/pack-access.js')).memberBrandsFor(supabase);   // every brand they are in
          const packRows = visibleToMember(packAll || [], packBrand);
          const weekDates = [...week.querySelectorAll('.ws-day')].map((c) => c.getAttribute('data-date'));
          const emptyDates = [...week.querySelectorAll('.ws-day--empty')].map((c) => c.getAttribute('data-date'));
          const pick = pickNewPackDay({ packs: packRows || [], weekDates, emptyDates, todayYmd });
          if (pick) {
            const card = week.querySelector(`.ws-day[data-date="${pick.date}"]`);
            if (card) paintStarter(card, pick);
          }
        } catch (_) { /* the week is fine without it */ }

        // Hero brief: live count of posts scheduled this week.
        const schedCount = (data || []).length;
        const sb = document.getElementById('brief-sched');
        if (sb) sb.textContent = schedCount ? `${schedCount} post${schedCount === 1 ? '' : 's'}` : 'No posts';
        reportQuiet('posts', schedCount === 0);

        // Days still to come this week with nothing on them. Counted forward
        // from today, because a gap on Monday is not something anyone can act
        // on by Thursday.
        let empty = 0;
        for (let i = 0; i < 7; i++) {
          const d = new Date(monday); d.setDate(monday.getDate() + i);
          const k = ymd(d);
          if (k >= todayYmd && !byDate[k]) empty++;
        }
        if (empty) claimSlot(4, 'empty', `${empty} empty day${empty === 1 ? '' : 's'}`, 'left this week', '/account/schedule');
      } catch (_) { /* keep the mock week */ }
    })();

    // ---- Chapter 03: the reel of designs (src/lib/pack-reel.js) ----
    (async function wireReel() {
      const reel = document.getElementById('ws-reel');
      if (!reel) return;
      const { fillPackReel } = await import('../../lib/pack-reel.js');
      // One from each pack in turn: never two of a pack side by side.
      const ok = await fillPackReel(supabase, reel, { runs: [1], perPack: 4 });
      if (!ok) reel.closest('.ws-inspire')?.classList.add('is-no-reel');
    })();

    // The Your packs door's hover picture: a template from the demo pack, the
    // "New to Market" one where there is one (Dani's pick for that pack).
    (async function wireDoorPack() {
      const slot = document.getElementById('ws-door-pack-img');
      if (!slot) return;
      try {
        const { data: packs } = await supabase.from('packs').select('id').eq('demo', true).eq('status', 'active').limit(1);
        const id = packs && packs[0] && packs[0].id;
        if (!id) return;
        const { data: tpls } = await supabase.from('templates').select('name, thumb_url').eq('pack_id', id).eq('status', 'active').order('sort_order', { ascending: true });
        const pick = (tpls || []).find((t) => /new to market/i.test(t.name || '') && t.thumb_url) || (tpls || []).find((t) => t.thumb_url);
        if (pick) slot.style.backgroundImage = `url('${pick.thumb_url}')`;
      } catch (_) {}
    })();

    // Back to top, smoothly where the page scrolls smoothly.
    document.querySelector('[data-to-top]')?.addEventListener('click', (e) => {
      e.preventDefault();
      if (window.__lenis && window.__lenis.scrollTo) window.__lenis.scrollTo(0); else scrollTo({ top: 0, behavior: 'smooth' });
    });

    // ---- Chapter 04: Learn, a folder ----
    (function wireFolder() {
      const box = document.querySelector('[data-folder]');
      if (!box) return;
      const tabs = [...box.querySelectorAll('[data-folder-tab]')];
      const slides = [...box.querySelectorAll('.ws-folder-slide')];
      const track = box.querySelector('[data-folder-track]');
      // The blog's line names the newest piece, read now rather than at the last deploy.
      (async () => {
        try {
          const { data } = await supabase.from('blog_posts').select('slug,title')
            .eq('status', 'published').in('audience', ['members', 'both'])
            .order('publish_date', { ascending: false }).limit(1);
          const post = data && data[0];
          if (!post) return;
          box.querySelector('[data-blog]')?.setAttribute('href', '/account/blog#' + post.slug);
          if (post.title) box.querySelectorAll('[data-blog-sum]').forEach((el) => { el.textContent = post.title; });
        } catch (_) {}
      })();
      const go = (i, focus) => {
        tabs.forEach((t, j) => {
          const on = j === i;
          t.classList.toggle('is-on', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
          t.tabIndex = on ? 0 : -1;
        });
        slides.forEach((sl, j) => {
          if (j === i) { sl.removeAttribute('aria-hidden'); sl.removeAttribute('tabindex'); }
          else { sl.setAttribute('aria-hidden', 'true'); sl.tabIndex = -1; }
        });
        track.style.transform = `translateX(${-i * 100}%)`;
        if (focus) tabs[i].focus();
        // A tab scrolled out of sight on a phone comes into view.
        const strip = tabs[i].parentElement;
        strip.scrollTo({ left: Math.max(0, tabs[i].offsetLeft - 16), behavior: 'smooth' });
      };
      tabs.forEach((t, i) => t.addEventListener('click', () => go(i)));
      box.querySelector('[role="tablist"]').addEventListener('keydown', (e) => {
        const at = tabs.findIndex((t) => t.classList.contains('is-on'));
        if (e.key === 'ArrowRight') { e.preventDefault(); go((at + 1) % tabs.length, true); }
        if (e.key === 'ArrowLeft') { e.preventDefault(); go((at - 1 + tabs.length) % tabs.length, true); }
      });
    })();

    // The full-width card is a guide (Chapter 04), not a pack, so nothing
    // fetches into it any more - the old wireDiscovery would have replaced its
    // title, art and link with whatever pack sorted first.

  </script>


  <script>
    // ===== Contextual coach =====
    // Picks the single most relevant, not-yet-dismissed tip from a prioritised
    // rule list, anchors it to the related element, and shows it once the
    // entrance settles. State is read locally (drafts / brand kit) so it works
    // signed-out in the preview; remembers dismissals in localStorage. The rule
    // shape (id / when / target / text) is ready for Claude to fill `text` later.
    (function coach() {
      const coach = document.getElementById('ws-coach');
      const msgEl = document.getElementById('ws-coach-msg');
      const xBtn = document.getElementById('ws-coach-x');
      if (!coach || !msgEl) return;

      const SEEN_KEY = 'tmke.coach.seen';
      let seen = [];
      try { seen = JSON.parse(localStorage.getItem(SEEN_KEY) || '[]'); } catch (_) {}

      const hasDraft = (() => {
        try { for (let i = 0; i < localStorage.length; i++) { const k = localStorage.key(i); if (k && k.startsWith('tmke.editor.')) return true; } } catch (_) {}
        return false;
      })();
      const brand = (() => { try { return JSON.parse(localStorage.getItem('tmke.brand') || 'null'); } catch (_) { return null; } })();
      const brandDone = !!(brand && (brand.logos || []).length && (brand.colors || []).some((c) => c && c.hex) && brand.fonts && (brand.fonts.heading || brand.fonts.subheading || brand.fonts.body));

      const RULES = [
        { id: 'brand-health', when: () => !brandDone, target: '.ws-textlink--accent', text: 'Finishing your Brand Kit means every design comes out on-brand automatically — worth a couple of minutes.' },
        { id: 'continue-draft', when: () => hasDraft, target: '.ws-resume', text: 'Continue design takes you straight back to your most recent design.' },
        // The Chapter 03 card, which reads "Get started - open a template in the
        // Studio" for anyone without a draft. The top-nav tab it used to point
        // at is hidden on a phone, and a bubble anchored to a hidden element
        // floats at the top of the page pointing at nothing.
        { id: 'first-studio', when: () => !hasDraft, target: '.ws-resume', text: 'New here? Hop into Studio to make your first design — it only takes a minute.' },
        { id: 'prompt-hint', when: () => true, target: '.ws-iconround', text: "Not feeling today's prompt? Tap here for another idea." },
        { id: 'schedule', when: () => true, target: '#plan-h', text: "Nothing planned yet this week — a midweek post tends to land well." },
      ];

      // A target has to be on screen, not merely in the DOM: a breakpoint that
      // hides an element leaves it findable and zero-sized.
      const onScreen = (el) => {
        if (!el || !el.getClientRects().length) return false;
        const b = el.getBoundingClientRect();
        // And inside the window: on a phone the doors are a swipe strip, and
        // Continue design starts off its right-hand edge.
        return b.width > 0 && b.height > 0 && b.left >= 0 && b.right <= document.documentElement.clientWidth;
      };
      const pick = RULES.find((r) => !seen.includes(r.id) && r.when() && onScreen(document.querySelector(r.target)));
      if (!pick) return;
      const target = document.querySelector(pick.target);
      msgEl.textContent = pick.text;

      function place() {
        coach.hidden = false;
        const r = target.getBoundingClientRect();
        const vw = document.documentElement.clientWidth;
        // Hung underneath, a bubble pointing at a big picture card lands in the
        // middle of whatever comes next - the section below it on a phone, the
        // Chapter 04 banner on a desktop. A card that size has room to hold the
        // bubble, so tuck it into the target's own top-right corner. Small
        // targets - a link, a round button, a heading - keep the arrow below.
        const corner = r.height >= 180 && r.width >= 260;
        // Set the class before measuring: the corner bubble is the narrower of
        // the two, and the old width put it 30px in from where it belongs.
        coach.classList.toggle('is-corner', corner);
        if (corner) {
          // Absolute, so relative to the nearest positioned ancestor rather
          // than to the page. Subtract that corner or every inset is off by it.
          const host = coach.offsetParent;
          const o = host ? host.getBoundingClientRect() : { top: -window.scrollY, left: -window.scrollX };
          const cw0 = coach.offsetWidth;
          coach.style.top = (r.top - o.top + 12) + 'px';
          const leftVp = Math.max(12, Math.min(r.right - cw0 - 12, vw - cw0 - 12));
          coach.style.left = (leftVp - o.left) + 'px';
          coach.style.removeProperty('--arrow-x');
          return;
        }
        const cx = r.left + r.width / 2 + window.scrollX;
        coach.style.top = (r.bottom + window.scrollY + 12) + 'px';
        coach.style.left = '0px';
        const cw = coach.offsetWidth;
        const maxLeft = vw - cw - 16;
        const left = Math.max(16, Math.min(cx - cw / 2, maxLeft));
        coach.style.left = left + 'px';
        coach.style.setProperty('--arrow-x', Math.max(16, Math.min(cx - left, cw - 16)) + 'px');
      }
      function dismiss() {
        coach.classList.remove('is-in');
        setTimeout(() => { coach.hidden = true; }, 320);
        if (!seen.includes(pick.id)) { seen.push(pick.id); try { localStorage.setItem(SEEN_KEY, JSON.stringify(seen)); } catch (_) {} }
      }
      xBtn?.addEventListener('click', dismiss);
      window.addEventListener('resize', () => { if (!coach.hidden) place(); });

      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      setTimeout(() => { place(); requestAnimationFrame(() => coach.classList.add('is-in')); }, reduce ? 400 : 3300);
    })();
  </script>
  <!-- Their brand may have changed since they were last here. Runs on arrival,
       updates only what they have not made their own, and asks rather than
       assumes for anyone who built their kit before brand kits existed. -->
  <BrandKitOffer />

</BaseLayout>
