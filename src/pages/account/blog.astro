---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import BlogPanel from "../../components/account/BlogPanel.astro";
import "../../styles/workspace.css";
import "../../styles/account-sections.css";
---

<BaseLayout
  dashboard
  title="Inside The Edit — members blog"
  description="Member-exclusive deep dives on platform changes, tactics that are working right now, and what we're testing behind the scenes."
  hideNav
  hideFooter
>
  <WorkspaceHeader active="blog" />
  <div class="dash-shell dash-shell--top">
    <main class="app-main dash-main">
      <BlogPanel />
    </main>
  </div>

  <script>
    import { supabase, signOutEverywhere} from "../../lib/supabase.js";
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        if (!import.meta.env.DEV) location.replace('/login?next=' + encodeURIComponent('/account/blog'));
        return;
      }
      // getSession() is local-only - a cleared/revoked session can still look
      // valid to it. Confirm with the server before letting anyone in.
      if (!import.meta.env.DEV) {
        const { data: { user }, error } = await supabase.auth.getUser();
        if (!user || error) { location.replace('/login?next=' + encodeURIComponent('/account/blog')); return; }
      }
      requestAnimationFrame(() => document.body.classList.add('is-loaded'));
      document.getElementById('app-signout')?.addEventListener('click', async () => {
        await signOutEverywhere();
      });
    })();
  </script>
</BaseLayout>
