---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import HubFootBar from "../../components/account/HubFootBar.astro";
import "../../styles/ws-system.css";
import { getImage } from "astro:assets";
import { TEAM, TMKE_SOCIALS } from "../../data/tmke-team.js";

// ---------------------------------------------------------------------------
// The Community (Dani, 17 Oct 2026): "the element of community is something
// that I always wanted to include in this hub. It feels very people-driven."
//
//   Chapter 01  This fortnight -- a topic we set every two weeks; members talk
//               under it and we join in with advice and feedback.
//   Chapter 02  Meet the team -- the three of us, each a pop-out with the
//               website's bio and 20 questions (src/data/tmke-team.js).
//   Chapter 03  Conversations -- open talk about estate agency marketing.
//   Chapter 04  Requests -- something to add or change. Others say "I need
//               this too", so we can see how many want what. The Help
//               Centre's Feedback card comes here.
//
// Posts go live straight away; we can hide any of them (/admin/community).
// Members show as "Sarah H." unless they choose their full name and agency.
// Schema and rules: supabase/community.sql.
// ---------------------------------------------------------------------------

// Meet the team: the website's portraits are 20-30 MB PNGs, so each is cut
// down to a 3:4 WebP at build, as on the About page.
const team = await Promise.all(TEAM.map(async (m) => ({
  ...m,
  pic: (await getImage({ src: m.photo, width: 600, height: 800, quality: 72, format: "webp" })).src,
  questions: m.questions.filter((x) => x.a && x.a.trim()),
})));
const socials = TMKE_SOCIALS.filter((s) => s.href);
const TEAM_TINTS = ["#7e6765", "#B9826A", "#969AB0"];

const CATEGORIES = ["Studio", "Packs & templates", "Planner", "Training", "Shoots & video", "Socials", "Something else"];
---
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Community — TMKE"
  readyGate
  description="Talk estate agency marketing with other members, join this fortnight's topic, and tell us what to build next."
>
  <div class="ws">
    <WorkspaceHeader active="community" />

    <main class="ws-main">
      <div class="ws-left">
      <section class="ws-hero ws-hero--sub" data-gate="hero">
        <div class="ws-hero-copy">
          <p class="ws-hero-date"><a href="/account" class="cm-back">&larr; Workspace</a></p>
          <h1 class="ws-greeting">The Community.</h1>
          <p class="ws-hero-sub">Talk estate agency marketing with other members, join this fortnight&rsquo;s topic, and tell us what to build next.</p>
          <div class="ws-hero-cta cm-cta">
            <button type="button" class="ws-btn ws-btn--primary" data-cm-new="discussion">Start a conversation
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
            </button>
          </div>
          <ul class="ws-brief cm-brief">
            <li><a class="ws-brief-slot" href="#cm-topic-h">
              <span class="ws-brief-ic ws-brief-ic--sched"><svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
              <span class="ws-brief-tx"><strong>This fortnight</strong><span>the topic we&rsquo;re all on</span></span>
            </a></li>
            <li><a class="ws-brief-slot" href="#requests">
              <span class="ws-brief-ic ws-brief-ic--sched"><svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/></svg></span>
              <span class="ws-brief-tx"><strong>Requests</strong><span>what members want next</span></span>
            </a></li>
            <li><button type="button" class="ws-brief-slot cm-brief-btn" data-cm-me>
              <span class="ws-brief-ic ws-brief-ic--sched"><svg viewBox="0 0 24 24"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg></span>
              <span class="ws-brief-tx"><strong>How you appear</strong><span data-cm-me-name></span></span>
            </button></li>
          </ul>
        </div>
      </section>

      <!-- ============ CHAPTER 01 — THIS FORTNIGHT ============ -->
      <section class="ws-block" aria-labelledby="cm-topic-h" data-gate="topic">
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="cm-topic-h"><span class="ws-block-ch">Chapter 01</span>This fortnight</h2>
        </header>
        <div data-cm-topic></div>
      </section>

      <!-- ============ CHAPTER 02 — MEET THE TEAM ============ -->
      <!-- The dashboard's "New in the Studio" layout (Dani, 17 Oct): our
           socials on the left, the three of us on the right. -->
      <section class="ws-block" aria-labelledby="cm-team-h">
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="cm-team-h"><span class="ws-block-ch">Chapter 02</span>Meet the TMKE team</h2>
        </header>
        <div class="ws-wn">
          <div class="ws-wn-col ws-wn-col--keys">
            <p class="ws-wn-label">Explore</p>
            <nav class="ws-wn-pills" aria-label="TMKE elsewhere">
              <!-- Our socials on one line, About and Talk to us on the next (Dani, 17 Oct). -->
              {socials.length > 0 && <span class="ws-wn-row">{socials.map((s) => <a class="ws-wn-pill" href={s.href} target="_blank" rel="noopener">{s.label}</a>)}</span>}
              <span class="ws-wn-row"><a class="ws-wn-pill" href="/about" target="_blank" rel="noopener">About TMKE</a><a class="ws-wn-pill" href="/account/contact">Talk to us</a></span>
            </nav>
          </div>
          <div class="ws-wn-col">
            <p class="ws-wn-label">Meet the team</p>
            <div class="ws-wn-cards">
              {team.map((m, i) => (
                <button type="button" class="ws-wn-card cm-team-card" data-team={m.key} style={`--wn: color-mix(in srgb, ${TEAM_TINTS[i % 3]} ${i === 1 ? 30 : i === 2 ? 32 : 26}%, #fff)`}>
                  <span class="ws-wn-art" style={`background-image:url('${m.pic}'); background-position: center 20%`}></span>
                  <span class="ws-wn-tx">
                    <span class="ws-wn-flag">{m.role}</span>
                    <strong class="ws-wn-h">{m.name}</strong>
                  </span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </section>

      <!-- ============ CHAPTER 03 — CONVERSATIONS ============ -->
      <section class="ws-block" aria-labelledby="cm-talk-h" data-gate="talk">
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="cm-talk-h"><span class="ws-block-ch">Chapter 03</span>Conversations</h2>
          <button type="button" class="ws-block-link cm-head-btn" data-cm-new="discussion">Start one
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
        </header>
        <div class="cm-list" data-cm-talk></div>
      </section>

      <!-- ============ CHAPTER 03 — REQUESTS ============ -->
      <section class="ws-block" aria-labelledby="cm-req-h" id="requests" data-gate="requests">
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="cm-req-h"><span class="ws-block-ch">Chapter 04</span>Requests</h2>
          <div class="cm-sort" role="group" aria-label="Order" data-cm-sort>
            <button type="button" class="cm-sort-b is-on" data-sort="wanted" aria-pressed="true">Most wanted</button>
            <button type="button" class="cm-sort-b" data-sort="new" aria-pressed="false">Newest</button>
          </div>
          <button type="button" class="ws-block-link cm-head-btn" data-cm-new="request">Ask for something
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
          </button>
        </header>
        <p class="cm-intro">Something you&rsquo;d like added or changed &mdash; in the Studio, the packs, the Planner, anything. If someone has asked already, say you need it too: the most wanted is what we build first.</p>
        <div class="cm-list" data-cm-reqs></div>
      </section>

      <HubFootBar />
      </div>
    </main>

  <!-- One pop-out, the Help Centre's size, for a thread, a new post and your name. -->
  <div class="cm-modal" data-cm-modal hidden>
    <div class="cm-modal-card" role="dialog" aria-modal="true" aria-labelledby="cm-modal-h" data-lenis-prevent>
      <button type="button" class="cm-x" data-cm-close aria-label="Close">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
      <div data-cm-modal-body></div>
    </div>
  </div>
  </div><!-- /.ws: the pop-out sits inside it for the hub's colours and buttons -->

  <script type="application/json" id="cm-cats" set:html={JSON.stringify(CATEGORIES)}></script>
  <script type="application/json" id="cm-team" set:html={JSON.stringify(team.map(({ key, name, short, role, pic, bio, questions }) => ({ key, name, short, role, pic, bio, questions })))}></script>

  <style is:global>
    /* The header is the shared flat one; the three boxes sit at the right,
       level with the button, as on the Studio. */
    .ws-left > .ws-hero.ws-hero--sub > .ws-hero-copy { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: clamp(24px, 3vw, 48px); align-items: end; }
    .ws-hero--sub .ws-hero-date, .ws-hero--sub .ws-greeting, .ws-hero--sub .ws-hero-sub { grid-column: 1 / -1; }
    .ws-hero--sub .cm-cta { grid-column: 1; grid-row: 4; align-self: end; }
    .cm-brief { grid-column: 2; grid-row: 4; align-self: end; }
    .cm-brief-btn { all: unset; cursor: pointer; display: flex; align-items: center; gap: 11px; }
    .cm-brief li:has(.cm-brief-btn:hover) { border-color: rgba(28,29,34,0.3); }
    .cm-back { color: inherit; text-decoration: none; }
    /* Chapter to chapter, 40% less than the hub's gap, as on Bookings: the
       cards here are short rows of words, so the full gap read as empty
       (Dani, 17 Oct). The header keeps the full gap. */
    .ws-left > .ws-block:has(+ .ws-block) { margin-bottom: calc(var(--ws-chapter-gap, 60px) * -0.4); }
    @media (max-width: 900px) {
      .ws-left > .ws-hero.ws-hero--sub > .ws-hero-copy { grid-template-columns: minmax(0, 1fr); }
      .cm-brief { grid-column: 1; grid-row: 4; margin-top: clamp(18px, 2.4vh, 26px); grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .ws-hero--sub .cm-cta { grid-row: 5; margin-top: 14px; }
    }
    @media (max-width: 620px) { .cm-brief { grid-template-columns: minmax(0, 1fr); } }

    /* The bar's own buttons, set like its links. */
    .cm-head-btn { all: unset; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; font-family: var(--sans); font-size: 12px; line-height: 14px; font-weight: 600; letter-spacing: 0.01em; color: rgba(255,255,255,0.78); transition: color 0.2s; }
    .cm-head-btn:hover { color: #fff; }
    .cm-head-btn:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .cm-head-btn svg { width: 12px; height: 12px; }
    .cm-sort { display: inline-flex; gap: 2px; margin-left: auto; padding: 2px; border: 1px solid rgba(255,255,255,0.22); border-radius: 4px; }
    .cm-sort-b { all: unset; cursor: pointer; padding: 4px 10px; border-radius: 3px; font-family: var(--sans); font-size: 11px; line-height: 14px; font-weight: 600; color: rgba(255,255,255,0.72); transition: background 0.2s, color 0.2s; }
    .cm-sort-b:hover { color: #fff; }
    .cm-sort-b.is-on { background: #fff; color: var(--english-violet); }
    .cm-sort-b:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }

    .cm-sort-b, .cm-head-btn { white-space: nowrap; }
    /* A phone: the order buttons go to their own line under the title. */
    @media (max-width: 620px) {
      #requests .ws-block-head { flex-wrap: wrap; row-gap: 10px; }
      #requests .cm-sort { order: 3; margin-left: 0; }
    }
    .cm-intro { margin: 0; max-width: 75%; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.6; color: var(--ws-tx); }
    @media (max-width: 760px) { .cm-intro { max-width: none; } }
    .cm-list { display: flex; flex-direction: column; gap: var(--ws-gap); }

    /* A row: what it is on the left, the count (and for a request, the
       button) on the right. White, the one outline, like every hub card. */
    .cm-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 8px 24px; align-items: center; padding: 16px 20px; background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); }
    .cm-row-open { all: unset; cursor: pointer; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .cm-row-open:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 4px; }
    .cm-row-t { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 700; line-height: 1.35; color: var(--ws-ink); overflow-wrap: anywhere; }
    .cm-row-open:hover .cm-row-t { color: var(--english-violet); }
    .cm-row-x { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.5; color: var(--ws-tx); display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
    .cm-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 4px 10px; font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-faint); }
    .cm-meta > * + *::before { content: "·"; margin-right: 10px; color: rgba(28,29,34,0.3); }
    .cm-side { display: flex; flex-direction: column; align-items: flex-end; gap: 7px; text-align: right; }
    .cm-count { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-faint); white-space: nowrap; }
    .cm-count b { color: var(--ws-ink); font-weight: 700; }
    .cm-badge { display: inline-flex; align-items: center; height: 17px; padding: 0 6px; border-radius: 3px; background: var(--english-violet); color: #fff; font-family: var(--sans); font-size: 9px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
    .cm-meta > .cm-badge::before { content: none; }
    .cm-status { display: inline-flex; align-items: center; height: 19px; padding: 0 7px; border-radius: 3px; font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; background: rgba(28,29,34,0.06); color: var(--ws-ink); }
    .cm-status[data-s="planned"]  { background: #ece6ee; color: #4a3550; }
    .cm-status[data-s="building"] { background: #f4e7df; color: #8a4f35; }
    .cm-status[data-s="done"]     { background: #e3efe7; color: #2f6e4c; }
    .cm-status[data-s="declined"] { background: rgba(28,29,34,0.06); color: var(--ws-faint); }
    .cm-hidden-note { color: #a1452f; }

    /* "I need this too": outlined until you need it, then filled. */
    .cm-need { all: unset; box-sizing: border-box; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 6px; height: var(--ws-btn-h, 26px); padding: 0 13px; border-radius: var(--ws-r); border: 1px solid var(--english-violet); color: var(--english-violet); background: #fff; font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; transition: background 0.18s, color 0.18s; }
    .cm-need:hover { background: rgba(55,30,40,0.06); }
    .cm-need.is-on { background: var(--english-violet); color: #fff; }
    .cm-need.is-on:hover { background: color-mix(in srgb, var(--english-violet) 86%, #000); }
    .cm-need:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
    .cm-need[disabled] { cursor: default; opacity: 0.6; }
    .cm-need svg { width: 11px; height: 11px; }
    .cm-mine { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-faint); }

    .cm-more { all: unset; cursor: pointer; align-self: flex-start; margin-top: 4px; font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-ink); border-bottom: 1px solid rgba(28,29,34,0.35); padding-bottom: 3px; }
    .cm-more:hover { color: var(--english-violet); border-color: var(--english-violet); }

    /* Nothing yet: said plainly, the bookings page's empty card. */
    .cm-none { padding: 20px 22px; background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); }
    .cm-none-h { margin: 0 0 6px; font-family: var(--serif); font-size: var(--ws-t-label, 11px); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .cm-none-p { margin: 0; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.6; color: rgba(28,29,34,0.6); }
    .cm-none-go { all: unset; cursor: pointer; display: inline-block; margin-top: 8px; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.6; font-weight: 700; color: var(--english-violet); border-bottom: 1px solid rgba(55,30,40,0.35); }

    /* Chapter 01: the topic in the wine, the talk under it on white. */
    .cm-topic { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: var(--ws-gap); }
    .cm-topic-card { display: flex; flex-direction: column; gap: 12px; padding: clamp(22px, 2.4vw, 34px); background: var(--english-violet); color: #fff; border-radius: var(--ws-r); }
    .cm-topic-when { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.6); }
    .cm-topic-t { margin: 0; font-family: var(--sans); font-size: clamp(20px, 1.7vw, 26px); font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; color: #fff; }
    .cm-topic-p { margin: 0; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.65; color: rgba(255,255,255,0.8); white-space: pre-line; }
    .cm-topic-acts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: auto; padding-top: 8px; }
    .cm-btn-w { all: unset; box-sizing: border-box; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; height: var(--ws-btn-h, 26px); padding: 0 13px; border-radius: var(--ws-r); background: #fff; color: var(--english-violet); font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; transition: background 0.18s; }
    .cm-btn-w:hover { background: #f1ecee; }
    .cm-btn-w--line { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,0.4); }
    .cm-btn-w--line:hover { background: rgba(255,255,255,0.08); }
    .cm-topic-past { font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(255,255,255,0.6); }
    .cm-topic-past button { all: unset; cursor: pointer; color: rgba(255,255,255,0.85); border-bottom: 1px solid rgba(255,255,255,0.3); }
    .cm-topic-past button:hover { color: #fff; }
    .cm-topic-talk { display: flex; flex-direction: column; gap: 12px; padding: 18px 20px; background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); min-width: 0; }
    .cm-talk-h { margin: 0; font-family: var(--serif); font-size: var(--ws-t-label, 11px); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    @media (max-width: 900px) { .cm-topic { grid-template-columns: minmax(0, 1fr); } }
    .cm-topic--solo { grid-template-columns: minmax(0, 1fr); }
    .cm-fortnight { display: flex; flex-direction: column; gap: var(--ws-gap); }
    .cm-disc { display: flex; flex-direction: column; gap: var(--ws-gap); }
    .cm-topic-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 10px 16px; margin-top: auto; padding-top: 6px; }
    .cm-preview { align-self: flex-start; padding: 5px 9px; border-radius: 3px; background: rgba(255,255,255,0.12); font-family: var(--sans); font-size: 11.5px; line-height: 1.4; color: #fff; }

    /* Reactions: the ones given, as chips with their count, then a smiley
       that opens the five. Your own is filled. */
    .cm-rx { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 4px; }
    .cm-rx-chip, .cm-rx-add, .cm-rx-opt { all: unset; box-sizing: border-box; cursor: pointer; display: inline-flex; align-items: center; gap: 4px; height: 24px; padding: 0 8px; border-radius: 999px; border: 1px solid var(--ws-line); background: #fff; font-family: var(--sans); font-size: 12px; line-height: 1; color: var(--ws-ink); transition: border-color 0.18s, background 0.18s, transform 0.18s; }
    .cm-rx-chip b { font-size: 11px; font-weight: 700; color: var(--ws-tx); }
    .cm-rx-chip:hover, .cm-rx-add:hover { border-color: var(--english-violet); }
    .cm-rx-chip.is-mine { border-color: var(--english-violet); background: #f6f1f3; }
    .cm-rx-chip.is-mine b { color: var(--english-violet); }
    .cm-rx-add { gap: 5px; color: var(--ws-faint); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
    .cm-rx-add svg { width: 14px; height: 14px; }
    .cm-rx-pick { display: inline-flex; gap: 2px; padding: 2px; border-radius: 999px; border: 1px solid var(--ws-line); background: #fff; }
    .cm-rx-pick[hidden] { display: none; }
    .cm-rx-opt { border: 0; padding: 0 5px; font-size: 16px; height: 26px; }
    .cm-rx-opt:hover { transform: translateY(-2px) scale(1.15); background: transparent; }
    .cm-rx-opt.is-mine { background: #f6f1f3; }
    .cm-rx :is(button):focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
    /* On the wine: the same, turned over. */
    .cm-topic-card .cm-rx-chip, .cm-topic-card .cm-rx-add { background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.28); color: #fff; }
    .cm-topic-card .cm-rx-chip b { color: rgba(255,255,255,0.8); }
    .cm-topic-card .cm-rx-chip.is-mine { background: #fff; border-color: #fff; color: var(--english-violet); }
    .cm-topic-card .cm-rx-chip.is-mine b { color: var(--english-violet); }
    .cm-topic-card .cm-rx-chip:hover, .cm-topic-card .cm-rx-add:hover { border-color: #fff; }
    .cm-topic-card .cm-rx-pick { background: #fff; border-color: #fff; }
    .cm-topic-card :is(button):focus-visible { outline-color: #fff; }

    /* A comment, its reactions and Reply; replies sit indented under it. */
    .cm-reply-foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 14px; margin-top: 2px; }
    .cm-thread-item { display: flex; flex-direction: column; gap: 10px; padding-bottom: 12px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .cm-thread-item:last-child { border-bottom: 0; padding-bottom: 0; }
    .cm-thread-item > .cm-reply { border: 0; padding-bottom: 0; }
    .cm-kids { display: flex; flex-direction: column; gap: 10px; margin-left: clamp(14px, 2vw, 28px); padding-left: clamp(12px, 1.4vw, 18px); border-left: 2px solid rgba(55,30,40,0.14); }
    .cm-kids .cm-reply { border: 0; padding-bottom: 0; }
    .cm-say--reply textarea { min-height: 60px; }
    .cm-say-btns { display: inline-flex; gap: 6px; }

    /* The pinned intro: white, the one outline, first. */
    .cm-intro-card { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px; background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); }
    .cm-intro-t { margin: 0; font-family: var(--sans); font-size: 17px; font-weight: 600; line-height: 1.3; color: var(--ws-ink); }
    .cm-intro-p { margin: 0; max-width: 75%; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.65; color: var(--ws-tx); white-space: pre-line; }
    @media (max-width: 760px) { .cm-intro-p { max-width: none; } }
    /* TMKE's view, beside the topic in the wine's own tint. */
    .cm-view { display: flex; flex-direction: column; gap: 10px; padding: clamp(22px, 2.4vw, 34px); background: #f6f1f3; border-radius: var(--ws-r); min-width: 0; }
    .cm-view-p { margin: 0; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.7; color: var(--ws-ink); white-space: pre-line; overflow-wrap: anywhere; }
    /* The comments: one bar, opening to the comments and the box to add one. */
    .cm-comments { background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); }
    .cm-comments-bar { all: unset; box-sizing: border-box; cursor: pointer; display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; padding: 14px 20px; font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 600; color: var(--ws-ink); }
    .cm-comments-bar:hover .cm-comments-go { color: var(--english-violet); }
    .cm-comments-bar:focus-visible { outline: 2px solid var(--english-violet); outline-offset: -2px; }
    .cm-comments-go { display: inline-flex; align-items: center; gap: 6px; font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-faint); white-space: nowrap; }
    .cm-comments-go svg { width: 13px; height: 13px; transition: transform 0.25s var(--ws-ease, ease); }
    .cm-comments.is-open .cm-comments-go svg { transform: rotate(180deg); }
    .cm-comments-body { display: flex; flex-direction: column; gap: 16px; padding: 4px 20px 20px; border-top: 1px solid rgba(28,29,34,0.08); padding-top: 16px; }

    /* A reply: who, when, what. */
    .cm-reply { display: flex; flex-direction: column; gap: 4px; padding-bottom: 12px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .cm-reply:last-child { border-bottom: 0; padding-bottom: 0; }
    .cm-reply-p { margin: 0; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.6; color: var(--ws-ink); white-space: pre-line; overflow-wrap: anywhere; }
    .cm-reply.is-staff { padding: 12px 14px; border: 0; border-radius: var(--ws-r); background: #f6f1f3; }
    .cm-reply.is-hidden { opacity: 0.55; }
    .cm-replies { display: flex; flex-direction: column; gap: 12px; }

    /* Writing: one box and a button, the hub's field. */
    .cm-say { display: flex; flex-direction: column; gap: 8px; }
    .cm-say textarea, .cm-field input, .cm-field textarea, .cm-field select { box-sizing: border-box; width: 100%; padding: 10px 12px; border: 1px solid var(--ws-line); border-radius: var(--ws-r); background: #fff; font-family: var(--sans); font-size: 14px; line-height: 1.5; color: var(--ws-ink); resize: vertical; transition: border-color 0.2s; }
    .cm-say textarea { min-height: 76px; }
    .cm-say textarea:focus, .cm-field :is(input, textarea, select):focus { outline: none; border-color: var(--english-violet); }
    .cm-say-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .cm-as { font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--ws-faint); }
    .cm-as button { all: unset; cursor: pointer; color: var(--english-violet); font-weight: 600; border-bottom: 1px solid rgba(55,30,40,0.3); }
    .cm-err { margin: 0; font-family: var(--sans); font-size: var(--ws-t-meta); color: #a1452f; }

    /* Meet the team: the dashboard's cards, as buttons. */
    .cm-team-card { font: inherit; text-align: left; cursor: pointer; width: 100%; }
    .cm-team-card:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 3px; }
    .cm-person { display: grid; grid-template-columns: 200px minmax(0, 1fr); gap: 24px; align-items: start; }
    .cm-person-pic { aspect-ratio: 3 / 4; border-radius: var(--ws-r); background-size: cover; background-position: center 20%; background-color: #eae5e1; }
    .cm-person .cm-m-h { margin-top: 2px; }
    @media (max-width: 560px) { .cm-person { grid-template-columns: 110px minmax(0, 1fr); gap: 16px; } }
    /* 20 questions: each a card that turns over to the answer. */
    .cm-qs { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
    .cm-q { all: unset; box-sizing: border-box; cursor: pointer; display: flex; flex-direction: column; gap: 6px; min-height: 86px; padding: 12px 14px; border-radius: var(--ws-r); border: 1px solid var(--ws-line); background: #fff; transition: background 0.2s, border-color 0.2s, color 0.2s; }
    .cm-q:hover { border-color: var(--english-violet); }
    .cm-q:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
    .cm-q-n { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-faint); }
    .cm-q-t { font-family: var(--sans); font-size: 14px; font-weight: 600; line-height: 1.35; color: var(--ws-ink); }
    .cm-q-a { display: none; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.5; color: #fff; }
    .cm-q.is-open { background: var(--english-violet); border-color: var(--english-violet); }
    .cm-q.is-open .cm-q-n { color: rgba(255,255,255,0.6); }
    .cm-q.is-open .cm-q-t { color: rgba(255,255,255,0.75); font-size: 12px; }
    .cm-q.is-open .cm-q-a { display: block; }
    @media (max-width: 560px) { .cm-qs { grid-template-columns: 1fr; } }

    /* The pop-out: the Help Centre's size, always. */
    .cm-modal { position: fixed; inset: 0; z-index: 9000; display: grid; place-items: center; padding: 24px; background: rgba(28,20,24,0.5); opacity: 0; transition: opacity 0.22s ease; }
    .cm-modal.is-in { opacity: 1; }
    .cm-modal[hidden] { display: none; }
    .cm-modal-card [hidden] { display: none !important; }   /* flex rules would otherwise show a hidden field */
    .cm-modal-card { position: relative; box-sizing: border-box; width: min(720px, 100%); height: min(720px, calc(100vh - 48px)); overflow-y: auto; overscroll-behavior: contain; padding: 30px 30px 26px; background: #fff; border-radius: 6px; border-top: 4px solid var(--english-violet); transform: translateY(8px); transition: transform 0.25s var(--ws-ease, ease); }
    .cm-modal.is-in .cm-modal-card { transform: none; }
    .cm-x { all: unset; cursor: pointer; position: absolute; top: 14px; right: 14px; width: 28px; height: 28px; display: grid; place-items: center; border-radius: 4px; color: var(--ws-tx); }
    .cm-x:hover { background: rgba(28,29,34,0.06); color: var(--ws-ink); }
    .cm-x svg { width: 14px; height: 14px; }
    .cm-m-eyebrow { margin: 0 0 10px; font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet); }
    .cm-m-h { margin: 0 40px 8px 0; font-family: var(--sans); font-size: 22px; font-weight: 600; line-height: 1.25; letter-spacing: -0.01em; color: var(--ws-ink); overflow-wrap: anywhere; }
    .cm-m-body { margin: 12px 0 0; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.65; color: var(--ws-ink); white-space: pre-line; overflow-wrap: anywhere; }
    .cm-m-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin: 16px 0 0; }
    .cm-m-sec { margin: 22px 0 12px; padding-top: 16px; border-top: 1px solid rgba(28,29,34,0.08); font-family: var(--serif); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .cm-m-sub { margin: 0 0 18px; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.6; color: var(--ws-tx); }
    .cm-link { all: unset; cursor: pointer; font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-faint); }
    .cm-link:hover { color: var(--english-violet); }
    .cm-tools { display: inline-flex; gap: 12px; }
    .cm-report { display: flex; flex-direction: column; gap: 8px; margin-top: 8px; }
    .cm-form { display: flex; flex-direction: column; gap: 14px; }
    .cm-field { display: flex; flex-direction: column; gap: 6px; }
    .cm-field > span { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .cm-field textarea { min-height: 150px; }
    .cm-two { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .cm-kind { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .cm-kind button, .cm-pick button { all: unset; box-sizing: border-box; cursor: pointer; display: flex; flex-direction: column; gap: 3px; padding: 12px 14px; border: 1px solid var(--ws-line); border-radius: var(--ws-r); font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.4; color: var(--ws-tx); transition: border-color 0.2s, background 0.2s; }
    .cm-kind button strong, .cm-pick button strong { font-size: 14px; color: var(--ws-ink); font-weight: 600; }
    .cm-kind button:hover, .cm-pick button:hover { border-color: rgba(28,29,34,0.3); }
    .cm-kind button.is-on, .cm-pick button.is-on { border-color: var(--english-violet); background: #f6f1f3; }
    .cm-pick { display: flex; flex-direction: column; gap: 8px; }
    .cm-form-acts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 4px; }
    @media (max-width: 560px) { .cm-two { grid-template-columns: 1fr; } .cm-modal { padding: 10px; } .cm-modal-card { height: calc(100vh - 20px); padding: 24px 20px 20px; } .cm-row { grid-template-columns: minmax(0, 1fr); } .cm-side { align-items: flex-start; text-align: left; flex-direction: row; flex-wrap: wrap; } }
  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";
    import { gateReady, gateFailed } from "../../lib/ready-gate.js";

    const CATS = JSON.parse(document.getElementById("cm-cats").textContent || "[]");
    const STATUS = { planned: "Planned", building: "Being built", done: "Done", declined: "Not for now" };
    const SHOW = 6;   // rows before "Show all"
    const $ = (s, r = document) => r.querySelector(s);
    const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    const plural = (n, one, many) => `${n} ${n === 1 ? one : (many || one + "s")}`;
    function ago(iso) {
      const s = (Date.now() - new Date(iso).getTime()) / 1000;
      if (s < 60) return "just now";
      if (s < 3600) return Math.floor(s / 60) + "m ago";
      if (s < 86400) return Math.floor(s / 3600) + "h ago";
      if (s < 86400 * 7) return Math.floor(s / 86400) + "d ago";
      return new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
    }
    const dayFmt = (d) => new Date(d + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short" });
    const todayISO = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`; };
    const missing = (e) => e && (e.code === "42P01" || e.code === "PGRST205" || /does not exist|could not find the table/i.test(e.message || ""));

    const S = { me: null, profile: null, names: new Map(), topics: [], talk: [], reqs: [], needs: new Set(), sort: "wanted", allTalk: false, allReqs: false, topicReplies: [], closed: false };
    const nameOf = (id) => S.names.get(id) || "Member";

    async function loadNames(ids) {
      const want = [...new Set(ids)].filter((id) => id && !S.names.has(id));
      if (!want.length) return;
      const { data } = await supabase.from("community_names").select("user_id, display_name").in("user_id", want);
      (data || []).forEach((r) => S.names.set(r.user_id, r.display_name || "Member"));
    }

    // ── How you appear ──────────────────────────────────────────────────────
    // First visit: a row from their own account (the brand kit's name, else
    // the sign-up's; the kit's company as the agency), shown as "Sarah H."
    async function ensureProfile(user) {
      const { data, error } = await supabase.from("community_members").select("*").eq("user_id", user.id).maybeSingle();
      if (error) throw error;
      if (data) return data;
      let kit = null;
      try { kit = JSON.parse(localStorage.getItem("tmke.brand") || "null"); } catch (_) {}
      const md = user.user_metadata || {};
      const full = String((kit && kit.about && kit.about.name) || md.name || md.full_name || "").trim();
      const parts = full.split(/\s+/).filter(Boolean);
      const first = parts.shift() || String(user.email || "").split("@")[0].replace(/[._-]+/g, " ").replace(/\b\w/g, (c) => c.toUpperCase()).split(" ")[0] || "Member";
      const row = { user_id: user.id, first_name: first.slice(0, 60), last_name: parts.join(" ").slice(0, 60), agency: String((kit && kit.company) || md.company || "").slice(0, 80) };
      const ins = await supabase.from("community_members").insert(row).select("*").single();
      if (ins.error) throw ins.error;
      return ins.data;
    }
    function paintMe() {
      $("[data-cm-me-name]").textContent = S.profile ? `as ${S.profile.display_name}` : "";
      if (S.profile) S.names.set(S.me.id, S.profile.display_name);
    }

    // ── Rows ────────────────────────────────────────────────────────────────
    function talkRow(p) {
      const el = document.createElement("article");
      el.className = "cm-row";
      el.innerHTML = `
        <button type="button" class="cm-row-open" data-open="${p.id}">
          <span class="cm-row-t">${esc(p.title)}</span>
          ${p.body ? `<span class="cm-row-x">${esc(p.body)}</span>` : ""}
          <span class="cm-meta"><span>${esc(nameOf(p.author_id))}</span>${p.is_staff ? '<span class="cm-badge">TMKE</span>' : ""}<span>${esc(ago(p.last_activity_at))}</span>${p.hidden ? '<span class="cm-hidden-note">Hidden by TMKE</span>' : ""}</span>
        </button>
        <div class="cm-side"><span class="cm-count"><b>${p.reply_count}</b> ${p.reply_count === 1 ? "reply" : "replies"}</span></div>`;
      return el;
    }
    function needBtn(p) {
      if (p.author_id === S.me.id) return `<span class="cm-mine">Your request</span>`;
      const on = S.needs.has(p.id);
      return `<button type="button" class="cm-need${on ? " is-on" : ""}" data-need="${p.id}" aria-pressed="${on}">${on
        ? '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>You need this'
        : "I need this too"}</button>`;
    }
    function reqRow(p) {
      const el = document.createElement("article");
      el.className = "cm-row";
      el.innerHTML = `
        <button type="button" class="cm-row-open" data-open="${p.id}">
          <span class="cm-row-t">${esc(p.title)}</span>
          <span class="cm-meta">${p.status !== "open" ? `<span class="cm-status" data-s="${esc(p.status)}">${esc(STATUS[p.status] || p.status)}</span>` : ""}${p.category ? `<span>${esc(p.category)}</span>` : ""}<span>${esc(nameOf(p.author_id))}</span><span>${p.reply_count ? `See what members said (${p.reply_count})` : "Add a comment"}</span>${p.hidden ? '<span class="cm-hidden-note">Hidden by TMKE</span>' : ""}</span>
        </button>
        <div class="cm-side">${needBtn(p)}<span class="cm-count"><b>${p.need_count}</b> ${p.need_count === 1 ? "member needs this" : "members need this"}</span></div>`;
      return el;
    }
    function none(h, p, go) {
      return `<div class="cm-none"><p class="cm-none-h">${esc(h)}</p><p class="cm-none-p">${esc(p)}</p>${go ? `<button type="button" class="cm-none-go" data-cm-new="${go.kind}">${esc(go.label)} &rarr;</button>` : ""}</div>`;
    }

    function paintTalk() {
      const box = $("[data-cm-talk]");
      box.innerHTML = "";
      if (S.closed) { box.innerHTML = none("Opening soon", "The Community isn't quite open yet. Check back shortly."); return; }
      if (!S.talk.length) { box.innerHTML = none("No conversations yet", "Ask the room: a post that worked, a listing that wouldn't shift, a tool you swear by.", { kind: "discussion", label: "Start the first one" }); return; }
      const list = S.allTalk ? S.talk : S.talk.slice(0, SHOW);
      list.forEach((p) => box.appendChild(talkRow(p)));
      if (S.talk.length > SHOW && !S.allTalk) box.insertAdjacentHTML("beforeend", `<button type="button" class="cm-more" data-more="talk">Show all ${S.talk.length} conversations</button>`);
    }
    function sortedReqs() {
      const r = [...S.reqs];
      if (S.sort === "new") r.sort((a, b) => b.created_at.localeCompare(a.created_at));
      else r.sort((a, b) => (b.need_count - a.need_count) || b.created_at.localeCompare(a.created_at));
      // Done and declined drop to the foot either way.
      const rank = (p) => (p.status === "done" || p.status === "declined" ? 1 : 0);
      return r.sort((a, b) => rank(a) - rank(b));
    }
    function paintReqs() {
      const box = $("[data-cm-reqs]");
      box.innerHTML = "";
      if (S.closed) { box.innerHTML = none("Opening soon", "The request board isn't quite open yet. Check back shortly."); return; }
      if (!S.reqs.length) { box.innerHTML = none("No requests yet", "Be the first: a template you keep wishing existed, a tool that would save you an hour, a change that would make something easier.", { kind: "request", label: "Ask for something" }); return; }
      const all = sortedReqs();
      (S.allReqs ? all : all.slice(0, SHOW)).forEach((p) => box.appendChild(reqRow(p)));
      if (all.length > SHOW && !S.allReqs) box.insertAdjacentHTML("beforeend", `<button type="button" class="cm-more" data-more="reqs">Show all ${all.length} requests</button>`);
    }
    // ── Reactions (Dani, 17 Oct): on posts and comments, one each ─────────────
    const RX = [["heart", "❤️", "Love"], ["thumbs", "👍", "Like"], ["hug", "🤗", "Hug"], ["cry", "😢", "Sad"], ["laugh", "😂", "Haha"]];
    S.rx = new Map(); S.myRx = new Map(); S.rxOn = true;
    async function loadReactions(ids) {
      const want = [...new Set(ids)].filter(Boolean);
      if (!S.rxOn || !want.length) return;
      for (let i = 0; i < want.length; i += 100) {
        const chunk = want.slice(i, i + 100);
        const [c, m] = await Promise.all([
          supabase.from("community_reaction_counts").select("target_id, emoji, n").in("target_id", chunk),
          supabase.from("community_reactions").select("target_id, emoji").eq("user_id", S.me.id).in("target_id", chunk),
        ]);
        // Not set up yet (community_forum.sql): no reactions, nothing broken.
        if (c.error || m.error) { S.rxOn = false; return; }
        chunk.forEach((id) => { S.rx.set(id, {}); S.myRx.delete(id); });
        (c.data || []).forEach((r) => { S.rx.get(r.target_id)[r.emoji] = r.n; });
        (m.data || []).forEach((r) => S.myRx.set(r.target_id, r.emoji));
      }
    }
    function rxBar(id, kind) {
      if (!S.rxOn) return "";
      const c = S.rx.get(id) || {}, mine = S.myRx.get(id);
      const chips = RX.filter(([k]) => c[k]).map(([k, e, l]) => `<button type="button" class="cm-rx-chip${mine === k ? " is-mine" : ""}" data-rx="${k}" data-rx-id="${id}" data-rx-kind="${kind}" aria-label="${l}, ${c[k]}" aria-pressed="${mine === k}"><span aria-hidden="true">${e}</span><b>${c[k]}</b></button>`).join("");
      const pick = RX.map(([k, e, l]) => `<button type="button" class="cm-rx-opt${mine === k ? " is-mine" : ""}" data-rx="${k}" data-rx-id="${id}" data-rx-kind="${kind}" aria-label="${l}" title="${l}">${e}</button>`).join("");
      return `<div class="cm-rx" data-rx-wrap="${id}">${chips}<button type="button" class="cm-rx-add" data-rx-open aria-expanded="false"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M5.6 9.6c.6.8 1.4 1.2 2.4 1.2s1.8-.4 2.4-1.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/><circle cx="6" cy="6.6" r=".8" fill="currentColor"/><circle cx="10" cy="6.6" r=".8" fill="currentColor"/></svg>${mine ? "" : "React"}</button><span class="cm-rx-pick" hidden>${pick}</span></div>`;
    }
    async function react(id, kind, emoji) {
      const before = S.myRx.get(id), counts = { ...(S.rx.get(id) || {}) };
      const redraw = () => document.querySelectorAll(`[data-rx-wrap="${id}"]`).forEach((w) => { w.outerHTML = rxBar(id, kind); });
      // Straight away on the page, then saved; put back if the save fails.
      if (before) counts[before] = Math.max(0, (counts[before] || 1) - 1);
      if (before !== emoji) counts[emoji] = (counts[emoji] || 0) + 1;
      S.rx.set(id, counts);
      if (before === emoji) S.myRx.delete(id); else S.myRx.set(id, emoji);
      redraw();
      const res = before === emoji
        ? await supabase.from("community_reactions").delete().eq("target_id", id).eq("user_id", S.me.id)
        : await supabase.from("community_reactions").upsert({ target_id: id, target_kind: kind, user_id: S.me.id, emoji }, { onConflict: "target_id,user_id" });
      if (res.error) { await loadReactions([id]); redraw(); }
    }

    // ── Comments, and replies to a comment (one level) ──────────────────────
    S.replies = new Map();      // post id -> its comments
    S.openComments = new Set(); // posts whose comments are open
    S.replyTo = null;           // the comment being replied to
    function replyHtml(r, child) {
      const mine = r.author_id === S.me.id;
      return `<div class="cm-reply${r.is_staff ? " is-staff" : ""}${r.hidden ? " is-hidden" : ""}${child ? " is-child" : ""}" data-reply="${r.id}">
        <span class="cm-meta"><span>${esc(nameOf(r.author_id))}</span>${r.is_staff ? '<span class="cm-badge">TMKE</span>' : ""}<span>${esc(ago(r.created_at))}</span>${r.hidden ? '<span class="cm-hidden-note">Hidden by TMKE</span>' : ""}</span>
        <p class="cm-reply-p">${esc(r.body)}</p>
        <div class="cm-reply-foot">${rxBar(r.id, "reply")}<span class="cm-tools"><button type="button" class="cm-link" data-reply-to="${child ? r.parent_id : r.id}">Reply</button>${mine ? `<button type="button" class="cm-link" data-del-reply="${r.id}">Delete</button>` : `<button type="button" class="cm-link" data-report-reply="${r.id}">Report</button>`}</span></div>
      </div>`;
    }
    function sayForm(postId, parentId, placeholder) {
      return `<form class="cm-say${parentId ? " cm-say--reply" : ""}" data-say="${postId}"${parentId ? ` data-parent="${parentId}"` : ""}>
        <textarea name="body" maxlength="5000" placeholder="${esc(placeholder)}" aria-label="${parentId ? "Your reply" : "Your comment"}" required></textarea>
        <div class="cm-say-row"><span class="cm-as">Posting as ${esc(S.profile.display_name)}${parentId ? "" : ` &middot; <button type="button" data-cm-me>change</button>`}</span><span class="cm-say-btns">${parentId ? `<button type="button" class="ws-btn ws-btn--ghost" data-reply-cancel>Cancel</button>` : ""}<button type="submit" class="ws-btn ws-btn--primary">${parentId ? "Reply" : "Post"}</button></span></div>
        <p class="cm-err" data-err hidden></p>
      </form>`;
    }
    function commentsHtml(postId) {
      const reps = S.replies.get(postId) || [];
      const ids = new Set(reps.map((r) => r.id));
      // A reply whose comment was hidden stands on its own.
      const tops = reps.filter((r) => !r.parent_id || !ids.has(r.parent_id));
      return tops.map((r) => {
        const kids = reps.filter((k) => k.parent_id === r.id);
        const replying = S.replyTo === r.id;
        return `<div class="cm-thread-item">${replyHtml(r, false)}${kids.length || replying ? `<div class="cm-kids">${kids.map((k) => replyHtml(k, true)).join("")}${replying ? sayForm(postId, r.id, `Reply to ${nameOf(r.author_id)}`) : ""}</div>` : ""}</div>`;
      }).join("");
    }
    async function loadReplies(postIds) {
      const want = [...new Set(postIds)].filter(Boolean);
      if (!want.length) return;
      let { data, error } = await supabase.from("community_replies").select("id, post_id, parent_id, body, author_id, is_staff, hidden, created_at").in("post_id", want).order("created_at", { ascending: true }).limit(1000);
      // Before community_forum.sql there are no replies-to-comments yet.
      if (error && /parent_id/.test(error.message || "")) ({ data } = await supabase.from("community_replies").select("id, post_id, body, author_id, is_staff, hidden, created_at").in("post_id", want).order("created_at", { ascending: true }).limit(1000));
      want.forEach((id) => S.replies.set(id, []));
      (data || []).forEach((r) => S.replies.get(r.post_id).push(r));
      await Promise.all([loadNames((data || []).map((r) => r.author_id)), loadReactions((data || []).map((r) => r.id))]);
    }

    // The pinned intro sits above everything; under it, the discussion
    // running now (Dani, 17 Oct). Each goes live at 8am on its date; until then
    // only staff and previewers are handed it, and they see the next one
    // marked as a preview, so the format can be checked before members do.
    const isLive = (p) => !p.publish_at || new Date(p.publish_at) <= new Date();
    const introTopic = () => S.topics.find((p) => p.pinned && !p.hidden) || null;
    function currentTopic() {
      const t = todayISO();
      const dated = S.topics.filter((p) => !p.pinned && !p.hidden && p.starts_on);
      return dated.find((p) => isLive(p) && p.starts_on <= t && (!p.ends_on || p.ends_on >= t))
        || [...dated].filter((p) => !isLive(p) || p.starts_on > t).sort((a, b) => a.starts_on.localeCompare(b.starts_on))[0]
        || null;
    }
    // "Mon 19 Oct, 8am", in UK time.
    function liveFmt(iso) {
      const d = new Date(iso);
      const day = d.toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short", timeZone: "Europe/London" }).replace(",", "");
      const parts = Object.fromEntries(new Intl.DateTimeFormat("en-GB", { hour: "numeric", minute: "2-digit", hour12: true, timeZone: "Europe/London" }).formatToParts(d).map((x) => [x.type, x.value]));
      return `${day}, ${parts.hour}${parts.minute !== "00" ? ":" + parts.minute : ""}${String(parts.dayPeriod || "").toLowerCase().replace(/\s|\./g, "")}`;
    }
    function topicBlock(t, label, extra) {
      const reps = S.replies.get(t.id) || [];
      const n = reps.length, open = S.openComments.has(t.id);
      const preview = !isLive(t) || (t.starts_on && t.starts_on > todayISO());
      return `<div class="cm-disc">
        <div class="cm-topic${t.viewpoint ? "" : " cm-topic--solo"}">
          <div class="cm-topic-card">
            <span class="cm-topic-when">${[label, t.category].filter(Boolean).map(esc).join(" &middot; ")}</span>
            ${preview && t.publish_at ? `<span class="cm-preview">Preview: only you and the team can see this. Goes live ${esc(liveFmt(t.publish_at))}.</span>` : ""}
            <h3 class="cm-topic-t">${esc(t.title)}</h3>
            ${t.body ? `<p class="cm-topic-p">${esc(t.body)}</p>` : ""}
            <div class="cm-topic-foot">${rxBar(t.id, "post")}${extra || ""}</div>
          </div>
          ${t.viewpoint ? `<div class="cm-view">
            <span class="cm-meta"><span class="cm-badge">TMKE</span><span>Our view</span></span>
            <p class="cm-view-p">${esc(t.viewpoint)}</p>
          </div>` : ""}
        </div>
        <div class="cm-comments${open ? " is-open" : ""}">
          <button type="button" class="cm-comments-bar" data-cm-comments="${t.id}" aria-expanded="${open}">
            <span>${n ? plural(n, "comment") : "No comments yet: be the first"}</span>
            <span class="cm-comments-go">${open ? "Hide" : n ? "Show comments" : "Add yours"}<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
          </button>
          ${open ? `<div class="cm-comments-body">
            ${n ? `<div class="cm-replies">${commentsHtml(t.id)}</div>` : ""}
            ${sayForm(t.id, null, "Add your view")}
          </div>` : ""}
        </div>
      </div>`;
    }
    function paintTopic() {
      const box = $("[data-cm-topic]");
      if (S.closed) { box.innerHTML = none("Opening soon", "The first topic lands when the Community opens."); return; }
      const intro = introTopic();
      const t = currentTopic();
      const past = S.topics.filter((p) => p !== t && !p.pinned && !p.hidden && p.starts_on && isLive(p) && p.ends_on && p.ends_on < todayISO()).slice(0, 3);
      const pastHtml = past.length ? `<p class="cm-topic-past">Earlier: ${past.map((p) => `<button type="button" data-open="${p.id}">${esc(p.title)}</button>`).join(", ")}</p>` : "";
      const parts = [];
      if (intro) parts.push(topicBlock(intro, "Pinned"));
      if (t) parts.push(topicBlock(t, t.starts_on && t.ends_on ? `${dayFmt(t.starts_on)} – ${dayFmt(t.ends_on)}` : "This fortnight", pastHtml));
      else parts.push(`<div class="cm-none"><p class="cm-none-h">Next topic coming up</p><p class="cm-none-p">Every fortnight we set a topic, share our view and talk it through with you. The next one is on its way.</p></div>`);
      box.innerHTML = `<div class="cm-fortnight">${parts.join("")}</div>`;
    }

    // ── Loading ─────────────────────────────────────────────────────────────
    // `viewpoint` arrives with supabase/community_fortnight.sql; until that has
    // run the page asks without it rather than failing.
    let COLS = "id, kind, title, body, viewpoint, publish_at, category, status, starts_on, ends_on, author_id, is_staff, hidden, pinned, need_count, reply_count, last_activity_at, created_at";
    async function loadAll() {
      if (!S.colsChecked) {
        S.colsChecked = true;
        for (const col of ["viewpoint", "publish_at"]) {
          const probe = await supabase.from("community_posts").select(col).limit(1);
          if (probe.error && (probe.error.code === "42703" || new RegExp(col).test(probe.error.message || ""))) COLS = COLS.replace(` ${col},`, "");
        }
      }
      const [tp, tk, rq, nd] = await Promise.all([
        supabase.from("community_posts").select(COLS).eq("kind", "topic").order("pinned", { ascending: false }).order("starts_on", { ascending: false, nullsFirst: false }).limit(40),
        supabase.from("community_posts").select(COLS).eq("kind", "discussion").order("pinned", { ascending: false }).order("last_activity_at", { ascending: false }).limit(300),
        supabase.from("community_posts").select(COLS).eq("kind", "request").order("need_count", { ascending: false }).limit(500),
        supabase.from("community_needs").select("post_id").eq("user_id", S.me.id).limit(1000),
      ]);
      const err = tp.error || tk.error || rq.error || nd.error;
      if (err) throw err;
      S.topics = tp.data || []; S.talk = tk.data || []; S.reqs = rq.data || [];
      S.needs = new Set((nd.data || []).map((r) => r.post_id));
      const t = currentTopic();
      const shown = [introTopic(), currentTopic()].filter(Boolean).map((p) => p.id);
      await loadReplies(shown);
      await loadReactions([...S.topics, ...S.talk, ...S.reqs].map((p) => p.id));
      await loadNames([...S.topics, ...S.talk, ...S.reqs].map((p) => p.author_id));
    }
    function paintAll() { paintMe(); paintTopic(); paintTalk(); paintReqs(); }

    // ── The pop-out ─────────────────────────────────────────────────────────
    const modal = $("[data-cm-modal]");
    const mBody = $("[data-cm-modal-body]");
    function openModal(html) {
      mBody.innerHTML = html;
      modal.hidden = false;
      window.__lenis?.stop?.();
      requestAnimationFrame(() => modal.classList.add("is-in"));
      $(".cm-modal-card").scrollTop = 0;
    }
    function closeModal() {
      S.inModal = false; S.openId = null;
      modal.classList.remove("is-in");
      window.__lenis?.start?.();
      setTimeout(() => { modal.hidden = true; mBody.innerHTML = ""; }, 220);
      const u = new URL(location.href);
      if (u.searchParams.has("post") || u.searchParams.has("new")) { u.searchParams.delete("post"); u.searchParams.delete("new"); history.replaceState(null, "", u); }
    }
    modal.addEventListener("click", (e) => { if (e.target === modal || e.target.closest("[data-cm-close]")) closeModal(); });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hidden) closeModal(); });

    const allPosts = () => [...S.topics, ...S.talk, ...S.reqs];
    async function openThread(id) {
      let p = allPosts().find((x) => x.id === id);
      if (!p) {
        const { data } = await supabase.from("community_posts").select(COLS).eq("id", id).maybeSingle();
        if (!data) return;
        p = data; await loadNames([p.author_id]);
      }
      S.inModal = true; S.openId = id;
      const kindLabel = p.kind === "topic" ? "This fortnight's topic" : p.kind === "request" ? "Request" : "Conversation";
      openModal(`<p class="cm-m-eyebrow">${kindLabel}</p><h2 class="cm-m-h" id="cm-modal-h">${esc(p.title)}</h2><div data-thread><p class="cm-m-sub">&nbsp;</p></div>`);
      await Promise.all([loadReplies([id]), loadReactions([id])]);
      if (S.openId !== id) return;
      S.openPost = p;
      renderThread(p);
    }
    function renderThread(p) {
      const replies = S.replies.get(p.id) || [];
      const mine = p.author_id === S.me.id;
      const when = p.kind === "topic" && p.starts_on && p.ends_on ? `${dayFmt(p.starts_on)} – ${dayFmt(p.ends_on)}` : ago(p.created_at);
      $("[data-thread]", mBody).innerHTML = `
        <span class="cm-meta">${p.status !== "open" && p.kind === "request" ? `<span class="cm-status" data-s="${esc(p.status)}">${esc(STATUS[p.status] || p.status)}</span>` : ""}${p.category ? `<span>${esc(p.category)}</span>` : ""}<span>${esc(nameOf(p.author_id))}</span>${p.is_staff ? '<span class="cm-badge">TMKE</span>' : ""}<span>${esc(when)}</span>${p.hidden ? '<span class="cm-hidden-note">Hidden by TMKE</span>' : ""}</span>
        ${p.body ? `<p class="cm-m-body">${esc(p.body)}</p>` : ""}
        ${p.viewpoint ? `<div class="cm-view" style="margin-top:16px"><span class="cm-meta"><span class="cm-badge">TMKE</span><span>Our view</span></span><p class="cm-view-p">${esc(p.viewpoint)}</p></div>` : ""}
        <div class="cm-m-bar">
          ${rxBar(p.id, "post")}
          ${p.kind === "request" ? `${needBtn(p)}<span class="cm-count"><b>${p.need_count}</b> ${p.need_count === 1 ? "member needs this" : "members need this"}</span>` : ""}
          <span class="cm-tools">${mine ? `<button type="button" class="cm-link" data-del-post="${p.id}">Delete</button>` : `<button type="button" class="cm-link" data-report-post="${p.id}">Report</button>`}</span>
        </div>
        <div data-report-slot></div>
        <p class="cm-m-sec">${replies.length ? plural(replies.length, "comment") : (p.kind === "discussion" ? "Replies" : "Comments")}</p>
        ${replies.length ? `<div class="cm-replies">${commentsHtml(p.id)}</div>` : `<p class="cm-m-sub">Nothing yet${p.kind === "request" ? " &mdash; add how you'd use it" : ""}.</p>`}
        ${p.hidden ? "" : `<div style="margin-top:16px">${sayForm(p.id, null, p.kind === "request" ? "How would you use it?" : "Add your reply")}</div>`}`;
    }

    function openComposer(kind) {
      S.inModal = true; S.openId = null;
      const k = kind === "request" ? "request" : "discussion";
      openModal(`<p class="cm-m-eyebrow">New post</p><h2 class="cm-m-h" id="cm-modal-h">${k === "request" ? "Ask for something" : "Start a conversation"}</h2>
        <form class="cm-form" data-compose>
          <div class="cm-kind" role="group" aria-label="What is it?">
            <button type="button" data-k="discussion" class="${k === "discussion" ? "is-on" : ""}"><strong>A conversation</strong>Ask the room, share what worked</button>
            <button type="button" data-k="request" class="${k === "request" ? "is-on" : ""}"><strong>A request</strong>Something to add or change</button>
          </div>
          <input type="hidden" name="kind" value="${k}">
          <label class="cm-field"><span>Title</span><input name="title" maxlength="140" required placeholder="${k === "request" ? "e.g. Interior design templates" : "e.g. What's your best-performing listing post?"}"></label>
          <label class="cm-field" data-cat ${k === "request" ? "" : "hidden"}><span>What's it about?</span><select name="category">${CATS.map((c) => `<option>${esc(c)}</option>`).join("")}</select></label>
          <label class="cm-field"><span>${k === "request" ? "Tell us more (optional)" : "Say more (optional)"}</span><textarea name="body" maxlength="5000" placeholder="${k === "request" ? "What would you use it for?" : "Give people something to reply to."}"></textarea></label>
          <p class="cm-as">Posting as ${esc(S.profile.display_name)} &middot; <button type="button" data-cm-me>change</button></p>
          <p class="cm-err" data-err hidden></p>
          <div class="cm-form-acts"><button type="button" class="ws-btn ws-btn--ghost" data-cm-close>Cancel</button><button type="submit" class="ws-btn ws-btn--primary">Post it</button></div>
        </form>`);
    }

    const TEAM = JSON.parse(document.getElementById("cm-team").textContent || "[]");
    function openPerson(key) {
      const m = TEAM.find((x) => x.key === key);
      if (!m) return;
      S.inModal = true; S.openId = null;
      const qs = m.questions || [];
      openModal(`<div class="cm-person">
          <span class="cm-person-pic" style="background-image:url('${esc(m.pic)}')" role="img" aria-label="${esc(m.name)}"></span>
          <div><p class="cm-m-eyebrow">${esc(m.role)}</p><h2 class="cm-m-h" id="cm-modal-h">${esc(m.name)}</h2><p class="cm-m-body">${esc(m.bio)}</p></div>
        </div>
        ${qs.length ? `<p class="cm-m-sec">20 questions with ${esc(m.short)}</p>
        <div class="cm-qs">${qs.map((x, i) => `<button type="button" class="cm-q" data-q aria-expanded="false"><span class="cm-q-n">${String(i + 1).padStart(2, "0")}</span><span class="cm-q-t">${esc(x.q)}</span><span class="cm-q-a">${esc(x.a)}</span></button>`).join("")}</div>` : ""}`);
    }

    function openMe() {
      S.inModal = true; S.openId = null;
      const p = S.profile;
      const short = `${p.first_name}${p.last_name ? " " + p.last_name.trim()[0].toUpperCase() + "." : ""}`;
      const full = `${p.first_name} ${p.last_name}`.trim() + (p.agency ? ` · ${p.agency}` : "");
      openModal(`<p class="cm-m-eyebrow">Your name in the Community</p><h2 class="cm-m-h" id="cm-modal-h">How you appear</h2>
        <p class="cm-m-sub">Only what you choose below is shown to other members. Your surname and agency stay private unless you show them.</p>
        <form class="cm-form" data-me>
          <div class="cm-two">
            <label class="cm-field"><span>First name</span><input name="first_name" maxlength="60" required value="${esc(p.first_name)}"></label>
            <label class="cm-field"><span>Surname</span><input name="last_name" maxlength="60" value="${esc(p.last_name)}"></label>
          </div>
          <label class="cm-field"><span>Agency</span><input name="agency" maxlength="80" value="${esc(p.agency)}"></label>
          <div class="cm-pick" role="radiogroup" aria-label="Show me as">
            <button type="button" role="radio" data-full="0" aria-checked="${!p.show_full}" class="${p.show_full ? "" : "is-on"}"><strong data-prev="short">${esc(short)}</strong>First name and initial</button>
            <button type="button" role="radio" data-full="1" aria-checked="${p.show_full}" class="${p.show_full ? "is-on" : ""}"><strong data-prev="full">${esc(full)}</strong>Full name and agency</button>
          </div>
          <p class="cm-err" data-err hidden></p>
          <div class="cm-form-acts"><button type="button" class="ws-btn ws-btn--ghost" data-cm-close>Cancel</button><button type="submit" class="ws-btn ws-btn--primary">Save</button></div>
        </form>`);
    }

    // ── Doing things ────────────────────────────────────────────────────────
    function showErr(form, msg) { const e = $("[data-err]", form); if (e) { e.textContent = msg; e.hidden = false; } }
    async function refresh() { await loadAll(); paintAll(); }

    async function toggleNeed(btn) {
      const id = btn.dataset.need;
      const on = S.needs.has(id);
      btn.disabled = true;
      const res = on
        ? await supabase.from("community_needs").delete().eq("post_id", id).eq("user_id", S.me.id)
        : await supabase.from("community_needs").insert({ post_id: id, user_id: S.me.id });
      btn.disabled = false;
      if (res.error && !/duplicate/i.test(res.error.message || "")) return;
      if (on) S.needs.delete(id); else S.needs.add(id);
      const { data } = await supabase.from("community_posts").select("need_count").eq("id", id).maybeSingle();
      const p = S.reqs.find((x) => x.id === id);
      if (p && data) p.need_count = data.need_count;
      paintReqs();
      if (S.openId === id) openThread(id);
    }

    document.addEventListener("click", async (e) => {
      const t = e.target;
      const cc = t.closest("[data-cm-comments]"); if (cc) {
        const id = cc.dataset.cmComments;
        if (S.openComments.has(id)) S.openComments.delete(id); else S.openComments.add(id);
        paintTopic();
        if (S.openComments.has(id)) setTimeout(() => document.querySelector(`[data-cm-comments="${id}"]`)?.closest(".cm-comments")?.querySelector(".cm-comments-body > .cm-say textarea")?.focus({ preventScroll: true }), 30);
        return;
      }
      // Reactions: open the five, choose one, or tap your own to take it back.
      const ro = t.closest("[data-rx-open]"); if (ro) { const pk = ro.parentElement.querySelector(".cm-rx-pick"); pk.hidden = !pk.hidden; ro.setAttribute("aria-expanded", String(!pk.hidden)); return; }
      const rx = t.closest("[data-rx]"); if (rx) { react(rx.dataset.rxId, rx.dataset.rxKind, rx.dataset.rx); return; }
      // Reply to a comment: the box opens under it.
      const rt = t.closest("[data-reply-to]"); if (rt) { S.replyTo = rt.dataset.replyTo; repaintComments(rt); setTimeout(() => document.querySelector(`[data-parent="${S.replyTo}"] textarea`)?.focus({ preventScroll: true }), 30); return; }
      if (t.closest("[data-reply-cancel]")) { const el = t.closest("[data-reply-cancel]"); S.replyTo = null; repaintComments(el); return; }
      const tm = t.closest("[data-team]"); if (tm) { e.preventDefault(); openPerson(tm.dataset.team); return; }
      const qq = t.closest("[data-q]"); if (qq) { const o = !qq.classList.contains("is-open"); qq.classList.toggle("is-open", o); qq.setAttribute("aria-expanded", String(o)); return; }
      const nw = t.closest("[data-cm-new]"); if (nw) { e.preventDefault(); openComposer(nw.dataset.cmNew); return; }
      if (t.closest("[data-cm-me]")) { e.preventDefault(); openMe(); return; }
      const op = t.closest("[data-open]"); if (op) { e.preventDefault(); const u = new URL(location.href); u.searchParams.set("post", op.dataset.open); history.replaceState(null, "", u); openThread(op.dataset.open); return; }
      const nd = t.closest("[data-need]"); if (nd) { e.preventDefault(); toggleNeed(nd); return; }
      const mo = t.closest("[data-more]"); if (mo) { if (mo.dataset.more === "talk") { S.allTalk = true; paintTalk(); } else { S.allReqs = true; paintReqs(); } return; }
      const so = t.closest("[data-sort]"); if (so) {
        S.sort = so.dataset.sort;
        document.querySelectorAll("[data-sort]").forEach((b) => { b.classList.toggle("is-on", b === so); b.setAttribute("aria-pressed", String(b === so)); });
        paintReqs(); return;
      }
      const kb = t.closest(".cm-kind [data-k]"); if (kb) {
        const f = kb.closest("form");
        f.querySelectorAll("[data-k]").forEach((b) => b.classList.toggle("is-on", b === kb));
        f.kind.value = kb.dataset.k;
        $("[data-cat]", f).hidden = kb.dataset.k !== "request";
        $("#cm-modal-h").textContent = kb.dataset.k === "request" ? "Ask for something" : "Start a conversation";
        return;
      }
      const pk = t.closest(".cm-pick [data-full]"); if (pk) {
        pk.parentElement.querySelectorAll("[data-full]").forEach((b) => { b.classList.toggle("is-on", b === pk); b.setAttribute("aria-checked", String(b === pk)); });
        return;
      }
      // Delete your own: asked once, in place.
      const dp = t.closest("[data-del-post], [data-del-reply]"); if (dp) {
        if (dp.dataset.sure !== "1") { dp.dataset.sure = "1"; dp.textContent = "Sure? Delete"; return; }
        const isPost = !!dp.dataset.delPost;
        const { error } = await supabase.from(isPost ? "community_posts" : "community_replies").delete().eq("id", isPost ? dp.dataset.delPost : dp.dataset.delReply);
        if (error) { dp.textContent = "Couldn't delete"; return; }
        if (isPost) { closeModal(); } else if (S.openId) { await openThread(S.openId); }
        refresh();
        return;
      }
      // Report: a line on why, then it's with us.
      const rp = t.closest("[data-report-post], [data-report-reply]"); if (rp) {
        const slot = rp.closest(".cm-reply") || $("[data-report-slot]", mBody);
        if (slot.querySelector(".cm-report")) return;
        slot.insertAdjacentHTML("beforeend", `<form class="cm-report" data-report="${rp.dataset.reportPost ? "post" : "reply"}:${rp.dataset.reportPost || rp.dataset.reportReply}">
          <label class="cm-field"><span>What's wrong with it?</span><input name="reason" maxlength="1000" placeholder="Optional"></label>
          <div class="cm-form-acts"><button type="submit" class="ws-btn ws-btn--ghost">Send to TMKE</button></div></form>`);
        return;
      }
    });

    // The two choices show the name as it will read, as they type.
    document.addEventListener("input", (e) => {
      const f = e.target.closest && e.target.closest("[data-me]");
      if (!f) return;
      const fn = f.first_name.value.trim(), ln = f.last_name.value.trim(), ag = f.agency.value.trim();
      $('[data-prev="short"]', f).textContent = fn + (ln ? " " + ln[0].toUpperCase() + "." : "");
      $('[data-prev="full"]', f).textContent = `${fn} ${ln}`.trim() + (ag ? ` · ${ag}` : "");
    });

    // Comments redraw where they are: in the pop-out, or on the page.
    function repaintComments(el) {
      if (el && el.closest(".cm-modal-card") && S.openPost) renderThread(S.openPost); else paintTopic();
    }

    document.addEventListener("submit", async (e) => {
      const f = e.target;
      if (f.matches("[data-say]")) {
        e.preventDefault();
        const body = f.body.value.trim();
        if (!body) return;
        const btn = f.querySelector('[type="submit"]'); btn.disabled = true;
        const row = { post_id: f.dataset.say, body };
        if (f.dataset.parent) row.parent_id = f.dataset.parent;
        const { error } = await supabase.from("community_replies").insert(row);
        btn.disabled = false;
        if (error) { showErr(f, "That didn't post. Try again in a moment."); return; }
        f.body.value = "";
        S.replyTo = null;
        S.openComments.add(f.dataset.say);
        await refresh();
        if (S.openId === f.dataset.say) openThread(f.dataset.say);
        return;
      }
      if (f.matches("[data-compose]")) {
        e.preventDefault();
        const kind = f.kind.value;
        const row = { kind, title: f.title.value.trim(), body: f.body.value.trim(), category: kind === "request" ? f.category.value : null };
        if (row.title.length < 3) { showErr(f, "Give it a title of a few words."); return; }
        const btn = f.querySelector('[type="submit"]'); btn.disabled = true;
        const { data, error } = await supabase.from("community_posts").insert(row).select("id").single();
        if (error) { btn.disabled = false; showErr(f, "That didn't post. Try again in a moment."); return; }
        // Asking for it counts as needing it.
        if (kind === "request") await supabase.from("community_needs").insert({ post_id: data.id, user_id: S.me.id });
        await refresh();
        openThread(data.id);
        return;
      }
      if (f.matches("[data-me]")) {
        e.preventDefault();
        const showFull = $(".cm-pick .is-on", f)?.dataset.full === "1";
        const row = { first_name: f.first_name.value.trim(), last_name: f.last_name.value.trim(), agency: f.agency.value.trim(), show_full: showFull, updated_at: new Date().toISOString() };
        if (!row.first_name) { showErr(f, "Your first name, at least."); return; }
        const { data, error } = await supabase.from("community_members").update(row).eq("user_id", S.me.id).select("*").single();
        if (error) { showErr(f, "That didn't save. Try again in a moment."); return; }
        S.profile = data; S.names.set(S.me.id, data.display_name);
        paintAll(); closeModal();
        return;
      }
      if (f.matches("[data-report]")) {
        e.preventDefault();
        const [what, id] = f.dataset.report.split(":");
        const { error } = await supabase.from("community_reports").insert(what === "post" ? { post_id: id, reason: f.reason.value.trim() } : { reply_id: id, reason: f.reason.value.trim() });
        f.innerHTML = `<p class="cm-as">${error ? "That didn't send. Try again in a moment." : "Thanks. It's with us and we'll take a look."}</p>`;
      }
    });

    // ── In ──────────────────────────────────────────────────────────────────
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        if (!import.meta.env.DEV) location.replace("/login?next=" + encodeURIComponent("/account/community"));
        return;
      }
      if (!import.meta.env.DEV) {
        const { data: { user }, error } = await supabase.auth.getUser();
        if (!user || error) { location.replace("/login?next=" + encodeURIComponent("/account/community")); return; }
      }
      S.me = session.user;
      const sections = ["topic", "talk", "requests"].map((n) => [n, document.querySelector(`[data-gate="${n}"]`)]);
      try {
        S.profile = await ensureProfile(S.me);
        await loadAll();
      } catch (err) {
        if (missing(err)) S.closed = true;
        else {
          sections.forEach(([n, el]) => { el.querySelector("[data-cm-topic], [data-cm-talk], [data-cm-reqs]").innerHTML = none("Didn't load", "Something went wrong loading the Community. Refresh to try again."); gateFailed(n, el); });
          gateReady("hero", document.querySelector('[data-gate="hero"]'));
          return;
        }
      }
      if (S.closed) { S.profile = { display_name: "" }; document.querySelectorAll("[data-cm-new], [data-cm-me]").forEach((b) => (b.disabled = true)); }
      paintAll();
      gateReady("hero", document.querySelector('[data-gate="hero"]'));
      sections.forEach(([n, el]) => gateReady(n, el));
      // A notification, or the Help Centre, can open straight onto a post or the board.
      const want = new URLSearchParams(location.search).get("post");
      if (want && !S.closed) openThread(want);
      // The menu's "Start a conversation" lands here with the form open.
      const nu = new URLSearchParams(location.search).get("new");
      if (nu && !want && !S.closed) openComposer(nu);
      if (location.hash === "#requests") setTimeout(() => document.getElementById("requests")?.scrollIntoView({ block: "start" }), 50);
    })();
  </script>
</BaseLayout>
