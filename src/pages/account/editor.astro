  <!--
    Admin-mode bootstrap. If the URL says ?mode=admin AND the user is signed in
    as an admin, we:
      • fetch templates from Supabase (overriding the baked-in mock library)
      • install a save hook that writes back to the templates table
    NOTE: this MUST be a bundled Astro script (bare `<script>`, NOT
    `<script type="module">`). With an explicit type="module" Astro leaves it
    inline and DOESN'T resolve the `../lib/*` imports — in the production build
    those become `/lib/supabase.js` / `/lib/admin-gate.js` which 404, so the
    save hook never installs and the editor falls back to the first template.
    A bare `<script>` is bundled (imports resolved into /_astro/) and is the
    `__TMKE_BOOT_ADMIN__` handshake makes ordering robust regardless.
  -->
  <script>
    import { supabase } from '../../lib/supabase.js';
    import { isAdminUser } from '../../lib/admin-gate.js';

    // ---- Externalise embedded images before writing to Supabase ----------
    // Canva imports (and pasted images) embed full-resolution pictures as
    // base64 data URLs inside canvas.backgroundImage / element.src. Writing
    // those straight into the `templates` row makes it multi-MB, which makes
    // the save/publish request fail ("Failed to fetch") or time out
    // ("canceling statement due to statement timeout"). So before saving we
    // upload each data-URL image to the public `site-media` bucket and swap in
    // its URL — the row stays tiny, the image stays full-res in storage.
    const _imgUrlCache = new Map();
    let _externUid = null;
    async function _externGetUid() {
      if (_externUid) return _externUid;
      try { const { data } = await supabase.auth.getSession(); _externUid = (data && data.session && data.session.user && data.session.user.id) || null; } catch (_) {}
      return _externUid;
    }
    async function externUploadDataUrl(dataUrl) {
      const m = /^data:([^;]+);base64,(.+)$/.exec(dataUrl);
      if (!m) return dataUrl;
      const mime = m[1], b64 = m[2];
      let h = 5381; for (let i = 0; i < dataUrl.length; i++) h = ((h * 33) ^ dataUrl.charCodeAt(i)) >>> 0;
      const ext = ((mime.split('/')[1] || 'png').toLowerCase().replace('jpeg', 'jpg').replace(/[^a-z0-9]/g, '')) || 'png';
      // calendar-assets RLS requires the first folder to be the user's id.
      const uid = await _externGetUid();
      const key = (uid ? uid + '/' : '') + 'templates/' + h.toString(36) + '-' + dataUrl.length.toString(36) + '.' + ext;
      const bin = atob(b64); const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const blob = new Blob([bytes], { type: mime });
      const { error } = await supabase.storage.from('calendar-assets').upload(key, blob, { cacheControl: '31536000', upsert: true, contentType: mime });
      if (error && !/exists|duplicate/i.test(error.message || '')) throw error;
      const { data } = supabase.storage.from('calendar-assets').getPublicUrl(key);
      return (data && data.publicUrl) || dataUrl;
    }
    // ---- Member upload library ------------------------------------------
    // A member's uploads used to live only in memory, so they vanished on
    // reload and had to be re-uploaded. Persist them in the same public
    // `calendar-assets` bucket under `<uid>/uploads/…` — the bucket already has
    // public read + per-user write/delete policies keyed on that first folder,
    // so no new table or migration is needed. editor.js calls these hooks; they
    // no-op when signed out (uploads then behave as before, in-memory only).
    const UPLOAD_DIR = 'uploads';
    function _uploadKey(uid, dataUrl, mime) {
      let h = 5381;
      for (let i = 0; i < dataUrl.length; i++) h = ((h * 33) ^ dataUrl.charCodeAt(i)) >>> 0;
      const ext = ((mime.split('/')[1] || 'png').toLowerCase().replace('jpeg', 'jpg').replace(/[^a-z0-9]/g, '')) || 'png';
      return uid + '/' + UPLOAD_DIR + '/' + h.toString(36) + '-' + dataUrl.length.toString(36) + '.' + ext;
    }
    window.__TMKE_UPLOAD_SAVE__ = async (dataUrl) => {
      try {
        const uid = await _externGetUid();
        if (!uid) return null;
        const m = /^data:([^;]+);base64,(.+)$/.exec(dataUrl);
        if (!m) return null;
        const mime = m[1], b64 = m[2];
        const key = _uploadKey(uid, dataUrl, mime);
        const bin = atob(b64), bytes = new Uint8Array(bin.length);
        for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
        const { error } = await supabase.storage.from('calendar-assets')
          .upload(key, new Blob([bytes], { type: mime }), { cacheControl: '31536000', upsert: true, contentType: mime });
        if (error && !/exists|duplicate/i.test(error.message || '')) return null;
        const { data } = supabase.storage.from('calendar-assets').getPublicUrl(key);
        return (data && data.publicUrl) || null;
      } catch (_) { return null; }
    };
    window.__TMKE_UPLOADS_LIST__ = async () => {
      try {
        const uid = await _externGetUid();
        if (!uid) return [];
        const { data, error } = await supabase.storage.from('calendar-assets')
          .list(uid + '/' + UPLOAD_DIR, { limit: 200, sortBy: { column: 'created_at', order: 'desc' } });
        if (error || !data) return [];
        return data.filter((f) => f && f.name && !f.name.startsWith('.')).map((f) => {
          const { data: pub } = supabase.storage.from('calendar-assets').getPublicUrl(uid + '/' + UPLOAD_DIR + '/' + f.name);
          return pub && pub.publicUrl;
        }).filter(Boolean);
      } catch (_) { return []; }
    };
    window.__TMKE_UPLOAD_DELETE__ = async (url) => {
      try {
        const uid = await _externGetUid();
        if (!uid || typeof url !== 'string') return false;
        const marker = '/' + uid + '/' + UPLOAD_DIR + '/';
        const i = url.indexOf(marker);
        if (i < 0) return false;   // not one of this member's library files
        const key = decodeURIComponent(url.slice(i + 1).split('?')[0]);
        const { error } = await supabase.storage.from('calendar-assets').remove([key]);
        return !error;
      } catch (_) { return false; }
    };

    async function externUrl(v) {
      if (typeof v !== 'string' || !v.startsWith('data:')) return v;
      if (_imgUrlCache.has(v)) return _imgUrlCache.get(v);
      const url = await externUploadDataUrl(v);
      _imgUrlCache.set(v, url);
      return url;
    }
    // Walk a list of pages ({canvas, elements}) and externalise every image.
    async function externalizePages(pages) {
      for (const pg of (pages || [])) {
        if (pg && pg.canvas && typeof pg.canvas.backgroundImage === 'string') pg.canvas.backgroundImage = await externUrl(pg.canvas.backgroundImage);
        for (const el of ((pg && pg.elements) || [])) { if (el && typeof el.src === 'string') el.src = await externUrl(el.src); }
      }
      return pages;
    }
    // Shared with the Publish flow (a separate script below).
    window.__TMKE_EXTERNALIZE_PAGES__ = externalizePages;

    const params = new URLSearchParams(location.search);
    const wantAdmin = params.get('mode') === 'admin';

    if (wantAdmin) {
      const { data: { session } } = await supabase.auth.getSession();
      const DEV = import.meta.env.DEV;
      if (!session && !DEV) {
        // Not signed in — bounce to admin login, preserve where we wanted to go.
        const next = encodeURIComponent(location.pathname + location.search);
        location.replace(`/admin/login?next=${next}`);
      } else if (session && !DEV && !(await isAdminUser(session.user))) {
        // Signed in but not an admin (e.g. a customer poking at ?mode=admin) —
        // never load the admin studio chrome or templates for them.
        location.replace('/admin/login?denied=1');
      } else {
        const requestedId = params.get('id');
        const tag = document.getElementById('ed-templates-data');
        const shape = (r) => ({
          id: r.id,
          name: r.name,
          category: r.category,
          thumb: r.thumb_url,
          canvas: r.canvas || { width: 1080, height: 1440, background: '#f4f2f1' },
          elements: r.elements || [],
        });

        // Install the save hook the editor will pick up. Editor.js passes
        // its current `state.templateId` in `payload.templateId`, which is
        // also the Supabase row id (we keep ids stable end-to-end). This must
        // be in place before we boot so editor.js's isAdminMode() is true.
        /* Returns { ok } or { ok:false, reason }. It used to return a bare
           boolean, which threw away why a save failed - so an expired sign-in,
           a photo that would not upload and a dropped connection all surfaced
           as the same "reconnecting to cloud…" and none of them told you what
           to do about it. */
        window.__TMKE_ADMIN_SAVE__ = async (payload) => {
          if (!payload?.templateId) return { ok: false, reason: 'No design open to save into.' };

          /* Photos are uploaded to storage and the row keeps their URLs. When
             that fails the picture stays in the design as base64 - which is
             what pushes the row past what the database will accept, and is the
             likeliest reason a save that used to work stops working. It is
             said out loud now rather than logged to a console nobody has open. */
          let stranded = 0;
          try {
            await externalizePages([{ canvas: payload.canvas, elements: payload.elements }]);
          } catch (e) { console.error('[save: externalize]', e); }
          for (const el of (payload.elements || [])) {
            if (el && typeof el.src === 'string' && el.src.startsWith('data:')) stranded++;
          }
          if (typeof payload?.canvas?.backgroundImage === 'string'
              && payload.canvas.backgroundImage.startsWith('data:')) stranded++;
          // Upload the editor-generated thumbnail so the studio list can show one
          // small image instead of rebuilding the whole design from full-res
          // photos — the big lever on list load time.
          let thumbUrl;
          if (typeof payload.thumb === 'string' && payload.thumb.startsWith('data:')) {
            try { thumbUrl = await externUploadDataUrl(payload.thumb); } catch (e) { console.error('[save: thumb]', e); }
          }
          // Full-resolution lossless render (render_url) — the crisp image the
          // pack catalogue / detail show, so a design never has to be shown from
          // the lighter thumb or a hand-uploaded gallery.
          let renderUrl;
          if (typeof payload.render === 'string' && payload.render.startsWith('data:')) {
            try { renderUrl = await externUploadDataUrl(payload.render); } catch (e) { console.error('[save: render]', e); }
          }
          const patch = {
            name: payload.filename,
            canvas: payload.canvas,
            elements: payload.elements,
          };
          if (thumbUrl) patch.thumb_url = thumbUrl;
          if (renderUrl) patch.render_url = renderUrl;
          // A long editing session can outlive the access token. Refresh once
          // and try again before calling it a failure — the design is fine, the
          // sign-in just went stale underneath it.
          const write = () => supabase.from('templates').update(patch).eq('id', payload.templateId);
          let { error: saveErr } = await write();
          if (saveErr && /jwt|token|expired|auth/i.test(saveErr.message || '')) {
            try { await supabase.auth.refreshSession(); } catch (_) {}
            ({ error: saveErr } = await write());
          }
          if (!saveErr) return { ok: true };

          const size = Math.round(JSON.stringify(patch).length / 1024);
          let reason = saveErr.message || 'The database refused the save.';
          if (stranded) {
            reason = stranded + (stranded === 1 ? ' image' : ' images') +
              " couldn't be uploaded to storage, so the design is too big to save (" +
              size + "KB). Check your connection and save again.";
          } else if (size > 1500) {
            reason = 'This design is ' + size + 'KB, which is too big for one save. Try removing or replacing the largest photos.';
          }
          return { ok: false, reason };
        };
        // Turn on autosave-as-draft (admin only for now) — editor.js persists a
        // draft to localStorage shortly after each change and before unload.
        window.__TMKE_AUTOSAVE__ = true;

        // On-demand single-row fetch. The switcher list ships WITHOUT each
        // template's heavy `elements`/`canvas` (so it stays tiny no matter how
        // many templates exist); editor.js calls this to pull the full design
        // only when the user actually switches to that template.
        window.__TMKE_FETCH_TEMPLATE__ = async (id) => {
          if (!id) return null;
          try {
            const { data } = await supabase
              .from('templates')
              .select('id, name, category, thumb_url, canvas, elements, status, sort_order')
              .eq('id', id)
              .maybeSingle();
            return data ? shape(data) : null;
          } catch (_) { return null; }
        };

        // Bulk "Regenerate previews" — re-render every template from its stored
        // design (text and all) and update BOTH its full-res render_url (for the
        // shop) and its lighter thumb_url (for lists). Lets an admin refresh all
        // packs in one click instead of re-opening each design by hand. Only
        // touches the preview columns — never the design data or pack links.
        window.__TMKE_REGEN_ALL__ = async function (onProgress) {
          const { data: list, error } = await supabase
            .from('templates')
            .select('id, canvas, elements');
          if (error || !list) throw error || new Error('Could not load templates.');
          let done = 0, failed = 0;
          for (const t of list) {
            try {
              const pair = (typeof window.__TMKE_RENDER_PAIR_FROM__ === 'function')
                ? await window.__TMKE_RENDER_PAIR_FROM__(t.canvas, t.elements)
                : { thumb: null, render: null };
              const update = {};
              if (pair && typeof pair.thumb === 'string' && pair.thumb.startsWith('data:')) {
                try { update.thumb_url = await externUploadDataUrl(pair.thumb); } catch (e) { console.error('[regen thumb]', t.id, e); }
              }
              if (pair && typeof pair.render === 'string' && pair.render.startsWith('data:')) {
                try { update.render_url = await externUploadDataUrl(pair.render); } catch (e) { console.error('[regen render]', t.id, e); }
              }
              if (update.thumb_url || update.render_url) {
                const { error: uErr } = await supabase.from('templates').update(update).eq('id', t.id);
                if (uErr) { failed++; console.error('[regen update]', t.id, uErr); }
              } else { failed++; }
            } catch (e) { failed++; console.error('[regen render]', t.id, e); }
            done++;
            if (onProgress) onProgress(done, list.length, failed);
          }
          return { total: list.length, done, failed };
        };

        // Brand-kit links point at the customer profile (/profile). In admin we
        // author shared templates, so redirect brand edits to the admin
        // fonts/brand area instead — and open in a new tab so the in-progress
        // editor session isn't thrown away mid-design.
        document.querySelectorAll('#brand-edit-link, .ed-brand-empty a').forEach((a) => {
          a.setAttribute('href', '/admin/fonts');
          a.setAttribute('target', '_blank');
          a.setAttribute('rel', 'noopener');
        });

        // 1) Open the RIGHT template, fast. The blob ships with the bundled seed
        //    library (whose [0] is "Just Listed"), and the editor falls back to
        //    TEMPLATES[0] whenever the requested id isn't found — so a slow,
        //    empty or failed full-list fetch made every Edit click open
        //    "Just Listed". Fetch just the requested row (one row = fast) and pin
        //    it to index 0 so the boot below loads exactly what was clicked.
        if (requestedId && tag) {
          try {
            const { data: one } = await supabase
              .from('templates')
              .select('id, name, category, thumb_url, canvas, elements, status, sort_order')
              .eq('id', requestedId)
              .maybeSingle();
            if (one) {
              let arr = [];
              try { arr = JSON.parse(tag.textContent || '[]'); } catch (_) {}
              arr = arr.filter((t) => t.id !== one.id);
              arr.unshift(shape(one));
              tag.textContent = JSON.stringify(arr);
            }
          } catch (_) {}
        }

        // Boot now — the requested design is in the blob, so it loads instantly
        // and correctly. editor.js may not have defined the callback yet
        // (script-load race) — leave a breadcrumb it picks up on boot if so.
        if (typeof window.__TMKE_BOOT_ADMIN__ === 'function') {
          window.__TMKE_BOOT_ADMIN__(requestedId || null);
        } else {
          window.__TMKE_ADMIN_BOOTSTRAP_DONE__ = { requestedId: requestedId || null };
        }

        // 2) Backfill the full template list for the switcher grid IN THE
        //    BACKGROUND. This MUST NOT be awaited: the bootstrap runs in a module
        //    with top-level await, which blocks editor.js — and so the canvas
        //    render — until the whole script finishes (see the comment above the
        //    import). Awaiting this heavy all-templates-with-elements fetch here
        //    is exactly what made opening a template take 15-30s. Fire it and let
        //    it refresh the switcher grid whenever it lands; the requested design
        //    has already been pinned + booted above, so the editor paints now.
        supabase
          .from('templates')
          .select('id, name, category, thumb_url, status, sort_order')
          .order('status', { ascending: true })
          .order('sort_order', { ascending: true })
          .then(({ data: rows, error }) => {
            if (error || !rows || !rows.length || !tag) return;
            const shaped = rows.map(shape);
            if (requestedId) {
              const idx = shaped.findIndex((t) => t.id === requestedId);
              if (idx > 0) { const [hit] = shaped.splice(idx, 1); shaped.unshift(hit); }
            }
            tag.textContent = JSON.stringify(shaped);
            if (typeof window.__TMKE_REFRESH_TEMPLATES__ === 'function') {
              window.__TMKE_REFRESH_TEMPLATES__();
            }
          })
          .catch(() => {});
      }
    }

    // ---- Customer design persistence (members' own copies of templates) ------
    // Not admin mode: when a signed-in member edits, editor.js calls this hook.
    // First save from a template INSERTS a copy into user_designs (copy-on-edit)
    // and returns its id so the editor adopts it; later saves UPDATE that row.
    // The original template is never touched.
    if (!wantAdmin) {
      const { data: { session: memberSession } } = await supabase.auth.getSession();
      if (memberSession) {
        const memberUid = memberSession.user.id;
        let currentDesignId = params.get('design') || null;
        window.__TMKE_DESIGN_SAVE__ = async (payload) => {
          try {
            // Externalise embedded data-URL images to storage (keeps the row small).
            try { await externalizePages([{ canvas: payload.canvas, elements: payload.elements }]); } catch (_) {}
            let thumbUrl;
            if (typeof payload.thumb === 'string' && payload.thumb.startsWith('data:')) {
              try { thumbUrl = await externUploadDataUrl(payload.thumb); } catch (_) {}
            }
            const row = {
              user_id: memberUid,
              name: payload.filename || 'Untitled design',
              canvas: payload.canvas,
              elements: payload.elements,
              pages: payload.pages || null,
              updated_at: new Date().toISOString(),
            };
            if (thumbUrl) row.thumb_url = thumbUrl;
            if (currentDesignId) {
              const { error } = await supabase.from('user_designs').update(row).eq('id', currentDesignId).eq('user_id', memberUid);
              return error ? { ok: false } : { ok: true, id: currentDesignId };
            }
            row.source_template_id = payload.templateId || null;
            const { data, error } = await supabase.from('user_designs').insert(row).select('id').single();
            if (error || !data) return { ok: false };
            currentDesignId = data.id;
            try { const u = new URL(location.href); u.searchParams.set('design', currentDesignId); u.searchParams.delete('template'); history.replaceState(null, '', u); } catch (_) {}
            return { ok: true, id: currentDesignId };
          } catch (_) { return { ok: false }; }
        };
        // Re-open a saved design (?design=<id>): fetch the row + boot the editor onto it.
        if (currentDesignId) {
          let design = null;
          try {
            const { data: d } = await supabase.from('user_designs').select('*').eq('id', currentDesignId).eq('user_id', memberUid).single();
            if (d) design = { id: d.id, name: d.name, canvas: d.canvas, elements: d.elements, pages: d.pages };
          } catch (_) {}
          if (typeof window.__TMKE_BOOT_DESIGN__ === 'function') window.__TMKE_BOOT_DESIGN__(design);
          else window.__TMKE_DESIGN_BOOTSTRAP_DONE__ = design;
        }
      }
    }

    // Custom brand fonts — fetched for BOTH admin and customer modes so the
    // canvas renders templates that reference them correctly. Each row is
    // registered with the document via Font Face API; editor.js picks them
    // up via `window.__TMKE_BRAND_FONTS__` and adds to the picker.
    try {
      const { data: bf, error: bfErr } = await supabase
        .from('brand_fonts')
        .select('id, family, display_name, file_url, weight, style')
        .order('family', { ascending: true });

      if (!bfErr && bf && bf.length) {
        const registered = new Set();
        for (const f of bf) {
          if (registered.has(f.family + '|' + f.weight + '|' + f.style)) continue;
          registered.add(f.family + '|' + f.weight + '|' + f.style);
          try {
            const face = new FontFace(f.family, `url("${f.file_url}")`, {
              weight: String(f.weight || 400),
              style: f.style || 'normal',
              display: 'swap',
            });
            face.load().then((l) => document.fonts.add(l)).catch(() => {});
          } catch (_) { /* ignore individual font failures */ }
        }
        // Editor.js reads this on init to populate the font picker.
        window.__TMKE_BRAND_FONTS__ = bf;
      }
    } catch (_) { /* fonts are optional — keep editor usable if fetch fails */ }

    // ---- Member brand kit — the logged-in person's own colours / fonts / logos.
    // Stored per user in member_brand_kits (RLS: own row only) so the Studio
    // opens with THEIR kit on any device, not a stale browser-local one. This
    // module runs before editor.js (top-level await blocks later modules), so
    // writing the cache here means editor.js's loadBrand() reads the live kit.
    // Applies to both member and admin logins — whoever is signed in gets their
    // own kit. (Admin authoring mode still leaves {brand …} tokens unfilled.)
    try {
      const { data: { session: bkSession } } = await supabase.auth.getSession();
      if (bkSession) {
        const { data: bk } = await supabase
          .from('member_brand_kits')
          .select('kit')
          .eq('user_id', bkSession.user.id)
          .maybeSingle();
        if (bk && bk.kit && typeof bk.kit === 'object' && Object.keys(bk.kit).length) {
          let local = null;
          try { local = JSON.parse(localStorage.getItem('tmke.brand') || 'null'); } catch (_) {}
          const serverT = Number(bk.kit.updatedAt || 0);
          const localT = Number((local && local.updatedAt) || 0);
          // Server wins unless the browser cache is genuinely newer (edited on
          // this device and not yet synced up).
          if (!local || serverT >= localT) {
            try { localStorage.setItem('tmke.brand', JSON.stringify(bk.kit)); } catch (_) {}
          }
        }
      }
    } catch (_) { /* brand kit is optional — keep the editor usable */ }
  </script>

  <!--
    Stock photo search — Pexels + Unsplash.
    Runs before editor.js so it can flag the bundled Photos grid as
    superseded. Actual API calls fire on user input; clicking a result
    calls `window.__TMKE_ADD_PHOTO__` (exposed by editor.js).
  -->
  <script type="module" define:vars={{ PEXELS_KEY, UNSPLASH_KEY }}>
    // PEXELS_KEY / UNSPLASH_KEY are injected by Astro via define:vars above.
    // Tell editor.js to skip its bundled library — this panel drives the grid.
    window.__TMKE_STOCK_SEARCH_ACTIVE__ = true;

    const inputEl = document.getElementById('ed-stock-input');
    const statusEl = document.getElementById('ed-stock-status');
    const gridEl = document.getElementById('ed-photo-grid');
    const srcCheckboxes = document.querySelectorAll('[data-stock-src]');

    if (!inputEl) {
      // Page didn't render the Photos pane (shouldn't happen). Bail quietly.
    } else {
      function activeSources() {
        return Array.from(srcCheckboxes)
          .filter((c) => c.checked)
          .map((c) => c.getAttribute('data-stock-src'));
      }

      function setStatus(msg, isError = false) {
        if (!statusEl) return;
        statusEl.textContent = msg;
        statusEl.classList.toggle('is-error', !!isError);
      }

      async function searchPexels(query) {
        if (!PEXELS_KEY) return [];
        try {
          const res = await fetch(
            `https://api.pexels.com/v1/search?query=${encodeURIComponent(query)}&per_page=24&orientation=portrait`,
            { headers: { Authorization: PEXELS_KEY } }
          );
          if (!res.ok) throw new Error(`Pexels ${res.status}`);
          const json = await res.json();
          return (json.photos || []).map((p) => ({
            source: 'pexels',
            id: String(p.id),
            thumb: p.src.medium,
            full: p.src.large2x || p.src.large || p.src.original,
            credit: `${p.photographer} on Pexels`,
            creditUrl: p.url,
          }));
        } catch (e) {
          console.warn('Pexels search failed', e);
          return [];
        }
      }

      async function searchUnsplash(query) {
        if (!UNSPLASH_KEY) return [];
        try {
          const res = await fetch(
            `https://api.unsplash.com/search/photos?query=${encodeURIComponent(query)}&per_page=24&orientation=portrait`,
            { headers: { Authorization: `Client-ID ${UNSPLASH_KEY}` } }
          );
          if (!res.ok) throw new Error(`Unsplash ${res.status}`);
          const json = await res.json();
          return (json.results || []).map((r) => ({
            source: 'unsplash',
            id: r.id,
            thumb: r.urls.small,
            full: r.urls.regular,
            credit: `${r.user.name} on Unsplash`,
            creditUrl: r.links.html,
            // Unsplash asks integrators to ping this URL when a photo is "used".
            downloadLocation: r.links.download_location,
          }));
        } catch (e) {
          console.warn('Unsplash search failed', e);
          return [];
        }
      }

      // Interleave two arrays so results from both sources are mixed.
      function interleave(a, b) {
        const out = [];
        const len = Math.max(a.length, b.length);
        for (let i = 0; i < len; i++) {
          if (a[i]) out.push(a[i]);
          if (b[i]) out.push(b[i]);
        }
        return out;
      }

      function renderResults(results) {
        gridEl.innerHTML = '';
        results.forEach((r) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.title = `Photo by ${r.credit}`;
          btn.setAttribute('data-stock-source', r.source);
          const img = document.createElement('img');
          img.src = r.thumb;
          img.alt = r.credit;
          img.loading = 'lazy';
          btn.appendChild(img);
          btn.addEventListener('click', () => addPhoto(r));
          // Make the card draggable so users can drop it directly onto a
          // frame on the canvas to fill it. We expose the full-resolution
          // URL so the frame doesn't render the thumbnail.
          btn.draggable = true;
          btn.addEventListener('dragstart', (e) => {
            if (!e.dataTransfer) return;
            e.dataTransfer.setData('text/uri-list', r.full);
            e.dataTransfer.setData('text/plain', r.full);
            e.dataTransfer.effectAllowed = 'copy';
          });
          gridEl.appendChild(btn);
        });
      }

      async function addPhoto(r) {
        // Fire and forget — Unsplash wants this hit when a photo gets used.
        if (r.source === 'unsplash' && r.downloadLocation && UNSPLASH_KEY) {
          fetch(r.downloadLocation, {
            headers: { Authorization: `Client-ID ${UNSPLASH_KEY}` },
          }).catch(() => {});
        }
        if (typeof window.__TMKE_ADD_PHOTO__ === 'function') {
          window.__TMKE_ADD_PHOTO__(r.full);
        } else {
          console.warn('Editor not ready — __TMKE_ADD_PHOTO__ missing');
        }
      }

      let lastQuery = '';
      let debounceTimer = null;

      async function runSearch() {
        const q = inputEl.value.trim();
        if (q.length < 2) {
          gridEl.innerHTML = '';
          setStatus('Type to search — results from both sources appear here.');
          return;
        }
        if (q === lastQuery) return;
        lastQuery = q;

        const sources = activeSources();
        if (sources.length === 0) {
          setStatus('Pick at least one source (Pexels / Unsplash).', true);
          return;
        }

        setStatus(`Searching for "${q}"…`);
        const calls = [];
        if (sources.includes('pexels')) calls.push(searchPexels(q));
        if (sources.includes('unsplash')) calls.push(searchUnsplash(q));

        const [a = [], b = []] = await Promise.all(calls);
        const merged = sources.length === 2 ? interleave(a, b) : [...a, ...b];

        if (merged.length === 0) {
          gridEl.innerHTML = '';
          setStatus(`No results for "${q}". Try a different word.`, true);
          return;
        }

        renderResults(merged);
        setStatus(`${merged.length} result${merged.length === 1 ? '' : 's'} for "${q}".`);
      }

      inputEl.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(runSearch, 350);
      });

      inputEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          clearTimeout(debounceTimer);
          runSearch();
        }
      });

      srcCheckboxes.forEach((c) =>
        c.addEventListener('change', () => {
          // Force re-run when toggling sources.
          lastQuery = '';
          runSearch();
        })
      );

      // ---- Pull a whole collection from a pasted Pexels / Unsplash link ----
      async function fetchPexelsCollection(id) {
        if (!PEXELS_KEY) return [];
        try {
          const res = await fetch(`https://api.pexels.com/v1/collections/${encodeURIComponent(id)}?type=photos&per_page=80`, { headers: { Authorization: PEXELS_KEY } });
          if (!res.ok) throw new Error(`Pexels ${res.status}`);
          const json = await res.json();
          return (json.media || []).filter((m) => m.src).map((p) => ({
            source: 'pexels', id: String(p.id), thumb: p.src.medium,
            full: p.src.large2x || p.src.large || p.src.original,
            credit: `${p.photographer} on Pexels`, creditUrl: p.url,
          }));
        } catch (e) { console.warn('Pexels collection failed', e); return []; }
      }
      async function fetchUnsplashCollection(id) {
        if (!UNSPLASH_KEY) return [];
        try {
          const res = await fetch(`https://api.unsplash.com/collections/${encodeURIComponent(id)}/photos?per_page=30`, { headers: { Authorization: `Client-ID ${UNSPLASH_KEY}` } });
          if (!res.ok) throw new Error(`Unsplash ${res.status}`);
          const json = await res.json();
          return (json || []).map((r) => ({
            source: 'unsplash', id: r.id, thumb: r.urls.small, full: r.urls.regular,
            credit: `${r.user.name} on Unsplash`, creditUrl: r.links.html, downloadLocation: r.links.download_location,
          }));
        } catch (e) { console.warn('Unsplash collection failed', e); return []; }
      }
      // Parse a Pexels/Unsplash collection link into { service, id, name, url }.
      function parseCollection(url) {
        url = (url || '').trim();
        if (!url) return null;
        try {
          const u = new URL(url);
          if (/pexels\.com/i.test(u.hostname)) {
            const seg = u.pathname.split('/').filter(Boolean).pop() || '';
            const parts = seg.split('-'); const id = parts[parts.length - 1];
            const name = parts.slice(0, -1).join(' ').replace(/\b\w/g, (c) => c.toUpperCase()) || 'Pexels collection';
            return { service: 'pexels', id, name, url };
          }
          if (/unsplash\.com/i.test(u.hostname)) {
            const segs = u.pathname.split('/').filter(Boolean);
            const ci = segs.indexOf('collections');
            const id = ci >= 0 ? segs[ci + 1] : null;
            const name = (ci >= 0 && segs[ci + 2] ? segs[ci + 2].replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase()) : 'Unsplash collection');
            return id ? { service: 'unsplash', id, name, url } : null;
          }
        } catch (_) { /* not a URL */ }
        return null;
      }

      let lastCollection = null;
      let activeKey = null;   // service:id of the collection whose photos are open
      const collectSaveBtn = document.getElementById('ed-collect-save');
      const collectSavedEl = document.getElementById('ed-collect-saved');
      const collectOpenEl = document.getElementById('ed-collect-open');
      const collectOpenName = document.getElementById('ed-collect-open-name');
      const DEFAULT_STOCK_STATUS = 'Type to search — results from both sources appear here.';

      // Withdraw the open collection's photos and collapse back to the folder list.
      function clearResults() {
        gridEl.innerHTML = '';
        activeKey = null; lastCollection = null;
        if (collectOpenEl) collectOpenEl.hidden = true;
        if (collectSaveBtn) collectSaveBtn.hidden = true;
        setStatus(DEFAULT_STOCK_STATUS);
        renderSaved();
      }

      async function pullCollection(url) {
        const c = parseCollection(url);
        if (!c) { setStatus('That doesn’t look like a Pexels or Unsplash collection link.', true); return; }
        setStatus('Pulling collection…');
        const results = c.service === 'pexels' ? await fetchPexelsCollection(c.id) : await fetchUnsplashCollection(c.id);
        if (!results.length) { gridEl.innerHTML = ''; setStatus('Couldn’t pull that collection — check it’s public and the link is right.', true); return; }
        renderResults(results);
        setStatus(`${results.length} photo${results.length === 1 ? '' : 's'} from the collection. Click one to add it.`);
        // Mark it open + offer to save it (unless already saved).
        lastCollection = c;
        activeKey = c.service + ':' + c.id;
        const saved = savedCollections().find((s) => s.service === c.service && s.id === c.id);
        if (collectOpenEl && collectOpenName) {
          collectOpenName.textContent = (saved && saved.name) || c.name || (c.service + ' collection');
          collectOpenEl.hidden = false;
        }
        if (collectSaveBtn) collectSaveBtn.hidden = !!saved;
        renderSaved();
      }

      // ---- Saved collections (localStorage) — click to re-pull, no re-typing ----
      function savedCollections() {
        try { return JSON.parse(localStorage.getItem('tmke.collections') || '[]'); } catch (_) { return []; }
      }
      function writeSaved(list) { try { localStorage.setItem('tmke.collections', JSON.stringify(list)); } catch (_) {} }
      function renderSaved() {
        if (!collectSavedEl) return;
        const list = savedCollections();
        collectSavedEl.innerHTML = list.map((s, i) => {
          const open = activeKey === (s.service + ':' + s.id);
          return '<span class="ed-collect-chip' + (open ? ' is-open' : '') + '" data-i="' + i + '" title="' + s.url.replace(/"/g, '&quot;') + '">' +
            '<span class="ed-collect-chip-dot ed-collect-' + s.service + '"></span>' +
            '<span class="ed-collect-chip-name">' + (s.name || s.service).replace(/</g, '&lt;') + '</span>' +
            '<button type="button" class="ed-collect-chip-x" data-rm="' + i + '" title="Remove">&times;</button>' +
          '</span>';
        }).join('');
      }
      if (collectSaveBtn) collectSaveBtn.addEventListener('click', () => {
        if (!lastCollection) return;
        const list = savedCollections();
        if (!list.some((s) => s.service === lastCollection.service && s.id === lastCollection.id)) {
          list.push(lastCollection); writeSaved(list); renderSaved();
        }
        collectSaveBtn.hidden = true;
      });
      if (collectSavedEl) collectSavedEl.addEventListener('click', (e) => {
        const rm = e.target.closest('[data-rm]');
        if (rm) {
          e.stopPropagation();
          const list = savedCollections(); const removed = list.splice(parseInt(rm.dataset.rm, 10), 1)[0];
          // If we deleted the folder that's currently open, withdraw its photos too.
          if (removed && activeKey === (removed.service + ':' + removed.id)) { writeSaved(list); clearResults(); return; }
          writeSaved(list); renderSaved(); return;
        }
        const chip = e.target.closest('.ed-collect-chip');
        if (chip) {
          const s = savedCollections()[parseInt(chip.dataset.i, 10)];
          if (!s) return;
          // Click an already-open folder to withdraw its photos; otherwise open it.
          if (activeKey === (s.service + ':' + s.id)) { clearResults(); return; }
          document.getElementById('ed-collect-input').value = s.url; pullCollection(s.url);
        }
      });
      const collectCloseBtn = document.getElementById('ed-collect-close');
      if (collectCloseBtn) collectCloseBtn.addEventListener('click', clearResults);
      renderSaved();

      const collectInput = document.getElementById('ed-collect-input');
      const collectBtn = document.getElementById('ed-collect-pull');
      if (collectBtn) collectBtn.addEventListener('click', () => pullCollection(collectInput.value));
      if (collectInput) collectInput.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); pullCollection(collectInput.value); } });

      if (!PEXELS_KEY && !UNSPLASH_KEY) {
        setStatus('No stock photo API keys configured. Set PUBLIC_PEXELS_API_KEY / PUBLIC_UNSPLASH_ACCESS_KEY.', true);
        inputEl.disabled = true;
      }
    }
  </script>

  <script src={`/scripts/editor.js?v=${scriptV}`} is:inline type="module"></script>

  <!-- Pages toggle: the page strip is hidden by default (so the canvas gets
       the full height); this pops it up from the bottom on demand. Standalone
       so it doesn't depend on editor.js's tool-rail handler. -->
  <script is:inline>
    (function () {
      var ed = document.getElementById("editor");
      var toggle = document.getElementById("ed-pages-toggle");
      if (!ed || !toggle) return;
      toggle.addEventListener("click", function () {
        var on = ed.classList.toggle("show-pages");
        toggle.classList.toggle("is-active", on);
        toggle.setAttribute("aria-pressed", on ? "true" : "false");
        // Generate live previews (background + text) when the strip opens.
        if (on && typeof window.__TMKE_REFRESH_THUMBS__ === "function") window.__TMKE_REFRESH_THUMBS__();
      });
    })();
  </script>

  <!--
    Schedule-to-calendar wiring.
    Opens the Schedule modal, validates the form, rasterizes the canvas via
    the editor.js hook (window.__TMKE_RENDER_PNG_BLOB__), uploads the PNG
    to the `calendar-assets` Storage bucket, and inserts a calendar_items
    row. The deep-link param ?schedule=YYYY-MM-DD pre-fills the date when
    the user clicks "Schedule a post for this day" from /account/schedule.
  -->
  <script>
    import { supabase, isConfigured } from "../../lib/supabase.js";

    const $btn      = document.getElementById("ed-schedule");
    const $modal    = document.getElementById("ed-schedule-modal");
    const $close    = document.getElementById("ed-schedule-close");
    const $cancel   = document.getElementById("ed-schedule-cancel");
    const $form     = document.getElementById("ed-schedule-form");
    const $title    = document.getElementById("ed-sched-title");
    const $date     = document.getElementById("ed-sched-date");
    const $time     = document.getElementById("ed-sched-time");
    const $caption  = document.getElementById("ed-sched-caption");
    const $submit   = document.getElementById("ed-schedule-submit");
    const $emailNow = document.getElementById("ed-schedule-emailnow");
    const $remind   = document.getElementById("ed-sched-remind");
    const $error    = document.getElementById("ed-schedule-error");

    // Where the Worker lives (send-now endpoint). Same env the rest of the
    // editor uses for deliverables.
    const API_BASE = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");

    // Bail quietly if the editor doesn't include the modal (e.g. an admin
    // build that strips it). Wrap the rest in an IIFE so we can short-
    // circuit without a top-level `return` (which is a SyntaxError in
    // ES modules).
    if ($btn && $modal && $form) wireSchedule();

    // AI caption → drop the generated copy straight into the caption box.
    document.getElementById("ed-sched-ai")?.addEventListener("click", () => {
      window.tmkeCaption?.open({
        output: "use",
        onUse: (text) => { if ($caption) { $caption.value = text; $caption.dispatchEvent(new Event("input", { bubbles: true })); } },
      });
    });

    function wireSchedule() {

    // ----- helpers -----
    function ymd(d) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, "0");
      const da = String(d.getDate()).padStart(2, "0");
      return `${y}-${m}-${da}`;
    }
    function showError(msg) {
      $error.textContent = msg;
      $error.hidden = false;
    }
    function clearError() {
      $error.hidden = true;
      $error.textContent = "";
    }

    function defaultDate() {
      // Allow ?schedule=YYYY-MM-DD deep-link from the calendar's day drawer.
      const params = new URLSearchParams(location.search);
      const pre = params.get("schedule");
      if (pre && /^\d{4}-\d{2}-\d{2}$/.test(pre)) return pre;
      // Fall back to tomorrow — scheduling for today by default feels
      // panicked, and the reminder time defaults to 09:00 anyway.
      const d = new Date();
      d.setDate(d.getDate() + 1);
      return ymd(d);
    }

    function openModal() {
      clearError();
      // Pull current editor state for sensible defaults.
      const summary = (typeof window.__TMKE_EDITOR_SUMMARY__ === "function")
        ? window.__TMKE_EDITOR_SUMMARY__()
        : { filename: "design", templateId: null };
      $title.value = summary.filename || "Design";
      $date.value = defaultDate();
      // Don't clobber a time the user may have set on a previous open.
      if (!$time.value) $time.value = "09:00";

      const today = new Date();
      const todayYmd = ymd(today);
      $date.min = todayYmd; // can't schedule in the past

      $modal.hidden = false;
      // Stash templateId for the submit handler to pick up.
      $form.dataset.designRef = summary.templateId || "";
      setTimeout(() => $title.focus(), 50);
    }
    function closeModal() {
      $modal.hidden = true;
      $submit.disabled = false;
      $submit.textContent = "Plan post";
      if ($emailNow) { $emailNow.disabled = false; $emailNow.textContent = "Email it to me now"; }
    }

    // Rasterize the current design and push it to Storage. Shared by both the
    // "Plan post" submit and the "Email it to me now" button so they never
    // drift apart. Returns the public asset URL.
    async function renderAndUpload(session) {
      if (typeof window.__TMKE_RENDER_PNG_BLOB__ !== "function") {
        throw new Error("Editor isn't ready yet. Give it a second and try again.");
      }
      const blob = await window.__TMKE_RENDER_PNG_BLOB__();
      if (!blob || blob.size === 0) throw new Error("Couldn't render the canvas. Try again.");
      const id = crypto.randomUUID();
      const path = `${session.user.id}/${id}.png`;
      const { error: upErr } = await supabase.storage
        .from("calendar-assets")
        .upload(path, blob, { contentType: "image/png", upsert: false });
      if (upErr) {
        if (/Bucket not found|404/i.test(upErr.message)) {
          throw new Error('Storage bucket "calendar-assets" not found. Create it in Supabase (Storage → New bucket → public), then run supabase/calendar_storage.sql.');
        }
        throw new Error(upErr.message || "Upload failed.");
      }
      const { data: pub } = supabase.storage.from("calendar-assets").getPublicUrl(path);
      return pub?.publicUrl || "";
    }

    // ----- open / close wiring -----
    $btn.addEventListener("click", openModal);
    $close.addEventListener("click", closeModal);
    $cancel.addEventListener("click", closeModal);
    $modal.addEventListener("click", (e) => { if (e.target === $modal) closeModal(); });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !$modal.hidden) closeModal();
    });

    // Auto-open the modal if we landed here via ?schedule=YYYY-MM-DD.
    // Wait a beat so the editor has a chance to render its current state
    // (so the title pre-fill picks up the right filename).
    const params = new URLSearchParams(location.search);
    if (params.get("schedule")) {
      // Only auto-open after the user has dismissed the pack-picker
      // onboarding — otherwise we'd cover it.
      const tryOpen = () => {
        const overlay = document.getElementById("ed-onboard");
        if (!overlay || overlay.classList.contains("is-gone") || overlay.hidden) {
          openModal();
        } else {
          setTimeout(tryOpen, 300);
        }
      };
      setTimeout(tryOpen, 500);
    }

    // ----- submit -----
    $form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      clearError();

      const title    = ($title.value || "").trim();
      const dateStr  = $date.value;
      const timeStr  = $time.value || "09:00";
      const caption  = ($caption.value || "").trim();
      const platform = $form.querySelector('input[name="ed-sched-platform"]:checked')?.value || "instagram";
      const designRef = $form.dataset.designRef || null;

      if (!title)   return showError("Give the post a short title — it shows on your calendar.");
      if (!dateStr) return showError("Pick a date for the post.");
      if (!isConfigured) {
        return showError("Supabase isn't configured in this environment — set PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY to enable scheduling.");
      }

      // Auth check before we spend cycles rasterizing.
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        return showError("You're signed out. Sign in again, then re-open Schedule.");
      }

      $submit.disabled = true;
      if ($emailNow) $emailNow.disabled = true;
      $submit.textContent = "Planning…";

      try {
        // 1 & 2. Rasterize + upload to Storage (shared helper).
        const assetUrl = await renderAndUpload(session);

        // 3. Insert the calendar row. `reminder` opts them into the 8am
        //    morning-of email (default on via the toggle).
        const wantsReminder = $remind ? !!$remind.checked : true;
        const { error: insErr } = await supabase.from("calendar_items").insert({
          user_id: session.user.id,
          scheduled_date: dateStr,
          scheduled_time: timeStr,
          title,
          caption: caption || null,
          asset_url: assetUrl,
          thumbnail_url: assetUrl, // same image until we generate a real thumb
          design_ref: designRef,
          platform_hint: platform,
          status: "scheduled",
          reminder: wantsReminder,
        });
        if (insErr) {
          if (/relation .* does not exist/i.test(insErr.message)) {
            throw new Error("calendar_items table is missing. Run supabase/calendar.sql in the SQL editor.");
          }
          // If the `reminder` column hasn't been migrated yet, retry without it
          // rather than blocking the whole plan.
          if (/reminder/i.test(insErr.message) && /column/i.test(insErr.message)) {
            const { error: retryErr } = await supabase.from("calendar_items").insert({
              user_id: session.user.id, scheduled_date: dateStr, scheduled_time: timeStr,
              title, caption: caption || null, asset_url: assetUrl, thumbnail_url: assetUrl,
              design_ref: designRef, platform_hint: platform, status: "scheduled",
            });
            if (retryErr) throw new Error(retryErr.message || "Couldn't save to your calendar.");
          } else {
            throw new Error(insErr.message || "Couldn't save to your calendar.");
          }
        }

        // 4. Done — close modal and bounce to the calendar so the user
        //    sees their new entry in context.
        closeModal();
        location.href = `/account/schedule?scheduled=${encodeURIComponent(dateStr)}`;
      } catch (err) {
        console.error("[schedule]", err);
        showError(err.message || "Something went wrong planning that post.");
        $submit.disabled = false;
        if ($emailNow) $emailNow.disabled = false;
        $submit.textContent = "Plan post";
      }
    });

    // ----- "Email it to me now" -----
    // Render + upload the current design, then ask the Worker to email it
    // (caption + image) to the signed-in member's inbox straight away. Same
    // content as the day-of reminder — for people who design on desktop but
    // post from their phone.
    if ($emailNow) $emailNow.addEventListener("click", async () => {
      clearError();
      const title    = ($title.value || "").trim() || "Your design";
      const caption  = ($caption.value || "").trim();
      const platform = $form.querySelector('input[name="ed-sched-platform"]:checked')?.value || "instagram";

      if (!isConfigured) {
        return showError("Supabase isn't configured in this environment.");
      }
      if (!API_BASE) {
        return showError("Email isn't available here — set PUBLIC_R2_WORKER_URL.");
      }
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        return showError("You're signed out. Sign in again, then re-open this.");
      }

      $emailNow.disabled = true;
      $submit.disabled = true;
      $emailNow.textContent = "Sending…";
      try {
        const assetUrl = await renderAndUpload(session);
        const res = await fetch(`${API_BASE}/calendar/send-now`, {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Authorization: `Bearer ${session.access_token}`,
          },
          body: JSON.stringify({ asset_url: assetUrl, caption, title, platform }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || !out.ok) {
          throw new Error(out.error || "Couldn't send the email — try again.");
        }
        $emailNow.textContent = "Sent ✓";
        showError("");
        $error.hidden = false;
        $error.style.color = "";
        $error.textContent = `Sent to ${out.to || "your inbox"} — check your phone.`;
        $error.classList.add("is-ok");
        setTimeout(() => {
          $emailNow.disabled = false;
          $submit.disabled = false;
          $emailNow.textContent = "Email it to me now";
          $error.classList.remove("is-ok");
          clearError();
        }, 4000);
      } catch (err) {
        console.error("[email-now]", err);
        $error.classList.remove("is-ok");
        showError(err.message || "Couldn't email that post.");
        $emailNow.disabled = false;
        $submit.disabled = false;
        $emailNow.textContent = "Email it to me now";
      }
    });

    // Toggle the active style on the platform radio so the visible "card"
    // matches the underlying selection (for when we light up the other
    // platforms later).
    $form.querySelectorAll('input[name="ed-sched-platform"]').forEach((r) => {
      r.addEventListener("change", () => {
        $form.querySelectorAll(".ed-sched-platform-opt").forEach((opt) => opt.classList.remove("is-active"));
        r.closest(".ed-sched-platform-opt")?.classList.add("is-active");
      });
    });

    } // end wireSchedule
  </script>

  <!-- Admin chrome + Publish → Pack. In admin mode the studio is an authoring
       tool, not a posting tool: drop Schedule, bury Download, surface Publish.
       Publish writes each page as a template, optionally linked to a pack. -->
  <script>
    import { supabase } from "../../lib/supabase.js";

    // Self-contained image externaliser for Publish (doesn't rely on the admin
    // bootstrap module, which loads separately). Uploads any embedded base64
    // data-URL images to the public `calendar-assets` bucket and swaps in the
    // URL, so the `templates` rows stay small (otherwise the insert is rejected
    // as too large → "Failed to fetch" / statement timeout).
    const _pubImgCache = new Map();
    let _pubUid = null;
    async function _pubGetUid() {
      if (_pubUid) return _pubUid;
      try { const { data } = await supabase.auth.getSession(); _pubUid = (data && data.session && data.session.user && data.session.user.id) || null; } catch (_) {}
      return _pubUid;
    }
    async function _pubUpload(dataUrl) {
      const m = /^data:([^;]+);base64,(.+)$/.exec(dataUrl);
      if (!m) return dataUrl;
      const mime = m[1], b64 = m[2];
      let h = 5381; for (let i = 0; i < dataUrl.length; i++) h = ((h * 33) ^ dataUrl.charCodeAt(i)) >>> 0;
      const ext = ((mime.split('/')[1] || 'png').toLowerCase().replace('jpeg', 'jpg').replace(/[^a-z0-9]/g, '')) || 'png';
      // calendar-assets RLS requires the first folder to be the user's id.
      const uid = await _pubGetUid();
      const key = (uid ? uid + '/' : '') + 'templates/' + h.toString(36) + '-' + dataUrl.length.toString(36) + '.' + ext;
      const bin = atob(b64); const bytes = new Uint8Array(bin.length);
      for (let i = 0; i < bin.length; i++) bytes[i] = bin.charCodeAt(i);
      const { error } = await supabase.storage.from('calendar-assets').upload(key, new Blob([bytes], { type: mime }), { cacheControl: '31536000', upsert: true, contentType: mime });
      if (error && !/exists|duplicate/i.test(error.message || '')) throw error;
      return supabase.storage.from('calendar-assets').getPublicUrl(key).data.publicUrl || dataUrl;
    }
    async function _pubExternUrl(v) {
      if (typeof v !== 'string' || !v.startsWith('data:')) return v;
      if (_pubImgCache.has(v)) return _pubImgCache.get(v);
      const url = await _pubUpload(v); _pubImgCache.set(v, url); return url;
    }
    async function externalizePagesLocal(pages) {
      for (const pg of (pages || [])) {
        if (pg && pg.canvas && typeof pg.canvas.backgroundImage === 'string') pg.canvas.backgroundImage = await _pubExternUrl(pg.canvas.backgroundImage);
        for (const el of ((pg && pg.elements) || [])) { if (el && typeof el.src === 'string') el.src = await _pubExternUrl(el.src); }
      }
      return pages;
    }

    const isAdmin = new URLSearchParams(location.search).get("mode") === "admin";
    const publishBtn = document.getElementById("ed-publish");
    const scheduleBtn = document.getElementById("ed-schedule");
    const downloadWrap = document.getElementById("ed-download");

    if (isAdmin) {
      if (scheduleBtn) scheduleBtn.hidden = true;          // posting is a customer action
      if (downloadWrap) downloadWrap.style.display = "none"; // buried — admins publish, not download
      if (publishBtn) publishBtn.hidden = false;
      // Admins don't need the customer-facing help widget.
      document.getElementById("ask-expert-trigger")?.remove();
      document.getElementById("ask-expert-panel")?.remove();
      // Keep navigation INSIDE the admin section — the studio's back arrow / logo
      // / onboarding "Back" otherwise point at /account and /, bouncing admins
      // out to the customer login.
      const backLink = document.querySelector(".ed-back");
      if (backLink) { backLink.setAttribute("href", "/admin/templates"); backLink.setAttribute("title", "Back to templates"); }
      const logoLink = document.querySelector(".ed-logo");
      if (logoLink) logoLink.setAttribute("href", "/admin");
      const onboardBack = document.getElementById("ed-onboard-back");
      if (onboardBack) { onboardBack.setAttribute("href", "/admin"); onboardBack.setAttribute("aria-label", "Back to admin"); }
    } else if (publishBtn) {
      publishBtn.hidden = true;
    }

    function slugify(s) {
      return String(s || "").toLowerCase().trim()
        .replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 60) || ("pack-" + Date.now());
    }

    // Styled, centred publish modal. Resolves to a choice object or null.
    function openPublishModal(packs, currentPackId) {
      return new Promise((resolve) => {
        const scrim = document.createElement("div");
        scrim.className = "ed-pub-scrim";
        // If this design is already in a pack, pre-select that pack so re-
        // publishing keeps it where it is (unless the admin changes it).
        const inPack = !!currentPackId && packs.some((p) => p.id === currentPackId);
        const opts = packs.map((p) => `<option value="${p.id}" ${p.id === currentPackId ? "selected" : ""}>${(p.title || p.slug).replace(/</g, "&lt;")}</option>`).join("");
        scrim.innerHTML = `
          <div class="ed-pub" role="dialog" aria-modal="true">
            <div class="ed-pub-eyebrow">Publish</div>
            <h2 class="ed-pub-title">Save this design <em>to a pack?</em></h2>
            <p class="ed-pub-sub">${inPack ? "This design is already in a pack — that pack is pre-selected below. Re-publishing keeps it there unless you change it." : "These pages become editable templates. Add them to a pack now, or publish without one."}</p>
            <div class="ed-pub-choices">
              <label class="ed-pub-choice"><input type="radio" name="ed-pub" value="new" ${inPack ? "" : "checked"}> <span>Create a new pack</span></label>
              <input type="text" class="ed-pub-newname" placeholder="Pack name — e.g. Community Spotlight" />
              <label class="ed-pub-choice ${packs.length ? "" : "is-disabled"}"><input type="radio" name="ed-pub" value="existing" ${packs.length ? "" : "disabled"} ${inPack ? "checked" : ""}> <span>Add to an existing pack</span></label>
              <select class="ed-pub-existing" ${packs.length ? "" : "disabled"}>${opts || '<option>No packs yet</option>'}</select>
              <label class="ed-pub-choice"><input type="radio" name="ed-pub" value="none"> <span>Not yet — just publish the templates</span></label>
            </div>
            <div class="ed-pub-actions">
              <button type="button" class="ed-pub-cancel">Cancel</button>
              <button type="button" class="ed-pub-ok">Publish</button>
            </div>
          </div>`;
        document.body.appendChild(scrim);
        const done = (val) => { scrim.classList.remove("is-open"); setTimeout(() => scrim.remove(), 200); resolve(val); };
        scrim.querySelector(".ed-pub-cancel").addEventListener("click", () => done(null));
        scrim.addEventListener("mousedown", (e) => { if (e.target === scrim) done(null); });
        scrim.querySelector(".ed-pub-ok").addEventListener("click", () => {
          const mode = scrim.querySelector('input[name="ed-pub"]:checked').value;
          if (mode === "new") {
            const name = scrim.querySelector(".ed-pub-newname").value.trim();
            if (!name) { scrim.querySelector(".ed-pub-newname").focus(); return; }
            done({ mode, name });
          } else if (mode === "existing") {
            done({ mode, packId: scrim.querySelector(".ed-pub-existing").value });
          } else { done({ mode: "none" }); }
        });
        requestAnimationFrame(() => scrim.classList.add("is-open"));
      });
    }

    async function doPublish() {
      if (typeof window.__TMKE_PUBLISH_DATA__ !== "function") return;
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) { alert("Sign in as an admin to publish."); return; }

      // Load existing packs for the "add to existing" option.
      let packs = [];
      try {
        const { data } = await supabase.from("packs").select("id, slug, title").order("sort_order", { ascending: true });
        packs = data || [];
      } catch (_) {}

      // If this design is already a published template, find which pack it's in
      // so the modal can pre-select it (no guessing on re-publish).
      let currentPackId = null;
      try {
        const sum = typeof window.__TMKE_EDITOR_SUMMARY__ === "function" ? window.__TMKE_EDITOR_SUMMARY__() : null;
        const tid = sum && sum.templateId;
        if (tid && !String(tid).startsWith("draft-")) {
          const { data: row } = await supabase.from("templates").select("pack_id").eq("id", tid).single();
          currentPackId = (row && row.pack_id) || null;
        }
      } catch (_) {}

      const choice = await openPublishModal(packs, currentPackId);
      if (!choice) return;

      publishBtn.disabled = true;
      const original = publishBtn.textContent;
      publishBtn.textContent = "Publishing…";
      try {
        const data = await window.__TMKE_PUBLISH_DATA__();

        // Upload embedded data-URL images to storage so the template rows stay
        // small (otherwise the insert fails / times out on big Canva imports).
        publishBtn.textContent = "Uploading images…";
        try {
          await externalizePagesLocal(data.pages);
        } catch (e) {
          console.error("[publish: externalize]", e);
          throw new Error("Couldn't upload the design images to storage: " + (e.message || e) + ". (Check the 'calendar-assets' bucket exists and is public.)");
        }
        publishBtn.textContent = "Publishing…";

        // Resolve the target pack id (or null).
        let packId = null;
        if (choice.mode === "new") {
          // New packs land as a DRAFT — they only go on the catalogue once an
          // admin adds a cover, description, price etc. and sets them Active in
          // the catalogue editor. Stops half-finished packs hitting the storefront.
          const { data: pack, error } = await supabase.from("packs").insert({
            slug: slugify(choice.name), title: choice.name, status: "draft", sort_order: 9000,
          }).select("id").single();
          if (error) throw error;
          packId = pack.id;
        } else if (choice.mode === "existing") {
          packId = choice.packId;
        }

        // Each page's thumbnail is a proper RENDER of the design (text and all),
        // uploaded to storage. Fall back to the bare background only if the
        // render is missing.
        const pageThumb = (pg) => {
          if (pg.canvas && pg.canvas.backgroundImage) return pg.canvas.backgroundImage;
          const img = (pg.elements || []).find((e) => e && e.type === "image" && e.src);
          return img ? img.src : null;
        };
        async function thumbFor(pg) {
          if (typeof pg.thumb === "string" && pg.thumb.startsWith("data:")) {
            try { return await _pubUpload(pg.thumb); } catch (_) {}
          }
          return pageThumb(pg);
        }
        // Full-resolution lossless render for the shop (render_url). Falls back to
        // the thumb, then the bare background, if the render is missing.
        async function renderFor(pg) {
          if (typeof pg.render === "string" && pg.render.startsWith("data:")) {
            try { return await _pubUpload(pg.render); } catch (_) {}
          }
          return await thumbFor(pg);
        }

        // A loaded, already-published design carries its real template id. Re-
        // publishing must UPDATE that same row (never duplicate) and re-assign it
        // to the chosen pack — moving it out of whatever pack it was in.
        const existingId = data.templateId && !String(data.templateId).startsWith("draft-") ? data.templateId : null;

        if (existingId && data.pages.length === 1) {
          const pg = data.pages[0];
          const thumb_url = await thumbFor(pg);
          const render_url = await renderFor(pg);
          const patch = { name: data.filename, canvas: pg.canvas, elements: pg.elements, thumb_url, render_url, status: "active" };
          if (choice.mode !== "none") patch.pack_id = packId;   // move into the chosen pack
          const { error: uErr } = await supabase.from("templates").update(patch).eq("id", existingId);
          if (uErr) throw uErr;
          publishBtn.textContent = "Re-published ✓";
          alert(choice.mode !== "none"
            ? "Updated this template in place and moved it to the chosen pack — no duplicate created."
            : "Updated this template in place — no duplicate created.");
          setTimeout(() => { publishBtn.textContent = original; publishBtn.disabled = false; }, 1800);
          return;
        }

        // New design — write each page as a fresh template row, linked to the pack.
        const rows = [];
        for (let i = 0; i < data.pages.length; i++) {
          const pg = data.pages[i];
          rows.push({
            id: "tmpl-" + Math.random().toString(36).slice(2, 9),
            name: data.filename + (data.pages.length > 1 ? " — " + String(i + 1).padStart(2, "0") : ""),
            canvas: pg.canvas,
            elements: pg.elements,
            thumb_url: await thumbFor(pg),
            render_url: await renderFor(pg),
            pack_id: packId,
            status: "active",
            sort_order: i,
          });
        }
        const { error: tErr } = await supabase.from("templates").insert(rows);
        if (tErr) throw tErr;

        publishBtn.textContent = "Sent to catalogue ✓";
        alert("Saved to the Catalogue as a draft. Add a cover, description and price in Admin → Catalogue, then set it Active to put it live.");
        setTimeout(() => { publishBtn.textContent = original; publishBtn.disabled = false; }, 1800);
      } catch (err) {
        console.error("[publish]", err);
        alert("Publish failed: " + (err.message || err));
        publishBtn.textContent = original;
        publishBtn.disabled = false;
      }
    }

    if (isAdmin && publishBtn) publishBtn.addEventListener("click", doPublish);

    // Bulk "Regenerate previews" — re-render every template's thumbnail at full
    // resolution so existing packs get crisp previews without re-opening each.
    const regenBtn = document.getElementById("ed-regen");
    if (isAdmin && regenBtn) {
      regenBtn.hidden = false;
      regenBtn.addEventListener("click", async () => {
        if (typeof window.__TMKE_REGEN_ALL__ !== "function") { alert("Not ready yet — give the studio a second to finish loading, then try again."); return; }
        if (!confirm("Re-render EVERY template preview at full resolution? This updates all packs and can take a minute or two. It only changes previews, not your designs.")) return;
        const orig = regenBtn.textContent;
        regenBtn.disabled = true;
        try {
          const res = await window.__TMKE_REGEN_ALL__((done, total) => { regenBtn.textContent = `Regenerating ${done}/${total}…`; });
          const ok = res.done - res.failed;
          regenBtn.textContent = `Done ✓`;
          alert(`Regenerated ${ok} of ${res.total} previews.` + (res.failed ? ` ${res.failed} failed — see the console.` : " Re-publishing covers will now use the crisp versions."));
        } catch (e) {
          console.error("[regen]", e);
          alert("Regenerate failed: " + (e.message || e));
        } finally {
          regenBtn.disabled = false;
          setTimeout(() => { regenBtn.textContent = orig; }, 3000);
        }
      });
    }

    // ---- Canva import (admin): a TWO-STAGE flow that fixes the duplicate-words
    // problem. Stage 1 = the finished designs (text baked in) — we read the
    // wording off these. Stage 2 = the same pages as plain backgrounds — these
    // become the editable canvas. We lay the read text onto the backgrounds, so
    // nothing is doubled up. (Backgrounds alone still work: you just get blank
    // pages to type on.) ----
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    if (isAdmin) {
      const canvaWrap = document.getElementById("ed-canva-import");
      const cstatus = document.getElementById("ed-canva-status");
      if (canvaWrap) canvaWrap.hidden = false;

      const setC = (msg, err) => { if (!cstatus) return; cstatus.hidden = false; cstatus.textContent = msg; cstatus.classList.toggle("is-error", !!err); };
      const blobToDataURL = (blob) => new Promise((res, rej) => { const r = new FileReader(); r.onload = () => res(r.result); r.onerror = rej; r.readAsDataURL(blob); });
      const imgDims = (src) => new Promise((res) => { const i = new Image(); i.onload = () => res({ w: i.naturalWidth, h: i.naturalHeight }); i.onerror = () => res({ w: 1080, h: 1350 }); i.src = src; });
      // Downscale an image to a sane max edge before sending to the AI. Claude
      // resizes anything over ~1568px anyway, and oversized Canva exports get
      // rejected by Anthropic with "Could not process image" — so cap it here.
      // Returns { src, w, h } in the downscaled space so coordinates map back.
      const downscaleForAI = (src, maxEdge = 1568) => new Promise((res) => {
        const img = new Image();
        img.onload = () => {
          const long = Math.max(img.naturalWidth, img.naturalHeight) || 1;
          const k = long > maxEdge ? maxEdge / long : 1;
          const w = Math.max(1, Math.round(img.naturalWidth * k));
          const h = Math.max(1, Math.round(img.naturalHeight * k));
          try {
            const c = document.createElement("canvas"); c.width = w; c.height = h;
            c.getContext("2d").drawImage(img, 0, 0, w, h);
            // Step the JPEG quality down if the encoded copy is somehow still
            // heavy, so we never hand Claude something over its 10 MB limit.
            let q = 0.9, out = c.toDataURL("image/jpeg", q);
            while (out.length > 9_000_000 && q > 0.4) { q -= 0.15; out = c.toDataURL("image/jpeg", q); }
            res({ src: out, w, h });
          } catch (_) { res({ src: null, w: 0, h: 0 }); }
        };
        // If the image can't even be decoded, return no src — never fall back
        // to posting the (possibly huge) original.
        img.onerror = () => res({ src: null, w: 0, h: 0 });
        img.src = src;
      });

      // Read every image out of a .zip into [{src,w,h}], sorted by filename.
      async function parseZipImages(file) {
        let JSZip;
        try { ({ default: JSZip } = await import("https://esm.sh/jszip@3.10.1")); }
        catch (e) { throw new Error("Couldn’t load the zip reader — check your connection."); }
        let zip;
        try { zip = await JSZip.loadAsync(file); } catch (e) { throw new Error("That doesn’t look like a valid .zip."); }
        const entries = [];
        zip.forEach((path, entry) => {
          if (!entry.dir && /\.(png|jpe?g|webp)$/i.test(path) && !/__MACOSX|\/\._/.test(path)) entries.push(entry);
        });
        entries.sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));
        const images = [];
        for (const e of entries) {
          try {
            const blob = await e.async("blob");
            const dataUrl = await blobToDataURL(blob);
            const dims = await imgDims(dataUrl);
            images.push({ src: dataUrl, w: dims.w, h: dims.h });
          } catch (_) { /* skip a bad entry */ }
        }
        return images;
      }

      let finalImages = [];   // stage 1 — finished designs (read these)
      let bgImages = [];      // stage 2 — plain backgrounds (canvas)
      const buildBtn = document.getElementById("ed-canva-build");
      const buildSub = document.getElementById("ed-canva-build-sub");

      function refreshBuild() {
        if (!buildBtn) return;
        buildBtn.disabled = !bgImages.length;
        if (!bgImages.length) { if (buildSub) buildSub.textContent = "— add backgrounds first"; return; }
        if (finalImages.length) { if (buildSub) buildSub.textContent = "— " + bgImages.length + " page" + (bgImages.length === 1 ? "" : "s") + ", text read from finished"; }
        else { if (buildSub) buildSub.textContent = "— " + bgImages.length + " blank page" + (bgImages.length === 1 ? "" : "s"); }
      }

      // Read images from a drop: a .zip (expand it) OR one-or-more image files
      // dropped directly. Returns [{src,w,h}] in filename order.
      async function readDropped(fileList) {
        const files = Array.from(fileList || []);
        if (!files.length) return [];
        const zips = files.filter((f) => /\.zip$/i.test(f.name) || /zip/i.test(f.type));
        if (zips.length) {
          let all = [];
          for (const z of zips) all = all.concat(await parseZipImages(z));
          return all;
        }
        const imgFiles = files
          .filter((f) => /^image\//i.test(f.type) || /\.(png|jpe?g|webp)$/i.test(f.name))
          .sort((a, b) => a.name.localeCompare(b.name, undefined, { numeric: true }));
        const images = [];
        for (const f of imgFiles) {
          try {
            const dataUrl = await blobToDataURL(f);
            const dims = await imgDims(dataUrl);
            images.push({ src: dataUrl, w: dims.w, h: dims.h });
          } catch (_) { /* skip a bad file */ }
        }
        return images;
      }

      // Show little thumbnails of what was loaded, so a drop is clearly visible.
      function renderThumbs(el, imgs) {
        if (!el) return;
        if (!imgs.length) { el.hidden = true; el.innerHTML = ""; return; }
        el.hidden = false;
        el.innerHTML =
          imgs.slice(0, 12).map(() => '<span class="ed-canva-thumb"></span>').join("") +
          (imgs.length > 12 ? '<span class="ed-canva-thumb ed-canva-thumb--more">+' + (imgs.length - 12) + '</span>' : "");
        // Same trap as the background image grid: a JSON-quoted URL inside a
        // double-quoted style attribute closes the attribute at url(, and every
        // thumbnail draws blank. Set it on the element instead.
        el.querySelectorAll(".ed-canva-thumb:not(.ed-canva-thumb--more)").forEach((sp, i) => {
          sp.style.backgroundImage = "url(" + JSON.stringify(imgs[i].src) + ")";
        });
      }

      function wireDrop(dropId, inputId, badgeId, thumbsId, onImages) {
        const drop = document.getElementById(dropId);
        const input = document.getElementById(inputId);
        const badge = document.getElementById(badgeId);
        const thumbs = document.getElementById(thumbsId);
        const handle = async (fileList) => {
          const files = Array.from(fileList || []);
          if (!files.length) return;
          if (drop) drop.classList.add("is-loading");
          setC("Reading " + files.length + " file" + (files.length === 1 ? "" : "s") + "…");
          try {
            const imgs = await readDropped(files);
            if (!imgs.length) {
              if (drop) drop.classList.remove("is-loading");
              setC("No images found — drop PNG/JPG files, or a .zip of them.", true);
              return;
            }
            onImages(imgs);
            if (badge) { badge.hidden = false; badge.textContent = imgs.length + " image" + (imgs.length === 1 ? "" : "s") + " ✓"; }
            renderThumbs(thumbs, imgs);
            if (drop) { drop.classList.remove("is-loading"); drop.classList.add("is-loaded"); }
            setC("");
            refreshBuild();
          } catch (e) {
            if (drop) drop.classList.remove("is-loading");
            setC(e.message || "Couldn’t read those files.", true);
          }
        };
        if (input) input.addEventListener("change", () => { handle(input.files); input.value = ""; });
        if (drop) {
          drop.addEventListener("dragover", (e) => { e.preventDefault(); drop.classList.add("is-drag"); });
          drop.addEventListener("dragleave", () => drop.classList.remove("is-drag"));
          drop.addEventListener("drop", (e) => { e.preventDefault(); drop.classList.remove("is-drag"); handle(e.dataTransfer.files); });
        }
      }
      wireDrop("ed-canva-drop-final", "ed-canva-zip-final", "ed-canva-final-badge", "ed-canva-final-thumbs", (imgs) => { finalImages = imgs; });
      wireDrop("ed-canva-drop-bg", "ed-canva-zip-bg", "ed-canva-bg-badge", "ed-canva-bg-thumbs", (imgs) => { bgImages = imgs; });

      if (buildBtn) buildBtn.addEventListener("click", async () => {
        if (!bgImages.length) return;
        // Create the editable pages from the plain backgrounds first.
        if (typeof window.__TMKE_IMPORT_BACKGROUNDS__ === "function") window.__TMKE_IMPORT_BACKGROUNDS__(bgImages);

        if (!finalImages.length) {
          setC(bgImages.length + " blank page" + (bgImages.length === 1 ? "" : "s") + " created — type your text, then Publish.");
          return;
        }
        // Read the wording off the finished designs and lay it onto each page.
        const n = Math.min(bgImages.length, finalImages.length);
        if (finalImages.length !== bgImages.length) {
          if (!confirm("You dropped " + finalImages.length + " finished design" + (finalImages.length === 1 ? "" : "s") + " and " + bgImages.length + " background" + (bgImages.length === 1 ? "" : "s") + ". I'll match the first " + n + " by order. Continue?")) return;
        }
        const token = await aiPrechecks(); if (!token) { setC("Sign in / set the AI worker to read text.", true); return; }
        if (!confirm("Read text from " + n + " finished design" + (n === 1 ? "" : "s") + "? This makes " + n + " AI requests (a few pence each).")) return;
        buildBtn.disabled = true;
        if (typeof window.__TMKE_SET_BUSY__ === "function") window.__TMKE_SET_BUSY__(true); // lock page clicks
        let total = 0, lastErr = null, failed = 0;
        try {
          for (let i = 0; i < n; i++) {
            setC("Reading page " + (i + 1) + " of " + n + "…");
            if (typeof window.__TMKE_GOTO_PAGE__ === "function") window.__TMKE_GOTO_PAGE__(i);
            await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
            try {
              const fin = finalImages[i], bg = bgImages[i];
              // Downscale before sending so big Canva exports aren't rejected.
              const ai = await downscaleForAI(fin.src, 1568);
              if (!ai.src) throw new Error("couldn't read that image file");
              const baseW = ai.w || fin.w, baseH = ai.h || fin.h;
              const blocks = await aiParse(token, { image: ai.src, width: baseW, height: baseH });
              // Map coordinates from the (downscaled) finished image into the
              // background's space.
              const sx = (bg.w || baseW) / (baseW || 1), sy = (bg.h || baseH) / (baseH || 1);
              const scaled = (blocks || []).map((b) => Object.assign({}, b, {
                x: (b.x || 0) * sx, y: (b.y || 0) * sy,
                w: (b.w || 0) * sx, h: (b.h || 0) * sy,
                fontSize: (b.fontSize || 32) * ((sx + sy) / 2),
              }));
              total += (typeof window.__TMKE_AI_PLACE_TEXT__ === "function") ? window.__TMKE_AI_PLACE_TEXT__(scaled) : 0;
            } catch (e) { failed++; lastErr = e; console.error("[canva build page " + i + "]", e); }
          }
          if (total === 0 && lastErr) {
            // Don't claim success when every page failed (e.g. the AI worker
            // isn't configured) — show why.
            setC("Pages created, but text couldn't be read: " + (lastErr.message || lastErr) + " — you can still type on each page, or use “Read text with AI” once that's set up.", true);
          } else {
            const note = failed ? " (" + failed + " page" + (failed === 1 ? "" : "s") + " couldn't be read)" : "";
            setC("Done — " + total + " text box" + (total === 1 ? "" : "es") + " placed across " + n + " page" + (n === 1 ? "" : "s") + note + ". Tweak fonts/positions, then Publish.");
            // Open the side-by-side compare so they can check it's like-for-like.
            try { await openCompare(finalImages.slice(0, n)); } catch (_) {}
          }
        } catch (err) { console.error("[canva build]", err); setC("Couldn’t finish: " + (err.message || err), true); }
        finally {
          buildBtn.disabled = false;
          if (typeof window.__TMKE_SET_BUSY__ === "function") window.__TMKE_SET_BUSY__(false); // unlock
        }
      });

      // ---- Side-by-side compare: studio render (left) vs Canva original
      // (right), one row per page, so admins can confirm it's like-for-like. ----
      async function openCompare(canvaImgs) {
        let studio = [];
        try {
          const data = (typeof window.__TMKE_REVIEW_DATA__ === "function") ? await window.__TMKE_REVIEW_DATA__() : null;
          studio = (data && data.pageImages) || [];
        } catch (_) {}
        const n = Math.min(studio.length, canvaImgs.length);
        if (!n) return;
        const rows = [];
        for (let i = 0; i < n; i++) {
          rows.push(
            '<div class="ed-cmp-row">' +
              '<div class="ed-cmp-cell"><span class="ed-cmp-tag">Studio design</span>' +
                (studio[i] ? '<img src="' + studio[i] + '" alt="Studio page ' + (i + 1) + '" />' : '<div class="ed-cmp-missing">—</div>') +
              '</div>' +
              '<div class="ed-cmp-cell"><span class="ed-cmp-tag ed-cmp-tag--alt">Canva design</span>' +
                '<img src="' + canvaImgs[i].src + '" alt="Canva page ' + (i + 1) + '" />' +
              '</div>' +
            '</div>'
          );
        }
        const scrim = document.createElement("div");
        scrim.className = "ed-cmp-scrim";
        scrim.innerHTML =
          '<div class="ed-cmp" role="dialog" aria-modal="true">' +
            '<div class="ed-cmp-head">' +
              '<div class="ed-cmp-check" aria-hidden="true">✓</div>' +
              '<div><div class="ed-cmp-title">Pages built — compare</div>' +
              '<div class="ed-cmp-sub">Your studio version (left) next to the original Canva design (right). Tweak anything that’s off, then Publish.</div></div>' +
              '<button type="button" class="ed-cmp-done" id="ed-cmp-done">Looks good →</button>' +
            '</div>' +
            '<div class="ed-cmp-body">' + rows.join("") + '</div>' +
          '</div>';
        document.body.appendChild(scrim);
        requestAnimationFrame(() => scrim.classList.add("is-open"));
        const close = () => { scrim.classList.remove("is-open"); setTimeout(() => scrim.remove(), 250); };
        scrim.querySelector("#ed-cmp-done").addEventListener("click", close);
        scrim.addEventListener("mousedown", (e) => { if (e.target === scrim) close(); });
        document.addEventListener("keydown", function esc(e) { if (e.key === "Escape") { close(); document.removeEventListener("keydown", esc); } });
      }

      // ---- "Read text with AI": send a page image to the Worker's /ai/parse
      // route (which calls Claude) and place the returned text. ----
      const aiBtn = document.getElementById("ed-ai-read");
      const aiAllBtn = document.getElementById("ed-ai-read-all");
      const aiStatus = document.getElementById("ed-ai-status");
      const setAi = (msg, err) => { if (!aiStatus) return; aiStatus.hidden = false; aiStatus.textContent = msg; aiStatus.classList.toggle("is-error", !!err); };

      // POST an image payload to the parser and return the raw text blocks.
      async function aiParse(token, payload) {
        const res = await fetch(`${WORKER}/ai/parse`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${token}` },
          body: JSON.stringify(payload),
        });
        const out = await res.json();
        if (!res.ok) throw new Error(out.error || ("AI failed (" + res.status + ")"));
        return out.blocks || [];
      }
      // Read the CURRENT page: snapshot → parse → place text. Returns count.
      async function aiReadCurrentPage(token) {
        const page = await window.__TMKE_PAGE_IMAGE__();
        if (!page.image) throw new Error("Couldn't snapshot this page.");
        const blocks = await aiParse(token, page);
        return (typeof window.__TMKE_AI_PLACE_TEXT__ === "function") ? window.__TMKE_AI_PLACE_TEXT__(blocks) : 0;
      }
      async function aiPrechecks() {
        if (!WORKER) { setAi("Set PUBLIC_R2_WORKER_URL to use the AI parser.", true); return null; }
        if (typeof window.__TMKE_PAGE_IMAGE__ !== "function") { setAi("Editor isn't ready — try again.", true); return null; }
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) { setAi("Sign in to use the AI parser.", true); return null; }
        return session.access_token;
      }

      if (aiBtn) aiBtn.addEventListener("click", async () => {
        const token = await aiPrechecks(); if (!token) return;
        aiBtn.disabled = true; if (aiAllBtn) aiAllBtn.disabled = true;
        setAi("Reading this page…");
        try {
          const n = await aiReadCurrentPage(token);
          setAi(n ? ("Added " + n + " text box" + (n === 1 ? "" : "es") + " — tweak as needed.") : "No text found on this page.");
        } catch (err) { console.error("[ai]", err); setAi("Couldn't read this page: " + (err.message || err), true); }
        finally { aiBtn.disabled = false; if (aiAllBtn) aiAllBtn.disabled = false; }
      });

      if (aiAllBtn) aiAllBtn.addEventListener("click", async () => {
        const token = await aiPrechecks(); if (!token) return;
        const count = (typeof window.__TMKE_PAGE_COUNT__ === "function") ? window.__TMKE_PAGE_COUNT__() : 1;
        if (count > 1 && !confirm("Read text on all " + count + " pages? This makes " + count + " AI requests (a few pence each).")) return;
        aiBtn.disabled = true; aiAllBtn.disabled = true;
        let total = 0;
        try {
          for (let i = 0; i < count; i++) {
            if (typeof window.__TMKE_GOTO_PAGE__ === "function") window.__TMKE_GOTO_PAGE__(i);
            await new Promise((r) => requestAnimationFrame(() => requestAnimationFrame(r)));
            setAi("Reading page " + (i + 1) + " of " + count + "…");
            try { total += await aiReadCurrentPage(token); }
            catch (e) { console.error("[ai page " + i + "]", e); }
          }
          setAi("Done — added " + total + " text box" + (total === 1 ? "" : "es") + " across " + count + " page" + (count === 1 ? "" : "s") + ".");
        } catch (err) { console.error("[ai all]", err); setAi("Couldn't finish: " + (err.message || err), true); }
        finally { aiBtn.disabled = false; aiAllBtn.disabled = false; }
      });
    }
  </script>

  <!-- Share menu: "Send for review" (ask a teammate to approve) or share/save
       the image. The review request stores the design + reviewer in Supabase;
       the reviewer's viewing experience is the next pass. -->
  <script>
    import { supabase } from "../../lib/supabase.js";

    const reviewBtn = document.getElementById("ed-review-btn");

    function openReviewModal() {
      const scrim = document.createElement("div");
      scrim.className = "ed-rev-scrim";
      scrim.innerHTML = `
        <div class="ed-rev" role="dialog" aria-modal="true">
          <div class="ed-rev-eyebrow">Send for review</div>
          <h2 class="ed-rev-title">Ask a teammate to review</h2>
          <p class="ed-rev-sub">They'll be able to open this design, leave comments, then approve it or send it back with changes.</p>
          <label class="ed-rev-label">Teammate's email</label>
          <input type="email" class="ed-rev-email" placeholder="name@agency.co.uk" autocomplete="email" />
          <label class="ed-rev-label">Message <span>(optional)</span></label>
          <textarea class="ed-rev-msg" rows="3" placeholder="Anything you'd like them to focus on?"></textarea>
          <div class="ed-rev-actions">
            <button type="button" class="ed-rev-cancel">Cancel</button>
            <button type="button" class="ed-rev-send">Send for review</button>
          </div>
          <p class="ed-rev-status" hidden></p>
        </div>`;
      document.body.appendChild(scrim);
      const close = () => { scrim.classList.remove("is-open"); setTimeout(() => scrim.remove(), 200); };
      scrim.querySelector(".ed-rev-cancel").addEventListener("click", close);
      scrim.addEventListener("mousedown", (e) => { if (e.target === scrim) close(); });
      const status = scrim.querySelector(".ed-rev-status");
      const setStatus = (m, err) => { status.hidden = false; status.textContent = m; status.classList.toggle("is-error", !!err); };

      scrim.querySelector(".ed-rev-send").addEventListener("click", async () => {
        const email = scrim.querySelector(".ed-rev-email").value.trim();
        const msg = scrim.querySelector(".ed-rev-msg").value.trim();
        if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { setStatus("Enter a valid email for your teammate.", true); return; }
        if (typeof window.__TMKE_REVIEW_DATA__ !== "function") { setStatus("Editor isn't ready — try again.", true); return; }
        setStatus("Preparing the design…");
        try {
          const { data: { session } } = await supabase.auth.getSession();
          const design = await window.__TMKE_REVIEW_DATA__();
          setStatus("Sending…");
          const { data, error } = await supabase.from("reviews").insert({
            title: design.filename || "Design",
            page_images: design.pageImages,
            page_elements: design.pageElements || [],
            design_comments: design.comments || [],
            annotations: [],
            reviewer_email: email,
            message: msg || null,
            requested_by: session ? session.user.id : null,
            requested_by_email: session ? session.user.email : null,
            status: "pending",
          }).select("id").single();
          if (error) throw error;
          const link = location.origin + "/review?id=" + data.id;
          status.innerHTML = "Sent ✓ — share this link with " + email + ":<br><a href=\"" + link + "\">" + link + "</a>";
          status.hidden = false; status.classList.remove("is-error");
        } catch (err) {
          console.error("[review]", err);
          if (/relation .*reviews.* does not exist/i.test(err.message || "")) setStatus("Review backend isn't set up yet — run supabase/reviews.sql.", true);
          else setStatus("Couldn't send: " + (err.message || err), true);
        }
      });
      requestAnimationFrame(() => { scrim.classList.add("is-open"); scrim.querySelector(".ed-rev-email").focus(); });
    }
    if (reviewBtn) reviewBtn.addEventListener("click", openReviewModal);
  </script>

  <!-- Studio onboarding: pick a pack, then play the build-in sequence -->
  <script>
    import { supabase } from "../../lib/supabase.js";

    const overlay = document.getElementById("ed-onboard");
    const scroller = document.getElementById("ed-ob-scroll");
    const editor = document.getElementById("editor");
    // Views.
    const homeView = document.getElementById("ed-ob-home");
    const packView = document.getElementById("ed-onboard-step2");
    // Home — your packs.
    const grid = document.getElementById("ed-onboard-grid");
    const loading = document.getElementById("ed-onboard-loading");
    const error = document.getElementById("ed-onboard-error");
    // Home — your saved designs.
    const savedGrid = document.getElementById("ed-ob-designs-grid");
    const savedLoading = document.getElementById("ed-ob-designs-loading");
    const savedEmpty = document.getElementById("ed-ob-designs-empty");
    // Size chooser.
    // Pack design chooser (step 2).
    const designGrid = document.getElementById("ed-onboard-design-grid");
    const designsLoading = document.getElementById("ed-onboard-designs-loading");
    const designsEmpty = document.getElementById("ed-onboard-designs-empty");
    const packTitleEl = document.getElementById("ed-onboard-pack-title");
    const packCatEl = document.getElementById("ed-onboard-pack-cat");
    const back2Btn = document.getElementById("ed-onboard-back2");

    function escapeHtml(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
      }[c]));
    }

    // Sequence: rail → top bar → canvas → panel → props. Total ~1.7s.
    function playBuildIn() {
      requestAnimationFrame(() => {
        setTimeout(() => editor.classList.add("show-rail"),  120);
        setTimeout(() => editor.classList.add("show-top"),   520);
        setTimeout(() => editor.classList.add("show-stage"), 920);
        setTimeout(() => editor.classList.add("show-panel"), 1320);
        setTimeout(() => {
          editor.classList.add("show-props");
          editor.classList.remove("is-onboarding");
        }, 1720);
      });
    }

    // Reveal the studio with the staged build-in. Used after a design is
    // chosen (or "start blank") — what to load is already decided.
    function revealStudio() {
      overlay.classList.add("is-leaving");
      // Wait for fade, then hide entirely and start the sequence.
      setTimeout(() => {
        overlay.classList.add("is-gone");
        playBuildIn();
      }, 420);
    }
    // Switch between the launcher's views (home / size chooser / pack designs).
    function showView(name) {
      if (homeView) homeView.hidden = name !== "home";
      if (packView) packView.hidden = name !== "pack";
      if (scroller) scroller.scrollTop = 0;
    }
    function showStep2() { showView("pack"); }
    function showHome() { showView("home"); }
    if (back2Btn) back2Btn.addEventListener("click", showHome);
    document.querySelectorAll("[data-back-home]").forEach((b) => b.addEventListener("click", showHome));

    // "Your designs" — the member's saved copies (user_designs), newest first.
    // Clicking one re-opens it via the ?design= path.
    // What shape a design is, from its own canvas. Named rather than measured
    // so "Instagram Post" groups with "Instagram Post" whatever the pixel size.
    function formatOf(d) {
      const c = (d.canvas && typeof d.canvas === "object") ? d.canvas
        : (Array.isArray(d.pages) && d.pages[0] && d.pages[0].canvas) || null;
      const w = Number(c && c.width), h = Number(c && c.height);
      if (!w || !h) return "Other";
      const r = w / h;
      if (Math.abs(r - 1) < 0.02) return "Square Post";
      if (Math.abs(r - 0.75) < 0.03) return "Instagram Post";
      if (Math.abs(r - 0.5625) < 0.03) return "Story / Reel";
      if (r > 1.2) return "Landscape";
      return r < 1 ? "Portrait" : "Other";
    }

    function savedCard(d) {
      return `
        <a class="ed-onboard-card" href="/account/editor?design=${encodeURIComponent(d.id)}" data-design="${escapeHtml(d.id)}">
          <button type="button" class="ed-ob-tick" data-tick="${escapeHtml(d.id)}" aria-label="Select ${escapeHtml(d.name || "design")}"></button>
          <span class="ed-onboard-card-cover"${d.thumb_url ? ` style="background-image:url('${escapeHtml(d.thumb_url)}')"` : ""}></span>
          <span class="ed-onboard-card-body">
            <span class="ed-onboard-card-title">${escapeHtml(d.name || "Untitled design")}</span>
            <span class="ed-onboard-card-cat">${escapeHtml(formatOf(d))}${d.folder ? " · " + escapeHtml(d.folder) : ""}</span>
          </span>
        </a>`;
    }
    // The pack banner. Reads the live shop rather than naming packs in code:
    // the whole point of the row is to say what each pack is FOR, and that
    // sentence is the pack's own description, written once where packs live.
    async function loadPackBanner() {
      const sec = document.getElementById("ed-ob-shop-sec");
      const grid = document.getElementById("ed-ob-shop-grid");
      const cta = document.getElementById("ed-ob-cta");
      if (!sec || !grid) return;
      let packs = [];
      try {
        const { data } = await supabase
          .from("packs")
          .select("slug, title, description, cover_image_url, status, sort_order")
          .eq("status", "active")
          .order("sort_order", { ascending: true })
          .limit(4);
        packs = data || [];
      } catch (_) {}
      // Nothing to show is not an error - the plain CTA below already covers it.
      if (!packs.length) return;
      grid.innerHTML = packs.map((p) => `
        <a class="ws-news-card" href="/edit/${encodeURIComponent(p.slug || "")}">
          <span class="ws-news-tx">
            <span class="ws-news-flag">Template pack</span>
            <strong class="ws-news-h">${escapeHtml(p.title || "Pack")}</strong>
            <span class="ws-news-desc">${escapeHtml(p.description || "Ready-made templates you can edit.")}</span>
          </span>
          <span class="ws-news-art"${p.cover_image_url ? ` style="background-image:url('${escapeHtml(p.cover_image_url)}')"` : ""}></span>
        </a>`).join("");
      sec.hidden = false;
      if (cta) cta.hidden = true;   // the row says it better than the strip did
    }
    loadPackBanner();

    // ---- The gallery: folders, sorting, selection and the quick actions ----
    // One list of rows is held here and every view is derived from it, so
    // filtering and sorting never cost a round trip.
    let GAL = { rows: [], folder: null, sort: "recent", q: "", picked: new Set() };

    const byName = (a, b) => String(a.name || "Untitled design").localeCompare(String(b.name || "Untitled design"));
    function galView() {
      let rows = GAL.rows;
      if (GAL.folder) rows = rows.filter((d) => (d.folder || "") === GAL.folder);
      if (GAL.q) rows = rows.filter((d) => String(d.name || "Untitled design").toLowerCase().includes(GAL.q));
      rows = rows.slice();
      if (GAL.sort === "name") rows.sort(byName);
      // Group by format, then newest first inside each group, so the shapes sit
      // together rather than being interleaved by date.
      else if (GAL.sort === "format") rows.sort((a, b) =>
        formatOf(a).localeCompare(formatOf(b)) || new Date(b.created_at || b.updated_at) - new Date(a.created_at || a.updated_at));
      else rows.sort((a, b) => new Date(b.created_at || b.updated_at) - new Date(a.created_at || a.updated_at));
      return rows;
    }

    function paintGallery() {
      const rows = galView();
      const count = document.getElementById("ed-ob-designs-count");
      const none = document.getElementById("ed-ob-designs-noresult");
      if (savedGrid) {
        savedGrid.innerHTML = rows.map(savedCard).join("");
        savedGrid.hidden = rows.length === 0;
        savedGrid.querySelectorAll("[data-tick]").forEach((b) => {
          b.classList.toggle("is-on", GAL.picked.has(b.getAttribute("data-tick")));
        });
      }
      if (none) none.hidden = rows.length !== 0;
      if (count) {
        const total = GAL.rows.length;
        count.textContent = rows.length === total ? `(${total})` : `(${rows.length} of ${total})`;
      }
      paintFolders();
      paintActions();
    }

    function paintFolders() {
      const box = document.getElementById("ed-ob-folders");
      if (!box) return;
      const names = [...new Set(GAL.rows.map((d) => d.folder).filter(Boolean))].sort();
      if (!names.length) {
        // Nothing to list yet. A folder cannot exist before a design is in it,
        // so this offers the only route that makes one.
        box.innerHTML = `<button type="button" class="ed-ob-folder ed-ob-folder--new" data-newfolder>+ Create a folder</button>`;
      } else {
        box.innerHTML = `<button type="button" class="ed-ob-folder${GAL.folder ? "" : " is-on"}" data-folder="">All designs <b>${GAL.rows.length}</b></button>`
          + names.map((n) => {
              const n2 = escapeHtml(n);
              const c = GAL.rows.filter((d) => d.folder === n).length;
              return `<button type="button" class="ed-ob-folder${GAL.folder === n ? " is-on" : ""}" data-folder="${n2}">${n2} <b>${c}</b></button>`;
            }).join("")
          + `<button type="button" class="ed-ob-folder ed-ob-folder--new" data-newfolder>+ New folder</button>`;
      }
    }

    function paintActions() {
      const bar = document.getElementById("ed-ob-actions");
      const n = document.getElementById("ed-ob-actions-n");
      const planner = document.getElementById("ed-ob-act-planner");
      if (!bar) return;
      const c = GAL.picked.size;
      bar.hidden = c === 0;
      if (n) n.textContent = `${c} selected`;
      // The planner needs a rendered picture, which only the editor can make,
      // so it opens that one design there. Meaningless for several at once.
      if (planner) planner.disabled = c !== 1;
    }

    async function galRefresh() {
      const { data } = await supabase
        .from("user_designs")
        .select("id, name, thumb_url, updated_at, created_at, canvas, pages, folder")
        .order("updated_at", { ascending: false });
      GAL.rows = data || [];
      GAL.picked = new Set([...GAL.picked].filter((id) => GAL.rows.some((r) => r.id === id)));
      paintGallery();
    }

    function wireGallery(rows) {
      GAL.rows = rows;
      const q = document.getElementById("ed-ob-designs-q");
      const sort = document.getElementById("ed-ob-sort");
      const folders = document.getElementById("ed-ob-folders");
      const bar = document.getElementById("ed-ob-actions");

      q?.addEventListener("input", () => { GAL.q = q.value.trim().toLowerCase(); paintGallery(); });
      sort?.addEventListener("change", () => { GAL.sort = sort.value; paintGallery(); });

      folders?.addEventListener("click", (e) => {
        const f = e.target.closest("[data-folder]");
        if (f) { GAL.folder = f.getAttribute("data-folder") || null; paintGallery(); return; }
        if (e.target.closest("[data-newfolder]")) fileIntoFolder();
      });

      // A tick selects; it must not follow the card's link.
      savedGrid?.addEventListener("click", (e) => {
        const t = e.target.closest("[data-tick]");
        if (!t) return;
        e.preventDefault();
        e.stopPropagation();
        const id = t.getAttribute("data-tick");
        if (GAL.picked.has(id)) GAL.picked.delete(id); else GAL.picked.add(id);
        t.classList.toggle("is-on", GAL.picked.has(id));
        paintActions();
      });

      bar?.addEventListener("click", (e) => {
        const b = e.target.closest("[data-act]");
        if (!b || b.disabled) return;
        const act = b.getAttribute("data-act");
        if (act === "clear") { GAL.picked.clear(); paintGallery(); }
        else if (act === "duplicate") duplicatePicked();
        else if (act === "folder") fileIntoFolder();
        else if (act === "delete") deletePicked();
        else if (act === "planner") {
          const id = [...GAL.picked][0];
          const today = new Date().toISOString().slice(0, 10);
          location.href = `/account/editor?design=${encodeURIComponent(id)}&schedule=${today}`;
        }
      });

      paintGallery();
    }

    async function duplicatePicked() {
      const picked = GAL.rows.filter((d) => GAL.picked.has(d.id));
      const { data: { session } } = await supabase.auth.getSession();
      if (!session || !picked.length) return;
      const copies = picked.map((d) => ({
        user_id: session.user.id,
        name: `${d.name || "Untitled design"} (copy)`,
        canvas: d.canvas, pages: d.pages, thumb_url: d.thumb_url, folder: d.folder,
      }));
      const { error } = await supabase.from("user_designs").insert(copies);
      if (error) { alert("Couldn't duplicate that: " + error.message); return; }
      GAL.picked.clear();
      await galRefresh();
    }

    async function fileIntoFolder() {
      if (!GAL.picked.size) {
        alert("Tick the designs you want to file first, then choose Add to folder.");
        return;
      }
      const existing = [...new Set(GAL.rows.map((d) => d.folder).filter(Boolean))];
      const name = prompt(
        existing.length ? `Folder name — or one you already use:\n${existing.join(", ")}` : "Name the folder",
        ""
      );
      if (name === null) return;
      const folder = name.trim() || null;   // empty takes them back out of a folder
      const { error } = await supabase.from("user_designs").update({ folder }).in("id", [...GAL.picked]);
      if (error) { alert("Couldn't file that: " + error.message); return; }
      GAL.picked.clear();
      await galRefresh();
    }

    async function deletePicked() {
      const c = GAL.picked.size;
      if (!c) return;
      if (!confirm(`Delete ${c} design${c === 1 ? "" : "s"}? This cannot be undone.`)) return;
      const { error } = await supabase.from("user_designs").delete().in("id", [...GAL.picked]);
      if (error) { alert("Couldn't delete that: " + error.message); return; }
      GAL.picked.clear();
      await galRefresh();
    }

    async function loadSavedDesigns(session) {
      if (!savedGrid) return;
      if (!session) {
        if (savedLoading) savedLoading.hidden = true;
        if (savedEmpty) { savedEmpty.textContent = "Sign in to see designs you've saved."; savedEmpty.hidden = false; }
        return;
      }
      try {
        const { data, error: e } = await supabase
          .from("user_designs")
          .select("id, name, thumb_url, updated_at, created_at, canvas, pages, folder")
          .order("updated_at", { ascending: false });   // all of them: this page IS the library
        if (savedLoading) savedLoading.hidden = true;
        if (e || !data || !data.length) {
          if (savedEmpty) { savedEmpty.textContent = "No saved designs yet — start one in the Studio and it'll show up here."; savedEmpty.hidden = false; }
          return;
        }
        savedGrid.innerHTML = data.map(savedCard).join("");
        savedGrid.hidden = false;
        wireGallery(data);
      } catch (_) {
        if (savedLoading) savedLoading.hidden = true;
      }
    }

    // A design card in the step-2 chooser (mirrors packCard).
    function designCard(d) {
      return `
        <button type="button" class="ed-onboard-card ed-onboard-design" data-template-id="${escapeHtml(d.id)}">
          <span class="ed-onboard-card-cover"${d.thumb ? ` style="background-image:url('${escapeHtml(d.thumb)}')"` : ""}></span>
          <span class="ed-onboard-card-body">
            <span class="ed-onboard-card-title">${escapeHtml(d.name || "Design")}</span>
            <span class="ed-onboard-card-cat">${escapeHtml(d.category || "Template")}</span>
          </span>
        </button>`;
    }

    // Picking a design loads just that one, then reveals the studio.
    if (designGrid) {
      designGrid.addEventListener("click", (e) => {
        const btn = e.target instanceof Element ? e.target.closest("[data-template-id]") : null;
        if (!btn) return;
        if (typeof window.__TMKE_LOAD_TEMPLATE__ === "function") window.__TMKE_LOAD_TEMPLATE__(btn.getAttribute("data-template-id"));
        (window as any).__TMKE_START_CONTEXT__?.("template");
        revealStudio();
      });
    }

    // Pick a pack → register its designs and show the chooser (step 2). Nothing
    // is loaded onto the canvas until the user picks one of the designs.
    async function showPackDesigns(selectedPack) {
      if (!selectedPack) return;
      try { sessionStorage.setItem("tmke.studio.pack", JSON.stringify({ id: selectedPack.id, title: selectedPack.title })); }
      catch (_) { /* ignore */ }

      packTitleEl.innerHTML = escapeHtml(selectedPack.title || "This pack") + " <em>designs.</em>";
      packCatEl.textContent = selectedPack.category || "The pack";
      designGrid.innerHTML = "";
      designsEmpty.hidden = true;
      showStep2();

      let designs = [];
      if (selectedPack.templateIds && selectedPack.templateIds.length) {
        // Demo packs carry library template ids directly.
        if (typeof window.__TMKE_OPEN_PACK__ === "function") {
          designs = window.__TMKE_OPEN_PACK__(selectedPack.templateIds, { load: false }) || [];
        }
      } else if (selectedPack.id) {
        // A real (published) pack — fetch its templates from Supabase.
        designsLoading.hidden = false;
        try {
          const { data: tpls } = await supabase
            .from("templates")
            .select("id, name, category, thumb_url, canvas, elements")
            .eq("pack_id", selectedPack.id)
            .eq("status", "active")
            .order("sort_order", { ascending: true });
          if (tpls && tpls.length && typeof window.__TMKE_OPEN_PACK_TEMPLATES__ === "function") {
            designs = window.__TMKE_OPEN_PACK_TEMPLATES__(tpls, { load: false }) || [];
          }
        } catch (_) { /* leave designs empty */ }
        designsLoading.hidden = true;
      }

      if (!designs.length) {
        // Real pack with no designs yet — say so rather than dropping into a
        // random design.
        designsEmpty.innerHTML = "No designs in this pack yet — they're being added. <button type=\"button\" class=\"ed-onboard-skip-inline\" data-blank>Start with a blank canvas &rarr;</button>";
        designsEmpty.hidden = false;
        const blank = designsEmpty.querySelector("[data-blank]");
        if (blank) blank.addEventListener("click", () => {
          (window as any).__TMKE_START_CONTEXT__?.("blank");
          revealStudio();
        });
        return;
      }
      designGrid.innerHTML = designs.map(designCard).join("");
    }

    function packCard(p) {
      return `
        <button type="button" class="ed-onboard-card" data-pack-id="${p.id}">
          <span class="ed-onboard-card-cover"${p.cover_image_url ? ` style="background-image:url('${escapeHtml(p.cover_image_url)}')"` : ""}></span>
          <span class="ed-onboard-card-body">
            <span class="ed-onboard-card-title">${escapeHtml(p.title)}</span>
            <span class="ed-onboard-card-cat">${escapeHtml(p.category || "Pack")}</span>
          </span>
        </button>`;
    }

    // "Need more packs?" footer cell — previews a couple of packs the user
    // doesn't own yet and links through to the shop to buy them.
    function renderMoreCell(unowned) {
      if (!unowned.length) return;
      const previews = unowned.slice(0, 2).map((p) => `
        <a class="ed-onboard-more-pack" href="#" data-shop data-shop-slug="${escapeHtml(p.slug)}" title="${escapeHtml(p.title)}">
          <span class="ed-onboard-more-cover"${p.cover_image_url ? ` style="background-image:url('${escapeHtml(p.cover_image_url)}')"` : ""}></span>
          <span class="ed-onboard-more-name">${escapeHtml(p.title)}</span>
        </a>`).join("");
      const cell = document.createElement("div");
      cell.className = "ed-onboard-more";
      cell.innerHTML = `
        <div class="ed-onboard-more-head">
          <strong>Need more packs?</strong>
          <span>Download and buy more in The Edit.</span>
        </div>
        <div class="ed-onboard-more-list">${previews}</div>
        <a class="ed-onboard-more-cta" href="#" data-shop>Browse The Edit &rarr;</a>`;
      grid.insertAdjacentElement("afterend", cell);
    }

    // Dev-only preview: visit /editor?demo=1 under `astro dev` to fill the
    // pack-picker with a few gifted example packs (no Supabase needed). This
    // is gated on import.meta.env.DEV so it can NEVER ship to production.
    // Demo packs carry real library template ids so clicking one opens its
    // designs in the studio (see __TMKE_OPEN_PACK__ in editor.js).
    const DEMO_PACKS = [
      { id: "demo-just-listed", slug: "just-listed-spring", title: "Just Listed — Spring", category: "Listings", cover_image_url: "https://assets.tmke.co.uk/kitchen-1.webp", templateIds: ["tmpl-01", "tmpl-02", "tmpl-13", "tmpl-14", "tmpl-17", "tmpl-26"] },
      { id: "demo-sold", slug: "sold-celebrating", title: "Sold & Celebrating", category: "Milestones", cover_image_url: "https://assets.tmke.co.uk/living-1.webp", templateIds: ["tmpl-04", "tmpl-16", "tmpl-20", "tmpl-25"] },
      { id: "demo-market", slug: "market-update", title: "Market Update", category: "Insights", cover_image_url: "https://assets.tmke.co.uk/orange-1.webp", templateIds: ["tmpl-09", "tmpl-18", "tmpl-28"] },
      { id: "demo-team", slug: "meet-the-team", title: "Meet the Team", category: "Brand", cover_image_url: "https://assets.tmke.co.uk/white-1.webp", templateIds: ["tmpl-10", "tmpl-12", "tmpl-24", "tmpl-29"] },
    ];
    const DEMO_UNOWNED = [
      { id: "demo-open-house", slug: "open-house", title: "Open House", category: "Listings", cover_image_url: "https://assets.tmke.co.uk/table.webp" },
      { id: "demo-testimonials", slug: "testimonials", title: "Testimonials", category: "Social proof", cover_image_url: "https://assets.tmke.co.uk/vibes.webp" },
    ];

    function wirePackGrid(owned) {
      grid.addEventListener("click", (e) => {
        const btn = e.target instanceof Element ? e.target.closest("[data-pack-id]") : null;
        if (!btn) return;
        const id = btn.getAttribute("data-pack-id");
        const pack = owned.find((p) => p.id === id);
        showPackDesigns(pack);
      });
    }

    /* ---- What "Start here" offers, by how you got here ---------------------
       There is one Start pane, and it used to offer one fixed list to
       everybody. That list can only be right for one of these:

         · a pack design you bought   — already designed; you are personalising
         · a design of your own       — you are picking up where you left off
         · a blank canvas             — nothing exists yet; you are building
         · a prompt from your planner — a brief to work to, on a blank canvas

       "Add a page" and "Elements" are noise on a finished template and the
       whole point on a blank one. "Make it yours" is the first thing you
       want on a template and does nothing on an empty canvas — there are no
       colours in the design for it to swap. So the list is built per route. */
    (function startPane() {
      const grid  = document.getElementById("ed-start-grid");
      const title = document.getElementById("ed-start-title");
      const sub   = document.getElementById("ed-start-sub");
      if (!grid) return;

      const IC = {
        brand:      '<path d="M12 3v18M5 8l7-5 7 5M5 8v8l7 5 7-5V8"/>',
        background: '<rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M21 16l-5-5L5 20"/>',
        text:       '<path d="M5 6h14M9 6v13M12 6v6"/>',
        photos:     '<circle cx="12" cy="12" r="9"/><path d="M12 8v8M8 12h8"/>',
        elements:   '<path d="M12 3l2.4 5.3 5.6.5-4.2 3.7 1.3 5.5L12 20.7 6.9 23.5l1.3-5.5L4 14.3l5.6-.5z"/>',
        page:       '<rect x="3" y="3" width="13" height="18" rx="2"/><path d="M19 8v13H8"/>',
      };
      const ACTIONS = {
        brand:      { tool: "brand",      label: "Make it yours", note: "Your colours &amp; fonts" },
        background: { tool: "background", label: "Background",    note: "Photo, crop &amp; overlay" },
        text:       { tool: "text",       label: "Text",          note: "Headlines &amp; captions" },
        photos:     { tool: "photos",     label: "Images",        note: "Add a photo" },
        elements:   { tool: "elements",   label: "Elements",      note: "Shapes, lines, icons" },
        page:       { addPage: true,      label: "Add a page",    note: "For a carousel" },
      };

      const params = new URLSearchParams(location.search);
      let ctx = "template";
      if (params.has("prompt")) ctx = "prompt";
      else if (params.has("blank") || params.has("new")) ctx = "blank";
      else if (params.has("design")) ctx = "design";

      const LAYOUT = {
        // Bought and already designed. Personalise it; don't offer to extend it.
        template: {
          title: "Choose something to edit",
          sub: "Select any item in the template to start customising it.",
          order: ["brand", "background", "text", "photos"],
        },
        // Yours, part-finished. Could have come from anywhere, so offer the lot.
        design: {
          title: "Pick up where you left off",
          sub: "Select an item on your design to continue editing it.",
          order: ["brand", "background", "text", "photos", "elements", "page"],
        },
        // Nothing on the page yet. Building tools first; rebranding last,
        // because there is nothing yet for it to recolour.
        blank: {
          title: "Start building",
          sub: "Your canvas is empty. Add your first element here.",
          order: ["text", "photos", "elements", "background", "page", "brand"],
        },
        // Same empty canvas, but they came with a brief. The brief sits above
        // this and is the thing to read first, so the header defers to it.
        prompt: {
          title: "Build your post",
          sub: "Use the post idea above to guide your design, then add your first element.",
          order: ["text", "photos", "elements", "background", "page", "brand"],
        },
      };

      function render(which) {
        const L = LAYOUT[which] || LAYOUT.template;
        if (title) title.textContent = L.title;
        if (sub) sub.textContent = L.sub;
        grid.innerHTML = L.order.map(function (key) {
          const a = ACTIONS[key];
          if (!a) return "";
          const attr = a.addPage ? "data-add-page" : 'data-start-tool="' + a.tool + '"';
          return '<button type="button" class="ed-start-btn" ' + attr + '>' +
            '<span class="ed-start-ic"><svg viewBox="0 0 24 24" aria-hidden="true">' + IC[key] + '</svg></span>' +
            '<span class="ed-start-tx"><b>' + a.label + '</b><i>' + a.note + '</i></span>' +
          '</button>';
        }).join("");
      }
      render(ctx);

      // Choosing from the launcher doesn't change the URL, so the query string
      // can't be the only thing that decides this. The launcher says which.
      (window as any).__TMKE_START_CONTEXT__ = render;
    })();

    (async () => {
      const params = new URLSearchParams(location.search);

      // Admin authors fresh (no pack-picker) — reveal the studio straight away.
      if (params.get("mode") === "admin") {
        overlay.classList.add("is-gone");
        editor.classList.remove("is-onboarding");
        editor.classList.add("show-rail", "show-top", "show-stage", "show-panel", "show-props");
        return;
      }

      // Opening a specific design (?template=… a pack template, or ?design=… a
      // saved copy) skips the launcher and lands straight on the canvas.
      // ?blank=1 does the same for a fresh canvas - the dashboard's content
      // prompts use it, so "design this post" lands on a blank Instagram
      // portrait (the default 1080 x 1440) rather than on the launcher.
      if (params.has("template") || params.has("design") || params.has("blank")) {
        overlay.classList.add("is-gone");
        editor.classList.remove("is-onboarding");
        editor.classList.add("show-rail", "show-top", "show-stage", "show-panel", "show-props");
        return;
      }

      // ?new=1 lands on the library with the "new design" pop-out already up —
      // NewDesignModal opens itself off the query string. Picking a size there
      // comes back as ?blank=<w>x<h>, which the engine opens a canvas at.
      showView("home");

      // Dev-only preview: /editor?demo=1 fills the packs with example packs.
      const isDemo = import.meta.env.DEV && params.has("demo");
      if (isDemo) {
        loadSavedDesigns(null);
        loading.hidden = true;
        grid.innerHTML = DEMO_PACKS.map(packCard).join("");
        grid.hidden = false;
        wirePackGrid(DEMO_PACKS);
        return;
      }

      // Who's signed in — drives their saved designs + owned packs.
      const { data: { session } } = await supabase.auth.getSession();
      const email = session?.user?.email || "";

      // Saved designs load independently (don't block the packs fetch).
      loadSavedDesigns(session);

      // All active packs + the user's paid orders, in parallel.
      const [packsRes, ordersRes] = await Promise.all([
        supabase
          .from("packs")
          .select("id, slug, title, category, cover_image_url")
          .eq("status", "active")
          .order("sort_order", { ascending: true }),
        session
          ? supabase
              .from("orders")
              .select("pack_id, status")
              .or(`user_id.eq.${session.user.id},buyer_email.eq.${email}`)
          : Promise.resolve({ data: [], error: null }),
      ]);

      loading.hidden = true;

      if (packsRes.error) {
        error.textContent = "Couldn't load your packs — start from a blank canvas above, or refresh to retry.";
        error.hidden = false;
        return;
      }

      const allPacks = packsRes.data ?? [];
      const ownedIds = new Set(
        (ordersRes.data ?? [])
          .filter((o) => o.status === "paid" && o.pack_id)
          .map((o) => o.pack_id)
      );
      const owned = allPacks.filter((p) => ownedIds.has(p.id));

      // Deep-link /editor?pack=<id> jumps straight to that pack's designs.
      const packParam = params.get("pack");
      if (packParam) {
        const p = owned.find((x) => x.id === packParam) || allPacks.find((x) => x.id === packParam);
        if (p) {
          grid.innerHTML = owned.map(packCard).join("");
          grid.hidden = false;
          wirePackGrid(owned);
          showPackDesigns(p);
          return;
        }
      }

      if (owned.length === 0) {
        error.innerHTML = "You haven't added any packs yet — start from a blank canvas above, or browse <a href=\"/edit\" data-shop>The Edit</a>.";
        error.hidden = false;
        return;
      }

      grid.innerHTML = owned.map(packCard).join("");
      grid.hidden = false;
      wirePackGrid(owned);
    })();
  </script>

  <!-- Floating "Ask an Expert" chat widget. Lives bottom-right; the
       backend route /api/ask-expert needs an SSR runtime (or a
       separate edge function). Until that's wired the widget shows
       a friendly fallback message so the UI is still usable. -->
  <AskExpert />

  <!-- Browse-packs shop modal — opened from the onboarding "Need more
       packs?" cell so users can buy without leaving the Studio. -->
  <ShopModal />

  <!-- AI caption generator — opened from the Schedule modal's caption field. -->
  <script>
    // The prompt box. The dashboard sends a key, not the words, so a brief
    // edited in content-calendar.js changes what shows here with no link to
    // update.
    import { supabase } from "../../lib/supabase.js";
    import { loadPrompts, findPromptIn } from "../../data/content-calendar.js";
    (async function wirePromptBox() {
      const key = new URLSearchParams(location.search).get("prompt");
      const box = document.getElementById("ed-prompt");
      if (!key || !box) return;
      // Same source as the dashboard that linked here, so the words in the box
      // are the words on the card that was clicked.
      const p = findPromptIn(await loadPrompts(supabase), key);
      if (!p) return;                       // unknown key: show nothing at all
      document.getElementById("ed-prompt-name").textContent = p.name;
      document.getElementById("ed-prompt-angle").textContent = p.angle || "";
      document.getElementById("ed-prompt-brief").textContent = p.brief || "";
      // A video prompt is two jobs: the film, and the cover you are here to
      // make. Saying only "film each one being done" on a canvas leaves the
      // second one unexplained.
      if (p.video) {
        const say = document.getElementById("ed-prompt-say");
        const cov = document.getElementById("ed-prompt-cover");
        say.querySelector("i").textContent = p.video.say;
        cov.querySelector("i").textContent = p.video.cover;
        say.hidden = false;
        cov.hidden = false;
        document.getElementById("ed-prompt-name").textContent = p.name + " \u00b7 Reel";
      } else if (p.detail) {
        // The static equivalent: one job, but more than one line's worth of it.
        const det = document.getElementById("ed-prompt-detail");
        det.querySelector("i").textContent = p.detail;
        det.hidden = false;
      }
      box.hidden = false;
      box.addEventListener("click", () => {
        const open = box.getAttribute("aria-expanded") === "true";
        box.setAttribute("aria-expanded", open ? "false" : "true");
      });
    })();

    // "Add a page" in the start panel, and the rail's way back to it. Both are
    // markup added in this file, so they are wired here rather than in the
    // engine — the engine only exposes addPage.
    // Delegated for the same reason as the start-tool buttons: the Start grid
    // is rendered per route, so the button may not exist when this runs.
    document.addEventListener("click", (e) => {
      const el = e.target as HTMLElement | null;
      if (!el?.closest?.("[data-add-page]")) return;
      if (typeof (window as any).__TMKE_ADD_PAGE__ === "function") (window as any).__TMKE_ADD_PAGE__();
      // Reveal the page strip too, or the new page is added out of sight.
      const t = document.getElementById("ed-pages-toggle");
      if (t && t.getAttribute("aria-pressed") !== "true") t.click();
    });
  </script>

  <CaptionGenerator />
  <NewDesignModal />

  <!-- First-time login tour — resumes here only if a tour is in progress. -->
  <script>
    import { initTour } from "../../lib/tour.js";
    initTour();
  </script>
</BaseLayout>
