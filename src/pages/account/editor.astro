          <button class="ed-shape" data-svg="plus"><div class="sh sh-svg"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="9,2 15,2 15,9 22,9 22,15 15,15 15,22 9,22 9,15 2,15 2,9 9,9"/></svg></div><span>Plus</span></button>
        </div>
        <div class="ed-section-title">Lines &amp; rules</div>
        <div class="ed-shape-grid ed-shape-grid--lines">
          <button class="ed-shape" data-shape="hr-thin"><div class="sh sh-hr"></div><span>Thin rule</span></button>
          <button class="ed-shape" data-shape="hr-thick"><div class="sh sh-hr sh-hr-thick"></div><span>Thick rule</span></button>
        </div>

        <div class="ed-section-title">Social &amp; contact icons</div>
