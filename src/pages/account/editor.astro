        <span>Guides</span>
      </button>
    </aside>

    <!-- =================== TOOL FLYOUT PANEL =================== -->
    <aside class="ed-panel" id="ed-panel">
      <!-- Selection — auto-opens when an element is selected, replacing
           the right-hand properties panel that used to live in this layout. -->
      <section class="ed-panel-pane" data-pane="selection">
        <div class="ed-pane-header">
          <h3>Selection</h3>
          <p>Edit the element you have selected.</p>
        </div>
        <div class="ed-selection-body" id="ed-selection-body"></div>
      </section>

      <!-- Customer Studio starting panel — a calm "choose something to edit"
           shown when nothing is selected. Admin keeps brand-kit-first (editor.js). -->
      <section class="ed-panel-pane" data-pane="start">
        <!-- Only when arriving from a prompt (?prompt=<key>). Closed to start:
             on a laptop the panel has little room, and the brief is a reminder
             rather than something to read before you can begin. -->
        <button type="button" class="ed-prompt" id="ed-prompt" hidden aria-expanded="false">
          <span class="ed-prompt-top">
            <span class="ed-prompt-tx">
              <b>Prompt</b>
              <i id="ed-prompt-name"></i>
            </span>
            <span class="ed-prompt-caret" aria-hidden="true">
              <svg viewBox="0 0 24 24"><path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </span>
          </span>
          <span class="ed-prompt-body" id="ed-prompt-body"><span class="ed-prompt-inner">
            <span class="ed-prompt-angle" id="ed-prompt-angle"></span>
            <span class="ed-prompt-brief" id="ed-prompt-brief"></span>
            <span class="ed-prompt-part" id="ed-prompt-say" hidden><b>What to say on camera</b><i></i></span>
            <span class="ed-prompt-part" id="ed-prompt-cover" hidden><b>Your cover</b><i></i></span>
            <span class="ed-prompt-part" id="ed-prompt-detail" hidden><b>What to put in it</b><i></i></span>
          </span></span>
        </button>

        <!-- Header + shortcuts are filled in by the script below, because
             what belongs here depends entirely on how you arrived. Someone
             personalising a pack they bought does not want "Add a page";
             someone on a blank canvas has nothing to rebrand yet. Static
             markup could only ever suit one of them. -->
        <div class="ed-pane-header">
          <h3 id="ed-start-title">Choose something to edit</h3>
          <p id="ed-start-sub">Tap an item on your design, or start here.</p>
        </div>
        <div class="ed-start-grid" id="ed-start-grid"></div>
      </section>

      <!-- Templates pane kept in the DOM (the admin /admin/templates page
           still navigates here with ?template=...) but the rail tab that
           opened it has been removed. -->
      <section class="ed-panel-pane" data-pane="templates">
        <div class="ed-pane-header">
          <h3>Designs from your pack</h3>
          <p>Tap a design to load it onto the canvas.</p>
        </div>
        <div class="ed-template-grid" id="ed-template-grid"></div>
      </section>

      <!-- Brand kit -->
      <section class="ed-panel-pane is-active" data-pane="brand">
        <div class="ed-pane-header">
          <h3 id="brand-company">Your brand kit</h3>
          <p>Use the colours, fonts and logos saved to your profile.<br />Click <a href="/account/profile" id="brand-edit-link">Edit</a> to update your brand guidelines.</p>
        </div>

        <div class="ed-brand-empty" id="brand-empty" hidden>
          <p>Set up your brand kit to use your colours, fonts and logos here.</p>
          <a href="/account/profile?next=/account/editor" class="ed-btn-solid">Set up brand kit</a>
        </div>

        <div id="brand-loaded">
          <!-- Rebrand — put the open design into their colours and fonts in one
               pass. Sits at the top of the kit because it is what people come
               to this pane wanting to do; the swatches below stay for changing
               one thing at a time. Built by editor.js from the design itself. -->
          <div class="ed-rebrand">
            <div class="ed-rb-head">
              <h4 class="ed-rb-title">Make this design yours</h4>
              <p class="ed-rb-intro">Apply your colours and fonts to the whole design in one go. Each row shows something already in use. Choose your version beside it to update every matching item. To change one item only, use its own menu.</p>
            </div>
            <div class="ed-rb-rows" id="ed-rebrand"></div>
          </div>

          <div class="ed-section-title">Brand colours</div>
          <p class="ed-brand-hint">Select an element, then choose a colour to recolour it. With nothing selected, the colour is applied to the background.</p>
          <div class="ed-swatches" id="brand-colour-grid"></div>

          <div class="ed-section-title">Brand fonts</div>
          <div id="brand-font-list"></div>

          <div class="ed-section-title">Logos</div>
          <p class="ed-brand-hint">Select a logo to add it to the canvas.</p>
          <div class="ed-photo-grid" id="brand-logo-grid"></div>
        </div>
      </section>

      <!-- Elements -->
      <section class="ed-panel-pane" data-pane="elements">
        <div class="ed-pane-header"><h3>Elements</h3><p>Add shapes, lines, icons and frames to your canvas.</p></div>
        <div class="ed-section-title">Shapes</div>
        <div class="ed-shape-grid">
          <button class="ed-shape" data-shape="rect"><div class="sh sh-rect"></div><span>Rectangle</span></button>
          <button class="ed-shape" data-shape="ellipse"><div class="sh sh-circle"></div><span>Circle</span></button>
          <button class="ed-shape" data-shape="triangle"><div class="sh sh-tri"></div><span>Triangle</span></button>
          <button class="ed-shape" data-shape="line"><div class="sh sh-line"></div><span>Line</span></button>
          <button class="ed-shape" data-shape="rounded"><div class="sh sh-round"></div><span>Pill</span></button>
          <button class="ed-shape" data-shape="star"><div class="sh sh-star">★</div><span>Star</span></button>
        </div>
        <!-- Gradients. You can always build one by drawing a rectangle and
             filling it, but the reason people want one is almost always the
             same — text sitting on a photo needs something behind it — and
             working that out from first principles every time is friction.
             Three, because they flip: top-to-bottom covers bottom-to-top, and
             left-to-right covers right-to-left. Black fading to nothing is the
             preset; the colour and both opacities are editable once it's in. -->
        <div class="ed-section-title">Gradients</div>
        <div class="ed-shape-grid">
          <button class="ed-shape" data-gradient="down" title="Dark at the bottom, clear at the top">
            <div class="sh sh-grad sh-grad--down"></div><span>Up</span></button>
          <button class="ed-shape" data-gradient="right" title="Dark on the left, clear on the right">
            <div class="sh sh-grad sh-grad--right"></div><span>Across</span></button>
          <button class="ed-shape" data-gradient="centre" title="Dark at the edges, clear in the middle">
            <div class="sh sh-grad sh-grad--centre"></div><span>Centre</span></button>
        </div>

        <div class="ed-section-title">More shapes</div>
        <div class="ed-shape-grid">
          <button class="ed-shape" data-svg="heart"><div class="sh sh-svg"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9C1 8.5 3 4 7 4c2 0 3.5 1 5 3 1.5-2 3-3 5-3 4 0 6 4.5 4.5 8-2.5 4.5-9.5 9-9.5 9z"/></svg></div><span>Heart</span></button>
