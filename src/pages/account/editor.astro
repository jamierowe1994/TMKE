      <button class="ed-rail-toggle" id="ed-pages-toggle" type="button" aria-pressed="false" title="Pages">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="3" width="12" height="16" rx="1.5"/><path d="M8 21h12V7"/></svg>
