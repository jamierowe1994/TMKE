      <!-- Text -->
      <section class="ed-panel-pane" data-pane="text">
        <div class="ed-pane-header"><h3>Text</h3><p>Replace the text on this page or add a new text block.</p></div>

        <!-- Tabbed so the pane stays short instead of one long scroll. -->
        <div class="ed-ttabs" role="tablist">
          <button type="button" class="ed-ttab is-active" data-ttab="page" role="tab">Text selection</button>
          <button type="button" class="ed-ttab" data-ttab="add" role="tab">Add text</button>
          <button type="button" class="ed-ttab" data-ttab="fonts" role="tab">Fonts</button>
        </div>

        <!-- Every text box on this page, editable in one place — type over the
             wording without touching the design. Built by editor.js. -->
        <div class="ed-ttab-pane is-active" data-ttab-pane="page">
          <!-- When a text box is selected, its own controls are moved in here
               from the Selection pane so styling it and picking which box you
               are styling are the same place. editor.js moves the actual
               #ed-selection-body node, so there is only ever one of it. -->
          <div class="ed-text-selhost" id="ed-text-selhost"></div>
          <div class="ed-textlist-head" id="ed-textlist-head" hidden>All text on this page</div>
          <div class="ed-textlist" id="ed-textlist"></div>
        </div>

        <div class="ed-ttab-pane" data-ttab-pane="add">
          <button class="ed-text-add" data-text="heading">
            <div class="ed-text-preview ed-text-h">Add a heading</div>
          </button>
          <button class="ed-text-add" data-text="subheading">
            <div class="ed-text-preview ed-text-sh">Add a subheading</div>
          </button>
          <button class="ed-text-add" data-text="body">
            <div class="ed-text-preview ed-text-b">Add body text</div>
          </button>
          <!-- The two brand presets used to sit behind their own "Brand kit"
               tab, which put font-adjacent things in two places. They are
               add-text presets, so they live with the other three; brand
               FONTS are starred in the font list instead. -->
          <div class="ed-text-add-sep">From your brand kit</div>
          <button class="ed-text-add" data-text="brand-eyebrow">
            <div class="ed-text-preview ed-text-eyebrow">CHAPTER MARKER</div>
          </button>
          <button class="ed-text-add" data-text="brand-quote">
            <div class="ed-text-preview ed-text-quote">"A pulled quote — italic Cormorant."</div>
          </button>
        </div>

        <!-- Full font browser (search · brand fonts · all fonts · weight),
             populated by editor.js. Also opened from the toolbar's font name. -->
        <div class="ed-ttab-pane" data-ttab-pane="fonts">
          <div class="ed-font-browser" id="ed-font-browser"></div>
        </div>
      </section>

      <!-- Images — stock search (Pexels + Unsplash) with your uploads underneath.
           Merged from the old separate Photos + Uploads panes. -->
      <section class="ed-panel-pane" data-pane="photos">
        <div class="ed-pane-header">
          <h3>Images</h3>
          <p>Search royalty-free images or upload your own.</p>
        </div>
        <div class="ed-stock-search">
          <input type="search" id="ed-stock-input" placeholder='Try "kitchen", "garden", "interior"…' autocomplete="off" />
          <div class="ed-stock-sources">
            <label><input type="checkbox" data-stock-src="pexels" checked /> Pexels</label>
            <label><input type="checkbox" data-stock-src="unsplash" checked /> Unsplash</label>
          </div>
        </div>
        <!-- Paste a Pexels OR Unsplash collection link — we work out which and
             pull every photo in it. -->
        <div class="ed-collect">
          <input type="url" id="ed-collect-input" placeholder="Paste a Pexels / Unsplash collection link…" autocomplete="off" />
          <button type="button" id="ed-collect-pull">Pull</button>
        </div>
        <button type="button" id="ed-collect-save" class="ed-collect-save" hidden>★ Save this collection to Photos</button>
        <div class="ed-collect-saved" id="ed-collect-saved"></div>
        <!-- Shows while a collection's photos are open — click to withdraw them
             (collapse back to the folder list). -->
        <div class="ed-collect-open" id="ed-collect-open" hidden>
          <span class="ed-collect-open-name" id="ed-collect-open-name"></span>
          <button type="button" class="ed-collect-close" id="ed-collect-close" title="Withdraw these photos">Close <span aria-hidden="true">&times;</span></button>
        </div>
        <p class="ed-stock-status" id="ed-stock-status">Type to search — results from both sources appear here.</p>
        <div class="ed-photo-grid" id="ed-photo-grid"></div>
        <p class="ed-stock-credit">Photos via <a href="https://www.pexels.com" target="_blank" rel="noopener">Pexels</a> &amp; <a href="https://unsplash.com" target="_blank" rel="noopener">Unsplash</a>. Hover an image to credit the photographer.</p>

        <!-- Your uploads — merged in beneath the search (no separate rail tab). -->
        <div class="ed-section-title">Your uploads</div>
        <p class="ed-brand-hint">Upload and add your own images.</p>
        <label class="ed-upload-drop">
          <input type="file" id="ed-upload-input" accept="image/*" multiple hidden />
          <strong>Click to upload</strong>
          <span>or drag images here</span>
        </label>
        <div class="ed-photo-grid" id="ed-upload-grid"></div>

        <!-- Admin-only: bulk-import Canva page exports. Shown via JS in ?mode=admin. -->
        <div class="ed-canva" id="ed-canva-import" hidden>
          <div class="ed-canva-sep"><span>Import from Canva</span></div>
          <p class="ed-canva-intro">Two steps. Add the <strong>finished designs</strong> (words included), then the same pages as <strong>plain backgrounds</strong>. We read the wording off the finished ones and lay it onto the backgrounds as editable text. Drop the images straight in (PNG/JPG) or a <strong>.zip</strong> — multiple at once is fine.</p>

          <label class="ed-upload-drop ed-canva-drop" id="ed-canva-drop-final">
            <input type="file" id="ed-canva-zip-final" accept=".zip,application/zip,application/x-zip-compressed,image/png,image/jpeg,image/webp" multiple hidden />
            <strong>1 · Finished designs</strong>
            <span>The full Canva exports — text and all. We read these. <em>Drop images or a .zip.</em></span>
            <span class="ed-canva-badge" id="ed-canva-final-badge" hidden></span>
            <div class="ed-canva-thumbs" id="ed-canva-final-thumbs" hidden></div>
          </label>

          <label class="ed-upload-drop ed-canva-drop" id="ed-canva-drop-bg">
            <input type="file" id="ed-canva-zip-bg" accept=".zip,application/zip,application/x-zip-compressed,image/png,image/jpeg,image/webp" multiple hidden />
            <strong>2 · Plain backgrounds</strong>
            <span>The same pages with the words removed. These become the canvas. <em>Drop images or a .zip.</em></span>
            <span class="ed-canva-badge" id="ed-canva-bg-badge" hidden></span>
            <div class="ed-canva-thumbs" id="ed-canva-bg-thumbs" hidden></div>
          </label>

          <button type="button" class="ed-ai-btn" id="ed-canva-build" disabled>
            <span aria-hidden="true">✨</span> Build pages <small id="ed-canva-build-sub">— add backgrounds first</small>
          </button>
          <p class="ed-canva-status" id="ed-canva-status" hidden></p>

          <div class="ed-canva-sep ed-canva-sep--minor"><span>On a single page</span></div>
          <button type="button" class="ed-ai-btn ed-ai-btn--ghost" id="ed-ai-read">
            <span aria-hidden="true">✨</span> Read text with AI <small>(this page)</small>
          </button>
          <button type="button" class="ed-ai-btn ed-ai-btn--ghost" id="ed-ai-read-all">
            <span aria-hidden="true">✨</span> Read text on all pages
          </button>
          <p class="ed-ai-status" id="ed-ai-status" hidden></p>
        </div>
      </section>

      <!-- Background -->
      <!-- Two jobs, so two sections. Colour and image were interleaved here —
           brand swatches at the top, the photo controls above them, custom and
           gradients at the foot — so neither read as a complete answer to
           "what goes behind this design". Colour first because the brand
           swatches are the thing most people came for. -->
      <section class="ed-panel-pane" data-pane="background">
        <div class="ed-pane-header"><h3>Background</h3><p>Set an image, colour or gradient as the background of your design.</p></div>

        <!-- ===== Colour ===== -->
        <div class="ed-bg-sec">
          <div class="ed-section-title">Colour</div>
          <!-- The member's own kit is injected here by
               seedBrandIntoBackgroundPane, above Custom and Gradient. -->
          <div id="ed-bg-colour-mount"></div>

          <!-- Same square swatches as the kit above and the fade colours
               below, rather than circles that read as a different kind of
               control for the same job. -->
          <div class="ed-bg-cg">
            <div class="ed-bg-cg-item">
              <button type="button" class="ed-sw ed-sw-lg" id="ed-bg-color-wrap" title="Custom colour — pick any hex colour" style="background:#f4f2f1"></button>
              <span class="ed-bg-cg-label">Custom</span>
            </div>
            <div class="ed-bg-cg-item">
              <button type="button" class="ed-sw ed-sw-lg" id="ed-bg-grad" title="Build a gradient" style="background:linear-gradient(135deg, var(--english-violet), #B9826A)"></button>
              <span class="ed-bg-cg-label">Gradient</span>
            </div>
          </div>
        </div>

        <!-- ===== Image ===== -->
        <div class="ed-bg-sec">
          <div class="ed-section-title">Image</div>

          <!-- Background image: live preview + change/upload menu. -->
          <div class="ed-bg-img-block">
            <div class="ed-bg-thumb" id="ed-bg-thumb"><span class="ed-bg-thumb-empty">No image</span></div>
            <div class="ed-bg-img-actions">
              <div class="ed-bg-change-wrap">
                <button type="button" class="ed-bg-btn" id="ed-bg-change">Change image
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                </button>
                <div class="ed-bg-imgmenu" id="ed-bg-imgmenu" hidden></div>
              </div>
              <div class="ed-bg-fit" id="ed-bg-fit" hidden role="group" aria-label="Background fit">
                <button type="button" class="ed-bg-fit-btn is-active" data-bgfit="cover" title="Fill the frame — crop to cover">Fill</button>
                <button type="button" class="ed-bg-fit-btn" data-bgfit="contain" title="Fit the whole photo inside the frame">Fit</button>
              </div>
              <button type="button" class="ed-bg-btn" id="ed-bg-reposition" hidden>Reposition</button>
              <button type="button" class="ed-bg-btn ed-bg-btn-danger" id="ed-bg-detach" hidden>Remove</button>
            </div>
            <input type="file" id="ed-bg-upload" accept="image/*" hidden />
          </div>

          <!-- Transparency — only when an image is set (toggled in editor.js). -->
          <div class="ed-bg-imgctl" id="ed-bg-imgctl" hidden>
            <div class="ed-section-title">Image transparency</div>
            <div class="ed-bg-op-row">
              <input type="range" min="0" max="100" step="1" value="100" id="ed-bg-opacity" />
              <input type="number" min="0" max="100" step="1" value="100" id="ed-bg-opacity-num" />
              <span class="ed-bg-op-pct">%</span>
            </div>
            <!-- Fade colour: only shown once the image is below 100% (the colour
                 that shows through the faded photo). -->
            <div class="ed-bg-tint" id="ed-bg-tint" hidden>
              <div class="ed-section-title" style="margin-top:12px;">Fade colour</div>
              <div class="ed-bg-tint-row">
                <button type="button" class="ed-sw" data-color="#000000" style="background:#000000" title="Black"></button>
                <button type="button" class="ed-sw" data-color="#FFFFFF" style="background:#FFFFFF; border:1px solid rgba(0,0,0,0.12)" title="White"></button>
                <label class="ed-sw ed-bg-tint-custom" title="Custom fade colour"><input type="color" id="ed-bg-tint-color" value="#000000" /></label>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Layers -->
      <section class="ed-panel-pane" data-pane="layers">
        <div class="ed-pane-header"><h3>Layers</h3><p>Drag layers to reorder them.</p></div>
        <ul class="ed-layers" id="ed-layers"></ul>
      </section>

      <!-- Resize -->
      <section class="ed-panel-pane" data-pane="resize">
        <div class="ed-pane-header"><h3>Resize design</h3><p>Re-size your canvas.</p></div>
        <div class="ed-resize-grid">
          <button class="ed-resize-card" data-size="1080,1440">
            <div class="ed-resize-vis" style="aspect-ratio:3/4"></div>
            <strong>Instagram Portrait</strong><span>1080 × 1440</span>
          </button>
          <button class="ed-resize-card" data-size="1080,1080">
            <div class="ed-resize-vis" style="aspect-ratio:1/1"></div>
            <strong>Instagram Square</strong><span>1080 × 1080</span>
          </button>
          <button class="ed-resize-card" data-size="1080,1920">
            <div class="ed-resize-vis" style="aspect-ratio:9/16"></div>
            <strong>Story / Reel</strong><span>1080 × 1920</span>
          </button>
          <button class="ed-resize-card" data-size="1920,1080">
            <div class="ed-resize-vis" style="aspect-ratio:16/9"></div>
            <strong>Landscape</strong><span>1920 × 1080</span>
          </button>
          <button class="ed-resize-card" data-size="1200,628">
            <div class="ed-resize-vis" style="aspect-ratio:1200/628"></div>
            <strong>Facebook Link</strong><span>1200 × 628</span>
          </button>
          <button class="ed-resize-card" data-size="2480,3508">
            <div class="ed-resize-vis" style="aspect-ratio:1/1.414"></div>
            <strong>A4 Portrait</strong><span>2480 × 3508</span>
          </button>
          <button class="ed-resize-card" data-size="1080,1920">
            <div class="ed-resize-vis" style="aspect-ratio:9/16"></div>
            <strong>TikTok</strong><span>1080 × 1920</span>
          </button>
          <button class="ed-resize-card" data-size="1200,627">
            <div class="ed-resize-vis" style="aspect-ratio:1200/627"></div>
            <strong>LinkedIn Post</strong><span>1200 × 627</span>
          </button>
          <button class="ed-resize-card" data-size="1200,675">
            <div class="ed-resize-vis" style="aspect-ratio:1200/675"></div>
            <strong>X (Twitter)</strong><span>1200 × 675</span>
          </button>
          <button class="ed-resize-card" data-size="1000,1500">
            <div class="ed-resize-vis" style="aspect-ratio:2/3"></div>
            <strong>Pinterest</strong><span>1000 × 1500</span>
          </button>
          <button class="ed-resize-card" data-size="1280,720">
            <div class="ed-resize-vis" style="aspect-ratio:16/9"></div>
            <strong>YouTube Thumb</strong><span>1280 × 720</span>
          </button>
          <button class="ed-resize-card" data-size="820,312">
            <div class="ed-resize-vis" style="aspect-ratio:820/312"></div>
            <strong>FB Cover</strong><span>820 × 312</span>
          </button>
        </div>
        <div class="ed-section-title">Custom</div>
        <div class="ed-resize-custom">
          <label>Width<input type="number" id="ed-resize-w" value="1080" min="100" max="6000" /></label>
          <label>Height<input type="number" id="ed-resize-h" value="1440" min="100" max="6000" /></label>
          <button class="ed-btn-solid" id="ed-resize-apply">Apply</button>
        </div>
      </section>

      <!-- Guides & margins — safe-area margin + alignment guide lines, all in
           one pane (moved out of the top bar). -->
      <section class="ed-panel-pane" data-pane="guides">
        <div class="ed-pane-header"><h3>Guides &amp; margins</h3><p>Use margins and guides to align your design.</p></div>

        <div class="ed-guide-block">
          <div class="ed-guide-row">
            <div>
              <strong>Safe-area margin</strong>
              <span>Keeps key content clear of the edges.</span>
            </div>
            <button type="button" class="ed-switch" id="ed-margins-toggle" aria-pressed="false" title="Show / hide the safe-area margin"><span class="ed-switch-dot"></span></button>
          </div>
          <label class="ed-guide-size">
            <span>Margin size</span>
            <span class="ed-guide-size-input"><input id="ed-margins-size" type="number" min="0" max="500" value="60" /> px</span>
          </label>
        </div>

        <div class="ed-guide-block">
          <div class="ed-guide-blocktitle">Guides</div>
          <button type="button" class="ed-guide-btn" id="ed-guide-add-v">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><line x1="12" y1="3" x2="12" y2="21"/></svg>
            Add vertical guide
          </button>
          <button type="button" class="ed-guide-btn" id="ed-guide-add-h">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><line x1="3" y1="12" x2="21" y2="12"/></svg>
            Add horizontal guide
          </button>
          <button type="button" class="ed-guide-btn ed-guide-btn--danger" id="ed-guides-clear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6"/></svg>
            Remove all guides
          </button>
          <p class="ed-guide-hint">Tip: drag a guide on the canvas to reposition it, or click it to fine-tune.</p>
        </div>
      </section>
    </aside>

    <!-- =================== CONTEXTUAL TOOLBAR =================== -->
    <div class="ed-context" id="ed-context" hidden>
      <!-- populated by JS based on selection -->
    </div>

    <!-- =================== CANVAS STAGE =================== -->
    <main class="ed-stage" id="ed-stage" data-lenis-prevent>
      <!-- The sizer holds the canvas's SCALED footprint. A transform scales
           what you see but not the box the layout reserves, so at any zoom
           above "fit" the stage had no idea the canvas had grown - which is
           why it could not be scrolled to its own top or bottom. -->
      <div class="ed-canvas-sizer" id="ed-canvas-sizer">
      <div class="ed-canvas-shadow" id="ed-canvas-shadow">
        <div class="ed-canvas" id="ed-canvas">
          <!-- elements rendered here -->
        </div>
        <div class="ed-guides" id="ed-guides"></div>
        <div class="ed-handles" id="ed-handles"></div>
      </div>
      </div>
    </main>

    <!-- Page strip — flip between / add / duplicate / delete pages in this design -->
    <div class="ed-pages" id="ed-pages"></div>

    <!-- Right properties panel removed — its controls now live inside
         the "Selection" pane on the left, which auto-opens when an
         element is selected. The #ed-props node is kept as an empty
         placeholder so any existing JS that queried it doesn't NPE
         while we transition; renderProps now targets the new pane. -->
    <aside class="ed-props" id="ed-props" hidden></aside>

    <!-- Colour panel — opens over the left panel column when a colour swatch is
         clicked. Rich picker: hex, in-design colours, brand palette, photo
         colours, solids and gradients. Populated by editor.js. -->
    <div class="ed-colorpanel" id="ed-colorpanel" hidden></div>

    <!-- Toast -->
    <div class="ed-toast" id="ed-toast" hidden></div>

    <!-- Shown when a design carries {brand name} but the brand kit has no
         company in it, so the tag can't resolve and the member would be
         looking at a literal {brand name} on their design. -->
    <div class="ed-brandnudge" id="ed-brandnudge" hidden>
      <span class="ed-brandnudge-txt">This design fills in your business name automatically &mdash; there isn&rsquo;t one in your brand kit yet.</span>
      <a class="ed-brandnudge-go" href="/account/profile?next=/account/editor">Add it</a>
      <button type="button" class="ed-brandnudge-x" id="ed-brandnudge-x" aria-label="Dismiss">&times;</button>
    </div>

    <!-- Shortcut modal -->
    <div class="ed-modal" id="ed-shortcuts" hidden>
      <div class="ed-modal-card">
        <header><h3>Keyboard shortcuts</h3><button class="ed-modal-close" id="ed-shortcuts-close">×</button></header>
        <ul>
          <li><kbd>Ctrl</kbd>+<kbd>Z</kbd> Undo</li>
          <li><kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>Z</kbd> Redo</li>
          <li><kbd>Ctrl</kbd>+<kbd>D</kbd> Duplicate</li>
          <li><kbd>Ctrl</kbd>+<kbd>C</kbd> / <kbd>V</kbd> Copy / Paste</li>
          <li><kbd>Ctrl</kbd>+<kbd>S</kbd> Save</li>
          <li><kbd>Del</kbd> Delete</li>
          <li><kbd>↑↓←→</kbd> Nudge 1px (<kbd>Shift</kbd> +10px)</li>
          <li><kbd>Space</kbd> + drag → Pan canvas</li>
          <li><kbd>+</kbd> / <kbd>−</kbd> / <kbd>0</kbd> Zoom in / out / fit</li>
          <li><kbd>[</kbd> / <kbd>]</kbd> Send back / bring forward</li>
        </ul>
      </div>
    </div>

    <!-- Schedule-to-calendar modal.
         Opens from the top-bar Schedule button. Flattens the current canvas
         to PNG, uploads to Supabase Storage, then writes a calendar_items
         row so the post lands on /account/schedule. v1 just plans + emails
         a reminder on the day; v2 (post-App-Review) will auto-publish to IG. -->
    <div class="ed-modal" id="ed-schedule-modal" hidden>
      <div class="ed-modal-card ed-sched-card">
        <header>
          <div>
            <p class="ed-sched-eyebrow">Schedule</p>
            <h3>Plan this Post.</h3>
          </div>
          <button class="ed-modal-close" id="ed-schedule-close" aria-label="Close">×</button>
        </header>

        <form class="ed-sched-form" id="ed-schedule-form" novalidate>
          <label class="ed-sched-field">
            <span class="ed-sched-label">Title</span>
            <input type="text" id="ed-sched-title" required maxlength="120" placeholder="Mid-week new build reveal" />
            <span class="ed-sched-hint">Shown on the calendar day cell.</span>
          </label>

          <div class="ed-sched-row">
            <label class="ed-sched-field">
              <span class="ed-sched-label">Date</span>
              <input type="date" id="ed-sched-date" required />
            </label>
            <label class="ed-sched-field">
              <span class="ed-sched-label">Reminder time</span>
              <input type="time" id="ed-sched-time" value="09:00" required />
              <span class="ed-sched-hint">When we'll email you.</span>
            </label>
          </div>

          <label class="ed-sched-field">
            <span class="ed-sched-label ed-sched-label--row">
              <span>Caption <span class="ed-sched-optional">— optional</span></span>
              <button type="button" class="ed-sched-ai" id="ed-sched-ai"><span aria-hidden="true">✨</span> Generate with AI</button>
            </span>
            <textarea id="ed-sched-caption" rows="4" maxlength="2200" placeholder="The copy you'll post alongside the image. Or generate one with AI — hashtags, mentions and calls to action, ready to go."></textarea>
          </label>

          <fieldset class="ed-sched-field ed-sched-platform" hidden>
            <span class="ed-sched-label">Platform</span>
            <div class="ed-sched-platform-grid">
              <label class="ed-sched-platform-opt is-active">
                <input type="radio" name="ed-sched-platform" value="instagram" checked />
                <span>Instagram</span>
              </label>
              <label class="ed-sched-platform-opt is-soon">
                <input type="radio" name="ed-sched-platform" value="facebook" disabled />
                <span>Facebook · soon</span>
              </label>
              <label class="ed-sched-platform-opt is-soon">
                <input type="radio" name="ed-sched-platform" value="linkedin" disabled />
                <span>LinkedIn · soon</span>
              </label>
              <label class="ed-sched-platform-opt is-soon">
                <input type="radio" name="ed-sched-platform" value="tiktok" disabled />
                <span>TikTok · soon</span>
              </label>
            </div>
            <span class="ed-sched-hint">We'll auto-post once Meta App Review lands. Until then, use the options below.</span>
          </fieldset>

          <label class="ed-sched-remind">
            <input type="checkbox" id="ed-sched-remind" checked />
            <span>Remind me on the day <span class="ed-sched-optional">— we'll email the caption &amp; image at 8am on the morning of this post</span></span>
          </label>

          <div class="ed-sched-error" id="ed-schedule-error" hidden></div>

          <footer class="ed-sched-foot">
            <button type="button" class="ed-sched-cancel" id="ed-schedule-cancel">Cancel</button>
            <button type="button" class="ed-sched-emailnow" id="ed-schedule-emailnow">Email it to me now</button>
            <button type="submit" class="ed-sched-submit" id="ed-schedule-submit">Plan post</button>
          </footer>
        </form>
      </div>
    </div>
  </div>

  <script id="ed-templates-data" type="application/json" set:html={JSON.stringify(templateData)}></script>
  <script id="ed-photos-data" type="application/json" set:html={JSON.stringify(photoLibrary)}></script>
  <script id="ed-google-fonts-data" type="application/json" set:html={JSON.stringify(googleFonts)}></script>

  <style is:global>
    /* ---- Admin boot veil (see the markup note by #ed-veil) ---- */
    .ed-veil { display: none; }
    html.ed-booting .ed-veil {
      display: grid; place-items: center; position: fixed; inset: 0; z-index: 100000;
      background: var(--paper, #f4f2f1); opacity: 1; transition: opacity 0.35s ease;
    }
    html.ed-booting .ed-veil.is-out { opacity: 0; pointer-events: none; }
    .ed-veil span { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.45); }

    /* Soft light-purple iridescent wash — matches the rest of the hub
       (the .dash-shell background). The white chrome (top bar, rail,
       panel, canvas) sits on top of it. */
    body {
      overflow: hidden;
      background:
        radial-gradient(70% 55% at 0% 0%, rgba(126, 103, 101, 0.18), transparent 50%),
        radial-gradient(75% 65% at 100% 0%, rgba(126, 103, 101, 0.26), transparent 55%),
        radial-gradient(85% 75% at 60% 115%, rgba(126, 103, 101, 0.15), transparent 55%),
        linear-gradient(150deg, #eee9f6 0%, #ebeef8 50%, #f4f2f1 100%);
    }

    .editor {
      position: fixed;
      inset: 0;
      display: grid;
      /* Right properties column gone — its controls live inside the
         left panel's "Selection" pane now. Rail bumped 80→100,
         panel bumped 320→360 for more room. */
      grid-template-columns: 76px 360px 1fr;
      grid-template-rows: 64px 44px 1fr auto;
      grid-template-areas:
        "top   top   top"
        "rail  panel ctx"
        "rail  panel stage"
        "rail  panel pages";
      background:
        radial-gradient(70% 55% at 0% 0%, rgba(126, 103, 101, 0.18), transparent 50%),
        radial-gradient(75% 65% at 100% 0%, rgba(126, 103, 101, 0.26), transparent 55%),
        radial-gradient(85% 75% at 60% 115%, rgba(126, 103, 101, 0.15), transparent 55%),
        linear-gradient(150deg, #eee9f6 0%, #ebeef8 50%, #f4f2f1 100%);
      font-family: var(--sans);
      color: var(--ink);
    }

    /* ===== Customer Studio — light/airy skin (rebuild · stage 1) =====
       Replace the mauve wash with a calm off-white "desk" so the white canvas +
       panels read as bright and airy. Scoped to .editor-light, so the admin
       authoring studio (?mode=admin, no class) keeps its current look. ===== */
    html.editor-light .editor { background: var(--paper); }
    html.editor-light .ed-onboard { background: var(--paper); }
    /* A touch more lift on the canvas so it floats cleanly on the lighter desk. */
    html.editor-light .ed-canvas-shadow {
      box-shadow: 0 1px 2px rgba(28,29,34,0.06), 0 30px 60px -34px rgba(28,29,34,0.28), 0 12px 30px -24px rgba(28,29,34,0.18);
    }
    /* Side panels share the soft off-white so the chrome "disappears" and the
       pure-white canvas is the single element that stands out (per the brief). */
    html.editor-light .ed-panel,
    html.editor-light .ed-props,
    html.editor-light .ed-colorpanel { background: var(--paper); }
    html.editor-light .ed-canvas { background: #ffffff; }

    /* The rail in the brand wine, so navigation reads as navigation rather than
       as more chrome. Matches the hub's chapter strips and the admin sidebar. */
    html.editor-light .ed-rail { background: var(--english-violet); border-right: 0; }
    html.editor-light .ed-rail .ed-rail-btn,
    html.editor-light .ed-rail .ed-rail-toggle { color: rgba(255,255,255,0.62); }
    html.editor-light .ed-rail .ed-rail-btn:hover,
    html.editor-light .ed-rail .ed-rail-toggle:hover { color: #fff; background: rgba(255,255,255,0.09); }
    html.editor-light .ed-rail .ed-rail-btn.is-active,
    html.editor-light .ed-rail .ed-rail-toggle.is-active {
      color: #fff; background: rgba(255,255,255,0.13); border-left-color: #fff;
    }

    /* The prompt box: wine, above the start options, closed by default. */
    .ed-prompt {
      appearance: none; display: block; width: 100%; text-align: left; cursor: pointer;
      margin: 0 0 10px; padding: 14px; border: 0; border-radius: 12px;
      background: var(--english-violet); color: #fff; font-family: var(--sans);
    }
    .ed-prompt[hidden] { display: none; }
    .ed-prompt-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .ed-prompt-tx { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .ed-prompt-tx b { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.6); }
    .ed-prompt-tx i { font-style: normal; font-size: var(--ws-t-body); font-weight: 600; color: #fff; line-height: 1.25; }
    .ed-prompt-caret { flex: none; color: rgba(255,255,255,0.7); display: inline-flex; transition: transform 0.25s cubic-bezier(.2,.8,.2,1); }
    .ed-prompt-caret svg { width: 16px; height: 16px; }
    .ed-prompt[aria-expanded="true"] .ed-prompt-caret { transform: rotate(180deg); }
    /* The 0fr/1fr grid trick, which needs exactly one child to squash — with
       two rows the second sizes itself and the box never fully closes. */
    .ed-prompt-body { display: grid; grid-template-rows: 0fr; transition: grid-template-rows 0.28s cubic-bezier(.2,.8,.2,1); }
    .ed-prompt[aria-expanded="true"] .ed-prompt-body { grid-template-rows: 1fr; }
    .ed-prompt-inner { display: block; min-height: 0; overflow: hidden; }
    .ed-prompt-angle { display: block; padding-top: 15px; font-size: var(--ws-t-body); font-weight: 600; line-height: 1.45; color: #fff; }
    .ed-prompt-brief { display: block; padding-top: 8px; font-size: var(--ws-t-meta); line-height: 1.55; color: rgba(255,255,255,0.76); }
    .ed-prompt-part { display: block; padding-top: 13px; }
    .ed-prompt-part[hidden] { display: none; }
    .ed-prompt-part b { display: block; font-size: 9px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.5); }
    .ed-prompt-part i { display: block; margin-top: 4px; font-style: normal; font-size: var(--ws-t-meta); line-height: 1.55; color: rgba(255,255,255,0.82); }
    /* Breathing room at the foot of the opened panel, or the last line sits on
       the edge of the box. */
    .ed-prompt-inner { padding-bottom: 4px; }

    /* Starting panel — "choose something to edit" (customer Studio only). */
    .ed-start-grid { display: flex; flex-direction: column; gap: 10px; }
    .ed-start-btn {
      display: flex; align-items: center; gap: 14px; width: 100%; text-align: left;
      padding: 14px; border: 1px solid rgba(28,29,34,0.12); border-radius: 12px;
      background: #fff; cursor: pointer; font-family: var(--sans);
      transition: transform 0.2s cubic-bezier(.2,.8,.2,1), border-color 0.2s, box-shadow 0.2s;
    }
    .ed-start-btn:hover { transform: translateY(-2px); border-color: rgba(28,29,34,0.22); box-shadow: 0 10px 22px -16px rgba(28,29,34,0.3); }
    .ed-start-ic { flex: 0 0 auto; width: 38px; height: 38px; border-radius: 10px; background: rgba(28,29,34,0.05); display: inline-flex; align-items: center; justify-content: center; color: var(--english-violet, #5b4a55); }
    .ed-start-ic svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ed-start-tx { display: flex; flex-direction: column; gap: 1px; }
    .ed-start-tx b { font-size: var(--ws-t-row); font-weight: 600; color: var(--ink); }
    .ed-start-tx i { font-size: var(--ws-t-meta); font-style: normal; color: rgba(28,29,34,0.5); }
    /* The Elements pane used to be hidden here, on the basis that it had been
       merged into an Assets pane. There is no Assets pane, and the shapes live
       nowhere else — so the rail button and the start card both opened onto
       nothing. */

    /* ===== Top bar — floating pill, detached from the page edges ===== */
    .ed-topbar {
      grid-area: top;
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      padding: 0 18px;
      margin: 10px 12px 0;
      height: 52px;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 8px;
      box-shadow: 0 6px 22px -10px rgba(28,29,34,0.18);
      z-index: 30;
    }
    .ed-topbar-left { display: flex; align-items: center; gap: 14px; justify-self: start; }
    .ed-topbar-mid { display: flex; align-items: center; gap: 4px; justify-self: center; }
    .ed-topbar-right { display: flex; align-items: center; gap: 8px; justify-self: end; }

    /* Current canvas-format readout — sits next to Save, mirrors the live size. */
    .ed-canvas-size-pill {
      display: inline-flex; align-items: center; gap: 6px;
      padding: 6px 12px; border-radius: 8px;
      background: transparent;
      border: 1px solid rgba(var(--violet-rgb), 0.18);
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600;
      letter-spacing: 0.02em; color: var(--english-violet);
      white-space: nowrap; user-select: none; cursor: pointer;
      transition: background 0.18s, border-color 0.18s;
    }
    .ed-canvas-size-pill:hover {
      background: rgba(var(--violet-rgb), 0.06);
      border-color: rgba(var(--violet-rgb), 0.4);
    }
    .ed-canvas-size-pill svg { color: rgba(55, 30, 40, 0.55); flex: none; }
    @media (max-width: 900px) { .ed-canvas-size-pill { display: none; } }

    .ed-back {
      width: 32px; height: 32px;
      display: inline-flex; align-items: center; justify-content: center;
      border-radius: 4px;
      color: rgba(28,29,34,0.7);
    }
    .ed-back:hover { background: rgba(28,29,34,0.06); color: var(--ink); }

    .ed-logo {
      font-family: var(--serif); font-size: var(--ws-t-title); font-weight: 400;
      letter-spacing: 0.02em; color: var(--ink); white-space: nowrap;
    }
    .ed-logo em { font-style: normal; color: var(--english-violet); font-size: var(--ws-t-body); margin-left: 5px; }

    .ed-divider { width: 1px; height: 22px; background: rgba(28,29,34,0.12); }

    .ed-filename {
      background: transparent;
      border: 1px solid transparent;
      padding: 6px 10px;
      font-size: var(--ws-t-row);
      font-family: var(--sans);
      color: var(--ink);
      border-radius: 4px;
      min-width: 200px;
      transition: background 0.2s, border-color 0.2s;
    }
    .ed-filename:hover { background: rgba(28,29,34,0.04); }
    .ed-filename:focus { outline: none; background: #fff; border-color: var(--english-violet); }

    .ed-icon-btn, .ed-zoom-display, .ed-btn-ghost, .ed-btn-solid, .ed-fit {
      font-family: var(--sans); cursor: pointer; border: none;
    }
    .ed-icon-btn {
      width: 32px; height: 32px;
      display: inline-flex; align-items: center; justify-content: center;
      background: transparent;
      color: rgba(28,29,34,0.7);
      border-radius: 4px;
      font-size: var(--ws-t-title); font-weight: 500;
    }
    .ed-icon-btn:hover { background: rgba(28,29,34,0.07); color: var(--ink); }
    .ed-icon-btn:disabled { opacity: 0.35; cursor: not-allowed; }
    .ed-icon-btn.ed-fit { width: auto; padding: 0 10px; font-size: var(--ws-t-meta); font-weight: 600; }

    .ed-zoom-display {
      background: transparent;
      padding: 4px 8px; font-size: var(--ws-t-meta); min-width: 56px;
      border-radius: 4px; color: rgba(28,29,34,0.7);
    }
    .ed-zoom-display:hover { background: rgba(28,29,34,0.07); }

    /* Searchable Google Fonts picker. Replaces native <select> in both the
       context bar and the right props panel — same widget, two contexts. */
    .ed-font-picker { position: relative; min-width: 180px; }
    .ed-font-trigger {
      width: 100%;
      padding: 7px 28px 7px 10px;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.18);
      border-radius: 4px;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      color: var(--ink);
      cursor: pointer;
      text-align: left;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      position: relative;
    }
    .ed-font-trigger::after {
      content: "▾";
      position: absolute;
      right: 10px; top: 50%;
      transform: translateY(-50%);
      font-size: var(--ws-t-label);
      opacity: 0.5;
    }
    .ed-font-trigger:hover { border-color: var(--english-violet); }
    /* `position: fixed` (vs absolute) is critical — the context bar parent
       uses overflow-x: auto, which implicitly clips overflow-y too. With
       absolute positioning the popover gets cropped to the 28px-tall bar
       and you see nothing. Fixed positioning escapes ancestor overflow. */
    .ed-font-pop {
      position: fixed;
      width: 280px;
      max-width: 90vw;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.12);
      border-radius: 6px;
      box-shadow: 0 14px 40px -8px rgba(0,0,0,0.2);
      padding: 6px;
      z-index: 200;
      display: flex; flex-direction: column;
      gap: 6px;
    }
    .ed-font-pop[hidden] { display: none; }

    /* Inline variant for the right properties panel: search + scrollable
       list always visible, no popover needed (the right panel has the
       vertical room for it). */
    .ed-font-picker.is-inline { min-width: 0; }
    .ed-font-picker.is-inline .ed-font-trigger { display: none; }
    .ed-font-picker.is-inline .ed-font-pop {
      position: static;
      width: 100%;
      max-width: none;
      box-shadow: none;
      border-color: rgba(28,29,34,0.15);
      padding: 6px;
      z-index: auto;
    }
    .ed-font-picker.is-inline .ed-font-list { max-height: 220px; }
    .ed-font-search {
      padding: 8px 10px;
      border: 1px solid rgba(28,29,34,0.15);
      border-radius: 4px;
      font: inherit;
      font-size: var(--ws-t-body);
      outline: none;
    }
    .ed-font-search:focus { border-color: var(--english-violet); }
    .ed-font-list {
      max-height: 280px;
      overflow-y: auto;
      display: flex; flex-direction: column;
      gap: 1px;
    }
    .ed-font-item {
      text-align: left;
      padding: 7px 10px;
      background: transparent;
      border: none;
      border-radius: 3px;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      color: var(--ink);
      cursor: pointer;
    }
    .ed-font-item:hover { background: rgba(28,29,34,0.06); }
    .ed-font-item.is-current { background: rgba(var(--violet-rgb),0.1); font-weight: 600; }
    .ed-font-empty {
      padding: 12px;
      font-size: var(--ws-t-meta);
      color: rgba(28,29,34,0.5);
      text-align: center;
    }

    /* Download dropdown (top right). Replaces the old standalone export
       buttons with a single trigger + menu listing PNG / PNG transparent
       / JPG / PDF. */
    .ed-download { position: relative; }
    .ed-download-caret {
      display: inline-block;
      margin-left: 4px;
      font-size: var(--ws-t-label);
      transform: translateY(-1px);
      opacity: 0.7;
    }
    .ed-download-menu {
      position: absolute;
      top: calc(100% + 6px);
      right: 0;
      width: 260px;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.12);
      border-radius: 6px;
      box-shadow: 0 14px 40px -8px rgba(0,0,0,0.18);
      padding: 6px;
      z-index: 90;
      display: flex; flex-direction: column;
    }
    .ed-download-menu[hidden] { display: none; }
    .ed-download-item {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 10px 12px;
      background: transparent;
      border: none;
      border-radius: 4px;
      text-align: left;
      cursor: pointer;
      font-family: var(--sans);
      color: var(--ink);
    }
    .ed-download-item strong {
      font-size: var(--ws-t-body); font-weight: 700;
    }
    .ed-download-item span {
      font-size: var(--ws-t-label);
      color: rgba(28,29,34,0.55);
    }
    .ed-download-item:hover {
      background: rgba(28,29,34,0.05);
    }

    .ed-btn-ghost {
      background: transparent;
      padding: 8px 14px;
      font-size: var(--ws-t-body); font-weight: 600;
      color: var(--ink);
      border-radius: 4px;
      /* Centre the leading icon with the label (was baseline-misaligned). */
      display: inline-flex; align-items: center; gap: 7px;
    }
    .ed-btn-ghost svg { display: block; flex: 0 0 auto; }
    /* The flex display above (and on solid buttons) would otherwise override the
       [hidden] attribute — keep hidden meaning hidden. */
    .ed-btn-ghost[hidden], .ed-btn-solid[hidden] { display: none !important; }
    .ed-btn-ghost:hover { background: rgba(28,29,34,0.07); }

    .ed-btn-solid {
      display: inline-flex; align-items: center; gap: 8px;
      background: var(--english-violet);
      color: var(--paper);
      padding: 8px 16px;
      font-size: var(--ws-t-body); font-weight: 600;
      border-radius: 4px;
    }
    .ed-btn-solid:hover { background: var(--ink); }

    /* ===== Left rail ===== */
    .ed-rail {
      grid-area: rail;
      background: #fff;
      border-right: 1px solid rgba(28,29,34,0.08);
      display: flex;
      flex-direction: column;
      /* The bottom padding matches the Creative Assistant's own offset, so the
         last icon in the rail and the button share one baseline instead of
         missing each other by sixteen pixels. */
      padding: 8px 0 24px;
      gap: 2px;
      z-index: 25;
    }
    .ed-rail-spacer { flex: 1; }
    .ed-rail-btn, .ed-rail-toggle {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 3px;
      width: 100%; padding: 9px 4px;
      background: transparent; border: none; cursor: pointer;
      color: rgba(28,29,34,0.65);
      border-left: 2px solid transparent;
      font-family: var(--sans);
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .ed-rail-btn svg, .ed-rail-toggle svg { width: 19px; height: 19px; }
    .ed-rail-btn span, .ed-rail-toggle span {
      font-size: 9px; font-weight: 600; letter-spacing: 0.03em;
    }
    .ed-rail-btn:hover, .ed-rail-toggle:hover { color: var(--ink); background: rgba(28,29,34,0.04); }
    .ed-rail-btn.is-active, .ed-rail-toggle.is-active {
      color: var(--english-violet);
      background: rgba(var(--violet-rgb), 0.08);
      border-left-color: var(--english-violet);
    }

    /* ===== Tool panel (flyout) ===== */
    .ed-panel {
      grid-area: panel;
      background: #fff;
      border-right: 1px solid rgba(28,29,34,0.08);
      overflow-y: auto;
      padding: 20px;
      z-index: 20;
    }
    .ed-panel-pane { display: none; }
    .ed-panel-pane.is-active { display: block; }

    /* Guides & margins pane */
    .ed-guide-block { padding-bottom: 18px; margin-bottom: 18px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .ed-guide-block:last-child { border-bottom: 0; margin-bottom: 0; }
    .ed-guide-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
    .ed-guide-row strong { display: block; font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 600; color: var(--ink); }
    .ed-guide-row > div > span { display: block; font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.4; color: rgba(28,29,34,0.55); margin-top: 2px; }
    .ed-switch { flex: 0 0 auto; width: 42px; height: 24px; border: 0; border-radius: 999px; background: rgba(28,29,34,0.2); cursor: pointer; position: relative; transition: background 0.2s; }
    .ed-switch-dot { position: absolute; top: 3px; left: 3px; width: 18px; height: 18px; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgba(0,0,0,0.25); transition: transform 0.2s; }
    .ed-switch[aria-pressed="true"] { background: var(--english-violet); }
    .ed-switch[aria-pressed="true"] .ed-switch-dot { transform: translateX(18px); }
    .ed-guide-size { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 14px; font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.6); }
    .ed-guide-size-input { display: inline-flex; align-items: center; gap: 6px; color: rgba(28,29,34,0.5); }
    .ed-guide-size input { width: 62px; padding: 7px 9px; border: 1px solid rgba(28,29,34,0.18); border-radius: 6px; font-family: var(--sans); font-size: var(--ws-t-body); color: var(--ink); background: #fff; }
    .ed-guide-size input:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(var(--violet-rgb),0.12); }
    .ed-guide-blocktitle { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin-bottom: 11px; }
    .ed-guide-btn { display: flex; align-items: center; gap: 9px; width: 100%; padding: 11px 12px; margin-bottom: 8px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; background: #fff; cursor: pointer; font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 600; color: var(--ink); transition: border-color 0.18s, background 0.18s; }
    .ed-guide-btn:hover { border-color: var(--english-violet); background: rgba(var(--violet-rgb),0.04); }
    .ed-guide-btn svg { width: 16px; height: 16px; flex: 0 0 auto; color: var(--english-violet); }
    .ed-guide-btn--danger { color: #a2472f; }
    .ed-guide-btn--danger svg { color: #a2472f; }
    .ed-guide-btn--danger:hover { border-color: #a2472f; background: rgba(162,71,47,0.05); }
    .ed-guide-hint { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.5; color: rgba(28,29,34,0.5); margin: 12px 0 0; }

    /* Selection pane = the property editor that used to live on the right.
       Re-uses the .ed-props-* class names so the existing CSS still applies
       to fields, rows, sections, actions. */
    .ed-selection-empty {
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      color: rgba(28,29,34,0.5);
      padding: 16px 4px;
      margin: 0;
    }

    /* Each pane opens on the same wine block the hub uses for its chapter
       strips, so the title and its one-liner read as a header rather than as
       the first item in the list under it. */
    .ed-pane-header {
      background: var(--english-violet);
      border-radius: 8px;
      padding: 13px 15px 14px;
      margin: 0 0 16px;
    }
    .ed-pane-header h3 {
      /* Not var(--serif): global.css remaps that to The Seasons inside an h3,
         which put the display face on every pane title. The Seasons is a
         once-a-page mark, and this is panel chrome — so it matches the rest of
         the panel instead, larger rather than heavier. */
      font-family: var(--sans);
      /* Matches the "Studio" tab in the hub nav (.ws-tab, 17px/500) so the
         panel title sits in the same register as the app's own navigation. */
      font-size: var(--ws-t-title);
      font-weight: 400;
      /* The gap under the title was mostly leading, not margin: 19px text on
         28.5px line-height left ~5px of air before the 3px margin even
         applied. Tightening the line closes it by about 40%. */
      line-height: 1.3;
      letter-spacing: 0.01em;
      color: #fff;
      margin: 0 0 2px;
    }
    .ed-pane-header p {
      font-family: var(--sans);
      font-size: var(--ws-t-meta);
      line-height: 1.45;
      color: rgba(255,255,255,0.72);
      margin: 0;
    }
    /* The Brand kit subtitle carries an inline "Edit" link, whose own
       line-height raised the line box and made that one header a pixel taller
       than the rest — enough to put its content off the shared line. */
    .ed-pane-header p a { line-height: inherit; color: #fff; }
    /* Every pane starts its content at the same height, whatever that content
       happens to be. Panes led by a section title (Elements) sat lower than
       panes led straight into a grid (Images, Layers); the header owns the gap
       now, so the first thing in each pane lines up with the next. */
    .ed-panel-pane > .ed-pane-header + * { margin-top: 0; }
    /* Some panes put a hidden block (an empty state) straight after the
       header, so the visible content is the sibling after that — and Brand kit
       wraps its content in a div whose first child carries the section title's
       own 22px. Both were still starting lower than the rest. */
    .ed-panel-pane > .ed-pane-header + [hidden] + * { margin-top: 0; }
    .ed-panel-pane > * > .ed-section-title:first-child { margin-top: 0; }
    .ed-section-title {
      font-family: var(--sans);
      font-size: var(--ws-t-label); font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(28,29,34,0.5);
      margin: 22px 0 10px;
    }
    /* Injected "Your brand" swatches (top of the Background pane) — separate
       them from the image preview below by the same gap that sits between
       every other section (the 22px section-title top margin). */
    .ed-brand-injected { margin-bottom: 22px; }
    .ed-brand-hint {
      /* --ws-t-label is the 10.5px caps step for section headings, and using it
         for running small print left "Select an element first" a size below
         every other explanatory line in the pane. Small print is --ws-t-meta. */
      font-size: var(--ws-t-meta, 12px);
      color: rgba(28,29,34,0.5);
      margin: 0 0 10px;
      line-height: 1.5;
    }
    /* Text pane tabs — keeps the pane short rather than one long scroll. */
    .ed-ttabs {
      display: flex; gap: 2px; margin: 0 0 12px;
      border-bottom: 1px solid rgba(28,29,34,0.12);
    }
    .ed-ttab {
      flex: 1 1 auto; border: 0; background: none; cursor: pointer;
      padding: 7px 3px 8px; margin-bottom: -1px; white-space: nowrap;
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      color: rgba(28,29,34,0.5); border-bottom: 2px solid transparent;
      transition: color 0.2s, border-color 0.2s;
    }
    .ed-ttab:hover { color: var(--ink); }
    .ed-ttab.is-active { color: var(--english-violet); border-bottom-color: var(--english-violet); }
    .ed-ttab-pane { display: none; }
    .ed-ttab-pane.is-active { display: block; }

    /* Text list — every text box on the page, editable in one place. */
    .ed-textlist { display: flex; flex-direction: column; gap: 8px; margin-bottom: 4px; }
    .ed-tl-row {
      display: flex; flex-direction: column; gap: 5px;
      border: 1px solid rgba(28,29,34,0.14); border-radius: 7px;
      padding: 8px 9px; background: #fff;
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .ed-tl-row:focus-within { border-color: var(--english-violet); box-shadow: 0 0 0 2px rgba(55,30,40,0.08); }
    /* The row for the box you have selected. This list is how you move between
       text boxes without leaving the pane, so it has to show where you are. */
    .ed-tl-row { cursor: pointer; }
    .ed-tl-row.is-selected { border-color: var(--english-violet); background: rgba(var(--violet-rgb),0.05); }
    .ed-tl-row.is-selected .ed-tl-num { color: var(--english-violet); }
    .ed-tl-input { cursor: text; }
    .ed-tl-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .ed-tl-num {
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.45);
    }
    .ed-tl-find {
      border: 0; background: none; cursor: pointer; padding: 0;
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet);
    }
    .ed-tl-find:hover { text-decoration: underline; }
    .ed-tl-input, .ed-props-text {
      width: 100%; box-sizing: border-box; resize: vertical;
      font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.4;
      color: var(--ink); background: #fff;
      border: 1px solid rgba(28,29,34,0.16); border-radius: 5px; padding: 6px 8px;
    }
    .ed-tl-input { border: 0; padding: 0; border-radius: 0; }
    .ed-tl-input:focus, .ed-props-text:focus { outline: none; }
    .ed-textlist-empty { font-size: var(--ws-t-label); color: rgba(28,29,34,0.5); margin: 0 0 10px; line-height: 1.5; }
    /* Upload tiles — hover to reveal a remove button. */
    .ed-upload-tile { position: relative; }
    .ed-upload-x {
      position: absolute; top: 4px; right: 4px; z-index: 2;
      width: 18px; height: 18px; border-radius: 50%;
      display: grid; place-items: center;
      background: rgba(28,29,34,0.72); color: #fff;
      font-size: var(--ws-t-body); line-height: 1; cursor: pointer;
      opacity: 0; transition: opacity 0.2s, background 0.2s;
    }
    .ed-upload-tile:hover .ed-upload-x { opacity: 1; }
    .ed-upload-x:hover { background: #b3261e; }
    .ed-brand-empty {
      padding: 24px;
      background: rgba(var(--violet-rgb),0.06);
      border: 1px dashed rgba(var(--violet-rgb),0.3);
      border-radius: 4px;
      text-align: center;
    }
    .ed-brand-empty p {
      margin: 0 0 14px;
      font-size: var(--ws-t-body);
      color: rgba(28,29,34,0.65);
    }
    /* No font-family here. This is an id, so it beat .ed-pane-header h3 and
       kept the Brand kit title on The Seasons while every other pane moved to
       the panel face — which is why that one header still looked like the old
       design. It inherits the shared header styling now. */
    #brand-edit-link {
      /* Was english-violet, which is now the header's own background — the
         link would have been violet on violet. */
      color: #fff;
      border-bottom: 1px solid rgba(255,255,255,0.5);
      font-size: var(--ws-t-label);
      line-height: inherit;
      letter-spacing: 0.04em;
    }
    #brand-edit-link:hover { border-bottom-color: #fff; }
    .ed-brand-font {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 8px;
      padding: 12px 14px;
      background: rgba(28,29,34,0.04);
      border: 1px solid transparent;
      border-radius: 4px;
      cursor: pointer;
      margin-bottom: 6px;
      text-align: left;
      width: 100%;
    }
    .ed-brand-font:hover { background: rgba(var(--violet-rgb),0.1); border-color: rgba(var(--violet-rgb),0.3); }
    .ed-brand-font-name {
      font-size: var(--ws-t-title); color: var(--ink); line-height: 1.1;
    }
    .ed-brand-font-role {
      font-size: var(--ws-t-label); font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(28,29,34,0.5);
    }

    /* Template + photo grids */
    .ed-template-grid, .ed-photo-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .ed-template-grid button, .ed-photo-grid button {
      position: relative;
      padding: 0; border: none; background: rgba(28,29,34,0.06);
      border-radius: 4px; overflow: hidden; cursor: pointer;
      aspect-ratio: 4/5;
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .ed-template-grid button img, .ed-photo-grid button img {
      width: 100%; height: 100%; object-fit: cover; display: block;
    }
    .ed-template-grid button:hover, .ed-photo-grid button:hover {
      transform: scale(1.02);
      box-shadow: 0 6px 16px -8px rgba(28,29,34,0.4);
    }
    .ed-template-grid button.is-current::after {
      content: ""; position: absolute; inset: 0;
      border: 2px solid var(--english-violet); border-radius: 4px;
      pointer-events: none;
    }

    /* Stock photo search (Pexels + Unsplash) */
    .ed-stock-search {
      display: flex; flex-direction: column; gap: 8px;
      margin-bottom: 12px;
    }
    .ed-stock-search input[type="search"] {
      width: 100%;
      padding: 10px 12px;
      border: 1px solid rgba(28,29,34,0.18);
      border-radius: 4px;
      font: inherit;
      font-size: var(--ws-t-body);
      background: #fff;
      color: var(--ink);
      outline: none;
      transition: border-color 0.2s;
    }
    .ed-stock-search input[type="search"]:focus {
      border-color: var(--english-violet);
    }
    .ed-stock-sources {
      display: flex; gap: 12px;
      font-size: var(--ws-t-label);
      color: rgba(28,29,34,0.65);
      font-weight: 600;
    }
    .ed-stock-sources label {
      display: inline-flex; align-items: center; gap: 5px;
      cursor: pointer;
      user-select: none;
    }
    .ed-stock-sources input[type="checkbox"] { accent-color: var(--english-violet); }
    .ed-collect { display: flex; gap: 8px; margin: 10px 0 4px; }
    .ed-collect input[type="url"] {
      flex: 1; min-width: 0; padding: 9px 12px; font-family: var(--sans); font-size: var(--ws-t-body);
      border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; background: #fff;
    }
    .ed-collect input[type="url"]:focus { outline: none; border-color: var(--english-violet); }
    .ed-collect button {
      flex: 0 0 auto; padding: 9px 16px; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700;
      letter-spacing: 0.06em; color: var(--paper); background: var(--english-violet);
      border: none; border-radius: 8px; cursor: pointer; transition: background 0.2s;
    }
    .ed-collect button:hover { background: var(--ink); }
    .ed-collect-save {
      width: 100%; margin: 4px 0 0; padding: 8px; cursor: pointer;
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; color: var(--english-violet);
      background: rgba(var(--violet-rgb),0.08); border: 1px dashed rgba(var(--violet-rgb),0.35); border-radius: 8px;
    }
    .ed-collect-save:hover { background: rgba(var(--violet-rgb),0.16); }
    .ed-collect-save[hidden] { display: none; }
    .ed-collect-saved { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
    .ed-collect-saved:empty { display: none; }
    .ed-collect-chip {
      display: inline-flex; align-items: center; gap: 6px; padding: 5px 6px 5px 9px;
      background: var(--paper); border: 1px solid rgba(28,29,34,0.14); border-radius: 999px;
      font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--ink); cursor: pointer; max-width: 100%;
    }
    .ed-collect-chip:hover { border-color: var(--english-violet); }
    .ed-collect-chip.is-open { border-color: var(--english-violet); background: rgba(var(--violet-rgb),0.1); font-weight: 700; }
    .ed-collect-open { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin: 10px 0 0; padding: 7px 10px; background: rgba(var(--violet-rgb),0.08); border: 1px solid rgba(var(--violet-rgb),0.18); border-radius: 8px; }
    .ed-collect-open[hidden] { display: none; }
    .ed-collect-open-name { font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; color: var(--english-violet); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ed-collect-close { flex: 0 0 auto; border: none; background: none; cursor: pointer; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.6); display: inline-flex; align-items: center; gap: 5px; }
    .ed-collect-close span { font-size: var(--ws-t-row); }
    .ed-collect-close:hover { color: #c0392b; }
    .ed-collect-chip-dot { width: 8px; height: 8px; border-radius: 50%; flex: 0 0 auto; }
    .ed-collect-pexels { background: #05a081; }
    .ed-collect-unsplash { background: #111; }
    .ed-collect-chip-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; max-width: 150px; }
    .ed-collect-chip-x { border: none; background: none; cursor: pointer; color: rgba(28,29,34,0.45); font-size: var(--ws-t-row); line-height: 1; padding: 0 2px; }
    .ed-collect-chip-x:hover { color: #c0392b; }
    .ed-stock-status {
      margin: 0 0 10px;
      font-size: var(--ws-t-label); color: rgba(28,29,34,0.5);
      font-style: italic;
    }
    .ed-stock-status.is-error { color: #a05a3c; font-style: normal; }
    .ed-stock-credit {
      margin: 12px 0 0;
      font-size: var(--ws-t-label);
      color: rgba(28,29,34,0.45);
      letter-spacing: 0.04em;
    }
    .ed-stock-credit a { color: var(--english-violet); text-decoration: none; }
    .ed-stock-credit a:hover { text-decoration: underline; }
    .ed-photo-grid button[data-stock-source] {
      position: relative;
    }
    .ed-photo-grid button[data-stock-source]::after {
      content: attr(data-stock-source);
      position: absolute;
      bottom: 4px; right: 4px;
      padding: 1px 5px;
      background: rgba(28,29,34,0.72);
      color: #fff;
      font-size: 8px; font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      border-radius: 2px;
      opacity: 0; transition: opacity 0.2s;
    }
    .ed-photo-grid button[data-stock-source]:hover::after { opacity: 1; }

    /* Shapes */
    .ed-shape-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 8px;
    }
    .ed-shape-grid--lines { grid-template-columns: repeat(2, 1fr); }
    .ed-shape {
      display: flex; flex-direction: column; align-items: center;
      gap: 6px;
      padding: 14px 8px;
      background: rgba(28,29,34,0.04);
      border: 1px solid transparent;
      border-radius: 4px;
      cursor: pointer;
      font-family: var(--sans); font-size: var(--ws-t-label);
      color: rgba(28,29,34,0.7);
      transition: background 0.2s, border-color 0.2s;
    }
    .ed-shape:hover { background: rgba(var(--violet-rgb),0.1); border-color: rgba(var(--violet-rgb),0.3); }
    .ed-shape .sh { width: 36px; height: 36px; background: var(--english-violet); display: flex; align-items: center; justify-content: center; color: #fff; }
    .ed-shape .sh-circle { border-radius: 50%; }
    .ed-shape .sh-round { border-radius: 18px; }
    .ed-shape .sh-tri {
      width: 0; height: 0; background: transparent;
      border-left: 18px solid transparent; border-right: 18px solid transparent;
      border-bottom: 32px solid var(--english-violet);
    }
    .ed-shape .sh-line { height: 4px; width: 36px; }
    .ed-shape .sh-hr { width: 100%; height: 1px; background: var(--english-violet); }
    .ed-shape .sh-hr-thick { height: 4px; }
    .ed-shape .sh-star { background: transparent; color: var(--english-violet); font-size: 28px; }
    /* SVG-backed shape preview — used by the More-shapes and Social-icons
       grids. Transparent background so each silhouette reads cleanly;
       inline SVG inherits colour via currentColor. */
    .ed-shape .sh-svg {
      background: transparent;
      color: var(--english-violet);
    }
    .ed-shape .sh-svg svg {
      width: 28px;
      height: 28px;
      display: block;
    }

    /* Detach background image button — small ghost button at the top of
       the Background pane that appears only when an image background is
       attached. JS toggles `hidden` on the element on every render. */
    .ed-bg-detach {
      appearance: none;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      margin-bottom: 14px;
      background: transparent;
      color: var(--english-violet);
      border: 1px solid rgba(var(--violet-rgb), 0.35);
      border-radius: 3px;
      font-family: inherit;
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .ed-bg-detach:hover {
      background: var(--english-violet);
      color: #f4f2f1;
      border-color: var(--english-violet);
    }
    .ed-bg-detach[hidden] { display: none; }

    /* Frame thumbnails — same panel chrome as shapes, but each `.fr` shows
       the silhouette of a photo crop. A subtle inner mountain icon hints
       that "a photo goes here". */
    .ed-shape .fr {
      width: 40px; height: 40px;
      background: linear-gradient(135deg, rgba(var(--violet-rgb),0.18) 0%, rgba(var(--violet-rgb),0.32) 100%);
      border: 1px solid rgba(var(--violet-rgb),0.35);
      position: relative;
      flex-shrink: 0;
    }
    /* Tiny mountain glyph centred inside every frame thumb */
    .ed-shape .fr::after {
      content: "";
      position: absolute; inset: 0;
      background-image:
        radial-gradient(circle at 70% 32%, var(--english-violet) 0 3px, transparent 4px),
        linear-gradient(135deg, transparent 55%, rgba(var(--violet-rgb),0.55) 56%, rgba(var(--violet-rgb),0.55) 70%, transparent 71%);
      background-size: 100% 100%;
      background-repeat: no-repeat;
      opacity: 0.7;
    }
    .ed-shape .fr-square    { width: 40px; height: 40px; }
    .ed-shape .fr-portrait  { width: 30px; height: 40px; }
    .ed-shape .fr-landscape { width: 44px; height: 32px; }
    .ed-shape .fr-wide      { width: 48px; height: 22px; }
    .ed-shape .fr-circle    { border-radius: 50%; }
    .ed-shape .fr-rounded   { border-radius: 10px; }
    .ed-shape .fr-arch      { border-radius: 22px 22px 4px 4px; }
    .ed-shape .fr-diamond   { transform: rotate(45deg); width: 30px; height: 30px; margin: 5px 0; }
    .ed-shape .fr-diamond::after { transform: rotate(-45deg); }

    .ed-section-hint {
      margin: 0 0 10px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      color: rgba(28,29,34,0.55);
      line-height: 1.4;
    }

    /* ===================== On-canvas frame element ===================== */
    /* A screen: the same idea as a frame, but its four corners move
       independently, so the artwork sits in perspective on a surface in a
       photo. The clip-path is written by the editor from those corners. */
    /* --sc-guide is set per element from its own guide colour. A screen is
       usually being lined up against something dark - a phone, a black monitor
       - where a faint outline may as well not be there, so the empty state is
       a solid tint rather than a hint, and the outline carries a white companion
       so it holds its edge on any photo underneath it. */
    /* Thin elements - lines and rules - get a hit target you can actually hit.
       The pseudo is invisible and doesn't move or resize anything; it only
       widens what counts as a click. Kept modest so it doesn't start stealing
       clicks from whatever sits next to it. */
    .ed-element.is-thin::after {
      content: "";
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      /* --ed-hit is set per element from the current zoom, so this stays a
         constant size under the pointer instead of shrinking with the stage. */
      width: max(100%, var(--ed-hit, 18px));
      height: max(100%, var(--ed-hit, 18px));
    }
    /* A locked or hidden element shouldn't grow a hit area either. */
    .ed-element.is-thin.is-locked::after,
    .ed-element.is-thin.is-hidden::after { content: none; }

    .ed-element[data-type="screen"] {
      --sc-guide: #00c2a8;
      background: color-mix(in srgb, var(--sc-guide) 22%, transparent);
      outline: 2px dashed var(--sc-guide);
      outline-offset: -2px;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.85);
    }
    .ed-element[data-type="screen"].is-filled {
      background: var(--sc-bg, transparent); outline: none; box-shadow: none;
    }
    /* The plane carries the perspective; the artwork sits inside it with its
       own pan/zoom/rotate. Two nested transforms, composed by the browser. */
    .ed-element[data-type="screen"] .sc-plane {
      position: absolute; top: 0; left: 0;
      pointer-events: none;
    }
    .ed-element[data-type="screen"] .sc-img {
      position: absolute;
      max-width: none; max-height: none;   /* the transforms do the sizing */
      pointer-events: none; user-select: none;
    }
    .ed-element[data-type="screen"] .sc-placeholder {
      position: absolute; inset: 0; display: flex; flex-direction: column;
      align-items: center; justify-content: center; gap: 8px; text-align: center;
      padding: 12px; color: #fff;
      font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.35; font-weight: 600;
      /* Readable over whatever photo it is sitting on. */
      text-shadow: 0 1px 3px rgba(0,0,0,0.65);
    }
    .ed-element[data-type="screen"].is-drop-target {
      background: color-mix(in srgb, var(--sc-guide) 42%, transparent);
    }

    /* The quad's own outline, and a pin on each corner. Round, and larger than
       a resize handle, because these are dragged to a specific point in a
       photograph rather than nudged along an edge. */
    .ed-screen-outline {
      --sc-guide: #00c2a8;
      position: absolute; pointer-events: none;
      background: color-mix(in srgb, var(--sc-guide) 14%, transparent);
      outline: 2px solid var(--sc-guide); outline-offset: -2px;
      box-shadow: inset 0 0 0 1px rgba(255,255,255,0.8);
    }
    /* White core, guide-coloured ring: reads against a dark screen and a light
       desk without needing to know which it is sitting on. */
    /* Fixed swatch rows in the Selection panel — a small set of choices reads
       faster than a spectrum when the answer is "something I can see". */
    /* Room above for the label and below for whatever follows, and enough
       padding that the selected swatch's ring is not clipped by the row. */
    .ed-sc-swatches {
      display: flex; flex-wrap: wrap; gap: 9px;
      margin: 8px 0 16px; padding: 3px;
    }
    .ed-sc-sw {
      width: 26px; height: 26px; border-radius: 50%; cursor: pointer;
      border: 1px solid rgba(28,29,34,0.22); padding: 0;
      transition: transform 0.12s, box-shadow 0.12s;
    }
    .ed-sc-sw:hover { transform: scale(1.08); }
    .ed-sc-sw.is-on {
      box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--english-violet);
      border-color: transparent;
    }
    /* "Let the photo show through" — a swatch for the absence of a fill. */
    .ed-sc-sw--none {
      background:
        linear-gradient(45deg, transparent 44%, #c8484c 44%, #c8484c 56%, transparent 56%),
        repeating-conic-gradient(#e9e6e2 0% 25%, #fff 0% 50%) 0 0/10px 10px;
    }

    /* Guide off: while the colour panel is open, or when the Hide guide box is
       ticked. The artwork and the photo stay exactly as they are - it is only
       the positioning aids that go, so what you see (and sample) is what will
       be exported. */
    html.ed-picking .ed-element[data-type="screen"],
    html.ed-guide-off .ed-element[data-type="screen"] {
      background: var(--sc-bg, transparent) !important;
      outline: none !important;
      box-shadow: none !important;
    }
    html.ed-picking .ed-screen-outline,
    html.ed-picking .ed-screen-pin,
    html.ed-picking .ed-screen-rot,
    html.ed-guide-off .ed-screen-outline,
    html.ed-guide-off .ed-screen-pin,
    html.ed-guide-off .ed-screen-rot { display: none; }
    html.ed-picking .ed-element[data-type="screen"] .sc-placeholder,
    html.ed-guide-off .ed-element[data-type="screen"] .sc-placeholder { opacity: 0.25; }

    .ed-sc-hide {
      display: flex; align-items: flex-start; gap: 8px; margin-bottom: 12px;
      font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.7);
      cursor: pointer;
    }
    .ed-sc-hide input { margin-top: 2px; flex: none; }

    /* Spin handle for the artwork, above the quad's top edge. */
    .ed-screen-rot {
      --sc-guide: #00c2a8;
      position: absolute; width: 30px; height: 30px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      background: #fff; border: 2px solid var(--sc-guide); color: var(--sc-guide);
      box-shadow: 0 0 0 1px rgba(20,18,26,0.35), 0 1px 5px rgba(20,18,26,0.4);
      cursor: grab; pointer-events: auto; z-index: 3;
    }
    .ed-screen-rot:active { cursor: grabbing; }
    /* In artwork mode the screen says so: a dragging cursor, and a ring that
       makes it obvious the next drag moves the picture, not the element. */
    .ed-element[data-type="screen"].is-artwork-edit {
      cursor: move;
      outline: 2px solid var(--sc-guide); outline-offset: 2px;
    }
    .ed-screen-pin {
      --sc-guide: #00c2a8;
      position: absolute; width: 16px; height: 16px; border-radius: 50%;
      background: #fff; border: 3px solid var(--sc-guide);
      box-shadow: 0 0 0 1px rgba(20,18,26,0.45), 0 1px 4px rgba(20,18,26,0.45);
      cursor: grab; pointer-events: auto; z-index: 2;
    }
    .ed-screen-pin:active { cursor: grabbing; }

    /* A frame is just an .ed-element with data-type="frame". Its outer
       div carries the clip-path/border-radius so any child <img> (the
       dropped photo) gets cropped to the frame's silhouette. */
    .ed-element[data-type="frame"] {
      overflow: hidden;
      background: repeating-linear-gradient(
        45deg,
        rgba(var(--violet-rgb),0.06) 0 8px,
        rgba(var(--violet-rgb),0.12) 8px 16px
      );
      border: 1px dashed rgba(var(--violet-rgb),0.45);
    }
    /* Frame shape variants — applied via data-frame-shape on the node */
    .ed-element[data-type="frame"][data-frame-shape="circle"]   { border-radius: 50%; }
    .ed-element[data-type="frame"][data-frame-shape="rounded"]  { border-radius: 24px; }
    .ed-element[data-type="frame"][data-frame-shape="arch"]     { border-radius: 999px 999px 12px 12px; }
    .ed-element[data-type="frame"][data-frame-shape="diamond"]  { clip-path: polygon(50% 0, 100% 50%, 50% 100%, 0 50%); border: none; }
    /* square / portrait / landscape / wide need no special clip */

    .ed-element[data-type="frame"].is-filled {
      background: #1c1d22;
      border: none;
    }
    .ed-element[data-type="frame"] .fr-img {
      position: absolute;
      left: 50%; top: 50%;
      transform-origin: center center;
      user-select: none;
      -webkit-user-drag: none;
      pointer-events: none;
    }
    .ed-element[data-type="frame"] .fr-placeholder {
      position: absolute; inset: 0;
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 6px;
      color: rgba(var(--violet-rgb),0.75);
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      text-align: center;
      padding: 12px;
      pointer-events: none;
    }
    .ed-element[data-type="frame"] .fr-placeholder svg { opacity: 0.55; }
    .ed-element[data-type="frame"].is-drop-target {
      outline: 2px solid var(--english-violet);
      outline-offset: 2px;
    }
    /* Viewpoint edit mode — entered by double-clicking a filled frame.
       Inner image becomes draggable; a small badge tells the user
       what to do. Click outside or hit Esc to commit. */
    .ed-element[data-type="frame"].is-editing-viewpoint {
      outline: 2px solid var(--english-violet);
      outline-offset: -2px;
      cursor: grab;
      /* Sit above the dimmed full-image ghost (z-index:49) so the in-frame
         region reads bright while the cropped-away area shows faintly. */
      z-index: 50;
    }
    /* Un-clipped, dimmed copy of the whole photo shown during reframing so the
       user can see what's outside the crop. Mirrors .fr-img centring. */
    .ed-frame-ghost { opacity: 0.4; }
    .ed-frame-ghost .fr-img {
      position: absolute;
      left: 50%; top: 50%;
      transform-origin: center center;
      user-select: none;
      -webkit-user-drag: none;
      pointer-events: none;
    }
    .ed-element[data-type="frame"].is-editing-viewpoint:active { cursor: grabbing; }
    .ed-element[data-type="frame"].is-editing-viewpoint .fr-img { pointer-events: auto; }
    .ed-element[data-type="frame"].is-editing-viewpoint::after {
      content: "Drag to pan · scroll to zoom · Esc when done";
      position: absolute;
      left: 50%; bottom: 8px;
      transform: translateX(-50%);
      background: rgba(28,29,34,0.85);
      color: #fff;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      padding: 4px 10px;
      border-radius: 4px;
      pointer-events: none;
      white-space: nowrap;
    }

    /* When a photo card is being dragged, dim it slightly so the user
       can see they've picked it up. */
    [draggable="true"]:active { opacity: 0.7; }

    /* Text adders */
    .ed-text-add {
      display: block;
      width: 100%; padding: 14px 16px;
      background: rgba(28,29,34,0.04);
      border: 1px solid transparent;
      border-radius: 4px;
      cursor: pointer;
      text-align: left;
      margin-bottom: 8px;
      transition: background 0.2s, border-color 0.2s;
    }
    .ed-text-add:hover { background: rgba(var(--violet-rgb),0.1); border-color: rgba(var(--violet-rgb),0.3); }
    .ed-text-preview { color: var(--ink); }
    .ed-text-h { font-family: var(--serif); font-size: 24px; font-weight: 400; }
    .ed-text-sh { font-family: var(--serif); font-size: var(--ws-t-title); font-weight: 400; font-style: italic; color: rgba(28,29,34,0.7); }
    .ed-text-b { font-family: var(--sans); font-size: var(--ws-t-body); color: rgba(28,29,34,0.7); }
    .ed-text-eyebrow { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.22em; color: var(--english-violet); }
    .ed-text-quote { font-family: var(--serif); font-style: italic; font-size: var(--ws-t-title); }

    /* Font browser (Text panel) — search · brand fonts · all fonts · weight */
    .ed-font-browser { margin-top: 4px; }
    .ed-fb-search {
      width: 100%; box-sizing: border-box; padding: 9px 12px; margin-bottom: 8px;
      font-family: var(--sans); font-size: var(--ws-t-body);
      border: 1px solid rgba(28,29,34,0.16); border-radius: 7px; background: #fff;
    }
    .ed-fb-search:focus { outline: none; border-color: rgba(var(--violet-rgb),0.5); }
    .ed-text-selhost:not(:empty) { margin-bottom: 4px; }
    .ed-textlist-head {
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: rgba(28,29,34,0.5);
      border-top: 1px solid rgba(28,29,34,0.10); padding-top: 13px; margin: 13px 0 8px;
    }
    .ed-textlist-head[hidden] { display: none; }
    /* Logo slot — authoring only. The dashed frame is the 200x75 the member's
       mark will be fitted into, so the reserved area is visible while you lay
       the design out rather than implied by a line of placeholder text. */
    .ed-element.is-logoslot { outline: 1px dashed rgba(var(--violet-rgb), 0.85); outline-offset: 2px; }
    .ed-element.is-logoslot::after {
      content: "LOGO"; position: absolute; top: -16px; left: 0;
      font-family: var(--sans); font-size: 9px; font-weight: 700;
      letter-spacing: 0.14em; color: var(--english-violet);
      background: rgba(255,255,255,0.9); padding: 1px 4px; border-radius: 2px;
      pointer-events: none;
    }
    /* Sits over the stage, clear of the panel and the context bar. Quiet
       enough to ignore, present enough to explain a {brand name} on screen. */
    .ed-brandnudge {
      position: absolute; z-index: 60;
      left: calc(76px + 360px + 24px); top: calc(64px + 44px + 16px);
      display: flex; align-items: center; gap: 12px;
      max-width: min(560px, calc(100vw - 76px - 360px - 48px));
      padding: 10px 12px 10px 14px;
      background: var(--english-violet); border-radius: 8px;
      box-shadow: 0 12px 30px rgba(20,18,26,0.28);
    }
    .ed-brandnudge[hidden] { display: none; }
    .ed-brandnudge-txt {
      font-family: var(--sans); font-size: var(--ws-t-meta, 12px);
      line-height: 1.45; color: rgba(255,255,255,0.9);
    }
    .ed-brandnudge-go {
      flex: none; font-family: var(--sans); font-size: var(--ws-t-meta, 12px);
      font-weight: 700; color: #fff; text-decoration: none;
      border-bottom: 1px solid rgba(255,255,255,0.55); padding-bottom: 1px;
    }
    .ed-brandnudge-go:hover { border-bottom-color: #fff; }
    .ed-brandnudge-x {
      flex: none; appearance: none; background: none; border: 0; cursor: pointer;
      font-size: 18px; line-height: 1; color: rgba(255,255,255,0.55); padding: 0 2px;
    }
    .ed-brandnudge-x:hover { color: #fff; }
    /* Width | lock | Height. The lock sits between the two boxes it ties
       together, aligned to their inputs rather than their labels. */
    .ed-props-row--wh { display: grid; grid-template-columns: 1fr auto 1fr; gap: 8px; align-items: end; }
    .ed-ratio-lock {
      appearance: none; cursor: pointer; width: 30px; height: 32px; margin-bottom: 1px;
      display: inline-flex; align-items: center; justify-content: center;
      background: rgba(28,29,34,0.04); border: 1px solid rgba(28,29,34,0.16);
      border-radius: 6px; color: rgba(28,29,34,0.5);
      transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .ed-ratio-lock:hover { color: var(--ink); border-color: rgba(28,29,34,0.3); }
    .ed-ratio-lock.is-on {
      background: rgba(var(--violet-rgb), 0.12);
      border-color: var(--english-violet);
      color: var(--english-violet);
    }
    /* Align-to-page row in the multi-selection panel. Six equal cells so the
       horizontal trio and the vertical trio read as two sets of three. */
    /* Brand-kit logos for a filled slot. Chequerboard behind each one so a
       white mark on a transparent background is still visible to choose. */
    /* Rebrand rows: what the design uses on the left, what to change it to on
       the right. One row per colour actually present, so a simple design shows
       one or two and a busy one shows what it really has. */
    /* This is the quickest route from "a template" to "our template", and it
       sat in the pane as flat rows with a hairline under them — the same
       weight as the swatch grid below, which does a far smaller job. A card
       gives it an edge and a ground of its own, so it reads as the thing to
       do first rather than the first thing on a list. */
    .ed-rebrand {
      display: flex; flex-direction: column; gap: 12px;
      padding: 14px; margin-bottom: 14px;
      background: rgba(var(--violet-rgb), 0.045);
      border: 1px solid rgba(var(--violet-rgb), 0.16);
      border-radius: 12px;
    }
    /* Title and explanation live inside the card. Outside it, the heading
       belonged to the pane as much as to the block underneath. */
    .ed-rb-head { display: flex; flex-direction: column; gap: 6px; }
    .ed-rb-title {
      margin: 0; font-family: var(--sans); font-size: var(--ws-t-label, 10.5px);
      font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--english-violet);
    }
    .ed-rb-intro {
      margin: 0; font-family: var(--sans); font-size: var(--ws-t-meta, 12px);
      line-height: 1.5; color: rgba(28,29,34,0.62);
    }
    .ed-rb-rows { display: flex; flex-direction: column; gap: 9px; }
    /* Rows sit on the card's own surface so each reads as one decision. */
    .ed-rb-row, .ed-rb-font {
      background: #fff; border: 1px solid rgba(28,29,34,0.09);
      border-radius: 8px; padding: 8px 10px;
    }
    .ed-rb-row { display: flex; align-items: center; gap: 10px; }
    .ed-rb-from { flex: none; width: 26px; height: 26px; border-radius: 5px; border: 1px solid rgba(28,29,34,0.2); }
    .ed-rb-what { flex: 1; min-width: 0; font-family: var(--sans); font-size: var(--ws-t-meta, 12px); color: rgba(28,29,34,0.65); line-height: 1.3; }
    .ed-rb-what b { display: block; color: var(--ink); font-weight: 700; }
    .ed-rb-to { flex: none; display: flex; gap: 5px; }
    .ed-rb-sw {
      appearance: none; cursor: pointer; width: 24px; height: 24px; padding: 0;
      border-radius: 5px; border: 1px solid rgba(28,29,34,0.2);
      transition: transform 0.12s, box-shadow 0.12s;
    }
    .ed-rb-sw:hover { transform: scale(1.12); }
    .ed-rb-sw.is-on { box-shadow: 0 0 0 2px rgba(var(--violet-rgb),0.35); }
    /* "Advanced · individual corners" had no styling at all, so it rendered at
       the browser default with the native disclosure triangle — a size and a
       marker belonging to no other control in the panel. */
    .ed-corner-details { margin-top: 10px; }
    .ed-corner-details > summary {
      cursor: pointer; list-style: none;
      display: flex; align-items: center; gap: 6px;
      font-family: var(--sans); font-size: var(--ws-t-meta, 12px); font-weight: 700;
      letter-spacing: 0.06em; color: rgba(28,29,34,0.55);
      padding: 6px 0;
    }
    .ed-corner-details > summary::-webkit-details-marker { display: none; }
    .ed-corner-details > summary::before {
      content: ""; flex: none; width: 0; height: 0;
      border-left: 4px solid currentColor;
      border-top: 3.5px solid transparent; border-bottom: 3.5px solid transparent;
      transition: transform 0.15s;
    }
    .ed-corner-details[open] > summary::before { transform: rotate(90deg); }
    .ed-corner-details > summary:hover { color: var(--english-violet); }

    /* Gradient tiles preview the actual preset, over a chequerboard so the
       transparent half reads as transparent rather than as white. */
    .sh-grad {
      width: 100%; height: 100%; border-radius: 3px;
      background-image: var(--g), repeating-conic-gradient(#cfcfcf 0% 25%, #fff 0% 50%);
      background-size: auto, 8px 8px;
    }
    .sh-grad--down   { --g: linear-gradient(0deg, rgba(0,0,0,0.92), rgba(0,0,0,0)); }
    .sh-grad--right  { --g: linear-gradient(90deg, rgba(0,0,0,0.92), rgba(0,0,0,0)); }
    .sh-grad--centre { --g: radial-gradient(circle, rgba(0,0,0,0) 35%, rgba(0,0,0,0.92)); }

    .ed-rb-logo {
      appearance: none; cursor: pointer; padding: 5px 12px;
      font-family: var(--sans); font-size: var(--ws-t-meta, 12px); font-weight: 700;
      color: var(--english-violet); background: rgba(var(--violet-rgb), 0.08);
      border: 1px solid rgba(var(--violet-rgb), 0.35); border-radius: 6px;
      transition: background 0.15s, border-color 0.15s;
    }
    .ed-rb-logo:hover { background: rgba(var(--violet-rgb), 0.16); border-color: var(--english-violet); }
    .ed-rb-note { font-family: var(--sans); font-size: var(--ws-t-meta, 12px); line-height: 1.45; color: rgba(28,29,34,0.55); margin: 0; }
    .ed-rb-font { display: flex; align-items: center; gap: 10px; }
    /* The font name is the row's subject, so it sits on its own line with the
       controls beneath — three things across one 360px panel left the dropdown
       about twenty pixels wide. */
    .ed-rb-font { flex-direction: column; align-items: stretch; gap: 8px; }
    .ed-rb-fontctl { display: flex; align-items: center; gap: 8px; }
    .ed-rb-fontctl select { flex: 1 1 auto; min-width: 0; }
    .ed-rb-fontctl .ed-rb-logo { flex: none; white-space: nowrap; }
    .ed-rb-font select {
      flex: 1; min-width: 0; padding: 6px 8px; border: 1px solid rgba(28,29,34,0.18);
      border-radius: 6px; font-family: var(--sans); font-size: var(--ws-t-meta, 12px); background: #fff; color: var(--ink);
    }
    .ed-logopick { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
    .ed-logopick-b {
      appearance: none; cursor: pointer; height: 52px; padding: 6px;
      display: flex; align-items: center; justify-content: center;
      border: 1px solid rgba(28,29,34,0.16); border-radius: 6px;
      background-color: #fff;
      background-image:
        linear-gradient(45deg, rgba(28,29,34,0.06) 25%, transparent 25%, transparent 75%, rgba(28,29,34,0.06) 75%),
        linear-gradient(45deg, rgba(28,29,34,0.06) 25%, transparent 25%, transparent 75%, rgba(28,29,34,0.06) 75%);
      background-size: 10px 10px; background-position: 0 0, 5px 5px;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .ed-logopick-b img { max-width: 100%; max-height: 100%; object-fit: contain; display: block; }
    .ed-logopick-b:hover { border-color: rgba(28,29,34,0.34); }
    .ed-logopick-b.is-on {
      border-color: var(--english-violet);
      box-shadow: 0 0 0 2px rgba(var(--violet-rgb), 0.22);
    }
    .ed-props-hint {
      font-family: var(--sans); font-size: var(--ws-t-meta, 12px);
      line-height: 1.45; color: rgba(28,29,34,0.55); margin: 8px 0 0;
    }
    .ed-grp-align { display: grid; grid-template-columns: repeat(6, 1fr); gap: 6px; }
    .ed-grp-align button {
      appearance: none; cursor: pointer; height: 32px; padding: 0;
      display: inline-flex; align-items: center; justify-content: center;
      background: rgba(28,29,34,0.04); border: 1px solid rgba(28,29,34,0.14);
      border-radius: 6px; color: rgba(28,29,34,0.65);
      transition: background 0.15s, border-color 0.15s, color 0.15s;
    }
    .ed-grp-align button:hover {
      background: rgba(var(--violet-rgb), 0.1);
      border-color: var(--english-violet); color: var(--english-violet);
    }
    .ed-logoslot-row { display: flex; gap: 8px; margin-bottom: 8px; }
    .ed-logoslot-btn {
      flex: 1; padding: 10px 8px; cursor: pointer;
      font-family: var(--sans); font-size: var(--ws-t-meta, 12px); font-weight: 700;
      color: var(--english-violet); background: rgba(var(--violet-rgb), 0.06);
      border: 1px dashed rgba(var(--violet-rgb), 0.45); border-radius: 6px;
      transition: background 0.15s, border-color 0.15s;
    }
    .ed-logoslot-btn:hover { background: rgba(var(--violet-rgb), 0.12); border-color: var(--english-violet); }
    .ed-text-add-sep {
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: rgba(28,29,34,0.5);
      border-top: 1px solid rgba(28,29,34,0.10); padding-top: 13px; margin: 13px 0 8px;
    }
    .ed-fb-hint { margin: 0 0 12px; font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.55); }
    .ed-fb-title {
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: rgba(28,29,34,0.5);
      margin: 14px 0 8px;
    }
    .ed-fb-weights { margin-bottom: 4px; padding-bottom: 12px; border-bottom: 1px solid rgba(28,29,34,0.10); }
    .ed-fb-weights .ed-fb-title { margin-top: 0; }
    .ed-fb-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
    .ed-fb-chip {
      padding: 6px 11px; font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--ink);
      background: rgba(28,29,34,0.04); border: 1px solid transparent; border-radius: 999px; cursor: pointer;
      transition: background 0.15s, border-color 0.15s;
    }
    .ed-fb-chip:hover { background: rgba(var(--violet-rgb),0.1); }
    .ed-fb-chip.is-on { background: rgba(var(--violet-rgb),0.14); border-color: rgba(var(--violet-rgb),0.4); color: var(--english-violet); }
    /* The font list scrolls within itself so the panel stays compact. */
    .ed-fb-list {
      display: flex; flex-direction: column;
      max-height: 360px; overflow-y: auto; overscroll-behavior: contain;
      padding-right: 4px; margin-top: 2px;
    }
    .ed-fb-list::-webkit-scrollbar { width: 8px; }
    .ed-fb-list::-webkit-scrollbar-thumb { background: rgba(28,29,34,0.18); border-radius: 8px; }
    .ed-fb-list .ed-fb-title:first-child { margin-top: 2px; border-top: 0; padding-top: 0; }
    /* Brand fonts, Recently picked and All fonts ran together as one column
       with a small heading in it. A rule above each makes them read as
       separate shelves without adding chrome. */
    .ed-fb-list .ed-fb-title {
      border-top: 1px solid rgba(28,29,34,0.10);
      padding-top: 13px; margin-top: 13px;
    }
    .ed-fb-row {
      display: flex; align-items: center; gap: 6px;
      border-radius: 7px; padding-right: 4px;
    }
    .ed-fb-row:hover { background: rgba(28,29,34,0.04); }
    .ed-fb-row.is-current { background: rgba(var(--violet-rgb),0.1); }
    .ed-fb-name {
      flex: 1; min-width: 0; text-align: left;
      /* Was 15px/9px. The previewed rows render in their own face at this
         size, and a column of them at 15 read as a specimen sheet rather than
         a list you scan. */
      padding: 7px 10px; font-size: var(--ws-t-body); color: var(--ink);
      background: none; border: none; border-radius: 7px; cursor: pointer;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .ed-fb-row.is-current .ed-fb-name { color: var(--english-violet); font-weight: 600; }
    .ed-fb-star {
      flex: none; width: 30px; height: 30px; display: inline-flex; align-items: center; justify-content: center;
      background: none; border: none; border-radius: 6px; cursor: pointer;
      /* Was a 30%-black outline, which read as a hard-to-see black star rather
         than a soft affordance. Brand violet at the same weight is legible
         without shouting. */
      color: rgba(var(--violet-rgb),0.45); transition: color 0.15s, background 0.15s;
    }
    .ed-fb-star:hover { background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .ed-fb-star.is-on { color: #e0a823; }
    .ed-fb-empty { font-family: var(--sans); font-size: var(--ws-t-body); color: rgba(28,29,34,0.5); padding: 10px 2px; }

    /* Uploads */
    .ed-upload-drop {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      gap: 4px;
      padding: 28px;
      border: 1.5px dashed rgba(var(--violet-rgb),0.35);
      border-radius: 4px;
      background: rgba(var(--violet-rgb),0.04);
      cursor: pointer;
      text-align: center;
      margin-bottom: 16px;
      transition: background 0.2s, border-color 0.2s;
    }
    .ed-upload-drop strong { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 600; color: var(--english-violet); }
    .ed-upload-drop span { font-size: var(--ws-t-meta); color: rgba(28,29,34,0.55); }
    .ed-upload-drop:hover, .ed-upload-drop.is-drag {
      background: rgba(var(--violet-rgb),0.1);
      border-color: var(--english-violet);
    }
    /* Canva bulk import (admin) */
    .ed-canva[hidden] { display: none; }
    .ed-canva-sep { display: flex; align-items: center; gap: 10px; margin: 4px 0 14px; }
    .ed-canva-sep::before, .ed-canva-sep::after { content: ""; flex: 1; height: 1px; background: rgba(28,29,34,0.12); }
    .ed-canva-sep span { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .ed-canva-status { font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--english-violet); margin: 10px 0 0; }
    .ed-canva-status.is-error { color: #a05a3c; }
    .ed-canva-status[hidden] { display: none; }
    .ed-canva-intro { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.55; color: rgba(28,29,34,0.62); margin: 0 0 14px; }
    .ed-canva-intro strong { color: var(--ink); font-weight: 700; }
    .ed-canva-drop { margin-bottom: 10px; position: relative; }
    .ed-canva-drop.is-loaded { border-color: var(--english-violet); background: rgba(var(--violet-rgb),0.05); }
    .ed-canva-drop.is-loading { border-color: var(--english-violet); }
    /* spinner shown while a drop is being read */
    .ed-canva-drop.is-loading::after {
      content: ""; position: absolute; top: 10px; right: 10px;
      width: 16px; height: 16px; border-radius: 50%;
      border: 2px solid rgba(var(--violet-rgb),0.25); border-top-color: var(--english-violet);
      animation: edSpin 0.7s linear infinite;
    }
    @keyframes edSpin { to { transform: rotate(360deg); } }
    .ed-canva-thumbs { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 10px; }
    .ed-canva-thumbs[hidden] { display: none; }
    .ed-canva-thumb {
      width: 34px; height: 42px; border-radius: 3px;
      background-size: cover; background-position: center;
      border: 1px solid rgba(28,29,34,0.15);
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; color: rgba(28,29,34,0.55);
    }
    .ed-canva-thumb--more { background: rgba(var(--violet-rgb),0.08); }

    /* Busy lock — block page-strip (and canvas) clicks while the AI build
       places text page-by-page, so a stray click can't redirect it. */
    .editor.ed-busy #ed-pages { pointer-events: none; opacity: 0.5; }
    .editor.ed-busy .ed-stage { pointer-events: none; }

    /* Compare modal — studio render vs original Canva design */
    .ed-cmp-scrim {
      position: fixed; inset: 0; z-index: 500; display: flex; align-items: center; justify-content: center;
      padding: 24px; background: rgba(16,14,22,0.6);
      backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
      opacity: 0; transition: opacity 0.22s ease;
    }
    .ed-cmp-scrim.is-open { opacity: 1; }
    .ed-cmp {
      width: 100%; max-width: 1100px; max-height: 90vh; display: flex; flex-direction: column;
      background: var(--paper); border-radius: 16px; overflow: hidden;
      box-shadow: 0 40px 90px -30px rgba(16,14,22,0.6);
      transform: translateY(12px); transition: transform 0.24s cubic-bezier(.2,.7,.2,1);
    }
    .ed-cmp-scrim.is-open .ed-cmp { transform: none; }
    .ed-cmp-head { display: flex; align-items: center; gap: 16px; padding: 20px 24px; border-bottom: 1px solid rgba(28,29,34,0.1); }
    .ed-cmp-check { width: 38px; height: 38px; border-radius: 50%; background: rgba(44,122,75,0.14); color: #2c7a4b; display: flex; align-items: center; justify-content: center; font-size: 20px; flex: 0 0 auto; }
    .ed-cmp-title { font-family: var(--serif); font-size: 22px; font-weight: 400; color: var(--ink); }
    .ed-cmp-sub { font-family: var(--sans); font-size: var(--ws-t-body); color: rgba(28,29,34,0.6); margin-top: 2px; max-width: 60ch; }
    .ed-cmp-done { margin-left: auto; flex: 0 0 auto; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--paper); background: var(--english-violet); border: none; border-radius: 999px; padding: 12px 22px; cursor: pointer; transition: background 0.2s; }
    .ed-cmp-done:hover { background: var(--ink); }
    .ed-cmp-body { overflow-y: auto; padding: 20px 24px 28px; display: flex; flex-direction: column; gap: 22px; }
    .ed-cmp-row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .ed-cmp-cell { position: relative; background: rgba(28,29,34,0.04); border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 12px; }
    .ed-cmp-cell img { display: block; width: 100%; height: auto; border-radius: 4px; }
    .ed-cmp-tag { display: inline-block; margin-bottom: 8px; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet); }
    .ed-cmp-tag--alt { color: rgba(28,29,34,0.5); }
    .ed-cmp-missing { aspect-ratio: 4/5; display: flex; align-items: center; justify-content: center; color: rgba(28,29,34,0.3); }
    @media (max-width: 640px) { .ed-cmp-row { grid-template-columns: 1fr; } }
    .ed-canva-drop.is-loaded { border-color: rgba(46,125,82,0.5); background: rgba(46,125,82,0.06); }
    .ed-canva-badge {
      display: inline-block; margin-top: 6px; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700;
      letter-spacing: 0.04em; color: #2e7d52; background: rgba(46,125,82,0.12); border-radius: 999px; padding: 2px 10px;
    }
    .ed-canva-badge[hidden] { display: none; }
    .ed-canva-sep--minor { margin-top: 16px; }
    .ed-canva-sep--minor span { font-size: 9px; color: rgba(28,29,34,0.35); }
    .ed-ai-btn {
      width: 100%; margin-top: 12px; padding: 11px 14px; cursor: pointer;
      font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 700; color: var(--paper);
      background: var(--english-violet); border: none; border-radius: 8px;
      display: flex; align-items: center; justify-content: center; gap: 7px; transition: background 0.2s, opacity 0.2s;
    }
    .ed-ai-btn small { font-weight: 500; opacity: 0.75; }
    .ed-ai-btn:hover { background: var(--ink); }
    .ed-ai-btn:disabled { opacity: 0.6; cursor: default; }
    .ed-ai-btn--ghost { margin-top: 8px; background: transparent; color: var(--english-violet); border: 1px solid rgba(var(--violet-rgb),0.35); }
    .ed-ai-btn--ghost:hover { background: rgba(var(--violet-rgb),0.08); color: var(--english-violet); }
    .ed-ai-status { font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--english-violet); margin: 8px 0 0; }
    .ed-ai-status.is-error { color: #a05a3c; }
    .ed-ai-status[hidden] { display: none; }

    /* Background swatches */
    .ed-swatches {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 6px;
    }
    .ed-sw {
      aspect-ratio: 1;
      border: 1px solid rgba(28,29,34,0.14); cursor: pointer; border-radius: 4px;
      transition: transform 0.2s, box-shadow 0.2s;
    }
    .ed-sw:hover { transform: scale(1.08); box-shadow: 0 4px 10px -4px rgba(28,29,34,0.3); }
    .ed-color-input { width: 100%; height: 40px; border: 1px solid rgba(28,29,34,0.1); border-radius: 4px; cursor: pointer; }

    .ed-grad-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .ed-grad {
      aspect-ratio: 1; border: none; cursor: pointer; border-radius: 4px;
      transition: transform 0.2s;
    }
    .ed-grad:hover { transform: scale(1.05); }

    /* Layers */
    .ed-layers {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column; gap: 4px;
    }
    /* Rows are draggable, so they don't fight the gesture by selecting their
       own text mid-drag. The grab cursor is set after the base rule below,
       which sets pointer. */
    /* Repositioning the background photo. The design steps aside: nothing on
       the canvas takes the pointer, so the drag reaches the photo rather than
       grabbing whatever happens to be on top of it, and an overlay can't be
       nudged by accident. Text stays visible because it is usually what you
       are positioning the photo around; everything else fades back. */
    .ed-canvas.is-bg-repositioning .ed-element { pointer-events: none; }
    /* !important is doing real work here: every element carries its own
       opacity as an inline style, which a stylesheet rule cannot otherwise
       beat. This is a temporary display state that ends with the mode, and it
       never touches the stored value. */
    .ed-canvas.is-bg-repositioning .ed-element:not([data-type="text"]) {
      opacity: 0.12 !important;
      transition: opacity 0.18s;
    }
    .ed-canvas.is-bg-repositioning .ed-element[data-type="text"] {
      opacity: 0.85 !important;
      transition: opacity 0.18s;
    }

    .ed-layer { touch-action: none; user-select: none; -webkit-user-select: none; }
    .ed-layer.is-dragging {
      cursor: grabbing; opacity: 0.9;
      box-shadow: 0 8px 20px rgba(20,18,26,0.22);
      position: relative; z-index: 2;
    }
    /* While reordering, the row under the pointer shouldn't light up as if it
       were about to be clicked. */
    .ed-layers.is-reordering .ed-layer:hover { background: rgba(28,29,34,0.04); }
    .ed-layer {
      display: grid;
      grid-template-columns: 40px 1fr auto auto;
      gap: 8px;
      align-items: center;
      padding: 8px;
      background: rgba(28,29,34,0.04);
      border: 1px solid transparent;
      border-radius: 4px;
      cursor: pointer;
      font-size: var(--ws-t-meta);
    }
    .ed-layer { cursor: grab; }
    /* The background row. Set apart because it is not a layer you can reorder
       or hide — it is where the stack ends, and a shortcut to the pane that
       owns it. */
    .ed-layer--base {
      cursor: pointer; grid-template-columns: 40px 1fr auto;
      border-style: dashed; background: transparent; opacity: 0.85;
      margin-top: 6px;
    }
    .ed-layer--base:hover { opacity: 1; border-color: var(--english-violet); background: rgba(var(--violet-rgb),0.05); }
    .ed-layer-base-go {
      font-family: var(--sans); font-size: 10px; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet);
    }
    .ed-layer:hover { background: rgba(var(--violet-rgb),0.08); }
    .ed-layer.is-selected { border-color: var(--english-violet); background: rgba(var(--violet-rgb),0.12); }
    .ed-layer-thumb {
      width: 32px; height: 32px;
      background: rgba(28,29,34,0.08);
      border-radius: 2px;
      overflow: hidden;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--serif); font-size: var(--ws-t-row); color: var(--english-violet);
    }
    .ed-layer-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .ed-layer-name { font-family: var(--sans); color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .ed-layer-action {
      width: 22px; height: 22px;
      display: inline-flex; align-items: center; justify-content: center;
      background: transparent; border: none; cursor: pointer;
      color: rgba(28,29,34,0.45);
      border-radius: 3px;
    }
    .ed-layer-action:hover { background: rgba(28,29,34,0.08); color: var(--ink); }
    .ed-layer-action.is-on { color: var(--english-violet); }

    /* Resize */
    .ed-resize-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .ed-resize-card {
      display: flex; flex-direction: column; align-items: stretch; gap: 6px;
      padding: 12px;
      background: rgba(28,29,34,0.04);
      border: 1px solid transparent;
      border-radius: 4px; cursor: pointer; text-align: left;
      transition: background 0.2s, border-color 0.2s;
    }
    .ed-resize-card:hover { background: rgba(var(--violet-rgb),0.1); border-color: rgba(var(--violet-rgb),0.3); }
    .ed-resize-vis { background: rgba(var(--violet-rgb),0.2); border-radius: 2px; margin-bottom: 6px; max-height: 80px; }
    .ed-resize-card strong { font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; color: var(--ink); }
    .ed-resize-card span { font-size: var(--ws-t-label); color: rgba(28,29,34,0.55); }
    .ed-resize-custom {
      display: grid; grid-template-columns: 1fr 1fr auto; gap: 8px; align-items: end;
    }
    .ed-resize-custom label {
      display: flex; flex-direction: column; gap: 4px;
      font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase;
      color: rgba(28,29,34,0.5);
    }
    .ed-resize-custom input {
      padding: 8px 10px;
      font-family: var(--sans); font-size: var(--ws-t-body);
      border: 1px solid rgba(28,29,34,0.15); border-radius: 4px;
    }

    /* ===== Contextual toolbar ===== */
    .ed-context {
      grid-area: ctx;
      display: flex;
      align-items: center;
      gap: 4px;
      padding: 0 10px;
      background: #fff;
      border-bottom: 1px solid rgba(28,29,34,0.08);
      overflow-x: auto;
      z-index: 22;
    }
    .ed-context[hidden] { display: none; }
    .ed-ctx-group {
      display: flex; align-items: center; gap: 3px;
      padding: 0 6px;
      border-right: 1px solid rgba(28,29,34,0.08);
      height: 26px;
    }
    .ed-ctx-group:last-child { border-right: none; }
    .ed-ctx-btn {
      height: 28px; min-width: 28px; padding: 0 7px;
      display: inline-flex; align-items: center; justify-content: center;
      background: transparent; border: 1px solid transparent;
      border-radius: 4px; cursor: pointer;
      font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 600; color: var(--ink);
      transition: background 0.15s, color 0.15s;
    }
    .ed-ctx-btn:hover { background: rgba(28,29,34,0.07); }
    .ed-ctx-btn.is-on { background: rgba(var(--violet-rgb),0.15); color: var(--english-violet); }
    .ed-ctx-btn svg { width: 15px; height: 15px; }
    /* Alignment toggle — deliberately larger + clearer than its neighbours, and
       it has no dropdown caret (it cycles on click). */
    .ed-ctx-btn-align { min-width: 34px; padding: 0 8px; }
    .ed-ctx-btn-align svg { width: 20px; height: 20px; }
    .ed-ctx-btn-text {
      padding: 0 12px;
      font-size: var(--ws-t-meta); font-weight: 700;
      letter-spacing: 0.06em;
    }
    .ed-ctx-btn-danger { color: #a05a3c; }
    .ed-ctx-btn-danger:hover { background: rgba(160,90,60,0.12); color: #a05a3c; }

    .ed-ctx-select {
      padding: 5px 10px;
      font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 500;
      border: 1px solid rgba(28,29,34,0.15);
      border-radius: 4px; background: #fff;
      min-width: 140px;
    }
    .ed-ctx-num {
      width: 60px; padding: 5px 8px;
      font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 600;
      border: 1px solid rgba(28,29,34,0.18);
      border-radius: 4px; background: #fff;
      text-align: center;
    }
    /* Font-size control: −  number  +  caret with a quick-pick dropdown */
    .ed-size-ctl { position: relative; display: inline-flex; align-items: center; }
    .ed-size-ctl .ed-ctx-num { width: 38px; border-radius: 0; border-left: none; border-right: none; padding: 5px 4px; }
    .ed-size-step {
      height: 28px; width: 24px; display: inline-flex; align-items: center; justify-content: center;
      border: 1px solid rgba(28,29,34,0.18); background: #fff; cursor: pointer;
      font-size: var(--ws-t-title); line-height: 1; color: rgba(28,29,34,0.7); font-family: var(--sans);
    }
    .ed-size-step:first-child { border-radius: 4px 0 0 4px; }
    .ed-size-step:hover { background: var(--paper); color: var(--ink); }
    .ed-size-caret {
      height: 28px; width: 20px; display: inline-flex; align-items: center; justify-content: center;
      border: 1px solid rgba(28,29,34,0.18); border-left: none; border-radius: 0 4px 4px 0;
      background: #fff; cursor: pointer; font-size: var(--ws-t-label); color: rgba(28,29,34,0.6);
    }
    .ed-size-caret:hover { background: var(--paper); color: var(--ink); }
    /* Fixed + high z-index so it always floats over the top of the canvas
       (JS positions it under the caret). */
    .ed-size-pop {
      position: fixed; z-index: 320;
      width: 84px; max-height: 280px; overflow-y: auto;
      background: #fff; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px;
      box-shadow: 0 16px 40px -16px rgba(28,29,34,0.4); padding: 5px;
    }
    .ed-size-pop[hidden] { display: none; }
    .ed-size-opt {
      display: block; width: 100%; text-align: left; padding: 7px 12px;
      font-family: var(--sans); font-size: var(--ws-t-row); color: var(--ink);
      background: none; border: none; border-radius: 5px; cursor: pointer;
    }
    .ed-size-opt:hover { background: rgba(var(--violet-rgb),0.09); }
    .ed-size-opt.is-current { color: var(--english-violet); font-weight: 700; background: rgba(var(--violet-rgb),0.1); }
    /* Legacy square colour input — kept for any callers we haven't migrated
       to the circular swatch yet. New code should use .ed-circle-swatch. */
    .ed-ctx-color {
      width: 32px; height: 32px;
      padding: 2px;
      border: 1px solid rgba(28,29,34,0.15);
      border-radius: 4px; cursor: pointer; background: #fff;
    }
    .ed-ctx-label {
      font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: rgba(28,29,34,0.6);
      margin-right: 6px;
    }

    /* Circular colour swatch — Canva-style. Clicking opens the native
       colour picker via a transparent <input type="color"> on top. */
    .ed-circle-swatch {
      position: relative;
      width: 28px; height: 28px;
      border-radius: 50%;
      border: 2px solid rgba(28,29,34,0.18);
      box-shadow: inset 0 0 0 2px rgba(255,255,255,0.5);
      cursor: pointer;
      transition: transform 0.15s, border-color 0.15s;
    }
    .ed-circle-swatch:hover {
      transform: scale(1.08);
      border-color: var(--english-violet);
    }
    .ed-circle-swatch input[type="color"] {
      position: absolute; inset: 0;
      width: 100%; height: 100%;
      opacity: 0;
      border: 0;
      padding: 0;
      cursor: pointer;
    }

    /* ---- Background pane redesign ---- */
    .ed-bg-img-block { margin-bottom: 14px; }
    .ed-bg-thumb {
      position: relative; width: 100%; aspect-ratio: 16 / 10; border-radius: 10px;
      background-color: rgba(28,29,34,0.05); background-size: cover; background-position: center; background-repeat: no-repeat;
      border: 1px solid rgba(28,29,34,0.12);
      display: flex; align-items: center; justify-content: center; overflow: hidden;
    }
    .ed-bg-thumb-empty { font-family: var(--sans); font-size: var(--ws-t-label); letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.35); }
    .ed-bg-thumb.has-img .ed-bg-thumb-empty { display: none; }
    .ed-bg-img-actions { display: flex; gap: 6px; margin-top: 8px; flex-wrap: wrap; }
    .ed-bg-change-wrap { position: relative; }
    .ed-bg-btn {
      display: inline-flex; align-items: center; gap: 5px;
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.03em;
      padding: 8px 12px; border-radius: 8px; cursor: pointer;
      background: #fff; border: 1px solid rgba(28,29,34,0.18); color: var(--ink);
      transition: background 0.15s, border-color 0.15s;
    }
    .ed-bg-btn:hover { background: rgba(55,30,40,0.05); border-color: rgba(55,30,40,0.35); }
    .ed-bg-btn[hidden] { display: none; }
    /* Fill / Fit segmented toggle */
    .ed-bg-fit { display: inline-flex; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; overflow: hidden; }
    .ed-bg-fit[hidden] { display: none; }
    .ed-bg-fit-btn {
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.03em;
      padding: 8px 12px; cursor: pointer; background: #fff; border: 0; color: var(--ink);
      border-left: 1px solid rgba(28,29,34,0.12);
    }
    .ed-bg-fit-btn:first-child { border-left: 0; }
    .ed-bg-fit-btn.is-active { background: var(--english-violet, #371e28); color: #fff; }
    .ed-bg-btn-danger { color: #a05a3c; border-color: rgba(160,90,60,0.4); }
    .ed-bg-btn-danger:hover { background: rgba(160,90,60,0.08); }
    .ed-bg-imgmenu {
      position: absolute; top: calc(100% + 6px); left: 0; z-index: 40;
      width: 232px; max-height: 300px; overflow-y: auto;
      background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 12px;
      box-shadow: 0 18px 44px -16px rgba(28,29,34,0.4); padding: 10px;
    }
    .ed-bg-imgmenu[hidden] { display: none; }
    .ed-bg-imgmenu-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; }
    .ed-bg-imgmenu-grid button { aspect-ratio: 1; border-radius: 7px; border: 1px solid rgba(28,29,34,0.1); background-size: cover; background-position: center; cursor: pointer; }
    .ed-bg-imgmenu-grid button:hover { border-color: var(--english-violet); }
    .ed-bg-imgmenu-empty { font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.45); margin: 0 0 8px; }
    .ed-bg-imgmenu-upload {
      display: flex; align-items: center; justify-content: center; gap: 6px; width: 100%;
      margin-top: 8px; padding: 9px; border-radius: 8px; cursor: pointer;
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700;
      background: var(--english-violet); color: var(--paper); border: 0;
    }
    .ed-bg-op-row { display: flex; align-items: center; gap: 8px; }
    .ed-bg-op-row input[type="range"] { flex: 1; accent-color: var(--english-violet); }
    .ed-bg-op-row input[type="number"] { width: 54px; text-align: right; border: 1px solid rgba(28,29,34,0.18); border-radius: 6px; padding: 4px 6px; font: inherit; }
    .ed-bg-op-pct { opacity: 0.55; font-size: var(--ws-t-meta); }
    .ed-bg-tint[hidden] { display: none; }
    .ed-bg-tint-row { display: flex; align-items: center; gap: 8px; }
    .ed-bg-tint-row .ed-sw { width: 26px; height: 26px; }
    /* Custom and Gradient are two more ways to answer the same question as
       the swatches above them, so they are the same square, on the same grid
       — five across, matching .ed-swatches — rather than two loose circles. */
    .ed-bg-cg { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; margin-top: 8px; }
    .ed-bg-cg-item { display: flex; flex-direction: column; align-items: stretch; gap: 4px; position: relative; }
    .ed-bg-cg-label { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.5); text-align: center; }
    .ed-bg-cg .ed-sw { width: 100%; }
    /* The tint custom swatch is a <label> wrapping a colour input, so it needs
       the box drawn on it rather than inherited from a button. */
    .ed-bg-tint-row .ed-bg-tint-custom {
      position: relative; overflow: hidden; border: 1px solid rgba(28,29,34,0.18);
      display: inline-block; aspect-ratio: auto;
    }
    .ed-bg-tint-row .ed-bg-tint-custom input[type="color"] {
      position: absolute; inset: -6px; width: calc(100% + 12px); height: calc(100% + 12px);
      border: 0; padding: 0; background: none; cursor: pointer;
    }
    /* Sections give colour and image a visible edge between them. */
    .ed-bg-sec + .ed-bg-sec { margin-top: 20px; padding-top: 18px; border-top: 1px solid rgba(28,29,34,0.09); }
    /* Inside a section, the group labels step down rather than repeating the
       section heading's weight two lines below it. */
    #ed-bg-colour-mount .ed-section-title {
      margin-top: 0; font-size: 9.5px; letter-spacing: 0.08em;
      color: rgba(28,29,34,0.5);
    }

    /* Popover triggered from a .ed-pop-trigger button. The trigger lives
       in the context bar; the popover itself is appended to <body> so
       overflow on the context bar can't clip it. */
    .ed-pop {
      position: fixed;
      z-index: 200;
      min-width: 240px;
      max-width: 320px;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.12);
      border-radius: 6px;
      box-shadow: 0 18px 50px -10px rgba(28,29,34,0.25);
      padding: 14px;
    }
    /* Form-flavoured popover — used by Position and Effects which want the
       same input styling as the right panel rather than the lean slider
       layout that .ed-pop-row gives. */
    .ed-pop-form { min-width: 280px; max-width: 340px; }
    .ed-pop-effects { min-width: 300px; max-width: 360px; }
    .ed-pop-form .ed-props-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 8px;
      align-items: end;
    }
    .ed-pop-form .ed-props-field {
      display: flex; flex-direction: column; gap: 4px; min-width: 0;
    }
    .ed-pop-form .ed-props-field > label {
      font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(28,29,34,0.6);
    }
    .ed-pop-form .ed-props-field input,
    .ed-pop-form .ed-props-field select {
      padding: 7px 10px;
      font-family: var(--sans); font-size: var(--ws-t-body);
      border: 1px solid rgba(28,29,34,0.15);
      border-radius: 4px;
      background: #fff;
      color: var(--ink);
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
    }
    .ed-pop-form .ed-props-field input[type="color"] { padding: 2px; height: 32px; cursor: pointer; }
    .ed-pop-form .ed-props-field input[type="range"] { padding: 0; min-height: 32px; }
    .ed-pop-form .ed-props-section { margin-bottom: 8px; }
    .ed-pop-form .ed-props-section h4 { display: none; }
    /* Text label inside an .ed-ctx-btn — same height as icon-only triggers
       but with a readable label. */
    .ed-ctx-poplabel {
      font-family: var(--sans);
      font-size: var(--ws-t-meta);
      font-weight: 600;
      padding: 0 4px;
      color: var(--ink);
    }
    .ed-pop[hidden] { display: none; }
    .ed-pop-panel {
      display: flex; flex-direction: column;
      gap: 6px;
    }
    .ed-pop-row {
      display: flex; align-items: center; gap: 12px;
      min-height: 24px;
    }
    .ed-pop-row > span {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.55);
    }
    .ed-pop-row input[type="range"] {
      flex: 1;
      accent-color: var(--english-violet);
    }
    .ed-pop-row output {
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      font-weight: 700;
      color: var(--ink);
      min-width: 44px;
      text-align: right;
    }

    /* Right-click context menu */
    .ed-rclick {
      position: fixed;
      z-index: 250;
      min-width: 220px;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.12);
      border-radius: 6px;
      box-shadow: 0 18px 50px -10px rgba(28,29,34,0.3);
      padding: 6px;
      display: flex;
      flex-direction: column;
    }
    .ed-rclick[hidden] { display: none; }
    .ed-rclick-item {
      appearance: none;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 14px;
      padding: 8px 12px;
      background: transparent;
      border: 0;
      border-radius: 4px;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      font-weight: 500;
      color: var(--ink);
      cursor: pointer;
      text-align: left;
    }
    .ed-rclick-item:hover { background: rgba(28,29,34,0.06); }
    .ed-rclick-item.is-danger { color: #a05a3c; }
    .ed-rclick-item.is-danger:hover { background: rgba(160,90,60,0.1); }
    /* Hover fly-out submenus (Layer / Align / Flip) */
    .ed-rclick-item.has-sub .ed-rclick-arrow { color: rgba(28,29,34,0.4); font-size: var(--ws-t-title); line-height: 1; }
    .ed-rclick-flyout {
      position: absolute;
      left: calc(100% + 4px);
      min-width: 168px;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.12);
      border-radius: 6px;
      box-shadow: 0 18px 50px -10px rgba(28,29,34,0.3);
      padding: 6px;
      display: none;
      flex-direction: column;
      z-index: 1;
    }
    .ed-rclick-flyout.is-open { display: flex; }
    .ed-rclick-flyout.flip-left { left: auto; right: calc(100% + 4px); }
    .ed-rclick-hint {
      font-size: var(--ws-t-label);
      color: rgba(28,29,34,0.45);
      font-weight: 600;
      letter-spacing: 0.04em;
    }
    .ed-rclick-divider {
      height: 1px;
      margin: 6px 8px;
      background: rgba(28,29,34,0.08);
    }

    /* ===== Canvas stage ===== */
    /* data-lenis-prevent is set on this element in the markup - see the stage
       div - so any smooth-scroll library leaves its wheel events alone. */
    .ed-stage {
      grid-area: stage;
      position: relative;
      overflow: auto;
      /* Transparent so the editor's purple wash shows through behind the
         white canvas. */
      background: transparent;
      display: flex;
      padding: 40px;
    }
    /* Centred with auto margins rather than align/justify-content.

       They look equivalent until the canvas is bigger than the stage: a
       flex item centred with align-items overflows equally in both
       directions, and the half above the container sits at a negative scroll
       offset the browser cannot reach. That is why a zoomed-in design would
       scroll down but never up, and never quite reach the bottom either.
       Auto margins collapse to zero once there is no spare room, so the
       overflow all falls below and every part of it is reachable. */
    /* Centred with auto margins on the sizer, not align-items on the stage:
       a centred flex item that overflows does so equally in both directions,
       and the half above the container sits at a scroll offset the browser
       cannot reach. Auto margins collapse to zero once the space is gone, so
       all of the overflow falls below, where it can be scrolled to. */
    .ed-canvas-sizer { margin: auto; flex: none; }

    /* ---- Colour panel (left, over the panel column) ----
       Sized off the grid, not by eye: the shell is `76px 360px 1fr`, so the
       overlay starts where the rail ends and is exactly as wide as the panel
       it replaces. It used to start at 100px, which left a 24px strip of the
       panel showing down the left-hand side and overhung the canvas by the
       same amount on the right. */
    .ed-colorpanel {
      position: absolute; left: 76px; top: 64px; width: 360px; bottom: 0; z-index: 40;
      background: #fff; border-right: 1px solid rgba(28,29,34,0.08);
      display: flex; flex-direction: column;
      box-shadow: 8px 0 28px -18px rgba(28,29,34,0.4);
    }
    .ed-colorpanel[hidden] { display: none; }
    .ed-cp-head { display: flex; align-items: center; justify-content: space-between; padding: 16px 18px 12px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .ed-cp-title { font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 700; letter-spacing: 0.04em; color: var(--ink); }
    .ed-cp-close { width: 28px; height: 28px; border-radius: 6px; border: none; background: transparent; cursor: pointer; font-size: var(--ws-t-title); color: rgba(28,29,34,0.55); }
    .ed-cp-close:hover { background: rgba(28,29,34,0.06); color: var(--ink); }
    .ed-cp-scroll { flex: 1; overflow-y: auto; padding: 14px 18px 28px; scrollbar-width: thin; }
    /* ---- The colour picker ----
       Saturation across, value down, hue underneath, hex at the foot — the
       arrangement every design tool uses, so it needs no learning. Replaces
       <input type="color">, which opened the operating system's own panel:
       a different shape on every platform, and R/G/B boxes in front of you
       when hex is what brand work is written in. */
    .ed-pick { display: flex; flex-direction: column; gap: 10px; }
    .ed-pick-sv {
      position: relative; width: 100%; aspect-ratio: 3 / 2;
      border-radius: 10px; overflow: hidden; cursor: crosshair;
      touch-action: none; user-select: none;
    }
    /* White left-to-right and black top-to-bottom over the hue: the standard
       construction, and it costs no canvas or image to draw. */
    .ed-pick-sv-white, .ed-pick-sv-black { position: absolute; inset: 0; }
    .ed-pick-sv-white { background: linear-gradient(to right, #fff, rgba(255,255,255,0)); }
    .ed-pick-sv-black { background: linear-gradient(to top, #000, rgba(0,0,0,0)); }
    .ed-pick-dot, .ed-pick-hue-dot {
      position: absolute; width: 16px; height: 16px; border-radius: 50%;
      border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(20,18,26,0.45), 0 1px 4px rgba(20,18,26,0.4);
      transform: translate(-50%, -50%); pointer-events: none;
    }
    .ed-pick-hue {
      position: relative; height: 14px; border-radius: 999px; cursor: pointer;
      touch-action: none; user-select: none;
      background: linear-gradient(to right, #f00 0%, #ff0 17%, #0f0 33%, #0ff 50%, #00f 67%, #f0f 83%, #f00 100%);
    }
    .ed-pick-hue-dot { top: 50%; }
    .ed-pick-foot { display: flex; align-items: center; gap: 8px; }
    .ed-pick-preview {
      width: 30px; height: 30px; border-radius: 8px; flex: none;
      border: 1px solid rgba(28,29,34,0.18);
    }
    .ed-pick-hex {
      flex: 1; min-width: 0; padding: 8px 10px;
      font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 600; letter-spacing: 0.04em;
      text-transform: uppercase; color: var(--ink);
      border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; background: var(--paper);
    }
    .ed-pick-hex:focus {
      outline: none; border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(var(--violet-rgb),0.1);
    }
    .ed-pick-drop {
      width: 32px; height: 32px; flex: none; display: flex; align-items: center; justify-content: center;
      border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; background: var(--paper);
      color: var(--english-violet); cursor: pointer; transition: background 0.15s, border-color 0.15s;
    }
    .ed-pick-drop:hover { background: rgba(var(--violet-rgb),0.06); border-color: rgba(var(--violet-rgb),0.4); }

    .ed-cp-hex {
      width: 100%; box-sizing: border-box; padding: 10px 12px; margin-bottom: 16px;
      font-family: var(--sans); font-size: var(--ws-t-row); border: 1px solid rgba(28,29,34,0.2); border-radius: 8px; background: var(--paper);
    }
    .ed-cp-hex:focus { outline: none; border-color: var(--english-violet); }
    .ed-cp-sec { margin-bottom: 18px; }
    .ed-cp-sec h5 { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin: 0 0 9px; }
    .ed-cp-grid { display: flex; flex-wrap: wrap; gap: 7px; }
    .ed-cp-sw {
      width: 26px; height: 26px; flex: 0 0 auto; border-radius: 50%; cursor: pointer;
      border: 1px solid rgba(28,29,34,0.14); padding: 0; transition: transform 0.12s;
      background-size: cover; background-position: center;
    }
    .ed-cp-sw:hover { transform: scale(1.15); }
    .ed-cp-sw.is-current { box-shadow: 0 0 0 2px #fff, 0 0 0 3px var(--english-violet); }
    .ed-cp-grid--grad .ed-cp-sw { width: 40px; height: 28px; border-radius: 6px; }
    .ed-cp-empty { flex: 1 1 100%; font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.45); white-space: nowrap; margin: 0; }

    /* ---- Custom gradient editor ---- */
    .ed-cpg { display: flex; flex-direction: column; gap: 9px; font-family: var(--sans); }
    .ed-cpg-preview { height: 40px; border-radius: 8px; border: 1px solid rgba(28,29,34,0.14); }
    .ed-cpg-row { display: flex; align-items: center; gap: 8px; }
    .ed-cpg-row.is-hidden { display: none; }
    .ed-cpg-lbl { flex: 0 0 42px; font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .ed-cpg-color { width: 30px; height: 26px; padding: 0; border: 1px solid rgba(28,29,34,0.18); border-radius: 6px; background: none; cursor: pointer; }
    .ed-cpg-color:disabled { opacity: 0.4; cursor: not-allowed; }
    .ed-cpg-hex {
      flex: 1; min-width: 0; font-family: var(--sans); font-size: var(--ws-t-meta); padding: 6px 8px;
      border: 1px solid rgba(28,29,34,0.18); border-radius: 6px; background: #fff; color: var(--ink);
    }
    .ed-cpg-hex:disabled { opacity: 0.5; }
    .ed-cpg-hex:focus { outline: none; border-color: var(--english-violet); }
    .ed-cpg-fade { display: inline-flex; align-items: center; gap: 4px; font-size: var(--ws-t-label); color: rgba(28,29,34,0.7); white-space: nowrap; cursor: pointer; }
    .ed-cpg-seg { display: flex; gap: 4px; }
    .ed-cpg-seg button {
      flex: 1; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.04em;
      padding: 7px 0; border: 1px solid rgba(28,29,34,0.18); border-radius: 6px; background: #fff;
      color: rgba(28,29,34,0.7); cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .ed-cpg-seg button.is-on { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .ed-cpg-range { flex: 1; min-width: 0; accent-color: var(--english-violet); }
    .ed-cpg-val { flex: 0 0 40px; text-align: right; font-size: var(--ws-t-label); color: rgba(28,29,34,0.7); font-variant-numeric: tabular-nums; }
    .ed-cpg-hint { margin: 2px 0 0; font-size: var(--ws-t-label); line-height: 1.4; color: rgba(28,29,34,0.45); }
    /* Canva-style multi-stop bits */
    .ed-cpg-sub { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin-top: 2px; }
    .ed-cpg-stops { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .ed-cpg-stop {
      width: 30px; height: 30px; border-radius: 50%; cursor: pointer;
      border: 2px solid #fff; box-shadow: 0 0 0 1px rgba(28,29,34,0.2);
      padding: 0; transition: box-shadow 0.12s, transform 0.12s;
    }
    .ed-cpg-stop.is-sel { box-shadow: 0 0 0 2px var(--english-violet); transform: scale(1.06); }
    .ed-cpg-add {
      width: 30px; height: 30px; border-radius: 50%; cursor: pointer;
      border: 1.5px dashed rgba(28,29,34,0.35); background: #fff;
      font-size: var(--ws-t-title); line-height: 1; color: rgba(28,29,34,0.6);
      display: inline-flex; align-items: center; justify-content: center;
    }
    .ed-cpg-add:hover { border-color: var(--english-violet); color: var(--english-violet); }
    .ed-cpg-del {
      flex: 0 0 auto; width: 26px; height: 26px; border-radius: 6px; cursor: pointer;
      border: 1px solid rgba(28,29,34,0.18); background: #fff; color: rgba(28,29,34,0.6); font-size: var(--ws-t-body);
    }
    .ed-cpg-del:hover:not(:disabled) { background: rgba(200,60,60,0.1); border-color: rgba(200,60,60,0.4); color: #b03b3b; }
    .ed-cpg-del:disabled { opacity: 0.35; cursor: not-allowed; }
    .ed-cpg-styles { display: flex; gap: 8px; }
    .ed-cpg-style {
      width: 44px; height: 36px; border-radius: 7px; cursor: pointer;
      border: 2px solid transparent; box-shadow: 0 0 0 1px rgba(28,29,34,0.15); padding: 0;
    }
    .ed-cpg-style.is-on { border-color: var(--english-violet); box-shadow: 0 0 0 1px var(--english-violet); }

    /* ---- Upload processing spinner ---- */
    #ed-upload-spinner {
      position: fixed; inset: 0; z-index: 200; display: none;
      align-items: center; justify-content: center;
      background: rgba(28,29,34,0.45); -webkit-backdrop-filter: blur(2px); backdrop-filter: blur(2px);
    }
    #ed-upload-spinner .ed-spin-box {
      display: flex; flex-direction: column; align-items: center; gap: 14px;
      background: #fff; border-radius: 16px; padding: 26px 34px;
      box-shadow: 0 22px 60px -18px rgba(28,29,34,0.5);
    }
    #ed-upload-spinner .ed-spin {
      width: 38px; height: 38px; border-radius: 50%;
      border: 3px solid rgba(55,30,40,0.15); border-top-color: var(--english-violet);
      animation: ed-spin 0.8s linear infinite;
    }
    #ed-upload-spinner .ed-spin-label {
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet);
    }
    @keyframes ed-spin { to { transform: rotate(360deg); } }

    /* ---- Share dropdown ---- */
    .ed-share { position: relative; }
    .ed-share-caret { font-size: 9px; margin-left: 2px; color: rgba(28,29,34,0.5); }
    .ed-share-menu {
      position: absolute; top: calc(100% + 8px); right: 0; z-index: 80;
      min-width: 280px; background: #fff; border: 1px solid rgba(28,29,34,0.12);
      border-radius: 12px; box-shadow: 0 18px 50px -12px rgba(28,29,34,0.4); padding: 6px;
    }
    .ed-share-menu[hidden] { display: none; }
    .ed-share-item {
      display: flex; flex-direction: column; gap: 2px; width: 100%; text-align: left;
      padding: 10px 12px; background: transparent; border: none; border-radius: 8px; cursor: pointer;
    }
    .ed-share-item:hover { background: rgba(var(--violet-rgb),0.08); }
    .ed-share-item strong { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 700; color: var(--ink); }
    .ed-share-item span { font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.6); }

    /* ---- Send-for-review modal ---- */
    .ed-rev-scrim {
      position: fixed; inset: 0; z-index: 400; display: flex; align-items: center; justify-content: center;
      padding: 24px; background: rgba(16,14,22,0.55); backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
      opacity: 0; transition: opacity 0.2s ease;
    }
    .ed-rev-scrim.is-open { opacity: 1; }
    .ed-rev {
      width: 100%; max-width: 460px; background: var(--paper); color: var(--ink);
      border-radius: 16px; padding: 32px 34px 26px; box-shadow: 0 30px 80px -20px rgba(16,14,22,0.6);
      transform: translateY(12px) scale(0.98); transition: transform 0.22s cubic-bezier(.16,1,.3,1);
    }
    .ed-rev-scrim.is-open .ed-rev { transform: none; }
    .ed-rev-eyebrow { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--english-violet); margin-bottom: 10px; }
    .ed-rev-title { font-family: var(--serif); font-weight: 400; font-size: var(--ws-t-panel); line-height: 1.15; letter-spacing: -0.015em; margin: 0 0 10px; text-wrap: balance; }
    .ed-rev-sub { font-family: var(--sans); font-size: var(--ws-t-row); line-height: 1.55; color: rgba(28,29,34,0.65); margin: 0 0 20px; }
    .ed-rev-label { display: block; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,29,34,0.55); margin: 14px 0 7px; }
    .ed-rev-label span { font-weight: 500; letter-spacing: 0; text-transform: none; color: rgba(28,29,34,0.4); }
    .ed-rev-email, .ed-rev-msg {
      width: 100%; box-sizing: border-box; padding: 12px 14px; font-family: var(--sans); font-size: var(--ws-t-row);
      border: 1px solid rgba(28,29,34,0.2); border-radius: 8px; background: #fff; color: var(--ink);
    }
    .ed-rev-msg { resize: vertical; }
    .ed-rev-email:focus, .ed-rev-msg:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(var(--violet-rgb),0.12); }
    .ed-rev-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 22px; }
    .ed-rev-cancel, .ed-rev-send { font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 700; letter-spacing: 0.06em; padding: 12px 24px; border-radius: 999px; cursor: pointer; border: 1px solid transparent; transition: background 0.2s, color 0.2s, border-color 0.2s; }
    .ed-rev-cancel { background: transparent; color: rgba(28,29,34,0.6); border-color: rgba(28,29,34,0.2); }
    .ed-rev-cancel:hover { color: var(--ink); border-color: rgba(28,29,34,0.45); }
    .ed-rev-send { background: var(--english-violet); color: var(--paper); }
    .ed-rev-send:hover { background: var(--ink); }
    .ed-rev-status { font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.5; color: #2e7d52; margin: 14px 0 0; }
    .ed-rev-status.is-error { color: #a05a3c; }
    .ed-rev-status[hidden] { display: none; }
    .ed-rev-status a { color: var(--english-violet); word-break: break-all; }

    /* ---- Page strip (multi-page designs) ----
       Hidden by default so the canvas gets the full height. The "Pages"
       toggle in the left rail pops it up from the bottom on demand. Never
       shows a scrollbar — hover + mouse-wheel scrolls the pages (wired in JS). */
    .ed-pages {
      grid-area: pages;
      display: none;
      align-items: center; gap: 12px;
      padding: 12px 18px;
      background: rgba(255,255,255,0.62);
      backdrop-filter: blur(10px) saturate(1.2);
      -webkit-backdrop-filter: blur(10px) saturate(1.2);
      border-top: 1px solid rgba(28,29,34,0.08);
      overflow-x: auto; overflow-y: hidden;
      scrollbar-width: none; -ms-overflow-style: none;
    }
    .ed-pages::-webkit-scrollbar { width: 0; height: 0; display: none; }
    .editor.show-pages .ed-pages {
      display: flex;
      animation: edPagesUp 0.34s cubic-bezier(.2,.75,.2,1) both;
    }
    @keyframes edPagesUp {
      from { opacity: 0; transform: translateY(100%); }
      to   { opacity: 1; transform: translateY(0); }
    }
    @media (prefers-reduced-motion: reduce) {
      .editor.show-pages .ed-pages { animation: none; }
    }
    .ed-page-tile {
      position: relative; flex: 0 0 auto;
      width: 68px; height: 85px;
      border: 2px solid rgba(28,29,34,0.18); border-radius: 6px;
      background: #fff; cursor: pointer; padding: 0;
      box-shadow: 0 1px 3px rgba(28,29,34,0.12);
      transition: border-color 0.2s, transform 0.15s;
    }
    .ed-page-tile:hover { transform: translateY(-2px); }
    .ed-page-tile.is-current { border-color: var(--english-violet); box-shadow: 0 0 0 2px rgba(var(--violet-rgb),0.18), 0 2px 6px rgba(28,29,34,0.18); }
    .ed-page-num {
      position: absolute; left: 4px; bottom: 3px;
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700;
      color: rgba(28,29,34,0.55); background: rgba(255,255,255,0.85);
      border-radius: 3px; padding: 0 4px; line-height: 1.4;
    }
    .ed-page-acts {
      position: absolute; top: 3px; right: 3px; display: flex; gap: 2px;
      opacity: 0; transition: opacity 0.15s;
    }
    .ed-page-tile:hover .ed-page-acts, .ed-page-tile.is-current .ed-page-acts { opacity: 1; }
    .ed-page-act {
      width: 16px; height: 16px; border-radius: 4px;
      display: flex; align-items: center; justify-content: center;
      font-size: var(--ws-t-label); line-height: 1; color: #fff;
      background: rgba(28,29,34,0.55); cursor: pointer;
    }
    .ed-page-act:hover { background: var(--english-violet); }
    .ed-page-del:hover { background: #c0392b; }
    .ed-page-add {
      flex: 0 0 auto; width: 68px; height: 85px;
      border: 2px dashed rgba(28,29,34,0.25); border-radius: 6px;
      background: transparent; cursor: pointer;
      display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2px;
      color: rgba(28,29,34,0.55); transition: border-color 0.2s, color 0.2s;
    }
    .ed-page-add span { font-size: 20px; line-height: 1; }
    .ed-page-add small { font-size: 8px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
    .ed-page-add:hover { border-color: var(--english-violet); color: var(--english-violet); }

    /* ---- Publish → Pack modal (admin) ---- */
    .ed-pub-scrim {
      position: fixed; inset: 0; z-index: 400; display: flex; align-items: center; justify-content: center;
      padding: 24px; background: rgba(16,14,22,0.55);
      backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
      opacity: 0; transition: opacity 0.2s ease;
    }
    .ed-pub-scrim.is-open { opacity: 1; }
    .ed-pub {
      width: 100%; max-width: 480px; background: var(--paper); color: var(--ink);
      border-radius: 16px; padding: 32px 34px 26px;
      box-shadow: 0 30px 80px -20px rgba(16,14,22,0.6);
      transform: translateY(12px) scale(0.98); transition: transform 0.22s cubic-bezier(.16,1,.3,1);
    }
    .ed-pub-scrim.is-open .ed-pub { transform: none; }
    .ed-pub-eyebrow { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--english-violet); margin-bottom: 10px; }
    .ed-pub-title { font-family: var(--serif); font-weight: 400; font-size: 30px; letter-spacing: -0.015em; margin: 0 0 8px; }
    .ed-pub-title em { font-style: italic; color: var(--english-violet); }
    .ed-pub-sub { font-family: var(--sans); font-size: var(--ws-t-row); line-height: 1.55; color: rgba(28,29,34,0.65); margin: 0 0 22px; }
    .ed-pub-choices { display: flex; flex-direction: column; gap: 12px; }
    .ed-pub-choice { display: flex; align-items: center; gap: 10px; font-family: var(--sans); font-size: var(--ws-t-row); color: var(--ink); cursor: pointer; }
    .ed-pub-choice.is-disabled { opacity: 0.4; }
    .ed-pub-newname, .ed-pub-existing {
      margin: -4px 0 4px 26px; padding: 11px 14px; font-family: var(--sans); font-size: var(--ws-t-row);
      border: 1px solid rgba(28,29,34,0.2); border-radius: 6px; background: #fff; color: var(--ink);
    }
    .ed-pub-newname:focus, .ed-pub-existing:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(var(--violet-rgb),0.12); }
    .ed-pub-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 26px; }
    .ed-pub-cancel, .ed-pub-ok {
      font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 700; letter-spacing: 0.06em;
      padding: 12px 24px; border-radius: 999px; cursor: pointer; border: 1px solid transparent; transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .ed-pub-cancel { background: transparent; color: rgba(28,29,34,0.6); border-color: rgba(28,29,34,0.2); }
    .ed-pub-cancel:hover { color: var(--ink); border-color: rgba(28,29,34,0.45); }
    .ed-pub-ok { background: var(--english-violet); color: var(--paper); }
    .ed-pub-ok:hover { background: var(--ink); }
    .ed-canvas-shadow {
      position: relative;
      box-shadow: 0 30px 90px -30px rgba(28,29,34,0.35), 0 4px 12px -6px rgba(28,29,34,0.18);
      /* Scales from its top-left, which is where the sizer has reserved its
         space. Scaling from the centre threw the top half of a zoomed canvas
         above the sizer, where nothing could scroll to it. */
      transform-origin: 0 0;
    }
    .ed-canvas {
      position: relative;
      overflow: hidden;
      background: #fff;
    }
    /* Empty-state prompt for a blank canvas. Sits in the canvas (so it scales
       with zoom) but is never part of the design data, so it won't export. */
    .ed-blank-hint {
      position: absolute;
      inset: 0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--serif), Georgia, serif;
      font-style: italic;
      font-size: 64px;
      letter-spacing: -0.01em;
      color: rgba(28, 29, 34, 0.28);
      text-align: center;
      padding: 0 8%;
      /* Clickable: a click drops a real, editable + deletable text box here. */
      pointer-events: auto;
      cursor: text;
      user-select: none;
      transition: opacity 0.2s;
    }
    .ed-blank-hint:hover { opacity: 0.65; }
    .ed-element {
      position: absolute;
      box-sizing: border-box;
      transform-origin: center center;
      user-select: none;
    }
    .ed-element[data-type="text"] {
      display: flex; align-items: flex-start;
      cursor: move;
      overflow: visible;
    }
    .ed-element[data-type="text"] .ed-text-inner {
      width: 100%;
      outline: none;
      word-wrap: break-word;
      white-space: pre-wrap;
      cursor: move;
    }
    .ed-element[data-type="text"].is-editing .ed-text-inner { cursor: text; }
    .ed-element[data-type="image"] img {
      width: 100%; height: 100%; object-fit: cover; pointer-events: none;
      display: block;
    }
    .ed-element.is-locked { pointer-events: none; }
    .ed-element.is-hidden { display: none; }

    .ed-element.is-selected::after {
      content: "";
      position: absolute; inset: -2px;
      border: 1.5px solid var(--english-violet);
      pointer-events: none;
    }
    .ed-element.is-multiselected::after {
      content: "";
      position: absolute; inset: -2px;
      border: 1.5px dashed rgba(var(--violet-rgb),0.7);
      pointer-events: none;
    }

    .ed-handles {
      position: absolute; inset: 0;
      pointer-events: none;
      transform-origin: center center;
    }
    /* High-contrast selection colour — must stand out over any photo, so a
       bright blue with a white halo rather than the muted brand violet. */
    .ed-stage { --ed-select: #1F8BFF; }
    .ed-handle {
      position: absolute;
      width: 11px; height: 11px;
      background: #fff;
      border: 2px solid var(--ed-select);
      border-radius: 50%;
      box-shadow: 0 0 0 1.5px rgba(255,255,255,0.9), 0 1px 4px rgba(0,0,0,0.35);
      pointer-events: auto;
      cursor: nwse-resize;
      z-index: 50;
    }
    .ed-handle[data-h="n"], .ed-handle[data-h="s"] { cursor: ns-resize; }
    .ed-handle[data-h="e"], .ed-handle[data-h="w"] { cursor: ew-resize; }
    .ed-handle[data-h="ne"], .ed-handle[data-h="sw"] { cursor: nesw-resize; }
    .ed-handle[data-h="rot"] {
      width: 15px; height: 15px;
      border-radius: 50%;
      background: var(--ed-select);
      border-color: #fff;
      cursor: grab;
    }
    .ed-bounds {
      position: absolute;
      border: 2px solid var(--ed-select);
      box-shadow: 0 0 0 1px rgba(255,255,255,0.85);
      pointer-events: none;
      box-sizing: border-box;
    }

    /* Floating selection toolbar (Canva-style quick actions, screen-space) */
    .ed-floatbar {
      position: fixed; z-index: 120;
      display: flex; align-items: center; gap: 2px;
      padding: 4px; background: #fff; border-radius: 10px;
      box-shadow: 0 8px 28px -8px rgba(28,29,34,0.4), 0 2px 6px rgba(28,29,34,0.14);
      border: 1px solid rgba(28,29,34,0.08);
    }
    .ed-floatbar[hidden] { display: none; }
    .ed-fb-btn {
      position: relative; width: 32px; height: 32px; border: none; background: transparent;
      border-radius: 7px; cursor: pointer; color: var(--ink);
      display: flex; align-items: center; justify-content: center; transition: background 0.15s, color 0.15s;
    }
    .ed-fb-btn:hover { background: rgba(28,29,34,0.07); }
    .ed-fb-danger:hover { background: rgba(192,57,43,0.12); color: #c0392b; }
    .ed-fb-sep { width: 1px; height: 20px; background: rgba(28,29,34,0.12); margin: 0 3px; }
    .ed-fb-count {
      position: absolute; top: -3px; right: -3px; min-width: 15px; height: 15px; padding: 0 3px;
      border-radius: 999px; background: var(--english-violet); color: #fff;
      font-family: var(--sans); font-size: 9px; font-weight: 700; line-height: 15px; text-align: center;
    }
    .ed-fb-count[hidden] { display: none; }
    .ed-fb-text { width: auto; padding: 0 12px; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; color: var(--english-violet); }

    /* Marquee drag-select box (canvas space) */
    .ed-marquee {
      position: absolute; z-index: 48; pointer-events: none;
      border: 1.5px solid var(--ed-select, #1F8BFF);
      background: rgba(31,139,255,0.10); box-sizing: border-box;
    }
    .ed-bounds--multi { border-style: dashed; }

    /* Text vertically centred in its box (icon labels stay on the icon's line) */
    .ed-element.ed-text-vcenter { display: flex; align-items: center; }
    .ed-element.ed-text-vcenter .ed-text-inner { width: 100%; }

    /* Comment popover */
    .ed-cmt-pop {
      position: fixed; z-index: 130; width: 300px;
      background: #fff; border: 1px solid rgba(28,29,34,0.12); border-radius: 12px;
      box-shadow: 0 18px 50px -12px rgba(28,29,34,0.4); overflow: hidden;
    }
    .ed-cmt-head { font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; letter-spacing: 0.04em; color: var(--ink); padding: 12px 14px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .ed-cmt-list { max-height: 220px; overflow-y: auto; padding: 6px; }
    .ed-cmt-empty { font-family: var(--sans); font-size: var(--ws-t-body); color: rgba(28,29,34,0.45); padding: 10px 8px; margin: 0; }
    .ed-cmt { padding: 9px 10px; border-radius: 8px; }
    .ed-cmt:hover { background: rgba(28,29,34,0.04); }
    .ed-cmt p { font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.5; color: var(--ink); margin: 0 0 6px; white-space: pre-wrap; word-break: break-word; }
    .ed-cmt.is-resolved p { color: rgba(28,29,34,0.4); text-decoration: line-through; }
    .ed-cmt-acts { display: flex; gap: 12px; }
    .ed-cmt-acts button { background: none; border: none; cursor: pointer; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.04em; color: var(--english-violet); padding: 0; }
    .ed-cmt-acts button:hover { text-decoration: underline; }
    .ed-cmt-add { display: flex; flex-direction: column; gap: 8px; padding: 10px 12px 12px; border-top: 1px solid rgba(28,29,34,0.08); }
    .ed-cmt-add textarea { resize: vertical; font-family: var(--sans); font-size: var(--ws-t-body); padding: 9px 11px; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; }
    .ed-cmt-add textarea:focus { outline: none; border-color: var(--english-violet); }
    .ed-cmt-send { align-self: flex-end; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; color: var(--paper); background: var(--english-violet); border: none; border-radius: 999px; padding: 8px 18px; cursor: pointer; }
    .ed-cmt-send:hover { background: var(--ink); }

    /* Comment badge on an element */
    .ed-cmt-badge {
      position: absolute; top: -10px; right: -10px; z-index: 6;
      min-width: 20px; height: 20px; padding: 0 5px; border-radius: 999px 999px 999px 2px;
      background: #F0C23B; color: #1c1d22; border: 1.5px solid #fff;
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; line-height: 18px; text-align: center;
      box-shadow: 0 2px 6px rgba(28,29,34,0.25); pointer-events: none;
    }

    .ed-guides {
      position: absolute; inset: 0; pointer-events: none; z-index: 49;
    }
    .ed-guide {
      position: absolute; background: #ff3b6b;
    }
    .ed-guide-v { width: 1px; }
    .ed-guide-h { height: 1px; }

    /* Safe-area / margin guides (toggle in the toolbar) */
    .ed-margins { position: absolute; inset: 0; pointer-events: none; z-index: 47; }
    .ed-margins[hidden] { display: none; }
    .ed-margin-box { position: absolute; border: 1px dashed rgba(91, 70, 110, 0.7); box-sizing: border-box; }
    .ed-margins-size { width: 52px; height: 30px; margin-left: 2px; border: 1px solid rgba(28,29,34,0.15); border-radius: 8px; background: #fff; font: inherit; font-size: var(--ws-t-meta); text-align: center; color: var(--ink); }
    #ed-margins-toggle[aria-pressed="true"] { background: rgba(var(--violet-rgb), 0.14); color: var(--english-violet); }

    /* User-placed guide lines (the "+ Guide" button). The overlay ignores
       pointers; each line is clickable/draggable via a widened hit zone. */
    .ed-userguides { position: absolute; inset: 0; pointer-events: none; z-index: 48; }
    .ed-userguide { position: absolute; pointer-events: auto; box-sizing: border-box; }
    .ed-userguide--v { cursor: ew-resize; }
    .ed-userguide--h { cursor: ns-resize; }
    /* Transparent grab strip so a 1px line is still easy to hit. */
    .ed-userguide::before { content: ""; position: absolute; }
    .ed-userguide--v::before { left: 50%; top: 0; transform: translateX(-50%); width: 11px; height: 100%; }
    .ed-userguide--h::before { top: 50%; left: 0; transform: translateY(-50%); height: 11px; width: 100%; }
    .ed-userguide.is-selected { box-shadow: 0 0 0 1px #fff, 0 0 0 2px var(--english-violet); }
    .ed-pane-sub { margin: 4px 0 0; font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.55); }

    /* Smart distance guides (Canva-style) — pixel gap badges + connector lines */
    .ed-dist-line { position: absolute; background: #ff3b6b; }
    .ed-dist-line-h { height: 1px; }
    .ed-dist-line-v { width: 1px; }
    .ed-dist {
      position: absolute; transform: translate(-50%, -50%);
      background: #ff3b6b; color: #fff; font-family: var(--sans, sans-serif);
      font-size: var(--ws-t-label); font-weight: 700; line-height: 1; padding: 2px 5px;
      border-radius: 4px; pointer-events: none; white-space: nowrap;
    }

    /* ===== Right properties ===== */
    .ed-props {
      grid-area: props;
      background: #fff;
      border-left: 1px solid rgba(28,29,34,0.08);
      overflow-y: auto;
      padding: 20px;
      z-index: 15;
    }
    .ed-props-empty {
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      height: 100%;
      text-align: center;
      color: rgba(28,29,34,0.45);
    }
    .ed-props-empty p { margin: 12px 0 4px; font-size: var(--ws-t-body); }
    .ed-props-hint { font-size: var(--ws-t-label); color: rgba(28,29,34,0.35); }
    /* A hint sitting under a label needs to wrap onto its own line rather than
       run into it, or it gets clipped against the controls below. Now that
       these hints are full sentences they cannot run on from the label's own
       words either, so the ones inside other labels get the same treatment. */
    .ed-props-field > label > .ed-props-hint,
    .ed-props-hint--block {
      display: block; margin-top: 3px; line-height: 1.4;
      /* The label above is uppercase and the hint inherited it. A lowercase
         fragment survived that; a full sentence in capitals only shouts. */
      text-transform: none; letter-spacing: normal;
    }
    .ed-props-hint kbd {
      font-family: var(--sans);
      background: rgba(28,29,34,0.08);
      padding: 1px 6px;
      border-radius: 3px;
      font-size: var(--ws-t-label);
    }

    /* Section headings match .ed-fb-title and .ed-textlist-head exactly. They
       were 12px/800/0.2em in full ink while every other pane used
       11px/700/0.14em at half strength — invisible while these lived in their
       own pane, obvious now the selected element's controls sit inside the
       Text selection tab next to them. One treatment everywhere. */
    .ed-props-section { margin-bottom: 18px; }
    .ed-props-section h4 {
      font-family: var(--sans);
      font-size: var(--ws-t-label); font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(28,29,34,0.5);
      margin: 0 0 8px;
    }
    /* Second and later sections carry the same rule the font shelves use, so
       Content / Arrange separate the way Brand fonts / All fonts do. */
    .ed-props-section + .ed-props-section > h4 {
      border-top: 1px solid rgba(28,29,34,0.10);
      padding-top: 13px; margin-top: 13px;
    }
    .ed-props-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 8px;
      margin-bottom: 8px;
      align-items: end;
    }
    /* min-width: 0 is what lets grid items shrink below their content's
       natural min-width — without it, number/range inputs overflow and
       sit on top of their neighbour. */
    .ed-props-field { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .ed-props-field > label {
      font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
      color: rgba(28,29,34,0.6);
    }
    .ed-props-field input, .ed-props-field select {
      padding: 7px 10px;
      font-family: var(--sans); font-size: var(--ws-t-body);
      border: 1px solid rgba(28,29,34,0.15);
      border-radius: 4px;
      background: #fff;
      color: var(--ink);
      /* Constrain to the grid cell so opacity/range no longer overlaps line height. */
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
    }
    .ed-props-field input[type="color"] { padding: 2px; height: 32px; cursor: pointer; }
    .ed-props-field input[type="range"] { padding: 0; min-height: 32px; }

    .ed-props-actions {
      display: grid; grid-template-columns: repeat(2, 1fr); gap: 6px;
      margin-top: 12px;
    }
    .ed-props-actions button {
      padding: 8px;
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600;
      background: rgba(28,29,34,0.05);
      border: 1px solid transparent;
      border-radius: 4px; cursor: pointer;
      color: var(--ink);
    }
    .ed-props-actions button:hover { background: rgba(28,29,34,0.1); }
    .ed-props-actions .danger:hover { background: rgba(160, 90, 60, 0.15); color: #a05a3c; }

    /* ============ Effects section (shadow / outline / gradient / bg / merge tags) ============ */
    .ed-fx-preset-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 6px;
      margin-bottom: 14px;
    }
    .ed-fx-preset {
      padding: 8px 4px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 600;
      letter-spacing: 0.04em;
      background: rgba(28,29,34,0.05);
      border: 1px solid transparent;
      border-radius: 4px;
      color: var(--ink);
      cursor: pointer;
      text-align: center;
    }
    .ed-fx-preset:hover {
      background: rgba(47,107,240,0.12);
      border-color: rgba(47,107,240,0.45);
      color: #2455c4;
    }
    /* The currently-applied shadow preset, highlighted in blue so you can see
       which one is on at a glance. */
    .ed-fx-preset.is-current {
      background: rgba(47,107,240,0.16);
      border-color: #2f6bf0;
      color: #2455c4;
    }
    /* Effects toolbar trigger when the layer already carries any effect. */
    .ed-pop-trigger.ed-fx-active {
      color: #2455c4;
      background: rgba(47,107,240,0.12);
    }
    .ed-pop-trigger.ed-fx-active .ed-ctx-poplabel::after {
      content: "";
      display: inline-block;
      width: 6px; height: 6px;
      margin-left: 6px;
      border-radius: 50%;
      background: #2f6bf0;
      vertical-align: middle;
    }
    .ed-fx-toggle {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 0;
      margin-top: 6px;
      font-family: var(--sans);
      font-size: var(--ws-t-meta);
      font-weight: 600;
      color: var(--ink);
      cursor: pointer;
      border-top: 1px solid rgba(28,29,34,0.08);
    }
    .ed-fx-toggle input[type="checkbox"] {
      width: 16px;
      height: 16px;
      cursor: pointer;
      margin: 0;
    }
    .ed-fx-controls {
      padding: 4px 0 10px;
    }
    .ed-fx-controls[hidden] { display: none; }
    .ed-fx-mergetags { margin-top: 6px; }

    /* Toast */
    .ed-toast {
      position: fixed;
      bottom: 24px; left: 50%; transform: translateX(-50%);
      background: rgba(28,29,34,0.92);
      color: var(--paper);
      padding: 10px 18px;
      border-radius: 4px;
      font-size: var(--ws-t-body); font-weight: 500;
      z-index: 200;
      pointer-events: none;
      transition: opacity 0.25s, transform 0.25s;
    }
    .ed-toast.is-show { opacity: 1; transform: translateX(-50%) translateY(0); }

    /* Modal */
    .ed-modal {
      position: fixed; inset: 0;
      background: rgba(28,29,34,0.5);
      display: flex; align-items: center; justify-content: center;
      z-index: 300;
    }
    .ed-modal[hidden] { display: none; }
    .ed-modal-card {
      background: #fff;
      border-radius: 6px;
      padding: 28px;
      max-width: 420px;
      width: 100%;
      box-shadow: 0 40px 80px -20px rgba(0,0,0,0.4);
    }
    .ed-modal-card header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; }
    .ed-modal-card h3 {
      font-family: var(--serif); font-size: 24px; font-weight: 400;
      margin: 0;
    }
    .ed-modal-close {
      background: transparent; border: none;
      font-size: 24px; cursor: pointer; color: rgba(28,29,34,0.5);
      width: 32px; height: 32px;
    }
    .ed-modal-close:hover { color: var(--ink); }
    .ed-modal-card ul {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column; gap: 10px;
      font-size: var(--ws-t-body);
    }
    .ed-modal-card kbd {
      font-family: var(--sans);
      background: rgba(28,29,34,0.08);
      padding: 2px 6px; border-radius: 3px;
      font-size: var(--ws-t-label); font-weight: 600;
      margin: 0 2px;
    }

    /* ============ Schedule-to-calendar modal ============
       Reuses .ed-modal / .ed-modal-card from the shortcuts modal for the
       overlay shell. Form-specific styles live here. */
    .ed-sched-card { max-width: 520px; padding: 28px 30px 26px; }
    .ed-sched-eyebrow {
      margin: 0;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--english-violet, #2e1f54);
    }
    .ed-sched-card header { align-items: flex-start; }
    .ed-sched-card h3 { font-family: var(--serif); font-weight: 400; font-size: var(--ws-t-panel); letter-spacing: -0.01em; line-height: 1.05; color: var(--ink); margin: 5px 0 0; }
    /* Platform picker hidden for now (auto-post isn't live) — [hidden] beats the fieldset's display:flex. */
    .ed-sched-platform[hidden] { display: none; }

    .ed-sched-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-top: 8px;
    }
    .ed-sched-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 14px;
    }
    @media (max-width: 520px) {
      .ed-sched-row { grid-template-columns: 1fr; }
    }
    .ed-sched-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .ed-sched-label {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.65);
    }
    .ed-sched-label--row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .ed-sched-ai {
      appearance: none; border: 1px solid rgba(var(--violet-rgb), 0.3); background: rgba(var(--violet-rgb), 0.06);
      color: var(--english-violet); font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.04em;
      text-transform: none; padding: 5px 11px; border-radius: 999px; cursor: pointer; transition: background 0.18s, border-color 0.18s;
    }
    .ed-sched-ai:hover { background: rgba(var(--violet-rgb), 0.12); border-color: var(--english-violet); }
    .ed-sched-optional {
      font-weight: 500;
      letter-spacing: 0.04em;
      text-transform: none;
      color: rgba(28,29,34,0.4);
    }
    .ed-sched-hint {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      color: rgba(28,29,34,0.5);
    }
    .ed-sched-form input[type="text"],
    .ed-sched-form input[type="date"],
    .ed-sched-form input[type="time"],
    .ed-sched-form textarea {
      appearance: none;
      width: 100%;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.18);
      border-radius: 3px;
      padding: 10px 12px;
      font-family: var(--sans);
      font-size: var(--ws-t-row);
      color: var(--ink);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .ed-sched-form input:focus,
    .ed-sched-form textarea:focus {
      outline: none;
      border-color: var(--english-violet, #2e1f54);
      box-shadow: 0 0 0 3px rgba(var(--violet-rgb), 0.12);
    }
    .ed-sched-form textarea {
      resize: vertical;
      min-height: 84px;
      line-height: 1.5;
    }

    .ed-sched-platform {
      border: 0; padding: 0; margin: 0;
    }
    .ed-sched-platform-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 8px;
    }
    .ed-sched-platform-opt {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 12px;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.18);
      border-radius: 3px;
      cursor: pointer;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      font-weight: 600;
      color: var(--ink);
      transition: border-color 0.2s, background 0.2s;
    }
    .ed-sched-platform-opt input { margin: 0; accent-color: var(--english-violet, #2e1f54); }
    .ed-sched-platform-opt:hover { border-color: var(--english-violet, #2e1f54); }
    .ed-sched-platform-opt.is-active { border-color: var(--english-violet, #2e1f54); background: rgba(var(--violet-rgb), 0.06); }
    .ed-sched-platform-opt.is-soon {
      cursor: not-allowed;
      opacity: 0.55;
      color: rgba(28,29,34,0.55);
    }
    .ed-sched-platform-opt.is-soon:hover { border-color: rgba(28,29,34,0.18); }

    .ed-sched-remind {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      padding: 12px 14px;
      background: rgba(var(--violet-rgb), 0.05);
      border: 1px solid rgba(var(--violet-rgb), 0.16);
      border-radius: 3px;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      line-height: 1.45;
      color: var(--ink);
      cursor: pointer;
    }
    .ed-sched-remind input {
      margin: 2px 0 0;
      width: 16px; height: 16px;
      flex: 0 0 auto;
      accent-color: var(--english-violet, #2e1f54);
      cursor: pointer;
    }
    .ed-sched-optional {
      color: rgba(28,29,34,0.55);
      font-weight: 400;
    }

    .ed-sched-error {
      padding: 10px 14px;
      background: rgba(195, 65, 50, 0.08);
      color: #a23023;
      border: 1px solid rgba(195, 65, 50, 0.25);
      border-radius: 3px;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      line-height: 1.5;
    }
    .ed-sched-error[hidden] { display: none; }
    .ed-sched-error.is-ok {
      background: rgba(46, 125, 80, 0.08);
      color: #2e7d50;
      border-color: rgba(46, 125, 80, 0.28);
    }

    .ed-sched-foot {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 6px;
      padding-top: 14px;
      border-top: 1px solid rgba(28,29,34,0.08);
    }
    .ed-sched-cancel {
      appearance: none;
      background: transparent;
      border: 1px solid rgba(28,29,34,0.2);
      border-radius: 3px;
      padding: 10px 18px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.7);
      cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .ed-sched-cancel:hover { background: rgba(28,29,34,0.06); color: var(--ink); }
    /* Email-now sits on the left; cancel + plan stay grouped on the right. */
    .ed-sched-emailnow {
      appearance: none;
      margin-right: auto;
      background: transparent;
      border: 1px solid rgba(var(--violet-rgb), 0.4);
      border-radius: 3px;
      padding: 10px 18px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--english-violet, #2e1f54);
      cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s, opacity 0.2s;
    }
    .ed-sched-emailnow:hover:not(:disabled) { background: rgba(var(--violet-rgb), 0.08); border-color: var(--english-violet, #2e1f54); }
    .ed-sched-emailnow:disabled { opacity: 0.6; cursor: progress; }
    .ed-sched-submit {
      appearance: none;
      background: var(--english-violet, #2e1f54);
      color: #f4f2f1;
      border: 0;
      border-radius: 3px;
      padding: 11px 22px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      cursor: pointer;
      box-shadow: 0 10px 22px -10px rgba(var(--violet-rgb), 0.55);
      transition: transform 0.2s, box-shadow 0.2s, background 0.2s, opacity 0.2s;
    }
    .ed-sched-submit:hover:not(:disabled) {
      transform: translateY(-1px);
      background: #1c1d22;
      box-shadow: 0 16px 30px -10px rgba(var(--violet-rgb), 0.7);
    }
    .ed-sched-submit:disabled { opacity: 0.65; cursor: progress; transform: none; box-shadow: none; }

    /* ============ Studio entry: staged build-in ============
       On first load the editor parts are off-screen. As the user picks a pack
       (or skips), each part slides into place in sequence — left rail, then
       top bar, then canvas, then panel + props. */
    .ed-rail, .ed-topbar, .ed-stage, .ed-props, .ed-panel {
      transition:
        transform 0.75s cubic-bezier(.2,.75,.2,1),
        opacity 0.55s ease-out;
    }
    .editor.is-onboarding .ed-rail   { transform: translateX(-110%); opacity: 0; }
    .editor.is-onboarding .ed-topbar { transform: translateY(-100%); opacity: 0; }
    .editor.is-onboarding .ed-stage  { transform: translateX(80px); opacity: 0; }
    .editor.is-onboarding .ed-props  { transform: translateX(80px); opacity: 0; }
    .editor.is-onboarding .ed-panel  { transform: translateX(-40px); opacity: 0; }

    .editor.show-rail  .ed-rail   { transform: none; opacity: 1; }
    .editor.show-top   .ed-topbar { transform: none; opacity: 1; }
    .editor.show-stage .ed-stage  { transform: none; opacity: 1; }
    .editor.show-props .ed-props  { transform: none; opacity: 1; }
    .editor.show-panel .ed-panel  { transform: none; opacity: 1; }

    /* ============ Studio start screen ============
       Branded, single-scroll launcher (customer mode). The real members-area
       header (WorkspaceHeader) sits flush on top; below it a centred column
       scrolls. Matches the dashboard: warm paper ground, white cards, hairline
       borders, 12px corners, wine accent used sparingly. */
    .ed-onboard {
      position: fixed; inset: 0;
      z-index: 200;
      display: flex; flex-direction: column;
      background: var(--paper);
      opacity: 1;
      transition: opacity 0.45s ease-out, transform 0.55s cubic-bezier(.7,0,.3,1);
    }
    .ed-onboard.is-leaving { opacity: 0; transform: translateY(-30px); pointer-events: none; }
    .ed-onboard.is-gone { display: none; }
    /* The hub nav sits at the top of the flex column, on white. */
    .ed-onboard > .ws-nav { flex: 0 0 auto; background: #fff; border-bottom: 1px solid rgba(28,29,34,0.13); }

    /* Scroll region — the fix for "won't scroll / bits cut off". */
    .ed-ob-scroll { flex: 1 1 auto; min-height: 0; overflow-y: auto; padding: clamp(20px, 3vh, 40px) clamp(20px, 5vw, 60px) 88px; }
    .ed-onboard-inner { width: 100%; max-width: 1180px; margin: 0 auto; animation: edOnboardIn 0.6s 0.04s cubic-bezier(.2,.75,.2,1) backwards; }
    @keyframes edOnboardIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
    .ed-ob-view[hidden] { display: none; }

    /* ---- Hero: mirrors the Orders / Bookings .dash-hero exactly ---- */
    .ed-ob-backlink { color: rgba(28,29,34,0.64); text-decoration: none; font-weight: 700; letter-spacing: 0.28em; display: inline-flex; align-items: center; gap: 4px; transition: color 0.2s, transform 0.2s; }
    .ed-ob-backlink:hover { color: var(--english-violet); transform: translateX(-2px); }
    /* Compact headers for the size / pack sub-views (no pill, no italic). */
    .ed-onboard-eyebrow { display: block; font-family: var(--sans); font-size: var(--ws-t-label); letter-spacing: 0.28em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.5); margin-bottom: 8px; }
    .ed-onboard-title { font-family: var(--serif); font-weight: 400; font-size: clamp(26px, 2.4vw, 36px); line-height: 1.05; letter-spacing: -0.02em; color: var(--english-violet); margin: 0 0 8px; }
    .ed-onboard-title em { font-style: normal; color: var(--english-violet); }
    .ed-onboard-sub { font-family: var(--sans); font-style: normal; font-size: var(--ws-t-row); color: rgba(28,29,34,0.64); max-width: 56ch; margin: 0 0 26px; line-height: 1.55; }
    .ed-onboard-loading { font-family: var(--sans); font-size: var(--ws-t-row); color: rgba(28,29,34,0.5); padding: 18px 0; }
    .ed-ob-empty, .ed-onboard-error { font-family: var(--sans); font-size: var(--ws-t-row); color: rgba(28,29,34,0.55); padding: 6px 0 2px; }
    .ed-ob-empty a, .ed-onboard-error a { color: var(--english-violet); text-decoration: underline; }

    /* ---- Cards (dashboard style: bordered image, sans name + meta below) ---- */
    .ed-onboard-card { appearance: none; cursor: pointer; text-align: left; text-decoration: none; background: none; border: 0; padding: 0; display: flex; flex-direction: column; gap: 9px; }
    .ed-onboard-card-cover { aspect-ratio: 4 / 5; border-radius: 12px; background-color: var(--platinum); background-size: cover; background-position: center; border: 1px solid rgba(28,29,34,0.13); transition: transform 0.28s, box-shadow 0.28s; }
    .ed-onboard-card:hover .ed-onboard-card-cover { transform: translateY(-3px); box-shadow: 0 22px 38px -24px rgba(28,29,34,0.42); }
    .ed-onboard-card-body { display: flex; flex-direction: column; gap: 2px; padding: 0; }
    .ed-onboard-card-title { font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 600; letter-spacing: 0; color: var(--ink); margin: 0; line-height: 1.2; }
    .ed-onboard-card-cat { font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 400; letter-spacing: 0; text-transform: none; color: rgba(28,29,34,0.46); }
    /* "Need more packs?" side cell — sits under the owned packs and teases a
       couple the user hasn't bought, linking through to the shop. */
    .ed-onboard-more {
      display: flex;
      align-items: center;
      gap: 24px;
      flex-wrap: wrap;
      padding: 20px 24px;
      margin: 4px 0 36px;
