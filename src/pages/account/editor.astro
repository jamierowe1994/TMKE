---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import AskExpert from "../../components/AskExpert.astro";
import ShopModal from "../../components/ShopModal.astro";
import "../../styles/ws-system.css";
import NewDesignModal from "../../components/account/NewDesignModal.astro";
import CaptionGenerator from "../../components/CaptionGenerator.astro";
import "../../styles/account-sections.css";   // dashboard shell + sidebar chrome for the Studio onboarding
import { templates, packages } from "../../data/library.js";

// Cache-buster for the static editor script. Files in public/ keep the same URL
// forever (unlike Astro's content-hashed bundles), so browsers/CDN serve a stale
// editor.js after a deploy. A fresh build stamp forces the new file each deploy.
const scriptV = Date.now();

const photoLibrary = templates.map((t) => {
  const photo = t.elements.find((e) => e.id === "bg-photo");
  return { id: t.id, name: t.name, src: photo ? photo.src : t.thumb };
});

const templateData = templates.map((t) => ({
  id: t.id,
  name: t.name,
  category: t.category,
  thumb: t.thumb,
  canvas: t.canvas,
  elements: t.elements,
}));

// Stock photo API keys read at SSG/build time, then injected into the inline
// stock-search script via Astro's `define:vars` directive — Astro/Vite only
// substitute `import.meta.env.*` references inside scripts that have at least
// one `import` statement, and our search script doesn't need any.
const PEXELS_KEY = import.meta.env.PUBLIC_PEXELS_API_KEY ?? "";
const UNSPLASH_KEY = import.meta.env.PUBLIC_UNSPLASH_ACCESS_KEY ?? "";

// Curated Google Fonts catalogue (~150 popular families). Each entry's CSS
// gets loaded on-demand when a user picks the font in the editor's font
// picker, so the page doesn't blow its budget at startup.
//   c = category (sans | serif | display | mono | handwriting)
