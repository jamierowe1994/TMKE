---

<BaseLayout
  dashboard
  title="Editor — TMKE"
  description="Edit your purchased templates in the TMKE design studio."
  hideNav={true}
  hideFooter={true}
>
  <!-- =================== ONBOARDING OVERLAY =================== -->
  <!-- Studio entry keeps the dashboard sidebar (left) so it reads as part of the
       account; .dash-shell brings the grid + theme tokens + DashThemePicker. The
       whole overlay is dismissed (.is-gone) once a design opens into the editor. -->
  <script is:inline>
    /* Studio rebuild — the CUSTOMER editor gets the new light skin; the admin
       authoring mode (?mode=admin) keeps its existing look untouched. Set before
       paint so there's no flash. */
    if (!location.search.includes('mode=admin')) document.documentElement.classList.add('editor-light');
    /* The Studio is an application, not a page you scroll. Site-wide smooth
       scrolling hijacks the wheel to animate the document, which left the
       canvas viewport unable to scroll at all once a design was zoomed past
       the window. Set before Lenis initialises so it never starts. */
    document.documentElement.setAttribute('data-no-smooth-scroll', '');
  </script>

  <!-- ============ Your designs ============
       The member's design library, shown when the Studio is opened without a
       design, a template or ?blank. Carries the hub's .ws class so it takes the
       shared system; the editor chrome underneath keeps its own look. -->
  <div class="ed-onboard ws" id="ed-onboard">
    <WorkspaceHeader active="studio" />

  <!-- Selection actions. Sits over the gallery once something is ticked. -->
  <div class="ed-ob-actions" id="ed-ob-actions" hidden>
    <span class="ed-ob-actions-n" id="ed-ob-actions-n">1 selected</span>
    <button type="button" class="ed-ob-act" data-act="duplicate">Duplicate</button>
    <button type="button" class="ed-ob-act" data-act="folder">Add to folder</button>
    <button type="button" class="ed-ob-act" data-act="planner" id="ed-ob-act-planner">Add to planner</button>
    <button type="button" class="ed-ob-act ed-ob-act--bad" data-act="delete">Delete</button>
    <button type="button" class="ed-ob-act ed-ob-act--quiet" data-act="clear">Clear</button>
  </div>


    <div class="ed-ob-scroll" id="ed-ob-scroll">
      <div class="ed-onboard-inner">

        <!-- ===== HOME — choose how to start ===== -->
        <section class="ed-ob-view" id="ed-ob-home">
          <!-- Hero mirrors the Orders / Bookings .dash-hero: eyebrow + title pin
               to the image top, the sub pins to its base. -->
          <section class="ws-hero ws-hero--sub ed-ob-hero">
            <div class="ws-hero-copy">
              <p class="ws-hero-date"><a href="/account/studio" class="ed-ob-backlink" id="ed-onboard-back"><span aria-hidden="true">&larr;</span> Studio</a></p>
              <h1 class="ws-greeting">Your Designs.</h1>
              <p class="ws-hero-sub">Open a design to continue editing, or start something new in the Studio.</p>
              <div class="ed-ob-cta-row">
                <a class="ws-btn ws-btn--primary" href="/account/editor?new=1" data-new-design>Create New Design
                  <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                </a>
              </div>
            </div>
            <div class="ws-hero-photo"></div>
          </section>

          <!-- Not a section of this page any more — Studio's shelf is where you
               browse packs. The markup stays because /account/editor?pack=<id>
               renders the pack list into this grid before opening the pack, and
               it is the "All packs" target when you go back from one. -->
          <section class="ed-ob-sec" id="ed-ob-packs-sec" hidden>
            <div class="ed-ob-sec-head"><h2 class="ed-ob-sec-h">Your packs</h2></div>
            <div class="ed-onboard-loading" id="ed-onboard-loading">Loading your packs…</div>
            <div class="ed-ob-grid ed-onboard-grid" id="ed-onboard-grid" hidden></div>
            <div class="ed-onboard-error ed-ob-empty" id="ed-onboard-error" hidden></div>
          </section>

          <!-- Your saved designs -->
          <section class="ws-block ed-ob-sec" id="ed-ob-designs-sec">
            <header class="ws-block-head">
              <h2 class="ws-block-h"><span class="ws-block-ch">Chapter 01</span>Your designs <span class="ed-ob-count" id="ed-ob-designs-count"></span></h2>
              <div class="ed-ob-tools">
                <label class="ed-ob-search">
                  <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                  <input type="search" id="ed-ob-designs-q" placeholder="Search your designs…" aria-label="Search your designs" />
                </label>
                <select id="ed-ob-sort" aria-label="Sort your designs">
                  <option value="recent">Most recent</option>
                  <option value="name">Name, A–Z</option>
                  <option value="format">Format</option>
                </select>
              </div>
            </header>

            <!-- Folders. A folder exists because a design names it, so this row
                 is built from the designs themselves - see the migration. -->
            <div class="ed-ob-folders" id="ed-ob-folders"></div>
            <p class="ed-ob-noresult" id="ed-ob-designs-noresult" hidden>Nothing matches that.</p>
            <p class="ed-ob-groupless" id="ed-ob-groupless" hidden></p>
            <div class="ed-onboard-loading" id="ed-ob-designs-loading">Loading your designs…</div>
            <div class="ed-ob-grid ed-ob-grid--sm" id="ed-ob-designs-grid" hidden></div>
            <div class="ed-ob-empty" id="ed-ob-designs-empty" hidden></div>
          </section>

          <!-- What else you could be working with. Filled from the live shop by
               loadPackBanner(); the plain CTA below is what shows if there is
               nothing to list. -->
          <section class="ws-block ed-ob-sec" id="ed-ob-shop-sec" hidden>
            <header class="ws-block-head">
              <h2 class="ws-block-h"><span class="ws-block-ch">Chapter 02</span>More to work with</h2>
              <a class="ws-block-link" href="/edit">Browse The Edit
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </header>
            <div class="ws-news" id="ed-ob-shop-grid"></div>
          </section>

          <div class="ed-ob-cta" id="ed-ob-cta">
            <div class="ed-ob-cta-tx">
              <strong>Need something new to work with?</strong>
              <span>Browse The Edit for more design packs and ready-made templates.</span>
            </div>
            <a class="ed-ob-cta-btn" href="/edit" data-shop>Browse The Edit <span class="btn-arrow" aria-hidden="true">&rarr;</span></a>
          </div>
        </section>

        <!-- ===== SIZE — blank canvas format ===== -->
        <!-- ===== PACK DESIGNS (step 2) ===== -->
        <section class="ed-ob-view" id="ed-onboard-step2" hidden>
          <button type="button" class="ed-onboard-back2" id="ed-onboard-back2">
            <span aria-hidden="true">&larr;</span> All packs
          </button>
          <div class="ed-onboard-eyebrow" id="ed-onboard-pack-cat">The pack</div>
          <h1 class="ed-onboard-title" id="ed-onboard-pack-title">Pick a <em>design.</em></h1>
          <p class="ed-onboard-sub" id="ed-onboard-pack-sub">Choose a design from this pack to open in the studio — you can switch to any of the others at any time.</p>
          <div class="ed-onboard-loading" id="ed-onboard-designs-loading" hidden>Loading this pack's designs…</div>
          <div class="ed-ob-grid ed-onboard-grid" id="ed-onboard-design-grid"></div>
          <div class="ed-onboard-error ed-ob-empty" id="ed-onboard-designs-empty" hidden></div>
        </section>

      </div>
    </div>
  </div>

  <div class="editor is-onboarding" id="editor" data-stage="0">
    <!-- =================== TOP BAR =================== -->
    <header class="ed-topbar">
      <div class="ed-topbar-left">
        <a href="/account/studio" class="ed-back" title="Back to the Studio">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </a>
        <a href="/account" class="ed-logo">TMKE<em>Studio</em></a>
        <span class="ed-divider"></span>
        <input id="ed-filename" class="ed-filename" value="Untitled design" />
      </div>

      <div class="ed-topbar-mid">
        <button class="ed-icon-btn" id="ed-undo" title="Undo (Ctrl+Z)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v6h6"/><path d="M3.51 13a9 9 0 1 0 2.13-9.36L3 6"/></svg>
        </button>
        <button class="ed-icon-btn" id="ed-redo" title="Redo (Ctrl+Shift+Z)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 7v6h-6"/><path d="M20.49 13A9 9 0 1 1 18.36 3.64L21 6"/></svg>
        </button>
        <!-- Crop and flip used to sit here. Neither is about the design as a
             whole: they act on whatever is selected, so they belong on the
             element's own toolbar, where Flip now lives. (Crop was never
             implemented - the button only ever said "coming soon", which is
             worse than no button.) -->
        <span class="ed-divider"></span>
        <button class="ed-icon-btn" id="ed-zoom-out" title="Zoom out (-)">−</button>
        <button class="ed-zoom-display" id="ed-zoom-display">100%</button>
        <button class="ed-icon-btn" id="ed-zoom-in" title="Zoom in (+)">+</button>
        <button class="ed-icon-btn ed-fit" id="ed-zoom-fit" title="Fit to screen (0)">Fit</button>
      </div>

      <div class="ed-topbar-right">
        <!-- It looked like a button and did nothing. It is a button now: the
             thing you want when you are reading the format is to change it. -->
        <button type="button" class="ed-canvas-size-pill" id="ed-canvas-size-btn" title="Change the canvas size">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/></svg>
          <span id="ed-canvas-size">1080 × 1440</span>
        </button>
        <button class="ed-btn-ghost" id="ed-save">Save</button>
        <button class="ed-btn-ghost" id="ed-schedule" title="Add this post to your content planner">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          Add
        </button>
        <button class="ed-btn-ghost" id="ed-review-btn" title="Send for review — ask a teammate to check & approve">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
          Review
        </button>
        <!-- Publish — admin only; shown via JS when ?mode=admin. -->
        <button class="ed-btn-ghost" id="ed-regen" hidden title="Re-render every template's preview at full resolution (updates all packs)">Regenerate previews</button>
        <button class="ed-btn-solid" id="ed-publish" hidden>Send to catalogue</button>
        <div class="ed-download" id="ed-download">
          <button class="ed-btn-solid" id="ed-download-trigger" aria-haspopup="menu" aria-expanded="false">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download
            <span class="ed-download-caret" aria-hidden="true">▾</span>
          </button>
          <div class="ed-download-menu" id="ed-download-menu" role="menu" hidden>
            <button class="ed-download-item" data-export="png-transparent" role="menuitem">
              <strong>PNG · transparent</strong>
              <span>Cut-outs &amp; overlays. No background.</span>
            </button>
            <button class="ed-download-item" data-export="png" role="menuitem">
              <strong>PNG</strong>
              <span>Highest quality. With background.</span>
            </button>
            <button class="ed-download-item" data-export="jpg" role="menuitem">
              <strong>JPG</strong>
              <span>Smaller file. With background.</span>
            </button>
            <button class="ed-download-item" data-export="pdf" role="menuitem">
              <strong>PDF</strong>
              <span>Print-ready, single page.</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- =================== LEFT TOOL RAIL =================== -->
    <!-- Admin boot veil. Opening a template from the Design studio used to
         show the empty default canvas, then the design popping in, then the
         fonts swapping as they arrived — three flashes in a second, ugly on a
         screen recording. In admin mode the page is covered in paper from the
         very first paint (the class is set by the inline script below, before
         any of the editor renders) and uncovered only once the requested
         template is loaded, its fonts are ready and a frame has been drawn.
         Falls open on its own after ten seconds so nothing can strand it. -->
    <script is:inline>
      (function () {
        try {
          if (new URLSearchParams(location.search).get("mode") !== "admin") return;
          if (new URLSearchParams(location.search).get("rebuildthumb") === "1") return;
          document.documentElement.classList.add("ed-booting");
          var done = false;
          window.__TMKE_BOOT_DONE__ = function () {
            if (done) return; done = true;
            var v = document.getElementById("ed-veil"), lifted = false;
            var lift = function () {
              if (lifted) return; lifted = true;
              if (v) v.classList.add("is-out");
              setTimeout(function () { document.documentElement.classList.remove("ed-booting"); }, 380);
            };
            // A frame after the render is the ideal moment; a timer covers a
            // tab that isn't visible, where frames don't run.
            requestAnimationFrame(function () { requestAnimationFrame(lift); });
            setTimeout(lift, 120);
          };
          setTimeout(function () { window.__TMKE_BOOT_DONE__(); }, 10000);
        } catch (_) {}
      })();
    </script>
    <div class="ed-veil" id="ed-veil" aria-hidden="true"><span>Opening design&hellip;</span></div>
    <aside class="ed-rail" role="tablist">
      <!-- "Designs" tab removed — users rarely jump between templates
           mid-session, and dropping it gives the rail more breathing room. -->
      <!-- Back to "Choose something to edit". Without it the start panel is
           reachable once and then never again. -->
      <button class="ed-rail-btn" data-tool="start" title="Where to start">
        <span class="ed-rail-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 11l9-8 9 8"/><path d="M5 10v10h14V10"/></svg></span>
        <span>Start</span>
      </button>
      <button class="ed-rail-btn is-active" data-tool="brand" title="Your brand kit">
