---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import HubFootBar from "../../components/account/HubFootBar.astro";
import "../../styles/workspace.css";
import "../../styles/ws-system.css";
import "../../styles/account-sections.css";
---

<!--
  Your Account (Danielle, 11 Nov 2026; agreed on the mock-up,
  docs/your-account/index.html). One page for the member's details, their
  Content Calendar plan, how they pay and what they've ordered. Your Orders
  moved in as the Orders tab and left the top bar (/account/orders now comes
  here). Built on the shared hub system: Your SMM's hero, fact cards and
  table, the Studio's Social / Print switch for the tabs, admin buttons.

  Where the figures come from:
    · Account  the sign-in (name, email, joined) and /access/me (brand)
    · Plan     the Worker's /access/me and /billing/me (level, who pays, the
               upgrade on offer at its real price, the upgrade they have)
    · Billing  /billing/invoices (card on file, Stripe invoices)
    · Orders   the orders table, as Your Orders read it
  Nothing shows until it has loaded: no sample figures.
-->
<BaseLayout title="Your Account · TMKE" description="Your details, your plan, how you pay and everything you've ordered." dashboard hideNav hideFooter>
  <div class="ws">
    <WorkspaceHeader active="account" />
    <main class="ws-main">
      <div class="ws-left">

        <section class="ws-hero ws-hero--sub ya-hero">
          <div class="ws-hero-copy">
            <p class="ws-hero-date"><a href="/account" class="back-link">&larr; Workspace</a></p>
            <h1 class="ws-greeting">Your Account.</h1>
            <p class="ws-hero-sub">Your details, your plan, how you pay and your template packs.</p>
            <div class="ws-hero-cta ya-hero-cta">
              <a class="ws-btn ws-btn--primary" href="/account/settings?tab=plan" data-go-tab="plan">See your plan
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <a class="ws-btn ws-btn--ghost" href="/account/contact">Message us</a>
            </div>
            <ul class="ws-brief ya-brief" id="ya-brief" hidden></ul>
          </div>
          <div class="ws-hero-photo" role="img" aria-label="A styled interior"></div>
        </section>

        <!-- One wrapper, so the hub's entrance (hub-entrance.css animates each
             child of .ws-left) plays once and not again on every tab. -->
        <div class="ya-body">
        <div class="ya-tabs" role="tablist" aria-label="Your Account">
          <button type="button" class="ya-tab" role="tab" data-tab="account" aria-selected="true">Account</button>
          <button type="button" class="ya-tab" role="tab" data-tab="plan" aria-selected="false">Plan</button>
          <button type="button" class="ya-tab" role="tab" data-tab="billing" aria-selected="false">Billing</button>
          <button type="button" class="ya-tab" role="tab" data-tab="orders" aria-selected="false">Template packs</button>
        </div>

        <p class="ya-note" id="ya-flash" hidden></p>

        <!-- ============ ACCOUNT ============ -->
        <div class="ya-panel" data-panel="account">
          <section class="ws-block" aria-labelledby="ya-det-h">
            <header class="ws-block-head"><h2 class="ws-block-h" id="ya-det-h"><span class="ws-block-ch">Chapter 01</span>Your details</h2></header>
            <div class="ya-facts" id="ya-details"><p class="ya-state">Loading your details&hellip;</p></div>
          </section>
          <section class="ws-block" aria-labelledby="ya-pw-h">
            <header class="ws-block-head"><h2 class="ws-block-h" id="ya-pw-h"><span class="ws-block-ch">Chapter 02</span>Password</h2></header>
            <form class="ya-box" id="ya-pw" novalidate>
              <div class="ya-pw">
                <label class="ya-field"><span class="ya-k">New password</span><input id="ya-pw1" type="password" autocomplete="new-password"></label>
                <label class="ya-field"><span class="ya-k">Type it again</span><input id="ya-pw2" type="password" autocomplete="new-password"></label>
                <button class="ws-btn ws-btn--primary" type="submit" id="ya-pw-go">Update password</button>
              </div>
              <p class="ya-small" id="ya-pw-msg">At least 8 characters.</p>
            </form>
          </section>
        </div>

        <!-- ============ PLAN ============ -->
        <div class="ya-panel" data-panel="plan" hidden>
          <!-- A payment that didn't go through, or Scheduling that ended for it
               (Danielle, 11 Nov). Filled by paintAlerts(). -->
          <div class="ya-alert" id="ya-plan-alert" role="status" hidden></div>
          <section class="ws-block" aria-labelledby="ya-plan-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="ya-plan-h"><span class="ws-block-ch">Chapter 01</span>Your plan</h2>
              <span class="ws-block-status" id="ya-plan-status" hidden></span>
            </header>
            <div class="ya-facts" id="ya-plan"><p class="ya-state">Loading your plan&hellip;</p></div>
          </section>
          <!-- Linked accounts for Scheduling (Danielle, 11 Nov): after upgrading
               nothing said they had to link anything. Shows what's linked, links
               and unlinks; the 30-day idle rule unlinks here too and points back. -->
          <section class="ws-block" aria-labelledby="ya-acc-h" id="ya-acc-block" hidden>
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="ya-acc-h"><span class="ws-block-ch">Chapter 02</span>Your social accounts</h2>
              <span class="ws-block-status" id="ya-acc-status" hidden></span>
            </header>
            <div class="ya-facts" id="ya-acc"><p class="ya-state">Loading your accounts&hellip;</p></div>
            <!-- Row 1a (Danielle, 11 Nov; copy by the copywriter): what Facebook
                 and Instagram ask, before they press Link. Shown while anything
                 is still to link. The full guide's button joins it once the
                 guide exists. -->
            <div class="ya-box ya-linknote" id="ya-acc-note" hidden>
              <p class="ya-sum" style="margin:0">Connecting your social accounts</p>
              <p class="ya-blurb">Connect your Facebook and Instagram accounts separately to post or schedule directly from the Studio. Here's how it works.</p>
              <ul class="ya-linklist">
                <li><strong>Facebook:</strong> Sign in with your personal Facebook account, then select the business Page you'd like to connect. You'll need full control of the Page.</li>
                <li><strong>Instagram:</strong> Sign in directly through Instagram using your Business or Creator account. Personal accounts aren't supported.</li>
                <li><strong>Zernio:</strong> We use Zernio to securely connect your social accounts. You may see their name during setup.</li>
                <li><strong>Switching accounts:</strong> If Facebook asks you to switch accounts, select <strong>Continue</strong> to return to your personal account.</li>
              </ul>
              <!-- Asked for only posting and post insights (ZERNIO_MEMBER_SCOPES in the Worker, 11 Nov). -->
              <p class="ya-sum" style="margin-top:18px">What access are you giving us?</p>
              <p class="ya-blurb">Connecting your accounts allows us to publish the posts you choose and see how they perform. We can't access your private messages, reply to comments or manage your advertising.</p>
            </div>
          </section>
          <section class="ws-block" aria-labelledby="ya-up-h" id="ya-up-block" hidden>
            <header class="ws-block-head"><h2 class="ws-block-h" id="ya-up-h"><span class="ws-block-ch" id="ya-up-ch">Chapter 02</span><span id="ya-up-title">Add to your plan</span></h2></header>
            <div class="ya-box" id="ya-up"></div>
          </section>
          <section class="ws-block" aria-labelledby="ya-dfy-h">
            <header class="ws-block-head"><h2 class="ws-block-h" id="ya-dfy-h"><span class="ws-block-ch">Waitlist</span>Done For You, from January</h2></header>
            <div class="ya-box ya-box--quiet ya-dfy">
              <p class="ya-blurb">Ten of the month's posts branded by our team and back in your calendar to approve. Places are limited, so join the waitlist to hear first.</p>
              <a class="ws-btn ws-btn--primary" href="/waitlist/done-for-you">Join the waitlist
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          </section>
        </div>

        <!-- ============ BILLING ============ -->
        <div class="ya-panel" data-panel="billing" hidden>
          <div class="ya-alert" id="ya-pay-alert" role="status" hidden></div>
          <section class="ws-block" aria-labelledby="ya-pay-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="ya-pay-h"><span class="ws-block-ch">Chapter 01</span>Payment</h2>
            </header>
            <div class="ya-facts ya-facts--3" id="ya-pay"><p class="ya-state">Loading&hellip;</p></div>
          </section>
          <section class="ws-block" aria-labelledby="ya-inv-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="ya-inv-h"><span class="ws-block-ch">Chapter 02</span>Invoices</h2>
              <span class="ws-block-status" id="ya-inv-status" hidden></span>
            </header>
            <div id="ya-invoices"><p class="ya-state">Loading&hellip;</p></div>
          </section>
          <p class="ya-foot">Videography invoices are on <a href="/account/bookings">Bookings</a>. Managed social media invoices are on <a href="/account/social">Your SMM</a>.</p>
        </div>

        <!-- ============ ORDERS ============ -->
        <div class="ya-panel" data-panel="orders" hidden>
          <section class="ws-block" aria-labelledby="ya-osum-h">
            <header class="ws-block-head"><h2 class="ws-block-h" id="ya-osum-h"><span class="ws-block-ch">Chapter 01</span>Summary</h2></header>
            <div class="ya-facts ya-facts--3" id="ya-osum"><p class="ya-state">Loading your template packs&hellip;</p></div>
          </section>
          <section class="ws-block" aria-labelledby="ya-olist-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="ya-olist-h"><span class="ws-block-ch">Chapter 02</span>Your template packs</h2>
              <a class="ws-block-link" href="/edit">Browse The Edit
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </header>
            <div id="ya-orders"></div>
          </section>
        </div>
        </div>

      </div>
      <HubFootBar emailSlot />
    </main>
  </div>

  <style is:global>
    /* Hero: Your SMM's arrangement - words across the top, buttons bottom
       left, the three boxes level with them on the right. */
    .ya-hero > .ws-hero-copy { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: clamp(24px, 3vw, 48px); align-items: end; }
    .ya-hero .ws-hero-date, .ya-hero .ws-greeting, .ya-hero .ws-hero-sub { grid-column: 1 / -1; }
    .ya-hero .ya-hero-cta { grid-column: 1; grid-row: 4; align-self: end; display: flex; flex-wrap: wrap; gap: 8px; }
    .ya-hero .ya-brief { grid-column: 2; grid-row: 4; align-self: end; }
    .ya-brief[hidden] { display: none !important; }
    .ya-brief .ws-brief-tx strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px; }
    .ya-brief .ws-brief-ic svg { width: 17px; height: 17px; fill: none; stroke: var(--english-violet); stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
    @media (max-width: 900px) {
      .ya-hero > .ws-hero-copy { grid-template-columns: minmax(0, 1fr); }
      .ya-hero .ya-brief { grid-column: 1; grid-row: 4; margin-top: clamp(18px, 2.4vh, 26px); grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .ya-hero .ya-hero-cta { grid-row: 5; }
    }
    @media (max-width: 620px) { .ya-hero .ya-brief { grid-template-columns: 1fr; } }

    /* Tabs: the Studio's Social / Print pill (.st-kinds). */
    .ya-body { display: flex; flex-direction: column; gap: var(--ws-gap); min-width: 0; }
    .ya-tabs { display: inline-flex; flex-wrap: wrap; gap: 4px; padding: 3px; margin: 0 0 4px; border-radius: 999px; background: rgba(28,29,34,0.05); align-self: flex-start; }
    .ya-tab { appearance: none; border: 0; cursor: pointer; padding: 7px 18px; border-radius: 999px; background: transparent; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ws-faint); transition: background 0.18s, color 0.18s, box-shadow 0.18s; }
    .ya-tab:hover { color: var(--ws-ink); }
    .ya-tab[aria-selected="true"] { background: #fff; color: var(--ws-ink); box-shadow: 0 1px 3px rgba(28,29,34,0.16); }
    .ya-tab:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
    .ya-panel { display: flex; flex-direction: column; gap: clamp(24px, 3vh, 32px); }
    .ya-panel[hidden] { display: none; }

    /* Strip status: Your SMM's. */
    .ya-panel .ws-block-status { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.78); display: inline-flex; align-items: center; gap: 7px; line-height: 14px; }
    .ya-panel .ws-block-status[hidden] { display: none; }
    .ya-panel .ws-block-status::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: var(--stone, #c9bcb7); }

    /* Fact cards: Your SMM's (.soc-pc). Values in Fraunces Light. */
    .ya-facts { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--ws-gap); }
    .ya-facts--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .ya-facts > .ya-state { grid-column: 1 / -1; }
    .ya-fc { display: flex; flex-direction: column; gap: 6px; padding: 15px 18px; background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); min-width: 0; }
    /* The small line sits right of the value on the same line when there's room
       (Dani, 11 Nov), and drops under it when there isn't. */
    .ya-fb { margin-top: auto; display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 4px 12px; min-width: 0; }
    .ya-fb .ya-s { text-align: right; margin-left: auto; }
    .ya-k { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); }
    /* Values in Darker Grotesque; Fraunces Light only for the name, brand and
       date on Account (Dani, 11 Nov: "it just feels too much"). */
    .ya-v { margin: 0; font-family: var(--sans); font-size: clamp(19px, 1.6vw, 22px); font-weight: 500; letter-spacing: -0.01em; color: var(--ws-ink); overflow-wrap: anywhere; line-height: 1.2; }
    [data-panel="account"] .ya-v:not(.ya-v--plain) { font-family: var(--serif); font-size: clamp(20px, 1.8vw, 24px); font-weight: 300; line-height: 1.25; }
    .ya-v--plain { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 500; letter-spacing: 0; display: flex; align-items: center; gap: 7px; min-width: 0; }
    .ya-v--plain span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ya-v--plain svg { flex: none; width: 13px; height: 13px; fill: none; stroke: var(--ws-faint); stroke-width: 1.8; }
    .ya-s { margin: 0; font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--ws-tx); }
    .ya-s a, .ya-link { color: var(--english-violet); font-weight: 600; }
    .ya-link { appearance: none; border: 0; background: none; padding: 0; font: inherit; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; }
    .ya-link:disabled { opacity: .55; cursor: default; }
    @media (max-width: 1100px) { .ya-facts { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 620px) { .ya-facts, .ya-facts--3 { grid-template-columns: 1fr; } }

    .ya-fc--wide { grid-column: span 2; }
    .ya-fc--todo { background: var(--lilac, #eae5e1); border-color: var(--lilac, #eae5e1); }
    /* A payment problem, above everything on Plan and Billing (Danielle, 11 Nov). */
    .ya-alert { background: var(--lilac, #eae5e1); border: 1px solid var(--lilac, #eae5e1); border-radius: var(--ws-r); padding: 22px 26px; margin: 0 0 18px; }
    .ya-alert[hidden] { display: none; }
    .ya-alert .ya-sum { margin: 0; color: var(--english-violet); }
    .ya-alert .ya-blurb { color: var(--english-violet); max-width: 75ch; }
    .ya-fc--todo .ya-s, .ya-fc--todo .ya-v { color: var(--english-violet); }
    .ya-acc-v { display: flex; align-items: center; gap: 10px; min-width: 0; }
    .ya-acc-v img { width: 26px; height: 26px; border-radius: 50%; object-fit: cover; flex: none; }
    .ya-acc-v span { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ya-acc-ic { width: 15px; height: 15px; fill: none; stroke: var(--ws-faint); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; vertical-align: -2px; margin-right: 6px; }
    @media (max-width: 1100px) { .ya-fc--wide { grid-column: 1 / -1; } }
    .ya-box { background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); padding: 24px 26px 22px; min-width: 0; }
    .ya-linknote[hidden] { display: none; }
    .ya-linklist { list-style: none; margin: 12px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 28px; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.45; color: var(--ws-tx); }
    .ya-linklist strong { color: var(--ws-ink); font-weight: 600; }
    @media (max-width: 760px) { .ya-linklist { grid-template-columns: 1fr; } }
    .ya-box--quiet { background: transparent; border-style: dashed; border-color: var(--stone, #c9bcb7); padding: 16px 18px; }
    .ya-strap { margin: 0; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--english-violet); }
    .ya-name { margin: 8px 0 0; font-family: var(--serif); font-size: clamp(24px, 2.2vw, 28px); font-weight: 300; letter-spacing: -0.02em; line-height: 1.1; color: var(--ws-ink); }
    .ya-sum { margin: 10px 0 0; font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 700; color: var(--ws-ink); }
    .ya-blurb { margin: 4px 0 0; font-family: var(--sans); font-size: var(--ws-t-body); color: var(--ws-tx); max-width: 62ch; }
    .ya-box--quiet .ya-blurb { margin: 0; }
    .ya-dfy { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px 24px; }
    .ya-up { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 28px; align-items: end; }
    .ya-inc { list-style: none; padding: 0; margin: 16px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 20px; }
    .ya-inc li { display: flex; gap: 10px; font-family: var(--sans); font-size: var(--ws-t-row); color: var(--ws-ink); }
    .ya-inc li::before { content: ""; flex: none; width: 9px; height: 5px; margin-top: 6px; border-left: 1.6px solid var(--english-violet); border-bottom: 1.6px solid var(--english-violet); transform: rotate(-45deg); }
    .ya-price { display: flex; align-items: baseline; flex-wrap: wrap; gap: 4px 10px; }
    .ya-price b { font-family: var(--sans); font-size: 32px; font-weight: 500; letter-spacing: -0.02em; color: var(--ws-ink); }
    .ya-price span { font-family: var(--sans); font-size: var(--ws-t-row); color: var(--ws-tx); }
    .ya-price s { font-family: var(--sans); font-size: var(--ws-t-row); color: var(--ws-faint); }
    .ya-up .ya-tag { margin-bottom: 8px; }
    .ya-linknote .ya-sum + .ya-blurb { margin-bottom: 0; }
    .ya-tag { display: inline-flex; align-items: center; height: 22px; padding: 0 9px; border-radius: var(--ws-r); background: var(--lilac, #eae5e1); color: var(--english-violet); font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
    .ya-small { margin: 8px 0 0; font-family: var(--sans); font-size: var(--ws-t-body); color: var(--ws-tx); }
    .ya-small.is-bad { color: #8a3f3f; }
    .ya-acts { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }
    .ya-acts[hidden], .ya-confirm[hidden] { display: none; }
    .ya-confirm { margin-top: 14px; background: var(--lilac, #eae5e1); border-radius: var(--ws-r); padding: 14px 16px; display: flex; flex-direction: column; gap: 10px; font-family: var(--sans); font-size: var(--ws-t-row); color: var(--english-violet); }
    .ya-confirm .ya-acts { margin-top: 0; }
    @media (max-width: 1100px) { .ya-up { grid-template-columns: 1fr; } }
    @media (max-width: 620px) { .ya-inc { grid-template-columns: 1fr; } }

    .ya-pw { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)) auto; gap: var(--ws-gap); align-items: end; }
    .ya-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
    .ya-field input { height: 30px; border: 1px solid #e2d9d4; border-radius: var(--ws-r); padding: 0 10px; font-family: var(--sans); font-size: var(--ws-t-row); background: #fff; color: var(--ws-ink); width: 100%; box-sizing: border-box; }
    .ya-field input:focus { outline: none; border-color: var(--english-violet); }
    @media (max-width: 760px) { .ya-pw { grid-template-columns: 1fr; } }

    /* Tables: Your SMM's invoices (.soc-it), in a white box. */
    .ya-tbl { background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); overflow-x: auto; }
    .ya-tbl table { width: 100%; min-width: 620px; border-collapse: collapse; font-family: var(--sans); }
    .ya-tbl th { text-align: left; padding: 13px 18px 10px; font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); border-bottom: 1px solid var(--ws-line); }
    .ya-tbl td { padding: 12px 18px; font-size: var(--ws-t-row); color: var(--ws-ink); border-top: 1px solid var(--ws-line); vertical-align: middle; font-variant-numeric: tabular-nums; }
    .ya-tbl tbody tr:first-child td { border-top: 0; }
    .ya-tbl td.r, .ya-tbl th.r { text-align: right; }
    .ya-tbl .is-muted { color: var(--ws-tx); }

    .ya-state { margin: 0; padding: 16px 18px; font-family: var(--sans); font-size: var(--ws-t-body); color: var(--ws-tx); background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); }
    .ya-note { margin: 0; padding: 12px 16px; border-radius: var(--ws-r); background: var(--lilac, #eae5e1); color: var(--english-violet); font-family: var(--sans); font-size: var(--ws-t-row); }
    .ya-note[hidden] { display: none; }
    .ya-foot { margin: 0; font-family: var(--sans); font-size: var(--ws-t-body); color: var(--ws-tx); }
    .ya-foot a { color: var(--english-violet); font-weight: 600; }
  </style>

  <script>
    import { supabase, gbpFromPence } from '../../lib/supabase.js';
    import { memberAccess, refreshMemberAccess, EDITION_LABEL } from '../../lib/calendar-month.js';
    import { isTrainingDemo } from '../../lib/demo.js';

    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
    const BASE = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');
    const HERE = '/account/settings';
    const gbp2 = (p) => '£' + (Number(p || 0) / 100).toFixed(2);
    const day = (iso) => { try { return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', timeZone: 'Europe/London' }); } catch (_) { return ''; } };
    const dayY = (iso) => { try { return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Europe/London' }); } catch (_) { return ''; } };
    // Stripe's period ends at midnight on the 1st; the member keeps it through the day before.
    const lastDay = (iso) => { try { return day(new Date(new Date(iso).getTime() - 86400000).toISOString()); } catch (_) { return ''; } };
    const monthY = (iso) => { try { return new Date(iso).toLocaleDateString('en-GB', { month: 'long', year: 'numeric', timeZone: 'Europe/London' }); } catch (_) { return ''; } };
    // Label at the top, the value and its small line at the foot (Dani, 11 Nov:
    // "I don't like it when everything is top-heavy in a box").
    const fact = (k, v, s, plain) => `<div class="ya-fc"><span class="ya-k">${k}</span><div class="ya-fb"><p class="ya-v${plain ? ' ya-v--plain' : ''}">${v}</p>${s ? `<p class="ya-s">${s}</p>` : ''}</div></div>`;
    const ARROW = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>';

    let session = null;
    // A fresh sign-in for each request: a page left open past an hour had an
    // expired one, so Update card said "Sign in again" (Danielle, 11 Nov).
    async function freshSession() {
      try { const { data } = await supabase.auth.getSession(); if (data && data.session) session = data.session; } catch (_) {}
      return session;
    }
    async function api(route, opts) {
      await freshSession();
      const res = await fetch(`${BASE}/billing/${route}`, {
        method: opts && opts.body ? 'POST' : 'GET',
        headers: { Authorization: `Bearer ${session.access_token}`, ...(opts && opts.body ? { 'Content-Type': 'application/json' } : {}) },
        body: opts && opts.body ? JSON.stringify(opts.body) : undefined,
      }).catch(() => null);
      const out = res ? await res.json().catch(() => null) : null;
      if (!res || !res.ok || !out || !out.ok) throw new Error((out && out.error) || "We couldn't reach your billing just now. Try again in a moment.");
      return out;
    }

    /* ---------------- tabs ---------------- */
    const TABS = ['account', 'plan', 'billing', 'orders'];
    function show(tab, push) {
      if (!TABS.includes(tab)) tab = 'account';
      document.querySelectorAll('.ya-panel').forEach((p) => { p.hidden = p.dataset.panel !== tab; });
      document.querySelectorAll('.ya-tab').forEach((b) => b.setAttribute('aria-selected', String(b.dataset.tab === tab)));
      if (push) {
        const u = new URL(location.href); u.searchParams.set('tab', tab);
        history.replaceState(null, '', u.pathname + u.search);
      }
    }
    document.querySelectorAll('.ya-tab').forEach((b) => b.addEventListener('click', () => show(b.dataset.tab, true)));
    document.querySelectorAll('[data-go-tab]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); show(a.dataset.goTab, true); }));
    const params = new URLSearchParams(location.search);
    let startTab = params.get('tab');
    try { const back = sessionStorage.getItem('ya-return-tab'); if (back && !startTab) startTab = back; sessionStorage.removeItem('ya-return-tab'); } catch (_) {}
    show(startTab || 'account', !!startTab);

    function flash(msg) { const f = $('ya-flash'); f.textContent = msg; f.hidden = !msg; }

    /* ---------------- brief (the three boxes) ---------------- */
    const IC = {
      plan: '<svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="17" rx="2"/><path d="M3 9h18M8 2v4M16 2v4"/></svg>',
      pay: '<svg viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>',
      ord: '<svg viewBox="0 0 24 24"><path d="M6 2l-2 5v13a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1V7l-2-5z"/><path d="M4 7h16M16 11a4 4 0 0 1-8 0"/></svg>',
    };
    const brief = { plan: null, pay: null, ord: null };
    function paintBrief() {
      if (!brief.plan || !brief.pay || !brief.ord) return;
      const box = (ic, [v, s], tab) => `<li><a class="ws-brief-slot" href="${HERE}?tab=${tab}" data-go-tab="${tab}"><span class="ws-brief-ic">${IC[ic]}</span><span class="ws-brief-tx"><strong>${esc(v)}</strong><span>${esc(s)}</span></span></a></li>`;
      const ul = $('ya-brief');
      ul.innerHTML = box('plan', brief.plan, 'plan') + box('pay', brief.pay, 'billing') + box('ord', brief.ord, 'orders');
      ul.querySelectorAll('[data-go-tab]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); show(a.dataset.goTab, true); }));
      ul.hidden = false;
    }

    /* ---------------- account ---------------- */
    function paintAccount(user, access) {
      const meta = user.user_metadata || {};
      const name = meta.name || meta.full_name || '';
      const brand = access && access.teg && EDITION_LABEL[access.edition] ? EDITION_LABEL[access.edition] : '';
      const lock = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="1.5"/><path d="M8 11V8a4 4 0 0 1 8 0v3"/></svg>';
      const cards = [];
      if (name) cards.push(fact('Name', esc(name)));
      if (brand) cards.push(fact('Brand', esc(brand)));
      if (user.created_at) cards.push(fact('Member since', esc(monthY(user.created_at))));
      cards.push(fact('Email', `${lock}<span>${esc(user.email || '')}</span>`, 'Need it changed? <a href="/account/contact">Message us</a> and we\'ll do it for you.', true));
      $('ya-details').innerHTML = cards.join('');
    }

    $('ya-pw').addEventListener('submit', async (e) => {
      e.preventDefault();
      const a = $('ya-pw1').value, b = $('ya-pw2').value, msg = $('ya-pw-msg'), go = $('ya-pw-go');
      msg.classList.remove('is-bad');
      if (a.length < 8) { msg.textContent = 'Use at least 8 characters.'; msg.classList.add('is-bad'); return; }
      if (a !== b) { msg.textContent = "The two passwords don't match."; msg.classList.add('is-bad'); return; }
      go.disabled = true; msg.textContent = 'Updating…';
      const { error } = await supabase.auth.updateUser({ password: a });
      go.disabled = false;
      if (error) { msg.textContent = `That didn't work: ${error.message}`; msg.classList.add('is-bad'); return; }
      $('ya-pw1').value = ''; $('ya-pw2').value = '';
      msg.textContent = 'Password updated. Use it next time you sign in.';
    });

    /* ---------------- plan ---------------- */
    const LEVEL_NAME = { free: 'Free membership', calendar: 'Content Calendar', scheduling: 'Content Calendar Plus', done_for_you: 'Done For You' };
    function payer(access) {
      if (access.source === 'teg') return EDITION_LABEL[access.edition] || 'Your brand';
      if (access.source === 'staff') return 'TMKE (staff login)';
      if (access.source === 'test') return (EDITION_LABEL[access.edition] ? EDITION_LABEL[access.edition] + ' (test login)' : 'Test login');
      return '';
    }
    function monthsLine(access) {
      const L0 = access.library;
      if (!L0) return 'None yet';
      // The Worker sends whole dates (2026-11-01); compare and show months.
      const L = { from: L0.from ? String(L0.from).slice(0, 7) : null, to: L0.to ? String(L0.to).slice(0, 7) : null };
      const now = new Date(); const ym = (d) => d.toISOString().slice(0, 7);
      const thisM = ym(now); const nextM = ym(new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth() + 1, 1)));
      if (L.from === thisM && L.to === nextM) return 'This month and next';
      if (L.from === thisM && L.to === thisM) return 'This month';
      if (!L.from) return 'Every month';
      return `${monthY(L.from + '-01')} to ${monthY(L.to + '-01')}`;
    }

    let bill = null, access = null;
    function paintPlan() {
      const up = bill && bill.upgrade;
      const vat = bill && bill.vat_rate != null ? Number(bill.vat_rate) : 20;
      const status = $('ya-plan-status');
      const cards = [];
      if (up) {
        const monthly = Math.round(up.price_pence * (1 + vat / 100));
        cards.push(fact('Plan', esc(LEVEL_NAME[up.level] || LEVEL_NAME.scheduling)));
        if (payer(access)) cards.push(fact('Brand', esc(payer(access))));
        // Cancelled (Danielle, 11 Nov): the Scheduling box says so where the eye
        // lands, and Next payment just says nothing's due, so it isn't said twice.
        const ending = up.status === 'cancelling' && up.ends_on;
        // You pay, not Scheduling (Danielle, 11 Nov): from February independents pay
        // for the whole plan, so the box says what comes off the card.
        cards.push(fact('You pay', `${esc(gbpFromPence(up.price_pence))} a month + VAT`, ending ? `Cancelled, ends ${esc(lastDay(up.ends_on))}` : up.launch_offer ? 'Your launch price is locked in.' : 'By card'));
        const due = up.status === 'past_due' ? ((bill && bill.due) || {}) : null;
        cards.push(due
          ? fact('Payment failed', due.amount_pence != null ? esc(gbp2(due.amount_pence)) : 'Due', due.retry_on ? `We try again on ${esc(day(due.retry_on))}` : '')
          : up.renews_on ? fact('Next payment', esc(gbp2(monthly)), `on ${esc(day(up.renews_on))}`) : fact('Next payment', 'Cancelled', 'Nothing due'));
        status.textContent = up.status === 'cancelling' ? `Ends ${lastDay(up.ends_on)}` : up.status === 'past_due' ? 'Payment due' : 'Active';
        status.hidden = false;
        brief.plan = [LEVEL_NAME[up.level] || LEVEL_NAME.scheduling, up.status === 'cancelling' ? `ends ${lastDay(up.ends_on)}` : (payer(access) || 'by card')];
      } else {
        const lvl = access ? access.level : 'free';
        cards.push(fact('Plan', esc(LEVEL_NAME[lvl] || 'Free membership')));
        const who = access ? payer(access) : '';
        if (access && access.calendar) {
          // The brand, not "paid by": it's part of their licence (Dani, 11 Nov).
          cards.push(fact(who ? 'Brand' : 'Paid by', esc(who || 'You')));
          cards.push(fact('Calendar view', esc(monthsLine(access))));
          cards.push(fact('Scheduling', access.scheduling ? 'Included' : 'Not included'));
          status.textContent = 'Active'; status.hidden = false;
        } else {
          cards.push(fact('Includes', 'The Studio and Planner', 'Your packs, your designs, the Marketing Planner and training'));
          status.hidden = true;
        }
        brief.plan = access && access.calendar ? [LEVEL_NAME[lvl], who || 'your plan'] : ['Free membership', 'Studio and Planner'];
      }
      $('ya-plan').innerHTML = cards.join('');
      paintAlerts();
      paintUpgrade();
      loadAccounts();
      paintBrief();
    }

    // Payment due, or Scheduling ended for an unpaid month (copywriter, 11 Nov).
    function paintAlerts() {
      const due = bill && bill.upgrade && bill.upgrade.status === 'past_due' ? (bill.due || {}) : null;
      const ended = !(bill && bill.upgrade) && bill && bill.ended;
      const retry = due && due.retry_on ? new Date(due.retry_on).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/London' }) : 'the next try';
      let html = '';
      if (due) {
        const amount = due.amount_pence != null ? gbp2(due.amount_pence) : 'the payment';
        html = `<p class="ya-sum">Your payment didn't go through</p>
          <p class="ya-blurb">We couldn't take ${esc(amount)} for ${esc(due.month || 'this month')}, so we'll try your card again on ${esc(retry)}. If that payment doesn't go through, Scheduling will end that day, so update your card before then if you need to.</p>
          <div class="ya-acts"><button type="button" class="ws-btn ws-btn--primary" data-card-retry>Try my card again</button><button type="button" class="ws-btn ws-btn--ghost" data-card-go>Update card</button></div>
          <p class="ya-small" data-retry-msg hidden></p>`;
      } else if (ended) {
        html = `<p class="ya-sum">Scheduling has ended</p>
          <p class="ya-blurb">Your last payment didn't go through on either try, so Scheduling ended and your Instagram and Facebook were unlinked. There's nothing to pay, and you can upgrade again whenever you're ready.</p>
          ${bill.offer ? '<div class="ya-acts"><a class="ws-btn ws-btn--primary" href="#ya-up-block" data-go-up>Upgrade to Scheduling</a></div>' : ''}`;
      }
      for (const id of ['ya-plan-alert', 'ya-pay-alert']) {
        const el = $(id);
        // Ended is said on Plan only; Billing has nothing to act on.
        const show = !!html && (id === 'ya-plan-alert' || !!due);
        el.innerHTML = show ? html : ''; el.hidden = !show;
      }
      document.querySelectorAll('.ya-alert [data-card-go]').forEach((b) => b.addEventListener('click', updateCard));
      document.querySelectorAll('.ya-alert [data-card-retry]').forEach((b) => b.addEventListener('click', retryCard));
      document.querySelector('.ya-alert [data-go-up]')?.addEventListener('click', (e) => { e.preventDefault(); $('ya-up-block')?.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    }

    function paintUpgrade() {
      const block = $('ya-up-block'), box = $('ya-up'), up = bill && bill.upgrade, offer = bill && bill.offer;
      if (up) {
        $('ya-up-title').textContent = 'Change your plan';
        if (up.status === 'cancelling') {
          box.innerHTML = `<p class="ya-sum" style="margin:0">Scheduling ends on ${esc(lastDay(up.ends_on))}.</p>
            <p class="ya-blurb">You won't be charged again. Changed your mind? You can keep it.</p>
            <div class="ya-acts"><button type="button" class="ws-btn ws-btn--primary" id="ya-resume">Keep Scheduling</button></div>
            <p class="ya-small" id="ya-up-msg" hidden></p>`;
          $('ya-resume').addEventListener('click', () => change('resume'));
        } else if (up.status === 'past_due') {
          const due = bill.due || {};
          const retry = due.retry_on ? new Date(due.retry_on).toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/London' }) : 'the next try';
          box.innerHTML = `<div id="ya-cx-idle"><p class="ya-sum" style="margin:0">Your payment for ${esc(due.month || 'this month')} is still due.</p>
              <p class="ya-blurb">Try your card again now, or update it and we'll take the payment with the new one straight away. Otherwise we try again on ${esc(retry)}. If you'd rather stop Scheduling, you can cancel it instead: it ends straight away and there's nothing to pay. Your designs and Content Calendar stay as they are.</p>
              <div class="ya-acts"><button type="button" class="ws-btn ws-btn--primary" data-card-retry>Try my card again</button><button type="button" class="ws-btn ws-btn--ghost" data-card-go>Update card</button><button type="button" class="ws-btn ws-btn--ghost" id="ya-cx-go">Cancel Scheduling</button></div>
              <p class="ya-small" data-retry-msg hidden></p></div>
            <div class="ya-confirm" id="ya-cx-confirm" hidden>
              <span><strong>Cancel Scheduling now?</strong> It ends straight away and your Instagram and Facebook are unlinked, so nothing scheduled will post. There's nothing to pay for ${esc(due.month || 'this month')}.</span>
              <div class="ya-acts"><button type="button" class="ws-btn ws-btn--primary" id="ya-cx-yes">Cancel Scheduling</button><button type="button" class="ws-btn ws-btn--ghost" id="ya-cx-no">Keep it</button></div>
            </div>
            <p class="ya-small" id="ya-up-msg" hidden></p>`;
          box.querySelector('[data-card-go]').addEventListener('click', updateCard);
          box.querySelector('[data-card-retry]').addEventListener('click', retryCard);
          $('ya-cx-go').addEventListener('click', () => { $('ya-cx-idle').hidden = true; $('ya-cx-confirm').hidden = false; });
          $('ya-cx-no').addEventListener('click', () => { $('ya-cx-idle').hidden = false; $('ya-cx-confirm').hidden = true; });
          $('ya-cx-yes').addEventListener('click', () => change('cancel'));
        } else {
          box.innerHTML = `<div id="ya-cx-idle"><p class="ya-sum" style="margin:0">Cancel Scheduling at any time.</p>
              <p class="ya-blurb">You keep it to the end of the month you've paid for. Your designs and your Content Calendar stay as they are.</p>
              <div class="ya-acts"><button type="button" class="ws-btn ws-btn--ghost" id="ya-cx-go">Cancel Scheduling</button></div></div>
            <div class="ya-confirm" id="ya-cx-confirm" hidden>
              <span><strong>Cancel Scheduling?</strong> You'll keep it until ${esc(lastDay(up.renews_on))}. After that your Instagram and Facebook disconnect, so anything scheduled later won't post.</span>
              <div class="ya-acts"><button type="button" class="ws-btn ws-btn--primary" id="ya-cx-yes">Cancel Scheduling</button><button type="button" class="ws-btn ws-btn--ghost" id="ya-cx-no">Keep it</button></div>
            </div>
            <p class="ya-small" id="ya-up-msg" hidden></p>`;
          $('ya-cx-go').addEventListener('click', () => { $('ya-cx-idle').hidden = true; $('ya-cx-confirm').hidden = false; });
          $('ya-cx-no').addEventListener('click', () => { $('ya-cx-idle').hidden = false; $('ya-cx-confirm').hidden = true; });
          $('ya-cx-yes').addEventListener('click', () => change('cancel'));
        }
        block.hidden = false;
        return;
      }
      if (!offer) { block.hidden = true; return; }
      $('ya-up-title').textContent = 'Add to your plan';
      const launch = !!offer.launch_offer;
      const month = new Date().toLocaleDateString('en-GB', { month: 'long', timeZone: 'Europe/London' });
      box.innerHTML = `<div class="ya-up">
          <div>
            <p class="ya-strap">Your content, taken care of.</p>
            <p class="ya-name">Scheduling</p>
            <p class="ya-sum">Share and schedule posts straight from the Studio to your Instagram and Facebook accounts.</p>
            <ul class="ya-inc"><li>Your Content Calendar</li><li>Post or schedule straight from the Studio</li><li>Publish to Instagram and Facebook</li><li>Cancel anytime</li></ul>
          </div>
          <div>
            ${launch ? '<span class="ya-tag">Launch Offer</span>' : ''}
            <div class="ya-price"><b>+${esc(gbpFromPence(offer.price_pence))}</b><span>/month + VAT</span></div>
            <p class="ya-small">${esc(gbp2(offer.total_pence))} a month including VAT. Your first payment is taken today, then on the 1st of each month.</p>
            <div class="ya-acts" id="ya-up-acts"><button type="button" class="ws-btn ws-btn--primary" id="ya-up-go">Add Scheduling</button></div>
            <div class="ya-confirm" id="ya-up-confirm" hidden>
              <span><strong>${esc(gbp2(offer.total_pence))} today</strong> for ${esc(month)}, then ${esc(gbp2(offer.total_pence))} on the 1st of each month.</span>
              <div class="ya-acts"><button type="button" class="ws-btn ws-btn--primary" id="ya-up-yes">Continue to payment</button><button type="button" class="ws-btn ws-btn--ghost" id="ya-up-no">Not now</button></div>
            </div>
            <p class="ya-small is-bad" id="ya-up-msg" hidden></p>
          </div>
        </div>`;
      $('ya-up-go').addEventListener('click', () => { $('ya-up-acts').hidden = true; $('ya-up-confirm').hidden = false; });
      $('ya-up-no').addEventListener('click', () => { $('ya-up-acts').hidden = false; $('ya-up-confirm').hidden = true; });
      $('ya-up-yes').addEventListener('click', async () => {
        const btn = $('ya-up-yes'); btn.disabled = true; btn.textContent = 'Opening payment…';
        try {
          const out = await api('upgrade', { body: { level: offer.level, return_to: location.origin + HERE } });
          try { sessionStorage.setItem('ya-return-tab', 'plan'); } catch (_) {}
          location.href = out.url;
        } catch (e) {
          btn.disabled = false; btn.textContent = 'Continue to payment';
          const m = $('ya-up-msg'); m.textContent = e.message; m.hidden = false;
        }
      });
      block.hidden = false;
    }

    async function change(what) {
      const m = $('ya-up-msg');
      document.querySelectorAll('#ya-up button').forEach((b) => { b.disabled = true; });
      const wasDue = !!(bill && bill.upgrade && bill.upgrade.status === 'past_due');
      try {
        await api(what, { body: {} });
        await loadBilling(true);
        flash(what === 'cancel' ? (wasDue ? 'Scheduling has ended. There\'s nothing to pay.' : 'Scheduling is cancelled. It runs to the end of the month you\'ve paid for.') : 'Scheduling is staying on your plan.');
      } catch (e) {
        document.querySelectorAll('#ya-up button').forEach((b) => { b.disabled = false; });
        if (m) { m.textContent = e.message; m.classList.add('is-bad'); m.hidden = false; }
      }
    }

    /* ---------------- linked social accounts ---------------- */
    // Scheduling posts to Instagram and Facebook (the plan's wording).
    // Facebook first (Danielle, 11 Nov): its sign-in is the longer one, through Meta.
    const PLATS = [
      ['facebook', 'Facebook', '<svg class="ya-acc-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.5L17 11h-3V9a.5.5 0 0 1 .5-.5z"/></svg>'],
      ['instagram', 'Instagram', '<svg class="ya-acc-ic" viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.9"/></svg>'],
    ];
    async function schedApi(route, body) {
      await freshSession();
      const res = await fetch(`${BASE}/schedule/${route}`, {
        method: body ? 'POST' : 'GET',
        headers: { Authorization: `Bearer ${session.access_token}`, ...(body ? { 'Content-Type': 'application/json' } : {}) },
        body: body ? JSON.stringify(body) : undefined,
      }).catch(() => null);
      const out = res ? await res.json().catch(() => null) : null;
      if (!res || !res.ok || !out || !out.ok) throw new Error((out && out.error) || "We couldn't reach your social accounts just now. Try again in a moment.");
      return out;
    }
    let accLoading = false;
    async function loadAccounts() {
      const block = $('ya-acc-block'), box = $('ya-acc'), st = $('ya-acc-status');
      const on = !!(access && access.scheduling) || !!(bill && bill.upgrade);
      block.hidden = !on;
      $('ya-up-ch').textContent = on ? 'Chapter 03' : 'Chapter 02';
      if (!on) $('ya-acc-note').hidden = true;
      if (!on || accLoading) return;
      accLoading = true;
      let data = null;
      try { data = await schedApi('status'); } catch (e) { box.innerHTML = `<p class="ya-state">${esc(e.message)}</p>`; accLoading = false; return; }
      accLoading = false;
      if (!data.open || data.configured === false) { box.innerHTML = '<p class="ya-state">We couldn\'t connect your social accounts right now. Please try again later.</p>'; st.hidden = true; return; }
      const mine = (data.accounts || []);
      const linked = PLATS.filter(([k]) => mine.some((a) => a.platform === k)).length;
      st.textContent = linked ? `${linked} connected` : 'Connect your accounts'; st.hidden = false;
      const cards = PLATS.map(([k, name, ic]) => {
        const a = mine.find((x) => x.platform === k);
        if (a) {
          const who = a.username ? (k === 'instagram' && !a.username.startsWith('@') ? '@' + a.username : a.username) : name;
          return `<div class="ya-fc"><span class="ya-k">${ic}${name}</span><div class="ya-fb">
            <p class="ya-v ya-acc-v">${a.picture ? `<img src="${esc(a.picture)}" alt="">` : ''}<span>${esc(who)}</span></p>
            <p class="ya-s" data-acc="${esc(a.id)}" data-name="${name}"><button type="button" class="ya-link" data-unlink>Disconnect</button></p></div></div>`;
        }
        return `<div class="ya-fc"><span class="ya-k">${ic}${name}</span><div class="ya-fb">
          <p class="ya-v">Not connected</p>
          <p class="ya-s"><button type="button" class="ws-btn ws-btn--primary" data-link="${k}">Connect ${name}</button></p></div></div>`;
      });
      cards.push(linked
        ? fact('How it works', 'Publish posts immediately or schedule them for later, straight from the Studio.', "If you don't publish or schedule anything for 30 days, we'll automatically disconnect your accounts. You can reconnect at any time.")
        : `<div class="ya-fc ya-fc--todo"><span class="ya-k">Next step</span><div class="ya-fb"><p class="ya-v">Connect your social accounts</p><p class="ya-s">Connect Instagram or Facebook to publish posts immediately or schedule them for later.</p></div></div>`);
      box.innerHTML = cards.join('');
      box.lastElementChild.classList.add('ya-fc--wide');
      $('ya-acc-note').hidden = linked >= PLATS.length;
      box.querySelectorAll('[data-link]').forEach((b) => b.addEventListener('click', async () => {
        b.disabled = true; b.textContent = 'Connecting…';
        try {
          const out = await schedApi('connect', { platform: b.dataset.link, return_to: HERE });
          location.href = out.authUrl;
        } catch (e) { b.disabled = false; b.textContent = 'Try again'; flash(e.message); }
      }));
      box.querySelectorAll('[data-unlink]').forEach((b) => b.addEventListener('click', () => {
        const line = b.parentElement;
        line.innerHTML = `Disconnect ${esc(line.dataset.name)}? Any posts scheduled to this account will no longer be published. <button type="button" class="ya-link" data-yes>Disconnect</button> · <button type="button" class="ya-link" data-no>Stay connected</button>`;
        line.querySelector('[data-no]').addEventListener('click', () => loadAccounts());
        line.querySelector('[data-yes]').addEventListener('click', async () => {
          line.textContent = 'Disconnecting…';
          try { await schedApi('disconnect', { accountId: line.dataset.acc }); flash(`Your ${line.dataset.name} account has been disconnected. Any scheduled posts for this account will no longer be published.`); }
          catch (e) { flash(e.message); }
          loadAccounts();
        });
      }));
    }

    /* ---------------- billing ---------------- */
    const BRAND = { visa: 'Visa', mastercard: 'Mastercard', amex: 'American Express', discover: 'Discover', diners: 'Diners Club', jcb: 'JCB', unionpay: 'UnionPay' };
    // Stripe's names are written for our books ("TMKE Scheduling upgrade: first
    // payment, November 2026"); the member doesn't need our name on the front
    // or the product's explanation on the end.
    const whatFor = (t) => String(t || '').replace(/^TMKE\s+/, '').replace(/,\s*the difference above.*$/i, '').trim();
    const INV_STATE = { paid: 'Paid', open: 'Due', void: 'Cancelled', uncollectible: 'Unpaid' };
    function paintBilling(inv) {
      const up = bill && bill.upgrade;
      const vat = bill && bill.vat_rate != null ? Number(bill.vat_rate) : 20;
      const card = inv && inv.card;
      const cards = [];
      cards.push(card
        // Update card lives in its box, not on the strip, so every strip is one height (Dani, 11 Nov).
        ? fact('Card on file', `${esc(BRAND[card.brand] || 'Card')} ending ${esc(card.last4)}`, `${card.exp_month ? `Expires ${String(card.exp_month).padStart(2, '0')}/${card.exp_year} · ` : ''}<button type="button" class="ya-link" id="ya-card-go" data-card-go>Update card</button>`)
        : up
          // Subscribed with no card left (removed on Stripe's page): they must be able to add one.
          ? fact('Card on file', 'None', '<button type="button" class="ya-link" id="ya-card-go" data-card-go>Add a card</button>')
          : fact('Card on file', 'None', 'You add one if you upgrade.'));
      if (up && up.status === 'past_due') {
        const due = (bill && bill.due) || {};
        cards.push(fact('Payment failed', due.amount_pence != null ? esc(gbp2(due.amount_pence)) : 'Due', due.retry_on ? `We try again on ${esc(day(due.retry_on))}` : ''));
        brief.pay = ['Payment failed', card ? `${BRAND[card.brand] || 'Card'} ending ${card.last4}` : 'no card on file'];
      } else if (up && up.renews_on) {
        const monthly = Math.round(up.price_pence * (1 + vat / 100));
        cards.push(fact('Next payment', `${esc(gbp2(monthly))} on ${esc(day(up.renews_on))}`, `Scheduling ${esc(gbp2(up.price_pence))} + VAT ${esc(gbp2(monthly - up.price_pence))}`));
        brief.pay = [`${gbp2(monthly)} on ${new Date(up.renews_on).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}`, card ? `${BRAND[card.brand] || 'Card'} ending ${card.last4}` : 'by card'];
      } else {
        cards.push(fact('Next payment', 'Nothing due', up && up.ends_on ? `Scheduling ends on ${esc(lastDay(up.ends_on))}` : ''));
        brief.pay = up && up.status === 'cancelling' ? ['Cancelled', 'nothing to pay'] : ['Nothing to pay', card ? `${BRAND[card.brand] || 'Card'} ending ${card.last4}` : 'no card on file'];
      }
      cards.push(access && access.source === 'teg'
        ? fact('Content Calendar', esc(EDITION_LABEL[access.edition] || 'Your brand'), 'Part of your licence')
        : fact('When you pay', 'The 1st of each month', 'For that calendar month'));
      $('ya-pay').innerHTML = cards.join('');
      $('ya-card-go')?.addEventListener('click', updateCard);

      const list = (inv && inv.invoices) || [];
      const st = $('ya-inv-status');
      if (!list.length) {
        $('ya-invoices').innerHTML = '<p class="ya-state">Your invoices will appear here once you pay for anything by card.</p>';
        st.hidden = true;
      } else {
        st.textContent = list.some((i) => i.status === 'open') ? 'Payment due' : 'All paid'; st.hidden = false;
        $('ya-invoices').innerHTML = `<div class="ya-tbl"><table>
          <thead><tr><th>Invoice</th><th>For</th><th>Amount</th><th>Status</th><th class="r"></th></tr></thead>
          <tbody>${list.map((i) => `<tr>
            <td>${esc(i.number || '—')}</td>
            <td>${esc(whatFor(i.what))}</td>
            <td>${esc(gbp2(i.total_pence))}</td>
            <td class="is-muted">${esc(INV_STATE[i.status] || i.status)}${i.status === 'paid' && (i.paid_at || i.created) ? ' ' + esc(dayY(i.paid_at || i.created)) : ''}</td>
            <td class="r">${i.pdf ? `<a class="ws-btn ws-btn--ghost" href="${esc(i.pdf)}" target="_blank" rel="noopener">Download</a>` : ''}</td>
          </tr>`).join('')}</tbody></table></div>`;
      }
      paintBrief();
    }
    // Try my card again (Danielle, 11 Nov): the payment that's due, on the card
    // already on file, now. Doesn't count as one of the two tries.
    async function retryCard(e) {
      const b = e.currentTarget, msg = b.closest('.ya-alert, #ya-up')?.querySelector('[data-retry-msg]');
      const label = b.textContent;
      b.disabled = true; b.textContent = 'Trying your card…';
      if (msg) msg.hidden = true;
      try {
        await api('retry', { body: {} });
        await loadBilling(true);
        flash("That's gone through. Scheduling carries on as before.");
      } catch (err) {
        b.disabled = false; b.textContent = label;
        if (msg) { msg.textContent = err.message; msg.classList.add('is-bad'); msg.hidden = false; } else flash(err.message);
      }
    }
    async function updateCard(e) {
      const b = (e && e.currentTarget) || $('ya-card-go'); b.disabled = true;
      try {
        const out = await api('card', { body: { return_to: location.origin + HERE } });
        try { sessionStorage.setItem('ya-return-tab', 'billing'); } catch (_) {}
        location.href = out.url;
      } catch (e) { b.disabled = false; flash(e.message); }
    }

    async function loadBilling(fresh) {
      let me = null, inv = null, failed = '';
      // After cancelling or paying, the plan itself has changed: ask again (Danielle, 11 Nov).
      if (fresh) { try { access = (await refreshMemberAccess(supabase)) || access; } catch (_) {} }
      try { me = await api('me'); } catch (e) { failed = e.message; }
      bill = me;
      try { inv = await api('invoices'); } catch (e) { failed = failed || e.message; }
      paintPlan();
      if (inv) paintBilling(inv);
      else {
        $('ya-pay').innerHTML = `<p class="ya-state">${esc(failed || "We couldn't load your billing.")}</p>`;
        $('ya-invoices').innerHTML = '';
        brief.pay = ['Billing', 'see the Billing tab']; paintBrief();
      }
      return me;
    }

    /* ---------------- orders (Your Orders, moved in) ---------------- */
    const METHOD = { apple_pay: 'Apple Pay', google_pay: 'Google Pay', card: 'Card', bank_transfer: 'Bank transfer' };
    const ORDER_STATE = { paid: 'Paid', due: 'Due', sent: 'Due', overdue: 'Overdue', pending: 'Pending', refunded: 'Refunded', cancelled: 'Cancelled' };
    async function loadOrders(user) {
      const { data, error } = await supabase.from('orders')
        .select('id, pack_title, amount_pence, invoice_number, status, payment_method, created_at')
        .or(`user_id.eq.${user.id},buyer_email.ilike.${user.email}`)
        .order('created_at', { ascending: false });
      if (error) {
        $('ya-osum').innerHTML = `<p class="ya-state">Couldn't load your template packs: ${esc(error.message)}</p>`;
        brief.ord = ['Template packs', 'see the tab below']; paintBrief();
        return;
      }
      const list = data || [];
      const spend = list.filter((o) => o.status === 'paid').reduce((t, o) => t + (o.amount_pence || 0), 0);
      $('ya-osum').innerHTML = fact('Template packs', String(list.length)) + fact('Lifetime spend', esc(gbpFromPence(spend) || '£0')) + fact('Last bought', list[0] ? esc(day(list[0].created_at)) : 'None yet');
      brief.ord = list.length ? [`${list.length} template pack${list.length === 1 ? '' : 's'}`, `last bought ${day(list[0].created_at)}`] : ['No template packs', 'yet'];
      paintBrief();
      $('ya-orders').innerHTML = list.length
        ? `<div class="ya-tbl"><table>
            <thead><tr><th>Pack</th><th>Invoice</th><th>Bought</th><th>Amount</th><th>Status</th><th class="r"></th></tr></thead>
            <tbody>${list.map((o) => `<tr>
              <td>${esc(o.pack_title || 'Order')}</td>
              <td class="is-muted">${esc(o.invoice_number || '—')}</td>
              <td class="is-muted">${esc(dayY(o.created_at))}${o.payment_method ? ' · ' + esc(METHOD[o.payment_method] || o.payment_method) : ''}</td>
              <td>${esc(gbpFromPence(o.amount_pence))}</td>
              <td class="is-muted">${esc(ORDER_STATE[o.status] || o.status)}</td>
              <td class="r"><a class="ws-btn ws-btn--ghost" href="/account/orders/receipt?order=${encodeURIComponent(o.id)}">Receipt</a></td>
            </tr>`).join('')}</tbody></table></div>`
        : '<p class="ya-state">No template packs yet. When you buy one from The Edit, its receipt will live here.</p>';
    }

    /* ---------------- start ---------------- */
    (async () => {
      const isDemo = import.meta.env.DEV || isTrainingDemo();
      ({ data: { session } } = await supabase.auth.getSession());
      if (!session) { if (!isDemo) location.replace('/login?next=' + encodeURIComponent(HERE + location.search)); return; }
      const { data: { user }, error } = await supabase.auth.getUser();
      if (!user || error) { if (!isDemo) location.replace('/login?next=' + encodeURIComponent(HERE + location.search)); return; }
      const email = $('footer-email'); if (email) email.textContent = user.email || '';

      access = await memberAccess(supabase);
      paintAccount(user, access);
      loadOrders(user);
      const me = await loadBilling();

      // Back from linking an account.
      const linkedNow = params.get('connected');
      if (linkedNow) {
        const u = new URL(location.href); u.searchParams.delete('connected'); u.searchParams.set('tab', 'plan');
        history.replaceState(null, '', u.pathname + u.search);
        show('plan');
        const nm = (PLATS.find(([k]) => k === linkedNow) || [])[1];
        if (nm) flash(`Your ${nm} account is now connected. You can publish or schedule posts directly from the Studio.`);
      }
      // Back from adding a card (Stripe's card step sets it as the one charged).
      // The new card becomes the one charged, and anything due is paid with it
      // now: people expect that once they've put their card in (Danielle, 11 Nov).
      if (params.get('card') === 'updated') {
        const u = new URL(location.href); u.searchParams.delete('card'); u.searchParams.set('tab', 'billing');
        history.replaceState(null, '', u.pathname + u.search);
        show('billing');
        const due = !!(me && me.upgrade && me.upgrade.status === 'past_due');
        flash(due ? 'Saving your card and taking the payment…' : 'Saving your card…');
        let note = '';
        try {
          const out = await api('card-done', { body: {} });
          note = out.paid ? "Your card is updated and the payment has gone through. Scheduling carries on as before." : "Your card is updated. We'll use it from your next payment.";
        } catch (e) {
          note = due ? `Your card is saved, but the payment didn't go through. ${e.message}` : e.message;
        }
        await loadBilling(true).catch(() => null);
        flash(note);
      }
      // Back from Stripe.
      const done = params.get('upgrade');
      if (done) {
        const u = new URL(location.href); u.searchParams.delete('upgrade'); u.searchParams.set('tab', 'plan');
        history.replaceState(null, '', u.pathname + u.search);
        show('plan');
        if (done === 'cancelled') flash("No payment was taken. You can add Scheduling whenever you're ready.");
        else if (me && me.upgrade) flash("You're all set. Scheduling has been added to your plan.");
        else {
          // Stripe tells us a moment after it takes the payment.
          flash("Payment received. We're getting Scheduling ready for you…");
          for (let i = 0; i < 10; i++) {
            await new Promise((r) => setTimeout(r, 2000));
            const again = await loadBilling().catch(() => null);
            if (again && again.upgrade) { flash("You're all set. Scheduling has been added to your plan."); return; }
          }
          flash("Your payment was successful, but Scheduling is taking a little longer to activate. Try refreshing the page shortly, or get in touch if it doesn't appear.");
        }
      }
    })();
  </script>
</BaseLayout>
