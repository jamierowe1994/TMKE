---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import { GUIDE_TOPICS } from "../../data/guide-topics.js";
---

<!--
  TMKE workspace — Learn (Guides). Editorial rehaul that adopts the new
  top-nav workspace shell from /dashboard. Self-contained on purpose: the
  nav markup + tokens mirror dashboard.astro so the chrome stays consistent
  while this page owns its own `.lrn-*` content. Links are intentionally
  blank (#) placeholders — we'll wire each guide/path/lesson up over time.
-->
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Learn — TMKE workspace"
  description="Practical playbooks and expert guidance to grow your brand on social media — topics, courses, learning paths and quick lessons."
>
  <div class="ws lrn">
    <WorkspaceHeader active="guides" />

    <main class="lrn-main">
      <!-- ============ Hero — full-width header, on-brand R2 image behind ============ -->
      <section class="lrn-hero ws-rise" style="--i:0">
        <div class="lrn-hero-bg" style="background-image:url('https://assets.tmke.co.uk/Smm%20hero.jpg')"></div>
        <div class="lrn-hero-inner">
          <h1 class="lrn-title">Learn. Apply. Grow.</h1>
          <p class="lrn-lede">Practical playbooks and expert guidance to grow your brand on social media.</p>
          <form class="lrn-search" role="search" onsubmit="return false">
            <input type="search" placeholder="What do you want to learn today?" aria-label="Search guides and lessons" />
            <button type="submit" class="lrn-search-btn" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg></button>
          </form>
        </div>
      </section>

      <!-- ============ Explore by topic ============ -->
      <section class="lrn-sec ws-rise" style="--i:1" aria-labelledby="topics-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="topics-h">Explore By Topic</h2>
        </header>
        <div class="lrn-rail">
          <div class="lrn-row" data-rail id="lrn-topics">
            {GUIDE_TOPICS.map((t) => (
              <a class="lrn-topic" href={`?topic=${t.slug}`} data-topic={t.slug}>
                <span class="lrn-topic-ic"><svg viewBox="0 0 24 24" set:html={t.icon}></svg></span>
                <span class="lrn-topic-name" set:html={t.label}></span>
                <span class="lrn-topic-count" data-count={t.slug}>—</span>
              </a>
            ))}
          </div>
          <button type="button" class="lrn-arrow" data-rail-next aria-label="Show more topics"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </section>

      <!-- ============ Guides (real — hydrated from the guides table) ============ -->
      <section class="lrn-sec ws-rise" style="--i:2" aria-labelledby="cont-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="cont-h">Guides</h2>
          <button type="button" class="ws-textlink" id="lrn-clear" hidden>Clear filter ✕</button>
        </header>
        <div class="lrn-guides-grid" id="lrn-guides" aria-busy="true"></div>
        <p class="lrn-guides-empty" id="lrn-guides-empty" hidden>No guides here yet — they'll appear as they're published.</p>
      </section>

      <!-- ============ Featured learning paths (hidden until real paths exist) ============ -->
      <section class="lrn-sec ws-rise lrn-soon" style="--i:3" aria-labelledby="paths-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="paths-h">Featured Learning Paths</h2>
        </header>
        <div class="lrn-paths">
          <a class="lrn-path lrn-path--dark" href="#">
            <div class="lrn-path-body">
              <span class="lrn-path-eyebrow">8 lessons</span>
              <h3 class="lrn-path-title">The Foundation</h3>
              <p class="lrn-path-desc">Everything you need to build a strong, on-brand presence.</p>
              <span class="lrn-path-cta">Start path <em>→</em></span>
            </div>
            <span class="lrn-path-art" style="background-image:url('/assets/home%20forest.jpg')"></span>
          </a>
          <a class="lrn-path" href="#">
            <div class="lrn-path-body">
              <span class="lrn-path-eyebrow">6 lessons</span>
              <h3 class="lrn-path-title">Content That Converts</h3>
              <p class="lrn-path-desc">Create content that attracts, engages and gets results.</p>
              <span class="lrn-path-cta">Start path <em>→</em></span>
            </div>
            <span class="lrn-path-art" style="background-image:url('/assets/home%20window.jpg')"></span>
          </a>
        </div>
        <div class="lrn-dots" aria-hidden="true"><span class="is-on"></span><span></span><span></span></div>
      </section>

      <!-- ============ Quick lessons (hidden until real video lessons exist) ============ -->
      <section class="lrn-sec ws-rise lrn-soon" style="--i:4" aria-labelledby="quick-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="quick-h">Quick Lessons</h2>
          <a class="ws-textlink" href="#">Browse all →</a>
        </header>
        <div class="lrn-rail">
          <div class="lrn-row" data-rail>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/home%20chair.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">4:21</span></span>
              <span class="lrn-clip-title">3 content ideas for today</span>
              <span class="lrn-clip-cat">Idea</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/phone%20me.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">3:17</span></span>
              <span class="lrn-clip-title">Design a post in 10 minutes</span>
              <span class="lrn-clip-cat">Design</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/glasses.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">2:58</span></span>
              <span class="lrn-clip-title">Write captions that sell</span>
              <span class="lrn-clip-cat">Copywriting</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/outside.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">2:42</span></span>
              <span class="lrn-clip-title">Best times to post</span>
              <span class="lrn-clip-cat">Strategy</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/vibes.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">2:35</span></span>
              <span class="lrn-clip-title">Reels that get watched</span>
              <span class="lrn-clip-cat">Video</span>
            </a>
          </div>
          <button type="button" class="lrn-arrow" data-rail-next aria-label="Show more lessons"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </section>

      <!-- ============ New to TMKE ============ -->
      <section class="lrn-onboard ws-rise" style="--i:5" aria-labelledby="onb-h">
        <div class="lrn-onboard-intro">
          <span class="lrn-onboard-star"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5z"/></svg></span>
          <div>
            <h2 class="lrn-onboard-h" id="onb-h">New to TMKE?</h2>
            <p class="lrn-onboard-sub">Start here. These essentials will get you set up for success.</p>
            <a class="ws-btn ws-btn--primary ws-btn--sm" href="#">Start the essentials
              <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
        <ol class="lrn-steps">
          <li class="lrn-step">
            <span class="lrn-step-thumb" style="background-image:url('/assets/home%20ginger.jpg')"></span>
            <span class="lrn-step-no">1</span>
            <span class="lrn-step-text"><strong>Set up your brand kit</strong>Build a recognisable brand in minutes.</span>
          </li>
          <li class="lrn-step">
            <span class="lrn-step-thumb" style="background-image:url('/assets/lay%20down.jpg')"></span>
            <span class="lrn-step-no">2</span>
            <span class="lrn-step-text"><strong>Plan your content</strong>Create consistent content with ease.</span>
          </li>
          <li class="lrn-step">
            <span class="lrn-step-thumb" style="background-image:url('/assets/home%20deer.jpg')"></span>
            <span class="lrn-step-no">3</span>
            <span class="lrn-step-text"><strong>Post with confidence</strong>Know what to post, and when.</span>
          </li>
        </ol>
      </section>
    </main>
  </div>

  <style is:global>
    /* =====================================================================
       Learn (Guides) — adopts the /dashboard workspace shell + tokens, then
       layers an editorial learning library on top. Mirrors dashboard.astro
       for the nav so the chrome stays identical across tabs.
       ===================================================================== */
    body[data-dashboard] { background: var(--ws-bg); }
    .ws {
      --ws-bg: var(--paper, #f4f2f1);
      --ws-card: #ffffff;
      --ws-soft: #fbfaf8;
      --ws-ink: #1c1d22;
      --ws-tx: rgba(28, 29, 34, 0.60);
      --ws-faint: rgba(28, 29, 34, 0.40);
      --ws-line: rgba(28, 29, 34, 0.07);
      --ws-accent: var(--english-violet, #5b4a55);
      --ws-success: #3f9468;
      --ws-r-lg: 4px; --ws-r: 4px; --ws-r-sm: 4px;   /* near-square, matches the dashboard */
      --ws-sh-hero: 0 2px 4px rgba(28,29,34,0.03), 0 34px 64px -34px rgba(28,29,34,0.30), 0 14px 30px -22px rgba(28,29,34,0.20);
      --ws-sh: 0 1px 2px rgba(28,29,34,0.02), 0 18px 40px -30px rgba(28,29,34,0.16);
      --ws-ease: cubic-bezier(.2, .8, .2, 1);
      min-height: 100vh;
      color: var(--ws-ink);
      font-family: var(--sans);
      background:
        radial-gradient(120% 80% at 100% -5%, rgba(91, 74, 85, 0.055), transparent 55%),
        radial-gradient(100% 70% at -5% 105%, rgba(91, 74, 85, 0.045), transparent 52%),
        var(--ws-bg);
    }

    /* ---------- Shared bits reused from the dashboard ---------- */
    .ws-eyebrow { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 0; }
    .ws-textlink { font-size: var(--ws-t-body); font-weight: 600; color: var(--ws-tx); background: none; border: 0; padding: 0; cursor: pointer; font-family: inherit; text-decoration: none; transition: color 0.2s; }
    .ws-textlink:hover { color: var(--ws-ink); }
    .ws-btn { display: inline-flex; align-items: center; gap: 9px; padding: 13px 22px; border-radius: 13px; font-family: inherit; font-size: var(--ws-t-row); font-weight: 600; text-decoration: none; cursor: pointer; border: 1px solid transparent; transition: transform 0.22s var(--ws-ease), box-shadow 0.22s, background 0.2s; }
    .ws-btn svg { width: 15px; height: 15px; }
    .ws-btn--sm { padding: 10px 16px; font-size: var(--ws-t-body); border-radius: 11px; }
    .ws-btn--primary { background: var(--ws-accent); color: #fff; box-shadow: 0 12px 24px -12px color-mix(in srgb, var(--ws-accent) 80%, transparent); }
    .ws-btn--primary:hover { transform: translateY(-2px); box-shadow: 0 18px 32px -12px color-mix(in srgb, var(--ws-accent) 75%, transparent); }
    .ws-btn--primary svg { transition: transform 0.25s var(--ws-ease); }
    .ws-btn--primary:hover svg { transform: translateX(3px); }

    /* ---------- Page shell ---------- */
    .lrn-main {
      max-width: 1500px; margin: 0 auto;
      padding: clamp(20px, 3vh, 38px) clamp(22px, 2.6vw, 56px) 120px;
      display: flex; flex-direction: column; gap: clamp(34px, 4.4vh, 56px);
    }

    /* ---------- Hero — full-width header, on-brand image behind ---------- */
    .lrn-hero { position: relative; isolation: isolate; display: flex; align-items: center; min-height: clamp(320px, 44vh, 470px); border-radius: var(--ws-r-lg); overflow: hidden; box-shadow: var(--ws-sh-hero); }
    .lrn-hero-bg { position: absolute; inset: 0; z-index: -2; background-size: cover; background-position: center 38%; transform: scale(1.02); transition: transform 1.8s var(--ws-ease); }
    .lrn-hero:hover .lrn-hero-bg { transform: scale(1.06); }
    .lrn-hero::after { content: ""; position: absolute; inset: 0; z-index: -1; background: linear-gradient(96deg, rgba(22,15,19,0.9) 0%, rgba(22,15,19,0.66) 34%, rgba(22,15,19,0.28) 62%, rgba(22,15,19,0.04) 100%); }
    .lrn-hero-inner { padding: clamp(28px, 4.4vw, 64px); max-width: 640px; }
    .lrn-title { font-family: var(--serif); font-weight: 500; font-size: clamp(40px, 5.4vw, 72px); line-height: 1.0; letter-spacing: -0.02em; margin: 0; color: #fff; }
    .lrn-lede { font-size: clamp(15px, 1.4vw, 17px); line-height: 1.6; color: rgba(255,255,255,0.84); margin: 18px 0 0; max-width: 42ch; }
    .lrn-search { display: flex; align-items: center; gap: 8px; margin-top: 28px; max-width: 440px; padding: 6px 6px 6px 18px; background: rgba(255,255,255,0.96); border: 1px solid rgba(255,255,255,0.5); border-radius: 999px; box-shadow: 0 18px 40px -20px rgba(0,0,0,0.5); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); transition: box-shadow 0.25s var(--ws-ease); }
    .lrn-search:focus-within { box-shadow: 0 22px 46px -20px rgba(0,0,0,0.55); }
    .lrn-search input { flex: 1; border: 0; outline: 0; background: transparent; font-family: inherit; font-size: var(--ws-t-row); color: var(--ws-ink); min-width: 0; }
    .lrn-search input::placeholder { color: var(--ws-faint); }
    .lrn-search-btn { flex: 0 0 auto; width: 40px; height: 40px; border-radius: 50%; border: 0; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; background: var(--ws-accent); color: #fff; transition: transform 0.2s var(--ws-ease); }
    .lrn-search-btn:hover { transform: translateY(-1px) scale(1.04); }
    .lrn-search-btn svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    @media (max-width: 620px) { .lrn-hero { min-height: 360px; } }

    /* ---------- Section scaffolding ---------- */
    .lrn-sec { display: flex; flex-direction: column; gap: 16px; }
    .lrn-soon { display: none; }   /* mock sections parked until real content exists */

    /* ---------- Real guides grid ---------- */
    .lrn-guides-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(248px, 1fr)); gap: clamp(14px, 1.4vw, 20px); }
    .lrn-guides-empty { font-size: var(--ws-t-row); color: var(--ws-faint); padding: 6px 0; }
    .lrn-gcard { display: flex; flex-direction: column; background: var(--ws-card); border: 1px solid var(--ws-line); border-radius: var(--ws-r-lg); overflow: hidden; text-decoration: none; color: inherit; box-shadow: var(--ws-sh); transition: transform 0.22s var(--ws-ease), box-shadow 0.22s; }
    .lrn-gcard:hover { transform: translateY(-3px); box-shadow: 0 1px 2px rgba(28,29,34,0.02), 0 24px 48px -30px rgba(28,29,34,0.24); }
    .lrn-gcard-art { aspect-ratio: 16 / 10; background-size: cover; background-position: center; background-color: color-mix(in srgb, var(--ws-accent) 14%, #efece9); }
    .lrn-gcard-body { padding: 15px 16px 17px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .lrn-gcard-kind { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-accent); }
    .lrn-gcard-title { font-family: var(--serif); font-weight: 500; font-size: var(--ws-t-title); line-height: 1.2; color: var(--ws-ink); }
    .lrn-gcard-sum { font-size: var(--ws-t-body); line-height: 1.5; color: var(--ws-tx); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .lrn-gcard-meta { margin-top: auto; padding-top: 4px; font-size: var(--ws-t-meta); color: var(--ws-faint); }
    .lrn-gcard-meta.lrn-done { display: inline-flex; align-items: center; gap: 5px; color: var(--ws-success); font-weight: 700; }
    .lrn-gcard-meta.lrn-done svg { width: 13px; height: 13px; }
    .lrn-gcard-prog { margin-top: auto; padding-top: 9px; display: flex; flex-direction: column; gap: 6px; }
    .lrn-gcard-prog-bar { height: 3px; border-radius: 999px; background: var(--ws-line); overflow: hidden; }
    .lrn-gcard-prog-bar i { display: block; height: 100%; background: var(--ws-accent); border-radius: 999px; }
    .lrn-gcard-prog-t { font-size: var(--ws-t-meta); font-weight: 700; letter-spacing: 0.01em; color: var(--ws-accent); }
    .lrn-topic.is-active { border-color: var(--ws-accent); box-shadow: inset 0 0 0 1px var(--ws-accent); }
    .lrn-sec-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; padding: 0 2px; }

    /* Horizontal rails (topics / courses / clips) */
    .lrn-rail { position: relative; }
    .lrn-row { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, 1fr); gap: 14px; overflow-x: auto; scroll-behavior: smooth; scroll-snap-type: x proximity; padding: 4px 2px 6px; margin: -4px -2px -6px; -ms-overflow-style: none; scrollbar-width: none; }
    .lrn-row::-webkit-scrollbar { display: none; }
    .lrn-row > * { scroll-snap-align: start; }
    .lrn-arrow { position: absolute; top: 50%; right: -6px; transform: translateY(-50%); z-index: 5; width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--ws-line); background: var(--ws-card); color: var(--ws-ink); cursor: pointer; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 10px 24px -12px rgba(28,29,34,0.34); transition: transform 0.2s var(--ws-ease), box-shadow 0.2s; }
    .lrn-arrow:hover { transform: translateY(-50%) scale(1.06); box-shadow: 0 14px 28px -12px rgba(28,29,34,0.4); }
    .lrn-arrow svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.9; stroke-linecap: round; stroke-linejoin: round; }
    @media (max-width: 720px) { .lrn-arrow { display: none; } }

    /* Topic cards */
    .lrn-topic { min-width: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; gap: 12px; padding: 22px 14px; border-radius: var(--ws-r-sm); background: var(--ws-card); border: 1px solid var(--ws-line); text-decoration: none; transition: transform 0.24s var(--ws-ease), box-shadow 0.24s, border-color 0.2s; }
    .lrn-topic:hover { transform: translateY(-4px); border-color: transparent; box-shadow: 0 2px 4px rgba(28,29,34,0.04), 0 22px 40px -26px rgba(28,29,34,0.3); }
    .lrn-topic-ic { width: 42px; height: 42px; border-radius: 12px; display: inline-flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--ws-accent) 9%, #fff); color: var(--ws-accent); }
    .lrn-topic-ic svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .lrn-topic-name { font-size: var(--ws-t-body); font-weight: 600; color: var(--ws-ink); line-height: 1.25; }
    .lrn-topic-count { font-size: var(--ws-t-label); color: var(--ws-faint); }

    /* Course cards */
    .lrn-course { min-width: 250px; display: flex; flex-direction: column; text-decoration: none; }
    .lrn-course-art { position: relative; display: block; aspect-ratio: 16 / 10; border-radius: var(--ws-r-sm); background-size: cover; background-position: center; background-color: #e9e6e2; box-shadow: var(--ws-sh); transition: transform 0.28s var(--ws-ease), box-shadow 0.28s; }
    .lrn-course:hover .lrn-course-art { transform: translateY(-4px); box-shadow: 0 2px 4px rgba(28,29,34,0.04), 0 24px 42px -26px rgba(28,29,34,0.34); }
    .lrn-ring { position: absolute; top: 12px; right: 12px; width: 46px; height: 46px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: conic-gradient(var(--ws-accent) calc(var(--p) * 1%), rgba(28,29,34,0.16) 0); box-shadow: 0 4px 10px -4px rgba(28,29,34,0.3); }
    .lrn-ring > span { display: inline-flex; align-items: center; justify-content: center; width: calc(100% - 8px); height: calc(100% - 8px); border-radius: 50%; background: #fff; font-size: var(--ws-t-meta); font-weight: 700; color: var(--ws-ink); }
    .lrn-course-body { display: flex; flex-direction: column; gap: 5px; padding: 14px 2px 0; }
    .lrn-kind { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-faint); }
    .lrn-course-title { font-size: var(--ws-t-row); font-weight: 600; color: var(--ws-ink); line-height: 1.3; }
    .lrn-course-meta { font-size: var(--ws-t-meta); color: var(--ws-faint); }
    .lrn-bar { height: 4px; border-radius: 999px; background: rgba(28,29,34,0.09); overflow: hidden; margin-top: 7px; }
    .lrn-bar-fill { display: block; height: 100%; border-radius: 999px; background: var(--ws-accent); }

    /* Featured learning paths */
    .lrn-paths { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(16px, 1.8vw, 26px); }
    @media (max-width: 860px) { .lrn-paths { grid-template-columns: 1fr; } }
    .lrn-path { position: relative; display: grid; grid-template-columns: 1.05fr 0.95fr; align-items: stretch; min-height: 230px; border-radius: var(--ws-r-lg); overflow: hidden; background: var(--ws-card); box-shadow: var(--ws-sh-hero); text-decoration: none; transition: transform 0.28s var(--ws-ease); }
    .lrn-path:hover { transform: translateY(-4px); }
    .lrn-path-body { padding: clamp(24px, 2.4vw, 36px); display: flex; flex-direction: column; justify-content: center; gap: 9px; }
    .lrn-path-eyebrow { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-faint); }
    .lrn-path-title { font-family: var(--serif); font-weight: 500; font-size: clamp(24px, 2.5vw, 34px); line-height: 1.05; letter-spacing: -0.015em; margin: 0; color: var(--ws-ink); }
    .lrn-path-desc { font-size: var(--ws-t-row); line-height: 1.5; color: var(--ws-tx); margin: 2px 0 0; max-width: 30ch; }
    .lrn-path-cta { margin-top: 16px; align-self: flex-start; display: inline-flex; align-items: center; gap: 8px; padding: 11px 18px; border-radius: 11px; background: var(--ws-accent); color: #fff; font-size: var(--ws-t-body); font-weight: 600; }
    .lrn-path-cta em { font-style: normal; display: inline-block; transition: transform 0.25s var(--ws-ease); }
    .lrn-path:hover .lrn-path-cta em { transform: translateX(4px); }
    .lrn-path-art { background-size: cover; background-position: center; background-color: #e9e6e2; transition: transform 1.2s var(--ws-ease); }
    .lrn-path:hover .lrn-path-art { transform: scale(1.05); }
    /* Dark variant — The Foundation */
    .lrn-path--dark { background: var(--english-violet, #371e28); }
    .lrn-path--dark .lrn-path-eyebrow { color: rgba(255,255,255,0.6); }
    .lrn-path--dark .lrn-path-title { color: #fff; }
    .lrn-path--dark .lrn-path-desc { color: rgba(255,255,255,0.72); }
    .lrn-path--dark .lrn-path-cta { background: #fff; color: var(--english-violet, #371e28); }
    @media (max-width: 620px) { .lrn-path { grid-template-columns: 1fr; } .lrn-path-art { min-height: 150px; order: -1; } }

    .lrn-dots { display: flex; justify-content: center; gap: 7px; margin-top: 4px; }
    .lrn-dots span { width: 7px; height: 7px; border-radius: 50%; background: rgba(28,29,34,0.16); }
    .lrn-dots span.is-on { width: 22px; border-radius: 999px; background: var(--ws-accent); }

    /* Quick lessons */
    .lrn-clip { min-width: 200px; display: flex; flex-direction: column; gap: 9px; text-decoration: none; }
    .lrn-clip-art { position: relative; display: block; aspect-ratio: 4 / 3; border-radius: var(--ws-r-sm); background-size: cover; background-position: center; background-color: #e9e6e2; box-shadow: var(--ws-sh); overflow: hidden; transition: transform 0.28s var(--ws-ease), box-shadow 0.28s; }
    .lrn-clip:hover .lrn-clip-art { transform: translateY(-4px); box-shadow: 0 2px 4px rgba(28,29,34,0.04), 0 24px 42px -26px rgba(28,29,34,0.34); }
    .lrn-clip-art::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(15,12,18,0) 55%, rgba(15,12,18,0.4) 100%); }
    .lrn-clip-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); z-index: 2; width: 44px; height: 44px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.9); color: var(--ws-accent); box-shadow: 0 10px 22px -10px rgba(0,0,0,0.4); transition: transform 0.25s var(--ws-ease); }
    .lrn-clip:hover .lrn-clip-play { transform: translate(-50%, -50%) scale(1.08); }
    .lrn-clip-play svg { width: 18px; height: 18px; fill: currentColor; margin-left: 2px; }
    .lrn-clip-dur { position: absolute; bottom: 9px; right: 9px; z-index: 2; padding: 3px 8px; border-radius: 999px; background: rgba(15,12,18,0.7); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); font-size: var(--ws-t-label); font-weight: 600; color: #fff; }
    .lrn-clip-title { font-size: var(--ws-t-body); font-weight: 600; color: var(--ws-ink); line-height: 1.3; padding: 0 2px; }
    .lrn-clip-cat { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-faint); padding: 0 2px; }

    /* New to TMKE */
    .lrn-onboard { display: grid; grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr); align-items: center; gap: clamp(24px, 3vw, 48px); padding: clamp(24px, 2.6vw, 38px); border-radius: var(--ws-r-lg); background: var(--ws-soft); border: 1px solid var(--ws-line); }
    @media (max-width: 900px) { .lrn-onboard { grid-template-columns: 1fr; } }
    .lrn-onboard-intro { display: flex; align-items: flex-start; gap: 16px; }
    .lrn-onboard-star { flex: 0 0 auto; width: 46px; height: 46px; border-radius: 14px; display: inline-flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--ws-accent) 12%, #fff); color: var(--ws-accent); }
    .lrn-onboard-star svg { width: 24px; height: 24px; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linejoin: round; }
    .lrn-onboard-h { font-family: var(--serif); font-weight: 500; font-size: clamp(20px, 2vw, 26px); letter-spacing: -0.01em; margin: 0; color: var(--ws-ink); }
    .lrn-onboard-sub { font-size: var(--ws-t-body); line-height: 1.5; color: var(--ws-tx); margin: 6px 0 16px; max-width: 30ch; }
    .lrn-steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
    @media (max-width: 620px) { .lrn-steps { grid-template-columns: 1fr; } }
    .lrn-step { position: relative; display: flex; align-items: center; gap: 13px; }
    .lrn-step-thumb { flex: 0 0 auto; width: 52px; height: 52px; border-radius: 6px; background-size: cover; background-position: center; background-color: #e9e6e2; box-shadow: var(--ws-sh); }
    .lrn-step-no { flex: 0 0 auto; position: absolute; left: 40px; top: -6px; width: 22px; height: 22px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-size: var(--ws-t-label); font-weight: 700; color: #fff; background: var(--ws-accent); box-shadow: 0 0 0 2px var(--ws-soft); }
    .lrn-step-text { display: flex; flex-direction: column; gap: 2px; font-size: var(--ws-t-meta); color: var(--ws-tx); line-height: 1.4; }
    .lrn-step-text strong { font-size: var(--ws-t-body); font-weight: 600; color: var(--ws-ink); }

    /* ---------- Entrance ---------- */
    .ws-rise { opacity: 0; transform: translateY(24px); }
    body.ws-ready .ws-rise { animation: wsRise 0.8s var(--ws-ease) both; animation-delay: calc(var(--i) * 0.09s); }
    @keyframes wsRise { to { opacity: 1; transform: none; } }

    /* ---------- Tooltips ---------- */
    [data-tip] { position: relative; }
    [data-tip]::after { content: attr(data-tip); position: absolute; bottom: calc(100% + 9px); left: 50%; transform: translateX(-50%) translateY(4px); width: max-content; max-width: 220px; padding: 9px 12px; border-radius: 10px; background: #1c1d22; color: #fff; font-size: var(--ws-t-meta); font-weight: 500; line-height: 1.4; letter-spacing: 0; text-transform: none; text-align: center; white-space: normal; opacity: 0; pointer-events: none; z-index: 60; box-shadow: 0 12px 28px -10px rgba(0,0,0,0.4); transition: opacity 0.22s var(--ws-ease), transform 0.22s var(--ws-ease); }
    [data-tip]:hover::after { opacity: 1; transform: translateX(-50%) translateY(0); }

    @media (prefers-reduced-motion: reduce) { .ws-rise { opacity: 1 !important; transform: none !important; animation: none !important; } .lrn-row { scroll-behavior: auto; } }
  </style>

  <script>
    requestAnimationFrame(() => document.body.classList.add('ws-ready'));

    // Nav dropdowns + the off-canvas drawer are owned by <WorkspaceHeader>.

    // Horizontal rails — arrow nudges the row along by ~one screenful.
    document.querySelectorAll('[data-rail-next]').forEach((btn) => {
      const row = btn.closest('.lrn-rail')?.querySelector('[data-rail]');
      if (!row) return;
      btn.addEventListener('click', () => {
        const atEnd = row.scrollLeft + row.clientWidth >= row.scrollWidth - 8;
        row.scrollTo({ left: atEnd ? 0 : row.scrollLeft + row.clientWidth * 0.85, behavior: 'smooth' });
      });
    });
  </script>

  <!-- Auth gate + identity + real guides. Customers must be signed in to reach
       Guides; local dev keeps a small sample so the design stays viewable. -->
  <script>
    import { supabase } from "../../lib/supabase.js";
    import { GUIDE_TOPIC_MAP } from "../../data/guide-topics.js";
    const DEV = import.meta.env.DEV;
    const titleCase = (s) => String(s || '').toLowerCase().replace(/\b\w/g, (c) => c.toUpperCase());
    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));

    // Dev-only sample so the grid + counts render without a DB/session.
    const SAMPLE = [
      { slug:'getting-around-your-hub', title:'Getting around your hub', topic:'getting-started', kind:'guide', summary:'A quick tour of your members hub — what each area does, and where to find it.', cover_url:'', lessons:[{}], est_minutes:4 },
      { slug:'setting-up-your-brand-kit', title:'Setting up your brand kit', topic:'getting-started', kind:'guide', summary:'Colours, fonts and logo — set them once and every design looks unmistakably yours.', cover_url:'', lessons:[{},{},{}], est_minutes:6 },
      { slug:'creating-your-first-post', title:'Creating your first post in the Studio', topic:'getting-started', kind:'guide', summary:'From blank canvas to finished post — design something on-brand in minutes.', cover_url:'', lessons:[{},{},{}], est_minutes:7 },
      { slug:'your-first-week-on-social', title:'Your first week on social', topic:'social-intro', kind:'course', summary:'A short, guided walk-through to get you posting with confidence — five quick parts.', cover_url:'', lessons:[{},{},{},{},{}], est_minutes:8 },
    ];

    // svg tick for the "Completed" state
    const TICK = '<svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 13l4 4L19 7"/></svg>';

    const grid = document.getElementById('lrn-guides');
    const emptyEl = document.getElementById('lrn-guides-empty');
    const clearBtn = document.getElementById('lrn-clear');
    let ALL = [];
    let PROGRESS = {};   // guide_slug -> { furthest, total, completed }
    let activeTopic = new URLSearchParams(location.search).get('topic') || '';

    function cardHtml(g) {
      const topic = GUIDE_TOPIC_MAP[g.topic];
      const lessons = Array.isArray(g.lessons) ? g.lessons.length : 0;
      const meta = g.kind === 'course' ? `${lessons} lesson${lessons===1?'':'s'}` : (g.est_minutes ? `~${g.est_minutes} min read` : 'Guide');
      const art = g.cover_url ? `style="background-image:url('${esc(g.cover_url)}')"` : '';

      // Completion state (signed-in members only; empty otherwise).
      const p = PROGRESS[g.slug];
      let href = `/account/guides/read?g=${encodeURIComponent(g.slug)}`;
      let footer;
      if (p && p.completed) {
        footer = `<span class="lrn-gcard-meta lrn-done">${TICK} Completed</span>`;
      } else if (p && g.kind === 'course' && p.total > 0 && p.furthest >= 1) {
        const at = Math.min(p.furthest, p.total);
        const pct = Math.round((at / p.total) * 100);
        href += `&p=${p.furthest}`;
        footer = `<span class="lrn-gcard-prog"><span class="lrn-gcard-prog-bar"><i style="width:${pct}%"></i></span><span class="lrn-gcard-prog-t">Resume · Part ${at} of ${p.total}</span></span>`;
      } else {
        footer = `<span class="lrn-gcard-meta">${meta}</span>`;
      }

      return `<a class="lrn-gcard" href="${href}">
        <span class="lrn-gcard-art" ${art}></span>
        <span class="lrn-gcard-body">
          <span class="lrn-gcard-kind">${g.kind === 'course' ? 'Course' : 'Guide'}${topic ? ' · ' + esc(topic.label) : ''}</span>
          <span class="lrn-gcard-title">${esc(g.title || 'Untitled')}</span>
          ${g.summary ? `<span class="lrn-gcard-sum">${esc(g.summary)}</span>` : ''}
          ${footer}
        </span></a>`;
    }

    function renderGrid(query) {
      let list = ALL.slice();
      if (activeTopic) list = list.filter((g) => g.topic === activeTopic);
      if (query) { const q = query.toLowerCase(); list = list.filter((g) => (g.title||'').toLowerCase().includes(q) || (g.summary||'').toLowerCase().includes(q)); }
      grid.innerHTML = list.map(cardHtml).join('');
      grid.setAttribute('aria-busy', 'false');
      emptyEl.hidden = list.length > 0;
      // topic tile active state + clear button
      document.querySelectorAll('.lrn-topic[data-topic]').forEach((t) => t.classList.toggle('is-active', t.dataset.topic === activeTopic));
      clearBtn.hidden = !activeTopic;
    }

    function hydrateCounts() {
      const counts = {};
      ALL.forEach((g) => { counts[g.topic] = (counts[g.topic] || 0) + 1; });
      document.querySelectorAll('.lrn-topic-count[data-count]').forEach((el) => {
        const n = counts[el.dataset.count] || 0;
        el.textContent = n === 1 ? '1 guide' : `${n} guides`;
      });
    }

    // Topic tiles filter the grid in place (no reload).
    document.querySelectorAll('.lrn-topic[data-topic]').forEach((t) => t.addEventListener('click', (e) => {
      e.preventDefault(); activeTopic = (activeTopic === t.dataset.topic) ? '' : t.dataset.topic;
      const u = new URL(location.href); if (activeTopic) u.searchParams.set('topic', activeTopic); else u.searchParams.delete('topic');
      history.replaceState({}, '', u); renderGrid(document.querySelector('.lrn-search input')?.value || '');
    }));
    clearBtn?.addEventListener('click', () => { activeTopic = ''; const u = new URL(location.href); u.searchParams.delete('topic'); history.replaceState({}, '', u); renderGrid(document.querySelector('.lrn-search input')?.value || ''); });
    document.querySelector('.lrn-search input')?.addEventListener('input', (e) => renderGrid(e.target.value));

    (async () => {
      let session = null;
      try { const { data } = await supabase.auth.getSession(); session = data.session; } catch (_) {}
      if (!session && !DEV) { location.replace('/login?next=' + encodeURIComponent('/account/guides')); return; }
      // getSession() is local-only - a cleared/revoked session can still look
      // valid to it. Confirm with the server before letting anyone in.
      if (session && !DEV) {
        try {
          const { data: { user }, error } = await supabase.auth.getUser();
          if (!user || error) { location.replace('/login?next=' + encodeURIComponent('/account/guides')); return; }
        } catch (_) { location.replace('/login?next=' + encodeURIComponent('/account/guides')); return; }
      }

      if (session) {
        const email = session.user.email ?? '';
        const meta = session.user.user_metadata ?? {};
        const fullName = titleCase(meta.name || email.split('@')[0].replace(/[._]/g, ' '));
        const initials = fullName.split(' ').slice(0, 2).map((w) => w[0]).join('').toUpperCase() || 'T';
        document.querySelectorAll('.ws-whoav').forEach((e) => { e.textContent = initials; });
        const setText = (sel, val) => { const el = document.querySelector(sel); if (el && val) el.textContent = val; };
        setText('.ws-whotext strong', fullName); setText('.ws-whotext span', email);
        setText('.ws-dropdown-head strong', fullName); setText('.ws-dropdown-head span', email);
      }

      try {
        const { data, error } = await supabase.from('guides')
          .select('slug,title,topic,kind,summary,cover_url,lessons,est_minutes')
          .eq('status', 'published').order('sort_order', { ascending: true }).order('created_at', { ascending: false });
        if (error) throw error;
        ALL = (data && data.length) ? data : (DEV ? SAMPLE : []);
      } catch (_) { ALL = DEV ? SAMPLE : []; }

      // Completion state for the signed-in member (RLS returns only their rows).
      if (session) {
        try {
          const { data: pr } = await supabase.from('guide_progress').select('guide_slug,furthest,total,completed');
          (pr || []).forEach((p) => { PROGRESS[p.guide_slug] = p; });
        } catch (_) {}
      } else if (DEV) {
        // Preview both states without a session.
        PROGRESS['getting-around-your-hub'] = { guide_slug:'getting-around-your-hub', completed:true, furthest:1, total:0 };
        PROGRESS['your-first-week-on-social'] = { guide_slug:'your-first-week-on-social', completed:false, furthest:2, total:5 };
      }

      hydrateCounts(); renderGrid('');
    })();
  </script>
</BaseLayout>
