---
import BaseLayout from "../../layouts/BaseLayout.astro";
import GuidesPanel from "../../components/account/GuidesPanel.astro";
import "../../styles/workspace.css";
import "../../styles/account-sections.css";
---

<BaseLayout
  title="Guides — TMKE workspace"
  description="Practical playbooks for the platform — brand kit setup, posting cadence, captions, photography, reels and more."
  hideNav
  hideFooter
>
  <header class="app-header">
    <a href="/account" class="app-logo">TMKE</a>
    <nav class="app-header-nav" aria-label="Workspace">
      <a href="/account" class="app-header-link">Workspace</a>
      <a href="/editor" class="app-header-link">Studio</a>
      <a href="/account/contact" class="app-header-link">Contact</a>
      <a href="/account/services" class="app-header-link">Managed socials</a>
      <a href="/account/guides" class="app-header-link is-active">Guides</a>
      <a href="/account/blog" class="app-header-link">Blog</a>
      <a href="/account/orders" class="app-header-link">Orders</a>
    </nav>
    <button type="button" id="app-signout" class="app-signout">Sign out</button>
  </header>

  <main class="app-main">
    <section class="welcome fade-up" data-delay="1">
      <p class="welcome-eyebrow"><a href="/account" class="back-link">&larr; Workspace</a></p>
    </section>

    <section class="fade-up" data-delay="2">
      <GuidesPanel />
    </section>
  </main>

  <script>
    import { supabase } from "../../lib/supabase.js";
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        location.replace('/login?next=' + encodeURIComponent('/account/guides'));
        return;
      }
      requestAnimationFrame(() => document.body.classList.add('is-loaded'));
      document.getElementById('app-signout')?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        location.replace('/login');
      });
    })();
  </script>
</BaseLayout>
