---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<!--
  TMKE workspace — Learn (Guides). Editorial rehaul that adopts the new
  top-nav workspace shell from /dashboard. Self-contained on purpose: the
  nav markup + tokens mirror dashboard.astro so the chrome stays consistent
  while this page owns its own `.lrn-*` content. Links are intentionally
  blank (#) placeholders — we'll wire each guide/path/lesson up over time.
-->
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Learn — TMKE workspace"
  description="Practical playbooks and expert guidance to grow your brand on social media — topics, courses, learning paths and quick lessons."
>
  <div class="ws lrn">
    <!-- ============ Top navigation (shared shell) ============ -->
    <header class="ws-nav" aria-label="Primary">
      <button type="button" class="ws-burger" data-drawer-open aria-label="Open menu" aria-expanded="false">
        <span></span><span></span><span></span>
      </button>

      <nav class="ws-tabs" aria-label="Sections">
        <a class="ws-tab" href="/dashboard">Dashboard</a>
        <a class="ws-tab" href="/studio">Studio</a>
        <a class="ws-tab" href="/edit">Library</a>
        <a class="ws-tab" href="/account/schedule">Planner</a>
        <a class="ws-tab" href="/account">Analytics</a>
      </nav>

      <div class="ws-nav-right">
        <button type="button" class="ws-circ" data-tip="Search anything"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg><span class="ws-sr">Search</span></button>
        <button type="button" class="ws-circ" data-tip="3 new updates"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.7 21a2 2 0 0 1-3.4 0"/></svg><span class="ws-dot"></span><span class="ws-sr">Notifications</span></button>
        <div class="ws-menu ws-who" data-menu>
          <button type="button" class="ws-whobtn" data-menu-btn aria-expanded="false" aria-haspopup="true">
            <span class="ws-whoav">DC</span>
            <svg class="ws-caret" viewBox="0 0 10 6" aria-hidden="true"><path d="M1 1l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <div class="ws-dropdown ws-dropdown--right" role="menu">
            <div class="ws-dropdown-head"><strong>Danielle Carter</strong><span>danielle@marinaestates.co.uk</span></div>
            <a role="menuitem" href="/profile">Your profile</a>
            <a role="menuitem" href="/profile">Brand Kit</a>
            <a role="menuitem" href="/account/orders">Billing</a>
            <a role="menuitem" href="/login" class="ws-dropdown-out">Sign out</a>
          </div>
        </div>
      </div>
    </header>

    <!-- ============ Off-canvas drawer (everything that isn't a primary tab) ============ -->
    <div class="ws-drawer" data-drawer hidden>
      <div class="ws-drawer-scrim" data-drawer-close></div>
      <aside class="ws-drawer-panel" aria-label="More menu">
        <div class="ws-drawer-top">
          <a class="ws-logo" href="/dashboard">TMKE</a>
          <button type="button" class="ws-circ" data-drawer-close aria-label="Close menu"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button>
        </div>
        <nav class="ws-drawer-nav" aria-label="All sections">
          <span class="ws-drawer-label">Workspace</span>
          <a href="/dashboard">Dashboard</a>
          <a href="/studio">Studio</a>
          <a href="/edit">Library</a>
          <a href="/account/schedule">Planner</a>
          <a href="/account">Analytics</a>

          <span class="ws-drawer-label">Learn</span>
          <a href="/account/guides" class="is-active" aria-current="page">Guides</a>
          <a href="/account/blog">Blog</a>

          <span class="ws-drawer-label">Manage</span>
          <a href="/profile">Brand Kit</a>
          <a href="/account/services">Managed Socials</a>
          <a href="/account/bookings">Bookings</a>
          <a href="/account/orders">Orders &amp; Billing</a>
          <a href="/profile">Settings</a>

          <span class="ws-drawer-label">Help</span>
          <a href="/contact">Contact</a>
          <a href="/contact">Help Centre</a>
        </nav>
        <a class="ws-drawer-out" href="/login">Sign out</a>
      </aside>
    </div>

    <main class="lrn-main">
      <!-- ============ Hero — full-width header, on-brand R2 image behind ============ -->
      <section class="lrn-hero ws-rise" style="--i:0">
        <div class="lrn-hero-bg" style="background-image:url('https://assets.tmke.co.uk/Smm%20hero.jpg')"></div>
        <div class="lrn-hero-inner">
          <h1 class="lrn-title">Learn. Apply. Grow.</h1>
          <p class="lrn-lede">Practical playbooks and expert guidance to grow your brand on social media.</p>
          <form class="lrn-search" role="search" onsubmit="return false">
            <input type="search" placeholder="What do you want to learn today?" aria-label="Search guides and lessons" />
            <button type="submit" class="lrn-search-btn" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg></button>
          </form>
        </div>
      </section>

      <!-- ============ Explore by topic ============ -->
      <section class="lrn-sec ws-rise" style="--i:1" aria-labelledby="topics-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="topics-h">Explore by topic</h2>
        </header>
        <div class="lrn-rail">
          <div class="lrn-row" data-rail>
            <a class="lrn-topic" href="#">
              <span class="lrn-topic-ic"><svg viewBox="0 0 24 24"><path d="M9 18h6M10 21h4M12 3a6 6 0 0 1 4 10.5c-.7.7-1 1.2-1 2.5H9c0-1.3-.3-1.8-1-2.5A6 6 0 0 1 12 3z"/></svg></span>
              <span class="lrn-topic-name">Getting started</span>
              <span class="lrn-topic-count">8 guides</span>
            </a>
            <a class="lrn-topic" href="#">
              <span class="lrn-topic-ic"><svg viewBox="0 0 24 24"><path d="M6 2h9l5 5v15H6z"/><path d="M14 2v6h6M9 13h7M9 17h7"/></svg></span>
              <span class="lrn-topic-name">Content strategy</span>
              <span class="lrn-topic-count">12 guides</span>
            </a>
            <a class="lrn-topic" href="#">
              <span class="lrn-topic-ic"><svg viewBox="0 0 24 24"><path d="M12 3a9 9 0 1 0 0 18c1.4 0 2-1 2-2s-.6-2-1-2.5.4-1.5 1.5-1.5H17a4 4 0 0 0 4-4c0-3.9-4-6-9-6z"/><circle cx="7.5" cy="11" r="1"/><circle cx="11" cy="7.5" r="1"/><circle cx="15.5" cy="8.5" r="1"/></svg></span>
              <span class="lrn-topic-name">Design &amp; branding</span>
              <span class="lrn-topic-count">14 guides</span>
            </a>
            <a class="lrn-topic" href="#">
              <span class="lrn-topic-ic"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="3"/><path d="M10 9l5 3-5 3z"/></svg></span>
              <span class="lrn-topic-name">Reels &amp; video</span>
              <span class="lrn-topic-count">10 guides</span>
            </a>
            <a class="lrn-topic" href="#">
              <span class="lrn-topic-ic"><svg viewBox="0 0 24 24"><path d="M7 11V6a2 2 0 0 1 4 0v5M11 11l1-7a1.5 1.5 0 0 1 3 .3L14.5 11M4 13a8 8 0 0 0 8 8 8 8 0 0 0 8-8c0-1-.7-2-2-2H6c-1.3 0-2 1-2 2z"/></svg></span>
              <span class="lrn-topic-name">Posting &amp; growth</span>
              <span class="lrn-topic-count">10 guides</span>
            </a>
            <a class="lrn-topic" href="#">
              <span class="lrn-topic-ic"><svg viewBox="0 0 24 24"><path d="M4 20V10M10 20V4M16 20v-8M22 20H2"/></svg></span>
              <span class="lrn-topic-name">Analytics</span>
              <span class="lrn-topic-count">8 guides</span>
            </a>
            <a class="lrn-topic" href="#">
              <span class="lrn-topic-ic"><svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-6 6-6s6 2.7 6 6"/><path d="M16 6.5a3 3 0 0 1 0 5.6M18 14c2.3.7 4 2.8 4 5.3"/></svg></span>
              <span class="lrn-topic-name">Client attraction</span>
              <span class="lrn-topic-count">7 guides</span>
            </a>
          </div>
          <button type="button" class="lrn-arrow" data-rail-next aria-label="Show more topics"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </section>

      <!-- ============ Continue learning ============ -->
      <section class="lrn-sec ws-rise" style="--i:2" aria-labelledby="cont-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="cont-h">Continue learning</h2>
          <a class="ws-textlink" href="#">See all →</a>
        </header>
        <div class="lrn-rail">
          <div class="lrn-row" data-rail>
            <a class="lrn-course" href="#">
              <span class="lrn-course-art" style="background-image:url('/assets/cosy%20home.jpg')"><span class="lrn-ring" style="--p:60"><span>60%</span></span></span>
              <span class="lrn-course-body">
                <span class="lrn-kind">Guide</span>
                <span class="lrn-course-title">Setting up your brand kit</span>
                <span class="lrn-course-meta">5 steps left</span>
                <span class="lrn-bar"><span class="lrn-bar-fill" style="width:60%"></span></span>
              </span>
            </a>
            <a class="lrn-course" href="#">
              <span class="lrn-course-art" style="background-image:url('/assets/home%20kitchen.jpg')"><span class="lrn-ring" style="--p:30"><span>30%</span></span></span>
              <span class="lrn-course-body">
                <span class="lrn-kind">Course</span>
                <span class="lrn-course-title">Content that converts</span>
                <span class="lrn-course-meta">3 of 10 lessons</span>
                <span class="lrn-bar"><span class="lrn-bar-fill" style="width:30%"></span></span>
              </span>
            </a>
            <a class="lrn-course" href="#">
              <span class="lrn-course-art" style="background-image:url('/assets/sitting%20chair.jpg')"><span class="lrn-ring" style="--p:75"><span>75%</span></span></span>
              <span class="lrn-course-body">
                <span class="lrn-kind">Course</span>
                <span class="lrn-course-title">Instagram growth playbook</span>
                <span class="lrn-course-meta">6 of 8 lessons</span>
                <span class="lrn-bar"><span class="lrn-bar-fill" style="width:75%"></span></span>
              </span>
            </a>
            <a class="lrn-course" href="#">
              <span class="lrn-course-art" style="background-image:url('/assets/tea.jpg')"><span class="lrn-ring" style="--p:20"><span>20%</span></span></span>
              <span class="lrn-course-body">
                <span class="lrn-kind">Guide</span>
                <span class="lrn-course-title">Captions that connect</span>
                <span class="lrn-course-meta">2 steps left</span>
                <span class="lrn-bar"><span class="lrn-bar-fill" style="width:20%"></span></span>
              </span>
            </a>
          </div>
          <button type="button" class="lrn-arrow" data-rail-next aria-label="Show more"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </section>

      <!-- ============ Featured learning paths ============ -->
      <section class="lrn-sec ws-rise" style="--i:3" aria-labelledby="paths-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="paths-h">Featured learning paths</h2>
        </header>
        <div class="lrn-paths">
          <a class="lrn-path lrn-path--dark" href="#">
            <div class="lrn-path-body">
              <span class="lrn-path-eyebrow">8 lessons</span>
              <h3 class="lrn-path-title">The Foundation</h3>
              <p class="lrn-path-desc">Everything you need to build a strong, on-brand presence.</p>
              <span class="lrn-path-cta">Start path <em>→</em></span>
            </div>
            <span class="lrn-path-art" style="background-image:url('/assets/home%20forest.jpg')"></span>
          </a>
          <a class="lrn-path" href="#">
            <div class="lrn-path-body">
              <span class="lrn-path-eyebrow">6 lessons</span>
              <h3 class="lrn-path-title">Content That Converts</h3>
              <p class="lrn-path-desc">Create content that attracts, engages and gets results.</p>
              <span class="lrn-path-cta">Start path <em>→</em></span>
            </div>
            <span class="lrn-path-art" style="background-image:url('/assets/home%20window.jpg')"></span>
          </a>
        </div>
        <div class="lrn-dots" aria-hidden="true"><span class="is-on"></span><span></span><span></span></div>
      </section>

      <!-- ============ Quick lessons ============ -->
      <section class="lrn-sec ws-rise" style="--i:4" aria-labelledby="quick-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="quick-h">Quick lessons</h2>
          <a class="ws-textlink" href="#">Browse all →</a>
        </header>
        <div class="lrn-rail">
          <div class="lrn-row" data-rail>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/home%20chair.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">4:21</span></span>
              <span class="lrn-clip-title">3 content ideas for today</span>
              <span class="lrn-clip-cat">Idea</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/phone%20me.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">3:17</span></span>
              <span class="lrn-clip-title">Design a post in 10 minutes</span>
              <span class="lrn-clip-cat">Design</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/glasses.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">2:58</span></span>
              <span class="lrn-clip-title">Write captions that sell</span>
              <span class="lrn-clip-cat">Copywriting</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/outside.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">2:42</span></span>
              <span class="lrn-clip-title">Best times to post</span>
              <span class="lrn-clip-cat">Strategy</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/vibes.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">2:35</span></span>
              <span class="lrn-clip-title">Reels that get watched</span>
              <span class="lrn-clip-cat">Video</span>
            </a>
          </div>
          <button type="button" class="lrn-arrow" data-rail-next aria-label="Show more lessons"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </section>

      <!-- ============ New to TMKE ============ -->
      <section class="lrn-onboard ws-rise" style="--i:5" aria-labelledby="onb-h">
        <div class="lrn-onboard-intro">
          <span class="lrn-onboard-star"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l2.5 5.5L20 9l-4 4 1 6-5-3-5 3 1-6-4-4 5.5-.5z"/></svg></span>
          <div>
            <h2 class="lrn-onboard-h" id="onb-h">New to TMKE?</h2>
            <p class="lrn-onboard-sub">Start here. These essentials will get you set up for success.</p>
            <a class="ws-btn ws-btn--primary ws-btn--sm" href="#">Start the essentials
              <svg viewBox="0 0 16 16"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>
        </div>
        <ol class="lrn-steps">
          <li class="lrn-step">
            <span class="lrn-step-thumb" style="background-image:url('/assets/home%20ginger.jpg')"></span>
            <span class="lrn-step-no">1</span>
            <span class="lrn-step-text"><strong>Set up your brand kit</strong>Build a recognisable brand in minutes.</span>
          </li>
          <li class="lrn-step">
            <span class="lrn-step-thumb" style="background-image:url('/assets/lay%20down.jpg')"></span>
            <span class="lrn-step-no">2</span>
            <span class="lrn-step-text"><strong>Plan your content</strong>Create consistent content with ease.</span>
          </li>
          <li class="lrn-step">
            <span class="lrn-step-thumb" style="background-image:url('/assets/home%20deer.jpg')"></span>
            <span class="lrn-step-no">3</span>
            <span class="lrn-step-text"><strong>Post with confidence</strong>Know what to post, and when.</span>
          </li>
        </ol>
      </section>
    </main>
  </div>

  <style is:global>
    /* =====================================================================
       Learn (Guides) — adopts the /dashboard workspace shell + tokens, then
       layers an editorial learning library on top. Mirrors dashboard.astro
       for the nav so the chrome stays identical across tabs.
       ===================================================================== */
    body[data-dashboard] { background: var(--ws-bg); }
    .ws {
      --ws-bg: #f5f4f1;
      --ws-card: #ffffff;
      --ws-soft: #fbfaf8;
      --ws-ink: #1c1d22;
      --ws-tx: rgba(28, 29, 34, 0.60);
      --ws-faint: rgba(28, 29, 34, 0.40);
      --ws-line: rgba(28, 29, 34, 0.07);
      --ws-accent: var(--english-violet, #5b4a55);
      --ws-success: #3f9468;
      --ws-r-lg: 26px; --ws-r: 20px; --ws-r-sm: 14px;
      --ws-sh-hero: 0 2px 4px rgba(28,29,34,0.03), 0 34px 64px -34px rgba(28,29,34,0.30), 0 14px 30px -22px rgba(28,29,34,0.20);
      --ws-sh: 0 1px 2px rgba(28,29,34,0.02), 0 18px 40px -30px rgba(28,29,34,0.16);
      --ws-ease: cubic-bezier(.2, .8, .2, 1);
      min-height: 100vh;
      color: var(--ws-ink);
      font-family: var(--sans);
      background:
        radial-gradient(120% 80% at 100% -5%, rgba(91, 74, 85, 0.055), transparent 55%),
        radial-gradient(100% 70% at -5% 105%, rgba(91, 74, 85, 0.045), transparent 52%),
        var(--ws-bg);
    }

    /* ---------- Navigation (identical to /dashboard) ---------- */
    .ws-nav {
      position: sticky; top: 0; z-index: 40;
      display: flex; align-items: center; gap: clamp(12px, 2vw, 28px);
      padding: 14px clamp(22px, 2.6vw, 56px);
      background: color-mix(in srgb, var(--ws-bg) 78%, transparent);
      -webkit-backdrop-filter: saturate(1.1) blur(14px); backdrop-filter: saturate(1.1) blur(14px);
    }
    .ws-brand { display: flex; align-items: center; gap: 14px; flex: 0 0 auto; }
    .ws-logo { font-family: var(--serif); font-size: 20px; font-weight: 600; letter-spacing: 0.05em; color: var(--ws-ink); text-decoration: none; }
    .ws-whobtn { display: inline-flex; align-items: center; gap: 10px; padding: 5px 12px 5px 5px; border: 0; border-radius: 999px; background: transparent; cursor: pointer; font-family: inherit; transition: background 0.2s; }
    .ws-whobtn:hover { background: rgba(28, 29, 34, 0.05); }
    .ws-whoav { width: 34px; height: 34px; border-radius: 50%; flex: 0 0 auto; display: inline-flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: #fff; background: linear-gradient(140deg, color-mix(in srgb, var(--ws-accent) 70%, #fff), var(--ws-accent)); background-size: cover; background-position: center; }
    .ws-whotext { display: flex; flex-direction: column; line-height: 1.2; text-align: left; }
    .ws-whotext strong { font-size: 13px; font-weight: 600; color: var(--ws-ink); }
    .ws-whotext span { font-size: 11px; color: var(--ws-faint); }
    @media (max-width: 980px) { .ws-whotext { display: none; } }

    .ws-tabs { flex: 1; display: flex; align-items: center; justify-content: center; gap: 3px; flex-wrap: wrap; }
    .ws-tab { display: inline-flex; align-items: center; gap: 6px; padding: 8px 15px; border-radius: 999px; font-size: 13.5px; font-weight: 500; color: var(--ws-tx); text-decoration: none; border: 0; background: transparent; cursor: pointer; font-family: inherit; transition: color 0.2s, background 0.2s, box-shadow 0.2s, transform 0.2s var(--ws-ease); }
    .ws-tab:hover { color: var(--ws-ink); background: rgba(28, 29, 34, 0.05); }
    .ws-tab.is-active { color: var(--ws-ink); font-weight: 600; background: var(--ws-card); box-shadow: 0 1px 2px rgba(28,29,34,0.04), 0 6px 16px -10px rgba(28,29,34,0.2); }
    .ws-caret { width: 9px; height: 6px; opacity: 0.55; transition: transform 0.25s var(--ws-ease); }

    .ws-nav-right { flex: 0 0 auto; display: flex; align-items: center; gap: 8px; }
    .ws-circ { position: relative; width: 40px; height: 40px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: color-mix(in srgb, var(--ws-card) 70%, transparent); border: 1px solid var(--ws-line); cursor: pointer; color: var(--ws-tx); transition: transform 0.2s var(--ws-ease), box-shadow 0.2s, color 0.2s, background 0.2s; }
    .ws-circ:hover { transform: translateY(-2px); color: var(--ws-ink); background: var(--ws-card); box-shadow: 0 9px 20px -10px rgba(28,29,34,0.3); }
    .ws-circ svg { width: 17px; height: 17px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
    .ws-dot { position: absolute; top: 9px; right: 10px; width: 7px; height: 7px; border-radius: 50%; background: var(--ws-accent); box-shadow: 0 0 0 2px var(--ws-bg); }
    .ws-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

    .ws-menu { position: relative; }
