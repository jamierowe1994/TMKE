---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DashSidebar from "../../components/account/DashSidebar.astro";
import GuidesPanel from "../../components/account/GuidesPanel.astro";
import "../../styles/workspace.css";
import "../../styles/account-sections.css";
---

<BaseLayout
  dashboard
  title="Guides — TMKE workspace"
  description="Practical playbooks for the platform — brand kit setup, posting cadence, captions, photography, reels and more."
  hideNav
  hideFooter
>
  <div class="dash-shell">
    <DashSidebar active="guides" />

    <main class="app-main dash-main">
      <GuidesPanel />
    </main>
  </div>

  <script>
    import { supabase } from "../../lib/supabase.js";
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        location.replace('/login?next=' + encodeURIComponent('/account/guides'));
        return;
      }
      requestAnimationFrame(() => document.body.classList.add('is-loaded'));
      document.getElementById('app-signout')?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        location.replace('/login');
      });
    })();
  </script>
</BaseLayout>
