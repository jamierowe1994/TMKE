---
// The header photograph (Dani, 7 Sep): 3600×620 in the assets bucket, served
// as WebP. Same banner as the Brand kit page — the two are meant to match.
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import HubFootBar from "../../components/account/HubFootBar.astro";
import { GUIDE_TOPICS } from "../../data/guide-topics.js";
import StudioInspo from "../../components/account/StudioInspo.astro";
import { WHATS_NEW } from "../../data/whats-new.js";
// The first of the Latest, always: What's New in the hub (Dani, 17 Oct).
const HUB_NEWS_ART = (WHATS_NEW[0] && WHATS_NEW[0].media) || "";
import { TRENDING_SAMPLE, monthLabel } from "../../data/trending-sample.js";

/* A cover of its own for "This Month". It used to borrow the first topic's
   media, which is a phone-shaped screenshot being cropped into a 300px-wide
   column — hence the sliced collage. Set this and it wins over the topic
   media, at build time and at runtime; leave it empty and nothing changes.
   Dani, 8 Oct. */
const MONTH_COVER = "https://assets.tmke.co.uk/TMKE%20Member%20Hub/TMKE_trending_content_1800x1000.png";
import "../../styles/learn.css";
import "../../styles/reel.css";
---

<!--
  TMKE workspace — Learn (Guides). Editorial rehaul that adopts the new
  top-nav workspace shell from /dashboard. Self-contained on purpose: the
  nav markup + tokens mirror dashboard.astro so the chrome stays consistent
  while this page owns its own `.lrn-*` content. Links are intentionally
  blank (#) placeholders — we'll wire each guide/path/lesson up over time.
-->
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Training Studio — TMKE workspace"
  description="Practical playbooks and expert guidance to grow your brand on social media — topics, courses, learning paths and quick lessons."
>
  <div class="ws lrn">
    <WorkspaceHeader active="guides" />

    <main class="lrn-main">
      <!-- ============ Hero — full-width header, on-brand R2 image behind ============ -->
      <section class="lrn-hero ws-rise" style="--i:0">
        <div class="lrn-hero-inner">
          <p class="lrn-eyebrow"><a href="/account">&larr; Workspace</a></p>
          <h1 class="lrn-title">The Training Studio.</h1>
          <p class="lrn-lede">Practical playbooks and expert guidance to grow your brand on social media.</p>
          <form class="lrn-search" role="search" onsubmit="return false">
            <input type="search" placeholder="What do you want to learn today?" aria-label="Search guides and lessons" />
            <button type="submit" class="lrn-search-btn" aria-label="Search"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.5" y2="16.5"/></svg></button>
          </form>
        </div>
      </section>

      <!-- ============ Explore by topic ============
           Buttons in the dashboard's Explore style (Dani, 17 Oct); each opens
           a pop-out of every guide and course in that topic. -->
      <section class="lrn-sec ws-rise" style="--i:1" aria-labelledby="topics-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="topics-h">Explore By Topic</h2>
        </header>
        <nav class="lrn-topic-pills" id="lrn-topics" aria-label="Topics">
          {GUIDE_TOPICS.map((t) => (
            <a class="lrn-topic" href={`?topic=${t.slug}`} data-topic={t.slug}><span set:html={t.label}></span> <span class="lrn-topic-count" data-count={t.slug}></span></a>
          ))}
        </nav>
      </section>

      <!-- ============ Getting Started ============
           The dashboard's Your Studio doors (Dani, 17 Oct): a picture card
           with the title first, then a card per course; a course's picture
           covers its card on hover. Drawn by renderTraining(). -->
      <section class="lrn-sec ws-rise" style="--i:2" aria-labelledby="training-h" id="training">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="training-h">Getting Started</h2>
        </header>
        <div class="lrn-doors" style="--cols:5">
          <a class="lrn-door lrn-door--title" href="/account/guides/read?g=training-hub">
            <span class="lrn-door-pic" style="background-image:url('/images/dashboard/door-create-v1.webp')"></span>
            <span class="lrn-door-tx"><strong>Getting Started</strong><span>Four short courses to find your way round the hub and make your first post.</span></span>
          </a>
          <div class="lrn-doors-fill" id="lrn-training" aria-busy="true"></div>
        </div>
      </section>

      <!-- ============ This month: See what's working ============
           The dashboard's Be inspired (Dani, 17 Oct): the month's five formats
           going by, each with its title above, and one box with the month's
           words beside them. Any of it opens the month (StudioInspo). -->
      <section class="lrn-sec ws-rise" style="--i:3" aria-labelledby="month-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="month-h">This Month</h2>
        </header>
        <div class="lrn-month">
          <div class="ws-reel lrn-month-reel" id="lrn-month-reel" aria-label="This month's formats" aria-busy="true"><div class="ws-reel-track"></div></div>
          <button type="button" class="lrn-month-box" data-inspo="trending">
            <span class="lrn-month-eyebrow">See what&rsquo;s working &middot; <span id="lrn-month-name">{monthLabel(TRENDING_SAMPLE.month)}</span></span>
            <strong class="lrn-month-title" id="lrn-month-title">{TRENDING_SAMPLE.intro}</strong>
            <span class="lrn-month-sub">Five formats pulling reach for agents right now: what each is, why it works, and how to use it. Updated monthly.</span>
            <span class="lrn-month-cta">Open this month <em aria-hidden="true">&rarr;</em></span>
          </button>
        </div>
      </section>

      <!-- ============ New to the Training Studio ============
           The dashboard's Explore and Latest (Dani, 17 Oct): the topics on the
           left, the three newest courses and guides on the right as portrait
           cards. Everything else is a topic away, in its pop-out. -->
      <section class="lrn-sec ws-rise" style="--i:4" aria-labelledby="cont-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="cont-h">New to the Training Studio</h2>
          <button type="button" class="ws-textlink" id="lrn-all">Every guide &rarr;</button>
        </header>
        <div class="lrn-wn">
          <div>
            <p class="lrn-wn-label">Explore</p>
            <nav class="lrn-topic-pills" aria-label="Topics">
              {GUIDE_TOPICS.map((t) => (
                <a class="lrn-topic" href={`?topic=${t.slug}`} data-topic={t.slug}><span set:html={t.label}></span> <span class="lrn-topic-count" data-count={t.slug}></span></a>
              ))}
            </nav>
          </div>
          <div>
            <p class="lrn-wn-label">Latest</p>
            <div class="lrn-cards lrn-cards--3" id="lrn-latest" aria-busy="true" data-news-art={HUB_NEWS_ART}></div>
          </div>
        </div>
        <!-- New Here (Dani, 17 Oct): four cards straight under Explore and
             Latest, the same picture-and-words cards, as part of one section. -->
        <div class="lrn-cards lrn-cards--4 lrn-newhere" aria-label="New here">
          <a class="lrn-card" href="/account/guides/read?g=training-hub">
            <span class="lrn-card-art" style="background-image:url('/assets/lay%20down.jpg')"></span>
            <span class="lrn-card-tx"><span class="lrn-card-flag">New here</span><strong class="lrn-card-h">Start here</strong><span class="lrn-card-sum">The essentials that set you up for success, in this order.</span></span>
          </a>
          <a class="lrn-card" href="/account/profile">
            <span class="lrn-card-art" style="background-image:url('/assets/home%20ginger.jpg')"></span>
            <span class="lrn-card-tx"><span class="lrn-card-flag">Step 1</span><strong class="lrn-card-h">Set up your brand kit</strong><span class="lrn-card-sum">Your colours, fonts and logo, so every design comes out on brand.</span></span>
          </a>
          <a class="lrn-card" href="/account/schedule">
            <span class="lrn-card-art" style="background-image:url('/images/dashboard/door-planner-v1.webp')"></span>
            <span class="lrn-card-tx"><span class="lrn-card-flag">Step 2</span><strong class="lrn-card-h">Plan your content</strong><span class="lrn-card-sum">A month of posts and activity on one calendar you can keep to.</span></span>
          </a>
          <a class="lrn-card" href="/account/studio">
            <span class="lrn-card-art" style="background-image:url('/assets/home%20deer.jpg')"></span>
            <span class="lrn-card-tx"><span class="lrn-card-flag">Step 3</span><strong class="lrn-card-h">Post with confidence</strong><span class="lrn-card-sum">Know what to post, and when, from your packs in the Studio.</span></span>
          </a>
        </div>
      </section>

      <!-- ============ Featured learning paths (hidden until real paths exist) ============ -->
      <!-- ============ From the blog: every piece going by, as on the Blog
           page (Dani, 17 Oct). Filled by fillPostReel; the section stays out
           of sight if there's nothing to show. ============ -->
      <section class="lrn-sec ws-rise" style="--i:5" aria-labelledby="notes-h" id="notes">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="notes-h">From the Blog</h2>
          <a class="ws-textlink" href="/account/blog">All articles &rarr;</a>
        </header>
        <div class="ws-reel" id="lrn-reel" aria-label="Articles" aria-busy="true"><div class="ws-reel-track"></div></div>
      </section>

      <!-- ============ Quick lessons (hidden until real video lessons exist) ============ -->
      <section class="lrn-sec ws-rise lrn-soon" style="--i:5" aria-labelledby="quick-h">
        <header class="lrn-sec-head">
          <h2 class="ws-eyebrow" id="quick-h">Quick Lessons</h2>
          <a class="ws-textlink" href="#">Browse all →</a>
        </header>
        <div class="lrn-rail">
          <div class="lrn-row" data-rail>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/home%20chair.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">4:21</span></span>
              <span class="lrn-clip-title">3 content ideas for today</span>
              <span class="lrn-clip-cat">Idea</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/phone%20me.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">3:17</span></span>
              <span class="lrn-clip-title">Design a post in 10 minutes</span>
              <span class="lrn-clip-cat">Design</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/glasses.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">2:58</span></span>
              <span class="lrn-clip-title">Write captions that sell</span>
              <span class="lrn-clip-cat">Copywriting</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/outside.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">2:42</span></span>
              <span class="lrn-clip-title">Best times to post</span>
              <span class="lrn-clip-cat">Strategy</span>
            </a>
            <a class="lrn-clip" href="#">
              <span class="lrn-clip-art" style="background-image:url('/assets/vibes.jpg')"><span class="lrn-clip-play"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg></span><span class="lrn-clip-dur">2:35</span></span>
              <span class="lrn-clip-title">Reels that get watched</span>
              <span class="lrn-clip-cat">Video</span>
            </a>
          </div>
          <button type="button" class="lrn-arrow" data-rail-next aria-label="Show more lessons"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg></button>
        </div>
      </section>

      <HubFootBar />
    </main>
    <StudioInspo />
  </div>

  <!-- A topic's guides and courses, in a pop-out (Dani, 17 Oct). -->
  <div class="lrn-sheet-scrim" id="lrn-sheet" data-lenis-prevent hidden>
    <div class="lrn-sheet" role="dialog" aria-modal="true" aria-labelledby="lrn-sheet-h">
      <button type="button" class="lrn-sheet-x" data-sheet-close aria-label="Close"><svg viewBox="0 0 24 24" aria-hidden="true"><line x1="6" y1="6" x2="18" y2="18"/><line x1="18" y1="6" x2="6" y2="18"/></svg></button>
      <span class="lrn-sheet-eyebrow">Topic</span>
      <h2 class="lrn-sheet-h" id="lrn-sheet-h"></h2>
      <p class="lrn-sheet-sub" id="lrn-sheet-sub"></p>
      <div class="lrn-guides-grid" id="lrn-sheet-grid"></div>
      <p class="lrn-guides-empty" id="lrn-sheet-empty" hidden>Nothing in this topic yet. Guides appear here as they&rsquo;re published.</p>
    </div>
  </div>

  <style is:global>
    /* ---------- Real guides grid ---------- */
    /* ---------- Explore by topic: the dashboard's Explore buttons ---------- */
    .lrn-topic-pills { display: flex; flex-wrap: wrap; gap: 6px; }
    .lrn-topic { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 12px; border: 1px solid rgba(55,30,40,0.45); border-radius: 6px; font-family: var(--sans); font-size: 10.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet); text-decoration: none; transition: background 0.2s var(--ws-ease), color 0.2s var(--ws-ease), border-color 0.2s; }
    .lrn-topic:hover { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .lrn-topic-count { opacity: 0.6; letter-spacing: 0.04em; }
    /* At the top: across the full width, every button one size (Dani, 17 Oct). */
    #lrn-topics { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px; }
    #lrn-topics .lrn-topic { height: 40px; justify-content: center; padding: 0 10px; letter-spacing: 0.08em; white-space: nowrap; overflow: hidden; }

    /* ---------- Doors: the dashboard's Your Studio cards ----------
       Portrait, shading down from the brand secondary, white words on a band
       at the foot. The first is a picture card with the title; on the others
       a picture covers the card on hover, words and all. */
    .lrn-doors { display: grid; grid-template-columns: repeat(var(--cols, 5), minmax(0, 1fr)); gap: var(--ws-gap, 10px); }
    .lrn-doors-fill { display: contents; }
    .lrn-door { --door: #7e6765; --pad: clamp(16px, 1.5vw, 22px); position: relative; overflow: hidden; isolation: isolate; display: flex; flex-direction: column; aspect-ratio: 4 / 5; padding: var(--pad); border-radius: var(--ws-r, 4px); background: var(--door); color: #fff; text-decoration: none; transition: transform 0.35s var(--ws-ease), box-shadow 0.35s var(--ws-ease); }
    .lrn-door:nth-child(2), .lrn-doors-fill > .lrn-door:nth-child(1) { --door: color-mix(in srgb, #7e6765 84%, #fff); }
    .lrn-door:nth-child(3), .lrn-doors-fill > .lrn-door:nth-child(2) { --door: color-mix(in srgb, #7e6765 68%, #fff); }
    .lrn-door:nth-child(4), .lrn-doors-fill > .lrn-door:nth-child(3) { --door: color-mix(in srgb, #7e6765 54%, #fff); }
    .lrn-door:nth-child(5), .lrn-doors-fill > .lrn-door:nth-child(4) { --door: color-mix(in srgb, #7e6765 42%, #fff); }
    .lrn-door:hover { transform: translateY(-4px); box-shadow: 0 22px 40px -24px rgba(55,30,40,0.55); }
    .lrn-door-tx { position: relative; margin: auto calc(-1 * var(--pad)) calc(-1 * var(--pad)); padding: 12px var(--pad) var(--pad); display: flex; flex-direction: column; gap: 5px; background: var(--door); }
    .lrn-door-tx em { font-style: normal; font-size: var(--ws-t-label, 10.5px); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; opacity: 0.75; }
    .lrn-door-tx strong { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 18px); font-weight: 600; line-height: 1.2; }
    .lrn-door-tx span { font-size: var(--ws-t-meta, 12px); line-height: 1.4; opacity: 0.85; }
    .lrn-door-tx .lrn-door-meta { margin-top: 2px; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; opacity: 0.85; }
    .lrn-door-pic { position: absolute; inset: 0; z-index: -1; background-size: cover; background-position: center; }
    /* The title card: its picture always, the band wine. */
    .lrn-door--title { --door: var(--english-violet); }
    .lrn-door--title .lrn-door-tx strong { font-size: clamp(18px, 1.5vw, 22px); }
    /* The others: the picture over the whole card on hover. */
    .lrn-door-pic--hover { z-index: 3; opacity: 0; transform: scale(1.04); transition: opacity 0.5s var(--ws-ease), transform 1.2s var(--ws-ease); pointer-events: none; }
    @media (hover: hover) { .lrn-door:hover .lrn-door-pic--hover, .lrn-door:focus-visible .lrn-door-pic--hover { opacity: 1; transform: none; } }
    /* Below 1000px all five still fit across (Dani, 17 Oct: in the training
       pop-out they ran off with no way to scroll), the line under each title
       dropped so nothing overflows; a swipe strip only on a phone. */
    @media (max-width: 1000px) {
      .lrn-door-tx span:not(.lrn-door-meta) { display: none; }
      .lrn-door { --pad: 12px; }
      .lrn-door-tx strong { font-size: 14px; }
    }
    @media (max-width: 620px) {
      .lrn-doors { display: flex; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; }
      .lrn-doors::-webkit-scrollbar { display: none; }
      .lrn-doors .lrn-door { flex: 0 0 calc((100% - 24px) / 3.3); scroll-snap-align: start; }
      .lrn-doors-fill { display: contents; }
      .lrn-door-tx span:not(.lrn-door-meta) { display: block; }
    }
    @media (max-width: 560px) { .lrn-doors .lrn-door { flex-basis: 62%; } }

    /* ---------- This month: the dashboard's Be inspired ---------- */
    .lrn-month { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: var(--ws-gap, 10px); align-items: stretch; }
    .lrn-month-box { display: flex; flex-direction: column; gap: 10px; padding: 22px clamp(40px, 4vw, 64px) 22px 22px;   /* more room on the right, so the words take a line or two more (Dani, 17 Oct) */ border: 1px solid rgba(28,29,34,0.13); border-radius: var(--ws-r, 4px); background: #fff; text-align: left; font: inherit; color: inherit; cursor: pointer; transition: border-color 0.2s; }
    .lrn-month-box:hover { border-color: rgba(28,29,34,0.3); }
    .lrn-month-eyebrow { margin-bottom: 20px;   /* three times the gap to the title */ font-size: var(--ws-t-label, 10.5px); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.46); }
    /* The size of the dashboard's "Getting Around Your Hub" (Dani, 17 Oct). */
    .lrn-month-title { font-family: var(--serif); font-weight: 500; font-size: clamp(19px, 1.6vw, 24px); line-height: 1.2; letter-spacing: -0.01em; color: var(--ws-ink); }
    .lrn-month-sub { font-size: var(--ws-t-body, 13px); line-height: 1.5; color: var(--ws-tx); }
    .lrn-month-cta { margin-top: auto; align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; height: 33px; padding: 0 16px; border-radius: var(--ws-r, 4px); background: var(--english-violet); color: #fff; font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
    .lrn-month-cta em { font-style: normal; transition: transform 0.25s var(--ws-ease); }
    .lrn-month-box:hover .lrn-month-cta em { transform: translateX(3px); }
    @media (max-width: 1000px) { .lrn-month { grid-template-columns: 1fr; } }

    /* ---------- New to the Training Studio: the dashboard's Explore and Latest ---------- */
    .lrn-wn { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2.7fr); gap: clamp(20px, 2.2vw, 34px); }
    .lrn-wn-label { margin: 0 0 14px; padding-bottom: 10px; border-bottom: 1px solid rgba(28,29,34,0.35); font-size: var(--ws-t-label, 10.5px); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-ink); }
    @media (max-width: 1100px) { .lrn-wn { grid-template-columns: 1fr; } }
    /* Explore here: one topic a row, every button the same length (Dani). */
    .lrn-wn .lrn-topic-pills { flex-direction: column; align-items: stretch; }
    .lrn-wn .lrn-topic { justify-content: space-between; }
    /* The dashboard's Latest cards: picture left, words right, each card its
       own soft tint; the intro two lines at most. */
    .lrn-cards { display: grid; gap: 8px; }
    .lrn-cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .lrn-cards--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .lrn-newhere { margin-top: 8px; }
    .lrn-card { display: grid; grid-template-columns: minmax(0, 40fr) minmax(0, 60fr); gap: 14px; padding: 6px; min-height: 150px; border-radius: var(--ws-r, 4px); background: var(--wn, #fff); text-decoration: none; color: var(--ws-ink); transition: transform 0.25s var(--ws-ease); }
    .lrn-card:hover { transform: translateY(-3px); }
    .lrn-card:nth-child(4n+1) { --wn: color-mix(in srgb, #7e6765 26%, #fff); }
    .lrn-card:nth-child(4n+2) { --wn: color-mix(in srgb, #B9826A 30%, #fff); }
    .lrn-card:nth-child(4n+3) { --wn: color-mix(in srgb, #969AB0 32%, #fff); }
    .lrn-card:nth-child(4n+4) { --wn: color-mix(in srgb, #5f6a35 22%, #fff); }
    .lrn-card-art { border-radius: 1px; background: #eae5e1 center / cover no-repeat; }
    .lrn-card-tx { display: flex; flex-direction: column; gap: 6px; padding: 8px 8px 6px 0; min-width: 0; }
    .lrn-card-flag { font-size: 9.5px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-tx); }
    .lrn-card-h { margin-top: auto; font-family: var(--sans); font-size: clamp(14px, calc(0.8vw + 4.5px), 17px); font-weight: 600; line-height: 1.2; color: var(--ws-ink); }
    .lrn-card-sum { font-size: 12px; line-height: 1.4; color: var(--ws-tx); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .lrn-card-meta { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; color: var(--ws-tx); }
    /* Latest: portrait (Dani, 17 Oct): the picture on top, the words under it. */
    .lrn-cards--3 .lrn-card { display: flex; flex-direction: column; gap: 0; padding: 6px; aspect-ratio: 4 / 5; min-height: 0; }
