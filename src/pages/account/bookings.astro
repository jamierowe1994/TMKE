---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import { TERMS_BY_SERVICE, TERMS_NOTE } from "../../lib/videography-config.js";
import "../../styles/workspace.css";
import "../../styles/ws-system.css";
import "../../styles/account-sections.css";
import "../../styles/booking-wizard.css";   // reuse .dc-cal / .dc-slot for the reschedule picker
---

<BaseLayout
  dashboard
  title="Bookings — TMKE workspace"
  description="Your videography bookings and discovery calls — view details, messages, documents, reschedule or cancel."
  hideNav
  hideFooter
>
  <WorkspaceHeader active="bookings" />
  <div class="ws">
    <main class="ws-main">
    <div class="ws-left">
    <section class="ws-hero ws-hero--sub bk-hero">
      <div class="ws-hero-copy">
        <p class="ws-hero-date"><a href="/account" class="back-link">&larr; Workspace</a></p>
        <h1 class="ws-greeting">Your Bookings.</h1>
        <p class="ws-hero-sub">Every shoot, studio session and call in one place — where each one has got to, what we sent you, and everything that came back.</p>
        <div class="bk-hero-cta">
          <a class="ws-btn ws-btn--primary" href="/videography">Book a shoot
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </a>
        </div>
      </div>
      <div class="ws-hero-photo"></div>
    </section>

    <section class="ws-block">
      <header class="ws-block-head">
        <h2 class="ws-block-h"><span class="ws-block-ch">Chapter 01</span>Upcoming</h2>
        <a class="ws-block-link" href="/videography">Book another</a>
      </header>
      <div id="bk-next"></div>
      <div id="bk-upcoming" class="bk-list">
        <div class="bk-state">Loading bookings&hellip;</div>
      </div>
    </section>

    <section class="ws-block bk-past-sec" id="bk-past-sec">
      <header class="ws-block-head">
        <h2 class="ws-block-h"><span class="ws-block-ch">Chapter 02</span>Previously</h2>
      </header>
      <div id="bk-past" class="bk-list"></div>
    </section>
    </div><!-- /.ws-left -->

    <footer class="app-foot dash-foot">
      <div class="app-foot-block">
        <div class="app-foot-tag">Help</div>
        <a href="/account/contact">hello@tmke.co.uk</a>
      </div>
      <div class="app-foot-block app-foot-block--right">
        <strong id="footer-email" class="dash-foot-email">&hellip;</strong>
      </div>
    </footer>
    </main>
  </div>

  <!-- ===================== Booking detail drawer ===================== -->
  <div class="bk-detail-scrim" id="bk-detail" hidden>
    <aside class="bk-detail-panel" role="dialog" aria-modal="true" aria-label="Booking details">
      <button type="button" class="bk-detail-x" id="bk-detail-close" aria-label="Close">&times;</button>
      <header class="bk-detail-head">
        <span class="bk-pill" id="bk-detail-pill">…</span>
        <h2 class="bk-detail-title" id="bk-detail-title">…</h2>
        <p class="bk-detail-count" id="bk-detail-count"></p>
      </header>
      <div class="bk-detail-body" id="bk-detail-body"></div>
    </aside>
  </div>

  <!-- ===================== Reschedule modal ===================== -->
  <div class="bk-resched-scrim" id="bk-resched" hidden>
    <div class="bk-resched-card" role="dialog" aria-modal="true" aria-label="Reschedule booking">
      <header class="bk-resched-head">
        <h3 id="bk-resched-title">Reschedule</h3>
        <button type="button" class="bk-resched-x" id="bk-resched-close" aria-label="Close">&times;</button>
      </header>
      <p class="bk-resched-sub" id="bk-resched-sub">Pick a new day and time.</p>
      <div id="bk-resched-cal-wrap">
        <div class="dc-cal">
          <header class="dc-cal-head">
            <button type="button" class="dc-cal-nav" id="bk-prev-month" aria-label="Previous month">&larr;</button>
            <div class="dc-cal-label" id="bk-cal-label">…</div>
            <button type="button" class="dc-cal-nav" id="bk-next-month" aria-label="Next month">&rarr;</button>
          </header>
          <div class="dc-cal-weekdays"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div>
          <div class="dc-cal-grid" id="bk-cal-grid"></div>
        </div>
      </div>
      <div id="bk-resched-slots-wrap" hidden>
        <p class="bk-resched-sub" id="bk-slots-sub">…</p>
        <div class="dc-slots-grid" id="bk-slots-grid"></div>
        <button type="button" class="bk-resched-back" id="bk-slots-back">&larr; Back to calendar</button>
      </div>
      <p class="dc-gate-error" id="bk-resched-error" hidden></p>
    </div>
  </div>

  <!-- ===================== Service-agreement modal ===================== -->
  <div class="bk-agree-scrim" id="bk-agree" hidden>
    <div class="bk-agree-card" role="dialog" aria-modal="true" aria-label="Service Agreement">
      <button type="button" class="bk-detail-x" id="bk-agree-close" aria-label="Close">&times;</button>
      <h2 class="bk-agree-title" id="bk-agree-title">Service Agreement</h2>
      <p class="bk-agree-signed" id="bk-agree-signed"></p>
      <div class="bk-agree-body" id="bk-agree-body"></div>
      <p class="bk-agree-note" id="bk-agree-note"></p>
    </div>
  </div>

  <script type="application/json" id="tmke-terms" set:html={JSON.stringify({ note: TERMS_NOTE, byService: TERMS_BY_SERVICE })}></script>

  <style is:global>
    /* One gap everywhere, the same token the rest of the hub uses. */
    .bk-list { display: flex; flex-direction: column; gap: var(--ws-gap); }
    /* Hairline-outlined, square-cornered, unfilled — the house card. */
    .bk-card {
      display: grid; grid-template-columns: 1fr auto; gap: 10px 24px; align-items: center;
      padding: 18px 22px; border-radius: 0; cursor: pointer;
      background: transparent; border: 1px solid rgba(28,29,34,0.14);
      transition: border-color .2s ease, background .2s ease;
    }
    .bk-card:hover { border-color: var(--english-violet); background: rgba(var(--violet-rgb), 0.03); }
    .bk-card:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
    .bk-card.is-cancelled { opacity: 0.55; }
    .bk-card-main { min-width: 0; }
    .bk-card-title { font-family: var(--serif); font-size: 19px; font-weight: 500; letter-spacing: -0.01em; color: var(--ink); margin: 0 0 3px; }
    .bk-card-when { font-family: var(--sans); font-size: 13.5px; color: rgba(28,29,34,0.7); }
    .bk-card-meta { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.5); margin-top: 3px; }
    .bk-card-side { display: flex; flex-direction: column; align-items: flex-end; gap: 8px; text-align: right; }
    /* Square, like everything else. The stage is a label, not a badge. */
    .bk-pill {
      font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; padding: 5px 10px; border-radius: 0; white-space: nowrap;
      background: var(--english-violet); color: #fff;
    }
    .bk-pill.is-cancelled { background: transparent; border: 1px solid rgba(28,29,34,0.2); color: rgba(28,29,34,0.5); }
    .bk-pill.is-complete { background: transparent; border: 1px solid rgba(46,106,74,0.4); color: #2e6a4a; }
    .bk-view-cue { font-family: var(--sans); font-size: 11.5px; font-weight: 600; letter-spacing: 0.02em; color: rgba(28,29,34,0.45); }
    .bk-card:hover .bk-view-cue { color: var(--english-violet); }
    /* ---- Next shoot banner ----
       Wine, because it is the one thing on the page asking for attention. It
       sits above Chapter 01 rather than inside it: the list is a record, this
       is a prompt. */
    .bk-next {
      display: grid; grid-template-columns: auto 1fr auto; gap: 8px 26px; align-items: center;
      padding: 18px 22px; margin-bottom: var(--ws-gap);
      background: var(--english-violet); color: #fff;
    }
    .bk-next-when { display: flex; flex-direction: column; gap: 2px; }
    .bk-next-count { font-family: var(--serif); font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.65); }
    .bk-next-date { font-family: var(--sans); font-size: 13px; font-weight: 600; white-space: nowrap; }
    .bk-next-main { min-width: 0; }
    .bk-next-title { font-family: var(--serif); font-size: 20px; font-weight: 500; letter-spacing: -0.01em; margin: 0; color: #fff; }
    .bk-next-meta { font-family: var(--sans); font-size: 12.5px; color: rgba(255,255,255,0.7); margin: 3px 0 0; }
    .bk-next-acts { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    /* On the wine the primary button has to invert, or it disappears into it. */
    .bk-next .ws-btn { border-color: rgba(255,255,255,0.4); color: #fff; background: transparent; }
    .bk-next .ws-btn:hover { background: rgba(255,255,255,0.14); border-color: #fff; }
    .bk-next .ws-btn--primary { background: #fff; color: var(--english-violet); border-color: #fff; }
    .bk-next .ws-btn--primary:hover { background: rgba(255,255,255,0.88); }
    @media (max-width: 720px) {
      .bk-next { grid-template-columns: 1fr; gap: 12px; }
      .bk-next-acts { justify-content: flex-start; }
    }

    /* ---- Invoicing rows ---- */
    .bk-inv {
      display: grid; grid-template-columns: 1fr auto; gap: 6px 16px; align-items: center;
      padding: 13px 15px; border: 1px solid rgba(28,29,34,0.14);
    }
    .bk-inv + .bk-inv { margin-top: 8px; }
    .bk-inv-main { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .bk-inv-main strong { font-family: var(--sans); font-size: 13.5px; font-weight: 700; color: var(--ink); }
    .bk-inv-main span { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); }
    .bk-inv-side { display: flex; flex-direction: column; align-items: flex-end; gap: 3px; }
    .bk-inv-total { font-family: var(--sans); font-size: 15px; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
    .bk-inv-state { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: #a5352f; }
    .bk-inv-state.is-paid { color: #2e6a4a; }
    /* The pay button spans both columns so it reads as an action on the whole
       row rather than a third value in it. */
    .bk-inv .bk-btn { grid-column: 1 / -1; justify-self: start; margin-top: 4px; }
    .bk-inv.is-paid { border-color: rgba(46,106,74,0.3); }

    .bk-state { font-family: var(--sans); font-size: 13.5px; color: rgba(28,29,34,0.55); padding: 18px 22px; border: 1px solid rgba(28,29,34,0.1); }
    .bk-hero { --ws-hero-img: url('/assets/home%20window.jpg'); }
    .bk-hero-cta { margin-top: auto; padding-top: clamp(24px, 3vh, 36px); }

    /* Empty states sit in an outline card so they match the booking cards. */
    /* No box. An empty section should read as a quiet note in the space where
       the cards will be, not as a card pretending there is something in it —
       and two outlined boxes saying "nothing" is the emptiest a page can look.
       The heading is Helios, sized and spaced like the strips above it. */
    .bk-none { padding: 18px 2px 22px; }
    .bk-none-h {
      margin: 0 0 6px; font-family: var(--serif); font-size: 11px; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.45);
    }
    .bk-none-p { margin: 0; font-family: var(--sans); font-size: 13.5px; line-height: 1.6; color: rgba(28,29,34,0.6); max-width: 52ch; }
    .bk-none-p a { color: var(--english-violet); font-weight: 700; text-decoration: none; border-bottom: 1px solid rgba(var(--violet-rgb),0.35); }
    .bk-none-p a:hover { border-bottom-color: var(--english-violet); }
    /* Match the booking card's typography exactly: the title reuses .bk-card-title
       (The Seasons), the body matches the .bk-card-when date line (Darker Grotesque). */
    @media (max-width: 680px) {
      .bk-card { grid-template-columns: 1fr; }
      .bk-card-side { align-items: flex-start; text-align: left; }
    }

    /* ---- Detail drawer ---- */
    .bk-detail-scrim { position: fixed; inset: 0; z-index: 520; background: rgba(28,29,34,0.5); display: flex; justify-content: flex-end; }
    .bk-detail-scrim[hidden] { display: none; }
    .bk-detail-panel { position: relative; width: min(560px, 100vw); height: 100%; overflow-y: auto; background: var(--paper); box-shadow: -30px 0 80px rgba(0,0,0,0.32); padding: 30px 34px 60px; animation: bkSlideIn .28s cubic-bezier(.2,.7,.3,1); }
    @keyframes bkSlideIn { from { transform: translateX(24px); opacity: 0; } to { transform: none; opacity: 1; } }
    .bk-detail-x { position: absolute; top: 20px; right: 22px; appearance: none; background: none; border: 0; font-size: 30px; line-height: 1; color: rgba(28,29,34,0.45); cursor: pointer; }
    .bk-detail-x:hover { color: var(--ink); }
    .bk-detail-head { margin: 4px 40px 22px 0; }
    /* The drawer's pill is the same pill as the card's — it names the same
       stage, so it should not be a second visual language for it. */
    .bk-detail-head .bk-pill { display: inline-block; margin-bottom: 12px; }
    .bk-detail-title { font-family: var(--serif); font-weight: 500; font-size: 30px; line-height: 1.1; color: var(--ink); margin: 0; }
    .bk-detail-count { font-family: var(--sans); font-size: 13.5px; color: rgba(28,29,34,0.6); margin: 6px 0 0; }
    .bk-detail-block { border-top: 1px solid rgba(28,29,34,0.09); padding: 20px 0; }
    .bk-detail-block:first-child { border-top: 0; padding-top: 0; }
    .bk-detail-h { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin: 0 0 14px; }
    .bk-facts { display: flex; flex-direction: column; gap: 0; }
    .bk-fact { display: flex; justify-content: space-between; gap: 16px; align-items: baseline; padding: 9px 0; border-bottom: 1px dashed rgba(28,29,34,0.1); font-family: var(--sans); font-size: 14.5px; color: var(--ink); }
    .bk-fact:last-child { border-bottom: 0; }
    .bk-fact > span:first-child { color: rgba(28,29,34,0.55); flex: 0 0 auto; }
    .bk-fact > strong, .bk-fact > span:last-child { text-align: right; font-weight: 600; }
    .bk-fact--sub { padding: 4px 0; border-bottom: 0; font-size: 13px; color: rgba(28,29,34,0.6); }
    .bk-fact--sub > span:last-child { font-weight: 500; }
    .bk-fact--note { padding-top: 8px; border-bottom: 0; font-size: 12.5px; font-style: italic; color: rgba(28,29,34,0.5); }
    .bk-expect { font-family: var(--sans); font-size: 14.5px; line-height: 1.6; color: rgba(28,29,34,0.75); margin: 0; }
    /* The PIN block. Reads as a fact when unlocked and as an explanation when
       not - a client who hasn't paid should understand why, not just find a
       blank. */
    .bk-pin {
      margin-top: 14px; padding: 14px 16px; border-radius: 5px;
      background: rgba(28,29,34,0.04); border: 1px solid rgba(28,29,34,0.08);
      display: flex; flex-direction: column; gap: 4px;
    }
    .bk-pin[data-unlocked="1"] { background: rgba(60,150,90,0.08); border-color: rgba(60,150,90,0.25); }
    .bk-pin-label { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .bk-pin-value { font-family: var(--sans); font-size: 22px; font-weight: 800; letter-spacing: 0.08em; color: var(--english-violet); }
    .bk-pin-note { font-family: var(--sans); font-size: 12.5px; line-height: 1.55; color: rgba(28,29,34,0.6); }
    /* Masked with real characters rather than a CSS blur, so the value a
       screen reader or a text selection picks up matches what is on screen. */
    .bk-pin-value.is-hidden { letter-spacing: 0.18em; color: rgba(28,29,34,0.35); }
    .bk-reveal {
      appearance: none; margin-left: auto; height: 28px; padding: 0 12px;
      border: 1px solid rgba(28,29,34,0.18); border-radius: 3px; background: transparent;
      font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: rgba(28,29,34,0.7); cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .bk-reveal:hover { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .bk-reveal[hidden] { display: none; }

    /* ---- Stage track ---- */
    .bk-track { display: flex; list-style: none; margin: 0 0 12px; padding: 0; gap: 0; }
    .bk-step { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 7px; position: relative; text-align: center; }
    /* The connector is drawn on the step, not between them, so the first and
       last ends stay clean without extra elements. */
    .bk-step::before, .bk-step::after {
      content: ''; position: absolute; top: 5px; height: 1px; background: rgba(28,29,34,0.15);
    }
    .bk-step::before { left: 0; right: 50%; }
    .bk-step::after { left: 50%; right: 0; }
    .bk-step:first-child::before, .bk-step:last-child::after { display: none; }
    .bk-step-dot {
      width: 11px; height: 11px; border-radius: 50%; box-sizing: border-box;
      border: 1px solid rgba(28,29,34,0.28); background: var(--paper);
      position: relative; z-index: 1;
    }
    .bk-step-label { font-family: var(--sans); font-size: 10.5px; font-weight: 600; letter-spacing: 0.04em; color: rgba(28,29,34,0.42); }
    .bk-step.is-done .bk-step-dot { background: var(--english-violet); border-color: var(--english-violet); }
    .bk-step.is-done .bk-step-label { color: rgba(28,29,34,0.62); }
    .bk-step.is-done::before, .bk-step.is-done::after,
    .bk-step.is-now::before { background: var(--english-violet); }
    .bk-step.is-now .bk-step-dot {
      background: var(--english-violet); border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(var(--violet-rgb), 0.18);
    }
    .bk-step.is-now .bk-step-label { color: var(--english-violet); font-weight: 800; }
    .bk-track-now { margin: 0; }
    .bk-track-cancelled { font-family: var(--sans); font-size: 13px; line-height: 1.6; color: rgba(28,29,34,0.6); margin: 0; }
    @media (max-width: 520px) { .bk-step-label { font-size: 9px; letter-spacing: 0; } }
    /* Same locked/unlocked treatment as the PIN, for the 360 tour link - held
       back exactly the same way, for exactly the same reason. */
    .bk-tour { margin-top: 10px; padding: 14px 16px; border-radius: 5px; background: rgba(28,29,34,0.04); border: 1px solid rgba(28,29,34,0.08); display: flex; flex-direction: column; gap: 4px; }
    .bk-tour[data-unlocked="1"] { background: rgba(60,150,90,0.08); border-color: rgba(60,150,90,0.25); }
    .bk-tour-label { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .bk-tour-link { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--english-violet); }
    .bk-tour-note { font-family: var(--sans); font-size: 12.5px; line-height: 1.55; color: rgba(28,29,34,0.6); }

    .bk-detail-actions { display: flex; flex-wrap: wrap; gap: 10px; }
    .bk-btn { appearance: none; border: 1px solid rgba(var(--violet-rgb),0.3); background: #fff; color: var(--ink); font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.04em; padding: 11px 16px; border-radius: 8px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 7px; transition: border-color .2s, background .2s, color .2s; }
    .bk-btn:hover { border-color: var(--english-violet); color: var(--english-violet); }
    .bk-btn--primary { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .bk-btn--primary:hover { background: var(--violet-deep); border-color: var(--violet-deep); color: #fff; }
    .bk-btn--danger:hover { border-color: #8a3b2f; color: #8a3b2f; }
    .bk-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .bk-note { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); }
    .bk-empty { font-family: var(--sans); font-size: 13.5px; line-height: 1.6; color: rgba(28,29,34,0.55); margin: 0; }

    /* Messages thread */
    .bk-thread { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; }
    .bk-msg { border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 12px 14px; background: #fff; }
    .bk-msg.is-out { border-left: 3px solid var(--violet-deep); }
    .bk-msg.is-in { border-left: 3px solid rgba(28,29,34,0.25); background: rgba(28,29,34,0.02); }
    .bk-msg-meta { display: flex; justify-content: space-between; gap: 12px; font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.5); margin-bottom: 5px; }
    .bk-msg-meta strong { color: rgba(28,29,34,0.7); font-weight: 700; }
    .bk-msg-subj { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); margin-bottom: 3px; }
    .bk-msg-body { font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: rgba(28,29,34,0.78); }

    /* Documents */
    .bk-doc { display: flex; align-items: center; gap: 12px; padding: 11px 12px; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; background: #fff; margin-bottom: 8px; }
    .bk-doc.is-agreement { background: rgba(var(--violet-rgb),0.05); border-color: rgba(var(--violet-rgb),0.18); }
    .bk-doc-ic { flex: 0 0 auto; width: 32px; height: 32px; border-radius: 8px; display: grid; place-items: center; background: rgba(var(--violet-rgb),0.12); color: var(--english-violet); font-size: 15px; }
    .bk-doc-main { min-width: 0; flex: 1; }
    .bk-doc-main strong { display: block; font-family: var(--sans); font-size: 14px; color: var(--ink); }
    .bk-doc-main span { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.5); }
    .bk-doc .bk-btn { padding: 8px 13px; font-size: 12px; }

    /* ---- Reschedule modal ---- */
    .bk-resched-scrim { position: fixed; inset: 0; z-index: 560; background: rgba(28,29,34,0.55); display: flex; align-items: center; justify-content: center; padding: 24px; }
    .bk-resched-scrim[hidden] { display: none; }
    .bk-resched-card { width: min(440px, 96vw); max-height: 90vh; overflow-y: auto; background: var(--paper); border-radius: 14px; padding: 24px 26px 28px; box-shadow: 0 30px 80px rgba(0,0,0,0.34); }
    .bk-resched-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 4px; }
    .bk-resched-head h3 { font-family: var(--serif); font-weight: 500; font-size: 26px; color: var(--ink); margin: 0; }
    .bk-resched-x { appearance: none; background: none; border: 0; font-size: 26px; line-height: 1; color: rgba(28,29,34,0.5); cursor: pointer; }
    .bk-resched-x:hover { color: var(--ink); }
    .bk-resched-sub { font-family: var(--sans); font-size: 13.5px; color: rgba(28,29,34,0.6); margin: 0 0 16px; }
    .bk-resched-back { appearance: none; background: none; border: 0; color: var(--english-violet); font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; cursor: pointer; margin-top: 16px; padding: 0; }

    /* ---- Service-agreement modal ---- */
    .bk-agree-scrim { position: fixed; inset: 0; z-index: 560; background: rgba(28,29,34,0.55); display: flex; align-items: center; justify-content: center; padding: 24px; }
    .bk-agree-scrim[hidden] { display: none; }
    .bk-agree-card { position: relative; width: min(640px, 96vw); max-height: 88vh; overflow-y: auto; background: var(--paper); border-radius: 14px; padding: 30px 34px 34px; box-shadow: 0 30px 80px rgba(0,0,0,0.34); }
    .bk-agree-title { font-family: var(--serif); font-weight: 500; font-size: 26px; color: var(--ink); margin: 0 34px 4px 0; }
    .bk-agree-signed { font-family: var(--sans); font-size: 13px; color: var(--english-violet); font-weight: 700; margin: 0 0 18px; }
    .bk-agree-body { border-top: 1px solid rgba(28,29,34,0.1); padding-top: 8px; }
    .bk-clause { padding: 14px 0; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .bk-clause:last-child { border-bottom: 0; }
    .bk-clause h4 { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); margin: 0 0 5px; }
    .bk-clause p { font-family: var(--sans); font-size: 13.5px; line-height: 1.6; color: rgba(28,29,34,0.75); margin: 0; }
    .bk-agree-note { font-family: var(--sans); font-size: 12px; font-style: italic; color: rgba(28,29,34,0.5); line-height: 1.5; margin: 18px 0 0; }
    .bk-doc.is-agreement { cursor: default; }
    .bk-doc.is-agreement .bk-btn { padding: 8px 13px; font-size: 12px; }
  </style>

  <script>
    import { supabase, gbpFromPence, signOutEverywhere} from '../../lib/supabase.js';
    import { bookingLocation, isSettled, isPackageCovered } from '../../lib/videography-config.js';
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');

    const $ = (id) => document.getElementById(id);
    const pad = (n) => String(n).padStart(2, '0');
    const localISO = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
    function escapeHtml(s) { return String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c])); }
    function fmtWhen(iso) {
      if (!iso) return null;
      try { return new Date(iso).toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }); }
      catch (_) { return iso; }
    }
    function fmtDate(iso) {
      if (!iso) return '';
      try { return new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }); } catch (_) { return iso; }
    }
    function fmtBytes(n) { if (!n) return ''; const u = ['B', 'KB', 'MB', 'GB']; let i = 0, v = n; while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; } return `${v.toFixed(v < 10 && i > 0 ? 1 : 0)} ${u[i]}`; }
    const STAGE_LABEL = {
      booked: 'Booked', invoiced: 'Invoice sent', shoot_day: 'Shoot day', editing: 'In edit',
      gallery_ready: 'Being prepared', sent: 'Ready to view', delivered: 'Delivered', cancelled: 'Cancelled',
      discovery_call_booked: 'Call booked', enquiry_non_member: 'Enquiry sent',
    };

    /* ---- The stage track ----------------------------------------------------
       The database keeps seven stages because the admin kanban runs on them.
       A member sees five, because two of the seven are bookkeeping rather than
       progress: 'invoiced' is not a step in getting your video, and
       'gallery_ready' is really the window in which you ask for changes.

       Note the two words that must not blur into each other: "Editing" is us
       cutting the footage, "Amends" is the client's own paid request. Same
       word in the database, opposite actors on screen. */
    const TRACK = [
      { key: 'booked',    label: 'Booked',    blurb: 'Your date is held. We will confirm the running order the day before.' },
      { key: 'shoot_day', label: 'Shoot day', blurb: 'Filming day. Please have access arranged and any spaces ready.' },
      { key: 'editing',   label: 'Editing',   blurb: 'We have your footage and are cutting it. Your gallery follows.' },
      { key: 'amends',    label: 'Amends',    blurb: 'Your gallery is up. This is the window to ask for any changes.' },
      { key: 'delivered', label: 'Delivered', blurb: 'All done — everything is yours to download.' },
    ];
    const STAGE_TO_STEP = {
      booked: 'booked', invoiced: 'booked',
      shoot_day: 'shoot_day',
      editing: 'editing',
      gallery_ready: 'amends', sent: 'amends',
      delivered: 'delivered', complete: 'delivered', final_draft: 'editing',
    };
    /* The one label a member sees for a stage, so the pill on the card, the
       pill in the drawer and the track cannot disagree with each other. A
       shoot reads off the track; anything else keeps its own wording. */
    function memberStageLabel(r) {
      if (!r) return 'Booking';
      if (r.stage === 'cancelled') return 'Cancelled';
      if (hasTrack(r)) {
        const step = TRACK.find((t) => t.key === (STAGE_TO_STEP[r.stage] || 'booked'));
        if (step) return step.label;
      }
      return STAGE_LABEL[r.stage] || r.stage || 'Booking';
    }

    /* Discovery calls and enquiries are not shoots and have no track. */
    function hasTrack(r) {
      return r && r.source === 'videography' && r.kind !== 'discovery' && r.service_type !== 'discovery';
    }
    function trackHtml(r) {
      if (!hasTrack(r)) return '';
      if (r.stage === 'cancelled') {
        return `<section class="bk-detail-block"><h3 class="bk-detail-h">Where it is</h3>
          <p class="bk-track-cancelled">This booking was cancelled. Nothing further is due.</p></section>`;
      }
      const stepKey = STAGE_TO_STEP[r.stage] || 'booked';
      const at = Math.max(0, TRACK.findIndex((t) => t.key === stepKey));
      const steps = TRACK.map((t, i) => {
        const state = i < at ? 'is-done' : i === at ? 'is-now' : '';
        return `<li class="bk-step ${state}"><span class="bk-step-dot" aria-hidden="true"></span>
          <span class="bk-step-label">${escapeHtml(t.label)}</span></li>`;
      }).join('');
      return `<section class="bk-detail-block">
        <h3 class="bk-detail-h">Where it is</h3>
        <ol class="bk-track">${steps}</ol>
        <p class="bk-expect bk-track-now">${escapeHtml(TRACK[at].blurb)}</p>
      </section>`;
    }

    const CAT_LABEL = { agreement: 'Service Agreement', prep: 'Prep Document', invoice: 'Invoice', delivery: 'Delivered Files', other: 'Document' };
    const CAT_ICON = { agreement: '✓', prep: '📋', invoice: '£', delivery: '🎬', other: '📄' };
    const keyOf = (r) => `${r.source}:${r.id}`;

    async function signOut() { await signOutEverywhere(); }
    $('app-signout')?.addEventListener('click', signOut);

    let rows = [];
    const msgsByKey = new Map();
    const docsByKey = new Map();
    const invsByKey = new Map();

    // ---------- Load ----------
    (async () => {
      const isDemo = import.meta.env.DEV;
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        if (!isDemo) { location.replace('/login?next=' + encodeURIComponent('/account/bookings')); return; }
        seedDemo();
        render();
        openFromUrl();
        return;
      }
      // getSession() is local-only - a cleared/revoked session can still look
      // valid to it. Confirm with the server before letting anyone in.
      if (!isDemo) {
        const { data: { user }, error } = await supabase.auth.getUser();
        if (!user || error) { location.replace('/login?next=' + encodeURIComponent('/account/bookings')); return; }
      }
      const email = session.user.email ?? '';
      $('footer-email').textContent = email;

      // Videography bookings + discovery calls (one table).
      const { data: vid, error: vidErr } = await supabase
        .from('videography_bookings')
        .select('id, kind, service, service_type, shoot_date, stage, total_pence, surcharge_pence, add_ons, package, postcode, reschedule_token, duration_min, created_at, client_name, client_email, client_phone, signed_name, signed_at, notes, discovery_interests, gallery_url, gallery_email, gallery_expires_on, extra_link_label, extra_link_url, store_url, gallery_sent_at, paid_at, pin_released_at, payment_route')
        .or(`account_user_id.eq.${session.user.id},client_email.eq.${email}`)
        .order('shoot_date', { ascending: false, nullsFirst: false });

      // SMM discovery calls (separate table).
      const { data: smm } = await supabase
        .from('smm_leads')
        .select('id, kind, full_name, email, phone, business, call_at, duration_min, reschedule_token, stage, created_at')
        .eq('kind', 'discovery')
        .or(`account_user_id.eq.${session.user.id},email.eq.${email}`)
        .order('call_at', { ascending: false, nullsFirst: false });

      if (vidErr) {
        $('bk-upcoming').innerHTML = `<div class="lib-state" style="padding:18px 22px;">Couldn't load bookings: ${escapeHtml(vidErr.message)}</div>`;
        return;
      }
      rows = (vid || []).map(normVid).concat((smm || []).map(normSmm));
      render();
      openFromUrl();

      // Messages + documents come through the Worker (service role + verified
      // session), so nothing is lost to an RLS or email-casing edge case.
      if (WORKER) {
        try {
          const res = await fetch(`${WORKER}/booking/mine`, { headers: { Authorization: 'Bearer ' + session.access_token } });
          if (res.ok) {
            const t = await res.json();
            // Belt and braces on top of the Worker's own filter: an internal
            // note must never render here, whatever the server sends.
            (t.messages || []).filter((m) => m.channel === 'email').forEach((m) => { const k = `${m.booking_source}:${m.booking_id}`; if (!msgsByKey.has(k)) msgsByKey.set(k, []); msgsByKey.get(k).push(m); });
            (t.documents || []).forEach((d) => { const k = `${d.booking_source}:${d.booking_id}`; if (!docsByKey.has(k)) docsByKey.set(k, []); docsByKey.get(k).push(d); });
            // The banner offers the prep document, and documents arrive after
            // the first paint — so the list has to be drawn again, not just an
            // open drawer refreshed.
            render();
            if (currentKey) openDetail(currentKey);
          }
        } catch (_) {}
        // Invoices come from their own route: the pay link has to be signed
        // server-side, and brand-billed bookings are filtered out there.
        try {
          const res = await fetch(`${WORKER}/booking/invoices/mine`, { headers: { Authorization: 'Bearer ' + session.access_token } });
          if (res.ok) {
            const t = await res.json();
            (t.invoices || []).forEach((iv) => {
              const k = `videography:${iv.booking_id}`;
              if (!invsByKey.has(k)) invsByKey.set(k, []);
              invsByKey.get(k).push(iv);
            });
            if (currentKey) openDetail(currentKey);
          }
        } catch (_) {}
      }
    })();

    function normVid(r) {
      return {
        source: 'videography', id: r.id, kind: r.kind, service: r.service || 'Videography booking',
        when: r.shoot_date, duration_min: r.duration_min || 60, stage: r.stage,
        location: bookingLocation({ service_type: r.service_type, source: 'videography', postcode: r.postcode }),
        total_pence: r.total_pence, surcharge_pence: r.surcharge_pence,
        add_ons: r.add_ons, package: r.package, service_type: r.service_type,
        reschedule_token: r.reschedule_token, client_name: r.client_name, client_email: r.client_email,
        client_phone: r.client_phone, signed_name: r.signed_name, signed_at: r.signed_at,
        notes: r.notes, created_at: r.created_at, discovery_interests: r.discovery_interests, canManageOnline: true,
        // These are selected above and were being dropped here, so the whole
        // "Your content" block — gallery, PIN, 360 tour — could never render:
        // it gates on r.gallery_url, which was always undefined.
        gallery_url: r.gallery_url, gallery_email: r.gallery_email, gallery_sent_at: r.gallery_sent_at,
        gallery_expires_on: r.gallery_expires_on, extra_link_label: r.extra_link_label,
        extra_link_url: r.extra_link_url, store_url: r.store_url,
        paid_at: r.paid_at, pin_released_at: r.pin_released_at, payment_route: r.payment_route,
        // One question for the gallery, the tour and the PIN alike. A package
        // shoot has no invoice and never gets a paid_at, but it is settled.
        settled: isSettled(r), packageCovered: isPackageCovered(r),
      };
    }
    function normSmm(r) {
      return {
        source: 'smm', id: r.id, kind: 'discovery', service: 'Social media discovery call',
        when: r.call_at, duration_min: r.duration_min || 30, stage: r.stage || 'discovery_call_booked',
        location: bookingLocation({ source: 'smm' }), total_pence: null, service_type: 'discovery',
        reschedule_token: r.reschedule_token, client_name: r.full_name, client_email: r.email,
        client_phone: r.phone, company: r.business, created_at: r.created_at, canManageOnline: false,
      };
    }

    // ---------- Render list ----------
    function render() {
      const now = Date.now();
      const up = [], past = [];
      for (const r of rows) {
        const ts = r.when ? new Date(r.when).getTime() : null;
        const isPast = r.stage === 'cancelled' || r.stage === 'delivered' || (ts != null && ts < now);
        (isPast ? past : up).push(r);
      }
      up.sort((a, b) => new Date(a.when || 0) - new Date(b.when || 0));
      past.sort((a, b) => new Date(b.when || 0) - new Date(a.when || 0));

      renderNext(up);
      const $up = $('bk-upcoming');
      if (!up.length) {
        $up.innerHTML = `<div class="bk-none"><p class="bk-none-h">Nothing upcoming</p><p class="bk-none-p">When you book a shoot or a call it will appear here. <a href="/videography">Browse videography &rarr;</a></p></div>`;
      } else {
        $up.innerHTML = up.map(cardHtml).join('');
      }
      // Previous bookings always show — with an empty state until a booking is done.
      $('bk-past').innerHTML = past.length
        ? past.map(cardHtml).join('')
        : `<div class="bk-none"><p class="bk-none-h">Nothing here yet</p><p class="bk-none-p">Once a shoot, session or call is done it moves here, so your history is always to hand.</p></div>`;
    }

    /* ---- The next shoot ----------------------------------------------------
       One booking gets pulled out of the list, because "when is my shoot and
       what do I need to do" is the question people actually arrive with. Only
       ever a shoot: a discovery call needs no preparation, so promoting one
       would be noise. */
    function renderNext(upcoming) {
      const el = $('bk-next');
      if (!el) return;
      const next = upcoming.find((r) => hasTrack(r) && r.when && r.stage !== 'cancelled');
      if (!next) { el.innerHTML = ''; return; }

      const ts = new Date(next.when).getTime();
      const days = Math.ceil((ts - Date.now()) / 86400000);
      const countdown = days <= 0 ? 'Today' : days === 1 ? 'Tomorrow' : `In ${days} days`;

      // The prep document, if one has been uploaded — surfaced here rather than
      // left three clicks away in Documents, which is the whole point of a
      // banner about the shoot you are about to have.
      const docs = docsByKey.get(keyOf(next)) || [];
      const prep = docs.find((d) => d.category === 'prep');

      const bits = [];
      if (next.location) bits.push(escapeHtml(next.location));
      if (next.package) bits.push(escapeHtml(next.package));
      if (next.duration_min) bits.push(`${next.duration_min} min`);

      el.innerHTML = `<div class="bk-next">
        <div class="bk-next-when">
          <span class="bk-next-count">${escapeHtml(countdown)}</span>
          <span class="bk-next-date">${escapeHtml(fmtWhen(next.when) || '')}</span>
        </div>
        <div class="bk-next-main">
          <h3 class="bk-next-title">${escapeHtml(next.service)}</h3>
          ${bits.length ? `<p class="bk-next-meta">${bits.join(' &middot; ')}</p>` : ''}
        </div>
        <div class="bk-next-acts">
          <button type="button" class="ws-btn ws-btn--primary" data-open="${escapeHtml(keyOf(next))}">View booking</button>
          ${prep ? `<button type="button" class="ws-btn" data-doc="${escapeHtml(prep.id)}" data-name="${escapeHtml(prep.file_name)}">How to prepare</button>` : ''}
        </div>
      </div>`;
    }

    function cardHtml(r) {
      const cancelled = r.stage === 'cancelled';
      const complete = r.stage === 'delivered';
      const when = fmtWhen(r.when);
      const pillCls = cancelled ? 'is-cancelled' : complete ? 'is-complete' : '';
      const label = memberStageLabel(r) || '—';
      const metaBits = [];
      if (r.location) metaBits.push(escapeHtml(r.location));
      // A package shoot has a total on the record — that is what it is worth to
      // us — but the client is not paying it, so a price here would read as a
      // bill they owe.
      if (r.packageCovered) metaBits.push('Included in your package');
      else if (r.total_pence != null) metaBits.push(gbpFromPence(r.total_pence) + ' inc. VAT');
      else if (r.service_type === 'discovery') metaBits.push('Complimentary');
      return `<div class="bk-card ${cancelled ? 'is-cancelled' : ''}" data-open="${escapeHtml(keyOf(r))}" role="button" tabindex="0">
        <div class="bk-card-main">
          <h3 class="bk-card-title">${escapeHtml(r.service)}</h3>
          <div class="bk-card-when">${when ? escapeHtml(when) : 'No date yet — enquiry'}</div>
          ${metaBits.length ? `<div class="bk-card-meta">${metaBits.join(' · ')}</div>` : ''}
        </div>
        <div class="bk-card-side">
          <span class="bk-pill ${pillCls}">${escapeHtml(label)}</span>
          <span class="bk-view-cue">View details &rarr;</span>
        </div>
      </div>`;
    }

    // ---------- Detail drawer ----------
    let currentKey = null;
    function openDetail(key) {
      const r = rows.find((x) => keyOf(x) === key); if (!r) return;
      currentKey = key;
      const now = Date.now();
      const ts = r.when ? new Date(r.when).getTime() : null;
      const cancelled = r.stage === 'cancelled';
      const complete = r.stage === 'delivered';
      const future = ts != null && ts > now;
      const days = ts != null ? (ts - now) / 86400000 : null;

      $('bk-detail-pill').className = 'bk-pill ' + (cancelled ? 'is-cancelled' : complete ? 'is-complete' : '');
      $('bk-detail-pill').textContent = memberStageLabel(r);
      $('bk-detail-title').textContent = r.service;
      let countdown = '';
      if (cancelled) countdown = 'This booking was cancelled.';
      else if (future && days != null) { const d = Math.ceil(days); countdown = d <= 0 ? 'Today' : d === 1 ? 'Tomorrow' : `In ${d} days`; }
      else if (ts != null && ts < now) countdown = 'Past booking';
      $('bk-detail-count').textContent = countdown;

      // ---- Facts ----
      const facts = [];
      if (r.when) facts.push(`<div class="bk-fact"><span>When</span><strong>${escapeHtml(fmtWhen(r.when))}</strong></div>`);
      facts.push(`<div class="bk-fact"><span>Duration</span><strong>${r.duration_min} min</strong></div>`);
      if (r.location) facts.push(`<div class="bk-fact"><span>Where</span><strong>${escapeHtml(r.location)}</strong></div>`);
      if (r.package) facts.push(`<div class="bk-fact"><span>Package</span><strong>${escapeHtml(r.package)}</strong></div>`);
      if (r.service_type === 'discovery' || r.source === 'smm') {
        facts.push(`<div class="bk-fact"><span>Cost</span><strong>Complimentary</strong></div>`);
      } else if (r.packageCovered) {
        facts.push(`<div class="bk-fact"><span>Cost</span><strong>Included in your package</strong></div>`);
        facts.push(`<div class="bk-fact bk-fact--note"><span></span><span>Covered by your social media management — there is nothing to pay for this shoot.</span></div>`);
      } else if (r.total_pence != null) {
        facts.push(`<div class="bk-fact"><span>Total</span><strong>${gbpFromPence(r.total_pence)} inc. VAT</strong></div>`);
        if (r.surcharge_pence) facts.push(`<div class="bk-fact bk-fact--sub"><span>Includes travel</span><span>${gbpFromPence(r.surcharge_pence)}</span></div>`);
        if (Array.isArray(r.add_ons) && r.add_ons.length) facts.push(`<div class="bk-fact bk-fact--sub"><span>Add-ons</span><span>${r.add_ons.map((a) => escapeHtml(a && a.name ? a.name : a)).join(', ')}</span></div>`);
        facts.push(`<div class="bk-fact bk-fact--note"><span></span><span>Invoiced on delivery</span></div>`);
      }

      // ---- What to expect ----
      const expect = (r.service_type === 'discovery' || r.source === 'smm')
        ? 'A relaxed video call, around 20–30 minutes. No pressure and no pitch — just a chat about your goals and where we can help.'
        : 'Your videographer will confirm the running order the day before. Please have access arranged and any spaces ready to shoot.';

      // ---- Actions ----
      const acts = [];
      const canResched = future && !cancelled && days != null && days >= 2 && r.reschedule_token && r.canManageOnline;
      const canCancel = future && !cancelled && days != null && days >= 3 && r.reschedule_token && r.canManageOnline;
      if (canResched) acts.push(`<button type="button" class="bk-btn bk-btn--primary" data-resched="${escapeHtml(r.reschedule_token)}" data-dur="${r.duration_min}" data-service="${escapeHtml(r.service)}">Reschedule</button>`);
      const ics = icsFor(r); if (ics && future && !cancelled) acts.push(`<a class="bk-btn" href="${ics}" download="tmke-booking.ics">Add to calendar</a>`);
      acts.push(`<a class="bk-btn" href="/account/contact">Ask about this booking</a>`);
      if (canCancel) acts.push(`<button type="button" class="bk-btn bk-btn--danger" data-cancel="${escapeHtml(r.reschedule_token)}">Cancel</button>`);
      let actNote = '';
      if (future && !cancelled && !r.canManageOnline) actNote = `<p class="bk-note" style="margin-top:8px">To move or cancel this call, use “Ask about this booking”.</p>`;
      else if (future && !cancelled && r.reschedule_token && days != null && days < 2) actNote = `<p class="bk-note" style="margin-top:8px">Within 48 hours — please contact us to make changes.</p>`;

      /* ---- Your content ----
         Two states, and the difference is payment. The PIN is deliberately not
         in the query above: it lives in a table no member can read, so it is
         fetched from the Worker and only once payment has landed. A client
         cannot reach it early by reading their own booking row. */
      const gallery = (r.gallery_url && r.gallery_sent_at) ? (() => {
        const links = [
          `<a class="bk-btn bk-btn--primary" href="${escapeHtml(r.gallery_url)}" target="_blank" rel="noopener">Open your gallery</a>`,
          r.extra_link_url ? `<a class="bk-btn" href="${escapeHtml(r.extra_link_url)}" target="_blank" rel="noopener">${escapeHtml(r.extra_link_label || 'Also for you')}</a>` : '',
          r.store_url ? `<a class="bk-btn" href="${escapeHtml(r.store_url)}" target="_blank" rel="noopener">Buy extra downloads</a>` : '',
        ].filter(Boolean).join('');
        const unlocked = !!r.settled;
        const expires = r.gallery_expires_on
          ? `<p class="bk-expect" style="margin-top:10px">Available until ${escapeHtml(new Date(r.gallery_expires_on + 'T12:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }))}.</p>`
          : '';
        return `<section class="bk-detail-block">
          <h3 class="bk-detail-h">Your content</h3>
          <div class="bk-detail-actions">${links}</div>
          <div class="bk-pin" id="bk-pin" data-booking="${escapeHtml(r.id)}" data-unlocked="${unlocked ? '1' : '0'}">
            ${unlocked
              ? `<span class="bk-pin-label">Download PIN</span><strong class="bk-pin-value is-hidden" id="bk-pin-value">••••••</strong><button type="button" class="bk-reveal" id="bk-pin-reveal" aria-pressed="false">Reveal</button>`
              : `<span class="bk-pin-label">Downloads locked</span><span class="bk-pin-note">Your gallery is watermarked until payment reaches us. Your PIN follows automatically as soon as it does.</span>`}
          </div>
          <div class="bk-tour" id="bk-tour" data-booking="${escapeHtml(r.id)}" data-unlocked="${unlocked ? '1' : '0'}">
            ${unlocked
              ? `<span class="bk-tour-label">360 Tour</span><span class="bk-tour-note">Checking…</span>`
              : `<span class="bk-tour-label">360 Tour</span><span class="bk-tour-note">If one's included with your booking, it follows automatically with your PIN once payment reaches us.</span>`}
          </div>
          ${expires}
        </section>`;
      })() : '';

      // ---- Messages + documents ----
      const msgs = msgsByKey.get(key) || [];
      const docs = docsByKey.get(key) || [];

      $('bk-detail-body').innerHTML = `
        ${trackHtml(r)}
        <section class="bk-detail-block"><div class="bk-facts">${facts.join('')}</div></section>
        ${!cancelled ? `<section class="bk-detail-block"><h3 class="bk-detail-h">What to expect</h3><p class="bk-expect">${escapeHtml(expect)}</p></section>` : ''}
        ${gallery}
        <section class="bk-detail-block"><h3 class="bk-detail-h">Manage</h3><div class="bk-detail-actions">${acts.join('')}</div>${actNote}</section>
        ${renderInvoices(r, invsByKey.get(key) || [])}
        <section class="bk-detail-block"><h3 class="bk-detail-h">Messages</h3>${renderMessages(msgs)}</section>
        <section class="bk-detail-block"><h3 class="bk-detail-h">Documents</h3>${renderDocs(r, docs)}</section>
      `;
      $('bk-detail').hidden = false;
      document.body.style.overflow = 'hidden';
      loadPin();
      loadTour();
    }
    // The PIN is never in the page's data - it is asked for, once the drawer is
    // open, and only for a booking that has been paid for.
    async function loadPin() {
      const el = $('bk-pin');
      if (!el || el.getAttribute('data-unlocked') !== '1') return;
      const valueEl = el.querySelector('.bk-pin-value');
      const btn = $('bk-pin-reveal');
      if (!valueEl) return;
      // Anything other than a real PIN is said plainly and the Reveal goes
      // away: a button that uncovers the word "Ask us" is just a tease.
      const fail = (msg) => { valueEl.classList.remove('is-hidden'); valueEl.textContent = msg; if (btn) btn.hidden = true; };
      // No Worker configured is still a failure to the person looking at it —
      // returning early here would leave dots and a Reveal that does nothing.
      if (!WORKER) return fail('Ask us');
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return fail('Sign in again to see this');
        const res = await fetch(`${WORKER}/videography/my-pin?booking_id=${encodeURIComponent(el.getAttribute('data-booking'))}`, {
          headers: { Authorization: 'Bearer ' + session.access_token },
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok || !d.paid) return fail('—');
        if (!d.pin) return fail('Ask us');
        // Held on the element so Reveal costs nothing. To be clear about what
        // this is: once fetched the PIN IS in the page, attribute or not. The
        // mask is presentation, not protection — the protection is that the
        // Worker refuses to send a PIN at all until the booking is settled.
        el.setAttribute('data-pin', d.pin);
        valueEl.textContent = '\u2022'.repeat(Math.max(4, String(d.pin).length));
      } catch (_) { fail('Ask us'); }
    }

    /* The banking-app gesture: covered until you ask. It is a nicety, not a
       lock — the real gate is that the Worker will not return a PIN at all
       until the booking is settled, so there is nothing here to reveal early. */
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('#bk-pin-reveal');
      if (!btn) return;
      const el = $('bk-pin');
      const valueEl = el && el.querySelector('.bk-pin-value');
      const pin = el && el.getAttribute('data-pin');
      if (!valueEl || !pin) return;
      const shown = !valueEl.classList.contains('is-hidden');
      valueEl.classList.toggle('is-hidden', shown);
      valueEl.textContent = shown ? '\u2022'.repeat(Math.max(4, pin.length)) : pin;
      btn.textContent = shown ? 'Reveal' : 'Hide';
      btn.setAttribute('aria-pressed', shown ? 'false' : 'true');
    });
    // Same rule as the PIN, same reason: not in the page's data, asked for
    // once the drawer is open and only once paid. Not every booking has a
    // tour, so an unlocked booking with none just quietly disappears rather
    // than showing an empty promise.
    async function loadTour() {
      const el = $('bk-tour');
      if (!el) return;
      if (el.getAttribute('data-unlocked') !== '1') return;
      const noteEl = el.querySelector('.bk-tour-note');
      if (!noteEl) return;
      // A row that says "Checking…" forever is worse than no row: most
      // bookings have no tour, and the absent case is already hidden below.
      if (!WORKER) { el.hidden = true; return; }
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) { noteEl.textContent = 'Sign in again to see this'; return; }
        const res = await fetch(`${WORKER}/videography/my-tour?booking_id=${encodeURIComponent(el.getAttribute('data-booking'))}`, {
          headers: { Authorization: 'Bearer ' + session.access_token },
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok || !d.paid || !d.url) { el.hidden = true; return; }
        noteEl.outerHTML = `<a class="bk-tour-link" href="${escapeHtml(d.url)}" target="_blank" rel="noopener">Open your 360 tour</a>`;
      } catch (_) { el.hidden = true; }
    }

    function closeDetail() { $('bk-detail').hidden = true; currentKey = null; document.body.style.overflow = ''; }

    function renderMessages(list) {
      if (!list.length) return `<p class="bk-empty">No messages yet. Booking confirmations and any updates from the team will appear here.</p>`;
      return `<ul class="bk-thread">` + list.map((m) => {
        const out = m.direction !== 'inbound';
        const who = out ? (m.is_automated ? 'TMKE · automated' : (m.created_by && m.created_by !== 'system' ? m.created_by : 'TMKE')) : 'You';
        return `<li class="bk-msg ${out ? 'is-out' : 'is-in'}">
          <div class="bk-msg-meta"><strong>${escapeHtml(who)}</strong><span>${escapeHtml(fmtWhen(m.created_at) || '')}</span></div>
          ${m.subject ? `<div class="bk-msg-subj">${escapeHtml(m.subject)}</div>` : ''}
          <div class="bk-msg-body">${escapeHtml(m.body || '').replace(/\n/g, '<br>')}</div>
        </li>`;
      }).join('') + `</ul>`;
    }

    /* ---- Invoicing --------------------------------------------------------
       Three shapes, and which one you get is decided by the payment route
       rather than by anything on screen:
         · covered by a package  — nothing to pay, said plainly
         · billed to a brand     — nothing at all, the route filters it out
         · billed to the client  — the invoice, and a way to settle it

       The pay link is the same signed URL that goes in the invoice email, so
       this is a second door onto one Stripe checkout, not a parallel path. */
    function renderInvoices(r, list) {
      if (r.packageCovered) {
        return `<section class="bk-detail-block"><h3 class="bk-detail-h">Invoicing</h3>
          <p class="bk-expect">Included in your social media package — there is nothing to pay for this shoot.</p></section>`;
      }
      if (!list.length) return '';
      const rows = list.map((iv) => {
        const paid = iv.status === 'paid';
        const when = paid
          ? `Paid${iv.paid_date ? ' ' + fmtDate(iv.paid_date) : ''}`
          : (iv.due_date ? `Due ${fmtDate(iv.due_date)}` : 'Due on receipt');
        // The pay button only exists while there is something to pay; once it
        // is settled the row says so and the button goes.
        const pay = (!paid && iv.pay_url)
          ? `<a class="bk-btn bk-btn--primary" href="${escapeHtml(iv.pay_url)}">Pay now</a>` : '';
        return `<div class="bk-inv ${paid ? 'is-paid' : ''}">
          <div class="bk-inv-main">
            <strong>${escapeHtml(iv.number || 'Invoice')}</strong>
            <span>${escapeHtml(when)}</span>
          </div>
          <div class="bk-inv-side">
            <span class="bk-inv-total">${gbpFromPence(iv.total_pence || 0)}</span>
            <span class="bk-inv-state ${paid ? 'is-paid' : ''}">${paid ? 'Paid' : 'Outstanding'}</span>
          </div>
          ${pay}
        </div>`;
      }).join('');
      const owing = list.some((iv) => iv.status !== 'paid');
      return `<section class="bk-detail-block"><h3 class="bk-detail-h">Invoicing</h3>${rows}
        ${owing ? `<p class="bk-expect" style="margin-top:10px">Your gallery, 360 tour and download PIN unlock automatically as soon as payment reaches us — by card or by bank transfer.</p>` : ''}
      </section>`;
    }

    function renderDocs(r, list) {
      const out = [];
      if (r.signed_at || r.signed_name) {
        out.push(`<div class="bk-doc is-agreement"><div class="bk-doc-ic">✓</div><div class="bk-doc-main"><strong>Service Agreement</strong><span>Signed by ${escapeHtml(r.signed_name || r.client_name || 'you')}${r.signed_at ? ' · ' + fmtDate(r.signed_at) : ''}</span></div><button type="button" class="bk-btn" data-agreement="${escapeHtml(r.service_type || '')}" data-signer="${escapeHtml(r.signed_name || r.client_name || '')}" data-signed="${escapeHtml(r.signed_at || '')}">View</button></div>`);
      }
      list.forEach((d) => {
        out.push(`<div class="bk-doc"><div class="bk-doc-ic">${CAT_ICON[d.category] || '📄'}</div><div class="bk-doc-main"><strong>${escapeHtml(d.title || d.file_name)}</strong><span>${escapeHtml(CAT_LABEL[d.category] || 'Document')}${d.size_bytes ? ' · ' + fmtBytes(d.size_bytes) : ''}</span></div><button type="button" class="bk-btn" data-doc="${escapeHtml(d.id)}" data-name="${escapeHtml(d.file_name)}">Download</button></div>`);
      });
      if (!out.length) return `<p class="bk-empty">No documents yet. Your agreement, prep notes, invoice and delivered files will appear here as your booking progresses.</p>`;
      return out.join('');
    }

    function icsFor(r) {
      if (!r.when) return null;
      const dt = new Date(r.when); if (isNaN(dt)) return null;
      const end = new Date(dt.getTime() + (r.duration_min || 60) * 60000);
      const fmt = (d) => d.toISOString().replace(/[-:]/g, '').replace(/\.\d{3}/, '');
      const lines = ['BEGIN:VCALENDAR', 'VERSION:2.0', 'PRODID:-//TMKE//Bookings//EN', 'BEGIN:VEVENT',
        'UID:' + (r.id || 'bk') + '@tmke.co.uk', 'DTSTAMP:' + fmt(new Date()), 'DTSTART:' + fmt(dt), 'DTEND:' + fmt(end),
        'SUMMARY:' + (r.service || 'TMKE booking'), r.location ? 'LOCATION:' + r.location : '', 'END:VEVENT', 'END:VCALENDAR'].filter(Boolean);
      return 'data:text/calendar;charset=utf-8,' + encodeURIComponent(lines.join('\r\n'));
    }

    // ---------- Service-agreement modal ----------
    const TERMS_DATA = (() => { try { return JSON.parse(document.getElementById('tmke-terms').textContent); } catch (_) { return { note: '', byService: {} }; } })();
    const TERMS_KEY = { content: 'content-studio', 'content-studio': 'content-studio', property: 'property', agent: 'agent' };
    function openAgreement(serviceType, signer, signed) {
      const t = TERMS_DATA.byService || {};
      const terms = t[TERMS_KEY[serviceType]] || t[serviceType] || t.property || null;
      $('bk-agree-title').textContent = (terms && terms.title) || 'Service Agreement';
      $('bk-agree-signed').textContent = signer ? `Signed by ${signer}${signed ? ' · ' + fmtDate(signed) : ''}` : '';
      $('bk-agree-body').innerHTML = terms && terms.clauses
        ? terms.clauses.map((c, i) => `<div class="bk-clause"><h4>${i + 1}. ${escapeHtml(c.h)}</h4><p>${c.p}</p></div>`).join('')
        : `<p class="bk-empty">Agreement terms are unavailable — please contact us for a copy.</p>`;
      $('bk-agree-note').textContent = TERMS_DATA.note || '';
      $('bk-agree').hidden = false;
      document.body.style.overflow = 'hidden';
    }
    function closeAgreement() { $('bk-agree').hidden = true; document.body.style.overflow = currentKey ? 'hidden' : ''; }
    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-agreement]'); if (!btn) return;
      openAgreement(btn.getAttribute('data-agreement'), btn.getAttribute('data-signer'), btn.getAttribute('data-signed'));
    });
    $('bk-agree-close')?.addEventListener('click', closeAgreement);
    $('bk-agree')?.addEventListener('click', (e) => { if (e.target === $('bk-agree')) closeAgreement(); });

    // Deep link from a notification: /account/bookings?open=<source>:<id>
    function openFromUrl() {
      try {
        const p = new URLSearchParams(location.search).get('open');
        if (p && rows.some((r) => keyOf(r) === p)) openDetail(p);
      } catch (_) {}
    }

    // Open detail (click or keyboard).
    document.addEventListener('click', (e) => {
      const card = e.target.closest('[data-open]'); if (!card) return;
      openDetail(card.getAttribute('data-open'));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$('bk-detail').hidden) { closeDetail(); return; }
      const card = e.target.closest?.('[data-open]');
      if (card && (e.key === 'Enter' || e.key === ' ')) { e.preventDefault(); openDetail(card.getAttribute('data-open')); }
    });
    $('bk-detail-close')?.addEventListener('click', closeDetail);
    $('bk-detail')?.addEventListener('click', (e) => { if (e.target === $('bk-detail')) closeDetail(); });

    // ---------- Document download (ownership-checked Worker endpoint) ----------
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-doc]'); if (!btn) return;
      const id = btn.getAttribute('data-doc');
      const name = btn.getAttribute('data-name') || 'document';
      if (String(id).startsWith('demo')) { alert('This is a sample document — real files download once your booking is delivered.'); return; }
      if (!WORKER) { alert('Downloads are being set up — please email hello@tmke.co.uk.'); return; }
      const { data: { session } } = await supabase.auth.getSession();
      const token = session?.access_token;
      btn.disabled = true; const t = btn.textContent; btn.textContent = '…';
      try {
        const res = await fetch(`${WORKER}/booking/document?id=${encodeURIComponent(id)}`, { headers: token ? { Authorization: 'Bearer ' + token } : {} });
        if (!res.ok) throw new Error('Download failed');
        const blob = await res.blob();
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a'); a.href = url; a.download = name; document.body.appendChild(a); a.click(); a.remove();
        URL.revokeObjectURL(url);
      } catch (_) { alert('Could not download — please try again.'); }
      finally { btn.disabled = false; btn.textContent = t; }
    });

    // ---------- Cancel ----------
    document.addEventListener('click', async (e) => {
      const btn = e.target.closest('[data-cancel]'); if (!btn) return;
      const token = btn.getAttribute('data-cancel');
      if (!confirm('Cancel this booking? This frees the slot and emails you a confirmation.')) return;
      if (!WORKER) { alert('Booking management is being set up — please email hello@tmke.co.uk.'); return; }
      btn.disabled = true; btn.textContent = 'Cancelling…';
      try {
        const res = await fetch(`${WORKER}/videography/cancel`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token }) });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || 'Could not cancel');
        const row = rows.find((r) => r.reschedule_token === token); if (row) row.stage = 'cancelled';
        render();
        if (currentKey) openDetail(currentKey);
      } catch (err) { alert(err.message || 'Could not cancel — please try again.'); btn.disabled = false; btn.textContent = 'Cancel'; }
    });

    // ---------- Reschedule modal ----------
    let rsToken = null, rsDur = 60, rsService = '', viewMonth = new Date(); viewMonth.setDate(1);
    let availWeekdays = null, configFetched = false;
    const MONTHS = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];
    const sameDay = (a, b) => a && b && a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();

    async function fetchConfig() {
      if (configFetched || !WORKER) return; configFetched = true;
      try { const r = await fetch(`${WORKER}/ms/config`); if (r.ok) { const d = await r.json(); if (d && d.weekdays) availWeekdays = new Set(Object.keys(d.weekdays).map(Number)); } } catch (_) {}
    }

    document.addEventListener('click', (e) => {
      const btn = e.target.closest('[data-resched]'); if (!btn) return;
      rsToken = btn.getAttribute('data-resched');
      rsDur = parseInt(btn.getAttribute('data-dur') || '60', 10);
      rsService = btn.getAttribute('data-service') || 'Booking';
      $('bk-resched-title').textContent = 'Reschedule';
      $('bk-resched-sub').textContent = `${rsService} — pick a new day.`;
      $('bk-resched-error').hidden = true;
      $('bk-resched-slots-wrap').hidden = true;
      $('bk-resched-cal-wrap').hidden = false;
      viewMonth = new Date(); viewMonth.setDate(1);
      $('bk-resched').hidden = false;
      fetchConfig().then(renderCal); renderCal();
    });
    $('bk-resched-close')?.addEventListener('click', () => { $('bk-resched').hidden = true; });
    $('bk-resched')?.addEventListener('click', (e) => { if (e.target === $('bk-resched')) $('bk-resched').hidden = true; });
    $('bk-slots-back')?.addEventListener('click', () => { $('bk-resched-slots-wrap').hidden = true; $('bk-resched-cal-wrap').hidden = false; });
    $('bk-prev-month')?.addEventListener('click', () => { viewMonth.setMonth(viewMonth.getMonth() - 1); renderCal(); });
    $('bk-next-month')?.addEventListener('click', () => { viewMonth.setMonth(viewMonth.getMonth() + 1); renderCal(); });

    function renderCal() {
      const label = $('bk-cal-label'), grid = $('bk-cal-grid'); if (!grid) return;
      label.textContent = `${MONTHS[viewMonth.getMonth()]} ${viewMonth.getFullYear()}`;
      const first = new Date(viewMonth), off = (first.getDay() + 6) % 7;
      const gs = new Date(first); gs.setDate(first.getDate() - off);
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const minDate = new Date(today); minDate.setDate(today.getDate() + 2);
      const cells = [];
      for (let i = 0; i < 42; i++) {
        const d = new Date(gs); d.setDate(gs.getDate() + i);
        const inM = d.getMonth() === viewMonth.getMonth();
        const tooSoon = d < minDate;
        const closed = availWeekdays ? !availWeekdays.has(d.getDay()) : (d.getDay() === 0 || d.getDay() === 6);
        const cl = ['dc-cal-day']; if (!inM) cl.push('is-other-month'); if (sameDay(d, today)) cl.push('is-today');
        cells.push(`<button type="button" class="${cl.join(' ')}" data-date="${localISO(d)}" ${tooSoon || closed ? 'disabled' : ''}>${d.getDate()}</button>`);
      }
      grid.innerHTML = cells.join('');
    }

    $('bk-cal-grid')?.addEventListener('click', async (e) => {
      const btn = e.target.closest('.dc-cal-day'); if (!btn || btn.hasAttribute('disabled')) return;
      const date = btn.dataset.date;
      $('bk-resched-cal-wrap').hidden = true;
      $('bk-resched-slots-wrap').hidden = false;
      const sub = $('bk-slots-sub'), grid = $('bk-slots-grid');
      const dt = new Date(date + 'T12:00:00').toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long' });
      sub.textContent = `${dt} — choose a time`;
      grid.innerHTML = `<p class="dc-slots-empty">Finding times…</p>`;
      if (!WORKER) { grid.innerHTML = `<p class="dc-slots-empty">Booking management isn't live yet.</p>`; return; }
      try {
        const res = await fetch(`${WORKER}/ms/availability?date=${date}&duration=${rsDur}`);
        const d = await res.json(); if (!res.ok) throw new Error(d.error || 'error');
        if (!d.slots || !d.slots.length) { grid.innerHTML = `<p class="dc-slots-empty">No times that day — try another.</p>`; return; }
        grid.innerHTML = d.slots.map((s) => `<button type="button" class="dc-slot" data-slot="${s}" data-date="${date}">${s}</button>`).join('');
      } catch (_) { grid.innerHTML = `<p class="dc-slots-empty">Couldn't load times. Try again.</p>`; }
    });

    $('bk-slots-grid')?.addEventListener('click', async (e) => {
      const btn = e.target.closest('.dc-slot'); if (!btn) return;
      const date = btn.dataset.date, start = btn.dataset.slot;
      const err = $('bk-resched-error'); err.hidden = true;
      btn.disabled = true; btn.textContent = '…';
      try {
        const res = await fetch(`${WORKER}/videography/reschedule`, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ token: rsToken, date, start }) });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || 'Could not reschedule');
        const row = rows.find((r) => r.reschedule_token === rsToken); if (row) row.when = `${date}T${start}:00`;
        $('bk-resched').hidden = true;
        render();
        if (currentKey) openDetail(currentKey);
      } catch (e2) { err.textContent = e2.message || 'Could not reschedule — try another time.'; err.hidden = false; btn.disabled = false; btn.textContent = start; }
    });

    // ---------- Demo data (preview only, no Supabase session) ----------
    function seedDemo() {
