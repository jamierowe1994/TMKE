---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import HubFootBar from "../../components/account/HubFootBar.astro";
import ContactPanel from "../../components/account/ContactPanel.astro";
import "../../styles/workspace.css";
import "../../styles/account-sections.css";
---
<!-- The Help Centre (Dani, 17 Oct): the lines they can raise a request on,
     each with its own form. It was at /account/contact, which is now the
     plain contact page. -->

<BaseLayout
  dashboard
  title="Help Centre — TMKE workspace"
  description="Pick the right line and reach the right inbox — pack support, managed socials, billing, feedback, press."
  hideNav
  hideFooter
>
  <WorkspaceHeader active="help" />
  <div class="dash-shell dash-shell--top">
    <main class="app-main dash-main">
      <!-- The flat header every hub page has (Dani, 17 Oct): the panel's own
           head was a different face and size. -->
      <section class="hc-hero">
        <p class="hc-hero-eyebrow"><a href="/account" class="hc-hero-back">&larr; Workspace</a></p>
        <h1 class="hc-hero-title">How can we help?</h1>
        <p class="hc-hero-lede">Pick the line that fits and it reaches the right inbox &mdash; most replies within one working day.</p>
      </section>
      <ContactPanel hideHead />
      <HubFootBar />
    </main>
  </div>

  <style is:global>
    body[data-dashboard] .dash-shell .dash-main { padding: calc(clamp(52px, 6.8vh, 92px) + 10px) clamp(22px, 2.6vw, 56px) 80px; gap: clamp(36px, 4.6vh, 64px); }
    .hc-hero { margin: 0; }
    .hc-hero-eyebrow { margin: 0; padding-bottom: clamp(16px, 2.2vh, 26px); font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.46); }
    .hc-hero-back { color: inherit; text-decoration: none; transition: color 0.2s; }
    .hc-hero-back:hover { color: var(--ink); }
    .hc-hero-title { font-family: var(--subhead); font-weight: 500; font-size: clamp(32px, 3.6vw, 52px); line-height: 1.08; letter-spacing: -0.02em; margin: 0; color: var(--ink); }
    .hc-hero-lede { font-family: var(--sans); font-size: 15.5px; line-height: 1.55; color: rgba(28,29,34,0.64); margin: clamp(8px, 1vh, 12px) 0 0; max-width: 75%; }
    @media (max-width: 760px) { .hc-hero-lede { max-width: none; } }
  </style>

  <script>
    import { supabase, signOutEverywhere} from "../../lib/supabase.js";
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        if (!import.meta.env.DEV) location.replace('/login?next=' + encodeURIComponent('/account/help'));
        return;
      }
      // getSession() is local-only - a cleared/revoked session can still look
      // valid to it. Confirm with the server before letting anyone in.
      if (!import.meta.env.DEV) {
        const { data: { user }, error } = await supabase.auth.getUser();
        if (!user || error) { location.replace('/login?next=' + encodeURIComponent('/account/help')); return; }
      }
      requestAnimationFrame(() => document.body.classList.add('is-loaded'));
      document.getElementById('app-signout')?.addEventListener('click', async () => {
        await signOutEverywhere();
      });
    })();
  </script>
</BaseLayout>
