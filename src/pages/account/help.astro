---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import HubFootBar from "../../components/account/HubFootBar.astro";
import ContactPanel from "../../components/account/ContactPanel.astro";
import "../../styles/workspace.css";
import "../../styles/ws-system.css";
import "../../styles/account-sections.css";
---
<!-- The Help Centre (Dani, 17 Oct): the lines they can raise a request on,
     each with its own form. It was at /account/contact, which is now the
     plain contact page. -->

<BaseLayout
  dashboard
  title="Help Centre — TMKE workspace"
  description="Pick the right line and reach the right inbox — pack support, managed socials, billing, feedback, press."
  hideNav
  hideFooter
>
  <!-- The dashboard's page (Dani, 17 Oct, "align to the dashboard"): the flat
       header, a wine chapter bar, the cards 10px apart in the brand tints. -->
  <div class="ws">
    <WorkspaceHeader active="help" />
    <main class="ws-main">
      <div class="ws-left">
        <section class="ws-hero ws-hero--sub">
          <div class="ws-hero-copy">
            <p class="ws-hero-date"><a href="/account" class="hc-back">&larr; Workspace</a></p>
            <h1 class="ws-greeting">How can we help?</h1>
            <p class="ws-hero-sub">Pick the line that fits and it reaches the right inbox, with your account details attached. Most replies within one working day.</p>
          </div>
        </section>
        <section class="ws-block" aria-labelledby="hc-lines-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="hc-lines-h"><span class="ws-block-ch">Chapter 01</span>Help Centre</h2>
            <a class="ws-block-link" href="/account/contact">Contact us
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </header>
          <ContactPanel hideHead />
        </section>
        <HubFootBar />
      </div>
    </main>
  </div>

  <style is:global>
    .hc-back { color: inherit; text-decoration: none; }
  </style>

  <script>
    import { supabase, signOutEverywhere} from "../../lib/supabase.js";
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        if (!import.meta.env.DEV) location.replace('/login?next=' + encodeURIComponent('/account/help'));
        return;
      }
      // getSession() is local-only - a cleared/revoked session can still look
      // valid to it. Confirm with the server before letting anyone in.
      if (!import.meta.env.DEV) {
        const { data: { user }, error } = await supabase.auth.getUser();
        if (!user || error) { location.replace('/login?next=' + encodeURIComponent('/account/help')); return; }
      }
      requestAnimationFrame(() => document.body.classList.add('is-loaded'));
      document.getElementById('app-signout')?.addEventListener('click', async () => {
        await signOutEverywhere();
      });
    })();
  </script>
</BaseLayout>
