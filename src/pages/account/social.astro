---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import "../../styles/workspace.css";
import "../../styles/ws-system.css";
import "../../styles/account-sections.css";
import { SOCIAL_SERVICES, SOCIAL_EXTRAS, PRICE_NOTE, BROCHURE_URL } from "../../lib/smm-config.js";
import { gbpFromPence } from "../../lib/supabase.js";
---

<!--
  Your SMM — the last member tab still on the old dashboard chrome. Rebuilt onto
  the shared hub system (ws-system.css): wine chapter strips, hairline square
  cards, one --ws-gap. Nothing about what the page DOES changes; the report
  renderers, the visibility rules and the worker fetch are untouched.

  The report's own furniture (.ri-*) comes out of lib/report-insights.js, which
  the admin Insights view shares. Those classes are styled here, in the member's
  own vocabulary — admin keeps its copy, so the two can look like the places
  they live without fighting over one stylesheet.
-->
<BaseLayout title="Your SMM · TMKE" description="Your social media management, your plan and your monthly performance." dashboard hideNav hideFooter>
  <div class="ws">
    <WorkspaceHeader active="social" />
    <main class="ws-main">
      <div class="ws-left">

        <!-- ============ HERO ============ -->
        <section class="ws-hero ws-hero--sub soc-hero">
          <div class="ws-hero-copy">
            <p class="ws-hero-date"><a href="/account" class="back-link">&larr; Workspace</a></p>
            <h1 class="ws-greeting">Your Socials.</h1>
            <p class="ws-hero-sub">View your social media plan and see how your accounts are performing month by month.</p>
          </div>
          <div class="ws-hero-photo" role="img" aria-label="A styled interior"></div>
        </section>

        <p id="soc-loading" class="soc-state">Loading your social media&hellip;</p>

        <!-- ============ Not a managed-social client ============
             What this page is for when there is no account behind it: the two
             services, in TMKE's own words, with real prices. It used to be one
             card apologising for being empty, above a "See the plans" button
             that led to three invented tiers at two to five times the actual
             cost. -->
        <div id="soc-noclient" hidden>
          <!-- Above the first chapter, in a card of its own: it is the answer to
               "why is this page empty", and inside the chapter it read as a
               caption to the two services rather than as the thing to read
               first. -->
          <div class="soc-card soc-lede-card ws-rise" style="--i:0">
            <p class="soc-lede"><strong>You&rsquo;re not on a social plan with us yet.</strong> There are two ways we run social for estate agents &mdash; one where we take the whole thing off your hands, and one where we handle the video.</p>
            <!-- The services brochure, opened in the browser's own PDF viewer
                 rather than saved: they're signed in, so no form, and from the
                 viewer they can read it or download it as they like. -->
            <a class="ws-btn ws-btn--ghost soc-lede-cta" href={BROCHURE_URL} target="_blank" rel="noopener">View services</a>
          </div>

          <section class="ws-block ws-rise" style="--i:1" aria-labelledby="soc-svc-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-svc-h"><span class="ws-block-ch">Chapter 01</span>Social, handled</h2>
              <a class="ws-block-link" href="/account/contact">Talk to us
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </header>

            <div class="soc-svc-grid">
              {SOCIAL_SERVICES.map((sv) => (
                <article class="soc-svc">
                  <p class="soc-svc-strap">{sv.strap}</p>
                  <h3 class="soc-svc-name">{sv.name}</h3>
                  <p class="soc-svc-sum">{sv.summary}</p>
                  <p class="soc-svc-blurb">{sv.blurb}</p>
                  <ul class="soc-svc-list">
                    {sv.includes.map((it) => <li>{it}</li>)}
                  </ul>
                  {sv.note && <p class="soc-svc-note">{sv.note}</p>}
                  {!sv.openToNewClients && (
                    <p class="soc-svc-wait">We&rsquo;re not taking on new social media management clients right now. Join the waitlist and we&rsquo;ll be in touch when a space opens up.</p>
                  )}
                  <div class="soc-svc-foot">
                    <div class="soc-price">
                      <span class="soc-price-tag">Prices</span>
                      <span class="soc-price-val">from {gbpFromPence(sv.from_pence)}</span>
                      <span class="soc-price-unit">+VAT / {sv.unit}</span>
                    </div>
                    {sv.openToNewClients
                      ? <a class="ws-btn ws-btn--primary" href={`/account/contact?from=${sv.key}`}>Talk to us</a>
                      : <button type="button" class="ws-btn ws-btn--primary" data-smm-form="waitlist">Join the waitlist</button>}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="ws-block ws-rise" style="--i:2" aria-labelledby="soc-extra-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-extra-h"><span class="ws-block-ch">Chapter 02</span>Also on social</h2>
            </header>
            <div class="soc-extra-grid">
              {SOCIAL_EXTRAS.map((sv) => (
                <article class="soc-extra">
                  <h3 class="soc-extra-name">{sv.name}</h3>
                  <p class="soc-extra-sum">{sv.summary}</p>
                  <div class="soc-price soc-price--sm">
                    <span class="soc-price-tag">Prices</span>
                    <span class="soc-price-val">from {gbpFromPence(sv.from_pence)}</span>
                    <span class="soc-price-unit">+VAT / {sv.unit}</span>
                  </div>
                </article>
              ))}
            </div>
            <p class="soc-price-note">{PRICE_NOTE}</p>
          </section>
        </div>

        <!-- ============ Managed-social client ============ -->
        <div id="soc-client" hidden>

          <!-- Chapter 01 — what you are on -->
          <section class="ws-block ws-rise" style="--i:1" aria-labelledby="soc-plan-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-plan-h"><span class="ws-block-ch">Chapter 01</span>Your plan</h2>
              <!-- Filled by renderPlan(). The strip carries the status so the
                   card below holds only the facts. -->
              <span class="ws-block-status" id="soc-status" hidden></span>
            </header>
            <div class="soc-card" id="soc-plan"></div>
          </section>

          <!-- Chapter 02 — the monthly report -->
          <section class="ws-block ws-rise" style="--i:2" aria-labelledby="soc-perf-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-perf-h"><span class="ws-block-ch">Chapter 02</span>Monthly performance</h2>
            </header>
            <div class="soc-card soc-report">
              <div id="soc-insights"><p class="soc-state">Your first monthly report will appear here once we&rsquo;ve published it.</p></div>
            </div>
          </section>

          <!-- Chapter 03 — the people behind it -->
          <section class="ws-block ws-rise" style="--i:3" aria-labelledby="soc-team-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-team-h"><span class="ws-block-ch">Chapter 03</span>Your social team</h2>
            </header>
            <div class="soc-card soc-contact">
              <div>
                <h3 class="soc-contact-h">Questions about your social?</h3>
                <p class="soc-contact-p">Your TMKE social team is here to help, from content ideas to the numbers above.</p>
              </div>
              <a class="ws-btn ws-btn--primary" href="/account/contact">Contact your team</a>
            </div>
          </section>

        </div>
      </div>

      <footer class="app-foot dash-foot">
        <div class="app-foot-block">
          <div class="app-foot-tag">Help</div>
          <a href="/contact">hello@tmke.co.uk</a>
        </div>
        <div class="app-foot-block app-foot-block--right">
          <strong id="footer-email" class="dash-foot-email">&hellip;</strong>
        </div>
      </footer>
    </main>

  <!-- A confirmation, not a form. Everyone here is signed in and has already
       given us their name, business and email — asking for them again is a
       worse experience AND a second copy of the truth to reconcile. The Worker
       reads them from the account, so this only has to ask. -->
  <div class="soc-wl-scrim" id="soc-wl" hidden>
    <div class="soc-wl-card" role="dialog" aria-modal="true" aria-labelledby="soc-wl-h">
      <button type="button" class="soc-wl-x" id="soc-wl-x" aria-label="Close">&times;</button>
      <p class="soc-wl-eyebrow">TMKE &mdash; Social Media</p>
      <h2 class="soc-wl-h" id="soc-wl-h">Join the waitlist.</h2>
      <p class="soc-wl-lead">We&rsquo;re not taking on new social media management clients right now. We&rsquo;ll be in touch when a space opens up.</p>

      <dl class="soc-wl-you" id="soc-wl-you"></dl>
      <p class="soc-wl-note">We&rsquo;ll use the details on your account. <a href="/account/profile">Update them &rarr;</a></p>

      <label class="soc-wl-check"><input type="checkbox" id="soc-wl-optin" /> <span>Sign me up to the TMKE newsletter and marketing emails</span></label>

      <p class="soc-wl-error" id="soc-wl-error" hidden></p>
      <button type="button" class="ws-btn ws-btn--primary soc-wl-go" id="soc-wl-go">Yes, add me to the waitlist</button>
      <button type="button" class="soc-wl-cancel" id="soc-wl-cancel">Not now</button>
    </div>
  </div>

  </div>

  <style is:global>
    /* The wine the takeaways panel uses. The hub theme resolves
       --english-violet to the BROWN, so the wine is carried as its own token. */
    #soc-client, #soc-noclient { --violet-rgb: 55,30,40; }
    .soc-hero { --ws-hero-img: url('/assets/personal-brand.jpg'); }

    /* Chapters are siblings in one column, spaced like every other hub page.
       Scoped to :not([hidden]) because a bare `display:flex` on the id beats
       the hidden attribute — which would show the empty scaffolding to
       everybody who is NOT on a managed plan. */
    #soc-client:not([hidden]) { display: flex; flex-direction: column; gap: clamp(26px, 3.4vh, 46px); }

    /* House rule: hairline outline, square corners, no fill, no shadow. */
    .soc-card {
      background: #fff; border: 1px solid var(--ws-line);
      border-radius: var(--ws-r); padding: 20px 22px;
    }
    .soc-state { font-family: var(--sans); font-size: var(--ws-t-body); color: var(--ws-faint); line-height: 1.6; margin: 0; }

    /* Status rides the strip, so it is white-on-wine like everything else
       there rather than a green pill the strip has to make room for. */
    .ws-block-status {
      font-family: var(--sans); font-size: 12px; font-weight: 600;
      letter-spacing: 0.01em; color: rgba(255,255,255,0.78);
      display: inline-flex; align-items: center; gap: 7px;
      /* Matched to the heading's own line box. Left to itself, 12px text made
         this strip 40px against 37px for the two below it, and a strip that is
         three pixels out of step with its neighbours is exactly the kind of
         thing you can see without being able to name. Same line box as
         .ws-block-link, so a strip is one height whatever it carries. */
      line-height: 14px;
    }
    .ws-block-status[hidden] { display: none; }
    .ws-block-status::before {
      content: ""; width: 6px; height: 6px; border-radius: 50%;
      background: var(--ws-success, #3f9468);
    }

    /* ---- Chapter 01: the plan ---- */
    .soc-plan-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--ws-gap); margin: 0; }
    .soc-plan-grid dt { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin-bottom: 7px; }
    .soc-plan-grid dd { font-family: var(--sans); font-size: var(--ws-t-row); color: var(--ws-ink); margin: 0; }
    .soc-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .soc-chip {
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600;
      padding: 3px 9px; border-radius: 3px;
      border: 1px solid color-mix(in srgb, var(--ws-accent) 34%, transparent);
      color: var(--ws-accent);
    }

    /* ---- Chapter 02: the report ---- */
    .soc-report { padding: 18px 20px 20px; }
    .soc-summary {
      border: 1px solid var(--ws-line); border-left: 3px solid rgb(var(--violet-rgb));
      border-radius: var(--ws-r); padding: 15px 18px; margin-bottom: var(--ws-gap);
      font-family: var(--sans); font-size: var(--ws-t-row); line-height: 1.65; color: var(--ws-tx);
    }

    /* ---- Not a client: the two services ----
       Same vocabulary as everything else on the page — hairline outline,
       square corners, no fill, no shadow. The only colour is the chapter
       strip above, as everywhere else in the hub. */
    #soc-noclient:not([hidden]) { display: flex; flex-direction: column; gap: clamp(26px, 3.4vh, 46px); }
    .soc-lede-card { border-left: 3px solid var(--ws-accent); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .soc-lede-cta { flex: 0 0 auto; white-space: nowrap; }
    .soc-lede { font-family: var(--sans); font-size: var(--ws-t-row); line-height: 1.6; color: var(--ws-tx); margin: 0; max-width: 78ch; }
    .soc-lede strong { color: var(--ws-ink); font-weight: 700; }
    .soc-svc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ws-gap); }
    @media (max-width: 900px) { .soc-svc-grid { grid-template-columns: 1fr; } }
    .soc-svc {
      display: flex; flex-direction: column; padding: 24px 26px 22px;
      background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r);
    }
    .soc-svc-strap { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-accent); margin: 0 0 12px; line-height: 1.5; }
    /* Helios, not The Seasons. The Seasons belongs to the page header and
       nowhere else in the hub — it was doing a job here that Helios does on
       every other card (.ws-news-h, the Studio's shelves), which is what made
       this page read as if it came from somewhere else.

       Written out rather than var(--serif) because global.css rebinds --serif
       to The Seasons inside h3/h4, and this is an h3 — so the token would have
       quietly put back the exact font being removed. */
    .soc-svc-name { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: clamp(19px, 1.7vw, 23px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; color: var(--ws-ink); margin: 0 0 10px; }
    .soc-svc-sum { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 700; line-height: 1.5; color: var(--ws-ink); margin: 0 0 10px; }
    .soc-svc-blurb { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.6; color: var(--ws-tx); margin: 0 0 16px; }
    .soc-svc-list { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .soc-svc-list li { position: relative; padding-left: 18px; font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.5; color: var(--ws-ink); }
    .soc-svc-list li::before { content: ""; position: absolute; left: 0; top: 7px; width: 5px; height: 5px; border-radius: 50%; background: var(--ws-accent); }
    .soc-svc-note { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.5; color: var(--ws-faint); margin: 0 0 16px; }
    /* Said plainly rather than left for someone to find out after enquiring,
       and in the wine so it is the thing the eye lands on in that card. */
    .soc-svc-wait {
      font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.55;
      color: var(--paper); margin: 0 0 16px; padding: 12px 14px;
      border-radius: var(--ws-r); background: rgb(var(--violet-rgb, 55,30,40));
    }
    /* Pinned, so the two cards' buttons line up however long the lists are. */
    .soc-svc-foot { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--ws-line); display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
    .soc-price { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
    .soc-price-tag { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); }
    .soc-price-val { font-family: var(--serif); font-size: clamp(19px, 1.7vw, 23px); font-weight: 600; letter-spacing: -0.01em; color: var(--ws-ink); }
    .soc-price-unit { font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--ws-tx); }
    .soc-price--sm .soc-price-val { font-size: var(--ws-t-row); }

    .soc-extra-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ws-gap); }
    @media (max-width: 720px) { .soc-extra-grid { grid-template-columns: 1fr; } }
    .soc-extra { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px; background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); }
    .soc-extra-name { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 700; color: var(--ws-ink); margin: 0; }
    .soc-extra-sum { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.5; color: var(--ws-tx); margin: 0; }
    .soc-price-note { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.6; color: var(--ws-faint); margin: 4px 0 0; max-width: 78ch; }

    /* ---- Chapter 03: the team ---- */
    .soc-contact { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .soc-contact-h { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 700; color: var(--ws-ink); margin: 0 0 4px; }
    .soc-contact-p { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.5; color: var(--ws-tx); margin: 0; }

    /* ---- Report primitives, emitted by lib/report-insights.js ----
       Same class names the admin Insights view uses; restyled here into the
       member vocabulary. Square, hairline, no fills. */
    .ri-months { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .ri-month { padding: 5px 12px; border-radius: var(--ws-r); border: 1px solid var(--ws-line); background: #fff; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600; color: var(--ws-tx); cursor: pointer; transition: border-color 0.2s var(--ws-ease); }
    .ri-month:hover { border-color: rgba(28,29,34,0.3); }
    .ri-month.is-active { background: rgb(var(--violet-rgb)); border-color: rgb(var(--violet-rgb)); color: #fff; }
    .ri-subtabs { display: inline-flex; gap: 2px; padding: 3px; background: rgba(28,29,34,0.045); border-radius: var(--ws-r); margin-bottom: 16px; flex-wrap: wrap; }
    .ri-subtab { padding: 6px 14px; border: 0; background: none; border-radius: 3px; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600; color: var(--ws-tx); cursor: pointer; }
    .ri-subtab:hover { color: var(--ws-ink); }
    .ri-subtab.is-active { background: #fff; color: var(--ws-ink); border: 1px solid var(--ws-line); padding: 5px 13px; }
    .ri-kpi { background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); padding: 14px 15px; }
    .ri-kpi-label { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin-bottom: 7px; }
    /* The one place a number is allowed to be big and serif, the same move the
       orders page makes with its totals. */
    .ri-kpi-val { font-family: var(--serif); font-size: clamp(22px, 2vw, 28px); font-weight: 400; letter-spacing: -0.015em; line-height: 1.05; color: var(--ws-ink); }
    .ri-kpi-sub { font-family: var(--sans); font-size: var(--ws-t-label); margin-top: 5px; color: var(--ws-tx); }
    .ri-panel { background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); padding: 15px 17px; margin-bottom: var(--ws-gap); }
    .ri-sec { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 22px 0 10px; }
    /* Inside one card, nested panels shouldn't each carry a full-strength edge. */
    .soc-report .ri-panel { border-color: rgba(28,29,34,0.09); }

    /* ---- Key takeaways ----
       The house rule is that the wine strip is the only brand colour on the
       page, and this used to be a second wine panel — which now reads as a
       chapter heading that has come loose. So it keeps its prominence from a
       wine rule and a wine heading instead of a wine field, and stops
       competing with the strips above it. */
    .soc-act { border: 1px solid var(--ws-line); border-top: 3px solid rgb(var(--violet-rgb)); border-radius: var(--ws-r); padding: 18px 20px; margin-top: 18px; background: #fff; }
    .soc-act-head { margin-bottom: 14px; }
    /* Helios spelled out — global.css rebinds --serif to --subhead ON h3/h4, so
       var(--serif) in here silently resolves to The Seasons. */
    .soc-act-h { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: var(--ws-t-row); font-weight: 700; font-style: normal; color: var(--ws-ink); margin: 0 0 5px; }
    .soc-act-sub { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.55; color: var(--ws-tx); margin: 0; max-width: 58ch; }
    .soc-act-list { list-style: none; margin: 0; padding: 0; }
    .soc-act-item { display: flex; align-items: flex-start; gap: 11px; padding: 11px 0; border-bottom: 1px solid var(--ws-line); font-family: var(--sans); font-size: var(--ws-t-row); line-height: 1.55; color: var(--ws-ink); }
    .soc-act-item:last-child { border-bottom: 0; }
    /* One neutral mark, not a traffic light. The admin triage colours (green/amber/
       red) are ours for deciding what to work on; on a client's report an amber dot
       announces "this bit's going badly" before they've read the line. Every takeaway
       gets the same mark and the tone lives in the words. */
    .soc-act-mark { width: 5px; height: 5px; border-radius: 50%; flex-shrink: 0; margin-top: 8px; background: rgb(var(--violet-rgb)); }
    .soc-act-coming { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--ws-line); }
    .soc-act-coming-h { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 0 0 8px; }
    .soc-act-coming-list { margin: 0; padding-left: 18px; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.7; color: var(--ws-tx); }

    /* ---- Waitlist confirmation ---- */
    .soc-wl-scrim { position: fixed; inset: 0; z-index: 200; display: flex; align-items: center; justify-content: center; padding: 24px; background: rgba(20,18,26,0.45); }
    .soc-wl-scrim[hidden] { display: none; }
    .soc-wl-card { position: relative; width: 460px; max-width: 100%; background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); padding: 30px 32px 26px; }
    .soc-wl-x { position: absolute; top: 12px; right: 14px; border: 0; background: none; font-size: 26px; line-height: 1; color: rgba(28,29,34,0.4); cursor: pointer; }
    .soc-wl-eyebrow { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-accent); margin: 0 0 10px; }
    .soc-wl-h { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: clamp(21px, 2vw, 25px); font-weight: 600; letter-spacing: -0.01em; color: var(--ws-ink); margin: 0 0 8px; }
    .soc-wl-lead { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.6; color: var(--ws-tx); margin: 0 0 18px; }
    /* Their details, shown rather than asked for — so they can see exactly what
       is about to be sent before they agree to it. */
    .soc-wl-you[hidden], .soc-wl-note[hidden] { display: none; }
    .soc-wl-you { margin: 0 0 10px; padding: 14px 16px; border: 1px solid var(--ws-line); border-radius: var(--ws-r); display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; }
    .soc-wl-you dt { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-faint); }
    .soc-wl-you dd { margin: 0; font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--ws-ink); min-width: 0; overflow-wrap: anywhere; }
    .soc-wl-note { font-family: var(--sans); font-size: var(--ws-t-label); color: var(--ws-faint); margin: 0 0 16px; }
    .soc-wl-note a { color: var(--ws-accent); font-weight: 700; text-decoration: none; }
    .soc-wl-check { display: flex; align-items: flex-start; gap: 9px; font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.45; color: var(--ws-tx); margin-bottom: 18px; cursor: pointer; }
    .soc-wl-check input { margin-top: 2px; flex: none; }
    .soc-wl-error { font-family: var(--sans); font-size: var(--ws-t-meta); color: #b3261e; margin: 0 0 12px; }
    .soc-wl-error[hidden] { display: none; }
    .soc-wl-go { width: 100%; }
    .soc-wl-cancel { display: block; width: 100%; margin-top: 10px; border: 0; background: none; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600; color: var(--ws-faint); cursor: pointer; padding: 8px; }
    .soc-wl-cancel:hover { color: var(--ws-ink); }

    @media (max-width: 720px) {
      .soc-contact { flex-direction: column; align-items: flex-start; }
    }
  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";
    import { renderTab, renderTrends, MONTHS } from "../../lib/report-insights.js";
    import { resolveVisibility } from "../../lib/report-fields.js";
    import { DEMO_REPORTS } from "../../lib/report-insights-demo.js";

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const DEV = import.meta.env.DEV;
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

    let reports = [], curIdx = 0, tab = "overview", vis = resolveVisibility(null);

    // How the shared report renderers are tailored for the client's view. Admin passes
    // no opts and keeps the full breakdown — this only trims what the member sees.
    const MEMBER_OPTS = { compactCards: true, topN: 5, rankTop: true, hideHashtags: true };

    function renderPlan(c) {
      const platforms = Array.isArray(c.platforms) && c.platforms.length ? c.platforms.map((p) => `<span class="soc-chip">${esc(p)}</span>`).join("") : "—";
      const since = c.start_date ? (() => { try { return new Date(c.start_date + "T12:00:00").toLocaleDateString("en-GB", { month: "long", year: "numeric" }); } catch (_) { return null; } })() : null;
      // The chapter strip carries the heading and the status now, so the card
      // holds only the facts.
      const status = $("soc-status");
      if (status) { status.textContent = "Active"; status.hidden = false; }
      $("soc-plan").innerHTML = `
        <dl class="soc-plan-grid">
          ${c.package_name ? `<div><dt>Package</dt><dd>${esc(c.package_name)}</dd></div>` : ""}
          <div><dt>Platforms</dt><dd class="soc-chips">${platforms}</dd></div>
          ${since ? `<div><dt>Managed since</dt><dd>${esc(since)}</dd></div>` : ""}
        </dl>`;
    }

    // Key takeaways — the internal priorities, turned round to face the client.
    // NO traffic lights here. Admin triages these as Do more / Improve / Fix now,
    // which is the right tool for us and the wrong one for a client: an amber or a
    // red dot flags "we're not doing this well" before they've read a word of it.
    // The colour is dropped and the tone carried by the text instead (see the
    // writing rules in docs/smm-report-rules.md) — every line lands as something
    // we're acting on, not a mark against the account.
    function keyTakeaways(d, vis) {
      const prios = (d.priorities || []).filter((p) => p && p.text);
      const coming = (d.comingSoon || []).filter(Boolean);
      const showP = vis.priorities !== false && prios.length;
      const showC = vis.comingSoon !== false && coming.length;
      if (!showP && !showC) return "";
      const items = showP ? prios.map((p) => `<li class="soc-act-item"><span class="soc-act-mark" aria-hidden="true"></span><span>${esc(p.text)}</span></li>`).join("") : "";
      return `
        <section class="soc-act">
          <div class="soc-act-head">
            <h3 class="soc-act-h">Key takeaways</h3>
            <p class="soc-act-sub">Taking into account how your accounts have performed recently, here's what we're bringing into the next few weeks.</p>
          </div>
          ${showP ? `<ul class="soc-act-list">${items}</ul>` : ""}
          ${showC ? `<div class="soc-act-coming"><h4 class="soc-act-coming-h">Content coming up</h4><ul class="soc-act-coming-list">${coming.map((c) => `<li>${esc(c)}</li>`).join("")}</ul></div>` : ""}
        </section>`;
    }

    function renderInsights() {
      const wrap = $("soc-insights");
      if (!reports.length) { wrap.innerHTML = `<p class="soc-state">Your first monthly report will appear here once we've published it.</p>`; return; }
      const cur = reports[curIdx];
      const months = reports.map((r, i) => `<button type="button" class="ri-month ${i === curIdx ? "is-active" : ""}" data-mi="${i}">${MONTHS[r.month]} ${r.year}</button>`).join("");
      // A tab only exists if it has something to say for THIS month. Two different
      // things can empty it, so it takes two checks:
      //  1. the admin switched all its fields off — the render fns return "" for that;
      //  2. the month has no data for it — the render fns DON'T return "" there, they
      //     emit headings and "—" placeholders, so the data has to be checked directly.
      // Checking only the rendered output looks like it works and silently does
      // nothing for case 2.
      const filled = (o) => !!o && Object.values(o).some((v) => v != null && v !== "" && !(Array.isArray(v) && !v.length));
      const len = (a) => (Array.isArray(a) ? a.length : 0);
      const d = cur.data || {}, pt = d.peakTimes || {}, dem = d.demographics || {};
      const HAS_DATA = {
        overview: () => filled(d.profile) || filled(d.reach),
        content: () => filled(d.reels) || filled(d.posts) || filled(d.ads) || len(d.topContent) || len(d.hashtags),
        audience: () => (len(pt.grid) && len(pt.slots)) || d.bestDays || d.morningWindow || d.eveningWindow
          || len(dem.gender) || len(dem.topCities) || len(dem.topCountries),
        actions: () => len(d.priorities) || len(d.comingSoon),
      };
      const hasBody = (t) => {
        try { return renderTab(t, cur.data, cur, vis).trim() !== ""; } catch (_) { return false; }
      };
      const shows = (t) => !!HAS_DATA[t]() && hasBody(t);
      // Three tabs, in the order a client reads them:
      //   Overview: the numbers, with the month-on-month trend graph folded in rather
      //             than sat in a tab of its own.
      //   Content:  how the posts themselves did.
      //   Summary:  what we make of it all, in words, and the key takeaways. Last,
      //             so you read the evidence and then the conclusion drawn from it.
      // Audience is NOT a client tab, by rule, not by config — see §2 of
      // docs/smm-report-rules.md. It's background context for whoever writes the
      // report; a client doesn't need to know what time we post. Anything from it
      // that IS worth their while (their audience is local, the age profile suits
      // buyers) reaches them as a line in Key takeaways, written by a human.
      // Deliberately not driven off the visibility flags: switching an audience
      // field on in Settings must not put the tab back.
      const hasSummary = !!(vis.summary && d.summary);
      const hasActions = (vis.priorities || vis.comingSoon) && shows("actions");
      const showTrends = !!vis.trends && reports.length > 1;
      const TABS = [];
      if (shows("overview") || showTrends) TABS.push(["overview", "Overview"]);
      if (shows("content")) TABS.push(["content", "Content"]);
      // Summary sits at the END: you read the numbers, then what we make of them.
      if (hasSummary || hasActions) TABS.push(["summary", "Summary"]);
      // Fall back to the first tab that EXISTS, not a hard-coded "overview" — with
      // the filtering above, overview may not be one of them. Switching month keeps
      // your current tab only if that month has it.
      if (!TABS.some(([t]) => t === tab)) tab = TABS.length ? TABS[0][0] : "";
      const tabs = TABS.map(([t, label]) => `<button type="button" class="ri-subtab ${tab === t ? "is-active" : ""}" data-tab="${t}">${label}</button>`).join("");
      // The written round-up used to sit above the tabs on every one of them. It's
      // the Summary tab's whole point now, so it lives there with the actions.
      const summaryHtml = hasSummary ? `<div class="soc-summary">${esc(d.summary)}</div>` : "";
      const trendsHtml = showTrends
        ? `<div class="ri-sec">How you're tracking, month on month</div>${renderTrends(reports.slice().reverse())}`
        : "";
      const body = !TABS.length
        ? `<p class="soc-state">There's nothing to show for this month yet. Your team is still putting the numbers together.</p>`
        : tab === "summary" ? summaryHtml + keyTakeaways(d, vis)
        : tab === "overview" ? renderTab("overview", cur.data, cur, vis) + trendsHtml
        : renderTab(tab, cur.data, cur, vis, MEMBER_OPTS);
      wrap.innerHTML = `<div class="ri-months">${months}</div><div class="ri-subtabs">${tabs}</div><div>${body}</div>`;
      wrap.querySelectorAll("[data-mi]").forEach((b) => b.addEventListener("click", () => { curIdx = +b.getAttribute("data-mi"); renderInsights(); }));
      wrap.querySelectorAll("[data-tab]").forEach((b) => b.addEventListener("click", () => { tab = b.getAttribute("data-tab"); renderInsights(); }));
    }

    function show(data) {
      $("soc-loading").hidden = true;
      if (!data || !data.client) { $("soc-noclient").hidden = false; return; }
      $("soc-client").hidden = false;
      vis = resolveVisibility(data.visibility);
      renderPlan(data.client);
      reports = (data.reports || []).map((r) => ({ id: r.id, platform: r.platform, month: r.month, year: r.year, data: r.data }));
      curIdx = 0; renderInsights();
    }

    /* ---- Join the waitlist ----
       A confirmation, because everyone on this page is signed in. It shows the
       details it is about to use so nobody agrees to something they cannot
       see, and the Worker reads them from the account rather than trusting
       what this sends — otherwise the confirm box would be a way to file an
       entry in someone else's name. */
    function wireWaitlist(session) {
      const scrim = $("soc-wl"), go = $("soc-wl-go"), err = $("soc-wl-error");
      if (!scrim) return;
      const meta = (session && session.user && session.user.user_metadata) || {};
      const email = (session && session.user && session.user.email) || "";
      const name = meta.name || meta.full_name || "";
      const business = meta.company || "";
      const row = (k, v) => v ? `<dt>${esc(k)}</dt><dd>${esc(v)}</dd>` : "";
      const rows = row("Name", name) + row("Business", business) + row("Email", email);
      $("soc-wl-you").innerHTML = rows;
      // Nothing to show is better shown as nothing than as an empty box.
      $("soc-wl-you").hidden = !rows;
      document.querySelector(".soc-wl-note").hidden = !rows;

      const open = () => { err.hidden = true; scrim.hidden = false; document.documentElement.style.overflow = "hidden"; };
      const close = () => { scrim.hidden = true; document.documentElement.style.overflow = ""; };
      document.querySelectorAll('[data-smm-form="waitlist"]').forEach((b) => b.addEventListener("click", open));
      $("soc-wl-x").addEventListener("click", close);
      $("soc-wl-cancel").addEventListener("click", close);
      scrim.addEventListener("click", (e) => { if (e.target === scrim) close(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !scrim.hidden) close(); });

      go.addEventListener("click", async () => {
        err.hidden = true;
        const orig = go.textContent;
        go.disabled = true; go.textContent = "Adding you…";
        try {
          if (!WORKER || !session) throw new Error("This isn't quite live yet — please email hello@tmke.co.uk and we'll sort it.");
          const res = await fetch(`${WORKER}/smm/waitlist`, {
            method: "POST",
            headers: { "Content-Type": "application/json", Authorization: "Bearer " + session.access_token },
            body: JSON.stringify({ source: "hub", marketing_opt_in: $("soc-wl-optin").checked }),
          });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(d.error || "Something went wrong — please try again.");
          $("soc-wl-h").textContent = "You're on the list";
          $("soc-wl-lead").textContent = "We'll be in touch the moment a space opens up. Check your inbox — we've sent you a confirmation.";
          ["soc-wl-you", "soc-wl-optin", "soc-wl-go"].forEach((id) => $(id)?.closest("dl, label, button")?.setAttribute("hidden", ""));
          document.querySelector(".soc-wl-note")?.setAttribute("hidden", "");
          $("soc-wl-cancel").textContent = "Close";
        } catch (e2) {
          err.textContent = e2 && e2.message ? e2.message : "Something went wrong — please try again.";
          err.hidden = false;
        } finally { go.disabled = false; go.textContent = orig; }
      });
    }

    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (session && session.user) $("footer-email").textContent = session.user.email || "";
      wireWaitlist(session);
      if (!session) {
        if (DEV) { show({ client: { package_name: "Growth", platforms: ["Instagram", "Facebook", "LinkedIn"], start_date: "2026-02-01" }, reports: DEMO_REPORTS }); return; }
        location.replace("/login?next=" + encodeURIComponent("/account/social"));
        return;
      }
      // getSession() is local-only - a cleared/revoked session can still look
      // valid to it. Confirm with the server before letting anyone in.
      if (!DEV) {
        const { data: { user }, error } = await supabase.auth.getUser();
        if (!user || error) { location.replace("/login?next=" + encodeURIComponent("/account/social")); return; }
      }
      if (!WORKER) { show({ client: null }); return; }
      try {
        const res = await fetch(`${WORKER}/smm/mine`, { headers: { Authorization: "Bearer " + session.access_token } });
        const j = await res.json().catch(() => ({}));
        show(j);
      } catch (_) { show({ client: null }); }
    })();
  </script>
</BaseLayout>
