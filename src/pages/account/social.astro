---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import HubFootBar from "../../components/account/HubFootBar.astro";
import "../../styles/workspace.css";
import "../../styles/ws-system.css";
import "../../styles/account-sections.css";
import { SOCIAL_SERVICES, SOCIAL_EXTRAS, PRICE_NOTE, BROCHURE_URL } from "../../lib/smm-config.js";
import { gbpFromPence } from "../../lib/supabase.js";
---

<!--
  Your SMM — the last member tab still on the old dashboard chrome. Rebuilt onto
  the shared hub system (ws-system.css): wine chapter strips, hairline square
  cards, one --ws-gap. Nothing about what the page DOES changes; the report
  renderers, the visibility rules and the worker fetch are untouched.

  The monthly report is read on its own page, a slide at a time, the way the
  courses are: social/report.astro. This page only offers it.
-->
<BaseLayout title="Your SMM · TMKE" description="Your social media management, your plan and your monthly performance." dashboard hideNav hideFooter>
  <div class="ws">
    <WorkspaceHeader active="social" />
    <main class="ws-main">
      <div class="ws-left">

        <!-- ============ HERO ============ -->
        <section class="ws-hero ws-hero--sub soc-hero">
          <div class="ws-hero-copy">
            <p class="ws-hero-date"><a href="/account" class="back-link">&larr; Workspace</a></p>
            <h1 class="ws-greeting">Your Socials.</h1>
            <p class="ws-hero-sub" id="soc-sub">View your social media plan and see how your accounts are performing month by month.</p>
            <!-- A client's: the dashboard's arrangement (Dani, 20 Oct: "more
                 inspiration from the dashboard"), the two things they come
                 for, then the three boxes. Hidden until known, never sample
                 figures. -->
            <div class="ws-hero-cta soc-hero-cta" id="soc-hero-cta" hidden>
              <a class="ws-btn ws-btn--primary" id="soc-hero-read" href="#soc-perf-h">Read the latest report
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <button type="button" class="ws-btn ws-btn--ghost" id="soc-hero-msg">Message your team</button>
            </div>
            <ul class="ws-brief soc-brief" id="soc-brief" hidden></ul>
          </div>
          <div class="ws-hero-photo" role="img" aria-label="A styled interior"></div>
        </section>

        <p id="soc-loading" class="soc-state">Loading your social media&hellip;</p>

        <!-- ============ Not a managed-social client ============
             What this page is for when there is no account behind it: the two
             services, in TMKE's own words, with real prices. It used to be one
             card apologising for being empty, above a "See the plans" button
             that led to three invented tiers at two to five times the actual
             cost. -->
        <div id="soc-noclient" hidden>
          <!-- Above the first chapter, in a card of its own: it is the answer to
               "why is this page empty", and inside the chapter it read as a
               caption to the two services rather than as the thing to read
               first. -->
          <div class="soc-card soc-lede-card ws-rise" style="--i:0">
            <p class="soc-lede"><strong>You&rsquo;re not on a social plan with us yet.</strong> There are two ways we run social for estate agents &mdash; one where we take the whole thing off your hands, and one where we handle the video.</p>
            <!-- The services brochure, opened in the browser's own PDF viewer
                 rather than saved: they're signed in, so no form, and from the
                 viewer they can read it or download it as they like. -->
            <span class="soc-lede-ctas">
              <button type="button" class="ws-btn ws-btn--primary" id="soc-sample">See what a plan looks like</button>
              <a class="ws-btn ws-btn--ghost soc-lede-cta" href={BROCHURE_URL} target="_blank" rel="noopener">View services</a>
            </span>
          </div>

          <section class="ws-block ws-rise" style="--i:1" aria-labelledby="soc-svc-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-svc-h"><span class="ws-block-ch">Chapter 01</span>Social, handled</h2>
              <a class="ws-block-link" href="/account/contact">Talk to us
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </header>

            <div class="soc-svc-grid">
              {SOCIAL_SERVICES.map((sv) => (
                <article class="soc-svc">
                  <p class="soc-svc-strap">{sv.strap}</p>
                  <h3 class="soc-svc-name">{sv.name}</h3>
                  <p class="soc-svc-sum">{sv.summary}</p>
                  <p class="soc-svc-blurb">{sv.blurb}</p>
                  <ul class="soc-svc-list">
                    {sv.includes.map((it) => <li>{it}</li>)}
                  </ul>
                  {sv.note && <p class="soc-svc-note">{sv.note}</p>}
                  {!sv.openToNewClients && (
                    <p class="soc-svc-wait">We&rsquo;re not taking on new social media management clients right now. Join the waitlist and we&rsquo;ll be in touch when a space opens up.</p>
                  )}
                  <div class="soc-svc-foot">
                    <div class="soc-price">
                      <span class="soc-price-tag">Prices</span>
                      <span class="soc-price-val">from {gbpFromPence(sv.from_pence)}</span>
                      <span class="soc-price-unit">+VAT / {sv.unit}</span>
                    </div>
                    {sv.openToNewClients
                      ? <a class="ws-btn ws-btn--primary" href={`/account/contact?from=${sv.key}`}>Talk to us</a>
                      : <button type="button" class="ws-btn ws-btn--primary" data-smm-form="waitlist">Join the waitlist</button>}
                  </div>
                </article>
              ))}
            </div>
          </section>

          <section class="ws-block ws-rise" style="--i:2" aria-labelledby="soc-extra-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-extra-h"><span class="ws-block-ch">Chapter 02</span>Also on social</h2>
            </header>
            <div class="soc-extra-grid">
              {SOCIAL_EXTRAS.map((sv) => (
                <article class="soc-extra">
                  <h3 class="soc-extra-name">{sv.name}</h3>
                  <p class="soc-extra-sum">{sv.summary}</p>
                  <div class="soc-price soc-price--sm">
                    <span class="soc-price-tag">Prices</span>
                    <span class="soc-price-val">from {gbpFromPence(sv.from_pence)}</span>
                    <span class="soc-price-unit">+VAT / {sv.unit}</span>
                  </div>
                </article>
              ))}
            </div>
            <p class="soc-price-note">{PRICE_NOTE}</p>
          </section>
        </div>

        <!-- ============ Managed-social client ============ -->
        <div id="soc-client" hidden>
          <!-- Only while a prospect is looking at the sample. -->
          <div class="soc-card soc-sample-note" id="soc-sample-note" hidden>
            <p class="soc-lede"><strong>This is a sample.</strong> It shows what your page looks like on a plan with us: your package, and a monthly report of how it's going.</p>
            <button type="button" class="ws-btn ws-btn--ghost" id="soc-sample-back">Back</button>
          </div>

          <!-- Chapter 01 — what you are on -->
          <section class="ws-block ws-rise" style="--i:1" aria-labelledby="soc-plan-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-plan-h"><span class="ws-block-ch">Chapter 01</span>Your plan</h2>
              <!-- Filled by renderPlan(). The strip carries the status. -->
              <span class="ws-block-status" id="soc-status" hidden></span>
            </header>
            <div id="soc-plan"></div>
          </section>

          <!-- Chapter 02 — the month (Dani, 20 Oct): the latest report as its
               own cover (the Socials picture, the wine card, as the course
               intros), then the dashboard's Explore and Latest row: every
               month as a pill, the latest three as cards. -->
          <section class="ws-block ws-rise" style="--i:2" aria-labelledby="soc-perf-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-perf-h"><span class="ws-block-ch">Chapter 02</span>Monthly report</h2>
            </header>
            <div id="soc-insights"><div class="soc-card"><p class="soc-state">Your first monthly report will appear here once we&rsquo;ve published it.</p></div></div>
          </section>

          <!-- Chapter 03 — what they owe, and what they have paid -->
          <section class="ws-block ws-rise" style="--i:3" aria-labelledby="soc-bill-h" id="soc-bill-block" hidden>
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-bill-h"><span class="ws-block-ch">Chapter 03</span>Invoices</h2>
              <span class="ws-block-status" id="soc-bill-status" hidden></span>
            </header>
            <div id="soc-bill"></div>
          </section>

          <!-- Chapter 04 — the person behind it, as the Community introduces
               the team: face, name, role, and the way to reach them. -->
          <section class="ws-block ws-rise" style="--i:4" aria-labelledby="soc-team-h">
            <header class="ws-block-head">
              <h2 class="ws-block-h" id="soc-team-h"><span class="ws-block-ch">Chapter 04</span>Your social team</h2>
            </header>
            <div class="soc-team" id="soc-team">
              <div class="soc-team-photo" id="soc-team-photo" aria-hidden="true"></div>
              <div class="soc-team-tx">
                <p class="soc-team-k" id="soc-team-k">Your social team</p>
                <h3 class="soc-team-h" id="soc-team-name">Questions about your social?</h3>
                <p class="soc-team-p" id="soc-team-p">Your TMKE social team is here to help, from content ideas to the numbers above.</p>
                <button type="button" class="ws-btn ws-btn--primary" id="soc-msg-open">Message your team</button>
              </div>
            </div>
          </section>

        </div>
      </div>

      <HubFootBar emailSlot />
    </main>

  <!-- A confirmation, not a form. Everyone here is signed in and has already
       given us their name, business and email — asking for them again is a
       worse experience AND a second copy of the truth to reconcile. The Worker
       reads them from the account, so this only has to ask. -->
  <div class="soc-wl-scrim" id="soc-wl" hidden>
    <div class="soc-wl-card" role="dialog" aria-modal="true" aria-labelledby="soc-wl-h">
      <button type="button" class="soc-wl-x" id="soc-wl-x" aria-label="Close">&times;</button>
      <p class="soc-wl-eyebrow">TMKE &mdash; Social Media</p>
      <h2 class="soc-wl-h" id="soc-wl-h">Join the waitlist.</h2>
      <p class="soc-wl-lead">We&rsquo;re not taking on new social media management clients right now. We&rsquo;ll be in touch when a space opens up.</p>

      <dl class="soc-wl-you" id="soc-wl-you"></dl>
      <p class="soc-wl-note">We&rsquo;ll use the details on your account. <a href="/account/profile">Update them &rarr;</a></p>

      <label class="soc-wl-check"><input type="checkbox" id="soc-wl-optin" /> <span>Sign me up to the TMKE newsletter and marketing emails</span></label>

      <p class="soc-wl-error" id="soc-wl-error" hidden></p>
      <button type="button" class="ws-btn ws-btn--primary soc-wl-go" id="soc-wl-go">Yes, add me to the waitlist</button>
      <button type="button" class="soc-wl-cancel" id="soc-wl-cancel">Not now</button>
    </div>
  </div>

  </div>

  <!-- Writing to their social team. We already hold their name, address and
       number, so the only thing to ask for is the thing we do not know. -->
  <div class="soc-msg-scrim" id="soc-msg" hidden>
    <div class="soc-msg-box" role="dialog" aria-modal="true" aria-labelledby="soc-msg-h">
      <h3 class="soc-msg-h" id="soc-msg-h">Message your social team</h3>
      <p class="soc-msg-sub" id="soc-msg-sub">Goes straight to the person who looks after your account.</p>
      <dl class="soc-msg-you" id="soc-msg-you"></dl>
      <label class="soc-msg-f"><span>Your message</span>
        <textarea id="soc-msg-body" rows="6" placeholder="Anything at all — an idea, a question, something you would like posted."></textarea>
      </label>
      <p class="soc-msg-note" id="soc-msg-note" hidden></p>
      <div class="soc-msg-acts">
        <button type="button" class="ws-btn ws-btn--ghost" id="soc-msg-cancel">Cancel</button>
        <button type="button" class="ws-btn ws-btn--primary" id="soc-msg-send">Send message</button>
      </div>
    </div>
  </div>

  <style is:global>
    /* The pop-up sits outside .ws, where the hub's button tokens live, so it
       carries them itself, in wine (Danielle, 19 Oct 2026). */
    .soc-msg-scrim { --ws-accent: #371e28; --ws-ink: #1c1d22; --ws-line: rgba(28,29,34,0.13); --ws-r: 4px; --ws-btn-h: 34px; --ws-ease: cubic-bezier(.2,.8,.2,1); }
    .soc-msg-acts .ws-btn { padding: 0 16px; font-size: 11px; }
    .soc-msg-scrim { position: fixed; inset: 0; z-index: 600; display: flex; align-items: center; justify-content: center; padding: 24px; background: rgba(16,14,22,0.5); backdrop-filter: blur(3px); }
    .soc-msg-scrim[hidden] { display: none; }
    .soc-msg-box { width: 100%; max-width: 520px; box-sizing: border-box; background: #fff; border-radius: 12px; padding: 26px 28px; box-shadow: 0 30px 80px -24px rgba(16,14,22,0.5); max-height: calc(100vh - 48px); overflow-y: auto; }
    .soc-msg-h { font-family: var(--serif); font-size: 22px; font-weight: 400; color: var(--ink); margin: 0 0 6px; }
    .soc-msg-sub { font-family: var(--sans); font-size: 13.5px; line-height: 1.6; color: rgba(28,29,34,0.6); margin: 0 0 18px; }
    /* Their details, shown rather than asked for: we already hold them, and a
       form that makes somebody retype what we know reads as a form. */
    .soc-msg-you { display: grid; grid-template-columns: auto 1fr; gap: 4px 14px; margin: 0 0 18px; padding: 12px 14px; border-radius: 9px; background: rgba(28,29,34,0.04); }
    .soc-msg-you dt { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.42); align-self: center; }
    .soc-msg-you dd { font-family: var(--sans); font-size: 13px; color: var(--ink); margin: 0; }
    .soc-msg-f { display: block; }
    .soc-msg-f > span { display: block; font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-bottom: 6px; }
    .soc-msg-f textarea { width: 100%; box-sizing: border-box; padding: 11px 13px; border: 1px solid rgba(28,29,34,0.16); border-radius: 9px; font-family: var(--sans); font-size: 14px; line-height: 1.55; color: var(--ink); background: #fff; resize: vertical; }
    .soc-msg-f textarea:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(var(--violet-rgb),0.12); }
    .soc-msg-note { font-family: var(--sans); font-size: 12.5px; margin: 12px 0 0; color: rgba(28,29,34,0.6); }
    .soc-msg-note.is-err { color: #9a2a2a; }
    .soc-msg-note.is-ok { color: #2b6b44; }
    .soc-msg-acts { display: flex; justify-content: flex-end; gap: 10px; margin-top: 18px; }

    /* The wine the takeaways panel uses. The hub theme resolves
       --english-violet to the BROWN, so the wine is carried as its own token. */
    #soc-client, #soc-noclient { --violet-rgb: 55,30,40; }
    .soc-hero { --ws-hero-img: url('/assets/hub/smm.jpg'); }

    /* Chapters are siblings in one column, spaced like every other hub page.
       Scoped to :not([hidden]) because a bare `display:flex` on the id beats
       the hidden attribute — which would show the empty scaffolding to
       everybody who is NOT on a managed plan. */
    #soc-client:not([hidden]) { display: flex; flex-direction: column; gap: clamp(26px, 3.4vh, 46px); }

    /* House rule: hairline outline, square corners, no fill, no shadow. */
    /* Invoices. One outstanding has something to do about it, so it carries
       weight; a settled one is a receipt and should read like filing. */
    .soc-inv-h { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,29,34,0.42); margin: 18px 0 8px; }
    .soc-inv-h:first-child { margin-top: 0; }
    /* The tools line up with the bottom of the second line, not the middle
       of both: a button floating between two lines belongs to neither. */
    .soc-inv { display: flex; align-items: flex-end; gap: 14px; flex-wrap: wrap; padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .soc-inv:last-child { border-bottom: 0; }
    .soc-inv-main { flex: 1 1 240px; min-width: 0; }
    .soc-inv-num { display: block; font-family: var(--sans); font-size: 14px; font-weight: 600; color: var(--ws-ink, #1c1d22); }
    .soc-inv-when { display: block; font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); margin-top: 2px; }
    .soc-inv-amt { font-weight: 700; color: var(--ws-ink, #1c1d22); font-variant-numeric: tabular-nums; }
    .soc-inv-tools { display: flex; gap: 8px; flex: none; }
    .soc-inv.is-paid .soc-inv-num, .soc-inv.is-paid .soc-inv-amt { color: rgba(28,29,34,0.6); font-weight: 600; }
    .soc-inv-when .soc-inv-amt { font-size: 12.5px; }

    .soc-card {
      background: #fff; border: 1px solid var(--ws-line);
      border-radius: var(--ws-r); padding: 20px 22px;
    }
    .soc-state { font-family: var(--sans); font-size: var(--ws-t-body); color: var(--ws-faint); line-height: 1.6; margin: 0; }
    .soc-retry { margin-left: 6px; padding: 0; border: 0; background: none; font: inherit; color: var(--ws-ink); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }

    /* Status rides the strip, so it is white-on-wine like everything else
       there rather than a green pill the strip has to make room for. */
    .ws-block-status {
      font-family: var(--sans); font-size: 12px; font-weight: 600;
      letter-spacing: 0.01em; color: rgba(255,255,255,0.78);
      display: inline-flex; align-items: center; gap: 7px;
      /* Matched to the heading's own line box. Left to itself, 12px text made
         this strip 40px against 37px for the two below it, and a strip that is
         three pixels out of step with its neighbours is exactly the kind of
         thing you can see without being able to name. Same line box as
         .ws-block-link, so a strip is one height whatever it carries. */
      line-height: 14px;
    }
    .ws-block-status[hidden] { display: none; }
    .ws-block-status::before {
      content: ""; width: 6px; height: 6px; border-radius: 50%;
      background: var(--ws-success, #3f9468);
    }

    /* ---- Chapter 01: the plan ---- */
    .soc-plan-grid { display: flex; flex-wrap: wrap; gap: var(--ws-gap); margin: 0; }
    .soc-plan-grid > div { flex: 1 1 140px; min-width: 0; }
    /* Several platforms get a double share of the row so the chips sit on
       one line where they can, and wrap inside their own cell where not. */
    .soc-plan-grid > .is-wide { flex: 2 1 280px; }
    .soc-plan-grid dt { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin-bottom: 7px; }
    .soc-plan-grid dd { font-family: var(--sans); font-size: var(--ws-t-row); color: var(--ws-ink); margin: 0; }
    .soc-chips { display: flex; flex-wrap: wrap; gap: 6px; }
    .soc-chip {
      display: inline-flex; align-items: center; gap: 5px;
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600;
      padding: 3px 9px; border-radius: 3px;
      border: 1px solid color-mix(in srgb, var(--ws-accent) 34%, transparent);
      color: var(--ws-accent);
    }
    /* A platform we hold an address for is the way there, so it has to look
       like one — the arrow says it leaves the hub. */
    .soc-chip.is-link { text-decoration: none; cursor: pointer; transition: background 0.16s, border-color 0.16s; }
    .soc-chip.is-link span { font-size: 0.85em; opacity: 0.6; }
    .soc-chip.is-link:hover { background: color-mix(in srgb, var(--ws-accent) 10%, transparent); border-color: var(--ws-accent); }
    .soc-chip.is-link:hover span { opacity: 1; }

    /* ---- Chapter 03: the reports ----
       The latest month as a cover with its three headline figures, the way
       a course card offers a course; the report is read on its own page. */
    .soc-rep-latest { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .soc-rep-eyebrow { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-accent); margin: 0 0 8px; }
    .soc-rep-h { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: clamp(21px, 2vw, 26px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.15; color: var(--ws-ink); margin: 0; }
    .soc-rep-figs { display: flex; flex-wrap: wrap; gap: 8px 32px; margin: 16px 0 0; }
    .soc-rep-figs dt { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin-bottom: 5px; }
    .soc-rep-figs dd { font-family: var(--serif); font-size: clamp(22px, 2vw, 28px); letter-spacing: -0.015em; line-height: 1.05; color: var(--ws-ink); margin: 0; font-variant-numeric: tabular-nums; }
    .soc-rep-earlier-h { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 22px 0 4px; padding-top: 18px; border-top: 1px solid var(--ws-line); }
    .soc-rep-list { list-style: none; margin: 0; padding: 0; }
    .soc-rep-list a { display: flex; align-items: center; justify-content: space-between; gap: 14px; padding: 11px 0; border-bottom: 1px solid var(--ws-line); font-family: var(--sans); font-size: var(--ws-t-row); color: var(--ws-ink); text-decoration: none; }
    .soc-rep-list li:last-child a { border-bottom: 0; padding-bottom: 0; }
    /* The same small capitals as "Latest report · Instagram" above it. */
    .soc-rep-plat { margin-left: 10px; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); }
    /* The chapter strips' status ("Active", "2 outstanding") in the same
       small capitals as every other label on the page. */
    #soc-client .ws-block-status { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; }
    @media (max-width: 720px) { .soc-rep-figs dd { font-size: 18px; } .soc-rep-figs { gap: 8px 24px; } }
    .soc-rep-go { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ws-tx); }
    .soc-rep-go svg { width: 13px; height: 13px; transition: transform 0.25s var(--ws-ease); }
    .soc-rep-list a:hover .soc-rep-go { color: var(--ws-accent); }
    .soc-rep-list a:hover .soc-rep-go svg { transform: translateX(3px); }

    /* ======== A client's page, on the dashboard's pieces (Dani, 20 Oct:
       "more inspiration from the dashboard and the training pages") ======== */
    .soc-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
    /* The Planner's arrangement (Dani, 20 Oct): the words across the top,
       the buttons bottom left, the three boxes level with them on the right. */
    .soc-hero > .ws-hero-copy { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: clamp(24px, 3vw, 48px); align-items: end; }
    .soc-hero .ws-hero-date, .soc-hero .ws-greeting, .soc-hero .ws-hero-sub { grid-column: 1 / -1; }
    .soc-hero .soc-hero-cta { grid-column: 1; grid-row: 4; align-self: end; display: flex; flex-wrap: wrap; gap: 8px; }
    .soc-hero .soc-brief { grid-column: 2; grid-row: 4; align-self: end; }
    .soc-hero-cta[hidden], .soc-brief[hidden] { display: none !important; }
    .soc-brief .ws-brief-tx strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px; }
    @media (max-width: 900px) {
      .soc-hero > .ws-hero-copy { grid-template-columns: minmax(0, 1fr); }
      .soc-hero .soc-brief { grid-column: 1; grid-row: 4; margin-top: clamp(18px, 2.4vh, 26px); grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .soc-hero .soc-hero-cta { grid-row: 5; }
    }
    @media (max-width: 620px) { .soc-hero .soc-brief { grid-template-columns: 1fr; } }

    /* Chapter 01: the latest month, as a cover beside its figures. */
    .soc-feature { display: grid; grid-template-columns: minmax(230px, 32%) minmax(0, 1fr); border: 1px solid var(--ws-line); border-radius: var(--ws-r); overflow: hidden; background: #fff; }
    .soc-cover { position: relative; isolation: isolate; overflow: hidden; display: flex; flex-direction: column; gap: 4px; min-height: 270px; padding: clamp(20px, 2vw, 28px); text-decoration: none; color: #fff;
      background: radial-gradient(120% 90% at 85% 0%, #5a3a47 0%, #371e28 55%, #2a1620 100%); }
    .soc-cover::after { content: ""; position: absolute; right: -30%; bottom: -45%; width: 80%; aspect-ratio: 1; border-radius: 50%; border: 1px solid rgba(255,255,255,0.12); z-index: -1; transition: transform 0.9s var(--ws-ease); }
    .soc-cover:hover::after { transform: translate(-8%, -8%); }
    .soc-cover-k { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.62); margin-bottom: auto; }
    .soc-cover-month { font-family: var(--subhead); font-size: clamp(40px, 4vw, 60px); line-height: 1; letter-spacing: -0.02em; }
    .soc-cover-year { font-family: var(--sans); font-size: 13px; font-weight: 600; letter-spacing: 0.18em; color: rgba(255,255,255,0.72); }
    .soc-cover-ics { display: flex; gap: 6px; margin-top: 16px; }
    .soc-cover-ic { width: 30px; height: 30px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.12); }
    .soc-cover-ic svg { width: 15px; height: 15px; fill: none; stroke: #fff; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .soc-feature-body { display: flex; flex-direction: column; gap: 6px; padding: clamp(20px, 2vw, 30px) clamp(20px, 2.4vw, 34px); min-width: 0; }
    .soc-feature-h { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: clamp(21px, 2vw, 27px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.15; color: var(--ws-ink); margin: 0; }
    .soc-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--ws-gap); margin: 18px 0 0; }
    .soc-stat { padding: 2px 0 2px 16px; border-left: 2px solid rgba(55,30,40,0.14); min-width: 0; }
    .soc-stat dt { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin-bottom: 6px; }
    .soc-stat dd { font-family: var(--serif); font-size: clamp(28px, 2.8vw, 42px); letter-spacing: -0.015em; line-height: 1; color: var(--ws-ink); margin: 0; font-variant-numeric: tabular-nums; }
    .soc-delta { display: block; margin-top: 7px; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600; color: var(--ws-faint); }
    .soc-delta.is-up { color: #2e6f4f; }
    .soc-delta.is-down { color: #a3392b; }
    .soc-feature-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 16px; margin-top: auto; padding-top: 22px; }
    .soc-feature-note { font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--ws-faint); }
    .soc-sub-h { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: calc(var(--ws-gap) * 2) 0 var(--ws-gap); }
    .soc-mini-cover { display: grid; place-items: center; color: #fff; background: radial-gradient(120% 90% at 85% 0%, #5a3a47 0%, #371e28 60%, #2a1620 100%); }
    .soc-mini-cover span { font-family: var(--subhead); font-size: 24px; letter-spacing: -0.01em; }
    @media (max-width: 860px) {
      .soc-feature { grid-template-columns: 1fr; }
      .soc-cover { min-height: 190px; }
      .soc-stats { grid-template-columns: 1fr; }
    }

    /* Chapter 02: the plan as three cards; platforms open their accounts. */
    .soc-plan-cards { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 2fr); gap: var(--ws-gap); }
    /* Four cards for every client (the third is the shoot, or the offer of one);
       the package gets the room its name needs, a long name wraps. */
    .soc-plan-cards.has-shoot { grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.3fr) minmax(0, 1.1fr) minmax(0, 1.7fr); }
    /* A little smaller, the name and its line 40% closer (Dani, 20 Oct). */
    .soc-pc { display: flex; flex-direction: column; gap: 6px; padding: 15px 18px; background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); min-width: 0; }
    .soc-pc-v + .soc-pc-s { margin-top: -2.4px; }
    .soc-pc-v { overflow-wrap: anywhere; }
    .soc-pc-link { display: inline; border: 0; background: none; padding: 0; cursor: pointer; font: inherit; color: var(--english-violet); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; text-align: left; }
    .soc-pc-k { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); }
    .soc-pc-v { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: clamp(18px, 1.6vw, 21px); font-weight: 600; letter-spacing: -0.01em; color: var(--ws-ink); }
    .soc-pc-s { font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--ws-tx); }
    /* At the foot, level with the other cards' last line; one line always,
       scaled by fitPlats() when there are more (--ps). */
    .soc-plats { --ps: 1; display: flex; flex-wrap: nowrap; gap: calc(8px * var(--ps)); margin-top: auto; overflow: hidden; }
    .soc-plat { flex: none; display: inline-flex; align-items: center; gap: calc(9px * var(--ps)); padding: calc(6px * var(--ps)) calc(12px * var(--ps)) calc(6px * var(--ps)) calc(8px * var(--ps)); font-size: calc(13px * var(--ps)) !important; border: 1px solid var(--ws-line); border-radius: var(--ws-r); font-family: var(--sans); font-size: var(--ws-t-row); color: var(--ws-ink); text-decoration: none; transition: border-color 0.2s var(--ws-ease), background 0.2s var(--ws-ease); }
    a.soc-plat:hover { border-color: #371e28; background: rgba(55,30,40,0.04); }
    .soc-plat-ic { width: calc(26px * var(--ps)); height: calc(26px * var(--ps)); border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: #371e28; }
    .soc-plat-ic svg { width: calc(14px * var(--ps)); height: calc(14px * var(--ps)); fill: none; stroke: #fff; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
    .soc-plat-go { font-size: 12px; color: var(--ws-faint); }
    @media (max-width: 1100px) { .soc-plan-cards, .soc-plan-cards.has-shoot { grid-template-columns: 1fr 1fr; } .soc-pc--wide { grid-column: 1 / -1; } }
    @media (max-width: 560px) { .soc-plan-cards { grid-template-columns: 1fr; } }

    /* Chapter 03: invoices as a table, ruled top and bottom; the older ones
       behind a drop-down. Its own names (soc-it-*): the old list's rules on
       .soc-inv-* made table cells blocks, which broke the row lines. */
    .soc-it { width: 100%; border-collapse: collapse; border-top: 1px solid var(--ws-line); border-bottom: 1px solid var(--ws-line); font-family: var(--sans); }
    .soc-it th { text-align: left; padding: 10px 12px; font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); border-bottom: 1px solid var(--ws-line); }
    .soc-it td { padding: 12px; border-top: 1px solid var(--ws-line); font-size: var(--ws-t-row); color: var(--ws-ink); vertical-align: middle; }
    .soc-it tbody:first-of-type tr:first-child td { border-top: 0; }
    .soc-it-older[hidden] { display: none; }
    .soc-it .soc-it-num, .soc-it .soc-it-amt { font-weight: 600; font-variant-numeric: tabular-nums; }
    .soc-it-state { display: inline-flex; align-items: center; height: 24px; padding: 0 10px; border-radius: 999px; font-size: var(--ws-t-meta); font-weight: 600; }
    .soc-it tr.is-due .soc-it-state { color: #371e28; background: rgba(55,30,40,0.08); }
    .soc-it tr.is-late .soc-it-state { color: #a3392b; background: rgba(163,57,43,0.1); }
    .soc-it tr.is-paid td { color: var(--ws-tx); }
    .soc-it tr.is-paid .soc-it-num, .soc-it tr.is-paid .soc-it-amt { font-weight: 500; }
    .soc-it tr.is-paid .soc-it-state { padding: 0; color: var(--ws-faint); }
    .soc-it .soc-it-tools { text-align: right; white-space: nowrap; }
    .soc-it .soc-it-tools .ws-btn + .ws-btn { margin-left: 6px; }
    .soc-it-more { display: inline-flex; align-items: center; gap: 6px; margin-top: var(--ws-gap); padding: 0; border: 0; background: none; cursor: pointer; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet); }
    .soc-it-more svg { width: 13px; height: 13px; transition: transform 0.25s var(--ws-ease); }
    .soc-it-more[aria-expanded="true"] svg { transform: rotate(180deg); }
    @media (max-width: 640px) {
      .soc-it thead { display: none; }
      .soc-it tr { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; padding: 12px 0; border-top: 1px solid var(--ws-line); }
      .soc-it td { padding: 0; border: 0; }
      .soc-it .soc-it-tools { grid-column: 1 / -1; text-align: left; margin-top: 6px; }
    }

    /* Chapter 02: the latest report as its own cover (report.astro's): the
       Socials picture with the wine card on it, like the course intros. */
    .soc-cover-banner { position: relative; display: flex; align-items: flex-end; min-height: clamp(380px, 34vw, 520px); padding: clamp(18px, 2.4vw, 34px); border-radius: 6px; overflow: hidden; border: 1px solid var(--ws-line);
      background: #e6e3e1 url('/assets/hub/smm.jpg') center / cover no-repeat; }
    .soc-cover-card { width: min(52%, 700px); max-width: 100%; padding: clamp(22px, 2.4vw, 32px); background: var(--english-violet, #4a2a3c); color: #fff; border-radius: 6px; }
    .soc-cover-eyebrow { margin: 0; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(255,255,255,0.72); }
    .soc-cover-title { margin: 10px 0 0; font-family: var(--serif); font-weight: 500; font-size: clamp(26px, 2.8vw, 38px); line-height: 1.06; letter-spacing: -0.02em; color: #fff; }
    .soc-cover-sum { margin: 10px 0 0; font-family: var(--sans); font-size: 14px; line-height: 1.6; color: rgba(255,255,255,0.84); max-width: 60ch; }
    .soc-cover-card .soc-stats { margin-top: 18px; }
    .soc-cover-card .soc-stat { border-left-color: rgba(255,255,255,0.22); }
    .soc-cover-card .soc-stat dt { color: rgba(255,255,255,0.62); }
    /* The plan cards' size (Rimberio Homes, Growth), in the figures' own face (Dani, 20 Oct). */
    .soc-cover-card .soc-stat dd { color: #fff; font-size: clamp(18px, 1.6vw, 21px); }
    .soc-cover-card .soc-delta { color: rgba(255,255,255,0.78); }
    .soc-cover-foot { display: flex; align-items: center; flex-wrap: wrap; gap: 10px 16px; margin-top: 22px; }
    .soc-cover-card .ws-btn--primary { background: #fff; color: var(--english-violet, #4a2a3c); }
    .soc-cover-card .ws-btn--primary:hover { background: var(--paper, #f4f2f1); }
    .soc-cover-note { font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(255,255,255,0.7); }
    .soc-cover-meta { position: absolute; right: clamp(18px, 2.4vw, 34px); bottom: clamp(18px, 2.4vw, 34px); font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #fff; text-shadow: 0 1px 8px rgba(0,0,0,0.35); }
    @media (max-width: 900px) { .soc-cover-card { width: 100%; } .soc-cover-meta { display: none; } .soc-cover-card .soc-stats { grid-template-columns: 1fr 1fr 1fr; } }
    @media (max-width: 560px) { .soc-cover-card .soc-stats { grid-template-columns: 1fr; } }
    /* Under it, the dashboard's Explore and Latest row: months as pills. */
    .soc-reports { margin-top: clamp(22px, 2.6vw, 34px); }
    .soc-month-pills { flex-direction: row; flex-wrap: wrap; }
    .soc-art-month { display: grid; place-items: center; color: #fff; background: radial-gradient(120% 90% at 85% 0%, #5a3a47 0%, #371e28 60%, #2a1620 100%); }
    .soc-art-month span { font-family: var(--subhead); font-size: 26px; }

    /* Chapter 04: the account manager, as the Community introduces the team. */
    .soc-team { display: grid; grid-template-columns: 170px minmax(0, 1fr); background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); overflow: hidden; }
    .soc-team-photo { background: #ece6e3 center top / cover no-repeat; min-height: 190px; }
    .soc-team-photo[hidden] { display: none; }
    .soc-team:has(.soc-team-photo[hidden]) { grid-template-columns: 1fr; }
    .soc-team-tx { display: flex; flex-direction: column; align-items: flex-start; gap: 6px; padding: clamp(20px, 2vw, 28px) clamp(20px, 2.4vw, 32px); }
    .soc-team-k { margin: 0; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); }
    .soc-team-h { margin: 0; font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: clamp(19px, 1.8vw, 24px); font-weight: 600; letter-spacing: -0.01em; color: var(--ws-ink); }
    .soc-team-p { margin: 0 0 10px; max-width: 75%; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.55; color: var(--ws-tx); }
    @media (max-width: 640px) { .soc-team { grid-template-columns: 1fr; } .soc-team-photo { min-height: 220px; } .soc-team-p { max-width: none; } }

    /* ---- Not a client: the two services ----
       Same vocabulary as everything else on the page — hairline outline,
       square corners, no fill, no shadow. The only colour is the chapter
       strip above, as everywhere else in the hub. */
    #soc-noclient:not([hidden]) { display: flex; flex-direction: column; gap: clamp(26px, 3.4vh, 46px); }
    .soc-lede-card { border-left: 3px solid var(--ws-accent); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .soc-lede-ctas { display: flex; gap: 10px; flex-wrap: wrap; flex: 0 0 auto; }
    .soc-sample-note { border-left: 3px solid var(--ws-accent); display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .soc-sample-note[hidden] { display: none; }
    .soc-lede-cta { flex: 0 0 auto; white-space: nowrap; }
    .soc-lede { font-family: var(--sans); font-size: var(--ws-t-row); line-height: 1.6; color: var(--ws-tx); margin: 0; max-width: 78ch; }
    .soc-lede strong { color: var(--ws-ink); font-weight: 700; }
    .soc-svc-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ws-gap); }
    @media (max-width: 900px) { .soc-svc-grid { grid-template-columns: 1fr; } }
    .soc-svc {
      display: flex; flex-direction: column; padding: 24px 26px 22px;
      background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r);
    }
    .soc-svc-strap { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-accent); margin: 0 0 12px; line-height: 1.5; }
    /* Helios, not The Seasons. The Seasons belongs to the page header and
       nowhere else in the hub — it was doing a job here that Helios does on
       every other card (.ws-news-h, the Studio's shelves), which is what made
       this page read as if it came from somewhere else.

       Written out rather than var(--serif) because global.css rebinds --serif
       to The Seasons inside h3/h4, and this is an h3 — so the token would have
       quietly put back the exact font being removed. */
    .soc-svc-name { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: clamp(19px, 1.7vw, 23px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; color: var(--ws-ink); margin: 0 0 10px; }
    .soc-svc-sum { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 700; line-height: 1.5; color: var(--ws-ink); margin: 0 0 10px; }
    /* Running copy on this page is --ws-t-body (13px), the size Bookings and
       the rest of the hub use for theirs. It had been set at --ws-t-meta,
       one size down, which is for units and captions, not paragraphs. */
    .soc-svc-blurb { font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.6; color: var(--ws-tx); margin: 0 0 16px; }
    .soc-svc-list { list-style: none; margin: 0 0 16px; padding: 0; display: flex; flex-direction: column; gap: 8px; }
    .soc-svc-list li { position: relative; padding-left: 18px; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.5; color: var(--ws-ink); }
    .soc-svc-list li::before { content: ""; position: absolute; left: 0; top: 7px; width: 5px; height: 5px; border-radius: 50%; background: var(--ws-accent); }
    .soc-svc-note { font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.5; color: var(--ws-faint); margin: 0 0 16px; }
    /* Said plainly rather than left for someone to find out after enquiring,
       and in the wine so it is the thing the eye lands on in that card. */
    .soc-svc-wait {
      font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.55;
      color: var(--paper); margin: 0 0 16px; padding: 12px 14px;
      border-radius: var(--ws-r); background: rgb(var(--violet-rgb, 55,30,40));
    }
    /* Pinned, so the two cards' buttons line up however long the lists are. */
    .soc-svc-foot { margin-top: auto; padding-top: 16px; border-top: 1px solid var(--ws-line); display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; }
    .soc-price { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; }
    .soc-price-tag { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); }
    .soc-price-val { font-family: var(--serif); font-size: clamp(19px, 1.7vw, 23px); font-weight: 600; letter-spacing: -0.01em; color: var(--ws-ink); }
    .soc-price-unit { font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--ws-tx); }
    .soc-price--sm .soc-price-val { font-size: var(--ws-t-row); }

    .soc-extra-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--ws-gap); }
    @media (max-width: 720px) { .soc-extra-grid { grid-template-columns: 1fr; } }
    .soc-extra { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px; background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); }
    .soc-extra-name { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 700; color: var(--ws-ink); margin: 0; }
    .soc-extra-sum { font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.5; color: var(--ws-tx); margin: 0; }
    .soc-price-note { font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.6; color: var(--ws-faint); margin: 4px 0 0; max-width: 78ch; }

    /* ---- Chapter 03: the team ---- */
    .soc-contact { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    /* Wine, on the right (the hub theme's --english-violet is the brown). */
    .soc-contact .ws-btn--primary { background: #371e28; margin-left: auto; }
    .soc-contact .ws-btn--primary:hover { background: #2a1620; }
    /* A heading like the report card's ("May 2026"), not bold body text. */
    .soc-contact-h { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: clamp(18px, 1.6vw, 21px); font-weight: 600; letter-spacing: -0.01em; line-height: 1.2; color: var(--ws-ink); margin: 0 0 6px; }
    .soc-contact-p { font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.5; color: var(--ws-tx); margin: 0; }

    /* ---- Waitlist confirmation ---- */
    .soc-wl-scrim { position: fixed; inset: 0; z-index: 200; display: flex; align-items: center; justify-content: center; padding: 24px; background: rgba(20,18,26,0.45); }
    .soc-wl-scrim[hidden] { display: none; }
    .soc-wl-card { position: relative; width: 460px; max-width: 100%; background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); padding: 30px 32px 26px; }
    .soc-wl-x { position: absolute; top: 12px; right: 14px; border: 0; background: none; font-size: 26px; line-height: 1; color: rgba(28,29,34,0.4); cursor: pointer; }
    .soc-wl-eyebrow { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-accent); margin: 0 0 10px; }
    .soc-wl-h { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: clamp(21px, 2vw, 25px); font-weight: 600; letter-spacing: -0.01em; color: var(--ws-ink); margin: 0 0 8px; }
    .soc-wl-lead { font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.6; color: var(--ws-tx); margin: 0 0 18px; }
    /* Their details, shown rather than asked for — so they can see exactly what
       is about to be sent before they agree to it. */
    .soc-wl-you[hidden], .soc-wl-note[hidden] { display: none; }
    .soc-wl-you { margin: 0 0 10px; padding: 14px 16px; border: 1px solid var(--ws-line); border-radius: var(--ws-r); display: grid; grid-template-columns: auto 1fr; gap: 6px 14px; }
    .soc-wl-you dt { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-faint); }
    .soc-wl-you dd { margin: 0; font-family: var(--sans); font-size: var(--ws-t-meta); color: var(--ws-ink); min-width: 0; overflow-wrap: anywhere; }
    .soc-wl-note { font-family: var(--sans); font-size: var(--ws-t-label); color: var(--ws-faint); margin: 0 0 16px; }
    .soc-wl-note a { color: var(--ws-accent); font-weight: 700; text-decoration: none; }
    .soc-wl-check { display: flex; align-items: flex-start; gap: 9px; font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.45; color: var(--ws-tx); margin-bottom: 18px; cursor: pointer; }
    .soc-wl-check input { margin-top: 2px; flex: none; }
    .soc-wl-error { font-family: var(--sans); font-size: var(--ws-t-meta); color: #b3261e; margin: 0 0 12px; }
    .soc-wl-error[hidden] { display: none; }
    .soc-wl-go { width: 100%; }
    .soc-wl-cancel { display: block; width: 100%; margin-top: 10px; border: 0; background: none; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600; color: var(--ws-faint); cursor: pointer; padding: 8px; }
    .soc-wl-cancel:hover { color: var(--ws-ink); }

    @media (max-width: 720px) {
      .soc-contact { flex-direction: column; align-items: flex-start; }
    }
  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";
    import { MONTHS } from "../../lib/report-insights.js";
    import { resolveVisibility } from "../../lib/report-fields.js";
    import { PLATFORM_LABELS, platformsOf } from "../../lib/report-metrics.js";
    import { DEMO_REPORTS } from "../../lib/report-insights-demo.js";
    // Here, in the page's script: imported in the frontmatter above it only
    // existed at build time, so the sign-in check threw and the page sat on
    // "Loading your social media" for everyone (Dani, 17 Oct).
    import { isTrainingDemo } from "../../lib/demo.js";
    import { TRAINING_SMM } from "../../lib/training-smm.js";
    import { TEAM } from "../../data/tmke-team.js";

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const DEV = import.meta.env.DEV;
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));

    let reports = [], vis = resolveVisibility(null);

    /* Where we keep each platform's address, so a chip can be the way to their
       own account rather than a label saying they have one. */
    const PLAT_IC = {
      instagram: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/></svg>',
      facebook: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 8.5h2.5V5H14a3.5 3.5 0 0 0-3.5 3.5V11H8v3.5h2.5V21H14v-6.5h2.5L17 11h-3V9a.5.5 0 0 1 .5-.5z"/></svg>',
      linkedin: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="2.5"/><path d="M8 10.5V16M8 7.6v.1M11.5 16v-3.3a2 2 0 0 1 4 0V16M11.5 10.5V16"/></svg>',
      youtube: '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="3.5"/><path d="M10.5 9.5v5l4-2.5z" fill="currentColor"/></svg>',
      tiktok: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5M14 4c.5 2.5 2.2 4 5 4.3"/></svg>',
    };
    const platKey = (name) => String(name || "").toLowerCase().replace(/[^a-z]/g, "");
    const ARROW = '<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>';
    /* The account manager as the Community introduces the team: their photo,
       name and role, matched on the first name we hold ("Abbie" is Abigail). */
    function managerOf(name) {
      const n = String(name || "").trim().toLowerCase();
      if (!n) return null;
      return TEAM.find((t) => [t.short, t.name, t.key].some((x) => {
        const v = String(x || "").toLowerCase();
        return v === n || v.split(" ")[0] === n || (n.length >= 3 && v.slice(0, 3) === n.slice(0, 3));
      })
        // The name they go by, as on their photo's file ("Abbie - About Us.png").
        || (() => { try { return decodeURIComponent(String(t.photo || "")).toLowerCase().includes(n); } catch (_) { return false; } })()) || null;
    }
    const PLATFORM_URL = {
      instagram: "instagram_url", facebook: "facebook_url", linkedin: "linkedin_url",
      youtube: "youtube_url", tiktok: "tiktok_url",
    };

    let client = null;
    function renderPlan(c) {
      client = c;
      const plats = Array.isArray(c.platforms) ? c.platforms : [];
      /* A platform we hold a link for opens their account, alongside the
         hub; one we have no address for is shown, not linked. */
      const tile = (name) => {
        const key = platKey(name), href = c[PLATFORM_URL[key]];
        const inner = `<span class="soc-plat-ic">${PLAT_IC[key] || ""}</span><span class="soc-plat-name">${esc(name)}</span>${href ? '<span class="soc-plat-go" aria-hidden="true">&#8599;</span>' : ""}`;
        return href
          ? `<a class="soc-plat" href="${esc(href)}" target="_blank" rel="noopener noreferrer" title="Open ${esc(name)}">${inner}</a>`
          : `<span class="soc-plat">${inner}</span>`;
      };
      const since = c.start_date ? (() => { try { return new Date(c.start_date + "T12:00:00").toLocaleDateString("en-GB", { month: "long", year: "numeric" }); } catch (_) { return null; } })() : null;
      const price = priceOf(c);
      const status = $("soc-status");
      if (status) { status.textContent = "Active"; status.hidden = false; }
      $("soc-plan").innerHTML = `<div class="soc-plan-cards">
          <div class="soc-pc">
            <span class="soc-pc-k">Account</span>
            <strong class="soc-pc-v">${esc(c.business || "Your account")}</strong>
            ${since ? `<span class="soc-pc-s">Managed since ${esc(since)}</span>` : ""}
          </div>
          <div class="soc-pc">
            <span class="soc-pc-k">Package</span>
            <strong class="soc-pc-v">${esc(c.package_name || "Social media management")}</strong>
            ${price ? `<span class="soc-pc-s">${esc(price)}</span>` : ""}
          </div>
          ${shootCard(c)}
          <div class="soc-pc soc-pc--wide">
            <span class="soc-pc-k">Platforms</span>
            <div class="soc-plats" id="soc-plats">${plats.length ? plats.map(tile).join("") : '<span class="soc-pc-s">&mdash;</span>'}</div>
          </div>
        </div>`;
      $("soc-plan").firstElementChild.classList.add("has-shoot");
      fitPlats();
      renderTeam(c);
    }
    /* Shot and Scheduled: the quarterly shoot (Dani, 20 Oct), worked out by
       the Worker (smmShootCycle). Booked, its date; otherwise the month it's
       due, with the way to ask for it. */
    function shootCard(c) {
      /* Not on Shot and Scheduled: the same card offers a filming day, so
         every client sees four cards (Dani, 20 Oct). */
      const sh = c.shoot;
      if (!sh) return `<div class="soc-pc"><span class="soc-pc-k">Filming</span><strong class="soc-pc-v">Not in your plan</strong>
        <span class="soc-pc-s"><a class="soc-pc-link" href="/videography">Book a videography day</a></span></div>`;
      const m = managerOf(c.social_media_manager);
      const who = (m && m.short) || String(c.social_media_manager || "").split(" ")[0] || "your team";
      const mon = (iso) => { try { return new Date(String(iso).slice(0, 10) + "T12:00:00").toLocaleDateString("en-GB", { month: "long" }); } catch (_) { return ""; } };
      const day = (iso) => { try { return new Date(iso).toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short" }); } catch (_) { return ""; } };
      if (sh.booked) return `<div class="soc-pc"><span class="soc-pc-k">Next shoot</span><strong class="soc-pc-v">Booked: ${esc(day(sh.booked))}</strong><span class="soc-pc-s">Your filming day with TMKE</span></div>`;
      if (!sh.due) return `<div class="soc-pc"><span class="soc-pc-k">Next shoot</span><strong class="soc-pc-v">Not booked yet</strong>
        <span class="soc-pc-s"><button type="button" class="soc-pc-link" data-book-shoot="">Message ${esc(who)} to book it in</button></span></div>`;
      return `<div class="soc-pc"><span class="soc-pc-k">Next shoot</span><strong class="soc-pc-v">Due in ${esc(mon(sh.due))}</strong>
        <span class="soc-pc-s"><button type="button" class="soc-pc-link" data-book-shoot="${esc(mon(sh.due))}">Message ${esc(who)} to book it in</button></span></div>`;
    }
    /* The platforms stay on one line: more of them, and they get smaller
       rather than wrap (Dani, 20 Oct). */
    function fitPlats() {
      const row = $("soc-plats"); if (!row) return;
      let k = 1;
      row.style.setProperty("--ps", "1");
      while (row.scrollWidth > row.clientWidth + 1 && k > 0.6) { k = Math.round((k - 0.05) * 100) / 100; row.style.setProperty("--ps", String(k)); }
    }
    addEventListener("resize", () => fitPlats());
    function priceOf(c) {
      if (c.price == null || c.price === "") return null;
      const n = Number(c.price);
      return Number.isFinite(n)
        ? "£" + n.toLocaleString("en-GB", { minimumFractionDigits: n % 1 ? 2 : 0, maximumFractionDigits: 2 }) + " a month"
        : String(c.price);
    }
    function renderTeam(c) {
      const m = managerOf(c.social_media_manager);
      const name = c.social_media_manager || (m && m.short) || "";
      const first = (m && m.short) || name.split(" ")[0] || "";
      const ph = $("soc-team-photo");
      if (ph) { ph.style.backgroundImage = m && m.photo ? `url("${m.photo}")` : ""; ph.hidden = !(m && m.photo); }
      if (name) {
        $("soc-team-k").textContent = "Your account manager";
        $("soc-team-name").textContent = (m && m.name) || name;
        $("soc-team-p").textContent = `${(m && m.role) || "Social Media Manager"}. ${first} looks after your account day to day: your content, your posting and your monthly report. Questions about any of it, from content ideas to the numbers, go straight to ${first}.`;
        $("soc-msg-open").textContent = `Message ${first}`;
        $("soc-hero-msg").textContent = `Message ${first}`;
      }
    }

    /* ---- Chapter 03: the reports ----
       The report itself is read on its own page, a slide at a time, the way
       the courses are (social/report.astro). Here it is the cover for the
       latest month, with three headline figures to glance at, and the months
       before it underneath. */
    let isSample = false;
    const repHref = (r) => isSample ? `/account/social/report?sample=${encodeURIComponent(r.id)}` : `/account/social/report?r=${encodeURIComponent(r.id)}`;
    const platKeysOf = (r) => platformsOf(r.data);
    const platLabel = (r) => platKeysOf(r).map((k) => PLATFORM_LABELS[k]).join(", ") || r.platform || "";
    const num = (v) => { const n = Number(String(v == null ? "" : v).replace(/[^0-9.-]/g, "")); return Number.isFinite(n) ? n : null; };
    /* A report's three headline figures, for one platform: Instagram's, else
       Facebook's or LinkedIn's, as the report itself leads. */
    function figsOf(r, first) {
      const d = (r && r.data) || {}, p = d.profile || {}, fb = d.facebook || {}, li = d.linkedin || {};
      return (first === "facebook"
        ? [["Page likes", fb.pageLikes, vis.followers], ["Page reach", fb.pageReach, vis.reach], ["Engagement", (fb.posts || {}).engagement, vis.interactions]]
        : first === "linkedin"
        ? [["Followers", li.followers, vis.followers], ["Post reach", (li.posts || {}).reach, vis.reach], ["Engagement", (li.posts || {}).engagement, vis.interactions]]
        : [["Followers", p.followers, vis.followers], ["Reach", p.reach, vis.reach], ["Interactions", p.interactions, vis.interactions]]
      ).filter(([, v, on]) => on !== false && num(v) != null);
    }
    /* The first line of a report's summary, for the cover. */
    const firstLine = (r) => String(((r && r.data) || {}).summary || "").split(/\n+/).map((l) => l.replace(/^[-•*]\s*/, "").trim()).filter(Boolean)[0] || "";
    /* A report's best post's picture, for its card. */
    const thumbOf = (r) => {
      const d = (r && r.data) || {};
      const pools = [d.content, (d.facebook || {}).content, (d.linkedin || {}).content].filter(Array.isArray);
      for (const list of pools) { const hit = list.find((x) => x && x.thumb); if (hit) return hit.thumb; }
      return "";
    };
    function renderReports() {
      const wrap = $("soc-insights");
      if (!reports.length) { wrap.innerHTML = `<div class="soc-card"><p class="soc-state">Your first monthly report will appear here once we've published it.</p></div>`; return; }
      const [latest, ...earlier] = reports;
      const first = platKeysOf(latest)[0];
      const prev = earlier[0] || null;
      const before = prev ? figsOf(prev, first) : [];
      // Each figure, and how it moved on the month before.
      const stats = figsOf(latest, first).map(([k, v]) => {
        const now = num(v), then = num((before.find(([kk]) => kk === k) || [])[1]);
        let delta = "";
        if (prev && then != null) {
          const d = now - then, pct = then ? Math.round((d / then) * 100) : null;
          delta = d === 0 ? `<span class="soc-delta">Level with ${esc(MONTHS[prev.month])}</span>`
            : `<span class="soc-delta">${d > 0 ? "&#9650;" : "&#9660;"} ${esc(Math.abs(d).toLocaleString("en-GB"))}${pct ? ` (${Math.abs(pct)}%)` : ""} on ${esc(MONTHS[prev.month])}</span>`;
        }
        return `<div class="soc-stat"><dt>${esc(k)}</dt><dd>${esc(now.toLocaleString("en-GB"))}</dd>${delta}</div>`;
      }).join("");
      const line = firstLine(latest);
      const label = (r) => `${MONTHS[r.month]} ${r.year}`;
      const latestThree = reports.slice(0, 3);
      wrap.innerHTML = `
        <div class="soc-cover-banner">
          <div class="soc-cover-card">
            <p class="soc-cover-eyebrow">Latest report${platLabel(latest) ? ` &middot; ${esc(platLabel(latest))}` : ""}</p>
            <h3 class="soc-cover-title">How ${esc(MONTHS[latest.month])} went</h3>
            ${line ? `<p class="soc-cover-sum">${esc(line)}</p>` : ""}
            ${stats ? `<dl class="soc-stats">${stats}</dl>` : ""}
            <div class="soc-cover-foot">
              <a class="ws-btn ws-btn--primary" href="${repHref(latest)}">Read the report ${ARROW}</a>
              ${first && platKeysOf(latest).length > 1 ? `<span class="soc-cover-note">Figures are ${esc(PLATFORM_LABELS[first])}'s; the report has every platform.</span>` : ""}
            </div>
          </div>
          <span class="soc-cover-meta">${esc(label(latest))}</span>
        </div>
        ${reports.length > 1 ? `<div class="ws-wn soc-reports">
          <div class="ws-wn-col ws-wn-col--keys">
            <p class="ws-wn-label">All reports</p>
            <nav class="ws-wn-pills soc-month-pills" aria-label="All reports">
              ${reports.map((r) => `<a class="ws-wn-pill" href="${repHref(r)}">${esc(label(r))}</a>`).join("")}
            </nav>
          </div>
          <div class="ws-wn-col">
            <p class="ws-wn-label">Latest</p>
            <div class="ws-wn-cards">${latestThree.map((r) => {
              const pic = thumbOf(r);
              return `<a class="ws-wn-card" href="${repHref(r)}">
                <span class="ws-wn-art${pic ? "" : " soc-art-month"}"${pic ? ` style="background-image:url('${esc(pic)}')"` : ""}>${pic ? "" : `<span>${esc(String(MONTHS[r.month]).slice(0, 3))}</span>`}</span>
                <span class="ws-wn-tx">
                  <span class="ws-wn-flag">Monthly report</span>
                  <strong class="ws-wn-h">${esc(label(r))}</strong>
                </span>
              </a>`; }).join("")}</div>
          </div>
        </div>` : ""}`;
      const read = $("soc-hero-read"); if (read) read.href = repHref(latest);
    }

    /* The header's three boxes (the dashboard's): the plan, the latest report
       and what's owed. Painted once everything they say is known. */
    /* "Growth plan": the package's own name, its first part only, so it
       stays on one line (Dani, 20 Oct). */
    function planName(name) {
      const first = String(name || "").split(/\s[–—-]\s|[(:,+/]/)[0].trim();
      if (!first) return "Your plan";
      return /\b(plan|package)$/i.test(first) ? first : `${first} plan`;
    }
    function paintBrief(invoices) {
      const ul = $("soc-brief"); if (!ul || !client) return;
      const latest = reports[0];
      const owing = (invoices || []).filter((i) => i.status !== "paid");
      const owed = owing.reduce((t, i) => t + (i.total_pence || 0), 0);
      const nextDue = owing.map((i) => i.due_date).filter(Boolean).sort()[0];
      const IC = {
        plan: '<svg viewBox="0 0 24 24"><path d="M12 3l2.6 5.6 6 .7-4.5 4.1 1.2 6L12 16.4 6.7 19.4l1.2-6L3.4 9.3l6-.7z"/></svg>',
        rep: '<svg viewBox="0 0 24 24"><path d="M4 19V5M4 19h16M8 15v-4M12 15V8M16 15v-6"/></svg>',
        inv: '<svg viewBox="0 0 24 24"><path d="M6 3h12v18l-3-2-3 2-3-2-3 2z"/><path d="M9 8h6M9 12h6"/></svg>',
      };
      const box = (ic, cls, v, sub, href) => `<li><${href ? `a class="ws-brief-slot" href="${href}"` : 'span class="ws-brief-slot"'}>
          <span class="ws-brief-ic ${cls}">${ic}</span>
          <span class="ws-brief-tx"><strong>${v}</strong><span>${sub}</span></span></${href ? "a" : "span"}></li>`;
      ul.innerHTML = [
        box(IC.plan, "ws-brief-ic--sched", esc(planName(client.package_name)), esc(priceOf(client) || "social media management"), "#soc-plan-h"),
        latest ? box(IC.rep, "ws-brief-ic--time", `${esc(MONTHS[latest.month])} report`, "ready to read", repHref(latest))
               : box(IC.rep, "ws-brief-ic--time", "First report", "on its way", ""),
        (invoices && invoices.length)
          ? (owing.length
              ? box(IC.inv, "ws-brief-ic--due", `${esc(gbp(owed))} to pay`, nextDue ? `due ${esc(dShort(nextDue))}` : "outstanding", "#soc-bill-h")
              : box(IC.inv, "ws-brief-ic--due", "All paid", "nothing owed", "#soc-bill-h"))
          : box(IC.inv, "ws-brief-ic--due", "No invoices", "yet", ""),
      ].join("");
      ul.hidden = false;
      $("soc-hero-cta").hidden = false;
      const sub = $("soc-sub");
      if (sub && client.business) sub.textContent = `${client.business}${client.package_name ? `, on the ${client.package_name} plan` : ""}. Your plan, your invoices and how your accounts did, month by month.`;
    }

    // A prospect can see the client view filled with sample numbers, and come back.
    const SAMPLE = { client: { business: "The Marketing Experts", social_media_manager: "Abbie", package_name: "Growth", platforms: ["Instagram", "Facebook", "LinkedIn"], start_date: "2026-02-01" },
      // One account's months, newest first, as the Worker sends a real client's.
      reports: DEMO_REPORTS.filter((r) => r.accountId === "tmke").sort((a, b) => (b.year * 12 + b.month) - (a.year * 12 + a.month)) };
    const showSample = () => {
      isSample = true;
      $("soc-noclient").hidden = true;
      $("soc-sample-note").hidden = false;
      show(SAMPLE);
      window.scrollTo({ top: 0, behavior: "smooth" });
    };
    $("soc-sample")?.addEventListener("click", showSample);
    $("soc-sample-back")?.addEventListener("click", () => {
      isSample = false;
      $("soc-client").hidden = true; $("soc-sample-note").hidden = true;
      const st = $("soc-status"); if (st) st.hidden = true;
      $("soc-brief").hidden = true; $("soc-hero-cta").hidden = true;
      $("soc-noclient").hidden = false;
      window.scrollTo({ top: 0, behavior: "smooth" });
    });
    function show(data) {
      clearTimeout(socTimer);
      $("soc-loading").hidden = true;
      if (!data || !data.client) { $("soc-noclient").hidden = false; return; }
      $("soc-client").hidden = false;
      vis = resolveVisibility(data.visibility);
      renderPlan(data.client);
      reports = (data.reports || []).map((r) => ({ id: r.id, platform: r.platform, month: r.month, year: r.year, data: r.data }));
      renderReports();
      renumberChapters();
      // The header's boxes once the invoices are known, so none changes after.
      loadInvoices().then(paintBrief, () => paintBrief([]));
      wireMessage(data.client);
    }

    /* Chapters count only the ones on show, so a hidden Invoices chapter (not
       invoiced yet, or billed to another brand) doesn't leave 01, 03, 04. */
    function renumberChapters() {
      let n = 0;
      document.querySelectorAll("#soc-client .ws-block").forEach((b) => {
        const ch = b.querySelector(".ws-block-ch");
        if (!ch || b.hidden) return;
        ch.textContent = "Chapter " + String(++n).padStart(2, "0");
      });
    }

    /* ---- Message your team ----
       We already hold their name, address and number, so the form asks for the
       one thing we do not know and shows the rest rather than making somebody
       retype what is on their own record. */
    function wireMessage(client) {
      const open = $("soc-msg-open"), scrim = $("soc-msg");
      if (!open || !scrim) return;
      const me = {
        name: (client && (client.full_name || client.business)) || "",
        email: (client && client.email) || "",
        phone: (client && client.phone) || "",
      };
      const sub = $("soc-msg-sub");
      if (sub && client && client.social_media_manager) {
        sub.textContent = `Goes straight to ${client.social_media_manager}, who looks after your account.`;
      }
      const you = $("soc-msg-you");
      if (you) {
        you.innerHTML = [
          me.name ? `<dt>You</dt><dd>${esc(me.name)}</dd>` : "",
          me.email ? `<dt>Email</dt><dd>${esc(me.email)}</dd>` : "",
          me.phone ? `<dt>Phone</dt><dd>${esc(me.phone)}</dd>` : "",
        ].join("");
        you.hidden = !you.innerHTML;
      }
      // Opened from a report: closing it (sent or not) goes back to that
      // report's finished slide, not this page (Danielle, 20 Oct 2026).
      const fromReport = new URLSearchParams(location.search).get("report");
      const close = () => {
        if (fromReport) { location.href = `/account/social/report?r=${encodeURIComponent(fromReport)}#finished`; return; }
        scrim.hidden = true;
      };
      $("soc-hero-msg")?.addEventListener("click", () => open.click());
      document.addEventListener("click", (e) => {
        const b = e.target.closest && e.target.closest("[data-book-shoot]"); if (!b) return;
        open.click();
        const box = $("soc-msg-body");
        if (box && !box.value.trim()) box.value = `Hi, I'd like to book in my ${b.dataset.bookShoot ? b.dataset.bookShoot + " " : "next "}shoot. These dates work for me: `;
      });
      open.addEventListener("click", () => {
        $("soc-msg-note").hidden = true;
        scrim.hidden = false;
        $("soc-msg-body").focus();
      });
      $("soc-msg-cancel").addEventListener("click", close);
      scrim.addEventListener("click", (e) => { if (e.target === scrim) close(); });
      // The report's last slide sends them here to ask about it.
      if (location.hash === "#message") { history.replaceState(null, "", location.pathname); open.click(); }

      $("soc-msg-send").addEventListener("click", async () => {
        const btn = $("soc-msg-send"), note = $("soc-msg-note");
        const body = $("soc-msg-body").value.trim();
        const say = (m, cls) => { note.textContent = m; note.className = "soc-msg-note " + (cls || ""); note.hidden = false; };
        if (!body) { say("Write something first.", "is-err"); return; }
        if (isTrainingDemo()) { say("This is the training account, so nothing is sent.", "is-ok"); if (fromReport) setTimeout(close, 1600); return; }
        btn.disabled = true; btn.textContent = "Sending…";
        try {
          const { data: { session } } = await supabase.auth.getSession();
          const res = await fetch(`${WORKER}/smm/message`, {
            method: "POST",
            headers: { Authorization: "Bearer " + session.access_token, "Content-Type": "application/json" },
            body: JSON.stringify({ body, name: me.name, phone: me.phone }),
          });
          const j = await res.json().catch(() => ({}));
          if (!res.ok || !j.ok) { say(j.error || "That didn't send. Try again in a minute.", "is-err"); return; }
          $("soc-msg-body").value = "";
          say("Sent — we'll come back to you.", "is-ok");
          setTimeout(close, 1600);
        } catch (_) { say("That didn't send. Try again in a minute.", "is-err"); }
        finally { btn.disabled = false; btn.textContent = "Send message"; }
      });
    }

    /* ---- Invoices ----
       Anything outstanding first, because that is the one with something to do
       about it; everything settled underneath, downloadable for as long as
       they need it. The card link is the same signed page the emailed button
       opens, so there is one way to pay rather than two to keep in step. */
    const gbp = (p) => {
      const v = (p || 0) / 100;
      return "£" + v.toLocaleString("en-GB", { minimumFractionDigits: v % 1 ? 2 : 0, maximumFractionDigits: 2 });
    };
    const dShort = (d) => d ? new Date(d + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : "";

    async function loadInvoices() {
      const block = $("soc-bill"), wrap = $("soc-bill-block");
      if (!block || !wrap || !WORKER) return [];
      let list = [];
      const training = isTrainingDemo();
      if (training) list = TRAINING_SMM.invoices || [];
      else try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return [];
        const res = await fetch(`${WORKER}/smm/invoices`, { headers: { Authorization: "Bearer " + session.access_token } });
        const j = await res.json().catch(() => null);
        if (!j || !j.ok) return [];
        list = j.invoices || [];
      } catch (_) { return []; }
      // Nothing billed yet is not worth a chapter saying so.
      if (!list.length) return [];

      const owing = list.filter((i) => i.status !== "paid");
      const settled = list.filter((i) => i.status === "paid");
      const strip = $("soc-bill-status");
      if (strip) {
        strip.textContent = owing.length
          ? `${owing.length} outstanding`
          : "All settled";
        strip.hidden = false;
      }

      /* A table, ruled top and bottom like the hub's others (Dani, 20 Oct):
         what's owed and the latest paid one on show, the older ones in a
         drop-down, because after a year there are a dozen. */
      const row = (i) => {
        const paid = i.status === "paid";
        const overdue = !paid && i.due_date && new Date(i.due_date + "T23:59:59") < new Date();
        const when = paid ? `Paid ${esc(dShort(i.paid_date))}` : `${overdue ? "Overdue since" : "Due"} ${esc(dShort(i.due_date))}`;
        return `<tr class="${paid ? "is-paid" : "is-due"}${overdue ? " is-late" : ""}">
          <td class="soc-it-num">${esc(i.number || "Invoice")}</td>
          <td class="soc-it-amt">${esc(gbp(i.total_pence))}</td>
          <td><span class="soc-it-state">${when}</span></td>
          <td class="soc-it-tools">
            ${i.pay_url && !paid ? `<a class="ws-btn ws-btn--primary ws-btn--sm" href="${esc(i.pay_url)}">Pay now</a>` : ""}
            <button type="button" class="ws-btn ws-btn--ghost ws-btn--sm" data-pdf="${esc(i.id)}">Download</button>
          </td>
        </tr>`;
      };
      const shown = owing.concat(settled.slice(0, owing.length ? 1 : 2));
      const older = settled.slice(owing.length ? 1 : 2);
      block.innerHTML = `<table class="soc-it">
          <thead><tr><th scope="col">Invoice</th><th scope="col">Amount</th><th scope="col">Status</th><th scope="col"><span class="soc-sr">Actions</span></th></tr></thead>
          <tbody>${shown.map(row).join("")}</tbody>
          ${older.length ? `<tbody class="soc-it-older" id="soc-it-older" hidden>${older.map(row).join("")}</tbody>` : ""}
        </table>
        ${older.length ? `<button type="button" class="soc-it-more" id="soc-it-more" aria-expanded="false" aria-controls="soc-it-older">Show older invoices (${older.length})<svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 6l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>` : ""}`;
      $("soc-it-more")?.addEventListener("click", (e) => {
        const b = e.currentTarget, body = $("soc-it-older"), open = body.hidden;
        body.hidden = !open; b.setAttribute("aria-expanded", String(open));
        b.firstChild.textContent = open ? "Hide older invoices" : `Show older invoices (${older.length})`;
      });

      block.querySelectorAll("[data-pdf]").forEach((b) => b.addEventListener("click", async () => {
        const label = b.textContent;
        if (training) { b.textContent = "Not in training"; setTimeout(() => { b.textContent = label; }, 1600); return; }
        b.disabled = true; b.textContent = "Preparing…";
        try {
          const { data: { session } } = await supabase.auth.getSession();
          const res = await fetch(`${WORKER}/smm/invoice-pdf?id=${encodeURIComponent(b.getAttribute("data-pdf"))}`,
            { headers: { Authorization: "Bearer " + session.access_token } });
          const j = await res.json().catch(() => ({}));
          if (j && j.url) window.open(j.url, "_blank", "noopener");
          else b.textContent = "Couldn't open it";
        } catch (_) { b.textContent = "Couldn't open it"; }
        finally { setTimeout(() => { b.disabled = false; b.textContent = label; }, 1200); }
      }));

      wrap.hidden = false;
      renumberChapters();
      return list;
    }

    /* ---- Join the waitlist ----
       A confirmation, because everyone on this page is signed in. It shows the
       details it is about to use so nobody agrees to something they cannot
       see, and the Worker reads them from the account rather than trusting
       what this sends — otherwise the confirm box would be a way to file an
       entry in someone else's name. */
    function wireWaitlist(session) {
      const scrim = $("soc-wl"), go = $("soc-wl-go"), err = $("soc-wl-error");
      if (!scrim) return;
      const meta = (session && session.user && session.user.user_metadata) || {};
      const email = (session && session.user && session.user.email) || "";
      const name = meta.name || meta.full_name || "";
      const business = meta.company || "";
      const row = (k, v) => v ? `<dt>${esc(k)}</dt><dd>${esc(v)}</dd>` : "";
      const rows = row("Name", name) + row("Business", business) + row("Email", email);
      $("soc-wl-you").innerHTML = rows;
      // Nothing to show is better shown as nothing than as an empty box.
      $("soc-wl-you").hidden = !rows;
      document.querySelector(".soc-wl-note").hidden = !rows;

      const open = () => { err.hidden = true; scrim.hidden = false; document.documentElement.style.overflow = "hidden"; };
      const close = () => { scrim.hidden = true; document.documentElement.style.overflow = ""; };
      document.querySelectorAll('[data-smm-form="waitlist"]').forEach((b) => b.addEventListener("click", open));
      $("soc-wl-x").addEventListener("click", close);
      $("soc-wl-cancel").addEventListener("click", close);
      scrim.addEventListener("click", (e) => { if (e.target === scrim) close(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !scrim.hidden) close(); });

      go.addEventListener("click", async () => {
        err.hidden = true;
        const orig = go.textContent;
        go.disabled = true; go.textContent = "Adding you…";
        try {
          if (!WORKER || !session) throw new Error("This isn't quite live yet — please email hello@tmke.co.uk and we'll sort it.");
          const res = await fetch(`${WORKER}/smm/waitlist`, {
            method: "POST",
            headers: { "Content-Type": "application/json", Authorization: "Bearer " + session.access_token },
            body: JSON.stringify({ source: "hub", marketing_opt_in: $("soc-wl-optin").checked }),
          });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(d.error || "Something went wrong — please try again.");
          $("soc-wl-h").textContent = "You're on the list";
          $("soc-wl-lead").textContent = "We'll be in touch the moment a space opens up. Check your inbox — we've sent you a confirmation.";
          ["soc-wl-you", "soc-wl-optin", "soc-wl-go"].forEach((id) => $(id)?.closest("dl, label, button")?.setAttribute("hidden", ""));
          document.querySelector(".soc-wl-note")?.setAttribute("hidden", "");
          $("soc-wl-cancel").textContent = "Close";
        } catch (e2) {
          err.textContent = e2 && e2.message ? e2.message : "Something went wrong — please try again.";
          err.hidden = false;
        } finally { go.disabled = false; go.textContent = orig; }
      });
    }

    /* Never stuck on "Loading your social media…". It waited, with nothing
       said, on the sign-in check and on the Worker; if either stalled the
       message sat there for good (Dani, 14 Oct: "Loading your social media
       does not seem to be working"). After 12 seconds it says so, offers a
       retry, and the console says which step it was waiting on. */
    let socStep = "starting";
    const socTimer = setTimeout(() => {
      const el = $("soc-loading");
      if (!el || el.hidden) return;
      console.error("[smm] still waiting after 12s on:", socStep);
      el.innerHTML = 'Your social media didn\u2019t load. <button type="button" class="soc-retry">Try again</button>';
      el.querySelector(".soc-retry")?.addEventListener("click", () => location.reload());
    }, 12000);
    (async () => {
      socStep = "the sign-in";
      const { data: { session } } = await supabase.auth.getSession();
      if (session && session.user) $("footer-email").textContent = session.user.email || "";
      wireWaitlist(session);
      /* The training account is a managed client: Rimberio Homes on
         Instagram, Facebook and LinkedIn (src/lib/training-smm.js), never
         the signed-in person's own plan, and nothing from the database. */
      if (isTrainingDemo()) { show(TRAINING_SMM); return; }
      if (!session) {
        if (DEV || isTrainingDemo()) { showSample(); return; }
        location.replace("/login?next=" + encodeURIComponent("/account/social"));
        return;
      }
      // getSession() is local-only - a cleared/revoked session can still look
      // valid to it. Confirm with the server before letting anyone in.
      if (!DEV && !isTrainingDemo()) {
        socStep = "the server's check of the sign-in";
        const { data: { user }, error } = await supabase.auth.getUser();
        if (!user || error) { location.replace("/login?next=" + encodeURIComponent("/account/social")); return; }
      }
      if (!WORKER) { show({ client: null }); return; }
      try {
        socStep = "the Worker (/smm/mine)";
        const res = await fetch(`${WORKER}/smm/mine`, { headers: { Authorization: "Bearer " + session.access_token } });
        if (!res.ok) console.error("[smm] /smm/mine answered", res.status);
        const j = await res.json().catch(() => ({}));
        socStep = "drawing the page";
        show(j);
        // Back from reading the sample report: land on the sample again.
        if (!j.client && new URLSearchParams(location.search).has("sample")) showSample();
      } catch (e) { console.error("[smm] failed at", socStep, e); show({ client: null }); }
    })().catch((e) => console.error("[smm] failed at", socStep, e));
  </script>
</BaseLayout>
