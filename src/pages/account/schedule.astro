      max-height: 340px;
      display: flex; align-items: center; justify-content: center;
    }
    .post-preview img { max-width: 100%; max-height: 340px; width: auto; height: auto; display: block; object-fit: contain; }
    .post-fields { display: flex; flex-direction: column; gap: 14px; flex: 0 0 auto; }
    .post-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .post-field { display: flex; flex-direction: column; gap: 6px; }
    .post-label {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--violet-deep);
    }
    .post-label--row { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .post-ai {
      appearance: none; border: 1px solid rgba(var(--violet-rgb), 0.3); background: rgba(var(--violet-rgb), 0.06);
      color: var(--violet-deep); font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.04em;
      text-transform: none; padding: 5px 11px; border-radius: 999px; cursor: pointer; transition: background 0.18s, border-color 0.18s;
    }
    .post-ai:hover { background: rgba(var(--violet-rgb), 0.12); border-color: var(--english-violet); }
    .post-input, .post-textarea {
      appearance: none;
      width: 100%;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.18);
      border-radius: 4px;
      padding: 10px 12px;
      font-family: var(--sans);
      font-size: var(--ws-t-row);
      color: var(--ink);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .post-input:focus, .post-textarea:focus {
      outline: none;
      border-color: var(--violet-deep);
      box-shadow: 0 0 0 3px rgba(var(--violet-rgb), 0.12);
    }
    .post-textarea { resize: vertical; min-height: 96px; line-height: 1.55; }
    .post-plat {
      margin: -4px 0 0;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.5);
    }
    .post-remind {
      display: flex; align-items: flex-start; gap: 10px;
      padding: 12px 14px;
      background: rgba(var(--violet-rgb), 0.05);
      border: 1px solid rgba(var(--violet-rgb), 0.16);
      border-radius: 4px;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      line-height: 1.45;
      color: var(--ink);
      cursor: pointer;
    }
    .post-remind input { margin: 2px 0 0; width: 16px; height: 16px; flex: 0 0 auto; accent-color: var(--violet-deep); cursor: pointer; }
    .post-remind-note { color: rgba(28,29,34,0.55); }
    .post-error {
      padding: 10px 14px;
      background: rgba(195, 65, 50, 0.08);
      color: #a23023;
      border: 1px solid rgba(195, 65, 50, 0.25);
      border-radius: 4px;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      line-height: 1.5;
    }
    .post-error[hidden] { display: none; }
    .post-error.is-ok { background: rgba(46, 125, 80, 0.08); color: #2e7d50; border-color: rgba(46, 125, 80, 0.28); }
    .post-foot { display: flex; flex-wrap: wrap; align-items: center; gap: 10px; }
    .post-btn {
      appearance: none;
      border-radius: 4px;
      padding: 11px 18px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s, transform 0.2s, opacity 0.2s;
    }
    .post-btn:disabled { opacity: 0.6; cursor: progress; }
    .post-btn--primary {
      margin-left: auto;
      background: var(--violet-deep);
      color: var(--paper);
      border: 0;
      box-shadow: 0 10px 22px -10px rgba(var(--violet-rgb), 0.55);
    }
    .post-btn--primary:hover:not(:disabled) { transform: translateY(-1px); background: var(--ink); }
    .post-btn--ghost {
      background: transparent;
      border: 1px solid rgba(var(--violet-rgb), 0.4);
      color: var(--violet-deep);
    }
    .post-btn--ghost:hover:not(:disabled) { background: rgba(var(--violet-rgb), 0.08); border-color: var(--violet-deep); }
    .post-btn--danger {
      background: transparent;
      border: 1px solid rgba(195, 65, 50, 0.3);
      color: #a23023;
    }
    .post-btn--danger:hover:not(:disabled) { background: rgba(195, 65, 50, 0.08); border-color: #a23023; }
    @media (max-width: 520px) {
      .post-btn--primary { margin-left: 0; }
      .post-foot .post-btn { flex: 1 1 auto; text-align: center; }
    }
  </style>

  <script>
    import { supabase, signOutEverywhere} from '../../lib/supabase.js';
    import { loadPrompts, upcomingFrom, keyForDay, canvasForPrompt } from '../../data/content-calendar.js';

    // ====== Elements ======
    const $title       = document.getElementById('cal-title');
    const $grid        = document.getElementById('cal-grid');
    const $state       = document.getElementById('cal-state');
    const $prev        = document.getElementById('cal-prev');
    const $next        = document.getElementById('cal-next');
    const $today       = document.getElementById('cal-today');
    const $footerEmail = document.getElementById('footer-email');

    const $dayModal    = document.getElementById('day-modal');
    const $dayClose    = document.getElementById('day-close');
    const $dayEyebrow  = document.getElementById('day-eyebrow');
    const $dayH        = document.getElementById('day-h');
    const $dayBody     = document.getElementById('day-body');
    const $dayNew      = document.getElementById('day-new');

    // Planned-post detail modal
    const $postModal   = document.getElementById('post-modal');
    const $postClose   = document.getElementById('post-close');
    const $postImg     = document.getElementById('post-img');
    const $postTitle   = document.getElementById('post-title');
    const $postDate    = document.getElementById('post-date');
    const $postTime    = document.getElementById('post-time');
    const $postPlat    = document.getElementById('post-plat');
    const $postCaption = document.getElementById('post-caption');
    const $postRemind  = document.getElementById('post-remind');
    const $postError   = document.getElementById('post-error');
    const $postSave    = document.getElementById('post-save');
    const $postEmail   = document.getElementById('post-email');
    const $postDelete  = document.getElementById('post-delete');

    // Worker base for the "email it to me now" endpoint (same env the editor uses).
    const API_BASE = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');
    let openPostId = null;  // id of the post currently in the detail modal
    let openDayDate = null; // YMD of the day modal currently open (to refresh it)

    // ====== State ======
    // viewMonth always points at the 1st of the month being displayed,
    // local time. Items + holidays are loaded in a window around it so
    // that prev/next swaps feel instant.
    // ?focus=YYYY-MM-DD (or YYYY-MM) opens the planner on that month, which is
    // how the dashboard's day cards and its content-calendar card arrive here.
    // Anything unparseable falls back to this month rather than a blank grid.
    function focusedMonth() {
      const q = new URLSearchParams(location.search).get('focus');
      const m = q && /^(\d{4})-(0[1-9]|1[0-2])(?:-\d{2})?$/.exec(q);
      if (!m) return startOfMonth(new Date());
      const d = new Date(Number(m[1]), Number(m[2]) - 1, 1);
      return isNaN(d.getTime()) ? startOfMonth(new Date()) : d;
    }
    let viewMonth = focusedMonth();
    let items     = [];           // user's scheduled posts (in window)
    let holidays  = [];           // uk_holidays rows (in window)
    let prompts   = [];           // content prompts falling in the window

    // ====== Date helpers ======
    function startOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
    function addMonths(d, n) { return new Date(d.getFullYear(), d.getMonth() + n, 1); }
    function ymd(d) {
      // YYYY-MM-DD in local time — matches how dates are stored in
      // calendar_items.scheduled_date (Postgres `date`, no tz).
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const da = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${da}`;
    }
    function sameDay(a, b) {
      return a.getFullYear() === b.getFullYear()
        && a.getMonth() === b.getMonth()
        && a.getDate() === b.getDate();
    }
    function fmtMonthYear(d) {
      return d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
    }
    function fmtFullDate(d) {
      return d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    }
    function fmtTime(t) {
      // t is a "HH:MM:SS" string from Postgres; render as "HH:MM".
      if (!t) return '09:00';
      return String(t).slice(0, 5);
    }

    // ====== HTML helpers ======
    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    // ====== Calendar grid ======
    // Build a 6-week grid (42 cells) starting on the Monday on or before
    // the 1st of viewMonth. Locking to 6 rows keeps the layout from
    // jumping by a row between months.
    function buildGridDays() {
      const first = startOfMonth(viewMonth);
      const dow = (first.getDay() + 6) % 7; // 0 = Mon ... 6 = Sun
      const start = new Date(first);
      start.setDate(first.getDate() - dow);
      const days = [];
      for (let i = 0; i < 42; i++) {
        const d = new Date(start);
        d.setDate(start.getDate() + i);
        days.push(d);
      }
      return days;
    }

    function renderCalendar() {
      // The strip's chapter label lives inside this heading, so replace only
      // the month text rather than the whole node.
      const monthEl = $title.querySelector('.cal-month') || $title;
      monthEl.textContent = fmtMonthYear(viewMonth);
      const days = buildGridDays();
      const today = new Date();
      const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());

      // Pre-bucket items + holidays by YMD for O(1) day lookups.
      const itemsByDate    = bucketBy(items,    (i) => i.scheduled_date);
      const holidaysByDate = bucketBy(holidays, (h) => h.date);
      const promptsByDate  = bucketBy(prompts,  (p) => p.date);

      $grid.innerHTML = days.map((d) => {
        const key       = ymd(d);
        const isOther   = d.getMonth() !== viewMonth.getMonth();
        const isWeekend = d.getDay() === 0 || d.getDay() === 6;
        const isToday   = sameDay(d, todayStart);
        const isPast    = d < todayStart && !isToday;
        const dayItems  = itemsByDate.get(key) || [];
        const dayPrompts = promptsByDate.get(key) || [];
        // A prompt says something to do; a holiday only says what day it is.
        // Where we have the first, the second is noise.
        const dayHols   = dayPrompts.length ? [] : (holidaysByDate.get(key) || []);
        const isEmpty   = dayItems.length === 0 && dayHols.length === 0 && dayPrompts.length === 0;

        const cls = [
          'cal-day',
          isOther   ? 'is-other-month' : '',
          isWeekend ? 'is-weekend'     : '',
          isToday   ? 'is-today'       : '',
          isPast    ? 'is-past'        : '',
          isEmpty   ? 'is-empty'       : '',
        ].filter(Boolean).join(' ');

        const dowLabel = d.toLocaleDateString('en-GB', { weekday: 'short' });

        // What we show in the cell, in order of priority:
        //   1. Holiday chips (max 2 visible)
        //   2. Post chips (max 2 visible)
        //   3. "+N more" if anything is hidden
        const visibleHols  = dayHols.slice(0, 2);
        const remainingPosts = Math.max(0, dayItems.length);
        const visiblePosts = dayItems.slice(0, Math.max(0, 2 - visibleHols.length + (visibleHols.length === 2 ? 0 : 1)));
        const hiddenCount  = (dayHols.length - visibleHols.length) + (dayItems.length - visiblePosts.length);

        const promptsHtml = dayPrompts.slice(0, 1).map((p) =>
          `<span class="cal-chip cal-chip--prompt" title="${escapeHtml(p.name + ' — ' + p.angle)}">${escapeHtml(p.name)}</span>`
        ).join('');
        const holsHtml = visibleHols.map((h) =>
          `<span class="cal-chip ${h.kind === 'bank' ? 'cal-chip--bank' : 'cal-chip--aware'}" title="${escapeHtml(h.name)}">${escapeHtml(h.name)}</span>`
        ).join('');
        const postsHtml = visiblePosts.map((p) => {
          const statusClass = p.status === 'done' ? 'is-done'
            : p.status === 'reminder_sent' ? 'is-sent'
            : p.status === 'cancelled' ? 'is-cancelled' : '';
          return `<span class="cal-chip cal-chip--post ${statusClass}" title="${escapeHtml(p.title)}">${escapeHtml(p.title)}</span>`;
        }).join('');
        const moreHtml = hiddenCount > 0 ? `<span class="cal-day-more">+${hiddenCount} more</span>` : '';

        return `
          <button type="button" class="${cls}" data-date="${key}" role="gridcell">
            <div class="cal-day-head">
              <span class="cal-day-num">${d.getDate()}</span>
              <span class="cal-day-dow">${escapeHtml(dowLabel)}</span>
            </div>
            ${promptsHtml}
            ${holsHtml}
            ${postsHtml}
            ${moreHtml}
          </button>
        `;
      }).join('');
    }

    function bucketBy(rows, keyFn) {
      const m = new Map();
      for (const r of rows) {
        const k = keyFn(r);
        if (!m.has(k)) m.set(k, []);
        m.get(k).push(r);
      }
      return m;
    }

    // ====== Day drawer ======
    let dayCloseTimer = null;
    function openDay(dateStr) {
      openDayDate = dateStr;
      const d = new Date(dateStr + 'T00:00:00');
      const dayItems = items.filter((i) => i.scheduled_date === dateStr)
        .sort((a, b) => (a.scheduled_time || '').localeCompare(b.scheduled_time || ''));
      const dayPrompts = prompts.filter((p) => p.date === dateStr);
      const dayHols  = dayPrompts.length ? [] : holidays.filter((h) => h.date === dateStr);

      $dayEyebrow.textContent = dayPrompts.length
        ? dayPrompts.map((p) => p.name).join(' · ')
        : (dayHols.length ? dayHols.map((h) => h.name).join(' · ') : 'No date markers');
      $dayH.textContent = fmtFullDate(d);
      $dayNew.href = `/account/editor?schedule=${encodeURIComponent(dateStr)}`;

      // The prompt, with the guidance and a way straight onto the canvas —
      // which is the whole point of it being here rather than a label.
      const promptHtml = dayPrompts.length ? `
        <div>
          <h3 class="day-section-h">Suggested for this day</h3>
          ${dayPrompts.map((p) => `
            <div class="day-prompt">
              <span class="day-prompt-name">${escapeHtml(p.name)}</span>
              <strong class="day-prompt-angle">${escapeHtml(p.angle)}</strong>
              ${(p.brief || p.hint) ? `<span class="day-prompt-brief">${escapeHtml(p.brief || p.hint)}</span>` : ''}
              <a class="day-prompt-cta" href="/account/editor?blank=${canvasForPrompt(p)}&prompt=${encodeURIComponent(keyForDay(p))}">
                ${p.video ? 'Design the cover' : 'Design this post'} <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          `).join('')}
        </div>
      ` : '';

      const holsHtml = dayHols.length ? `
        <div>
          <h3 class="day-section-h">On this day</h3>
          ${dayHols.map((h) => `
            <div class="day-holiday ${h.kind === 'bank' ? 'is-bank' : 'is-aware'}">${escapeHtml(h.name)}</div>
          `).join('')}
        </div>
      ` : '';

      const itemsHtml = dayItems.length ? `
        <div>
          <h3 class="day-section-h">Planned posts</h3>
          ${dayItems.map((p) => {
            const thumb = p.thumbnail_url || p.asset_url || '';
            const thumbStyle = thumb ? `style="background-image:url('${escapeHtml(thumb)}')"` : '';
            const statusLabel = ({
              scheduled:     'Planned',
              reminder_sent: 'Reminder sent',
              done:          'Posted',
              cancelled:     'Cancelled',
            })[p.status] || 'Planned';
            const statusClass = ({
              scheduled:     'is-scheduled',
              reminder_sent: 'is-sent',
              done:          'is-done',
              cancelled:     'is-cancelled',
            })[p.status] || 'is-scheduled';
            return `
              <div class="day-item" data-id="${escapeHtml(String(p.id))}" role="button" tabindex="0" title="Open this post">
                <div class="day-item-thumb" ${thumbStyle}></div>
                <div class="day-item-body">
                  <span class="day-item-time">${escapeHtml(fmtTime(p.scheduled_time))} · ${escapeHtml(p.platform_hint || 'instagram')}</span>
                  <h4 class="day-item-title">${escapeHtml(p.title)}</h4>
                  ${p.caption ? `<p class="day-item-caption">${escapeHtml(p.caption)}</p>` : ''}
                  <span class="day-item-status ${statusClass}">${escapeHtml(statusLabel)}</span>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      ` : '';

      const empty = (!dayHols.length && !dayItems.length && !dayPrompts.length) ? `
        <div class="day-empty">
          Nothing planned for this day yet. Use the button below to design and plan a post — your calendar will fill up as you plan ahead.
        </div>
      ` : '';

      $dayBody.innerHTML = promptHtml + holsHtml + itemsHtml + empty;

      $dayModal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        requestAnimationFrame(() => $dayModal.classList.add('is-open'));
      });
    }

    function closeDay() {
      if (!$dayModal.classList.contains('is-open')) {
        $dayModal.hidden = true;
        document.body.style.overflow = '';
        return;
      }
      $dayModal.classList.remove('is-open');
      clearTimeout(dayCloseTimer);
      dayCloseTimer = setTimeout(() => {
        $dayModal.hidden = true;
        document.body.style.overflow = '';
      }, 540);
    }

    // ====== Planned-post detail ======
    function platLabel(p) {
      const m = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', tiktok: 'TikTok' };
      return m[p] || (p ? p[0].toUpperCase() + p.slice(1) : 'Instagram');
    }
    function clearPostError() { $postError.hidden = true; $postError.textContent = ''; $postError.classList.remove('is-ok'); }
    function showPostError(msg, ok) {
      $postError.hidden = false;
      $postError.textContent = msg;
      $postError.classList.toggle('is-ok', !!ok);
    }

    function openPost(id) {
      const p = items.find((i) => String(i.id) === String(id));
      if (!p) return;
      openPostId = p.id;
      clearPostError();
      const img = p.asset_url || p.thumbnail_url || '';
      const $preview = $postImg.closest('.post-preview');
      if (img) { $postImg.src = img; $postImg.style.display = ''; if ($preview) $preview.style.display = ''; }
      else { $postImg.removeAttribute('src'); if ($preview) $preview.style.display = 'none'; }
      $postTitle.value = p.title || '';
      $postDate.value = p.scheduled_date || '';
      $postTime.value = (p.scheduled_time || '09:00').slice(0, 5);
      $postPlat.textContent = platLabel(p.platform_hint);
      $postCaption.value = p.caption || '';
      $postRemind.checked = p.reminder !== false; // default on (column may be absent)
      $postSave.disabled = false;  $postSave.textContent = 'Save changes';
      $postEmail.disabled = false; $postEmail.textContent = 'Email it to me now';
      $postDelete.disabled = false; $postDelete.textContent = 'Remove';
      $postModal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => requestAnimationFrame(() => $postModal.classList.add('is-open')));
      setTimeout(() => $postTitle.focus(), 60);
    }

    let postCloseTimer;
    function closePost() {
      openPostId = null;
      if (!$postModal.classList.contains('is-open')) { $postModal.hidden = true; return; }
      $postModal.classList.remove('is-open');
      clearTimeout(postCloseTimer);
      postCloseTimer = setTimeout(() => {
        $postModal.hidden = true;
        // The day modal may still be open beneath — only release scroll if not.
        if ($dayModal.hidden) document.body.style.overflow = '';
      }, 540);
    }

    // Refresh the day modal beneath (it's static once rendered).
    function refreshDayUnder() {
      if (openDayDate && !$dayModal.hidden) openDay(openDayDate);
    }

    async function savePost() {
      if (!openPostId) return;
      clearPostError();
      const title   = ($postTitle.value || '').trim();
      const dateStr = $postDate.value;
      const timeStr = $postTime.value || '09:00';
      const caption = ($postCaption.value || '').trim();
      const wantsReminder = !!$postRemind.checked;
      if (!title)   return showPostError('Give the post a short title.');
      if (!dateStr) return showPostError('Pick a date for the post.');

      $postSave.disabled = true; $postSave.textContent = 'Saving…';
      const patch = { title, scheduled_date: dateStr, scheduled_time: timeStr, caption: caption || null, reminder: wantsReminder };
      let { error } = await supabase.from('calendar_items').update(patch).eq('id', openPostId);
      if (error && /reminder/i.test(error.message || '') && /column/i.test(error.message || '')) {
        // reminder column not migrated yet — persist everything else.
        const { reminder, ...rest } = patch;
        ({ error } = await supabase.from('calendar_items').update(rest).eq('id', openPostId));
      }
      if (error) {
        $postSave.disabled = false; $postSave.textContent = 'Save changes';
        return showPostError(error.message || "Couldn't save your changes.");
      }
      const p = items.find((i) => String(i.id) === String(openPostId));
      if (p) Object.assign(p, patch);
      renderCalendar();
      $postSave.textContent = 'Saved ✓';
      showPostError('Changes saved.', true);
      setTimeout(() => { closePost(); refreshDayUnder(); }, 700);
    }

    async function emailPostNow() {
      if (!openPostId) return;
      clearPostError();
      const p = items.find((i) => String(i.id) === String(openPostId));
      if (!p) return;
      const asset = p.asset_url || p.thumbnail_url || '';
      if (!asset)    return showPostError('This post has no image to send.');
      if (!API_BASE) return showPostError("Email isn't available here (PUBLIC_R2_WORKER_URL not set).");
      const { data: { session } } = await supabase.auth.getSession();
      if (!session)  return showPostError("You're signed out — sign in again.");

      $postEmail.disabled = true; $postEmail.textContent = 'Sending…';
      try {
        const res = await fetch(`${API_BASE}/calendar/send-now`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session.access_token}` },
          body: JSON.stringify({
            asset_url: asset,
            caption: ($postCaption.value || '').trim(),
            title: ($postTitle.value || '').trim(),
            platform: p.platform_hint || 'instagram',
          }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || !out.ok) throw new Error(out.error || "Couldn't send the email.");
        $postEmail.textContent = 'Sent ✓';
        showPostError(`Sent to ${out.to || 'your inbox'} — check your phone.`, true);
        setTimeout(() => { $postEmail.disabled = false; $postEmail.textContent = 'Email it to me now'; clearPostError(); }, 4000);
      } catch (err) {
        showPostError(err.message || "Couldn't email that post.");
        $postEmail.disabled = false; $postEmail.textContent = 'Email it to me now';
      }
    }

    async function removePost() {
      if (!openPostId) return;
      if (!confirm("Remove this planned post from your calendar? This can't be undone.")) return;
      clearPostError();
      $postDelete.disabled = true; $postDelete.textContent = 'Removing…';
      const { error } = await supabase.from('calendar_items').delete().eq('id', openPostId);
      if (error) {
        $postDelete.disabled = false; $postDelete.textContent = 'Remove';
        return showPostError(error.message || "Couldn't remove that post.");
      }
      items = items.filter((i) => String(i.id) !== String(openPostId));
      renderCalendar();
      closePost();
      refreshDayUnder();
    }

    // ====== Data loaders ======
    // Pull a 3-month window so prev/next feels instant. We re-fetch
    // whenever the user navigates outside the loaded window.
    let loadedWindow = null; // { fromYmd, toYmd }
    // getSession() is local-only - a cleared/revoked session can still look
    // valid to it. Confirmed once with the server (getUser()) per page load -
    // not on every loadWindow() call, since that also runs on plain month
    // navigation and shouldn't add a network round-trip each time.
    let sessionConfirmed = false;
    async function loadWindow() {
      const winStart = addMonths(viewMonth, -1);
      const winEnd   = addMonths(viewMonth,  2);  // exclusive
      const fromYmd  = ymd(winStart);
      const toYmd    = ymd(new Date(winEnd.getFullYear(), winEnd.getMonth(), 0)); // last day of viewMonth+1

      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        if (!import.meta.env.DEV) location.replace('/login?next=' + encodeURIComponent('/account/schedule'));
        return;
      }
      if (!sessionConfirmed && !import.meta.env.DEV) {
        const { data: { user }, error } = await supabase.auth.getUser();
        if (!user || error) { location.replace('/login?next=' + encodeURIComponent('/account/schedule')); return; }
      }
      sessionConfirmed = true;
      $footerEmail.textContent = session.user.email ?? '';

      const [itemsRes, holsRes] = await Promise.all([
        supabase.from('calendar_items')
          .select('*')
          .gte('scheduled_date', fromYmd)
          .lte('scheduled_date', toYmd)
          .order('scheduled_date', { ascending: true })
          .order('scheduled_time', { ascending: true }),
        supabase.from('uk_holidays')
          .select('date, name, kind, country')
          .gte('date', fromYmd)
          .lte('date', toYmd)
          .order('date', { ascending: true }),
      ]);

      // If the calendar table hasn't been migrated yet (or RLS denies),
      // surface a friendly hint rather than a silent empty grid.
      if (itemsRes.error && /relation .* does not exist/i.test(itemsRes.error.message || '')) {
        $state.hidden = false;
        $state.textContent = "Calendar table not found — run supabase/calendar.sql in the Supabase SQL editor to enable scheduling.";
        items = [];
      } else {
        items = itemsRes.data || [];
        $state.hidden = true;
      }

      // Holidays — fall back silently to a small stub so the demo still
      // looks alive if the table isn't seeded. The seed lives in the
      // same SQL file, so once that runs this fallback is never hit.
      if (holsRes.error || !(holsRes.data || []).length) {
        holidays = stubHolidaysForWindow(fromYmd, toYmd);
      } else {
        holidays = holsRes.data;
      }

      // Content prompts for the same window. They come from the same table the
      // dashboard and the Studio read, so a day edited in the admin centre
      // shows here too.
      try {
        const P = await loadPrompts(supabase);
        const from = new Date(fromYmd + 'T00:00:00');
        const to = new Date(toYmd + 'T00:00:00');
        // upcomingFrom rolls into next year, so ask for plenty and cut to the
        // window rather than assuming a count.
        prompts = upcomingFrom(P.days, from, 200)
          .filter((d) => d.when <= to)
          .map((d) => ({ ...d, date: ymd(d.when) }));
      } catch (_) { prompts = []; }

      loadedWindow = { fromYmd, toYmd };
    }

    // Tiny holiday stub so the page still demos before the seed has been
    // applied. Returns whichever of these fall inside the loaded window.
    function stubHolidaysForWindow(fromYmd, toYmd) {
      const all = [
        { date: '2026-05-04', name: 'Early May bank holiday', kind: 'bank',      country: 'england-and-wales' },
        { date: '2026-05-25', name: 'Spring bank holiday',    kind: 'bank',      country: 'england-and-wales' },
        { date: '2026-06-21', name: "Father's Day (UK)",     kind: 'awareness', country: 'uk' },
        { date: '2026-08-31', name: 'Summer bank holiday',    kind: 'bank',      country: 'england-and-wales' },
        { date: '2026-10-31', name: 'Halloween',              kind: 'awareness', country: 'uk' },
        { date: '2026-11-05', name: 'Bonfire Night',          kind: 'awareness', country: 'uk' },
        { date: '2026-11-27', name: 'Black Friday',           kind: 'awareness', country: 'uk' },
        { date: '2026-12-25', name: 'Christmas Day',          kind: 'bank',      country: 'england-and-wales' },
      ];
      return all.filter((h) => h.date >= fromYmd && h.date <= toYmd);
    }

    // ====== Event wiring ======
    $prev?.addEventListener('click', async () => {
      viewMonth = addMonths(viewMonth, -1);
      await ensureWindow();
      renderCalendar();
    });
    $next?.addEventListener('click', async () => {
      viewMonth = addMonths(viewMonth, 1);
      await ensureWindow();
      renderCalendar();
    });
    $today?.addEventListener('click', async () => {
      viewMonth = startOfMonth(new Date());
      await ensureWindow();
      renderCalendar();
    });
    $grid?.addEventListener('click', (e) => {
      const cell = e.target.closest('.cal-day');
      if (!cell) return;
      openDay(cell.getAttribute('data-date'));
    });
    $dayClose?.addEventListener('click', closeDay);
    $dayModal?.addEventListener('click', (e) => { if (e.target === $dayModal) closeDay(); });

    // Click (or keyboard) a planned post in the day list to open its detail.
    $dayBody?.addEventListener('click', (e) => {
      const item = e.target.closest('.day-item');
      if (item && item.dataset.id) openPost(item.dataset.id);
    });
    $dayBody?.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const item = e.target.closest('.day-item');
      if (item && item.dataset.id) { e.preventDefault(); openPost(item.dataset.id); }
    });

    // Post detail modal wiring.
    $postClose?.addEventListener('click', closePost);
    $postModal?.addEventListener('click', (e) => { if (e.target === $postModal) closePost(); });
    $postSave?.addEventListener('click', savePost);
    $postEmail?.addEventListener('click', emailPostNow);
    $postDelete?.addEventListener('click', removePost);

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!$postModal.hidden) { closePost(); return; }   // post modal is on top
      if (!$dayModal.hidden) closeDay();
    });

    async function ensureWindow() {
      // Reload only if the new viewMonth is outside the cached window
      // (with 1-month buffer on each side).
      if (!loadedWindow) { await loadWindow(); return; }
      const monthYmd = ymd(viewMonth);
      if (monthYmd < loadedWindow.fromYmd || monthYmd > loadedWindow.toYmd) {
        await loadWindow();
      }
    }

    // ====== Sign-out (shared with other workspace pages) ======
    async function signOut() {
      await signOutEverywhere();
    }
    document.getElementById('app-signout')?.addEventListener('click', signOut);
    document.getElementById('app-signout-foot')?.addEventListener('click', signOut);

    // AI caption → drop the result straight into the post's caption box.
    document.getElementById('post-ai-caption')?.addEventListener('click', () => {
      window.tmkeCaption?.open({
        output: 'use',
        onUse: (text) => {
          $postCaption.value = text;
          $postCaption.dispatchEvent(new Event('input', { bubbles: true }));
        },
      });
    });

    // ====== Bootstrap ======
    (async () => {
      await loadWindow();
      renderCalendar();
      requestAnimationFrame(() => document.body.classList.add('is-loaded'));
    })();
  </script>

  <NewDesignModal />
  <CaptionGenerator />
</BaseLayout>
