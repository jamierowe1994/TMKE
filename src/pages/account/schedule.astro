    /* ---- Planned-post detail modal ---- */
    .post-body { display: flex; flex-direction: column; gap: 18px; }
    .post-preview {
      margin: 0;
      flex: 0 0 auto;   /* never let the scrolling column shrink the thumbnail */
      border-radius: 6px;
      overflow: hidden;
      background: var(--platinum);
