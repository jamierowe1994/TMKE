    const $postSave    = document.getElementById('post-save');
    const $postEmail   = document.getElementById('post-email');
    const $postDelete  = document.getElementById('post-delete');

    // Worker base for the "email it to me now" endpoint (same env the editor uses).
    const API_BASE = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');
    let openPostId = null;  // id of the post currently in the detail modal
    let openDayDate = null; // YMD of the day modal currently open (to refresh it)

    // ====== State ======
    // viewMonth always points at the 1st of the month being displayed,
    // local time. Items + holidays are loaded in a window around it so
    // that prev/next swaps feel instant.
    // ?focus=YYYY-MM-DD (or YYYY-MM) opens the planner on that month, which is
    // how the dashboard's day cards and its content-calendar card arrive here.
    // Anything unparseable falls back to this month rather than a blank grid.
    function focusedMonth() {
      const q = new URLSearchParams(location.search).get('focus');
      const m = q && /^(\d{4})-(0[1-9]|1[0-2])(?:-\d{2})?$/.exec(q);
      if (!m) return startOfMonth(new Date());
      const d = new Date(Number(m[1]), Number(m[2]) - 1, 1);
      return isNaN(d.getTime()) ? startOfMonth(new Date()) : d;
    }
    let viewMonth = focusedMonth();
    let items     = [];           // user's scheduled posts (in window)
    let holidays  = [];           // uk_holidays rows (in window)
    let prompts   = [];           // content prompts falling in the window
    /* The view (Dani, 18 Oct): 'all' is the Marketing Planner, everything;
       'posts' is the Content Calendar, social posts with their ideas. Key
       dates show in both. Kept in this browser; the old Activities view, no
       longer offered, opens as the Marketing Planner. */
    let calView = 'all';
    try { const v = localStorage.getItem('tmke.calendar.view'); if (v === 'posts') calView = v; } catch (_) {}
    // ?view=posts opens on the Content Calendar (the content plan's links back).
    { const v = new URLSearchParams(location.search).get('view'); if (v === 'posts' || v === 'all') calView = v; }
    const isPostItem = (it) => !(it && it.activity && it.activity !== 'social_post');
    /* Each view its own (Dani, 18 Oct): the Marketing Planner is the
       marketing, the Content Calendar the posts. A day's posts show in the
       Marketing Planner as one quiet "3 posts", which opens the Content
       Calendar. Ideas and awareness days are the Content Calendar's; bank
       holidays show in both, as they shape the rest of the marketing too. */
    const inView = (it) => calView === 'posts' ? isPostItem(it) : !isPostItem(it);
    /* The page says which one you are in (Dani, 18 Oct: "so we can distinctly
       see there's a difference"): its heading, its line and the tab's name. */
    const VIEW_HEAD = {
      all:   { h: 'Your Marketing Planner.', sub: 'Plan all of your marketing, from campaigns and print to events and follow-ups, on the day it happens.', t: 'Marketing Planner' },
      posts: { h: 'Your Content Calendar.', sub: 'See what you\u2019re posting and when, with post ideas and key dates on the days.', t: 'Content Calendar' },
    };
    function paintViewHead() {
      const v = VIEW_HEAD[calView] || VIEW_HEAD.all;
      const h = document.querySelector('.cal-hero .ws-greeting'); if (h) h.textContent = v.h;
      const sub = document.querySelector('.cal-hero .ws-hero-sub'); if (sub) sub.textContent = v.sub;
      document.title = v.t + ' \u2014 TMKE workspace';
    }
    function setCalView(v) {
      calView = v;
      paintViewHead();
      try { localStorage.setItem('tmke.calendar.view', v); } catch (_) {}
      document.querySelector('.cal')?.setAttribute('data-cal-view', v);
      document.querySelectorAll('.cal-view-btn').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)));
      renderCalendar();
      if (openDayDate && !$dayModal.hidden) openDay(openDayDate);
    }
    document.querySelectorAll('.cal-view-btn').forEach((b) => b.addEventListener('click', () => setCalView(b.dataset.view)));
    document.querySelector('.cal')?.setAttribute('data-cal-view', calView);
    document.querySelectorAll('.cal-view-btn').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === calView)));
    paintViewHead();
    document.addEventListener('click', (e) => {
      if (!e.target.closest) return;
      if (e.target.closest('[data-view-all]')) setCalView('all');
      else if (e.target.closest('[data-view-posts]')) setCalView('posts');
    });

    // ====== Date helpers ======
    function startOfMonth(d) { return new Date(d.getFullYear(), d.getMonth(), 1); }
    function addMonths(d, n) { return new Date(d.getFullYear(), d.getMonth() + n, 1); }
    function ymd(d) {
      // YYYY-MM-DD in local time — matches how dates are stored in
      // calendar_items.scheduled_date (Postgres `date`, no tz).
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, '0');
      const da = String(d.getDate()).padStart(2, '0');
      return `${y}-${m}-${da}`;
    }
    function sameDay(a, b) {
      return a.getFullYear() === b.getFullYear()
        && a.getMonth() === b.getMonth()
        && a.getDate() === b.getDate();
    }
    function fmtMonthYear(d) {
      return d.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
    }
    function fmtFullDate(d) {
      return d.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
    }
    function fmtTime(t) {
      // t is a "HH:MM:SS" string from Postgres; render as "HH:MM".
      if (!t) return '09:00';
      return String(t).slice(0, 5);
    }

    // ====== HTML helpers ======
    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    // ====== Calendar grid ======
    // Build a 6-week grid (42 cells) starting on the Monday on or before
    // the 1st of viewMonth. Locking to 6 rows keeps the layout from
    // jumping by a row between months.
    function buildGridDays() {
      const first = startOfMonth(viewMonth);
      const dow = (first.getDay() + 6) % 7; // 0 = Mon ... 6 = Sun
      const start = new Date(first);
      start.setDate(first.getDate() - dow);
      const days = [];
      for (let i = 0; i < 42; i++) {
        const d = new Date(start);
        d.setDate(start.getDate() + i);
        days.push(d);
      }
      return days;
    }

    function renderCalendar() {
      // The strip's chapter label lives inside this heading, so replace only
      // the month text rather than the whole node.
      const monthEl = $title.querySelector('.cal-month') || $title;
      monthEl.textContent = fmtMonthYear(viewMonth);
      const days = buildGridDays();
      const today = new Date();
      const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());

      // Pre-bucket items + holidays by YMD for O(1) day lookups.
      // Each entry on every day it covers: a run (a campaign, paid ads) is on
      // each day from its start to its end, marked as a continuation after
      // the first so it draws as a thin bar.
      const itemsByDate = new Map();
      for (const it of items.filter(inView)) {
        const start = new Date(it.scheduled_date + 'T00:00:00');
        const end = new Date(lastDay(it) + 'T00:00:00');
        for (let d = new Date(start), n = 0; d <= end && n < 400; d.setDate(d.getDate() + 1), n++) {
          const k = ymd(d);
          if (!itemsByDate.has(k)) itemsByDate.set(k, []);
          itemsByDate.get(k).push(n === 0 ? it : { ...it, __cont: true });
        }
      }
      const holidaysByDate = bucketBy(calView === 'posts' ? holidays : holidays.filter((h) => h.kind === 'bank'), (h) => h.date);
      const promptsByDate  = bucketBy(calView === 'posts' ? prompts : [],  (p) => p.date);
      const postsByDate = calView === 'posts' ? new Map() : bucketBy(items.filter((it) => isPostItem(it) && it.status !== 'cancelled'), (it) => it.scheduled_date);

      $grid.innerHTML = days.map((d) => {
        const key       = ymd(d);
        const isOther   = d.getMonth() !== viewMonth.getMonth();
        const isWeekend = d.getDay() === 0 || d.getDay() === 6;
        const isToday   = sameDay(d, todayStart);
        const isPast    = d < todayStart && !isToday;
        const dayItems  = itemsByDate.get(key) || [];
        const dayPrompts = promptsByDate.get(key) || [];
        // A prompt says something to do; a holiday only says what day it is.
        // Where we have the first, the second is noise.
        const dayHols   = dayPrompts.length ? [] : (holidaysByDate.get(key) || []);
        const dayPosts  = (postsByDate.get(key) || []).length;
        const isEmpty   = dayItems.length === 0 && dayHols.length === 0 && dayPrompts.length === 0 && !dayPosts;

        const cls = [
          'cal-day',
          isOther   ? 'is-other-month' : '',
          isWeekend ? 'is-weekend'     : '',
          isToday   ? 'is-today'       : '',
          isPast    ? 'is-past'        : '',
          isEmpty   ? 'is-empty'       : '',
        ].filter(Boolean).join(' ');

        const dowLabel = d.toLocaleDateString('en-GB', { weekday: 'short' });

        // What we show in the cell, in order of priority:
        //   1. Holiday chips (max 2 visible)
        //   2. Post chips (max 2 visible)
        //   3. "+N more" if anything is hidden
        const visibleHols  = dayHols.slice(0, 2);
        const remainingPosts = Math.max(0, dayItems.length);
        const visiblePosts = dayItems.slice(0, Math.max(0, 2 - visibleHols.length + (visibleHols.length === 2 ? 0 : 1)));
        const hiddenCount  = (dayHols.length - visibleHols.length) + (dayItems.length - visiblePosts.length);

        const promptsHtml = dayPrompts.slice(0, 1).map((p) =>
          `<span class="cal-chip cal-chip--prompt" title="${escapeHtml(p.name + ' — ' + p.angle)}">${escapeHtml(p.name)}</span>`
        ).join('');
        const holsHtml = visibleHols.map((h) =>
          `<span class="cal-chip ${h.kind === 'bank' ? 'cal-chip--bank' : 'cal-chip--aware'}" title="${escapeHtml(h.name)}">${escapeHtml(h.name)}</span>`
        ).join('');
        const postsHtml = visiblePosts.map((p) => {
          if (isAct(p)) {
            const c = catOfItem(p);
            return `<span class="cal-chip cal-chip--act cal-chip--${c.key}${p.__cont ? ' is-cont' : ''}${p.booking ? ' cal-chip--booking' : ''}" title="${escapeHtml(activityOf(p.activity).label + ' — ' + (p.title || ''))}">${p.__cont ? '' : escapeHtml(p.title || activityOf(p.activity).label)}</span>`;
          }
          const statusClass = p.status === 'done' ? 'is-done'
            : p.status === 'reminder_sent' ? 'is-sent'
            : p.status === 'cancelled' ? 'is-cancelled'
            : !postIsMade(p) ? 'is-todo' : '';
          return `<span class="cal-chip cal-chip--post ${statusClass}" title="${escapeHtml(p.title)}">${escapeHtml(p.title)}</span>`;
        }).join('');
        const moreHtml = hiddenCount > 0 ? `<span class="cal-day-more">+${hiddenCount} more</span>` : '';
        const postsMark = dayPosts ? `<span class="cal-chip cal-chip--posts" data-to-posts title="Open the Content Calendar">${dayPosts} ${dayPosts === 1 ? 'post' : 'posts'}</span>` : '';

        return `
          <button type="button" class="${cls}" data-date="${key}" role="gridcell">
            <div class="cal-day-head">
              <span class="cal-day-num">${d.getDate()}</span>
              <span class="cal-day-dow">${escapeHtml(dowLabel)}</span>
            </div>
            ${promptsHtml}
            ${holsHtml}
            ${postsHtml}
            ${moreHtml}
            ${postsMark}
          </button>
        `;
      }).join('');
      paintBrief();
      paintOurs();
    }

    // ====== The month's posts (Content Calendar subscription) ======
    /* TMKE's post for each weekday, read from a published month. Who may read
       one is the database's call: for now only staff can, so for a member
       every month comes back empty and none of this shows. Each month is read
       once a visit. */
    const $cal = document.querySelector('.cal');
    const $ours = document.getElementById('cc-ours');
    const $ccGrid = document.getElementById('cc-grid');
    const $ccTab = document.getElementById('cc-tab');
    const ccMonths = new Map();          // "2026-11-01" -> month | null
    const ccLoading = new Map();
    // Which of the two shows: ours unless they've turned to their own.
    let ccLayer = 'ours';
    try { if (sessionStorage.getItem('tmke.cc.layer') === 'mine') ccLayer = 'mine'; } catch (_) {}
    let ccEdition = null;
    function ccFor(d) {
      const k = ccMonthKey(d);
      if (ccMonths.has(k)) return ccMonths.get(k);
      if (!ccLoading.has(k)) {
        ccLoading.set(k, loadPublishedMonth(supabase, k, ccEdition).then((m) => {
          ccMonths.set(k, m); ccLoading.delete(k);
          if (ccMonthKey(viewMonth) === k) paintOurs();
        }));
      }
      return undefined;                  // not read yet
    }
    function paintOurs() {
      if (!$ours || !$cal) return;
      const m = calView === 'posts' ? ccFor(viewMonth) : null;
      const has = !!(m && m.posts);
      $ccTab.hidden = !has;
      if (!has) { $ours.hidden = true; $cal.classList.remove('is-ours'); return; }
      const name = monthPostsName(m.month.month);
      document.getElementById('cc-ours-name').textContent = name + '.';
      // Staff testing: a month published for more than one edition.
      const ed = document.getElementById('cc-ours-ed');
      const sel = document.getElementById('cc-ours-ed-sel');
      ed.hidden = m.editions.length < 2;
      if (!ed.hidden) sel.innerHTML = m.editions.map((e) => `<option value="${e}"${e === m.month.edition ? ' selected' : ''}>${escapeHtml(EDITION_LABEL[e] || e)}</option>`).join('');
      const showOurs = ccLayer === 'ours';
      $ours.hidden = !showOurs;
      $cal.classList.toggle('is-ours', showOurs);
      $ccTab.textContent = showOurs ? 'Your calendar' : name;
      $ccTab.setAttribute('aria-label', showOurs ? 'Show your calendar' : 'Show ' + name);
      if (!showOurs) return;
      const byDate = bucketBy(m.posts.filter((p) => p.post_date), (p) => p.post_date);
      const today = new Date(); const todayKey = ymd(today);
      // Only the weeks the month is in.
      const days = buildGridDays();
      let last = days.length;
      while (last > 7 && days.slice(last - 7, last).every((d) => d.getMonth() !== viewMonth.getMonth())) last -= 7;
      $ccGrid.innerHTML = days.slice(0, last).map((d) => {
        const key = ymd(d);
        const other = d.getMonth() !== viewMonth.getMonth();
        const post = other ? null : (byDate.get(key) || [])[0];
        const img = post && post.template && post.template.thumb_url;
        const cls = ['cc-day', other ? 'is-other-month' : '', key === todayKey ? 'is-today' : ''].filter(Boolean).join(' ');
        const pic = post ? `<button type="button" class="cc-post" data-cc-post="${escapeHtml(post.id)}" aria-label="${escapeHtml(post.title || 'Post')}">${img ? `<img src="${escapeHtml(img)}" alt="" loading="lazy">` : ''}${post.date_tied ? '<span class="cc-badge">On this day</span>' : ''}<span class="cc-post-card">${post.pillar ? `<span class="cc-post-k">${escapeHtml(post.pillar)}</span>` : ''}<span class="cc-post-h">${escapeHtml(post.title || (post.template && post.template.name) || 'Post')}</span><span class="cc-post-go">See it full size</span></span></button>` : '<span class="cc-slot" aria-hidden="true"></span>';
        return `<div class="${cls}"><span class="cc-num">${d.getDate()}</span>${pic}</div>`;
      }).join('');
    }
    $ccTab?.addEventListener('click', () => {
      ccLayer = ccLayer === 'ours' ? 'mine' : 'ours';
      try { sessionStorage.setItem('tmke.cc.layer', ccLayer); } catch (_) {}
      $cal.classList.toggle('is-mine-in', ccLayer === 'mine');
      paintOurs();
      $cal.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    document.getElementById('cc-ours-ed-sel')?.addEventListener('change', (e) => {
      ccEdition = e.target.value; setPreferredEdition(ccEdition);
      ccMonths.clear(); paintOurs();
    });

    // One post, full size.
    const $ccp = document.getElementById('ccp');
    function openCcPost(id) {
      const m = ccMonths.get(ccMonthKey(viewMonth));
      const p = m && m.posts.find((x) => x.id === id);
      if (!p) return;
      const set = (elId, text) => { const el = document.getElementById(elId); el.textContent = text || ''; return el; };
      const img = document.getElementById('ccp-img');
      img.src = (p.template && p.template.thumb_url) || '';
      set('ccp-k', monthPostsName(m.month.month));
      set('ccp-h', p.title || (p.template && p.template.name) || 'Post');
      set('ccp-d', fmtPostDate(p.post_date));
      set('ccp-p', p.pillar).hidden = !p.pillar;
      set('ccp-type', p.post_type && p.post_type !== 'single' ? POST_TYPE_LABEL[p.post_type] : '').hidden = !(p.post_type && p.post_type !== 'single');
      set('ccp-t', p.date_tied ? (p.occasion ? 'On this day: ' + p.occasion : 'On this day') : '').hidden = !p.date_tied;
      set('ccp-howto', p.how_to_edit); document.getElementById('ccp-howto-wrap').hidden = !p.how_to_edit;
      const cap = (p.captions || []).find((c) => c && c.trim());
      set('ccp-cap', cap); document.getElementById('ccp-cap-wrap').hidden = !cap;
      set('ccp-reel', p.post_type === 'reel' ? p.reel_prompt : ''); document.getElementById('ccp-reel-wrap').hidden = !(p.post_type === 'reel' && p.reel_prompt);
      const use = document.getElementById('ccp-use');
      use.href = `/account/editor?ccpost=${encodeURIComponent(p.id)}`;
      use.hidden = !p.template_id;
      $ccp.hidden = false;
      document.body.style.overflow = 'hidden';
      document.getElementById('ccp-x').focus({ preventScroll: true });
    }
    function closeCcPost() { if ($ccp.hidden) return; $ccp.hidden = true; document.body.style.overflow = ''; }
    $ccGrid?.addEventListener('click', (e) => {
      const b = e.target.closest && e.target.closest('[data-cc-post]');
      if (b) openCcPost(b.getAttribute('data-cc-post'));
    });
    document.getElementById('ccp-x')?.addEventListener('click', closeCcPost);
    $ccp?.addEventListener('click', (e) => { if (e.target === $ccp) closeCcPost(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeCcPost(); });

    function bucketBy(rows, keyFn) {
      const m = new Map();
      for (const r of rows) {
        const k = keyFn(r);
        if (!m.has(k)) m.set(k, []);
        m.get(k).push(r);
      }
      return m;
    }

    // ====== Day drawer ======
    let dayCloseTimer = null;
    function openDay(dateStr) {
      openDayDate = dateStr;
      // A day that's gone shows what was on it, with no way to add to it.
      { const t = new Date(); const todayKey = `${t.getFullYear()}-${String(t.getMonth() + 1).padStart(2, '0')}-${String(t.getDate()).padStart(2, '0')}`;
        const foot = document.querySelector('.day-foot'); if (foot) foot.hidden = dateStr < todayKey;
        // Each view adds its own: activities to the Marketing Planner, posts
        // to the Content Calendar.
        const addAct = document.getElementById('day-plan'); if (addAct) addAct.hidden = calView === 'posts';
        ['day-pick', 'day-new'].forEach((id) => { const b = document.getElementById(id); if (b) b.hidden = calView !== 'posts'; }); }
      const d = new Date(dateStr + 'T00:00:00');
      const allDayItems = items.filter((i) => occursOn(i, dateStr));
      const dayItems = allDayItems.filter(inView)
        .sort((a, b) => ((a.has_time === false ? '' : a.scheduled_time) || '').localeCompare((b.has_time === false ? '' : b.scheduled_time) || ''));
      const dayPrompts = calView === 'posts' ? prompts.filter((p) => p.date === dateStr) : [];
      const hiddenHere = allDayItems.filter((i) => !(i.status === 'cancelled' && isPostItem(i))).length - dayItems.length;
      const viewNote = !hiddenHere ? '' : calView === 'posts'
        ? `<p class="day-view-note">${hiddenHere} ${hiddenHere === 1 ? 'activity' : 'activities'} on this day in your Marketing Planner. <button type="button" data-view-all>Show ${hiddenHere === 1 ? 'it' : 'them'}</button></p>`
        : `<p class="day-view-note">${hiddenHere} ${hiddenHere === 1 ? 'post' : 'posts'} on this day in your Content Calendar. <button type="button" data-view-posts>Show ${hiddenHere === 1 ? 'it' : 'them'}</button></p>`;
      const dayHols  = dayPrompts.length ? [] : holidays.filter((h) => h.date === dateStr && (calView === 'posts' || h.kind === 'bank'));

      $dayEyebrow.textContent = dayPrompts.length
        ? dayPrompts.map((p) => p.name).join(' · ')
        : (dayHols.length ? dayHols.map((h) => h.name).join(' · ') : 'No date markers');
      $dayH.textContent = fmtFullDate(d);
      // "Create a post for this day" opens a blank canvas; `for` carries the
      // day so the editor's own Plan post is already on it. (?schedule= is the
      // older deep link, which opens the plan modal straight away - not what
      // you want when you haven't designed anything yet.)
      $dayNew.href = `/account/editor?blank=1&for=${encodeURIComponent(dateStr)}`;

      // The prompt, with the guidance and a way straight onto the canvas —
      // which is the whole point of it being here rather than a label.
      const promptHtml = dayPrompts.length ? `
        <div>
          <h3 class="day-section-h">Suggested for this day</h3>
          ${dayPrompts.map((p) => `
            <div class="day-prompt">
              <span class="day-prompt-name">${escapeHtml(p.name)}</span>
              <strong class="day-prompt-angle">${escapeHtml(p.angle)}</strong>
              ${(p.brief || p.hint) ? `<span class="day-prompt-brief">${escapeHtml(p.brief || p.hint)}</span>` : ''}
              <a class="day-prompt-cta" href="/account/editor?blank=${canvasForPrompt(p)}&prompt=${encodeURIComponent(keyForDay(p))}">
                ${p.video ? 'Design the cover' : 'Design this post'} <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          `).join('')}
        </div>
      ` : '';

      const holsHtml = dayHols.length ? `
        <div>
          <h3 class="day-section-h">On this day</h3>
          ${dayHols.map((h) => `
            <div class="day-holiday ${h.kind === 'bank' ? 'is-bank' : 'is-aware'}">${escapeHtml(h.name)}</div>
          `).join('')}
        </div>
      ` : '';

      const itemsHtml = dayItems.length ? `
        <div>
          <h3 class="day-section-h">Planned</h3>
          ${dayItems.map((p) => {
            if (isAct(p)) {
              const a = activityOf(p.activity), c = catOfItem(p);
              const list = Array.isArray(p.checklist) ? p.checklist : [];
              const done = list.filter((x) => x && x.done).length;
              const when = p.has_time === false ? 'All day' : fmtTime(p.scheduled_time);
              const run = p.end_date && p.end_date > p.scheduled_date
                ? ` · until ${new Date(p.end_date + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' })}` : '';
              const planKey = p.activity === 'content_planning' ? planMonthOf(p) : '';
              return `
              <div class="day-item day-item--act" style="--cat:${c.colour}" data-id="${escapeHtml(String(p.id))}"${planKey ? ` data-plan-month="${planKey}"` : ''} role="button" tabindex="0" title="${p.booking ? 'Open your bookings' : planKey ? 'Open your content plan' : 'Open this'}">
                <div class="day-item-body">
                  <span class="day-item-kind">${escapeHtml(a.label)}${p.details && p.details.shoot ? ' · ' + escapeHtml(p.details.shoot) : ''}${p.booking ? ' · TMKE booking' : ''}</span>
                  <h4 class="day-item-title">${escapeHtml(p.title || a.label)}</h4>
                  <span class="day-item-time">${escapeHtml(when + run)}</span>
                  ${(p.details && (p.details.address || p.details.location)) && (p.details.address || p.details.location) !== p.title ? `<span class="day-item-time">${escapeHtml(p.details.address || p.details.location)}</span>` : ''}
                  ${p.notes ? `<p class="day-item-caption">${escapeHtml(p.notes)}</p>` : ''}
                  ${list.length ? `<span class="act-progress">Checklist: ${done} of ${list.length} done</span>` : ''}
                  ${planKey ? `<span class="day-item-plan"><span>Open your ${escapeHtml(planMonthName(planKey))} content plan &rarr;</span><button type="button" class="day-item-edit" data-edit-entry>Edit session</button></span>` : ''}
                </div>
              </div>`;
            }
            const thumb = p.thumbnail_url || p.asset_url || '';
            const thumbStyle = thumb ? `style="background-image:url('${escapeHtml(thumb)}')"` : '';
            const statusLabel = (p.status === 'scheduled' && !postIsMade(p)) ? 'To design' : ({
              scheduled:     'Planned',
              reminder_sent: 'Reminder sent',
              done:          'Posted',
              cancelled:     'Cancelled',
            })[p.status] || 'Planned';
            const statusClass = ({
              scheduled:     'is-scheduled',
              reminder_sent: 'is-sent',
              done:          'is-done',
              cancelled:     'is-cancelled',
            })[p.status] || 'is-scheduled';
            return `
              <div class="day-item" data-id="${escapeHtml(String(p.id))}" role="button" tabindex="0" title="Open this post">
                <div class="day-item-thumb" ${thumbStyle}></div>
                <div class="day-item-body">
                  <span class="day-item-time">${escapeHtml(fmtTime(p.scheduled_time))} · ${escapeHtml(p.platform_hint || 'instagram')}${p.details && p.details.plan ? ' · from your content plan' : ''}${campaignTitle(p) ? ' · ' + escapeHtml(campaignTitle(p)) : ''}</span>
                  <h4 class="day-item-title">${escapeHtml(p.title)}</h4>
                  ${p.caption ? `<p class="day-item-caption">${escapeHtml(p.caption)}</p>` : ''}
                  <span class="day-item-status ${statusClass}">${escapeHtml(statusLabel)}</span>
                </div>
              </div>
            `;
          }).join('')}
        </div>
      ` : '';

      const empty = (!dayHols.length && !dayItems.length && !dayPrompts.length && !hiddenHere) ? `
        <div class="day-empty">
          ${calView === 'posts' ? 'No posts planned for this day yet.' : "Nothing planned for this day yet. Add a canvassing round, a launch, a session or anything else you're doing."}
        </div>
      ` : '';

      $dayBody.innerHTML = promptHtml + holsHtml + itemsHtml + viewNote + empty;

      $dayModal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        requestAnimationFrame(() => $dayModal.classList.add('is-open'));
      });
    }

    function closeDay() {
      if (!$dayModal.classList.contains('is-open')) {
        $dayModal.hidden = true;
        document.body.style.overflow = '';
        return;
      }
      $dayModal.classList.remove('is-open');
      clearTimeout(dayCloseTimer);
      dayCloseTimer = setTimeout(() => {
        $dayModal.hidden = true;
        document.body.style.overflow = '';
      }, 540);
    }

    // ====== Planned-post detail ======
    function platLabel(p) {
      const m = { instagram: 'Instagram', facebook: 'Facebook', linkedin: 'LinkedIn', tiktok: 'TikTok' };
      return m[p] || (p ? p[0].toUpperCase() + p.slice(1) : 'Instagram');
    }
    function clearPostError() { $postError.hidden = true; $postError.textContent = ''; $postError.classList.remove('is-ok'); }
    function showPostError(msg, ok) {
      $postError.hidden = false;
      $postError.textContent = msg;
      $postError.classList.toggle('is-ok', !!ok);
    }

    function openPost(id) {
      const p = items.find((i) => String(i.id) === String(id));
      if (!p) return;
      openPostId = p.id;
      clearPostError();
      const img = p.asset_url || p.thumbnail_url || '';
      const $preview = $postImg.closest('.post-preview');
      if (img) { $postImg.src = img; $postImg.style.display = ''; if ($preview) $preview.style.display = ''; }
      else { $postImg.removeAttribute('src'); if ($preview) $preview.style.display = 'none'; }
      // An uploaded post: its files and links, to open again.
      const pd = p.details || {};
      const pf = (Array.isArray(pd.files) ? pd.files : []).filter((x) => x && x.url);
      const pl = (Array.isArray(pd.links) ? pd.links : []).filter(Boolean);
      document.getElementById('post-files').innerHTML = [
        ...pf.map((x) => `<a class="act-file act-file-open" href="${escapeHtml(x.url)}" target="_blank" rel="noopener"><span class="act-file-kind">${escapeHtml(String(x.name || '').split('.').pop().slice(0, 5) || 'File')}</span><span class="act-file-name">${escapeHtml(x.name || 'File')}</span></a>`),
        ...pl.map((u) => `<a class="act-file act-file-open" href="${escapeHtml(u)}" target="_blank" rel="noopener"><span class="act-file-kind">Link</span><span class="act-file-name">${escapeHtml(u.replace(/^https?:\/\//, ''))}</span></a>`),
      ].join('');
      { const pl = document.getElementById('post-plan');
        pl.hidden = !(pd.plan && pd.plan.id);
        pl.href = planUrl(monthKey(p.scheduled_date || ymd(new Date())));
        pl.innerHTML = postIsMade(p) ? 'Open it in your content plan &rarr;' : 'Make it from your content plan &rarr;'; }
      $postTitle.value = p.title || '';
      $postDate.value = p.scheduled_date || '';
      $postTime.value = (p.scheduled_time || '09:00').slice(0, 5);
      $postPlat.textContent = platLabel(p.platform_hint);
      $postCaption.value = p.caption || '';
      $postRemind.checked = p.reminder !== false; // default on (column may be absent)
      $postSave.disabled = false;  $postSave.textContent = 'Save changes';
      $postEmail.disabled = false; $postEmail.textContent = 'Email it to me now';
      $postDelete.disabled = false; $postDelete.textContent = 'Remove';
      $postMycal.hidden = (demoOn() && !isTrainingDemo()) || calSynced;
      $postModal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => requestAnimationFrame(() => $postModal.classList.add('is-open')));
      setTimeout(() => $postTitle.focus(), 60);
    }

    let postCloseTimer;
    function closePost() {
      openPostId = null;
      if (!$postModal.classList.contains('is-open')) { $postModal.hidden = true; return; }
      $postModal.classList.remove('is-open');
      clearTimeout(postCloseTimer);
      postCloseTimer = setTimeout(() => {
        $postModal.hidden = true;
        // The day modal may still be open beneath — only release scroll if not.
        if ($dayModal.hidden) document.body.style.overflow = '';
      }, 540);
    }

    // ====== Plan a post: pick one you've already made ======
    // The library in a pop-out over the calendar. Picking a design doesn't open
    // it - the saved preview is the image the post carries - so planning is the
    // three or four fields below and nothing else.
    let pickDate = null, pickChosen = null, pickCache = null;
    /* Two more ways through this window (Dani, 16 Oct):
         upload    a post made elsewhere: files (PNG, JPEG, PDF) or links,
                   then the same plan step. Files go to calendar-assets, as a
                   design's image does, so the 8am reminder can attach them.
         sequence  a campaign's linked designs, planned one after another. */
    let pickMode = 'designs', pickUploads = [], pickLinks = [], pickQueue = null, pickIndex = 0;
    const $pickUpload  = document.getElementById('pick-step-upload');
    const $pickUpList  = document.getElementById('pick-up-list');
    const $pickUpErr   = document.getElementById('pick-up-error');
    const $pickContinue = document.getElementById('pick-continue');
    const $pickFileTile = document.getElementById('pick-file-tile');
    const showPickModal = () => { $pickModal.hidden = false; requestAnimationFrame(() => $pickModal.classList.add('is-open')); };

    function openPick(dateStr) {
      // The public demo's padlock; the training account plans, under Dani's login.
      if (demoOn() && !isTrainingDemo()) {
        lock("Planning is for members.", "In the demo you can open any day and see how the planner works. Members plan posts from their own designs.");
        return;
      }
      pickDate = dateStr;
      pickChosen = null; pickMode = 'designs'; pickQueue = null;
      const d = new Date(dateStr + 'T00:00:00');
      $pickEyebrow.textContent = fmtFullDate(d);
      $pickH.textContent = 'Choose a design';
      $pickDesigns.hidden = false;
      $pickUpload.hidden = true;
      $pickPlan.hidden = true;
      $pickFoot.hidden = true;
      $pickModal.hidden = false;
      /* .is-open is what makes a .day-backdrop take clicks and scrolling. The
         Choose a design window was unhidden without it, so every click, the
         scroll and the X went straight through to the day panel underneath
         (Dani, 15 Oct: "This whole 'Choose a design' window isn't
         functional"). */
      requestAnimationFrame(() => $pickModal.classList.add('is-open'));
      loadPickDesigns();
    }

    function openPickUpload(dateStr) {
      if (demoOn() && !isTrainingDemo()) {
        lock("Planning is for members.", "In the demo you can open any day and see how the planner works. Members plan and upload their own posts.");
        return;
      }
      pickDate = dateStr; pickChosen = null; pickMode = 'upload'; pickQueue = null;
      pickUploads = []; pickLinks = []; drawPickUploads();
      $pickUpErr.hidden = true;
      $pickEyebrow.textContent = fmtFullDate(new Date(dateStr + 'T00:00:00'));
      $pickH.textContent = 'Upload a post';
      $pickDesigns.hidden = true; $pickPlan.hidden = true; $pickUpload.hidden = false;
      $pickFoot.hidden = false; $pickContinue.hidden = false; $pickSave.hidden = true; syncSaveCal();
      showPickModal();
    }
    function pickUpError(msg) { $pickUpErr.hidden = !msg; $pickUpErr.textContent = msg || ''; }
    function drawPickUploads() {
      const rows = [
        ...pickUploads.map((x, i) => ({ i, kind: 'file', label: x.name, meta: x.uploading ? 'Uploading…' : fmtSize(x.size || 0), ext: String(x.name).split('.').pop() })),
        ...pickLinks.map((u, i) => ({ i, kind: 'link', label: u.replace(/^https?:\/\//, ''), meta: 'Link', ext: 'Link' })),
      ];
      $pickUpList.innerHTML = rows.map((r) => `<div class="act-file"><span class="act-file-open"><span class="act-file-kind">${escapeHtml(String(r.ext).slice(0, 5))}</span><span class="act-file-name">${escapeHtml(r.label)}</span><span class="act-file-meta">${escapeHtml(r.meta)}</span></span>
        <button type="button" class="act-check-del" data-up-del="${r.kind}:${r.i}" aria-label="Remove ${escapeHtml(r.label)}">&times;</button></div>`).join('');
    }
    async function uploadPickFiles(files) {
      const acct = await plannerStore();
      if (!acct || acct.blocked) return pickUpError(acct ? acct.reason : "You're signed out — sign in again.");
      pickUpError('');
      for (const file of files) {
        if (!/^(image\/(png|jpeg)|application\/pdf)$/.test(file.type) && !/\.(png|jpe?g|pdf)$/i.test(file.name)) { pickUpError(`${file.name} isn't a PNG, JPEG or PDF.`); continue; }
        if (file.size > FILE_MAX) { pickUpError(`${file.name} is over 25 MB. Add a link to it instead.`); continue; }
        const safe = file.name.replace(/[^\w.\-]+/g, '-').slice(-80);
        const path = `${acct.uid}/${acct.training ? 'training/' : ''}posts/${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}-${safe}`;
        const entry = { kind: 'file', name: file.name, size: file.size, mime: file.type || '', uploading: true };
        pickUploads.push(entry); drawPickUploads();
        const { error } = await acct.db.storage.from('calendar-assets').upload(path, file, { contentType: file.type || undefined, upsert: false });
        if (error) { pickUploads = pickUploads.filter((x) => x !== entry); drawPickUploads(); pickUpError(`${file.name} didn't upload: ${error.message || 'try again'}.`); continue; }
        entry.url = acct.db.storage.from('calendar-assets').getPublicUrl(path).data.publicUrl;
        entry.path = path; entry.uploading = false; drawPickUploads();
      }
    }
    document.getElementById('pick-files')?.addEventListener('change', (e) => { uploadPickFiles([...e.target.files]); e.target.value = ''; });
    const $pickDrop = document.getElementById('pick-drop');
    $pickDrop?.addEventListener('dragover', (e) => { e.preventDefault(); $pickDrop.classList.add('is-over'); });
    $pickDrop?.addEventListener('dragleave', () => $pickDrop.classList.remove('is-over'));
    $pickDrop?.addEventListener('drop', (e) => { e.preventDefault(); $pickDrop.classList.remove('is-over'); uploadPickFiles([...(e.dataTransfer && e.dataTransfer.files || [])]); });
    document.getElementById('pick-up-link')?.addEventListener('click', () => {
      const inp = document.getElementById('pick-up-url');
      let url = String(inp.value || '').trim(); if (!url) return;
      if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
      try { new URL(url); } catch (_) { return pickUpError("That doesn't look like a link."); }
      pickLinks.push(url); inp.value = ''; pickUpError(''); drawPickUploads();
    });
    document.getElementById('pick-up-url')?.addEventListener('keydown', (e) => { if (e.key === 'Enter') { e.preventDefault(); document.getElementById('pick-up-link').click(); } });
    $pickUpList?.addEventListener('click', (e) => {
      const b = e.target.closest('[data-up-del]'); if (!b) return;
      const [kind, i] = b.dataset.upDel.split(':');
      if (kind === 'link') pickLinks.splice(+i, 1);
      else { const [x] = pickUploads.splice(+i, 1); if (x && x.path) filesDb().then((db) => db.storage.from('calendar-assets').remove([x.path])).catch(() => {}); }
      drawPickUploads();
    });
    $pickContinue?.addEventListener('click', () => {
      if (pickUploads.some((x) => x.uploading)) return pickUpError('Wait for the files to finish uploading.');
      if (!pickUploads.length && !pickLinks.length) return pickUpError('Upload your post, or add a link to it.');
      const firstImg = pickUploads.find((x) => /^image\//.test(x.mime) || /\.(png|jpe?g)$/i.test(x.name));
      const first = pickUploads[0];
      choosePick({ upload: true, name: first ? first.name.replace(/\.[^.]+$/, '') : '', thumb_url: firstImg ? firstImg.url : '',
        fileLabel: first ? String(first.name.split('.').pop()).toUpperCase() : 'LINK' });
    });

    function closePick() {
      $pickModal.classList.remove('is-open');
      $pickModal.hidden = true;
      // An upload that was never planned leaves nothing behind.
      if (pickMode === 'upload' && pickUploads.length && !pickSaved) {
        const paths = pickUploads.map((x) => x.path).filter(Boolean);
        if (paths.length) filesDb().then((db) => db.storage.from('calendar-assets').remove(paths)).catch(() => {});
      }
      pickUploads = []; pickLinks = []; pickSaved = false;
      pickMode = 'designs'; pickQueue = null; pickCampaign = null;
      $pickContinue.hidden = true; $pickSave.hidden = false;
      pickChosen = null;
      document.getElementById('pick-save-cal').hidden = true;
      $pickSave.disabled = false;
      $pickSave.textContent = 'Plan post';
      clearPickError();
    }

    function clearPickError() { $pickError.hidden = true; $pickError.textContent = ''; }
    function showPickError(msg, ok) {
      $pickError.hidden = false;
      $pickError.textContent = msg;
      $pickError.classList.toggle('is-ok', !!ok);
    }

    async function loadPickDesigns() {
      if (pickCache) return renderPickGrid(pickCache);
      $pickNote.textContent = 'Loading your designs…';
      $pickGrid.innerHTML = '';
      // A member's own, or the training account's (src/lib/design-store.js).
      const store = await designStore();
      if (!store || store.blocked) { $pickNote.textContent = store && store.blocked ? store.reason : "You're signed out — sign in again to see your designs."; return; }
      const { data, error } = await store.db
        .from(store.table)
        .select('id, name, thumb_url, canvas, updated_at')
        .eq('user_id', store.uid)
        .order('updated_at', { ascending: false })
        .limit(60);
      if (error) { $pickNote.textContent = "Couldn't load your designs — try again in a moment."; return; }
      // Social posts only: a print design (A4, A5, A6, business card) is not
      // something you post (Dani, 15 Oct).
      pickCache = (data || []).filter((d) => !isPrintDesign(d));
      renderPickGrid(pickCache);
    }

    const PRINT_SIZES = new Set(
      STUDIO_SIZES.filter((g) => g.family === 'print')     // the same rule as the Studio shelf
        .flatMap((g) => g.sizes.map((z) => `${z.w}x${z.h}`))
    );
    function isPrintDesign(d) {
      const c = d && d.canvas;
      const w = Math.round(Number(c && c.width) || 0), h = Math.round(Number(c && c.height) || 0);
      if (!w || !h) return false;
      if (PRINT_SIZES.has(`${w}x${h}`) || PRINT_SIZES.has(`${h}x${w}`)) return true;
      const r = Math.max(w, h) / Math.min(w, h);
      return Math.abs(r - Math.SQRT2) < 0.01 && Math.min(w, h) >= 1200;   // any ISO paper size at print resolution
    }

    function formatOfDesign(d) {
      const c = d && d.canvas;
      const w = Number(c && c.width), h = Number(c && c.height);
      if (!w || !h) return 'Design';
      const r = w / h;
      if (Math.abs(r - 1) < 0.02) return 'Square post';
      if (Math.abs(r - 0.75) < 0.03) return 'Instagram post';
      if (Math.abs(r - 0.5625) < 0.03) return 'Story / Reel';
      return r > 1.2 ? 'Landscape' : 'Portrait';
    }

    function renderPickGrid(rows) {
      if (!rows.length) {
        $pickNote.innerHTML = 'No saved designs yet. <a href="/account/editor?blank=1&for=' + encodeURIComponent(pickDate) + '">Create one for this day</a> and it will be here.';
        $pickGrid.innerHTML = '';
        return;
      }
      $pickNote.textContent = 'Click the one you want to plan. It goes on the calendar exactly as it is.';
      $pickGrid.innerHTML = rows.map((d) => `
        <button type="button" class="pick-card" data-design="${escapeHtml(String(d.id))}">
          <img src="${escapeHtml(d.thumb_url || '')}" alt="" loading="lazy" />
          <b>${escapeHtml(d.name || 'Untitled design')}</b>
          <span>${escapeHtml(formatOfDesign(d))}</span>
        </button>`).join('');
    }

    let pickSaved = false;
    function choosePick(id) {
      const d = typeof id === 'object' ? id : (pickCache || []).find((x) => String(x.id) === String(id));
      if (!d) return;
      pickChosen = d;
      const fig = $pickImg.closest('.pick-chosen');
      fig.classList.toggle('is-file', !d.thumb_url);
      $pickFileTile.textContent = d.fileLabel || 'FILE';
      $pickImg.src = d.thumb_url || '';
      $pickName.textContent = d.upload
        ? [pickUploads.length && `${pickUploads.length} ${pickUploads.length === 1 ? 'file' : 'files'}`, pickLinks.length && `${pickLinks.length} ${pickLinks.length === 1 ? 'link' : 'links'}`].filter(Boolean).join(', ')
        : (d.name || 'Untitled design');
      $pickBack.textContent = pickMode === 'sequence' ? 'Skip this one' : (d.upload ? 'Back to upload' : 'Choose another');
      $pickContinue.hidden = true; $pickSave.hidden = false;
      $pickUpload.hidden = true;
      $pickTitle.value = d.name || '';
      $pickDate.value = pickDate;
      $pickDate.min = ymd(new Date());
      if (!$pickTime.value) $pickTime.value = '09:00';
      $pickCaption.value = '';
      $pickRemind.checked = true;
      clearPickError();
      $pickH.textContent = pickMode === 'sequence' ? `Plan post ${pickIndex + 1} of ${pickQueue.length}` : 'Plan this post';
      $pickSave.textContent = pickMode === 'sequence' && pickIndex < pickQueue.length - 1 ? 'Plan post & next' : 'Plan post';
      $pickDesigns.hidden = true;
      $pickPlan.hidden = false;
      $pickFoot.hidden = false;
      syncSaveCal();
      setTimeout(() => $pickTitle.focus(), 50);
    }

    function backToPick() {
      if (pickMode === 'sequence') { nextInSequence(); return; }
      if (pickMode === 'upload') {
        $pickH.textContent = 'Upload a post';
        $pickPlan.hidden = true; $pickUpload.hidden = false;
        $pickContinue.hidden = false; $pickSave.hidden = true; pickChosen = null; syncSaveCal();
        return;
      }
      $pickH.textContent = 'Choose a design';
      $pickDesigns.hidden = false;
      $pickPlan.hidden = true;
      $pickFoot.hidden = true;
      pickChosen = null;
    }

    async function savePick() {
      if (!pickChosen) return;
      clearPickError();
      const title = ($pickTitle.value || '').trim();
      const dateStr = $pickDate.value;
      const timeStr = $pickTime.value || '09:00';
      const caption = ($pickCaption.value || '').trim();
      if (!title) return showPickError('Give the post a short title — it shows on your calendar.');
      if (!dateStr) return showPickError('Pick a date for the post.');
      const asset = pickChosen.thumb_url || '';
      if (!asset && !pickChosen.upload) return showPickError("That design has no preview saved yet. Open it in the Studio, let it save, then plan it.");

      // A member, or the training account through Dani's login.
      const acct = await plannerStore();
      if (!acct) return showPickError("You're signed out — sign in again.");
      if (acct.blocked) return showPickError(acct.reason);

      $pickSave.disabled = true;
      $pickSave.textContent = 'Planning…';
      const row = {
        user_id: acct.uid,
        scheduled_date: dateStr,
        scheduled_time: timeStr,
        title,
        caption: caption || null,
        asset_url: asset || null,
        thumbnail_url: asset || null,
        design_ref: pickChosen.upload ? null : String(pickChosen.id),
        platform_hint: 'instagram',
        status: 'scheduled',
        reminder: !!$pickRemind.checked,
      };
      if (pickChosen.upload) row.details = {
        files: pickUploads.map((x) => ({ kind: 'file', name: x.name, url: x.url, path: x.path, size: x.size, mime: x.mime })),
        links: pickLinks.slice(),
      };
      // From a campaign's Plan these posts: the post is the campaign's.
      if (pickMode === 'sequence' && pickCampaign) row.details = { ...(row.details || {}), campaign_id: String(pickCampaign) };
      let { data, error } = await acct.db.from(acct.table).insert(row).select('*').single();
      if (error && /reminder/i.test(error.message || '') && /column/i.test(error.message || '')) {
        const { reminder, ...rest } = row;
        ({ data, error } = await acct.db.from(acct.table).insert(rest).select('*').single());
      }
      if (error) {
        $pickSave.disabled = false;
        $pickSave.textContent = 'Plan post';
        return showPickError(error.message || "Couldn't add that to your calendar.");
      }
      if (data) items.push(data);
      pickSaved = true;
      renderCalendar();
      $pickSave.textContent = 'Planned ✓';
      showPickError('On your calendar for ' + fmtFullDate(new Date(dateStr + 'T00:00:00')) + '.', true);
      if (pickMode === 'sequence') { pickDate = addDays(dateStr, 1); setTimeout(nextInSequence, 700); return data; }
      setTimeout(() => { closePick(); refreshDayUnder(); }, 800);
      return data;   // Plan & add to my calendar adds this one
    }

    /* Plan your posts (Dani, 16 Oct): a campaign's linked designs, one after
       another - date, time and caption for each - all from the campaign. A
       print design isn't a post, so it's left out. Each starts the day after
       the one before. */
    function addDays(ymdStr, n) { const t = new Date(ymdStr + 'T12:00:00'); t.setDate(t.getDate() + n); return ymd(t); }
    let pickCampaign = null;   // the campaign a sequence's posts belong to
    function planSequence(designs, startDate, campaignId) {
      if (demoOn() && !isTrainingDemo()) { lock("Planning is for members.", "Members plan a campaign's posts from here."); return; }
      pickQueue = designs; pickIndex = -1; pickMode = 'sequence'; pickCampaign = campaignId || null;
      pickDate = startDate;
      $pickEyebrow.textContent = 'Plan your posts';
      showPickModal();
      nextInSequence();
    }
    function nextInSequence() {
      pickIndex += 1;
      if (!pickQueue || pickIndex >= pickQueue.length) { closePick(); return; }
      $pickSave.disabled = false; clearPickError();
      choosePick(pickQueue[pickIndex]);
    }

    if ($dayPlan) $dayPlan.addEventListener('click', () => { if (openDayDate) openAct(openDayDate); });
    /* Plan a post for this day: what Social Media Post was in the Marketing
       Planner's list -- one of your designs, a template, or an upload (Dani,
       18 Oct). */
    document.getElementById('day-pick')?.addEventListener('click', () => {
      if (!openDayDate) return;
      if (demoOn() && !isTrainingDemo()) { openPick(openDayDate); return; }
      actDate = openDayDate; actEditing = null;
      $actEyebrow.textContent = fmtFullDate(new Date(openDayDate + 'T00:00:00'));
      chooseAct('social_post');
    });
    if ($pickClose) $pickClose.addEventListener('click', closePick);
    if ($pickCancel) $pickCancel.addEventListener('click', closePick);
    if ($pickBack) $pickBack.addEventListener('click', backToPick);
    if ($pickSave) $pickSave.addEventListener('click', savePick);
    if ($pickModal) $pickModal.addEventListener('click', (e) => { if (e.target === $pickModal) closePick(); });
    if ($pickGrid) $pickGrid.addEventListener('click', (e) => {
      const b = e.target.closest('[data-design]');
      if (b) choosePick(b.getAttribute('data-design'));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && $pickModal && !$pickModal.hidden) closePick();
    });

    // ====== Add to this day: the marketing activities ======
    /* Everything an estate agent's marketing involves, not only posts (Dani,
       15 Oct). The chooser lists the categories in working order; a social
       post goes on to the design library above, everything else is one form
       drawn from the activity's own fields (src/data/marketing-activities.js). */
    const $actModal  = document.getElementById('act-modal');
    const $actClose  = document.getElementById('act-close');
    const $actH      = document.getElementById('act-h');
    const $actLine   = document.getElementById('act-line');
    const $actMycal  = document.getElementById('act-mycal');
    const $postMycal = document.getElementById('post-mycal');
    const setActLine = (t) => { $actLine.textContent = t || ''; $actLine.hidden = !t; };
    const $actEyebrow = document.getElementById('act-eyebrow');
    const $actChoose = document.getElementById('act-choose');
    const $actForm   = document.getElementById('act-form');
    const $actFoot   = document.getElementById('act-foot');
    const $actSave   = document.getElementById('act-save');
    const $actBack   = document.getElementById('act-back');
    const $actDelete = document.getElementById('act-delete');
    let actDate = null, actKey = null, actEditing = null, actChecklist = [], actDesigns = null;
    /* Content Studio sessions and agent filming days are for agents of The
       Experts Group only (the same test as the TEG guides). */
    let isTeg = false;
    import('../../lib/guide-audience.js').then((m) => m.guideViewer(supabase)).then((v) => { isTeg = !!(v && v.teg) || isTrainingDemo(); }).catch(() => { isTeg = isTrainingDemo(); });

    const isAct = (it) => it && it.activity && it.activity !== 'social_post';
    /* The month a content planning session plans: chosen on it, or else the
       month it's in (in the first half) or the one after (Dani, 18 Oct). */
    function planMonthOf(it) {
      const v = it && it.details && it.details.plan_month;
      if (v && /^\d{4}-\d{2}$/.test(v)) return v;
      const d = new Date(((it && it.scheduled_date) || ymd(new Date())) + 'T00:00:00');
      return monthKey(d.getDate() <= 15 ? d : new Date(d.getFullYear(), d.getMonth() + 1, 1));
    }
    // A post planned from a campaign carries the campaign's name.
    function campaignTitle(p) {
      const id = p && p.details && p.details.campaign_id; if (!id) return '';
      const c = items.find((x) => String(x.id) === String(id));
      return c ? (c.title || activityOf(c.activity).label) : '';
    }
    const catOfItem = (it) => categoryOf(activityOf(it.activity || 'social_post').category);
    const lastDay = (it) => it.end_date && it.end_date > it.scheduled_date ? it.end_date : it.scheduled_date;
    const occursOn = (it, dateStr) => it.scheduled_date <= dateStr && lastDay(it) >= dateStr;

    function openAct(dateStr) {
      if (demoOn() && !isTrainingDemo()) {
        lock("Planning is for members.", "In the demo you can open any day and see how the planner works. Members plan their marketing here.");
        return;
      }
      actDate = dateStr; actKey = null; actEditing = null;
      $actEyebrow.textContent = fmtFullDate(new Date(dateStr + 'T00:00:00'));
      $actH.textContent = 'What are you planning?';
      setActLine('');
      const cat = (c) => {
        // Posts are planned in the Content Calendar now (Dani, 18 Oct).
        const list = ACTIVITIES.filter((a) => a.category === c.key && (!a.teg || isTeg) && !a.social);
        return `<section class="act-cat" style="--cat:${c.colour}"><h3>${escapeHtml(c.label)}</h3><ol>${
          list.map((a) => `<li><button type="button" class="act-pick" data-act="${a.key}">${escapeHtml(a.label)}</button></li>`).join('')
        }</ol></section>`;
      };
      // Content & Social over Something Else, then Property Marketing over
      // Campaigns, then Print & Canvassing over Business & Community (Dani, 16 Oct).
      const col = (keys) => `<div class="act-col">${keys.map((k) => cat(categoryOf(k))).join('')}</div>`;
      // Something Else under Content & Social, with its own heading like
      // every other group now Social Media Post has gone to the Content
      // Calendar, so the columns still end level (Dani, 18 Oct).
      $actChoose.innerHTML = `<div class="act-col">${cat(categoryOf('content'))}${cat(categoryOf('other'))}</div>`
        + `<div class="act-rest">${col(['property', 'campaigns'])}${col(['print', 'business'])}</div>`;
      $actChoose.hidden = false; $actForm.hidden = true; $actFoot.hidden = true;
      showActModal();
    }
    function showActModal() {
      $actModal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => $actModal.classList.add('is-open'));
    }
    function closeAct() {
      if (actFreshPaths.size) { const p = [...actFreshPaths]; actFreshPaths.clear(); filesDb().then((db) => db.storage.from(CAL_FILES).remove(p)).catch(() => {}); }
      $actModal.classList.remove('is-open');
      $actModal.hidden = true;
      actEditing = null;
      if ($dayModal.hidden) document.body.style.overflow = '';
    }

    /* The designs a form can attach: print designs for print and canvassing,
       any design for a launch campaign. Loaded once. */
    async function loadActDesigns() {
      if (actDesigns) return actDesigns;
      const store = await designStore();
      if (!store || store.blocked) return (actDesigns = []);
      const { data } = await store.db.from(store.table)
        .select('id, name, thumb_url, canvas, updated_at').eq('user_id', store.uid)
        .order('updated_at', { ascending: false }).limit(80);
      return (actDesigns = data || []);
    }

    async function chooseAct(key, item, opts) {
      const a = activityOf(key);
      if (a.social && !item) {
        // Three ways to a post (Dani, 16 Oct): one of your designs, a fresh
        // design from a template, or one made elsewhere, uploaded or linked.
        const c0 = categoryOf(a.category);
        actKey = a.key;
        $actH.textContent = a.label;
        setActLine(a.line);
        $actForm.style.setProperty('--cat', c0.colour);
        $actForm.innerHTML = `<div class="act-book-cards act-book-cards--3">
          <section class="act-book">
            <p class="act-kind">Use one of your designs</p>
            <p>Plan a post from the designs you've saved in the Studio.</p>
            <div class="act-book-links"><button type="button" class="is-primary" data-post-route="designs">Choose a design</button></div>
