            <div class="act-book-links"><button type="button" class="is-primary" data-post-route="upload">Upload a post</button></div>
          </section>
        </div>`;
        $actChoose.hidden = true; $actForm.hidden = false; $actFoot.hidden = false;
        $actDelete.hidden = true; $actSave.hidden = true; $actMycal.hidden = true; syncSaveCal(); $actBack.textContent = 'Cancel';
        if ($actModal.hidden) showActModal();
        return;
      }
      /* Content Planning (Dani, 18 Oct): the month's content plan, opened or
         made; or a session on this day to do it in, which opens the plan. */
      if (a.key === 'content_planning' && !item && !(opts && opts.log)) {
        const c0 = categoryOf(a.category);
        const key = planMonthOf({ scheduled_date: actDate });
        actKey = a.key;
        $actH.textContent = a.label;
        setActLine(a.line);
        $actForm.style.setProperty('--cat', c0.colour);
        const has = (await plannedMonths([key])).has(key);
        $actForm.innerHTML = `<div class="act-book-cards">
          <section class="act-book">
            <p class="act-kind">Your ${escapeHtml(planMonthName(key))} content plan</p>
            <p>Plan the month's posts in one place: dates, formats, content pillars and ideas, each one ready to make.</p>
            <div class="act-book-links"><a class="is-primary" href="${planUrl(key)}">${has ? 'Open your content plan' : 'Create your content plan'}</a></div>
          </section>
          <section class="act-book act-book--log">
            <p class="act-kind">Book time to plan it</p>
            <p>Put a planning session on this day. When you get to it, it opens your plan.</p>
            <div class="act-book-links"><button type="button" data-act-log="0">Add a planning session</button></div>
            <div></div>
          </section>
        </div>`;
        $actChoose.hidden = true; $actForm.hidden = false; $actFoot.hidden = false;
        $actDelete.hidden = true; $actSave.hidden = true; $actMycal.hidden = true; syncSaveCal(); $actBack.textContent = 'Back';
        if ($actModal.hidden) showActModal();
        return;
      }
      if (a.book && !item && !(opts && opts.log)) {
        // Something we film: book it with us, or add it as a day yourself
        // (Dani, 16 Oct). A booking lands on the calendar by itself.
        const c0 = categoryOf(a.category);
        actKey = a.key;
        $actH.textContent = a.label;
        setActLine(a.line);
        $actForm.style.setProperty('--cat', c0.colour);
        // Two cards side by side, the buttons stacked (Dani, 16 Oct).
        $actForm.innerHTML = `<div class="act-book-cards">
          <section class="act-book">
            <p class="act-kind">Book with TMKE</p>
            <p>${escapeHtml(a.book.blurb)}</p>
            <div class="act-book-links">
              ${a.book.book.map((b) => `<button type="button" class="is-primary" data-book-service="${b.service}">${escapeHtml(b.label)}</button>`).join('')}
              <a href="${a.book.info}" target="_blank" rel="noopener">${escapeHtml(a.book.discover || "See what's included")}</a>
              <a href="${a.book.brochure}" target="_blank" rel="noopener">Download the brochure</a>
            </div>
            <div><p class="act-book-note">Once it's booked, it appears on your calendar by itself.</p>
            <div class="post-error" data-act-error hidden></div></div>
          </section>
          <section class="act-book act-book--log">
            <p class="act-kind">Booked or arranged it yourself?</p>
            <p>Add it to your calendar with its date and time.</p>
            <div class="act-book-links">${(a.book.logs || [{ label: 'Add it as a day' }]).map((l, i) => `<button type="button" data-act-log="${i}">${escapeHtml(l.label)}</button>`).join('')}</div>
            <div></div>
          </section>
        </div>`;
        $actChoose.hidden = true; $actForm.hidden = false; $actFoot.hidden = false;
        $actDelete.hidden = true; $actSave.hidden = true; $actMycal.hidden = true; syncSaveCal(); $actBack.textContent = 'Back';
        if ($actModal.hidden) showActModal();
        return;
      }
      $actSave.hidden = false;
      actKey = a.key; actEditing = item || null;
      const c = categoryOf(a.category);
      const d = (item && item.details) || {};
      // Property photography or videography, when it was logged as one.
      actShoot = (opts && opts.shoot) || d.shoot || null;
      actChecklist = item ? (Array.isArray(item.checklist) ? item.checklist.map((x) => ({ ...x })) : [])
                          : (a.checklist || []).map((text) => ({ text, done: false }));
      actFiles = {};
      testiTone = null; testiCh = 'email';
      (a.fields || []).filter((f) => f.kind === 'files').forEach((f) => { actFiles[f.key] = (Array.isArray(d[f.key]) ? d[f.key] : []).map((x) => ({ ...x })); });
      $actH.textContent = item ? entryTitle(a.key, d) : (actShoot === 'Photography' ? 'Photography Shoot' : actShoot === 'Videography' ? 'Property Videography' : a.label);
      setActLine(a.line);
      $actEyebrow.textContent = fmtFullDate(new Date((item ? item.scheduled_date : actDate) + 'T00:00:00'));
      const hasTime = item ? item.has_time !== false : !!a.timeRequired;
      const time = item && item.has_time !== false ? fmtTime(item.scheduled_time) : (a.timeRequired ? '09:00' : '');
      // An entry keeps what was chosen for it; a new one starts on only for the
      // time-sensitive activities (a post, a property shoot -- Dani, 15 Oct).
      const remind = item ? item.reminder === true : !!a.reminder;
      const field = (f) => {
        const v = f.kind === 'endDate' ? (item && item.end_date) || '' : (d[f.key] ?? '');
        const lab = `<span class="post-label">${escapeHtml(f.label)}${f.optional ? ' <span class="pick-optional">— optional</span>' : ''}</span>`;
        if (f.kind === 'area') return `<label class="post-field">${lab}<textarea class="post-textarea" data-f="${f.key}" rows="3" placeholder="${escapeHtml(f.placeholder || '')}">${escapeHtml(v)}</textarea></label>`;
        if (f.kind === 'files') return `<div class="post-field act-files" data-files="${f.key}">${lab}
          <div class="act-files-list" data-files-list></div>
          <div class="act-files-add">
            <label class="act-files-btn"><input type="file" multiple accept="${FILE_ACCEPT}" data-files-input hidden />Upload files</label>
            <input type="text" inputmode="url" spellcheck="false" class="post-input" data-files-url placeholder="Or paste a link" />
            <button type="button" class="act-files-btn" data-files-link>Add link</button>
          </div></div>`;
        if (f.kind === 'planMonth') {
          const from = new Date((item ? item.scheduled_date : actDate) + 'T00:00:00');
          const pick = v || planMonthOf(item || { scheduled_date: actDate });
          const opts = [0, 1, 2].map((n) => monthKey(new Date(from.getFullYear(), from.getMonth() + n, 1)));
          if (!opts.includes(pick)) opts.unshift(pick);
          return `<label class="post-field">${lab}<select class="post-input" data-f="${f.key}" data-plan-month-pick>${opts.map((k) => `<option value="${k}"${k === pick ? ' selected' : ''}>${escapeHtml(new Date(k + '-01T00:00:00').toLocaleDateString('en-GB', { month: 'long', year: 'numeric' }))}</option>`).join('')}</select></label>`;
        }
        if (f.kind === 'number') return `<label class="post-field">${lab}<input type="number" min="0" class="post-input" data-f="${f.key}" value="${escapeHtml(v)}" /></label>`;
        if (f.kind === 'endDate') return `<label class="post-field">${lab}<input type="date" class="post-input" data-f="end_date" value="${escapeHtml(v)}" /></label>`;
        if (f.kind === 'endTime') return `<label class="post-field">${lab}<input type="text" readonly data-time data-time-optional placeholder="Choose a time" class="post-input" data-f="end_time" value="${escapeHtml(v)}" /></label>`;
        if (f.kind === 'platform') return `<label class="post-field">${lab}<select class="post-input" data-f="platform"><option value="">Choose…</option>${PLATFORMS.map((p) => `<option${p === v ? ' selected' : ''}>${escapeHtml(p)}</option>`).join('')}</select></label>`;
        if (f.kind === 'printDesign' || f.kind === 'printDesigns' || f.kind === 'linkedDesigns') return `<div class="post-field">${lab}<div class="act-designs" data-designs="${f.kind}" data-f="${f.key}"><p class="act-none">Loading your designs…</p></div></div>`;
        if (f.kind === 'testimonial') return `<div class="post-field act-testi" data-testi>${lab.replace(' <span class="pick-optional">— optional</span>', '')}
          <div class="act-testi-tones">${TESTIMONIAL_TONES.map((t) => `<button type="button" class="act-files-btn" data-testi-tone="${t.key}" aria-pressed="false">${escapeHtml(t.label)}</button>`).join('')}</div>
          <div class="act-testi-out" hidden>
            <div class="act-testi-head">
              <p class="act-testi-note" data-testi-note></p>
              <div class="act-testi-channel" role="group" aria-label="Send it as">
                <button type="button" data-testi-ch="email" aria-pressed="true">Email</button>
                <button type="button" data-testi-ch="whatsapp" aria-pressed="false">WhatsApp</button>
              </div>
            </div>
            <label class="post-field" data-testi-subject-row><span class="post-label">Subject</span><input type="text" class="post-input" data-testi-subject /></label>
            <textarea class="post-textarea act-testi-body" data-testi-body rows="11"></textarea>
            <p class="act-testi-missing" data-testi-missing hidden></p>
            <div class="act-testi-acts">
              <button type="button" class="act-files-btn" data-testi-copy="subject">Copy subject</button>
              <button type="button" class="act-files-btn act-testi-copy" data-testi-copy="body">Copy message</button>
            </div>
          </div></div>`;
        if (f.kind === 'campaignLink') return `<div class="post-field">${lab}<div class="act-campaign"><select class="post-input" data-f="${f.key}" data-campaign-pick data-was="${escapeHtml(v)}"><option value="">No campaign</option></select><button type="button" class="act-files-btn" data-open-campaign hidden>Open it</button></div></div>`;
        return `<label class="post-field">${lab}<input type="text" class="post-input" data-f="${f.key}" value="${escapeHtml(v)}" placeholder="${escapeHtml(f.placeholder || '')}" maxlength="160" /></label>`;
      };
      const fields = a.fields || [];
      const checklistHtml = `<div class="post-field"><span class="post-label">Checklist <span class="act-progress" data-progress></span></span>
          <div class="act-check" data-check></div>
          <div class="act-check-add"><input type="text" class="post-input" data-check-new placeholder="Add an item" maxlength="160" /><button type="button" data-check-add>Add</button></div>
        </div>`;
      $actForm.style.setProperty('--cat', c.colour);
      $actForm.innerHTML = `
        <p class="act-kind">${escapeHtml(c.label)} · ${escapeHtml(a.label)}</p>
        ${fields.filter((f) => !f.afterDates && !['endDate', 'endTime', 'printDesign', 'printDesigns', 'linkedDesigns', 'area', 'files', 'campaignLink'].includes(f.kind)).map(field).join('')}
        <div class="act-row">
          <label class="post-field"><span class="post-label">${fields.some((f) => f.kind === 'endDate') ? 'Start date' : 'Date'}</span>
            <input type="date" class="post-input" data-f="date" value="${escapeHtml(item ? item.scheduled_date : actDate)}" /></label>
          ${fields.filter((f) => f.kind === 'endDate').map(field).join('')}
          <label class="post-field"><span class="post-label">${a.key === 'open_house' ? 'Start time' : 'Time'}${a.timeRequired ? '' : ' <span class="pick-optional">— optional</span>'}</span>
            <input type="text" readonly data-time${a.timeRequired ? '' : ' data-time-optional'} placeholder="${a.timeRequired ? 'Choose a time' : 'All day'}" class="post-input" data-f="time" value="${escapeHtml(hasTime ? time : '')}" /></label>
          ${fields.filter((f) => f.kind === 'endTime').map(field).join('')}
        </div>
        ${fields.filter((f) => f.afterDates).map(field).join('')}
        ${a.buttons ? `<div class="act-btns">${a.buttons.map((b) => `<a class="act-files-btn" href="${b.href}" target="_blank" rel="noopener">${escapeHtml(b.label)}</a>`).join('')}</div>` : ''}
        ${a.category === 'campaigns' && item ? `<div class="post-field" data-linked-events hidden></div>` : ''}
        ${a.checklistFirst ? checklistHtml : ''}
        ${fields.filter((f) => !f.afterDates && ['printDesign', 'printDesigns', 'linkedDesigns', 'area', 'files'].includes(f.kind)).map(field).join('')}
        ${a.link ? `<a class="act-link" href="${a.link.href}">${escapeHtml(a.link.label)} &rarr;</a>` : ''}
        ${a.key === 'content_planning' ? `<a class="act-link" data-plan-open href="${planUrl(planMonthOf(item || { scheduled_date: actDate }))}">Open your content plan &rarr;</a>` : ''}
        <label class="post-field"><span class="post-label">Notes <span class="pick-optional">— optional</span></span>
          <textarea class="post-textarea act-notes" data-f="notes" rows="2" maxlength="2000">${escapeHtml((item && item.notes) || '')}</textarea></label>
        ${fields.filter((f) => f.kind === 'campaignLink').map(field).join('')}
        ${a.checklistFirst || a.noChecklist ? '' : checklistHtml}
        <label class="post-remind"><input type="checkbox" data-f="reminder" ${remind ? 'checked' : ''} />
          <span>Remind me on the day <span class="post-remind-note">&mdash; we'll email you at 8am that morning</span></span></label>
        <div class="post-error" data-act-error hidden></div>`;
      drawChecklist();
      Object.keys(actFiles).forEach(drawFiles);
      $actChoose.hidden = true; $actForm.hidden = false; $actFoot.hidden = false;
      $actDelete.hidden = !item;
      $actBack.textContent = item ? 'Cancel' : 'Back';
      $actSave.disabled = false; $actSave.textContent = item ? 'Save changes' : 'Save';
      $actMycal.hidden = !item || (demoOn() && !isTrainingDemo()) || calSynced;
      syncSaveCal();
      if ($actModal.hidden) showActModal();
      $actForm.scrollTop = 0;
      // The plan link follows the month chosen.
      $actForm.querySelector('[data-plan-month-pick]')?.addEventListener('change', (e) => {
        const l = $actForm.querySelector('[data-plan-open]'); if (l) l.href = planUrl(e.target.value);
      });
      linkCampaigns(item);
      // Designs, once they have loaded.
      const pickers = [...$actForm.querySelectorAll('[data-designs]')];
      if (pickers.length) {
        const all = await loadActDesigns();
        pickers.forEach((box) => {
          const multi = box.dataset.designs === 'linkedDesigns' || box.dataset.designs === 'printDesigns';
          const list = box.dataset.designs === 'linkedDesigns' ? all : all.filter((x) => isPrintDesign(x));
          // An entry from before several could be chosen kept one, as design_id.
          const chosen = new Set([].concat(d[box.dataset.f] || [], box.dataset.f === 'design_ids' && d.design_id ? [d.design_id] : []).map(String));
          box.innerHTML = list.length
            ? list.map((x) => `<button type="button" class="act-design${chosen.has(String(x.id)) ? ' is-on' : ''}" data-design-id="${escapeHtml(String(x.id))}" aria-pressed="${chosen.has(String(x.id))}"><img src="${escapeHtml(x.thumb_url || '')}" alt="" loading="lazy" /><span>${escapeHtml(x.name || 'Untitled design')}</span></button>`).join('')
            : `<p class="act-none">${box.dataset.designs === 'linkedDesigns' ? 'No saved designs yet.' : 'No print designs yet. Make one from your print packs in the Studio.'}</p>`;
          /* Linked designs can be planned as posts from here (Dani, 16 Oct):
