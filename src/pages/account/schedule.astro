          let planBtn = null;
          // In the order they were picked: that's the order they go out in.
          const picked = [...box.querySelectorAll('.act-design.is-on')].map((b) => b.dataset.designId);
          const pickedDesigns = () => picked.map((id) => all.find((x) => String(x.id) === id)).filter((x) => x && !isPrintDesign(x));
          const syncPlan = () => {
            if (!planBtn) return;
            const n = pickedDesigns().length;
            planBtn.hidden = !n;
            planBtn.textContent = n === 1 ? 'Plan this post' : `Plan these ${n} posts`;
          };
          if (box.dataset.designs === 'linkedDesigns' && list.length) {
            box.insertAdjacentHTML('afterend', `<button type="button" class="act-files-btn act-plan-designs" data-plan-designs hidden>Plan these posts</button>`);
            planBtn = box.nextElementSibling;
            planBtn.addEventListener('click', () => {
              const chosen = pickedDesigns();
              const start = ($actForm.querySelector('[data-f="date"]') || {}).value || actDate;
              if (chosen.length) planSequence(chosen, start, actEditing && actEditing.id);
            });
            syncPlan();
          }
          box.addEventListener('click', (e) => {
            const b = e.target.closest('[data-design-id]'); if (!b) return;
            if (!multi) box.querySelectorAll('.act-design.is-on').forEach((o) => { if (o !== b) { o.classList.remove('is-on'); o.setAttribute('aria-pressed', 'false'); } });
            const on = !b.classList.contains('is-on');
            b.classList.toggle('is-on', on); b.setAttribute('aria-pressed', String(on));
            const id = b.dataset.designId, at = picked.indexOf(id);
            if (on && at < 0) picked.push(id);
            if (!on && at >= 0) picked.splice(at, 1);
            if (!multi) { picked.length = 0; if (on) picked.push(id); }
            syncPlan();
          });
        });
      }
    }

    /* An event and its campaign, linked both ways (Dani, 16 Oct). The event's
       Campaign list is every campaign they've made; the campaign shows the
       events linked to it. Either opens the other, which may still have steps
       left on its checklist. */
    const CAMPAIGN_KEYS = ACTIVITIES.filter((x) => x.category === 'campaigns').map((x) => x.key);

    /* With a pop-out open, the wheel scrolls the pop-out (Dani, 16 Oct). The
       site's smooth scrolling (Lenis, app.js) takes the wheel for the page,
       locked or not, so it's paused while any of them is open. */
    (() => {
      const pops = () => [...document.querySelectorAll('.day-backdrop, .dc-panel')];
      const sync = () => {
        const open = pops().some((el) => el.classList.contains('dc-panel')
          ? el.getAttribute('aria-hidden') === 'false' || el.classList.contains('is-open')
          : !el.hidden);
        const l = window.__lenis;
        if (l) { if (open) l.stop(); else l.start(); }
      };
      const mo = new MutationObserver(sync);
      pops().forEach((el) => { el.setAttribute('data-lenis-prevent', ''); mo.observe(el, { attributes: true, attributeFilter: ['hidden', 'class', 'aria-hidden'] }); });
    })();
    async function linkCampaigns(item) {
      const pick = $actForm.querySelector('[data-campaign-pick]');
      const back = $actForm.querySelector('[data-linked-events]');
      if (!pick && !back) return;
      const acct = await plannerStore();
      if (!acct || acct.blocked) return;
      if (pick) {
        const { data } = await acct.db.from(acct.table).select('id, title, activity, scheduled_date')
          .eq('user_id', acct.uid).in('activity', CAMPAIGN_KEYS).order('scheduled_date', { ascending: false }).limit(60);
        const was = pick.dataset.was || '';
        (data || []).forEach((c) => {
          const o = document.createElement('option');
          o.value = c.id;
          const label = activityOf(c.activity).label;
          const when = new Date(c.scheduled_date + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
          o.textContent = (c.title && c.title !== label ? `${c.title} · ` : '') + `${label} · ${when}`;
          if (String(c.id) === was) o.selected = true;
          pick.appendChild(o);
        });
        const btn = $actForm.querySelector('[data-open-campaign]');
        const sync = () => { btn.hidden = !pick.value; };
        pick.addEventListener('change', sync); sync();
      }
      if (back && item) {
        const { data } = await acct.db.from(acct.table).select('id, title, activity, scheduled_date, scheduled_time, status')
          .eq('user_id', acct.uid).eq('details->>campaign_id', String(item.id)).order('scheduled_date', { ascending: true }).order('scheduled_time', { ascending: true });
        const events = (data || []).filter((e) => !isPostItem(e));
        const posts = (data || []).filter((e) => isPostItem(e) && e.status !== 'cancelled');
        /* Its posts, in the Content Calendar (Dani, 18 Oct): "3 posts
           planned: Tue 4 Nov 10:00, ...", each opening its post. */
        const when = (e) => `${new Date(e.scheduled_date + 'T00:00:00').toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short' })} ${fmtTime(e.scheduled_time)}`;
        const html = [
          events.length ? `<span class="post-label">Linked to this campaign</span><div class="act-linked">${events.map((e) =>
            `<button type="button" class="act-files-btn" data-open-entry="${escapeHtml(String(e.id))}">${escapeHtml(activityOf(e.activity).label)} · ${escapeHtml(new Date(e.scheduled_date + 'T00:00:00').toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }))}</button>`).join('')}</div>` : '',
          posts.length ? `<span class="post-label">In your Content Calendar</span><p class="act-posts-line">${posts.length} ${posts.length === 1 ? 'post' : 'posts'} planned: ${posts.map((e) =>
            `<button type="button" data-open-post="${escapeHtml(String(e.id))}" data-date="${escapeHtml(e.scheduled_date)}" title="${escapeHtml(e.title || '')}">${escapeHtml(when(e))}</button>`).join(', ')}</p>` : '',
        ].join('');
        if (html) { back.innerHTML = html; back.hidden = false; }
      }
    }
    // Open a linked entry in place of this one.
    async function openLinked(id) {
      const acct = await plannerStore();
      if (!acct || acct.blocked) return;
      const { data } = await acct.db.from(acct.table).select('*').eq('user_id', acct.uid).eq('id', id).maybeSingle();
      if (!data) return actError("That entry isn't on your calendar any more.");
      actDate = data.scheduled_date;
      chooseAct(data.activity, data);
    }
    $actForm?.addEventListener('click', (e) => {
      const open = e.target.closest && e.target.closest('[data-open-campaign]');
      if (open) { const v = $actForm.querySelector('[data-campaign-pick]').value; if (v) openLinked(v); return; }
      const ent = e.target.closest && e.target.closest('[data-open-entry]');
      if (ent) openLinked(ent.dataset.openEntry);
      const post = e.target.closest && e.target.closest('[data-open-post]');
      if (post) {
        // On the Content Calendar, at its post; a month away, the page opens there.
        if (!items.some((i) => String(i.id) === post.dataset.openPost)) { location.href = `/account/schedule?view=posts&focus=${post.dataset.date}`; return; }
        closeAct(); setCalView('posts'); openPost(post.dataset.openPost);
      }
    });

    /* Request a Testimonial (Dani, 16 Oct): pick a tone, email or WhatsApp,
       and the message is there, filled in from the brand kit, to copy. */
    let testiTone = null, testiCh = 'email', testiKit;
    async function brandKitNow() {
      if (testiKit !== undefined) return testiKit;
      if (isTrainingDemo()) { try { testiKit = JSON.parse(localStorage.getItem('tmke.brand.training') || 'null'); } catch (_) { testiKit = null; } return testiKit; }
      const { data } = await supabase.auth.getSession();
      const uid = data && data.session && data.session.user.id;
      const cached = readBrandCache();
      if (cached && (!cached.owner || cached.owner === uid)) return (testiKit = cached);
      if (!uid) return (testiKit = null);
      const r = await supabase.from('member_brand_kits').select('kit').eq('user_id', uid).maybeSingle();
      return (testiKit = (r.data && r.data.kit) || null);
    }
    async function drawTestimonial() {
      const box = $actForm.querySelector('[data-testi]'); if (!box) return;
      const tone = TESTIMONIAL_TONES.find((t) => t.key === testiTone);
      box.querySelectorAll('[data-testi-tone]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.testiTone === testiTone)));
      box.querySelectorAll('[data-testi-ch]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.testiCh === testiCh)));
      const out = box.querySelector('.act-testi-out');
      out.hidden = !tone;
      if (!tone) return;
      const kit = await brandKitNow();
      const email = testiCh === 'email';
      box.querySelector('[data-testi-note]').textContent = tone.note;
      box.querySelector('[data-testi-subject-row]').hidden = !email;
      box.querySelector('[data-testi-copy="subject"]').hidden = !email;
      box.querySelector('[data-testi-subject]').value = email ? fillTestimonial(tone.email.subject, 'email', kit) : '';
      box.querySelector('[data-testi-body]').value = fillTestimonial(email ? tone.email.body : tone.whatsapp, testiCh, kit);
      // Say what's still to fill, and where it comes from.
      const about = (kit && kit.about) || {};
      const gaps = [!about.review && 'your review link', !about.name && 'your name', email && testiTone === 'professional' && !(kit && kit.company) && 'your business name'].filter(Boolean);
      const miss = box.querySelector('[data-testi-missing]');
      miss.hidden = false;
      miss.innerHTML = `Change [First Name] to your client's.${gaps.length ? ` Add ${gaps.join(' and ')} to your <a href="/account/profile" target="_blank" rel="noopener">Brand Kit</a> and ${gaps.length > 1 ? 'they fill' : 'it fills'} in here.` : ''}`;
    }
    $actForm?.addEventListener('click', async (e) => {
      const t = e.target.closest && e.target.closest('[data-testi-tone]');
      if (t) { testiTone = t.dataset.testiTone; drawTestimonial(); return; }
      const ch = e.target.closest && e.target.closest('[data-testi-ch]');
      if (ch) { testiCh = ch.dataset.testiCh; drawTestimonial(); return; }
      const cp = e.target.closest && e.target.closest('[data-testi-copy]');
      if (cp) {
        const box = $actForm.querySelector('[data-testi]');
        const text = cp.dataset.testiCopy === 'subject' ? box.querySelector('[data-testi-subject]').value : box.querySelector('[data-testi-body]').value;
        try { await navigator.clipboard.writeText(text); }
        catch (_) { const el = cp.dataset.testiCopy === 'subject' ? box.querySelector('[data-testi-subject]') : box.querySelector('[data-testi-body]'); el.select(); document.execCommand('copy'); }
        const was = cp.textContent; cp.textContent = 'Copied ✓'; setTimeout(() => { cp.textContent = was; }, 1600);
      }
    });

    function drawChecklist() {
      const box = $actForm.querySelector('[data-check]'); if (!box) return;
      box.innerHTML = actChecklist.map((x, i) => `
        <div class="act-check-item${x.done ? ' is-done' : ''}">
          <label><input type="checkbox" data-check-i="${i}" ${x.done ? 'checked' : ''} /><span>${escapeHtml(x.text)}</span></label>
          <button type="button" class="act-check-del" data-check-del="${i}" aria-label="Remove ${escapeHtml(x.text)}">&times;</button>
        </div>`).join('');
      const done = actChecklist.filter((x) => x.done).length;
      const pr = $actForm.querySelector('[data-progress]');
      if (pr) pr.textContent = actChecklist.length ? `${done} of ${actChecklist.length} done` : '— optional';
    }
    /* Files and links on an entry (Dani, 16 Oct). Files go to the private
       calendar-files bucket under the member's own folder and open through a
       link that lasts five minutes (supabase/calendar_files.sql). */
    const CAL_FILES = 'calendar-files';
    // The login that owns the files: a member's, or Dani's for the training account.
    const filesDb = async () => { const a = await plannerStore(); return a && !a.blocked ? a.db : supabase; };
    const FILE_ACCEPT = '.pdf,.doc,.docx,.txt,.rtf,.odt,.pages,.xls,.xlsx,.csv,.numbers,.ppt,.pptx,.key,.png,.jpg,.jpeg,.webp,.heic';
    const FILE_MAX = 25 * 1024 * 1024;
    let actFiles = {};
    let actShoot = null;
    const actFreshPaths = new Set();   // uploaded since the form opened, not saved yet
    const filePathsOf = (it) => {
      const d = (it && it.details) || {};
      return Object.values(d).filter(Array.isArray).flat().filter((x) => x && x.kind === 'file' && x.path).map((x) => x.path);
    };
    const fmtSize = (n) => n >= 1048576 ? (n / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(n / 1024)) + ' KB';
    function drawFiles(key) {
      const box = $actForm.querySelector(`[data-files="${key}"] [data-files-list]`); if (!box) return;
      const list = actFiles[key] || [];
      box.innerHTML = list.map((x, i) => {
        const name = x.kind === 'link' ? x.url.replace(/^https?:\/\//, '').replace(/\/$/, '') : x.name;
        const meta = x.kind === 'link' ? 'Link' : (x.uploading ? 'Uploading…' : fmtSize(x.size || 0));
        return `<div class="act-file${x.uploading ? ' is-uploading' : ''}">
          <button type="button" class="act-file-open" data-file-open="${i}" ${x.uploading ? 'disabled' : ''}><span class="act-file-kind">${x.kind === 'link' ? 'Link' : escapeHtml((String(x.name).split('.').pop() || 'File').slice(0, 5))}</span><span class="act-file-name">${escapeHtml(name)}</span><span class="act-file-meta">${escapeHtml(meta)}</span></button>
          <button type="button" class="act-check-del" data-file-del="${i}" aria-label="Remove ${escapeHtml(name)}">&times;</button>
        </div>`;
      }).join('');
    }
    async function uploadCalFiles(key, files) {
      const acct = await plannerStore();
      if (!acct || acct.blocked) return actError(acct ? acct.reason : "You're signed out — sign in again.");
      actError('');
      for (const file of files) {
        if (file.size > FILE_MAX) { actError(`${file.name} is over 25 MB, so it can't be added. Add a link to it instead.`); continue; }
        const safe = file.name.replace(/[^\w.\-]+/g, '-').slice(-80);
        const path = `${acct.uid}/${acct.training ? 'training/' : ''}${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 8)}-${safe}`;
        const entry = { kind: 'file', name: file.name, size: file.size, mime: file.type || '', path, uploading: true };
        (actFiles[key] = actFiles[key] || []).push(entry); drawFiles(key);
        const { error } = await acct.db.storage.from(CAL_FILES).upload(path, file, { contentType: file.type || undefined, upsert: false });
        if (error) {
          actFiles[key] = actFiles[key].filter((x) => x !== entry); drawFiles(key);
          actError(/bucket|not found/i.test(error.message || '') ? 'File uploads need one update before they work (supabase/calendar_files.sql).' : `${file.name} didn't upload: ${error.message || 'try again'}.`);
          continue;
        }
        entry.uploading = false; actFreshPaths.add(path); drawFiles(key);
      }
    }
    $actForm?.addEventListener('change', (e) => {
      const inp = e.target.closest && e.target.closest('[data-files-input]'); if (!inp) return;
      const key = inp.closest('[data-files]').dataset.files;
      uploadCalFiles(key, [...inp.files]); inp.value = '';
    });
    $actForm?.addEventListener('click', async (e) => {
      const wrap = e.target.closest && e.target.closest('[data-files]'); if (!wrap) return;
      const key = wrap.dataset.files, list = actFiles[key] || [];
      if (e.target.closest('[data-files-link]')) {
        const inp = wrap.querySelector('[data-files-url]');
        let url = String(inp.value || '').trim(); if (!url) return;
        if (!/^https?:\/\//i.test(url)) url = 'https://' + url;
        try { new URL(url); } catch (_) { return actError("That doesn't look like a link."); }
        list.push({ kind: 'link', url }); actFiles[key] = list; inp.value = ''; drawFiles(key); return;
      }
      const del = e.target.closest('[data-file-del]');
      if (del) {
        const [x] = list.splice(+del.dataset.fileDel, 1); drawFiles(key);
        if (x && x.kind === 'file' && actFreshPaths.has(x.path)) { actFreshPaths.delete(x.path); filesDb().then((db) => db.storage.from(CAL_FILES).remove([x.path])).catch(() => {}); }
        return;
      }
      const open = e.target.closest('[data-file-open]');
      if (open) {
        const x = list[+open.dataset.fileOpen]; if (!x) return;
        if (x.kind === 'link') { window.open(x.url, '_blank', 'noopener'); return; }
        const w = window.open('', '_blank');   // opened now, so it isn't blocked as a pop-up
        const acct = await plannerStore();
        const { data, error } = acct && !acct.blocked ? await acct.db.storage.from(CAL_FILES).createSignedUrl(x.path, 300) : { error: true };
        if (error || !data) { if (w) w.close(); return actError("Couldn't open that file just now."); }
        if (w) w.location.href = data.signedUrl; else location.href = data.signedUrl;
      }
    });
    $actForm?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.target.matches && e.target.matches('[data-files-url]')) { e.preventDefault(); e.target.closest('[data-files]').querySelector('[data-files-link]').click(); }
    });

    function actError(msg, ok) {
      const el = $actForm.querySelector('[data-act-error]'); if (!el) return;
      el.hidden = !msg; el.textContent = msg || ''; el.classList.toggle('is-ok', !!ok);
    }

    async function saveAct() {
      const a = activityOf(actKey);
      const val = (k) => { const el = $actForm.querySelector(`[data-f="${k}"]`); return el ? (el.type === 'checkbox' ? el.checked : String(el.value || '').trim()) : ''; };
      actError('');
      const details = {};
      for (const f of a.fields || []) {
        if (f.kind === 'endDate') continue;
        if (f.kind === 'testimonial') continue;   // a message to copy, not a field to keep
        if (f.kind === 'files') {
          const list = (actFiles[f.key] || []);
          if (list.some((x) => x.uploading)) return actError('Wait for the files to finish uploading.');
          if (list.length) details[f.key] = list.map(({ uploading, fresh, ...x }) => x);
          continue;
        }
        if (f.kind === 'printDesign' || f.kind === 'printDesigns' || f.kind === 'linkedDesigns') {
          const ids = [...$actForm.querySelectorAll(`[data-f="${f.key}"] .act-design.is-on`)].map((b) => b.dataset.designId);
          if (f.kind === 'printDesign') { if (ids[0]) details[f.key] = ids[0]; } else if (ids.length) details[f.key] = ids;
          continue;
        }
        const v = val(f.key);
        if (f.required && !v) return actError(`Add the ${f.label.toLowerCase()}.`);
        if (v) details[f.key] = f.kind === 'number' ? Number(v) : v;
      }
      if (actShoot) details.shoot = actShoot;
      const date = val('date');
      if (!date) return actError('Choose a date.');
      const endDate = (a.fields || []).some((f) => f.kind === 'endDate') ? val('end_date') : '';
      if (endDate && endDate < date) return actError('The end date is before the start.');
      const time = val('time');
      if (a.timeRequired && !time) return actError('Choose a time.');
      const acct = await plannerStore();
      if (!acct) return actError("You're signed out — sign in again.");
      if (acct.blocked) return actError(acct.reason);
      const row = {
        activity: a.key,
        title: entryTitle(a.key, details),
        scheduled_date: date,
        end_date: endDate || null,
        scheduled_time: time || '09:00',
        has_time: !!time,
        details,
        notes: val('notes') || null,
        checklist: actChecklist,
        reminder: !!val('reminder'),
        platform_hint: 'other',
      };
      $actSave.disabled = true; $actSave.textContent = 'Saving…';
      let res;
      if (actEditing) res = await acct.db.from(acct.table).update(row).eq('id', actEditing.id).eq('user_id', acct.uid).select('*').single();
      else res = await acct.db.from(acct.table).insert({ ...row, user_id: acct.uid, status: 'scheduled' }).select('*').single();
      if (res.error) {
        $actSave.disabled = false; $actSave.textContent = actEditing ? 'Save changes' : 'Save';
        const m = res.error.message || '';
        return actError(/column|activity/i.test(m) ? 'The calendar needs one update before it can hold this (supabase/calendar_activities.sql).' : (m || "Couldn't save that."));
      }
      // Files taken off a saved entry go from storage too, now it's saved.
      const keptPaths = new Set(Object.values(details).flat().filter((x) => x && x.kind === 'file').map((x) => x.path));
      const dropped = filePathsOf(actEditing).filter((p) => !keptPaths.has(p));
      if (dropped.length) acct.db.storage.from(CAL_FILES).remove(dropped).catch(() => {});
      actFreshPaths.clear();
      items = items.filter((x) => !actEditing || String(x.id) !== String(actEditing.id)).concat(res.data);
      renderCalendar();
      $actSave.textContent = 'Saved ✓';
      setTimeout(() => { closeAct(); refreshDayUnder(); }, 500);
      return res.data;   // Save & add to my calendar adds this one
    }

    async function deleteAct() {
      if (!actEditing) return;
      const was = { ...actEditing };
      const acct = await plannerStore();
      if (!acct || acct.blocked) return actError(acct ? acct.reason : "You're signed out — sign in again.");
      const { error } = await acct.db.from(acct.table).delete().eq('id', actEditing.id).eq('user_id', acct.uid);
      if (error) return actError(error.message || "Couldn't remove it.");
      // Its files go only once Undo has passed.
      const gone = filePathsOf(actEditing);
      items = items.filter((x) => String(x.id) !== String(actEditing.id));
      renderCalendar(); closeAct(); refreshDayUnder();
      undoToast(`“${was.title || activityOf(was.activity).label}” removed from your calendar.`, () => restoreEntry(was), {
        onExpire: () => { if (gone.length) acct.db.storage.from(CAL_FILES).remove(gone).catch(() => {}); },
      });
    }

    // One door for anything in a day's list.
    function openEntry(id) {
      const it = items.find((i) => String(i.id) === String(id));
      if (!it) return;
      if (it.booking) { location.href = '/account/bookings'; return; }
      if (isAct(it)) { actDate = it.scheduled_date; chooseAct(it.activity, it); return; }
      openPost(id);
    }

    /* ---- Their own calendar (Dani, 17 Oct) ----
       Two ways, for Apple, Outlook and Google alike: sync the whole Marketing
       Calendar (subscribe once to a private link, which the calendar app checks
       for changes), or add one entry now as a copy. The link comes from the
       Worker, made from their sign-in. */
    let feedLink = null;
    async function getFeedLink(reset) {
      if (feedLink && !reset) return feedLink;
      if (!API_BASE) throw new Error("Calendar links aren't available here.");
      // A member's own login, or Dani's for the training account, whose feed
      // is the training entries (Worker: /calendar/feed/t/...).
      const acct = await plannerStore();
      if (!acct) throw new Error("You're signed out. Sign in again.");
      if (acct.blocked) throw new Error(acct.reason);
      const res = await fetch(`${API_BASE}/calendar/feed-link`, {
        method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: 'Bearer ' + acct.token },
        body: JSON.stringify({ reset: !!reset, training: !!acct.training }),
      });
      const j = await res.json().catch(() => ({}));
      if (!res.ok || !j.feed) throw new Error(j.error || "Couldn't get your link just now.");
      feedLink = j;
      return j;
    }

    // An entry's start and end, as the feed writes them: a time on the day
    // (an hour, half an hour for a post, or to its end time), or all day,
    // running to its end date.
    function entryWhen(it) {
      const ymd = (d) => String(d).slice(0, 10).replace(/-/g, '');
      const addDay = (d, n) => { const t = new Date(String(d).slice(0, 10) + 'T12:00:00Z'); t.setUTCDate(t.getUTCDate() + n); return t.toISOString().slice(0, 10); };
      const date = String(it.scheduled_date).slice(0, 10);
      const end = it.end_date && String(it.end_date).slice(0, 10) > date ? String(it.end_date).slice(0, 10) : null;
      if (it.has_time === false || end) return { allDay: true, date, endDate: addDay(end || date, 1), ymd, };
      const st = String(it.scheduled_time || '09:00').slice(0, 5);
      const toMin = (t) => +t.slice(0, 2) * 60 + +t.slice(3, 5);
      let en = toMin(st) + ((it.activity || 'social_post') === 'social_post' ? 30 : 60);
      const et = it.details && it.details.end_time ? String(it.details.end_time).slice(0, 5) : '';
      if (et && toMin(et) > toMin(st)) en = toMin(et);
      en = Math.min(en, 23 * 60 + 59);
      const hm = (m) => String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0');
      return { allDay: false, date, start: st, end: hm(en), ymd };
    }
    function entryText(it) {
      const a = activityOf(it.activity || 'social_post');
      const title = String(it.title || '').trim();
      const summary = !title || title === a.label ? a.label : `${a.label}: ${title}`;
      const d = it.details || {};
      const where = d.address || d.location || d.area || '';
      const isPost = !it.activity || it.activity === 'social_post';
      const files = isPost ? [it.asset_url && `Your design: ${it.asset_url}`, ...((Array.isArray(d.files) ? d.files : []).filter((f) => f && f.url).map((f) => `${f.name || 'File'}: ${f.url}`))].filter(Boolean).join('\n') : '';
      const body = [isPost ? '' : a.line, files, it.caption, it.notes, isPost
        ? `On your Content Calendar: https://tmke.co.uk/account/schedule?view=posts&focus=${it.scheduled_date}`
        : 'On your Marketing Planner: https://tmke.co.uk/account/schedule'].filter(Boolean).join('\n\n');
      return { summary, where, body };
    }

    /* Synced (Dani, 18 Oct): a calendar app has checked their link in the
       last fortnight. Then everything here reaches their calendar by itself,
       so Add to my calendar and Save & add aren't offered. */
    let calSynced = false;
    const demoLocked = () => demoOn() && !isTrainingDemo();
    function applySynced() {
      const pm = document.getElementById('post-mycal'); if (pm && calSynced) pm.hidden = true;
      const am = document.getElementById('act-mycal'); if (am && calSynced) am.hidden = true;
      syncSaveCal();
    }
    function syncSaveCal() {
      const a = document.getElementById('act-save-cal');
      if (a) a.hidden = calSynced || demoLocked() || !!actEditing || $actSave.hidden;
      const p = document.getElementById('pick-save-cal');
      if (p) p.hidden = calSynced || demoLocked() || $pickSave.hidden || $pickPlan.hidden;
    }
    async function checkSynced() {
      if (demoLocked()) return;
      try {
        const f = await getFeedLink();
        const now = Date.now();
        calSynced = Object.values(f.synced || {}).some((t) => now - Date.parse(t) < 14 * 864e5);
      } catch (_) { calSynced = false; }
      applySynced();
    }

    const $mycalMenu = document.getElementById('mycal-menu');
    let mycalItem = null, mycalSave = null, mycalBtn = null;
    function closeMycal() { $mycalMenu.hidden = true; mycalItem = null; mycalSave = null; mycalBtn = null; }
    /* Out to the right of its button, as wide as it, its foot level with the
       button's: as if it were the next button along (Dani, 18 Oct). Above it,
       when there isn't the room. */
    function placeMycal(b) {
      const r = b.getBoundingClientRect();
      $mycalMenu.style.minWidth = '0';
      $mycalMenu.style.width = Math.max(r.width, 190) + 'px';
      const m = $mycalMenu.getBoundingClientRect();
      if (r.right + 8 + m.width <= innerWidth - 12) {
        $mycalMenu.style.left = (r.right + 8) + 'px';
        $mycalMenu.style.top = Math.max(12, r.bottom - m.height) + 'px';
      } else {
        $mycalMenu.style.left = Math.max(12, Math.min(r.left, innerWidth - m.width - 12)) + 'px';
        $mycalMenu.style.top = Math.max(12, r.top - m.height - 8) + 'px';
      }
    }
    document.addEventListener('click', (e) => {
      const b = e.target.closest && e.target.closest('[data-mycal]');
      if (b) {
        if (!$mycalMenu.hidden && mycalBtn === b) { closeMycal(); return; }
        // Save & add: which calendar first, then it's saved and added.
        if (b.dataset.mycalSave) { mycalItem = null; mycalSave = b.dataset.mycalSave; }
        else {
          const id = b.id === 'post-mycal' ? openPostId : actEditing && actEditing.id;
          const it = items.find((i) => String(i.id) === String(id));
          if (!it) return;
          mycalItem = it; mycalSave = null;
        }
        mycalBtn = b;
        $mycalMenu.hidden = false;
        placeMycal(b);
        getFeedLink().catch(() => {});   // ready for the file, if they choose it
        return;
      }
      if (!$mycalMenu.hidden && !e.target.closest('#mycal-menu')) closeMycal();
    });
    $mycalMenu.addEventListener('click', async (e) => {
      const b = e.target.closest('[data-mycal-to]'); if (!b || (!mycalItem && !mycalSave)) return;
      const to = b.dataset.mycalTo, saving = mycalSave;
      let it = mycalItem;
      closeMycal();
      // A tab for Google or Outlook opened now, while it's still their click,
      // so the browser doesn't block it while the entry saves.
      const tab = (to === 'google' || to === 'outlookweb') ? window.open('', '_blank') : null;
      if (saving) {
        it = await (saving === 'act' ? saveAct() : savePick());
        if (!it) { if (tab) tab.close(); return; }
      }
      const go = (url) => { if (tab) tab.location.href = url; else window.open(url, '_blank', 'noopener'); };
      const w = entryWhen(it), t = entryText(it);
      if (to === 'google') {
        const dates = w.allDay ? `${w.ymd(w.date)}/${w.ymd(w.endDate)}` : `${w.ymd(w.date)}T${w.start.replace(':', '')}00/${w.ymd(w.date)}T${w.end.replace(':', '')}00`;
        const q = new URLSearchParams({ action: 'TEMPLATE', text: t.summary, dates, details: t.body, location: t.where, ctz: 'Europe/London' });
        go('https://calendar.google.com/calendar/render?' + q.toString());
        return;
      }
      if (to === 'outlookweb') {
        const q = new URLSearchParams({ path: '/calendar/action/compose', rru: 'addevent', subject: t.summary, body: t.body, location: t.where,
          startdt: w.allDay ? w.date : `${w.date}T${w.start}:00`, enddt: w.allDay ? w.endDate : `${w.date}T${w.end}:00`, allday: w.allDay ? 'true' : 'false' });
        go('https://outlook.office.com/calendar/0/deeplink/compose?' + q.toString());
        return;
      }
      // Apple and Outlook open a calendar file; on an iPhone it asks to add it.
      try { const f = await getFeedLink(); location.href = `${f.base}/${it.id}.ics`; }
      catch (err) { alert(err.message || "Couldn't make the calendar file just now."); }
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !$mycalMenu.hidden) { e.stopPropagation(); closeMycal(); } }, true);

    const $syncModal = document.getElementById('sync-modal');
    const $syncState = document.getElementById('sync-state');
    const $syncReady = document.getElementById('sync-ready');
    function fillSync(f) {
      const https = f.feed, webcal = https.replace(/^https?:/, 'webcal:');
      const name = encodeURIComponent('TMKE Marketing Planner');
      // Each link says which calendar it's for, so the Worker can tell which
      // ones are syncing.
      const tag = (u, app) => `${u}?app=${app}`;
      document.getElementById('sync-apple').href = tag(webcal, 'apple');
      document.getElementById('sync-outlook').href = `https://outlook.office.com/calendar/0/addfromweb?url=${encodeURIComponent(tag(https, 'outlook'))}&name=${name}`;
      document.getElementById('sync-outlookcom').href = `https://outlook.live.com/calendar/0/addfromweb?url=${encodeURIComponent(tag(https, 'outlookcom'))}&name=${name}`;
      document.getElementById('sync-google').href = `https://calendar.google.com/calendar/render?cid=${encodeURIComponent(tag(webcal, 'google'))}`;
      document.getElementById('sync-link').value = https;
      /* Synced: that calendar has checked the feed in the last week (Dani,
         16 Oct). Greyed, with a tag; still there to press, for another device. */
      const seen = f.synced || {};
      const week = 7 * 24 * 3600 * 1000;
      ['apple', 'outlook', 'outlookcom', 'google'].forEach((app) => {
        const el = document.getElementById('sync-' + app); if (!el) return;
        const at = Date.parse(seen[app] || '');
        const on = isFinite(at) && Date.now() - at < week;
        el.classList.toggle('is-synced', on);
        el.title = on ? 'Already syncing with your Marketing Planner.' : '';
      });
      $syncState.hidden = true; $syncReady.hidden = false;
    }
    async function openSync() {
      if (demoOn() && !isTrainingDemo()) { lock("Syncing is for members.", "Members put their whole Marketing Planner into their Apple, Outlook or Google calendar from here."); return; }
      else {
        $syncState.textContent = 'Getting your link…'; $syncState.hidden = false; $syncReady.hidden = true;
        getFeedLink().then(fillSync).catch((err) => { $syncState.textContent = err.message || "Couldn't get your link just now."; });
      }
      $syncModal.hidden = false;
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => $syncModal.classList.add('is-open'));
    }
    function closeSync() {
      $syncModal.classList.remove('is-open'); $syncModal.hidden = true;
      if ($dayModal.hidden) document.body.style.overflow = '';
    }
    document.getElementById('cal-sync')?.addEventListener('click', openSync);
    document.getElementById('sync-close')?.addEventListener('click', closeSync);
    $syncModal?.addEventListener('click', (e) => { if (e.target === $syncModal) closeSync(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !$syncModal.hidden) closeSync(); });
    document.getElementById('sync-copy')?.addEventListener('click', async (e) => {
      const b = e.currentTarget, v = document.getElementById('sync-link').value;
      try { await navigator.clipboard.writeText(v); } catch (_) { const i = document.getElementById('sync-link'); i.select(); document.execCommand('copy'); }
      b.textContent = 'Copied ✓'; setTimeout(() => { b.textContent = 'Copy link'; }, 1600);
    });
    document.getElementById('sync-reset')?.addEventListener('click', async () => {
      if (!confirm("Reset your link? Any calendar using the old one stops updating, and you'll need to subscribe again with the new one.")) return;
      $syncState.textContent = 'Making a new link…'; $syncState.hidden = false; $syncReady.hidden = true;
      try { fillSync(await getFeedLink(true)); $syncState.textContent = ''; }
      catch (err) { $syncState.textContent = err.message || "Couldn't reset your link just now."; }
    });

    $actClose?.addEventListener('click', closeAct);
    $actModal?.addEventListener('click', (e) => { if (e.target === $actModal) closeAct(); });
    $actChoose?.addEventListener('click', (e) => { const b = e.target.closest('[data-act]'); if (b) chooseAct(b.dataset.act); });
    $actForm?.addEventListener('click', (e) => {
      const b = e.target.closest('[data-act-log]'); if (!b || !actKey) return;
      const l = ((activityOf(actKey).book || {}).logs || [])[+b.dataset.actLog] || {};
      chooseAct(actKey, null, { log: true, shoot: l.shoot || null });
    });
    $actForm?.addEventListener('click', (e) => {
      const r = e.target.closest && e.target.closest('[data-post-route]'); if (!r) return;
      const date = actDate; closeAct();
      if (r.dataset.postRoute === 'upload') openPickUpload(date); else openPick(date);
    });
    $actBack?.addEventListener('click', () => {
      if (actEditing) closeAct();
      else if (actKey === 'social_post') closeAct();   // opened from Plan a post, not the list
      else if (actKey && (activityOf(actKey).book || actKey === 'content_planning') && !$actSave.hidden) chooseAct(actKey);   // the log form: back to book or log
      else openAct(actDate);
    });
    $actSave?.addEventListener('click', saveAct);

    /* Book now: the website's booking form, in member mode -- their details
       from their account, and member or external decided by the CRM's brands
       as well as their email (src/lib/videography-config.js). */
    async function hubMemberForBooking() {
      const { data } = await supabase.auth.getSession();
      const u = data && data.session && data.session.user;
      if (!u) return null;
      const meta = u.user_metadata || {};
      let brands = [];
      try { const m = await import('../../lib/pack-access.js'); brands = (await m.memberBrandsFor(supabase)) || []; } catch (_) {}
      const { audienceForMember } = await import('../../lib/videography-config.js');
      const audience = audienceForMember(u.email, brands);
      return {
        email: u.email, audience,
        name: meta.full_name || meta.name || '',
        phone: meta.phone || '',
        company: meta.company || (audience.audience === 'member' ? audience.label : '') || '',
      };
    }
    $actForm?.addEventListener('click', async (e) => {
      const b = e.target.closest('[data-book-service]'); if (!b) return;
      // The demo and the training window never book a real shoot.
      if (isTrainingDemo()) { actError("Training doesn't book anything. On your own Marketing Planner, this opens the booking form with your details already filled in.", true); return; }
      if (demoOn()) { lock("Booking is for members.", "Members book filming and photography from here, with their details already filled in."); return; }
      const member = await hubMemberForBooking();
      if (!member) { location.href = '/login?next=' + encodeURIComponent('/account/schedule'); return; }
      const date = actDate;
      closeAct();
      if (typeof window.tmkeVideographyBook === 'function') window.tmkeVideographyBook(b.dataset.bookService, { member, date });
    });
    // Booked: reload the window so it shows on its day straight away.
    window.addEventListener('tmke:videography-booked', async () => { loadedWindow = null; await loadWindow(); renderCalendar(); });
    $actDelete?.addEventListener('click', deleteAct);
    $actForm?.addEventListener('change', (e) => {
      const i = e.target.getAttribute && e.target.getAttribute('data-check-i');
      if (i != null) { actChecklist[+i].done = e.target.checked; drawChecklist(); }
    });
    $actForm?.addEventListener('click', (e) => {
      const del = e.target.closest('[data-check-del]');
      if (del) { actChecklist.splice(+del.dataset.checkDel, 1); drawChecklist(); return; }
      if (e.target.closest('[data-check-add]')) {
        const inp = $actForm.querySelector('[data-check-new]');
        const t = String(inp.value || '').trim();
        if (t) { actChecklist.push({ text: t, done: false }); inp.value = ''; drawChecklist(); inp.focus(); }
      }
    });
    $actForm?.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && e.target.matches('[data-check-new]')) { e.preventDefault(); $actForm.querySelector('[data-check-add]').click(); }
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && $actModal && !$actModal.hidden) closeAct(); });

    // Refresh the day modal beneath (it's static once rendered).
    function refreshDayUnder() {
      if (openDayDate && !$dayModal.hidden) openDay(openDayDate);
    }

    async function savePost() {
      if (demoOn() && !isTrainingDemo()) { lock("Adding to the planner is for members.", "In the demo you can open any day and see how planning works. Members add posts, ideas and key dates here."); return; }
      if (!openPostId) return;
      clearPostError();
      const title   = ($postTitle.value || '').trim();
      const dateStr = $postDate.value;
      const timeStr = $postTime.value || '09:00';
      const caption = ($postCaption.value || '').trim();
      const wantsReminder = !!$postRemind.checked;
      if (!title)   return showPostError('Give the post a short title.');
      if (!dateStr) return showPostError('Pick a date for the post.');

      const acct = await plannerStore();
      if (!acct) return showPostError("You're signed out — sign in again.");
      if (acct.blocked) return showPostError(acct.reason);
      $postSave.disabled = true; $postSave.textContent = 'Saving…';
      const patch = { title, scheduled_date: dateStr, scheduled_time: timeStr, caption: caption || null, reminder: wantsReminder };
      let { error } = await acct.db.from(acct.table).update(patch).eq('id', openPostId);
      if (error && /reminder/i.test(error.message || '') && /column/i.test(error.message || '')) {
        // reminder column not migrated yet — persist everything else.
        const { reminder, ...rest } = patch;
        ({ error } = await acct.db.from(acct.table).update(rest).eq('id', openPostId));
      }
      if (error) {
        $postSave.disabled = false; $postSave.textContent = 'Save changes';
        return showPostError(error.message || "Couldn't save your changes.");
      }
      const p = items.find((i) => String(i.id) === String(openPostId));
      if (p) Object.assign(p, patch);
      renderCalendar();
      $postSave.textContent = 'Saved ✓';
      showPostError('Changes saved.', true);
      setTimeout(() => { closePost(); refreshDayUnder(); }, 700);
    }

    async function emailPostNow() {
      if (!openPostId) return;
      clearPostError();
      const p = items.find((i) => String(i.id) === String(openPostId));
      if (!p) return;
      const asset = p.asset_url || p.thumbnail_url || '';
      const pd = p.details || {};
      const hasFiles = (Array.isArray(pd.files) && pd.files.length) || (Array.isArray(pd.links) && pd.links.length);
      if (!asset && !hasFiles) return showPostError('This post has no image to send.');
      if (!API_BASE) return showPostError("Email isn't available here (PUBLIC_R2_WORKER_URL not set).");
      const acct = await plannerStore();
      if (!acct)  return showPostError("You're signed out — sign in again.");
      if (acct.blocked) return showPostError(acct.reason);

      $postEmail.disabled = true; $postEmail.textContent = 'Sending…';
      try {
        const res = await fetch(`${API_BASE}/calendar/send-now`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${acct.token}` },
          body: JSON.stringify({
            asset_url: asset,
            caption: ($postCaption.value || '').trim(),
            title: ($postTitle.value || '').trim(),
            platform: p.platform_hint || 'instagram',
            files: (Array.isArray(pd.files) ? pd.files : []).map((x) => ({ name: x.name, url: x.url })),
            links: Array.isArray(pd.links) ? pd.links : [],
          }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || !out.ok) throw new Error(out.error || "Couldn't send the email.");
        $postEmail.textContent = 'Sent ✓';
        showPostError(`Sent to ${out.to || 'your inbox'} — check your phone.`, true);
        setTimeout(() => { $postEmail.disabled = false; $postEmail.textContent = 'Email it to me now'; clearPostError(); }, 4000);
      } catch (err) {
        showPostError(err.message || "Couldn't email that post.");
        $postEmail.disabled = false; $postEmail.textContent = 'Email it to me now';
      }
    }

    /* Put back something just removed (Undo): the same row, id and all, so a
       content plan still finds its post. */
    async function restoreEntry(row) {
      const acct = await plannerStore();
      if (!acct || acct.blocked) throw new Error("You're signed out, so it couldn't be put back.");
      const { booking, __cont, ...clean } = row;
      const { data, error } = await acct.db.from(acct.table).insert(clean).select('*').single();
      if (error) throw new Error("Couldn't put it back. Try again.");
      items = items.filter((i) => String(i.id) !== String(data.id)).concat(data);
      renderCalendar(); refreshDayUnder();
    }

    // Removed at once, with Undo for ten seconds (Dani, 18 Oct), not a
    // question first that nobody reads.
    async function removePost() {
      if (!openPostId) return;
      const was = items.find((i) => String(i.id) === String(openPostId));
      clearPostError();
      $postDelete.disabled = true; $postDelete.textContent = 'Removing…';
      const acct = await plannerStore();
      if (!acct || acct.blocked) { $postDelete.disabled = false; $postDelete.textContent = 'Remove'; return showPostError(acct ? acct.reason : "You're signed out — sign in again."); }
      const { error } = await acct.db.from(acct.table).delete().eq('id', openPostId);
      if (error) {
        $postDelete.disabled = false; $postDelete.textContent = 'Remove';
        return showPostError(error.message || "Couldn't remove that post.");
      }
      items = items.filter((i) => String(i.id) !== String(openPostId));
      renderCalendar();
      closePost();
      refreshDayUnder();
      if (was) undoToast(`“${was.title || 'Post'}” removed from your calendar.`, () => restoreEntry(was));
    }

    // ====== Data loaders ======
    // Pull a 3-month window so prev/next feels instant. We re-fetch
    // whenever the user navigates outside the loaded window.
    let loadedWindow = null; // { fromYmd, toYmd }
    // getSession() is local-only - a cleared/revoked session can still look
    // valid to it. Confirmed once with the server (getUser()) per page load -
    // not on every loadWindow() call, since that also runs on plain month
    // navigation and shouldn't add a network round-trip each time.
    let sessionConfirmed = false;
    async function loadWindow() {
      const winStart = addMonths(viewMonth, -1);
      const winEnd   = addMonths(viewMonth,  2);  // exclusive
      const fromYmd  = ymd(winStart);
      const toYmd    = ymd(new Date(winEnd.getFullYear(), winEnd.getMonth(), 0)); // last day of viewMonth+1

      const { data: { session } } = await supabase.auth.getSession();
      // The demo has no session but still gets the month: the prompts on
      // their days and the holidays, with nothing of anyone's on it.
      if (!session && !demoOn()) {
        if (!import.meta.env.DEV) location.replace('/login?next=' + encodeURIComponent('/account/schedule'));
        return;
      }
      if (session && !sessionConfirmed && !import.meta.env.DEV) {
        const { data: { user }, error } = await supabase.auth.getUser();
        if (!user || error) { location.replace('/login?next=' + encodeURIComponent('/account/schedule')); return; }
      }
      sessionConfirmed = true;
      $footerEmail.textContent = session ? (session.user.email ?? '') : 'The demo';

      /* Posts from the account's own Planner: a member's, or the training
         account's (Dani's login). Nobody's at all for the public demo. */
      const acct = await plannerStore();
      const postsQuery = () => (acct && !acct.blocked)
        ? acct.db.from(acct.table).select('*').eq('user_id', acct.uid)
        : supabase.from('calendar_items').select('*');
      /* Anything that touches the window: an entry on a day in it, or a run
         (a campaign, paid ads) that started earlier and is still going. A
         database without end_date yet (supabase/calendar_activities.sql not
         run) falls back to the days in the window. */
      const ranged = async () => {
        let r = await postsQuery()
          .lte('scheduled_date', toYmd)
          .or(`scheduled_date.gte.${fromYmd},end_date.gte.${fromYmd}`)
          .order('scheduled_date', { ascending: true })
          .order('scheduled_time', { ascending: true });
        if (r.error && /end_date/i.test(r.error.message || '')) {
          r = await postsQuery().gte('scheduled_date', fromYmd).lte('scheduled_date', toYmd)
            .order('scheduled_date', { ascending: true }).order('scheduled_time', { ascending: true });
        }
        return r;
      };
      const [itemsRes, holsRes] = await Promise.all([
        ranged(),
        supabase.from('uk_holidays')
          .select('date, name, kind, country')
          .gte('date', fromYmd)
          .lte('date', toYmd)
          .order('date', { ascending: true }),
      ]);

      // If the calendar table hasn't been migrated yet (or RLS denies),
      // surface a friendly hint rather than a silent empty grid.
      if (itemsRes.error && /relation .* does not exist/i.test(itemsRes.error.message || '')) {
        $state.hidden = false;
        $state.textContent = "Calendar table not found — run supabase/calendar.sql in the Supabase SQL editor to enable scheduling.";
        items = [];
      } else {
        items = itemsRes.data || [];
        $state.hidden = true;
      }
      /* TMKE photography and filming you've booked with us appear as Property
         Marketing on their day, read from Bookings, so nothing is entered
         twice. A member's own only; not the training account or the demo. */
      if (session && acct && !acct.training) {
        try {
          const email = session.user.email || '';
          const { data: shoots } = await supabase.from('videography_bookings')
            .select('id, service, service_type, shoot_date, stage, postcode, kind')
            .or(`account_user_id.eq.${session.user.id},client_email.ilike.${email}`)
            .gte('shoot_date', fromYmd + 'T00:00:00').lte('shoot_date', toYmd + 'T23:59:59');
          (shoots || []).forEach((b) => {
            if (!b.shoot_date || b.stage === 'cancelled' || b.kind === 'discovery') return;
            const when = new Date(b.shoot_date);
            items.push({
              id: 'booking-' + b.id, booking: true,
              // A studio session or a filming day is its own activity; any other shoot is the property's.
              activity: /studio/i.test(String(b.service_type || b.service)) ? 'content_studio'
                : /agent/i.test(String(b.service_type || b.service)) ? 'agent_filming' : 'property_shoot',
              title: (b.service || 'TMKE shoot') + (b.postcode ? ' · ' + b.postcode : ''),
              scheduled_date: ymd(when), scheduled_time: when.toTimeString().slice(0, 5), has_time: true,
              details: { address: bookingLocation(b) }, checklist: [], status: 'scheduled',
            });
          });
        } catch (_) { /* the calendar is fine without them */ }
      }

      // Holidays — fall back silently to a small stub so the demo still
      // looks alive if the table isn't seeded. The seed lives in the
      // same SQL file, so once that runs this fallback is never hit.
      if (holsRes.error || !(holsRes.data || []).length) {
        holidays = stubHolidaysForWindow(fromYmd, toYmd);
      } else {
        holidays = holsRes.data;
      }

      // Content prompts for the same window. They come from the same table the
      // dashboard and the Studio read, so a day edited in the admin centre
      // shows here too.
      try {
        const P = await loadPrompts(supabase);
        const from = new Date(fromYmd + 'T00:00:00');
        const to = new Date(toYmd + 'T00:00:00');
        // upcomingFrom rolls into next year, so ask for plenty and cut to the
        // window rather than assuming a count.
        prompts = upcomingFrom(P.days, from, 200)
          .filter((d) => d.when <= to)
          .map((d) => ({ ...d, date: ymd(d.when) }));
      } catch (_) { prompts = []; }

      loadedWindow = { fromYmd, toYmd };
    }

    // Tiny holiday stub so the page still demos before the seed has been
    // applied. Returns whichever of these fall inside the loaded window.
    function stubHolidaysForWindow(fromYmd, toYmd) {
      const all = [
        { date: '2026-05-04', name: 'Early May bank holiday', kind: 'bank',      country: 'england-and-wales' },
        { date: '2026-05-25', name: 'Spring bank holiday',    kind: 'bank',      country: 'england-and-wales' },
        { date: '2026-06-21', name: "Father's Day (UK)",     kind: 'awareness', country: 'uk' },
        { date: '2026-08-31', name: 'Summer bank holiday',    kind: 'bank',      country: 'england-and-wales' },
        { date: '2026-10-31', name: 'Halloween',              kind: 'awareness', country: 'uk' },
        { date: '2026-11-05', name: 'Bonfire Night',          kind: 'awareness', country: 'uk' },
        { date: '2026-11-27', name: 'Black Friday',           kind: 'awareness', country: 'uk' },
        { date: '2026-12-25', name: 'Christmas Day',          kind: 'bank',      country: 'england-and-wales' },
      ];
      return all.filter((h) => h.date >= fromYmd && h.date <= toYmd);
    }

    // ====== Event wiring ======
    $prev?.addEventListener('click', async () => {
      viewMonth = addMonths(viewMonth, -1);
      await ensureWindow();
      renderCalendar();
    });
    $next?.addEventListener('click', async () => {
      viewMonth = addMonths(viewMonth, 1);
      await ensureWindow();
      renderCalendar();
    });
    $today?.addEventListener('click', async () => {
      viewMonth = startOfMonth(new Date());
      await ensureWindow();
      renderCalendar();
    });
    $grid?.addEventListener('click', (e) => {
      const cell = e.target.closest('.cal-day');
      if (!cell) return;
      // "3 posts" in the Marketing Planner opens the Content Calendar.
      if (e.target.closest('[data-to-posts]')) { setCalView('posts'); return; }
      // Nothing to plan on a day that's gone; an empty one does nothing.
      if (cell.classList.contains('is-past') && cell.classList.contains('is-empty')) return;
      openDay(cell.getAttribute('data-date'));
    });
    $dayClose?.addEventListener('click', closeDay);
    $dayModal?.addEventListener('click', (e) => { if (e.target === $dayModal) closeDay(); });

    // Click (or keyboard) a planned post in the day list to open its detail.
    $dayBody?.addEventListener('click', (e) => {
      const item = e.target.closest('.day-item');
      if (!item || !item.dataset.id) return;
      // A content planning session opens its plan; Edit session, the session.
      if (item.dataset.planMonth && !e.target.closest('[data-edit-entry]')) { location.href = planUrl(item.dataset.planMonth); return; }
      openEntry(item.dataset.id);
    });
    $dayBody?.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter' && e.key !== ' ') return;
      const item = e.target.closest('.day-item');
      if (item && item.dataset.id) { e.preventDefault(); openEntry(item.dataset.id); }
    });

    // Post detail modal wiring.
    $postClose?.addEventListener('click', closePost);
    $postModal?.addEventListener('click', (e) => { if (e.target === $postModal) closePost(); });
    $postSave?.addEventListener('click', savePost);
    $postEmail?.addEventListener('click', emailPostNow);
    $postDelete?.addEventListener('click', removePost);

    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (!$postModal.hidden) { closePost(); return; }   // post modal is on top
      if (!$dayModal.hidden) closeDay();
    });

    async function ensureWindow() {
      // Reload only if the new viewMonth is outside the cached window
      // (with 1-month buffer on each side).
      if (!loadedWindow) { await loadWindow(); return; }
      const monthYmd = ymd(viewMonth);
      if (monthYmd < loadedWindow.fromYmd || monthYmd > loadedWindow.toYmd) {
        await loadWindow();
      }
    }

    // ====== Sign-out (shared with other workspace pages) ======
    async function signOut() {
      await signOutEverywhere();
    }
    document.getElementById('app-signout')?.addEventListener('click', signOut);
    document.getElementById('app-signout-foot')?.addEventListener('click', signOut);

    // AI caption → drop the result straight into the post's caption box.
    document.getElementById('pick-ai-caption')?.addEventListener('click', (e) => {
      e.preventDefault();
      const box = document.getElementById('pick-caption');
      window.tmkeCaption?.open({
        output: 'use',
        topic: (pickChosen && pickChosen.canvas && pickChosen.canvas.captionPrompt) || '',
        onUse: (text) => { box.value = text; box.dispatchEvent(new Event('input', { bubbles: true })); },
      });
    });
    document.getElementById('post-ai-caption')?.addEventListener('click', () => {
      window.tmkeCaption?.open({
        output: 'use',
        onUse: (text) => {
          $postCaption.value = text;
          $postCaption.dispatchEvent(new Event('input', { bubbles: true }));
        },
      });
    });

    // ====== Bootstrap ======
    /* The page does not show until the month is drawn: dates, month name,
       posts and all (Dani, 14 Oct: "it's coming in without the dates and the
       months, and then it's flashing up once it's loaded"). */
    const releaseEntrance = window.__tmkeEnterHold ? window.__tmkeEnterHold() : null;
    (async () => {
      try {
        await loadWindow();
        renderCalendar();
        checkSynced();
      } finally {
        requestAnimationFrame(() => { document.body.classList.add('is-loaded'); releaseEntrance && releaseEntrance(); });
      }
    })();
  </script>

  <NewDesignModal />
  <!-- The website's own booking form, opened by Book now in Add activity
       (member mode: their details known, member or external from the CRM). -->
  <VideographyBooking />
  <CaptionGenerator />
</BaseLayout>
