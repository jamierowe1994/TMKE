    /* Planned posts are clickable — nudge on hover to signal it. */
    .day-item { cursor: pointer; transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s; }
    .day-item:hover {
      transform: translateY(-1px);
      border-color: rgba(var(--violet-rgb), 0.3);
