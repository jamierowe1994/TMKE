---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import HubFootBar from "../../components/account/HubFootBar.astro";
import CaptionGenerator from "../../components/CaptionGenerator.astro";
import "../../styles/workspace.css";
import "../../styles/ws-system.css";
import NewDesignModal from "../../components/account/NewDesignModal.astro";
import VideographyBooking from "../../components/VideographyBooking.astro";
import "../../styles/account-sections.css";
---

<BaseLayout
  dashboard
  title="Marketing Planner — TMKE workspace"
  description="Plan and schedule your social posts. A month-by-month diary of what's going out, with UK holidays and awareness days baked in."
  hideNav
  hideFooter
>
  <div class="ws">
  <WorkspaceHeader active="planner" />
  <main class="ws-main">
    <div class="ws-left">
    <section class="ws-hero ws-hero--sub cal-hero">
      <div class="ws-hero-copy">
        <p class="ws-hero-date"><a href="/account" class="back-link">&larr; Workspace</a></p>
        <h1 class="ws-greeting">Your Marketing Planner.</h1>
        <p class="ws-hero-sub">Plan all of your marketing, from campaigns and print to events and follow-ups, on the day it happens.</p>
        <div class="ws-hero-cta cal-hero-cta">
          <button type="button" class="ws-btn ws-btn--primary" data-new-design>Create new design
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </button>
          <button type="button" class="ws-btn ws-btn--ghost" id="cal-sync">Sync to my calendar</button>
        </div>
        <!-- The dashboard's three boxes, following the view (Dani, 18 Oct).
             Marketing Planner: activities coming up, posts coming up (to the
             Content Calendar), and the next activity and when. Content
             Calendar: the month's content plan (view it, or create it), posts
             coming up, and the next post and when. Filled by paintBrief();
             empty, never sample figures, until it knows. -->
        <ul class="ws-brief cal-brief" aria-live="polite">
          <li><a class="ws-brief-slot" id="cb-1" href="#">
            <span class="ws-brief-ic ws-brief-ic--sched" id="cb-1-ic"></span>
            <span class="ws-brief-tx"><strong id="cb-1-h">&nbsp;</strong><span id="cb-1-s">&nbsp;</span></span>
          </a></li>
          <li><a class="ws-brief-slot" id="cb-2" href="#">
            <span class="ws-brief-ic ws-brief-ic--time" id="cb-2-ic"></span>
            <span class="ws-brief-tx"><strong id="cb-2-h">&nbsp;</strong><span id="cb-2-s">&nbsp;</span></span>
          </a></li>
          <li><a class="ws-brief-slot" id="cb-next-link">
            <span class="ws-brief-ic ws-brief-ic--due"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <span class="ws-brief-tx"><strong id="cb-next">&nbsp;</strong><span id="cb-next-when">next up</span></span>
          </a></li>
        </ul>
      </div>
    </section>

    <!-- Calendar shell -->
    <section class="ws-block cal" aria-labelledby="cal-title" data-cal-view="all">
      <header class="ws-block-head cal-strip">
        <h2 class="ws-block-h" id="cal-title"><span class="ws-block-ch">Chapter 01</span><span class="cal-month">—</span></h2>
        <div class="cal-strip-nav">
          <!-- Two views (Dani, 18 Oct): the Marketing Planner, which is all of it
               and never hides anything planned, and the Content Calendar, which
               is what they post -- posts, post ideas and key dates. Remembered
               in this browser. The Content Calendar is where TMKE's monthly
               templates will sit for subscribers later; nothing of that is
               built yet. -->
          <div class="cal-view" role="group" aria-label="Show">
            <button type="button" class="cal-nav cal-view-btn" data-view="all" aria-pressed="true" title="Everything you've planned">Marketing Planner</button>
            <button type="button" class="cal-nav cal-view-btn" data-view="posts" aria-pressed="false" title="Your posts, post ideas and key dates">Content Calendar</button>
          </div>
          <button type="button" class="cal-nav" id="cal-prev" aria-label="Previous month">&larr;</button>
          <button type="button" class="cal-nav cal-today" id="cal-today" title="Back to this month">Month</button>
          <button type="button" class="cal-nav" id="cal-next" aria-label="Next month">&rarr;</button>
        </div>
      </header>

      <!-- The key: the five kinds of marketing activity, then what the
           calendar marks for you. -->
      <div class="cal-legend" aria-hidden="true">
        <span class="cal-leg cal-leg--post" data-in="posts">Social post</span>
        <span class="cal-leg cal-leg--content" data-in="activity">Content &amp; Social</span>
        <span class="cal-leg cal-leg--print" data-in="activity">Print &amp; Canvassing</span>
        <span class="cal-leg cal-leg--business" data-in="activity">Business &amp; Community</span>
        <span class="cal-leg cal-leg--property" data-in="activity">Property Marketing</span>
        <span class="cal-leg cal-leg--campaigns" data-in="activity">Campaigns</span>
        <span class="cal-leg cal-leg--other" data-in="activity">Something Else</span>
        <span class="cal-leg cal-leg--todo" data-in="posts">Post to design</span>
        <span class="cal-leg cal-leg--prompt" data-in="posts">Idea ready</span>
        <span class="cal-leg cal-leg--date">Key date</span>
      </div>

      <div class="cal-weekhead" aria-hidden="true">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
      </div>

      <div id="cal-grid" class="cal-grid" role="grid" aria-labelledby="cal-title">
        <!-- Day cells injected by JS -->
      </div>

      <p id="cal-state" class="cal-state" hidden></p>

      <!-- The month's posts (Content Calendar subscription, Dani 27 Oct):
           TMKE's post for each weekday, full size in its day. Shown on the
           Content Calendar when a published month can be read; for now only
           staff can read one (the database decides, not this page), so for
           members none of this ever appears. It sits over the member's own
           calendar, and the tab on the edge swaps between the two. -->
      <div class="cc-ours" id="cc-ours" hidden>
        <div class="cc-ours-head">
          <p class="cc-ours-line"><strong id="cc-ours-name"></strong> <span id="cc-ours-sub">One for each weekday. Click a post to see it full size.</span></p>
          <label class="cc-ours-ed" id="cc-ours-ed" hidden>Edition
            <select id="cc-ours-ed-sel"></select>
          </label>
        </div>
        <div class="cal-weekhead" aria-hidden="true">
          <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
        </div>
        <div class="cc-grid" id="cc-grid"></div>
      </div>
      <button type="button" class="cc-tab" id="cc-tab" hidden></button>
    </section>

    </div><!-- /.ws-left -->

    <HubFootBar emailSlot />
    </main>
  </div>

  <!-- Day drawer — slides in from the right when a day cell is clicked.
       Shows all scheduled items + holidays for that date, with quick
       actions (open, edit, mark as posted, cancel) on each item. -->
  <div class="day-backdrop" id="day-modal" hidden role="dialog" aria-modal="true" aria-labelledby="day-h">
    <aside class="day-panel" aria-label="Day detail">
      <header class="day-head">
        <div>
          <p class="day-eyebrow" id="day-eyebrow">—</p>
          <h2 id="day-h" class="day-h">—</h2>
        </div>
        <button type="button" class="day-close" id="day-close" aria-label="Close">&times;</button>
      </header>
      <div class="day-body" id="day-body">
        <!-- Filled in by JS -->
      </div>
      <footer class="day-foot">
        <!-- Two ways in. Plan one you've already made, without leaving the
             calendar; or start a new design for this day. -->
        <!-- Three ways in: any marketing activity; the shortcut to plan one of
             your saved designs as a post; or a new design for this day. -->
        <button type="button" id="day-plan" class="day-new-btn">+ Add activity to this day</button>
        <button type="button" id="day-pick" class="day-new-btn day-new-btn--ghost">Plan a post for this day</button>
        <a href="#" id="day-new" class="day-new-btn day-new-btn--ghost">Create a post for this day</a>
      </footer>
    </aside>
  </div>

  <!-- One of the month's posts, full size: what it is, how to edit it, the
       example caption, and Use This Template into the Studio. -->
  <div class="ccp" id="ccp" hidden>
    <div class="ccp-card ws" role="dialog" aria-modal="true" aria-labelledby="ccp-h">
      <div class="ccp-pic"><img id="ccp-img" alt=""></div>
      <div class="ccp-meta">
        <button type="button" class="ccp-x" id="ccp-x" aria-label="Close">&times;</button>
        <p class="ccp-k" id="ccp-k"></p>
        <h3 class="ccp-h" id="ccp-h"></h3>
        <div class="ccp-facts">
          <span id="ccp-d"></span>
          <span class="ccp-chip" id="ccp-p" hidden></span>
          <span class="ccp-chip" id="ccp-type" hidden></span>
          <span class="ccp-chip ccp-chip--tied" id="ccp-t" hidden></span>
        </div>
        <div class="ccp-scroll">
          <div class="ccp-part" id="ccp-howto-wrap" hidden><p class="ccp-ph">How to edit</p><p class="ccp-tx" id="ccp-howto"></p></div>
          <div class="ccp-part" id="ccp-cap-wrap" hidden><p class="ccp-ph">Caption</p><p class="ccp-tx" id="ccp-cap"></p></div>
          <div class="ccp-part" id="ccp-reel-wrap" hidden><p class="ccp-ph">For the Reel</p><p class="ccp-tx" id="ccp-reel"></p></div>
        </div>
        <a class="ws-btn ws-btn--primary ccp-use" id="ccp-use" href="#">Use This Template</a>
      </div>
    </div>
  </div>

  <!-- Planned-post detail: click a post in the day view to open it here.
       Mirrors what was set in the editor's plan modal — title, date/time,
       caption, reminder — so it can be reviewed and edited after planning,
       or emailed over on demand. -->
  <div class="day-backdrop" id="post-modal" hidden role="dialog" aria-modal="true" aria-labelledby="post-h">
    <aside class="day-panel post-panel" aria-label="Planned post">
      <header class="day-head">
        <div>
          <p class="day-eyebrow" id="post-eyebrow">Planned post</p>
          <h2 id="post-h" class="day-h">Your post</h2>
        </div>
        <button type="button" class="day-close" id="post-close" aria-label="Close">&times;</button>
      </header>
      <div class="day-body post-body">
        <figure class="post-preview"><img id="post-img" alt="Your post design" /></figure>
        <div class="act-files-list post-files" id="post-files" style="--cat: var(--violet-deep)"></div>
        <a class="post-plan" id="post-plan" href="/account/content-plan" hidden>Make it from your content plan &rarr;</a>
        <div class="post-fields">
          <label class="post-field">
            <span class="post-label">Title</span>
            <input type="text" id="post-title" class="post-input" placeholder="Post title" />
          </label>
          <div class="post-row">
            <label class="post-field">
              <span class="post-label">Date</span>
              <input type="date" id="post-date" class="post-input" />
            </label>
            <label class="post-field">
              <span class="post-label">Time</span>
              <input type="text" readonly data-time id="post-time" class="post-input" placeholder="Choose a time" />
            </label>
          </div>
          <p class="post-plat" id="post-plat">Instagram</p>
          <label class="post-field">
            <span class="post-label post-label--row">Caption
              <button type="button" class="post-ai" id="post-ai-caption"><span aria-hidden="true">✨</span> Generate with AI</button>
            </span>
            <textarea id="post-caption" class="post-textarea" rows="5" placeholder="Write your caption… or generate one with AI"></textarea>
          </label>
          <label class="post-remind">
            <input type="checkbox" id="post-remind" />
            <span>Remind me on the day <span class="post-remind-note">— we'll email the caption &amp; image at 8am on the morning of this post</span></span>
          </label>
          <div class="post-error" id="post-error" hidden></div>
        </div>
      </div>
      <footer class="day-foot post-foot">
        <button type="button" class="post-btn post-btn--danger" id="post-delete">Remove</button>
        <button type="button" class="post-btn post-btn--ghost" id="post-email">Email it to me now</button>
        <button type="button" class="post-btn post-btn--ghost" id="post-mycal" data-mycal>Add to my calendar</button>
        <button type="button" class="post-btn post-btn--primary" id="post-save">Save changes</button>
      </footer>
    </aside>
  </div>

  <!-- Add to this day: choose the marketing activity, then fill in what it
       needs (src/data/marketing-activities.js). A social post goes on to the
       design library below; everything else is this one form. -->
  <div class="day-backdrop" id="act-modal" hidden role="dialog" aria-modal="true" aria-labelledby="act-h">
    <aside class="pick-panel act-panel" aria-label="Add to this day">
      <header class="day-head">
        <div>
          <p class="day-eyebrow" id="act-eyebrow">Add to this day</p>
          <h2 id="act-h" class="day-h">What are you planning?</h2>
          <p class="act-line" id="act-line" hidden></p>
        </div>
        <button type="button" class="day-close" id="act-close" aria-label="Close">&times;</button>
      </header>
      <div class="pick-body act-choose" id="act-choose"></div>
      <div class="pick-body act-form" id="act-form" hidden></div>
      <footer class="day-foot post-foot act-foot" id="act-foot" hidden>
        <button type="button" class="post-btn post-btn--danger" id="act-delete" hidden>Remove</button>
        <button type="button" class="post-btn post-btn--ghost" id="act-back">Back</button>
        <button type="button" class="post-btn post-btn--ghost" id="act-mycal" data-mycal hidden>Add to my calendar</button>
        <!-- Not synced: save it and put it in their own calendar in one go
             (Dani, 18 Oct). Synced, their calendar takes it by itself. -->
        <button type="button" class="post-btn post-btn--ghost" id="act-save-cal" data-mycal data-mycal-save="act" hidden>Save &amp; add to my calendar</button>
        <button type="button" class="post-btn post-btn--primary" id="act-save">Save</button>
      </footer>
    </aside>
  </div>

  <!-- One entry into their own calendar: a copy, added now. -->
  <div class="mycal-menu" id="mycal-menu" hidden role="menu" aria-label="Add to my calendar">
    <button type="button" role="menuitem" data-mycal-to="file">Apple Calendar or iPhone</button>
    <button type="button" role="menuitem" data-mycal-to="file">Outlook</button>
    <button type="button" role="menuitem" data-mycal-to="outlookweb">Outlook on the web</button>
    <button type="button" role="menuitem" data-mycal-to="google">Google Calendar</button>
  </div>

  <!-- Sync: their whole Marketing Calendar in their own calendar, subscribed
       once and kept up to date (the Worker's /calendar/feed). -->
  <div class="day-backdrop" id="sync-modal" hidden role="dialog" aria-modal="true" aria-labelledby="sync-h">
    <aside class="pick-panel act-panel sync-panel" aria-label="Sync to my calendar">
      <header class="day-head">
        <div>
          <p class="day-eyebrow">Stay updated</p>
          <h2 id="sync-h" class="day-h">Sync to My Calendar</h2>
          <p class="act-line">Subscribe once and everything on your Marketing Planner appears in your own calendar.<br class="sync-br" /> Add, move or remove something here and your calendar follows.</p>
        </div>
        <button type="button" class="day-close" id="sync-close" aria-label="Close">&times;</button>
      </header>
      <div class="pick-body sync-body">
        <p class="sync-state" id="sync-state">Getting your link&hellip;</p>
        <div class="sync-ready" id="sync-ready" hidden>
          <p class="post-label">Choose your calendar</p>
          <div class="sync-apps">
            <a class="sync-app" id="sync-apple" href="#"><strong>Apple Calendar or iPhone<em class="sync-tag">Synced</em></strong><span>Opens Calendar and asks to subscribe.</span></a>
            <a class="sync-app" id="sync-outlook" href="#" target="_blank" rel="noopener"><strong>Outlook<em class="sync-tag">Synced</em></strong><span>Work or school account.</span></a>
            <a class="sync-app" id="sync-outlookcom" href="#" target="_blank" rel="noopener"><strong>Outlook.com<em class="sync-tag">Synced</em></strong><span>A personal Outlook, Hotmail or Live account.</span></a>
            <a class="sync-app" id="sync-google" href="#" target="_blank" rel="noopener"><strong>Google Calendar<em class="sync-tag">Synced</em></strong><span>Opens Google Calendar and asks to add it.</span></a>
          </div>
          <p class="post-label">Another calendar</p>
          <div class="sync-copy">
            <input type="text" id="sync-link" class="post-input" readonly aria-label="Your calendar link" />
            <button type="button" class="post-btn post-btn--ghost" id="sync-copy">Copy link</button>
          </div>
          <p class="sync-note">Paste it wherever your calendar says &ldquo;subscribe&rdquo; or &ldquo;add from the web&rdquo;.</p>
          <p class="sync-note">Changes don&rsquo;t appear instantly: each calendar app checks the link on its own schedule, from about an hour to a day. For something you need there straight away, open the entry and choose <strong>Add to my calendar</strong>.</p>
          <p class="sync-note">This link is private to you: anyone who has it can see your calendar. <button type="button" class="sync-reset" id="sync-reset">Reset the link</button> if it&rsquo;s been shared by mistake.</p>
        </div>
      </div>
    </aside>
  </div>

  <!-- Plan a post: your design library, over the calendar. Pick one and the
       planning steps follow in the same pop-out - the design isn't opened, and
       the calendar is never left. -->
  <div class="day-backdrop" id="pick-modal" hidden role="dialog" aria-modal="true" aria-labelledby="pick-h">
    <aside class="pick-panel" aria-label="Plan a post">
      <header class="day-head">
        <div>
          <p class="day-eyebrow" id="pick-eyebrow">Plan a post</p>
          <h2 id="pick-h" class="day-h">Choose a design</h2>
        </div>
        <button type="button" class="day-close" id="pick-close" aria-label="Close">&times;</button>
      </header>

      <!-- Step one: the library. -->
      <div class="pick-body" id="pick-step-designs">
        <p class="pick-note" id="pick-note">Loading your designs…</p>
        <div class="pick-grid" id="pick-grid"></div>
      </div>

      <!-- Or: a post made elsewhere, uploaded or linked (Dani, 16 Oct). -->
      <div class="pick-body" id="pick-step-upload" hidden>
        <p class="pick-note">Upload the post you've made, as a PNG, JPEG or PDF: one file or several. Or add a link to it.</p>
        <label class="pick-drop" id="pick-drop">
          <input type="file" id="pick-files" accept=".png,.jpg,.jpeg,.pdf,image/png,image/jpeg,application/pdf" multiple hidden />
          <strong>Choose files</strong><span>or drop them here</span>
        </label>
        <div class="act-files-list pick-up-list" id="pick-up-list"></div>
        <div class="act-files-add">
          <input type="text" inputmode="url" spellcheck="false" class="post-input" id="pick-up-url" placeholder="Or paste a link, e.g. to your Canva design" />
          <button type="button" class="act-files-btn" id="pick-up-link">Add link</button>
        </div>
        <div class="post-error" id="pick-up-error" hidden></div>
      </div>

      <!-- Step two: the same details the editor asks for. -->
      <div class="pick-body pick-body--plan" id="pick-step-plan" hidden>
        <figure class="pick-chosen">
          <img id="pick-chosen-img" alt="" />
          <span class="pick-file-tile" id="pick-file-tile">PDF</span>
          <figcaption id="pick-chosen-name">Your design</figcaption>
          <button type="button" class="pick-back" id="pick-back">Choose another</button>
        </figure>
        <div class="post-fields">
          <label class="post-field">
            <span class="post-label">Title</span>
            <input type="text" id="pick-title" class="post-input" placeholder="Mid-week new build reveal" maxlength="120" />
          </label>
          <div class="post-row">
            <label class="post-field">
              <span class="post-label">Date</span>
              <input type="date" id="pick-date" class="post-input" />
            </label>
            <label class="post-field">
              <span class="post-label">Reminder time</span>
              <input type="text" readonly data-time id="pick-time" class="post-input" value="09:00" placeholder="Choose a time" />
            </label>
          </div>
          <label class="post-field">
            <!-- Every caption box offers the AI caption writer (Dani, 18 Oct). -->
            <span class="post-label post-label--row"><span>Caption <span class="pick-optional">— optional</span></span>
              <button type="button" class="post-ai" id="pick-ai-caption"><span aria-hidden="true">✨</span> Generate with AI</button>
            </span>
            <textarea id="pick-caption" class="post-textarea" rows="4" maxlength="2200" placeholder="The words you'll post alongside it."></textarea>
          </label>
          <label class="post-remind">
            <input type="checkbox" id="pick-remind" checked />
            <span>Remind me on the day <span class="post-remind-note">&mdash; we'll email the caption &amp; image at 8am on the morning of this post</span></span>
          </label>
          <div class="post-error" id="pick-error" hidden></div>
        </div>
      </div>

      <footer class="day-foot post-foot" id="pick-foot" hidden>
        <button type="button" class="post-btn post-btn--ghost" id="pick-cancel">Cancel</button>
        <button type="button" class="post-btn post-btn--primary" id="pick-continue" hidden>Continue</button>
        <button type="button" class="post-btn post-btn--ghost" id="pick-save-cal" data-mycal data-mycal-save="pick" hidden>Plan &amp; add to my calendar</button>
        <button type="button" class="post-btn post-btn--primary" id="pick-save">Plan post</button>
      </footer>
    </aside>
  </div>

  <style is:global>
    /* ============================================================
       /account/schedule — calendar UI
       Shared workspace shell (header, footer, welcome, section heads)
       comes from src/styles/workspace.css. Everything below is
       calendar-specific.
       ============================================================ */

    /* No panel: on the hub system a block is unfilled and the wine strip is the
       only colour. The old glass card fought the grid's hairlines for it. */

    /* ---- Planner on the shared hub system ---- */
    .cal-hero { --ws-hero-img: url('/assets/hub/planner.jpg'); }
    /* The dashboard's arrangement: the words across the top, the buttons at
       the bottom left and the three boxes level with them on the right. */
    .cal-hero > .ws-hero-copy { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: clamp(24px, 3vw, 48px); align-items: end; }
    .cal-hero .ws-hero-date, .cal-hero .ws-greeting, .cal-hero .ws-hero-sub { grid-column: 1 / -1; }
    .cal-hero .ws-hero-cta { grid-column: 1; grid-row: 4; align-self: end; }
    .cal-hero .cal-brief { grid-column: 2; grid-row: 4; align-self: end; }
    .cal-brief .ws-brief-tx strong { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px; }
    @media (max-width: 900px) {
      .cal-hero > .ws-hero-copy { grid-template-columns: minmax(0, 1fr); }
      .cal-hero .cal-brief { grid-column: 1; grid-row: 4; margin-top: clamp(18px, 2.4vh, 26px); grid-template-columns: repeat(3, minmax(0, 1fr)); }
      .cal-hero .ws-hero-cta { grid-row: 5; }
    }
    @media (max-width: 620px) { .cal-hero .cal-brief { grid-template-columns: 1fr; } }
    /* Spacing comes from .ws-hero-cta. */
    .cal-hero-cta { }

    /* The month name sits beside the chapter label rather than in a heading of
       its own, so the page carries one bar where it used to carry two. */
    .cal-month { font-family: var(--serif); font-size: var(--ws-t-meta); letter-spacing: 0.01em; text-transform: none; }

    /* 25px, so a strip holding controls still measures the house 37px. */
    /* A strip carrying controls tightens its own padding so it still measures
       37px — the same trick the shared sheet does for inputs, done here because
       a bare <button> in a strip means something taller elsewhere. */
    .cal-strip { padding-top: 6px; padding-bottom: 6px; padding-right: 6px; }
    .cal-strip-nav { display: flex; align-items: center; gap: 6px; }
    .cal-nav {
      appearance: none;
      display: inline-flex; align-items: center; justify-content: center;
      height: 25px; min-width: 25px; padding: 0 9px; box-sizing: border-box;
      border: 1px solid rgba(255,255,255,0.28); border-radius: 3px;
      background: transparent; color: #fff; cursor: pointer;
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600; line-height: 1;
      transition: background 0.2s, border-color 0.2s;
    }
    .cal-nav:hover { background: rgba(255,255,255,0.16); border-color: rgba(255,255,255,0.5); }
    .cal-today { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
    .cal-view { display: inline-flex; gap: 6px; margin-right: 14px; }
    .cal-view-btn { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }
    .cal-view-btn[aria-pressed="true"] { background: #fff; border-color: #fff; color: var(--violet-deep); }
    /* On a phone the switch takes its own row under the month and arrows. */
    @media (max-width: 780px) {
      .cal-strip { flex-wrap: wrap; row-gap: 6px; }
      .cal-strip-nav { flex-wrap: wrap; width: 100%; justify-content: flex-end; row-gap: 6px; }
      .cal-view { order: 2; width: 100%; margin: 0; }
      .cal-view-btn { flex: 1 1 0; }
    }
    /* The key follows the view. */
    .cal[data-cal-view="posts"] .cal-leg[data-in="activity"] { display: none; }
    .cal[data-cal-view="all"] .cal-leg[data-in="posts"] { display: none; }
    .cal-leg--todo::before { background: #fff; box-shadow: inset 0 0 0 2px var(--violet-deep); }
    /* A day's posts, in the Marketing Planner: one quiet count. */
    .cal-chip--posts { align-self: flex-start; background: transparent; color: var(--violet-deep); border: 1px solid rgba(var(--violet-rgb), 0.35); font-weight: 700; cursor: pointer; }
    .cal-chip--posts:hover { border-color: var(--violet-deep); background: rgba(var(--violet-rgb), 0.06); }
    .cal[data-cal-view="posts"] .cal-day.is-empty:hover::after { content: "+ Plan a post"; }
    /* A content planning session, in the day's list: it opens the plan. */
    .day-item-plan { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; margin-top: 4px; font-size: var(--ws-t-meta); font-weight: 600; color: var(--violet-deep); }
    .day-item-edit { all: unset; cursor: pointer; font-weight: 500; color: rgba(28,29,34,0.6); text-decoration: underline; text-underline-offset: 2px; white-space: nowrap; }
    .day-item-edit:hover { color: var(--ink); }
    /* Half the usual gap under the post (Dani, 18 Oct). */
    .post-plan { display: inline-block; align-self: flex-start; margin: -9px 0 0; font-size: var(--ws-t-meta); font-weight: 600; color: var(--violet-deep); text-decoration: underline; text-underline-offset: 2px; }
    .post-plan[hidden] { display: none; }
    .act-posts-line { margin: 0; font-size: var(--ws-t-meta); line-height: 1.6; color: rgba(28,29,34,0.75); }
    .act-posts-line button { all: unset; cursor: pointer; color: var(--violet-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    .day-view-note { margin: 0; font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.6); }
    .day-view-note button { all: unset; cursor: pointer; color: var(--violet-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }

    /* The key runs the full width (Dani, 17 Oct): every box grows by the same
       amount, the gaps stay equal. */
    .cal-legend { display: flex; gap: 6px; flex-wrap: wrap; padding: 0 0 var(--ws-gap); }
    .cal-legend > .cal-leg { flex: 1 1 auto; justify-content: center; white-space: nowrap; }
    /* Narrower screens: tighter lettering, so it stays one line for longer. */
    @media (max-width: 1400px) { .cal-legend > .cal-leg { letter-spacing: 0.1em; padding: 0 7px; } }

    .cal-leg {
      display: inline-flex; align-items: center; gap: 6px;
      height: 25px; padding: 0 9px; box-sizing: border-box;
      border: 1px solid rgba(28, 29, 34, 0.14); border-radius: 3px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.55);
    }
    .cal-leg::before {
      content: ""; width: 10px; height: 10px; border-radius: 2px;
    }
    .cal-leg--post::before   { background: var(--violet-deep); }      /* your own scheduled posts */
    /* The five kinds of marketing activity (src/data/marketing-activities.js,
       CATEGORIES -- keep the colours in step). */
    .cal-leg--content::before  { background: #371e28; }
    .cal-leg--print::before    { background: #2f5d62; }
    .cal-leg--property::before { background: #8c5f37; }
    .cal-leg--campaigns::before { background: #5f6a35; }
    .cal-leg--business::before { background: #465a86; }
    .cal-leg--other::before    { background: #62666e; }
    .cal-leg--prompt::before { background: #fff; box-shadow: inset 0 0 0 2px var(--english-violet); }  /* wine outline — an angle is written for you */
    .cal-leg--date::before   { background: #887d77; }                 /* stone — a date to know, nothing to do */

    .cal-new {
      appearance: none;
      background: var(--violet-deep);
      color: var(--paper);
      border: 0;
      padding: 10px 18px;
      border-radius: 4px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex; align-items: center; gap: 6px;
      box-shadow:
        0 8px 18px -8px rgba(var(--violet-rgb), 0.45),
        0 2px 4px -2px rgba(28, 29, 34, 0.18);
      transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
    }
    .cal-new:hover {
      transform: translateY(-1px);
      background: var(--ink);
      box-shadow:
        0 14px 28px -10px rgba(var(--violet-rgb), 0.55),
        0 4px 8px -4px rgba(28, 29, 34, 0.25);
    }

    /* Days closer than the hub's cards (Dani, 17 Oct): a month is 35 of
       them, and the space goes to the days themselves. */
    .cal-weekhead, .cal-grid { --cal-gap: 6px; }

    /* ---------- Day-of-week header strip ---------- */
    /* The same columns and gap as the grid below, so each day's name starts
       at its column's left edge (Dani, 17 Oct: they drifted, the gap being
       the grid's and not the strip's). In the wine, to stand out. */
    .cal-weekhead {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: var(--cal-gap);
      padding: 0;
    }
    .cal-weekhead span {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--english-violet);
      padding: 6px 0;
      text-align: left;
    }

    /* ---------- The grid itself ---------- */
    .cal-grid {
      display: grid;
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: var(--cal-gap);
    }

    /* Hairline-outlined, square-cornered, unfilled — the same card the rest of
       the hub uses. A month is 35 of these at once, so anything heavier than a
       hairline reads as a wall of boxes rather than a calendar. */
    /* 4:5, the shape of a post, like the Content Calendar's days (Dani, 29 Oct). */
    .cal-day {
      aspect-ratio: 4 / 5;
      min-width: 0;
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 10px 11px 12px;
      background: transparent;
      border-radius: 0;
      border: 1px solid rgba(28, 29, 34, 0.14);
      cursor: pointer;
      text-align: left;
      font: inherit;
      color: var(--ink);
      overflow: hidden;
      transition: border-color 0.2s, background 0.2s;
    }
    .cal-day:hover { border-color: var(--english-violet); background: rgba(var(--violet-rgb), 0.03); }

    /* Days you cannot act on recede by weight, not by fill. */
    .cal-day.is-other-month { border-color: rgba(28,29,34,0.07); color: rgba(28,29,34,0.35); }
    .cal-day.is-other-month .cal-day-num { color: rgba(28,29,34,0.32); }
    /* A day that's gone (Dani, 17 Oct): greyed out in the hover's colour,
       nothing to plan on it; one with something on it still opens to see. */
    .cal-day.is-past { border-color: rgba(28,29,34,0.08); background: rgba(var(--violet-rgb), 0.03); cursor: default; }
    .cal-day.is-past:hover { border-color: rgba(28,29,34,0.08); background: rgba(var(--violet-rgb), 0.03); }
    .cal-day.is-past:not(.is-empty) { cursor: pointer; }
    .cal-day.is-past:not(.is-empty):hover { border-color: rgba(28,29,34,0.2); }
    .cal-day.is-past .cal-chip { opacity: 0.55; }
    .cal-day.is-past .cal-day-num { color: rgba(28,29,34,0.4); }

    /* Today is the one square that gets the wine, and it gets it outright. */
    .cal-day.is-today { border-color: var(--english-violet); box-shadow: inset 0 0 0 1px var(--english-violet); }
    .cal-day.is-today .cal-day-num {
      color: var(--paper);
      background: var(--english-violet);
      border-radius: 0;
      padding: 2px 7px;
    }

    /* A day's entries sit at the foot of the square; a second stacks on top
       of the first, upwards (Dani, 17 Oct). */
    .cal-day > .cal-day-head { margin-bottom: auto; }
    .cal-day-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 6px;
    }
    .cal-day-num {
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      font-weight: 700;
      letter-spacing: 0;
      color: var(--ink);
      transition: color 0.2s;
    }
    .cal-day-dow {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.35);
      display: none;
    }

    /* Holiday + post chips inside a day cell */
    .cal-chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 7px;
      border-radius: 0;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 600;
      letter-spacing: 0.02em;
      line-height: 1.25;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .cal-chip--bank,
    .cal-chip--aware {
      background: rgba(136, 125, 119, 0.13);
      color: #6b6058;
      border: 1px solid rgba(136, 125, 119, 0.30);
    }
    .cal-chip--post {
      background: var(--violet-deep);
      color: var(--paper);
      border: 1px solid var(--violet-deep);
      padding: 4px 8px;
    }
    .cal-chip--post.is-done       { background: #2e6f4f; border-color: #2e6f4f; }
    /* Planned, not made yet (from a content plan). */
    .cal-chip--post.is-todo       { background: #fff; color: var(--violet-deep); border: 1px dashed var(--violet-deep); }
    .cal-chip--post.is-sent       { background: var(--violet); border-color: var(--violet); }
    .cal-chip--post.is-cancelled  { background: rgba(28,29,34,0.35); border-color: rgba(28,29,34,0.35); text-decoration: line-through; }
    /* Every other activity: its category's colour. A run (a campaign, paid
       ads) is drawn on each of its days; after the first, as a thin bar. */
    .cal-chip--act { color: #fff; padding: 4px 8px; border: 1px solid transparent; }
    .cal-chip--content  { background: #371e28; border-color: #371e28; }
    .cal-chip--print    { background: #2f5d62; border-color: #2f5d62; }
    .cal-chip--property { background: #8c5f37; border-color: #8c5f37; }
    .cal-chip--campaigns { background: #5f6a35; border-color: #5f6a35; }
    .cal-chip--business { background: #465a86; border-color: #465a86; }
    .cal-chip--other    { background: #62666e; border-color: #62666e; }
    .cal-chip--act.is-cont { padding: 0; height: 6px; min-height: 6px; font-size: 0; opacity: 0.7; }
    .cal-chip--booking { font-style: italic; }

    .cal-day-more {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--violet-deep);
      margin-top: auto;
    }

    /* Empty-state hint on hover for blank days. We don't render a chip
       so the calendar reads clean; the prompt only shows on hover. */
    .cal-day.is-empty:hover::after {
      content: "+ Plan an activity";
      position: absolute;
      bottom: 8px; left: 11px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--violet-deep);
      pointer-events: none;
    }

    .cal-state {
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      color: rgba(28,29,34,0.55);
      padding: 12px 4px 0;
      margin: 0;
    }

    /* Compact mode on mobile — drop the day-of-week strip into each
       cell, shrink chips, collapse cells to fit. */
    @media (max-width: 780px) {
      .cal-legend { display: none; }
      .cal-grid { grid-auto-rows: minmax(82px, 1fr); gap: 6px; }
      .cal-weekhead { display: none; }
      /* A phone's day is too narrow for 4:5 to hold its entries. */
      .cal-day { aspect-ratio: auto; padding: 6px 7px 8px; }
      .cal-day-dow { display: inline-block; }
      .cal-chip { font-size: var(--ws-t-label); padding: 2px 5px; }
    }

    /* ============================================================
       Day drawer — slides in from the right edge.
       Same lifecycle as the shop drawer in /account.astro:
       hidden -> next frame add .is-open -> on close remove .is-open
       and re-set [hidden] after transitionend.
       ============================================================ */
    .day-backdrop {
      position: fixed; inset: 0;
      background: rgba(15, 12, 30, 0);
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
      display: flex;
      align-items: stretch;
      justify-content: flex-end;
      z-index: 100;
      pointer-events: none;
      transition:
        background 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
        backdrop-filter 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
        -webkit-backdrop-filter 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .day-backdrop.is-open {
      background: rgba(15, 12, 30, 0.5);
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
      pointer-events: auto;
    }
    .day-backdrop[hidden] { display: none; }

    .day-panel {
      width: 100%;
      max-width: 460px;
      background: var(--paper);
      border-left: 1px solid rgba(28,29,34,0.08);
      box-shadow:
        -24px 0 60px -20px rgba(0, 0, 0, 0.4),
        -2px 0 8px -4px rgba(var(--violet-rgb), 0.2);
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .day-backdrop.is-open .day-panel { transform: translateX(0); }

    @media (prefers-reduced-motion: reduce) {
      .day-backdrop, .day-panel { transition: none; }
    }

    .day-head {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding: 28px 28px 18px;
      border-bottom: 1px solid rgba(28,29,34,0.08);
    }
    .day-eyebrow {
      margin: 0;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--violet-deep);
    }
    .day-h {
      font-family: var(--serif);
      font-size: var(--ws-t-panel, 26px);
      font-weight: 400;
      letter-spacing: -0.01em;
      margin: 4px 0 0;
      color: var(--ink);
    }
    .act-line {
      margin: 8px 0 0; max-width: 75%;
      font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.5;
      color: rgba(28,29,34,0.65);
    }
    .act-line[hidden] { display: none; }
    /* The title sits lower, nearer its line than the date (Dani, 16 Oct): it
       moves down 8px and the line comes up 8px, so the date and the line
       stay exactly where they were. */
    .act-panel .day-h { margin-top: 12px; }
    .act-panel .act-line { margin-top: 0; }
    /* Their own calendar: the entry menu and the sync panel. */
    .mycal-menu { position: fixed; z-index: 1300; min-width: 220px; padding: 6px; background: #fff; border-radius: 8px;
      border: 1px solid rgba(28,29,34,0.12); box-shadow: 0 14px 34px rgba(28,29,34,0.18); display: grid; }
    .mycal-menu[hidden] { display: none; }
    .mycal-menu button { all: unset; cursor: pointer; padding: 10px 12px; border-radius: 5px; font-family: var(--sans); font-size: var(--ws-t-body); color: var(--ink); }
    .mycal-menu button:hover, .mycal-menu button:focus-visible { background: rgba(var(--violet-rgb), 0.08); color: var(--violet-deep); }
    .sync-panel { max-width: 640px; }
    .sync-body { display: grid; gap: 14px; }
    .sync-state { margin: 0; font-family: var(--sans); font-size: var(--ws-t-body); color: rgba(28,29,34,0.65); }
    .sync-state[hidden], .sync-ready[hidden] { display: none; }
    .sync-ready { display: grid; gap: 12px; }
    .sync-apps { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .sync-panel .act-line { max-width: none; }
    @media (max-width: 640px) { .sync-br { display: none; } }
    .sync-app { display: grid; gap: 6px; padding: 14px 16px; border-radius: 6px; text-decoration: none; background: #fff;
      border: 1px solid rgba(var(--violet-rgb), 0.25); transition: border-color 0.2s, background 0.2s; }
    .sync-app:hover { border-color: var(--violet-deep); background: rgba(var(--violet-rgb), 0.04); }
    .sync-app strong { display: flex !important; align-items: center; justify-content: space-between; gap: 10px; }
    .sync-tag { display: none; font-style: normal; font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #2e6f4f; }
    .sync-tag::before { content: "✓ "; }
    .sync-app.is-synced { background: rgba(28,29,34,0.035); border-color: rgba(28,29,34,0.1); }
    .sync-app.is-synced strong { color: rgba(28,29,34,0.5); }
    .sync-app.is-synced span { color: rgba(28,29,34,0.42); }
    .sync-app.is-synced .sync-tag { display: inline; }
    .sync-app strong { display: block; font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 600; line-height: 1.4; color: var(--violet-deep); }
    .sync-app span { display: block; font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.3; color: rgba(28,29,34,0.6); }
    .sync-copy { display: flex; gap: 10px; }
    .sync-copy .post-input { flex: 1; min-width: 0; font-size: var(--ws-t-meta); }
    .sync-note { margin: 0; font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.55; color: rgba(28,29,34,0.6); }
    .sync-reset { all: unset; cursor: pointer; color: var(--violet-deep); font-weight: 600; text-decoration: underline; text-underline-offset: 2px; }
    @media (max-width: 640px) { .sync-apps { grid-template-columns: 1fr; } }
    .act-panel .day-head > div { flex: 1; min-width: 0; }
    .day-close {
      background: transparent;
      border: 1px solid rgba(var(--violet-rgb), 0.3);
      border-radius: 999px;
      font-size: 20px;
      width: 34px; height: 34px;
      cursor: pointer;
      color: var(--violet-deep);
      line-height: 1;
      transition: background 0.25s, color 0.25s, border-color 0.25s;
    }
    .day-close:hover { background: var(--violet-deep); color: var(--paper); border-color: var(--violet-deep); }

    .day-body {
      flex: 1;
      overflow-y: auto;
      padding: 22px 28px;
      display: flex; flex-direction: column; gap: 16px;
    }

    .day-section-h {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.5);
      margin: 0 0 8px;
    }

    /* A prompt on the grid. Wine, because it is the one marker that is asking
       for something rather than noting something. */
    .cal-chip--prompt {
      background: #fff;
      color: var(--english-violet);
      border: 1px solid var(--english-violet);
      font-weight: 700;
    }

    /* The prompt in the day panel: what it is, what to make, and the way in. */
    .day-prompt { padding: 14px; border-radius: 10px; background: var(--english-violet); color: #fff; display: flex; flex-direction: column; gap: 4px; }
    .day-prompt-name { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.6); }
    .day-prompt-angle { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 600; line-height: 1.35; }
    .day-prompt-brief { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.55; color: rgba(255,255,255,0.78); }
    .day-prompt-cta { align-self: flex-start; margin-top: 8px; padding: 8px 14px; border-radius: 4px; background: #fff; color: var(--english-violet); font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; }
    .day-prompt-cta:hover { opacity: 0.9; }

    .day-holiday {
      display: flex; gap: 10px; align-items: center;
      padding: 10px 14px;
      border-radius: 4px;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      font-weight: 600;
    }
    .day-holiday.is-bank {
      background: rgba(201, 122, 58, 0.12);
      color: #8a4d1f;
      border: 1px solid rgba(201, 122, 58, 0.3);
    }
    .day-holiday.is-aware {
      background: rgba(111, 141, 101, 0.12);
      color: #3f5a36;
      border: 1px solid rgba(111, 141, 101, 0.28);
    }
    .day-holiday::before {
      content: ""; width: 6px; height: 6px; border-radius: 999px;
      background: currentColor; opacity: 0.55;
    }

    .day-item {
      display: flex;
      gap: 14px;
      padding: 14px;
      background: var(--card-glass);
      -webkit-backdrop-filter: var(--card-blur);
      backdrop-filter: var(--card-blur);
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 6px;
      box-shadow: 0 4px 12px -8px rgba(var(--violet-rgb), 0.2);
    }
    .day-item-thumb {
      width: 64px; height: 64px;
      background: var(--platinum);
      background-size: cover;
      background-position: center;
      border-radius: 4px;
      flex-shrink: 0;
    }
    .day-item-body { flex: 1; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .day-item-time {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--violet-deep);
    }
    .day-item-title {
      font-family: var(--serif);
      font-size: var(--ws-t-title);
      letter-spacing: -0.01em;
      margin: 0;
      color: var(--ink);
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .day-item-caption {
      font-family: var(--sans);
      font-size: var(--ws-t-meta);
      color: rgba(28,29,34,0.6);
      line-height: 1.5;
      margin: 2px 0 0;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
    }
    .day-item-status {
      display: inline-flex; align-items: center;
      padding: 2px 8px;
      border-radius: 999px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      width: fit-content;
      margin-top: 4px;
    }
    .day-item-status.is-scheduled { background: rgba(var(--violet-rgb), 0.1);  color: var(--violet-deep); }
    .day-item-status.is-sent      { background: rgba(123, 91, 207, 0.18); color: var(--violet-deep); }
    .day-item-status.is-done      { background: rgba(46, 111, 79, 0.18); color: #2e6f4f; }
    .day-item-status.is-cancelled { background: rgba(28, 29, 34, 0.1);  color: rgba(28,29,34,0.55); }

    .day-empty {
      padding: 20px 22px;
      background: var(--card-glass);
      border: 1px dashed rgba(var(--violet-rgb), 0.32);
      border-radius: 6px;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      color: rgba(28,29,34,0.6);
      line-height: 1.55;
    }

    .day-foot[hidden] { display: none; }
    .day-foot {
      padding: 18px 28px 24px;
      border-top: 1px solid rgba(28,29,34,0.08);
    }
    .day-new-btn {
      display: block;
      text-align: center;
      width: 100%;
      padding: 12px 18px;
      background: var(--violet-deep);
      color: var(--paper);
      border-radius: 4px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      text-decoration: none;
      box-shadow:
        0 10px 22px -10px rgba(var(--violet-rgb), 0.55),
        0 3px 6px -3px rgba(28, 29, 34, 0.22);
      transition: transform 0.25s, background 0.25s, box-shadow 0.25s;
    }
    .day-new-btn:hover {
      transform: translateY(-1px);
      background: var(--ink);
      box-shadow:
        0 16px 30px -10px rgba(var(--violet-rgb), 0.65),
        0 6px 12px -6px rgba(28, 29, 34, 0.3);
    }
    /* The second way in: a new design for this day. Quieter than planning one
       you already have, which is the commoner job. */
    .day-new-btn--ghost {
      margin-top: 10px; background: transparent; color: var(--violet-deep);
      border: 1px solid rgba(var(--violet-rgb), 0.35); box-shadow: none;
    }
    .day-new-btn--ghost:hover { background: rgba(var(--violet-rgb), 0.07); color: var(--violet-deep); box-shadow: none; }
    .day-foot button.day-new-btn { border: 0; cursor: pointer; }
    .day-new-btn[hidden] { display: none; }
    .day-foot button.day-new-btn--ghost { border: 1px solid rgba(var(--violet-rgb), 0.35); }

    /* ---- Plan a post: the library, over the calendar ---- */
    .pick-panel {
      position: relative; display: flex; flex-direction: column; overflow: hidden;
      width: min(1020px, calc(100vw - 32px)); max-height: min(88vh, 900px);
      margin: auto; background: var(--paper, #f4f2f1);
      border-radius: 8px; box-shadow: 0 40px 90px -30px rgba(28,29,34,0.55);
    }
    #pick-modal { display: flex; align-items: center; justify-content: center; padding: 16px; }
    #pick-modal[hidden] { display: none; }
    .pick-body { padding: 22px 28px 26px; overflow: auto; }
    .pick-note { font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.55); margin: 0 0 16px; }
    .pick-note a { color: var(--violet-deep); }
    .pick-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 14px; }
    .pick-card {
      display: flex; flex-direction: column; gap: 6px; padding: 0; cursor: pointer; text-align: left;
      background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 6px; overflow: hidden;
      transition: border-color 0.2s, transform 0.2s;
    }
    .pick-card:hover { border-color: var(--violet-deep); transform: translateY(-2px); }
    .pick-card img { display: block; width: 100%; aspect-ratio: 1080 / 1440; object-fit: cover; background: #e9e6e2; }
    .pick-card b { font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 600; padding: 0 10px; }
    .pick-card span { font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.5); padding: 0 10px 10px; }
    .pick-body--plan { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 26px; align-items: start; }
    /* A class that sets display beats the browser's own [hidden] rule, so say
       it here: a step that is hidden is hidden. */
    .pick-body[hidden], .pick-body--plan[hidden], #pick-foot[hidden], #pick-continue[hidden], #pick-save[hidden] { display: none; }
    #pick-step-upload { display: grid; gap: 12px; align-content: start; --cat: var(--violet-deep); }
    /* Its own display outranked [hidden], so the upload box showed on every
       post, not only "Upload a post" (Dani, 18 Oct). */
    #pick-step-upload[hidden] { display: none; }
    .pick-drop { display: grid; place-items: center; gap: 4px; padding: 30px 16px; border: 1.5px dashed rgba(var(--violet-rgb), 0.35); border-radius: 8px; background: #fff; cursor: pointer; text-align: center; font-family: var(--sans); transition: border-color .2s, background .2s; }
    .pick-drop strong { font-size: var(--ws-t-body); color: var(--violet-deep); }
    .pick-drop span { font-size: var(--ws-t-meta); color: rgba(28,29,34,0.55); }
    .pick-drop:hover, .pick-drop.is-over { border-color: var(--violet-deep); background: rgba(var(--violet-rgb), 0.04); }
    .pick-chosen.is-file img { display: none; }
    .pick-file-tile { display: none; aspect-ratio: 1080 / 1440; border-radius: 6px; background: #e9e6e2; place-items: center; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; color: rgba(28,29,34,0.55); }
    .pick-chosen.is-file .pick-file-tile { display: grid; }
    .pick-chosen { margin: 0; }
    .pick-chosen img { display: block; width: 100%; aspect-ratio: 1080 / 1440; object-fit: cover; border-radius: 6px; background: #e9e6e2; }
    .pick-chosen figcaption { font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.6); margin-top: 8px; }
    .pick-back {
      margin-top: 8px; padding: 0; background: none; border: 0; cursor: pointer;
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; color: var(--violet-deep); text-decoration: underline;
    }
    .pick-optional { color: rgba(28,29,34,0.45); font-weight: 400; }
    @media (max-width: 720px) {
      .pick-body--plan { grid-template-columns: 1fr; }
      .pick-chosen img { max-width: 180px; }
    }

    /* ---- Add to this day: the activity chooser and its form ---- */
    .act-panel { width: min(820px, calc(100vw - 32px)); }
    #act-modal { display: flex; align-items: center; justify-content: center; padding: 16px; }
    #act-modal[hidden], .act-form[hidden], .act-choose[hidden], #act-foot[hidden], #act-delete[hidden], #act-save[hidden] { display: none; }
    /* Content & Social over Something Else down the first column; beside it
       Property Marketing over Campaigns, then Print & Canvassing over Business
       & Community (Dani, 15 and 16 Oct). One column on a phone. */
    .act-choose { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 20px 22px; align-items: start; }
    .act-rest { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 22px; }
    .act-col { display: grid; gap: 28px; align-content: start; }
    .act-cat--solo { margin-top: -22px; }   /* sits on as the list's last row */
    .act-cat--solo .act-pick { display: flex; align-items: center; gap: 8px; color: rgba(28,29,34,0.75); }
    .act-cat--solo .act-pick::before { content: ""; width: 9px; height: 9px; border-radius: 2px; background: var(--cat); flex: none; }
    @media (max-width: 720px) { .act-choose, .act-rest { grid-template-columns: 1fr; } }
    .act-files-list { display: grid; gap: 6px; }
    .act-testi-tones { display: flex; flex-wrap: wrap; gap: 8px; }
    .act-testi-tones [aria-pressed="true"] { background: var(--violet-deep); border-color: var(--violet-deep); color: #fff; }
    .act-testi-out { display: grid; gap: 10px; margin-top: 6px; padding: 14px; background: #fff; border: 1px solid rgba(28,29,34,0.12); border-radius: 8px; }
    .act-testi-out[hidden] { display: none; }
    .act-testi-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
    .act-testi-note { margin: 0; font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.6); }
    .act-testi-channel { display: inline-flex; border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 999px; padding: 2px; }
    .act-testi-channel button { all: unset; cursor: pointer; padding: 5px 12px; border-radius: 999px; font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--violet-deep); }
    .act-testi-channel [aria-pressed="true"] { background: var(--violet-deep); color: #fff; }
    .act-testi-body { min-height: 220px; line-height: 1.55; }
    .act-testi-missing { margin: 0; font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.6); }
    .act-testi-missing a { color: var(--violet-deep); font-weight: 600; }
    .act-testi-acts { display: flex; justify-content: flex-end; gap: 8px; }
    .act-testi-acts [hidden] { display: none; }
    .act-testi [data-testi-subject-row][hidden], .act-testi-missing[hidden] { display: none; }
    .act-testi-copy { background: var(--violet-deep); border-color: var(--violet-deep); color: #fff; }
    /* Room on the activity forms (Dani, 16 Oct): a fifth less between a label
       and its box, and boxes a fifth shorter. */
    #act-form .post-field { gap: 5px; }
    #act-form .post-input { padding-top: 0; padding-bottom: 0; }
    #act-form .post-textarea { padding-top: 7px; padding-bottom: 7px; min-height: 0; }
    #act-form .act-notes { min-height: 58px; }
    #act-form .act-files-btn, #act-form .act-check-add button { height: 31px; }
    .act-btns { display: flex; flex-wrap: wrap; gap: 8px; }
    .act-btns .act-files-btn { text-decoration: none; }
    .act-campaign { display: flex; gap: 8px; align-items: center; }
    .act-campaign .post-input { flex: 1; min-width: 0; }
    .act-linked { display: flex; flex-wrap: wrap; gap: 8px; }
    .act-plan-designs { justify-self: start; margin-top: 4px; background: var(--violet-deep); border-color: var(--violet-deep); color: #fff; }
    .act-plan-designs:hover { background: var(--violet-deep); opacity: 0.92; }
    .act-plan-designs[hidden] { display: none; }
    .act-files-list:empty { display: none; }
    .act-file { display: flex; align-items: center; gap: 6px; background: #fff; border: 1px solid rgba(28,29,34,0.12); border-radius: 6px; padding: 4px 6px 4px 4px; }
    .act-file-open { all: unset; cursor: pointer; flex: 1; min-width: 0; display: flex; align-items: center; gap: 10px; padding: 4px 6px; border-radius: 4px; font-family: var(--sans); font-size: var(--ws-t-body); color: var(--ink); }
    .act-file-open:hover:not(:disabled) { background: rgba(var(--violet-rgb), 0.06); }
    .act-file-kind { flex: none; min-width: 38px; padding: 3px 6px; border-radius: 3px; background: var(--cat); color: #fff; text-align: center; font-size: 9px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
    .act-file-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .act-file-meta { flex: none; font-size: var(--ws-t-meta); color: rgba(28,29,34,0.5); }
    .act-file.is-uploading { opacity: 0.6; }
    .act-files-add { display: flex; gap: 8px; align-items: center; }
    .act-files-add .post-input { flex: 1; min-width: 0; }
    .act-files-btn { flex: none; display: inline-flex; align-items: center; height: 38px; padding: 0 14px; border-radius: 4px; cursor: pointer; background: #fff;
      border: 1px solid rgba(var(--violet-rgb), 0.3); color: var(--violet-deep); font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
    .act-files-btn:hover { border-color: var(--violet-deep); background: rgba(var(--violet-rgb), 0.05); }
    @media (max-width: 560px) { .act-files-add { flex-wrap: wrap; } .act-files-add .post-input { flex-basis: 100%; order: 2; } }
    .act-book-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: auto auto 1fr auto; gap: 0 16px; align-items: stretch; }
    .act-book-cards:not(.act-book-cards--3) > .act-book { grid-row: span 4; display: grid; grid-template-rows: subgrid; }
    .act-book-cards:not(.act-book-cards--3) > .act-book > .act-book-links { margin-top: 0; align-self: end; }
    @media (max-width: 720px) { .act-book-cards { grid-template-columns: 1fr; grid-template-rows: none; gap: 16px; } .act-book-cards:not(.act-book-cards--3) > .act-book { grid-row: auto; grid-template-rows: none; } }
    .act-book { display: flex; flex-direction: column; gap: 12px; padding: 20px; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; }
    .act-book p { margin: 0; font-family: var(--sans); font-size: var(--ws-t-body); line-height: 1.55; color: rgba(28,29,34,0.75); }
    .act-book-links { display: grid; gap: 8px; }
    .act-book-links a, .act-book-links button { display: flex; justify-content: center; cursor: pointer; align-items: center; height: 36px; padding: 0 14px; border-radius: 4px; text-decoration: none;
      font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      border: 1px solid rgba(28,29,34,0.2); color: var(--ink); background: #fff; }
    .act-book-links .is-primary { background: var(--violet-deep); border-color: var(--violet-deep); color: #fff; }
    .act-book-note { font-size: var(--ws-t-meta) !important; color: rgba(28,29,34,0.55) !important; }
    .act-book .act-book-links { margin-top: auto; }
    .act-book-cards--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    /* Three to a row: each card's title on one line. */
    .act-book-cards--3 > .act-book { padding: 18px 16px; }
    .act-book-cards--3 .act-kind { letter-spacing: 0.1em; white-space: nowrap; }
    @media (max-width: 720px) { .act-book-cards--3 { grid-template-columns: 1fr; } }
    .act-cat h3 { margin: 0 0 8px; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.55); display: flex; align-items: center; gap: 7px; }
    .act-cat h3::before { content: ""; width: 9px; height: 9px; border-radius: 2px; background: var(--cat); }
    .act-cat ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
    .act-pick { width: 100%; text-align: left; cursor: pointer; padding: 10px 12px; border-radius: 6px; border: 1px solid rgba(28,29,34,0.12); background: #fff;
      font-family: var(--sans); font-size: var(--ws-t-body); font-weight: 600; color: var(--ink); transition: border-color .18s, transform .18s; }
    .act-pick:hover { border-color: var(--cat); transform: translateY(-1px); }
    .act-pick:focus-visible { outline: 2px solid var(--cat); outline-offset: 2px; }
    .act-form { display: grid; gap: 14px; }
    .act-kind { display: flex; align-items: center; gap: 8px; font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--cat); }
    .act-kind::before { content: ""; width: 9px; height: 9px; border-radius: 2px; background: var(--cat); }
    .act-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; }
    .act-allday { display: inline-flex; align-items: center; gap: 6px; font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.65); margin-top: 6px; }
    .act-link { font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; color: var(--violet-deep); }
    .act-designs { display: grid; grid-template-columns: repeat(auto-fill, minmax(92px, 1fr)); gap: 8px; max-height: 260px; overflow: auto; padding: 2px; }
    .act-design { position: relative; padding: 0; border: 1px solid rgba(28,29,34,0.12); border-radius: 4px; overflow: hidden; background: #fff; cursor: pointer; text-align: left; }
    .act-design img { display: block; width: 100%; aspect-ratio: 3 / 4; object-fit: contain; background: #e9e6e2; }
    .act-design span { display: block; padding: 4px 6px; font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.7); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .act-design.is-on { border-color: var(--violet-deep); box-shadow: 0 0 0 2px var(--violet-deep); }
    .act-none { font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.55); margin: 0; }
    .act-check { display: grid; gap: 6px; }
    .act-check-item { display: flex; align-items: center; gap: 8px; padding: 7px 10px; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 5px; font-family: var(--sans); font-size: var(--ws-t-body); }
    .act-check-item label { flex: 1; display: flex; align-items: center; gap: 8px; cursor: pointer; min-width: 0; }
    .act-check-item input[type="checkbox"] { width: 16px; height: 16px; accent-color: var(--violet-deep); flex: 0 0 auto; }
    .act-check-item.is-done label span { text-decoration: line-through; color: rgba(28,29,34,0.45); }
    .act-check-del { border: 0; background: none; cursor: pointer; color: rgba(28,29,34,0.4); font-size: 18px; line-height: 1; padding: 0 2px; }
    .act-check-del:hover { color: #9b2c2c; }
    .act-check-add { display: flex; gap: 8px; }
    .act-check-add input { flex: 1; }
    .act-check-add button { border: 1px solid rgba(28,29,34,0.2); background: #fff; border-radius: 5px; padding: 0 12px; cursor: pointer; font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700; }
    .act-progress { font-family: var(--sans); font-size: var(--ws-t-meta); color: rgba(28,29,34,0.55); }

    /* An activity in the day list: its category's colour down the side. */
    .day-item--act { border-left: 3px solid var(--cat, #62666e); }
    .day-item-kind { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--cat, #62666e); }

    /* Planned posts are clickable — nudge on hover to signal it. */
    .day-item { cursor: pointer; transition: transform 0.18s, box-shadow 0.18s, border-color 0.18s; }
    .day-item:hover {
      transform: translateY(-1px);
      border-color: rgba(var(--violet-rgb), 0.3);
      box-shadow: 0 8px 18px -8px rgba(var(--violet-rgb), 0.32);
    }

    /* ---- Planned-post detail modal ---- */
    .post-body { display: flex; flex-direction: column; gap: 18px; }
    /* The post fills the panel's width, in its own proportions, with no grey
       box round it (Dani, 18 Oct). */
    .post-preview {
      margin: 0;
      flex: 0 0 auto;   /* never let the scrolling column shrink the thumbnail */
      border-radius: 6px;
      overflow: hidden;
    }
    .post-preview img { width: 100%; height: auto; display: block; }
    .post-files:empty { display: none; }   /* no extra gap when there are no files */
    .post-fields { display: flex; flex-direction: column; gap: 14px; flex: 0 0 auto; }
    .post-row { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .post-field { display: flex; flex-direction: column; gap: 6px; }
    .post-label {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
