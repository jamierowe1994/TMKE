        $(`cb-${n}-ic`).innerHTML = BRIEF_IC[ic]; $(`cb-${n}-h`).textContent = h; $(`cb-${n}-s`).textContent = sub;
        const a = $(`cb-${n}`); a.setAttribute('href', href || '#');
        if (view) a.dataset.briefView = view; else delete a.dataset.briefView;
      };
      const rows = briefRows || [];
      const posts = rows.filter((it) => isPostItem(it)), acts = rows.filter((it) => !isPostItem(it));
      const known = briefRows !== null;
      const count = (n, one, many, none) => !known ? ' ' : briefRows === false ? '—' : n ? `${n} ${n === 1 ? one : many}` : none;
      const postsTx = count(posts.length, 'post', 'posts', 'No posts');
      if (calView === 'posts') {
        const key = monthKey(viewMonth);
        set(1, 'plan', ' ', `for ${planMonthName(key)}`, planUrl(key));
        set(2, 'cal', postsTx, 'coming up', '#', null);
        if (!briefPlan.has(key)) briefPlan.set(key, plannedMonths([key]).then((x) => x.has(key)));
        briefPlan.get(key).then((has) => {
          if (calView !== 'posts' || monthKey(viewMonth) !== key) return;
          $('cb-1-h').textContent = has ? 'View your content plan' : 'Create your content plan';
        });
      } else {
        set(1, 'tick', count(acts.length, 'activity', 'activities', 'No activities'), 'coming up', '#', null);
        set(2, 'cal', postsTx, 'in your Content Calendar', '#', 'posts');
      }
      // Next: the first still ahead of now (today's earlier ones have passed).
      const d = new Date();
      const today = ymd(d);
      const nowHm = `${String(d.getHours()).padStart(2, '0')}:${String(d.getMinutes()).padStart(2, '0')}`;
      const $n = $('cb-next'), $w = $('cb-next-when'), $l = $('cb-next-link');
      if (!known) return;
