        // Paged: a busy diary passes the 1,000-row cap.
        const rows = [];
        for (let from = 0; ; from += 1000) {
          const { data, error } = await acct.db.from(acct.table).select('id, title, activity, details, scheduled_date, scheduled_time, has_time, status')
            .eq('user_id', acct.uid).gte('scheduled_date', today).in('status', ['scheduled', 'reminder_sent'])
            .order('scheduled_date', { ascending: true }).order('scheduled_time', { ascending: true }).range(from, from + 999);
          if (error) throw error;
          rows.push(...(data || []));
          if (!data || data.length < 1000) break;
        }
