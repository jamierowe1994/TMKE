---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import CaptionGenerator from "../../components/CaptionGenerator.astro";
import "../../styles/workspace.css";
import "../../styles/ws-system.css";
import NewDesignModal from "../../components/account/NewDesignModal.astro";
import "../../styles/account-sections.css";
---

<BaseLayout
  dashboard
  title="Content calendar — TMKE workspace"
  description="Plan and schedule your social posts. A month-by-month diary of what's going out, with UK holidays and awareness days baked in."
  hideNav
  hideFooter
>
  <div class="ws">
  <WorkspaceHeader active="planner" />
  <main class="ws-main">
    <div class="ws-left">
    <section class="ws-hero ws-hero--sub cal-hero">
      <div class="ws-hero-copy">
        <p class="ws-hero-date"><a href="/account" class="back-link">&larr; Workspace</a></p>
        <h1 class="ws-greeting">Your Content Calendar.</h1>
        <p class="ws-hero-sub">See what's planned, find fresh post prompts and keep your social media consistent all month.</p>
        <div class="ws-hero-cta cal-hero-cta">
          <button type="button" class="ws-btn ws-btn--primary" data-new-design>Create new design
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </button>
        </div>
      </div>
      <div class="ws-hero-photo"></div>
    </section>

    <!-- Calendar shell -->
    <section class="ws-block cal" aria-labelledby="cal-title">
      <header class="ws-block-head cal-strip">
        <h2 class="ws-block-h" id="cal-title"><span class="ws-block-ch">Chapter 01</span><span class="cal-month">—</span></h2>
        <div class="cal-strip-nav">
          <button type="button" class="cal-nav" id="cal-prev" aria-label="Previous month">&larr;</button>
          <button type="button" class="cal-nav cal-today" id="cal-today">Today</button>
          <button type="button" class="cal-nav" id="cal-next" aria-label="Next month">&rarr;</button>
        </div>
      </header>

      <div class="cal-legend" aria-hidden="true">
        <span class="cal-leg cal-leg--post">Your posts</span>
        <span class="cal-leg cal-leg--prompt">Idea ready</span>
        <span class="cal-leg cal-leg--date">Key date</span>
      </div>

      <div class="cal-weekhead" aria-hidden="true">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
      </div>

      <div id="cal-grid" class="cal-grid" role="grid" aria-labelledby="cal-title">
        <!-- Day cells injected by JS -->
      </div>

      <p id="cal-state" class="cal-state" hidden></p>
    </section>

    </div><!-- /.ws-left -->

    <footer class="app-foot dash-foot">
      <div class="app-foot-block">
        <div class="app-foot-tag">Help</div>
        <a href="/contact">hello@tmke.co.uk</a>
      </div>
      <div class="app-foot-block app-foot-block--right">
        <strong id="footer-email" class="dash-foot-email">&hellip;</strong>
      </div>
    </footer>
    </main>
  </div>

  <!-- Day drawer — slides in from the right when a day cell is clicked.
       Shows all scheduled items + holidays for that date, with quick
       actions (open, edit, mark as posted, cancel) on each item. -->
  <div class="day-backdrop" id="day-modal" hidden role="dialog" aria-modal="true" aria-labelledby="day-h">
    <aside class="day-panel" aria-label="Day detail">
      <header class="day-head">
        <div>
          <p class="day-eyebrow" id="day-eyebrow">—</p>
          <h2 id="day-h" class="day-h">—</h2>
        </div>
        <button type="button" class="day-close" id="day-close" aria-label="Close">&times;</button>
      </header>
      <div class="day-body" id="day-body">
        <!-- Filled in by JS -->
      </div>
      <footer class="day-foot">
        <a href="#" id="day-new" class="day-new-btn">+ Plan a post for this day</a>
      </footer>
    </aside>
  </div>

  <!-- Planned-post detail: click a post in the day view to open it here.
       Mirrors what was set in the editor's plan modal — title, date/time,
       caption, reminder — so it can be reviewed and edited after planning,
       or emailed over on demand. -->
  <div class="day-backdrop" id="post-modal" hidden role="dialog" aria-modal="true" aria-labelledby="post-h">
    <aside class="day-panel post-panel" aria-label="Planned post">
      <header class="day-head">
        <div>
          <p class="day-eyebrow" id="post-eyebrow">Planned post</p>
          <h2 id="post-h" class="day-h">Your post</h2>
        </div>
        <button type="button" class="day-close" id="post-close" aria-label="Close">&times;</button>
      </header>
      <div class="day-body post-body">
        <figure class="post-preview"><img id="post-img" alt="Your post design" /></figure>
        <div class="post-fields">
          <label class="post-field">
            <span class="post-label">Title</span>
            <input type="text" id="post-title" class="post-input" placeholder="Post title" />
          </label>
          <div class="post-row">
            <label class="post-field">
              <span class="post-label">Date</span>
              <input type="date" id="post-date" class="post-input" />
            </label>
            <label class="post-field">
              <span class="post-label">Time</span>
              <input type="time" id="post-time" class="post-input" />
            </label>
          </div>
          <p class="post-plat" id="post-plat">Instagram</p>
          <label class="post-field">
            <span class="post-label post-label--row">Caption
              <button type="button" class="post-ai" id="post-ai-caption"><span aria-hidden="true">✨</span> Generate with AI</button>
            </span>
            <textarea id="post-caption" class="post-textarea" rows="5" placeholder="Write your caption… or generate one with AI"></textarea>
          </label>
          <label class="post-remind">
            <input type="checkbox" id="post-remind" />
            <span>Remind me on the day <span class="post-remind-note">— we'll email the caption &amp; image at 8am on the morning of this post</span></span>
          </label>
          <div class="post-error" id="post-error" hidden></div>
        </div>
      </div>
      <footer class="day-foot post-foot">
        <button type="button" class="post-btn post-btn--danger" id="post-delete">Remove</button>
        <button type="button" class="post-btn post-btn--ghost" id="post-email">Email it to me now</button>
        <button type="button" class="post-btn post-btn--primary" id="post-save">Save changes</button>
      </footer>
    </aside>
  </div>

  <style is:global>
    /* ============================================================
       /account/schedule — calendar UI
       Shared workspace shell (header, footer, welcome, section heads)
       comes from src/styles/workspace.css. Everything below is
       calendar-specific.
       ============================================================ */

    /* No panel: on the hub system a block is unfilled and the wine strip is the
       only colour. The old glass card fought the grid's hairlines for it. */

    /* ---- Planner on the shared hub system ---- */
    .cal-hero { --ws-hero-img: url('/assets/home%20chair.jpg'); }
    /* Spacing comes from .ws-hero-cta. */
    .cal-hero-cta { }

    /* The month name sits beside the chapter label rather than in a heading of
       its own, so the page carries one bar where it used to carry two. */
    .cal-month { font-family: var(--serif); font-size: var(--ws-t-meta); letter-spacing: 0.01em; text-transform: none; }

    /* 25px, so a strip holding controls still measures the house 37px. */
    /* A strip carrying controls tightens its own padding so it still measures
       37px — the same trick the shared sheet does for inputs, done here because
       a bare <button> in a strip means something taller elsewhere. */
    .cal-strip { padding-top: 6px; padding-bottom: 6px; padding-right: 6px; }
    .cal-strip-nav { display: flex; align-items: center; gap: 6px; }
    .cal-nav {
      appearance: none;
      display: inline-flex; align-items: center; justify-content: center;
      height: 25px; min-width: 25px; padding: 0 9px; box-sizing: border-box;
      border: 1px solid rgba(255,255,255,0.28); border-radius: 3px;
      background: transparent; color: #fff; cursor: pointer;
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 600; line-height: 1;
      transition: background 0.2s, border-color 0.2s;
    }
    .cal-nav:hover { background: rgba(255,255,255,0.16); border-color: rgba(255,255,255,0.5); }
    .cal-today { font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; }

    .cal-legend { display: flex; gap: 14px; flex-wrap: wrap; padding: 0 2px var(--ws-gap); }

    .cal-leg {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.55);
    }
    .cal-leg::before {
      content: ""; width: 10px; height: 10px; border-radius: 2px;
    }
    .cal-leg--post::before   { background: var(--violet-deep); }      /* your own scheduled posts */
    .cal-leg--prompt::before { background: #fff; box-shadow: inset 0 0 0 2px var(--english-violet); }  /* wine outline — an angle is written for you */
    .cal-leg--date::before   { background: #887d77; }                 /* stone — a date to know, nothing to do */

    .cal-new {
      appearance: none;
      background: var(--violet-deep);
      color: var(--paper);
      border: 0;
      padding: 10px 18px;
      border-radius: 4px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex; align-items: center; gap: 6px;
      box-shadow:
        0 8px 18px -8px rgba(var(--violet-rgb), 0.45),
        0 2px 4px -2px rgba(28, 29, 34, 0.18);
      transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
    }
    .cal-new:hover {
      transform: translateY(-1px);
      background: var(--ink);
      box-shadow:
        0 14px 28px -10px rgba(var(--violet-rgb), 0.55),
        0 4px 8px -4px rgba(28, 29, 34, 0.25);
    }

    /* ---------- Day-of-week header strip ---------- */
    .cal-weekhead {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      gap: 0;
      padding: 0 2px;
    }
    .cal-weekhead span {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.45);
      padding: 6px 10px;
      text-align: left;
    }

    /* ---------- The grid itself ---------- */
    .cal-grid {
      display: grid;
      grid-template-columns: repeat(7, 1fr);
      grid-auto-rows: minmax(118px, 1fr);
      gap: var(--ws-gap);
    }

    /* Hairline-outlined, square-cornered, unfilled — the same card the rest of
       the hub uses. A month is 35 of these at once, so anything heavier than a
       hairline reads as a wall of boxes rather than a calendar. */
    .cal-day {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 10px 11px 12px;
      background: transparent;
      border-radius: 0;
      border: 1px solid rgba(28, 29, 34, 0.14);
      cursor: pointer;
      text-align: left;
      font: inherit;
      color: var(--ink);
      overflow: hidden;
      transition: border-color 0.2s, background 0.2s;
    }
    .cal-day:hover { border-color: var(--english-violet); background: rgba(var(--violet-rgb), 0.03); }

    /* Days you cannot act on recede by weight, not by fill. */
    .cal-day.is-other-month { border-color: rgba(28,29,34,0.07); color: rgba(28,29,34,0.35); }
    .cal-day.is-other-month .cal-day-num { color: rgba(28,29,34,0.32); }
    .cal-day.is-past { border-color: rgba(28,29,34,0.08); }
    .cal-day.is-past .cal-day-num { color: rgba(28,29,34,0.4); }

    /* Today is the one square that gets the wine, and it gets it outright. */
    .cal-day.is-today { border-color: var(--english-violet); box-shadow: inset 0 0 0 1px var(--english-violet); }
    .cal-day.is-today .cal-day-num {
      color: var(--paper);
      background: var(--english-violet);
      border-radius: 0;
      padding: 2px 7px;
    }

    .cal-day-head {
      display: flex; align-items: center; justify-content: space-between;
      gap: 6px;
    }
    .cal-day-num {
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      font-weight: 700;
      letter-spacing: 0;
      color: var(--ink);
      transition: color 0.2s;
    }
    .cal-day-dow {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.35);
      display: none;
    }

    /* Holiday + post chips inside a day cell */
    .cal-chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 7px;
      border-radius: 0;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 600;
      letter-spacing: 0.02em;
      line-height: 1.25;
      max-width: 100%;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .cal-chip--bank,
    .cal-chip--aware {
      background: rgba(136, 125, 119, 0.13);
      color: #6b6058;
      border: 1px solid rgba(136, 125, 119, 0.30);
    }
    .cal-chip--post {
      background: var(--violet-deep);
      color: var(--paper);
      border: 1px solid var(--violet-deep);
      padding: 4px 8px;
    }
    .cal-chip--post.is-done       { background: #2e6f4f; border-color: #2e6f4f; }
    .cal-chip--post.is-sent       { background: var(--violet); border-color: var(--violet); }
    .cal-chip--post.is-cancelled  { background: rgba(28,29,34,0.35); border-color: rgba(28,29,34,0.35); text-decoration: line-through; }

    .cal-day-more {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--violet-deep);
      margin-top: auto;
    }

    /* Empty-state hint on hover for blank days. We don't render a chip
       so the calendar reads clean; the prompt only shows on hover. */
    .cal-day.is-empty:hover::after {
      content: "+ Plan a post";
      position: absolute;
      bottom: 8px; left: 11px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--violet-deep);
      pointer-events: none;
    }

    .cal-state {
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      color: rgba(28,29,34,0.55);
      padding: 12px 4px 0;
      margin: 0;
    }

    /* Compact mode on mobile — drop the day-of-week strip into each
       cell, shrink chips, collapse cells to fit. */
    @media (max-width: 780px) {
      .cal-legend { display: none; }
      .cal-grid { grid-auto-rows: minmax(82px, 1fr); gap: 6px; }
      .cal-weekhead { display: none; }
      .cal-day { padding: 6px 7px 8px; }
      .cal-day-dow { display: inline-block; }
      .cal-chip { font-size: var(--ws-t-label); padding: 2px 5px; }
    }

    /* ============================================================
       Day drawer — slides in from the right edge.
       Same lifecycle as the shop drawer in /account.astro:
       hidden -> next frame add .is-open -> on close remove .is-open
       and re-set [hidden] after transitionend.
       ============================================================ */
    .day-backdrop {
      position: fixed; inset: 0;
      background: rgba(15, 12, 30, 0);
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
      display: flex;
      align-items: stretch;
      justify-content: flex-end;
      z-index: 100;
      pointer-events: none;
      transition:
        background 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
        backdrop-filter 0.4s cubic-bezier(0.2, 0.7, 0.2, 1),
        -webkit-backdrop-filter 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .day-backdrop.is-open {
      background: rgba(15, 12, 30, 0.5);
      backdrop-filter: blur(3px);
      -webkit-backdrop-filter: blur(3px);
      pointer-events: auto;
    }
    .day-backdrop[hidden] { display: none; }

    .day-panel {
      width: 100%;
      max-width: 460px;
      background: var(--paper);
      border-left: 1px solid rgba(28,29,34,0.08);
      box-shadow:
        -24px 0 60px -20px rgba(0, 0, 0, 0.4),
        -2px 0 8px -4px rgba(var(--violet-rgb), 0.2);
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .day-backdrop.is-open .day-panel { transform: translateX(0); }

    @media (prefers-reduced-motion: reduce) {
      .day-backdrop, .day-panel { transition: none; }
    }

    .day-head {
      display: flex; justify-content: space-between; align-items: flex-start;
      padding: 28px 28px 18px;
      border-bottom: 1px solid rgba(28,29,34,0.08);
    }
    .day-eyebrow {
      margin: 0;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--violet-deep);
    }
    .day-h {
      font-family: var(--serif);
      font-size: var(--ws-t-panel, 26px);
      font-weight: 400;
      letter-spacing: -0.01em;
      margin: 4px 0 0;
      color: var(--ink);
    }
    .day-close {
      background: transparent;
      border: 1px solid rgba(var(--violet-rgb), 0.3);
      border-radius: 999px;
      font-size: 20px;
      width: 34px; height: 34px;
      cursor: pointer;
      color: var(--violet-deep);
      line-height: 1;
      transition: background 0.25s, color 0.25s, border-color 0.25s;
    }
    .day-close:hover { background: var(--violet-deep); color: var(--paper); border-color: var(--violet-deep); }

    .day-body {
      flex: 1;
      overflow-y: auto;
      padding: 22px 28px;
      display: flex; flex-direction: column; gap: 16px;
    }

    .day-section-h {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.5);
      margin: 0 0 8px;
    }

    /* A prompt on the grid. Wine, because it is the one marker that is asking
       for something rather than noting something. */
    .cal-chip--prompt {
      background: #fff;
      color: var(--english-violet);
      border: 1px solid var(--english-violet);
      font-weight: 700;
    }

    /* The prompt in the day panel: what it is, what to make, and the way in. */
    .day-prompt { padding: 14px; border-radius: 10px; background: var(--english-violet); color: #fff; display: flex; flex-direction: column; gap: 4px; }
    .day-prompt-name { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.6); }
    .day-prompt-angle { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 600; line-height: 1.35; }
    .day-prompt-brief { font-family: var(--sans); font-size: var(--ws-t-meta); line-height: 1.55; color: rgba(255,255,255,0.78); }
    .day-prompt-cta { align-self: flex-start; margin-top: 8px; padding: 8px 14px; border-radius: 4px; background: #fff; color: var(--english-violet); font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; text-decoration: none; }
    .day-prompt-cta:hover { opacity: 0.9; }

    .day-holiday {
      display: flex; gap: 10px; align-items: center;
      padding: 10px 14px;
      border-radius: 4px;
      font-family: var(--sans);
      font-size: var(--ws-t-body);
      font-weight: 600;
    }
    .day-holiday.is-bank {
      background: rgba(201, 122, 58, 0.12);
      color: #8a4d1f;
      border: 1px solid rgba(201, 122, 58, 0.3);
    }
    .day-holiday.is-aware {
      background: rgba(111, 141, 101, 0.12);
      color: #3f5a36;
      border: 1px solid rgba(111, 141, 101, 0.28);
    }
    .day-holiday::before {
      content: ""; width: 6px; height: 6px; border-radius: 999px;
      background: currentColor; opacity: 0.55;
    }

    .day-item {
      display: flex;
      gap: 14px;
      padding: 14px;
      background: var(--card-glass);
      -webkit-backdrop-filter: var(--card-blur);
      backdrop-filter: var(--card-blur);
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 6px;
      box-shadow: 0 4px 12px -8px rgba(var(--violet-rgb), 0.2);
    }
    .day-item-thumb {
      width: 64px; height: 64px;
      background: var(--platinum);
      background-size: cover;
      background-position: center;
      border-radius: 4px;
      flex-shrink: 0;
    }
    .day-item-body { flex: 1; display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .day-item-time {
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--violet-deep);
    }
    .day-item-title {
      font-family: var(--serif);
      font-size: var(--ws-t-title);
      letter-spacing: -0.01em;
      margin: 0;
      color: var(--ink);
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }
    .day-item-caption {
      font-family: var(--sans);
      font-size: var(--ws-t-meta);
      color: rgba(28,29,34,0.6);
      line-height: 1.5;
      margin: 2px 0 0;
      overflow: hidden;
      text-overflow: ellipsis;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
    }
    .day-item-status {
      display: inline-flex; align-items: center;
      padding: 2px 8px;
      border-radius: 999px;
      font-family: var(--sans);
      font-size: var(--ws-t-label);
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      width: fit-content;
      margin-top: 4px;
    }
    .day-item-status.is-scheduled { background: rgba(var(--violet-rgb), 0.1);  color: var(--violet-deep); }
    .day-item-status.is-sent      { background: rgba(123, 91, 207, 0.18); color: var(--violet-deep); }
    .day-item-status.is-done      { background: rgba(46, 111, 79, 0.18); color: #2e6f4f; }
    .day-item-status.is-cancelled { background: rgba(28, 29, 34, 0.1);  color: rgba(28,29,34,0.55); }

    .day-empty {
      padding: 20px 22px;
      background: var(--card-glass);
      border: 1px dashed rgba(var(--violet-rgb), 0.32);
      border-radius: 6px;
