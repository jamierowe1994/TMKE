---
/* Your Orders became the Orders tab of Your Account (Danielle, 11 Nov 2026):
   src/pages/account/settings.astro. This address stays so old links,
   bookmarks and emails still land in the right place. Receipts keep their
   own address, /account/orders/receipt. */
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/account/settings?tab=orders" />
    <link rel="canonical" href="/account/settings?tab=orders" />
    <title>Your Account · TMKE</title>
    <script is:inline>location.replace('/account/settings?tab=orders');</script>
  </head>
  <body>
    <p><a href="/account/settings?tab=orders">Your orders are now in Your Account.</a></p>
  </body>
</html>
