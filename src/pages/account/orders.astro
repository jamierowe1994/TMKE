---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import "../../styles/workspace.css";
import "../../styles/ws-system.css";
import "../../styles/account-sections.css";
---

<!--
  Orders — the member's financial record. Rebuilt onto the shared hub system
  (ws-system.css): wine chapter strips, hairline square cards, one --ws-gap.

  Today this reads `orders` only — self-serve pack purchases from The Edit,
  which a member can read under their own RLS. Raised invoices (videography,
  social media management) live in `invoices`, which is admin-policy-only, so
  they cannot be shown here until that access decision is made. The markup is
  built for the merge: every row carries a type and its own action, so adding
  a second source is a second fetch and a concat, not a redesign.
-->
<BaseLayout
  dashboard
  title="Orders — TMKE workspace"
  description="Your full order history, invoices and receipts."
  hideNav
  hideFooter
>
  <div class="ws">
    <WorkspaceHeader active="orders" />
    <main class="ws-main">
      <div class="ws-left">

        <!-- ============ HERO ============ -->
        <section class="ws-hero ws-hero--sub ord-hero">
          <div class="ws-hero-copy">
            <p class="ws-hero-date"><a href="/account" class="back-link">&larr; Workspace</a></p>
            <h1 class="ws-greeting">Your Orders.</h1>
            <p class="ws-hero-sub">Every purchase and receipt in one place. Download what you have bought, and check back for anything still to settle.</p>
          </div>
          <div class="ws-hero-photo" role="img" aria-label="A styled interior"></div>
        </section>

        <!-- ============ Chapter 01 — the numbers ============ -->
        <section class="ws-block ws-rise" style="--i:1" aria-labelledby="ord-sum-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="ord-sum-h"><span class="ws-block-ch">Chapter 01</span>Summary</h2>
          </header>
          <div class="ord-stats">
            <div class="ord-stat">
              <div class="ord-stat-label">Total orders</div>
              <div class="ord-stat-value" id="o-count">&mdash;</div>
            </div>
            <div class="ord-stat">
              <div class="ord-stat-label">Lifetime spend</div>
              <div class="ord-stat-value" id="o-spend">&pound;0</div>
            </div>
            <div class="ord-stat">
              <div class="ord-stat-label">Last purchase</div>
              <div class="ord-stat-value" id="o-last">&mdash;</div>
            </div>
          </div>
        </section>

        <!-- ============ Chapter 02 — the list ============ -->
        <section class="ws-block ws-rise" style="--i:2" aria-labelledby="ord-list-h">
          <header class="ws-block-head">
            <h2 class="ws-block-h" id="ord-list-h"><span class="ws-block-ch">Chapter 02</span>All orders</h2>
            <a class="ws-block-link" href="/edit">Browse The Edit
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </header>
          <div id="orders-list" class="ord-list">
            <p class="ord-state">Loading orders&hellip;</p>
          </div>
        </section>

      </div>

      <footer class="app-foot dash-foot">
        <div class="app-foot-block">
          <div class="app-foot-tag">Help</div>
          <a href="/contact">hello@tmke.co.uk</a>
        </div>
        <div class="app-foot-block app-foot-block--right">
          <strong id="footer-email" class="dash-foot-email">&hellip;</strong>
        </div>
      </footer>
    </main>
  </div>

  <style is:global>
    .ord-hero { --ws-hero-img: url('/assets/sitting%20chair.jpg'); }

    /* ---- Chapter 01: the numbers. Outline, square, no fill — house rule. ---- */
    .ord-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--ws-gap); }
    @media (max-width: 720px) { .ord-stats { grid-template-columns: 1fr; } }
    .ord-stat {
      padding: 20px 22px 18px; background: #fff;
      border: 1px solid var(--ws-line); border-radius: var(--ws-r);
      transition: border-color 0.2s var(--ws-ease), transform 0.2s var(--ws-ease);
    }
    .ord-stat:hover { transform: translateY(-2px); border-color: rgba(28,29,34,0.28); }
    .ord-stat-label { font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); }
    .ord-stat-value { font-family: var(--serif); font-size: clamp(26px, 2.6vw, 34px); font-weight: 400; letter-spacing: -0.015em; margin-top: 8px; color: var(--ws-ink); line-height: 1.05; }

    /* ---- Chapter 02: one row per order. A row is a card, not a table line, so
       a future invoice row can carry a different action without the columns
       having to agree. ---- */
    .ord-list { display: flex; flex-direction: column; gap: var(--ws-gap); }
    .ord-row {
      display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: center;
      padding: 16px 18px; background: #fff;
      border: 1px solid var(--ws-line); border-radius: var(--ws-r);
      text-decoration: none; color: var(--ws-ink);
      transition: border-color 0.2s var(--ws-ease), transform 0.2s var(--ws-ease);
    }
    .ord-row:hover { transform: translateY(-2px); border-color: rgba(28,29,34,0.28); }
    .ord-row-main { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .ord-row-top { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; }
    .ord-type {
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--ws-accent);
      border: 1px solid color-mix(in srgb, var(--ws-accent) 34%, transparent);
      border-radius: 3px; padding: 3px 7px;
    }
    /* Row name — the admin centre's .vid-card-name (14px/700 sans). These
       pages don't carry .hub-skin, so the values are written out rather than
       inherited; they are the same numbers. */
    .ord-title { font-family: var(--sans); font-size: var(--ws-t-row); font-weight: 700; letter-spacing: 0; line-height: 1.25; }
    .ord-meta { font-size: var(--ws-t-meta); line-height: 1.45; color: var(--ws-tx); }
    .ord-meta b { font-weight: 600; color: var(--ws-ink); font-variant-numeric: tabular-nums; }
    .ord-row-side { display: flex; align-items: center; gap: 16px; flex-shrink: 0; }
    .ord-amount { font-family: var(--serif); font-size: var(--ws-t-title, 17px); font-weight: 400; letter-spacing: -0.01em; font-variant-numeric: tabular-nums; }
    .ord-pill {
      font-family: var(--sans); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; padding: 4px 9px; border-radius: 999px; white-space: nowrap;
      background: rgba(63,148,104,0.12); color: #2f6f4d; border: 1px solid rgba(63,148,104,0.3);
    }
    .ord-pill--due { background: rgba(201,122,58,0.12); color: #8a4d1f; border-color: rgba(201,122,58,0.32); }
    .ord-pill--other { background: rgba(28,29,34,0.05); color: var(--ws-tx); border-color: var(--ws-line); }
    .ord-go { font-size: var(--ws-t-row); color: var(--ws-faint); transition: transform 0.25s var(--ws-ease), color 0.2s; }
    .ord-row:hover .ord-go { transform: translateX(4px); color: var(--ws-accent); }
    @media (max-width: 720px) {
      .ord-row { grid-template-columns: 1fr; }
      .ord-row-side { justify-content: space-between; }
    }

    /* Empty / loading / error all share one quiet card. */
    .ord-state {
      margin: 0; padding: 32px; background: #fff;
      border: 1px solid var(--ws-line); border-radius: var(--ws-r);
      font-size: var(--ws-t-row); line-height: 1.6; color: var(--ws-tx);
    }
    /* Empty/error headline — the admin centre's .vid-panel-title (26px/400). */
    .ord-state strong { display: block; font-family: var(--serif); font-size: var(--ws-t-panel); font-weight: 400; letter-spacing: 0.01em; color: var(--ws-ink); margin-bottom: 6px; }
  </style>

  <script>
    import { supabase, gbpFromPence, signOutEverywhere} from '../../lib/supabase.js';

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }
    function formatDate(iso) {
      try { return new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); }
      catch (_) { return ''; }
    }
    const METHOD = { apple_pay: 'Apple Pay', google_pay: 'Google Pay', card: 'Card', bank_transfer: 'Bank transfer' };

    // Paid is the settled state; anything owed is the one worth colouring
    // differently, because it is the only row a member has to act on.
    function pillClass(status) {
      if (status === 'paid') return '';
      if (status === 'due' || status === 'sent' || status === 'overdue' || status === 'pending') return ' ord-pill--due';
      return ' ord-pill--other';
    }

    async function signOut() { await signOutEverywhere(); }
    document.getElementById('app-signout')?.addEventListener('click', signOut);
    document.getElementById('app-signout-foot')?.addEventListener('click', signOut);

    (async () => {
      const isDemo = import.meta.env.DEV;
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        if (!isDemo) location.replace('/login?next=' + encodeURIComponent('/account/orders'));
        return;
      }
      // getSession() is local-only - a cleared/revoked session can still look
      // valid to it. Confirm with the server before letting anyone in.
      if (!isDemo) {
        const { data: { user }, error } = await supabase.auth.getUser();
        if (!user || error) { location.replace('/login?next=' + encodeURIComponent('/account/orders')); return; }
      }

      const email = session.user.email ?? '';
      const $email = document.getElementById('footer-email');
      if ($email) $email.textContent = email;

      const { data: orders, error } = await supabase
        .from('orders')
        .select('id, pack_slug, pack_title, amount_pence, invoice_number, status, payment_method, created_at, buyer_company')
        .or(`user_id.eq.${session.user.id},buyer_email.eq.${email}`)
        .order('created_at', { ascending: false });

      const $list = document.getElementById('orders-list');

      if (error) {
        $list.innerHTML = `<p class="ord-state"><strong>Couldn't load your orders.</strong>${escapeHtml(error.message)}</p>`;
        return;
      }

      const list = orders || [];
      const paid = list.filter((o) => o.status === 'paid');
      const totalSpend = paid.reduce((a, o) => a + (o.amount_pence || 0), 0);
      const last = list[0];

      document.getElementById('o-count').textContent = String(list.length);
      document.getElementById('o-spend').textContent = gbpFromPence(totalSpend) || '£0';
      document.getElementById('o-last').textContent = last ? formatDate(last.created_at) : '—';

      if (list.length === 0) {
        $list.innerHTML = `
          <p class="ord-state">
            <strong>No orders yet.</strong>
            When you buy a pack from The Edit, the receipt will live here.
          </p>`;
        return;
      }

      $list.innerHTML = list.map((o) => `
        <a class="ord-row" href="/account/orders/receipt?order=${encodeURIComponent(o.id)}">
          <span class="ord-row-main">
            <span class="ord-row-top">
              <span class="ord-type">Pack</span>
              <span class="ord-title">${escapeHtml(o.pack_title || 'Order')}</span>
            </span>
            <span class="ord-meta">
              <b>${escapeHtml(o.invoice_number || '—')}</b>
              &nbsp;·&nbsp; ${formatDate(o.created_at)}
              ${o.payment_method ? `&nbsp;·&nbsp; ${escapeHtml(METHOD[o.payment_method] || o.payment_method)}` : ''}
            </span>
          </span>
          <span class="ord-row-side">
            <span class="ord-amount">${gbpFromPence(o.amount_pence)}</span>
            <span class="ord-pill${pillClass(o.status)}">${escapeHtml(o.status)}</span>
            <span class="ord-go" aria-hidden="true">&rarr;</span>
          </span>
        </a>
      `).join('');
    })();
  </script>
</BaseLayout>
