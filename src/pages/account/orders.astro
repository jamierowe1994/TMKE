---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import "../../styles/workspace.css";
import "../../styles/account-sections.css";
---

<BaseLayout
  dashboard
  title="Orders — TMKE workspace"
  description="Your full order history, invoices and receipts."
  hideNav
  hideFooter
>
  <WorkspaceHeader active="orders" />
  <div class="dash-shell dash-shell--top">
    <main class="app-main dash-main">
    <section class="dash-hero">
      <div class="dash-hero-copy">
        <p class="welcome-eyebrow"><a href="/account" class="back-link">&larr; Workspace</a></p>
        <h1 class="welcome-h">Your <em>orders.</em></h1>
        <p class="welcome-sub">Every purchase, invoice and receipt — sortable, downloadable.</p>
      </div>
      <figure class="dash-hero-media">
        <img src="/assets/sitting%20chair.jpg" alt="" loading="eager" />
      </figure>
    </section>

    <!-- Summary strip -->
    <section class="orders-summary">
      <div class="o-stat">
        <div class="o-stat-label">Total orders</div>
        <div class="o-stat-value" id="o-count">—</div>
      </div>
      <div class="o-stat">
        <div class="o-stat-label">Lifetime spend</div>
        <div class="o-stat-value" id="o-spend">£0</div>
      </div>
      <div class="o-stat">
        <div class="o-stat-label">Last purchase</div>
        <div class="o-stat-value" id="o-last">—</div>
      </div>
    </section>

    <!-- Orders table -->
    <section class="orders-section">
      <header class="section-head">
        <h2 class="section-h">All orders</h2>
        <p class="section-sub">Click any invoice number to view the full receipt.</p>
      </header>
      <div id="orders-list" class="orders-list">
        <div class="lib-state" style="padding:18px 22px;">Loading orders…</div>
      </div>
    </section>

    <footer class="app-foot dash-foot">
      <div class="app-foot-block">
        <div class="app-foot-tag">Help</div>
        <a href="/contact">hello@tmke.co.uk</a>
      </div>
      <div class="app-foot-block app-foot-block--right">
        <strong id="footer-email" class="dash-foot-email">&hellip;</strong>
      </div>
    </footer>
    </main>
  </div>

  <!-- Left-edge Calendar tab + month-view drawer.
       Same component as on /account. Click the tab → drawer slides in
       from the left. Click a day in the drawer → deep-links to the
       full /account/schedule page focused on that day. -->
  <button type="button" class="cal-tab" id="cal-tab-trigger" aria-haspopup="dialog" aria-controls="cal-popup">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2"/>
      <line x1="16" y1="2" x2="16" y2="6"/>
      <line x1="8" y1="2" x2="8" y2="6"/>
      <line x1="3" y1="10" x2="21" y2="10"/>
    </svg>
    <span class="cal-tab-label">Calendar</span>
    <span class="cal-tab-count" id="cal-tab-count" hidden>0</span>
  </button>

  <div class="cal-popup-backdrop" id="cal-popup" hidden role="dialog" aria-modal="true" aria-labelledby="cal-popup-title">
    <aside class="cal-popup" aria-label="Content calendar">
      <header class="cal-popup-head">
        <h2 class="cal-popup-title" id="cal-popup-title">—</h2>
        <div class="cal-popup-controls">
          <button type="button" class="cal-popup-nav" id="cal-popup-prev" aria-label="Previous month">&larr;</button>
          <button type="button" class="cal-popup-today" id="cal-popup-today">Today</button>
          <button type="button" class="cal-popup-nav" id="cal-popup-next" aria-label="Next month">&rarr;</button>
        </div>
        <a href="/account/schedule" class="cal-popup-expand">Open full &rarr;</a>
        <button type="button" class="cal-popup-close" id="cal-popup-close" aria-label="Close">&times;</button>
      </header>
      <div class="cal-popup-weekhead" aria-hidden="true">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
      </div>
      <div id="cal-popup-grid" class="cal-popup-grid" role="grid" aria-labelledby="cal-popup-title"></div>
      <p id="cal-popup-state" class="cal-popup-state" hidden></p>
    </aside>
  </div>

  <style is:global>
    /* Shared workspace shell (header, footer, welcome, section heads,
       order rows, etc.) lives in src/styles/workspace.css. Only the
       orders-page-specific summary cards stay here. */

    .orders-summary {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    @media (max-width: 720px) { .orders-summary { grid-template-columns: 1fr; } }
    .o-stat {
      padding: 24px 26px 20px;
      background: var(--card-glass);
      -webkit-backdrop-filter: var(--card-blur);
      backdrop-filter: var(--card-blur);
      border: 1px solid rgba(28,29,34,0.06);
      border-top: 3px solid var(--violet-deep);
      border-radius: 8px;
      box-shadow:
        0 10px 24px -14px rgba(var(--violet-rgb), 0.22),
        0 2px 6px -3px rgba(28, 29, 34, 0.10);
      transition: transform 0.3s cubic-bezier(.2,.7,.2,1), box-shadow 0.25s;
    }
    .o-stat:hover {
      transform: translateY(-3px);
      box-shadow:
        0 18px 38px -14px rgba(var(--violet-rgb), 0.30),
        0 6px 14px -8px rgba(28, 29, 34, 0.18);
    }
    .o-stat-label {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--dash-accent-ink-soft);
    }
    .o-stat-value {
      font-family: var(--serif);
      font-size: 40px;
      letter-spacing: -0.015em;
      margin-top: 8px;
      color: var(--dash-accent-ink);
    }
    /* Order stat cards sit on the solid accent (theme-picker driven) + ink. */
    .o-stat { background: var(--dash-accent); border-color: rgba(255, 255, 255, 0.16); }
  </style>

  <script>
    import { supabase, gbpFromPence } from '../../lib/supabase.js';

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }
    function formatDate(iso) {
      try { return new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' }); }
      catch (_) { return ''; }
    }

    async function signOut() {
      await supabase.auth.signOut();
      location.replace('/login');
    }
    document.getElementById('app-signout')?.addEventListener('click', signOut);
    document.getElementById('app-signout-foot')?.addEventListener('click', signOut);

    (async () => {
      const isDemo = import.meta.env.DEV && location.search.includes('demo=1');
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        if (!isDemo) location.replace('/login?next=' + encodeURIComponent('/account/orders'));
        return;
      }

      const email = session.user.email ?? '';
      document.getElementById('footer-email').textContent = email;

      const { data: orders, error } = await supabase
        .from('orders')
        .select('id, pack_slug, pack_title, amount_pence, invoice_number, status, payment_method, created_at, buyer_company')
        .or(`user_id.eq.${session.user.id},buyer_email.eq.${email}`)
        .order('created_at', { ascending: false });

      const $list = document.getElementById('orders-list');

      if (error) {
        $list.innerHTML = `<div class="lib-state" style="padding:18px 22px;">Couldn't load orders: ${escapeHtml(error.message)}</div>`;
        return;
      }

      const list = orders || [];
      const paid = list.filter((o) => o.status === 'paid');
      const totalSpend = paid.reduce((a, o) => a + (o.amount_pence || 0), 0);
      const last = list[0];

      document.getElementById('o-count').textContent = String(list.length);
      document.getElementById('o-spend').textContent = gbpFromPence(totalSpend) || '£0';
      document.getElementById('o-last').textContent = last ? formatDate(last.created_at) : '—';

      if (list.length === 0) {
        $list.innerHTML = `
          <div class="lib-state" style="padding:32px;">
            <strong style="display:block;font-family:var(--serif);font-size:24px;color:var(--ink);margin-bottom:6px;">No orders yet.</strong>
            <p style="margin:0;line-height:1.6;">When you purchase a pack from The Edit, the invoice will live here.</p>
          </div>`;
        return;
      }

      $list.innerHTML = `
        <div class="order-row order-row-head">
          <span>Invoice</span>
          <span>Pack</span>
          <span>Method</span>
          <span>Date</span>
          <span>Amount</span>
          <span>Status</span>
        </div>
        ${list.map((o) => `
          <div class="order-row">
            <span class="order-invoice"><a href="/edit/thanks?order=${encodeURIComponent(o.id)}">${escapeHtml(o.invoice_number || '—')}</a></span>
            <span>${escapeHtml(o.pack_title)}</span>
            <span>${({ apple_pay: 'Apple Pay', google_pay: 'Google Pay', card: 'Card' }[o.payment_method] || o.payment_method)}</span>
            <span>${formatDate(o.created_at)}</span>
            <span>${gbpFromPence(o.amount_pence)}</span>
            <span><span class="pill">${escapeHtml(o.status)}</span></span>
          </div>
        `).join('')}
      `;

      // Update the order-row grid for the extra Amount column.
      const style = document.createElement('style');
      style.textContent = `
        .order-row { grid-template-columns: 1.1fr 1.2fr 0.8fr 0.9fr 0.7fr 0.6fr; }
        @media (max-width: 720px) {
          .order-row { grid-template-columns: 1fr 1fr; }
          .order-row-head { display: none; }
        }
      `;
      document.head.appendChild(style);
    })();

    // ====== Calendar drawer (left-tab → month view) ======
    // Drawer-only variant of the calendar bootstrap on /account — no
    // week strip here. Self-contained so an orders-page failure can't
    // break /account and vice versa. Shares /lib/calendar.js helpers
    // and the workspace.css drawer styles.
    (async function calendarDrawerBootstrap() {
      const cal = await import('../../lib/calendar.js');

      const $tab        = document.getElementById('cal-tab-trigger');
      const $popup      = document.getElementById('cal-popup');
      const $popupClose = document.getElementById('cal-popup-close');
      const $popupPrev  = document.getElementById('cal-popup-prev');
      const $popupNext  = document.getElementById('cal-popup-next');
      const $popupToday = document.getElementById('cal-popup-today');
      const $popupTitle = document.getElementById('cal-popup-title');
      const $popupGrid  = document.getElementById('cal-popup-grid');
      const $popupState = document.getElementById('cal-popup-state');
      const $tabCount   = document.getElementById('cal-tab-count');

      if (!$tab || !$popup) return;

      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return;

      let popupMonth = cal.startOfMonth(new Date());
      let items = [];
      let holidays = [];
      let loadedRange = null;

      async function loadWindow() {
        const winStart = cal.addMonths(popupMonth, -2);
        const winEnd   = cal.addMonths(popupMonth, 3);
        const fromYmd  = cal.ymd(winStart);
        const toYmd    = cal.ymd(new Date(winEnd.getFullYear(), winEnd.getMonth(), 0));
        const { items: ii, holidays: hh, itemsError } = await cal.fetchCalendarWindow(supabase, fromYmd, toYmd);
        items = ii;
        holidays = hh;
        loadedRange = { fromYmd, toYmd };
        if (itemsError && /relation .* does not exist/i.test(itemsError)) {
          $popupState.hidden = false;
          $popupState.textContent = "Calendar table not found — run supabase/calendar.sql first.";
        } else {
          $popupState.hidden = true;
        }
        updateBadge();
      }

      async function ensureLoaded() {
        if (!loadedRange) { await loadWindow(); return; }
        const refYmd = cal.ymd(popupMonth);
        if (refYmd < loadedRange.fromYmd || refYmd > loadedRange.toYmd) {
          await loadWindow();
        }
      }

      function updateBadge() {
        // Count posts in the current week that are still pending.
        const today = new Date();
        const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());
        const weekStart = cal.defaultUpcomingWeekStart(today);
        const weekStartYmd = cal.ymd(weekStart);
        const weekEndYmd = cal.ymd(cal.addDays(weekStart, 7));
        const upcoming = items.filter((p) => {
          if (p.status !== 'scheduled' && p.status !== 'reminder_sent') return false;
          if (p.scheduled_date < weekStartYmd || p.scheduled_date >= weekEndYmd) return false;
          const pTs = new Date(`${p.scheduled_date}T${p.scheduled_time || '09:00'}`);
          return pTs >= todayStart;
        });
        if (upcoming.length === 0) { $tabCount.hidden = true; return; }
        $tabCount.hidden = false;
        $tabCount.textContent = String(upcoming.length);
      }

      function renderDrawer() {
        $popupTitle.textContent = cal.fmtMonthYear(popupMonth);
        const first = cal.startOfMonth(popupMonth);
        const dow = (first.getDay() + 6) % 7;
        const start = new Date(first);
        start.setDate(first.getDate() - dow);

        const itemsByDate    = cal.bucketBy(items,    (i) => i.scheduled_date);
        const holidaysByDate = cal.bucketBy(holidays, (h) => h.date);

        const today = new Date();
        const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());

        const cells = [];
        for (let i = 0; i < 42; i++) {
          const d = new Date(start);
          d.setDate(start.getDate() + i);
          const key       = cal.ymd(d);
          const isOther   = d.getMonth() !== popupMonth.getMonth();
          const isToday   = cal.sameDay(d, todayStart);
          const dayItems  = itemsByDate.get(key) || [];
          const dayHols   = holidaysByDate.get(key) || [];

          const visibleHols  = dayHols.slice(0, 1);
          const visiblePosts = dayItems.slice(0, 2 - visibleHols.length);
          const hiddenCount  = (dayHols.length - visibleHols.length) + (dayItems.length - visiblePosts.length);

          const cls = [
            'cal-popup-day',
            isOther ? 'is-other-month' : '',
            isToday ? 'is-today' : '',
          ].filter(Boolean).join(' ');

          const holsHtml = visibleHols.map((h) =>
            `<span class="cal-popup-chip cal-popup-chip--${h.kind === 'bank' ? 'bank' : 'aware'}" title="${cal.escapeHtml(h.name)}">${cal.escapeHtml(h.name)}</span>`
          ).join('');
          const postsHtml = visiblePosts.map((p) => {
            const sClass = p.status === 'done' ? 'is-done'
              : p.status === 'reminder_sent' ? 'is-sent'
              : p.status === 'cancelled' ? 'is-cancelled' : '';
            return `<span class="cal-popup-chip cal-popup-chip--post ${sClass}" title="${cal.escapeHtml(p.title)}">${cal.escapeHtml(p.title)}</span>`;
          }).join('');
          const moreHtml = hiddenCount > 0 ? `<span class="cal-popup-day-more">+${hiddenCount}</span>` : '';

          cells.push(`
            <button type="button" class="${cls}" data-date="${key}" role="gridcell">
              <span class="cal-popup-day-num">${d.getDate()}</span>
              ${holsHtml}
              ${postsHtml}
              ${moreHtml}
            </button>
          `);
        }
        $popupGrid.innerHTML = cells.join('');
      }

      let popupCloseTimer = null;
      function openPopup() {
        renderDrawer();
        $popup.hidden = false;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => {
          requestAnimationFrame(() => $popup.classList.add('is-open'));
        });
      }
      function closePopup() {
        if (!$popup.classList.contains('is-open')) {
          $popup.hidden = true;
          document.body.style.overflow = '';
          return;
        }
        $popup.classList.remove('is-open');
        clearTimeout(popupCloseTimer);
        popupCloseTimer = setTimeout(() => {
          $popup.hidden = true;
          document.body.style.overflow = '';
        }, 580);
      }

      $tab.addEventListener('click', openPopup);
      $popupClose.addEventListener('click', closePopup);
      $popup.addEventListener('click', (e) => { if (e.target === $popup) closePopup(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !$popup.hidden) closePopup();
      });
      $popupPrev.addEventListener('click', async () => {
        popupMonth = cal.addMonths(popupMonth, -1);
        await ensureLoaded();
        renderDrawer();
      });
      $popupNext.addEventListener('click', async () => {
        popupMonth = cal.addMonths(popupMonth, 1);
        await ensureLoaded();
        renderDrawer();
      });
      $popupToday.addEventListener('click', async () => {
        popupMonth = cal.startOfMonth(new Date());
        await ensureLoaded();
        renderDrawer();
      });
      $popupGrid.addEventListener('click', (e) => {
        const cell = e.target.closest('.cal-popup-day');
        if (!cell) return;
        const dateStr = cell.getAttribute('data-date');
        if (dateStr) location.href = '/account/schedule?focus=' + encodeURIComponent(dateStr);
      });

      try { await loadWindow(); } catch (err) { console.warn('[calendar drawer]', err); }
    })();
  </script>
</BaseLayout>
