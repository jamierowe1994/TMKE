---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../../components/account/WorkspaceHeader.astro";
import "../../../styles/workspace.css";
import "../../../styles/ws-system.css";
---

<!--
  A client's monthly report, told the way the courses are: a cover, one idea a
  slide, Previous / Next, and a finish. It used to be a grid of tiles behind
  three tabs on the Socials page, which asked the client to do the reading of
  it themselves. Here the order does that work — the numbers, where you were
  seen, how it's moving, what did best, then what we make of it and what we're
  doing next (evidence first, conclusion after: docs/smm-report-rules.md §2).

  Its own page, ?r=<report id>, so the "your report is ready" email can link
  straight to it. ?sample=<demo id> shows a prospect the sample.
-->
<BaseLayout title="Your monthly report · TMKE" description="Your social media report for the month." dashboard hideNav hideFooter>
  <div class="ws">
    <WorkspaceHeader active="social" />
    <main class="ws-main rp-main">
      <a class="rp-back" href="/account/social" id="rp-back">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg> Back to your socials
      </a>

      <p class="rp-state" id="rp-loading">Loading your report&hellip;</p>
      <div class="rp-empty" id="rp-empty" hidden>
        <p class="rp-state">We couldn&rsquo;t find that report. It may have been replaced by a newer one.</p>
        <a class="ws-btn ws-btn--primary ws-btn--sm" href="/account/social">Back to your socials</a>
      </div>

      <div class="rp" id="rp" hidden>
        <div class="rp-progress">
          <div class="rp-bar"><span class="rp-fill" id="rp-fill"></span></div>
          <div class="rp-progress-meta"><span id="rp-step">Your monthly report</span><span id="rp-count"></span></div>
        </div>

        <div class="rp-stage" id="rp-stage" aria-live="polite"></div>

        <footer class="rp-nav" id="rp-nav" hidden>
          <button type="button" class="ws-btn ws-btn--ghost" id="rp-prev">
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 4L6 8l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Previous
          </button>
          <div class="rp-rail" id="rp-rail"></div>
          <button type="button" class="ws-btn ws-btn--primary" id="rp-next">
            <span id="rp-next-label">Next</span>
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </footer>
      </div>
    </main>
  </div>

  <style is:global>
    /* The hub's own margins (.ws-main), without its gap between blocks —
       that gap was the space under "Back to your socials". */
    .rp-main { gap: 0; padding-bottom: 18px; }
    .rp-back { display: inline-flex; align-items: center; gap: 6px; margin: 0 0 8px; justify-self: start; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ws-tx); text-decoration: none; }
    .rp-back svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; }
    .rp-back:hover { color: var(--ws-accent); }
    .rp-state { font-family: var(--sans); font-size: var(--ws-t-body); color: var(--ws-faint); line-height: 1.6; margin: 0 0 14px; }
    .rp-empty[hidden], .rp[hidden], .rp-nav[hidden] { display: none; }

    /* Scales with the window. One size is set here — from the smaller of
       the window's width and height, so a wide but short laptop screen
       doesn't overflow — and everything inside is measured in em from it:
       14px on a 1440 × 900 screen, 17–18px on a 1920 × 1080 monitor, up to
       21px on a large display. */
    .rp { font-size: clamp(12.5px, min(0.98vw, 1.58vh), 21px); font-family: var(--sans); }
    /* A phone reads the report scrolling, not a screen at a time, so it gets
       a size for reading rather than one worked out from the window. Most
       clients will open it from the email, on their phone. */
    @media (max-width: 720px) {
      .rp { font-size: 15px; }
      /* Side by side on a phone: labels in a row line up at the top, and the
         figures are sized to fit half the screen. */
      .rp-figs.rp-grow .rp-fig { justify-content: flex-start; padding: 1.1em 0; }
      .rp-figs.rp-grow .rp-fig-val { font-size: 2.2em; }
      .rp-reach { grid-template-columns: 1fr 1fr; }
      .rp-reach-why { grid-column: 1 / -1; }
      .rp-chips { gap: 0.6em; }
      .rp-chip b { font-size: 1.45em; }
      /* Top five on a phone: picture, title, and the figures as one line
         under it, rather than a table to swipe across. */
      .rp-topcard .rp-tblwrap { overflow: visible; }
      .rp-tblwrap .rp-tbl { min-width: 0; width: 100%; table-layout: auto; }
      .rp-tblwrap .rp-tbl thead, .rp-tblwrap .rp-tbl colgroup, .rp-tblwrap .rp-tbl td.rp-c { display: none; }
      .rp-tblwrap .rp-tbl td { padding: 0.55em 0.4em; }
      .rp-tblwrap .rp-tbl td.rp-rank { width: 1.4em; }
      .rp-tblwrap .rp-tbl td:nth-child(2) { width: 3.1em; }
      .rp-top-t a, .rp-top-t .rp-t { max-width: 100%; }
      .rp-tbl .rp-top-t .rp-top-m { display: block; margin-top: 0.3em; font-size: 0.8em; font-weight: 400; color: var(--ws-tx); white-space: normal; }
      .rp-part { padding: 1.4em 1.2em; }
      .rp-mini { padding: 1em 1.05em; }
    }
    .rp .ws-btn { font-size: 0.86em; height: 2.9em; padding: 0 1.2em; }
    .rp .ws-btn svg { width: 1.05em; height: 1.05em; }

    /* Progress, as the courses have it. */
    .rp-progress { margin: 0 0 0.7em; }
    .rp-bar { height: 4px; border-radius: 999px; background: var(--ws-line); overflow: hidden; }
    .rp-fill { display: block; height: 100%; width: 0; border-radius: 999px; background: var(--ws-accent); transition: width .55s cubic-bezier(.2,.7,.3,1); }
    .rp-progress-meta { display: flex; justify-content: space-between; margin-top: 0.45em; font-size: 0.86em; font-weight: 600; letter-spacing: 0.02em; color: var(--ws-faint); }
    #rp-step { color: var(--ws-tx); }

    /* One screen on desktop: the deck runs from under the header to the
       bottom of the window, the slide takes whatever the progress bar and
       the buttons leave, and a slide that still has more than that scrolls
       inside its own card rather than moving the page. */
    .rp:not([hidden]) { display: flex; flex-direction: column; height: calc(100dvh - var(--rp-top, 150px) - 18px); min-height: 480px; }
    .rp-stage { flex: 1 1 auto; min-height: 0; display: flex; flex-direction: column; }
    .rp-stage > .rp-slide { flex: 1 1 auto; min-height: 0; overflow-y: auto; scrollbar-width: thin; }
    .rp-stage > .rp-done { display: flex; flex-direction: column; justify-content: center; }
    @media (max-width: 720px) {
      .rp:not([hidden]) { height: auto; min-height: 0; }
      .rp-stage > .rp-slide { overflow: visible; }
    }
    .rp-slide { animation: rpIn .42s cubic-bezier(.2,.7,.3,1); }
    @keyframes rpIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) { .rp-slide { animation: none; } .rp-fill { transition: none; } }

    /* ---- Cover: the Socials banner, the month in a wine card over it ---- */
    .rp-cover { position: relative; padding: 2em; border-radius: 6px; border: 1px solid var(--ws-line); overflow: hidden; background: #e6e3e1 url('/assets/hub/smm.jpg') center / cover no-repeat; display: flex; align-items: flex-start; }
    .rp-cover-card { width: min(52%, 46em); max-width: 100%; padding: 2.3em; background: var(--english-violet, #4a2a3c); color: #fff; border-radius: 6px; }
    @media (max-width: 900px) { .rp-cover-card { width: 100%; } }
    .rp-eyebrow { font-size: 0.78em; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-accent); margin: 0 0 0.9em; }
    .rp-cover-card .rp-eyebrow { color: rgba(255,255,255,0.72); }
    .rp-cover-title { font-family: var(--serif); font-weight: 500; font-size: 3.1em; line-height: 1.04; letter-spacing: -0.02em; color: #fff; margin: 0; }
    .rp-cover-sub { font-size: 1em; line-height: 1.6; color: rgba(255,255,255,0.84); margin: 0.8em 0 0; }
    .rp-cover-upd { display: inline-block; margin: 0.9em 0 0; padding: 0.35em 0.8em; border-radius: var(--ws-r, 4px); background: rgba(255,255,255,0.14); font-size: 0.8em; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #fff; }
    .rp-contents { list-style: none; margin: 1.5em 0 0; padding: 1.1em 0 0; border-top: 1px solid rgba(255,255,255,0.16); display: grid; gap: 0.5em; counter-reset: rp; }
    .rp-contents li { counter-increment: rp; display: flex; gap: 0.85em; font-size: 0.93em; color: rgba(255,255,255,0.9); }
    .rp-contents li::before { content: counter(rp, decimal-leading-zero); font-weight: 700; color: rgba(255,255,255,0.5); font-variant-numeric: tabular-nums; }
    .rp-contents button { all: unset; cursor: pointer; }
    .rp-contents button:hover, .rp-contents button:focus-visible { text-decoration: underline; text-underline-offset: 3px; }
    .rp-cover-start { margin-top: 1.7em; display: flex; justify-content: flex-end; }
    .rp-cover-card .ws-btn--primary { background: #fff; color: var(--english-violet, #4a2a3c); }
    .rp-cover-card .ws-btn--primary:hover { background: var(--paper, #f4f2f1); }

    /* ---- A part: one card, one idea ---- */
    .rp-part { background: var(--ws-card, #fff); border: 1px solid var(--ws-line); border-radius: var(--ws-r-lg, 6px); padding: 1.9em 2.4em; box-shadow: var(--ws-sh); display: flex; flex-direction: column; }
    /* The body takes the card's remaining height, so a slide can spread its
       content to the foot of the card rather than stopping short. */
    .rp-part > .rp-body { flex: 1 0 auto; display: flex; flex-direction: column; }
    .rp-title { font-family: var(--serif); font-weight: 500; font-size: 2.35em; line-height: 1.08; letter-spacing: -0.02em; color: var(--ws-ink); margin: 0; text-wrap: balance; }
    .rp-lede { font-size: 1em; line-height: 1.6; color: var(--ws-tx); margin: 0.6em 0 0; }
    .rp-body { margin-top: 1.5em; }
    .rp-label { font-size: 0.72em; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 0 0 0.9em; }

    /* A small card inside a slide. */
    .rp-mini { border: 1px solid var(--ws-line); border-radius: var(--ws-r, 4px); padding: 1.15em 1.3em; background: #fff; min-width: 0; }
    .rp-mini-h { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 1.07em; font-weight: 700; color: var(--english-violet, #4a2a3c); margin: 0 0 0.45em; }
    /* What did best's card titles in wine: that slide has no other colour
       and they were getting lost. */
    .rp-best .rp-label { color: var(--english-violet, #4a2a3c); }
    .rp-mini-p { font-size: 0.93em; line-height: 1.55; color: var(--ws-tx); margin: 0; }
    .rp-cards { display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); gap: 1em; }
    @media (max-width: 900px) { .rp-cards { grid-template-columns: 1fr; } }

    /* The numbers: three to a row. The explanation under each is written to
       two lines and given two lines' height, so the rows read as blocks. */
    .rp-figs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 2.2em; border-top: 1px solid var(--ws-line); }
    @media (max-width: 720px) { .rp-figs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .rp-fig { padding: 1.15em 0; border-bottom: 1px solid var(--ws-line); }
    .rp-fig-val { font-family: var(--serif); font-size: 2.6em; font-weight: 400; letter-spacing: -0.02em; line-height: 1; color: var(--ws-ink); font-variant-numeric: tabular-nums; margin: 0.15em 0 0; }
    .rp-fig-move { font-size: 0.86em; font-weight: 700; color: var(--ws-accent); margin: 0.5em 0 0; }
    .rp-fig-means { font-size: 0.86em; line-height: 1.45; color: var(--ws-tx); margin: 0.35em 0 0; max-width: 30ch; min-height: 2.9em; }

    /* A block that takes the slide's spare height, so the content spreads to
       the foot of the card rather than stopping in its top half. */
    /* Grows into the slide's spare height, never below its own content (a
       short screen scrolls inside the card instead). */
    .rp-grow { flex: 1 0 auto; width: 100%; }
    /* Rows at their natural height, then stretched to share what's left. */
    .rp-figs.rp-grow { align-content: stretch; }
    .rp-figs.rp-grow .rp-fig { display: flex; flex-direction: column; justify-content: center; padding: 1.4em 0; }
    .rp-figs.rp-grow .rp-fig-val { font-size: 3em; }
    .rp-cards.rp-grow { align-items: stretch; }
    .rp-cards.rp-grow > .rp-mini { display: flex; flex-direction: column; justify-content: center; padding: 1.6em 1.5em; }
    .rp-mini-note { margin: 0.9em 0 0; font-size: 0.78em; line-height: 1.45; color: var(--ws-faint); }
    /* Who you reached */
    /* The two figures take the left half; "Why two numbers?" the right half,
       out to the margin, centred on them. */
    .rp-reach { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 2fr); gap: 1em 2.6em; align-items: center; padding-bottom: 1.3em; margin-bottom: 1.3em; border-bottom: 1px solid var(--ws-line); }
    .rp-reach-why { margin: 0; padding: 1em 1.2em; border-left: 3px solid var(--english-violet, #4a2a3c); background: color-mix(in srgb, var(--english-violet, #4a2a3c) 5%, #fff); font-size: 0.93em; line-height: 1.55; color: var(--ws-tx); }
    .rp-reach-why b { color: var(--ws-ink); }
    @media (max-width: 900px) { .rp-reach { grid-template-columns: 1fr 1fr; } .rp-reach-why { grid-column: 1 / -1; } }
    .rp-big { font-family: var(--serif); font-size: 2.6em; line-height: 1; color: var(--ws-ink); font-variant-numeric: tabular-nums; margin-bottom: 0.2em; }
    .rp-splitbar { height: 0.55em; border-radius: 99px; background: color-mix(in srgb, var(--english-violet, #4a2a3c) 22%, #fff); overflow: hidden; margin: 1.1em 0 0.7em; }
    .rp-splitbar span { display: block; height: 100%; background: var(--english-violet, #4a2a3c); }
    .rp-splitkey { display: flex; justify-content: space-between; gap: 1em; font-size: 0.86em; color: var(--ws-tx); }
    .rp-splitkey i { display: inline-block; width: 0.65em; height: 0.65em; border-radius: 2px; margin-right: 0.4em; background: color-mix(in srgb, var(--english-violet, #4a2a3c) 22%, #fff); }
    .rp-splitkey i.is-f { background: var(--english-violet, #4a2a3c); }
    .rp-ages { display: grid; gap: 0.5em; }
    .rp-age { display: grid; grid-template-columns: 3.4em 1fr 2.6em; align-items: center; gap: 0.7em; font-size: 0.86em; color: var(--ws-tx); }
    .rp-age b { text-align: right; color: var(--ws-ink); font-variant-numeric: tabular-nums; }
    .rp-track { height: 0.6em; background: rgba(28,29,34,0.06); border-radius: 2px; overflow: hidden; }
    .rp-track i { display: block; height: 100%; background: var(--english-violet, #4a2a3c); border-radius: 2px; }
    .rp-cities { list-style: none; margin: 0; padding: 0; counter-reset: c; }
    .rp-cities li { counter-increment: c; display: flex; gap: 0.85em; padding: 0.5em 0; border-bottom: 1px solid var(--ws-line); font-size: 1em; color: var(--ws-ink); }
    .rp-cities li::before { content: counter(c); font-family: var(--serif); color: var(--ws-faint); width: 1.1em; }
    .rp-cities li span { flex: 1; }
    .rp-cities b { font-variant-numeric: tabular-nums; }

    /* What did best: the top five on a card of their own, reels and posts
       beside them. */
    /* Fills the slide top to bottom: the table's rows share out the height,
       and the reels and posts cards grow to match. */
    .rp-best { flex: 1; display: grid; grid-template-columns: minmax(0, 2.1fr) minmax(0, 1fr); gap: 1em; align-items: stretch; }
    .rp-topcard { display: flex; flex-direction: column; }
    .rp-topcard .rp-tblwrap { flex: 1; display: flex; }
    .rp-topcard .rp-tbl { height: 100%; }
    .rp-formats { grid-template-rows: 1fr 1fr; }
    .rp-format { display: flex; flex-direction: column; }
    .rp-format dl { flex: 1; align-content: space-evenly; }
    .rp-best.is-one { grid-template-columns: 1fr; }
    @media (max-width: 900px) { .rp-best { grid-template-columns: 1fr; } }
    .rp-formats { display: grid; gap: 1em; }
    .rp-format dl { margin: 0; display: grid; grid-template-columns: 1fr auto; gap: 0.5em 1em; font-size: 0.93em; }
    .rp-format dt { color: var(--ws-tx); }
    .rp-format dd { margin: 0; font-weight: 700; color: var(--ws-ink); text-align: right; font-variant-numeric: tabular-nums; }
    .rp-tblwrap { overflow-x: auto; }
    .rp-tbl { width: 100%; border-collapse: collapse; table-layout: fixed; min-width: 34em; font-size: 0.93em; }
    .rp-tbl col.rp-eq { width: 12%; }
    .rp-tbl th { text-align: left; font-size: 0.72em; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ws-faint); padding: 0 0.6em 0.7em; white-space: nowrap; }
    .rp-tbl td { padding: 0.5em 0.6em; border-top: 1px solid var(--ws-line); vertical-align: middle; color: var(--ws-ink); }
    .rp-tbl .rp-c { text-align: center; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .rp-rank { font-family: var(--serif); font-size: 1.2em; color: var(--ws-faint); padding-left: 0 !important; }
    .rp-thumb { display: block; width: 3.1em; height: 3.1em; object-fit: cover; border-radius: 3px; background: rgba(28,29,34,0.06); }
    .rp-top-t a { display: inline-flex; align-items: baseline; gap: 0.4em; max-width: 100%; color: var(--ws-ink); text-decoration: none; }
    .rp-t { font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; display: block; }
    .rp-go { flex: none; color: var(--ws-faint); }
    .rp-top-t a:hover .rp-t { color: var(--ws-accent); text-decoration: underline; text-underline-offset: 3px; }
    .rp-top-t a:hover .rp-go { color: var(--ws-accent); }
    .rp-top-m { display: none; }
    .rp-top-k { font-size: 0.78em; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-faint); }

    /* What it means: our words, then month against month. */
    /* What went up this month: tiles, squared off with the hub's corners. */
    .rp-ups { display: flex; flex-wrap: wrap; gap: 0.7em; margin-bottom: 1.4em; }
    .rp-up { display: flex; flex-direction: column; gap: 0.15em; padding: 0.75em 1.1em; border-radius: var(--ws-r, 4px); background: color-mix(in srgb, var(--english-violet, #4a2a3c) 7%, #fff); border: 1px solid color-mix(in srgb, var(--english-violet, #4a2a3c) 16%, #fff); }
    .rp-up b { font-family: var(--serif); font-size: 1.5em; font-weight: 400; line-height: 1.05; color: var(--english-violet, #4a2a3c); font-variant-numeric: tabular-nums; }
    .rp-up span { font-size: 0.78em; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ws-tx); }
    /* This month against last: the figure, the change once, last month's. */
    .rp-cmps { display: grid; grid-template-columns: repeat(var(--n, 5), minmax(0, 1fr)); gap: 1em; margin-bottom: 1.6em; }
    @media (max-width: 900px) { .rp-cmps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .rp-cmp .rp-label { margin-bottom: 0.5em; }
    .rp-cmp-now { font-family: var(--serif); font-size: 2em; line-height: 1.05; color: var(--ws-ink); font-variant-numeric: tabular-nums; }
    .rp-cmp-chg { display: block; margin-top: 0.45em; font-size: 0.86em; font-weight: 700; color: var(--ws-tx); }
    .rp-cmp-chg.is-up { color: var(--english-violet, #4a2a3c); }
    .rp-cmp-was { margin: 0.25em 0 0; font-size: 0.8em; color: var(--ws-faint); }
    .rp-cmp-line { display: block; width: 100%; height: auto; margin-top: 0.8em; overflow: visible; }
    /* Stat chips: squared off, not pills. */
    .rp-chips { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.8em; margin-bottom: 1.1em; }
    @media (max-width: 900px) { .rp-chips { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .rp-chip { display: flex; flex-direction: column; justify-content: center; gap: 0.3em; padding: 1.15em 1.3em; border-radius: var(--ws-r, 4px); background: color-mix(in srgb, var(--english-violet, #4a2a3c) 6%, #fff); border: 1px solid color-mix(in srgb, var(--english-violet, #4a2a3c) 14%, #fff); }
    .rp-chip-l { font-size: 0.72em; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-faint); }
    .rp-chip b { font-family: var(--serif); font-size: 1.7em; font-weight: 400; line-height: 1.05; color: var(--ws-ink); font-variant-numeric: tabular-nums; }
    .rp-chip-c { font-size: 0.82em; font-weight: 700; color: var(--ws-tx); }
    .rp-chip-c.is-up { color: var(--english-violet, #4a2a3c); }
    /* Insights: open columns under a wine rule, not boxes, so the page
       doesn't turn into a grid of cards. As many columns as insights. */
    .rp-insights { flex: 1 1 auto; display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); gap: 2.4em; align-content: center; padding: 0.6em 0 1em; }
    @media (max-width: 900px) { .rp-insights { grid-template-columns: 1fr; gap: 1.6em; } }
    .rp-insight { border-top: 2px solid var(--english-violet, #4a2a3c); padding-top: 1.3em; min-width: 0; }
    .rp-insight-k { color: var(--english-violet, #4a2a3c); margin-bottom: 0.7em; display: flex; align-items: center; gap: 0.7em; flex-wrap: wrap; }
    .rp-insight-early { font-size: 0.9em; letter-spacing: 0.1em; padding: 0.25em 0.6em; border-radius: var(--ws-r, 4px); background: color-mix(in srgb, var(--english-violet, #4a2a3c) 8%, #fff); color: var(--ws-tx); }
    .rp-insight-h { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 1.5em; font-weight: 700; line-height: 1.25; color: var(--ws-ink); margin: 0 0 0.55em; text-wrap: balance; }
    .rp-insight-p { font-size: 1.07em; line-height: 1.65; color: var(--ws-tx); margin: 0; }
    .rp-insight-ev { margin: 0.9em 0 0; font-size: 0.82em; font-weight: 700; line-height: 1.5; color: var(--english-violet, #4a2a3c); font-variant-numeric: tabular-nums; }
    .rp-prose { font-size: 1.1em; line-height: 1.7; color: var(--ws-ink); max-width: 70ch; white-space: pre-line; }
    .rp-trends { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1em; }
    @media (max-width: 900px) { .rp-trends { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .rp-trend-now { font-family: var(--serif); font-size: 1.85em; color: var(--ws-ink); line-height: 1.1; margin: 0.3em 0 0.4em; font-variant-numeric: tabular-nums; display: flex; align-items: baseline; gap: 0.5em; }
    .rp-trend-now span { font-family: var(--sans); font-size: 0.46em; font-weight: 700; color: var(--ws-accent); }
    .rp-trend svg { display: block; width: 100%; height: auto; overflow: visible; }
    .rp-trend-axis { display: flex; justify-content: space-between; font-size: 0.75em; color: var(--ws-faint); margin-top: 0.4em; }

    /* Into next month */
    .rp-takes .rp-mini-p { font-size: 1em; }
    /* The cards share the slide's spare height, so four sit as two even rows. */
    .rp-takes.rp-grow { align-content: stretch; }
    .rp-takes.rp-grow > .rp-mini { display: flex; flex-direction: column; justify-content: center; padding: 1em 1.4em; }
    .rp-coming { margin-top: 1em; }
    /* Questions, at the foot of the slide. Later: next month's content plan. */
    .rp-cta { margin-top: auto; display: flex; align-items: center; justify-content: space-between; gap: 1.6em; padding: 1.3em 1.5em; border-radius: var(--ws-r, 4px); background: var(--english-violet, #4a2a3c); color: #fff; }
    .rp-takes, .rp-coming { margin-bottom: 0.8em; }
    .rp-cta-h { font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 1.2em; font-weight: 700; margin: 0 0 0.2em; color: #fff; }
    .rp-cta-p { margin: 0; font-size: 0.93em; line-height: 1.5; color: rgba(255,255,255,0.8); max-width: 64ch; }
    .rp-cta .ws-btn--primary { background: #fff; color: var(--english-violet, #4a2a3c); flex: none; }
    .rp-cta .ws-btn--primary:hover { background: var(--paper, #f4f2f1); }
    .rp-coming ol { margin: 0; padding-left: 1.3em; font-size: 0.93em; line-height: 1.8; color: var(--ws-tx); columns: 2; column-gap: 2.5em; }

    /* The finish. */
    .rp-done { text-align: center; padding: 1.4em 0; }
    .rp-done-badge { width: 4.2em; height: 4.2em; border-radius: 50%; margin: 0 auto 1.5em; display: grid; place-items: center; background: color-mix(in srgb, var(--ws-accent) 12%, #fff); color: var(--ws-accent); }
    .rp-done-badge svg { width: 2em; height: 2em; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .rp-done h2 { font-family: var(--serif); font-weight: 500; font-size: 2.3em; line-height: 1.12; color: var(--ws-ink); margin: 0 0 0.4em; }
    .rp-done p { color: var(--ws-tx); font-size: 1.07em; line-height: 1.6; margin: 0 auto 1.6em; max-width: 46ch; }
    .rp-done-actions { display: flex; gap: 0.7em; justify-content: center; flex-wrap: wrap; }

    /* Nav row. */
    .rp-nav { flex: none; display: flex; justify-content: space-between; align-items: center; gap: 1em; margin: 0.85em 0 0; padding-top: 0.85em; border-top: 1px solid var(--ws-line); }
    .rp-rail { display: flex; gap: 0.55em; }
    .rp-dot { width: 0.65em; height: 0.65em; border-radius: 50%; border: 0; padding: 0; background: var(--ws-line); cursor: pointer; transition: background .2s, transform .2s; }
    .rp-dot:hover { transform: scale(1.25); }
    .rp-dot.is-done { background: color-mix(in srgb, var(--ws-accent) 42%, var(--ws-line)); }
    .rp-dot.is-active { background: var(--ws-accent); transform: scale(1.3); }
    .rp-hide { visibility: hidden; }
    @media (max-width: 560px) {
      .rp-rail { display: none; }
    }
    /* Download PDF */
    .rp-cover-start { gap: 0.6em; }
    .rp-cover-card .rp-dl { background: transparent; color: #fff; border-color: rgba(255,255,255,0.45); }
    .rp-cover-card .rp-dl:hover { border-color: #fff; }
    #rp-print { display: none; }
    @media print {
      @page { size: A4 landscape; margin: 9mm; }
      body.rp-printing > :not(#rp-print) { display: none !important; }
      body.rp-printing { background: #fff !important; }
      body.rp-printing #rp-print { display: block; font-size: 10.5px; font-family: var(--sans); -webkit-print-color-adjust: exact; print-color-adjust: exact; }
      #rp-print .rp-slide { animation: none; box-sizing: border-box; min-height: 188mm; break-after: page; page-break-after: always; box-shadow: none; overflow: visible; }
      #rp-print .rp-slide:last-child { break-after: auto; page-break-after: auto; }
      #rp-print .rp-cover-start, #rp-print .rp-cta .ws-btn { display: none; }
      #rp-print .rp-cta { margin-top: 1.5em; }
      #rp-print .rp-tblwrap { overflow: visible; }
    }
  </style>

  <script>
    import { supabase } from "../../../lib/supabase.js";
    import { MONTHS } from "../../../lib/report-insights.js";
    import { resolveVisibility } from "../../../lib/report-fields.js";
    import { DEMO_REPORTS } from "../../../lib/report-insights-demo.js";
    import { headlineCards, normaliseInsight, INSIGHT_CATEGORIES } from "../../../lib/report-metrics.js";

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const DEV = import.meta.env.DEV;
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const n = (v) => { const x = Number(String(v ?? "").replace(/[^0-9.\-]/g, "")); return Number.isFinite(x) && String(v ?? "").trim() !== "" ? x : null; };
    const fmt = (v) => (v == null ? "—" : Number(v).toLocaleString("en-GB"));
    const has = (v) => v != null && v !== "";
    const params = new URLSearchParams(location.search);

    /* ---- The parts ----
       Each part is a function of the month's data that returns nothing when
       it has nothing to say, so a month without a second month to compare
       simply has less in it. The visibility switches in admin
       (report-fields.js) still decide what a client may see. */
    function buildParts(r, all, vis, client, sampleMode) {
      const d = r.data || {}, p = d.profile || {}, rc = d.reach || {}, dem = d.demographics || {};
      const month = MONTHS[r.month];
      const parts = [];
      const mv = (v) => { const x = n(v); return x ? `${x > 0 ? "Up" : "Down"} ${Math.abs(x)}% on last month` : ""; };

      // 1 — The numbers. Six, three to a row. Every explanation is written to
      // run to two lines, so the row reads as one block.
      const figs = [];
      const fig = (key, label, val, means, move) => {
        if (vis[key] === false || val == null) return;
        figs.push(`<div class="rp-fig"><p class="rp-label">${esc(label)}</p><p class="rp-fig-val">${esc(val)}</p><p class="rp-fig-move">${move ? esc(move) : "&nbsp;"}</p><p class="rp-fig-means">${esc(means)}</p></div>`);
      };
      const nfo = n(p.newFollowers);
      fig("followers", "Followers", n(p.followers) != null ? fmt(n(p.followers)) : null,
        // New followers is everyone who followed during the month; it isn't
        // the overall change, which also takes off anyone who unfollowed.
        "Your total follower count on the day this report was produced.", vis.newFollowers !== false && nfo ? `${fmt(nfo)} new follower${nfo === 1 ? "" : "s"} in ${month}` : "");
      // Profile reach, named as such: posts and reels each have a reach of
      // their own, and those add up to more (see What did best).
      fig("reach", "Profile reach", n(p.reach) != null ? fmt(n(p.reach)) : null,
        "Different people who saw the account, each counted once.", mv(p.reachChange));
      fig("views", "Views", n(p.views) != null ? fmt(n(p.views)) : null,
        "Times your posts and videos were seen, repeats included.", mv(p.viewsChange));
      fig("interactions", "Interactions", n(p.interactions) != null ? fmt(n(p.interactions)) : null,
        "Likes, comments, saves and shares, all added together.", mv(p.interactionsChange));
      fig("interactionRate", "Interaction rate", n(p.interactionRate) != null ? n(p.interactionRate) + "%" : null,
        "Of everyone the account reached, the share who interacted.");
      // How much we put out. Stories aren't in it: SocialPilot only reports
      // them for the last 24 hours, never the month.
      const np = n(d.posts?.published), nr = n(d.reels?.published);
      if (vis.published !== false && (np != null || nr != null)) {
        const bits = [np ? `${fmt(np)} image and carousel post${np === 1 ? "" : "s"}` : "", nr ? `${fmt(nr)} short-form video${nr === 1 ? "" : "s"}` : ""].filter(Boolean);
        fig("published", "Total published", fmt((np || 0) + (nr || 0)), bits.length ? bits.join(" and ") + "." : "Nothing went out this month.");
      }
      // Slide titles in title case (Danielle, Sep 2026); the cover's contents
      // list and the progress label use the same names.
      if (figs.length) parts.push({ step: `${month} in Numbers`, html: part(
        `${month} in Numbers`,
        "Your Instagram performance at a glance.",
        `<div class="rp-figs rp-grow">${figs.join("")}</div>`) });

      // 2 — Who you reached: the profile's reach, split into followers and
      // people new to the account, then who the followers are. Age and
      // location are SocialPilot's figures for followers, not for everyone
      // reached, and they're labelled that way.
      const cards = [];
      const nfr = n(rc.nonFollower), fr = n(rc.follower);
      if (vis.followerSplit !== false && nfr != null && fr != null && nfr + fr > 0) {
        // SocialPilot's follower / non-follower split is counted content by
        // content, so it isn't a share of profile reach (September: 858 in the
        // split against 695 reached). Say what it IS a share of, and never set
        // it against the profile figure.
        const pct = Math.round(nfr / (nfr + fr) * 100);
        cards.push(`<div class="rp-mini"><p class="rp-label">Followers and non-followers</p>
          <div class="rp-big">${pct}%</div><p class="rp-mini-p">of your content&rsquo;s reach was people who don&rsquo;t follow you yet.</p>
          <div class="rp-splitbar"><span style="width:${100 - pct}%"></span></div>
          <div class="rp-splitkey"><span><i class="is-f"></i>${fmt(fr)} followers</span><span><i></i>${fmt(nfr)} non-followers</span></div>
          <p class="rp-mini-note">Counted piece by piece, like content reach, so these don&rsquo;t add up to your profile reach.</p></div>`);
      }
      const ages = vis.followerAge !== false ? (dem.age || []).filter((a) => a && a.range).map((a) => ({ range: a.range, v: (n(a.male) || 0) + (n(a.female) || 0) + (n(a.unspecified) || 0) })) : [];
      const ageTot = ages.reduce((a, b) => a + b.v, 0);
      if (ageTot) {
        const top = Math.max(...ages.map((a) => a.v));
        cards.push(`<div class="rp-mini"><p class="rp-label">Age of your followers</p><div class="rp-ages">${ages.map((a) => {
          const pc = Math.round(a.v / ageTot * 100);
          return `<div class="rp-age"><span>${esc(a.range)}</span><div class="rp-track"><i style="width:${Math.max(2, Math.round(a.v / top * 100))}%"></i></div><b>${pc}%</b></div>`;
        }).join("")}</div></div>`);
      }
      // Its own switch: the old "Top cities" one belonged to an Audience tab
      // clients never saw, so it may well be off.
      const cities = vis.followerLocation !== false ? (dem.topCities || []).map((c) => c && ({ city: c.city || c.name || c.location, count: c.count })).filter((c) => c && c.city).slice(0, 3) : [];
      if (cities.length) {
        const uk = n((dem.topCountries || []).find((c) => /united kingdom/i.test(c.country || ""))?.count) ?? n(p.ukFollowers);
        const ukPct = uk != null && n(p.followers) ? Math.round(uk / n(p.followers) * 100) : null;
        cards.push(`<div class="rp-mini"><p class="rp-label">Where your followers are</p><ol class="rp-cities">${cities.map((c) => `<li><span>${esc(String(c.city).replace(/,\s*(England|Scotland|Wales|Northern Ireland|United Kingdom)$/i, ""))}</span><b>${fmt(n(c.count))}</b></li>`).join("")}</ol>${ukPct != null ? `<p class="rp-mini-p" style="margin-top:.9em">${ukPct}% of your followers are in the UK.</p>` : ""}</div>`);
      }
      if (vis.organicPaidReach !== false && n(d.ads?.reach)) {
        cards.push(`<div class="rp-mini"><p class="rp-label">Paid adverts</p><div class="rp-big">${fmt(n(d.ads.reach))}</div><p class="rp-mini-p">people reached through paid adverts.</p></div>`);
      }
      // Two reaches, side by side and told apart, before who they were.
      const cr = (n(d.posts?.reach) || 0) + (n(d.reels?.reach) || 0);
      const band = n(p.reach) != null ? `<div class="rp-reach">
          <div><p class="rp-label">Profile reach</p><div class="rp-big">${fmt(n(p.reach))}</div><p class="rp-mini-p">different people saw the account.</p></div>
          ${vis.contentReach !== false && cr ? `<div><p class="rp-label">Content reach</p><div class="rp-big">${fmt(cr)}</div><p class="rp-mini-p">people reached, counted post by post.</p></div>` : ""}
          ${vis.contentReach !== false && cr ? `<p class="rp-reach-why"><b>Why two numbers?</b> Profile reach counts each person once, however many of your posts they saw. Content reach adds up every post&rsquo;s own reach, so someone who saw three posts is counted three times. That&rsquo;s why it&rsquo;s the bigger of the two.</p>` : ""}
        </div>` : "";
      if (cards.length || band) parts.push({ step: "Who You Reached", html: part(
        "Who You Reached",
        n(p.reach) != null ? `${fmt(n(p.reach))} different people saw your account this month. Here's who they were.` : "Who saw your account this month.",
        band + (cards.length ? `<div class="rp-cards rp-grow" style="--n:${cards.length}">${cards.join("")}</div>` : "")) });

      // 3 — What did best: the top five on their own card, reels and posts
      // beside them. Ranked by reach, interactions breaking a tie.
      const rows = (Array.isArray(d.content) && d.content.length ? d.content : (d.topContent || [])).filter((t) => t && (t.title || t.url));
      const top = vis.topContent !== false ? rows.slice().sort((a, b) => (n(b.reach) || 0) - (n(a.reach) || 0) || (n(b.interactions) || 0) - (n(a.interactions) || 0)).slice(0, 5) : [];
      // SocialPilot's Instagram Post and Instagram Reels pages. Views are a
      // total for each; only reels also have them post by post.
      const fcard = (label, one, x) => {
        if (!x) return "";
        const rate = n(x.interactionRate);
        const rs = [[`${label} published`, x.published], [`${one} reach`, x.reach], [`${one} views`, x.views], [`${one} interactions`, x.interactions], [`${one} interaction rate`, rate != null ? rate + "%" : null]]
          .filter(([, v]) => has(v)).map(([k, v]) => `<dt>${esc(k)}</dt><dd>${esc(/%$/.test(String(v)) ? v : fmt(n(v)))}</dd>`).join("");
        return rs ? `<div class="rp-mini rp-format"><p class="rp-label">${label}</p><dl>${rs}</dl></div>` : "";
      };
      const formats = vis.organicContent !== false ? fcard("Reels", "Reel", d.reels) + fcard("Posts", "Post", d.posts) : "";
      const tRow = (t, i) => {
        const reel = /reel/i.test(t.type || "");
        let name = t.url
          ? `<a href="${esc(t.url)}" target="_blank" rel="noopener noreferrer"><span class="rp-t">${esc(t.title || "Open on Instagram")}</span><span class="rp-go" aria-hidden="true">&#8599;</span></a>`
          : `<span class="rp-t">${esc(t.title)}</span>`;
        // On a phone the four figures become one line under the title.
        const line = [reel ? "Reel" : "Post", `${fmt(n(t.reach))} reach`, reel && n(t.views) != null ? `${fmt(n(t.views))} views` : "", `${fmt(n(t.interactions))} interactions`].filter(Boolean).join(" · ");
        name += `<span class="rp-top-m">${esc(line)}</span>`;
        return `<tr><td class="rp-rank">${i + 1}</td><td>${t.thumb ? `<img class="rp-thumb" src="${esc(t.thumb)}" alt="" loading="lazy">` : `<span class="rp-thumb"></span>`}</td><td class="rp-top-t">${name}</td><td class="rp-c" data-l="Type"><span class="rp-top-k">${reel ? "Reel" : "Post"}</span></td><td class="rp-c" data-l="Reach">${fmt(n(t.reach))}</td><td class="rp-c" data-l="Views">${reel ? fmt(n(t.views)) : "&ndash;"}</td><td class="rp-c" data-l="Interactions">${fmt(n(t.interactions))}</td></tr>`;
      };
      const topCard = top.length ? `<div class="rp-mini rp-topcard"><p class="rp-label">Top performing content</p><div class="rp-tblwrap"><table class="rp-tbl"><colgroup><col style="width:1.8em"><col style="width:3.9em"><col><col class="rp-eq"><col class="rp-eq"><col class="rp-eq"><col class="rp-eq"></colgroup><thead><tr><th></th><th></th><th>Content</th><th class="rp-c">Type</th><th class="rp-c">Reach</th><th class="rp-c">Views</th><th class="rp-c">Interactions</th></tr></thead><tbody>${top.map(tRow).join("")}</tbody></table></div></div>` : "";
      if (topCard || formats) parts.push({ step: "What Worked Well", html: part(
        "What Worked This Month",
        "Each post's reach counts everyone who saw it, so someone who saw three posts is in all three.",
        `<div class="rp-best${topCard && formats ? "" : " is-one"}">${topCard}${formats ? `<div class="rp-formats">${formats}</div>` : ""}</div>`) });

      // 4 — What it means: our words on the month, then, once there's a month
      // before it, how it compares.
      const series = all
        // This month and the two calendar months before it, no further:
        // social moves too fast for older months to say much about this one.
        .filter((x) => (x.platform || "") === (r.platform || "") && (x.year * 12 + x.month) <= (r.year * 12 + r.month) && (x.year * 12 + x.month) >= (r.year * 12 + r.month) - 2)
        .sort((a, b) => (a.year * 12 + a.month) - (b.year * 12 + b.month));
      // 4 — What it means: the reason the report is worth reading.
      //  - Four stat chips across the top: a bridge from the data pages,
      //    each change said once (this month against last, or SocialPilot's
      //    own change on the previous period for a first month).
      //  - Up to four insight cards from Client commentary: what we're
      //    seeing, what it means, what we'll do about it. Structured, so the
      //    page stays the same shape from month to month (rules §10).
      //  - The old free-written paragraph only stands in until a month has
      //    insights.
      const cl = d.client || {};
      const prev = vis.trends !== false && series.length > 1 ? series[series.length - 2] : null;
      // Four figures chosen for this month's story (report-metrics.js): the
      // drafting picks which, the numbers are worked out here.
      const heads = headlineCards(cl.headline, { d, prev: prev?.data || null, month, pm: prev ? MONTHS[prev.month] : null }, vis);
      const chipsHtml = heads.length ? `<div class="rp-chips">${heads.map((c) => `<div class="rp-chip"><span class="rp-chip-l">${esc(c.label)}</span><b>${esc(c.value)}</b>${c.sub ? `<span class="rp-chip-c ${c.dir > 0 ? "is-up" : c.dir < 0 ? "is-down" : ""}">${esc(c.sub)}</span>` : ""}</div>`).join("")}</div>` : "";
      // Two to four insights, as many as the month genuinely has.
      const insights = vis.summary !== false ? (cl.insights || []).map(normaliseInsight).filter(Boolean).slice(0, 4) : [];
      const insightsHtml = insights.length ? `<div class="rp-insights" style="--n:${insights.length}">${insights.map((i) => `<div class="rp-insight">
          <p class="rp-label rp-insight-k">${esc(INSIGHT_CATEGORIES[i.category])}${i.confidence === "emerging" ? `<span class="rp-insight-early">Early signal</span>` : ""}</p>
          <h3 class="rp-insight-h">${esc(i.headline)}</h3>
          <p class="rp-insight-p">${esc(i.analysis)}</p>
          ${i.evidence.length ? `<p class="rp-insight-ev">${i.evidence.map(esc).join(" &middot; ")}</p>` : ""}
        </div>`).join("")}</div>` : "";
      const story = has(cl.summary) ? cl.summary : d.summary;
      const prose = !insights.length && vis.summary !== false && has(story) ? `<div class="rp-prose">${esc(story)}</div>` : "";
      if (chipsHtml || insightsHtml || prose) {
        parts.push({ step: "What It Means", html: part("What It Means", "The four figures that tell this month's story, and what we're taking from them.", chipsHtml + (insightsHtml || prose)) });
      }

      // 5 — Into next month: each thing we're doing on a card of its own,
      // then what's coming. The Do more / Improve / Fix now marks are admin's
      // and never shown (rules §6).
      const takes = vis.priorities !== false ? ((cl.priorities || []).length ? cl.priorities : (d.priorities || [])).filter((x) => x && x.text) : [];
      const coming = vis.comingSoon !== false ? (d.comingSoon || []).filter(Boolean) : [];
      if (takes.length || coming.length) {
        const next = MONTHS[(r.month + 1) % 12];
        parts.push({ step: `Into ${next}`, html: part(
          `Into ${next}`,
          "Taking into account how the account has done recently, here's what we're bringing into the next few weeks.",
          (takes.length ? `<div class="rp-cards rp-takes rp-grow" style="--n:${Math.min(takes.length, takes.length === 4 ? 2 : 3)}">${takes.map((x) => `<div class="rp-mini">${x.title ? `<h3 class="rp-mini-h">${esc(x.title)}</h3>` : ""}<p class="rp-mini-p">${esc(x.text)}</p></div>`).join("")}</div>` : "")
          + (coming.length ? `<div class="rp-mini rp-coming"><p class="rp-label">Content coming up</p><ol>${coming.map((c) => `<li>${esc(c)}</li>`).join("")}</ol></div>` : "")
          // Later this becomes "See next month's content plan".
          + (sampleMode ? "" : `<div class="rp-cta"><div><h3 class="rp-cta-h">Got any questions?</h3><p class="rp-cta-p">${client?.social_media_manager ? `${esc(client.social_media_manager.split(/\s+/)[0])}, your account manager, can talk you through any of it: this month&rsquo;s insights and our plan for the month ahead.` : "Your account manager can talk you through any of it: this month&rsquo;s insights and our plan for the month ahead."}</p></div><a class="ws-btn ws-btn--primary" href="/account/social#message">${client?.social_media_manager ? `Message ${esc(client.social_media_manager.split(/\s+/)[0])}` : "Message your account manager"}</a></div>`)) });
      }
      return parts;
    }

    function part(title, lede, body) {
      return `<section class="rp-slide rp-part"><h2 class="rp-title">${esc(title)}</h2>${lede ? `<p class="rp-lede">${esc(lede)}</p>` : ""}<div class="rp-body">${body}</div></section>`;
    }

    // A measure across the months: the latest figure, the change on the month
    // before, and the line. One scale per chart, first and last months named.
    function trend(label, series, get, show, bare) {
      const vals = series.map(get);
      if (vals.filter((v) => v != null).length < 2) return "";
      const pts = vals.map((v, i) => [i, v]).filter(([, v]) => v != null);
      const lo = Math.min(...pts.map(([, v]) => v)), hi = Math.max(...pts.map(([, v]) => v));
      const W = 200, H = 48, pad = 5, span = hi - lo || 1;
      const x = (i) => pad + i * (W - pad * 2) / Math.max(1, series.length - 1);
      const y = (v) => hi === lo ? H / 2 : H - pad - (v - lo) / span * (H - pad * 2);
      const line = pts.map(([i, v]) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
      const area = `${x(pts[0][0]).toFixed(1)},${H} ${line} ${x(pts[pts.length - 1][0]).toFixed(1)},${H}`;
      const last = pts[pts.length - 1][1], prev = pts[pts.length - 2][1];
      const chg = prev ? ((last - prev) / Math.abs(prev) * 100) : 0;
      const chgTxt = !prev ? "" : `${chg >= 0 ? "Up" : "Down"} ${Math.abs(chg).toFixed(Math.abs(chg) < 10 ? 1 : 0)}%`;
      const [lx, ly] = [x(pts[pts.length - 1][0]), y(last)];
      // Inside a comparison card: just the line and its first and last month.
      if (bare) return `<svg class="rp-cmp-line" viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(label)} over ${series.length} months">
          <polygon points="${area}" fill="var(--english-violet, #4a2a3c)" fill-opacity="0.08" />
          <polyline points="${line}" fill="none" stroke="var(--english-violet, #4a2a3c)" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" />
          <circle cx="${lx.toFixed(1)}" cy="${ly.toFixed(1)}" r="3.5" fill="var(--english-violet, #4a2a3c)" />
        </svg><div class="rp-trend-axis"><span>${MONTHS[series[0].month].slice(0, 3)}</span><span>${MONTHS[series[series.length - 1].month].slice(0, 3)}</span></div>`;
      return `<div class="rp-mini rp-trend">
        <p class="rp-label" style="margin:0">${esc(label)}</p>
        <div class="rp-trend-now">${esc(show(last))}${chgTxt ? `<span>${esc(chgTxt)}</span>` : ""}</div>
        <svg viewBox="0 0 ${W} ${H}" role="img" aria-label="${esc(label)} over ${series.length} months">
          <polygon points="${area}" fill="var(--english-violet, #4a2a3c)" fill-opacity="0.08" />
          <polyline points="${line}" fill="none" stroke="var(--english-violet, #4a2a3c)" stroke-width="2" vector-effect="non-scaling-stroke" stroke-linejoin="round" stroke-linecap="round" />
          <circle cx="${lx.toFixed(1)}" cy="${ly.toFixed(1)}" r="3.5" fill="var(--english-violet, #4a2a3c)" />
        </svg>
        <div class="rp-trend-axis"><span>${MONTHS[series[0].month].slice(0, 3)}</span><span>${MONTHS[series[series.length - 1].month].slice(0, 3)}</span></div>
      </div>`;
    }

    function run(r, all, vis, client, sample) {
      $("rp-loading").hidden = true;
      $("rp").hidden = false;
      const parts = buildParts(r, all, vis, client, sample);
      const month = `${MONTHS[r.month]} ${r.year}`;
      const who = [client?.business, r.platform].filter(Boolean).join(" · ");
      document.title = `${month} report · TMKE`;
      const back = sample ? "/account/social?sample=1" : "/account/social";
      $("rp-back").href = back;

      const cover = `<div class="rp-slide rp-cover"><div class="rp-cover-card">
          <p class="rp-eyebrow">Your monthly report</p>
          <h1 class="rp-cover-title">${esc(month)}</h1>
          ${who ? `<p class="rp-cover-sub">${esc(who)}</p>` : ""}
          ${r.amendment_notice_at ? `<p class="rp-cover-upd">Updated ${esc(new Date(r.amendment_notice_at).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }))}</p>` : ""}
          ${parts.length ? `<ol class="rp-contents">${parts.map((p, i) => `<li><button type="button" data-go="${i + 1}">${esc(p.step)}</button></li>`).join("")}</ol>` : `<p class="rp-cover-sub">There&rsquo;s nothing to show for this month yet. Your team is still putting the numbers together.</p>`}
          ${parts.length ? `<div class="rp-cover-start"><button type="button" class="ws-btn rp-dl" data-pdf><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v8M4.5 7L8 10.5 11.5 7M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Download PDF</button><button type="button" class="ws-btn ws-btn--primary" data-go="1">Start
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div>` : ""}
        </div></div>`;
      const mgr = client?.social_media_manager;
      const done = `<div class="rp-slide rp-done">
          <div class="rp-done-badge"><svg viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg></div>
          <h2>That&rsquo;s your ${esc(MONTHS[r.month])}</h2>
          <p>${mgr ? `If anything here raises a question, ${esc(mgr.split(/\s+/)[0])} is the person to ask.` : "If anything here raises a question, your social team is the place to ask."}</p>
          <div class="rp-done-actions">
            <a class="ws-btn ws-btn--ghost" href="${back}">Back to your socials</a>
            <button type="button" class="ws-btn ws-btn--ghost" data-pdf><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2.5v8M4.5 7L8 10.5 11.5 7M3 13.5h10" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>Download PDF</button>
            ${sample ? "" : `<a class="ws-btn ws-btn--primary" href="/account/social#message">${mgr ? `Message ${esc(mgr.split(/\s+/)[0])}` : "Message your team"}</a>`}
          </div>
        </div>`;

      const slides = [cover, ...parts.map((p) => p.html), done];
      const steps = ["Your monthly report", ...parts.map((p) => p.step), "Finished"];
      const LAST = slides.length - 1;
      const stage = $("rp-stage"), nav = $("rp-nav"), rail = $("rp-rail");
      const prev = $("rp-prev"), next = $("rp-next"), nextLabel = $("rp-next-label");
      rail.innerHTML = parts.map((p, i) => `<button type="button" class="rp-dot" data-go="${i + 1}" title="${esc(p.step)}" aria-label="${esc(p.step)}"></button>`).join("");
      let at = 0;
      // Where the deck starts on the page, so it can end at the window's foot.
      const deck = $("rp");
      const fit = () => { deck.style.setProperty("--rp-top", `${Math.round(deck.getBoundingClientRect().top + window.scrollY)}px`); };
      window.addEventListener("resize", fit);
      const show = (i) => {
        at = Math.max(0, Math.min(LAST, i));
        stage.innerHTML = slides[at];
        nav.hidden = at === 0 || !parts.length;
        prev.classList.toggle("rp-hide", at === 0);
        next.classList.toggle("rp-hide", at === LAST);
        nextLabel.textContent = at === LAST - 1 ? "Finish" : "Next";
        $("rp-step").textContent = steps[at];
        $("rp-count").textContent = at > 0 && at < LAST ? `${at} of ${parts.length}` : "";
        $("rp-fill").style.width = `${Math.round(at / LAST * 100)}%`;
        rail.querySelectorAll(".rp-dot").forEach((d, k) => { d.classList.toggle("is-active", k + 1 === at); d.classList.toggle("is-done", k + 1 < at); });
        fit();
      };
      document.addEventListener("click", (e) => { const b = e.target.closest("[data-go]"); if (b) { e.preventDefault(); show(+b.dataset.go); } });
      // Download PDF: every slide but the finish, one to a landscape A4 page,
      // through the browser's own Save as PDF.
      document.addEventListener("click", (e) => {
        if (!e.target.closest("[data-pdf]")) return;
        let sheet = $("rp-print");
        if (!sheet) { sheet = document.createElement("div"); sheet.id = "rp-print"; document.body.appendChild(sheet); }
        sheet.innerHTML = slides.slice(0, LAST).join("");
        const was = document.title;
        document.title = `${client?.business ? client.business + " " : ""}${month} social media report`;
        document.body.classList.add("rp-printing");
        const done = () => { document.body.classList.remove("rp-printing"); document.title = was; window.removeEventListener("afterprint", done); };
        window.addEventListener("afterprint", done);
        setTimeout(() => window.print(), 50);
      });
      prev.addEventListener("click", () => show(at - 1));
      next.addEventListener("click", () => show(at + 1));
      document.addEventListener("keydown", (e) => {
        if (e.target.closest("input, textarea, select")) return;
        if (e.key === "ArrowRight") show(at + 1);
        if (e.key === "ArrowLeft") show(at - 1);
      });
      show(0);
    }

    function notFound() { $("rp-loading").hidden = true; $("rp-empty").hidden = false; }

    (async () => {
      // Dev only: ?fixture=/some.json renders a report's data as a client
      // would see it, to check a new upload's shape without an account.
      if (DEV && params.get("fixture")) {
        // A single report's data, or an array of { month, year, data }, newest last.
        const j = await (await fetch(params.get("fixture"))).json();
        const list = (Array.isArray(j) ? j : [{ month: +(params.get("m") ?? 7), year: +(params.get("y") ?? 2026), data: j }]).map((x, i) => ({ id: "fx" + i, platform: "Instagram", ...x }));
        return run(list[list.length - 1], list, resolveVisibility(null), { business: "Fixture", social_media_manager: "Abby" }, false);
      }
      const sampleId = params.get("sample");
      const SAMPLE_CLIENT = { business: "The Marketing Experts", social_media_manager: "Abby" };
      if (sampleId) {
        const r = DEMO_REPORTS.find((x) => x.id === sampleId) || DEMO_REPORTS.find((x) => x.accountId === "tmke");
        const all = DEMO_REPORTS.filter((x) => x.accountId === r.accountId);
        return run(r, all, resolveVisibility(null), SAMPLE_CLIENT, true);
      }
      const id = params.get("r");
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        if (DEV) { const r = DEMO_REPORTS[1]; return run(r, DEMO_REPORTS.filter((x) => x.accountId === r.accountId), resolveVisibility(null), SAMPLE_CLIENT, true); }
        location.replace("/login?next=" + encodeURIComponent(location.pathname + "?r=" + (params.get("r") || "")));
        return;
      }
      if (!WORKER) return notFound();
      try {
        const res = await fetch(`${WORKER}/smm/mine`, { headers: { Authorization: "Bearer " + session.access_token } });
        const j = await res.json().catch(() => ({}));
        const all = j.reports || [];
        const r = id ? all.find((x) => String(x.id) === id) : all[0];
        if (!r) return notFound();
        run(r, all, resolveVisibility(j.visibility), j.client || {}, false);
      } catch (_) { notFound(); }
    })();
  </script>
</BaseLayout>
