---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../../components/account/WorkspaceHeader.astro";
import { GUIDE_TOPICS } from "../../../data/guide-topics.js";
// Single reader page (query param ?g=<slug>) so newly-published guides work
// instantly — no site rebuild needed (unlike the getStaticPaths blog pattern).
//
// Two templates, chosen by guide.kind:
//   • 'guide'  → Article  : a clean, spacious long-form read (quick how-to).
//   • 'course' → Course   : one lesson per slide, progress bar, prev/next,
//                           an intro slide + a completion slide. Click-through.
---
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Learn — TMKE workspace"
  description="A TMKE Learn guide."
>
  <div class="ws lrn">
    <WorkspaceHeader active="guides" />

    <main class="lrn-main gr-main">
      <a class="gr-back" href="/account/guides">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg> Back to Learn
      </a>

      <article class="gr" id="gr" aria-busy="true">
        <div class="gr-loading" id="gr-loading">Loading…</div>

        <!-- ============ ARTICLE (kind='guide') ============ -->
        <div class="gr-article" id="gr-article" hidden>
          <header class="gr-head">
            <a class="gr-topic" id="ar-topic" href="#"></a>
            <h1 class="gr-title" id="ar-title"></h1>
            <p class="gr-summary" id="ar-summary"></p>
            <div class="gr-meta" id="ar-meta"></div>
          </header>
          <figure class="gr-cover" id="ar-cover" hidden><img id="ar-cover-img" alt="" /></figure>
          <div class="gr-body" id="ar-body"></div>
          <footer class="gr-artfoot">
            <a class="ws-btn ws-btn--ghost ws-btn--sm" href="/account/guides">← Back to Learn</a>
          </footer>
        </div>

        <!-- ============ COURSE (kind='course') ============ -->
        <div class="gc" id="gr-course" hidden>
          <div class="gc-progress" id="gc-progress">
            <div class="gc-bar"><span class="gc-fill" id="gc-fill"></span></div>
            <div class="gc-progress-meta">
              <span id="gc-step">Overview</span>
              <span id="gc-pct">0%</span>
            </div>
          </div>

          <div class="gc-stage" id="gc-stage" aria-live="polite"></div>

          <footer class="gc-nav" id="gc-nav" hidden>
            <button type="button" class="ws-btn ws-btn--ghost ws-btn--sm" id="gc-prev">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 4L6 8l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span id="gc-prev-label">Previous</span>
            </button>
            <div class="gc-rail" id="gc-rail" aria-hidden="true"></div>
            <button type="button" class="ws-btn ws-btn--primary ws-btn--sm" id="gc-next">
              <span id="gc-next-label">Next</span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </footer>
        </div>

        <div class="gr-empty" id="gr-empty" hidden>
          <h1>Not found</h1>
          <p>This may have moved or isn't published yet.</p>
          <a class="ws-btn ws-btn--primary ws-btn--sm" href="/account/guides">Back to Learn</a>
        </div>
      </article>
    </main>
  </div>

  <style is:global>
    /* Workspace tokens — the reader relies on these for cards, borders, radii
       and shadows. Kept in sync with the Learn landing (account/guides.astro). */
    body[data-dashboard] { background: var(--ws-bg); }
    .ws {
      --ws-bg: #f5f4f1;
      --ws-card: #ffffff;
      --ws-soft: #fbfaf8;
      --ws-ink: #1c1d22;
      --ws-tx: rgba(28, 29, 34, 0.60);
      --ws-faint: rgba(28, 29, 34, 0.40);
      --ws-line: rgba(28, 29, 34, 0.07);
      --ws-accent: var(--english-violet, #5b4a55);
      --ws-success: #3f9468;
      --ws-r-lg: 4px; --ws-r: 4px; --ws-r-sm: 4px;
      --ws-sh-hero: 0 2px 4px rgba(28,29,34,0.03), 0 34px 64px -34px rgba(28,29,34,0.30), 0 14px 30px -22px rgba(28,29,34,0.20);
      --ws-sh: 0 1px 2px rgba(28,29,34,0.02), 0 18px 40px -30px rgba(28,29,34,0.16);
      --ws-ease: cubic-bezier(.2, .8, .2, 1);
      min-height: 100vh;
      color: var(--ws-ink);
      font-family: var(--sans);
      background:
        radial-gradient(120% 80% at 100% -5%, rgba(91, 74, 85, 0.055), transparent 55%),
        radial-gradient(100% 70% at -5% 105%, rgba(91, 74, 85, 0.045), transparent 52%),
        var(--ws-bg);
    }

    .gr-main { max-width: 820px; }
    .gr-back { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--ws-tx); text-decoration: none; margin-bottom: 4px; }
    .gr-back svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .gr-back:hover { color: var(--ws-ink); }
    .gr-loading, .gr-empty { text-align: center; padding: 60px 0; color: var(--ws-faint); font-size: 14px; }
    .gr-empty h1 { font-family: var(--serif); font-weight: 500; color: var(--ws-ink); font-size: 28px; margin: 0 0 8px; }
    .gr-empty p { margin: 0 0 18px; }

    /* ---- Shared long-form typography (used by both templates) ---- */
    .gr-topic { display: inline-flex; align-items: center; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-accent); text-decoration: none; margin-bottom: 12px; }
    .gr-title { font-family: var(--serif); font-weight: 500; font-size: clamp(30px, 4vw, 46px); line-height: 1.06; letter-spacing: -0.02em; color: var(--ws-ink); margin: 0; }
    .gr-summary { font-size: clamp(15px, 1.3vw, 18px); line-height: 1.6; color: var(--ws-tx); margin: 14px 0 0; max-width: 64ch; }
    .gr-meta { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 18px 0 0; font-size: 12.5px; color: var(--ws-faint); }
    .gr-meta span { display: inline-flex; align-items: center; gap: 6px; }
    .gr-cover { margin: 26px 0 0; border-radius: var(--ws-r-lg); overflow: hidden; box-shadow: var(--ws-sh); }
    .gr-cover img { display: block; width: 100%; height: auto; }

    .gr-body { margin: 30px 0 0; font-size: 16px; line-height: 1.72; color: var(--ws-ink); }
    .gr-body h2 { font-family: var(--serif); font-weight: 500; font-size: 26px; line-height: 1.15; margin: 34px 0 12px; }
    .gr-body h3 { font-size: 18px; font-weight: 700; margin: 26px 0 8px; }
    .gr-body p { margin: 0 0 16px; }
    .gr-body ul, .gr-body ol { margin: 0 0 16px; padding-left: 22px; }
    .gr-body li { margin: 0 0 8px; }
    .gr-body img { max-width: 100%; height: auto; border-radius: var(--ws-r); margin: 8px 0; }
    .gr-body a { color: var(--ws-accent); }
    .gr-body strong { font-weight: 700; }
    .gr-body blockquote { margin: 0 0 16px; padding: 4px 0 4px 18px; border-left: 3px solid var(--ws-accent); color: var(--ws-tx); font-style: italic; }

    /* ---- Article footer ---- */
    .gr-artfoot { margin: 46px 0 0; padding-top: 24px; border-top: 1px solid var(--ws-line); }
    .ws-btn--ghost { background: var(--ws-card); border-color: var(--ws-line); color: var(--ws-ink); }
    .ws-btn--ghost:hover { border-color: var(--ws-accent); }

    /* ======================================================
       COURSE — click-through, one lesson per slide
       ====================================================== */
    .gc-progress { position: sticky; top: 0; z-index: 6; margin: 2px 0 4px; padding: 12px 0 14px; background: color-mix(in srgb, var(--ws-bg, #f6f4f2) 90%, transparent); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); }
    .gc-bar { height: 4px; border-radius: 999px; background: var(--ws-line); overflow: hidden; }
    .gc-fill { display: block; height: 100%; width: 0; border-radius: 999px; background: var(--ws-accent); transition: width .55s cubic-bezier(.2,.7,.3,1); }
    .gc-progress-meta { display: flex; justify-content: space-between; margin-top: 9px; font-size: 12px; font-weight: 600; letter-spacing: 0.02em; color: var(--ws-faint); }
    #gc-step { color: var(--ws-tx); }

    /* The stage holds one slide at a time and vertically centres content parts
       (and the completion slide) so the course reads like a click-through deck.
       The overview slide stays top-aligned. */
    .gc-stage { position: relative; min-height: min(56vh, 520px); display: flex; flex-direction: column; justify-content: flex-start; }
    .gc-stage.is-centered { justify-content: center; }
    .gc-slide { animation: gcIn .42s cubic-bezier(.2,.7,.3,1); }
    @keyframes gcIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }

    /* Content slide — a soft card panel (deck feel), text left-aligned. */
    .gc-slide--part { background: var(--ws-card); border: 1px solid var(--ws-line); border-radius: var(--ws-r-lg); padding: clamp(26px, 3vw, 40px); box-shadow: var(--ws-sh); }
    .gc-part { display: inline-block; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-accent); margin: 0 0 14px; }
    .gc-slide-title { font-family: var(--serif); font-weight: 500; font-size: clamp(26px, 3.4vw, 40px); line-height: 1.08; letter-spacing: -0.02em; color: var(--ws-ink); margin: 0 0 6px; }
    .gc-slide-body { margin-top: 20px; }

    /* Intro slide */
    .gc-slide--intro { padding-top: 6px; }
    .gc-intro-title { font-family: var(--serif); font-weight: 500; font-size: clamp(32px, 4.4vw, 52px); line-height: 1.04; letter-spacing: -0.02em; color: var(--ws-ink); margin: 8px 0 0; }
    .gc-intro-sum { font-size: clamp(15px, 1.4vw, 19px); line-height: 1.6; color: var(--ws-tx); margin: 16px 0 0; max-width: 62ch; }
    .gc-intro-meta { display: flex; flex-wrap: wrap; gap: 10px; margin: 24px 0 0; }
    .gc-intro-meta span { font-size: 12.5px; font-weight: 600; color: var(--ws-tx); background: var(--ws-card); border: 1px solid var(--ws-line); border-radius: 999px; padding: 6px 14px; }
    .gc-intro-cover { margin: 28px 0 0; border-radius: var(--ws-r-lg); overflow: hidden; box-shadow: var(--ws-sh); }
    .gc-intro-cover img { display: block; width: 100%; height: auto; }
    .gc-intro-start { margin-top: 30px; }

    /* Completion slide */
    .gc-slide--done { text-align: center; padding: 34px 0 8px; }
    .gc-done-badge { width: 60px; height: 60px; border-radius: 50%; margin: 0 auto 22px; display: grid; place-items: center; background: color-mix(in srgb, var(--ws-accent) 12%, #fff); color: var(--ws-accent); }
    .gc-done-badge svg { width: 28px; height: 28px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .gc-slide--done h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(24px, 3vw, 34px); line-height: 1.12; color: var(--ws-ink); margin: 0 0 10px; }
    .gc-slide--done p { color: var(--ws-tx); font-size: 15px; line-height: 1.6; margin: 0 auto 24px; max-width: 46ch; }
    .gc-done-actions { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; }

    /* Nav row */
    .gc-nav { display: flex; justify-content: space-between; align-items: center; gap: 14px; margin: 42px 0 0; padding-top: 22px; border-top: 1px solid var(--ws-line); }
    .gc-nav[hidden] { display: none; }
    .gc-rail { display: flex; gap: 8px; }
    .gc-dot { width: 9px; height: 9px; border-radius: 50%; border: 0; padding: 0; background: var(--ws-line); cursor: pointer; transition: background .2s, transform .2s; }
    .gc-dot:hover { transform: scale(1.25); }
    .gc-dot.is-done { background: color-mix(in srgb, var(--ws-accent) 42%, var(--ws-line)); }
    .gc-dot.is-active { background: var(--ws-accent); transform: scale(1.3); }
    .gc-prev-hidden { visibility: hidden; }

    @media (max-width: 560px) {
      .gc-rail { display: none; }
      .gc-nav { justify-content: space-between; }
    }
  </style>

  <script>
    import { supabase } from "../../../lib/supabase.js";
    import { GUIDE_TOPIC_MAP } from "../../../data/guide-topics.js";

    const $ = (s) => document.querySelector(s);
    const DEV = import.meta.env.DEV;
    let USER_ID = null;

    // Persist how far the member has got. One row per (member, guide); we only
    // ever push the furthest point forward, and flip completed once at the end.
    async function saveProgress(slug, { furthest, total, completed }) {
      if (!USER_ID || !slug) return;
      const row = { user_id: USER_ID, guide_slug: slug, furthest, total, completed };
      if (completed) row.completed_at = new Date().toISOString();
      try { await supabase.from("guide_progress").upsert(row, { onConflict: "user_id,guide_slug" }); } catch (_) {}
    }

    // Dev-only samples so both templates are viewable without a DB/session.
    //   ?g=sample         → article
    //   ?g=sample-course  → mini course
    const SAMPLE_ARTICLE = {
      slug: "sample", title: "Setting up your brand kit", topic: "getting-started",
      kind: "guide", summary: "Build a recognisable brand in minutes — colours, fonts and your logo, ready to drop into every design.",
      est_minutes: 5, cover_url: "",
      lessons: [
        { title: "", body_html: "<p>Your brand kit is the set of colours, fonts and logos that make every post <strong>unmistakably yours</strong>. Set it once and the Studio applies it everywhere.</p><h3>What you'll set</h3><ul><li>Your brand colours</li><li>Your fonts</li><li>Your logo</li></ul><p>Head to your profile and add your primary and secondary colours. These become one-tap swatches across the editor, so you never have to hunt for a hex code again.</p><blockquote>Tip: stick to two or three colours. Restraint reads as premium.</blockquote>" },
      ],
    };
    const SAMPLE_COURSE = {
      slug: "sample-course", title: "Your first week on social", topic: "social-intro",
      kind: "course", summary: "A short, guided walk-through to get you posting with confidence — five quick parts, done in a coffee break.",
      est_minutes: 8, cover_url: "",
      lessons: [
        { title: "Set your foundations", body_html: "<p>Before you post anything, get the basics right: a clear profile photo, a one-line bio that says what you do, and a link that goes somewhere useful.</p><ul><li>Square logo or clean headshot</li><li>Bio: who you help + how</li><li>One call-to-action link</li></ul>" },
        { title: "Find your three pillars", body_html: "<p>Pick three themes you'll post about. This keeps you consistent and stops the blank-page panic.</p><p>For most agents that's <strong>listings</strong>, <strong>local area</strong>, and <strong>behind the scenes</strong>.</p>" },
        { title: "Plan a week of posts", body_html: "<p>Batch it. Sit down once and rough out five posts against your pillars. You'll thank yourself on the busy days.</p>" },
        { title: "Write captions that land", body_html: "<p>Open with a hook, keep it human, end with one clear ask. Short sentences win.</p><blockquote>People scroll fast — earn the second line.</blockquote>" },
        { title: "Post, then review", body_html: "<p>Consistency beats perfection. Post your week, then check which one got the most saves and do more of that.</p>" },
      ],
    };

    function esc(s){ return String(s ?? "").replace(/[&<>\"]/g, (c)=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c])); }
    function topicLabel(slug){ const t = GUIDE_TOPIC_MAP[slug]; return t ? t.label : "Learn"; }

    function cleanLessons(guide){
      return Array.isArray(guide.lessons) ? guide.lessons.filter((l)=> l && (l.title || l.body_html)) : [];
    }

    // ---------------- ARTICLE ----------------
    function renderArticle(guide, lessons){
      $("#gr-article").hidden = false;
      const t = $("#ar-topic");
      t.textContent = topicLabel(guide.topic);
      t.href = "/account/guides#" + (guide.topic || "");
      $("#ar-title").textContent = guide.title || "Untitled";
      const sum = $("#ar-summary"); if (guide.summary) sum.textContent = guide.summary; else sum.hidden = true;

      const meta = [];
      if (guide.est_minutes) meta.push(`<span>${guide.est_minutes} min read</span>`);
      $("#ar-meta").innerHTML = meta.join("");

      if (guide.cover_url) { $("#ar-cover").hidden = false; const im = $("#ar-cover-img"); im.src = guide.cover_url; im.alt = guide.cover_alt || guide.title || ""; }

      // One flowing read. If an article somehow has several lessons, join them
      // with each lesson title as an <h2>.
      const html = lessons.length <= 1
        ? (lessons[0]?.body_html || "<p>This article has no content yet.</p>")
        : lessons.map((l)=> (l.title ? `<h2>${esc(l.title)}</h2>` : "") + (l.body_html || "")).join("");
      $("#ar-body").innerHTML = html;

      // An article is a single short read — opening it counts as done.
      saveProgress(guide.slug, { furthest: 1, total: 0, completed: true });
    }

    // ---------------- COURSE ----------------
    function renderCourse(guide, lessons){
      $("#gr-course").hidden = false;
      $("#gc-progress").hidden = false;
      const N = lessons.length;                 // content slides
      const LAST = N + 1;                        // done slide index
      const stage = $("#gc-stage"), nav = $("#gc-nav");
      const fill = $("#gc-fill"), stepEl = $("#gc-step"), pctEl = $("#gc-pct");
      const prevBtn = $("#gc-prev"), nextBtn = $("#gc-next");
      const prevLabel = $("#gc-prev-label"), nextLabel = $("#gc-next-label");
      const rail = $("#gc-rail");

      // Rail = one dot per content part.
      rail.innerHTML = lessons.map((_, i)=> `<button type="button" class="gc-dot" data-go="${i+1}" title="Part ${i+1}"></button>`).join("");
      rail.querySelectorAll("[data-go]").forEach((b)=> b.addEventListener("click", ()=> show(+b.dataset.go)));

      const introHtml = () => {
        const chips = [];
        chips.push(`<span>${N} part${N===1?"":"s"}</span>`);
        if (guide.est_minutes) chips.push(`<span>~${guide.est_minutes} min</span>`);
        const cover = guide.cover_url ? `<figure class="gc-intro-cover"><img src="${esc(guide.cover_url)}" alt="${esc(guide.cover_alt || guide.title || "")}"></figure>` : "";
        return `<div class="gc-slide gc-slide--intro">
          <a class="gr-topic" href="/account/guides#${esc(guide.topic||"")}">${esc(topicLabel(guide.topic))}</a>
          <h1 class="gc-intro-title">${esc(guide.title || "Untitled")}</h1>
          ${guide.summary ? `<p class="gc-intro-sum">${esc(guide.summary)}</p>` : ""}
          <div class="gc-intro-meta">${chips.join("")}</div>
          ${cover}
          <div class="gc-intro-start"><button type="button" class="ws-btn ws-btn--primary" data-next>Start course
            <svg viewBox="0 0 16 16" aria-hidden="true" style="width:15px;height:15px;margin-left:2px"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button></div>
        </div>`;
      };
      const partHtml = (i) => {
        const l = lessons[i-1];
        return `<div class="gc-slide gc-slide--part">
          <span class="gc-part">Part ${i} of ${N}</span>
          ${l.title ? `<h2 class="gc-slide-title">${esc(l.title)}</h2>` : ""}
          <div class="gc-slide-body gr-body">${l.body_html || ""}</div>
        </div>`;
      };
      const doneHtml = () => `<div class="gc-slide gc-slide--done">
        <div class="gc-done-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></div>
        <h2>That's a wrap</h2>
        <p>You've finished <strong>${esc(guide.title || "this course")}</strong>. Nice work — put it into practice, then come back for the next one.</p>
        <div class="gc-done-actions">
          <a class="ws-btn ws-btn--primary ws-btn--sm" href="/account/guides">Back to Learn</a>
          <button type="button" class="ws-btn ws-btn--ghost ws-btn--sm" data-restart>Start over</button>
        </div>
      </div>`;

      let pos = 0; // 0 = intro, 1..N = parts, N+1 = done
      let maxReached = 0, doneFlag = false;

      function show(next){
        pos = Math.max(0, Math.min(LAST, next));
        if (pos === 0)      stage.innerHTML = introHtml();
        else if (pos === LAST) stage.innerHTML = doneHtml();
        else                stage.innerHTML = partHtml(pos);

        // Vertically centre content parts + the completion slide (deck feel);
        // keep the overview top-aligned.
        stage.classList.toggle("is-centered", pos !== 0);

        // Wire the per-slide buttons that just rendered.
        stage.querySelector("[data-next]")?.addEventListener("click", ()=> show(pos + 1));
        stage.querySelector("[data-restart]")?.addEventListener("click", ()=> show(1));

        // Progress bar: intro 0%, part k = k/N, done 100%.
        const pct = pos === 0 ? 0 : Math.round((Math.min(pos, N) / N) * 100);
        fill.style.width = pct + "%";
        pctEl.textContent = pct + "%";
        stepEl.textContent = pos === 0 ? "Overview" : pos === LAST ? "Complete" : `Part ${pos} of ${N}`;

        // Bottom nav shows on content parts only; intro/done have their own buttons.
        const onPart = pos >= 1 && pos <= N;
        nav.hidden = !onPart;
        if (onPart){
          prevBtn.classList.toggle("gc-prev-hidden", false);
          prevLabel.textContent = pos === 1 ? "Overview" : "Previous";
          nextLabel.textContent = pos === N ? "Finish" : "Next";
        }

        // Rail state.
        rail.querySelectorAll(".gc-dot").forEach((d, i)=>{
          const part = i + 1;
          d.classList.toggle("is-active", part === pos);
          d.classList.toggle("is-done", part < pos || pos === LAST);
        });

        if (pos !== 0) window.scrollTo({ top: 0, behavior: "smooth" });

        // Save progress once they've actually started (past the overview).
        maxReached = Math.max(maxReached, pos);
        if (pos === LAST) doneFlag = true;
        if (maxReached >= 1) saveProgress(guide.slug, { furthest: maxReached, total: N, completed: doneFlag });
      }

      prevBtn.addEventListener("click", ()=> show(pos - 1));
      nextBtn.addEventListener("click", ()=> show(pos + 1));

      // Resume from the Learn card (?p=<part>) when asked; otherwise the overview.
      const jump = parseInt(new URLSearchParams(location.search).get("p"), 10);
      show(Number.isFinite(jump) && jump >= 1 ? Math.min(jump, N) : 0);
    }

    function render(guide){
      $("#gr-loading").hidden = true;
      if (!guide) { $("#gr-empty").hidden = false; $("#gr").setAttribute("aria-busy","false"); return; }
      $("#gr").setAttribute("aria-busy","false");
      const lessons = cleanLessons(guide);
      const isCourse = guide.kind === "course" && lessons.length > 0;
      if (isCourse) renderCourse(guide, lessons);
      else renderArticle(guide, lessons);
    }

    (async () => {
      const slug = new URLSearchParams(location.search).get("g") || "";
      let session = null;
      try { const { data } = await supabase.auth.getSession(); session = data.session; } catch (_) {}
      if (!session && !DEV) { location.replace("/login?next=" + encodeURIComponent(location.pathname + location.search)); return; }
      USER_ID = session?.user?.id || null;

      // Fill the header identity (mirrors the Learn page).
      if (session) {
        const email = session.user.email ?? "";
        const meta = session.user.user_metadata ?? {};
        const fullName = (meta.name || email.split("@")[0].replace(/[._]/g, " ")).replace(/\b\w/g, (c)=>c.toUpperCase());
        const initials = fullName.split(" ").slice(0,2).map((w)=>w[0]).join("").toUpperCase() || "T";
        document.querySelectorAll(".ws-whoav").forEach((e)=>e.textContent = initials);
        const set = (sel,v)=>{ const el=document.querySelector(sel); if(el&&v) el.textContent=v; };
        set(".ws-whotext strong", fullName); set(".ws-whotext span", email);
      }

      const devSample = slug === "sample-course" ? SAMPLE_COURSE : SAMPLE_ARTICLE;
      if (!slug) { render(DEV ? SAMPLE_ARTICLE : null); return; }
      try {
        const { data, error } = await supabase.from("guides").select("*").eq("slug", slug).eq("status","published").maybeSingle();
        if (error) throw error;
        render(data || (DEV ? devSample : null));
      } catch (_) { render(DEV ? devSample : null); }
    })();
  </script>
</BaseLayout>
