---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../../components/account/WorkspaceHeader.astro";
import HubFootBar from "../../../components/account/HubFootBar.astro";
import { GUIDE_TOPICS } from "../../../data/guide-topics.js";
import { getImage } from "astro:assets";
import "../../../styles/ws-system.css";   // the hub's buttons (.ws-btn) — the reader had none of its own
import "../../../styles/guide-reader.css"; // the reader's own look, shared with admin Guides

// A course cover for guides that don't carry a picture of their own: the Learn
// banner's photograph, served as WebP.
const DEFAULT_COVER = (await getImage({
  src: "https://assets.tmke.co.uk/TMKE%20Member%20Hub/Training.png",
  width: 3600, height: 620, format: "webp", quality: 82,
})).src;
// Single reader page (query param ?g=<slug>) so newly-published guides work
// instantly — no site rebuild needed (unlike the getStaticPaths blog pattern).
//
// Two templates, chosen by guide.kind:
//   • 'guide'  → Article  : a clean, spacious long-form read (quick how-to).
//   • 'course' → Course   : one lesson per slide, progress bar, prev/next,
//                           an intro slide + a completion slide. Click-through.
---
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Training Studio — TMKE workspace"
  description="A TMKE Learn guide."
>
  <div class="ws lrn">
    <WorkspaceHeader active="guides" />

    <main class="lrn-main gr-main">
      <a class="gr-back" href="/account/guides">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg> Back to the Training Studio
      </a>

      <article class="gr" id="gr" aria-busy="true">
        <div class="gr-loading" id="gr-loading">Loading…</div>

        <!-- ============ ARTICLE (kind='guide') ============ -->
        <div class="gr-article" id="gr-article" hidden>
          <header class="gr-head">
            <a class="gr-topic" id="ar-topic" href="#"></a>
            <h1 class="gr-title" id="ar-title"></h1>
            <p class="gr-summary" id="ar-summary"></p>
            <div class="gr-meta" id="ar-meta"></div>
          </header>
          <figure class="gr-cover" id="ar-cover" hidden><img id="ar-cover-img" alt="" /></figure>
          <div class="gr-body" id="ar-body"></div>
          <footer class="gr-artfoot">
            <a class="ws-btn ws-btn--ghost ws-btn--sm" href="/account/guides">← Back to the Training Studio</a>
          </footer>
        </div>

        <!-- ============ COURSE (kind='course') ============ -->
        <div class="gc" id="gr-course" hidden>
          <div class="gc-progress" id="gc-progress">
            <div class="gc-bar"><span class="gc-fill" id="gc-fill"></span></div>
            <div class="gc-progress-meta">
              <span id="gc-step">Overview</span>
              <span id="gc-pct">0%</span>
            </div>
          </div>

          <div class="gc-stage" id="gc-stage" aria-live="polite"></div>

          <footer class="gc-nav" id="gc-nav" hidden>
            <button type="button" class="ws-btn ws-btn--ghost" id="gc-prev">
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M10 4L6 8l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span id="gc-prev-label">Previous</span>
            </button>
            <div class="gc-rail" id="gc-rail" aria-hidden="true"></div>
            <button type="button" class="ws-btn ws-btn--primary" id="gc-next">
              <span id="gc-next-label">Next</span>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </footer>
        </div>

        <div class="gr-empty" id="gr-empty" hidden>
          <h1>Not found</h1>
          <p>This may have moved or isn't published yet.</p>
          <a class="ws-btn ws-btn--primary ws-btn--sm" href="/account/guides">Back to the Training Studio</a>
        </div>
      </article>
      <HubFootBar />
    </main>
  </div>


  <script type="application/json" id="gr-defaults" set:html={JSON.stringify({ cover: DEFAULT_COVER })}></script>
  <script>
    import { isDemo as demoOn, isTrainingDemo, lock } from "../../../lib/demo.js";
    import { supabase } from "../../../lib/supabase.js";
    import { markSubheads, subheadsHtml } from "../../../lib/guide-subheads.js";
    import { memberCourseLevels, levelGate, LEVEL_NAME, LEVEL_WITH } from "../../../lib/guide-level.js";
    // Checklists (.bk-check): a tick stays ticked on this device, per guide.
    const ckKey = (slug, li) => `tmke-check:${slug}:${(li.querySelector("strong")?.textContent || "").trim().slice(0, 60)}`;
    const ckSet = (li, on) => { li.classList.toggle("is-done", on); li.querySelector(".bk-check-box")?.setAttribute("aria-pressed", on ? "true" : "false"); };
    function ckRestore(root, slug) {
      if (!root) return;
      root.dataset.ck = slug || "";
      root.querySelectorAll(".bk-check > li").forEach((li) => { let on = false; try { on = localStorage.getItem(ckKey(slug, li)) === "1"; } catch (_) {} ckSet(li, on); });
    }
    document.addEventListener("click", (e) => {
      const b = (e.target as any).closest?.(".bk-check-box"); if (!b) return;
      const li = b.closest("li"), root = b.closest("[data-ck]"); if (!li || !root) return;
      const on = !li.classList.contains("is-done"); ckSet(li, on);
      try { if (on) localStorage.setItem(ckKey(root.dataset.ck, li), "1"); else localStorage.removeItem(ckKey(root.dataset.ck, li)); } catch (_) {}
    });
    import { logUsage } from "../../../lib/usage-log.js";
    import { GUIDE_TOPIC_MAP } from "../../../data/guide-topics.js";
    import { CONTENT_IDEAS_GUIDE } from "../../../data/content-ideas-guide.js";
    import { TRAINING_GUIDES, PRINT_GUIDES, CALENDAR_GUIDES } from "../../../data/training-guides.js";
    import { withBuiltIn } from "../../../lib/guide-merge.js";
    import { guideViewer, guideVisibleTo } from "../../../lib/guide-audience.js";
    import { startWalk } from "../../../lib/tour.js";
    import { WALKS } from "../../../data/walkthroughs.js";
    const STATIC_GUIDES = [CONTENT_IDEAS_GUIDE, ...TRAINING_GUIDES, ...PRINT_GUIDES, ...CALENDAR_GUIDES];

    const $ = (s) => document.querySelector(s);
    const DEV = import.meta.env.DEV;
    let USER_ID = null;

    // Persist how far the member has got. One row per (member, guide); we only
    // ever push the furthest point forward, and flip completed once at the end.
    /* Forward only (Danielle, 17 Nov 2026: training should be reportable).
       Reopening a course used to save it again from part 1, so a finished
       course went back to "Part 1, not finished". Now the saved row is read
       first and never goes backwards, and the first finish date is kept
       (training_progress_reporting.sql makes the database hold to that too).
       Each new part reached and each first finish also goes in the usage log,
       so a training report can later say when, and where people stop. */
    const SAVED = new Map();     // slug -> Promise of { furthest, completed }
    function savedFor(slug) {
      if (!SAVED.has(slug)) SAVED.set(slug, (async () => {
        try {
          const { data } = await supabase.from("guide_progress").select("furthest, completed")
            .eq("user_id", USER_ID).eq("guide_slug", slug).maybeSingle();
          return { furthest: (data && data.furthest) || 0, completed: !!(data && data.completed) };
        } catch (_) { return { furthest: 0, completed: false }; }
      })());
      return SAVED.get(slug);
    }
    async function saveProgress(slug, { furthest, total, completed }) {
      if (!USER_ID || !slug) return;
      // One save at a time per guide, so quick clicks can't overtake each other.
      const prev = SAVED.get(slug + ":chain") || Promise.resolve();
      const next = prev.then(async () => {
        const was = await savedFor(slug);
        const now = { furthest: Math.max(was.furthest, furthest), completed: was.completed || !!completed };
        if (now.furthest === was.furthest && now.completed === was.completed && was.furthest > 0) return;
        const row = { user_id: USER_ID, guide_slug: slug, furthest: now.furthest, total, completed: now.completed };
        if (now.completed && !was.completed) row.completed_at = new Date().toISOString();
        try { await supabase.from("guide_progress").upsert(row, { onConflict: "user_id,guide_slug" }); } catch (_) {}
        if (total > 0) {
          for (let part = was.furthest + 1; part <= Math.min(now.furthest, total); part++) logUsage("course_part", { detail: { course: slug, part, of: total } });
          if (now.completed && !was.completed) logUsage("course_completed", { detail: { course: slug, of: total } });
        } else if (!was.completed && now.completed) logUsage("guide_read", { detail: { course: slug } });
        SAVED.set(slug, Promise.resolve(now));
      });
      SAVED.set(slug + ":chain", next.catch(() => {}));
      return next;
    }

    // Dev-only samples so both templates are viewable without a DB/session.
    //   ?g=sample         → article
    //   ?g=sample-course  → mini course
    const SAMPLE_ARTICLE = {
      slug: "sample", title: "Setting up your brand kit", topic: "getting-started",
      kind: "guide", summary: "Build a recognisable brand in minutes — colours, fonts and your logo, ready to drop into every design.",
      est_minutes: 5, cover_url: "",
      lessons: [
        { title: "", body_html: "<p>Your brand kit is the set of colours, fonts and logos that make every post <strong>unmistakably yours</strong>. Set it once and the Studio applies it everywhere.</p><h3>What you'll set</h3><ul><li>Your brand colours</li><li>Your fonts</li><li>Your logo</li></ul><p>Head to your profile and add your primary and secondary colours. These become one-tap swatches across the editor, so you never have to hunt for a hex code again.</p><blockquote>Tip: stick to two or three colours. Restraint reads as premium.</blockquote>" },
      ],
    };
    const SAMPLE_COURSE = {
      slug: "sample-course", title: "Your first week on social", topic: "social-intro",
      kind: "course", summary: "A short, guided walk-through to get you posting with confidence — five quick parts, done in a coffee break.",
      est_minutes: 8, cover_url: "",
      lessons: [
        { title: "Set your foundations", body_html: "<p>Before you post anything, get the basics right: a clear profile photo, a one-line bio that says what you do, and a link that goes somewhere useful.</p><ul><li>Square logo or clean headshot</li><li>Bio: who you help + how</li><li>One call-to-action link</li></ul>" },
        { title: "Find your three pillars", body_html: "<p>Pick three themes you'll post about. This keeps you consistent and stops the blank-page panic.</p><p>For most agents that's <strong>listings</strong>, <strong>local area</strong>, and <strong>behind the scenes</strong>.</p>" },
        { title: "Plan a week of posts", body_html: "<p>Batch it. Sit down once and rough out five posts against your pillars. You'll thank yourself on the busy days.</p>" },
        { title: "Write captions that land", body_html: "<p>Open with a hook, keep it human, end with one clear ask. Short sentences win.</p><blockquote>People scroll fast — earn the second line.</blockquote>" },
        { title: "Post, then review", body_html: "<p>Consistency beats perfection. Post your week, then check which one got the most saves and do more of that.</p>" },
      ],
    };

    const DEFAULTS = JSON.parse(document.getElementById("gr-defaults")?.textContent || "{}");
    function esc(s){ return String(s ?? "").replace(/[&<>\"]/g, (c)=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c])); }
    function topicLabel(slug){ const t = GUIDE_TOPIC_MAP[slug]; return t ? t.label : "Learn"; }

    function cleanLessons(guide){
      return Array.isArray(guide.lessons) ? guide.lessons.filter((l)=> l && (l.title || l.body_html)) : [];
    }

    // ---------------- ARTICLE ----------------
    function renderArticle(guide, lessons){
      $("#gr-article").hidden = false;
      const t = $("#ar-topic");
      t.textContent = topicLabel(guide.topic);
      t.href = "/account/guides#" + (guide.topic || "");
      $("#ar-title").textContent = guide.title || "Untitled";
      const sum = $("#ar-summary"); if (guide.summary) sum.textContent = guide.summary; else sum.hidden = true;

      const meta = [];
      if (guide.est_minutes) meta.push(`<span>${guide.est_minutes} min read</span>`);
      $("#ar-meta").innerHTML = meta.join("");

      if (guide.cover_url) { $("#ar-cover").hidden = false; const im = $("#ar-cover-img"); im.src = guide.cover_url; im.alt = guide.cover_alt || guide.title || ""; }

      // One flowing read. If an article somehow has several lessons, join them
      // with each lesson title as an <h2>.
      const html = lessons.length <= 1
        ? (lessons[0]?.body_html || "<p>This article has no content yet.</p>")
        : lessons.map((l)=> (l.title ? `<h2>${esc(l.title)}</h2>` : "") + (l.body_html || "")).join("");
      $("#ar-body").innerHTML = html;
      markSubheads($("#ar-body"));
      ckRestore($("#ar-body"), guide.slug);

      /* A Show me box in a guide's copy (Linking Your Accounts, Danielle,
         23 Nov): the same walkthrough a course part opens, back here after. */
      $("#ar-body").addEventListener("click", (e) => {
        const w = e.target.closest("[data-walk]"); if (!w) return;
        startWalk(w.dataset.walk, { returnTo: `/account/guides/read?g=${encodeURIComponent(guide.slug)}` });
      });

      // An article is a single short read — opening it counts as done.
      saveProgress(guide.slug, { furthest: 1, total: 0, completed: true });
    }

    // ---------------- COURSE ----------------
    function renderCourse(guide, lessons){
      $("#gr-course").hidden = false;
      $("#gc-progress").hidden = false;
      const N = lessons.length;                 // content slides
      const LAST = N + 1;                        // done slide index
      const stage = $("#gc-stage"), nav = $("#gc-nav");
      const fill = $("#gc-fill"), stepEl = $("#gc-step"), pctEl = $("#gc-pct");
      const prevBtn = $("#gc-prev"), nextBtn = $("#gc-next");
      const prevLabel = $("#gc-prev-label"), nextLabel = $("#gc-next-label");
      const rail = $("#gc-rail");

      // Rail = one dot per content part.
      rail.innerHTML = lessons.map((_, i)=> `<button type="button" class="gc-dot" data-go="${i+1}" title="Part ${i+1}"></button>`).join("");
      rail.querySelectorAll("[data-go]").forEach((b)=> b.addEventListener("click", ()=> show(+b.dataset.go)));
      // Links inside a slide can jump to a part too (the content-ideas cover's
      // four pillar cards do).
      stage.addEventListener("click", (e)=>{ const a = e.target.closest("[data-go]"); if (!a || a.closest("#gc-rail")) return; e.preventDefault(); show(+a.dataset.go); });

      const introHtml = () => {
        const chips = [];
        chips.push(`<span>${N} part${N===1?"":"s"}</span>`);
        if (guide.est_minutes) chips.push(`<span>~${guide.est_minutes} min</span>`);
        // The cover is the guide's own picture, or the Learn banner's when it
        // has none. The copy sits in a wine card at the top-left, over it.
        const coverSrc = guide.cover_url || DEFAULTS.cover || "";
        return `<div class="gc-slide gc-slide--intro" style="${coverSrc ? `background-image:url('${esc(coverSrc)}')` : ""}${guide.cover_pos ? `;background-position:${esc(guide.cover_pos)}` : ""}">
          <div class="gc-intro-card">
            <a class="gr-topic" href="/account/guides#${esc(guide.topic||"")}">${esc(topicLabel(guide.topic))}</a>
            <h1 class="gc-intro-title">${esc(guide.title || "Untitled")}</h1>
            ${Array.isArray(guide.intro) && guide.intro.length
              // A course's own introduction (training-guides.js `intro`) in place of its card line.
              ? guide.intro.map((t) => `<p class="gc-intro-sum">${esc(t)}</p>`).join("")
              : guide.summary ? `<p class="gc-intro-sum">${esc(guide.summary)}</p>` : ""}
            <div class="gc-intro-meta">${chips.join("")}</div>
            <div class="gc-intro-start"><button type="button" class="ws-btn ws-btn--primary" data-next>Start course
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button></div>
          </div>
        </div>`;
      };
      // A lesson can carry a video (YouTube, Vimeo or a plain file) above its
      // copy, and a walkthrough - a spotlight tour of the real page - offered
      // as "Show me" beneath it.
      const videoHtml = (url) => {
        const u = String(url || "").trim(); if (!u) return "";
        let m;
        if ((m = u.match(/(?:youtube\.com\/(?:watch\?v=|embed\/|shorts\/)|youtu\.be\/)([\w-]{6,})/)))
          return `<div class="gr-video"><iframe src="https://www.youtube-nocookie.com/embed/${m[1]}" title="Video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen loading="lazy"></iframe></div>`;
        if ((m = u.match(/vimeo\.com\/(?:video\/)?(\d+)/)))
          return `<div class="gr-video"><iframe src="https://player.vimeo.com/video/${m[1]}" title="Video" allow="autoplay; fullscreen; picture-in-picture" allowfullscreen loading="lazy"></iframe></div>`;
        return `<div class="gr-video"><video controls preload="metadata" src="${esc(u)}"></video></div>`;
      };
      const walkHtml = (id, i) => {
        if (!id || !WALKS[id]) return "";
        /* A walk still waiting for its pictures shows its box, with the
           button saying so rather than opening an empty demo (Dani, 13 Oct:
           the course has to show where each walkthrough goes). */
        if (WALKS[id].pending) {
          return `<div class="gr-walk gr-walk--soon">
            <span class="gr-walk-tx"><strong>${esc(WALKS[id].lead || "See it on the page")}</strong><span>${esc(WALKS[id].line || "")}</span></span>
            <button type="button" class="ws-btn ws-btn--primary ws-btn--sm" disabled aria-disabled="true">Coming soon</button>
          </div>`;
        }
        // A walk can name itself (lead / line in walkthroughs.js) when the
        // lesson has already said what it is about to show.
        const lead = WALKS[id].lead || "See it on the page";
        const line = WALKS[id].line || `A guided look at the real thing: ${WALKS[id].title}, ${WALKS[id].steps.length} steps. Finish brings you back here.`;
        return `<div class="gr-walk">
          <span class="gr-walk-tx"><strong>${esc(lead)}</strong><span>${esc(line)}</span></span>
          <button type="button" class="ws-btn ws-btn--primary ws-btn--sm" data-walk="${esc(id)}" data-part="${i}">Show me
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>`;
      };
      const partHtml = (i) => {
        const l = lessons[i-1];
        let body = subheadsHtml(l.body_html || ""), trailingTip = "", inlineWalk = false;
        // <!--WALK--> in the copy puts the "Show me" box exactly there, in the
        // middle of the lesson, rather than at the end of it.
        if (body.indexOf("<!--WALK-->") !== -1) {
          body = body.replace("<!--WALK-->", walkHtml(l.walk, i));
          inlineWalk = true;
        }
        // More than one walk in a part: <!--WALK:id--> puts that one's box there.
        body = body.replace(/<!--WALK:([\w-]+)-->/g, (m, id) => walkHtml(id, i));
        // A tip that closes the lesson sits under the Show me box, not above it.
        const m = body.match(/(<p class="ci-rhythm">[\s\S]*?<\/p>)\s*$/);
        if (m && !inlineWalk && l.walk && WALKS[l.walk]) { trailingTip = m[1]; body = body.slice(0, m.index); }
        return `<div class="gc-slide gc-slide--part">
          <span class="gc-part">Part ${i} of ${N}</span>
          ${l.title ? `<h2 class="gc-slide-title">${esc(l.title)}</h2>` : ""}
          ${videoHtml(l.video_url)}
          <div class="gc-slide-body gr-body">${body}</div>
          ${inlineWalk ? "" : walkHtml(l.walk, i)}
          ${trailingTip ? `<div class="gc-slide-body gr-body gr-body--after">${trailingTip}</div>` : ""}
        </div>`;
      };
      // The six parts of the Brand Kit: a card opens onto its detail, which is
      // already on the page beside it, hidden.
      const sheetWrap = document.createElement("div");
      sheetWrap.className = "bk-sheet-wrap";
      sheetWrap.hidden = true;
      sheetWrap.innerHTML = `<div class="bk-sheet" role="dialog" aria-modal="true"><button type="button" class="bk-sheet-x" aria-label="Close">&times;</button><div class="bk-sheet-body gr-body"></div></div>`;
      // Inside the workspace, not on the body: the brand tokens (--ws-accent and
      // the rest) are defined on .ws, so a panel appended outside it lost its
      // wine line - the declaration referenced a variable that wasn't there.
      (document.querySelector(".ws") || document.body).appendChild(sheetWrap);
      /* The wheel scrolls the pop-out, not the lesson behind it (Dani, 30 Oct):
         smooth scrolling is paused while it is open and leaves it alone. */
      sheetWrap.setAttribute("data-lenis-prevent", "");
      const closeSheet = () => { sheetWrap.hidden = true; sheetWrap.querySelector(".bk-sheet-body").innerHTML = ""; try { (window as any).__lenis?.start?.(); } catch (_) {} };
      sheetWrap.addEventListener("click", (e) => { if (e.target === sheetWrap || e.target.closest(".bk-sheet-x")) closeSheet(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !sheetWrap.hidden) closeSheet(); });
      stage.addEventListener("click", (e) => {
        const opener = e.target.closest("[data-bk-open]");
        if (!opener) return;
        const src = document.getElementById(opener.getAttribute("data-bk-open"));
        if (!src) return;
        sheetWrap.querySelector(".bk-sheet-body").innerHTML = src.innerHTML;
        sheetWrap.querySelector(".bk-sheet").classList.toggle("bk-sheet--wide", src.hasAttribute("data-wide"));
        sheetWrap.hidden = false;
        try { (window as any).__lenis?.stop?.(); } catch (_) {}
        sheetWrap.querySelector(".bk-sheet").scrollTop = 0;
      });

      // "Show me" - in the lesson itself, or inside one of the pop-outs.
      const wireWalks = (root) => root.addEventListener("click", (e) => {
        const b = e.target.closest("[data-walk]"); if (!b) return;
        const back = `/account/guides/read?g=${encodeURIComponent(guide.slug)}&p=${b.dataset.part}`;
        if (!sheetWrap.hidden) closeSheet();
        startWalk(b.dataset.walk, { returnTo: back });
      });
      wireWalks(stage);
      wireWalks(sheetWrap);
      const doneHtml = () => `<div class="gc-slide gc-slide--done">
        <div class="gc-done-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 13l4 4L19 7"/></svg></div>
        <h2>That's a wrap</h2>
        <p>You've finished <strong>${esc(guide.title || "this course")}</strong>. Nice work — put it into practice, then come back for the next one.</p>
        <div class="gc-done-actions">
          <a class="ws-btn ws-btn--primary ws-btn--sm" href="/account/guides">Back to the Training Studio</a>
          <button type="button" class="ws-btn ws-btn--ghost ws-btn--sm" data-restart>Start over</button>
        </div>
      </div>`;

      let pos = 0; // 0 = intro, 1..N = parts, N+1 = done
      let maxReached = 0, doneFlag = false;

      function show(next){
        pos = Math.max(0, Math.min(LAST, next));
        if (pos === 0)      stage.innerHTML = introHtml();
        else if (pos === LAST) stage.innerHTML = doneHtml();
        else                stage.innerHTML = partHtml(pos);
        ckRestore(stage, guide.slug);

        // Vertically centre content parts + the completion slide (deck feel);
        // keep the overview top-aligned.
        stage.classList.toggle("is-centered", pos !== 0);

        // Wire the per-slide buttons that just rendered.
        stage.querySelector("[data-next]")?.addEventListener("click", ()=> show(pos + 1));
        stage.querySelector("[data-restart]")?.addEventListener("click", ()=> show(1));

        // Progress bar: intro 0%, part k = k/N, done 100%.
        const pct = pos === 0 ? 0 : Math.round((Math.min(pos, N) / N) * 100);
        fill.style.width = pct + "%";
        pctEl.textContent = pct + "%";
        stepEl.textContent = pos === 0 ? "Overview" : pos === LAST ? "Complete" : `Part ${pos} of ${N}`;

        // Bottom nav shows on content parts only; intro/done have their own buttons.
        const onPart = pos >= 1 && pos <= N;
        nav.hidden = !onPart;
        // Parts fill the screen and scroll inside the card; the page itself
        // holds still. Measured, because the header and the main's padding
        // above the course differ by screen.
        const gc = $("#gr-course");
        // The cover fills the window too, down to the same margin as a part,
        // so the overview is one screen with nothing to scroll (Dani, 13 Oct).
        // Only where the window is tall enough to hold its card.
        const onCover = pos === 0 && matchMedia("(min-height: 520px)").matches;
        document.body.classList.toggle("gr-fixed", onPart || onCover);
        gc.classList.toggle("is-part", onPart);
        gc.classList.toggle("is-cover", onCover);
        if (onPart || onCover) {
          const fit = () => {
            gc.style.setProperty("--gc-top", Math.max(0, Math.round(gc.getBoundingClientRect().top + window.scrollY)) + "px");
            // The foot bar's own height, so it fits on the screen under the card.
            const foot = document.querySelector(".hub-foot");
            if (foot) gc.style.setProperty("--gc-foot", foot.offsetHeight + "px");
          };
          fit(); requestAnimationFrame(fit);
          if (!gc._fitBound) { gc._fitBound = true; window.addEventListener("resize", fit); }
        }
        if (onPart) {
          const slide = stage.querySelector(".gc-slide--part");
          if (slide) {
            slide.scrollTop = 0;
            slide.setAttribute("data-lenis-prevent", "");
            // Next sits over the scrolling copy, whose right edge stops short of
            // the card's by the scrollbar's width and the card's own border.
            // Measured off the copy itself, so the button ends where the cards
            // above it end, whatever the browser draws.
            const copy = slide.querySelector(".gr-body") || slide;
            const padR = Math.max(0, gc.getBoundingClientRect().right - copy.getBoundingClientRect().right - 1);
            gc.style.setProperty("--gc-pad-r", padR.toFixed(2) + "px");
          }
        }
        if (onPart){
          prevBtn.classList.toggle("gc-prev-hidden", false);
          prevLabel.textContent = pos === 1 ? "Overview" : "Previous";
          nextLabel.textContent = pos === N ? "Finish" : "Next";
        }

        // Rail state.
        rail.querySelectorAll(".gc-dot").forEach((d, i)=>{
          const part = i + 1;
          d.classList.toggle("is-active", part === pos);
          d.classList.toggle("is-done", part < pos || pos === LAST);
        });

        window.scrollTo({ top: 0, behavior: onPart ? "auto" : "smooth" });

        // Save progress once they've actually started (past the overview).
        maxReached = Math.max(maxReached, pos);
        if (pos === LAST) doneFlag = true;
        if (maxReached >= 1) saveProgress(guide.slug, { furthest: maxReached, total: N, completed: doneFlag });
      }

      prevBtn.addEventListener("click", ()=> show(pos - 1));
      nextBtn.addEventListener("click", ()=> show(pos + 1));

      // The page doesn't scroll on a part, so a wheel anywhere on it - over
      // the header, the progress bar, the margins - moves the card's copy.
      // Over the card itself the browser already does this.
      window.addEventListener("wheel", (e)=>{
        if (!document.body.classList.contains("gr-fixed")) return;
        const slide = stage.querySelector(".gc-slide--part"); if (!slide) return;
        if (slide.contains(e.target)) return;
        slide.scrollTop += e.deltaY;
      }, { passive: true });

      // Resume from the Learn card (?p=<part>) when asked; otherwise the overview.
      const jump = parseInt(new URLSearchParams(location.search).get("p"), 10);
      show(Number.isFinite(jump) && jump >= 1 ? Math.min(jump, N) : 0);
    }

    function render(guide){

      // The public demo reads Getting Started only; the training account (ours) reads everything (Danielle, 23 Nov).
      if (demoOn() && !isTrainingDemo() && guide && guide.topic && guide.topic !== "getting-started") { lock("That guide is for members.", "The demo includes the Getting Started guides. Members have the whole Learning Centre."); guide = null; }
      $("#gr-loading").hidden = true;
      if (!guide) { $("#gr-empty").hidden = false; $("#gr").setAttribute("aria-busy","false"); return; }
      $("#gr").setAttribute("aria-busy","false");
      const lessons = cleanLessons(guide);
      const isCourse = guide.kind === "course" && lessons.length > 0;
      if (isCourse) renderCourse(guide, lessons);
      else renderArticle(guide, lessons);
    }

    (async () => {
      const slug = new URLSearchParams(location.search).get("g") || "";
      let session = null;
      try { const { data } = await supabase.auth.getSession(); session = data.session; } catch (_) {}
      if (!session && !DEV && !demoOn()) { location.replace("/login?next=" + encodeURIComponent(location.pathname + location.search)); return; }
      USER_ID = session?.user?.id || null;

      // Fill the header identity (mirrors the Learn page).
      if (session) {
        const email = session.user.email ?? "";
        const meta = session.user.user_metadata ?? {};
        const fullName = (meta.name || email.split("@")[0].replace(/[._]/g, " ")).replace(/\b\w/g, (c)=>c.toUpperCase());
        const initials = fullName.split(" ").slice(0,2).map((w)=>w[0]).join("").toUpperCase() || "T";
        document.querySelectorAll(".ws-whoav").forEach((e)=>e.textContent = initials);
        const set = (sel,v)=>{ const el=document.querySelector(sel); if(el&&v) el.textContent=v; };
        set(".ws-whotext strong", fullName); set(".ws-whotext span", email);
      }

      const devSample = slug === "sample-course" ? SAMPLE_COURSE : SAMPLE_ARTICLE;
      /* A guide for The Experts Group's agents only shows them a short note
         instead, pointing back to Learn (src/lib/guide-audience.js). */
      async function renderFor(g) {
        if (g && g.audience === "teg") {
          let viewer = { teg: false };
          try { viewer = await guideViewer(supabase); } catch (_) {}
          if (!guideVisibleTo(g, viewer)) {
            render({ slug: g.slug, kind: "article", title: g.title, topic: g.topic,
              summary: "This course is for agents of The Experts Group.",
              lessons: [{ title: g.title, body_html: "<p>It uses the print templates made for The Experts Group's brands. Head back to Learn for the guides and courses available to you.</p>" }] });
            return;
          }
        }
        /* Above their level (src/lib/guide-level.js): set to show locked, a
           short note with what it comes with; otherwise it isn't there. */
        if (g && g.level && g.level !== "free") {
          const { levels, access } = await memberCourseLevels(supabase);
          const gate = levelGate(g, levels);
          if (gate === "hidden") { render(null); return; }
          if (gate === "locked") {
            const name = LEVEL_WITH[g.level] || LEVEL_NAME[g.level], what = g.kind === "course" ? "course" : g.kind === "article" ? "article" : "guide";
            const plan = access && access.calendar ? `<p><a href="/account/settings">See your plan</a></p>` : "";
            render({ slug: g.slug, kind: "article", title: g.title, topic: g.topic, cover_url: g.cover_url, art: g.art,
              summary: `This ${what} comes with ${name}.`,
              lessons: [{ title: g.title, body_html: `${g.summary ? `<p>${esc(g.summary)}</p>` : ""}<p>It opens for members who have ${name}.</p>${plan}` }] });
            return;
          }
        }
        render(g);
      }
      // Guides that ship with the site (content-ideas). A published DB row with
      // the same slug wins; until one exists the static copy is what members read.
      const builtIn = STATIC_GUIDES.find((g) => g.slug === slug) || null;
      if (!slug) { render(DEV ? SAMPLE_ARTICLE : null); return; }
      try {
        const { data, error } = await supabase.from("guides").select("*").eq("slug", slug).eq("status","published").maybeSingle();
        if (error) throw error;
        // A database copy of a built-in keeps the built-in's picture and settings (src/lib/guide-merge.js).
        await renderFor((data ? withBuiltIn(data, builtIn) : builtIn) || (DEV ? devSample : null));
      } catch (_) { await renderFor(builtIn || (DEV ? devSample : null)); }
    })();
  </script>
</BaseLayout>
