---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../../components/account/WorkspaceHeader.astro";
import { GUIDE_TOPICS } from "../../../data/guide-topics.js";
// Single reader page (query param ?g=<slug>) so newly-published guides work
// instantly — no site rebuild needed (unlike the getStaticPaths blog pattern).
---
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Guide — TMKE workspace"
  description="A TMKE Learn guide."
>
  <div class="ws lrn">
    <WorkspaceHeader active="guides" />

    <main class="lrn-main gr-main">
      <a class="gr-back" href="/account/guides">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6"/></svg> Back to Learn
      </a>

      <article class="gr" id="gr" aria-busy="true">
        <div class="gr-loading" id="gr-loading">Loading…</div>

        <div class="gr-shell" id="gr-shell" hidden>
          <header class="gr-head">
            <a class="gr-topic" id="gr-topic" href="#"></a>
            <h1 class="gr-title" id="gr-title"></h1>
            <p class="gr-summary" id="gr-summary"></p>
            <div class="gr-meta" id="gr-meta"></div>
          </header>

          <figure class="gr-cover" id="gr-cover" hidden><img id="gr-cover-img" alt="" /></figure>

          <!-- Lesson chips (only shown for multi-lesson courses) -->
          <nav class="gr-lessons" id="gr-lessons" hidden aria-label="Lessons"></nav>

          <div class="gr-body" id="gr-body"></div>

          <footer class="gr-foot" id="gr-foot" hidden>
            <button type="button" class="ws-btn ws-btn--ghost ws-btn--sm" id="gr-prev" hidden><svg viewBox="0 0 16 16"><path d="M10 4L6 8l4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg> Previous</button>
            <button type="button" class="ws-btn ws-btn--primary ws-btn--sm" id="gr-next">Next <svg viewBox="0 0 16 16"><path d="M6 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
          </footer>
        </div>

        <div class="gr-empty" id="gr-empty" hidden>
          <h1>Guide not found</h1>
          <p>This guide may have moved or isn't published yet.</p>
          <a class="ws-btn ws-btn--primary ws-btn--sm" href="/account/guides">Back to Learn</a>
        </div>
      </article>
    </main>
  </div>

  <style is:global>
    .gr-main { max-width: 820px; }
    .gr-back { display: inline-flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--ws-tx); text-decoration: none; margin-bottom: 4px; }
    .gr-back svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .gr-back:hover { color: var(--ws-ink); }
    .gr-loading, .gr-empty { text-align: center; padding: 60px 0; color: var(--ws-faint); font-size: 14px; }
    .gr-empty h1 { font-family: var(--serif); font-weight: 500; color: var(--ws-ink); font-size: 28px; margin: 0 0 8px; }
    .gr-empty p { margin: 0 0 18px; }

    .gr-topic { display: inline-flex; align-items: center; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ws-accent); text-decoration: none; margin-bottom: 12px; }
    .gr-title { font-family: var(--serif); font-weight: 500; font-size: clamp(30px, 4vw, 46px); line-height: 1.06; letter-spacing: -0.02em; color: var(--ws-ink); margin: 0; }
    .gr-summary { font-size: clamp(15px, 1.3vw, 18px); line-height: 1.6; color: var(--ws-tx); margin: 14px 0 0; }
    .gr-meta { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 18px 0 0; font-size: 12.5px; color: var(--ws-faint); }
    .gr-meta span { display: inline-flex; align-items: center; gap: 6px; }

    .gr-cover { margin: 26px 0 0; border-radius: var(--ws-r-lg); overflow: hidden; box-shadow: var(--ws-sh); }
    .gr-cover img { display: block; width: 100%; height: auto; }

    .gr-lessons { display: flex; flex-wrap: wrap; gap: 8px; margin: 28px 0 0; }
    .gr-lesson-chip { padding: 8px 14px; border: 1px solid var(--ws-line); border-radius: 999px; background: var(--ws-card); cursor: pointer; font-family: inherit; font-size: 13px; font-weight: 600; color: var(--ws-tx); transition: border-color .15s, color .15s, background .15s; }
    .gr-lesson-chip:hover { border-color: var(--ws-accent); color: var(--ws-ink); }
    .gr-lesson-chip.is-active { border-color: var(--ws-accent); background: color-mix(in srgb, var(--ws-accent) 8%, #fff); color: var(--ws-accent); }
    .gr-lesson-chip b { display: inline-block; width: 18px; opacity: 0.6; }

    .gr-body { margin: 30px 0 0; font-size: 16px; line-height: 1.72; color: var(--ws-ink); }
    .gr-body h2 { font-family: var(--serif); font-weight: 500; font-size: 26px; line-height: 1.15; margin: 34px 0 12px; }
    .gr-body h3 { font-size: 18px; font-weight: 700; margin: 26px 0 8px; }
    .gr-body p { margin: 0 0 16px; }
    .gr-body ul, .gr-body ol { margin: 0 0 16px; padding-left: 22px; }
    .gr-body li { margin: 0 0 8px; }
    .gr-body img { max-width: 100%; height: auto; border-radius: var(--ws-r); margin: 8px 0; }
    .gr-body a { color: var(--ws-accent); }
    .gr-body strong { font-weight: 700; }
    .gr-body blockquote { margin: 0 0 16px; padding: 4px 0 4px 18px; border-left: 3px solid var(--ws-accent); color: var(--ws-tx); font-style: italic; }

    .gr-foot { display: flex; justify-content: space-between; gap: 12px; margin: 40px 0 0; padding-top: 22px; border-top: 1px solid var(--ws-line); }
    .ws-btn--ghost { background: var(--ws-card); border-color: var(--ws-line); color: var(--ws-ink); }
    .ws-btn--ghost:hover { border-color: var(--ws-accent); }
  </style>

  <script>
    import { supabase } from "../../../lib/supabase.js";
    import { GUIDE_TOPIC_MAP } from "../../../data/guide-topics.js";

    const $ = (s) => document.querySelector(s);
    const DEV = import.meta.env.DEV;

    // A dev-only sample so the reader is viewable without a DB/session.
    const SAMPLE = {
      slug: "sample", title: "Setting up your brand kit", topic: "getting-started",
      kind: "guide", summary: "Build a recognisable brand in minutes — colours, fonts and logo, ready to drop into every design.",
      est_minutes: 6, cover_url: "",
      lessons: [
        { title: "Why a brand kit", body_html: "<p>Your brand kit is the set of colours, fonts and logos that make every post <strong>unmistakably yours</strong>. Set it once and the Studio applies it everywhere.</p><h3>What you'll set</h3><ul><li>Brand colours</li><li>Fonts</li><li>Your logo</li></ul>" },
        { title: "Add your colours", body_html: "<p>Head to your profile and add your primary and secondary colours. These become one-tap swatches across the editor.</p>" },
      ],
    };

    function esc(s){ return String(s ?? "").replace(/[&<>\"]/g, (c)=>({"&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;"}[c])); }

    function render(guide) {
      $("#gr-loading").hidden = true;
      if (!guide) { $("#gr-empty").hidden = false; $("#gr").setAttribute("aria-busy","false"); return; }
      $("#gr-shell").hidden = false;
      $("#gr").setAttribute("aria-busy","false");

      const topic = GUIDE_TOPIC_MAP[guide.topic];
      const t = $("#gr-topic");
      t.textContent = topic ? topic.label : "Guides";
      t.href = "/account/guides#" + (guide.topic || "");
      $("#gr-title").textContent = guide.title || "Untitled";
      const sum = $("#gr-summary"); if (guide.summary) sum.textContent = guide.summary; else sum.hidden = true;

      const meta = [];
      if (guide.kind === "course") meta.push(`<span>${(guide.lessons||[]).length} lessons</span>`);
      if (guide.est_minutes) meta.push(`<span>~${guide.est_minutes} min</span>`);
      $("#gr-meta").innerHTML = meta.join("");

      if (guide.cover_url) { $("#gr-cover").hidden = false; const im = $("#gr-cover-img"); im.src = guide.cover_url; im.alt = guide.cover_alt || guide.title || ""; }

      const lessons = Array.isArray(guide.lessons) ? guide.lessons.filter((l)=>l && (l.title || l.body_html)) : [];
      if (!lessons.length) { $("#gr-body").innerHTML = "<p>This guide has no content yet.</p>"; return; }

      // Multi-lesson courses get chips + prev/next; single guides just render inline.
      let idx = 0;
      const multi = lessons.length > 1;
      const nav = $("#gr-lessons"), foot = $("#gr-foot");
      const show = (i) => {
        idx = Math.max(0, Math.min(lessons.length - 1, i));
        $("#gr-body").innerHTML = lessons[idx].body_html || "";
        if (multi) {
          [...nav.children].forEach((c, n) => c.classList.toggle("is-active", n === idx));
          $("#gr-prev").hidden = idx === 0;
          $("#gr-next").textContent = idx === lessons.length - 1 ? "Finish" : "Next";
          window.scrollTo({ top: 0, behavior: "smooth" });
        }
      };
      if (multi) {
        nav.hidden = false; foot.hidden = false;
        nav.innerHTML = lessons.map((l, i) => `<button type="button" class="gr-lesson-chip" data-i="${i}"><b>${i+1}</b>${esc(l.title || ("Lesson " + (i+1)))}</button>`).join("");
        nav.querySelectorAll("[data-i]").forEach((b) => b.addEventListener("click", () => show(+b.dataset.i)));
        $("#gr-next").addEventListener("click", () => { if (idx < lessons.length - 1) show(idx + 1); else location.href = "/account/guides"; });
        $("#gr-prev").addEventListener("click", () => show(idx - 1));
      }
      show(0);
    }

    (async () => {
      const slug = new URLSearchParams(location.search).get("g") || "";
      let session = null;
      try { const { data } = await supabase.auth.getSession(); session = data.session; } catch (_) {}
      if (!session && !DEV) { location.replace("/login?next=" + encodeURIComponent(location.pathname + location.search)); return; }

      // Fill the header identity (mirrors the Learn page).
      if (session) {
        const email = session.user.email ?? "";
        const meta = session.user.user_metadata ?? {};
        const fullName = (meta.name || email.split("@")[0].replace(/[._]/g, " ")).replace(/\b\w/g, (c)=>c.toUpperCase());
        const initials = fullName.split(" ").slice(0,2).map((w)=>w[0]).join("").toUpperCase() || "T";
        document.querySelectorAll(".ws-whoav").forEach((e)=>e.textContent = initials);
        const set = (sel,v)=>{ const el=document.querySelector(sel); if(el&&v) el.textContent=v; };
        set(".ws-whotext strong", fullName); set(".ws-whotext span", email);
      }

      if (!slug) { render(DEV ? SAMPLE : null); return; }
      try {
        const { data, error } = await supabase.from("guides").select("*").eq("slug", slug).eq("status","published").maybeSingle();
        if (error) throw error;
        render(data || (DEV ? SAMPLE : null));
      } catch (_) { render(DEV ? SAMPLE : null); }
    })();
  </script>
</BaseLayout>
