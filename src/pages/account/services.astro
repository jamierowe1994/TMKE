---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import ServicesPanel from "../../components/account/ServicesPanel.astro";
import "../../styles/workspace.css";
import "../../styles/account-sections.css";
---

<BaseLayout
  dashboard
  title="Managed socials — TMKE workspace"
  description="Hand the channel over. Three tiers, a clear process, and a single point of contact."
  hideNav
  hideFooter
>
  <WorkspaceHeader active="services" />
  <div class="dash-shell dash-shell--top">
    <main class="app-main dash-main">
      <ServicesPanel />
    </main>
  </div>

  <script>
    import { supabase } from "../../lib/supabase.js";
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        location.replace('/login?next=' + encodeURIComponent('/account/services'));
        return;
      }
      requestAnimationFrame(() => document.body.classList.add('is-loaded'));
      document.getElementById('app-signout')?.addEventListener('click', async () => {
        await supabase.auth.signOut();
        location.replace('/login');
      });
    })();
  </script>
</BaseLayout>
