---
import BaseLayout from "../../layouts/BaseLayout.astro";
import WorkspaceHeader from "../../components/account/WorkspaceHeader.astro";
import HubFootBar from "../../components/account/HubFootBar.astro";
import CaptionGenerator from "../../components/CaptionGenerator.astro";
import QrGenerator from "../../components/QrGenerator.astro";
import "../../styles/ws-system.css";
import "../../styles/reel.css";
import NewDesignModal from "../../components/account/NewDesignModal.astro";
import StudioInspo from "../../components/account/StudioInspo.astro";

// ---------------------------------------------------------------------------
// Studio launcher — the page you land on from the "Studio" tab. Top nav only
// (no left rail). A hero with a mock of the editor + entry CTAs, then: pick a
// pack -> your designs -> design tools -> inspiration. Picks open the real
// editor at /editor; pack browsing/buying lives in The Edit (/edit).
// ---------------------------------------------------------------------------

const tools = [
  { name: "Caption Generator", desc: "Write on-brand captions & hashtags with AI.", action: "caption", ic: "caption" },
  // In Background Remover's place (Dani, 16 Oct): a pop-out of its own.
  { name: "QR Code Generator", desc: "A QR code for any link or a WhatsApp chat.", action: "qr", ic: "qr" },
  { name: "Brand Kit", desc: "Apply your brand colours and fonts instantly.", href: "/account/profile", ic: "brand" },
  { name: "Templates", desc: "Browse beautiful on-brand templates.", href: "/edit", ic: "grid" },
];

// Icons for the shared tool cards, keyed by the `ic` on each tool above.
const TOOL_ICONS = {
  caption: '<svg viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/><line x1="7" y1="9" x2="17" y2="9"/><line x1="7" y1="13" x2="13" y2="13"/></svg>',
  qr: '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><path d="M14 14h3v3h-3zM20 14v.01M14 20h.01M17 17h3v3"/></svg>',
  brand: '<svg viewBox="0 0 24 24"><path d="M6 3h12v18l-6-4-6 4z"/></svg>',
  grid: '<svg viewBox="0 0 24 24"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
};

// The four inspiration cards. Three open the StudioInspo pop-out (data-inspo);
// Content ideas is a proper read, so it links to the guide instead.
const R2 = (n) => `https://assets.tmke.co.uk/${n}.webp`;
/* Dani's own artwork, in the hub folder. The name is the file's real name,
   checked against the bucket rather than typed from the brief — the spaces and
   the apostrophes are exactly where a guess goes wrong. */
const HUB = (n) => `https://assets.tmke.co.uk/TMKE%20Member%20Hub/${encodeURIComponent(n)}.png`;
// Chapter 04's second row (Dani, 16 Oct): these three as cards; Content
// ideas moves to the Explore links beside them, as a link, not a picture.
const inspo = [
  { key: "trending", name: "See what's working", flag: "Updated monthly", desc: "Five formats performing right now, updated monthly.", thumb: HUB("See whats working"), cta: "View" },
  /* Seasonal moments does NOT follow the calendar, unlike the card of nearly
     the same name on the dashboard. This one shows the seasonal PACK, and the
     pack changes when the pack is made, not when the month turns — it is the
     autumn pack until the winter one is built (Dani, 8 Oct). Swap it by
     replacing Seasonal Moments.png in the hub folder on R2; no deploy. */
  { key: "seasonal", name: "Seasonal moments",   flag: "This season",     desc: "The pack for this time of year.",                  thumb: HUB("Seasonal Moments"), cta: "Browse" },
  { key: "brand",    name: "Brand inspo",        flag: "In your colours", desc: "Our templates, in your colours.",                  thumb: HUB("Brand Inspo"), cta: "See" },
];
---
<BaseLayout
  dashboard
  hideNav
  hideFooter
  title="Studio — TMKE"
  readyGate
  description="Bring ideas to life. Start from your packs, pick up a design in progress, or open the Studio with a blank canvas."
>
  <div class="ws">
    <WorkspaceHeader active="studio" />

    <main class="ws-main">
      <div class="ws-left">
      <!-- ============ HERO ============ -->
      <section class="ws-hero ws-hero--sub" data-gate="hero">
        <div class="ws-hero-copy">
          <p class="ws-hero-date"><a href="/account" class="st-back">&larr; Workspace</a></p>
          <h1 class="ws-greeting">Your Design Studio.</h1>
          <p class="ws-hero-sub">Edit your templates, create new assets and design content that&rsquo;s ready to post.</p>
          <div class="ws-hero-cta st-cta">
              <button type="button" class="ws-btn ws-btn--primary" data-new-design>Create new design
                <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 3v10M3 8h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
              </button>
          </div>
        </div>
      </section>

      <!-- ============ PICK FROM YOUR PACKS ============ -->
      <section class="ws-block ws-rise" style="--i:1" aria-labelledby="packs-h" id="packs">
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="packs-h"><span class="ws-block-ch">Chapter 01</span>Your packs</h2>
          <a class="ws-block-link" href="/edit">View All Templates <span aria-hidden="true">→</span></a>
        </header>
        <div class="st-rail" data-rail>
          <!-- Empty until the member's own packs are in (wirePacks, below).
               The page stays behind the ready gate until then: no sample
               packs, no stand-in cards (Dani, 14 Oct). -->
          <div class="st-row st-row--packs" data-packs data-gate="packs"></div>
          <!-- One dot per pack. Built by wireRail() once the real packs are in,
               so the count always matches what is on the shelf. -->
          <div class="st-nav" data-rail-nav hidden>
            <button type="button" class="st-nav-arrow" data-rail-prev aria-label="Previous pack">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
            <div class="st-dots" data-rail-dots></div>
            <button type="button" class="st-nav-arrow" data-rail-next aria-label="Next pack">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </div>
        </div>
      </section>

      <!-- ============ YOUR DESIGNS ============ -->
      <section class="ws-block ws-rise" style="--i:2" aria-labelledby="designs-h">
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="designs-h"><span class="ws-block-ch">Chapter 02</span>Your designs</h2>
          <a class="ws-block-link" href="/account/editor" data-seeall hidden>See All Designs <span aria-hidden="true">→</span></a>
        </header>
        <!-- Empty until the member's own designs are in (wireDesigns). -->
        <div class="st-row st-row--designs" data-designs data-gate="designs"></div>
      </section>

      <!-- ============ DESIGN TOOLS ============ -->
      <section class="ws-block ws-rise" style="--i:3" aria-labelledby="tools-h">
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="tools-h"><span class="ws-block-ch">Chapter 03</span>Design tools</h2>
        </header>
        <div class="ws-tools">
          {tools.map((t) => (
            t.action ? (
              <button type="button" class="ws-tool" data-tool={t.action}>
                <span class="ws-tool-ic" set:html={TOOL_ICONS[t.ic]} />
                <span class="ws-tool-tx"><strong>{t.name}</strong><span>{t.desc}</span></span>
                <span class="ws-tool-go" aria-hidden="true">→</span>
              </button>
            ) : (
              <a class="ws-tool" href={t.href}>
                <span class="ws-tool-ic" set:html={TOOL_ICONS[t.ic]} />
                <span class="ws-tool-tx"><strong>{t.name}</strong><span>{t.desc}</span></span>
                <span class="ws-tool-go" aria-hidden="true">→</span>
              </a>
            )
          ))}
        </div>
      </section>

      <!-- ============ INSPIRATION ============
           Two rows: Explore links and three cards (the dashboard's Chapter 05
           layout), then the packs going by, two or three of a pack together
           before the next (Dani, 16-17 Oct). -->
      <section class="ws-block ws-rise" style="--i:4" aria-labelledby="inspo-h">
        <header class="ws-block-head">
          <h2 class="ws-block-h" id="inspo-h"><span class="ws-block-ch">Chapter 04</span>Inspiration</h2>
          <a class="ws-block-link" href="/account/guides">Explore More <span aria-hidden="true">→</span></a>
        </header>
        <div class="ws-wn st-wn" data-gate="inspo">
          <div class="ws-wn-col ws-wn-col--keys">
            <p class="ws-wn-label">Explore</p>
            <nav class="ws-wn-pills" aria-label="Explore">
              <span class="ws-wn-row"><a class="ws-wn-pill" href="/account/guides/read?g=content-ideas">Evergreen content ideas</a></span>
              <span class="ws-wn-row"><a class="ws-wn-pill" href="/account/guides/read?g=training-studio">How to edit a template</a></span>
              <!-- This month's "What to post" piece from the blog, once it's
                   found (wireMonthIdeas); a month without one has no link. -->
              <span class="ws-wn-row"><a class="ws-wn-pill" id="st-month-ideas" href="/account/blog" hidden>This month's content ideas</a><a class="ws-wn-pill" href="/account/guides">All guides</a></span>
            </nav>
          </div>
          <div class="ws-wn-col">
            <p class="ws-wn-label">Latest</p>
            <div class="ws-wn-cards">
              {inspo.map((c) => (
                <button type="button" class="ws-wn-card" data-inspo={c.key}>
                  <span class="ws-wn-art" style={`background-image:url('${c.thumb}')`}></span>
                  <span class="ws-wn-tx">
                    <span class="ws-wn-flag">{c.flag}</span>
                    <strong class="ws-wn-h">{c.name}</strong>
                  </span>
                </button>
              ))}
            </div>
          </div>
        </div>
        <!-- Filled by fillPackReel (src/lib/pack-reel.js); empty until its
             pictures have loaded, nothing standing in for them. -->
        <div class="ws-reel st-reel" id="st-reel" aria-label="Templates from our packs" aria-busy="true">
          <div class="ws-reel-track"></div>
        </div>
      </section>
      </div>
      <HubFootBar />
    </main>
  </div>

  <CaptionGenerator />
  <QrGenerator />
  <NewDesignModal />
  <StudioInspo />

  <style is:global>
    /* The header and spacing are the shared ones (ws-system.css). */
    /* Chapter 04: Explore and Latest, then the strip under them. */
    .st-reel { margin-top: clamp(18px, 2.4vw, 32px); }
    .st-wn button.ws-wn-card { font: inherit; text-align: left; cursor: pointer; width: 100%; }

    /* Studio's own furniture. The tokens, layout, buttons, chapter strips and
       the tool cards all come from ws-system.css - only the pack, design and
       inspiration shelves are particular to this page. */

    /* Hero — the shared frame; only the photograph is Studio's own. */
    .ws-hero { --ws-hero-img: url('/assets/hub/studio.jpg'); }
    .ws-greeting { text-wrap: balance; }
    /* Sits on the panel's bottom padding, the same 56px off the floor as the
       dashboard's button, rather than wherever the copy above happens to end.
       The padding is the floor for when the copy is long enough to close the
       gap itself - margin-top:auto collapses to nothing then. */
    /* Spacing comes from .ws-hero-cta now, so every subpage hero is one height. */
    .st-cta { display: flex; flex-wrap: wrap; gap: 10px; }

    /* Horizontal shelves. One card size across packs, designs and inspiration,
       so the three sections read as one page rather than three. */
    .st-rail { position: relative; }
    /* A fixed number of cards across, so anything beyond that genuinely runs
       off the shelf and the dots below have something to do. At 1fr the cards
       simply shrank to fit and the slider was decorative. */
    .st-row {
      --st-across: 5;
      display: grid; grid-auto-flow: column;
      grid-auto-columns: calc((100% - (var(--st-across) - 1) * var(--ws-gap)) / var(--st-across));
      gap: var(--ws-gap); overflow-x: auto; scroll-snap-type: x proximity;
      scrollbar-width: none; padding-bottom: 2px;
    }
    .st-row > * { scroll-snap-align: start; }
    .st-row::-webkit-scrollbar { display: none; }
    @media (max-width: 1200px) { .st-row { --st-across: 4; } }
    @media (max-width: 900px)  { .st-row { --st-across: 2.4; } }
    @media (max-width: 560px)  { .st-row { --st-across: 1.3; } }

    .st-pack, .st-design {
      display: flex; flex-direction: column; gap: 4px; padding: 12px;
      border: 1px solid var(--ws-line); border-radius: var(--ws-r); background: #fff;
      text-decoration: none; color: var(--ws-ink);
      transition: border-color 0.25s var(--ws-ease), transform 0.25s var(--ws-ease);
    }
    .st-pack:hover, .st-design:hover { transform: translateY(-3px); border-color: rgba(28,29,34,0.22); }
    .st-pack-img, .st-design-img {
      position: relative; width: 100%; aspect-ratio: 1080 / 1440; border-radius: 4px;
      background-size: cover; background-position: center; background-color: #e9e6e2; margin-bottom: 8px;
    }
    /* A design keeps its own shape. One frame for the grid, the picture whole
       inside it and the rest left grey — a postcard cropped to a portrait tile
       showed the middle third of itself, which is neither the design nor a
       useful way to tell one from another. Packs too: a print pack's cover is
       often borrowed from one of its own designs, so it was being stretched
       the same way. */
    .st-design-img, .st-pack-img {
      background-size: contain; background-repeat: no-repeat;
    }
    /* The Print tab (Dani, 13 Oct): a print card is the shape of its own
       design -- landscape, mostly -- at 75% of a social card's picture
       height, so nothing grey sits around it. --st-print-h is worked out from
       the social column (fitPrintRow); --ar is each card's own shape. Social
       is untouched. */
    .st-row--print { grid-auto-columns: max-content; }
    .st-row--print > .st-pack, .st-row--print > .st-design { width: calc(var(--st-print-h, 200px) * var(--ar, 1.414) + 26px); box-sizing: border-box; }
    .st-row--print .st-pack-img, .st-row--print .st-design-img {
      width: 100%; height: var(--st-print-h, 200px); aspect-ratio: auto; background-size: cover;
    }
    .st-row--print > .st-design--new, .st-row--print > .st-design--all { min-height: calc(var(--st-print-h, 200px) + 26px); }
    /* Social / Print over a shelf that holds both. The hub's own pill shape —
       quiet until chosen, the way the rest of the workspace behaves. */
    .st-kinds { display: inline-flex; gap: 4px; padding: 3px; margin: 0 0 14px; border-radius: 999px; background: rgba(28,29,34,0.05); }
    .st-kind {
      appearance: none; border: 0; cursor: pointer;
      padding: 7px 18px; border-radius: 999px; background: transparent;
      font-family: var(--sans); font-size: var(--ws-t-meta); font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase; color: var(--ws-faint);
      transition: background 0.18s, color 0.18s, box-shadow 0.18s;
    }
    .st-kind:hover { color: var(--ink); }
    .st-kind.is-on { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(28,29,34,0.16); }
    .st-kind:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
    /* "See all designs" sits on the shelf now, so it reads as the last card
       rather than a link in the heading the toggle has taken. A whole card
       like "New design", in the brand's second colour so the two read as a
       pair without reading as the same thing. */
    .st-design--all {
      align-items: center; justify-content: center;
      border-style: solid; border-color: color-mix(in srgb, #7e6765 26%, transparent);
      background: color-mix(in srgb, #7e6765 9%, #fff);
    }
    .st-design--all .st-design-new,
    .st-design--all .st-plus { color: #7e6765; }
    .st-design--all:hover { border-color: color-mix(in srgb, #7e6765 45%, transparent); }
    .st-pack-name, .st-design-name { font-family: var(--serif); font-size: var(--ws-t-body); font-weight: 400; letter-spacing: -0.01em; line-height: 1.25; }
    .st-pack-count, .st-design-type { font-size: var(--ws-t-meta); color: var(--ws-faint); }
    /* The state pill on a design. Packs carry no overlay: the name sits under
       the card, and printing it twice only obscured the picture. */
    .st-design-tag { position: absolute; left: 8px; top: 8px; padding: 3px 8px; border-radius: 3px; background: rgba(255,255,255,0.93); font-size: var(--ws-t-label); font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--ws-accent); }

    /* "Shop more packs" and "New design" — outlined, tinted, no picture. */
    .st-pack--shop .st-pack-img, .st-design--new { background: color-mix(in srgb, var(--ws-accent) 7%, #fff); }
    .st-pack--shop .st-pack-img { display: flex; align-items: center; justify-content: center; }
    .st-pack-shop-ic, .st-plus { font-size: var(--ws-t-panel); font-weight: 200; line-height: 1; color: var(--ws-accent); }
    .st-design--new { align-items: center; justify-content: center; border-style: dashed; }
    .st-design-new { display: flex; flex-direction: column; align-items: center; gap: 8px; font-size: var(--ws-t-meta); font-weight: 600; color: var(--ws-accent); }
    /* On its own in the row (the demo, or nothing saved yet) it keeps a card's shape. */
    .st-design--new:only-child { aspect-ratio: 1080 / 1600; }

    /* ---- Loading ---------------------------------------------------------
       None on the page. It used to ship six invented packs and four starter
       designs, then grey shimmering stand-in cards over them, swapped row by
       row for the member's own -- each swap a flash. Now the shelves are
       empty in the markup and the page waits behind the ready gate
       (BaseLayout readyGate) until both are filled with the real thing,
       pictures included. Dani, 14 Oct: no placeholders, ever. */
    /* A shelf that could not be loaded says so, in place of its cards. */
    .st-fail {
      grid-column: 1 / -1; margin: 0; padding: 22px 20px;
      border: 1px solid var(--ws-line); border-radius: var(--ws-r); background: #fff;
      font-size: 15px; color: rgba(28,29,34,0.72);
    }
    .st-fail button {
      margin-left: 6px; padding: 0; border: 0; background: none; font: inherit;
      color: var(--ws-ink, #1c1d22); text-decoration: underline; cursor: pointer;
    }

    /* Inspiration — a picture with the words laid over it. */
    .st-row--inspo { --st-across: 4; }
    /* The inspiration cards in the pack cards' clothes — picture on top, name
       and line beneath on white — rather than words printed over a photograph,
       which put white titles on whatever the picture happened to be. */
    .st-insp {
      display: flex; flex-direction: column; gap: 4px; padding: 12px; width: 100%;
      border: 1px solid var(--ws-line); border-radius: var(--ws-r); background: #fff;
      text-decoration: none; color: var(--ws-ink); text-align: left;
      transition: border-color 0.25s var(--ws-ease), transform 0.25s var(--ws-ease);
    }
    button.st-insp { font: inherit; cursor: pointer; appearance: none; }
    .st-insp:hover { transform: translateY(-3px); border-color: rgba(28,29,34,0.22); }
    .st-insp-img { display: block; width: 100%; aspect-ratio: 16 / 10; border-radius: 4px; background: #e9e6e2 center / cover no-repeat; margin-bottom: 8px; }
    .st-insp-name { font-family: var(--serif); font-size: var(--ws-t-body); font-weight: 400; letter-spacing: -0.01em; line-height: 1.25; }
    .st-insp-desc { font-size: var(--ws-t-meta); color: var(--ws-faint); line-height: 1.4; }
    /* One word, bottom-right, in the accent: the card's call to action. */
    .st-insp-cta {
      align-self: flex-end; margin-top: auto; padding-top: 10px;
      /* Darker Grotesque's glyphs sit a pixel low in their box; the extra
         bottom padding lifts the capitals to the true centre. */
      display: inline-flex; align-items: center; justify-content: center; height: 26px; padding: 0 12px 2px;
      border-radius: var(--ws-r, 4px); background: var(--ws-accent); color: #fff;
      font-family: var(--sans); font-size: 10.5px; line-height: 1; font-weight: 700; letter-spacing: 0.14em; text-indent: 0.14em; text-transform: uppercase;
      transition: transform 0.25s var(--ws-ease);
    }
    .st-insp:hover .st-insp-cta { transform: translateX(2px); }

    /* Shelf navigation: an arrow either side of one dot per pack, underneath
       where it can be reached, rather than an arrow floating over the last card. */
    .st-nav { display: flex; align-items: center; justify-content: center; gap: 14px; margin-top: 14px; }
    .st-nav[hidden] { display: none; }
    .st-nav-arrow {
      appearance: none; width: 28px; height: 28px; border-radius: 50%;
      border: 1px solid var(--ws-line); background: #fff; color: var(--ws-ink); cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center;
      transition: border-color 0.2s, opacity 0.2s;
    }
    .st-nav-arrow svg { width: 15px; height: 15px; }
    .st-nav-arrow:hover:not(:disabled) { border-color: var(--ws-accent); }
    .st-nav-arrow:disabled { opacity: 0.3; cursor: default; }
    .st-dots { display: flex; align-items: center; gap: 7px; }
    .st-dot {
      appearance: none; width: 7px; height: 7px; padding: 0; border-radius: 50%;
      border: 0; background: rgba(28,29,34,0.18); cursor: pointer;
      transition: background 0.2s var(--ws-ease), transform 0.2s var(--ws-ease);
    }
    .st-dot:hover { background: rgba(28,29,34,0.4); }
    .st-dot.is-active { background: var(--ws-accent); transform: scale(1.35); }

    /* Entrance — the shared .ws-rise, stepped per section. */
    .ws-rise { animation-delay: calc(0.1s + var(--i, 0) * 0.09s); }
  </style>

  <script>
    import { isDemo as demoOn, lockClicks } from "../../lib/demo.js";
    /* Come from the Marketing Calendar's "Design from a template" (?for=day):
       the pack you open carries the day on, so Plan post is already on it. */
    (() => {
      const forDay = new URLSearchParams(location.search).get("for");
      if (!forDay || !/^\d{4}-\d{2}-\d{2}$/.test(forDay)) return;
      document.addEventListener("click", (e) => {
        const a = e.target instanceof Element ? e.target.closest('a[href^="/account/editor"]') : null;
        if (!a) return;
        const u = new URL(a.getAttribute("href"), location.origin);
        if (!u.searchParams.has("for")) { u.searchParams.set("for", forDay); a.setAttribute("href", u.pathname + u.search + u.hash); }
      }, true);
    })();
    import { STUDIO_SIZES } from "../../data/studio-sizes.js";
    if (demoOn()) {
      // The demo: the content ideas are for members.
      const locked = [];
      document.querySelectorAll('.ws-tool, .st-insp, .ws-wn-pill').forEach((el) => {
        const t = (el.textContent || '').toLowerCase();
        if (t.includes('content ideas')) { el.setAttribute('data-demo-lock', ''); el.classList.add('is-demo-locked'); locked.push(el); }
      });
      if (locked.length) lockClicks('[data-demo-lock]', 'That one is for members.', 'The 48 content ideas come with membership. In the demo, open the pack and try the editor.');
    }
    import { supabase } from "../../lib/supabase.js";
    import { designStore } from "../../lib/design-store.js";
    import { gateReady, gateFailed } from "../../lib/ready-gate.js";

    // Shelf navigation: one dot per card, plus an arrow either side. Rebuilt on
    // demand because the packs are swapped in from Supabase after first paint -
    // a dot count baked at render time would be wrong the moment they land.
    function wireRail(rail) {
      const row = rail.querySelector('.st-row');
      const nav = rail.querySelector('[data-rail-nav]');
      const dots = rail.querySelector('[data-rail-dots]');
      const prev = rail.querySelector('[data-rail-prev]');
      const next = rail.querySelector('[data-rail-next]');
      if (!row || !nav || !dots || !prev || !next) return;

      const cards = [...row.children];
      // Nothing to navigate if the whole shelf is already on screen.
      const overflows = row.scrollWidth > row.clientWidth + 4;
      nav.hidden = cards.length < 2 || !overflows;
      if (nav.hidden) return;

      dots.innerHTML = cards.map((_, i) =>
        `<button type="button" class="st-dot" data-i="${i}" aria-label="Go to item ${i + 1}"></button>`).join('');
      const dotEls = [...dots.children];

      // Which card sits at the left edge, and which are on screen at all.
      const leftmost = () => {
        let best = 0, dist = Infinity;
        cards.forEach((c, i) => {
          const d = Math.abs(c.offsetLeft - row.scrollLeft);
          if (d < dist) { dist = d; best = i; }
        });
        return best;
      };
      const isVisible = (i) => {
        const c = cards[i];
        if (!c) return false;
        return c.offsetLeft >= row.scrollLeft - 2
            && c.offsetLeft + c.offsetWidth <= row.scrollLeft + row.clientWidth + 2;
      };

      // The dot you last asked for stays lit while its card is on screen. With
      // five across and seven packs the last cards can never reach the left
      // edge, so keying the active dot off the leftmost card alone would leave
      // the final dots permanently unlit and looking broken when clicked.
      let wanted = 0;
      const sync = () => {
        const active = isVisible(wanted) ? wanted : leftmost();
        dotEls.forEach((d, j) => d.classList.toggle('is-active', j === active));
        prev.disabled = row.scrollLeft <= 2;
        next.disabled = row.scrollLeft >= row.scrollWidth - row.clientWidth - 2;
      };
      const goTo = (i) => {
        i = Math.max(0, Math.min(cards.length - 1, i));
        wanted = i;
        const c = cards[i];
        if (c) row.scrollTo({ left: Math.min(c.offsetLeft, row.scrollWidth - row.clientWidth), behavior: 'smooth' });
        sync();
      };

      dots.addEventListener('click', (e) => {
        const b = e.target.closest('[data-i]');
        if (b) goTo(Number(b.getAttribute('data-i')));
      });
      prev.addEventListener('click', () => goTo(leftmost() - 1));
      next.addEventListener('click', () => goTo(leftmost() + 1));
      row.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }
    /* Print or social, from the canvas it was drawn at. The print sizes are
       the ones the Studio offers (src/data/studio-sizes.js) at 300dpi, plus
       the A-series ratio for anything drawn before that list existed — the
       same test the Studio itself uses to decide which units to measure in. */
    const PRINT_SIZES = new Set(
      STUDIO_SIZES.filter((g) => g.family === 'print')
        .flatMap((g) => g.sizes.map((z) => `${z.w}x${z.h}`))
    );
    function isPrintDesign(d) {
      const c = d && d.canvas;
      const w = Math.round(Number(c && c.width) || 0), h = Math.round(Number(c && c.height) || 0);
      if (!w || !h) return false;
      if (PRINT_SIZES.has(`${w}x${h}`) || PRINT_SIZES.has(`${h}x${w}`)) return true;
      const r = Math.max(w, h) / Math.min(w, h);
      return Math.abs(r - Math.SQRT2) < 0.01 && Math.min(w, h) >= 1200;
    }

    /* Social / Print, over a shelf that has both. Two pills, the hub's own
       shape, not the browser's own buttons. Built here rather than in the
       markup because a member with only social packs should never see it. */
    /* The tab you were on, remembered for this browser tab: back from a print
       pack or template lands on Print again, not Social (Dani, 13 Oct). */
    const kindKey = (name) => 'tmke.studio.kind.' + name;
    function rememberedKind(name) {
      try { return sessionStorage.getItem(kindKey(name)) === 'print' ? 'print' : 'social'; } catch (_) { return 'social'; }
    }
    function mountKindToggle(rail, name, onChange) {
      const start = rememberedKind(name);
      if (!rail || rail.previousElementSibling?.classList.contains('st-kinds')) return start;
      const wrap = document.createElement('div');
      wrap.className = 'st-kinds';
      wrap.setAttribute('role', 'tablist');
      wrap.setAttribute('aria-label', 'Social or print');
      [['social', 'Social'], ['print', 'Print']].forEach(([k, label], i) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'st-kind' + (k === start ? ' is-on' : '');
        b.dataset.kind = k;
        b.textContent = label;
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-selected', k === start ? 'true' : 'false');
        b.addEventListener('click', () => {
          if (b.classList.contains('is-on')) return;
          try { sessionStorage.setItem(kindKey(name), k); } catch (_) {}
          wrap.querySelectorAll('.st-kind').forEach((x) => {
            const on = x === b;
            x.classList.toggle('is-on', on);
            x.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          onChange(k);
        });
        wrap.appendChild(b);
      });
      rail.parentNode.insertBefore(wrap, rail);
      return start;
    }
    // The packs shelf is wired from a different <script>, which is a different
    // module: hand it over the way the rail re-wire is handed over.
    window.__ST_KIND_TOGGLE__ = mountKindToggle;

    /* A print shelf: picture height is 75% of what a social card's picture
       would be at this width, and each card takes the shape of its picture.
       A pack cover's shape is only known once it has loaded. */
    function fitPrintRow(row, on) {
      row.classList.toggle('st-row--print', !!on);
      if (!on) { row.style.removeProperty('--st-print-h'); return Promise.resolve(); }
      const cs = getComputedStyle(row);
      const across = parseFloat(cs.getPropertyValue('--st-across')) || 5;
      const gap = parseFloat(cs.columnGap) || 16;
      const col = (row.clientWidth - (across - 1) * gap) / across;
      const picW = col - 26;                                    // the card's padding and border
      row.style.setProperty('--st-print-h', Math.round(picW * (1440 / 1080) * 0.75) + 'px');
      /* Resolves once every card has its shape, so the ready gate can hold
         the page until then rather than let the cards change size in view. */
      const shaped = [];
      row.querySelectorAll('[data-cover]').forEach((card) => {
        const src = card.getAttribute('data-cover');
        if (!src || card.dataset.arDone) return;
        shaped.push(new Promise((resolve) => {
          const im = new Image();
          im.onload = () => { if (im.naturalWidth && im.naturalHeight) { card.style.setProperty('--ar', (im.naturalWidth / im.naturalHeight).toFixed(4)); card.dataset.arDone = '1'; } resolve(); };
          im.onerror = () => resolve();
          setTimeout(resolve, 4000);
          im.src = src;
        }));
      });
      return Promise.all(shaped);
    }
    window.__ST_FIT_PRINT__ = fitPrintRow;
    window.addEventListener('resize', () => {
      document.querySelectorAll('.st-row--print').forEach((r) => fitPrintRow(r, true));
    }, { passive: true });

    /* The hero and the inspiration cards are fixed artwork: ready as soon as
       their pictures have arrived (the gate waits for those). */
    gateReady('hero', document.querySelector('[data-gate="hero"]'));
    gateReady('inspo', document.querySelector('[data-gate="inspo"]'));

    // Chapter 04: the packs going by, two or three of a pack together.
    (async () => {
      const reel = document.getElementById('st-reel');
      if (!reel) return;
      const { fillPackReel } = await import('../../lib/pack-reel.js');
      const ok = await fillPackReel(supabase, reel, { runs: [2, 3], perPack: 6 });
      if (!ok) reel.hidden = true;
    })();

    // This month's "What to post" piece, by its address: october-what-to-post-...
    (async function wireMonthIdeas() {
      const a = document.getElementById('st-month-ideas');
      if (!a) return;
      try {
        const month = new Date().toLocaleDateString('en-GB', { month: 'long' });
        const { data } = await supabase.from('blog_posts').select('slug').eq('status', 'published')
          .in('audience', ['members', 'both']).ilike('slug', `${month.toLowerCase()}-what-to-post%`)
          .order('publish_date', { ascending: false }).limit(1);
        if (data && data[0]) { a.href = '/account/blog#' + data[0].slug; a.textContent = `${month} content ideas`; a.hidden = false; }
      } catch (_) {}
    })();

    /* A shelf that could not be loaded says so, with a way to try again. */
    window.__ST_FAIL__ = (what) => `<p class="st-fail">Your ${what} didn't load.<button type="button" data-st-retry>Try again</button></p>`;
    document.addEventListener('click', (e) => { if (e.target.closest && e.target.closest('[data-st-retry]')) location.reload(); });

    const rails = () => document.querySelectorAll('[data-rail]');
    rails().forEach(wireRail);
    // Re-wire after the real packs replace the sample ones.
    window.__ST_REWIRE_RAILS__ = () => rails().forEach(wireRail);

    // Caption Generator tool → open the standalone generator (copy output).
    document.querySelector('[data-tool="caption"]')?.addEventListener('click', () => {
      window.tmkeCaption?.open({ output: 'copy' });
    });
    // QR Code Generator tool -> its own pop-out (src/components/QrGenerator.astro).
    document.querySelector('[data-tool="qr"]')?.addEventListener('click', () => { window.tmkeQr?.open(); });

    // "Your designs": the member's own saved copies (user_designs), newest first.
    (async function wireDesigns() {
      const row = document.querySelector('[data-designs]');
      if (!row) return;
      const seeall = document.querySelector('[data-seeall]');
      const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      const newCard = `<a class="st-design st-design--new" href="/account/editor?new=1" data-new-design><span class="st-design-new"><span class="st-plus">+</span><span>New design</span></span></a>`;
      /* However this ends, the row is final before the page is shown: their
         designs, just "New design", or a plain "didn't load". Signed out, it
         is the sign-in page -- there is no preview of somebody's Studio. */
      const done = () => { row.classList.add('is-ready'); gateReady('designs', row); };
      const failed = () => { row.innerHTML = window.__ST_FAIL__('designs'); row.classList.add('is-ready'); gateFailed('designs', row); };
      try {
        /* Where this person's designs live: a member's own, or the training
           account's, kept under danielle@tmke.co.uk (src/lib/design-store.js). */
        const store = await designStore();
        if ((!store || store.blocked) && demoOn()) {
          // The demo has nothing saved: just the way to start one.
          row.innerHTML = newCard;
          done();
          return;
        }
        if (!store) { location.replace('/login?next=' + encodeURIComponent('/account/studio')); return; }
        if (store.blocked) { failed(); return; }
        /* All of them, not five: the toggle has to be able to say whether they
           have any print designs at all, and a shelf of three cannot answer
           that from a page of five. `canvas` is what tells print from social. */
        const { data, error } = await store.db
          .from(store.table)
          .select('id, name, thumb_url, updated_at, canvas')
          .eq('user_id', store.uid)
          .order('updated_at', { ascending: false });
        if (error) { failed(); return; }
        const designs = data || [];
        if (!designs.length) { row.innerHTML = newCard; done(); return; } // signed in, none yet → just "New design"

        const seeAllCard = `
          <a class="st-design st-design--all" href="/account/editor" data-seeall-card>
            <span class="st-design-new"><span class="st-plus">&rarr;</span><span>See all designs</span></span>
          </a>`;
        const shapeOf = (d) => {
          const c = d && d.canvas, w = Number(c && c.width) || 0, h = Number(c && c.height) || 0;
          return (w && h) ? ` style="--ar:${(w / h).toFixed(4)}"` : '';
        };
        const card = (d) => `
          <a class="st-design" href="/account/editor?design=${encodeURIComponent(d.id)}"${shapeOf(d)}>
            <span class="st-design-img"${d.thumb_url ? ` style="background-image:url('${esc(d.thumb_url)}')"` : ''}><span class="st-design-tag">Saved</span></span>
            <span class="st-design-name">${esc(d.name || 'Untitled design')}</span>
            <span class="st-design-type">Your design</span>
          </a>`;
        /* Three designs, then the two ways on: a new one, and the rest of
           them. "See all" used to sit in the chapter heading, which is where
           the toggle now goes, so it comes onto the shelf as a card. */
        const draw = (list, kind) => {
          row.innerHTML = list.slice(0, 3).map(card).join('') + newCard
            + (list.length > 3 ? seeAllCard : '');
          const shaped = fitPrintRow(row, kind === 'print' || (!kind && list.length && list.every(isPrintDesign)));
          window.__ST_REWIRE_RAILS__?.();
          return shaped;
        };

        const printDesigns  = designs.filter(isPrintDesign);
        const socialDesigns = designs.filter((d) => !isPrintDesign(d));
        if (seeall) seeall.hidden = true;        // it lives on the shelf now
        if (printDesigns.length && socialDesigns.length) {
          const startKind = mountKindToggle(row.closest('.st-rail'), 'designs', (kind) => draw(kind === 'print' ? printDesigns : socialDesigns, kind));
          await draw(startKind === 'print' ? printDesigns : socialDesigns, startKind);
        } else {
          await draw(designs);
        }
        done();
      } catch (_) { failed(); }
    })();
  </script>

  <!-- "Pick from your packs" → the member's actually-purchased packs. -->
  <script>
    import { isDemo as demoOn } from "../../lib/demo.js";
    import { supabase } from "../../lib/supabase.js";
    import { gateReady, gateFailed } from "../../lib/ready-gate.js";
    (async function wirePacks() {
      const row = document.querySelector('[data-packs]');
      if (!row) return;
      const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      const shopTile = `
        <a class="st-pack st-pack--shop" href="/edit">
          <span class="st-pack-img"><span class="st-pack-shop-ic">+</span></span>
          <span class="st-pack-name">Shop more packs</span>
          <span class="st-pack-count">Visit The Edit &rarr;</span>
        </a>`;
      // Final before the page is shown: the packs, the shop, or "didn't load".
      const done = () => { row.classList.add('is-ready'); window.__ST_REWIRE_RAILS__?.(); gateReady('packs', row); };
      const failed = () => {
        row.innerHTML = window.__ST_FAIL__ ? window.__ST_FAIL__('packs') : '';
        row.classList.add('is-ready');
        gateFailed('packs', row);
      };
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session && demoOn()) {
          // The demo: the pack made for it (a slug or title starting "demo"), and the shop.
          let card = '';
          try {
            const { data } = await supabase.from('packs').select('*').eq('demo', true).eq('status', 'active').limit(1);
            const { fillPackCovers } = await import('../../lib/pack-cover.js');
            await fillPackCovers(supabase, data || []);
            const p = data && data[0];
            if (p) card = `
          <a class="st-pack" data-demo-pack href="/account/editor?pack=${encodeURIComponent(p.id)}">
            <span class="st-pack-img"${p.cover_image_url ? ` style="background-image:url('${esc(p.cover_image_url)}')"` : ''}></span>
            <span class="st-pack-name">${esc(p.title)}</span>
            <span class="st-pack-count">Open pack &rarr;</span>
          </a>`;
          } catch (_) {}
          row.innerHTML = card + shopTile;
          done();
          return;
        }
        if (!session) { location.replace('/login?next=' + encodeURIComponent('/account/studio')); return; }
        const email = session.user.email || '';
        /* Which brand this account is actually in, asked of the database
           rather than assumed. Staff can read every pack, so without this
           somebody at TMKE saw a Property Experts print pack in their own
           Studio. `undefined` means the question could not be put, and takes
           nobody's pack away. */
        let memberBrand;
        const [packsRes, ordersRes, brandRes] = await Promise.all([
          supabase.from('packs').select('*').eq('status', 'active').order('sort_order', { ascending: true }),
          supabase.from('orders').select('pack_id, status').or(`user_id.eq.${session.user.id},buyer_email.ilike.${email}`),
          import('../../lib/pack-access.js').then((m) => m.memberBrandsFor(supabase), () => undefined),
        ]);
        memberBrand = brandRes;   // every brand they are in (pack-access.js)
        // A failed read is not "you own nothing": say it did not load.
        if (packsRes.error || ordersRes.error) { failed(); return; }
        const allPacks = packsRes.data || [];
        // Packs with no cover set borrow one of their own templates.
        const { fillPackCovers } = await import('../../lib/pack-cover.js');
        await fillPackCovers(supabase, allPacks);
        const ownedIds = new Set((ordersRes.data || []).filter((o) => o.status === 'paid' && o.pack_id).map((o) => o.pack_id));
        // Bought, the demo, free-to-members, or drawn for their brand — the
        // brand check is the database's (src/lib/pack-access.js explains why).
        const { ownedPacks } = await import('../../lib/pack-access.js');
        const owned = ownedPacks(allPacks, ownedIds, memberBrand);
        if (!owned.length) { row.innerHTML = shopTile; done(); return; } // no packs → just the shop tile
        // The demo pack is marked so the "Opening a template" walk can point at
        // the one every member has, not at whichever pack happens to be first.
        const tile = (p) => `
          <a class="st-pack"${p.demo ? ' data-demo-pack' : ''}${p.cover_image_url ? ` data-cover="${esc(p.cover_image_url)}"` : ''} href="/account/editor?pack=${encodeURIComponent(p.id)}">
            <span class="st-pack-img"${p.cover_image_url ? ` style="background-image:url('${esc(p.cover_image_url)}')"` : ''}></span>
            <span class="st-pack-name">${esc(p.title)}</span>
            <span class="st-pack-count">Open pack &rarr;</span>
          </a>`;

        /* Print and social are different jobs — different sizes, different
           rules — and a member reaching for one is not half-thinking about the
           other. One shelf, with a toggle over it, rather than two shelves:
           the shelf stays the length of the screen and nobody scrolls past a
           row they did not want. No print packs, no toggle. */
        const printPacks  = owned.filter((p) => p.kind === 'print');
        const socialPacks = owned.filter((p) => p.kind !== 'print');
        /* The Print tab has no "Shop more packs" card (Dani, 13 Oct). */
        const draw = (list, print) => {
          row.innerHTML = list.map(tile).join('') + (print ? '' : shopTile);
          const shaped = window.__ST_FIT_PRINT__?.(row, print);
          window.__ST_REWIRE_RAILS__?.();
          return shaped;
        };
        if (printPacks.length && socialPacks.length) {
          const startKind = window.__ST_KIND_TOGGLE__?.(row.closest('.st-rail'), 'packs', (kind) => draw(kind === 'print' ? printPacks : socialPacks, kind === 'print')) || 'social';
          await draw(startKind === 'print' ? printPacks : socialPacks, startKind === 'print');
        } else {
          await draw(owned, !socialPacks.length && printPacks.length > 0);
        }
        done();                           // the dot count follows the real packs
      } catch (_) { failed(); }
    })();
  </script>
</BaseLayout>
