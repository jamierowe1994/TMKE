---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin.css";
import AdminBack from "../../components/AdminBack.astro";
---

<BaseLayout
  title="Admin sign in — TMKE"
  description="Sign in to the TMKE admin centre."
  hideNav
  hideFooter
  noindex
>
  <AdminBack href="/" label="Website" />

  <main class="login-page">
    <div class="login-card">
      <div class="login-eyebrow">TMKE &middot; Admin</div>
      <h1 class="login-h">Sign <em>in.</em></h1>
      <p class="login-note">Team access only.</p>

      <p class="login-denied" id="login-denied" hidden>
        This account doesn't have admin access. If you're a customer, head to
        <a href="/account">your workspace</a> instead.
      </p>

      <form id="login-form" class="login-form" novalidate>
        <label class="login-field">
          <span>Email</span>
          <input type="email" name="email" autocomplete="username" required />
        </label>
        <label class="login-field">
          <span>Password</span>
          <input type="password" name="password" autocomplete="current-password" required />
        </label>
        <button type="submit" class="login-submit"><span data-label>Sign in</span></button>
        <p class="login-error" id="login-error" hidden></p>
      </form>

      <div class="login-or"><span>or</span></div>
      <button type="button" class="login-ms" id="login-ms">
        <svg width="16" height="16" viewBox="0 0 23 23" aria-hidden="true"><path fill="#f25022" d="M0 0h11v11H0z"/><path fill="#7fba00" d="M12 0h11v11H12z"/><path fill="#00a4ef" d="M0 12h11v11H0z"/><path fill="#ffb900" d="M12 12h11v11H12z"/></svg>
        Sign in with Microsoft
      </button>
    </div>
  </main>

  <style>
    .login-page {
      min-height: 100vh; display: flex; align-items: center; justify-content: center;
      padding: 90px 24px 60px; background: var(--paper);
    }
    .login-card {
      width: 100%; max-width: 400px;
      border: 1px solid rgba(var(--violet-rgb), 0.2); border-radius: 10px;
      padding: 42px 38px; background: rgba(255, 255, 255, 0.45);
      box-shadow: 0 24px 70px rgba(20, 18, 26, 0.08);
    }
    .login-eyebrow { font-family: var(--sans); font-size: 11px; letter-spacing: 0.3em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); text-align: center; margin-bottom: 16px; }
    .login-h { font-family: var(--serif); font-weight: 400; font-size: 46px; line-height: 1; letter-spacing: -0.02em; color: var(--ink); text-align: center; margin: 0 0 8px; }
    .login-h em { font-style: italic; color: var(--english-violet); }
    .login-note { font-family: var(--sans); font-size: 13px; color: rgba(28, 29, 34, 0.55); text-align: center; margin: 0 0 30px; }
    .login-form { display: flex; flex-direction: column; gap: 16px; }
    .login-field { display: flex; flex-direction: column; gap: 6px; }
    .login-field span { font-family: var(--sans); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; color: var(--english-violet); }
    .login-field input {
      font-family: var(--sans); font-size: 15px; padding: 11px 14px;
      border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 4px;
      background: var(--paper); color: var(--ink); outline: none; transition: border-color 0.2s;
    }
    .login-field input:focus { border-color: var(--english-violet); }
    .login-submit {
      margin-top: 4px; padding: 13px 18px; border: none; border-radius: 4px;
      background: var(--english-violet); color: var(--paper); font-family: var(--sans);
      font-size: 12px; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700;
      cursor: pointer; transition: background 0.25s;
    }
    .login-submit:hover { background: var(--ink); }
    .login-submit[disabled] { opacity: 0.55; cursor: progress; }
    .login-error { margin: 2px 0 0; font-size: 13px; color: #a05a3c; font-family: var(--sans); text-align: center; }
    .login-denied {
      margin: 0 0 22px; padding: 12px 14px; font-size: 13px; line-height: 1.5;
      font-family: var(--sans); text-align: center; color: #8a4a2f;
      background: rgba(185, 130, 106, 0.12); border: 1px solid rgba(185, 130, 106, 0.4); border-radius: 6px;
    }
    .login-denied a { color: var(--english-violet); font-weight: 700; }
    .login-or { display: flex; align-items: center; gap: 14px; margin: 24px 0; font-family: var(--sans); font-size: 11px; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(28, 29, 34, 0.4); }
    .login-or::before, .login-or::after { content: ""; flex: 1; height: 1px; background: rgba(var(--violet-rgb), 0.18); }
    .login-ms {
      width: 100%; display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      padding: 12px 18px; border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 4px;
      background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 13px;
      font-weight: 700; cursor: pointer; transition: background 0.2s, border-color 0.2s;
    }
    .login-ms:hover { background: rgba(var(--violet-rgb), 0.06); border-color: var(--english-violet); }
  </style>

  <script>
    import { supabase } from '../../lib/supabase.js';
    import { isAdminUser } from '../../lib/admin-gate.js';

    const form = document.getElementById('login-form');
    const errEl = document.getElementById('login-error');
    const deniedEl = document.getElementById('login-denied');
    const submitBtn = form?.querySelector('button[type="submit"]');
    const labelEl = submitBtn?.querySelector('[data-label]');
    const params = new URLSearchParams(location.search);

    function showDenied() { if (deniedEl) deniedEl.hidden = false; }

    // Arrived here because the gate refused a signed-in non-admin.
    if (params.get('denied')) showDenied();

    // Only forward an EXISTING session if it actually belongs to an admin — a
    // signed-in customer must not be bounced into /admin.
    supabase.auth.getSession().then(async ({ data }) => {
      if (!data.session) return;
      if (await isAdminUser(data.session.user)) {
        location.replace(params.get('next') || '/admin');
      } else {
        showDenied();
      }
    });

    function showError(msg) {
      if (!errEl) return;
      errEl.textContent = msg;
      errEl.hidden = false;
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      errEl.hidden = true;
      if (deniedEl) deniedEl.hidden = true;
      submitBtn.setAttribute('disabled', 'true');
      labelEl.textContent = 'Signing in…';

      const fd = new FormData(form);
      const email = String(fd.get('email') || '').trim();
      const password = String(fd.get('password') || '');

      const { data: signInData, error } = await supabase.auth.signInWithPassword({ email, password });
      if (error) {
        submitBtn.removeAttribute('disabled');
        labelEl.textContent = 'Sign in';
        showError(error.message || 'Could not sign in.');
        return;
      }
      // Valid credentials, but not an admin → sign back out so a customer can't
      // sit on an admin session, and tell them why.
      if (!(await isAdminUser(signInData.user))) {
        await supabase.auth.signOut();
        submitBtn.removeAttribute('disabled');
        labelEl.textContent = 'Sign in';
        showDenied();
        return;
      }
      location.replace(params.get('next') || '/admin');
    });

    // Microsoft SSO (works once the Azure provider is enabled in Supabase).
    document.getElementById('login-ms')?.addEventListener('click', async () => {
      errEl.hidden = true;
      const next = new URLSearchParams(location.search).get('next') || '/admin';
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'azure',
        options: {
          scopes: 'openid profile email',
          redirectTo: `${location.origin}/auth/callback?next=${encodeURIComponent(next)}`,
        },
      });
      if (error) showError(error.message || 'Microsoft sign-in is not enabled yet.');
    });
  </script>
</BaseLayout>
