    .tadm-list { background: #fff; border: 1px solid var(--line, rgba(28,29,34,0.13)); border-radius: 6px; overflow: hidden; }
    .tadm-list-head { display: flex; align-items: center; justify-content: space-between; padding: 12px 14px; border-bottom: 1px solid var(--line, rgba(28,29,34,0.13)); }
    .tadm-list-head h2 { margin: 0; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.6); }
    .tadm-new { border: 0; background: none; color: #371e28; font-family: var(--sans); font-size: 12px; font-weight: 700; cursor: pointer; }
    .tadm-items { display: flex; flex-direction: column; }
    .tadm-item { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 10px; width: 100%; min-height: 62px; text-align: left; padding: 10px 14px; border: 0; border-bottom: 1px solid rgba(28,29,34,0.08); background: none; cursor: pointer; font-family: var(--sans); font-size: 14px; color: var(--ink); }
    .tadm-item > span:first-child { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .tadm-item:hover, .tadm-item.is-on { background: #eae5e1; }
    .tadm-item small { font-size: 12px; color: #7e6765; }
    .wn-tag { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 8px; border-radius: 4px; white-space: nowrap; background: #eae5e1; color: #7e6765; }
    .wn-tag.on { background: #371e28; color: #fff; }
    .wn-tag.live { background: #c9bcb7; color: #371e28; }
    .tadm-muted { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.5); margin: 0; padding: 12px 14px; }
    .wn-saved { padding: 0; }
    .tadm-edit, .tadm-empty { background: #fff; border: 1px solid var(--line, rgba(28,29,34,0.13)); border-radius: 6px; padding: 18px 20px 24px; }
    .tadm-empty { text-align: center; padding: 60px 20px; }
    .tadm-empty h2 { font-family: var(--serif); font-weight: 400; font-size: 24px; margin: 0 0 8px; letter-spacing: -0.05em; }
    .tadm-empty p { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.6); margin: 0 0 16px; }
    .tadm-bar { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding-bottom: 14px; margin-bottom: 16px; border-bottom: 1px solid rgba(28,29,34,0.1); }
    .tadm-bar-gap { flex: 1; }
    .tadm-status { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 4px 10px; border-radius: 4px; background: #eae5e1; color: #7e6765; }
    .tadm-status[data-status="published"] { background: #371e28; color: #fff; }
    .tadm-btn { display: inline-flex; align-items: center; justify-content: center; box-sizing: border-box; height: 32px; padding: 0 14px; border-radius: 4px; border: 1px solid rgba(28,29,34,0.16); background: #fff; color: var(--ink); font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; cursor: pointer; }
    .tadm-btn:hover { border-color: #371e28; color: #371e28; }
