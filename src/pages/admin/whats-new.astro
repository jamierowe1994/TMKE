---
// Admin › Member hub › What's new (Danielle, 20 Nov 2026).
//
// The updates members step through from "What's New in Your Member Hub" on
// their dashboard. The latest five published show. Table: public.whats_new
// (supabase/whats_new.sql). The hub pages are built ahead, so Publish, Take
// down and deleting a live one ask the Worker to rebuild the site (/deploy,
// the same as the blog); the hub shows the change once that build is live.
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
import { WHATS_NEW_COUNT, AUDIENCE_LEVELS, AUDIENCE_GROUPS } from "../../lib/whats-new-audience.js";
import { BRAND_ORDER } from "../../data/brands.js";
import { LINK_CHOICES } from "../../lib/hub-links.js";
import { TRAINING_GUIDES, CALENDAR_GUIDES, PRINT_GUIDES } from "../../data/training-guides.js";

// For "Write it with Claude": the courses that live in the code, as plain
// text, and the hub's own "What's Where" as the map of where things are.
const plain = (h) => String(h || "").replace(/<(br|\/p|\/li|\/h\d|\/div)[^>]*>/gi, "\n").replace(/<[^>]+>/g, " ")
  .replace(/&nbsp;/g, " ").replace(/&amp;/g, "&").replace(/&rsquo;|&lsquo;/g, "'").replace(/&ldquo;|&rdquo;/g, '"').replace(/&[a-z]+;/g, " ")
  .replace(/[ \t]+/g, " ").replace(/\n\s*\n+/g, "\n").trim();
const courseText = (g) => [g.title, g.summary, ...(g.lessons || []).map((l) => `## ${l.title || ""}\n${plain(l.body_html)}`)].filter(Boolean).join("\n\n");
const COURSE_PICKS = [...TRAINING_GUIDES, ...CALENDAR_GUIDES, ...PRINT_GUIDES].map((g) => ({ slug: g.slug, title: g.title }));
const BUILT_IN = [...TRAINING_GUIDES, ...CALENDAR_GUIDES, ...PRINT_GUIDES].map((g) => ({ slug: g.slug, title: g.title, text: courseText(g).slice(0, 20000) }));
const hubTour = TRAINING_GUIDES.find((g) => g.slug === "training-hub");
const HUB_MAP = hubTour ? courseText(hubTour).slice(0, 8000) : "";
---

<AdminShell active="whats-new" title="What's new" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">What&rsquo;s new</div>
          <div class="page-header-sub">The updates members step through from &ldquo;What&rsquo;s New in Your Member Hub&rdquo; on their dashboard. The latest {WHATS_NEW_COUNT} published show; publishing a new one retires the oldest.</div>
        </div>
      </div>
      <div class="page-header-right">
        <a class="admin-btn" href="/account?inspo=news" target="_blank" rel="noopener">See it in the hub &rarr;</a>
      </div>
    </div>
  </div>

  <div class="wn">
    <aside class="tadm-list">
      <div class="tadm-list-head">
        <h2>Updates</h2>
        <button type="button" class="tadm-new" id="wn-new">+ New</button>
      </div>
      <div class="tadm-items" id="wn-items"><p class="tadm-muted">Loading&hellip;</p></div>
    </aside>

    <section class="tadm-edit" id="wn-edit" hidden>
      <div class="tadm-bar">
        <span class="tadm-status" id="wn-pill" data-status="draft">Draft</span>
        <span class="tadm-muted wn-saved" id="wn-saved"></span>
        <span class="tadm-bar-gap"></span>
        <button type="button" class="tadm-btn" id="wn-save">Save draft</button>
        <button type="button" class="tadm-btn" id="wn-down" hidden>Take down</button>
        <button type="button" class="tadm-btn tadm-btn--solid" id="wn-publish">Publish</button>
        <button type="button" class="tadm-btn tadm-btn--danger" id="wn-delete">Delete</button>
      </div>

      <div class="wn-ai">
        <p class="wn-ai-h">Write it with Claude</p>
        <div class="wn-ai-row">
          <label class="tadm-f"><span>It&rsquo;s about</span>
            <select id="ai-kind">
              <option value="calendar">A Content Calendar month</option>
              <option value="trending">A Trending month</option>
              <option value="course">A Learn course</option>
              <option value="pack">A pack</option>
              <option value="blog">A blog post</option>
              <option value="other">Something else: describe it below</option>
            </select>
          </label>
          <label class="tadm-f" id="ai-pick-wrap"><span>Which one</span><select id="ai-pick"><option value="">Loading&hellip;</option></select></label>
        </div>
        <label class="tadm-f"><span id="ai-notes-l">Anything to point out (optional)</span><textarea id="ai-notes" rows="2" placeholder="e.g. Mention it's free for November. Or, for a new feature: what it does and where it is."></textarea></label>
        <div class="wn-ai-go">
          <button type="button" class="tadm-btn tadm-btn--solid" id="ai-go">Write it</button>
          <span class="wn-stat" id="ai-stat"></span>
        </div>
      </div>

      <div class="wn-grid">
        <div class="wn-fields">
          <label class="tadm-f"><span>Title: what members can now do</span><input id="f-title" maxlength="80" placeholder="e.g. Schedule Your Posts Straight From the Studio" /></label>
          <div class="wn-two">
            <label class="tadm-f"><span>Added</span><input id="f-date" type="date" /></label>
            <label class="tadm-f"><span>Area</span><input id="f-area" maxlength="40" placeholder="e.g. Studio" /></label>
          </div>
          <label class="tadm-f"><span>Find it: the clicks to get there</span><input id="f-where" maxlength="120" placeholder="e.g. Studio → Start → Schedule" /></label>
          <label class="tadm-f"><span>What&rsquo;s new: two sentences at most</span><textarea id="f-what" rows="4" placeholder="What it is and what it does."></textarea></label>
          <label class="tadm-f"><span>Why it helps</span><textarea id="f-why" rows="3" placeholder="What it saves them or makes possible."></textarea></label>
          <label class="tadm-f"><span>TMKE tip: one practical pointer</span><textarea id="f-tip" rows="3" placeholder="Shown in the wine box."></textarea></label>
          <div class="wn-two">
            <label class="tadm-f"><span>Button takes them to</span>
              <select id="f-link">
                <option value="">No button</option>
                {LINK_CHOICES.map((c) => <option value={c.kind}>{c.label}</option>)}
              </select>
            </label>
            <label class="tadm-f"><span>Button words</span><input id="f-label" maxlength="40" placeholder="e.g. Open the Studio" /></label>
          </div>
          <label class="tadm-f" id="f-href-wrap" hidden><span>Address</span><input id="f-href" placeholder="/account/… or https://…" /></label>
          <label class="tadm-f" id="f-pack-wrap" hidden><span>Pack</span><select id="f-pack"><option value="demo">Demo pack</option></select></label>
          <label class="tadm-f" id="f-course-wrap" hidden><span>Course</span><select id="f-course">{COURSE_PICKS.map((c) => <option value={c.slug}>{c.title}</option>)}</select></label>
          <label class="tadm-f" id="f-month-wrap" hidden><span>Month on their Content Calendar</span><select id="f-month"></select></label>
          <label class="tadm-f" id="f-day-wrap" hidden><span>Date on their Content Calendar</span><input type="date" id="f-day" /></label>
          <fieldset class="tadm-f wn-aud">
            <span>Who sees it</span>
            <div class="wn-two">
              <label class="tadm-f"><span>Members</span>
                <select id="f-who">
                  <option value="all">Every member</option>
                  {AUDIENCE_GROUPS.map((g) => <option value={g.key}>{g.label}</option>)}
                  <option value="brands">Only these brands</option>
                </select>
              </label>
              <label class="tadm-f"><span>Subscription</span>
                <select id="f-level">
                  <option value="">Any, or none</option>
                  {AUDIENCE_LEVELS.map((l, i) => <option value={l.key}>{l.label}{i < AUDIENCE_LEVELS.length - 1 ? " and above" : ""}</option>)}
                </select>
              </label>
            </div>
            <div class="wn-aud-brands" id="f-brands" hidden></div>
            <p class="wn-aud-says" id="f-aud-says"></p>
          </fieldset>
          <div class="wn-media">
            <div class="wn-media-box" id="f-box">Portrait 4:5<br>1080 × 1350</div>
            <div class="wn-media-side">
              <label class="tadm-btn wn-upload">Upload a picture<input type="file" id="f-file" accept="image/*" /></label>
              <label class="tadm-f"><span>or paste its address</span><input id="f-media" placeholder="https://assets.tmke.co.uk/…" /></label>
              <span class="wn-stat" id="f-stat"></span>
            </div>
          </div>
        </div>

        <div class="wn-prev-col">
          <p class="wn-prev-h">How members see it</p>
          <div class="wn-prev" id="wn-prev"></div>
        </div>
      </div>
    </section>

    <section class="tadm-empty" id="wn-empty">
      <h2>What&rsquo;s new</h2>
      <p>Pick an update on the left, or write a new one.</p>
      <button type="button" class="tadm-btn tadm-btn--solid" id="wn-new-2">+ New update</button>
    </section>
  </div>

  <p class="tadm-toast" id="wn-toast" hidden></p>
  <script type="application/json" id="wn-cfg" set:html={JSON.stringify({ count: WHATS_NEW_COUNT, brands: BRAND_ORDER, builtIn: BUILT_IN, hubMap: HUB_MAP })}></script>

  <style is:global>
