    .tadm-btn--solid:hover { background: #2a1620; color: #fff; }
    .tadm-btn--danger { color: #8a2a2a; }
    .tadm-btn:disabled { opacity: .6; cursor: default; }
    .tadm-btn[hidden] { display: none; }
    .hub-skin .tadm-f { display: flex; flex-direction: column; gap: 6px; margin: 0; font-family: var(--sans); min-width: 0; }
    .hub-skin .tadm-f[hidden] { display: none; }
    .hub-skin .tadm-f > span { display: block; margin: 0; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .hub-skin .tadm-f input, .hub-skin .tadm-f textarea, .hub-skin .tadm-f select { width: 100%; box-sizing: border-box; height: 38px; min-height: 0; margin: 0; font-family: var(--sans); font-size: 14px; padding: 0 10px; border: 1px solid rgba(28,29,34,0.16); border-radius: 4px; background: #fff; color: var(--ink); }
    .hub-skin .tadm-f textarea { height: auto; padding: 8px 10px; resize: vertical; line-height: 1.5; }
    .hub-skin .tadm-f input:focus, .hub-skin .tadm-f textarea:focus, .hub-skin .tadm-f select:focus { outline: none; border-color: #371e28; box-shadow: 0 0 0 3px rgba(55,30,40,0.12); }
    .wn-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 28px; align-items: start; }
    .wn-fields { display: flex; flex-direction: column; gap: 14px; }
    .wn-two { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; }
    .wn-media { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 14px; align-items: start; }
    .wn-media-box { aspect-ratio: 4 / 5; border-radius: 4px; border: 1px dashed rgba(28,29,34,0.2); background: #f4f2f1 center / cover no-repeat; display: grid; place-items: center; text-align: center; font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.45); }
    .wn-media-box.has { border-style: solid; color: transparent; }
    .wn-media-side { display: flex; flex-direction: column; gap: 10px; }
    .wn-upload { align-self: flex-start; }
    .wn-upload input { display: none; }
    .wn-stat { font-family: var(--sans); font-size: 12px; color: #7e6765; min-height: 1em; }
    .wn-prev-col { position: sticky; top: 16px; }
    .wn-prev-h { margin: 0 0 8px; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .wn-prev { border: 1px solid rgba(28,29,34,0.12); border-radius: 6px; background: #fff; padding: 18px; display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: 16px; font-family: var(--sans); }
    .wn-p-copy { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
    .wn-p-eye { margin: 0; font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #7e6765; }
    .wn-p-h { font-family: var(--serif); font-weight: 400; font-size: 24px; line-height: 1.08; letter-spacing: -0.05em; color: #1c1d22; overflow-wrap: anywhere; }
    .wn-p-facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin: 0; padding: 8px 0; border-top: 1px solid #eae5e1; border-bottom: 1px solid #eae5e1; }
    .wn-p-facts dt { font-size: 9.5px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .wn-p-facts dd { margin: 0; font-size: 12px; font-weight: 600; color: #1c1d22; overflow-wrap: anywhere; }
    .wn-p-sec p { margin: 0; font-size: 13px; line-height: 1.45; color: rgba(28,29,34,0.72); white-space: pre-wrap; }
    .wn-p-sec .wn-p-l { margin: 0 0 4px; font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #4a2a3c; }
    .wn-p-btn { align-self: flex-start; display: inline-flex; align-items: center; height: 30px; padding: 0 12px; border: 1px solid rgba(28,29,34,0.2); border-radius: 4px; font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #1c1d22; }
    .wn-p-tip { padding: 12px 14px; border-radius: 4px; background: #4a2a3c; color: #fff; }
    .wn-p-tip b { display: block; font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; opacity: 0.8; margin-bottom: 4px; }
    .wn-p-tip p { margin: 0; font-size: 12.5px; line-height: 1.55; white-space: pre-wrap; }
    .wn-p-media { aspect-ratio: 4 / 5; border-radius: 4px; background: #eae5e1 center / cover no-repeat; }
    .wn-p-empty { color: rgba(28,29,34,0.35); }
    .wn-ai { display: flex; flex-direction: column; gap: 12px; padding: 14px 16px; margin-bottom: 18px; border-radius: 6px; background: #f6f3f1; border: 1px solid #eae5e1; }
    .wn-ai-h { margin: 0; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: #371e28; }
    .wn-ai-row { display: grid; grid-template-columns: 240px minmax(0, 1fr); gap: 14px; }
    .wn-ai-go { display: flex; align-items: center; gap: 12px; }
    .wn-aud { border: 0; padding: 0; }
    .wn-aud-brands label { display: inline-flex; align-items: center; gap: 6px; cursor: pointer; }
    .hub-skin .tadm-f.wn-aud .wn-aud-brands input { accent-color: #371e28; width: auto; height: auto; margin: 0; padding: 0; }
    .wn-aud-says { margin: 0; font-family: var(--sans); font-size: 14px; font-weight: 400; color: #7e6765; }
    .wn-aud-brands { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px 14px; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.12); border-radius: 4px; font-family: var(--sans); font-size: 14px; }
    .wn-aud-brands[hidden] { display: none; }
    .hub-skin .wn-aud .wn-aud-brands label { margin: 0; font-family: var(--sans); font-size: 14px; font-weight: 400; letter-spacing: 0; text-transform: none; color: var(--ink); }
    .wn-who { font-size: 12px; color: #7e6765; }
    .tadm-toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); max-width: min(560px, calc(100vw - 32px)); background: #1c1d22; color: #fff; font-family: var(--sans); font-size: 13px; line-height: 1.45; padding: 10px 16px; border-radius: 6px; z-index: 50; margin: 0; }
    @media (max-width: 1200px) { .wn-grid { grid-template-columns: 1fr; } .wn-prev-col { position: static; } .wn-ai-row { grid-template-columns: 1fr; } }
    @media (max-width: 900px) { .wn { grid-template-columns: 1fr; } .wn-prev { grid-template-columns: 1fr; } }
  </style>

  <script>
    import { supabase, isConfigured } from "../../lib/supabase.js";
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { audiencesMeet, audienceParts, audienceLabel, AUDIENCE_LEVELS, AUDIENCE_GROUPS, NO_BRAND } from "../../lib/whats-new-audience.js";
    import { LINK_CHOICES, linkHref as hubHref, linkParse, monthChoices } from "../../lib/hub-links.js";

    const $ = (s) => document.querySelector(s);
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const CFG = JSON.parse($("#wn-cfg")?.textContent || "{}");
    const COUNT = CFG.count || 5;
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    function toast(m, ms) { const t = $("#wn-toast"); t.textContent = m; t.hidden = false; clearTimeout(toast._t); toast._t = setTimeout(() => (t.hidden = true), ms || 3200); }
    const today = () => new Date().toLocaleDateString("en-CA", { timeZone: "Europe/London" });
    const dayLabel = (d) => { const x = new Date(String(d || "") + "T00:00:00"); return isNaN(x) ? "" : x.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); };
    const NO_TABLE = /schema cache|does not exist|PGRST205|42P01/i;
    const COLS = "id,status,live_on,title,area,find_it,what,why,tip,link_href,link_label,media_url,audience,created_at";

    let list = [], cur = null, curStatus = "draft", dirty = false, booted = false;
    const F = { title: "#f-title", date: "#f-date", area: "#f-area", where: "#f-where", what: "#f-what", why: "#f-why", tip: "#f-tip", label: "#f-label", href: "#f-href", media: "#f-media" };
    const val = (k) => ($(F[k]).value || "").trim();
    const markDirty = () => { if (booted) { dirty = true; $("#wn-saved").textContent = "Unsaved changes"; } preview(); };

    // The five members see: the newest published, by date then when written.
    // An update is live if fewer than five newer published ones reach any of
    // the same members (each member sees the latest five meant for them).
    const byDate = (a, b) => (a.live_on === b.live_on ? (a.created_at < b.created_at ? 1 : -1) : a.live_on < b.live_on ? 1 : -1);
    function showing() {
      const pub = list.filter((r) => r.status === "published").sort(byDate);
      return new Set(pub.filter((r, i) => pub.slice(0, i).filter((o) => audiencesMeet(o.audience, r.audience)).length < COUNT).map((r) => r.id));
    }

    /* ---------- who sees it ---------- */
    let BRANDS = (CFG.brands || []).slice();
    function drawBrands(chosen) {
      const pick = new Set(chosen || []);
      $("#f-brands").innerHTML = BRANDS.map((b) => `<label><input type="checkbox" value="${esc(b)}"${pick.has(b) ? " checked" : ""} /> ${esc(b)}</label>`).join("")
        + `<label><input type="checkbox" value="${NO_BRAND}"${pick.has(NO_BRAND) ? " checked" : ""} /> Members with no brand</label>`;
    }
    // Who: every member, a group (TEG, TEG without F&C, F&C) or ticked brands.
    // Subscription narrows it: that level or a higher one. Saved as one list
    // (src/lib/whats-new-audience.js).
    const tickedBrands = () => [...$("#f-brands").querySelectorAll("input:checked")].map((i) => i.value);
    function setAudience(aud) {
      const p = audienceParts(aud);
      p.brands.forEach((b) => { if (b !== NO_BRAND && !BRANDS.includes(b)) BRANDS.push(b); });
      const group = p.groups.find((g) => AUDIENCE_GROUPS.some((x) => x.key === g));
      $("#f-who").value = group || (p.brands.length ? "brands" : "all");
      $("#f-level").value = AUDIENCE_LEVELS.some((x) => x.key === p.levels[0]) ? p.levels[0] : "";
      drawBrands(p.brands); $("#f-brands").hidden = $("#f-who").value !== "brands";
      sayWho();
    }
    function getAudience() {
      const who = $("#f-who").value, lvl = $("#f-level").value;
      const out = who === "all" ? [] : who === "brands" ? tickedBrands() : ["group:" + who];
      if (lvl) out.push("level:" + lvl);
      return out;
    }
    const whoLabel = (a) => audienceLabel(a);
    // In a sentence, under the two choices.
    function sayWho() {
      const who = $("#f-who").value, lvl = AUDIENCE_LEVELS.find((x) => x.key === $("#f-level").value);
      const people = who === "all" ? "Every member"
        : who === "brands" ? (tickedBrands().length ? "Members in " + tickedBrands().map((b) => (b === NO_BRAND ? "no brand" : b)).join(", ") : "Nobody yet: tick the brands")
        : { teg: "Everyone in TEG, Fine & Country included", teg_no_fc: "Everyone in TEG apart from Fine & Country", fc: "Fine & Country only" }[who];
      $("#f-aud-says").textContent = people + (lvl ? ", if they have " + lvl.sees.replace(/ and (?!.* and )/, " or ") + "." : ".");
    }
    $("#f-who").addEventListener("change", () => { $("#f-brands").hidden = $("#f-who").value !== "brands"; sayWho(); markDirty(); });
    $("#f-level").addEventListener("change", () => { sayWho(); markDirty(); });
    $("#f-brands").addEventListener("change", () => { sayWho(); markDirty(); });
    // Brands on agents' profiles that aren't in the usual list still show.
    (async () => {
      try {
        const { data } = await supabase.from("agent_profiles").select("brand").is("left_at", null).limit(1000);
        [...new Set((data || []).map((r) => String(r.brand || "").trim()).filter(Boolean))].forEach((b) => { if (!BRANDS.some((x) => x.toLowerCase() === b.toLowerCase())) BRANDS.push(b); });
        if (!$("#wn-edit").hidden) drawBrands(tickedBrands());
      } catch (_) {}
    })();

    // The button's address: a place, or a pack, course, date or address
    // picked beside it (src/lib/hub-links.js, shared with Hub notifications).
    const PICK_FIELD = { pack: "#f-pack", course: "#f-course", month: "#f-month", day: "#f-day", url: "#f-href" };
    $("#f-month").innerHTML = monthChoices().map((m) => `<option value="${m.value}"${m.current ? " selected" : ""}>${m.label}</option>`).join("");
    function linkHref() { const k = $("#f-link").value; return hubHref(k, PICK_FIELD[k] ? $(PICK_FIELD[k]).value : ""); }
    function showPick() {
      const k = $("#f-link").value;
      $("#f-href-wrap").hidden = k !== "url"; $("#f-pack-wrap").hidden = k !== "pack";
      $("#f-course-wrap").hidden = k !== "course"; $("#f-day-wrap").hidden = k !== "day"; $("#f-month-wrap").hidden = k !== "month";
    }
    // A pick that isn't in its list yet (packs load after the page) keeps its value.
    function setPick(sel, value) {
      if (!value) return;
      if (![...sel.options].some((o) => o.value === value)) { const o = document.createElement("option"); o.value = value; o.textContent = "This one (" + value.slice(0, 8) + "…)"; sel.appendChild(o); }
      sel.value = value;
    }
    function setLink(href) {
      const { kind, value } = linkParse(href);
      $("#f-link").value = kind;
      ["#f-href", "#f-day"].forEach((s) => { $(s).value = ""; });
      if (kind === "pack") setPick($("#f-pack"), value);
      else if (kind === "course") setPick($("#f-course"), value);
      else if (kind === "month") {
        const sel = $("#f-month");
        if (![...sel.options].some((o) => o.value === value)) sel.insertAdjacentHTML("afterbegin", `<option value="${esc(value)}">${esc(monthName(value + "-01"))}</option>`);
        sel.value = value;
      }
      else if (kind === "day") $("#f-day").value = value;
      else if (kind === "url") $("#f-href").value = value;
      showPick();
    }
    (async () => {
      try {
        const [{ data: packs }, { data: guides }] = await Promise.all([
          supabase.from("packs").select("id,title,demo,status").neq("status", "archived").order("sort_order", { ascending: true }),
          supabase.from("guides").select("slug,title,status").eq("status", "published").order("title", { ascending: true }),
        ]);
        const ps = $("#f-pack"), keep = ps.value;
        ps.innerHTML = '<option value="demo">Demo pack</option>' + (packs || []).filter((p) => !p.demo).map((p) => `<option value="${esc(p.id)}">${esc(p.title)}${p.status === "draft" ? " (draft)" : ""}</option>`).join("");
        setPick(ps, keep);
        const cs = $("#f-course"), have = new Set([...cs.options].map((o) => o.value));
        (guides || []).filter((g) => g.slug && !have.has(g.slug)).forEach((g) => { const o = document.createElement("option"); o.value = g.slug; o.textContent = g.title; cs.appendChild(o); });
      } catch (_) {}
    })();
    function setBox(url) {
      const box = $("#f-box");
      box.style.backgroundImage = url ? `url("${url.replace(/"/g, "%22")}")` : "";
      box.classList.toggle("has", !!url);
    }

    function preview() {
      const t = val("title"), d = val("date"), a = val("area"), w = val("where"), what = val("what"), why = val("why"), tip = val("tip"), m = val("media");
      const href = linkHref(), label = val("label");
      const fact = (l, v) => `<div><dt>${l}</dt><dd>${v ? esc(v) : '<span class="wn-p-empty">—</span>'}</dd></div>`;
      const sec = (l, v) => v ? `<div class="wn-p-sec"><p class="wn-p-l">${l}</p><p>${esc(v)}</p></div>` : "";
      $("#wn-prev").innerHTML = `
        <div class="wn-p-copy">
          <p class="wn-p-eye">What's new · In your Member Hub${getAudience().length ? ` · <span class="wn-who">Only ${esc(whoLabel(getAudience()))}</span>` : ""}</p>
          <div class="wn-p-h">${t ? esc(t) : '<span class="wn-p-empty">Your title</span>'}</div>
          <dl class="wn-p-facts">${fact("Added", d ? new Date(d + "T00:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "long" }) : "")}${fact("Area", a)}${fact("Find it", w)}</dl>
          ${sec("What's new", what)}${sec("Why it helps", why)}
          ${href ? `<span class="wn-p-btn">${esc(label || "Take a look")} &rarr;</span>` : ""}
          ${tip ? `<div class="wn-p-tip"><b>TMKE tip</b><p>${esc(tip)}</p></div>` : ""}
        </div>
        <div class="wn-p-media" style="${m ? `background-image:url(&quot;${esc(m)}&quot;)` : ""}"></div>`;
    }

    function setPill(s) {
      const p = $("#wn-pill"); p.dataset.status = s;
      p.textContent = s === "published" ? (cur && showing().has(cur) ? "Live in the hub" : "Published, not in the latest " + COUNT) : "Draft";
      $("#wn-down").hidden = s !== "published";
      $("#wn-publish").textContent = s === "published" ? "Save and update the hub" : "Publish";
      $("#wn-save").hidden = s === "published";
    }

    function showEditor(row) {
      booted = false;
      $("#wn-empty").hidden = true; $("#wn-edit").hidden = false;
      cur = row ? row.id : null; curStatus = row?.status || "draft";
      $(F.title).value = row?.title || ""; $(F.date).value = row ? String(row.live_on).slice(0, 10) : today();
      $(F.area).value = row?.area || ""; $(F.where).value = row?.find_it || "";
      $(F.what).value = row?.what || ""; $(F.why).value = row?.why || ""; $(F.tip).value = row?.tip || "";
      $(F.label).value = row?.link_label || ""; setLink(row?.link_href || "");
      $(F.media).value = row?.media_url || ""; setBox(row?.media_url || ""); $("#f-stat").textContent = "";
      setAudience(row?.audience || []); $("#ai-stat").textContent = "";
      setPill(curStatus);
      $("#wn-saved").textContent = row ? "Saved" : "";
      dirty = false; booted = true; preview();
      document.querySelectorAll(".tadm-item").forEach((b) => b.classList.toggle("is-on", b.dataset.id === cur));
    }
    Object.values(F).forEach((s) => $(s).addEventListener("input", markDirty));
    $(F.media).addEventListener("input", () => setBox(val("media")));
    $("#f-link").addEventListener("change", () => {
      showPick();
      const c = LINK_CHOICES.find((x) => x.kind === $("#f-link").value);
      if (!val("label") && c && c.words) $(F.label).value = c.words;
      markDirty();
    });
    ["#f-pack", "#f-course", "#f-month", "#f-day"].forEach((s) => { $(s).addEventListener("change", markDirty); $(s).addEventListener("input", markDirty); });
    $("#f-file").addEventListener("change", async (e) => {
      const file = e.target.files?.[0]; e.target.value = ""; if (!file) return;
      const stat = $("#f-stat"); stat.textContent = "Uploading…";
      try {
        const { data: { session: s } } = await supabase.auth.getSession();
        const fd = new FormData(); fd.append("file", file);
        const res = await fetch(`${WORKER}/admin/upload`, { method: "POST", headers: s?.access_token ? { Authorization: `Bearer ${s.access_token}` } : {}, body: fd });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.url) { stat.textContent = "Upload failed: " + (j.error || ("HTTP " + res.status)); return; }
        $(F.media).value = j.url; setBox(j.url);
        // Warn about the shape rather than crop it: the hub shows 4:5.
        const img = new Image();
        img.onload = () => { const r = img.naturalWidth / img.naturalHeight; stat.textContent = Math.abs(r - 0.8) > 0.03 ? `Uploaded. It's ${img.naturalWidth} × ${img.naturalHeight}; the hub shows 4:5 (1080 × 1350), so the edges will be cropped.` : "Uploaded."; };
        img.onerror = () => { stat.textContent = "Uploaded."; };
        img.src = j.url;
        markDirty();
      } catch (err) { stat.textContent = "Upload failed: " + (err.message || err); }
    });

    function gather() {
      return {
        title: val("title"), live_on: val("date") || today(), area: val("area") || null, find_it: val("where") || null,
        what: val("what") || null, why: val("why") || null, tip: val("tip") || null,
        link_href: linkHref() || null, link_label: linkHref() ? (val("label") || "Take a look") : null,
        media_url: val("media") || null, audience: getAudience(), status: curStatus,
      };
    }

    // The hub is built ahead, so a change members see needs a rebuild.
    async function rebuild(done) {
      if (!WORKER) { toast(done + " The live hub wasn't rebuilt: no Worker is set up here."); return; }
      try {
        const { data: { session: s } } = await supabase.auth.getSession();
        const res = await fetch(`${WORKER}/deploy`, { method: "POST", headers: { Authorization: `Bearer ${s?.access_token || ""}` } });
        const out = await res.json().catch(() => ({}));
        if (res.ok && out.ok) toast(done + " The hub updates in about five minutes, once the site has rebuilt.", 6000);
        else toast(done + " But the hub didn't rebuild: " + (out.error || ("HTTP " + res.status)) + ". Publish again to retry.", 9000);
      } catch (e) { toast(done + " But the hub didn't rebuild: couldn't reach the Worker. Publish again to retry.", 9000); }
    }

    async function save(newStatus) {
      if (!isConfigured) { toast("Connect Supabase to save."); return; }
      const was = curStatus;
      const payload = gather();
      if (newStatus) payload.status = newStatus;
      if (!payload.title) { toast("Give it a title first."); $(F.title).focus(); return; }
      if ($("#f-who").value === "brands" && !tickedBrands().length) { toast("Tick the brands that see it, or choose Every member."); return; }
      if (payload.status === "published" && !payload.what) { toast("Add what's new before publishing."); $(F.what).focus(); return; }
      if (payload.status === "published" && !payload.media_url && !confirm("There's no picture. The dashboard card uses the newest update's picture. Publish anyway?")) return;
      document.querySelectorAll(".tadm-bar button").forEach((b) => (b.disabled = true));
      const q = cur
        ? supabase.from("whats_new").update(payload).eq("id", cur).select(COLS).maybeSingle()
        : supabase.from("whats_new").insert(payload).select(COLS).maybeSingle();
      const { data, error } = await q;
      document.querySelectorAll(".tadm-bar button").forEach((b) => (b.disabled = false));
      if (error || !data) { toast(error && NO_TABLE.test(error.message) ? "The table isn't there yet. Run supabase/whats_new.sql in the SQL editor." : "Couldn't save: " + ((error && error.message) || "nothing came back")); return; }
      cur = data.id; curStatus = data.status; dirty = false; $("#wn-saved").textContent = "Saved";
      await loadList();
      setPill(curStatus);
      if (curStatus === "published" || was === "published") await rebuild(curStatus === "published" ? (was === "published" ? "Saved." : "Published.") : "Taken down.");
      else toast("Saved as a draft. Members can't see it.");
    }
    $("#wn-save").addEventListener("click", () => save());
    $("#wn-publish").addEventListener("click", () => save("published"));
    $("#wn-down").addEventListener("click", () => { if (confirm("Take this out of the hub? It stays here as a draft.")) save("draft"); });
    $("#wn-delete").addEventListener("click", async () => {
      if (!cur) { showEmpty(); return; }
      const live = curStatus === "published";
      if (!confirm(live ? "Delete this update? It comes out of the hub and can't be brought back." : "Delete this draft? It can't be brought back.")) return;
      const { error } = await supabase.from("whats_new").delete().eq("id", cur);
      if (error) { toast("Couldn't delete: " + error.message); return; }
      showEmpty(); await loadList();
      if (live) await rebuild("Deleted."); else toast("Deleted.");
    });
    function showEmpty() { $("#wn-edit").hidden = true; $("#wn-empty").hidden = false; cur = null; dirty = false; document.querySelectorAll(".tadm-item").forEach((b) => b.classList.remove("is-on")); }
    const startNew = () => { if (dirty && !confirm("Discard unsaved changes?")) return; showEditor(null); };
    $("#wn-new").addEventListener("click", startNew);
    $("#wn-new-2").addEventListener("click", startNew);
    window.addEventListener("beforeunload", (e) => { if (dirty) { e.preventDefault(); e.returnValue = ""; } });

    /* ---------- write it with Claude ---------- */
    const stripHtml = (h) => String(h || "").replace(/<(br|\/p|\/li|\/h\d|\/div)[^>]*>/gi, "\n").replace(/<[^>]+>/g, " ").replace(/&nbsp;/g, " ").replace(/&amp;/g, "&").replace(/&[a-z]+;/g, " ").replace(/[ \t]+/g, " ").replace(/\n\s*\n+/g, "\n").trim();
    const monthName = (d) => new Date(String(d).slice(0, 10) + "T00:00:00").toLocaleDateString("en-GB", { month: "long", year: "numeric" });
    // Each kind: how to list them, and how to turn one into material to read.
    const EDITION = { property: "The Property Experts", prestige: "Prestige Property Experts", lettings: "The Letting Experts", independent: "Independent agents" };
    const POST_KIND = { single: "Single image", carousel: "Carousel", reel: "Reel" };
    const SOURCES = {
      // A month of the Content Calendar (Danielle, 23 Nov): one row per month
      // and edition. Its posts are read when she presses Write it.
      calendar: {
        list: async () => {
          const { data } = await supabase.from("content_months").select("id,month,edition,status,intro").order("month", { ascending: false }).order("edition").limit(40);
          return (data || []).map((r) => ({ id: r.id, label: `${monthName(r.month)} · ${EDITION[r.edition] || r.edition}${r.status === "published" ? "" : " (draft)"}`, row: r }));
        },
        text: async (o) => {
          const r = o.row;
          const { data, error } = await supabase.from("content_month_posts").select("post_date,title,post_type,pillar,date_tied,occasion,sort_order").eq("month_id", r.id).order("post_date").order("sort_order").limit(200);
          if (error) throw new Error("Couldn't read that month's posts: " + error.message);
          const posts = data || [];
          const count = (k) => posts.filter((p) => p.post_type === k).length;
          const day = (d) => d ? new Date(String(d).slice(0, 10) + "T12:00:00").toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short" }) : "No date";
          return `The Content Calendar for ${monthName(r.month)} (the ${EDITION[r.edition] || r.edition} edition): a month of ready-made posts for members with a Content Calendar subscription. They open it from their Content Calendar, where each day's post opens with its design and captions.\n${r.intro || ""}\n\n`
            + `${posts.length} posts: ${count("single")} single images, ${count("carousel")} carousels, ${count("reel")} reels.\n`
            + posts.map((p) => `- ${day(p.post_date)} · ${POST_KIND[p.post_type] || p.post_type} · ${p.pillar || "no pillar"} · ${p.title || "Untitled"}${p.date_tied ? ` (tied to its day${p.occasion ? ": " + p.occasion : ""})` : ""}`).join("\n");
        },
      },
      trending: {
        list: async () => {
          const { data } = await supabase.from("trending_months").select("id,month,status,intro,topics").order("month", { ascending: false }).limit(12);
          return (data || []).map((r) => ({ id: r.id, label: `${monthName(r.month)}${r.status === "published" ? "" : " (draft)"}`, row: r }));
        },
        text: (o) => {
          const r = o.row;
          return `See what's working (the Trending month in the Studio): ${monthName(r.month)}. Members find it under Studio → See what's working, and in Learn.\n${r.intro || ""}\n\n` + (r.topics || []).map((t, i) => `Topic ${i + 1}: ${t.title || ""}\nFormat: ${t.format || ""} · Platform: ${t.platform || ""} · Length: ${t.length || ""} · Effort: ${t.effort || ""}\nWhat it is: ${t.what || ""}\nWhy it works: ${t.about || ""}\nTMKE tip: ${t.tip || ""}`).join("\n\n");
        },
      },
      course: {
        list: async () => {
          const { data } = await supabase.from("guides").select("id,slug,title,summary,lessons,status,kind").neq("status", "archived").order("updated_at", { ascending: false }).limit(60);
          const db = (data || []).map((r) => ({ id: "db:" + r.id, label: `${r.title}${r.status === "published" ? "" : " (draft)"}`, slug: r.slug, text: [r.title, r.summary, ...(Array.isArray(r.lessons) ? r.lessons : []).map((l) => `## ${l.title || ""}\n${stripHtml(l.body_html || l.body || "")}`)].filter(Boolean).join("\n\n") }));
          const have = new Set(db.map((g) => g.slug));
          const built = (CFG.builtIn || []).filter((g) => !have.has(g.slug)).map((g) => ({ id: "code:" + g.slug, label: g.title, text: g.text }));
          return [...db, ...built];
        },
        text: (o) => `A Learn course (Training Studio → Learn).\n\n${o.text}`,
      },
      pack: {
        list: async () => {
          const { data } = await supabase.from("packs").select("*").neq("status", "archived").order("created_at", { ascending: false }).limit(60);
          return (data || []).map((r) => ({ id: r.id, label: `${r.title}${r.demo ? " (demo pack)" : ""}${r.status === "draft" ? " (draft)" : ""}`, row: r }));
        },
        text: (o) => {
          const r = o.row;
          const keep = Object.entries(r).filter(([k, v]) => v != null && v !== "" && !/(^id$|_id$|_at$|url|image|cover|thumb|sort|stripe|sig|token|user_ids)/i.test(k) && (typeof v !== "object" || JSON.stringify(v).length < 4000));
          return "A pack of templates in The Edit shop, used in the Studio.\n\n" + keep.map(([k, v]) => `${k}: ${typeof v === "string" ? stripHtml(v) : JSON.stringify(v)}`).join("\n");
        },
      },
      blog: {
        list: async () => {
          const { data } = await supabase.from("blog_posts").select("id,title,standfirst,body_html,status,audience,publish_date").order("created_at", { ascending: false }).limit(40);
          return (data || []).map((r) => ({ id: r.id, label: `${r.title}${r.status === "published" ? "" : " (draft)"}`, row: r }));
        },
        text: (o) => `A blog post${o.row.audience === "members" ? " for members only" : ""}, read in the hub under Inside the Edit (blog).\n\n${o.row.title}\n${o.row.standfirst || ""}\n\n${stripHtml(o.row.body_html)}`,
      },
    };
    let aiItems = [];
    async function loadPicks() {
      const kind = $("#ai-kind").value, sel = $("#ai-pick");
      $("#ai-pick-wrap").hidden = kind === "other";
      $("#ai-notes-l").textContent = kind === "other" ? "Describe it: what it is, what it does and where members find it" : "Anything to point out (optional)";
      if (kind === "other") return;
      sel.innerHTML = '<option value="">Loading…</option>';
      try { aiItems = await SOURCES[kind].list(); } catch (_) { aiItems = []; }
      if ($("#ai-kind").value !== kind) return;
      sel.innerHTML = aiItems.length ? aiItems.map((o) => `<option value="${esc(o.id)}">${esc(o.label)}</option>`).join("") : '<option value="">None found</option>';
    }
    $("#ai-kind").addEventListener("change", loadPicks);
    $("#ai-go").addEventListener("click", async () => {
      const kind = $("#ai-kind").value, notes = $("#ai-notes").value.trim();
      const pick = kind === "other" ? null : aiItems.find((o) => o.id === $("#ai-pick").value);
      if (kind === "other" && !notes) { $("#ai-stat").textContent = "Describe the feature first."; $("#ai-notes").focus(); return; }
      if (kind !== "other" && !pick) { $("#ai-stat").textContent = "Choose which one."; return; }
      if (["title", "what", "why", "tip"].some((k) => val(k)) && !confirm("Replace what's in the boxes with Claude's version?")) return;
      const btn = $("#ai-go"); btn.disabled = true; $("#ai-stat").textContent = "Claude is reading it and writing the card…";
      try {
        const { data: { session: s } } = await supabase.auth.getSession();
        const examples = list.filter((r) => r.status === "published").sort(byDate).slice(0, 4).map((r) => ({ title: r.title, area: r.area, find_it: r.find_it, what: r.what, why: r.why, tip: r.tip }));
        // A calendar month reads its posts now, so this can wait on the database.
        const material = pick ? String(await SOURCES[kind].text(pick)).slice(0, 24000) : "";
        const res = await fetch(`${WORKER}/admin/whats-new/draft`, {
          method: "POST", headers: { "Content-Type": "application/json", Authorization: `Bearer ${s?.access_token || ""}` },
          body: JSON.stringify({ kind: $("#ai-kind").selectedOptions[0].textContent, label: pick ? pick.label : "", material, notes, hub_map: CFG.hubMap || "", examples }),
        });
        const out = await res.json().catch(() => ({}));
        if (!res.ok || !out.card) { $("#ai-stat").textContent = out.error || ("Claude didn't answer (HTTP " + res.status + ")."); return; }
        const c = out.card;
        $(F.title).value = c.title || ""; $(F.area).value = c.area || ""; $(F.where).value = c.find_it || "";
        $(F.what).value = c.what || ""; $(F.why).value = c.why || ""; $(F.tip).value = c.tip || "";
        setLink(c.link_href || ""); $(F.label).value = c.link_href ? (c.link_label || "") : "";
        // A pack or course gets a button straight to it; a Trending month to its
        // trends; a Content Calendar month to that month on their calendar.
        const own = kind === "pack" ? hubHref("pack", pick.id) : kind === "course" ? hubHref("course", pick.slug || String(pick.id).replace(/^code:/, ""))
          : kind === "trending" ? "/account/studio?inspo=trending" : kind === "calendar" ? hubHref("month", String(pick.row.month).slice(0, 7)) : "";
        if (own) { setLink(own); $(F.label).value = (LINK_CHOICES.find((x) => x.kind === linkParse(own).kind) || {}).words || $(F.label).value; }
        // Only subscribers have the month, so a calendar update starts out for
        // them. She can change it under Who sees it.
        let narrowed = "";
        if (kind === "calendar" && !$("#f-level").value) { $("#f-level").value = "calendar"; sayWho(); narrowed = " Who sees it is now Content Calendar and above."; }
        markDirty();
        $("#ai-stat").textContent = (c.notes ? "Written. Claude says: " + c.notes : "Written. Check it over, add a picture, then publish.") + narrowed;
      } catch (e) { $("#ai-stat").textContent = "Couldn't reach Claude: " + (e.message || e); }
      finally { btn.disabled = false; }
    });

    async function loadList() {
      const wrap = $("#wn-items");
      if (!isConfigured) { wrap.innerHTML = '<p class="tadm-muted">Connect Supabase to load the updates.</p>'; return; }
      const { data, error } = await supabase.from("whats_new").select(COLS).order("live_on", { ascending: false }).order("created_at", { ascending: false });
      if (error) {
        wrap.innerHTML = `<p class="tadm-muted">${NO_TABLE.test(error.message) ? "The table isn't there yet. Run <code>supabase/whats_new.sql</code> in the SQL editor, then reload." : esc(error.message)}</p>`;
        $("#wn-new").disabled = $("#wn-new-2").disabled = NO_TABLE.test(error.message);
        return;
      }
      // Drafts first, then published newest first (the order members see).
      list = (data || []).slice().sort((a, b) => (a.status === b.status ? 0 : a.status === "draft" ? -1 : 1));
      const on = showing();
      wrap.innerHTML = list.length
        ? list.map((r) => {
            const tag = r.status === "draft" ? '<span class="wn-tag">Draft</span>' : on.has(r.id) ? '<span class="wn-tag on">Live</span>' : '<span class="wn-tag live">Retired</span>';
            return `<button type="button" class="tadm-item ${r.id === cur ? "is-on" : ""}" data-id="${r.id}"><span>${esc(r.title || "Untitled")}<br><small>${esc(dayLabel(r.live_on))}${r.area ? " · " + esc(r.area) : ""}${whoLabel(r.audience) ? " · " + esc(whoLabel(r.audience)) : ""}</small></span>${tag}</button>`;
          }).join("")
        : '<p class="tadm-muted">No updates yet. Write the first one.</p>';
      wrap.querySelectorAll(".tadm-item").forEach((b) => b.addEventListener("click", () => {
        if (b.dataset.id === cur) return;
        if (dirty && !confirm("Discard unsaved changes?")) return;
        showEditor(list.find((r) => r.id === b.dataset.id));
      }));
    }

    (async () => {
      const session = await requireAdmin("/admin/login");
      if (!session) return;
      await loadList();
      loadPicks();
    })();
  </script>
</AdminShell>
