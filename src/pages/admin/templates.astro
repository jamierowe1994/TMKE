---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
import { templates as defaultLibrary } from "../../data/library.js";
---

<AdminShell active="studio" title="Design studio">
  <div class="ash-panel ash-page">
  <section class="admin-bar">
    <div class="admin-bar-actions">
      <span class="admin-bar-count" id="tpl-count">…</span>
      <a href="/admin/fonts" class="admin-btn admin-btn-ghost">Brand fonts</a>
      <button type="button" id="seed-btn" class="admin-btn admin-btn-ghost" hidden>Seed from default library</button>
      <button type="button" id="new-btn" class="admin-btn admin-btn-primary">+ New template</button>
    </div>
  </section>

  <section class="tpl-list wrap" id="tpl-list">
    <p class="tpl-loading" id="tpl-loading">Loading templates…</p>
    <div class="tpl-empty" id="tpl-empty" hidden>
      <p><strong>No templates yet.</strong></p>
      <p>Click <strong>Seed from default library</strong> to import the 30 starter templates, or <strong>+ New template</strong> to build one from scratch.</p>
    </div>
    <div class="tpl-grid" id="tpl-grid"></div>
  </section>
  </div>

  <!-- Bulk action bar — appears when one or more templates are ticked. -->
  <div class="tpl-bulkbar" id="tpl-bulkbar" hidden>
    <span class="tpl-bulk-count" id="tpl-bulk-count">0 selected</span>
    <button type="button" class="admin-btn admin-btn-ghost" id="tpl-bulk-archive">Archive</button>
    <button type="button" class="admin-btn admin-btn-danger" id="tpl-bulk-delete">Delete selected</button>
    <button type="button" class="admin-btn admin-btn-ghost" id="tpl-bulk-cancel">Cancel</button>
  </div>

  <!-- Hidden bootstrap blob — read by the JS below. Keeps the script tag tidy. -->
  <script id="tpl-default-library" type="application/json" set:html={JSON.stringify(defaultLibrary)}></script>

  <!--
    is:global so the rules below apply to cards that are injected by JS
    after the page renders. Without this, Astro's auto-scoping adds a
    unique attribute to every selector at build time, and dynamic HTML
    doesn't carry that attribute — so the card styles silently miss.
    All selectors are .tpl-* / .admin-* and used only on this page, so
    leakage to other pages is negligible.
  -->
  <style is:global>
    .admin-hero-pad { padding-top: 100px; }
    @media (max-width: 720px) { .admin-hero-pad { padding-top: 56px; } }
    .admin-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      max-width: 1360px;
      margin: 0 auto;
      padding: 12px 36px 0;
    }
    .admin-back {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--english-violet);
      text-decoration: none;
      font-weight: 700;
    }
    .admin-back:hover { color: var(--ink); }
    .admin-bar-actions { display: flex; align-items: center; gap: 12px; }
    .admin-bar-count {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.6);
      font-weight: 600;
    }
    .admin-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 2px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid transparent;
      text-decoration: none;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .admin-btn-primary { background: var(--english-violet); color: var(--paper); }
    .admin-btn-primary:hover { background: var(--ink); }
    .admin-btn-ghost { background: transparent; border-color: rgba(55, 30, 40, 0.4); color: var(--english-violet); }
    .admin-btn-ghost:hover { background: rgba(55, 30, 40, 0.06); }
    .admin-btn-danger { background: transparent; border-color: #a05a3c; color: #a05a3c; }
    .admin-btn-danger:hover { background: #a05a3c; color: var(--paper); }
    .admin-btn[disabled] { opacity: 0.5; cursor: not-allowed; }

    .tpl-list {
      max-width: 1360px;
      margin: 0 auto;
      padding: 24px 36px 200px;
    }
    .tpl-loading {
      font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.5);
      padding: 24px 0;
    }
    .tpl-empty {
      padding: 32px;
      border: 1px dashed rgba(55, 30, 40,0.4);
      border-radius: 2px;
      font-family: var(--sans);
      color: rgba(28,29,34,0.7);
      max-width: 620px;
    }
    .tpl-empty strong { color: var(--ink); }
    .tpl-empty p { margin: 0 0 8px; line-height: 1.55; }
    .tpl-empty p:last-child { margin-bottom: 0; }

    .tpl-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
      align-items: start;
    }
    @media (max-width: 1180px) { .tpl-grid { grid-template-columns: repeat(3, 1fr); } }
    @media (max-width: 880px)  { .tpl-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px)  { .tpl-grid { grid-template-columns: 1fr; } }

    .tpl-card {
      position: relative;
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(55, 30, 40, 0.3);
      border-radius: 2px;
      background: rgba(255, 255, 255, 0.5);
      overflow: hidden;
      transition: border-color 0.2s, transform 0.3s, box-shadow 0.2s;
    }
    .tpl-card:hover { border-color: rgba(55, 30, 40,0.6); transform: translateY(-2px); }
    .tpl-card.is-draft { border-style: dashed; opacity: 0.85; }
    .tpl-card.is-archived { opacity: 0.5; }
    .tpl-card.is-selected { border-color: var(--english-violet); box-shadow: 0 0 0 2px var(--english-violet); }

    /* Bulk-select checkbox — top-left of each card. */
    .tpl-check { position: absolute; top: 8px; left: 8px; z-index: 4; cursor: pointer; }
    .tpl-check input { position: absolute; opacity: 0; width: 0; height: 0; }
    .tpl-check-box {
      position: relative; display: block; width: 22px; height: 22px; border-radius: 5px;
      background: rgba(255,255,255,0.92); border: 1px solid rgba(28,29,34,0.3);
      box-shadow: 0 1px 4px rgba(20,18,26,0.25); transition: background 0.15s, border-color 0.15s;
    }
    .tpl-check input:checked + .tpl-check-box { background: var(--english-violet); border-color: var(--english-violet); }
    .tpl-check input:checked + .tpl-check-box::after {
      content: ""; position: absolute; left: 7px; top: 3px; width: 5px; height: 10px;
      border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg);
    }

    /* Bulk action bar — floats at the bottom centre when items are selected. */
    .tpl-bulkbar {
      position: fixed; left: 50%; bottom: 22px; transform: translateX(-50%);
      z-index: 60; display: flex; align-items: center; gap: 10px;
      padding: 10px 14px; border-radius: 12px;
      background: rgba(28,29,34,0.94); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
      box-shadow: 0 16px 40px -16px rgba(0,0,0,0.5);
    }
    .tpl-bulkbar[hidden] { display: none; }
    .tpl-bulk-count { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; color: #fff; padding-right: 4px; }
    .tpl-bulkbar .admin-btn { padding: 8px 12px; }
    .tpl-bulkbar .admin-btn-ghost { color: #fff; border-color: rgba(255,255,255,0.35); background: transparent; }
    .tpl-bulkbar .admin-btn-ghost:hover { background: rgba(255,255,255,0.12); }
    .tpl-bulkbar .admin-btn-danger { background: #c0392b; color: #fff; border-color: #c0392b; }
    .tpl-bulkbar .admin-btn-danger:hover { background: #8f2a1f; border-color: #8f2a1f; }
    .tpl-card-link {
      display: block;
      text-decoration: none;
      color: var(--ink);
    }
    .tpl-thumb {
      aspect-ratio: 3 / 4;
      background: var(--platinum);
      position: relative;
      overflow: hidden;
      container-type: size;
    }
    /* Live mini-render of the template's own canvas + elements (scaled via
       percentage positions + container-query font units), so previews show
       even when no thumbnail image has been generated. */
    .tpl-canvas { position: absolute; inset: 0; }
    .tpl-canvas img { display: block; border: 0; }
    .tpl-status {
      position: absolute;
      top: 10px;
      right: 10px;
      padding: 3px 9px;
      background: rgba(28,29,34,0.78);
      color: var(--paper);
      font-family: var(--sans);
      font-size: 9px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      border-radius: 2px;
    }
    .tpl-status.is-draft { background: #8a7a36; }
    .tpl-status.is-archived { background: rgba(28,29,34,0.5); }
    .tpl-body {
      padding: 14px 16px 8px;
      display: flex;
      flex-direction: column;
      gap: 4px;
    }
    .tpl-name {
      font-family: var(--serif);
      font-size: 17px;
      font-weight: 500;
      color: var(--ink);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .tpl-meta {
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.5);
      font-weight: 600;
    }
    .tpl-actions {
      display: flex;
      gap: 6px;
      padding: 0 16px 14px;
    }
    .tpl-actions .admin-btn { padding: 6px 10px; font-size: 10px; }

    /* On-brand centred prompt modal (replaces the native browser prompt) */
    .tpl-ask-scrim {
      position: fixed; inset: 0; z-index: 400;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
      background: rgba(16, 14, 22, 0.55);
      backdrop-filter: blur(4px); -webkit-backdrop-filter: blur(4px);
      opacity: 0; transition: opacity 0.2s ease;
    }
    .tpl-ask-scrim.is-open { opacity: 1; }
    .tpl-ask {
      width: 100%; max-width: 460px;
      background: var(--paper, #f4f2f1); color: var(--ink, #1c1d22);
      border-radius: 16px; padding: 34px 34px 28px;
      box-shadow: 0 30px 80px -20px rgba(16, 14, 22, 0.6);
      transform: translateY(12px) scale(0.98); transition: transform 0.22s cubic-bezier(.16,1,.3,1);
    }
    .tpl-ask-scrim.is-open .tpl-ask { transform: none; }
    .tpl-ask-eyebrow {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--english-violet); margin-bottom: 12px;
    }
    .tpl-ask-label {
      display: block; font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.55); margin-bottom: 8px;
    }
    .tpl-ask-input {
      width: 100%; box-sizing: border-box; padding: 14px 16px;
      font-family: var(--serif); font-size: 22px; color: var(--ink);
      background: #fff; border: 1px solid rgba(28,29,34,0.2); border-radius: 6px;
    }
    .tpl-ask-input:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55, 30, 40,0.14); }
    .tpl-ask-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 24px; }
    .tpl-ask-cancel, .tpl-ask-ok {
      font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.08em;
      padding: 12px 22px; border-radius: 999px; cursor: pointer; border: 1px solid transparent;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .tpl-ask-cancel { background: transparent; color: rgba(28,29,34,0.6); border-color: rgba(28,29,34,0.2); }
    .tpl-ask-cancel:hover { color: var(--ink); border-color: rgba(28,29,34,0.45); }
    .tpl-ask-ok { background: var(--english-violet); color: var(--paper); }
    .tpl-ask-ok:hover { background: var(--ink); }
  </style>

  <script>
    import { requireAdmin } from '../../lib/admin-gate.js';
    import { supabase } from '../../lib/supabase.js';

    const els = {
      grid: document.getElementById('tpl-grid'),
      empty: document.getElementById('tpl-empty'),
      loading: document.getElementById('tpl-loading'),
      count: document.getElementById('tpl-count'),
      seedBtn: document.getElementById('seed-btn'),
      newBtn: document.getElementById('new-btn'),
    };

    const defaultLibrary = JSON.parse(
      document.getElementById('tpl-default-library')?.textContent || '[]'
    );
    const DEV = import.meta.env.DEV;

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    function fontStack(f) {
      const s = String(f || '');
      return /garamond|seasons|helios|times|serif/i.test(s)
        ? `'${s}', Georgia, serif`
        : `'${s}', 'Darker Grotesque', system-ui, sans-serif`;
    }

    // Render one element as a positioned div/img. Coordinates are a % of the
    // canvas; font + letter-spacing use cqw (1% of the thumb's width) so text
    // scales with the preview at any size.
    function renderEl(el, W, H) {
      if (!el || el.x == null) return '';
      const pos = `position:absolute;left:${(el.x / W * 100).toFixed(3)}%;top:${(el.y / H * 100).toFixed(3)}%;width:${(el.w / W * 100).toFixed(3)}%;height:${(el.h / H * 100).toFixed(3)}%;`;
      const rot = el.rotation ? `transform:rotate(${el.rotation}deg);` : '';
      if (el.type === 'image' && el.src) {
        return `<img src="${escapeHtml(el.src)}" alt="" loading="lazy" style="${pos}${rot}object-fit:cover;opacity:${el.opacity ?? 1};" />`;
      }
      if (el.type === 'rect') {
        const rad = el.radius ? `border-radius:${(el.radius / W * 100).toFixed(2)}cqw;` : '';
        return `<div style="${pos}${rot}background:${escapeHtml(el.fill || 'transparent')};opacity:${el.opacity ?? 1};${rad}"></div>`;
      }
      if (el.type === 'text') {
        const fs = (Number(el.size) || 16) / W * 100;
        const ls = (Number(el.letterSpacing) || 0) / W * 100;
        return `<div style="${pos}${rot}color:${escapeHtml(el.color || '#1c1d22')};font-family:${fontStack(el.font)};font-size:${fs.toFixed(3)}cqw;font-weight:${el.weight || 400};font-style:${el.italic ? 'italic' : 'normal'};text-align:${el.align || 'left'};letter-spacing:${ls.toFixed(3)}cqw;line-height:${el.lineHeight || 1.2};overflow:hidden;">${escapeHtml(el.text || '')}</div>`;
      }
      return '';
    }

    function renderPreview(t) {
      const cv = t.canvas || {};
      const W = Number(cv.width) || 1080, H = Number(cv.height) || 1440;
      const els = Array.isArray(t.elements) ? t.elements : [];
      // No design yet but a thumbnail exists → show the thumbnail.
      if (!els.length && t.thumb_url) {
        return `<div class="tpl-canvas" style="background:#fff"><img src="${escapeHtml(t.thumb_url)}" alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;" /></div>`;
      }
      return `<div class="tpl-canvas" style="background:${escapeHtml(cv.background || '#f4f2f1')}">${els.map((el) => renderEl(el, W, H)).join('')}</div>`;
    }

    function renderCard(t) {
      const cv = t.canvas || {};
      const arW = Number(cv.width) || 1080, arH = Number(cv.height) || 1440;
      const statusBadge = t.status === 'active'
        ? ''
        : `<span class="tpl-status is-${t.status}">${t.status}</span>`;
      return `
        <article class="tpl-card is-${t.status}" data-id="${escapeHtml(t.id)}">
          <label class="tpl-check" title="Select template"><input type="checkbox" data-select="${escapeHtml(t.id)}" /><span class="tpl-check-box"></span></label>
          <a class="tpl-card-link" href="/editor?id=${encodeURIComponent(t.id)}&mode=admin">
            <div class="tpl-thumb" style="aspect-ratio:${arW}/${arH}">${renderPreview(t)}${statusBadge}</div>
            <div class="tpl-body">
              <div class="tpl-name">${escapeHtml(t.name)}</div>
              <div class="tpl-meta">${escapeHtml(t.category || '—')} · #${t.sort_order ?? 0}</div>
            </div>
          </a>
          <div class="tpl-actions">
            <a class="admin-btn admin-btn-ghost" href="/editor?id=${encodeURIComponent(t.id)}&mode=admin">Edit</a>
            ${t.status === 'archived'
              ? `<button class="admin-btn admin-btn-ghost" data-restore="${escapeHtml(t.id)}">Restore</button>`
              : `<button class="admin-btn admin-btn-ghost" data-archive="${escapeHtml(t.id)}">Archive</button>`}
          </div>
        </article>
      `;
    }

    function devSampleTemplates() {
      return defaultLibrary.map((t, i) => ({
        id: t.id, name: t.name, category: t.category || null,
        thumb_url: t.thumb || null, canvas: t.canvas, elements: t.elements,
        status: 'active', sort_order: (i + 1) * 10,
      }));
    }

    async function loadTemplates() {
      els.loading.hidden = false;
      const { data, error } = await supabase
        .from('templates')
        .select('id, name, category, thumb_url, canvas, elements, status, sort_order, updated_at')
        .order('status', { ascending: true })
        .order('sort_order', { ascending: true });

      els.loading.hidden = true;

      let tpls = data ?? [];
      if ((error || !tpls.length) && DEV) {
        // Local dev has no Supabase session — render the default library so the
        // page and the live thumbnails are viewable without a login.
        tpls = devSampleTemplates();
      } else if (error) {
        els.grid.innerHTML = `<p>Could not load templates: ${escapeHtml(error.message)}</p>`;
        return;
      }

      const active = tpls.filter((t) => t.status === 'active').length;
      els.count.textContent = `${active} active · ${tpls.length} total`;
      els.empty.hidden = tpls.length !== 0;
      els.seedBtn.hidden = tpls.length !== 0 || defaultLibrary.length === 0;
      els.grid.innerHTML = tpls.map(renderCard).join('');
    }

    async function seedFromLibrary() {
      if (!defaultLibrary.length) return;
      if (!confirm(`Import ${defaultLibrary.length} starter templates from the default library?`)) return;

      els.seedBtn.setAttribute('disabled', 'true');
      els.seedBtn.textContent = 'Seeding…';

      const rows = defaultLibrary.map((t, i) => ({
        id: t.id,
        name: t.name,
        category: t.category || null,
        thumb_url: t.thumb || null,
        canvas: t.canvas,
        elements: t.elements,
        status: 'active',
        sort_order: (i + 1) * 10,
      }));

      const { error } = await supabase.from('templates').upsert(rows, { onConflict: 'id' });
      els.seedBtn.removeAttribute('disabled');
      els.seedBtn.textContent = 'Seed from default library';

      if (error) {
        alert(`Seed failed: ${error.message}`);
        return;
      }
      await loadTemplates();
    }

    async function archiveTemplate(id) {
      if (!confirm('Archive this template? It will be hidden from the studio.')) return;
      const { error } = await supabase.from('templates').update({ status: 'archived' }).eq('id', id);
      if (error) return alert(`Archive failed: ${error.message}`);
      await loadTemplates();
    }

    async function restoreTemplate(id) {
      const { error } = await supabase.from('templates').update({ status: 'active' }).eq('id', id);
      if (error) return alert(`Restore failed: ${error.message}`);
      await loadTemplates();
    }

    // Centred, on-brand prompt modal (replaces the native browser prompt).
    function askName({ title, label, placeholder, confirm }) {
      return new Promise((resolve) => {
        const scrim = document.createElement('div');
        scrim.className = 'tpl-ask-scrim';
        scrim.innerHTML = `
          <div class="tpl-ask" role="dialog" aria-modal="true">
            <div class="tpl-ask-eyebrow">${title || 'New'}</div>
            <label class="tpl-ask-label">${label || 'Name'}</label>
            <input type="text" class="tpl-ask-input" placeholder="${placeholder || ''}" />
            <div class="tpl-ask-actions">
              <button type="button" class="tpl-ask-cancel">Cancel</button>
              <button type="button" class="tpl-ask-ok">${confirm || 'Create'}</button>
            </div>
          </div>`;
        document.body.appendChild(scrim);
        const input = scrim.querySelector('.tpl-ask-input');
        const done = (val) => {
          scrim.classList.remove('is-open');
          setTimeout(() => scrim.remove(), 220);
          resolve(val);
        };
        scrim.querySelector('.tpl-ask-ok').addEventListener('click', () => done(input.value.trim() || null));
        scrim.querySelector('.tpl-ask-cancel').addEventListener('click', () => done(null));
        scrim.addEventListener('mousedown', (e) => { if (e.target === scrim) done(null); });
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') { e.preventDefault(); done(input.value.trim() || null); }
          else if (e.key === 'Escape') { e.preventDefault(); done(null); }
        });
        requestAnimationFrame(() => { scrim.classList.add('is-open'); input.focus(); });
      });
    }

    async function newTemplate() {
      const name = await askName({
        title: 'New template',
        label: 'Template name',
        placeholder: 'e.g. Just Listed — Editorial',
        confirm: 'Create template',
      });
      if (!name) return;
      const id = 'tmpl-' + Math.random().toString(36).slice(2, 8);
      const row = {
        id,
        name: name.trim(),
        category: null,
        thumb_url: null,
        canvas: { width: 1080, height: 1440, background: '#f4f2f1' },
        elements: [],
        status: 'draft',
        sort_order: 9000,
      };
      const { error } = await supabase.from('templates').insert(row);
      if (error) {
        alert(`Create failed: ${error.message}`);
        return;
      }
      // Carry the name straight into the studio so it opens titled, not "Untitled".
      location.href = `/editor?id=${encodeURIComponent(id)}&mode=admin&title=${encodeURIComponent(name.trim())}`;
    }

    (async () => {
      if (!DEV) {
        const session = await requireAdmin();
        if (!session) return;
      }
      await loadTemplates();
    })();

    els.seedBtn.addEventListener('click', seedFromLibrary);
    els.newBtn.addEventListener('click', newTemplate);

    els.grid.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement)) return;
      const arch = t.getAttribute('data-archive');
      const rest = t.getAttribute('data-restore');
      if (arch) { archiveTemplate(arch); return; }
      if (rest) { restoreTemplate(rest); return; }
    });

    // ---- Bulk select + actions ----
    const selected = new Set();
    const bulkBar = document.getElementById('tpl-bulkbar');
    const bulkCount = document.getElementById('tpl-bulk-count');

    function updateBulkBar() {
      const n = selected.size;
      if (bulkBar) bulkBar.hidden = n === 0;
      if (bulkCount) bulkCount.textContent = n + (n === 1 ? ' selected' : ' selected');
    }
    function clearSelection() {
      selected.clear();
      els.grid.querySelectorAll('[data-select]').forEach((c) => { c.checked = false; });
      els.grid.querySelectorAll('.tpl-card.is-selected').forEach((c) => c.classList.remove('is-selected'));
      updateBulkBar();
    }

    // Ticking a card's checkbox selects it (the box sits outside the edit link).
    els.grid.addEventListener('change', (e) => {
      const cb = e.target;
      if (!(cb instanceof HTMLInputElement) || !cb.hasAttribute('data-select')) return;
      const id = cb.getAttribute('data-select');
      const card = cb.closest('.tpl-card');
      if (cb.checked) { selected.add(id); card && card.classList.add('is-selected'); }
      else { selected.delete(id); card && card.classList.remove('is-selected'); }
      updateBulkBar();
    });

    document.getElementById('tpl-bulk-cancel')?.addEventListener('click', clearSelection);

    document.getElementById('tpl-bulk-delete')?.addEventListener('click', async () => {
      const ids = [...selected];
      if (!ids.length) return;
      if (!confirm(`Delete ${ids.length} template${ids.length > 1 ? 's' : ''}? This can't be undone.`)) return;
      const btn = document.getElementById('tpl-bulk-delete');
      btn.setAttribute('disabled', 'true'); btn.textContent = 'Deleting…';
      const { error } = await supabase.from('templates').delete().in('id', ids);
      btn.removeAttribute('disabled'); btn.textContent = 'Delete selected';
      if (error) { alert(`Bulk delete failed: ${error.message}`); return; }
      clearSelection();
      await loadTemplates();
    });

    document.getElementById('tpl-bulk-archive')?.addEventListener('click', async () => {
      const ids = [...selected];
      if (!ids.length) return;
      const btn = document.getElementById('tpl-bulk-archive');
      btn.setAttribute('disabled', 'true'); btn.textContent = 'Archiving…';
      const { error } = await supabase.from('templates').update({ status: 'archived' }).in('id', ids);
      btn.removeAttribute('disabled'); btn.textContent = 'Archive';
      if (error) { alert(`Bulk archive failed: ${error.message}`); return; }
      clearSelection();
      await loadTemplates();
    });
  </script>
</AdminShell>
