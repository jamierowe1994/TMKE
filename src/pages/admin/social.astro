---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
import { SOCIAL_SERVICES, SOCIAL_EXTRAS, PRICE_COLUMNS } from "../../lib/smm-config.js";
import { gbpFromPence } from "../../lib/supabase.js";

const marketing = SOCIAL_SERVICES.find((s) => s.key === "social-media-marketing");
---

<AdminShell active="social" title="Social media" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Social media</div>
          <div class="page-header-sub">Every enquiry through to active, managed client.</div>
        </div>
      </div>
    </div>
  </div>
  <div class="ash-panel ash-page">
    <!-- Same shape as Videography's: an action bar, then the panel it acts on.
         The two pages sit next to each other in the rail and were laid out
         differently for no reason other than being written apart. -->
    <section class="admin-bar">
      <div class="admin-bar-actions">
        <button type="button" class="admin-btn admin-btn-primary" id="smm-add-lead">+ New client</button>
        <div class="smm-cog-wrap">
          <button type="button" class="smm-cog" id="smm-cog" aria-label="Social settings" aria-expanded="false">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
            <span>Settings</span>
          </button>
          <div class="smm-cog-menu" id="smm-cog-menu" hidden>
            <button type="button" data-go="pipeline">Contacts</button>
            <button type="button" data-go="rates">Packages &amp; pricing</button>
            <button type="button" data-go="mgmt" id="smm-cog-mgmt" hidden>Monthly report</button>
          </div>
        </div>
      </div>
    </section>

    <!-- ===================== CONTACTS (the pipeline) ===================== -->
    <section class="smm-panel wrap is-active" data-panel="pipeline">
      <div class="smm-pagehead">
        <div>
          <h2 class="smm-panel-title">Contacts</h2>
          <p class="smm-panel-sub">Everyone who has expressed an interest in our SMM services, by pipeline stage. Click a card to open a person&rsquo;s file.</p>
        </div>
        <input type="search" id="smm-search" class="admin-search" placeholder="Search name, email, business…" aria-label="Search contacts" />
      </div>

      <div class="smm-bar-top">
        <div class="smm-filters" id="smm-filters" role="tablist">
          <button type="button" class="smm-chip is-active" data-filter="all">All</button>
          <button type="button" class="smm-chip" data-filter="waitlist">Waitlist</button>
          <button type="button" class="smm-chip" data-filter="enquiry">Enquiries</button>
          <button type="button" class="smm-chip" data-filter="brochure">Brochures</button>
          <button type="button" class="smm-chip" data-filter="meeting_set">Discovery calls</button>
          <button type="button" class="smm-chip" data-filter="proposal_sent">Proposals</button>
          <button type="button" class="smm-chip" data-filter="contract_signed">Contracts</button>
          <button type="button" class="smm-chip" data-filter="onboarding">Onboarding clients</button>
          <button type="button" class="smm-chip" data-filter="active_client">Clients</button>
        </div>
        <div class="smm-bar-actions">
          <label class="smm-lost-toggle"><input type="checkbox" id="smm-show-lost" /> Show lost</label>
        </div>
      </div>

      <p class="smm-loading" id="smm-loading">Loading pipeline…</p>
      <div class="smm-scrolltop" id="smm-scrolltop" hidden><div id="smm-scrolltop-inner"></div></div>
      <div class="smm-board" id="smm-board" hidden></div>
    </section>

    <!-- ===================== PACKAGES & PRICING (reference) ===================== -->
    <section class="smm-panel wrap" data-panel="rates" hidden>
      <div class="smm-pagehead">
        <div>
          <h2 class="smm-panel-title">Packages &amp; pricing</h2>
          <p class="smm-panel-sub">What we sell and what it costs, so nobody has to go looking for a spreadsheet. Read-only &mdash; the figures come from <code>src/lib/smm-config.js</code>, the same file the website and the member hub price from, so this cannot drift from what a client is shown.</p>
        </div>
      </div>

      <div class="smm-rate-heads">
        {SOCIAL_SERVICES.map((sv) => (
          <div class="smm-rate-head">
            <div class="smm-rate-head-name">{sv.name}</div>
            {sv.alias && <div class="smm-rate-head-alias">Also called &ldquo;{sv.alias}&rdquo;</div>}
            <div class="smm-rate-head-price">from {gbpFromPence(sv.from_pence)} <span>+VAT / {sv.unit}</span></div>
            <div class={`smm-rate-head-state ${sv.openToNewClients ? "is-open" : "is-closed"}`}>
              {sv.openToNewClients ? "Taking new clients" : "Full — waitlist only"}
            </div>
          </div>
        ))}
      </div>

      <h3 class="smm-rate-sub">{marketing.name} &mdash; the three packages</h3>
      <div class="smm-rate-wrap">
        <table class="smm-rate">
          <thead>
            <tr>
              <th>Package</th><th>Shoot</th><th>Videos</th><th>Posts / wk</th><th>Amends</th>
              {PRICE_COLUMNS.map((c) => <th class="smm-rate-num">{c.label}</th>)}
              <th class="smm-rate-num">Max clients</th>
            </tr>
          </thead>
          <tbody>
            {marketing.packages.map((pk, i) => (
              <tr>
                <td><strong>{pk.name || `Package ${i + 1}`}</strong><span class="smm-rate-hours">{pk.hours.videography}h film · {pk.hours.editing}h edit · {pk.hours.brief}h brief · {pk.hours.management}h management</span></td>
                <td>{pk.spec}</td>
                <td>{pk.videos}</td>
                <td>{pk.postsPerWeek}</td>
                <td>{pk.amends}</td>
                {PRICE_COLUMNS.map((c) => <td class="smm-rate-num">{gbpFromPence(pk.price_pence[c.key])}</td>)}
                <td class="smm-rate-num">{pk.maxClientsPerSmm}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="smm-rate-note">
        Onboarding is {gbpFromPence(marketing.onboarding_pence)} one-off on every package. Prices exclude VAT.
        The three columns are <strong>who is buying</strong>, not what they get &mdash; the spec is identical across them.
        Nothing client-facing picks a column: the website and the hub show &ldquo;from&rdquo; the lowest, because neither can tell who someone is.
      </p>

      <h3 class="smm-rate-sub">Also on social</h3>
      <div class="smm-rate-wrap">
        <table class="smm-rate">
          <thead><tr><th>Service</th><th>What it is</th><th class="smm-rate-num">From</th></tr></thead>
          <tbody>
            {SOCIAL_EXTRAS.map((sv) => (
              <tr><td><strong>{sv.name}</strong></td><td>{sv.summary}</td><td class="smm-rate-num">{gbpFromPence(sv.from_pence)} <span class="smm-rate-unit">+VAT / {sv.unit}</span></td></tr>
            ))}
          </tbody>
        </table>
      </div>
      {SOCIAL_SERVICES.filter((sv) => sv.futurePackages).map((sv) => (
        <p class="smm-rate-note">
          <strong>{sv.name}</strong> is one service at one price for now. It splits into {sv.futurePackages.join(", ")} once those are packaged and priced.
        </p>
      ))}
    </section>

    <!-- ===================== MONTHLY REPORT (management) ===================== -->
    <!-- Danielle, Sam and Abby only: the Worker checks (MGMT_REPORT_EMAILS);
         the menu item is only shown to them. -->
    <section class="smm-panel wrap" data-panel="mgmt" hidden>
      <div class="smm-pagehead">
        <div>
          <h2 class="smm-panel-title">Monthly report</h2>
          <p class="smm-panel-sub">Every client report published for a month, in one A4 PDF: a cover with the month's totals and anyone missing, then a page per account with the profile, the content, the top five posts, and our own read of the month from the Summary tab. A client is in it once their report for the month has been published to them.</p>
        </div>
      </div>
      <div class="mg-controls">
        <label class="mg-f"><span>Month</span><select id="mg-month"></select></label>
        <button type="button" class="smm-btn smm-btn--primary" id="mg-pull" disabled>Pull monthly report</button>
        <span class="mg-status" id="mg-status"></span>
      </div>
      <div class="mg-preview" id="mg-preview"></div>
    </section>
  </div>

  <!-- Full-screen customer file -->
  <div class="smm-file-scrim" id="smm-file" hidden>
    <div class="smm-file-card" role="dialog" aria-modal="true" aria-label="Customer file">
      <button type="button" class="smm-file-x" id="smm-file-close" aria-label="Close">&times;</button>
      <div class="smm-file-body" id="smm-file-body"></div>
    </div>
  </div>

  <!-- Modal host (meeting booking / add file) -->
  <div id="smm-modal-host"></div>

  <style is:global>
    /* ---- Panels + toolbar (mirroring Videography) ----
       The bar's own layout is defined per page in the admin centre, so it is
       written out here too rather than inherited — without it the two buttons
       stack instead of sitting in a row. Same numbers as Videography's. */
    .admin-bar {
      display: flex; justify-content: space-between; align-items: center;
      gap: 16px; max-width: 1360px; margin: 0 auto;
      padding: 0 36px 12px; flex-wrap: wrap;
    }
    .admin-bar-actions,
    .hub-skin .admin-bar .admin-bar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    /* The open cog menu must sit above the cards below it. */
    .admin-bar:has(#smm-cog-menu:not([hidden])) { z-index: 30; position: relative; }
    /* ---- Panels + toolbar (mirroring Videography) ---- */
    /* Videography's numbers exactly — same padding-bottom, same head, same
       margins. Title and sub deliberately declare NOTHING but their margin:
       hub-tokens.css already sets both for .vid-panel-title / .vid-panel-sub
       and Social is named in those rules now, so there is one definition of
       what a panel heading looks like rather than two that drifted to 30px
       against 26px. */
    .smm-panel { padding-bottom: 40px; }
    .smm-panel[hidden] { display: none; }
    /* .smm-pagehead, NOT .smm-panel-head — that name was already taken by the
       customer file's small section heads further down this file, whose rule
       comes later and quietly won. The page head was inheriting a 12px margin
       it never asked for, and leaking flex-wrap into every drawer heading. */
    .smm-pagehead { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; flex-wrap: wrap; margin-bottom: 12px; }
    .smm-panel-title { margin: 0; }
    /* No max-width: Videography has none, and a cap here was wrapping a
       sentence that fits, which is the one thing that still made the two
       heads different heights. The long explanation on the rates panel gets
       its own cap instead. */
    .smm-panel-sub { margin: 4px 0 0; }
    .smm-panel[data-panel="rates"] .smm-panel-sub { max-width: 88ch; }
    .smm-panel[data-panel="rates"] .smm-pagehead { margin-bottom: 24px; }
    .smm-panel-sub code { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12.5px; background: rgba(28,29,34,0.06); padding: 1px 5px; border-radius: 3px; }

    /* Monthly report panel */
    /* Month and button on one line, the same height and type. */
    .mg-controls { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 8px 0 22px; }
    .mg-controls .mg-f { display: flex; align-items: center; gap: 14px; margin: 0; }
    .mg-f span { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .mg-f select, .mg-controls .smm-btn { height: 40px; box-sizing: border-box; font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.02em; border-radius: 8px; }
    .mg-f select { padding: 0 34px 0 14px; border: 1px solid rgba(var(--violet-rgb),0.3); background: #fff; color: var(--english-violet); min-width: 210px; }
    .mg-controls .smm-btn { padding: 0 18px; }
    .mg-status { font-size: 13px; color: rgba(28,29,34,0.6); }
    .mg-pick { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 10px; }
    .mg-pick button { font: 700 12px var(--sans); padding: 5px 10px; border-radius: 99px; border: 1px solid rgba(var(--violet-rgb),0.25); background: #fff; color: var(--english-violet); cursor: pointer; }
    .mg-pick button:hover { border-color: var(--english-violet); }
    .mg-card label { display: flex; align-items: flex-start; gap: 10px; cursor: pointer; }
    .mg-card label input { margin-top: 3px; accent-color: var(--english-violet); }
    .mg-who { display: grid; gap: 1px; }
    .mg-who b { font-weight: 700; color: #1c1d22; }
    .mg-who small { font-size: 12.5px; color: rgba(28,29,34,0.55); }
    .mg-preview { display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 16px; }
    .mg-card { border: 1px solid rgba(28,29,34,0.12); border-radius: 6px; background: #fff; padding: 16px 18px; }
    .mg-card h3 { margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.6); }
    .mg-card ul { list-style: none; margin: 0; padding: 0; }
    .mg-card li { display: flex; justify-content: space-between; gap: 12px; padding: 7px 0; border-top: 1px solid rgba(28,29,34,0.07); font-size: 14px; }
    .mg-card li:first-child { border-top: 0; }
    .mg-card li > span:last-child { color: rgba(28,29,34,0.55); text-align: right; }
    .mg-card .mg-empty { font-size: 14px; color: rgba(28,29,34,0.55); margin: 0; }

    /* Settings cog — the same control Videography carries. */
    .smm-cog-wrap { position: relative; }
    .smm-cog {
      display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px;
      background: var(--surface, #fff); border: 1px solid var(--border, #eae5e1); border-radius: 4px;
      font-family: var(--sans); font-size: 12px; line-height: 1; letter-spacing: 0.04em;
      font-weight: 700; text-transform: uppercase; color: var(--ink); cursor: pointer;
      transition: border-color .15s, color .15s;
    }
    .smm-cog svg { width: 14px; height: 14px; flex: none; margin: -1px 0; }
    .smm-cog:hover { border-color: var(--english-violet); color: var(--english-violet); }
    .smm-cog-menu {
      position: absolute; right: 0; top: calc(100% + 6px); z-index: 400;
      background: #fff; border: 1px solid rgba(var(--violet-rgb), 0.2); border-radius: 8px;
      box-shadow: 0 18px 50px rgba(20, 18, 26, 0.22); padding: 6px; width: 220px;
    }
    .smm-cog-menu[hidden] { display: none; }
    .smm-cog-menu button {
      display: block; width: 100%; text-align: left; padding: 9px 12px; border: 0; border-radius: 5px;
      background: none; font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--ink); cursor: pointer;
    }
    .smm-cog-menu button:hover { background: rgba(var(--violet-rgb), 0.08); }

    /* ---- The rate card ---- */
    .smm-rate-heads { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; margin-bottom: 30px; }
    @media (max-width: 800px) { .smm-rate-heads { grid-template-columns: 1fr; } }
    .smm-rate-head { padding: 16px 18px; border: 1px solid var(--border, #eae5e1); border-radius: 4px; background: #fff; }
    .smm-rate-head-name { font-family: var(--sans); font-size: 15px; font-weight: 700; color: var(--ink); }
    .smm-rate-head-alias { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); margin-top: 2px; }
    .smm-rate-head-price { font-family: var(--serif); font-size: 24px; font-weight: 500; color: var(--ink); margin-top: 10px; }
    .smm-rate-head-price span { font-family: var(--sans); font-size: 12.5px; font-weight: 600; color: rgba(28,29,34,0.55); }
    .smm-rate-head-state { margin-top: 8px; display: inline-flex; align-items: center; gap: 6px; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
    .smm-rate-head-state::before { content: ""; width: 6px; height: 6px; border-radius: 50%; }
    .smm-rate-head-state.is-open { color: #2e6b40; }
    .smm-rate-head-state.is-open::before { background: #3f9468; }
    .smm-rate-head-state.is-closed { color: #8a4d33; }
    .smm-rate-head-state.is-closed::before { background: #b9826a; }
    .smm-rate-sub { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin: 26px 0 10px; }
    .smm-rate-wrap { overflow-x: auto; border: 1px solid var(--border, #eae5e1); border-radius: 4px; background: #fff; }
    .smm-rate { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: 13px; }
    .smm-rate th, .smm-rate td { padding: 11px 14px; text-align: left; border-bottom: 1px solid rgba(28,29,34,0.07); vertical-align: top; }
    .smm-rate thead th { font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.5); white-space: nowrap; }
    .smm-rate tbody tr:last-child td { border-bottom: 0; }
    .smm-rate-num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .smm-rate-hours { display: block; font-size: 11.5px; color: rgba(28,29,34,0.5); margin-top: 3px; }
    .smm-rate-unit { font-size: 11.5px; color: rgba(28,29,34,0.5); }
    .smm-rate-note { font-family: var(--sans); font-size: 13px; line-height: 1.6; color: rgba(28,29,34,0.6); margin: 12px 0 0; max-width: 88ch; }

    .smm-bar { display: flex; flex-direction: column; gap: 12px; max-width: 1360px; margin: 0 auto; padding: 34px 36px 20px; }
    .smm-bar-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 18px; }
    /* Level with the bottom of the filter pills beside it. */
    .smm-bar-actions { display: flex; align-items: flex-end; gap: 12px; flex: none; align-self: flex-end; margin-bottom: 18px; }
    .smm-filters { display: flex; gap: 8px; flex-wrap: wrap; flex: 1; min-width: 0; margin: 0 0 18px; }
    .smm-chip {
      height: 32px; box-sizing: border-box; display: inline-flex; align-items: center; padding: 0 14px;
      background: #fff; border: 1px solid var(--border, rgba(28,29,34,0.14)); border-radius: 999px;
      font-family: var(--sans); font-size: 12px; font-weight: 600; color: rgba(28,29,34,0.7);
      cursor: pointer; transition: background .15s, border-color .15s, color .15s;
    }
    .smm-chip:hover { border-color: rgba(var(--violet-rgb),0.4); }
    .smm-chip.is-active { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    /* .ash-content.hub-skin prefix beats hub-tokens.css's ".hub-skin label{display:block}"
       (meant for real form-field captions) — this label is a clickable icon+input
       wrapper, not a caption, and needs to stay a flex row regardless of cascade order. */
    .ash-content.hub-skin .smm-search { height: 28px; box-sizing: border-box; display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 4px; padding: 0 14px; width: 340px; max-width: 100%; }
    .smm-search svg { width: 15px; height: 15px; color: rgba(28,29,34,0.42); flex: none; }
    .smm-search input { border: 0; outline: none; background: none; padding: 0; width: 100%; font-family: var(--sans); font-size: 13px; color: var(--ink); }
    .smm-lost-toggle { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); display: inline-flex; align-items: center; gap: 7px; cursor: pointer; white-space: nowrap; margin: 0; line-height: 1; }
    /* .hub-skin label adds a 6px bottom margin that outranks the rule above. */
    .smm-bar-actions .smm-lost-toggle, .smm-bar-actions .smm-lost-toggle input { margin: 0; }
    .smm-bar-actions .smm-lost-toggle { display: inline-flex; align-items: flex-end; gap: 7px; }
    .smm-loading { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); padding: 40px 36px; max-width: 1360px; margin: 0 auto; }

    /* ---- Pipeline board — comfortable columns, scroll along the bottom ---- */
    /* A synced scrollbar above the board so you don't have to scroll down a
       laptop screen to reach the native one. */
    .smm-scrolltop { max-width: 1360px; margin: 14px auto 6px; padding: 0 36px; overflow-x: auto; overflow-y: hidden; }
    .smm-scrolltop[hidden] { display: none; }
    #smm-scrolltop-inner { height: 1px; }
    /* Rows, not columns — one row per stage, cards run left-to-right within
       a row and that row scrolls on its own past ~3 cards. Same treatment
       as Videography's board. */
    .smm-board { display: flex; flex-direction: column; gap: 22px; max-width: 1360px; margin: 0 auto; padding: 6px 36px 60px; }
    /* One row per stage, a wine hairline between rows (skip before the first). */
    .smm-stage-row { min-width: 0; padding-top: 18px; border-top: 1px solid var(--accent-light, #c9bcb7); }
    .smm-stage-row:first-child { padding-top: 0; border-top: 0; }
    .smm-stage-cards {
      display: flex; gap: 12px; align-items: stretch; overflow-x: auto; padding: 2px 2px 10px;
      scrollbar-width: thin; scrollbar-color: rgba(28,29,34,0.28) transparent;
    }
    .smm-stage-cards::-webkit-scrollbar { height: 8px; -webkit-appearance: none; }
    .smm-stage-cards::-webkit-scrollbar-track { background: rgba(28,29,34,0.05); border-radius: 999px; }
    .smm-stage-cards::-webkit-scrollbar-thumb { background: rgba(28,29,34,0.28); border-radius: 999px; border: 2px solid transparent; background-clip: padding-box; }
    .smm-stage-cards::-webkit-scrollbar-thumb:hover { background: rgba(28,29,34,0.42); background-clip: padding-box; }
    .smm-stage-cards.drop-hover { background: rgba(var(--violet-rgb),0.07); box-shadow: inset 0 0 0 2px rgba(var(--violet-rgb),0.35); border-radius: 12px; }
    /* Three ~300px cards + two 12px gaps ≈ 924px — comfortable on a laptop;
       narrower viewports just see fewer per row before the scroll kicks in. */
    .smm-stage-cards .smm-card { flex: 0 0 300px; }
    /* Clients row: wraps onto a couple of lines instead of scrolling. */
    .smm-stage-cards.is-wrap { flex-wrap: wrap; overflow-x: visible; padding: 2px; }
    .smm-see-all {
      flex: 0 0 300px; appearance: none; cursor: pointer; text-align: center;
      background: none; border: 1.5px dashed rgba(28,29,34,0.18); border-radius: 10px;
      padding: 12px; font-family: var(--sans); font-size: 12.5px; font-weight: 700;
      color: var(--english-violet); transition: background 0.15s, border-color 0.15s;
    }
    .smm-see-all:hover { background: rgba(var(--violet-rgb), 0.06); border-color: var(--english-violet); }
    /* Filter active → a single-column line view instead of the board. */
    .smm-board.is-list { display: block; overflow-x: visible; }
    .smm-list { max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; }
    .smm-list-head { font-family: var(--sans); font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin: 2px 0 12px; }
    .smm-row { display: grid; grid-template-columns: 88px minmax(140px, 1.2fr) minmax(150px, 1.3fr) 118px auto; gap: 16px; align-items: center; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 12px 16px; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
    .smm-row:hover { border-color: rgba(var(--violet-rgb),0.45); box-shadow: 0 8px 20px -16px rgba(28,29,34,0.4); }
    .smm-row-main { min-width: 0; }
    .smm-row-name { font-family: var(--sans); font-size: 14.5px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smm-row-biz { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 1px; }
    .smm-row-email { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smm-row-stage { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.5); background: rgba(28,29,34,0.05); border-radius: 999px; padding: 4px 10px; text-align: center; white-space: nowrap; }
    .smm-row-acts { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    @media (max-width: 760px) { .smm-row { grid-template-columns: 1fr auto; } .smm-row-email, .smm-row-stage { display: none; } }
    .smm-col { background: transparent; min-width: 0; }
    .smm-col-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 0 4px 12px; }
    .smm-col-name { font-family: var(--sans); font-size: 11.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet); }
    .smm-col-count { font-family: var(--sans); font-size: 11px; font-weight: 700; color: rgba(28,29,34,0.5); background: rgba(28,29,34,0.06); border-radius: 999px; padding: 1px 8px; }
    .smm-col-body { display: flex; flex-direction: column; gap: 10px; min-height: 120px; padding: 4px; border-radius: 12px; transition: background .15s, box-shadow .15s; }
    .smm-col-body.drop-hover { background: rgba(var(--violet-rgb),0.07); box-shadow: inset 0 0 0 2px rgba(var(--violet-rgb),0.35); }
    .smm-col-empty { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.32); padding: 14px 6px; }
    .smm-card { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 15px 16px; cursor: pointer; transition: border-color .16s, transform .16s, box-shadow .16s; }
    .smm-card:hover { border-color: rgba(var(--violet-rgb),0.45); transform: translateY(-1px); box-shadow: 0 10px 24px -18px rgba(28,29,34,0.4); }
    .smm-card.dragging { opacity: .45; }
    .smm-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
    .smm-kind { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-kind.is-discovery { background: rgba(47,158,94,0.12); color: #2c7a4b; }
    .smm-kind.is-brochure { background: rgba(227,160,8,0.14); color: #9a6a04; }
    .smm-kind.is-package { background: var(--english-violet); color: #fff; }
    .smm-add-btn { height: 28px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; padding: 0 16px; background: var(--english-violet); border: 1px solid var(--english-violet); border-radius: 4px; font-family: var(--sans); font-size: 12.5px; font-weight: 700; color: #fff; cursor: pointer; transition: background .15s; white-space: nowrap; }
    .smm-add-btn:hover { background: var(--ink); border-color: var(--ink); }
    .smm-add-btn svg { width: 14px; height: 14px; }
    .smm-card-when { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.42); }
    .smm-card-name { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); }
    .smm-card-biz { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); margin-top: 2px; }
    .smm-card-line { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.5); margin-top: 8px; display: flex; align-items: center; gap: 6px; min-width: 0; }
    .smm-card-line svg { width: 13px; height: 13px; flex: none; color: rgba(28,29,34,0.4); }
    .smm-card-line-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .smm-card-meta { font-family: var(--sans); font-size: 11.5px; color: var(--english-violet); margin-top: 8px; display: inline-flex; align-items: center; gap: 5px; }
    .smm-card-meta svg { width: 12px; height: 12px; }
    .smm-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 12px; }
    .smm-card-acts { display: flex; flex-wrap: wrap; gap: 6px; }
    .smm-card-act { font-family: var(--sans); font-size: 11px; font-weight: 700; color: var(--english-violet); background: rgba(var(--violet-rgb),0.08); border: 0; border-radius: 6px; padding: 5px 10px; cursor: pointer; transition: background .15s; }
    .smm-card-act:hover { background: rgba(var(--violet-rgb),0.18); }
    .smm-card-status { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; flex: none; }

    /* ---- Full-screen customer file ---- */
    .smm-file-scrim { position: fixed; top: 0; right: 0; bottom: 0; left: var(--ash-side-w, 0); z-index: 200; background: rgba(20,18,26,0.5); display: flex; align-items: stretch; justify-content: center; padding: 28px; }
    .smm-file-scrim[hidden] { display: none; }
    .smm-file-card { position: relative; width: min(1120px, 100%); background: #fff; border-radius: 14px; box-shadow: 0 40px 100px rgba(20,18,26,0.4); overflow-y: auto; padding: 34px 40px 48px; }
    .smm-file-x { position: absolute; top: 20px; right: 24px; background: none; border: 0; font-size: 30px; line-height: 1; color: rgba(28,29,34,0.4); cursor: pointer; z-index: 2; }
    .smm-file-x:hover { color: var(--ink); }
    .smm-file-head { margin: 0 40px 20px 0; }
    .smm-name-wrap { display: inline-flex; align-items: center; gap: 6px; }
    .smm-file-name { font-family: var(--serif); font-weight: 500; font-size: 30px; color: var(--ink); margin: 0; display: inline-flex; align-items: center; gap: 6px; }
    .smm-name-edit { background: none; border: 0; padding: 5px; border-radius: 7px; color: rgba(28,29,34,0.32); cursor: pointer; display: inline-flex; }
    .smm-name-edit:hover { background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-name-edit svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }
    .smm-name-input { font-family: var(--serif); font-weight: 500; font-size: 30px; color: var(--ink); border: 0; border-bottom: 2px solid var(--english-violet); outline: none; background: none; min-width: 220px; padding: 0 0 2px; }
    .smm-file-sub { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); margin: 5px 0 0; }
    .smm-status-pill { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; margin-left: 6px; position: relative; top: -4px; }
    .smm-status-pill.is-active, .smm-card-status.is-active { background: rgba(47,158,94,0.14); color: #2c7a4b; }
    .smm-status-pill.is-paused, .smm-card-status.is-paused { background: rgba(227,160,8,0.16); color: #9a6a04; }
    .smm-status-pill.is-ended, .smm-card-status.is-ended { background: rgba(28,29,34,0.09); color: rgba(28,29,34,0.55); }

    /* Pipeline stepper */
    .smm-pipe { position: relative; display: flex; margin: 8px 0 93px; padding-top: 4px; }
    .smm-pipe-track { position: absolute; top: 10px; left: 7px; right: 7px; height: 2px; background: rgba(28,29,34,0.12); }
    .smm-pipe-fill { position: absolute; left: 0; top: 0; height: 100%; background: var(--english-violet); transition: width .25s; }
    .smm-pipe-step { position: absolute; top: 4px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; }
    .smm-pipe-step--first { transform: translateX(0); align-items: flex-start; }
    .smm-pipe-step--last { transform: translateX(-100%); align-items: flex-end; }
    .smm-pipe-dot { width: 14px; height: 14px; border-radius: 50%; background: #fff; border: 2px solid rgba(28,29,34,0.25); position: relative; z-index: 1; transition: background .18s, border-color .18s, box-shadow .18s; }
    .smm-pipe-step.is-done .smm-pipe-dot { background: var(--english-violet); border-color: var(--english-violet); }
    .smm-pipe-step.is-current .smm-pipe-dot { box-shadow: 0 0 0 4px rgba(var(--violet-rgb),0.18); }
    .smm-pipe-label { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.5); white-space: nowrap; }
    .smm-pipe-step.is-done .smm-pipe-label, .smm-pipe-step.is-current .smm-pipe-label { color: var(--ink); font-weight: 600; }
    .smm-pipe-step:hover .smm-pipe-label { color: var(--english-violet); }

    /* File layout */
    .smm-file-grid { display: grid; grid-template-columns: 320px 1fr; gap: 34px; }
    @media (max-width: 860px) { .smm-file-grid { grid-template-columns: 1fr; } }
    .smm-sec { border-top: 1px solid rgba(28,29,34,0.09); padding: 18px 0; }
    .smm-sec:first-child { border-top: 0; padding-top: 0; }
    .smm-sec-h { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin: 0 0 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }

    /* Contact details card */
    .smm-cd-card { border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 6px 16px; }
    .smm-cd-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.07); }
    .smm-cd-row:last-child { border-bottom: 0; }
    .smm-cd-ico { width: 34px; height: 34px; flex: none; border-radius: 9px; background: rgba(var(--violet-rgb),0.09); color: var(--english-violet); display: inline-flex; align-items: center; justify-content: center; }
    .smm-cd-ico svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; }
    .smm-cd-main { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 1px; }
    .smm-cd-k { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.42); }
    .smm-cd-v { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    a.smm-cd-v:hover { color: var(--english-violet); }
    .smm-cd-input { width: 100%; border: 0; border-bottom: 1px solid transparent; background: none; font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); padding: 1px 0; }
    .smm-cd-input:hover { border-bottom-color: rgba(28,29,34,0.15); }
    .smm-cd-input:focus { outline: none; border-bottom-color: var(--english-violet); }
    .smm-cd-input::placeholder { color: rgba(28,29,34,0.3); font-weight: 500; }
    /* CRM link row under the contact details. */
    .smm-crm-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 10px 0 0; }
    .smm-crm-note { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); }
    .smm-btn--ghost { background: transparent; border: 1px solid rgba(var(--violet-rgb),0.3); color: var(--english-violet); text-decoration: none; }
    .smm-btn--ghost:hover { background: rgba(var(--violet-rgb),0.07); }
    .smm-cd-status { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); margin: 8px 0 0; min-height: 14px; }
    .smm-copy { background: none; border: 0; padding: 6px; border-radius: 7px; color: rgba(28,29,34,0.38); cursor: pointer; display: inline-flex; flex: none; transition: background .15s, color .15s; }
    .smm-copy:hover { background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-copy svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; }
    .smm-copy.is-done { color: #2c7a4b; }

    /* See more */
    .smm-more-toggle { margin-top: 14px; background: none; border: 0; padding: 6px 0; font-family: var(--sans); font-size: 12.5px; font-weight: 600; color: var(--english-violet); cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .smm-more-toggle svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.2; transition: transform .18s; }
    .smm-more-toggle.is-open svg { transform: rotate(180deg); }
    .smm-more { margin-top: 4px; }
    .smm-more[hidden] { display: none; }
    .smm-field { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px dashed rgba(28,29,34,0.09); font-family: var(--sans); font-size: 13.5px; color: var(--ink); }
    .smm-field:last-child { border-bottom: 0; }
    .smm-field-k { color: rgba(28,29,34,0.5); flex: 0 0 auto; font-size: 12.5px; }
    .smm-field-v { text-align: right; min-width: 0; }

    /* Actions */
    .smm-file-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .smm-btn { display: inline-flex; align-items: center; gap: 7px; padding: 9px 15px; border-radius: 8px; font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.02em; cursor: pointer; border: 1px solid rgba(var(--violet-rgb),0.3); background: #fff; color: var(--english-violet); text-decoration: none; transition: background .15s, border-color .15s, color .15s; }
    .smm-btn:hover { background: rgba(var(--violet-rgb),0.06); }
    .smm-btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }
    .smm-btn--primary { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .smm-btn--primary:hover { background: var(--ink); color: #fff; }
    .smm-btn--block { width: 100%; justify-content: center; }
    .smm-btn--danger { border-color: #a05a3c; color: #a05a3c; }
    .smm-btn--danger:hover { background: #a05a3c; color: #fff; }
    .smm-btn--del { border-color: rgba(28,29,34,0.2); color: rgba(28,29,34,0.55); }
    .smm-btn--del:hover { background: #a05a3c; border-color: #a05a3c; color: #fff; }
    .smm-btn--sm { padding: 6px 12px; font-size: 12px; }
    .smm-status-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .smm-hint { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); margin: 8px 0 0; }
    .smm-eng { display: grid; grid-template-columns: 1fr 1fr; gap: 11px 12px; }
    .smm-eng-row { display: flex; flex-direction: column; gap: 4px; }
    .smm-eng-row--full { grid-column: 1 / -1; }
    .smm-eng-row > span { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .smm-eng-row input, .smm-eng-row textarea, .smm-eng-row select { width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; font-family: var(--sans); font-size: 13px; color: var(--ink); background: #fff; resize: vertical; }
    .smm-eng-row input:focus, .smm-eng-row textarea:focus, .smm-eng-row select:focus { outline: none; border-color: var(--english-violet); }
    .smm-eng-status { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); margin: 8px 0 0; min-height: 14px; }
    .smm-platforms { margin-top: 12px; }
    .smm-plat-label { display: block; font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-bottom: 8px; }
    .smm-plat-grid { display: flex; flex-wrap: wrap; gap: 6px 14px; }
    .smm-plat { display: inline-flex; align-items: center; gap: 6px; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.68); cursor: pointer; }
    /* Invoices */
    .smm-inv { border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 12px 13px; margin-bottom: 9px; }
    .smm-inv-top { display: flex; align-items: center; gap: 10px; }
    .smm-inv-status { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; flex: none; }
    .smm-inv-status.is-paid { background: rgba(47,158,94,0.14); color: #2c7a4b; }
    .smm-inv-status.is-due { background: rgba(227,160,8,0.16); color: #9a6a04; }
    .smm-inv-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(28,29,34,0.07); }
    .smm-inv-paid { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); display: inline-flex; align-items: center; gap: 7px; }
    .smm-inv-paid input { padding: 5px 8px; border: 1px solid rgba(28,29,34,0.16); border-radius: 7px; font-family: var(--sans); font-size: 12px; color: var(--ink); }
    /* Invoicing builder (per-client) */
    .siv-build { border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 16px; margin-bottom: 18px; background: rgba(28,29,34,0.015); }
    .siv-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .siv-f { display: block; margin-bottom: 12px; }
    .siv-f > span { display: block; font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-bottom: 6px; }
    .siv-f input, .siv-f textarea { width: 100%; padding: 9px 11px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 13.5px; color: var(--ink); background: #fff; }
    .siv-f input:focus, .siv-f textarea:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .siv-item { display: grid; grid-template-columns: 1fr 120px 32px; gap: 8px; margin-bottom: 8px; }
    .siv-item input { padding: 8px 10px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 13px; color: var(--ink); background: #fff; }
    .siv-del { cursor: pointer; border: 1px solid rgba(28,29,34,0.14); background: #fff; border-radius: 8px; font-size: 17px; line-height: 1; color: rgba(28,29,34,0.5); }
    .siv-del:hover { background: rgba(200,70,50,0.08); border-color: rgba(200,70,50,0.4); color: #a3372b; }
    .siv-totals { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(28,29,34,0.1); font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); }
    .siv-totals strong { font-size: 15px; color: var(--ink); }
    .siv-tpl { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .siv-tpl-lbl { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .siv-tpl-opts { display: inline-flex; gap: 4px; padding: 3px; background: rgba(28,29,34,0.05); border-radius: 8px; }
    .siv-tpl-opt { appearance: none; cursor: pointer; background: none; border: 0; border-radius: 6px; padding: 6px 14px; font-family: var(--sans); font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.55); transition: background .15s, color .15s; }
    .siv-tpl-opt.is-active { background: var(--english-violet); color: #fff; }
    .cim-pay { font-family: var(--sans); font-size: 12px; line-height: 1.5; color: rgba(28,29,34,0.55); margin: 0 0 12px; padding: 9px 12px; border-radius: 7px; background: rgba(28,29,34,0.05); }
    .cim-pay.is-on { color: var(--english-violet); background: rgba(var(--violet-rgb), 0.09); font-weight: 700; }
    .siv-pay-hint { font-family: var(--sans); font-size: 11px; line-height: 1.45; color: rgba(28,29,34,0.5); }
    .pay-toggle { display: inline-flex; gap: 4px; padding: 3px; background: rgba(28,29,34,0.05); border-radius: 9px; }
    .pay-opt { appearance: none; cursor: pointer; background: none; border: 0; border-radius: 7px; padding: 8px 22px; font-family: var(--sans); font-size: 13.5px; font-weight: 700; color: rgba(28,29,34,0.55); transition: background .15s, color .15s; }
    .pay-opt.is-active { background: var(--english-violet); color: #fff; }
    .siv-dd-banner { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; margin-bottom: 16px; background: rgba(55,30,40,0.06); border: 1px solid rgba(55,30,40,0.15); border-radius: 10px; font-family: var(--sans); font-size: 13px; line-height: 1.5; color: var(--ink); }
    .siv-dd-banner strong { color: var(--english-violet); }
    .siv-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
    .siv-list-head { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin: 6px 0 10px; }
    .siv-row { display: grid; grid-template-columns: 90px 1fr auto auto auto; gap: 12px; align-items: center; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.1); border-radius: 9px; margin-bottom: 8px; font-family: var(--sans); font-size: 13px; }
    .siv-row .siv-num { font-weight: 700; color: var(--ink); }
    .siv-row .siv-due { color: rgba(28,29,34,0.5); font-size: 12px; }
    .siv-row .siv-amt2 { font-weight: 700; text-align: right; }
    .siv-row .smm-inv-status { text-transform: uppercase; }

    /* Insights panel (per-client SocialPilot reports) */
    .ri-months { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .ri-month { padding: 5px 13px; border-radius: 999px; border: 1px solid rgba(28,29,34,0.16); background: #fff; font-family: var(--sans); font-size: 11.5px; font-weight: 600; color: rgba(28,29,34,0.6); cursor: pointer; }
    .ri-month.is-active { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    /* Runs the full width of the panel, margin to margin, the tabs sharing it. */
    .ri-subtabs { display: flex; gap: 2px; padding: 3px; background: rgba(28,29,34,0.05); border-radius: 9px; margin-bottom: 14px; flex-wrap: wrap; }
    .ri-subtab { flex: 1 1 auto; text-align: center; white-space: nowrap; padding: 6px 14px; border: 0; background: none; border-radius: 6px; font-family: var(--sans); font-size: 12.5px; font-weight: 600; color: rgba(28,29,34,0.55); cursor: pointer; }
    .ri-subtab:hover { color: var(--ink); }
    .ri-subtab.is-active { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(28,29,34,0.12); }
    .smm-ri-json { font-family: ui-monospace, "SF Mono", Menlo, monospace !important; font-size: 12px !important; line-height: 1.5; resize: vertical; }
    /* report render primitives (from report-insights.js) */
    .ri-kpi { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 12px 13px; }
    .ri-kpi-label { font-size: 10px; color: #8a8796; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 6px; }
    .ri-kpi-val { font-size: 21px; font-weight: 600; line-height: 1; color: var(--ink); }
    .ri-kpi-sub { font-size: 10px; margin-top: 4px; }
    .ri-panel { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 15px 17px; margin-bottom: 14px; }
    .ri-sec { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #8a8796; margin: 20px 0 9px; }
    /* Layout pieces for the report tabs (report-insights.js) */
    .ri-grid { display: grid; grid-template-columns: repeat(var(--ri-cols, 3), minmax(0, 1fr)); gap: 10px; margin-bottom: 14px; }
    @media (max-width: 760px) { .ri-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    .ri-grid > .ri-panel { margin: 0; }
    .ri-note { font-family: var(--sans); font-size: 12px; line-height: 1.5; color: #8a8796; margin: -2px 0 10px; max-width: 80ch; }
    .ri-note b { color: var(--ink); }
    .ri-card-h, .ri-split-h { font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--ink); margin-bottom: 12px; }
    .ri-row { display: flex; justify-content: space-between; gap: 10px; padding: 6px 0; border-bottom: 0.5px solid #e5e1e2; font-family: var(--sans); font-size: 12.5px; color: #8a8796; }
    .ri-row:last-child { border-bottom: 0; }
    .ri-row b { color: var(--ink); font-weight: 600; font-variant-numeric: tabular-nums; }
    .ri-split-bar { height: 8px; border-radius: 4px; background: #d8d2d5; overflow: hidden; margin-bottom: 10px; }
    .ri-split-bar span { display: block; height: 100%; background: var(--english-violet); }
    .ri-split-legend { display: flex; justify-content: space-between; gap: 10px; font-family: var(--sans); font-size: 12px; color: #8a8796; }
    .ri-split-legend b { font-size: 16px; color: var(--ink); display: block; font-variant-numeric: tabular-nums; }
    .ri-split-legend em { font-style: normal; font-weight: 700; color: var(--ink); }
    .ri-split-legend > div:last-child { text-align: right; }
    .ri-split-note { font-family: var(--sans); font-size: 11px; line-height: 1.45; color: #8a8796; margin-top: 10px; }
    .ri-more { margin-top: 6px; }
    .ri-more > summary { cursor: pointer; font-family: var(--sans); font-size: 11.5px; font-weight: 700; letter-spacing: 0.04em; color: var(--english-violet); padding: 8px 0 4px; list-style: none; }
    .ri-more > summary::-webkit-details-marker { display: none; }
    .ri-more > summary::before { content: "+ "; }
    .ri-more[open] > summary::before { content: "− "; }
    .ri-more > .ri-panel { margin-top: 8px; }
    .ri-tblwrap { overflow-x: auto; }
    .ri-tbl { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: 12.5px; }
    .ri-tbl th { text-align: left; font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: #8a8796; padding: 0 8px 8px; border-bottom: 0.5px solid #e5e1e2; white-space: nowrap; }
    .ri-tbl td { padding: 8px; border-bottom: 0.5px solid #e5e1e2; color: var(--ink); vertical-align: middle; }
    .ri-tbl tr:last-child td { border-bottom: 0; }
    .ri-tbl .ri-n { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ri-rank { width: 18px; color: #8a8796; font-weight: 700; }
    .ri-thumbcell { width: 44px; }
    .ri-thumb { display: block; width: 44px; height: 44px; object-fit: cover; border-radius: 4px; background: #f4f2f1; }
    .ri-ttl a { display: inline-flex; align-items: baseline; gap: 6px; max-width: 100%; color: var(--ink); font-weight: 600; text-decoration: none; }
    .ri-ttl-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .ri-ttl-go { flex: none; color: #8a8796; font-weight: 400; }
    .ri-ttl a:hover .ri-ttl-t { color: var(--english-violet); text-decoration: underline; text-underline-offset: 3px; }
    .ri-ttl a:hover .ri-ttl-go { color: var(--english-violet); }
    .ri-ttl-d { display: block; font-size: 11px; color: #8a8796; margin-top: 3px; }
    /* Top content: fixed columns, the four figures an equal width and centred. */
    .ri-tbl--fixed { table-layout: fixed; min-width: 640px; }
    .ri-tbl--fixed col.ri-eq { width: 13%; }
    .ri-tbl .ri-c { text-align: center; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .ri-more > .ri-tbl { margin-top: 0; }
    /* Day-by-day chart picker */
    .ri-pills { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 10px; }
    .ri-pill { padding: 7px 14px; border-radius: 8px; border: 1px solid rgba(28,29,34,0.16); background: #fff; font-family: var(--sans); font-size: 12px; font-weight: 600; color: rgba(28,29,34,0.6); cursor: pointer; }
    .ri-pill:hover { border-color: var(--english-violet); color: var(--ink); }
    .ri-pill.is-active { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    [data-ri-pane][hidden] { display: none; }
    /* Top five hashtags, posts and reels together */
    .ri-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }
    .ri-tag { display: inline-flex; align-items: baseline; gap: 7px; padding: 7px 12px; border-radius: 8px; background: #fff; border: 1px solid rgba(28,29,34,0.12); font-family: var(--sans); font-size: 12.5px; font-weight: 600; color: var(--ink); }
    .ri-tag b { color: #8a8796; font-size: 11px; }
    .ri-tag em { font-style: normal; font-weight: 400; font-size: 11px; color: #8a8796; }
    /* Client commentary: read as finished, edited in a pop-out */
    .ri-cm-card { margin-bottom: 14px; }
    .ri-cm-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
    .ri-cm-edit { flex: none; width: 32px; height: 32px; display: grid; place-items: center; border: 1px solid rgba(28,29,34,0.12); border-radius: 8px; background: #fff; color: rgba(28,29,34,0.55); cursor: pointer; }
    .ri-cm-edit svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .ri-cm-edit:hover { border-color: var(--english-violet); color: var(--english-violet); }
    .ri-cm-prose { font-family: var(--sans); font-size: 14px; line-height: 1.65; color: var(--ink); white-space: pre-line; max-width: 72ch; }
    .ri-cm-empty { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.45); margin: 0; }
    .ri-cm-list { list-style: none; margin: 0; padding: 0; }
    .ri-cm-list li { display: flex; gap: 12px; align-items: baseline; padding: 9px 0; border-bottom: 0.5px solid #e5e1e2; font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: var(--ink); }
    .ri-cm-list li:last-child { border-bottom: 0; }
    .ri-cm-mark { flex: none; width: 64px; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; }
    .ri-cm-mark.is-go { color: #2c7a4b; } .ri-cm-mark.is-caution { color: #9a6a04; } .ri-cm-mark.is-action { color: #a05a3c; }
    .ri-cm-coming { margin: 0; padding-left: 20px; font-family: var(--sans); font-size: 13.5px; line-height: 1.8; color: var(--ink); }
    .ri-head-acts { display: flex; gap: 8px; flex-wrap: wrap; }
    .ri-month.is-live::before { content: ""; display: inline-block; width: 6px; height: 6px; border-radius: 50%; background: #2c7a4b; margin-right: 6px; vertical-align: 1px; }
    .smm-modal.ri-pub-modal { width: min(640px, calc(100vw - 48px)); }
    .ri-pub-list { display: grid; gap: 6px; margin: 4px 0 6px; max-height: 50vh; overflow-y: auto; overflow-x: hidden; }
    .ri-pub-row { display: grid; grid-template-columns: 20px minmax(110px, 1fr) auto minmax(0, 1.3fr); gap: 12px; align-items: center; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.12); border-radius: 8px; font-family: var(--sans); font-size: 13px; cursor: pointer; }
    /* A live row: dot, month, since when, and its buttons at their own width. */
    .ri-pub-row.is-live { grid-template-columns: 20px minmax(110px, 1fr) auto auto; }
    .ri-pub-row .smm-btn { white-space: nowrap; }
    .ri-pub-row:hover { border-color: var(--english-violet); }
    .ri-pub-row.is-live { cursor: default; background: #f6faf7; border-color: #d3e6d9; }
    .ri-pub-row.is-live:hover { border-color: #d3e6d9; }
    .ri-pub-live { width: 8px; height: 8px; border-radius: 50%; background: #2c7a4b; justify-self: center; }
    .ri-pub-down { justify-self: end; }
    .ri-pub-acts { display: flex; gap: 6px; justify-self: end; }
    .ri-pub-m { font-weight: 700; color: var(--ink); }
    .ri-pub-m small { display: block; font-weight: 400; font-size: 11px; color: rgba(28,29,34,0.5); }
    .ri-pub-s { font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.5); }
    .ri-pub-s.is-live { color: #2c7a4b; }
    .ri-pub-c { font-size: 12px; color: rgba(28,29,34,0.55); }
    .ri-pub-c.is-warn { color: #9a6a04; }
    .ri-pub-email { display: flex; gap: 9px; align-items: flex-start; margin: 12px 0 0; font-family: var(--sans); font-size: 13px; color: var(--ink); cursor: pointer; }
    .ri-pub-email input { margin-top: 2px; }
    .ri-month.is-pending::before { background: #c58a0a; }
    .ri-pub-s.is-pending { color: #9a6a04; }
    .ri-pending { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin: 0 0 12px; padding: 10px 14px; border-radius: 8px; background: #fbf4e4; border: 1px solid #ecd9a8; font-family: var(--sans); font-size: 13px; color: #6b4d05; }
    .ri-pending b { color: #5a3f00; }
    .smm-modal.ri-rep-modal { width: min(560px, calc(100vw - 48px)); }
    .ri-rep-opt { display: block; width: 100%; text-align: left; margin: 0 0 10px; padding: 14px 16px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; background: #fff; cursor: pointer; font-family: var(--sans); }
    .ri-rep-opt:hover { border-color: var(--english-violet); background: rgba(var(--violet-rgb),0.03); }
    .ri-rep-opt b { display: block; font-size: 14px; color: var(--ink); margin-bottom: 4px; }
    .ri-rep-opt span { display: block; font-size: 12.5px; line-height: 1.5; color: rgba(28,29,34,0.6); }
    .ri-rep-opt:disabled { opacity: 0.6; cursor: default; }
    .ri-cm-ins { display: grid; gap: 10px; }
    .ri-cm-in { padding: 12px 14px; border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; font-family: var(--sans); }
    .ri-cm-in-k { display: block; font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet); margin-bottom: 4px; }
    .ri-cm-in b { display: block; font-size: 14px; color: var(--ink); margin-bottom: 4px; }
    .ri-cm-in p { margin: 0; font-size: 13px; line-height: 1.55; color: rgba(28,29,34,0.75); }
    .ri-cm-in .ri-cm-in-next { margin-top: 6px; color: var(--english-violet); font-weight: 600; }
    .ri-cm-insrow { display: grid; gap: 6px; padding: 12px; margin-bottom: 10px; border: 1px solid rgba(28,29,34,0.12); border-radius: 8px; }
    .ri-cm-insrow-top { display: grid; grid-template-columns: 170px 1fr 130px 30px; gap: 8px; }
    .ri-cm-headpick { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 8px; }
    .ri-cm-headpick select { width: 100%; padding: 8px 10px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 13px; background: #fff; }
    .ri-cm-heads { margin: 0 0 10px; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; color: var(--english-violet); }
    .ri-cm-insrow textarea, .ri-cm-insrow input, .ri-cm-insrow select { width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 13px; line-height: 1.5; color: var(--ink); background: #fff; resize: vertical; }
    .ri-cm-top { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; }
    .ri-cm-list--client li { display: block; }
    .smm-modal.ri-cm-modal { width: min(880px, calc(100vw - 48px)); max-height: calc(100vh - 48px); overflow-y: auto; box-sizing: border-box; }
    .smm-modal.ri-cm-modal #ri-cm-summary { min-height: 220px; font-size: 14.5px; line-height: 1.6; }
    .ri-cm-stack { display: grid; gap: 6px; }
    .ri-cm-t { display: block; font-weight: 700; margin-bottom: 2px; }
    .ri-cm-row { display: grid; grid-template-columns: 120px 1fr 30px; gap: 10px; align-items: start; margin-bottom: 12px; }
    .ri-cm-row--plain { grid-template-columns: 1fr 30px; }
    .ri-cm-row textarea, .ri-cm-row input { width: 100%; box-sizing: border-box; padding: 9px 11px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 13.5px; line-height: 1.5; color: var(--ink); background: #fff; resize: vertical; }
    .ri-cm-row select { height: 40px; padding: 0 8px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 12.5px; color: var(--ink); background: #fff; }
    .ri-cm-row textarea:focus, .ri-cm-row input:focus, .ri-cm-row select:focus { outline: none; border-color: var(--english-violet); }
    .ri-cm-x { width: 30px; height: 40px; border: 0; background: none; font-size: 20px; line-height: 1; color: rgba(28,29,34,0.35); cursor: pointer; border-radius: 8px; }
    .ri-cm-x:hover { color: #a05a3c; background: rgba(160,90,60,0.08); }
    /* Best days / posting windows: a touch smaller than a figure, centred top to bottom. */
    /* Label at the top like every other card; the value centred in the
       space below it, so a short "7am–9am" sits level with a two-line
       "Best days". */
    .ri-kpi--window { display: flex; flex-direction: column; }
    .ri-kpi--window .ri-kpi-val { flex: 1; display: flex; align-items: center; font-size: 16px; line-height: 1.3; }
    .ri-type { display: inline-block; font-size: 10px; font-weight: 700; letter-spacing: 0.04em; padding: 3px 8px; border-radius: 999px; }
    .ri-type--reel { background: #efedf0; color: #371e28; }
    .ri-type--post { background: #eef1f4; color: #3f5a75; }
    .ri-chart { display: block; width: 100%; height: auto; }
    .ri-legend { display: flex; flex-wrap: wrap; gap: 6px 14px; margin-top: 8px; font-family: var(--sans); font-size: 11px; color: #8a8796; }
    .ri-legend i { display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 5px; vertical-align: -1px; }
    .ri-age { display: grid; grid-auto-flow: column; grid-auto-columns: 1fr; gap: 14px; height: 150px; }
    .ri-age-col { display: flex; flex-direction: column; min-width: 0; }
    .ri-age-bars { flex: 1; display: flex; align-items: flex-end; gap: 3px; border-bottom: 1px solid #e5e1e2; }
    .ri-age-bars span { flex: 1; border-radius: 2px 2px 0 0; min-height: 1px; }
    .ri-age-l { font-family: var(--sans); font-size: 11px; color: #8a8796; text-align: center; margin-top: 6px; }
    .ri-hm { display: grid; grid-template-columns: 36px repeat(var(--ri-slots), 1fr); gap: 3px; margin-bottom: 12px; }
    .ri-hm-l { font-family: var(--sans); font-size: 10px; color: #8a8796; text-align: center; align-self: center; }
    .ri-hm-c { height: 20px; border-radius: 3px; }
    /* Ask AI chat */
    .ri-ai-chat { min-height: 180px; max-height: 44vh; overflow-y: auto; padding: 2px; margin-bottom: 12px; }
    .ri-ai-msg { max-width: 86%; padding: 10px 14px; border-radius: 12px; font-family: var(--sans); font-size: 13.5px; line-height: 1.55; margin-bottom: 10px; }
    .ri-ai-user { margin-left: auto; background: var(--english-violet); color: #fff; border-bottom-right-radius: 3px; }
    .ri-ai-bot { margin-right: auto; background: #fff; border: 1px solid rgba(28,29,34,0.1); color: var(--ink); border-bottom-left-radius: 3px; white-space: pre-wrap; }
    .ri-ai-bot.is-loading { color: rgba(28,29,34,0.45); font-style: italic; }
