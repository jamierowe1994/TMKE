    // ---------- Insights (per-client SocialPilot reports) ----------
    let riReportId = null, riTab = "overview";
    async function loadInsights(r) {
      const panel = $("smm-panel-insights"); if (!panel) return;
      if (!r._reports) {
        if (isDemo(r)) { r._reports = []; }
        else if (WORKER) {
          panel.innerHTML = '<p class="smm-soon">Loading reports…</p>';
          try { const token = await authToken(); const res = await fetch(`${WORKER}/smm/reports?lead_id=${encodeURIComponent(r.id)}`, { headers: { Authorization: "Bearer " + token } }); if (res.ok) { const j = await res.json(); r._reports = (j.reports || []).map((x) => ({ id: x.id, platform: x.platform, month: x.month, year: x.year, data: x.data || {} })); } else r._reports = []; } catch (_) { r._reports = []; }
        } else r._reports = [];
      }
      renderInsights(r);
    }
    const riSorted = (r) => (r._reports || []).slice().sort((a, b) => (a.year !== b.year ? a.year - b.year : a.month - b.month));
    function renderInsights(r) {
      const panel = $("smm-panel-insights"); if (!panel) return;
      const reps = riSorted(r);
      const head = `<div class="smm-panel-head"><h4>Insights</h4><button type="button" class="smm-btn smm-btn--sm" id="smm-ri-upload">${PLUS_SVG}Upload report</button></div>`;
      if (!reps.length) { panel.innerHTML = head + '<p class="smm-doc-empty">No reports yet — upload this client\'s SocialPilot month to build their dashboard.</p>'; $("smm-ri-upload")?.addEventListener("click", () => openReportUpload(r)); return; }
      if (!riReportId || !reps.find((x) => x.id === riReportId)) riReportId = reps[reps.length - 1].id;
      const cur = reps.find((x) => x.id === riReportId) || reps[reps.length - 1];
      const isAi = riTab === "ai";
      const strip = isAi ? "" : `<div class="ri-months">${reps.map((x) => `<button type="button" class="ri-month ${x.id === riReportId ? "is-active" : ""}" data-rmonth="${esc(x.id)}">${esc(RI_MONTHS[x.month])} ${x.year}</button>`).join("")}</div>`;
      const TABS = [["overview", "Overview"], ["content", "Content"], ["audience", "Audience"], ["actions", "Actions"], ["trends", "Trends"], ["ai", "Ask AI ✦"]];
      const subtabs = `<div class="ri-subtabs">${TABS.map(([k, l]) => `<button type="button" class="ri-subtab ${riTab === k ? "is-active" : ""}" data-rtab="${k}">${l}</button>`).join("")}</div>`;
      const bodyHtml = isAi ? renderAiChat(r) : (riTab === "trends" ? renderTrends(reps) : renderTab(riTab, cur.data || {}, cur));
      panel.innerHTML = head + strip + subtabs + `<div class="ri-body">${bodyHtml}</div>`;
      $("smm-ri-upload")?.addEventListener("click", () => openReportUpload(r));
      panel.querySelectorAll("[data-rmonth]").forEach((b) => b.addEventListener("click", () => { riReportId = b.getAttribute("data-rmonth"); renderInsights(r); }));
      panel.querySelectorAll("[data-rtab]").forEach((b) => b.addEventListener("click", () => { riTab = b.getAttribute("data-rtab"); renderInsights(r); }));
      if (isAi) wireAiChat(r);
    }
    function renderAiChat(r) {
      const msgs = r._aiMessages || [];
      const chat = msgs.length ? msgs.map((m) => m.role === "user"
        ? `<div class="ri-ai-msg ri-ai-user">${esc(m.text)}</div>`
        : `<div class="ri-ai-msg ri-ai-bot${m.loading ? " is-loading" : ""}">${m.loading ? "Thinking…" : esc(m.text).replace(/\n/g, "<br>")}</div>`).join("")
        : `<div class="ri-ai-empty"><div class="ri-ai-empty-ic">✦</div><div class="ri-ai-empty-h">Ask anything about ${esc(nameOf(r))}'s performance</div><div class="ri-ai-suggest">When's best to post on a Wednesday?<br>Which hashtags reach furthest?<br>How has engagement trended?</div></div>`;
      return `<div class="ri-ai-chat" id="ri-ai-chat">${chat}</div>
        <div class="ri-ai-compose"><input type="text" id="ri-ai-input" placeholder="Ask about this account's performance…"><button type="button" class="smm-btn smm-btn--primary smm-btn--sm" id="ri-ai-send">Ask ✦</button></div>
        <p class="smm-hint">Admin only — Claude reads all of this account's months to answer.</p>`;
    }
    function wireAiChat(r) {
      const input = $("ri-ai-input");
      $("ri-ai-send")?.addEventListener("click", () => askAi(r));
      input?.addEventListener("keydown", (e) => { if (e.key === "Enter") askAi(r); });
