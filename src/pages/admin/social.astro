        if (!held) return box(r.meeting_at ? `Discovery call on ${esc(sfWhen(r.meeting_at))}` : lateH("Next: book the discovery call"), [li(!!r.meeting_at, r.meeting_at ? "Discovery call booked" : "Discovery call not booked"), li(0, "Call notes after the call"), li(0, "Proposal due 3 working days after the call"), fu].filter(Boolean),
          sfHb(false, 'data-sf="book-call"', r.meeting_at ? "Move the call" : "Book the discovery call") + sfHb(true, 'data-sf="callnotes" data-id="discovery"', "Call notes"), r.meeting_at ? "" : lateC);
        const due = sfAddWork(r.meeting_at, 3);
        return box(lateH("Discovery call held. Next: the proposal"), [li(1, `Discovery call held ${esc(sfDay(r.meeting_at))}`), li(!!F.discovery, F.discovery ? "Call notes written" : "Call notes not written yet"), li(0, `Proposal due by ${esc(sfDate(due).toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" }))}`), fu].filter(Boolean),
          sfHb(false, 'data-sf="callnotes" data-id="discovery"', "Call notes") + sfHb(false, 'data-sf="quote"', "Price it") + sfHb(true, 'data-sf="proposal"', F.prep ? "Send the proposal" : "Upload and send the proposal"), lateC);
      }
      if (st === "proposal_sent") {
