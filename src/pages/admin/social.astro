      const chat = $("ri-ai-chat"); if (chat) chat.scrollTop = chat.scrollHeight;
    }
    async function askAi(r) {
      const input = $("ri-ai-input"); const q = (input && input.value || "").trim(); if (!q) return;
      r._aiMessages = r._aiMessages || [];
      r._aiMessages.push({ role: "user", text: q });
      r._aiMessages.push({ role: "assistant", loading: true });
      renderInsights(r);
      let answer;
      if (isDemo(r) || !WORKER) { await new Promise((res) => setTimeout(res, 600)); answer = demoAiAnswer(r, q); }
      else {
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER}/smm/report/ask`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id, question: q }) });
          const j = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(j.error || "Couldn't get an answer");
          answer = j.answer || "(no answer)";
        } catch (e) { answer = "Sorry — " + (e.message || "couldn't answer that right now."); }
      }
      r._aiMessages[r._aiMessages.length - 1] = { role: "assistant", text: answer };
      renderInsights(r);
    }
    function demoAiAnswer(r, q) {
      const reps = riSorted(r), latest = reps[reps.length - 1], d = (latest && latest.data) || {}, p = d.profile || {};
      const ql = q.toLowerCase();
      let a = `[Demo — the live version has Claude read all ${reps.length} month(s) and answer directly.]\n\n`;
      if (/time|when|post|day/.test(ql)) a += `• Best days: ${d.bestDays || "Tue & Wed"}\n• Morning: ${d.morningWindow || "10am–12pm"}\n• Evening: ${d.eveningWindow || "6–7pm"}\n• ${d.timing || "Weekends see minimal engagement."}`;
      else if (/hashtag/.test(ql)) { const h = d.hashtags || []; a += h.length ? h.map((x) => `• ${x.name}: reach ${x.reach}, interactions ${x.interactions}`).join("\n") : "No hashtag data in the latest report."; }
      else if (/reach|engag|trend|grow|follow/.test(ql)) a += `• Latest reach: ${(p.reach && p.reach.toLocaleString()) || "—"} (${p.reachChange ? "↑ " + p.reachChange + "%" : "no change data"})\n• Engagement rate: ${p.interactionRate || "—"}%\n• Trend: ${reps.length > 1 ? "improving month-on-month — see the Trends tab" : "upload more months for a trend"}`;
      else a += `• Followers: ${(p.followers && p.followers.toLocaleString()) || "—"}\n• Reach: ${(p.reach && p.reach.toLocaleString()) || "—"}\n• Interactions: ${p.interactions || "—"}\n• Engagement rate: ${p.interactionRate || "—"}%`;
      return a;
    }
