          await draftCommentary(r, { id: j.report.id, data }, "both").catch(() => {});
        }
        r._reports = null; riReportId = null; closeModal(); await loadInsights(r);
      } catch (e) { status.hidden = false; status.textContent = e.message || "Couldn't save — try again."; btn.disabled = false; btn.textContent = "Save report"; }
    }

    // ---------- Manual add ----------
    function openAddLead() {
      $("smm-modal-host").innerHTML = `
        <div class="smm-modal-scrim" id="smm-modal">
