    }
    const PLATFORM_NAMES = { instagram: "Instagram", facebook: "Facebook", linkedin: "LinkedIn" };
    const platformList = (ps) => { const n = ps.map((x) => PLATFORM_NAMES[x] || x); return n.length > 1 ? n.slice(0, -1).join(", ") + " and " + n[n.length - 1] : (n[0] || ""); };

    async function saveReport(r) {
      const month = parseInt($("smm-rp-month").value, 10), year = parseInt($("smm-rp-year").value, 10);
      const status = $("smm-rp-status");
      let data;
      try { const parsed = JSON.parse($("smm-rp-json").value); data = parsed && parsed.data && typeof parsed.data === "object" ? parsed.data : parsed; }
      catch (_) { status.hidden = false; status.textContent = "That doesn't look like valid JSON — paste the report Claude produced."; return; }
      const btn = $("smm-rp-save"); btn.disabled = true; btn.textContent = "Saving…";
      // Into this month's report if there already is one.
      const existing = (r._reports || []).find((x) => x.month === month && x.year === year && (x.platform || "Instagram") === "Instagram");
      const added = platformsIn(data);
      const merging = !!(existing && existing.data && Object.keys(existing.data).length);
      data = merging ? mergeReportData(existing.data, data) : { ...data, platforms: added };
      const hadCommentary = merging && !!existing.data.client;
      if (isDemo(r)) {
        r._reports = (r._reports || []).filter((x) => !(x.month === month && x.year === year));
        r._reports.push({ id: "d" + Date.now(), platform: "Instagram", month, year, data });
        riReportId = null; closeModal(); activeTab = "insights"; renderInsights(r); return;
      }
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/smm/report`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id, platform: "Instagram", month, year, data, upload: true }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || "Save failed");
        // A first draft of the trends summary and the client commentary, so
        // the rewrite starts from something. A failure here loses nothing:
        // the Client commentary tab has a Draft button.
        // Adding a platform to a month we've already written up keeps our
        // commentary: redrafting would replace it. The Draft button is there
        // if it should take the new platform in.
        // A platform new to the month: ask whether the commentary should be
        // redrafted to cover it (it replaces the current one, edits and all).
        const before = (existing && existing.data && (existing.data.platforms || platformsIn(existing.data))) || [];
        const fresh = added.filter((x) => !before.includes(x));
        if (hadCommentary && fresh.length && j.report && j.report.id
            && confirm(`${platformList(fresh)} is now in ${RI_MONTHS[month]}'s report.\n\nRedraft the client commentary and the team summary so they cover ${platformList(fresh)} too? This replaces what's written now, including your edits.\n\nCancel keeps your commentary as it is.`)) {
          btn.textContent = "Redrafting…";
          status.hidden = false; status.textContent = `Saved. Redrafting the commentary to cover ${platformList(fresh)} — a few seconds.`;
          await draftCommentary(r, { id: j.report.id, data }, "both").catch(() => {});
        } else if (hadCommentary) {
          status.hidden = false;
          status.textContent = `Added ${platformList(added)} to ${RI_MONTHS[month]}'s report. Your commentary is unchanged - redraft it from Client commentary if it should cover ${platformList(added)} too.`;
          await new Promise((res2) => setTimeout(res2, 2200));
        } else if (j.report && j.report.id) {
          btn.textContent = "Drafting the commentary…";
          status.hidden = false; status.textContent = "Saved. Writing a first draft of the client commentary — a few seconds.";
          await draftCommentary(r, { id: j.report.id, data }, "both").catch(() => {});
        }
        r._reports = null; riReportId = null; closeModal(); await loadInsights(r);
      } catch (e) { status.hidden = false; status.textContent = e.message || "Couldn't save — try again."; btn.disabled = false; btn.textContent = "Save report"; }
    }

    // ---------- Manual add ----------
    function openAddLead() {
      $("smm-modal-host").innerHTML = `
        <div class="smm-modal-scrim" id="smm-modal">
          <div class="smm-modal" role="dialog" aria-modal="true" aria-label="Add a person">
            <h3>Add a person</h3>
