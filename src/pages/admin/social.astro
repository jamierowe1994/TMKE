    .sf-c { flex: 0 0 calc((100% - 36px) / 4); min-width: 230px; height: 216px; box-sizing: border-box; scroll-snap-align: start; display: flex; flex-direction: column; gap: 8px; padding: 12px 14px; border: 1px solid var(--sf-edge); border-radius: 4px; background: #fff; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
