    async function parseReportPdf(file, r) {
      if (!file) return;
      const hint = $("smm-rp-pdfhint"), status = $("smm-rp-status"), save = $("smm-rp-save");
      status.hidden = true;
      if (!WORKER) { hint.textContent = "PDF reading runs on the deployed Worker — for now, paste the JSON below."; return; }
      hint.textContent = "Reading the PDF with Claude…"; save.disabled = true;
      try {
        const b64 = await new Promise((res, rej) => { const fr = new FileReader(); fr.onload = () => res(String(fr.result)); fr.onerror = rej; fr.readAsDataURL(file); });
        const token = await authToken();
        // The figures come from Claude; each post's link and thumbnail come
        // straight out of the PDF, at the same time. A failure there costs
        // the pictures, never the report.
        const linksP = extractPostLinks(file).catch((e) => { console.warn("post links", e); return []; });
        const resp = await fetch(`${WORKER}/smm/report/parse`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ pdf: b64 }) });
        const j = await resp.json().catch(() => ({}));
        if (!resp.ok || !j.data) throw new Error(j.error || "Couldn't read the PDF");
        const data = j.data;
        hint.textContent = "Adding each post's link and picture…";
        const links = await linksP;
        if (links.length) {
          if (!Array.isArray(data.content) || !data.content.length) data.content = links.map((l) => ({ title: l.title, type: l.type, date: l.date }));
          let pics = 0;
          for (const { row, link } of matchLinks(data.content, links)) {
            if (!link) continue;
            row.url = link.url;
            if (!row.date && link.date) row.date = link.date;
            if (link.thumb && !isDemo(r)) {
              const code = (link.url.match(/\/(?:p|reel|tv)\/([^/?#]+)/) || [])[1] || Math.random().toString(36).slice(2, 9);
              const path = `smm-thumbs/${code}-${Date.now().toString(36)}.jpg`;
              const { error } = await supabase.storage.from("pack-images").upload(path, link.thumb, { cacheControl: "31536000", upsert: false, contentType: "image/jpeg" });
              if (!error) { row.thumb = supabase.storage.from("pack-images").getPublicUrl(path).data.publicUrl; pics++; }
            }
          }
          hint.textContent = `Read ✓ — ${links.length} post link${links.length === 1 ? "" : "s"} and ${pics} picture${pics === 1 ? "" : "s"} added. Check the figures below, then save.`;
        } else hint.textContent = "Read ✓ — check the figures below, then save.";
        $("smm-rp-json").value = JSON.stringify(data, null, 2);
      } catch (e) { hint.textContent = ""; status.hidden = false; status.textContent = e.message || "Couldn't read the PDF — try again or paste the JSON."; }
      finally { save.disabled = false; }
    }
