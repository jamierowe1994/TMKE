    // ---------- Boot ----------
    (async () => {
      let session;
      if (import.meta.env.DEV) session = (await supabase.auth.getSession()).data.session || { user: { email: "dev@tmke.co.uk", id: "dev" } };
      else { session = await requireAdmin(); if (!session) return; }

      let rows = [];
      try { const { data } = await supabase.from("smm_leads").select("*").order("created_at", { ascending: false }); rows = data || []; } catch (_) {}
      if (!rows.length && import.meta.env.DEV) rows = demoRows();
      all = rows;

      $("smm-loading").hidden = true;
      $("smm-board").hidden = false;
      renderBoard();

      $("smm-filters").addEventListener("click", (e) => {
        const btn = e.target.closest(".smm-chip"); if (!btn) return;
        document.querySelectorAll(".smm-chip").forEach((c) => c.classList.remove("is-active"));
        btn.classList.add("is-active");
        kindFilter = btn.getAttribute("data-filter") || "all";
        renderBoard();
      });
      $("smm-search").addEventListener("input", (e) => { q = e.target.value.toLowerCase().trim(); renderBoard(); });
      $("smm-show-lost").addEventListener("change", (e) => { showLost = e.target.checked; renderBoard(); });
      $("smm-add-lead").addEventListener("click", openAddLead);
      // Keep the top scrollbar and the board in sync (either can be dragged).
      let riSyncLock = false;
      $("smm-scrolltop").addEventListener("scroll", () => { if (riSyncLock) return; riSyncLock = true; $("smm-board").scrollLeft = $("smm-scrolltop").scrollLeft; riSyncLock = false; });
      $("smm-board").addEventListener("scroll", () => { if (riSyncLock) return; riSyncLock = true; $("smm-scrolltop").scrollLeft = $("smm-board").scrollLeft; riSyncLock = false; });
      window.addEventListener("resize", syncTopScroll);
      $("smm-file-close").addEventListener("click", closeFile);
      $("smm-file").addEventListener("click", (e) => { if (e.target === $("smm-file")) closeFile(); });
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        if ($("smm-modal-host").children.length) { closeModal(); return; }
        if (!$("smm-file").hidden) closeFile();
      });
    })();
