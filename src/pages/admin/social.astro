---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
---

<AdminShell active="social" title="Social media" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Social media</div>
          <div class="page-header-sub">Every enquiry through to active, managed client.</div>
        </div>
      </div>
    </div>
  </div>
  <div class="ash-panel ash-page">
    <section class="smm-bar">
      <div class="smm-bar-top">
        <div class="smm-filters" id="smm-filters" role="tablist">
          <button type="button" class="smm-chip is-active" data-filter="all">All</button>
          <button type="button" class="smm-chip" data-filter="enquiry">Enquiries</button>
          <button type="button" class="smm-chip" data-filter="brochure">Brochures</button>
          <button type="button" class="smm-chip" data-filter="meeting_set">Discovery calls</button>
          <button type="button" class="smm-chip" data-filter="proposal_sent">Proposals</button>
          <button type="button" class="smm-chip" data-filter="contract_signed">Contracts</button>
          <button type="button" class="smm-chip" data-filter="onboarding">Onboarding clients</button>
          <button type="button" class="smm-chip" data-filter="active_client">Clients</button>
        </div>
        <div class="smm-bar-actions">
          <label class="smm-lost-toggle"><input type="checkbox" id="smm-show-lost" /> Show lost</label>
          <button type="button" class="smm-add-btn" id="smm-add-lead"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Add</button>
        </div>
      </div>
      <div class="smm-bar-bottom">
        <label class="smm-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="smm-search" placeholder="Search name, email, business…" aria-label="Search leads" />
        </label>
      </div>
    </section>

    <p class="smm-loading" id="smm-loading">Loading pipeline…</p>
    <div class="smm-scrolltop" id="smm-scrolltop" hidden><div id="smm-scrolltop-inner"></div></div>
    <div class="smm-board" id="smm-board" hidden></div>
  </div>

  <!-- Full-screen customer file -->
  <div class="smm-file-scrim" id="smm-file" hidden>
    <div class="smm-file-card" role="dialog" aria-modal="true" aria-label="Customer file">
      <button type="button" class="smm-file-x" id="smm-file-close" aria-label="Close">&times;</button>
      <div class="smm-file-body" id="smm-file-body"></div>
    </div>
  </div>

  <!-- Modal host (meeting booking / add file) -->
  <div id="smm-modal-host"></div>

  <style is:global>
    /* ---- Toolbar ---- */
    .smm-bar { display: flex; flex-direction: column; gap: 12px; max-width: 1360px; margin: 0 auto; padding: 34px 36px 20px; }
    .smm-bar-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
    .smm-bar-actions { display: flex; align-items: center; gap: 12px; flex: none; }
    .smm-filters { display: flex; gap: 6px; flex-wrap: wrap; flex: 1; min-width: 0; }
    .smm-chip { height: 34px; box-sizing: border-box; display: inline-flex; align-items: center; padding: 0 14px; background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 999px; font-family: var(--sans); font-size: 12px; font-weight: 600; color: rgba(28,29,34,0.7); cursor: pointer; transition: background .15s, border-color .15s, color .15s; }
    .smm-chip:hover { border-color: rgba(var(--violet-rgb),0.4); }
    .smm-chip.is-active { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    /* .ash-content.hub-skin prefix beats hub-tokens.css's ".hub-skin label{display:block}"
       (meant for real form-field captions) — this label is a clickable icon+input
       wrapper, not a caption, and needs to stay a flex row regardless of cascade order. */
    .ash-content.hub-skin .smm-search { height: 34px; box-sizing: border-box; display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 999px; padding: 0 14px; width: 340px; max-width: 100%; }
    .smm-search svg { width: 15px; height: 15px; color: rgba(28,29,34,0.42); flex: none; }
    .smm-search input { border: 0; outline: none; background: none; padding: 0; width: 100%; font-family: var(--sans); font-size: 13px; color: var(--ink); }
    .smm-lost-toggle { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); display: inline-flex; align-items: center; gap: 7px; cursor: pointer; white-space: nowrap; }
    .smm-loading { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); padding: 40px 36px; max-width: 1360px; margin: 0 auto; }

    /* ---- Pipeline board — comfortable columns, scroll along the bottom ---- */
    /* A synced scrollbar above the board so you don't have to scroll down a
       laptop screen to reach the native one. */
    .smm-scrolltop { max-width: 1360px; margin: 14px auto 6px; padding: 0 36px; overflow-x: auto; overflow-y: hidden; }
    .smm-scrolltop[hidden] { display: none; }
    #smm-scrolltop-inner { height: 1px; }
    /* Rows, not columns — one row per stage, cards run left-to-right within
       a row and that row scrolls on its own past ~3 cards. Same treatment
       as Videography's board. */
    .smm-board { display: flex; flex-direction: column; gap: 22px; max-width: 1360px; margin: 0 auto; padding: 6px 36px 60px; }
    /* One row per stage, a wine hairline between rows (skip before the first). */
    .smm-stage-row { min-width: 0; padding-top: 18px; border-top: 1px solid var(--accent-light, #c9bcb7); }
    .smm-stage-row:first-child { padding-top: 0; border-top: 0; }
    .smm-stage-cards {
      display: flex; gap: 12px; align-items: stretch; overflow-x: auto; padding: 2px 2px 10px;
      scrollbar-width: thin; scrollbar-color: rgba(28,29,34,0.28) transparent;
    }
    .smm-stage-cards::-webkit-scrollbar { height: 8px; -webkit-appearance: none; }
    .smm-stage-cards::-webkit-scrollbar-track { background: rgba(28,29,34,0.05); border-radius: 999px; }
    .smm-stage-cards::-webkit-scrollbar-thumb { background: rgba(28,29,34,0.28); border-radius: 999px; border: 2px solid transparent; background-clip: padding-box; }
    .smm-stage-cards::-webkit-scrollbar-thumb:hover { background: rgba(28,29,34,0.42); background-clip: padding-box; }
    .smm-stage-cards.drop-hover { background: rgba(var(--violet-rgb),0.07); box-shadow: inset 0 0 0 2px rgba(var(--violet-rgb),0.35); border-radius: 12px; }
    /* Three ~300px cards + two 12px gaps ≈ 924px — comfortable on a laptop;
       narrower viewports just see fewer per row before the scroll kicks in. */
    .smm-stage-cards .smm-card { flex: 0 0 300px; }
    /* Clients row: wraps onto a couple of lines instead of scrolling. */
    .smm-stage-cards.is-wrap { flex-wrap: wrap; overflow-x: visible; padding: 2px; }
    .smm-see-all {
      flex: 0 0 300px; appearance: none; cursor: pointer; text-align: center;
      background: none; border: 1.5px dashed rgba(28,29,34,0.18); border-radius: 10px;
      padding: 12px; font-family: var(--sans); font-size: 12.5px; font-weight: 700;
      color: var(--english-violet); transition: background 0.15s, border-color 0.15s;
    }
    .smm-see-all:hover { background: rgba(var(--violet-rgb), 0.06); border-color: var(--english-violet); }
    /* Filter active → a single-column line view instead of the board. */
    .smm-board.is-list { display: block; overflow-x: visible; }
    .smm-list { max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; }
    .smm-list-head { font-family: var(--sans); font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin: 2px 0 12px; }
    .smm-row { display: grid; grid-template-columns: 88px minmax(140px, 1.2fr) minmax(150px, 1.3fr) 118px auto; gap: 16px; align-items: center; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 12px 16px; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
    .smm-row:hover { border-color: rgba(var(--violet-rgb),0.45); box-shadow: 0 8px 20px -16px rgba(28,29,34,0.4); }
    .smm-row-main { min-width: 0; }
    .smm-row-name { font-family: var(--sans); font-size: 14.5px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smm-row-biz { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 1px; }
    .smm-row-email { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smm-row-stage { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.5); background: rgba(28,29,34,0.05); border-radius: 999px; padding: 4px 10px; text-align: center; white-space: nowrap; }
    .smm-row-acts { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    @media (max-width: 760px) { .smm-row { grid-template-columns: 1fr auto; } .smm-row-email, .smm-row-stage { display: none; } }
    .smm-col { background: transparent; min-width: 0; }
    .smm-col-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 0 4px 12px; }
    .smm-col-name { font-family: var(--sans); font-size: 11.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet); }
    .smm-col-count { font-family: var(--sans); font-size: 11px; font-weight: 700; color: rgba(28,29,34,0.5); background: rgba(28,29,34,0.06); border-radius: 999px; padding: 1px 8px; }
    .smm-col-body { display: flex; flex-direction: column; gap: 10px; min-height: 120px; padding: 4px; border-radius: 12px; transition: background .15s, box-shadow .15s; }
    .smm-col-body.drop-hover { background: rgba(var(--violet-rgb),0.07); box-shadow: inset 0 0 0 2px rgba(var(--violet-rgb),0.35); }
    .smm-col-empty { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.32); padding: 14px 6px; }
    .smm-card { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 15px 16px; cursor: pointer; transition: border-color .16s, transform .16s, box-shadow .16s; }
    .smm-card:hover { border-color: rgba(var(--violet-rgb),0.45); transform: translateY(-1px); box-shadow: 0 10px 24px -18px rgba(28,29,34,0.4); }
    .smm-card.dragging { opacity: .45; }
    .smm-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
    .smm-kind { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-kind.is-discovery { background: rgba(47,158,94,0.12); color: #2c7a4b; }
    .smm-kind.is-brochure { background: rgba(227,160,8,0.14); color: #9a6a04; }
    .smm-kind.is-package { background: var(--english-violet); color: #fff; }
    .smm-add-btn { height: 34px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; padding: 0 16px; background: var(--english-violet); border: 1px solid var(--english-violet); border-radius: 999px; font-family: var(--sans); font-size: 12.5px; font-weight: 700; color: #fff; cursor: pointer; transition: background .15s; white-space: nowrap; }
    .smm-add-btn:hover { background: var(--ink); border-color: var(--ink); }
    .smm-add-btn svg { width: 14px; height: 14px; }
    .smm-card-when { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.42); }
    .smm-card-name { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); }
    .smm-card-biz { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); margin-top: 2px; }
    .smm-card-line { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.5); margin-top: 8px; display: flex; align-items: center; gap: 6px; min-width: 0; }
    .smm-card-line svg { width: 13px; height: 13px; flex: none; color: rgba(28,29,34,0.4); }
    .smm-card-line-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .smm-card-meta { font-family: var(--sans); font-size: 11.5px; color: var(--english-violet); margin-top: 8px; display: inline-flex; align-items: center; gap: 5px; }
    .smm-card-meta svg { width: 12px; height: 12px; }
    .smm-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 12px; }
    .smm-card-acts { display: flex; flex-wrap: wrap; gap: 6px; }
    .smm-card-act { font-family: var(--sans); font-size: 11px; font-weight: 700; color: var(--english-violet); background: rgba(var(--violet-rgb),0.08); border: 0; border-radius: 6px; padding: 5px 10px; cursor: pointer; transition: background .15s; }
    .smm-card-act:hover { background: rgba(var(--violet-rgb),0.18); }
    .smm-card-status { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; flex: none; }

    /* ---- Full-screen customer file ---- */
    .smm-file-scrim { position: fixed; top: 0; right: 0; bottom: 0; left: var(--ash-side-w, 0); z-index: 200; background: rgba(20,18,26,0.5); display: flex; align-items: stretch; justify-content: center; padding: 28px; }
    .smm-file-scrim[hidden] { display: none; }
    .smm-file-card { position: relative; width: min(1120px, 100%); background: #fff; border-radius: 14px; box-shadow: 0 40px 100px rgba(20,18,26,0.4); overflow-y: auto; padding: 34px 40px 48px; }
    .smm-file-x { position: absolute; top: 20px; right: 24px; background: none; border: 0; font-size: 30px; line-height: 1; color: rgba(28,29,34,0.4); cursor: pointer; z-index: 2; }
    .smm-file-x:hover { color: var(--ink); }
    .smm-file-head { margin: 0 40px 20px 0; }
    .smm-name-wrap { display: inline-flex; align-items: center; gap: 6px; }
    .smm-file-name { font-family: var(--serif); font-weight: 500; font-size: 30px; color: var(--ink); margin: 0; display: inline-flex; align-items: center; gap: 6px; }
    .smm-name-edit { background: none; border: 0; padding: 5px; border-radius: 7px; color: rgba(28,29,34,0.32); cursor: pointer; display: inline-flex; }
    .smm-name-edit:hover { background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-name-edit svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }
    .smm-name-input { font-family: var(--serif); font-weight: 500; font-size: 30px; color: var(--ink); border: 0; border-bottom: 2px solid var(--english-violet); outline: none; background: none; min-width: 220px; padding: 0 0 2px; }
    .smm-file-sub { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); margin: 5px 0 0; }
    .smm-status-pill { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; margin-left: 6px; position: relative; top: -4px; }
    .smm-status-pill.is-active, .smm-card-status.is-active { background: rgba(47,158,94,0.14); color: #2c7a4b; }
    .smm-status-pill.is-paused, .smm-card-status.is-paused { background: rgba(227,160,8,0.16); color: #9a6a04; }
    .smm-status-pill.is-ended, .smm-card-status.is-ended { background: rgba(28,29,34,0.09); color: rgba(28,29,34,0.55); }

    /* Pipeline stepper */
    .smm-pipe { position: relative; display: flex; margin: 8px 0 93px; padding-top: 4px; }
    .smm-pipe-track { position: absolute; top: 10px; left: 7px; right: 7px; height: 2px; background: rgba(28,29,34,0.12); }
    .smm-pipe-fill { position: absolute; left: 0; top: 0; height: 100%; background: var(--english-violet); transition: width .25s; }
    .smm-pipe-step { position: absolute; top: 4px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; }
    .smm-pipe-step--first { transform: translateX(0); align-items: flex-start; }
    .smm-pipe-step--last { transform: translateX(-100%); align-items: flex-end; }
    .smm-pipe-dot { width: 14px; height: 14px; border-radius: 50%; background: #fff; border: 2px solid rgba(28,29,34,0.25); position: relative; z-index: 1; transition: background .18s, border-color .18s, box-shadow .18s; }
    .smm-pipe-step.is-done .smm-pipe-dot { background: var(--english-violet); border-color: var(--english-violet); }
    .smm-pipe-step.is-current .smm-pipe-dot { box-shadow: 0 0 0 4px rgba(var(--violet-rgb),0.18); }
    .smm-pipe-label { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.5); white-space: nowrap; }
    .smm-pipe-step.is-done .smm-pipe-label, .smm-pipe-step.is-current .smm-pipe-label { color: var(--ink); font-weight: 600; }
    .smm-pipe-step:hover .smm-pipe-label { color: var(--english-violet); }

    /* File layout */
    .smm-file-grid { display: grid; grid-template-columns: 320px 1fr; gap: 34px; }
    @media (max-width: 860px) { .smm-file-grid { grid-template-columns: 1fr; } }
    .smm-sec { border-top: 1px solid rgba(28,29,34,0.09); padding: 18px 0; }
    .smm-sec:first-child { border-top: 0; padding-top: 0; }
    .smm-sec-h { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin: 0 0 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }

    /* Contact details card */
    .smm-cd-card { border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 6px 16px; }
    .smm-cd-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.07); }
    .smm-cd-row:last-child { border-bottom: 0; }
    .smm-cd-ico { width: 34px; height: 34px; flex: none; border-radius: 9px; background: rgba(var(--violet-rgb),0.09); color: var(--english-violet); display: inline-flex; align-items: center; justify-content: center; }
    .smm-cd-ico svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; }
    .smm-cd-main { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 1px; }
    .smm-cd-k { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.42); }
    .smm-cd-v { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    a.smm-cd-v:hover { color: var(--english-violet); }
    .smm-cd-input { width: 100%; border: 0; border-bottom: 1px solid transparent; background: none; font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); padding: 1px 0; }
    .smm-cd-input:hover { border-bottom-color: rgba(28,29,34,0.15); }
    .smm-cd-input:focus { outline: none; border-bottom-color: var(--english-violet); }
    .smm-cd-input::placeholder { color: rgba(28,29,34,0.3); font-weight: 500; }
    /* CRM link row under the contact details. */
    .smm-crm-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; margin: 10px 0 0; }
    .smm-crm-note { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); }
    .smm-btn--ghost { background: transparent; border: 1px solid rgba(var(--violet-rgb),0.3); color: var(--english-violet); text-decoration: none; }
    .smm-btn--ghost:hover { background: rgba(var(--violet-rgb),0.07); }
    .smm-cd-status { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); margin: 8px 0 0; min-height: 14px; }
    .smm-copy { background: none; border: 0; padding: 6px; border-radius: 7px; color: rgba(28,29,34,0.38); cursor: pointer; display: inline-flex; flex: none; transition: background .15s, color .15s; }
    .smm-copy:hover { background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-copy svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; }
    .smm-copy.is-done { color: #2c7a4b; }

    /* See more */
    .smm-more-toggle { margin-top: 14px; background: none; border: 0; padding: 6px 0; font-family: var(--sans); font-size: 12.5px; font-weight: 600; color: var(--english-violet); cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .smm-more-toggle svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.2; transition: transform .18s; }
    .smm-more-toggle.is-open svg { transform: rotate(180deg); }
    .smm-more { margin-top: 4px; }
    .smm-more[hidden] { display: none; }
    .smm-field { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px dashed rgba(28,29,34,0.09); font-family: var(--sans); font-size: 13.5px; color: var(--ink); }
    .smm-field:last-child { border-bottom: 0; }
    .smm-field-k { color: rgba(28,29,34,0.5); flex: 0 0 auto; font-size: 12.5px; }
    .smm-field-v { text-align: right; min-width: 0; }

    /* Actions */
    .smm-file-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .smm-btn { display: inline-flex; align-items: center; gap: 7px; padding: 9px 15px; border-radius: 8px; font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.02em; cursor: pointer; border: 1px solid rgba(var(--violet-rgb),0.3); background: #fff; color: var(--english-violet); text-decoration: none; transition: background .15s, border-color .15s, color .15s; }
    .smm-btn:hover { background: rgba(var(--violet-rgb),0.06); }
    .smm-btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }
    .smm-btn--primary { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .smm-btn--primary:hover { background: var(--ink); color: #fff; }
    .smm-btn--block { width: 100%; justify-content: center; }
    .smm-btn--danger { border-color: #a05a3c; color: #a05a3c; }
    .smm-btn--danger:hover { background: #a05a3c; color: #fff; }
    .smm-btn--del { border-color: rgba(28,29,34,0.2); color: rgba(28,29,34,0.55); }
    .smm-btn--del:hover { background: #a05a3c; border-color: #a05a3c; color: #fff; }
    .smm-btn--sm { padding: 6px 12px; font-size: 12px; }
    .smm-status-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .smm-hint { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); margin: 8px 0 0; }
    .smm-eng { display: grid; grid-template-columns: 1fr 1fr; gap: 11px 12px; }
    .smm-eng-row { display: flex; flex-direction: column; gap: 4px; }
    .smm-eng-row--full { grid-column: 1 / -1; }
    .smm-eng-row > span { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .smm-eng-row input, .smm-eng-row textarea, .smm-eng-row select { width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; font-family: var(--sans); font-size: 13px; color: var(--ink); background: #fff; resize: vertical; }
    .smm-eng-row input:focus, .smm-eng-row textarea:focus, .smm-eng-row select:focus { outline: none; border-color: var(--english-violet); }
    .smm-eng-status { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); margin: 8px 0 0; min-height: 14px; }
    .smm-platforms { margin-top: 12px; }
    .smm-plat-label { display: block; font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-bottom: 8px; }
    .smm-plat-grid { display: flex; flex-wrap: wrap; gap: 6px 14px; }
    .smm-plat { display: inline-flex; align-items: center; gap: 6px; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.68); cursor: pointer; }
    /* Invoices */
    .smm-inv { border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 12px 13px; margin-bottom: 9px; }
    .smm-inv-top { display: flex; align-items: center; gap: 10px; }
    .smm-inv-status { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; flex: none; }
    .smm-inv-status.is-paid { background: rgba(47,158,94,0.14); color: #2c7a4b; }
    .smm-inv-status.is-due { background: rgba(227,160,8,0.16); color: #9a6a04; }
    .smm-inv-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 10px; padding-top: 10px; border-top: 1px solid rgba(28,29,34,0.07); }
    .smm-inv-paid { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); display: inline-flex; align-items: center; gap: 7px; }
    .smm-inv-paid input { padding: 5px 8px; border: 1px solid rgba(28,29,34,0.16); border-radius: 7px; font-family: var(--sans); font-size: 12px; color: var(--ink); }
    /* Invoicing builder (per-client) */
    .siv-build { border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 16px; margin-bottom: 18px; background: rgba(28,29,34,0.015); }
    .siv-grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    .siv-f { display: block; margin-bottom: 12px; }
    .siv-f > span { display: block; font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-bottom: 6px; }
    .siv-f input, .siv-f textarea { width: 100%; padding: 9px 11px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 13.5px; color: var(--ink); background: #fff; }
    .siv-f input:focus, .siv-f textarea:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .siv-item { display: grid; grid-template-columns: 1fr 120px 32px; gap: 8px; margin-bottom: 8px; }
    .siv-item input { padding: 8px 10px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 13px; color: var(--ink); background: #fff; }
    .siv-del { cursor: pointer; border: 1px solid rgba(28,29,34,0.14); background: #fff; border-radius: 8px; font-size: 17px; line-height: 1; color: rgba(28,29,34,0.5); }
    .siv-del:hover { background: rgba(200,70,50,0.08); border-color: rgba(200,70,50,0.4); color: #a3372b; }
    .siv-totals { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(28,29,34,0.1); font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); }
    .siv-totals strong { font-size: 15px; color: var(--ink); }
    .siv-tpl { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .siv-tpl-lbl { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .siv-tpl-opts { display: inline-flex; gap: 4px; padding: 3px; background: rgba(28,29,34,0.05); border-radius: 8px; }
    .siv-tpl-opt { appearance: none; cursor: pointer; background: none; border: 0; border-radius: 6px; padding: 6px 14px; font-family: var(--sans); font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.55); transition: background .15s, color .15s; }
    .siv-tpl-opt.is-active { background: var(--english-violet); color: #fff; }
    .cim-pay { font-family: var(--sans); font-size: 12px; line-height: 1.5; color: rgba(28,29,34,0.55); margin: 0 0 12px; padding: 9px 12px; border-radius: 7px; background: rgba(28,29,34,0.05); }
    .cim-pay.is-on { color: var(--english-violet); background: rgba(var(--violet-rgb), 0.09); font-weight: 700; }
    .siv-pay-hint { font-family: var(--sans); font-size: 11px; line-height: 1.45; color: rgba(28,29,34,0.5); }
    .pay-toggle { display: inline-flex; gap: 4px; padding: 3px; background: rgba(28,29,34,0.05); border-radius: 9px; }
    .pay-opt { appearance: none; cursor: pointer; background: none; border: 0; border-radius: 7px; padding: 8px 22px; font-family: var(--sans); font-size: 13.5px; font-weight: 700; color: rgba(28,29,34,0.55); transition: background .15s, color .15s; }
    .pay-opt.is-active { background: var(--english-violet); color: #fff; }
    .siv-dd-banner { display: flex; gap: 10px; align-items: flex-start; padding: 12px 14px; margin-bottom: 16px; background: rgba(55,30,40,0.06); border: 1px solid rgba(55,30,40,0.15); border-radius: 10px; font-family: var(--sans); font-size: 13px; line-height: 1.5; color: var(--ink); }
    .siv-dd-banner strong { color: var(--english-violet); }
    .siv-actions { display: flex; justify-content: flex-end; gap: 8px; margin-top: 14px; }
    .siv-list-head { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin: 6px 0 10px; }
    .siv-row { display: grid; grid-template-columns: 90px 1fr auto auto auto; gap: 12px; align-items: center; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.1); border-radius: 9px; margin-bottom: 8px; font-family: var(--sans); font-size: 13px; }
    .siv-row .siv-num { font-weight: 700; color: var(--ink); }
    .siv-row .siv-due { color: rgba(28,29,34,0.5); font-size: 12px; }
    .siv-row .siv-amt2 { font-weight: 700; text-align: right; }
    .siv-row .smm-inv-status { text-transform: uppercase; }

    /* Insights panel (per-client SocialPilot reports) */
    .ri-months { display: flex; gap: 6px; flex-wrap: wrap; margin-bottom: 12px; }
    .ri-month { padding: 5px 13px; border-radius: 999px; border: 1px solid rgba(28,29,34,0.16); background: #fff; font-family: var(--sans); font-size: 11.5px; font-weight: 600; color: rgba(28,29,34,0.6); cursor: pointer; }
    .ri-month.is-active { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .ri-subtabs { display: inline-flex; gap: 2px; padding: 3px; background: rgba(28,29,34,0.05); border-radius: 9px; margin-bottom: 14px; flex-wrap: wrap; }
    .ri-subtab { padding: 6px 14px; border: 0; background: none; border-radius: 6px; font-family: var(--sans); font-size: 12.5px; font-weight: 600; color: rgba(28,29,34,0.55); cursor: pointer; }
    .ri-subtab:hover { color: var(--ink); }
    .ri-subtab.is-active { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(28,29,34,0.12); }
    .smm-ri-json { font-family: ui-monospace, "SF Mono", Menlo, monospace !important; font-size: 12px !important; line-height: 1.5; resize: vertical; }
    /* report render primitives (from report-insights.js) */
    .ri-kpi { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 12px 13px; }
    .ri-kpi-label { font-size: 10px; color: #8a8796; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 6px; }
    .ri-kpi-val { font-size: 21px; font-weight: 600; line-height: 1; color: var(--ink); }
    .ri-kpi-sub { font-size: 10px; margin-top: 4px; }
    .ri-panel { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 15px 17px; margin-bottom: 14px; }
    .ri-sec { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: #8a8796; margin: 20px 0 9px; }
    /* Ask AI chat */
    .ri-ai-chat { min-height: 180px; max-height: 44vh; overflow-y: auto; padding: 2px; margin-bottom: 12px; }
    .ri-ai-msg { max-width: 86%; padding: 10px 14px; border-radius: 12px; font-family: var(--sans); font-size: 13.5px; line-height: 1.55; margin-bottom: 10px; }
    .ri-ai-user { margin-left: auto; background: var(--english-violet); color: #fff; border-bottom-right-radius: 3px; }
    .ri-ai-bot { margin-right: auto; background: #fff; border: 1px solid rgba(28,29,34,0.1); color: var(--ink); border-bottom-left-radius: 3px; white-space: pre-wrap; }
    .ri-ai-bot.is-loading { color: rgba(28,29,34,0.45); font-style: italic; }
    .ri-ai-empty { text-align: center; padding: 26px 16px; color: rgba(28,29,34,0.55); }
    .ri-ai-empty-ic { font-size: 30px; margin-bottom: 10px; }
    .ri-ai-empty-h { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); margin-bottom: 10px; }
    .ri-ai-suggest { font-family: var(--sans); font-size: 12.5px; line-height: 1.9; color: rgba(28,29,34,0.5); }
    .ri-ai-compose { display: flex; gap: 8px; }
    .ri-ai-compose input { flex: 1; min-width: 0; padding: 10px 13px; border: 1px solid rgba(28,29,34,0.16); border-radius: 9px; font-family: var(--sans); font-size: 13.5px; color: var(--ink); background: #fff; }
    .ri-ai-compose input:focus { outline: none; border-color: var(--english-violet); }
    .smm-msg { background: rgba(var(--violet-rgb),0.04); border-left: 3px solid var(--english-violet); padding: 14px 16px; border-radius: 6px; font-family: var(--sans); font-size: 14px; line-height: 1.6; color: var(--ink); white-space: pre-wrap; margin-bottom: 18px; }
    .smm-soon { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.45); line-height: 1.6; }

    /* Right-panel tabs */
    .smm-tabs { display: inline-flex; gap: 4px; padding: 4px; background: rgba(28,29,34,0.05); border-radius: 10px; margin-bottom: 18px; }
    .smm-tab { padding: 7px 18px; border: 0; background: none; border-radius: 7px; font-family: var(--sans); font-size: 13px; font-weight: 600; color: rgba(28,29,34,0.55); cursor: pointer; transition: background .15s, color .15s; }
    .smm-tab:hover { color: var(--ink); }
    .smm-tab.is-active { background: #fff; color: var(--ink); box-shadow: 0 1px 3px rgba(28,29,34,0.14); }
    .smm-panel-body[hidden] { display: none; }
    .smm-panel-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
    .smm-panel-head h4 { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); margin: 0; }

    /* Thread: notes / emails / documents */
    .smm-thread-status { font-family: var(--sans); font-size: 12.5px; margin: 10px 0 0; }
    .smm-add { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
    .smm-add textarea, .smm-add input[type=text] { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 13.5px; line-height: 1.5; color: var(--ink); background: #fff; resize: vertical; }
    .smm-add textarea:focus, .smm-add input[type=text]:focus { outline: none; border-color: var(--english-violet); }
    .smm-add-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }
    .smm-note { border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; padding: 11px 13px; margin-bottom: 8px; background: #fff; }
    .smm-note.is-pinned { border-color: rgba(var(--violet-rgb),0.35); background: rgba(var(--violet-rgb),0.04); }
    .smm-divider { display: flex; align-items: center; gap: 12px; margin: 22px 0 16px; }
    .smm-divider::before, .smm-divider::after { content: ""; flex: 1; height: 1px; background: rgba(28,29,34,0.1); }
    .smm-divider span { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .smm-activity { display: flex; flex-direction: column; }
    .smm-act { display: flex; gap: 11px; padding: 8px 0; }
    .smm-act-dot { width: 8px; height: 8px; border-radius: 50%; background: rgba(var(--violet-rgb),0.4); margin-top: 5px; flex: none; position: relative; }
    .smm-act:not(:last-child) .smm-act-dot::after { content: ""; position: absolute; left: 50%; top: 12px; transform: translateX(-50%); width: 1px; height: calc(100% + 8px); background: rgba(28,29,34,0.1); }
    .smm-act-main { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .smm-act-text { font-family: var(--sans); font-size: 13px; color: var(--ink); }
    .smm-act-meta { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.45); }
    .smm-note-body { font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: var(--ink); white-space: pre-wrap; }
    .smm-note-edit { width: 100%; font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: var(--ink); padding: 9px 11px; border: 1px solid rgba(var(--violet-rgb),0.3); border-radius: 6px; background: #fff; resize: vertical; }
    .smm-note-edit:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(var(--violet-rgb),0.12); }
    .smm-note-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 8px; }
    .smm-note-meta { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); display: inline-flex; align-items: center; gap: 6px; }
    .smm-pin-badge { color: var(--english-violet); font-weight: 700; }
    .smm-note-tools { display: inline-flex; gap: 4px; }
    .smm-mini { background: none; border: 0; padding: 3px 7px; border-radius: 6px; font-family: var(--sans); font-size: 11.5px; font-weight: 600; color: rgba(28,29,34,0.5); cursor: pointer; transition: background .15s, color .15s; }
    .smm-mini:hover { background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-mini.is-danger:hover { background: rgba(160,90,60,0.12); color: #a05a3c; }
    .smm-mini.is-primary { background: var(--english-violet); color: #fff; padding: 4px 11px; }
    .smm-mini.is-primary:hover { background: var(--english-violet); opacity: 0.9; color: #fff; }
    .smm-mini:disabled { opacity: 0.5; cursor: not-allowed; }
    .siv-row-tools { display: inline-flex; align-items: center; gap: 6px; justify-self: end; }
    .smm-mail { max-width: 88%; margin-bottom: 10px; padding: 11px 14px; border-radius: 12px; font-family: var(--sans); }
    .smm-mail.is-in { background: rgba(28,29,34,0.045); border: 1px solid rgba(28,29,34,0.08); border-top-left-radius: 4px; margin-right: auto; }
    .smm-mail.is-out { background: rgba(var(--violet-rgb),0.07); border: 1px solid rgba(var(--violet-rgb),0.16); border-top-right-radius: 4px; margin-left: auto; }
    .smm-mail-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 5px; }
    .smm-mail-who { font-size: 11.5px; font-weight: 700; color: rgba(28,29,34,0.6); display: inline-flex; align-items: center; gap: 6px; }
    .smm-mail-badge { font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 1px 6px; border-radius: 999px; background: rgba(28,29,34,0.08); color: rgba(28,29,34,0.55); }
    .smm-mail-when { font-size: 11px; color: rgba(28,29,34,0.42); }
    .smm-mail-subj { font-size: 13px; font-weight: 700; color: var(--ink); margin-bottom: 2px; }
    .smm-mail-body { font-size: 13.5px; line-height: 1.55; color: var(--ink); white-space: pre-wrap; }
    .smm-mail-empty, .smm-doc-empty { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.4); padding: 4px 0 10px; }
    .smm-doc { display: flex; align-items: center; gap: 10px; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; margin-bottom: 7px; }
    .smm-doc-ico { width: 28px; height: 28px; flex: none; border-radius: 6px; background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); display: inline-flex; align-items: center; justify-content: center; }
    .smm-doc-ico svg { width: 15px; height: 15px; }
    .smm-doc-main { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; }
    .smm-doc-name { font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smm-doc-cat { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.45); }
    .smm-doc-tools { display: inline-flex; gap: 2px; flex: none; }
    .smm-file-input { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.6); width: 100%; }
    .smm-file-input::file-selector-button { margin-right: 10px; padding: 8px 13px; border-radius: 8px; border: 1px solid rgba(var(--violet-rgb),0.3); background: #fff; color: var(--english-violet); font-family: var(--sans); font-size: 12.5px; font-weight: 700; cursor: pointer; }
    .smm-file-input::file-selector-button:hover { background: rgba(var(--violet-rgb),0.06); }

    /* Modals (meeting / add file) */
    .smm-modal-scrim { position: fixed; top: 0; right: 0; bottom: 0; left: var(--ash-side-w, 0); z-index: 220; background: rgba(20,18,26,0.5); display: flex; align-items: center; justify-content: center; padding: 20px; }
    .smm-modal { background: #fff; border-radius: 14px; width: min(440px, 100%); padding: 26px 28px 24px; box-shadow: 0 40px 100px rgba(20,18,26,0.45); }
    .smm-modal.smm-modal--email { width: min(620px, 100%); max-height: 88vh; overflow-y: auto; }
    .smm-modal-field textarea { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 14px; line-height: 1.55; color: var(--ink); background: #fff; resize: vertical; }
    .smm-modal-field textarea:focus { outline: none; border-color: var(--english-violet); }
    .smm-modal-field input[readonly] { background: rgba(28,29,34,0.04); color: rgba(28,29,34,0.6); }
    .smm-modal h3 { font-family: var(--serif); font-weight: 500; font-size: 21px; color: var(--ink); margin: 0 0 4px; }
    .smm-modal p.smm-modal-sub { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.55); margin: 0 0 18px; }
    .smm-modal-field { margin-bottom: 14px; }
    .smm-modal-field > label { display: block; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin-bottom: 6px; }
    .smm-modal-field input[type=text], .smm-modal-field input[type=date], .smm-modal-field input[type=time], .smm-modal-field select { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 14px; color: var(--ink); background: #fff; }
    .smm-modal-field input:focus, .smm-modal-field select:focus { outline: none; border-color: var(--english-violet); }
    .smm-modal-two { display: flex; gap: 12px; }
    .smm-modal-two > * { flex: 1; }
    .smm-check { display: flex; align-items: center; gap: 9px; font-family: var(--sans); font-size: 13.5px; color: var(--ink); cursor: pointer; margin: 4px 0 2px; }
    .smm-modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 20px; }
    .smm-modal-status { font-family: var(--sans); font-size: 12.5px; color: #a05a3c; margin: 10px 0 0; }
  </style>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { supabase } from "../../lib/supabase.js";
    import { renderTab, renderTrends, MONTHS as RI_MONTHS } from "../../lib/report-insights.js";
    import { DEMO_REPORTS } from "../../lib/report-insights-demo.js";
    import { renderInvoiceHtml } from "../../lib/invoice-render.js";

    const STAGES = [
      { key: "inquiry", label: "Inquiry" },
      { key: "meeting_set", label: "Meeting set" },
      { key: "proposal_sent", label: "Proposal sent" },
      { key: "contract_signed", label: "Contract sent" },
      { key: "onboarding", label: "Onboarding" },
      { key: "active_client", label: "Active client" },
    ];
    const STAGE_INDEX = Object.fromEntries(STAGES.map((s, i) => [s.key, i]));
    // Legacy stages map onto the nearest current column.
    const STAGE_ALIAS = { contract_sent: "proposal_sent", brochure_downloaded: "inquiry", general_enquiry: "inquiry", discovery_call_booked: "inquiry" };
    const KIND_LABEL = { enquiry: "Enquiry", brochure: "Brochure", discovery: "Discovery call", manual: "Manual" };
    const CLIENT_STATUS = { active: "Active", paused: "Paused", ended: "Ended" };
    const NEXT_LABEL = { meeting_set: "Set a meeting", proposal_sent: "Mark proposal sent", contract_signed: "Mark contract sent", onboarding: "Start onboarding", active_client: "Make active client" };
    const PLATFORMS = ["Instagram", "Facebook", "LinkedIn", "YouTube", "TikTok"];

    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    const nameOf = (r) => (r.full_name || `${r.first_name || ""} ${r.last_name || ""}`).trim() || "—";
    function fmtWhen(iso) {
      if (!iso) return "";
      const d = new Date(iso), diff = (Date.now() - d) / 1000;
      if (diff < 3600) return Math.max(1, Math.floor(diff / 60)) + "m";
      if (diff < 86400) return Math.floor(diff / 3600) + "h";
      if (diff < 604800) return Math.floor(diff / 86400) + "d";
      return d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
    }
    const fmtDateTime = (iso) => { try { return new Date(iso).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }); } catch (_) { return ""; } };
    function stageOf(r) {
      let s = r.pipeline_stage;
      if (s && STAGE_ALIAS[s]) s = STAGE_ALIAS[s];
      return s && STAGE_INDEX[s] != null ? s : "inquiry";
    }

    // Icons
    const COPY_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    const PENCIL_SVG = '<svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>';
    const PLUS_SVG = '<svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
    const CHEV_SVG = '<svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>';
    const EMAIL_SVG = '<svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>';
    const PHONE_SVG = '<svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>';
    const BIZ_SVG = '<svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></svg>';
    const DOC_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>';
    const CAL_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg>';
    const USER_SVG = '<svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const SMM_CATS = [["agreement", "Contract"], ["prep", "Proposal"], ["content_plan", "Content plan"], ["insights_report", "Insights report"], ["delivery", "Deliverables"], ["invoice", "Invoice"], ["other", "Other"]];
    const catLabel = (c) => (SMM_CATS.find((x) => x[0] === c) || [, "Document"])[1];
    const isDemo = (r) => String(r.id).startsWith("demo");
    async function authToken() {
      try {
        let session = (await supabase.auth.getSession()).data.session;
        // Refresh if the token is missing or expiring within 60s, so uploads
        // don't fail with "Unauthorised" on a stale session.
        if (!session || (session.expires_at && session.expires_at * 1000 < Date.now() + 60000)) {
          try { const r = await supabase.auth.refreshSession(); if (r.data && r.data.session) session = r.data.session; } catch (_) {}
        }
        return (session && session.access_token) || "";
      } catch (_) { return ""; }
    }

    let ME = "";            // the signed-in admin's email — a note belongs to whoever wrote it
    let all = [], kindFilter = "all", q = "", showLost = false, current = null, activeTab = "notes";

    // ---------- Board ----------
    function visible() {
      return all
        .filter((r) => showLost ? true : r.pipeline_stage !== "lost" && r.status !== "spam")
        .filter((r) => {
          const f = kindFilter;
          if (f === "all") return true;
          if (f === "enquiry" || f === "brochure") return r.kind === f;
          return stageOf(r) === f; // meeting_set (Discovery calls) / proposal_sent / contract_signed / onboarding / active_client (Clients)
        })
        .filter((r) => !q || (nameOf(r) + " " + (r.email || "") + " " + (r.business || "")).toLowerCase().includes(q));
    }
    // Shared by the filter chips and any "See all" card — both just narrow
    // the board to one kind/stage via the same kindFilter var.
    function goToFilter(key) {
      kindFilter = key;
      document.querySelectorAll(".smm-chip").forEach((c) => c.classList.toggle("is-active", c.getAttribute("data-filter") === key));
      renderBoard();
    }
    function renderBoard() {
      const board = $("smm-board");
      const rows = visible();
      if (kindFilter === "all") {
        // One row per stage; cards run left-to-right and that row scrolls on
        // its own past ~3 cards (.smm-stage-cards) — no board-wide horizontal
        // scroll across every stage, and no cap/"see all", the row just scrolls.
        board.classList.remove("is-list");
        // "Clients" (active_client) is structurally the busiest stage — it
        // only grows, never clears out like the others — so it wraps onto a
        // couple of lines instead of one scrolling row, and past 8 clients
        // a "See all" hands off to the existing Clients list view rather
        // than growing a 3rd/4th line.
        const CLIENTS_WRAP_CAP = 8;
        board.innerHTML = STAGES.map((s) => {
          const allCards = rows.filter((r) => stageOf(r) === s.key);
          const isClients = s.key === "active_client";
          const overCap = isClients && allCards.length > CLIENTS_WRAP_CAP;
          const cards = overCap ? allCards.slice(0, CLIENTS_WRAP_CAP) : allCards;
          const seeAll = overCap ? `<button type="button" class="smm-see-all" data-goto-filter="active_client">See all ${allCards.length} &rarr;</button>` : "";
          return `<div class="smm-col smm-stage-row">
            <div class="smm-col-head"><span class="smm-col-name">${esc(s.label)}</span><span class="smm-col-count">${allCards.length}</span></div>
            <div class="smm-stage-cards${isClients ? " is-wrap" : ""}" data-stage="${s.key}">${allCards.length ? cards.map(cardHtml).join("") + seeAll : '<div class="smm-col-empty">Drop here</div>'}</div>
          </div>`;
        }).join("");
        wireCards(board);
        board.querySelectorAll("[data-goto-filter]").forEach((btn) => {
          btn.addEventListener("click", () => goToFilter(btn.getAttribute("data-goto-filter")));
        });
        board.querySelectorAll(".smm-stage-cards").forEach((col) => {
          col.addEventListener("dragover", (e) => { e.preventDefault(); col.classList.add("drop-hover"); });
          col.addEventListener("dragleave", () => col.classList.remove("drop-hover"));
          col.addEventListener("drop", (e) => {
            e.preventDefault(); col.classList.remove("drop-hover");
            const id = e.dataTransfer.getData("text/plain");
            const r = all.find((x) => x.id === id); if (!r) return;
            moveToStage(r, col.getAttribute("data-stage"));
          });
        });
      } else {
        // A filter is on → single-column line view of just the matches.
        board.classList.add("is-list");
        const label = document.querySelector(".smm-chip.is-active")?.textContent || "Results";
        board.innerHTML = `<div class="smm-list"><div class="smm-list-head">${esc(label)} · ${rows.length}</div>${rows.length ? rows.map(rowHtml).join("") : '<div class="smm-col-empty">No matches.</div>'}</div>`;
        wireCards(board);
      }
      syncTopScroll();
    }
    function syncTopScroll() {
      const board = $("smm-board"), top = $("smm-scrolltop"), inner = $("smm-scrolltop-inner");
      if (!board || !top) return;
      if (board.classList.contains("is-list")) { top.hidden = true; return; }
      const over = board.scrollWidth > board.clientWidth + 1;
      top.hidden = !over;
      if (over) inner.style.width = board.scrollWidth + "px";
    }
    function wireCards(board) {
      board.querySelectorAll("[data-id]").forEach((el) => {
        const r = () => all.find((x) => x.id === el.getAttribute("data-id"));
        el.addEventListener("click", (e) => { if (e.target.closest(".smm-card-act")) return; openFile(el.getAttribute("data-id")); });
        el.querySelector("[data-cmeet]")?.addEventListener("click", (e) => { e.stopPropagation(); const x = r(); if (x) openMeeting(x); });
        el.querySelector("[data-cmsg]")?.addEventListener("click", (e) => { e.stopPropagation(); const x = r(); if (x) { activeTab = "emails"; openFile(x.id); } });
        if (el.classList.contains("smm-card")) {
          el.addEventListener("dragstart", (e) => { e.dataTransfer.setData("text/plain", el.getAttribute("data-id")); e.dataTransfer.effectAllowed = "move"; el.classList.add("dragging"); });
          el.addEventListener("dragend", () => el.classList.remove("dragging"));
        }
      });
    }
    function rowHtml(r) {
      const kc = r.kind === "discovery" ? " is-discovery" : r.kind === "brochure" ? " is-brochure" : "";
      const st = stageOf(r);
      const signed = STAGE_INDEX[st] >= STAGE_INDEX["contract_signed"];
      const pill = signed && r.package_name ? `<span class="smm-kind is-package">${esc(r.package_name)}</span>` : `<span class="smm-kind${kc}">${esc(KIND_LABEL[r.kind] || r.kind || "Lead")}</span>`;
      return `<div class="smm-row" data-id="${esc(r.id)}">
        ${pill}
        <div class="smm-row-main"><div class="smm-row-name">${esc(nameOf(r))}</div>${r.business ? `<div class="smm-row-biz">${esc(r.business)}</div>` : ""}</div>
        <div class="smm-row-email">${esc(r.email || "")}</div>
        <div class="smm-row-stage">${esc(STAGES[STAGE_INDEX[st]].label)}</div>
        <div class="smm-row-acts">
          <button type="button" class="smm-card-act" data-cmeet>Set a meeting</button>
          <button type="button" class="smm-card-act" data-cmsg>Send a message</button>
        </div>
      </div>`;
    }
    function cardHtml(r) {
      const kc = r.kind === "discovery" ? " is-discovery" : r.kind === "brochure" ? " is-brochure" : "";
      const st = stageOf(r);
      // From Contract signed on, the pill shows the package they're on (falls back
      // to the lead type until a package is set).
      const signed = STAGE_INDEX[st] >= STAGE_INDEX["contract_signed"];
      const pill = signed && r.package_name
        ? `<span class="smm-kind is-package">${esc(r.package_name)}</span>`
        : `<span class="smm-kind${kc}">${esc(KIND_LABEL[r.kind] || r.kind || "Lead")}</span>`;
      const meeting = r.meeting_at ? `<div class="smm-card-line">${CAL_SVG}Meeting ${esc(fmtDateTime(r.meeting_at))}</div>`
        : (r.kind === "discovery" && r.call_at ? `<div class="smm-card-line">${CAL_SVG}Call ${esc(fmtDateTime(r.call_at))}</div>` : "");
      const cstatus = st === "active_client" && r.client_status && r.client_status !== "active" ? `<span class="smm-card-status is-${r.client_status}">${esc(CLIENT_STATUS[r.client_status] || r.client_status)}</span>` : "";
      return `<div class="smm-card" draggable="true" data-id="${esc(r.id)}">
        <div class="smm-card-top">${pill}<span class="smm-card-when">${esc(fmtWhen(r.created_at))}</span></div>
        <div class="smm-card-name">${esc(nameOf(r))}</div>
        ${r.business ? `<div class="smm-card-biz">${esc(r.business)}</div>` : ""}
        ${r.email ? `<div class="smm-card-line">${EMAIL_SVG}<span class="smm-card-line-t">${esc(r.email)}</span></div>` : ""}
        ${meeting}
        <div class="smm-card-foot">
          <div class="smm-card-acts">
            <button type="button" class="smm-card-act" data-cmeet>Set a meeting</button>
            <button type="button" class="smm-card-act" data-cmsg>Send a message</button>
          </div>
          ${cstatus}
        </div>
      </div>`;
    }

    // ---------- Customer file ----------
    function contactRow(icon, label, value, href) {
      if (!value) return "";
      const v = href ? `<a class="smm-cd-v" href="${esc(href)}">${esc(value)}</a>` : `<span class="smm-cd-v">${esc(value)}</span>`;
      return `<div class="smm-cd-row"><span class="smm-cd-ico">${icon}</span><div class="smm-cd-main"><span class="smm-cd-k">${esc(label)}</span>${v}</div><button type="button" class="smm-copy" data-copy="${esc(value)}" title="Copy">${COPY_SVG}</button></div>`;
    }
    // Editable contact-detail row (contact name / email / phone / business).
    function cdEdit(icon, label, field, value) {
      return `<div class="smm-cd-row"><span class="smm-cd-ico">${icon}</span><div class="smm-cd-main"><span class="smm-cd-k">${esc(label)}</span><input class="smm-cd-input" data-cf="${field}" value="${esc(value || "")}" placeholder="Add ${esc(label.toLowerCase())}…"></div><button type="button" class="smm-copy" title="Copy">${COPY_SVG}</button></div>`;
    }
    function openFile(id) {
      const r = all.find((x) => x.id === id); if (!r) return;
      current = r;
      const st = stageOf(r);
      const idx = STAGE_INDEX[st];
      const n = STAGES.length;
      const isActive = st === "active_client";
      const cs = r.client_status || "active";
      const next = idx < n - 1 ? STAGES[idx + 1].key : null;
      const showProp = idx >= STAGE_INDEX["proposal_sent"]; // social channels + engagement (+ Direct Debit) from Proposal sent on
      const plats = Array.isArray(r.platforms) ? r.platforms : [];
      const pipe = `<div class="smm-pipe"><div class="smm-pipe-track"><div class="smm-pipe-fill" style="width:${(idx / (n - 1)) * 100}%"></div></div>${STAGES.map((s, i) => {
        const cls = (i <= idx ? " is-done" : "") + (i === idx ? " is-current" : "") + (i === 0 ? " smm-pipe-step--first" : "") + (i === n - 1 ? " smm-pipe-step--last" : "");
        return `<div class="smm-pipe-step${cls}" data-stage="${s.key}" style="left:${(i / (n - 1)) * 100}%"><span class="smm-pipe-dot"></span><span class="smm-pipe-label">${esc(s.label)}</span></div>`;
      }).join("")}</div>`;
      const acct = r.account_created ? "Created at submission" : (r.account_user_id ? "Existing account" : "None");
      $("smm-file-body").innerHTML = `
        <header class="smm-file-head">
          <h2 class="smm-file-name"><span class="smm-name-text">${esc(nameOf(r))}</span><button type="button" class="smm-name-edit" data-editname title="Edit name">${PENCIL_SVG}</button>${isActive ? `<span class="smm-status-pill is-${cs}">${esc(CLIENT_STATUS[cs])}</span>` : ""}</h2>
          <p class="smm-file-sub">${esc(r.business || KIND_LABEL[r.kind] || "Lead")}</p>
        </header>
        ${pipe}
        <div class="smm-file-grid">
          <div>
            <div class="smm-sec">
              <h3 class="smm-sec-h">Contact details</h3>
              <div class="smm-cd-card">
                ${cdEdit(USER_SVG, "Contact name", "full_name", nameOf(r) === "—" ? "" : nameOf(r))}
                ${cdEdit(EMAIL_SVG, "Email", "email", r.email)}
                ${cdEdit(PHONE_SVG, "Phone", "phone", r.phone)}
                ${cdEdit(BIZ_SVG, "Business", "business", r.business)}
              </div>
              <p class="smm-cd-status" id="smm-cd-status"></p>
              <!-- A social client added here doesn't land in the CRM on its own -
                   only website enquiries do that. This closes the gap. -->
              <div class="smm-crm-row" id="smm-crm-row"></div>
              <div class="smm-linkrow" style="display:flex;align-items:center;gap:10px;margin:6px 0 2px;font-family:var(--sans);font-size:12.5px;flex-wrap:wrap;">
                <span style="color:rgba(28,29,34,0.5);font-weight:700;letter-spacing:.04em;text-transform:uppercase;font-size:10.5px;">Member hub</span>
                ${r.account_user_id
                  ? `<span style="color:#2e6b40;font-weight:700;">Linked ✓</span>`
                  : `<span style="color:rgba(28,29,34,0.55);">Not linked</span>${r.email ? `<button type="button" data-linkacct style="appearance:none;cursor:pointer;background:var(--english-violet);color:#fff;border:0;border-radius:7px;padding:6px 12px;font-family:var(--sans);font-size:11.5px;font-weight:700;">Link to hub account</button>` : `<span style="color:rgba(28,29,34,0.4);">add an email first</span>`}`}
              </div>
              <button type="button" class="smm-more-toggle" data-more>See more info ${CHEV_SVG}</button>
              <div class="smm-more" hidden>
                <div class="smm-field"><span class="smm-field-k">Type</span><span class="smm-field-v">${esc(KIND_LABEL[r.kind] || r.kind || "Lead")}</span></div>
                <div class="smm-field"><span class="smm-field-k">Received</span><span class="smm-field-v">${esc(fmtDateTime(r.created_at))}</span></div>
                ${r.call_at ? `<div class="smm-field"><span class="smm-field-k">Discovery call</span><span class="smm-field-v">${esc(fmtDateTime(r.call_at))}</span></div>` : ""}
                ${r.meeting_at ? `<div class="smm-field"><span class="smm-field-k">Meeting</span><span class="smm-field-v">${esc(fmtDateTime(r.meeting_at))}</span></div>` : ""}
                <div class="smm-field"><span class="smm-field-k">Marketing</span><span class="smm-field-v">${r.marketing_opt_in ? "Opted in" : "Not opted in"}</span></div>
                <div class="smm-field"><span class="smm-field-k">Account</span><span class="smm-field-v">${esc(acct)}</span></div>
              </div>
            </div>
            ${showProp ? `<div class="smm-sec">
              <h3 class="smm-sec-h">Engagement &amp; billing</h3>
              <div class="smm-eng">
                <label class="smm-eng-row"><span>Package</span><input type="text" data-ef="package_name" value="${esc(r.package_name || "")}" placeholder="e.g. Growth"></label>
                <label class="smm-eng-row"><span>Pricing</span><input type="text" data-ef="price" value="${esc(r.price || "")}" placeholder="e.g. £750 / month"></label>
                <label class="smm-eng-row"><span>Contracted hours / month</span><input type="number" min="0" step="0.5" data-ef="contracted_hours_per_month" value="${r.contracted_hours_per_month ?? ""}" placeholder="e.g. 6"></label>
                <label class="smm-eng-row"><span>Start date</span><input type="date" data-ef="start_date" value="${esc(r.start_date || "")}"></label>
                <label class="smm-eng-row"><span>End date</span><input type="date" data-ef="end_date" value="${esc(r.end_date || "")}"></label>
                <div class="smm-eng-row"><span>Inter-brand invoice</span>
                  <div class="pay-toggle" id="ibi-toggle">
                    <button type="button" class="pay-opt ${r.inter_brand_invoice ? "is-active" : ""}" data-ibi="yes">Yes</button>
                    <button type="button" class="pay-opt ${!r.inter_brand_invoice ? "is-active" : ""}" data-ibi="no">No</button>
                  </div>
                </div>
                <label class="smm-eng-row"><span>Social media manager</span><input type="text" data-ef="social_media_manager" value="${esc(r.social_media_manager || "")}" placeholder="Who runs this account"></label>
                <div class="smm-eng-row"><span>Direct debit customer?</span>
                  <div class="pay-toggle" id="dd-toggle">
                    <button type="button" class="pay-opt ${r.direct_debit ? "is-active" : ""}" data-dd="yes">Yes</button>
                    <button type="button" class="pay-opt ${!r.direct_debit ? "is-active" : ""}" data-dd="no">No</button>
                  </div>
                </div>
                <label class="smm-eng-row" id="dd-date-row"><span>Direct debit date</span><select id="dd-date"><option value=""${!r.direct_debit_day ? " selected" : ""}>N/A</option>${Array.from({ length: 28 }, (_, i) => `<option value="${i + 1}"${Number(r.direct_debit_day) === i + 1 ? " selected" : ""}>${i + 1}${["st","nd","rd"][((i) % 10)] && i < 3 ? ["st","nd","rd"][i] : (i + 1) % 10 === 1 && i + 1 !== 11 ? "st" : (i + 1) % 10 === 2 && i + 1 !== 12 ? "nd" : (i + 1) % 10 === 3 && i + 1 !== 13 ? "rd" : "th"}</option>`).join("")}</select></label>
                <label class="smm-eng-row smm-eng-row--full"><span>Business address</span><textarea data-ef="business_address" rows="2" placeholder="For invoicing">${esc(r.business_address || "")}</textarea></label>
              </div>
              <div class="smm-platforms" data-platforms>
                <span class="smm-plat-label">Platforms we manage</span>
                <div class="smm-plat-grid">${PLATFORMS.map((p) => `<label class="smm-plat"><input type="checkbox" data-plat="${p}" ${plats.includes(p) ? "checked" : ""}> ${p}</label>`).join("")}</div>
              </div>
              <p class="smm-eng-status" id="smm-eng-status"></p>
            </div>
            <div class="smm-sec">
              <h3 class="smm-sec-h">Social channels</h3>
              <div class="smm-eng">
                <label class="smm-eng-row smm-eng-row--full"><span>Instagram</span><input type="text" data-ef="instagram_url" value="${esc(r.instagram_url || "")}" placeholder="instagram.com/…"></label>
                <label class="smm-eng-row smm-eng-row--full"><span>Facebook</span><input type="text" data-ef="facebook_url" value="${esc(r.facebook_url || "")}" placeholder="facebook.com/…"></label>
                <label class="smm-eng-row smm-eng-row--full"><span>LinkedIn</span><input type="text" data-ef="linkedin_url" value="${esc(r.linkedin_url || "")}" placeholder="linkedin.com/…"></label>
                <label class="smm-eng-row smm-eng-row--full"><span>YouTube</span><input type="text" data-ef="youtube_url" value="${esc(r.youtube_url || "")}" placeholder="youtube.com/…"></label>
                <label class="smm-eng-row smm-eng-row--full"><span>TikTok</span><input type="text" data-ef="tiktok_url" value="${esc(r.tiktok_url || "")}" placeholder="tiktok.com/@…"></label>
              </div>
              <p class="smm-eng-status" id="smm-chan-status"></p>
            </div>` : ""}
            <div class="smm-sec">
              <h3 class="smm-sec-h">${isActive ? "Client status" : "Actions"}</h3>
              ${isActive ? `<div class="smm-status-row">
                <button type="button" class="smm-btn smm-btn--sm ${cs === "active" ? "smm-btn--primary" : ""}" data-cstatus="active">Active</button>
                <button type="button" class="smm-btn smm-btn--sm ${cs === "paused" ? "smm-btn--primary" : ""}" data-cstatus="paused">Paused</button>
                <button type="button" class="smm-btn smm-btn--sm ${cs === "ended" ? "smm-btn--primary" : ""}" data-cstatus="ended">Ended</button>
              </div>` : `<button type="button" class="smm-btn smm-btn--primary smm-btn--block" data-move="${next}">${esc(NEXT_LABEL[next])}</button>`}
              <div class="smm-file-actions" style="margin-top:10px">
                <button type="button" class="smm-btn smm-btn--danger smm-btn--block" data-lost>Mark lost</button>
                <button type="button" class="smm-btn smm-btn--block smm-btn--del" data-delcard>Delete</button>
              </div>
              ${isActive ? `<p class="smm-hint">Status sets the CRM tag <strong>SMM-Status: ${esc(CLIENT_STATUS[cs])}</strong>${cs === "active" ? " and marks them a Customer" : ""}.</p>` : ""}
            </div>
          </div>
          <div>
            ${r.message ? `<div class="smm-msg">${esc(r.message)}</div>` : ""}
            <div class="smm-tabs" role="tablist">
              <button type="button" class="smm-tab ${activeTab === "notes" ? "is-active" : ""}" data-tab="notes">Notes</button>
              <button type="button" class="smm-tab ${activeTab === "emails" ? "is-active" : ""}" data-tab="emails">Emails</button>
              <button type="button" class="smm-tab ${activeTab === "files" ? "is-active" : ""}" data-tab="files">Files</button>
              ${isActive ? `<button type="button" class="smm-tab ${activeTab === "invoices" ? "is-active" : ""}" data-tab="invoices">Invoicing</button>` : ""}
              ${isActive ? `<button type="button" class="smm-tab ${activeTab === "insights" ? "is-active" : ""}" data-tab="insights">Insights</button>` : ""}
            </div>
            <div id="smm-panel-notes" class="smm-panel-body" ${activeTab === "notes" ? "" : "hidden"}><p class="smm-soon">Loading…</p></div>
            <div id="smm-panel-emails" class="smm-panel-body" ${activeTab === "emails" ? "" : "hidden"}></div>
            <div id="smm-panel-files" class="smm-panel-body" ${activeTab === "files" ? "" : "hidden"}></div>
            ${isActive ? `<div id="smm-panel-invoices" class="smm-panel-body" ${activeTab === "invoices" ? "" : "hidden"}></div>` : ""}
            ${isActive ? `<div id="smm-panel-insights" class="smm-panel-body" ${activeTab === "insights" ? "" : "hidden"}></div>` : ""}
            <p class="smm-thread-status" id="smm-thread-status" hidden></p>
          </div>
        </div>`;
      $("smm-file").hidden = false;
      document.body.style.overflow = "hidden";
      wireFile(r);
    }
    function closeFile() { $("smm-file").hidden = true; current = null; document.body.style.overflow = ""; }

    function wireFile(r) {
      const body = $("smm-file-body");
      // Quick-copy (reads the sibling input for editable rows)
      body.querySelectorAll("[data-copy], .smm-cd-row .smm-copy").forEach((b) => b.addEventListener("click", async (e) => {
        e.stopPropagation();
        const inp = b.parentElement.querySelector(".smm-cd-input");
        const val = inp ? inp.value.trim() : b.getAttribute("data-copy");
        if (!val) return;
        try { await navigator.clipboard.writeText(val); b.classList.add("is-done"); setTimeout(() => b.classList.remove("is-done"), 1200); } catch (_) {}
      }));
      // Contact details (editable, any stage)
      body.querySelectorAll("[data-cf]").forEach((el) => el.addEventListener("change", () => saveContact(r, el.getAttribute("data-cf"), el.value)));
      // Edit name
      body.querySelector("[data-editname]")?.addEventListener("click", () => startEditName(r));
      // Link this card to the member's hub account
      body.querySelector("[data-linkacct]")?.addEventListener("click", () => linkAccount(r));
      // See more
      body.querySelector("[data-more]")?.addEventListener("click", (e) => {
        const btn = e.currentTarget, more = body.querySelector(".smm-more");
        const open = more.hasAttribute("hidden");
        if (open) more.removeAttribute("hidden"); else more.setAttribute("hidden", "");
        btn.classList.toggle("is-open", open);
        btn.firstChild.textContent = open ? "Hide info " : "See more info ";
      });
      // Pipeline advance (a step = move to that stage)
      body.querySelectorAll("[data-stage]").forEach((s) => s.addEventListener("click", () => moveToStage(r, s.getAttribute("data-stage"))));
      // Move to next stage
      body.querySelector("[data-move]")?.addEventListener("click", (e) => moveToStage(r, e.currentTarget.getAttribute("data-move")));
      // Mark lost
      body.querySelector("[data-lost]")?.addEventListener("click", () => setStage(r, "lost"));
      // Delete card (test cleanup)
      body.querySelector("[data-delcard]")?.addEventListener("click", () => deleteCard(r));
      // Client status
      body.querySelectorAll("[data-cstatus]").forEach((b) => b.addEventListener("click", () => setClientStatus(r, b.getAttribute("data-cstatus"))));
      // Engagement, channels & platforms (autosave)
      body.querySelectorAll("[data-ef]").forEach((el) => el.addEventListener("change", () => saveEngagement(r, el.getAttribute("data-ef"), el.value)));
      body.querySelectorAll("[data-plat]").forEach((el) => el.addEventListener("change", () => savePlatforms(r)));
      // Payments — Direct Debit toggle + date
      body.querySelectorAll("#dd-toggle [data-dd]").forEach((b) => b.addEventListener("click", () => setDirectDebit(r, b.getAttribute("data-dd") === "yes")));
      body.querySelectorAll("#ibi-toggle [data-ibi]").forEach((b) => b.addEventListener("click", () => setInterBrand(r, b.getAttribute("data-ibi") === "yes")));
      renderCrmRow(r);
      body.querySelector("#dd-date")?.addEventListener("change", (e) => saveDdDay(r, Number(e.target.value)));
      // Tabs
      body.querySelectorAll("[data-tab]").forEach((b) => b.addEventListener("click", () => {
        activeTab = b.getAttribute("data-tab");
        body.querySelectorAll("[data-tab]").forEach((x) => x.classList.toggle("is-active", x === b));
        ["notes", "emails", "files", "invoices", "insights"].forEach((t) => { const p = $("smm-panel-" + t); if (p) p.hidden = t !== activeTab; });
        if (activeTab === "insights") loadInsights(r);
      }));
      // Correspondence
      loadThread(r);
      if (activeTab === "insights") loadInsights(r);
    }

    function smmStatus(msg, ok) { const s = $("smm-cd-status"); if (s) { s.textContent = msg; s.style.color = ok ? "#2e6b40" : "#a3372b"; } }

    async function linkAccount(r, force) {
      const btn = $("smm-file-body").querySelector("[data-linkacct]");
      if (isDemo(r)) { r.account_user_id = "demo"; openFile(r.id); return; }
      if (!WORKER) { smmStatus("Connect the Worker to link accounts.", false); return; }
      if (btn) { btn.disabled = true; btn.textContent = "Linking…"; }
      const reset = () => { if (btn) { btn.disabled = false; btn.textContent = "Link to hub account"; } };
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/smm/link`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id, force: !!force }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok && !j.noAccount && !j.nameMismatch) throw new Error(j.error || "Couldn't link the account.");
        // No hub account yet → offer to invite them to create one.
        if (j.noAccount) {
          reset();
          if (confirm(`No member hub account exists for ${j.email} yet.\n\nSend them an invite to create one? They'll get a branded email with a link to set their password and open their account.`)) {
            inviteAccount(r);
          } else {
            smmStatus(`No hub account for ${j.email} yet — invite not sent.`, false);
          }
          return;
        }
        // The email's account is under a different name → confirm it's them.
        if (j.nameMismatch) {
          reset();
          if (confirm(`Careful — the member hub account for ${j.email} is under "${j.account_name || "(no name)"}", but this card is "${j.card_name}".\n\nAre you sure this is the same person? Click OK to link anyway.`)) {
            linkAccount(r, true);
          } else {
            smmStatus("Link cancelled — the names didn't match.", false);
          }
          return;
        }
        r.account_user_id = j.user_id;
        smmStatus(`Linked to ${j.linked_email} — their reports will now show on the member hub.`, true);
        openFile(r.id);
      } catch (e) {
        reset();
        smmStatus(e.message || "Couldn't link the account.", false);
      }
    }

    async function inviteAccount(r) {
      if (isDemo(r)) { r.account_user_id = "demo"; smmStatus("Invite sent (demo).", true); openFile(r.id); return; }
      if (!WORKER) { smmStatus("Connect the Worker to send invites.", false); return; }
      smmStatus("Sending invite…", true);
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/smm/invite`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id }) });
        const j = await res.json().catch(() => ({}));
        if (j.user_id) r.account_user_id = j.user_id;
        if (j.emailFailed) { smmStatus("Account linked, but the invite email didn't send — try again shortly.", false); openFile(r.id); return; }
        if (!res.ok || !j.ok) throw new Error(j.error || "Couldn't send the invite.");
        smmStatus(`Invite sent to ${j.invited} — they'll set a password and their account will be linked.`, true);
        openFile(r.id);
      } catch (e) {
        smmStatus(e.message || "Couldn't send the invite.", false);
      }
    }

    function startEditName(r) {
      const h = $("smm-file-body").querySelector(".smm-file-name");
      h.innerHTML = `<input class="smm-name-input" value="${esc(nameOf(r))}" />`;
      const inp = h.querySelector("input"); inp.focus(); inp.select();
      let done = false;
      const save = async () => { if (done) return; done = true; const v = inp.value.trim(); if (v && v !== nameOf(r)) await saveName(r, v); renderBoard(); openFile(r.id); };
      inp.addEventListener("keydown", (e) => { if (e.key === "Enter") inp.blur(); if (e.key === "Escape") { done = true; openFile(r.id); } });
      inp.addEventListener("blur", save);
    }
    async function saveName(r, v) {
      r.full_name = v; const parts = v.split(/\s+/); r.first_name = parts.shift() || v; r.last_name = parts.join(" ") || null;
      if (!isDemo(r)) { try { await supabase.from("smm_leads").update({ full_name: v, first_name: r.first_name, last_name: r.last_name }).eq("id", r.id); } catch (_) {} }
    }
    async function saveContact(r, field, value) {
      const v = value.trim();
      const s = $("smm-cd-status"); if (s) s.textContent = "Saving…";
      if (field === "full_name") {
        r.full_name = v; const parts = v.split(/\s+/); r.first_name = parts.shift() || v; r.last_name = parts.join(" ") || null;
        const t = $("smm-file-body").querySelector(".smm-name-text"); if (t) t.textContent = v || "—";
        if (!isDemo(r)) { try { await supabase.from("smm_leads").update({ full_name: v || null, first_name: r.first_name || null, last_name: r.last_name }).eq("id", r.id); } catch (_) {} }
      } else {
        r[field] = v || null;
        if (!isDemo(r)) { try { await supabase.from("smm_leads").update({ [field]: v || null }).eq("id", r.id); } catch (_) {} }
      }
      if (s) s.textContent = isDemo(r) ? "Saved (demo)." : "Saved.";
      renderBoard();
    }
    // Numeric data-ef fields need a real JSON number, not the trimmed string
    // every other field sends — PostgREST rejects a JSON string against a
    // numeric column.
    const NUMERIC_EF_FIELDS = new Set(["contracted_hours_per_month"]);
    async function saveEngagement(r, field, value) {
      const raw = value.trim();
      const v = NUMERIC_EF_FIELDS.has(field) ? (raw === "" ? null : Number(raw)) : (raw || null);
      r[field] = v;
      const s = $(/_url$/.test(field) ? "smm-chan-status" : "smm-eng-status"); if (s) s.textContent = "Saving…";
      if (isDemo(r)) { if (s) s.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ [field]: v }).eq("id", r.id); if (s) s.textContent = "Saved."; }
      catch (_) { if (s) s.textContent = "Couldn't save."; }
    }
    // Inter-brand invoice: this client's work is billed to another TEG brand
    // rather than to them. Same shape as the direct-debit toggle.
    // Which SMM tag belongs on this person's contact. The tag framework treats
    // a client status as superseding the lead tags (normalize_contact_tags drops
    // "Interest: SMM" once any "SMM-Status:" is present), so a client gets their
    // status and only a not-yet-client gets the interest tag.
    const SMM_STATUS_TAG = { active: "SMM-Status: Active", paused: "SMM-Status: Paused", ended: "SMM-Status: Ended" };
    const smmTagFor = (r) => SMM_STATUS_TAG[r.client_status] || "Interest: SMM";

    // Is this social client in the CRM? Only website enquiries create a contact;
    // anyone added here by hand does not exist in contacts at all, which is how
    // James ended up with clients missing from the CRM.
    async function renderCrmRow(r) {
      const row = $("smm-crm-row"); if (!row) return;
      const email = (r.email || "").trim().toLowerCase();
      if (!email) { row.innerHTML = `<span class="smm-crm-note">Add an email to link this client to the CRM.</span>`; return; }
      row.innerHTML = `<span class="smm-crm-note">Checking the CRM…</span>`;
      let existing = null;
      try {
        const { data } = await supabase.from("contacts").select("id").ilike("email", email).limit(1);
        existing = data && data[0];
      } catch (_) { /* fall through to offering the button */ }
      row.innerHTML = existing
        ? `<a class="smm-btn smm-btn--sm smm-btn--ghost" href="/admin/contacts?contact=${encodeURIComponent(existing.id)}">Open in contacts →</a>
           ${r.client_status ? `<button type="button" class="smm-btn smm-btn--sm smm-btn--ghost" id="smm-synccontact">Update tags</button>` : ""}
           <span class="smm-crm-note">In the CRM${r.client_status ? ` — should be tagged ${smmTagFor(r)}` : ""}.</span>`
        : `<button type="button" class="smm-btn smm-btn--sm" id="smm-mkcontact">Create contact</button>
           <span class="smm-crm-note">Not in the CRM yet.</span>`;
      $("smm-mkcontact")?.addEventListener("click", () => createContact(r));
      $("smm-synccontact")?.addEventListener("click", async (e) => {
        const b = e.currentTarget; b.disabled = true; b.textContent = "Updating…";
        try { await pushClientStatus(r, r.client_status); b.textContent = "Updated"; }
        catch (_) { b.disabled = false; b.textContent = "Update tags"; alert("Couldn't update that contact."); }
      });
    }

    async function createContact(r) {
      const btn = $("smm-mkcontact"); if (btn) { btn.disabled = true; btn.textContent = "Creating…"; }
      const email = (r.email || "").trim().toLowerCase();
      try {
        // upsert_contact rather than a plain insert: it is the same path every
        // other route uses, so tag normalisation and the duplicate-name review
        // behave identically however a contact arrives.
        const { data, error } = await supabase.rpc("upsert_contact", {
          p_email: email,
          p_first_name: r.first_name || (nameOf(r) !== "—" ? String(nameOf(r)).split(" ")[0] : null) || null,
          p_last_name: r.last_name || (nameOf(r) !== "—" ? String(nameOf(r)).split(" ").slice(1).join(" ") : null) || null,
          p_phone: r.phone || null,
          p_company: r.business || null,
          p_source: "smm_admin",
          p_lifecycle: null,
          p_marketing_opt_in: null,   // null, not false - nobody has agreed to anything here
          p_tags: [smmTagFor(r)],
        });
        if (error) throw error;
        const id = Array.isArray(data) ? data[0] : data;
        if (!id) throw new Error("No contact was created.");
        // Reuse the existing status sync rather than duplicating its rules: it
        // also sets lifecycle to customer for an active client.
        if (r.client_status) { try { await pushClientStatus(r, r.client_status); } catch (_) {} }
        // Hand them straight to the card so the rest can be filled in now.
        location.href = `/admin/contacts?contact=${encodeURIComponent(id)}`;
      } catch (e) {
        if (btn) { btn.disabled = false; btn.textContent = "Create contact"; }
        alert("Couldn't create that contact: " + (e.message || e));
      }
    }

    async function setInterBrand(r, on) {
      r.inter_brand_invoice = on;
      document.querySelectorAll("#ibi-toggle [data-ibi]").forEach((b) => b.classList.toggle("is-active", (b.getAttribute("data-ibi") === "yes") === on));
      const st = $("smm-eng-status"); if (st) st.textContent = "Saving…";
      if (isDemo(r)) { if (st) st.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ inter_brand_invoice: on }).eq("id", r.id); if (st) st.textContent = "Saved."; }
      catch (e) {
        // Almost always the column not existing yet, and the raw Postgres
        // message doesn't say what to do about it.
        if (st) st.textContent = /inter_brand_invoice/i.test(e.message || "") ? "Needs supabase/smm_manager_and_interbrand.sql" : "Couldn't save.";
      }
    }

    async function setDirectDebit(r, on) {
      r.direct_debit = on;
      document.querySelectorAll("#dd-toggle [data-dd]").forEach((b) => b.classList.toggle("is-active", (b.getAttribute("data-dd") === "yes") === on));
      const st = $("smm-eng-status"); if (st) st.textContent = "Saving…";
      // Re-render the Invoicing panel so it switches to/from the DD view immediately.
      const pInv = $("smm-panel-invoices"); if (pInv) renderInvoicing(r, pInv, r._lastDocs || [], false, r._lastWarn || null);
      if (isDemo(r)) { if (st) st.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ direct_debit: on, direct_debit_day: r.direct_debit_day || null }).eq("id", r.id); if (st) st.textContent = "Saved."; }
      catch (_) { if (st) st.textContent = "Couldn't save."; }
    }
    async function saveDdDay(r, day) {
      // "" is the N/A option — stored as null, not as a day.
      day = day ? Number(day) : null;
      r.direct_debit_day = day;
      const st = $("smm-eng-status"); if (st) st.textContent = "Saving…";
      if (isDemo(r)) { if (st) st.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ direct_debit_day: day }).eq("id", r.id); if (st) st.textContent = "Saved."; }
      catch (_) { if (st) st.textContent = "Couldn't save."; }
    }
    async function savePlatforms(r) {
      const arr = [...document.querySelectorAll("[data-plat]")].filter((c) => c.checked).map((c) => c.getAttribute("data-plat"));
      r.platforms = arr;
      const s = $("smm-eng-status"); if (s) s.textContent = "Saving…";
      if (isDemo(r)) { if (s) s.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ platforms: arr }).eq("id", r.id); if (s) s.textContent = "Saved."; }
      catch (_) { if (s) s.textContent = "Couldn't save."; }
    }

    // ---------- Stage moves ----------
    function moveToStage(r, stageKey) {
      if (!stageKey) return;
      if (stageKey === "meeting_set") { openMeeting(r); return; }
      if (stageKey === stageOf(r)) return;
      setStage(r, stageKey);
    }
    async function deleteCard(r) {
      if (!confirm(`Delete "${nameOf(r)}" entirely? This permanently removes the card and its notes, files and invoices. It can't be undone.`)) return;
      if (!isDemo(r)) {
        if (!WORKER) { alert("Connect the Worker to delete."); return; }
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER}/smm/lead?id=${encodeURIComponent(r.id)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } });
          if (!res.ok) { const j = await res.json().catch(() => ({})); throw new Error(j.error || "Delete failed."); }
        } catch (e) { alert(e.message || "Couldn't delete."); return; }
      }
      all = all.filter((x) => x.id !== r.id);
      closeFile();
      renderBoard();
    }
    async function setStage(r, stage) {
      r.pipeline_stage = stage;
      if (!isDemo(r)) { try { await supabase.from("smm_leads").update({ pipeline_stage: stage }).eq("id", r.id); } catch (_) {} }
      if (stage === "active_client") { if (!r.client_status) r.client_status = "active"; pushClientStatus(r, "active"); }
      renderBoard();
      if (stage === "lost") closeFile(); else openFile(r.id);
    }
    async function pushClientStatus(r, status) {
