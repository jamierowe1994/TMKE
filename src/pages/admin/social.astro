    async function loadSmmInvoices(r) {
      const wrap = $("siv-list"); if (!wrap) return;
      const fmtDate = (d) => { if (!d) return "—"; try { return new Date(d + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); } catch (_) { return d; } };
      const rowsHtml = (list) => list.length ? list.map((v) => `<div class="siv-row"><span class="siv-num">${esc(v.number)}</span><span class="siv-due">Due ${fmtDate(v.due_date)}</span><span class="siv-amt2">${gbp(v.total_pence)}</span><span class="smm-inv-status ${v.status === "paid" ? "is-paid" : "is-due"}">${esc(v.status)}</span><span class="siv-row-tools">${v.status !== "paid" && v.status !== "void" ? `${v.bill_to_email ? `<button type="button" class="smm-mini is-primary" data-sivsend="${esc(v.id)}">${v.status === "sent" ? "Resend" : "Send"}</button>` : ""}<button type="button" class="smm-mini" data-sivpaid="${esc(v.id)}">Mark paid</button>` : ""}<button type="button" class="smm-mini" data-sivvoid="${esc(v.id)}">Void</button><button type="button" class="smm-mini is-danger" data-sivdel="${esc(v.id)}">Delete</button></span></div>`).join("") : `<p class="smm-doc-empty">No invoices raised yet.</p>`;
      if (isDemo(r)) { sivInvoices = r._invoices || []; wrap.innerHTML = rowsHtml(sivInvoices); }
      else if (!WORKER) { wrap.innerHTML = '<p class="smm-doc-empty">Connect the Worker to raise invoices.</p>'; return; }
      else {
        try { const token = await authToken(); const res = await fetch(`${WORKER}/invoicing/invoices?booking_id=${encodeURIComponent(r.id)}`, { headers: { Authorization: "Bearer " + token } }); const j = await res.json().catch(() => ({})); sivInvoices = (j && j.invoices) || []; wrap.innerHTML = rowsHtml(sivInvoices); }
        catch (_) { wrap.innerHTML = '<p class="smm-doc-empty">Couldn\'t load invoices.</p>'; }
