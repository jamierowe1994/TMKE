    function onbCallState(r) {
      const o = onbState(r);
      const msgs = ((r._thread || {}).messages) || [];
      if (sfCallNotes(msgs, "onboarding")) return { k: "notes", done: true };
      if (o.ask.call === "skip") return { k: "skip", done: true };
      if (o.done.call) return { k: "notes", done: true };
      const ev = (current === r && sfData.events) || [];
      const since = (ev.filter((e) => e.stage === "onboarding").map((e) => e.reached_at).sort().slice(-1)[0]) || null;
      const at = r.meeting_at && (since ? new Date(r.meeting_at) >= new Date(new Date(since).getTime() - 864e5) : new Date(r.meeting_at) > new Date()) ? r.meeting_at : null;
      if (at && new Date(at) > new Date()) return { k: "waiting", at, done: false };
      if (at) return { k: "held", at, done: false };
