          !sent ? "" : chased[1] ? li(1, `Chased again ${esc(sfDay(chased[1].created_at))}`) : li(0, `Chase again on ${esc(sfDay(sfAddDays(sent, 5)))}`),
          reply ? li(1, `Replied ${esc(sfDay(reply.created_at))}`) : chased.length >= 2 ? li(0, "No reply since") : "", fu].filter(Boolean);
        return box(lateH(reply ? `${name1} replied. Next: the pricing call` : "Waiting on their reply"), items,
          sfHb(false, 'data-sf="note-add"', "Add an update") + (r.email ? sfHb(false, 'data-sf="chase"', "Chase") : "") + sfHb(true, 'data-sf="book-call"', "Book the pricing call"), lateC);
      }
      if (st === "pricing_call") {
        const held = r.meeting_at && new Date(r.meeting_at) <= new Date();
        const sent = F.reached("proposal_sent") || (F.prep && F.prep.created_at);
        const items = [sent ? li(1, `Proposal sent ${esc(sfDay(sent))}`) : "", r.meeting_at ? li(1, `Pricing call ${held ? "held" : "booked for"} ${esc(held ? sfDay(r.meeting_at) : sfWhen(r.meeting_at))}`) : li(0, "Pricing call not booked"),
          held ? li(!!F.pricing, F.pricing ? "Call notes written" : "Call notes not written yet") : "", r.meeting_at ? li(0, `Contract out by ${esc(sfDate(sfAddWork(r.meeting_at, 1)).toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" }))}`) : "", fu].filter(Boolean);
        return box(lateH(r.meeting_at && !held ? `Pricing call on ${esc(sfWhen(r.meeting_at))}` : "Next: send the contract"), items,
          (r.meeting_at ? "" : sfHb(false, 'data-sf="book-call"', "Book the pricing call")) + sfHb(false, 'data-sf="callnotes" data-id="pricing"', "Call notes") + sfHb(false, 'data-sf="quote"', "Price it") + sfHb(true, 'data-sf-force="contract_signed"', "Mark contract sent"), lateC);
      }
      if (st === "contract_signed") {
        const sent = F.reached("contract_signed");
        const items = [sent ? li(1, `Contract sent ${esc(sfDay(sent))}`) : li(1, "Contract sent"),
          F.agreement ? li(1, `Signed copy back ${esc(sfDay(F.agreement.created_at))}`) : li(0, sent ? `Signed: chase on ${esc(sfDay(sfAddDays(sent, 3)))}, then ${esc(sfDay(sfAddDays(sent, 5)))}` : "Signed copy back"), fu].filter(Boolean);
        return box(lateH(F.agreement ? "Signed. Next: onboarding" : "Contract out for signing"), items,
          (F.agreement ? "" : (r.email ? sfHb(false, 'data-sf="chase" data-id="contract"', "Chase") : "") + sfHb(false, 'data-sf="file-add" data-cat="agreement"', "Upload signed copy")) + sfHb(true, 'data-sf-force="onboarding"', "Start onboarding"), lateC);
      }
      if (st === "onboarding") {
        // Two rows at most (Dani, 5 Nov): the contract, the first invoices,
        // accounts, approvals and the first shoot.
        const o = onbState(r), cctx = onbCtx(r), item = (k) => { const it = ONB_ITEMS.find((x) => x.key === k); return it && (!it.when || it.when(r, o)) ? onbDone(r, it, o, cctx) : null; };
        const invsOut = (sfData.invoices || []).filter((v) => v.status !== "void" && v.status !== "draft").length > 0;
        const items = [li(!!F.agreement, F.agreement ? `Signed contract back ${esc(sfDay(F.agreement.created_at))}` : "Signed contract on file"),
          (() => { const oi = sfOnbInvs(sfData.invoices).filter((v) => v.status !== "draft"); const paid = oi.length && oi.every((v) => v.status === "paid");
            return li(!!oi.length, paid ? "Onboarding invoices paid" : oi.length ? "Onboarding invoices sent, waiting for payment" : "Onboarding invoices: outstanding"); })(),
          (() => { const cs = onbCallState(r); return li(cs.done, cs.k === "waiting" ? `Waiting for the onboarding call, ${esc(sfWhen(cs.at))}` : cs.k === "held" ? "Onboarding call held: write the notes" : cs.k === "skip" ? "Onboarding call skipped" : cs.done ? "Onboarding call done" : "Onboarding call: book it or skip it"); })(),
          li(!!item("access"), "Accounts linked"),
          item("approval") === null ? "" : li(!!item("approval"), "Approval process agreed"),
