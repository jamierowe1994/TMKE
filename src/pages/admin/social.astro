    /* The file picker's button in the house strip, not the browser's grey one (Dani, 5 Nov). */
    #smm-file input.sf-file { font-size: 14px; color: var(--sf-tx); }
    #smm-file input.sf-file::file-selector-button { height: 30px; margin-right: 12px; padding: 0 14px; border: 1px solid var(--sf-edge); border-radius: 4px; background: #fff; color: var(--sf-ink); cursor: pointer; font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
    #smm-file input.sf-file::file-selector-button:hover { border-color: var(--sf-wine); color: var(--sf-wine); }
    #smm-file input.sf-file::-webkit-file-upload-button { height: 30px; margin-right: 12px; padding: 0 14px; border: 1px solid var(--sf-edge); border-radius: 4px; background: #fff; color: var(--sf-ink); cursor: pointer; font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
    .sf-plat { display: flex; flex-wrap: wrap; gap: 6px; }
    #smm-file .sf-plat label { display: inline-flex; align-items: center; gap: 6px; height: 30px; padding: 0 10px; border: 1px solid var(--sf-edge); border-radius: 4px; cursor: pointer; }
    #smm-file .sf-plat input, #smm-file .sf-check input, #smm-file .sf-stat input { margin: 0; accent-color: var(--sf-wine); }
    #smm-file .sf-check { display: flex; align-items: center; gap: 8px; margin: 10px 0 4px; cursor: pointer; }
    .sf-stat { display: grid; gap: 8px; margin: 8px 0 6px; }
    #smm-file .sf-stat label { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 10px; align-items: start; padding: 10px 12px; border: 1px solid var(--sf-edge); border-radius: 4px; cursor: pointer; }
    #smm-file .sf-stat label:has(input:checked) { border-color: var(--sf-wine); background: var(--sf-soft); }
    #smm-file .sf-stat b { display: block; color: var(--sf-ink); }
    #smm-file .sf-stat small { display: block; margin-top: 2px; color: var(--sf-tx); }
    .sf-inline { display: flex; gap: 8px; padding: 10px 0 4px; }
    #smm-file .sf-read { margin: 12px 0 0; padding: 14px 16px; border: 1px solid var(--sf-edge); border-radius: 4px; color: var(--sf-ink); line-height: 1.45; white-space: pre-line; overflow-wrap: anywhere; }
    .sf-mailhead .sf-pr { grid-template-columns: 5em minmax(0, 1fr); }
    #smm-file .sf-lock { display: block; margin: 0 0 14px; padding: 12px 14px; border-radius: 4px; background: var(--sf-linen); color: var(--sf-ink); }
    #smm-file .sf-lock b { color: var(--sf-wine); }
    .sf-ins { list-style: none; margin: 0; padding: 0; }
    #smm-file .sf-ins li { display: grid; grid-template-columns: 18px minmax(0, 1fr); gap: 8px; padding: 9px 0; border-top: 1px solid var(--sf-line); }
    #smm-file .sf-ins li:first-child { border-top: 0; }
    .sf-dot { display: block; width: 7px; height: 7px; margin-top: 6px; border-radius: 50%; background: var(--sf-wine); }
    /* Every invoice, in the house table. */
    .sf-tbl { border: 1px solid var(--sf-edge); border-radius: 4px; overflow: hidden; }
    .sf-tbl-h, .sf-tbl-r { display: grid; grid-template-columns: 6.5em 9em 6.5em minmax(0, 1fr) auto; column-gap: 14px; align-items: center; padding: 0 14px; }
    .sf-tbl-h { height: 30px; background: var(--sf-wine); }
    #smm-file .sf-tbl-h span { color: #fff; font-size: 11px; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; }
    .sf-tbl-r { height: 42px; border-top: 1px solid var(--sf-line); }
    .sf-tbl-h + .sf-tbl-r { border-top: 0; }
    .sf-tbl-r > span { min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .sf-tbl .num { text-align: right; font-variant-numeric: tabular-nums; }
    .sf-tbl-a { display: inline-flex; gap: 14px; justify-content: flex-end; }
    /* The older panels, lent to a pop-out, in the house style. */
    #sf-pop-b .smm-panel-head h4, #sf-pop-b .siv-list-head { margin: 14px 0 8px; font-family: var(--serif); font-weight: 300; font-size: 19px; letter-spacing: -0.04em; text-transform: none; color: var(--sf-ink); }
    #sf-pop-b :is(.smm-btn, .admin-btn) { height: 30px; padding: 0 14px; border-radius: 4px; border: 1px solid var(--sf-edge); background: #fff; color: var(--sf-ink); box-shadow: none; font-size: 11px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; }
    #sf-pop-b :is(.smm-btn--primary, .admin-btn-primary) { background: var(--sf-wine); border-color: var(--sf-wine); color: #fff; }
    #sf-pop-b :is(input[type="text"], input[type="email"], input[type="date"], input[type="month"], input[type="number"], select, textarea):not(.sf-in) { border: 1px solid var(--sf-edge); border-radius: 4px; box-shadow: none; }
    #sf-pop-b .ri-subtab, #sf-pop-b .ri-month { font-size: 14px; }
    /* The pop-out has the title already. */
    :is(#sf-ins-slot, #sf-vid-slot, #sf-oneoff-slot) .smm-panel-head > h4 { display: none; }
    :is(#sf-ins-slot, #sf-vid-slot, #sf-oneoff-slot) .smm-panel-head { justify-content: flex-end; margin-top: 0; }
  </style>

  <script>
    import { requireAdmin, isManagementUser } from "../../lib/admin-gate.js";
    import { supabase } from "../../lib/supabase.js";
    /* Only management raise, change, void or mark invoices paid. Everyone
       else sees a client's invoices, opens them and resends a sent one as it
       was (Danielle, 28 Oct 2026); the Worker holds the same line. */
    const CAN_MONEY = import.meta.env.DEV ? Promise.resolve(true)
      : supabase.auth.getSession().then(({ data }) => isManagementUser(data && data.session && data.session.user)).catch(() => false);
    import { renderTab, renderTrends, MONTHS as RI_MONTHS } from "../../lib/report-insights.js";
    import { extractPostLinks, matchLinks } from "../../lib/socialpilot-pdf.js";
    import { HEADLINE_METRICS, DEFAULT_HEADLINE, defaultHeadline, headlineOptions, INSIGHT_CATEGORIES, normaliseInsight, PLATFORM_LABELS, platformsOf, itemPlatform, pointBlocks } from "../../lib/report-metrics.js";
    import { DEMO_REPORTS } from "../../lib/report-insights-demo.js";
    import { TEG_BRANDS, TEG_ACCOUNTS_EMAIL, VIDEO_INVOICE_ROUTES } from "../../lib/videography-config.js";
    import { renderInvoiceHtml } from "../../lib/invoice-render.js";
    import { invoiceEmail } from "../../lib/invoice-email.js";
    import { SOCIAL_SERVICES as PKG_SERVICES, SOCIAL_EXTRAS as SOCIAL_EXTRAS_C } from "../../lib/smm-config.js";
    import { mergeFigures, priceOf, fitBudget, score, sell, PLANNING_STEPS, PLATFORM_STEPS, POST_TYPES, PLATFORMS as PC_PLATFORMS, MGMT_PACKAGES, SAS_PACKAGES } from "../../lib/smm-calc.js";
    import { listVideoNotes, addVideoNote, setVideoNoteDone, deleteVideoNote, noteAuthor, VIDEO_NOTES_MISSING } from "../../lib/video-notes.js";

    const STAGES = [
      // Ahead of Inquiry: they have asked to be told when a space opens, which
      // is not the same as having asked to buy.
      { key: "waitlist", label: "Waitlist" },
      { key: "inquiry", label: "Enquiry" },
      // Danielle's process (5 Nov 2026): a discovery call, the proposal, a
      // pricing call, then the contract.
      { key: "meeting_set", label: "Discovery call" },
      { key: "proposal_sent", label: "Proposal sent" },
      { key: "pricing_call", label: "Pricing call" },
      { key: "contract_signed", label: "Contract sent" },
      { key: "onboarding", label: "Onboarding" },
      { key: "active_client", label: "Active client" },
    ];
    const STAGE_INDEX = Object.fromEntries(STAGES.map((s, i) => [s.key, i]));
    // Legacy stages map onto the nearest current column.
    const STAGE_ALIAS = { contract_sent: "proposal_sent", brochure_downloaded: "inquiry", general_enquiry: "inquiry", discovery_call_booked: "inquiry", waitlist_joined: "waitlist" };
    const KIND_LABEL = { enquiry: "Enquiry", brochure: "Brochure", discovery: "Discovery call", manual: "Manual" };
    // Ended is now Lost (Danielle, 4 Nov 2026): one end state, with "was a
    // client" kept for anyone who'd become one. "ended" stays for old cards.
    const CLIENT_STATUS = { active: "Active", paused: "Paused", ended: "Lost", internal: "Internal" };
    const wasClient = (r) => r.lost_from_stage === "active_client" || r.client_status === "ended";
    const NEXT_LABEL = { meeting_set: "Book the discovery call", proposal_sent: "Mark proposal sent", pricing_call: "Book the pricing call", contract_signed: "Mark contract sent", onboarding: "Start onboarding", active_client: "Make client active" };
    const PLATFORMS = ["Instagram", "Facebook", "LinkedIn", "YouTube", "TikTok"];

    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    const nameOf = (r) => (r.full_name || `${r.first_name || ""} ${r.last_name || ""}`).trim() || "—";
    function fmtWhen(iso) {
      if (!iso) return "";
      const d = new Date(iso), diff = (Date.now() - d) / 1000;
      if (diff < 3600) return Math.max(1, Math.floor(diff / 60)) + "m";
      if (diff < 86400) return Math.floor(diff / 3600) + "h";
      if (diff < 604800) return Math.floor(diff / 86400) + "d";
      return d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
    }
    const fmtDateTime = (iso) => { try { return new Date(iso).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }); } catch (_) { return ""; } };
    function stageOf(r) {
      let s = r.pipeline_stage;
      if (s && STAGE_ALIAS[s]) s = STAGE_ALIAS[s];
      return s && STAGE_INDEX[s] != null ? s : "inquiry";
    }

    // Icons
    const COPY_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    const PENCIL_SVG = '<svg viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>';
    const PLUS_SVG = '<svg viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>';
    const CHEV_SVG = '<svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg>';
    const EMAIL_SVG = '<svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>';
    const PHONE_SVG = '<svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>';
    const BIZ_SVG = '<svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></svg>';
    const DOC_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>';
    const CAL_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg>';
    const USER_SVG = '<svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const SMM_CATS = [["agreement", "Contract"], ["prep", "Proposal"], ["strategy", "Strategy"], ["brand", "Brand assets"], ["content_plan", "Content plan"], ["insights_report", "Insights report"], ["delivery", "Deliverables"], ["invoice", "Invoice"], ["other", "Other"]];
    const catLabel = (c) => (SMM_CATS.find((x) => x[0] === c) || [, "Document"])[1];
    const isDemo = (r) => String(r.id).startsWith("demo");
    async function authToken() {
      try {
        let session = (await supabase.auth.getSession()).data.session;
        // Refresh if the token is missing or expiring within 60s, so uploads
        // don't fail with "Unauthorised" on a stale session.
        if (!session || (session.expires_at && session.expires_at * 1000 < Date.now() + 60000)) {
          try { const r = await supabase.auth.refreshSession(); if (r.data && r.data.session) session = r.data.session; } catch (_) {}
        }
        return (session && session.access_token) || "";
      } catch (_) { return ""; }
    }

    let ME = "";            // the signed-in admin's email — a note belongs to whoever wrote it
    let all = [], kindFilter = "all", q = "", showLost = false, current = null, activeTab = "notes", notesTab = "pkg";
    // Where the admin top bar ends, for the pop-outs to start below it.
    const setSmmTop = () => { const t = document.querySelector(".ash-top"); document.documentElement.style.setProperty("--smm-top", `${t ? Math.max(0, Math.round(t.getBoundingClientRect().bottom)) : 0}px`); };
    setSmmTop(); window.addEventListener("resize", setSmmTop);
    const NOTE_TABS = [["pkg", "Package details"], ["notes", "Notes"], ["activity", "Client activity"], ["files", "Files"]];

    // ---------- Board ----------
    function visible() {
      return all
        .filter((r) => showLost ? true : r.pipeline_stage !== "lost" && r.status !== "spam")
        .filter((r) => {
          const f = kindFilter;
          if (f === "all") return true;
          if (f === "enquiry" || f === "brochure") return r.kind === f;
          return stageOf(r) === f; // meeting_set (Discovery calls) / proposal_sent / contract_signed / onboarding / active_client (Clients)
        })
        .filter((r) => !q || (nameOf(r) + " " + (r.email || "") + " " + (r.business || "")).toLowerCase().includes(q));
    }
    // Shared by the filter chips and any "See all" card — both just narrow
    // the board to one kind/stage via the same kindFilter var.
    function goToFilter(key) {
      kindFilter = key;
      document.querySelectorAll(".smm-chip").forEach((c) => c.classList.toggle("is-active", c.getAttribute("data-filter") === key));
      renderBoard();
    }
    // The board (Dani's 4 Nov mock-up, built 5 Nov 2026): a wine strip per stage
    // with its cards in a grid; empty stages fold into one "Nothing in" line that
    // still takes a drop; Active clients show 8 until See all.
    const bdOpen = {};
    // Filters, with how many each catches (Dani, 5 Nov 2026: as Videography's).
    const BD_FILTERS = [
      ["all", "All", () => true],
      ["calls", "Calls booked", (r) => r.meeting_at && new Date(r.meeting_at) > new Date()],
      ["nomgr", "No manager", (r) => !r.social_media_manager && stageOf(r) !== "waitlist"],
      ["proposed", "Proposals out", (r) => ["proposal_sent", "pricing_call"].includes(stageOf(r))],
      ["onboarding", "Onboarding", (r) => stageOf(r) === "onboarding"],
      ["paused", "Paused or leaving", (r) => stageOf(r) === "active_client" && (r.client_status === "paused" || !!r.leaving_on)],
    ];
    let bdFilter = "all";
    function drawBdChips(base) {
      const host = $("bd-chips"); if (!host) return;
      host.innerHTML = BD_FILTERS.map(([k, l, f]) => `<button type="button" data-bdf="${k}" aria-pressed="${bdFilter === k}">${esc(l)}${k === "all" ? "" : ` <i>${base.filter((r) => r.pipeline_stage !== "lost" && f(r)).length}</i>`}</button>`).join("");
    }
    document.addEventListener("click", (e) => { const b = e.target.closest && e.target.closest("[data-bdf]"); if (!b) return; bdFilter = b.getAttribute("data-bdf"); renderBoard(); });
    function renderBoard() {
      const board = $("smm-board");
      const base = visible();
      drawBdChips(base);
      const pass = (BD_FILTERS.find((f) => f[0] === bdFilter) || BD_FILTERS[0])[2];
      const rows = base.filter((r) => r.pipeline_stage === "lost" || pass(r));
      // Paused clients have their own section under Active clients (Dani, 5 Nov 2026).
      const stages = [...STAGES.map((s) => ({ key: s.key, label: s.key === "active_client" ? "Active clients" : s.label })), { key: "paused", label: "Paused" }, ...(showLost ? [{ key: "lost", label: "Lost" }] : [])];
      const isPaused = (r) => stageOf(r) === "active_client" && r.client_status === "paused";
      const inStage = (k) => k === "lost" ? rows.filter((r) => r.pipeline_stage === "lost")
        : k === "paused" ? rows.filter((r) => r.pipeline_stage !== "lost" && isPaused(r))
        : rows.filter((r) => r.pipeline_stage !== "lost" && stageOf(r) === k && !(k === "active_client" && isPaused(r)));
      let html = "", quiet = [];
      const flush = () => { if (q || bdFilter !== "all") { quiet = []; return; } if (quiet.length) { html += `<div class="bd-quiet"><span>Nothing in</span>${quiet.map((s) => `<span class="bd-quiet-s" data-drop="${s.key}">${esc(s.label)}</span>`).join("")}</div>`; quiet = []; } };
      stages.forEach((s) => {
        let list = inStage(s.key);
        // Internal clients always last among Active clients (Dani, 5 Nov 2026).
        if (s.key === "active_client") list = [...list.filter((r) => r.client_status !== "internal"), ...list.filter((r) => r.client_status === "internal")];
        if (!list.length) { quiet.push(s); return; }
        flush();
        const cap = s.key === "active_client" && !bdOpen[s.key] ? 8 : Infinity;
        const shown = list.slice(0, cap);
        const more = list.length > shown.length ? `<button type="button" class="bd-more" data-bd-more="${s.key}">See all ${list.length}</button>` : (s.key === "active_client" && bdOpen[s.key] && list.length > 8 ? `<button type="button" class="bd-more" data-bd-more="${s.key}">Show fewer</button>` : "");
        html += `<section class="bd-stage"><div class="bd-strip" data-drop="${s.key}"><h2 class="bd-h">${esc(s.label)}<span class="bd-n">${list.length}</span></h2>${more}</div><div class="bd-grid">${shown.map(bdCard).join("")}</div></section>`;
      });
      flush();
      board.innerHTML = rows.length ? html : `<div class="bd-empty">${q || bdFilter !== "all" ? "Nobody matches that. Try All, or clear the search." : "No one here yet."}</div>`;
      const live = rows.filter((r) => r.pipeline_stage !== "lost"), c = live.filter((r) => stageOf(r) === "active_client").length, pz = live.filter(isPaused).length;
      const sum = $("bd-sum"); if (sum) sum.textContent = `${live.length - c} in progress, ${c - pz} active ${c - pz === 1 ? "client" : "clients"}${pz ? `, ${pz} paused` : ""}`;
    }
    const bdR = (k, v) => `<div class="bd-r"><dt>${k}</dt><dd title="${esc(String(v || "").replace(/<[^>]*>/g, ""))}">${v || '<span class="bd-none">—</span>'}</dd></div>`;
    const bdDay = (iso) => { try { return iso ? new Date(String(iso).length <= 10 ? iso + "T12:00:00" : iso).toLocaleDateString("en-GB", { day: "numeric", month: "short" }) : ""; } catch (_) { return ""; } };
    const bdWhen = (iso) => { try { return iso ? new Date(iso).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }).replace(",", "") : ""; } catch (_) { return ""; } };
    function bdCard(r) {
      const st = r.pipeline_stage === "lost" ? "lost" : stageOf(r);
      const pd = r.package_details || {};
      const chip = (cls, t) => `<span class="bd-chip is-${cls}">${esc(t)}</span>`;
      const src = (r.source || KIND_LABEL[r.kind] || "").split(":")[0];
      const tag = st === "lost" ? chip("bad", wasClient(r) ? "Lost, was a client" : "Lost")
        : r.leaving_on ? chip("bad", leavingLabel(r))
        : st === "active_client" ? (r.client_status === "paused" ? chip("wait", "Paused") : r.client_status === "internal" ? chip("plain", "Internal") : chip("good", "Active"))
        : st === "onboarding" ? chip("wait", "Onboarding")
        : chip("plain", src || "Enquiry");
      const mgr = r.social_media_manager ? r.social_media_manager.split(" ")[0] : "";
      const pr = pd.proposed || {};
      let rows;
      if (st === "active_client" || st === "onboarding") {
        rows = bdR("Business", esc(r.business || "")) + bdR("Package", esc([r.package_name, pd.tier ? tierLabel(r.package_name, pd.tier) : ""].filter(Boolean).join(", "))) + bdR(st === "onboarding" ? "Starts" : "Monthly", esc(st === "onboarding" ? bdDay(r.start_date) : (r.price || ""))) + bdR("Managed by", esc(mgr));
      } else if (st === "proposal_sent" || st === "pricing_call" || st === "contract_signed") {
        rows = bdR("Business", esc(r.business || "")) + bdR("Proposed", esc([pr.package ? String(pr.package).split(": ").pop() : "", pr.price !== "" && pr.price != null ? "£" + Number(pr.price).toLocaleString("en-GB") + " a month" : ""].filter(Boolean).join(", "))) + bdR(st === "pricing_call" ? "Pricing call" : "Call", esc(bdWhen(r.meeting_at))) + bdR("Managed by", esc(mgr));
      } else if (st === "lost") {
        rows = bdR("Business", esc(r.business || "")) + bdR("Got as far as", esc(r.lost_from_stage === "active_client" ? "Active client" : ((STAGES.find((s) => s.key === r.lost_from_stage) || {}).label || ""))) + bdR("Lost on", esc(bdDay(r.lost_at))) + bdR("Why", esc(r.lost_reason || ""));
      } else {
        rows = bdR("Business", esc(r.business || "")) + bdR("Enquired", esc(bdDay(r.created_at))) + bdR(st === "meeting_set" ? "Discovery call" : "Call", esc(bdWhen(r.meeting_at))) + bdR("Managed by", esc(mgr));
      }
      // What needs doing, when something obviously does; otherwise the two quick links.
      const warn = st === "lost" ? "" : !r.social_media_manager && st !== "waitlist" ? "No one manages them yet"
        : st === "active_client" && !r.price && r.client_status !== "internal" ? "No monthly fee on the file"
        : st === "proposal_sent" && !pr.package ? "What we proposed isn't filled in" : "";
      const foot = warn ? `<div class="bd-next">${esc(warn)}</div>`
        : `<div class="bd-foot"><button type="button" class="bd-link" data-bd-open>Open file</button>${st === "lost" ? "" : st === "active_client" || st === "onboarding" ? (r.email ? `<button type="button" class="bd-link" data-bd-msg>Send a message</button>` : "") : `<button type="button" class="bd-link" data-bd-meet>${r.meeting_at && new Date(r.meeting_at) > new Date() ? "Move the call" : "Set a meeting"}</button>`}</div>`;
