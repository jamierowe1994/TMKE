    }
    let onbPart = "practical";
    async function saveOnb(r, st) {
      const el = $("smm-onb-status");
      if (isDemo(r)) { if (el) el.textContent = "Saved (demo)."; return; }
      if (el) el.textContent = "Saving…";
      const { error } = await supabase.from("smm_leads").update({ onboarding: r.onboarding }).eq("id", r.id);
      if (el) el.textContent = error ? (/onboarding/.test(error.message || "") ? "Needs supabase/smm_onboarding.sql running first." : "Couldn't save: " + error.message) : "Saved.";
    }
    /* Each automatic item opens where it's filled in, with the field picked
       out; saving or closing there comes back to Onboarding (Dani, 5 Nov 2026). */
    function sfFlash(sel) {
      setTimeout(() => {
        const el = document.querySelector(sel); if (!el) return;
        el.scrollIntoView({ block: "center", behavior: "smooth" });
        if (/^(INPUT|SELECT|TEXTAREA|BUTTON)$/.test(el.tagName)) el.focus({ preventScroll: true });
      }, 60);
    }
    const ONB_GO = {
      contract: (r) => { sfClosePop(); sfReturnTo = "onboarding"; openAddFile(r, { cat: "agreement", name: "" }); },
      proposal: (r) => { sfClosePop(); sfReturnTo = "onboarding"; openAddFile(r, { cat: "prep", name: "" }); },
      package: () => { sfReturnTo = "onboarding"; sfOpen("edit", "package"); },
      start: () => { sfReturnTo = "onboarding"; sfOpen("edit"); sfFlash("#sfe-start"); },
      manager: () => { sfReturnTo = "onboarding"; sfOpen("edit"); sfFlash("#sfe-mgr"); },
      billing: (r) => { r._onbInvoices = null; sfReturnTo = "onboarding"; sfInvTab = "monthly"; sfEditing = !!sfData.recurring; sfOpen("invoice"); },
      hub: () => { sfReturnTo = "onboarding"; sfEditing = false; sfOpen("view"); sfFlash('#sf-pop [data-sf="link"], #sf-pop [data-sf="unlink"]'); },
      channels: (r) => { sfReturnTo = "onboarding"; sfOpen("channels"); const miss = (Array.isArray(r.platforms) ? r.platforms : []).find((p) => !String(r[SF_URL[p]] || "").trim()); sfFlash(miss ? "#sfc-" + miss : "#sf-pop-b input"); },
      shoot: (r) => { sfClosePop(); sfReturnTo = "onboarding"; openVidBooking(r); },
      assets: (r) => sfPickBrand(r),
      firstinv: (r) => { r._onbInvoices = null; r._onbInvSent = null; sfReturnTo = "onboarding"; sfOpen("firstinv"); },
    };
    document.addEventListener("click", (e) => {
      const b = e.target.closest && e.target.closest("[data-onbcall]"); if (!b || !current) return;
      e.preventDefault(); e.stopPropagation();
      const r = current, a = b.getAttribute("data-onbcall");
      if (a === "book") { sfClosePop(); sfReturnTo = "onboarding"; openMeeting(r); return; }
      if (a === "notes") { sfReturnTo = "onboarding"; sfOpen("callnotes", "onboarding"); return; }
      const cur = onbState(r);
      if (a === "skip") { cur.ask.call = "skip"; r.onboarding = cur; sfAutoNote(r, "Onboarding call", "Onboarding call skipped: already covered with them."); }
      if (a === "unskip") { delete cur.ask.call; r.onboarding = cur; }
      renderOnboarding(r); saveOnb(r);
    }, true);
    document.addEventListener("click", (e) => {
      const g = e.target.closest && e.target.closest("[data-onbgo]"); if (!g || !current) return;
      const fn = ONB_GO[g.getAttribute("data-onbgo")]; if (fn) { e.preventDefault(); e.stopPropagation(); fn(current); }
    }, true);
    function renderOnboarding(r) {
      const host = $("smm-panel-onboarding");
      const c0 = onbCount(r);
      const n = $("smm-onb-n"); if (n) n.textContent = ` (${c0.done}/${c0.total})`;
      if (!host) return;
      // Invoices raised in the Invoicing tab count as billing set up: read once.
      if (r._onbInvoices == null && !isDemo(r) && WORKER) {
        r._onbInvoices = 0;
        authToken().then((token) => fetch(`${WORKER}/invoicing/invoices?booking_id=${encodeURIComponent(r.id)}`, { headers: { Authorization: "Bearer " + token } }))
          .then((res) => res.ok ? res.json() : {}).then((j) => { const all = ((j && j.invoices) || []).filter((v) => v.status !== "void"); r._onbInvoices = all.length; r._onbInvSent = all.filter((v) => v.status !== "draft").length; if (r._onbInvoices) renderOnboarding(r); }).catch(() => {});
      }
      const o = onbState(r), c = onbCtx(r), C = ONB_COPY;
      const when = (x) => { try { return new Date(x).toLocaleDateString("en-GB", { day: "numeric", month: "short" }); } catch (_) { return ""; } };
      // "abigail.saunders@…" reads as Abigail.
      const who = (x) => String(x || "").split("@")[0].split(/[._-]/)[0].toLowerCase().replace(/^./, (m) => m.toUpperCase());
      const row = (it) => {
        const t = C.items[it.key] || { label: it.key, todo: "" };
        const done = onbDone(r, it, o, c);
        const hint = it.kind === "auto" && done && t.done ? (typeof t.done === "function" ? t.done(r) : t.done) : t.todo;
        if (it.kind === "ask") return `<div class="smm-onb-row smm-onb-ask${done ? " is-done" : ""}"><span class="smm-onb-mark">${done ? "✓" : ""}</span><div class="smm-onb-main"><span class="smm-onb-label">${esc(t.label)}</span><span class="smm-onb-hint">${onbMd(hint)}</span><div class="pay-toggle smm-onb-yn"><button type="button" class="pay-opt${o.ask[it.ask] === "yes" ? " is-active" : ""}" data-onbask="${it.ask}" data-v="yes">Yes</button><button type="button" class="pay-opt${o.ask[it.ask] === "no" ? " is-active" : ""}" data-onbask="${it.ask}" data-v="no">No</button></div></div></div>`;
        const by = it.kind === "manual" && o.done[it.key] ? `<span class="smm-onb-by">${esc(C.tickedBy(who(o.done[it.key].by), when(o.done[it.key].at)))}</span>` : it.kind === "auto" ? `<span class="smm-onb-by">${esc(done ? C.autoDone : C.autoOpen)}</span>` : "";
        const box = it.kind === "manual"
          ? `<input type="checkbox" class="smm-onb-tick" data-onbtick="${it.key}"${done ? " checked" : ""} aria-label="${esc(t.label)}">`
          : `<span class="smm-onb-mark${done ? "" : " is-open"}">${done ? "✓" : ""}</span>`;
        const note = it.note ? `<textarea class="smm-onb-note" rows="2" data-onbnote="${it.note}" placeholder="${esc(t.notePlaceholder || "")}">${esc(o.notes[it.note] || "")}</textarea>` : "";
        if (it.kind === "call") {
          const cs = onbCallState(r);
          const hint = { none: t.todo, waiting: `Waiting for the onboarding call, ${sfWhen(cs.at)}.`, held: `Held ${sfDay(cs.at)}. Write the call notes and this ticks itself.`, notes: "Done. The call notes are in **Notes**.", skip: "Skipped: already covered with them." }[cs.k];
          const b = (a, txt, primary) => `<button type="button" class="smm-btn smm-btn--sm${primary ? " smm-btn--primary" : ""}" data-onbcall="${a}">${txt}</button>`;
          const btns = { none: b("book", "Book the onboarding call", true) + b("skip", "Skip it"), waiting: b("book", "Move the call") + b("notes", "Call notes"), held: b("notes", "Write the call notes", true), notes: b("notes", "Read the notes"), skip: b("unskip", "Undo") }[cs.k];
          return `<div class="smm-onb-row${cs.done ? " is-done" : ""} is-auto"><span class="smm-onb-mark${cs.done ? "" : " is-open"}">${cs.done ? "✓" : ""}</span><div class="smm-onb-main"><span class="smm-onb-label">${esc(t.label)}</span><span class="smm-onb-hint">${onbMd(hint)}</span><div class="smm-onb-acts">${btns}</div></div></div>`;
        }
        const extraBtn = it.key === "assets" ? `<div class="smm-onb-acts"><button type="button" class="smm-btn smm-btn--sm${done ? "" : " smm-btn--primary"}" data-sf="brand-add">${done ? "Add more" : "Upload"}</button>${done ? `<button type="button" class="smm-btn smm-btn--sm" data-sf="brand">Open the folder</button>` : ""}</div>`
          : it.key === "firstinv" && !done ? `<div class="smm-onb-acts"><button type="button" class="smm-btn smm-btn--sm smm-btn--primary" data-onbgo="firstinv">Raise the first invoice</button></div>` : "";
        const label = it.kind === "auto" && ONB_GO[it.key] ? `<button type="button" class="smm-onb-label smm-onb-go" data-onbgo="${it.key}">${esc(t.label)}<span aria-hidden="true"> ›</span></button>` : `<span class="smm-onb-label">${esc(t.label)}</span>`;
        return `<div class="smm-onb-row${done ? " is-done" : ""}${it.kind === "auto" ? " is-auto" : ""}">${box}<div class="smm-onb-main">${label}<span class="smm-onb-hint">${onbMd(hint)}</span>${by}${note}${extraBtn}</div></div>`;
      };
