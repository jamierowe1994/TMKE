        const res = await fetch(`${WORKER}/invoicing/invoices`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: r.id, booking_source: "smm", bill_to_name: inv.bill_to_name, bill_to_email: inv.bill_to_email || null, bill_to_address: inv.bill_to_address || null, cc_email: ccVal, issued_date: inv.issued_date, due_date: inv.due_date, notes: inv.notes, template: sivTemplate, pay_by_card: sivPayByCard, line_items: inv.line_items }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.invoice) throw new Error(j.error || "Couldn't create the invoice.");
        invSettings.next_number = (invSettings.next_number || 1001) + 1;
