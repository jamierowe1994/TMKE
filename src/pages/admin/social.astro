            <div class="smm-modal-field"><label>Stage</label><select id="smm-nl-stage">${STAGES.map((s) => `<option value="${s.key}"${s.key === "inquiry" ? " selected" : ""}>${s.label}</option>`).join("")}</select></div>
            <p class="smm-modal-status" id="smm-nl-status" hidden></p>
