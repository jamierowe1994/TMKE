    const sfOnbItems = (r) => { const o = onbState(r), c = onbCtx(r); return ONB_ITEMS.filter((it) => !it.when || it.when(r, o)).map((it) => ({ it, ok: onbDone(r, it, o, c), label: (ONB_COPY.items[it.key] || {}).label || it.key })); };
    const sfStageLabel = (k) => (STAGES.find((s) => s.key === k) || {}).label || "";

