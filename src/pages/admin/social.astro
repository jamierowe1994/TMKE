      const full = F.signedUp || (F.lost && (wasClient(r) || (r._reports || []).length || F.plans.length));
      const tabs = !full ? [["paper", "Paperwork"], ["comm", "Communication"], ["notes", "Notes"]]
        : F.st === "onboarding" && !F.lost ? [["plan", "Content plan"], ["comm", "Communication"], ["notes", "Notes"], ["paper", "Paperwork"]]
        : [["reports", "Reports"], ["plan", "Content plan"], ["comm", "Communication"], ["notes", "Notes"], ["paper", "Paperwork"]];
      if (!tabs.some(([k]) => k === sfTab)) sfTab = tabs[0][0];
      const card = (attrs, head, body, foot, cls = "") => `<article class="sf-c${cls}" tabindex="0" ${attrs}><div class="sf-c-h">${head}</div>${body}<div class="sf-c-f">${foot || ""}</div></article>`;
      const none = (t) => `<div class="sf-c is-none"><p class="sf-c-p">${t}</p></div>`;
      const row = (id, label, cards) => `<div class="sf-prow"><div class="sf-prow-h"><span>${label}</span><span class="sf-nav"><button type="button" data-sf-scroll="${id}" data-dir="-1" aria-label="Back">&lsaquo;</button><button type="button" data-sf-scroll="${id}" data-dir="1" aria-label="More">&rsaquo;</button></span></div><div class="sf-strip" id="sf-strip-${id}">${cards}</div></div>`;
      /* Before they're an active client there isn't enough for two rows
         (Dani, 5 Nov): one row, outstanding first, and you scroll. */
      const isNone = (h) => String(h || "").startsWith('<div class="sf-c is-none"');
      const two = (l1, c1, l2, c2) => F.client
        ? row("a", l1, c1) + row("b", l2, c2)
        : row("a", "", [c1, c2].filter((x) => x && !isNone(x)).join("") || c1 || c2);
      const loading = !F.thread;
      const first = sfFirst(r);
      let acts = "", rows = "";
      if (sfTab === "reports") {
        acts = sfAct("insights", "Open insights");
        const lm = new Date(F.now.getFullYear(), F.now.getMonth() - 1, 1);
        const rep = F.reps.find((x) => x.year === lm.getFullYear() && x.month === lm.getMonth());
        const due = !sfData.reports ? none("Loading…") : F.cs === "paused" && F.client ? none("Nothing due while they're paused.")
          : rep && rep.published_at ? none(`Nothing outstanding. ${RI_MONTHS[lm.getMonth()]}'s is published.`)
          : card(`data-sf="upload-report"`, `<h4>${RI_MONTHS[lm.getMonth()]}</h4>${sfChip("wait", rep ? "Not published" : "Not uploaded")}`, `<p class="sf-c-p">${rep ? `Built, and not yet published to ${first}'s hub.` : `Upload ${RI_MONTHS[lm.getMonth()]}'s SocialPilot export and the report builds from it, one platform at a time.`}</p>`, `<span></span>${sfHb(true, 'data-sf="upload-report"', rep ? "Open" : "Upload")}`, " is-todo");
        const pub = F.reps.filter((x) => x.published_at);
        const figs = (x) => { const p = (x.data || {}).profile || {}, po = (x.data || {}).posts || {}, re = (x.data || {}).reels || {};
          const cells = [];
          if (p.reach != null) cells.push([Number(p.reach).toLocaleString("en-GB"), "Reach", p.reachChange != null ? (p.reachChange > 0 ? "+" : "") + p.reachChange + "%" : ""]);
          if (p.interactionRate != null) cells.push([p.interactionRate + "%", "Engagement", ""]);
          if (p.followers != null) cells.push([Number(p.followers).toLocaleString("en-GB"), "Followers", p.newFollowers ? "+" + p.newFollowers : ""]);
          if (po.published != null || re.published != null) cells.push([String((po.published || 0) + (re.published || 0)), "Posts", "inc. reels"]);
          return cells.length ? `<div class="sf-figs">${cells.slice(0, 4).map(([v, k, d]) => `<div class="sf-fig"><b>${esc(v)}</b><span>${esc(k)}${d ? " · " + esc(d) : ""}</span></div>`).join("")}</div>` : `<p class="sf-c-p">The figures are in the full report.</p>`; };
        const ins = (x) => { const i = (((x.data || {}).client || {}).insights || [])[0]; const h = i && (i.headline || i.title || (typeof i === "string" ? i : "")); return h ? `<p class="sf-c-ins">${esc(h)}</p>` : ""; };
        const done = !sfData.reports ? none("Loading…") : pub.length ? pub.map((x) => card(`data-sf-card="report" data-id="${esc(x.id)}"`, `<h4>${RI_MONTHS[x.month]}</h4>${sfChip("good", "Published")}`, figs(x) + ins(x), `<span>${esc(sfDay(x.published_at))}${x.published_by ? ", " + esc(sfStaff(x.published_by)) : ""}</span><span class="sf-ics">${["instagram", "facebook", "linkedin"].filter((k) => k === "instagram" ? (x.data || {}).profile : (x.data || {})[k]).map((k) => sfIcon(PLATFORM_NAMES[k])).join("")}</span>`)).join("") : none("No reports published yet.");
        rows = two("Outstanding", due, "Published", done);
      } else if (sfTab === "plan") {
        acts = sfAct("plan-upload", "Upload a plan");
        // Onboarding (Dani, 5 Nov 2026): only the first plan, for the month they
        // start, and never overdue. Clients: this month's and next month's.
        const onb = F.st === "onboarding" && !F.lost;
        const need = (onb ? [sfFirstPlanYm(r, F)] : [F.ym, sfYmAdd(F.ym, 1)]).filter((ym) => !F.plans.some((p) => p.ym === ym));
        const dueCards = loading ? none("Loading…") : need.length ? need.map((ym) => { const late = !onb && ym === F.ym && F.now.getDate() > 2; return card(`data-sf="plan-upload" data-ym="${ym}"`, `<h4>${esc(sfYmName(ym).split(" ")[0])}</h4>${sfChip(late ? "bad" : "wait", late ? "Overdue, was due the 2nd" : onb && ym === F.ym ? "Due before they start" : `Due by 2 ${sfMon(ym)}`)}`, `<p class="sf-c-p">Upload ${esc(sfYmName(ym).split(" ")[0])}'s plan. It needs to be in before the report that says what's coming next.</p>`, `<span></span>${sfHb(true, `data-sf="plan-upload" data-ym="${ym}"`, "Upload the plan")}`, " is-todo"); }).join("") : none(onb ? "Their first plan is in." : "Nothing outstanding. This month's and next month's plans are in.");
        const doneCards = loading ? none("Loading…") : F.plans.length ? F.plans.map((p) => card(`data-sf-card="plan" data-id="${esc(p.id)}"`, `<h4>${esc(sfYmName(p.ym).split(" ")[0])}</h4>${sfChip("good", "On file")}`, `<p class="sf-c-file">${esc(p.title || p.file_name)}</p>`, `<span>${esc(sfShort(p.created_at))}${p.uploaded_by && p.uploaded_by !== "system" ? ", " + esc(sfStaff(p.uploaded_by)) : ""}</span>${sfHb(false, `data-sf-doc="${esc(p.id)}" data-name="${esc(p.file_name || "plan")}"`, "Open")}`)).join("") : none("No plans uploaded yet.");
        rows = two("Outstanding", dueCards, "On file", doneCards);
      } else if (sfTab === "comm") {
        acts = r.email ? sfAct("write", "Write") : "";
        const list = F.msgs.filter((m) => (m.channel === "email" || m.channel === "hub" || m.channel === "system") && m.kind !== "meeting").sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
        const inbound = (m) => m.channel === "hub" || m.direction === "inbound";
        const cc = (m) => card(`data-sf-card="msg" data-id="${esc(m.id)}"`, `<span class="sf-c-chips">${sfChip(m.channel === "hub" ? "info" : "plain", m.channel === "hub" ? "Member Hub" : m.channel === "system" ? "Notice" : "Email")}${isUnread(m) ? sfChip("wait", "New") : ""}</span><span class="sf-c-who">${esc(sfShort(m.created_at))}</span>`,
          `<p class="sf-c-sub">${esc(m.subject || String(m.body || "").split("\n")[0] || "Message")}</p><p class="sf-c-p sf-c-2">${esc(m.body || "")}</p>`,
          `<span>${inbound(m) ? "From " + esc(name) + (m.channel === "hub" ? ", in their hub" : "") : "To " + esc(m.to_email || r.email || name) + (m.is_automated || m.created_by === "system" ? ", sent automatically" : m.created_by ? ", by " + esc(sfStaff(m.created_by)) : "")}</span>`);
        const ins = list.filter(inbound), outs = list.filter((m) => !inbound(m));
        rows = two(`Received from ${first}`, loading ? none("Loading…") : ins.map(cc).join("") || none("Nothing from them yet."), `Sent to ${first}`, loading ? none("Loading…") : outs.map(cc).join("") || none("Nothing sent yet."));
      } else if (sfTab === "notes") {
        acts = sfAct("activity", "Client activity");
        const notes = F.msgs.filter((m) => m.channel === "note" || m.kind === "meeting").sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
        const nc = (m) => card(`data-sf-card="note" data-id="${esc(m.id)}"`, `<h4>${esc(sfShort(m.created_at))}</h4><span class="sf-c-who">${m.is_pinned ? "Pinned · " : ""}${esc(m.created_by && m.created_by !== "system" ? sfStaff(m.created_by) : "")}</span>`, `${m.subject ? `<p class="sf-c-sub">${esc(m.subject)}</p>` : ""}<p class="sf-c-p sf-c-note">${esc(m.body || "")}</p>`, "", m.is_pinned ? " is-pin" : "");
        const add = card('data-sf="note-add"', `<h4>Add a note</h4>`, `<p class="sf-c-p">What happened, what was agreed. Pin it and it stays up here for everyone working on ${first}.</p>`, `<span></span>${sfHb(true, 'data-sf="note-add"', "Add a note")}`, " is-todo");
        rows = two("Add and pinned", add + (loading ? "" : notes.filter((m) => m.is_pinned).map(nc).join("")), "All notes", loading ? none("Loading…") : notes.filter((m) => !m.is_pinned).map(nc).join("") || none("No other notes."));
      } else {
        acts = sfAct("file-add", "Add a file");
        // A bin beside Open (Dani, 5 Nov 2026): deletes the file from the client, after a check.
        const doc = (d) => card(`data-sf-doc="${esc(d.id)}" data-name="${esc(d.file_name || "document")}"`, `<h4>${esc(catLabel(d.category))}</h4>${sfChip("good", "On file")}`, `<p class="sf-c-file">${esc(d.title || d.file_name)}</p>`, `<span>${esc(sfShort(d.created_at))}${d.uploaded_by && d.uploaded_by !== "system" ? ", " + esc(sfStaff(d.uploaded_by)) : ""}</span><span class="sf-c-btns"><button type="button" class="sf-bin" data-sf-deldoc="${esc(d.id)}" aria-label="Delete ${esc(d.file_name || "this file")}" title="Delete"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 12a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2l1-12M9 7V4h6v3"/></svg></button>${sfHb(false, `data-sf-doc="${esc(d.id)}" data-name="${esc(d.file_name || "document")}"`, "Open")}</span>`);
        const want = (cat, t) => card(`data-sf="file-add" data-cat="${cat}"`, `<h4>${t}</h4>${sfChip("plain", "Not yet")}`, `<p class="sf-c-file">Nothing uploaded</p>`, `<span></span>${sfHb(true, `data-sf="file-add" data-cat="${cat}"`, "Add")}`, " is-todo");
        const prep = F.docs.filter((d) => d.category === "prep"), agr = F.docs.filter((d) => d.category === "agreement");
        const items = sfOnbItems(r), cd = items.filter((x) => x.ok).length;
        const onb = F.signedUp ? card('data-sf="onboarding"', `<h4>Onboarding</h4>${sfChip(cd === items.length ? "good" : "wait", `${cd} of ${items.length}`)}`, `<span class="sf-bar"><i style="width:${items.length ? (cd / items.length) * 100 : 0}%"></i></span><p class="sf-c-p">${cd === items.length ? "Everything's done." : `Still open: ${esc(items.filter((x) => !x.ok).slice(0, 2).map((x) => x.label.toLowerCase()).join(", "))}${items.length - cd > 2 ? " and more" : ""}.`}</p>`, `<span></span>${sfHb(cd !== items.length, 'data-sf="onboarding"', "Open")}`) : "";
        // In the order things happen, newest first (Dani, 5 Nov): onboarding, contract, proposal.
        const brandDocs = F.docs.filter((d) => d.category === "brand");
        // Brand assets as one folder, however many files (Dani, 5 Nov 2026).
        const brandCard = brandDocs.length
          ? card('data-sf="brand"', `<h4>Brand assets</h4>${sfChip("good", brandDocs.length === 1 ? "1 file" : brandDocs.length + " files")}`, `<p class="sf-c-file">${esc(brandDocs.slice(0, 3).map((d) => d.file_name).join(", "))}${brandDocs.length > 3 ? ` and ${brandDocs.length - 3} more` : ""}</p>`, `<span>${esc(sfShort(brandDocs[brandDocs.length - 1].created_at))}</span>${sfHb(false, 'data-sf="brand"', "Open")}`)
          : F.signedUp || F.st === "onboarding" ? card('data-sf="brand-add"', `<h4>Brand assets</h4>${sfChip("plain", "Not yet")}`, `<p class="sf-c-file">Nothing uploaded</p>`, `<span></span>${sfHb(true, 'data-sf="brand-add"', "Upload")}`, " is-todo") : "";
        const signing = onb + brandCard + (agr.length ? agr.map(doc).join("") : F.idx >= STAGE_INDEX.contract_signed ? want("agreement", "Contract") : "") + (prep.length ? prep.map(doc).join("") : F.idx >= STAGE_INDEX.meeting_set ? want("prep", "Proposal") : "");
        const other = F.docs.filter((d) => !["prep", "agreement", "invoice", "content_plan", "brand"].includes(d.category));
        rows = two("Signing up", loading ? none("Loading…") : signing || none("The proposal and contract go here."), "Working files", loading ? none("Loading…") : other.map(doc).join("") || none("Strategy, brand files and anything else go here."));
      }
      return `<div class="sf-pan">
          <div class="sf-switch"><div class="sf-seg" role="group" aria-label="Show">${tabs.map(([k, t]) => `<button type="button" data-sf-tab="${k}" aria-pressed="${sfTab === k}">${t}</button>`).join("")}</div><span class="sf-acts">${acts}</span></div>
          <div class="sf-card sf-pan-card">${rows}</div>
        </div>`;
    }

    // ---- Pop-outs: one kind, one size, centred beside the sidebar ----
    const sfPR = (label, html) => `<div class="sf-pr"><dt>${label}</dt><dd>${html === "" || html == null ? '<span class="sf-none">—</span>' : html}</dd></div>`;
    const sfPF = (label, field, hint) => `<div class="sf-pr is-field"><dt>${label}</dt><dd>${field}${hint ? `<small class="sf-hint">${hint}</small>` : ""}</dd></div>`;
    const sfSec = (h, inner) => `<section class="sf-sec"><div class="sf-sec-h">${h}</div><div class="sf-sec-b">${inner}</div></section>`;
    const sfIn = (id, v, type = "text", ph = "") => `<input class="sf-in" id="${id}" type="${type}" value="${esc(v == null ? "" : v)}"${ph ? ` placeholder="${esc(ph)}"` : ""}>`;
    const sfTog = (id, onA, a = "Yes", b = "No") => `<span class="sf-tog" data-sf-tog="${id}"><button type="button" aria-pressed="${!!onA}">${a}</button><button type="button" aria-pressed="${!onA}">${b}</button></span>`;
    const sfTogOn = (id) => document.querySelector(`[data-sf-tog="${id}"] button[aria-pressed="true"]`) === document.querySelector(`[data-sf-tog="${id}"] button`);
    // Lent hosts go back to #sf-legacy when the pop-out closes.
    let sfLent = [];
    // Lent pieces go back where they came from (sf-legacy, or the calculator's own page).
    function sfLend(id, into) { const el = $(id), legacy = $("sf-legacy"); if (!el || !legacy || !into) return; sfLent.push({ id, home: el.parentElement || legacy }); into.appendChild(el); }
    function sfReturn() { sfLent.forEach(({ id, home }) => { const el = $(id); if (el && home) home.appendChild(el); }); sfLent = []; }
    function sfPlace() { const scrim = $("sf-pop"), main = document.querySelector(".ash-main"); if (scrim) scrim.style.left = (main && window.innerWidth > 900 ? Math.max(0, main.getBoundingClientRect().left) : 0) + "px"; }
    window.addEventListener("resize", () => { if (sfPop) sfPlace(); });
    // Closing redraws the file: ticks, uploads and publishes inside a pop-out show at once.
    function sfClosePop() { if (sfPop === "write") sfWritePreset = null; if (sfPop === "quote") pcLeaveClient(); const was = sfPop; sfReturn(); sfPop = null; sfEditing = false; const p = $("sf-pop"); if (p) p.hidden = true; if (was && current) sfDraw(current); sfBackTo(); }
    function sfBackTo() { if (!sfReturnTo || !current || sfPop) return; const k = sfReturnTo; sfReturnTo = null; setTimeout(() => { if (!sfPop && current) sfOpen(k); }, 0); }
    function sfShell(eye, title, chip, tabs, body, foot, opts = {}) {
      const p = $("sf-pop"); if (!p) return null;
      sfReturn();
      p.hidden = false; sfPlace();
      const panel = p.querySelector(".sf-panel");
      panel.classList.toggle("is-narrow", !!opts.narrow);
      panel.classList.toggle("is-wide", !!opts.wide);
      panel.classList.toggle("is-edit", !!opts.edit);
      $("sf-pop-eye").textContent = eye; $("sf-pop-t").textContent = title;
      $("sf-pop-chip").innerHTML = chip || ""; $("sf-pop-tabs").innerHTML = tabs || "";
      const b = $("sf-pop-b"); b.innerHTML = body || ""; b.scrollTop = 0;
      $("sf-pop-f").innerHTML = foot || "";
      return b;
    }
    const sfFootBtn = (primary, attrs, t) => sfHb(primary, attrs, t);

    function sfOpen(key, arg) {
      const r = current; if (!r) return;
      if (sfPop === "quote" && key !== "quote") pcLeaveClient();
      if (sfPop === "onboarding" && key !== "onboarding") sfReturnTo = "onboarding";
      sfPop = key; sfCur = arg == null ? null : arg;
      const name = nameOf(r), eye = (t) => `${t} · ${name}`;
      const F = sfFacts(r);
      if (key === "view") {
        // Client details follow the stages too (Danielle, 5 Nov 2026): what came
        // in, the calls and their notes, the proposal and contract, as far as
        // they've got.
        const idx = STAGE_INDEX[F.st];
        const D = F.discovery || {}, Pn = F.pricing || {};
        const notesRows = (f) => sfPR("What they want", esc(f["what they want"] || "")) + sfPR("Package interest", esc(f["package interest"] || "")) + sfPR("Platforms", esc(f.platforms || "")) + sfPR("Budget", esc(f.budget || "")) + sfPR("Wants to start", esc(f["wants to start"] || "")) + sfPR("Next step", esc(f["next step"] || ""));
        const transcript = (kind) => F.msgs.find((m) => m.channel === "note" && String(m.subject || "").toLowerCase() === `${kind} call transcript`);
        const tLink = (kind) => { const m = transcript(kind); return m ? sfPR("Transcript", `<button type="button" class="sf-act" data-sf="note" data-id="${esc(m.id)}">Read the transcript</button>`) : ""; };
        const pd = r.package_details || {};
        const propSent = F.reached("proposal_sent") || (F.prep && F.prep.created_at);
        const showCalls = !F.lost || true;
        const b = sfShell(eye("Client"), "Client details", "", "",
          sfSec("Contact", `<dl class="sf-pdl">${sfPR("Contact name", esc(name === "—" ? "" : name))}${sfPR("Business", esc(r.business || ""))}${sfPR("Email", esc(r.email || ""))}${sfPR("Phone", esc(r.phone || ""))}</dl>`)
          + sfSec("How they came in", `<dl class="sf-pdl">${sfPR("Enquiry received", esc(sfDayYear(r.created_at)))}${sfPR("How", esc(sfSource(r) || KIND_LABEL[r.kind] || "Added by hand"))}${sfPR("What they said", esc(r.message || ""))}${sfPR("Marketing", r.marketing_opt_in ? "Opted in" : "Not opted in")}</dl>`)
          + (idx >= STAGE_INDEX.meeting_set || F.discovery ? sfSec("Discovery call", `<dl class="sf-pdl">${F.st === "meeting_set" || F.st === "inquiry" ? sfPR("When", esc(sfWhen(r.meeting_at))) : ""}${F.discovery ? notesRows(D) + tLink("discovery") : sfPR("Call notes", `Not written yet &nbsp;<button type="button" class="sf-act" data-sf="callnotes" data-id="discovery">Write them</button>`)}</dl>`) : "")
          + (idx >= STAGE_INDEX.proposal_sent ? sfSec("Proposal", `<dl class="sf-pdl">${sfPR("Sent", esc(sfDayYear(propSent)))}${sfPR("File", F.prep ? `<button type="button" class="sf-act" data-sf-doc="${esc(F.prep.id)}" data-name="${esc(F.prep.file_name || "proposal")}">${esc(F.prep.title || F.prep.file_name)}</button>` : "")}${pd.proposed ? sfPR("Proposed", esc([pd.proposed.package, pd.proposed.price !== "" && pd.proposed.price != null ? sfGbpWhole(pd.proposed.price) + " a month" : "", (pd.proposed.platforms || []).join(", ")].filter(Boolean).join(" · ")) + ` <button type="button" class="sf-act" data-sf="proposed">Change</button>`) + (pd.proposed.notes ? sfPR("Proposal notes", esc(pd.proposed.notes)) : "") : ""}${sfPR("Priced", pd.quote ? `${esc(pcQuoteLine(pd.quote))} <button type="button" class="sf-act" data-sf="quote">Open</button>` : `Not yet <button type="button" class="sf-act" data-sf="quote">Price it</button>`)}${sfPR("Monthly fee", esc(r.price || ""))}${sfPR("Onboarding fee", pd.onboarding_fee != null && pd.onboarding_fee !== "" ? `£${esc(pd.onboarding_fee)} + VAT` : "")}</dl>`) : "")
          + (idx >= STAGE_INDEX.pricing_call ? sfSec("Pricing call", `<dl class="sf-pdl">${F.st === "pricing_call" ? sfPR("When", esc(sfWhen(r.meeting_at))) : ""}${F.pricing ? notesRows(Pn) + tLink("pricing") : sfPR("Call notes", `Not written yet &nbsp;<button type="button" class="sf-act" data-sf="callnotes" data-id="pricing">Write them</button>`)}</dl>`) : "")
          + (idx >= STAGE_INDEX.contract_signed ? sfSec("Contract", `<dl class="sf-pdl">${sfPR("Sent", esc(sfDayYear(F.reached("contract_signed"))))}${sfPR("Signed copy", F.agreement ? `<button type="button" class="sf-act" data-sf-doc="${esc(F.agreement.id)}" data-name="${esc(F.agreement.file_name || "contract")}">${esc(F.agreement.title || F.agreement.file_name)}</button>, ${esc(sfDay(F.agreement.created_at))}` : "Not back yet")}</dl>`) : "")
          + (idx >= STAGE_INDEX.proposal_sent ? sfSec("Package", `<dl class="sf-pdl">${sfPR("Package", esc(r.package_name || ""))}${sfPR("Tier", esc(tierLabel(r.package_name, pd.tier)))}${sfPR("Monthly fee", esc(r.price || ""))}${sfPR("Hours a month", r.contracted_hours_per_month != null ? esc(String(r.contracted_hours_per_month)) : "")}${sfPR("Includes video", pd.video == null ? "" : pd.video ? "Yes" : "No")}${pd.video ? sfPR("Shoot", esc(pd.shoot_frequency || "")) : ""}${sfPR("What comes out of it", esc(pd.outputs || "").replace(/\n/g, "<br>"))}</dl><div class="sf-inline">${sfHb(false, 'data-sf="edit" data-id="package"', "Change in Edit")}</div>`) : "")
