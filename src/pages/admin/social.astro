        const q = (r.package_details || {}).quote;
        const b = sfShell(eye("Proposal"), "Price it", q ? sfChip("good", "Saved " + sfDay(q.at)) : "", "",
          `<div id="sf-quote-slot"></div>`,
          `<span class="sf-say" id="sf-save-msg">Saved on their file. The prices go into the email that sends the proposal.</span>${sfFootBtn(false, "data-sf-close", "Cancel")}${sfFootBtn(true, 'data-sf="save-quote"', "Save to their file")}`, { wide: true, edit: true });
        if (b) { sfLend("smm-pc", b.querySelector("#sf-quote-slot")); pcForClient(r, F); }
      } else if (key === "brand") {
        const files = F.docs.filter((d) => d.category === "brand");
        sfShell(eye("Paperwork"), "Brand assets", sfChip("good", files.length === 1 ? "1 file" : files.length + " files"), "",
          sfSec("In the folder", files.length ? `<div class="sf-tbl"><div class="sf-tbl-h"><span>File</span><span>Added</span><span></span></div>${files.map((d) => `<div class="sf-tbl-r"><span>${esc(d.file_name || "file")}</span><span>${esc(sfShort(d.created_at))}</span><span class="sf-tbl-a"><button type="button" class="sf-act" data-sf-doc="${esc(d.id)}" data-name="${esc(d.file_name || "file")}">Open</button><button type="button" class="sf-act" data-sf-deldoc="${esc(d.id)}">Delete</button></span></div>`).join("")}</div>` : `<p class="sf-say sf-note">Nothing in the folder yet.</p>`),
          `<span class="sf-say" id="sf-save-msg"></span>${sfFootBtn(false, "data-sf-close", "Close")}${sfFootBtn(true, 'data-sf="brand-add"', "Add files")}`);
      } else if (key === "firstinv") {
        // The first invoice (Dani, 5 Nov 2026): the onboarding fee, the first
        // month and, if they're having it, profile optimisation, on one invoice.
        const pdI = r.package_details || {};
        const monthly = sfData.recurring && sfData.recurring.amount_pence ? (sfData.recurring.amount_pence / 100).toFixed(2) : parseMoney(r.price) ? (parseMoney(r.price) / 100).toFixed(2) : "";
        const first = sfFirstPlanYm(r, F);
        const po = SF_PROFILE_OPT;
        sfShell(eye("Invoicing"), "The first invoice", "", "",
          sfSec("On the invoice", sfPF("Onboarding fee", sfIn("sfi-ob", pdI.onboarding_fee ?? "", "number", "0.00"), "Before VAT. From Edit › Package.")
            + sfPF("First month", `<select class="sf-in" id="sfi-month">${[sfYmAdd(F.ym, 0), sfYmAdd(F.ym, 1), sfYmAdd(F.ym, 2)].concat(first > sfYmAdd(F.ym, 2) ? [first] : []).map((ym) => `<option value="${ym}"${ym === first ? " selected" : ""}>${esc(sfYmName(ym))}</option>`).join("")}</select>`)
            + sfPF("Monthly fee", sfIn("sfi-month-amt", monthly, "number", "0.00"), "Before VAT.")
            + (po ? sfPF("Profile optimisation", `<label class="sf-check"><input type="checkbox" id="sfi-po"${onbState(r).ask.optimise === "yes" ? " checked" : ""}> Add ${esc(po.name)}, ${esc(sfGbp(po.from_pence))} a ${esc(po.unit)}</label>`) : ""))
          + `<p class="sf-say sf-note">Next, the invoice opens with these on it, for you to check and send.</p>`,
          `<span class="sf-say" id="sf-save-msg"></span>${sfFootBtn(false, "data-sf-close", "Cancel")}${sfFootBtn(true, 'data-sf="firstinv-go"', "Continue to the invoice")}`, { edit: true });
      } else if (key === "proposed") {
        sfShell(eye("Proposal"), "What we proposed", "", "", sfProposedFields(r)
          + (sfAfterProposed ? `<p class="sf-say sf-note">Fill this in before the pricing call is booked. The booking opens straight after.</p>` : ""),
          `<span class="sf-say" id="sf-save-msg"></span>${sfFootBtn(false, "data-sf-close", "Cancel")}${sfFootBtn(true, 'data-sf="save-proposed"', sfAfterProposed ? "Save and carry on" : "Save")}`, { edit: true });
      } else if (key === "proposal") {
        // Already in Paperwork (Dani, 5 Nov 2026): send that one; choosing a file replaces it.
        const have = F.prep;
        sfShell(eye("Proposal"), have ? "Send the proposal" : "Upload and send the proposal", "", "",
          sfSec("The proposal", (have
            ? sfPF("File", `<button type="button" class="sf-act" data-sf-doc="${esc(have.id)}" data-name="${esc(have.file_name || "proposal")}">${esc(have.title && have.title !== "Proposal" ? have.title : have.file_name || "Proposal")}</button>`, `In Paperwork since ${esc(sfDay(have.created_at))}. This is the one that's attached.`)
              + sfPF("Use a different file", `<input class="sf-file" id="sfp-prop" type="file">`, "Only if this one's changed. The new file goes into Paperwork.")
            : sfPF("File", `<input class="sf-file" id="sfp-prop" type="file">`, "The pitch deck you're sending them. It's kept in Paperwork."))
            + `<label class="sf-check"><input type="checkbox" id="sfp-mark" checked> Mark the proposal sent, so the chase dates start today</label>`)
          + sfProposedFields(r)
          + `<p class="sf-say sf-note">Next, an email to send it with opens, with the proposal attached, for you to finish and send. The chases are counted from today.</p>`,
          `<span class="sf-say" id="sf-save-msg"></span>${sfFootBtn(false, "data-sf-close", "Cancel")}${sfFootBtn(true, 'data-sf="save-proposal"', "Save")}`, { edit: true });
      } else if (key === "invoice") {
        sfInvoicePop(r, F);
      }
      sfPop = key;
    }

    // ---- Invoicing: the monthly invoice, a one-off, and every invoice ----
    function sfInvoicePop(r, F) {
      const name = nameOf(r);
      const rec = F.rec;
      const n = F.invs.length;
      const tabs = [["monthly", "Monthly invoice"], ["oneoff", "Raise a one-off"], ["all", `All invoices${sfData.invoices ? " (" + n + ")" : ""}`]].map(([k, t]) => `<button type="button" data-sf-invtab="${k}" aria-selected="${sfInvTab === k}">${t}</button>`).join("");
      const eye = `Invoicing · ${name}`;
      const chip = !rec ? sfChip("bad", "No monthly invoice") : rec.active === false ? sfChip("plain", "Stopped") : sfChip("good", "Set up");
      if (sfInvTab === "monthly") {
        const can = sfData.canMoney;
        if (sfEditing || (!rec && can)) {
          // Raised on the 5th and due on the 28th, the same as every other
          // social client (Dani, 5 Nov). Inter-brand follows the brand route.
          const ib = sfIbRoute(r);
          const last = F.invs[0];
          const ro = (h) => (ib ? h.replace("<input", "<input readonly") : h);
          const line = rec && Array.isArray(rec.line_items) && rec.line_items[0] ? rec.line_items[0].description : `Social media management${r.package_name ? " - " + r.package_name : ""} (Month YYYY)`;
          const nextYm = sfYmAdd(F.ym, 1);
          // New clients pay ahead (Dani, 5 Nov 2026): on by default at Onboarding or once their first invoice has gone.
          const aheadDefault = F.st === "onboarding" || (r._onbInvSent || 0) > 0;
          const bill = ib ? ib.billTo : (rec && (rec.bill_to_name || rec.name)) || (last && last.bill_to_name) || r.business || (name === "—" ? "" : name);
          const mail = ib ? ib.to : (rec && (rec.bill_to_email || rec.match_email)) || (last && last.bill_to_email) || r.email || "";
          const cc = ib ? ib.cc : (rec && rec.cc_email) || (last && last.cc_email) || "";
          const addr = ib ? ib.address : (rec && rec.bill_to_address) || r.business_address || "";
          const day = (rec && rec.day_of_month) || 5, dueOn = (rec && rec.due_day) || 28;
          const ibNote = ib ? `<div class="sf-lock"><b>Inter-brand.</b> ${ib.brand ? `Billed to ${esc(ib.billTo)}` : "Choose the brand that pays in Client › Edit first"}, sent to Paula at TEG accounts, copied to accounts payable, Rosie-Anne and ${sfFirst(r)}. ${esc(ib.client)} is named on the invoice as the client.</div>` : "";
          sfShell(eye, rec ? "Edit the monthly invoice" : "Set up the monthly invoice", chip, tabs,
            (!rec ? `<div class="sf-lock"><b>No monthly invoice yet.</b> Until this is saved, ${esc(name)} isn't invoiced each month and won't show on Monthly invoices.</div>` : "") + ibNote
            + sfSec("What we charge", sfPF("Monthly fee", sfIn("sfm-amt", rec && rec.amount_pence ? (rec.amount_pence / 100).toFixed(2) : (parseMoney(r.price) ? (parseMoney(r.price) / 100).toFixed(2) : ""), "number", "0.00"), "Before VAT.")
              + sfPF("Line on the invoice", sfIn("sfm-line", line), "(Month YYYY) becomes the month, such as December 2026.")
              + sfPF("Pays a month ahead", sfTog("sfm-ahead", rec ? !!rec.pays_ahead : aheadDefault), "Yes for every new client: their first invoice covered their first month, so the invoice raised in December is for January. Most existing clients are No.")
              + sfPF("First month", `<input class="sf-in" id="sfm-start" type="month" value="${esc((rec && rec.start_month) || (aheadDefault ? sfFirstPlanYm(r, F) : nextYm))}">`, "The first month it's raised in.")
              + sfPF("Raised on", `<select class="sf-in" id="sfm-day">${Array.from({ length: 28 }, (_, i) => `<option value="${i + 1}"${Number(day) === i + 1 ? " selected" : ""}>The ${i + 1}${ordinal(i + 1)} of each month</option>`).join("")}</select>`, "The automatic invoicing raises every social client's on the 5th.")
              + sfPF("Due on", `<select class="sf-in" id="sfm-due">${Array.from({ length: 28 }, (_, i) => `<option value="${i + 1}"${Number(dueOn) === i + 1 ? " selected" : ""}>The ${i + 1}${ordinal(i + 1)}</option>`).join("")}</select>`))
            + sfSec("Who pays", sfPF("Bill to", ro(sfIn("sfm-bill", bill, "text", ib ? "Choose the brand in Client › Edit" : ""))) + sfPF("Invoice email", ro(sfIn("sfm-email", mail, "email")), ib ? "TEG accounts." : "")
              + sfPF("Copy to", sfIn("sfm-cc", cc, "text", "Comma-separated"), ib ? "Accounts payable, Rosie-Anne and the client's MD." : "")
              + sfPF("Billing address", `<textarea class="sf-in" id="sfm-addr" rows="3"${ib ? " readonly" : ""}>${esc(addr)}</textarea>`)
              + (ib ? sfPF("Client name", esc(ib.client)) : sfPF("Card payment", sfTog("sfm-card", !!(rec && rec.pay_by_card)), "Yes puts a Pay by card button on the invoice email. Bank details are on the invoice either way."))),
            `<span class="sf-say" id="sf-save-msg"></span>${rec ? sfFootBtn(false, 'data-sf="inv-cancel"', "Cancel") : sfFootBtn(false, "data-sf-close", "Not now")}${sfFootBtn(true, 'data-sf="save-monthly"', rec ? "Save" : "Set up invoicing")}`, { edit: true });
        } else if (!rec) {
          sfShell(eye, "Monthly invoice", chip, tabs, `<div class="sf-lock"><b>No monthly invoice yet.</b> Ask Danielle to set it up: changing what a client is invoiced is for management.</div>`, sfFootBtn(true, "data-sf-close", "Close"));
        } else {
          const line = Array.isArray(rec.line_items) && rec.line_items[0] ? rec.line_items[0].description : rec.name;
          const lock = r.client_status === "paused" ? `<div class="sf-lock"><b>Paused.</b> No monthly invoice is raised, and nothing is chased, until they're Active again.</div>` : r.leaving_on ? `<div class="sf-lock"><b>Leaving ${esc(sfDayYear(r.leaving_on))}.</b> Nothing is raised after they've gone.</div>` : "";
          sfShell(eye, "Monthly invoice", chip, tabs, lock
            + sfSec("What we charge", `<dl class="sf-pdl">${sfPR("Monthly fee", rec.amount_pence ? `${sfGbp(rec.amount_pence)} + VAT` : sfMiss("No amount"))}${sfPR("Line on the invoice", esc(String(line || "").replace(/\{month year\}|\{month\}|Month YYYY/g, sfYmName(rec.pays_ahead ? sfYmAdd(F.ym, 1) : F.ym))))}${sfPR("Pays a month ahead", rec.pays_ahead ? "Yes: each invoice is for the month after it's raised" : "No")}${sfPR("First month", rec.start_month ? esc(sfYmName(rec.start_month)) : "")}${sfPR("Raised on", rec.day_of_month ? `The ${rec.day_of_month}${ordinal(rec.day_of_month)} of each month` : "")}${sfPR("Due on", rec.due_day ? `The ${rec.due_day}${ordinal(rec.due_day)}` : "")}</dl>`)
            + sfSec("Who pays", `<dl class="sf-pdl">${sfPR("Bill to", esc(rec.bill_to_name || rec.name || ""))}${sfPR("Invoice email", esc(rec.bill_to_email || rec.match_email || ""))}${sfPR("Copy to", esc(rec.cc_email || ""))}${sfPR("Billing address", esc(rec.bill_to_address || ""))}${r.inter_brand_invoice ? sfPR("Client name", esc(rec.contact_name || nameOf(r))) : sfPR("Card payment", rec.pay_by_card ? "Yes: the email has a Pay by card button" : "No")}</dl>`),
            `${sfFootBtn(false, "data-sf-close", "Close")}${sfData.canMoney ? sfFootBtn(true, 'data-sf="inv-edit"', "Edit") : ""}`);
        }
      } else if (sfInvTab === "oneoff") {
        const b = sfShell(eye, "Raise a one-off", chip, tabs, `<p class="sf-say sf-note" style="margin-top:0">For anything outside the monthly fee, such as an extra reel or their first invoice.</p><div id="sf-oneoff-slot"></div>`,
          `<span class="sf-say" id="siv-msg"></span>${sfFootBtn(false, "data-sf-close", "Close")}${sfFootBtn(false, 'id="siv-pdf"', "Preview")}${sfFootBtn(false, 'id="siv-create"', "Save draft")}${sfFootBtn(true, 'id="siv-send"', "Create and send")}`, { edit: true });
        sfLend("smm-panel-invoices", b.querySelector("#sf-oneoff-slot"));
        renderInvoicing(r, $("smm-panel-invoices"), r._lastDocs || F.docs, false, r._lastWarn || null)
          .then(() => { if (!$("siv-name")) ["siv-pdf", "siv-create", "siv-send"].forEach((id) => $(id)?.remove()); });
      } else {
        const rows = sfData.invoices === null ? `<p class="sf-say sf-note">Loading…</p>` : F.invs.length ? `<div class="sf-tbl"><div class="sf-tbl-h"><span>Invoice</span><span>Issued</span><span class="num">Amount</span><span>Status</span><span></span></div>${F.invs.map((v) => `<div class="sf-tbl-r"><span>${esc(v.number || "Draft")}</span><span>${esc(sfDayYear(v.issued_date || v.created_at))}</span><span class="num">${sfGbp(v.total_pence)}</span><span>${sfInvChip(v)}</span><span class="sf-tbl-a"><button type="button" class="sf-act" data-sf="inv-view" data-id="${esc(v.id)}">View</button>${v.status !== "draft" ? `<button type="button" class="sf-act" data-sf="inv-resend" data-id="${esc(v.id)}">Resend</button>` : sfData.canMoney ? `<button type="button" class="sf-act" data-sf="inv-del" data-id="${esc(v.id)}">Delete</button>` : ""}</span></div>`).join("")}</div><p class="sf-say sf-note">Amounts include VAT. A draft can be deleted here; marking paid and voiding are on the Invoicing page.</p>` : `<p class="sf-say sf-note">No invoices yet.</p>`;
        sfShell(eye, "All invoices", chip, tabs, rows, sfFootBtn(true, "data-sf-close", "Close"));
      }
    }

    // ---- Saving ----
    const sfMsg = (t, bad) => { const el = $("sf-save-msg"); if (el) { el.textContent = t; el.style.color = bad ? "#8a3f3f" : ""; } };
    async function sfUpdate(r, patch) {
      if (isDemo(r)) { Object.assign(r, patch); return null; }
      const { error } = await supabase.from("smm_leads").update(patch).eq("id", r.id);
      if (!error) Object.assign(r, patch);
      return error;
    }
    /* A note at each key step (Danielle, 5 Nov 2026): when the stage moves,
       a call is booked, they're paused or a follow-up is set, it's written
       into Notes, so the file is a full record and not only the banner. */
    async function sfAutoNote(r, subject, body) {
      if (!r || !body) return;
      if (isDemo(r)) { if (r._thread) r._thread.messages.push({ id: "n" + Date.now(), channel: "note", subject, body, created_by: ME, created_at: new Date().toISOString() }); return; }
      if (!WORKER) return;
      try { const token = await authToken(); await fetch(`${WORKER}/booking/message`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: r.id, source: "smm", subject, body }) }); } catch (_) {}
    }
    function sfStageNote(r, stage) {
      const day = (iso) => sfDay(iso);
      const now = new Date().toISOString();
      const call = r.meeting_at && new Date(r.meeting_at) > new Date() ? ` Call booked for ${sfWhen(r.meeting_at)}.` : "";
      switch (stage) {
        case "inquiry": return "Back at Enquiry.";
        case "meeting_set": return `Moved to Discovery call.${call}`;
        case "proposal_sent": return `Proposal sent. Chase on ${day(sfAddDays(now, 3))}, then ${day(sfAddDays(now, 5))} if there's no reply.`;
        case "pricing_call": return `Moved to Pricing call.${call}`;
        case "contract_signed": return `Contract sent. Chase on ${day(sfAddDays(now, 3))}, then ${day(sfAddDays(now, 5))} if it isn't signed.`;
        case "onboarding": return "Signed contract back. Onboarding started: invoice the onboarding fee and set up the monthly invoice.";
        case "active_client": return `Made a client active.${r.price ? ` Monthly fee ${r.price}.` : ""}${r.start_date ? ` Started ${sfDayYear(r.start_date)}.` : ""}`;
        case "lost": return `Marked lost${r.lost_reason ? `: ${r.lost_reason}` : ""}.`;
        default: return "";
      }
    }
    async function sfSaveClient(r, btn) {
      const v = (id) => ($(id)?.value || "").trim();
      const full = v("sfe-name"), parts = full.split(/\s+/);
      const hours = v("sfe-hours");
      const patch = {
        full_name: full || null, first_name: parts[0] || null, last_name: parts.slice(1).join(" ") || null,
        business: v("sfe-business") || null, email: v("sfe-email") || null, phone: v("sfe-phone") || null,
        package_name: v("sfe-pkg") || null, price: v("sfe-price") || null, contracted_hours_per_month: hours === "" ? null : Number(hours),
        platforms: [...document.querySelectorAll("[data-sfe-plat]")].filter((c) => c.checked).map((c) => c.getAttribute("data-sfe-plat")),
        social_media_manager: v("sfe-mgr") || null, start_date: v("sfe-start") || null, inter_brand_invoice: sfTogOn("sfe-ibi"),
        package_details: Object.assign({}, r.package_details || {}, { onboarding_fee: v("sfe-obfee") === "" ? null : Number(v("sfe-obfee")),
          tier: v("sfe-tier") || null, video: sfTogOn("sfe-video"), shoot_frequency: sfTogOn("sfe-video") ? (v("sfe-freq") || null) : null, outputs: ($("sfe-out")?.value || "").trim() || null }),
      };
      // These three come with supabase/smm_stages_and_follow_ups.sql.
      const extra = { source: v("sfe-src") || null, source_detail: v("sfe-srcwho") || null, billed_brand: v("sfe-brand") || null };
      patch.message = ($("sfe-msg")?.value || "").trim() || null;
      if (patch.inter_brand_invoice && !extra.billed_brand) { sfMsg("Choose the brand that pays: the invoice can't go out without it.", true); $("sfe-brand")?.focus(); return; }
      btn.disabled = true; sfMsg("Saving…");
      let error = await sfUpdate(r, Object.assign({}, patch, extra));
      if (error && /source|billed_brand/i.test(error.message || "")) {
        error = await sfUpdate(r, patch);
        if (!error) { btn.disabled = false; renderBoard(); sfDraw(r); sfMsg("Saved, except How they came in and the brand: run supabase/smm_stages_and_follow_ups.sql first.", true); return; }
      }
      if (error) { btn.disabled = false; sfMsg(/inter_brand|social_media_manager/i.test(error.message || "") ? "Needs supabase/smm_manager_and_interbrand.sql run first." : "Couldn't save: " + error.message, true); return; }
      renderBoard(); sfClosePop(); sfDraw(r);
    }
    async function sfSaveChannels(r, btn) {
      const patch = {}; SF_PLATS.forEach((p) => { patch[SF_URL[p]] = ($("sfc-" + p)?.value || "").trim() || null; });
      btn.disabled = true; sfMsg("Saving…");
      const error = await sfUpdate(r, patch);
      if (error) { btn.disabled = false; sfMsg("Couldn't save: " + error.message, true); return; }
      sfClosePop(); sfDraw(r);
    }
    async function sfSaveMonthly(r, btn) {
      const rec = sfData.recurring;
      const v = (id) => ($(id)?.value || "").trim();
      const pounds = parseFloat(v("sfm-amt"));
      const email = v("sfm-email");
      if (!(pounds > 0)) { sfMsg("Add the monthly fee first.", true); $("sfm-amt")?.focus(); return; }
      if (!email) { sfMsg("Add the email it goes to.", true); $("sfm-email")?.focus(); return; }
      if (r.inter_brand_invoice && !r.billed_brand) { sfMsg("Choose the brand that pays in Client › Edit first.", true); return; }
      const body = {
        id: rec ? rec.id : undefined, social: true, lead_id: r.id, pay_by_card: r.inter_brand_invoice ? false : sfTogOn("sfm-card"), pays_ahead: sfTogOn("sfm-ahead"), due_day: v("sfm-due"),
        name: rec ? rec.name : `${nameOf(r) === "—" ? (r.business || "Client") : nameOf(r)}: social media`, contact_name: nameOf(r) === "—" ? "" : nameOf(r),
        amount_pence: Math.round(pounds * 100), match_email: rec ? (rec.match_email || email) : email, match_text: rec ? rec.match_text : "", start_month: v("sfm-start"),
        auto: { auto_send: rec ? !!rec.auto_send : true, day_of_month: v("sfm-day"), frequency: (rec && rec.frequency) || "monthly", end_month: (rec && rec.end_month) || "", bill_to_name: v("sfm-bill"), bill_to_email: email, cc_email: v("sfm-cc"), bill_to_address: v("sfm-addr"), terms_days: rec && rec.terms_days != null ? rec.terms_days : "", line: v("sfm-line") },
      };
      btn.disabled = true; sfMsg("Saving…");
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/invoicing/recurring`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify(body) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || "Couldn't save it.");
        sfData.recurring = undefined; sfEditing = false;
        const t2 = await authToken();
        const rr = await fetch(`${WORKER}/invoicing/recurring`, { headers: { Authorization: "Bearer " + t2 } }).then((x) => x.json()).catch(() => ({}));
        sfData.recurring = ((rr && rr.recurring) || []).find((x) => String(x.lead_id || "") === String(r.id)) || null;
        sfDraw(r); sfOpen("invoice");
      } catch (e) { btn.disabled = false; sfMsg(e.message || "Couldn't save it.", true); }
    }
    async function sfUploadPlan(r, btn) {
      const f = $("sfp-file")?.files?.[0], ym = $("sfp-month")?.value;
      if (!f) { sfMsg("Choose the file first.", true); return; }
      if (isDemo(r)) { r._thread.documents.push({ id: "d" + Date.now(), category: "content_plan", title: `Content plan - ${sfYmName(ym)}`, file_name: f.name, created_at: new Date().toISOString() }); sfClosePop(); sfDraw(r); return; }
      btn.disabled = true; sfMsg("Uploading…");
      try {
        const token = await authToken();
        const qs = new URLSearchParams({ booking_id: r.id, source: "smm", category: "content_plan", file_name: f.name, content_type: f.type || "application/octet-stream", title: `Content plan - ${sfYmName(ym)}` });
        const res = await fetch(`${WORKER}/booking/document?${qs}`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": f.type || "application/octet-stream" }, body: f });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.document) throw new Error(j.error || "Upload failed.");
        sfClosePop(); loadThread(r);
      } catch (e) { btn.disabled = false; sfMsg(e.message || "Couldn't upload it.", true); }
    }
    async function sfSendEmail(r, btn) {
