        if (cyc.booked) items.push(li(1, "Shoot booked for " + esc(dayDate(cyc.booked))));
        else if (cyc.due && cyc.due.slice(0, 7) <= sfYmAdd(F.ym, 1)) { items.push(li(0, `Shoot due in ${esc(monthYear(cyc.due))}, not booked`)); if (!acts) acts += sfHb(true, 'data-sf="book"', "Book the shoot"); }
