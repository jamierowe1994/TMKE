        mk({ full_name: "Sofia Reyes", email: "sofia@reyeshomes.co.uk", phone: "07700 900777", business: "Reyes Homes", kind: "enquiry", pipeline_stage: "contract_signed", package_name: "Starter", price: "£450 / month", platforms: ["Instagram"], ageDays: 12 }),
        mk({ full_name: "James Okafor", email: "james@fineandcountry.com", phone: "07700 900444", business: "Fine & Country (Kettering)", kind: "enquiry", marketing_opt_in: true, pipeline_stage: "active_client", client_status: "active", package_name: "Growth", price: "£750 / month", start_date: "2026-05-01", business_address: "12 Market Street, Kettering, NN16 0AH", instagram_url: "instagram.com/fineandcountrykettering", facebook_url: "facebook.com/fineandcountrykettering", linkedin_url: "linkedin.com/company/fineandcountry", platforms: ["Instagram", "Facebook", "LinkedIn"], ageDays: 40 }),
        mk({ full_name: "Elena Frost", email: "elena@frostandco.co.uk", phone: "07700 900555", business: "Frost & Co", kind: "discovery", marketing_opt_in: true, pipeline_stage: "active_client", client_status: "paused", ageDays: 90 }),
        mk({ full_name: "Owen Pryce", email: "owen@pryceandpartners.co.uk", phone: "07700 900999", business: "Pryce & Partners", kind: "enquiry", pipeline_stage: "onboarding", package_name: "Growth", price: "£750 / month", start_date: "2026-07-15", platforms: ["Instagram", "Facebook"], ageDays: 5 }),
      ];
      rows[0]._thread = { messages: [
        { id: "n1", channel: "note", body: "Warm lead — followed us on Instagram first. Wants reels + a content plan.", is_pinned: true, created_by: "Abby", created_at: ago(0.5) },
      ], documents: [] };
      rows[6]._thread = { messages: [
        { id: "n2", channel: "note", body: "On the £750/mo Growth plan. Prefers a monthly call on the first Tuesday.", is_pinned: true, created_by: "Abby", created_at: ago(38) },
        { id: "e1", channel: "email", direction: "inbound", subject: "Social media help", body: "Hi — we're looking to hand over our Instagram and Facebook. Can you tell me how it works?", created_at: ago(41) },
        { id: "e2", channel: "email", direction: "outbound", subject: "Re: Social media help", body: "Hi James, absolutely — I've attached our brochure. Shall we set up a quick discovery call this week?", created_by: "Danielle", created_at: ago(40) },
        { id: "e3", channel: "email", direction: "outbound", subject: "Your contract", body: "Great to chat today. Your agreement is attached — sign at your leisure and we'll get started.", is_automated: false, created_by: "Abby", created_at: ago(37) },
        { id: "n3", channel: "note", body: "Contract signed 2 days after sending. Onboarding call booked.", is_pinned: false, created_by: "Abby", created_at: ago(35) },
      ], documents: [
        { id: "doc1", file_name: "TMKE-Social-Brochure.pdf", title: "Social media brochure", category: "prep" },
        { id: "doc2", file_name: "Fine-and-Country-Agreement.pdf", title: "Signed agreement", category: "agreement" },
        { id: "doc3", file_name: "Invoice-1024.pdf", title: "Invoice #1024", category: "invoice", invoice_date: "2026-06-01", paid_date: "2026-06-09" },
        { id: "doc4", file_name: "Invoice-1041.pdf", title: "Invoice #1041", category: "invoice", invoice_date: "2026-07-01", paid_date: null },
      ] };
      // Two months of demo reports on the active client so the Insights tab + Trends render in preview.
      rows[6]._reports = DEMO_REPORTS.filter((x) => x.accountId === "tmke").map((x) => ({ id: x.id, platform: x.platform, month: x.month, year: x.year, data: x.data }));
      return rows;
    }

    // ---------- Boot ----------
    (async () => {
      let session;
      if (import.meta.env.DEV) session = (await supabase.auth.getSession()).data.session || { user: { email: "dev@tmke.co.uk", id: "dev" } };
      else { session = await requireAdmin(); if (!session) return; }
      // Who I am, for note ownership. A note's created_by is the author's email.
      ME = (session && session.user && session.user.email) || "";

      let rows = [];
      try { const { data } = await supabase.from("smm_leads").select("*").order("created_at", { ascending: false }); rows = data || []; } catch (_) {}
      if (!rows.length && import.meta.env.DEV) rows = demoRows();
      all = rows;

      $("smm-loading").hidden = true;
      $("smm-board").hidden = false;
      renderBoard();

      $("smm-filters").addEventListener("click", (e) => {
        const btn = e.target.closest(".smm-chip"); if (!btn) return;
        goToFilter(btn.getAttribute("data-filter") || "all");
      });
      $("smm-search").addEventListener("input", (e) => { q = e.target.value.toLowerCase().trim(); renderBoard(); });
      $("smm-show-lost").addEventListener("change", (e) => { showLost = e.target.checked; renderBoard(); });
      $("smm-add-lead").addEventListener("click", openAddLead);
      // Keep the top scrollbar and the board in sync (either can be dragged).
      let riSyncLock = false;
      $("smm-scrolltop").addEventListener("scroll", () => { if (riSyncLock) return; riSyncLock = true; $("smm-board").scrollLeft = $("smm-scrolltop").scrollLeft; riSyncLock = false; });
      $("smm-board").addEventListener("scroll", () => { if (riSyncLock) return; riSyncLock = true; $("smm-scrolltop").scrollLeft = $("smm-board").scrollLeft; riSyncLock = false; });
      window.addEventListener("resize", syncTopScroll);
      $("smm-file-close").addEventListener("click", closeFile);
      $("smm-file").addEventListener("click", (e) => { if (e.target === $("smm-file")) closeFile(); });
      document.addEventListener("keydown", (e) => {
        if (e.key !== "Escape") return;
        if ($("smm-modal-host").children.length) { closeModal(); return; }
        if (!$("smm-file").hidden) closeFile();
      });
    })();
  </script>
