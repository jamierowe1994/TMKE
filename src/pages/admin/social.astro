    .cs-table th { text-align: left; font-size: 10.5px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.5); padding: 10px 12px; border-bottom: 1px solid rgba(28,29,34,0.12); white-space: nowrap; }
