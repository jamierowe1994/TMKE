    const EMAIL_SVG = '<svg viewBox="0 0 24 24"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg>';
    const PHONE_SVG = '<svg viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>';
    const BIZ_SVG = '<svg viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/></svg>';
    const DOC_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>';
    const CAL_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg>';
    const USER_SVG = '<svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const SMM_CATS = [["agreement", "Contract"], ["prep", "Proposal"], ["strategy", "Strategy"], ["content_plan", "Content plan"], ["insights_report", "Insights report"], ["delivery", "Deliverables"], ["invoice", "Invoice"], ["other", "Other"]];
    const catLabel = (c) => (SMM_CATS.find((x) => x[0] === c) || [, "Document"])[1];
    const isDemo = (r) => String(r.id).startsWith("demo");
    async function authToken() {
      try {
        let session = (await supabase.auth.getSession()).data.session;
        // Refresh if the token is missing or expiring within 60s, so uploads
        // don't fail with "Unauthorised" on a stale session.
        if (!session || (session.expires_at && session.expires_at * 1000 < Date.now() + 60000)) {
          try { const r = await supabase.auth.refreshSession(); if (r.data && r.data.session) session = r.data.session; } catch (_) {}
        }
        return (session && session.access_token) || "";
      } catch (_) { return ""; }
    }

    let ME = "";            // the signed-in admin's email — a note belongs to whoever wrote it
    let all = [], kindFilter = "all", q = "", showLost = false, current = null, activeTab = "notes", notesTab = "pkg";
    // Where the admin top bar ends, for the pop-outs to start below it.
    const setSmmTop = () => { const t = document.querySelector(".ash-top"); document.documentElement.style.setProperty("--smm-top", `${t ? Math.max(0, Math.round(t.getBoundingClientRect().bottom)) : 0}px`); };
    setSmmTop(); window.addEventListener("resize", setSmmTop);
    const NOTE_TABS = [["pkg", "Package details"], ["notes", "Notes"], ["activity", "Client activity"], ["files", "Files"]];

    // ---------- Board ----------
    function visible() {
      return all
        .filter((r) => showLost ? true : r.pipeline_stage !== "lost" && r.status !== "spam")
        .filter((r) => {
          const f = kindFilter;
          if (f === "all") return true;
          if (f === "enquiry" || f === "brochure") return r.kind === f;
          return stageOf(r) === f; // meeting_set (Discovery calls) / proposal_sent / contract_signed / onboarding / active_client (Clients)
        })
        .filter((r) => !q || (nameOf(r) + " " + (r.email || "") + " " + (r.business || "")).toLowerCase().includes(q));
    }
    // Shared by the filter chips and any "See all" card — both just narrow
    // the board to one kind/stage via the same kindFilter var.
    function goToFilter(key) {
      kindFilter = key;
      document.querySelectorAll(".smm-chip").forEach((c) => c.classList.toggle("is-active", c.getAttribute("data-filter") === key));
      renderBoard();
    }
    function renderBoard() {
      const board = $("smm-board");
      const rows = visible();
      if (kindFilter === "all") {
        // One row per stage; cards run left-to-right and that row scrolls on
        // its own past ~3 cards (.smm-stage-cards) — no board-wide horizontal
        // scroll across every stage, and no cap/"see all", the row just scrolls.
        board.classList.remove("is-list");
        // "Clients" (active_client) is structurally the busiest stage — it
        // only grows, never clears out like the others — so it wraps onto a
        // couple of lines instead of one scrolling row, and past 8 clients
        // a "See all" hands off to the existing Clients list view rather
        // than growing a 3rd/4th line.
        const CLIENTS_WRAP_CAP = 8;
        // Lost cards have a row of their own, after Active client, when
        // "Show lost" is on; they no longer fall into Inquiry (30 Sep 2026).
        const lostRow = showLost ? [{ key: "lost", label: "Lost" }] : [];
        board.innerHTML = [...STAGES, ...lostRow].map((s) => {
          const allCards = s.key === "lost" ? rows.filter((r) => r.pipeline_stage === "lost") : rows.filter((r) => r.pipeline_stage !== "lost" && stageOf(r) === s.key);
          const isClients = s.key === "active_client";
          const overCap = isClients && allCards.length > CLIENTS_WRAP_CAP;
          const cards = overCap ? allCards.slice(0, CLIENTS_WRAP_CAP) : allCards;
          const seeAll = overCap ? `<button type="button" class="smm-see-all" data-goto-filter="active_client">See all ${allCards.length} &rarr;</button>` : "";
          return `<div class="smm-col smm-stage-row">
            <div class="smm-col-head"><span class="smm-col-name">${esc(s.label)}</span><span class="smm-col-count">${allCards.length}</span></div>
            <div class="smm-stage-cards${isClients ? " is-wrap" : ""}" data-stage="${s.key}">${allCards.length ? cards.map(cardHtml).join("") + seeAll : '<div class="smm-col-empty">Drop here</div>'}</div>
          </div>`;
        }).join("");
        wireCards(board);
        board.querySelectorAll("[data-goto-filter]").forEach((btn) => {
          btn.addEventListener("click", () => goToFilter(btn.getAttribute("data-goto-filter")));
        });
        board.querySelectorAll(".smm-stage-cards").forEach((col) => {
          col.addEventListener("dragover", (e) => { e.preventDefault(); col.classList.add("drop-hover"); });
          col.addEventListener("dragleave", () => col.classList.remove("drop-hover"));
          col.addEventListener("drop", (e) => {
            e.preventDefault(); col.classList.remove("drop-hover");
            const id = e.dataTransfer.getData("text/plain");
            const r = all.find((x) => x.id === id); if (!r) return;
            moveToStage(r, col.getAttribute("data-stage"));
          });
        });
      } else {
        // A filter is on → single-column line view of just the matches.
        board.classList.add("is-list");
        const label = document.querySelector(".smm-chip.is-active")?.textContent || "Results";
        board.innerHTML = `<div class="smm-list"><div class="smm-list-head">${esc(label)} · ${rows.length}</div>${rows.length ? rows.map(rowHtml).join("") : '<div class="smm-col-empty">No matches.</div>'}</div>`;
        wireCards(board);
      }
      syncTopScroll();
    }
    function syncTopScroll() {
      const board = $("smm-board"), top = $("smm-scrolltop"), inner = $("smm-scrolltop-inner");
      if (!board || !top) return;
      if (board.classList.contains("is-list")) { top.hidden = true; return; }
      const over = board.scrollWidth > board.clientWidth + 1;
      top.hidden = !over;
      if (over) inner.style.width = board.scrollWidth + "px";
    }
    function wireCards(board) {
      board.querySelectorAll("[data-id]").forEach((el) => {
        const r = () => all.find((x) => x.id === el.getAttribute("data-id"));
        el.addEventListener("click", (e) => { if (e.target.closest(".smm-card-act")) return; openFile(el.getAttribute("data-id")); });
        el.querySelector("[data-cmeet]")?.addEventListener("click", (e) => { e.stopPropagation(); const x = r(); if (x) openMeeting(x); });
        el.querySelector("[data-cmsg]")?.addEventListener("click", (e) => { e.stopPropagation(); const x = r(); if (x) { activeTab = "emails"; openFile(x.id); } });
        if (el.classList.contains("smm-card")) {
          el.addEventListener("dragstart", (e) => { e.dataTransfer.setData("text/plain", el.getAttribute("data-id")); e.dataTransfer.effectAllowed = "move"; el.classList.add("dragging"); });
          el.addEventListener("dragend", () => el.classList.remove("dragging"));
        }
      });
    }
    /* A package as a pill: one line, "…" when it's still too long, the full
       name on hover; Shot & Scheduled as S&S (Danielle, 19 Oct 2026). */
    const pkgLabel = (name) => String(name || "").replace(/\bshot\s*(?:&|and)\s*scheduled\b/gi, "S&S");
    const pkgPill = (name) => `<span class="smm-kind is-package" title="${esc(name)}">${esc(pkgLabel(name))}</span>`;
    function rowHtml(r) {
      const kc = r.kind === "discovery" ? " is-discovery" : r.kind === "brochure" ? " is-brochure" : "";
      const st = stageOf(r);
      const signed = STAGE_INDEX[st] >= STAGE_INDEX["contract_signed"];
      const pill = signed && r.package_name ? pkgPill(r.package_name) : `<span class="smm-kind${kc}">${esc(KIND_LABEL[r.kind] || r.kind || "Lead")}</span>`;
      return `<div class="smm-row" data-id="${esc(r.id)}">
        ${pill}
        <div class="smm-row-main"><div class="smm-row-name">${esc(nameOf(r))}</div>${r.business ? `<div class="smm-row-biz">${esc(r.business)}</div>` : ""}</div>
        <div class="smm-row-email">${esc(r.email || "")}</div>
        <div class="smm-row-stage">${esc(r.pipeline_stage === "lost" ? "Lost" : STAGES[STAGE_INDEX[st]].label)}</div>
        <div class="smm-row-acts">
          <button type="button" class="smm-card-act" data-cmeet>Set a meeting</button>
          <button type="button" class="smm-card-act" data-cmsg>Send a message</button>
        </div>
      </div>`;
    }
    function cardHtml(r) {
      const kc = r.kind === "discovery" ? " is-discovery" : r.kind === "brochure" ? " is-brochure" : "";
      const st = stageOf(r);
      // From Contract signed on, the pill shows the package they're on (falls back
      // to the lead type until a package is set).
      const signed = STAGE_INDEX[st] >= STAGE_INDEX["contract_signed"];
      const pill = signed && r.package_name
        ? pkgPill(r.package_name)
        : `<span class="smm-kind${kc}">${esc(KIND_LABEL[r.kind] || r.kind || "Lead")}</span>`;
      const meeting = r.meeting_at ? `<div class="smm-card-line">${CAL_SVG}Meeting ${esc(fmtDateTime(r.meeting_at))}</div>`
        : (r.kind === "discovery" && r.call_at ? `<div class="smm-card-line">${CAL_SVG}Call ${esc(fmtDateTime(r.call_at))}</div>` : "");
      const cstatus = r.leaving_on && r.pipeline_stage !== "lost" ? `<span class="smm-card-status is-leaving">${esc(leavingLabel(r))}</span>`
        : st === "active_client" && r.client_status && r.client_status !== "active" ? `<span class="smm-card-status is-${r.client_status}">${esc(CLIENT_STATUS[r.client_status] || r.client_status)}</span>` : "";
      return `<div class="smm-card" draggable="true" data-id="${esc(r.id)}">
        <div class="smm-card-top">${pill}<span class="smm-card-when">${esc(fmtWhen(r.created_at))}</span></div>
        <div class="smm-card-name">${esc(nameOf(r))}</div>
        ${r.business ? `<div class="smm-card-biz">${esc(r.business)}</div>` : ""}
        ${r.email ? `<div class="smm-card-line">${EMAIL_SVG}<span class="smm-card-line-t">${esc(r.email)}</span></div>` : ""}
        ${meeting}
        <div class="smm-card-foot">
          <div class="smm-card-acts">
            <button type="button" class="smm-card-act" data-cmeet>Set a meeting</button>
            <button type="button" class="smm-card-act" data-cmsg>Send a message</button>
          </div>
          ${cstatus}
        </div>
      </div>`;
    }

    // ---------- Customer file ----------
    function contactRow(icon, label, value, href) {
      if (!value) return "";
      const v = href ? `<a class="smm-cd-v" href="${esc(href)}">${esc(value)}</a>` : `<span class="smm-cd-v">${esc(value)}</span>`;
      return `<div class="smm-cd-row"><span class="smm-cd-ico">${icon}</span><div class="smm-cd-main"><span class="smm-cd-k">${esc(label)}</span>${v}</div><button type="button" class="smm-copy" data-copy="${esc(value)}" title="Copy">${COPY_SVG}</button></div>`;
    }
    // Editable contact-detail row (contact name / email / phone / business).
    function cdEdit(icon, label, field, value) {
      return `<div class="smm-cd-row"><span class="smm-cd-ico">${icon}</span><div class="smm-cd-main"><span class="smm-cd-k">${esc(label)}</span><input class="smm-cd-input" data-cf="${field}" value="${esc(value || "")}" placeholder="Add ${esc(label.toLowerCase())}…"></div><button type="button" class="smm-copy" title="Copy">${COPY_SVG}</button></div>`;
    }
    function openFile(id) {
      const r = all.find((x) => x.id === id); if (!r) return;
      current = r;
      const st = stageOf(r);
      const idx = STAGE_INDEX[st];
      const n = STAGES.length;
      const isActive = st === "active_client";
      const cs = r.client_status || "active";
      const next = idx < n - 1 ? STAGES[idx + 1].key : null;
      const showProp = idx >= STAGE_INDEX["proposal_sent"];
      // The onboarding checklist, from Onboarding on (Danielle, 21 Oct 2026).
      const showOnb = idx >= STAGE_INDEX["onboarding"];
      // Its own tab only while they're onboarding; after that it's kept for
      // reference under Notes > Package details (Danielle, 22 Oct 2026).
      const onbTab = st === "onboarding";
      if (["onboarding", "invoices", "videography"].includes(activeTab) && !showOnb) activeTab = "notes";
      if (activeTab === "onboarding" && !onbTab) activeTab = "notes";
      if (activeTab === "insights" && !isActive) activeTab = "notes"; // social channels + engagement (+ Direct Debit) from Proposal sent on
      const plats = Array.isArray(r.platforms) ? r.platforms : [];
      const pipe = `<div class="smm-pipe"><div class="smm-pipe-track"><div class="smm-pipe-fill" style="width:${(idx / (n - 1)) * 100}%"></div></div>${STAGES.map((s, i) => {
        const cls = (i <= idx ? " is-done" : "") + (i === idx ? " is-current" : "") + (i === 0 ? " smm-pipe-step--first" : "") + (i === n - 1 ? " smm-pipe-step--last" : "");
        return `<div class="smm-pipe-step${cls}" data-stage="${s.key}" style="left:${(i / (n - 1)) * 100}%"><span class="smm-pipe-dot"></span><span class="smm-pipe-label">${esc(s.label)}</span></div>`;
      }).join("")}</div>`;
      const acct = r.account_created ? "Created at submission" : (r.account_user_id ? "Existing account" : "None");
      $("smm-file-body").innerHTML = `
        <header class="smm-file-head">
          <h2 class="smm-file-name"><span class="smm-name-text">${esc(nameOf(r))}</span><button type="button" class="smm-name-edit" data-editname title="Edit name">${PENCIL_SVG}</button>${isActive ? `<span class="smm-status-pill is-${cs}">${esc(CLIENT_STATUS[cs])}</span>` : ""}${r.pipeline_stage === "lost" ? `<span class="smm-status-pill is-ended">Lost</span>` : ""}${r.leaving_on && r.pipeline_stage !== "lost" ? `<span class="smm-status-pill is-leaving" title="${esc(r.lost_reason || "")}">${esc(leavingLabel(r))}<button type="button" class="smm-leaving-x" data-cancel-leaving aria-label="Cancel the date">&times;</button></span>` : ""}</h2>
          <p class="smm-file-sub">${esc(r.business || KIND_LABEL[r.kind] || "Lead")}</p>
        </header>
        ${pipe}
        <div class="smm-file-grid">
          <div>
            <div class="smm-sec">
              <h3 class="smm-sec-h">Contact details</h3>
              <div class="smm-cd-card">
                ${cdEdit(USER_SVG, "Contact name", "full_name", nameOf(r) === "—" ? "" : nameOf(r))}
                ${cdEdit(EMAIL_SVG, "Email", "email", r.email)}
                ${cdEdit(PHONE_SVG, "Phone", "phone", r.phone)}
                ${cdEdit(BIZ_SVG, "Business", "business", r.business)}
              <!-- A social client added here doesn't land in the CRM on its own -
                   only website enquiries do that. This closes the gap.
                   Inside the card, two lines (Danielle, 20 Oct 2026): the
                   contact card and the member hub box, then Unlink and See
                   more info. -->
              <div class="smm-acct">
                <div class="smm-acct-l1">
                  <span class="smm-crm-row" id="smm-crm-row"></span>
                  <span class="smm-hubbox${r.account_user_id ? " is-linked" : ""}"><span class="smm-hubbox-k">Member hub</span><b>${r.account_user_id ? "Linked ✓" : "Not linked"}</b></span>
                  ${!r.account_user_id && r.email ? `<button type="button" class="smm-btn smm-btn--sm" data-linkacct>Link to hub account</button>` : ""}
                </div>
                <div class="smm-acct-l2">
                  ${r.account_user_id ? `<button type="button" class="smm-textbtn" data-unlinkacct>Unlink</button>` : !r.email ? `<span class="smm-crm-note">Add an email to link a hub account.</span>` : ""}
                  <button type="button" class="smm-more-toggle" data-more>See more info ${CHEV_SVG}</button>
                </div>
              </div>
              <div class="smm-more" hidden>
                <div class="smm-field"><span class="smm-field-k">Type</span><span class="smm-field-v">${esc(KIND_LABEL[r.kind] || r.kind || "Lead")}</span></div>
                <div class="smm-field"><span class="smm-field-k">Received</span><span class="smm-field-v">${esc(fmtDateTime(r.created_at))}</span></div>
                ${r.call_at ? `<div class="smm-field"><span class="smm-field-k">Discovery call</span><span class="smm-field-v">${esc(fmtDateTime(r.call_at))}</span></div>` : ""}
                ${r.meeting_at ? `<div class="smm-field"><span class="smm-field-k">Meeting</span><span class="smm-field-v">${esc(fmtDateTime(r.meeting_at))}</span></div>` : ""}
                <div class="smm-field"><span class="smm-field-k">Marketing</span><span class="smm-field-v">${r.marketing_opt_in ? "Opted in" : "Not opted in"}</span></div>
                <div class="smm-field"><span class="smm-field-k">Account</span><span class="smm-field-v">${esc(acct)}</span></div>
              </div>
              </div>
              <p class="smm-cd-status" id="smm-cd-status"></p>
            </div>
            ${showProp ? `<details class="smm-sec smm-fold"${isActive ? "" : " open"}>
              <summary class="smm-sec-h">Paperwork ${CHEV_SVG}</summary>
              <div class="smm-paper" id="smm-paper"><p class="smm-soon">Loading…</p></div>
            </details>
            <div class="smm-sec">
              <h3 class="smm-sec-h">Engagement &amp; billing</h3>
              <div class="smm-eng">
                <label class="smm-eng-row"><span>Package</span><select data-ef="package_name">${packageOptions(r.package_name)}</select></label>
                <label class="smm-eng-row"><span>Pricing</span><input type="text" data-ef="price" value="${esc(r.price || "")}" placeholder="e.g. £750 / month"></label>
                <label class="smm-eng-row"><span>Contracted hours / month</span><input type="number" min="0" step="0.5" data-ef="contracted_hours_per_month" value="${r.contracted_hours_per_month ?? ""}" placeholder="e.g. 6"></label>
                <label class="smm-eng-row"><span>Start date</span><input type="date" data-ef="start_date" value="${esc(r.start_date || "")}"></label>
                <label class="smm-eng-row"><span>End date</span><input type="date" data-ef="end_date" value="${esc(r.end_date || "")}"></label>
                <div class="smm-eng-row"><span>Inter-brand invoice</span>
                  <div class="pay-toggle" id="ibi-toggle">
                    <button type="button" class="pay-opt ${r.inter_brand_invoice ? "is-active" : ""}" data-ibi="yes">Yes</button>
                    <button type="button" class="pay-opt ${!r.inter_brand_invoice ? "is-active" : ""}" data-ibi="no">No</button>
                  </div>
                </div>
                <label class="smm-eng-row"><span>Social media manager</span><input type="text" data-ef="social_media_manager" value="${esc(r.social_media_manager || "")}" placeholder="Who runs this account"></label>
                <div class="smm-eng-row"><span>Direct debit customer?</span>
                  <div class="pay-toggle" id="dd-toggle">
                    <button type="button" class="pay-opt ${r.direct_debit ? "is-active" : ""}" data-dd="yes">Yes</button>
                    <button type="button" class="pay-opt ${!r.direct_debit ? "is-active" : ""}" data-dd="no">No</button>
                  </div>
                </div>
                <label class="smm-eng-row" id="dd-date-row"><span>Direct debit date</span><select id="dd-date"><option value=""${!r.direct_debit_day ? " selected" : ""}>N/A</option>${Array.from({ length: 28 }, (_, i) => `<option value="${i + 1}"${Number(r.direct_debit_day) === i + 1 ? " selected" : ""}>${i + 1}${["st","nd","rd"][((i) % 10)] && i < 3 ? ["st","nd","rd"][i] : (i + 1) % 10 === 1 && i + 1 !== 11 ? "st" : (i + 1) % 10 === 2 && i + 1 !== 12 ? "nd" : (i + 1) % 10 === 3 && i + 1 !== 13 ? "rd" : "th"}</option>`).join("")}</select></label>
                <label class="smm-eng-row smm-eng-row--full"><span>Business address</span><textarea data-ef="business_address" rows="2" placeholder="For invoicing">${esc(r.business_address || "")}</textarea></label>
              </div>
              <div class="smm-platforms" data-platforms>
                <span class="smm-plat-label">Platforms we manage</span>
                <div class="smm-plat-grid">${PLATFORMS.map((p) => `<label class="smm-plat"><input type="checkbox" data-plat="${p}" ${plats.includes(p) ? "checked" : ""}> ${p}</label>`).join("")}</div>
              </div>
              <p class="smm-eng-status" id="smm-eng-status"></p>
            </div>
            <details class="smm-sec smm-fold"${isActive ? "" : " open"}>
              <summary class="smm-sec-h">Social channels ${CHEV_SVG}</summary>
              <div class="smm-eng">
                <label class="smm-eng-row smm-eng-row--full"><span>Instagram</span><input type="text" data-ef="instagram_url" value="${esc(r.instagram_url || "")}" placeholder="instagram.com/…"></label>
                <label class="smm-eng-row smm-eng-row--full"><span>Facebook</span><input type="text" data-ef="facebook_url" value="${esc(r.facebook_url || "")}" placeholder="facebook.com/…"></label>
                <label class="smm-eng-row smm-eng-row--full"><span>LinkedIn</span><input type="text" data-ef="linkedin_url" value="${esc(r.linkedin_url || "")}" placeholder="linkedin.com/…"></label>
                <label class="smm-eng-row smm-eng-row--full"><span>YouTube</span><input type="text" data-ef="youtube_url" value="${esc(r.youtube_url || "")}" placeholder="youtube.com/…"></label>
                <label class="smm-eng-row smm-eng-row--full"><span>TikTok</span><input type="text" data-ef="tiktok_url" value="${esc(r.tiktok_url || "")}" placeholder="tiktok.com/@…"></label>
              </div>
              <p class="smm-eng-status" id="smm-chan-status"></p>
            </details>` : ""}
            <div class="smm-sec">
              <h3 class="smm-sec-h">${isActive ? "Client status" : "Actions"}</h3>
              ${isActive ? `<div class="smm-status-row">
                <button type="button" class="smm-btn smm-btn--sm ${cs === "active" ? "smm-btn--primary" : ""}" data-cstatus="active">Active</button>
                <button type="button" class="smm-btn smm-btn--sm ${cs === "paused" ? "smm-btn--primary" : ""}" data-cstatus="paused">Paused</button>
                <button type="button" class="smm-btn smm-btn--sm ${cs === "ended" ? "smm-btn--primary" : ""}" data-cstatus="ended">Ended</button>
                <button type="button" class="smm-btn smm-btn--sm ${cs === "internal" ? "smm-btn--primary" : ""}" data-cstatus="internal" title="One of us: run as a client, never invoiced">Internal</button>
              </div>` : `<button type="button" class="smm-btn smm-btn--primary smm-btn--block" data-move="${next}">${esc(NEXT_LABEL[next])}</button>`}
              <div class="smm-file-actions" style="margin-top:10px">
                <button type="button" class="smm-btn smm-btn--danger smm-btn--block" data-lost>Mark lost</button>
                <button type="button" class="smm-btn smm-btn--block smm-btn--del" data-delcard>Delete</button>
              </div>
              ${isActive ? `<p class="smm-hint">Status sets the CRM tag <strong>SMM-Status: ${esc(CLIENT_STATUS[cs])}</strong>${cs === "active" ? " and marks them a Customer" : ""}.</p>` : ""}
            </div>
          </div>
          <div>
            ${r.message ? `<div class="smm-msg">${esc(r.message)}</div>` : ""}
            <div class="smm-tabs" role="tablist">
              <button type="button" class="smm-tab ${activeTab === "notes" ? "is-active" : ""}" data-tab="notes">Notes</button>
              <button type="button" class="smm-tab ${activeTab === "emails" ? "is-active" : ""}" data-tab="emails">Communication<span class="smm-tab-n" id="smm-comm-n"></span></button>
              ${onbTab ? `<button type="button" class="smm-tab ${activeTab === "onboarding" ? "is-active" : ""}" data-tab="onboarding">Onboarding<span class="smm-tab-n" id="smm-onb-n"></span></button>` : ""}
              ${showOnb ? `<button type="button" class="smm-tab ${activeTab === "invoices" ? "is-active" : ""}" data-tab="invoices">Invoicing</button>` : ""}
              ${isActive ? `<button type="button" class="smm-tab ${activeTab === "insights" ? "is-active" : ""}" data-tab="insights">Insights</button>` : ""}
              ${showOnb ? `<button type="button" class="smm-tab ${activeTab === "videography" ? "is-active" : ""}" data-tab="videography">Videography</button>` : ""}
            </div>
            <!-- Notes has its own bar (Danielle, 20 Oct 2026): Package details,
                 Notes, Client activity and Files, one at a time. -->
            <div id="smm-panel-notes" class="smm-panel-body" ${activeTab === "notes" ? "" : "hidden"}>
              <div class="ri-subtabs smm-ntabs">${NOTE_TABS.map(([k, l]) => `<button type="button" class="ri-subtab ${notesTab === k ? "is-active" : ""}" data-ntab="${k}">${l}</button>`).join("")}</div>
              <div class="smm-ntab" data-npanel="pkg" ${notesTab === "pkg" ? "" : "hidden"}><div class="smm-pkg" id="smm-pkg"></div>
                ${showOnb && !onbTab ? `<details class="smm-onb-done"><summary>Onboarding ${CHEV_SVG}</summary><div id="smm-panel-onboarding"></div></details>` : ""}</div>
              <div class="smm-ntab" data-npanel="notes" ${notesTab === "notes" ? "" : "hidden"}><div id="smm-notes-list"><p class="smm-soon">Loading…</p></div></div>
              <div class="smm-ntab" data-npanel="activity" ${notesTab === "activity" ? "" : "hidden"}><div id="smm-activity-wrap"><p class="smm-soon">Loading…</p></div></div>
              <div class="smm-ntab" data-npanel="files" ${notesTab === "files" ? "" : "hidden"}><div id="smm-panel-files"></div></div>
            </div>
            <div id="smm-panel-emails" class="smm-panel-body" ${activeTab === "emails" ? "" : "hidden"}></div>
            ${onbTab ? `<div id="smm-panel-onboarding" class="smm-panel-body" ${activeTab === "onboarding" ? "" : "hidden"}></div>` : ""}
            ${showOnb ? `<div id="smm-panel-invoices" class="smm-panel-body" ${activeTab === "invoices" ? "" : "hidden"}></div>` : ""}
            ${isActive ? `<div id="smm-panel-insights" class="smm-panel-body" ${activeTab === "insights" ? "" : "hidden"}></div>` : ""}
            ${showOnb ? `<div id="smm-panel-videography" class="smm-panel-body" ${activeTab === "videography" ? "" : "hidden"}><p class="smm-soon">Loading…</p></div>` : ""}
            <p class="smm-thread-status" id="smm-thread-status" hidden></p>
          </div>
        </div>`;
      /* Below the admin top bar, which sits above the page's content (and
         so above this): the gap over the card then matches the gap under it,
         and the card scrolls between the two (Danielle, 19 Oct 2026). */
      const topBar = document.querySelector(".ash-top");
      $("smm-file").style.top = topBar ? `${Math.max(0, Math.round(topBar.getBoundingClientRect().bottom))}px` : "";
      $("smm-file").hidden = false;
      document.body.style.overflow = "hidden";
      wireFile(r);
    }
    function closeFile() { $("smm-file").hidden = true; current = null; document.body.style.overflow = ""; }

    function wireFile(r) {
      const body = $("smm-file-body");
      // Quick-copy (reads the sibling input for editable rows)
      body.querySelectorAll("[data-copy], .smm-cd-row .smm-copy").forEach((b) => b.addEventListener("click", async (e) => {
        e.stopPropagation();
        const inp = b.parentElement.querySelector(".smm-cd-input");
        const val = inp ? inp.value.trim() : b.getAttribute("data-copy");
        if (!val) return;
        try { await navigator.clipboard.writeText(val); b.classList.add("is-done"); setTimeout(() => b.classList.remove("is-done"), 1200); } catch (_) {}
      }));
      // Contact details (editable, any stage)
      body.querySelectorAll("[data-cf]").forEach((el) => el.addEventListener("change", () => saveContact(r, el.getAttribute("data-cf"), el.value)));
      // Edit name
      body.querySelector("[data-editname]")?.addEventListener("click", () => startEditName(r));
      // Link this card to the member's hub account
      body.querySelector("[data-linkacct]")?.addEventListener("click", () => linkAccount(r));
      body.querySelector("[data-unlinkacct]")?.addEventListener("click", () => unlinkAccount(r));
      // See more
      body.querySelector("[data-more]")?.addEventListener("click", (e) => {
        const btn = e.currentTarget, more = body.querySelector(".smm-more");
        const open = more.hasAttribute("hidden");
        if (open) more.removeAttribute("hidden"); else more.setAttribute("hidden", "");
        btn.classList.toggle("is-open", open);
        btn.firstChild.textContent = open ? "Hide info " : "See more info ";
      });
      // Pipeline advance (a step = move to that stage)
      body.querySelectorAll("[data-stage]").forEach((s) => s.addEventListener("click", () => moveToStage(r, s.getAttribute("data-stage"))));
      // Move to next stage
      body.querySelector("[data-move]")?.addEventListener("click", (e) => moveToStage(r, e.currentTarget.getAttribute("data-move")));
      // Mark lost
      body.querySelector("[data-lost]")?.addEventListener("click", () => openLost(r, "lost"));
      body.querySelector("[data-cancel-leaving]")?.addEventListener("click", () => cancelLeaving(r));
      // Delete card (test cleanup)
      body.querySelector("[data-delcard]")?.addEventListener("click", () => deleteCard(r));
      // Client status
      body.querySelectorAll("[data-cstatus]").forEach((b) => b.addEventListener("click", () => setClientStatus(r, b.getAttribute("data-cstatus"))));
      // Engagement, channels & platforms (autosave)
      body.querySelectorAll("[data-ef]").forEach((el) => el.addEventListener("change", () => saveEngagement(r, el.getAttribute("data-ef"), el.value)));
      body.querySelectorAll("[data-plat]").forEach((el) => el.addEventListener("change", () => savePlatforms(r)));
      // Payments — Direct Debit toggle + date
      body.querySelectorAll("#dd-toggle [data-dd]").forEach((b) => b.addEventListener("click", () => setDirectDebit(r, b.getAttribute("data-dd") === "yes")));
      body.querySelectorAll("#ibi-toggle [data-ibi]").forEach((b) => b.addEventListener("click", () => setInterBrand(r, b.getAttribute("data-ibi") === "yes")));
      renderCrmRow(r);
      body.querySelector("#dd-date")?.addEventListener("change", (e) => saveDdDay(r, Number(e.target.value)));
      // Tabs
      body.querySelectorAll("[data-tab]").forEach((b) => b.addEventListener("click", () => {
        activeTab = b.getAttribute("data-tab");
        body.querySelectorAll("[data-tab]").forEach((x) => x.classList.toggle("is-active", x === b));
        ["notes", "emails", "onboarding", "invoices", "insights", "videography"].forEach((t) => { const p = $("smm-panel-" + t); if (p) p.hidden = t !== activeTab; });
        if (activeTab === "insights") loadInsights(r);
        if (activeTab === "videography") loadVideography(r);
        if (activeTab === "notes") clampNotes();
        if (activeTab === "emails") markCommsRead(r);
      }));
      body.querySelectorAll("[data-ntab]").forEach((b) => b.addEventListener("click", () => {
        notesTab = b.getAttribute("data-ntab");
        body.querySelectorAll("[data-ntab]").forEach((x) => x.classList.toggle("is-active", x === b));
        body.querySelectorAll("[data-npanel]").forEach((p) => { p.hidden = p.getAttribute("data-npanel") !== notesTab; });
        if (notesTab === "notes") clampNotes();
      }));
      // Correspondence
      loadThread(r);
      if (activeTab === "insights") loadInsights(r);
      if (activeTab === "videography") loadVideography(r);
    }


    /* ================= Videography =================
       The shoots linked to this client, and a way to book one without going
       through Jack first — the social manager usually knows about a shoot
       before he does, and making them wait to have it entered is how it ends
       up only in someone's head.

       The track mirrors the member hub's (src/pages/account/bookings.astro):
       seven stages in the database, five a person reads, because 'invoiced' is
       bookkeeping rather than progress and 'gallery_ready'/'sent' are both
       really "your gallery is up". Kept identical on purpose — a client asking
       "where is my video" should get the same answer from either side. */
    const VID_TRACK = [
      { key: "booked",       label: "Booked" },
      { key: "shoot_day",    label: "Shoot day" },
      { key: "editing",      label: "Editing" },
      // The content is edited and in the Library: for a social media client
      // that IS the delivery, since they never receive the footage themselves.
      { key: "gallery_ready", label: "In the Library" },
      { key: "amends",       label: "Amends" },
      { key: "delivered",    label: "Delivered" },
    ];
    const VID_STAGE_TO_STEP = {
      booked: "booked", invoiced: "booked",
      shoot_day: "shoot_day",
      editing: "editing", final_draft: "editing",
      gallery_ready: "gallery_ready", sent: "amends",
      delivered: "delivered", complete: "delivered",
    };
    function vidTrackHtml(b) {
      if (b.stage === "cancelled") return `<p class="vidx-cancelled">Cancelled — nothing further is due.</p>`;
      const at = Math.max(0, VID_TRACK.findIndex((t) => t.key === (VID_STAGE_TO_STEP[b.stage] || "booked")));
      return `<ol class="vidx-track">${VID_TRACK.map((t, i) =>
        `<li class="vidx-step ${i < at ? "is-done" : i === at ? "is-now" : ""}"><span class="vidx-dot"></span><span>${esc(t.label)}</span></li>`
      ).join("")}</ol>`;
    }
    // Straight to this client's folder, once there is something in it. The
    // team never needs the storage itself, only this.
    function libraryLink(b) {
      const folder = String(b.archive_folder || "").trim();
      const ready = ["gallery_ready", "sent", "delivered", "complete"].includes(b.stage);
      if (!folder || !ready) return "";
      return `<a class="vidx-library" href="/admin/content?folder=${encodeURIComponent(folder)}">Open the content in the Library &rarr;</a>`;
    }

    const vidWhen = (iso) => {
      if (!iso) return "Date to confirm";
      try { return new Date(iso).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" }); }
      catch (_) { return ""; }
    };

    /* The packages, as on the packages and pricing (Dani, 20 Oct): Shot and
       Scheduled, Social Media Management, or Bespoke. A card that still says
       something older keeps it as an option until it's changed. */
    const PACKAGES = ["Shot and Scheduled", "Social Media Management", "Bespoke"];
    function packageOptions(cur) {
      const v = String(cur || "");
      const opts = [""].concat(PACKAGES, v && !PACKAGES.includes(v) ? [v] : []);
      return opts.map((o) => `<option value="${esc(o)}"${o === v ? " selected" : ""}>${o ? esc(o) + (o === v && !PACKAGES.includes(v) ? " (old name)" : "") : "Choose…"}</option>`).join("");
    }
    /* Shot and Scheduled's quarterly shoot (Dani, 20 Oct). The same rule the
       Worker uses for the client's page (smmShootCycleFrom): next is due three
       months after the last shoot, unless a month is set here, which counts
       only while it's after the last shoot; a booked shoot shows instead. */
    const isShotAndScheduled = (name) => /shot\s*(and|&)\s*scheduled|social media marketing/i.test(String(name || ""));
    function shootCycle(bookings, override) {
      const now = Date.now();
      const live = (bookings || []).filter((b) => b && b.shoot_date && b.stage !== "cancelled");
      const past = live.filter((b) => Date.parse(b.shoot_date) <= now).sort((a, b) => Date.parse(b.shoot_date) - Date.parse(a.shoot_date));
      const ahead = live.filter((b) => Date.parse(b.shoot_date) > now).sort((a, b) => Date.parse(a.shoot_date) - Date.parse(b.shoot_date));
      const last = past[0] ? past[0].shoot_date : null, booked = ahead[0] ? ahead[0].shoot_date : null;
      let due = null;
      if (last) { const d = new Date(last); due = new Date(Date.UTC(d.getUTCFullYear(), d.getUTCMonth() + 3, 1)).toISOString().slice(0, 10); }
      const o = override ? String(override).slice(0, 10) : null;
      if (o && (!last || o.slice(0, 7) > String(last).slice(0, 7))) due = o;
      return { last, booked, due, byHand: !!(o && due === o) };
    }
    const monthYear = (iso) => { try { return new Date(String(iso).slice(0, 10) + "T12:00:00").toLocaleDateString("en-GB", { month: "long", year: "numeric" }); } catch (_) { return ""; } };
    const dayDate = (iso) => { try { return new Date(iso).toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short", year: "numeric" }); } catch (_) { return ""; } };
    function shootBox(r, list) {
      if (!isShotAndScheduled(r.package_name)) return "";
      const c = shootCycle(list, r.next_shoot_due);
      const nextLine = c.booked
        ? `<strong>Booked for ${esc(dayDate(c.booked))}</strong>`
        : c.due ? `<strong>Due ${esc(monthYear(c.due))}</strong>${c.byHand ? ' <span class="vidx-cycle-tag">set by hand</span>' : ' <span class="vidx-cycle-tag">3 months after the last</span>'}`
        : `<strong>Not worked out yet</strong> <span class="vidx-cycle-tag">set it, or it follows the first shoot</span>`;
      return `<div class="vidx-cycle">
          <div class="vidx-cycle-col"><span class="vidx-cycle-k">Last shoot</span><span class="vidx-cycle-v">${c.last ? esc(dayDate(c.last)) : "None yet"}</span></div>
          <div class="vidx-cycle-col"><span class="vidx-cycle-k">Next shoot</span><span class="vidx-cycle-v">${nextLine}</span></div>
          ${c.booked ? "" : `<div class="vidx-cycle-col vidx-cycle-edit"><span class="vidx-cycle-k">Change the month</span>
            <span class="vidx-cycle-v"><input type="month" id="vidx-due" value="${c.due ? esc(c.due.slice(0, 7)) : ""}" /></span>
            <span class="vidx-cycle-note" id="vidx-due-note"></span></div>`}
        </div>`;
    }
    async function saveShootDue(r, month) {
      const note = $("vidx-due-note");
      const v = month ? month + "-01" : null;
      if (note) note.textContent = "Saving…";
      if (isDemo(r)) { r.next_shoot_due = v; if (note) note.textContent = "Saved (demo)."; loadVideography(r); return; }
      const { error } = await supabase.from("smm_leads").update({ next_shoot_due: v }).eq("id", r.id);
      if (error) { if (note) note.textContent = /next_shoot_due/.test(error.message || "") ? "Needs supabase/smm_next_shoot.sql running first." : "Couldn't save."; return; }
      r.next_shoot_due = v; loadVideography(r);
    }

    async function loadVideography(r) {
      const panel = $("smm-panel-videography");
      if (!panel) return;
      const { data, error } = await supabase
        .from("videography_bookings")
        .select("id, service, service_type, shoot_date, stage, location, property_address, notes, archive_folder, client_name")
        .eq("smm_lead_id", r.id)
        .order("shoot_date", { ascending: false, nullsFirst: true });

      // A failed read must not take the "Book a shoot" button down with it —
      // being unable to see the existing shoots is no reason to be unable to
      // add one. The error goes in the list region only.
      const list = error ? [] : (data || []);
      const rows = list.map((b) => `
        <article class="vidx-card">
          <header class="vidx-card-head">
            <div>
              <h4 class="vidx-service">${esc(b.service || "Videography shoot")}</h4>
              <p class="vidx-when">${esc(vidWhen(b.shoot_date))}${b.location || b.property_address ? " · " + esc(b.property_address || b.location) : ""}</p>
            </div>
            <a class="vidx-open" href="/admin/videography?booking=${encodeURIComponent(b.id)}">Open &rarr;</a>
          </header>
          ${vidTrackHtml(b)}
          ${libraryLink(b)}
        </article>`).join("");

      panel.innerHTML = `
        ${shootBox(r, list)}
        <div class="smm-panel-head">
          <h4>Shoots for this client</h4>
          <button type="button" class="smm-btn" id="vidx-add">+ Book a shoot</button>
        </div>
        ${error
          ? `<p class="smm-soon">Couldn't load the existing shoots: ${esc(error.message)}</p>`
          : list.length ? rows : `<p class="smm-soon">No shoots booked yet. Book one and it lands on Jack's board straight away.</p>`}
`;

      $("vidx-add")?.addEventListener("click", () => openVidBooking(r));
      $("vidx-due")?.addEventListener("change", (e) => saveShootDue(r, e.target.value));
    }

    // The same New booking form Jack uses, minus the parts the social manager
    // shouldn't have to think about: the client is already known, so their
    // details are filled in, and package work is never quoted or routed by
    // hand — brand and payment route are set on save.
    function openVidBooking(r) {
      const name = r.business || [r.first_name, r.last_name].filter(Boolean).join(" ").trim() || r.full_name || r.email || "Client";
      $("smm-modal-host").innerHTML = `
        <div class="smm-modal-scrim" id="smm-modal">
          <div class="smm-modal smm-modal--booking" role="dialog" aria-modal="true" aria-label="New booking">
            <h3>New booking</h3>
            <p class="smm-modal-sub">Covered by their social package &mdash; nothing is invoiced. Jack is emailed as soon as you save.</p>
            <div class="smm-modal-field">
              <label>Client name</label>
              <input type="text" id="vidx-name" value="${esc(name)}" />
            </div>
            <div class="smm-modal-two">
              <div class="smm-modal-field"><label>Email</label><input type="email" id="vidx-email" value="${esc(r.email || "")}" /></div>
              <div class="smm-modal-field"><label>Phone</label><input type="tel" id="vidx-phone" value="${esc(r.phone || "")}" /></div>
            </div>
            <div class="smm-modal-two">
              <div class="smm-modal-field"><label>Company</label><input type="text" id="vidx-company" value="${esc(r.business || "")}" /></div>
              <div class="smm-modal-field"><label>Shoot date</label><input type="datetime-local" id="vidx-date" step="900" /></div>
            </div>
            <div class="smm-modal-field">
              <label>Service</label>
              <input type="text" id="vidx-service" placeholder="Property video, podcast&hellip;" />
            </div>
            <div class="smm-modal-field">
              <label>Shoot location</label>
              <input type="text" id="vidx-location" placeholder="Where Jack is going &mdash; this is what his calendar says" />
            </div>
            <div class="smm-modal-field">
              <label>Property address</label>
              <textarea id="vidx-address" rows="2" placeholder="Full address including postcode">${esc(r.business_address || "")}</textarea>
            </div>
            <div class="smm-modal-field"><label>Notes</label><textarea id="vidx-notes" rows="3"></textarea></div>
            <p class="smm-modal-status" id="vidx-status"></p>
            <div class="smm-modal-actions">
              <button type="button" class="smm-btn" data-mcancel>Cancel</button>
              <button type="button" class="smm-btn smm-btn--primary" id="vidx-save">Save booking</button>
            </div>
          </div>
        </div>`;
      const scrim = $("smm-modal");
      scrim.addEventListener("click", (e) => { if (e.target === scrim) closeModal(); });
      $("smm-modal-host").querySelector("[data-mcancel]").addEventListener("click", closeModal);
      $("vidx-save").addEventListener("click", () => saveVideographyBooking(r));
      $("vidx-service").focus();
    }

    async function saveVideographyBooking(r) {
      const status = $("vidx-status");
      const service = ($("vidx-service")?.value || "").trim();
      const when = $("vidx-date")?.value || "";
      if (!service) { if (status) { status.textContent = "Say what we're shooting."; status.style.color = "#a3372b"; } return; }

      const btn = $("vidx-save");
      if (btn) { btn.disabled = true; btn.textContent = "Saving…"; }

      const val = (id) => ($(id)?.value || "").trim();
      const fallbackName = r.business || [r.first_name, r.last_name].filter(Boolean).join(" ").trim() || r.full_name || r.email || "Client";
      const payload = {
        client_name: val("vidx-name") || fallbackName,
        client_email: val("vidx-email") || null,
        client_phone: val("vidx-phone") || null,
        client_company: val("vidx-company") || null,
        service,
        shoot_date: when ? new Date(when).toISOString() : null,
        location: val("vidx-location") || null,
        property_address: val("vidx-address") || null,
        notes: val("vidx-notes") || null,
        // Package work: never quoted, never routed by hand. Set here so the
        // social manager cannot leave the client billed as anything else.
        payment_route: "smm_package",
        brand: "social-media-marketing",
        smm_lead_id: r.id,
        stage: "booked",
      };

      const { data, error } = await supabase.from("videography_bookings").insert(payload).select("id").single();
      if (error) {
        if (status) { status.textContent = "Couldn't book that: " + error.message; status.style.color = "#a3372b"; }
        if (btn) { btn.disabled = false; btn.textContent = "Save booking"; }
        return;
      }

      // Jack is told by email. Best-effort on purpose: the booking is already
      // saved and on his board, so a mail failure must not read as "not booked".
      // This page calls the Worker WORKER, not WORKER_URL, and does not keep the
      // signed-in admin around, so it is read here rather than assumed.
      let mailed = false;
      if (WORKER) {
        try {
          // The endpoint is admin-gated, so it needs the bearer token this page
          // already uses for its other Worker calls.
          const token = await authToken();
          const { data: { user } } = await supabase.auth.getUser();
          const res = await fetch(`${WORKER}/videography/notify-new-booking`, {
            method: "POST",
            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
            body: JSON.stringify({ booking_id: data.id, booked_by: user?.email || null }),
          });
          mailed = res.ok;
        } catch (_) { mailed = false; }
      }

      // When Jack has been told, the shoot appearing in the list behind is the
      // confirmation — close and show it. When he hasn't, the modal stays put:
      // that warning is the whole reason to send someone a message, so it must
      // not vanish behind a closing dialog.
      if (mailed) {
        closeModal();
        loadVideography(r);
        return;
      }
      if (status) {
        status.textContent = WORKER
          ? "Booked and on Jack's board, but the email didn't send. Worth a message."
          : "Booked and on Jack's board. No Worker configured, so Jack has not been emailed.";
        status.style.color = "#8a5a1f";
      }
      // Replacing the node drops the save listener with it — the shoot is
      // already booked, and a second click must not book it twice.
      if (btn) {
        const done = btn.cloneNode(false);
        done.disabled = false;
        done.textContent = "Done";
        done.addEventListener("click", () => { closeModal(); loadVideography(r); });
        btn.replaceWith(done);
      }
    }

    function smmStatus(msg, ok) { const s = $("smm-cd-status"); if (s) { s.textContent = msg; s.style.color = ok ? "#2e6b40" : "#a3372b"; } }

    async function linkAccount(r, force) {
      const btn = $("smm-file-body").querySelector("[data-linkacct]");
      if (isDemo(r)) { r.account_user_id = "demo"; openFile(r.id); return; }
      if (!WORKER) { smmStatus("Connect the Worker to link accounts.", false); return; }
      if (btn) { btn.disabled = true; btn.textContent = "Linking…"; }
      const reset = () => { if (btn) { btn.disabled = false; btn.textContent = "Link to hub account"; } };
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/smm/link`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id, force: !!force }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok && !j.noAccount && !j.nameMismatch) throw new Error(j.error || "Couldn't link the account.");
        // No hub account yet → offer to invite them to create one.
        if (j.noAccount) {
          reset();
          if (confirm(`No member hub account exists for ${j.email} yet.\n\nSend them an invite to create one? They'll get a branded email with a link to set their password and open their account.`)) {
            inviteAccount(r);
          } else {
            smmStatus(`No hub account for ${j.email} yet — invite not sent.`, false);
          }
          return;
        }
        // The email's account is under a different name → confirm it's them.
        if (j.nameMismatch) {
          reset();
          if (confirm(`Careful — the member hub account for ${j.email} is under "${j.account_name || "(no name)"}", but this card is "${j.card_name}".\n\nAre you sure this is the same person? Click OK to link anyway.`)) {
            linkAccount(r, true);
          } else {
            smmStatus("Link cancelled — the names didn't match.", false);
          }
          return;
        }
        r.account_user_id = j.user_id;
        smmStatus(`Linked to ${j.linked_email}. Their reports will now show on the member hub, and their contact card has been updated.`, true);
        openFile(r.id);
      } catch (e) {
        reset();
        smmStatus(e.message || "Couldn't link the account.", false);
      }
    }

    // Linking is a judgement call — an email can be shared, a name can look
    // like a match when it isn't. Getting it wrong shows one client another
    // client's reports, so it has to be undoable without a developer.
    async function unlinkAccount(r) {
      const name = nameOf(r);
      if (!confirm(`Unlink ${name} from their member hub account?\n\nTheir reports will stop showing on the hub. Nothing is deleted — the hub account itself, and everything on this card, stays exactly as it is. You can link it again afterwards.`)) return;
      const btn = $("smm-file-body").querySelector("[data-unlinkacct]");
      if (btn) { btn.disabled = true; btn.textContent = "Unlinking…"; }
      if (isDemo(r)) { r.account_user_id = null; openFile(r.id); return; }
      try {
        const { error } = await supabase.from("smm_leads").update({ account_user_id: null }).eq("id", r.id);
        if (error) throw new Error(error.message);
        r.account_user_id = null;
        smmStatus("Unlinked — their reports no longer show on the member hub.", true);
        openFile(r.id);
      } catch (e) {
        if (btn) { btn.disabled = false; btn.textContent = "Unlink"; }
        smmStatus(e.message || "Couldn't unlink that account.", false);
      }
    }

    async function inviteAccount(r) {
      if (isDemo(r)) { r.account_user_id = "demo"; smmStatus("Invite sent (demo).", true); openFile(r.id); return; }
      if (!WORKER) { smmStatus("Connect the Worker to send invites.", false); return; }
      smmStatus("Sending invite…", true);
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/smm/invite`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id }) });
        const j = await res.json().catch(() => ({}));
        if (j.user_id) r.account_user_id = j.user_id;
        if (j.emailFailed) { smmStatus("Account linked, but the invite email didn't send — try again shortly.", false); openFile(r.id); return; }
        if (!res.ok || !j.ok) throw new Error(j.error || "Couldn't send the invite.");
        smmStatus(`Invite sent to ${j.invited} — they'll set a password and their account will be linked.`, true);
        openFile(r.id);
      } catch (e) {
        smmStatus(e.message || "Couldn't send the invite.", false);
      }
    }

    function startEditName(r) {
      const h = $("smm-file-body").querySelector(".smm-file-name");
      h.innerHTML = `<input class="smm-name-input" value="${esc(nameOf(r))}" />`;
      const inp = h.querySelector("input"); inp.focus(); inp.select();
      let done = false;
      const save = async () => { if (done) return; done = true; const v = inp.value.trim(); if (v && v !== nameOf(r)) await saveName(r, v); renderBoard(); openFile(r.id); };
      inp.addEventListener("keydown", (e) => { if (e.key === "Enter") inp.blur(); if (e.key === "Escape") { done = true; openFile(r.id); } });
      inp.addEventListener("blur", save);
    }
    async function saveName(r, v) {
      r.full_name = v; const parts = v.split(/\s+/); r.first_name = parts.shift() || v; r.last_name = parts.join(" ") || null;
      if (!isDemo(r)) { try { await supabase.from("smm_leads").update({ full_name: v, first_name: r.first_name, last_name: r.last_name }).eq("id", r.id); } catch (_) {} }
    }
    async function saveContact(r, field, value) {
      const v = value.trim();
      const s = $("smm-cd-status"); if (s) s.textContent = "Saving…";
      if (field === "full_name") {
        r.full_name = v; const parts = v.split(/\s+/); r.first_name = parts.shift() || v; r.last_name = parts.join(" ") || null;
        const t = $("smm-file-body").querySelector(".smm-name-text"); if (t) t.textContent = v || "—";
        if (!isDemo(r)) { try { await supabase.from("smm_leads").update({ full_name: v || null, first_name: r.first_name || null, last_name: r.last_name }).eq("id", r.id); } catch (_) {} }
      } else {
        r[field] = v || null;
        if (!isDemo(r)) { try { await supabase.from("smm_leads").update({ [field]: v || null }).eq("id", r.id); } catch (_) {} }
      }
      if (s) s.textContent = isDemo(r) ? "Saved (demo)." : "Saved.";
      renderBoard();
    }
    // Numeric data-ef fields need a real JSON number, not the trimmed string
    // every other field sends — PostgREST rejects a JSON string against a
    // numeric column.
    const NUMERIC_EF_FIELDS = new Set(["contracted_hours_per_month"]);
    async function saveEngagement(r, field, value) {
      const raw = value.trim();
      const v = NUMERIC_EF_FIELDS.has(field) ? (raw === "" ? null : Number(raw)) : (raw || null);
      r[field] = v;
      if (field === "package_name" || field === "contracted_hours_per_month") renderPackage(r);
      const s = $(/_url$/.test(field) ? "smm-chan-status" : "smm-eng-status"); if (s) s.textContent = "Saving…";
      if (isDemo(r)) { if (s) s.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ [field]: v }).eq("id", r.id); if (s) s.textContent = "Saved."; }
      catch (_) { if (s) s.textContent = "Couldn't save."; }
    }
    // Inter-brand invoice: this client's work is billed to another TEG brand
    // rather than to them. Same shape as the direct-debit toggle.
    // Which SMM tag belongs on this person's contact. The tag framework treats
    // a client status as superseding the lead tags (normalize_contact_tags drops
    // "Interest: SMM" once any "SMM-Status:" is present), so a client gets their
    // status and only a not-yet-client gets the interest tag.
    const SMM_STATUS_TAG = { active: "SMM-Status: Active", paused: "SMM-Status: Paused", ended: "SMM-Status: Ended" };
    const smmTagFor = (r) => SMM_STATUS_TAG[r.client_status] || "Interest: SMM";

    // Is this social client in the CRM? Only website enquiries create a contact;
    // anyone added here by hand does not exist in contacts at all, which is how
    // James ended up with clients missing from the CRM.
    async function renderCrmRow(r) {
      const row = $("smm-crm-row"); if (!row) return;
      const email = (r.email || "").trim().toLowerCase();
      if (!email) { row.innerHTML = `<span class="smm-crm-note">Add an email to link this client to the CRM.</span>`; return; }
      row.innerHTML = `<span class="smm-crm-note">Checking the CRM…</span>`;
      let existing = null;
      try {
        // By email, or by the hub account it's linked to: a linked client is
        // in the CRM even when their card's email differs from their login.
        const { data } = await supabase.from("contacts").select("id").ilike("email", email).limit(1);
        existing = data && data[0];
        if (!existing && r.account_user_id && !isDemo(r)) {
          const { data: byUser } = await supabase.from("contacts").select("id").eq("user_id", r.account_user_id).limit(1);
          existing = byUser && byUser[0];
        }
      } catch (_) { /* fall through to offering the button */ }
      if (isDemo(r) && r.account_user_id) existing = { id: "demo" };
      row.innerHTML = existing
        ? `<button type="button" class="smm-btn smm-btn--sm smm-btn--ghost" id="smm-viewcontact">View contact</button>`
        : `<button type="button" class="smm-btn smm-btn--sm" id="smm-mkcontact" title="Not in the CRM yet">Create contact</button>`;
      $("smm-viewcontact")?.addEventListener("click", () => openContactCard(existing.id));
      $("smm-mkcontact")?.addEventListener("click", () => createContact(r));
      $("smm-synccontact")?.addEventListener("click", async (e) => {
        const b = e.currentTarget; b.disabled = true; b.textContent = "Updating…";
        try {
          if (!isDemo(r)) {
            const token = await authToken();
            const res = await fetch(`${WORKER}/smm/contact-sync`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id }) });
            const j = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(j.error || "Couldn't update that contact.");
          }
          b.textContent = "Contact updated";
        }
        catch (err) { b.disabled = false; b.textContent = "Update contact"; alert(err.message || "Couldn't update that contact."); }
      });
    }

    /* The contact card, popped out over the file: the Contacts page's own
       card (?embed=1), as on TEG sync. On <body>, above the admin bars. */
    function openContactCard(id) {
      let box = document.getElementById("smm-cc");
      if (!box) {
        box = document.createElement("div");
        box.id = "smm-cc"; box.className = "smm-cc";
        box.innerHTML = `<div class="smm-cc-back" data-ccclose></div><div class="smm-cc-frame"><button type="button" class="smm-cc-x" data-ccclose aria-label="Close">&times;</button><p class="smm-cc-wait">Opening the contact card…</p><iframe title="Contact card" hidden></iframe></div>`;
        document.body.appendChild(box);
        box.addEventListener("click", (e) => { if (e.target.closest("[data-ccclose]")) closeContactCard(); });
        window.addEventListener("message", (e) => {
          if (e.origin !== location.origin || !e.data || box.hidden) return;
          if (e.data.type === "tmke-contact-ready") { box.querySelector(".smm-cc-wait").hidden = true; box.querySelector("iframe").hidden = false; box.querySelector(".smm-cc-x").hidden = true; }
          else if (e.data.type === "tmke-contact-closed") closeContactCard();
          else if (e.data.type === "tmke-contact-missing") box.querySelector(".smm-cc-wait").textContent = "That contact isn't in the CRM any more.";
        });
        document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !box.hidden) closeContactCard(); });
      }
      const wait = box.querySelector(".smm-cc-wait"), frame = box.querySelector("iframe");
      wait.textContent = "Opening the contact card…"; wait.hidden = false; frame.hidden = true; box.querySelector(".smm-cc-x").hidden = false;
      frame.src = `/admin/contacts?contact=${encodeURIComponent(id)}&embed=1`;
      box.hidden = false;
    }
    function closeContactCard() { const box = document.getElementById("smm-cc"); if (!box) return; box.hidden = true; box.querySelector("iframe").removeAttribute("src"); }

    async function createContact(r) {
      const btn = $("smm-mkcontact"); if (btn) { btn.disabled = true; btn.textContent = "Creating…"; }
      const email = (r.email || "").trim().toLowerCase();
      try {
        // upsert_contact rather than a plain insert: it is the same path every
        // other route uses, so tag normalisation and the duplicate-name review
        // behave identically however a contact arrives.
        const { data, error } = await supabase.rpc("upsert_contact", {
          p_email: email,
          p_first_name: r.first_name || (nameOf(r) !== "—" ? String(nameOf(r)).split(" ")[0] : null) || null,
          p_last_name: r.last_name || (nameOf(r) !== "—" ? String(nameOf(r)).split(" ").slice(1).join(" ") : null) || null,
          p_phone: r.phone || null,
          p_company: r.business || null,
          p_source: "smm_admin",
          p_lifecycle: null,
          p_marketing_opt_in: null,   // null, not false - nobody has agreed to anything here
          p_tags: [smmTagFor(r)],
        });
        if (error) throw error;
        const id = Array.isArray(data) ? data[0] : data;
        if (!id) throw new Error("No contact was created.");
        // Reuse the existing status sync rather than duplicating its rules: it
        // also sets lifecycle to customer for an active client.
        if (r.client_status) { try { await pushClientStatus(r, r.client_status); } catch (_) {} }
        // Hand them straight to the card so the rest can be filled in now.
        location.href = `/admin/contacts?contact=${encodeURIComponent(id)}`;
      } catch (e) {
        if (btn) { btn.disabled = false; btn.textContent = "Create contact"; }
        alert("Couldn't create that contact: " + (e.message || e));
      }
    }

    async function setInterBrand(r, on) {
      r.inter_brand_invoice = on;
      document.querySelectorAll("#ibi-toggle [data-ibi]").forEach((b) => b.classList.toggle("is-active", (b.getAttribute("data-ibi") === "yes") === on));
      const st = $("smm-eng-status"); if (st) st.textContent = "Saving…";
      if (isDemo(r)) { if (st) st.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ inter_brand_invoice: on }).eq("id", r.id); if (st) st.textContent = "Saved."; }
      catch (e) {
        // Almost always the column not existing yet, and the raw Postgres
        // message doesn't say what to do about it.
        if (st) st.textContent = /inter_brand_invoice/i.test(e.message || "") ? "Needs supabase/smm_manager_and_interbrand.sql" : "Couldn't save.";
      }
    }

    async function setDirectDebit(r, on) {
      r.direct_debit = on;
      document.querySelectorAll("#dd-toggle [data-dd]").forEach((b) => b.classList.toggle("is-active", (b.getAttribute("data-dd") === "yes") === on));
      const st = $("smm-eng-status"); if (st) st.textContent = "Saving…";
      // Re-render the Invoicing panel so it switches to/from the DD view immediately.
      const pInv = $("smm-panel-invoices"); if (pInv) renderInvoicing(r, pInv, r._lastDocs || [], false, r._lastWarn || null);
      if (isDemo(r)) { if (st) st.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ direct_debit: on, direct_debit_day: r.direct_debit_day || null }).eq("id", r.id); if (st) st.textContent = "Saved."; }
      catch (_) { if (st) st.textContent = "Couldn't save."; }
    }
    async function saveDdDay(r, day) {
      // "" is the N/A option — stored as null, not as a day.
      day = day ? Number(day) : null;
      r.direct_debit_day = day;
      const st = $("smm-eng-status"); if (st) st.textContent = "Saving…";
      if (isDemo(r)) { if (st) st.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ direct_debit_day: day }).eq("id", r.id); if (st) st.textContent = "Saved."; }
      catch (_) { if (st) st.textContent = "Couldn't save."; }
    }
    async function savePlatforms(r) {
      const arr = [...document.querySelectorAll("[data-plat]")].filter((c) => c.checked).map((c) => c.getAttribute("data-plat"));
      r.platforms = arr;
      const s = $("smm-eng-status"); if (s) s.textContent = "Saving…";
      if (isDemo(r)) { if (s) s.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ platforms: arr }).eq("id", r.id); if (s) s.textContent = "Saved."; }
      catch (_) { if (s) s.textContent = "Couldn't save."; }
    }

    // ---------- Stage moves ----------
    function moveToStage(r, stageKey) {
      if (!stageKey) return;
      if (stageKey === "meeting_set") { openMeeting(r); return; }
      // A lost card reads as Inquiry to stageOf, so dragging it back into
      // Inquiry has to count as a move.
      if (stageKey === (r.pipeline_stage === "lost" ? "lost" : stageOf(r))) return;
      if (stageKey === "active_client" && STAGE_INDEX[stageOf(r)] >= STAGE_INDEX["onboarding"]) {
        const c = onbCount(r);
        if (c.open && !confirm(ONB_COPY.activeConfirm(c.open))) return;
      }
      setStage(r, stageKey);
    }
    async function deleteCard(r) {
      if (!confirm(`Delete "${nameOf(r)}" entirely? This permanently removes the card and its notes, files and invoices. It can't be undone.`)) return;
      if (!isDemo(r)) {
        if (!WORKER) { alert("Connect the Worker to delete."); return; }
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER}/smm/lead?id=${encodeURIComponent(r.id)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } });
          if (!res.ok) { const j = await res.json().catch(() => ({})); throw new Error(j.error || "Delete failed."); }
        } catch (e) { alert(e.message || "Couldn't delete."); return; }
      }
      all = all.filter((x) => x.id !== r.id);
      closeFile();
      renderBoard();
    }
    async function setStage(r, stage) {
      r.pipeline_stage = stage;
      if (!isDemo(r)) { try { await supabase.from("smm_leads").update({ pipeline_stage: stage }).eq("id", r.id); } catch (_) {} }
      if (stage === "active_client") { if (!r.client_status) r.client_status = "active"; pushClientStatus(r, "active"); }
      renderBoard();
      if (stage === "lost") closeFile(); else openFile(r.id);
    }
    async function pushClientStatus(r, status) {
      if (isDemo(r) || !WORKER) return;
      try { const token = await authToken(); await fetch(`${WORKER}/smm/status`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id, status }) }); } catch (_) {}
    }
    async function setClientStatus(r, status) {
      // An active client ending is a client lost: ask why first.
      if (status === "ended" && r.client_status !== "ended" && !openLost.confirmed) { openLost(r, "ended"); return; }
      openLost.confirmed = false;
      r.client_status = status;
      await pushClientStatus(r, status);
      renderBoard(); openFile(r.id);
    }

    /* ---------- Why were they lost? ----------
       Asked when a lead is marked lost, or an active client is set to Ended.
       The reason is kept on the lead (lost_reason); the database stamps when
       and from which stage (supabase/smm_stage_history.sql). */
    const todayIso = () => new Date().toLocaleDateString("en-CA", { timeZone: "Europe/London" });
    const leavingLabel = (r) => r.leaving_on ? `${r.leaving_as === "ended" ? "Leaving" : "Lost from"} ${new Date(r.leaving_on + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short" })}` : "";
    async function cancelLeaving(r) {
      if (!confirm(`Cancel ${nameOf(r)}'s ${r.leaving_as === "ended" ? "leaving" : "lost"} date? They'll stay as they are.`)) return;
      if (!isDemo(r)) { try { await supabase.from("smm_leads").update({ leaving_on: null, leaving_as: null, lost_reason: null }).eq("id", r.id); } catch (_) {} }
      r.leaving_on = null; r.leaving_as = null; r.lost_reason = null;
      renderBoard(); openFile(r.id);
    }
    const LOST_REASONS = ["Price", "Went with another agency", "Doing it themselves", "Not the right time", "Stopped replying", "Not a good fit for us", "Unhappy with the service", "Business closed or sold", "Other"];
    function openLost(r, mode) {
      const ended = mode === "ended";
      $("smm-modal-host").innerHTML = `
        <div class="smm-modal-scrim" id="smm-modal">
          <div class="smm-modal" role="dialog" aria-modal="true" aria-label="${ended ? "Client ended" : "Mark lost"}">
            <h3>${ended ? "Why are they leaving?" : "Why was this one lost?"}</h3>
            <p class="smm-modal-sub">${esc(nameOf(r))}${r.business ? " · " + esc(r.business) : ""}. Shown on Client status and in its export.</p>
            <div class="smm-modal-field"><label>Reason</label><select id="smm-lost-why"><option value="">Choose a reason</option>${LOST_REASONS.map((x) => `<option>${esc(x)}</option>`).join("")}</select></div>
            <div class="smm-modal-field"><label>Anything to add (optional)</label><textarea id="smm-lost-note" rows="3" placeholder="e.g. Signed with a local agency at £400 a month"></textarea></div>
            <div class="smm-modal-field"><label>${ended ? "Leaving on" : "Lost from"}</label><input type="date" id="smm-lost-on" value="${todayIso()}" />
              <span class="smm-modal-hint">Leave it as today to change it now. Pick a later date and they stay as they are until then; the change happens that morning.</span></div>
            <p class="smm-modal-status" id="smm-lost-status" hidden></p>
            <div class="smm-modal-actions">
              <button type="button" class="smm-btn" data-mcancel>Cancel</button>
              <button type="button" class="smm-btn smm-btn--danger" id="smm-lost-save">${ended ? "Set to Ended" : "Mark lost"}</button>
            </div>
          </div>
        </div>`;
      const scrim = $("smm-modal");
      scrim.addEventListener("click", (e) => { if (e.target === scrim) closeModal(); });
      $("smm-modal-host").querySelector("[data-mcancel]").addEventListener("click", closeModal);
      $("smm-lost-save").addEventListener("click", async () => {
        const why = $("smm-lost-why").value, note = $("smm-lost-note").value.trim();
        if (!why) { const st = $("smm-lost-status"); st.hidden = false; st.textContent = "Choose a reason."; return; }
        const reason = note ? `${why}: ${note}` : why;
        const on = $("smm-lost-on").value || todayIso();
        r.lost_reason = reason;
        // A later date: keep the reason and the date, change nothing yet. The
        // Worker's morning run makes the change on the day (runSmmLeavingDue).
        if (on > todayIso()) {
          if (!isDemo(r)) {
            const { error } = await supabase.from("smm_leads").update({ lost_reason: reason, leaving_on: on, leaving_as: ended ? "ended" : "lost" }).eq("id", r.id);
            if (error) { const st = $("smm-lost-status"); st.hidden = false; st.textContent = "Couldn't save the date. The leaving-date SQL may not have been run yet."; return; }
          }
          r.leaving_on = on; r.leaving_as = ended ? "ended" : "lost";
          closeModal(); renderBoard(); openFile(r.id);
          return;
        }
        if (!isDemo(r)) {
          // The reason first; a database without the new column still saves the rest.
          // A date in the past is when it happened, so it's the date shown.
          const patch = { lost_reason: reason };
          if (on < todayIso()) patch.lost_at = `${on}T12:00:00Z`;
          try { await supabase.from("smm_leads").update(patch).eq("id", r.id); } catch (_) {}
          try { await supabase.from("smm_leads").update({ leaving_on: null, leaving_as: null }).eq("id", r.id); } catch (_) {}
        }
        r.leaving_on = null; r.leaving_as = null;
        closeModal();
        if (ended) { openLost.confirmed = true; await setClientStatus(r, "ended"); }
        else await setStage(r, "lost");
      });
    }

    /* ---------- Monthly invoices (Settings) ----------
       Abbie's list (Danielle, 22 Oct 2026): every social media client on the
       invoice schedule with their fee, a tick per month for this month and
       next, and Confirm per month. The Worker sends the ticked ones on the 5th. */
    const gbpP = (p) => p == null ? "" : "£" + (p / 100).toLocaleString("en-GB", { minimumFractionDigits: p % 100 ? 2 : 0 });
    async function loadMonthlyInvoices() {
      const host = $("mi-body"), note = $("mi-note");
      host.innerHTML = `<p class="cs-empty">Loading…</p>`; note.hidden = true;
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/smm/monthly-invoices`, { headers: { Authorization: "Bearer " + token } });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || "Couldn't load the list.");
        const months = d.months || [], rows = d.rows || [];
        if (!rows.length) { host.innerHTML = `<p class="cs-empty">No social media clients are set up for automatic invoicing yet.</p>`; return; }
        const who = (e) => String(e || "").split("@")[0].split(/[._]/)[0].replace(/^./, (m) => m.toUpperCase());
        const when = (x) => new Date(x).toLocaleDateString("en-GB", { day: "numeric", month: "short" });
        host.innerHTML = `<table class="mi-tbl"><thead><tr><th>Client</th><th>Billed to</th><th class="mi-num">Monthly fee</th>${months.map((m) => `<th class="mi-month">
            <span class="mi-mname">${esc(m.label)}</span>
            ${m.confirmed ? `<span class="mi-conf">Confirmed by ${esc(who(m.confirmed.confirmed_by))}, ${when(m.confirmed.confirmed_at)} <button type="button" class="mi-undo" data-miundo="${m.month}">Undo</button></span>`
              : `<button type="button" class="smm-btn smm-btn--primary smm-btn--sm" data-miconfirm="${m.month}">Confirm ${esc(m.label.split(" ")[0])}</button>`}</th>`).join("")}</tr></thead>
          <tbody>${rows.map((r) => `<tr><td><strong>${esc(r.contact_name || r.name)}</strong></td><td>${esc(r.bill_to_name || "")}</td><td class="mi-num">${gbpP(r.amount_pence)}</td>${months.map((m) => {
            const c = (r.cells || {})[m.month] || {};
            if (c.invoice) return `<td class="mi-cell is-sent"><span class="mi-sent">${esc(c.invoice.number)} ${c.invoice.status === "draft" ? "drafted" : esc(c.invoice.status)}</span></td>`;
            return `<td class="mi-cell"><label class="mi-tick"><input type="checkbox" data-mitick="${esc(r.id)}" data-month="${m.month}"${c.ticked ? " checked" : ""}> Invoice</label></td>`;
          }).join("")}</tr>`).join("")}</tbody></table>`;
        host.querySelectorAll("[data-mitick]").forEach((cb) => cb.addEventListener("change", async () => {
          cb.disabled = true;
          try {
            const token = await authToken();
            const r = await fetch(`${WORKER}/smm/monthly-invoices`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ recurring_id: cb.dataset.mitick, month: cb.dataset.month, approved: cb.checked }) });
            const j = await r.json().catch(() => ({}));
            if (!r.ok) throw new Error(j.error || "Couldn't save that.");
          } catch (err) { cb.checked = !cb.checked; note.hidden = false; note.textContent = err.message; }
          finally { cb.disabled = false; }
        }));
        host.querySelectorAll("[data-miconfirm], [data-miundo]").forEach((b) => b.addEventListener("click", async () => {
          const month = b.dataset.miconfirm || b.dataset.miundo, undo = !!b.dataset.miundo;
          const ticked = host.querySelectorAll(`[data-mitick][data-month="${month}"]:checked`).length;
          if (!undo && !confirm(`Confirm ${ticked} client${ticked === 1 ? "" : "s"} to invoice? Anyone not ticked won't be invoiced that month.`)) return;
          b.disabled = true;
          try {
            const token = await authToken();
            const r = await fetch(`${WORKER}/smm/monthly-invoices/confirm`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ month, undo }) });
            if (!r.ok) throw new Error("Couldn't save that.");
            loadMonthlyInvoices();
          } catch (err) { note.hidden = false; note.textContent = err.message; b.disabled = false; }
        }));
      } catch (err) { host.innerHTML = `<p class="cs-empty">${esc(err.message)}</p>`; }
    }

    /* ---------- Client status (Settings) ----------
       The pipeline as a table per stage, with dates; the boxes are tabs. */
    const CS_TABS = [
      { key: "waitlist", label: "Waitlist" }, { key: "inquiry", label: "Inquiry" }, { key: "meeting_set", label: "Meeting set" },
      { key: "proposal_sent", label: "Proposal sent" }, { key: "contract_signed", label: "Contract sent" }, { key: "onboarding", label: "Onboarding" },
      { key: "active_client", label: "Active clients" }, { key: "lost", label: "Lost" },
    ];
    const STAGE_LABEL = Object.fromEntries(STAGES.map((x) => [x.key, x.label]));
    let csTab = "inquiry", csData = null;
    const csDay = (iso) => { if (!iso) return ""; const d = new Date(String(iso).length === 10 ? iso + "T12:00:00" : iso); return isNaN(d) ? "" : d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); };
    const csIso = (iso) => { if (!iso) return ""; const d = new Date(String(iso).length === 10 ? iso + "T12:00:00" : iso); return isNaN(d) ? "" : d.toISOString().slice(0, 10); };
    // Lost = marked lost, or an active client set to Ended.
    const csStageOf = (r) => (r.pipeline_stage === "lost" || r.client_status === "ended") ? "lost" : stageOf(r);
    async function loadClientStatus() {
      const note = $("cs-note");
      const leads = all.filter((r) => !isDemo(r));
      const ids = leads.map((r) => r.id);
      let events = [], sqlNeeded = false;
      for (let i = 0; i < ids.length; i += 150) {
        const { data, error } = await supabase.from("smm_stage_events").select("lead_id, stage, reached_at, estimated").in("lead_id", ids.slice(i, i + 150)).order("reached_at", { ascending: true }).range(0, 4999);
        if (error) { sqlNeeded = true; break; }
        events.push(...(data || []));
      }
      // Payments: social media invoices for active clients, late if sent and past due.
      const activeIds = leads.filter((r) => csStageOf(r) === "active_client").map((r) => r.id);
      let invoices = [];
      if (activeIds.length) {
        const { data } = await supabase.from("invoices").select("booking_id, status, due_date, total_pence, paid_date").eq("booking_source", "smm").in("booking_id", activeIds).range(0, 4999);
        invoices = data || [];
      }
      note.hidden = !sqlNeeded;
      if (sqlNeeded) note.textContent = "Run supabase/smm_stage_history.sql in Supabase to record the date of each stage and why anyone was lost. Until then, dates come from what each card already holds.";
      const byLead = new Map();
      events.forEach((e) => { if (!byLead.has(e.lead_id)) byLead.set(e.lead_id, []); byLead.get(e.lead_id).push(e); });
      csData = { leads, byLead, invoices };
      drawClientStatus();
    }
    // When they reached a stage: the latest log entry for it, else a field the card holds.
    function csWhen(r, stage) {
      // Joined is the start date on their card, whenever there is one.
      if (stage === "active_client" && r.start_date) return { at: r.start_date, est: false };
      const ev = (csData.byLead.get(r.id) || []).filter((e) => e.stage === stage || (stage === "contract_signed" && e.stage === "contract_sent"));
      const e = ev[ev.length - 1];
      if (e) return { at: e.reached_at, est: !!e.estimated };
      if (stage === "waitlist" || stage === "inquiry") return { at: r.created_at, est: false };
      if (stage === "meeting_set" && (r.meeting_at || r.call_at)) return { at: r.meeting_at || r.call_at, est: true };
      if (stage === csStageOf(r)) return { at: r.updated_at, est: true };
      return null;
    }
    const csDateCell = (w) => w && w.at ? `<td class="cs-d">${w.est ? `<span class="cs-est" title="Estimated: from before stage dates were recorded">c. ${esc(csDay(w.at))}</span>` : esc(csDay(w.at))}</td>` : '<td class="cs-d">—</td>';
    function csPayments(r) {
      if (r.client_status === "internal") return { label: "N/A", tone: "", late: 0, owed: 0 };
      const today = new Date().toISOString().slice(0, 10);
      const mine = csData.invoices.filter((v) => v.booking_id === r.id);
      const late = mine.filter((v) => v.status === "sent" && v.due_date && v.due_date < today);
      const owed = late.reduce((n, v) => n + (v.total_pence || 0), 0);
      if (late.length) return { label: `${late.length} late · £${(owed / 100).toLocaleString("en-GB", { minimumFractionDigits: 0, maximumFractionDigits: 2 })}`, tone: "is-late", late: late.length, owed };
      if (!mine.length) return { label: r.direct_debit ? "Direct Debit" : "No invoices yet", tone: r.direct_debit ? "is-ok" : "", late: 0, owed: 0 };
      return { label: r.direct_debit ? "Up to date · DD" : "Up to date", tone: "is-ok", late: 0, owed: 0 };
    }
    // The columns each stage shows: the steps so far, then what that stage adds.
    const CS_STEPS = ["inquiry", "meeting_set", "proposal_sent", "contract_signed", "onboarding"];
    function csColumns(tab) {
      const base = [{ h: "Name", v: (r) => nameOf(r), cell: (r) => `<td><button type="button" class="cs-name" data-cs-open="${esc(r.id)}">${esc(nameOf(r))}</button></td>` },
        { h: "Business", v: (r) => r.business || "" }, { h: "Email", v: (r) => r.email || "" }];
      const step = (st, h) => ({ h, v: (r) => { const w = csWhen(r, st); return w && w.at ? csIso(w.at) + (w.est ? " (estimated)" : "") : ""; }, cell: (r) => csDateCell(csWhen(r, st)) });
      if (tab === "waitlist") return [...base, step("waitlist", "Joined the waitlist")];
      if (tab === "inquiry") return [...base, step("inquiry", "Enquired"), { h: "Came in via", v: (r) => KIND_LABEL[r.kind] || r.kind || "" }];
      if (tab === "active_client") return [...base,
        { h: "Joined", v: (r) => { const w = csWhen(r, "active_client"); return w && w.at ? csIso(w.at) : ""; }, cell: (r) => csDateCell(csWhen(r, "active_client")) },
        { h: "Package", v: (r) => r.package_name || "" }, { h: "Monthly fee", v: (r) => r.price || "" },
        { h: "Payments", v: (r) => csPayments(r).label, cell: (r) => { const p = csPayments(r); return `<td><span class="cs-pill ${p.tone}">${esc(p.label)}</span></td>`; } },
        { h: "Status", v: (r) => CLIENT_STATUS[r.client_status] || "Active" }];
      if (tab === "lost") return [...base,
        { h: "First enquired", v: (r) => csIso(r.created_at), cell: (r) => `<td class="cs-d">${esc(csDay(r.created_at))}</td>` },
        { h: "Got as far as", v: (r) => STAGE_LABEL[csFrom(r)] || "", cell: (r) => `<td><span class="cs-pill${csFrom(r) === "active_client" ? " is-wait" : ""}">${esc(STAGE_LABEL[csFrom(r)] || "Not recorded")}</span></td>` },
        { h: "Lost on", v: (r) => csIso(r.lost_at || r.end_date || r.updated_at) + (r.lost_at || r.end_date ? "" : " (estimated)"), cell: (r) => csDateCell({ at: r.lost_at || r.end_date || r.updated_at, est: !(r.lost_at || r.end_date) }) },
        { h: "Reason", v: (r) => r.lost_reason || "", cell: (r) => `<td>${r.lost_reason ? esc(r.lost_reason) : '<span class="cs-est">Not recorded</span>'}</td>` }];
      // Meeting set to onboarding: every step up to and including this one.
      const upto = CS_STEPS.slice(0, CS_STEPS.indexOf(tab) + 1);
      const labels = { inquiry: "Enquired", meeting_set: "Meeting", proposal_sent: "Proposal sent", contract_signed: "Contract sent", onboarding: "Onboarding since" };
      return [...base, ...upto.map((st) => step(st, labels[st]))];
    }
    // How far a lost lead got: as the database recorded it, else the furthest logged stage.
    function csFrom(r) {
      if (r.lost_from_stage) return STAGE_ALIAS[r.lost_from_stage] || r.lost_from_stage;
      if (r.client_status === "ended") return "active_client";
      const ev = (csData.byLead.get(r.id) || []).map((e) => STAGE_ALIAS[e.stage] || e.stage).filter((s) => STAGE_INDEX[s] != null);
      return ev.sort((a, b) => STAGE_INDEX[b] - STAGE_INDEX[a])[0] || "";
    }
    function csRows(tab) {
      const rows = csData.leads.filter((r) => csStageOf(r) === tab);
      const t = (r) => { const w = tab === "lost" ? { at: r.lost_at || r.updated_at } : csWhen(r, tab === "active_client" ? "active_client" : tab); return w && w.at ? new Date(w.at).getTime() : 0; };
      // Newest first; internal accounts (ours, never invoiced) at the bottom.
      const internal = (r) => (r.client_status === "internal" ? 1 : 0);
      return rows.sort((a, b) => internal(a) - internal(b) || t(b) - t(a));
    }
    function drawClientStatus() {
      if (!csData) return;
      $("cs-tabs").innerHTML = CS_TABS.map((t) => `<button type="button" class="cs-tab${t.key === csTab ? " is-on" : ""}${t.key === "lost" ? " is-lost" : ""}" data-cs-tab="${t.key}" aria-pressed="${t.key === csTab}"><b>${csRows(t.key).length}</b><span>${esc(t.label)}</span></button>`).join("");
      const cols = csColumns(csTab), rows = csRows(csTab);
      $("cs-body").innerHTML = rows.length
        ? `<div class="cs-wrap"><table class="cs-table"><thead><tr>${cols.map((c) => `<th>${esc(c.h)}</th>`).join("")}</tr></thead><tbody>${rows.map((r) => `<tr>${cols.map((c) => c.cell ? c.cell(r) : `<td>${esc(c.v(r)) || "—"}</td>`).join("")}</tr>`).join("")}</tbody></table></div>`
        : `<p class="cs-empty">No one here right now.</p>`;
    }
    // One spreadsheet, every stage: a Stage column, then that stage's columns.
    function exportClientStatus() {
      if (!csData) return;
      const cell = (v) => { const x = String(v ?? ""); return /[",\n\r]/.test(x) ? '"' + x.replace(/"/g, '""') + '"' : x; };
      const lines = [];
      for (const t of CS_TABS) {
        const rows = csRows(t.key); if (!rows.length) continue;
        const cols = csColumns(t.key);
        if (lines.length) lines.push("");
        lines.push([t.label.toUpperCase() + ` (${rows.length})`].map(cell).join(","));
        lines.push(cols.map((c) => cell(c.h)).join(","));
        rows.forEach((r) => lines.push(cols.map((c) => cell(c.v(r))).join(",")));
      }
      const blob = new Blob(["\ufeff" + lines.join("\r\n")], { type: "text/csv;charset=utf-8" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `TMKE social media client status ${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(a.href);
    }

    // ---------- Meeting modal ----------
    function closeModal() { $("smm-modal-host").innerHTML = ""; }
    function openMeeting(r) {
      const d = new Date(Date.now() + 2 * 86400000);
      const dstr = d.toISOString().slice(0, 10);
      $("smm-modal-host").innerHTML = `
        <div class="smm-modal-scrim" id="smm-modal">
          <div class="smm-modal" role="dialog" aria-modal="true" aria-label="Book a meeting">
            <h3>Book a meeting</h3>
            <p class="smm-modal-sub">with ${esc(nameOf(r))}${r.business ? " · " + esc(r.business) : ""}</p>
            <div class="smm-modal-two">
              <div class="smm-modal-field"><label>Date</label><input type="date" id="smm-mt-date" value="${dstr}"></div>
              <div class="smm-modal-field"><label>Time</label><input type="time" id="smm-mt-time" value="10:00"></div>
            </div>
            <div class="smm-modal-field"><label>Length</label><select id="smm-mt-dur"><option value="30">30 minutes</option><option value="45">45 minutes</option><option value="60">1 hour</option></select></div>
            <label class="smm-check"><input type="checkbox" id="smm-mt-invite" checked> Send a diary invite to the client</label>
            <p class="smm-modal-status" id="smm-mt-status" hidden></p>
            <div class="smm-modal-actions">
              <button type="button" class="smm-btn" data-mcancel>Cancel</button>
              <button type="button" class="smm-btn smm-btn--primary" id="smm-mt-save">Save meeting</button>
            </div>
          </div>
        </div>`;
      const scrim = $("smm-modal");
      scrim.addEventListener("click", (e) => { if (e.target === scrim) closeModal(); });
      $("smm-modal-host").querySelector("[data-mcancel]").addEventListener("click", closeModal);
      $("smm-mt-save").addEventListener("click", () => saveMeeting(r));
    }
    async function saveMeeting(r) {
      const date = $("smm-mt-date").value, start = $("smm-mt-time").value;
      const duration = $("smm-mt-dur").value, invite = $("smm-mt-invite").checked;
      if (!date || !start) { const s = $("smm-mt-status"); s.hidden = false; s.textContent = "Pick a date and time."; return; }
      const btn = $("smm-mt-save"); btn.disabled = true; btn.textContent = "Saving…";
      // Only move them into Meeting set if they're still before it — booking a
      // meeting with a later-stage client shouldn't drag them back.
      const setStage = STAGE_INDEX[stageOf(r)] < STAGE_INDEX["meeting_set"];
      r.meeting_at = `${date}T${start}:00`; if (setStage) r.pipeline_stage = "meeting_set";
      if (!isDemo(r)) {
        let ok = false;
        if (WORKER) { try { const token = await authToken(); const res = await fetch(`${WORKER}/smm/meeting`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id, date, start, duration, send_invite: invite, set_stage: setStage }) }); ok = res.ok; } catch (_) {} }
        if (!ok) { try { const patch = { meeting_at: r.meeting_at }; if (setStage) patch.pipeline_stage = "meeting_set"; await supabase.from("smm_leads").update(patch).eq("id", r.id); } catch (_) {} }
      }
      closeModal(); renderBoard(); openFile(r.id);
    }

    /* ---------- Package details ----------
       What the client's package consists of, in one place under Notes
       (Danielle, 20 Oct 2026): the tier, monthly hours, whether it includes
       video, how often the shoot is, and what comes out of it. Choosing a
       Shot and Scheduled tier (Social Starter, Social Authority, Social
       Leadership) fills these from the rate card (smm-config.js), monthly
       hours being its management hours, which are per month;
       every field can be changed by hand, as bespoke packages will be.
       Monthly hours are the file's contracted_hours_per_month. Reference
       only: nothing bills or schedules from it. */
    const SAS_TIERS = ((PKG_SERVICES.find((x) => x.key === "social-media-marketing") || {}).packages || []).map((p, i) => ({
      key: p.key, label: p.name || `Tier ${i + 1}`, spec: p.spec,
      fill: { video: true, hours: p.hours.management, shoot_frequency: `Quarterly, ${p.hours.videography} hour shoot`, outputs: `${p.videos} videos a quarter, ${p.postsPerWeek} posts a week. Amends: ${String(p.amends).toLowerCase()}` },
      card: `${p.hours.videography}h film · ${p.hours.editing}h edit · ${p.hours.brief}h brief a quarter; ${p.hours.management}h management a month`,
    }));
    const SMM_TIERS = ((PKG_SERVICES.find((x) => x.key === "social-media-management") || {}).futurePackages || []).map((n) => ({ key: n, label: n }));
    function tiersFor(pkg) {
      if (isShotAndScheduled(pkg)) return SAS_TIERS;
      if (/social media management/i.test(String(pkg || ""))) return SMM_TIERS;
      return [];
    }
    function tierLabel(pkg, key) {
      const t = tiersFor(pkg).find((x) => x.key === key);
      return t ? (t.spec ? `${t.label} (${t.spec})` : t.label) : (key || "");
    }
    function renderPackage(r, editing) {
      const host = $("smm-pkg"); if (!host) return;
      const pd = r.package_details || {};
      const pkg = r.package_name || "";
      const tiers = tiersFor(pkg);
      const hours = r.contracted_hours_per_month;
      if (!editing) {
        const row = (k, v) => `<div class="smm-pkg-row"><span class="smm-pkg-k">${k}</span><span class="smm-pkg-v">${v || '<span class="smm-pkg-none">Not set</span>'}</span></div>`;
        const empty = !pd.tier && pd.video == null && !pd.outputs && hours == null;
        host.innerHTML = `<div class="smm-pkg-card">
            ${row("Package", esc(pkg))}
            ${row("Tier", esc(tierLabel(pkg, pd.tier)))}
            ${row("Monthly hours", hours != null ? esc(String(hours)) : "")}
            ${row("Includes video", pd.video == null ? "" : pd.video ? "Yes" : "No")}
            ${pd.video ? row("Shoot", esc(pd.shoot_frequency || "")) : ""}
            ${row("What comes out of it", esc(pd.outputs || "").replace(/\n/g, "<br>")).replace('class="smm-pkg-row"', 'class="smm-pkg-row smm-pkg-row--wide"')}
            <div class="smm-pkg-foot"><button type="button" class="smm-btn smm-btn--primary smm-btn--sm smm-pkg-editbtn" id="smm-pkg-edit">${empty ? `${PLUS_SVG}Add the package details` : "Edit"}</button></div>
          </div>`;
        $("smm-pkg-edit").addEventListener("click", () => renderPackage(r, true));
        return;
      }
      const tierField = tiers.length
        ? `<select id="pkg-tier"><option value="">Choose…</option>${tiers.map((t) => `<option value="${esc(t.key)}"${pd.tier === t.key ? " selected" : ""}>${esc(t.spec ? `${t.label} (${t.spec})` : t.label)}</option>`).join("")}${pd.tier && !tiers.some((t) => t.key === pd.tier) ? `<option value="${esc(pd.tier)}" selected>${esc(pd.tier)}</option>` : ""}</select>`
        : `<input type="text" id="pkg-tier" value="${esc(pd.tier || "")}" placeholder="${pkg ? "e.g. Bespoke: monthly shoot" : "Choose the package under Engagement first"}">`;
      host.innerHTML = `<div class="smm-pkg-card smm-pkg-form">
          <label class="smm-pkg-f"><span>Tier</span>${tierField}<em class="smm-pkg-hint" id="pkg-card"></em></label>
          <label class="smm-pkg-f"><span>Monthly hours</span><input type="number" id="pkg-hours" min="0" step="0.5" value="${hours ?? ""}" placeholder="e.g. 7"></label>
          <div class="smm-pkg-f"><span>Includes video</span><div class="pay-toggle" id="pkg-video"><button type="button" class="pay-opt${pd.video ? " is-active" : ""}" data-v="yes">Yes</button><button type="button" class="pay-opt${pd.video === false ? " is-active" : ""}" data-v="no">No</button></div></div>
          <label class="smm-pkg-f" id="pkg-freq-row"${pd.video ? "" : " hidden"}><span>How often they shoot</span><input type="text" id="pkg-freq" value="${esc(pd.shoot_frequency || "")}" placeholder="e.g. Quarterly, 5 hour shoot"></label>
          <label class="smm-pkg-f smm-pkg-f--wide"><span>What comes out of it</span><textarea id="pkg-out" rows="2" placeholder="e.g. 36 reels a quarter, 3 posts a week">${esc(pd.outputs || "")}</textarea></label>
          <p class="smm-pkg-status" id="pkg-status"></p>
          <div class="smm-pkg-foot"><button type="button" class="smm-btn smm-btn--sm" id="pkg-cancel">Cancel</button><button type="button" class="smm-btn smm-btn--primary smm-btn--sm" id="pkg-save">Save</button></div>
        </div>`;
      let video = pd.video == null ? null : !!pd.video;
      const setVideo = (v) => { video = v; host.querySelectorAll("#pkg-video [data-v]").forEach((b) => b.classList.toggle("is-active", (b.dataset.v === "yes") === v)); $("pkg-freq-row").hidden = !v; };
      host.querySelectorAll("#pkg-video [data-v]").forEach((b) => b.addEventListener("click", () => setVideo(b.dataset.v === "yes")));
      const showCard = () => { const t = tiers.find((x) => x.key === $("pkg-tier").value); $("pkg-card").textContent = t && t.card ? `Rate card: ${t.card}` : ""; };
      showCard();
      if (tiers.length) $("pkg-tier").addEventListener("change", () => {
        showCard();
        const t = tiers.find((x) => x.key === $("pkg-tier").value);
        if (t && t.fill) { setVideo(t.fill.video); $("pkg-freq").value = t.fill.shoot_frequency; $("pkg-out").value = t.fill.outputs; if (t.fill.hours != null) $("pkg-hours").value = t.fill.hours; }
      });
      $("pkg-cancel").addEventListener("click", () => renderPackage(r));
      $("pkg-save").addEventListener("click", async () => {
        const st = $("pkg-status");
        const h = $("pkg-hours").value.trim();
        const next = { tier: $("pkg-tier").value.trim() || null, video, shoot_frequency: video ? ($("pkg-freq").value.trim() || null) : null, outputs: $("pkg-out").value.trim() || null };
        const patch = { package_details: next, contracted_hours_per_month: h === "" ? null : Number(h) };
        const done = () => { Object.assign(r, patch); const hrs = document.querySelector('[data-ef="contracted_hours_per_month"]'); if (hrs) hrs.value = r.contracted_hours_per_month ?? ""; renderPackage(r); };
        if (isDemo(r)) { done(); return; }
        st.textContent = "Saving…";
        const { error } = await supabase.from("smm_leads").update(patch).eq("id", r.id);
        if (error) { st.textContent = /package_details/.test(error.message || "") ? "Needs supabase/smm_package_details.sql running first." : "Couldn't save: " + error.message; return; }
        done();
      });
    }

    /* ---------- Onboarding checklist ----------
       What Abbie works through once a contract is signed, in two parts
       (Danielle, 21 Oct 2026). Practical: everything done and the system set
       up properly. Items that can be read from the file (contract on file,
       start date, hub linked...) tick themselves; the rest are ticked by
       hand, and two Yes/No questions decide which further items apply.
       Strategy: six topics written down before posting starts. Stored in
       smm_leads.onboarding (supabase/smm_onboarding.sql). Wording in
       ONB_COPY, written to docs/tmke-copy-voice.md. */
    // Written to docs/tmke-copy-voice.md (copywriter brief, 21 Oct 2026).
    // **x** is bold: the exact names of buttons, tabs and fields.
    const ONB_COPY = {
      practicalIntro: "This is everything that needs to be in place before we start posting, and anything without a tick box ticks itself once the right details are on the client's file.",
      complete: "Every practical item is done, so this client is set up. Once the strategy's written, you're ready to click **Make active client**.",
      strategyIntro: "We write this down before we start posting, because it's what every month's content and report is measured against.",
      strategyDoc: { label: "Strategy document", hint: "If the strategy's in a presentation or document, upload it here. It's also kept in **Files** under **Notes**.", add: "Upload a document" },
      activeConfirm: (n) => `There ${n === 1 ? "is still 1 onboarding item" : `are still ${n} onboarding items`} open for this client. Do you want to make them an active client anyway? Click OK to carry on, or Cancel to go back and finish them.`,
      tickedBy: (who, when) => `Ticked by ${who}, ${when}`,
      autoDone: "Ticked automatically", autoOpen: "Ticks itself when this is on the file",
      groups: { paper: "Paperwork and billing", access: "Accounts and access", work: "How we'll work together", optimise: "Profile optimisation" },
      items: {
        contract: { label: "Signed contract on file", todo: "Upload the signed contract to **Paperwork** on the left, with the file type set to **Contract**.", done: "Done. There's a Contract file in **Paperwork**." },
        proposal: { label: "Proposal on file", todo: "Upload the proposal we sent them to **Paperwork**, with the file type set to **Proposal**, so anyone picking up the account can see what was offered.", done: "Done. There's a Proposal file in **Paperwork**." },
        package: { label: "Package details filled in", todo: "Add their package and tier in the **Package details** tab under **Notes**, so everyone working on the account knows what the client is paying for.", done: "Done. The package and tier are in **Package details**." },
        start: { label: "Start date set", todo: "Add the date we start working for them in **Start date**, in **Engagement & billing**.", done: "Done. The **Start date** is set in **Engagement & billing**." },
        billing: { label: "Billing set up", todo: "Set **Direct debit customer?** to **Yes** in **Engagement & billing**, or raise their first invoice in the **Invoicing** tab.", done: (r) => r.direct_debit ? "Done. They're set up as a direct debit customer." : "Done. Their first invoice has been raised in **Invoicing**." },
        manager: { label: "Account manager named", todo: "Choose who's looking after this client in **Social media manager**, in **Engagement & billing**.", done: "Done. Their social media manager is named in **Engagement & billing**." },
        hub: { label: "Linked to their Member Hub", todo: "Link this file to the client's Member Hub with **Link to hub account**, so they can see their reports and invoices there.", done: "Done. **Member hub** shows **Linked**." },
        channels: { label: "Platforms and links recorded", todo: "Tick each platform in **Platforms we manage** and add its link in **Social channels**.", done: "Done. Every platform in **Platforms we manage** has its link in **Social channels**." },
        access: { label: "Access to every platform", todo: "Get admin or manager access to every account we run for them, such as their Instagram, Facebook Page and LinkedIn page, because we can't post or see their insights without it." },
        socialpilot: { label: "Connected to SocialPilot", todo: "Add each platform to SocialPilot, so we can schedule their posts and run their monthly reports from it." },
        assets: { label: "Brand assets received", todo: "Collect their logo, brand colours, fonts and any photography or video they'd like us to use, and save them in the **Files** tab under **Notes**." },
        call: { label: "Onboarding call held", todo: "Hold the first call to agree how we'll work together, then note the date and anything agreed in the box below.", notePlaceholder: "e.g. Call on 14 Nov with Sarah. Posts go out Mon, Wed, Fri. She'll send new listings by email each Monday." },
        approvalQ: { label: "Do they want to approve every post before it goes out?", todo: "If they do, we need content ready further ahead, so they have time to review it before it's due to go out." },
        approval: { label: "Approval process agreed", todo: "Agree how they'll approve posts, for example by email or in a shared calendar, and how long they have to reply before we post anyway.", notePlaceholder: "e.g. Monday email with the week's posts. Two working days to reply, then we post." },
        shoot: { label: "First shoot booked", todo: "Book their first shoot in the **Videography** tab.", done: "Done. A shoot is booked in **Videography**." },
        optimiseQ: { label: "Is profile optimisation included in their start-up package?", todo: "If it is, we update their bios, images, pinned posts, highlights and links before we start, so anyone who finds them through our posts sees a profile that's up to date." },
        bios: { label: "Bios updated on each platform", todo: "Update the bio on each platform, so it says who they are, the areas they cover and how to get in touch." },
        images: { label: "Profile and cover images updated", todo: "Update the profile picture and cover image on each platform, using their current logo and branding." },
        pinned: { label: "Pinned posts set", todo: "Pin the posts new visitors should see first, on each platform that lets you pin." },
        highlights: { label: "Instagram highlights set up", todo: "Set up their Instagram highlights, grouping the stories people look for most, such as new listings, recent sales and reviews." },
        links: { label: "Links checked", todo: "Check that the website and booking links in each bio open the right page." },
      },
      topics: {
        competitors: { label: "Competitor analysis", hint: "Which local agents are they up against on social media? Note what those agents do well and where the gaps are that we can fill.", placeholder: "e.g. Two main rivals in Harrogate. Smith & Co post listings daily but no video. Hart Homes share good market updates but rarely reply to comments." },
        audience: { label: "Target audience", hint: "Who we're trying to reach, such as sellers, landlords, buyers or tenants, and what matters to each of them.", placeholder: "e.g. Homeowners aged 35 to 60 in Harrogate thinking of selling in the next year, plus local landlords with one or two properties." },
        groups: { label: "Groups", hint: "The local and community groups we'll share their content in, such as Facebook groups for the towns and villages they cover. Add a link to each and any posting rules the group has.", placeholder: "e.g. Harrogate Community Noticeboard (Facebook, business posts on Fridays only), Knaresborough Residents (Facebook, no listings, local news only)." },
        pillars: { label: "Content pillars", hint: "The main themes their content will come back to each month, and roughly how much of the month each one takes up.", placeholder: "e.g. Local market updates, new listings and sales, meet the team, area guides, client reviews." },
        tone: { label: "Tone", hint: "How they want to come across, and any words, phrases or topics to use or avoid.", placeholder: "e.g. Friendly and local, never pushy. Say \"home\" rather than \"property\". No emojis on LinkedIn." },
        goals: { label: "Goals", hint: "What they want social media to achieve in the first few months, with numbers where you can. These are the starting goals, and you can track them each month in the **Goals** table on the report's **Summary** tab.", placeholder: "e.g. Grow Instagram from 800 to 1,200 followers by March, and get five valuation enquiries a month through social." },
      },
    };
    // Escaped text with **bold** names.
    const onbMd = (t) => esc(t || "").replace(/\*\*(.+?)\*\*/g, "<b>$1</b>");
    const CHANNEL_FIELD = { Instagram: "instagram_url", Facebook: "facebook_url", LinkedIn: "linkedin_url", YouTube: "youtube_url", TikTok: "tiktok_url" };
    const onbState = (r) => { const o = r.onboarding && typeof r.onboarding === "object" ? r.onboarding : {}; return { done: o.done || {}, ask: o.ask || {}, notes: o.notes || {}, strategy: o.strategy || {} }; };
    const onbCtx = (r) => {
      const t = r._thread || {};
      return { docs: t.documents || r._lastDocs || [], shoots: t.shoots || [], invoices: r._onbInvoices || 0, loaded: !!r._thread };
    };
    // kind: auto (read from the file), manual (ticked), ask (Yes/No).
    const ONB_ITEMS = [
      { g: "paper", key: "contract", kind: "auto", test: (r, c) => c.docs.some((d) => d.category === "agreement") },
      { g: "paper", key: "proposal", kind: "auto", test: (r, c) => c.docs.some((d) => d.category === "prep") },
      { g: "paper", key: "package", kind: "auto", test: (r) => !!(r.package_name && (r.package_details || {}).tier) },
      { g: "paper", key: "start", kind: "auto", test: (r) => !!r.start_date },
      { g: "paper", key: "billing", kind: "auto", test: (r, c) => !!r.direct_debit || c.invoices > 0 || c.docs.some((d) => d.category === "invoice") },
      { g: "paper", key: "manager", kind: "auto", test: (r) => !!String(r.social_media_manager || "").trim() },
      { g: "access", key: "hub", kind: "auto", test: (r) => !!r.account_user_id },
      { g: "access", key: "channels", kind: "auto", test: (r) => { const ps = Array.isArray(r.platforms) ? r.platforms : []; return ps.length > 0 && ps.every((p) => !CHANNEL_FIELD[p] || String(r[CHANNEL_FIELD[p]] || "").trim()); } },
      { g: "access", key: "access", kind: "manual" },
      { g: "access", key: "socialpilot", kind: "manual" },
      { g: "access", key: "assets", kind: "manual" },
      { g: "work", key: "call", kind: "manual", note: "call" },
      { g: "work", key: "approvalQ", kind: "ask", ask: "approval" },
      { g: "work", key: "approval", kind: "manual", note: "approval", when: (r, o) => o.ask.approval === "yes" },
      { g: "work", key: "shoot", kind: "auto", when: (r) => !!(r.package_details || {}).video, test: (r, c) => c.shoots.some((b) => b.stage !== "cancelled") },
      { g: "optimise", key: "optimiseQ", kind: "ask", ask: "optimise" },
      { g: "optimise", key: "bios", kind: "manual", when: (r, o) => o.ask.optimise === "yes" },
      { g: "optimise", key: "images", kind: "manual", when: (r, o) => o.ask.optimise === "yes" },
      { g: "optimise", key: "pinned", kind: "manual", when: (r, o) => o.ask.optimise === "yes" },
      { g: "optimise", key: "highlights", kind: "manual", when: (r, o) => o.ask.optimise === "yes" && (Array.isArray(r.platforms) ? r.platforms : []).includes("Instagram") },
      { g: "optimise", key: "links", kind: "manual", when: (r, o) => o.ask.optimise === "yes" },
    ];
    const ONB_GROUPS = ["paper", "access", "work", "optimise"];
    const ONB_TOPICS = ["competitors", "audience", "groups", "pillars", "tone", "goals"];
    const onbDone = (r, it, o, c) => it.kind === "auto" ? !!it.test(r, c) : it.kind === "ask" ? !!o.ask[it.ask] : !!o.done[it.key];
    function onbCount(r) {
      const o = onbState(r), c = onbCtx(r);
      const items = ONB_ITEMS.filter((it) => !it.when || it.when(r, o));
      const done = items.filter((it) => onbDone(r, it, o, c)).length;
      const written = ONB_TOPICS.filter((k) => String(o.strategy[k] || "").trim()).length;
      return { total: items.length, done, open: items.length - done, written };
    }
    let onbPart = "practical";
    async function saveOnb(r, st) {
      const el = $("smm-onb-status");
      if (isDemo(r)) { if (el) el.textContent = "Saved (demo)."; return; }
      if (el) el.textContent = "Saving…";
      const { error } = await supabase.from("smm_leads").update({ onboarding: r.onboarding }).eq("id", r.id);
      if (el) el.textContent = error ? (/onboarding/.test(error.message || "") ? "Needs supabase/smm_onboarding.sql running first." : "Couldn't save: " + error.message) : "Saved.";
    }
    function renderOnboarding(r) {
      const host = $("smm-panel-onboarding");
      const c0 = onbCount(r);
      const n = $("smm-onb-n"); if (n) n.textContent = ` (${c0.done}/${c0.total})`;
      if (!host) return;
      // Invoices raised in the Invoicing tab count as billing set up: read once.
      if (r._onbInvoices == null && !isDemo(r) && WORKER) {
        r._onbInvoices = 0;
        authToken().then((token) => fetch(`${WORKER}/invoicing/invoices?booking_id=${encodeURIComponent(r.id)}`, { headers: { Authorization: "Bearer " + token } }))
          .then((res) => res.ok ? res.json() : {}).then((j) => { r._onbInvoices = ((j && j.invoices) || []).filter((v) => v.status !== "void").length; if (r._onbInvoices) renderOnboarding(r); }).catch(() => {});
      }
      const o = onbState(r), c = onbCtx(r), C = ONB_COPY;
      const when = (x) => { try { return new Date(x).toLocaleDateString("en-GB", { day: "numeric", month: "short" }); } catch (_) { return ""; } };
      // "abigail.saunders@…" reads as Abigail.
      const who = (x) => String(x || "").split("@")[0].split(/[._-]/)[0].toLowerCase().replace(/^./, (m) => m.toUpperCase());
      const row = (it) => {
        const t = C.items[it.key] || { label: it.key, todo: "" };
        const done = onbDone(r, it, o, c);
        const hint = it.kind === "auto" && done && t.done ? (typeof t.done === "function" ? t.done(r) : t.done) : t.todo;
        if (it.kind === "ask") return `<div class="smm-onb-row smm-onb-ask${done ? " is-done" : ""}"><span class="smm-onb-mark">${done ? "✓" : ""}</span><div class="smm-onb-main"><span class="smm-onb-label">${esc(t.label)}</span><span class="smm-onb-hint">${onbMd(hint)}</span><div class="pay-toggle smm-onb-yn"><button type="button" class="pay-opt${o.ask[it.ask] === "yes" ? " is-active" : ""}" data-onbask="${it.ask}" data-v="yes">Yes</button><button type="button" class="pay-opt${o.ask[it.ask] === "no" ? " is-active" : ""}" data-onbask="${it.ask}" data-v="no">No</button></div></div></div>`;
        const by = it.kind === "manual" && o.done[it.key] ? `<span class="smm-onb-by">${esc(C.tickedBy(who(o.done[it.key].by), when(o.done[it.key].at)))}</span>` : it.kind === "auto" ? `<span class="smm-onb-by">${esc(done ? C.autoDone : C.autoOpen)}</span>` : "";
        const box = it.kind === "manual"
          ? `<input type="checkbox" class="smm-onb-tick" data-onbtick="${it.key}"${done ? " checked" : ""} aria-label="${esc(t.label)}">`
          : `<span class="smm-onb-mark${done ? "" : " is-open"}">${done ? "✓" : ""}</span>`;
        const note = it.note ? `<textarea class="smm-onb-note" rows="2" data-onbnote="${it.note}" placeholder="${esc(t.notePlaceholder || "")}">${esc(o.notes[it.note] || "")}</textarea>` : "";
        return `<div class="smm-onb-row${done ? " is-done" : ""}${it.kind === "auto" ? " is-auto" : ""}">${box}<div class="smm-onb-main"><span class="smm-onb-label">${esc(t.label)}</span><span class="smm-onb-hint">${onbMd(hint)}</span>${by}${note}</div></div>`;
      };
      const items = ONB_ITEMS.filter((it) => !it.when || it.when(r, o));
      const practical = `${c0.open ? `<p class="smm-onb-intro">${onbMd(C.practicalIntro)}</p>` : `<p class="smm-onb-intro smm-onb-complete">${onbMd(C.complete)}</p>`}
        ${ONB_GROUPS.map((g) => { const its = items.filter((it) => it.g === g); return its.length ? `<h4 class="smm-comm-h">${esc(C.groups[g])}</h4><div class="smm-onb-list">${its.map(row).join("")}</div>` : ""; }).join("")}`;
      const strategy = `<p class="smm-onb-intro">${onbMd(C.strategyIntro)}</p>
        ${ONB_TOPICS.map((k) => { const t = C.topics[k]; return `<div class="smm-onb-topic"><h4 class="smm-onb-topic-h">${esc(t.label)}</h4><p class="smm-onb-hint">${onbMd(t.hint)}</p><textarea rows="4" data-onbtopic="${k}" placeholder="${esc(t.placeholder)}">${esc(o.strategy[k] || "")}</textarea></div>`; }).join("")}
        <div class="smm-onb-topic smm-onb-files"><h4 class="smm-onb-topic-h">${esc(C.strategyDoc.label)}</h4><p class="smm-onb-hint">${onbMd(C.strategyDoc.hint)}</p>
          ${c.docs.filter((d) => d.category === "strategy").map((d) => `<div class="smm-doc"><span class="smm-doc-ico">${DOC_SVG}</span><span class="smm-doc-main"><span class="smm-doc-name">${esc(d.title || d.file_name)}</span></span><span class="smm-doc-tools"><button type="button" class="smm-mini" data-docdl="${esc(d.id)}" data-docname="${esc(d.file_name || "strategy")}">Download</button></span></div>`).join("")}
          <button type="button" class="smm-btn smm-btn--sm" data-onbupload>${PLUS_SVG}${esc(C.strategyDoc.add)}</button></div>`;
      host.innerHTML = `
        <div class="ri-subtabs smm-onb-parts"><button type="button" class="ri-subtab${onbPart === "practical" ? " is-active" : ""}" data-onbpart="practical">Practical <span class="smm-onb-c">${c0.done} of ${c0.total}</span></button><button type="button" class="ri-subtab${onbPart === "strategy" ? " is-active" : ""}" data-onbpart="strategy">Strategy <span class="smm-onb-c">${c0.written} of ${ONB_TOPICS.length}</span></button></div>
        ${c.loaded ? "" : `<p class="smm-soon">Loading…</p>`}
        <div class="smm-onb-part" ${onbPart === "practical" ? "" : "hidden"}>${practical}</div>
        <div class="smm-onb-part" ${onbPart === "strategy" ? "" : "hidden"}>${strategy}</div>
        <p class="smm-onb-status" id="smm-onb-status"></p>`;
      const set = (fn) => { const cur = onbState(r); fn(cur); r.onboarding = cur; };
      host.querySelectorAll("[data-onbpart]").forEach((b) => b.addEventListener("click", () => { onbPart = b.dataset.onbpart; renderOnboarding(r); }));
      host.querySelectorAll("[data-docdl]").forEach((b) => b.addEventListener("click", () => downloadDoc(b.getAttribute("data-docdl"), b.getAttribute("data-docname"))));
      host.querySelector("[data-onbupload]")?.addEventListener("click", () => openAddFile(r, { cat: "strategy", name: "Strategy", heading: C.strategyDoc.add }));
      host.querySelectorAll("[data-onbtick]").forEach((b) => b.addEventListener("change", () => {
        set((cur) => { if (b.checked) cur.done[b.dataset.onbtick] = { at: new Date().toISOString(), by: ME || "you" }; else delete cur.done[b.dataset.onbtick]; });
        renderOnboarding(r); saveOnb(r);
      }));
      host.querySelectorAll("[data-onbask]").forEach((b) => b.addEventListener("click", () => {
        set((cur) => { cur.ask[b.dataset.onbask] = b.dataset.v; });
        renderOnboarding(r); saveOnb(r);
      }));
      host.querySelectorAll("[data-onbnote]").forEach((t) => t.addEventListener("change", () => { set((cur) => { cur.notes[t.dataset.onbnote] = t.value.trim(); }); saveOnb(r); }));
      host.querySelectorAll("[data-onbtopic]").forEach((t) => t.addEventListener("change", () => {
        set((cur) => { cur.strategy[t.dataset.onbtopic] = t.value.trim(); });
        const k = onbCount(r); const cEl = host.querySelector('[data-onbpart="strategy"] .smm-onb-c'); if (cEl) cEl.textContent = `${k.written} of ${ONB_TOPICS.length}`;
        saveOnb(r);
      }));
    }

    /* ---------- Paperwork ----------
       A copy of the proposal once it's gone (Proposal sent on), and of the
       signed contract once they're onboarding (Danielle, 20 Oct 2026). Each
       is a file in Documents of that type; this shows it, or a button to add
       it with the type already chosen. */
    const PAPERWORK = [
      { cat: "prep", from: "proposal_sent", label: "Proposal", add: "Add the proposal", name: "Proposal" },
      { cat: "agreement", from: "onboarding", label: "Signed contract", add: "Add the signed contract", name: "Signed contract" },
    ];
    function renderPaperwork(r, docs, loading) {
      const host = $("smm-paper"); if (!host) return;
      if (loading) { host.innerHTML = '<p class="smm-soon">Loading…</p>'; return; }
      const idx = STAGE_INDEX[stageOf(r)];
      host.innerHTML = PAPERWORK.filter((p) => idx >= STAGE_INDEX[p.from]).map((p) => {
        const have = docs.filter((d) => d.category === p.cat);
        return `<div><p class="smm-paper-k">${esc(p.label)}</p>${have.length ? have.map((d) => `<div class="smm-doc">
            <span class="smm-doc-ico">${DOC_SVG}</span>
            <span class="smm-doc-main"><span class="smm-doc-name">${esc(d.title || d.file_name)}</span>${d.created_at ? `<span class="smm-doc-cat">Added ${esc(new Date(d.created_at).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }))}</span>` : ""}</span>
            <span class="smm-doc-tools"><button type="button" class="smm-mini" data-docdl="${esc(d.id)}" data-docname="${esc(d.file_name || "document")}">Download</button></span>
          </div>`).join("") : `<div class="smm-paper-missing"><span>Not added yet</span><button type="button" class="smm-btn smm-btn--sm" data-paperadd="${p.cat}">${PLUS_SVG}${esc(p.add)}</button></div>`}</div>`;
      }).join("");
      host.querySelectorAll("[data-docdl]").forEach((b) => b.addEventListener("click", () => downloadDoc(b.getAttribute("data-docdl"), b.getAttribute("data-docname"))));
      host.querySelectorAll("[data-paperadd]").forEach((b) => b.addEventListener("click", () => {
        const p = PAPERWORK.find((x) => x.cat === b.getAttribute("data-paperadd"));
        openAddFile(r, { cat: p.cat, name: p.name, heading: p.add });
      }));
    }

    // ---------- Add-file modal ----------
    // `preset` (from Paperwork): the type chosen and a name filled in.
    function openAddFile(r, preset) {
      $("smm-modal-host").innerHTML = `
        <div class="smm-modal-scrim" id="smm-modal">
          <div class="smm-modal" role="dialog" aria-modal="true" aria-label="Add a file">
            <h3>${esc(preset && preset.heading ? preset.heading : "Add a file")}</h3>
            <p class="smm-modal-sub">Attach it to ${esc(nameOf(r))}'s file.</p>
            <div class="smm-modal-field"><label>File</label><input type="file" id="smm-af-file" class="smm-file-input"></div>
            <div class="smm-modal-field"><label>Type</label><select id="smm-af-type">${SMM_CATS.filter((c) => c[0] !== "invoice").map((c) => `<option value="${c[0]}">${c[1]}</option>`).join("")}</select></div>
            <div class="smm-modal-field"><label>Name (optional)</label><input type="text" id="smm-af-name" placeholder="e.g. Signed agreement"></div>
            <p class="smm-modal-status" id="smm-af-status" hidden></p>
            <div class="smm-modal-actions">
              <button type="button" class="smm-btn" data-mcancel>Cancel</button>
              <button type="button" class="smm-btn smm-btn--primary" id="smm-af-add">Add file</button>
            </div>
          </div>
        </div>`;
      const scrim = $("smm-modal");
      scrim.addEventListener("click", (e) => { if (e.target === scrim) closeModal(); });
      $("smm-modal-host").querySelector("[data-mcancel]").addEventListener("click", closeModal);
      if (preset) { $("smm-af-type").value = preset.cat; $("smm-af-name").value = preset.name || ""; }
      $("smm-af-add").addEventListener("click", () => uploadFile(r));
    }
    async function uploadFile(r) {
      const fileEl = $("smm-af-file"); const file = fileEl && fileEl.files && fileEl.files[0];
      const cat = $("smm-af-type").value || "other"; const title = $("smm-af-name").value.trim();
      const status = $("smm-af-status");
      if (!file) { status.hidden = false; status.textContent = "Choose a file first."; return; }
      if (isDemo(r)) { r._thread.documents.push({ id: "d" + Date.now(), file_name: file.name, title: title || null, category: cat }); closeModal(); renderThread(r, r._thread); return; }
      const btn = $("smm-af-add"); btn.disabled = true; btn.textContent = "Uploading…";
      try {
        const token = await authToken();
        const qs = new URLSearchParams({ booking_id: r.id, source: "smm", category: cat, file_name: file.name, content_type: file.type || "application/octet-stream" });
        if (title) qs.set("title", title);
        const res = await fetch(`${WORKER}/booking/document?${qs.toString()}`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": file.type || "application/octet-stream" }, body: file });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.document) throw new Error(j.error || "Upload failed");
        closeModal(); loadThread(r);
      } catch (e) { status.hidden = false; status.textContent = e.message || "Couldn't upload — try again."; btn.disabled = false; btn.textContent = "Add file"; }
    }

    // ---------- Invoicing ----------
    async function setInvoicePaid(r, id, date) {
      if (isDemo(r)) { const d = r._thread.documents.find((x) => x.id === id); if (d) d.paid_date = date || null; renderThread(r, r._thread); return; }
      try { const token = await authToken(); await fetch(`${WORKER}/booking/document/paid`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ id, paid_date: date || null }) }); loadThread(r); } catch (_) {}
    }

    // ---------- Invoicing (the full builder, per client) ----------
    // Reuses the standalone engine: POST /invoicing/invoices creates a numbered
    // draft (number + VAT server-side), booking_id links it to this SMM client.
    let sivItems = [];       // [{ description, amount }] for the client being viewed
    let sivInvoices = [];    // the raised-invoice list (for the send modal lookup)
    let sivTemplate = "minimal"; // which style this invoice uses
    // Off by default. Only some clients pay by card - the rest are bank
    // transfer or inter-brand - so this is a deliberate choice per invoice
    // rather than something that quietly appears on every one.
    let sivPayByCard = false;
    let invSettings = null;  // cached company/VAT settings for preview + totals
    const gbp = (p) => "£" + ((p || 0) / 100).toFixed(2);
    const ordinal = (n) => { const s = ["th", "st", "nd", "rd"], v = n % 100; return s[(v - 20) % 10] || s[v] || s[0]; };
    const sivSettings = () => ({ ...invSettings, template: sivTemplate });
    function syncSivTpl() { document.querySelectorAll("#siv-tpl .siv-tpl-opt").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-tpl") === sivTemplate)); }
    function syncSivPay() { document.querySelectorAll("#siv-pay .siv-tpl-opt").forEach((b) => b.classList.toggle("is-active", (b.getAttribute("data-pay") === "yes") === sivPayByCard)); }
    const parseMoney = (s) => { const m = String(s || "").match(/[\d,]+(\.\d+)?/); return m ? Math.round(parseFloat(m[0].replace(/,/g, "")) * 100) : 0; };
    async function ensureInvSettings() {
      if (invSettings) return invSettings;
      if (!WORKER) { invSettings = {}; return invSettings; }
      try { const token = await authToken(); const res = await fetch(`${WORKER}/invoicing/settings`, { headers: { Authorization: "Bearer " + token } }); const j = await res.json().catch(() => ({})); invSettings = (j && j.settings) || {}; } catch (_) { invSettings = {}; }
      return invSettings;
    }
    function sivTotals() {
      const vatRate = Number(invSettings && invSettings.vat_rate != null ? invSettings.vat_rate : 20);
      const subtotal = sivItems.reduce((s, it) => s + Math.round((parseFloat(it.amount) || 0) * 100), 0);
      const vat = Math.round(subtotal * vatRate / 100);
      return { subtotal, vat, total: subtotal + vat, vatRate };
    }
    function sivBuildInvoice(r) {
      const t = sivTotals();
      return {
        number: (invSettings.invoice_prefix || "TMKE") + (invSettings.next_number || 1001),
        issued_date: $("siv-issued").value || null, due_date: $("siv-due").value || null,
        bill_to_name: $("siv-name").value.trim(), bill_to_email: $("siv-email").value.trim(), bill_to_address: $("siv-address").value.trim(),
        client_name: ($("siv-client")?.value || "").trim() || null,
        notes: ($("siv-notes")?.value || "").trim() || null,
        line_items: sivItems.map((it) => ({ description: it.description, qty: 1, unit_pence: Math.round((parseFloat(it.amount) || 0) * 100) })),
        subtotal_pence: t.subtotal, vat_pence: t.vat, total_pence: t.total,
        pay_by_card: sivPayByCard,   // drives the "How to pay" wording in the PDF preview
      };
    }
    function sivRenderItems() {
      $("siv-items").innerHTML = sivItems.map((it, i) => `<div class="siv-item"><input class="siv-desc" data-i="${i}" placeholder="Description of the service" value="${esc(it.description)}"><input class="siv-amt" data-i="${i}" type="number" step="0.01" placeholder="0.00" value="${esc(it.amount)}"><button type="button" class="siv-del" data-i="${i}" title="Remove">&times;</button></div>`).join("");
    }
    function sivRenderTotals() {
      const t = sivTotals();
      $("siv-totals").innerHTML = `<span>Sub-total ${gbp(t.subtotal)} · VAT (${t.vatRate}%) ${gbp(t.vat)}</span><strong>Total ${gbp(t.total)}</strong>`;
    }
    function sivRefreshItems() { sivRenderItems(); sivRenderTotals(); wireSivItems(); }
    function wireSivItems() {
      $("siv-items").querySelectorAll(".siv-desc").forEach((el) => el.addEventListener("input", (e) => { sivItems[+e.target.getAttribute("data-i")].description = e.target.value; }));
      $("siv-items").querySelectorAll(".siv-amt").forEach((el) => el.addEventListener("input", (e) => { sivItems[+e.target.getAttribute("data-i")].amount = e.target.value; sivRenderTotals(); }));
      $("siv-items").querySelectorAll(".siv-del").forEach((el) => el.addEventListener("click", (e) => { sivItems.splice(+e.currentTarget.getAttribute("data-i"), 1); if (!sivItems.length) sivItems.push({ description: "", amount: "" }); sivRefreshItems(); }));
    }
    async function renderInvoicing(r, panel, docs, loading, warn) {
      // Fresh every time the tab opens: the details may have been changed on
      // the Invoicing page since this page loaded.
      invSettings = null;
      await ensureInvSettings();
      const dt = { classic: "minimal", editorial: "minimal", modern: "banded" }[invSettings.template] || invSettings.template;
      sivTemplate = ["minimal", "banded"].includes(dt) ? dt : "minimal";
      // Seed one line item from the agreed monthly price (editable; add more rows).
      sivItems = [{ description: "Social media management" + (r.package_name ? " — " + r.package_name : "") + " (monthly)", amount: parseMoney(r.price) ? (parseMoney(r.price) / 100).toFixed(2) : "" }];
      const today = new Date().toISOString().slice(0, 10);
      const due = new Date(); due.setDate(due.getDate() + Number((invSettings && invSettings.payment_terms_days) || 7)); const dueISO = due.toISOString().slice(0, 10);
      const uploaded = docs.filter((d) => d.category === "invoice");
      const fmtDate = (d) => { if (!d) return "—"; try { return new Date(d + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); } catch (_) { return d; } };
      const billName = r.business || (nameOf(r) === "—" ? "" : nameOf(r));
      // Inter-brand: the payer is another TEG brand, so the invoice names the
      // client it was for (that is what the month-end report groups by). Billed
      // to the client themselves, the line is left off.
      const clientName = nameOf(r) === "—" ? (r.business || "") : nameOf(r);
      panel.innerHTML = `
        <div class="smm-panel-head"><h4>Invoicing</h4></div>
        ${r.direct_debit ? `<div class="siv-dd-banner">💳 <span><strong>Direct Debit client${r.direct_debit_day ? ` — collected on the ${r.direct_debit_day}${ordinal(r.direct_debit_day)}` : ""}.</strong> Invoices are raised to your accounts team as reminders (not emailed to the customer), then you mark them paid.</span></div>` : ""}
        ${warn ? `<p class="smm-soon" style="margin-bottom:12px">${esc(warn)}</p>` : ""}
        ${r.direct_debit ? `
        <div class="siv-dd-recip">
          <label class="siv-f"><span>Ghost invoices sent to</span><input id="dd-recip" value="${esc(r.dd_invoice_email || "danielle@tmke.co.uk")}" placeholder="accounts@…"></label>
          <p class="smm-hint" id="dd-recip-status" style="min-height:15px"></p>
          <p class="smm-hint">Invoices auto-raise on the <strong>1st of each month</strong> — line "Social media management (month)", amount from <strong>Pricing</strong>, due on their DD date — and are emailed here as a reminder. Mark each paid once the Direct Debit clears.</p>
        </div>` : `
        <div class="siv-build">
          <div class="siv-tpl">
            <span class="siv-tpl-lbl">Template</span>
            <div class="siv-tpl-opts" id="siv-tpl">
              <button type="button" class="siv-tpl-opt" data-tpl="minimal">Minimal</button>
              <button type="button" class="siv-tpl-opt" data-tpl="banded">Banded</button>
            </div>
          </div>
          <div class="siv-tpl">
            <span class="siv-tpl-lbl">Card payment</span>
            <div class="siv-tpl-opts" id="siv-pay">
              <button type="button" class="siv-tpl-opt" data-pay="no">Off</button>
              <button type="button" class="siv-tpl-opt" data-pay="yes">On</button>
            </div>
            <span class="siv-pay-hint">Adds a &ldquo;Pay by card&rdquo; button to the email. Bank details stay on the invoice either way.</span>
          </div>
          <div class="siv-grid2">
            <label class="siv-f"><span>Bill to</span><input id="siv-name" value="${esc(billName)}"></label>
            <label class="siv-f"><span>Email</span><input id="siv-email" type="email" value="${esc(r.email || "")}"></label>
          </div>
          <label class="siv-f"><span>Client <small style="font-weight:400;opacity:.7">only when billing another brand - blank leaves it off the invoice</small></span><input id="siv-client" value="${esc(r.inter_brand_invoice ? clientName : "")}" placeholder="Who the work was for, if different"></label>
          <label class="siv-f"><span>Billing address</span><textarea id="siv-address" rows="2" placeholder="Optional">${esc(r.business_address || "")}</textarea></label>
          <label class="siv-f"><span>CC</span><input id="siv-cc" value="${esc(invSettings.accounts_cc_email || "")}" placeholder="Accounts, comma-separated"></label>
          <div class="siv-grid2">
            <label class="siv-f"><span>Issued</span><input id="siv-issued" type="date" value="${today}"></label>
            <label class="siv-f"><span>Due</span><input id="siv-due" type="date" value="${dueISO}"></label>
          </div>
          <div class="siv-f"><span>Line items</span><div id="siv-items"></div><button type="button" class="smm-btn smm-btn--sm" id="siv-add">${PLUS_SVG}Add line</button></div>
          <div class="siv-totals" id="siv-totals"></div>
          <label class="siv-f"><span>Notes (optional)</span><textarea id="siv-notes" rows="2" placeholder="e.g. Thank you for your business.">Thank you for your business - TMKE</textarea></label>
          <p class="smm-modal-status" id="siv-msg" hidden></p>
          <div class="siv-actions">
            <button type="button" class="smm-btn" id="siv-pdf">Preview / PDF</button>
            <button type="button" class="smm-btn" id="siv-create">Save draft</button>
            <button type="button" class="smm-btn smm-btn--primary" id="siv-send">Create &amp; send</button>
          </div>
        </div>`}
        <div class="siv-list-head">Raised invoices</div>
        <div id="siv-list"><p class="smm-soon">Loading…</p></div>
        ${uploaded.length ? `<div class="siv-list-head">Uploaded PDFs</div>${uploaded.map((d) => `<div class="smm-inv"><div class="smm-inv-top"><span class="smm-doc-ico">${DOC_SVG}</span><span class="smm-doc-main"><span class="smm-doc-name">${esc(d.title || d.file_name)}</span><span class="smm-doc-cat">Sent ${fmtDate(d.invoice_date)}</span></span><span class="smm-inv-status ${d.paid_date ? "is-paid" : "is-due"}">${d.paid_date ? "Paid" : "Outstanding"}</span></div><div class="smm-inv-foot"><label class="smm-inv-paid">Paid <input type="date" data-invpaid="${esc(d.id)}" value="${esc(d.paid_date || "")}"></label><span class="smm-doc-tools"><button type="button" class="smm-mini" data-docdl="${esc(d.id)}" data-docname="${esc(d.file_name || "invoice")}">Download</button><button type="button" class="smm-mini is-danger" data-docdel="${esc(d.id)}">Remove</button></span></div></div>`).join("")}` : ""}`;
      if (r.direct_debit) {
        // DD client — no manual builder. Save the ghost-invoice recipient, and
        // ask the Worker to ensure this month's invoice exists before listing.
        $("dd-recip")?.addEventListener("change", (e) => saveDdRecipient(r, e.target.value));
        ensureDdThenLoad(r);
      } else {
        sivRefreshItems(); syncSivTpl();
        $("siv-tpl").addEventListener("click", (e) => { const b = e.target.closest(".siv-tpl-opt"); if (!b) return; sivTemplate = b.getAttribute("data-tpl"); syncSivTpl(); });
        $("siv-pay")?.addEventListener("click", (e) => { const b = e.target.closest(".siv-tpl-opt"); if (!b) return; sivPayByCard = b.getAttribute("data-pay") === "yes"; syncSivPay(); });
        syncSivPay();
        $("siv-add").addEventListener("click", () => { sivItems.push({ description: "", amount: "" }); sivRefreshItems(); });
        $("siv-pdf").addEventListener("click", () => { const w = window.open("", "_blank"); if (!w) return; w.document.open(); w.document.write(renderInvoiceHtml({ settings: sivSettings(), invoice: sivBuildInvoice(r) })); w.document.close(); });
        $("siv-create").addEventListener("click", () => createSmmInvoice(r, false));
        $("siv-send").addEventListener("click", () => createSmmInvoice(r, true));
        loadSmmInvoices(r);
      }
      panel.querySelectorAll("[data-invpaid]").forEach((el) => el.addEventListener("change", () => setInvoicePaid(r, el.getAttribute("data-invpaid"), el.value)));
      panel.querySelectorAll("[data-docdl]").forEach((b) => b.addEventListener("click", () => downloadDoc(b.getAttribute("data-docdl"), b.getAttribute("data-docname"))));
      panel.querySelectorAll("[data-docdel]").forEach((b) => b.addEventListener("click", () => deleteDoc(r, b.getAttribute("data-docdel"))));
    }
    async function saveDdRecipient(r, value) {
      r.dd_invoice_email = value.trim() || null;
      const st = $("dd-recip-status"); if (st) st.textContent = "Saving…";
      if (isDemo(r)) { if (st) st.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ dd_invoice_email: r.dd_invoice_email }).eq("id", r.id); if (st) st.textContent = "Saved."; }
      catch (_) { if (st) st.textContent = "Couldn't save."; }
    }
    async function ensureDdThenLoad(r) {
      const wrap = $("siv-list"); if (wrap) wrap.innerHTML = `<p class="smm-soon">Raising this month's invoice…</p>`;
      if (!isDemo(r) && WORKER) {
        try { const token = await authToken(); await fetch(`${WORKER}/invoicing/dd/ensure`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: r.id }) }); } catch (_) {}
      }
      loadSmmInvoices(r);
    }
    async function loadSmmInvoices(r) {
      const wrap = $("siv-list"); if (!wrap) return;
      const fmtDate = (d) => { if (!d) return "—"; try { return new Date(d + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); } catch (_) { return d; } };
      // Was it sent, when, and to whom - on the row, not in someone's inbox.
      const sentNote = (v) => {
        if (!v.sent_to && !v.sent_at) return "";
        const when = v.sent_at ? new Date(v.sent_at).toLocaleString("en-GB", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" }) : "";
        return `<span class="siv-sent">Sent${when ? " " + esc(when) : ""}${v.sent_to ? " to " + esc(v.sent_to) : ""}</span>`;
      };
      const rowsHtml = (list) => list.length ? list.map((v) => `<div class="siv-row"><span class="siv-num">${esc(v.number)}</span><span class="siv-due">Due ${fmtDate(v.due_date)}${sentNote(v)}</span><span class="siv-amt2">${gbp(v.total_pence)}</span><span class="smm-inv-status ${v.status === "paid" ? "is-paid" : "is-due"}">${esc(v.status)}</span><span class="siv-row-tools">${v.status !== "paid" && v.status !== "void" ? `${v.bill_to_email ? `<button type="button" class="smm-mini is-primary" data-sivsend="${esc(v.id)}">${v.status === "sent" ? "Resend" : "Send"}</button>` : ""}<button type="button" class="smm-mini" data-sivpaid="${esc(v.id)}">Mark paid</button>` : ""}<button type="button" class="smm-mini" data-sivview="${esc(v.id)}">View</button><button type="button" class="smm-mini" data-sivvoid="${esc(v.id)}">Void</button><button type="button" class="smm-mini is-danger" data-sivdel="${esc(v.id)}">Delete</button></span></div>`).join("") : `<p class="smm-doc-empty">No invoices raised yet.</p>`;
      if (isDemo(r)) { sivInvoices = r._invoices || []; wrap.innerHTML = rowsHtml(sivInvoices); }
      else if (!WORKER) { wrap.innerHTML = '<p class="smm-doc-empty">Connect the Worker to raise invoices.</p>'; return; }
      else {
        try { const token = await authToken(); const res = await fetch(`${WORKER}/invoicing/invoices?booking_id=${encodeURIComponent(r.id)}`, { headers: { Authorization: "Bearer " + token } }); const j = await res.json().catch(() => ({})); sivInvoices = (j && j.invoices) || []; wrap.innerHTML = rowsHtml(sivInvoices); }
        catch (_) { wrap.innerHTML = '<p class="smm-doc-empty">Couldn\'t load invoices.</p>'; }
      }
      wrap.querySelectorAll("[data-sivpaid]").forEach((b) => b.addEventListener("click", async () => {
        b.disabled = true;
        if (isDemo(r)) { const v = (r._invoices || []).find((x) => x.id === b.getAttribute("data-sivpaid")); if (v) v.status = "paid"; loadSmmInvoices(r); return; }
        try { const token = await authToken(); await fetch(`${WORKER}/invoicing/invoices`, { method: "PATCH", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ id: b.getAttribute("data-sivpaid"), status: "paid" }) }); loadSmmInvoices(r); } catch (_) { b.disabled = false; }
      }));
      wrap.querySelectorAll("[data-sivview]").forEach((b) => b.addEventListener("click", async () => {
        const was = b.textContent; b.disabled = true; b.textContent = "Opening…";
        const tab = window.open("", "_blank");                    // opened on the click, or the browser blocks it
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER}/invoicing/invoice-pdf?id=${encodeURIComponent(b.getAttribute("data-sivview"))}`, { headers: { Authorization: "Bearer " + token } });
          const j = await res.json().catch(() => ({}));
          if (!res.ok || !j.url) throw new Error(j.error || "Couldn't open it.");
          if (tab) tab.location = j.url; else window.location = j.url;
        } catch (err) { if (tab) tab.close(); alert("Couldn't open the invoice: " + err.message); }
        finally { b.disabled = false; b.textContent = was; }
      }));
      wrap.querySelectorAll("[data-sivsend]").forEach((b) => b.addEventListener("click", () => {
        const inv = (sivInvoices || []).find((x) => x.id === b.getAttribute("data-sivsend"));
        if (inv) openSmmEmailModal(inv, r);
      }));
      wrap.querySelectorAll("[data-sivdel]").forEach((b) => b.addEventListener("click", async () => {
        if (!confirm("Delete this invoice? This permanently removes it and its PDF — it can't be undone.")) return;
        b.disabled = true;
        if (isDemo(r)) { r._invoices = (r._invoices || []).filter((x) => x.id !== b.getAttribute("data-sivdel")); loadSmmInvoices(r); return; }
        try { const token = await authToken(); await fetch(`${WORKER}/invoicing/invoices?id=${encodeURIComponent(b.getAttribute("data-sivdel"))}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } }); loadSmmInvoices(r); } catch (e) { alert(e.message); b.disabled = false; }
      }));
      wrap.querySelectorAll("[data-sivvoid]").forEach((b) => b.addEventListener("click", async () => {
        const reason = prompt("Void this invoice? It'll be removed and accounts + you will be emailed.\n\nReason for voiding:");
        if (reason === null) return;
        b.disabled = true;
        if (isDemo(r)) { r._invoices = (r._invoices || []).filter((x) => x.id !== b.getAttribute("data-sivvoid")); loadSmmInvoices(r); return; }
        try { const token = await authToken(); const res = await fetch(`${WORKER}/invoicing/invoices/void`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ id: b.getAttribute("data-sivvoid"), reason }) }); if (!res.ok) { const j = await res.json().catch(() => ({})); throw new Error(j.error || "Void failed."); } loadSmmInvoices(r); } catch (e) { alert(e.message); b.disabled = false; }
      }));
    }
    // Default covering-email text (mirrors the Worker default; keys off due date).
    function smmDefaultEmailBody(inv) {
      const company = invSettings.company_name || "The Marketing Experts (Nationwide) Ltd";
      const due = inv.due_date ? new Date(inv.due_date + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) : null;
      const lines = [`Dear ${inv.bill_to_name || "Sir or Madam"},`, "", `Please find attached invoice ${inv.number} from ${company}.`, "", `Amount due: ${gbp(inv.total_pence || 0)}`];
      if (due) lines.push(`Due date: ${due}`);
      // When the invoice carries a pay link, say so - telling someone to pay by
  // bank transfer while a card button sits above it just reads as contradictory.
  lines.push("", inv.pay_by_card ? `Payment is due${due ? ` by ${due}` : ""}. You can pay by card using the button in this email, or by bank transfer using the account details on the invoice, quoting ${inv.number} as the reference. If you have any questions, just reply to this email.`
    : `Payment is due${due ? ` by ${due}` : ""} by bank transfer — the account details are on the invoice, and please quote ${inv.number} as the reference. If you have any questions, just reply to this email.`, "", "Kind regards,", company);
      // Shoots only. An SMM invoice must not promise anything about content.
      if (inv.release_on_payment) {
        lines.splice(lines.length - 2, 0, "", "Payment isn't required until your shoot has taken place. Your content stays watermarked and locked until payment reaches us — once it does we'll email your PIN, which unlocks downloading from your gallery.");
      }
      return lines.join("\n");
    }
    // QuickBooks-style edit-before-send review modal.
    function openSmmEmailModal(inv, r) {
      const subject = `Invoice ${inv.number} from ${invSettings.company_name || "The Marketing Experts (Nationwide) Ltd"}`;
      $("smm-modal-host").innerHTML = `
        <div class="smm-modal-scrim" id="smm-modal">
          <div class="smm-modal smm-modal--email" role="dialog" aria-modal="true" aria-label="Send invoice">
            <h3>Send invoice ${esc(inv.number)}</h3>
            <p class="smm-modal-sub">Review the email — edit anything before it goes. The PDF and your footer image are added automatically.</p>
            <div class="smm-modal-field"><label>To</label><input type="text" id="sem-to" value="${esc(inv.bill_to_email || "")}" readonly></div>
            <div class="smm-modal-field"><label>CC</label><input type="text" id="sem-cc" value="${esc(inv.cc_email || "")}"></div>
            <div class="smm-modal-field"><label>Subject</label><input type="text" id="sem-subject" value="${esc(subject)}"></div>
            <div class="smm-modal-field"><label>Message</label><textarea id="sem-body" rows="10">${esc(smmDefaultEmailBody(inv))}</textarea></div>
            <p class="cim-pay${inv.pay_by_card ? " is-on" : ""}">${inv.pay_by_card
              ? "This email includes a Pay by card button (Stripe)."
              : "No payment link — bank transfer only, using the details on the invoice."}</p>
            <p class="smm-modal-status" id="sem-status" hidden></p>
            <div class="smm-modal-actions">
              <button type="button" class="smm-btn" data-mcancel>Cancel</button>
              <button type="button" class="smm-btn smm-btn--primary" id="sem-send">Send invoice</button>
            </div>
          </div>
        </div>`;
      const scrim = $("smm-modal");
      scrim.addEventListener("click", (e) => { if (e.target === scrim) closeModal(); });
      $("smm-modal-host").querySelector("[data-mcancel]").addEventListener("click", closeModal);
      $("sem-send").addEventListener("click", async () => {
        const btn = $("sem-send"), status = $("sem-status"); btn.disabled = true; btn.textContent = "Sending…";
        if (isDemo(r)) { const v = (r._invoices || []).find((x) => x.id === inv.id); if (v) v.status = "sent"; closeModal(); loadSmmInvoices(r); return; }
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER}/invoicing/invoices/send`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ id: inv.id, email_subject: $("sem-subject").value.trim(), email_body: $("sem-body").value, cc: $("sem-cc").value.trim() }) });
          const j = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(j.error || "Send failed.");
          closeModal(); loadSmmInvoices(r);
        } catch (e) { status.hidden = false; status.textContent = e.message; btn.disabled = false; btn.textContent = "Send invoice"; }
      });
    }
    // Create a draft (and optionally send it). send=true also emails the recipient.
    async function createSmmInvoice(r, send) {
      const inv = sivBuildInvoice(r);
      const msgEl = $("siv-msg");
      const show = (t, ok) => { msgEl.hidden = false; msgEl.textContent = t; msgEl.style.color = ok ? "#2e6b40" : "#a3372b"; };
      if (!inv.bill_to_name) { show("Add a recipient name.", false); return; }
      if (send && !inv.bill_to_email) { show("Add a recipient email to send to.", false); return; }
      if (!inv.line_items.some((it) => it.description || it.unit_pence)) { show("Add at least one line item.", false); return; }
      const btn = send ? $("siv-send") : $("siv-create"); const label = btn.textContent; btn.disabled = true; btn.textContent = send ? "Preparing…" : "Saving…";
      const ccVal = ($("siv-cc")?.value || "").trim();
      if (isDemo(r)) { r._invoices = r._invoices || []; const demoInv = { id: "iv" + Date.now(), number: inv.number, due_date: inv.due_date, total_pence: inv.total_pence, status: "draft", bill_to_name: inv.bill_to_name, bill_to_email: inv.bill_to_email, cc_email: ccVal }; r._invoices.unshift(demoInv); loadSmmInvoices(r); btn.disabled = false; btn.textContent = label; if (send) openSmmEmailModal(demoInv, r); else show(`Invoice ${inv.number} saved as a draft.`, true); return; }
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/invoicing/invoices`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: r.id, booking_source: "smm", bill_to_name: inv.bill_to_name, client_name: inv.client_name || null, bill_to_email: inv.bill_to_email || null, bill_to_address: inv.bill_to_address || null, cc_email: ccVal, issued_date: inv.issued_date, due_date: inv.due_date, notes: inv.notes, template: sivTemplate, pay_by_card: sivPayByCard, line_items: inv.line_items }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.invoice) throw new Error(j.error || "Couldn't create the invoice.");
        invSettings.next_number = (invSettings.next_number || 1001) + 1;
        loadSmmInvoices(r);
        if (send) openSmmEmailModal(j.invoice, r);
        else show(`Invoice ${j.invoice.number} saved as a draft.`, true);
      } catch (e) { show(e.message, false); }
      finally { btn.disabled = false; btn.textContent = label; }
    }

    // ---------- Insights (per-client SocialPilot reports) ----------
    let riReportId = null, riTab = "overview";
    async function loadInsights(r) {
      const panel = $("smm-panel-insights"); if (!panel) return;
      if (!r._reports) {
        if (isDemo(r)) { r._reports = []; }
        else if (WORKER) {
          panel.innerHTML = '<p class="smm-soon">Loading reports…</p>';
          // A failed load says so, and isn't kept: "No reports yet" is only for
          // a card that really has none.
          r._reportsError = "";
          try { const token = await authToken(); const res = await fetch(`${WORKER}/smm/reports?lead_id=${encodeURIComponent(r.id)}`, { headers: { Authorization: "Bearer " + token } }); const j = await res.json().catch(() => ({})); if (res.ok) { r._reports = (j.reports || []).map((x) => ({ id: x.id, platform: x.platform, month: x.month, year: x.year, data: x.data || {}, published_at: x.published_at || null, published_data: x.published_data || null, amended_at: x.amended_at || null, amendment_notice_at: x.amendment_notice_at || null })); } else r._reportsError = j.error || `Couldn't load reports (${res.status}).`; } catch (e) { r._reportsError = `Couldn't load reports: ${e.message || e}`; }
          if (r._reportsError) { panel.innerHTML = `<p class="smm-doc-empty">${esc(r._reportsError)} <button type="button" class="smm-btn smm-btn--sm" id="smm-ri-retry">Try again</button></p>`; $("smm-ri-retry")?.addEventListener("click", () => loadInsights(r)); return; }
        } else r._reports = [];
      }
      renderInsights(r);
    }
    // Key order differs between what the database hands back and what an edit
    // builds, so compare with the keys sorted.
    const stable = (v) => Array.isArray(v) ? `[${v.map(stable).join(",")}]` : v && typeof v === "object" ? `{${Object.keys(v).sort().map((k) => JSON.stringify(k) + ":" + stable(v[k])).join(",")}}` : JSON.stringify(v);
    // Live, but edited since: the client still sees the published copy.
    // The Summary tab is ours, not the client's, so editing it isn't a
    // change the client is waiting for: it's left out of the comparison
    // (and the plan too, when the client has their own on Client commentary).
    const clientSide = (d) => { const { summary, trendSummary, goals, ...rest } = d || {}; if (rest.client && (rest.client.priorities || []).length) delete rest.priorities; return rest; };
    const hasPending = (x) => !!(x && x.published_at && x.published_data && stable(clientSide(x.data)) !== stable(clientSide(x.published_data)));
    const riSorted = (r) => (r._reports || []).slice().sort((a, b) => (a.year !== b.year ? a.year - b.year : a.month - b.month));
    function renderInsights(r) {
      const panel = $("smm-panel-insights"); if (!panel) return;
      const reps = riSorted(r);
      const head = `<div class="smm-panel-head"><h4>Insights</h4><div class="ri-head-acts">${(r._reports || []).length ? `<button type="button" class="smm-btn smm-btn--sm smm-btn--primary" id="smm-ri-publish">Publish to client</button>` : ""}<button type="button" class="smm-btn smm-btn--sm" id="smm-ri-upload">${PLUS_SVG}Upload report</button></div></div>`;
      if (!reps.length) { panel.innerHTML = head + '<p class="smm-doc-empty">No reports yet — upload this client\'s SocialPilot month to build their dashboard.</p>'; $("smm-ri-upload")?.addEventListener("click", () => openReportUpload(r)); return; }
      if (!riReportId || !reps.find((x) => x.id === riReportId)) riReportId = reps[reps.length - 1].id;
      const cur = reps.find((x) => x.id === riReportId) || reps[reps.length - 1];
      const isAi = riTab === "ai";
      // A dot marks the months the client can see.
      const strip = isAi ? "" : `<div class="ri-months">${reps.map((x) => `<button type="button" class="ri-month ${x.id === riReportId ? "is-active" : ""}${x.published_at ? " is-live" : ""}${hasPending(x) ? " is-pending" : ""}" data-rmonth="${esc(x.id)}" title="${hasPending(x) ? "Live, with changes the client can't see yet" : x.published_at ? "Live in the client's hub" : "Draft: the client can't see this yet"}">${esc(RI_MONTHS[x.month])} ${x.year}</button>`).join("")}</div>`;
      // A live month edited since it went out: say so, and offer to send it.
      const pendingBar = !isAi && hasPending(cur) ? `<div class="ri-pending"><span><b>Changes not published.</b> ${esc(nameOf(r))} still sees ${esc(RI_MONTHS[cur.month])} as it was ${cur.amended_at ? "last republished" : "published"}.</span><button type="button" class="smm-btn smm-btn--sm smm-btn--primary" id="smm-ri-republish">Republish</button></div>` : "";
      const TABS = [["overview", "Overview"], ["content", "Content"], ["audience", "Audience"], ["actions", "Client commentary"], ["trends", "Trends"], ["summary", "Management Summary"], ["ai", "Ask AI ✦"]];
      const subtabs = `<div class="ri-subtabs">${TABS.map(([k, l]) => `<button type="button" class="ri-subtab ${riTab === k ? "is-active" : ""}" data-rtab="${k}">${l}</button>`).join("")}</div>`;
      // Trends look back three months from the month on screen, no further:
      // social moves too fast for older months to say much about this one.
      const curIx = cur.year * 12 + cur.month;
      const last3 = reps.filter((x) => { const i = x.year * 12 + x.month; return i <= curIx && i >= curIx - 2; });
      const bodyHtml = isAi ? renderAiChat(r) : riTab === "trends" ? renderTrends(last3) : riTab === "summary" ? renderSummary(cur, last3) : riTab === "actions" ? renderCommentary(cur) : renderTab(riTab, cur.data || {}, cur);
      // Which platforms this month's report holds (added one upload at a time).
      const plat = !isAi && cur ? platformsIn(cur.data) : [];
      const platLine = plat.length ? `<p class="ri-platforms">In this report: <b>${esc(platformList(plat))}</b></p>` : "";
      panel.innerHTML = head + strip + platLine + pendingBar + subtabs + `<div class="ri-body">${bodyHtml}</div>`;
      $("smm-ri-upload")?.addEventListener("click", () => openReportUpload(r));
      $("smm-ri-publish")?.addEventListener("click", () => openPublish(r));
      $("smm-ri-republish")?.addEventListener("click", () => openRepublish(r, cur));
      panel.querySelectorAll("[data-rmonth]").forEach((b) => b.addEventListener("click", () => { riReportId = b.getAttribute("data-rmonth"); renderInsights(r); }));
      panel.querySelectorAll("[data-rtab]").forEach((b) => b.addEventListener("click", () => { riTab = b.getAttribute("data-rtab"); renderInsights(r); }));
      // Day-by-day charts: one at a time, picked from the pills.
      panel.querySelectorAll("[data-ri-pill]").forEach((b) => b.addEventListener("click", () => {
        const i = b.getAttribute("data-ri-pill");
        // Each platform's charts switch on their own (Instagram and Facebook
        // can both have a Day by day on the same tab).
        const scope = b.closest(".ri-platsec") || panel;
        scope.querySelectorAll("[data-ri-pill]").forEach((x) => { const on = x === b; x.classList.toggle("is-active", on); x.setAttribute("aria-selected", on ? "true" : "false"); });
        scope.querySelectorAll("[data-ri-pane]").forEach((x) => { x.hidden = x.getAttribute("data-ri-pane") !== i; });
      }));
      if (isAi) wireAiChat(r);
      if (riTab === "actions" || riTab === "summary") wireCommentary(r, cur);
    }

    /* ---- Client commentary ----
       The words the client reads in their report: "What it means" (the
       summary) and "Into <next month>" (the priorities and what's coming).
       The upload drafts them; the account manager rewrites them here in the
       client's voice (docs/smm-report-rules.md §6) before they go out. The
       Do more / Improve / Fix now marks stay ours — the client never sees
       them. Saved through the same upsert as the upload, whole report at once. */
    const PRIO_TYPES = [["go", "Do more"], ["caution", "Improve"], ["action", "Fix now"]];
    /* Which platform each point is about, when a month covers more than one
       (Danielle, 10 Oct 2026): a pill beside it, and a picker when editing. */
    const PLAT_COL = { instagram: "#c13584", facebook: "#1877f2", linkedin: "#0a66c2", all: "#6e6268" };
    const platPill = (k) => `<span class="ri-pp" style="--pp:${PLAT_COL[k] || "#6e6268"}">${esc(PLATFORM_LABELS[k] || k)}</span>`;
    const platSelect = (d, cur, attr) => {
      const ps = platformsOf(d);
      if (ps.length < 2) return "";
      return `<select ${attr} aria-label="Platform">${[...ps, "all"].map((v) => `<option value="${v}"${v === cur ? " selected" : ""}>${esc(PLATFORM_LABELS[v])}</option>`).join("")}</select>`;
    };

    /* ---- Publish to client ----
       Drafts get a tickbox; live months don't. A live month shows as Live,
       with its own Take down button, so publishing can only ever add to the
       client's hub and taking a month away is always a separate, deliberate
       act. (A tick used to mean "live", so unticking a live month to publish
       another quietly took it down.) Nothing is emailed unless ticked. */
    function openPublish(r) {
      const reps = riSorted(r).slice().reverse();
      const byId = Object.fromEntries(reps.map((x) => [x.id, x]));
      const fmtD = (iso) => new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
      const ready = (x) => { const c = x.data && x.data.client; return !!(c && ((c.insights || []).length || c.summary || (c.priorities || []).length)); };
      const row = (x) => x.published_at
        ? `<div class="ri-pub-row is-live">
            <span class="ri-pub-live" aria-hidden="true"></span>
            <span class="ri-pub-m">${esc(RI_MONTHS[x.month])} ${x.year}<small>${esc(x.platform || "Instagram")}</small></span>
            <span class="ri-pub-s ${hasPending(x) ? "is-pending" : "is-live"}">Live since ${fmtD(x.published_at)}${hasPending(x) ? "<br>Changes not published" : ""}</span>
            <span class="ri-pub-acts">${hasPending(x) ? `<button type="button" class="smm-btn smm-btn--sm smm-btn--primary" data-rep-open="${esc(x.id)}">Republish</button>` : ""}<button type="button" class="smm-btn smm-btn--sm ri-pub-down" data-down="${esc(x.id)}">Take down</button></span>
          </div>`
        : `<label class="ri-pub-row">
            <input type="checkbox" data-pub="${esc(x.id)}">
            <span class="ri-pub-m">${esc(RI_MONTHS[x.month])} ${x.year}<small>${esc(x.platform || "Instagram")}</small></span>
            <span class="ri-pub-s">Draft</span>
            <span class="ri-pub-c ${ready(x) ? "" : "is-warn"}">${ready(x) ? "Client commentary written" : "No client commentary yet: they'd see the team's summary"}</span>
          </label>`;
      const drafts = reps.filter((x) => !x.published_at).length;
      $("smm-modal-host").innerHTML = `
        <div class="smm-modal-scrim" id="smm-modal">
          <div class="smm-modal ri-pub-modal" role="dialog" aria-modal="true" aria-label="Publish to client">
            <h3>Publish to ${esc(nameOf(r))}</h3>
            <p class="smm-modal-sub">${drafts ? "Tick the drafts to publish. Live months stay live." : "Every month is live."} The client sees their six most recent live reports.</p>
            <div class="ri-pub-list" id="ri-pub-list">${reps.map(row).join("")}</div>
            ${drafts ? `<label class="ri-pub-email"><input type="checkbox" id="ri-pub-email" ${r.email ? "" : "disabled"}> <span>${r.email ? `Email ${esc(nameOf(r))} at ${esc(r.email)} that a new report is ready` : "No email address on file, so they'll only see it in their hub"}</span></label>
            <p class="ri-note" style="margin:4px 0 0;">Their hub's bell always shows a new report. You can preview the email in Email → Automated emails.</p>` : ""}
            <p class="smm-modal-status" id="ri-pub-status" hidden></p>
            <div class="smm-modal-actions">
              <button type="button" class="smm-btn" data-mcancel>${drafts ? "Cancel" : "Close"}</button>
              ${drafts ? `<button type="button" class="smm-btn smm-btn--primary" id="ri-pub-save" disabled>Publish</button>` : ""}
            </div>
          </div>
        </div>`;
      const scrim = $("smm-modal"), status = $("ri-pub-status");
      const call = async (ids, action, extra) => {
        if (isDemo(r)) {
          const now = new Date().toISOString();
          ids.forEach((id) => { byId[id].published_at = action === "publish" ? now : null; byId[id].published_data = action === "publish" ? byId[id].data : null; });
          return null;
        }
        const token = await authToken();
        const res = await fetch(`${WORKER}/smm/report/publish`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ ids, action, ...(extra || {}) }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || "Couldn't save");
        (j.reports || []).forEach((x) => { if (byId[x.id]) { byId[x.id].published_at = x.published_at; byId[x.id].published_data = x.published_data || null; } });
        return j.notes || null;
      };
      scrim.addEventListener("click", (e) => { if (e.target === scrim) closeModal(); });
      $("smm-modal-host").querySelector("[data-mcancel]").addEventListener("click", () => { closeModal(); renderInsights(r); });

      // Republish from here too: the banner above the tabs is easy to miss.
      $("ri-pub-list").addEventListener("click", (e) => {
        const b = e.target.closest("[data-rep-open]"); if (!b) return;
        openRepublish(r, byId[b.dataset.repOpen]);
      });
      // Take down: one month, asked about by name, then the list redrawn.
      $("ri-pub-list").addEventListener("click", async (e) => {
        const b = e.target.closest("[data-down]"); if (!b) return;
        const x = byId[b.dataset.down];
        if (!confirm(`Take ${RI_MONTHS[x.month]} ${x.year} out of ${nameOf(r)}'s hub? They won't be able to see it until you publish it again.`)) return;
        b.disabled = true; b.textContent = "Taking down…";
        try { await call([x.id], "unpublish"); openPublish(r); renderInsights(r); }
        catch (err) { status.hidden = false; status.textContent = err.message || "Couldn't take it down — try again."; b.disabled = false; b.textContent = "Take down"; }
      });

      const save = $("ri-pub-save");
      if (!save) return;
      const picked = () => [...document.querySelectorAll("[data-pub]")].filter((b) => b.checked).map((b) => b.dataset.pub);
      document.querySelectorAll("[data-pub]").forEach((b) => b.addEventListener("change", () => {
        const n = picked().length;
        save.disabled = !n;
        save.textContent = n > 1 ? `Publish ${n} months` : "Publish";
      }));
      save.addEventListener("click", async () => {
        const on = picked(); if (!on.length) return;
        save.disabled = true; save.textContent = "Publishing…";
        try {
          const notes = await call(on, "publish", { email: !!$("ri-pub-email")?.checked });
          // Say what reached them, not just that it saved.
          if (notes && (notes.noHub || notes.failed || notes.noEmail)) {
            status.hidden = false; status.style.color = "#6b4d05";
            status.textContent = [
              notes.noHub ? `${nameOf(r)} has no hub account linked, so there's no bell notification.` : "",
              notes.noEmail ? "No email address on file, so no email." : "",
              notes.failed ? "The email didn't send; the report is live anyway." : "",
            ].filter(Boolean).join(" ");
            const done = save.cloneNode(false); done.textContent = "Done"; done.disabled = false;
            done.addEventListener("click", () => { closeModal(); renderInsights(r); });
            save.replaceWith(done);
            renderInsights(r);
            return;
          }
          closeModal(); renderInsights(r);
        } catch (err) { status.hidden = false; status.textContent = err.message || "Couldn't publish — try again."; save.disabled = false; save.textContent = "Publish"; }
      });
    }

    /* ---- Republish ----
       A live report's edits reach the client only from here. Two ways, and
       the choice is the point: a reworded sentence goes quietly; wrong
       figures, or anything the client may already have acted on, go with a
       note telling them the report was amended. */
    function openRepublish(r, cur) {
      const m = `${RI_MONTHS[cur.month]} ${cur.year}`;
      $("smm-modal-host").innerHTML = `
        <div class="smm-modal-scrim" id="smm-modal">
          <div class="smm-modal ri-rep-modal" role="dialog" aria-modal="true" aria-label="Republish">
            <h3>Republish ${esc(m)}</h3>
            <p class="smm-modal-sub">${esc(nameOf(r))} will see the report as it is now. Should they be told it's been amended?</p>
            <button type="button" class="ri-rep-opt" data-rep="quiet"><b>Republish quietly</b><span>For small changes: a reworded sentence, a typo, a tidier title. Nothing they'd act on differently.</span></button>
            <button type="button" class="ri-rep-opt" data-rep="notify"><b>Republish and tell them</b><span>For changes that matter: wrong figures, a plan that's changed, anything they may already have read and relied on. Their report is marked "Updated" with today's date, their hub's bell says so, and they're emailed that it's been amended.</span></button>
            <p class="smm-modal-status" id="ri-rep-status" hidden></p>
            <div class="smm-modal-actions"><button type="button" class="smm-btn" data-mcancel>Cancel</button></div>
          </div>
        </div>`;
      const scrim = $("smm-modal");
      scrim.addEventListener("click", (e) => { if (e.target === scrim) closeModal(); });
      $("smm-modal-host").querySelector("[data-mcancel]").addEventListener("click", closeModal);
      document.querySelectorAll("[data-rep]").forEach((b) => b.addEventListener("click", async () => {
        const notify = b.dataset.rep === "notify", status = $("ri-rep-status");
        document.querySelectorAll("[data-rep]").forEach((x) => { x.disabled = true; });
        b.querySelector("b").textContent = "Republishing…";
        try {
          if (isDemo(r)) {
            const now = new Date().toISOString();
            Object.assign(cur, { published_data: cur.data, amended_at: now }, notify ? { amendment_notice_at: now } : {});
          } else {
            const token = await authToken();
            const res = await fetch(`${WORKER}/smm/report/publish`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ ids: [cur.id], action: "republish", notify }) });
            const j = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(j.error || "Couldn't republish");
            const x = (j.reports || [])[0];
            if (x) Object.assign(cur, { published_data: x.published_data, amended_at: x.amended_at, amendment_notice_at: x.amendment_notice_at });
          }
          closeModal(); renderInsights(r);
        } catch (e) { status.hidden = false; status.textContent = e.message || "Couldn't republish — try again."; document.querySelectorAll("[data-rep]").forEach((x) => { x.disabled = false; }); }
      }));
    }

    /* ---- Summary: the team's own read of the month (read-only) ----
       What the upload wrote for us, in our voice: what it means, what we
       plan into next month with the Do more / Improve / Fix now marks, and
       the trend across the last three months. Never shown to the client —
       the Client commentary tab is that. */
    /* The team's notes as points under platform pills (pointBlocks). Text
       written before points keeps its paragraphs. */
    function pointsHtml(text, pills) {
      return pointBlocks(text).map((b) => `<div class="ri-cm-platblock">${pills && b.platform ? platPill(b.platform) : ""}${b.prose.map((x) => `<div class="ri-cm-prose">${esc(x)}</div>`).join("")}${b.points.length ? `<ul class="ri-points">${b.points.map((x) => `<li>${esc(x)}</li>`).join("")}</ul>` : ""}</div>`).join("");
    }
    function renderSummary(cur, last3) {
      const d = cur.data || {};
      const next = RI_MONTHS[(cur.month + 1) % 12];
      const prios = (d.priorities || []).filter((p) => p && p.text);
      const label = (t) => (PRIO_TYPES.find(([v]) => v === (t || "go")) || PRIO_TYPES[0]);
      // Each card can be rewritten by hand: the account manager knows things
      // the figures don't (Danielle, Sep 2026), and this is what the
      // management report prints.
      const pen = (key, title) => `<button type="button" class="ri-cm-edit" data-sm-edit="${key}" title="Edit ${esc(title)}" aria-label="Edit ${esc(title)}">${PENCIL_SVG}</button>`;
      const card = (title, sub, body, action, key) => `<div class="ri-panel ri-cm-card"><div class="ri-cm-head"><div><div class="ri-card-h" style="margin:0;">${esc(title)}</div><p class="ri-note" style="margin:3px 0 0;">${esc(sub)}</p></div><div style="display:flex;gap:8px;align-items:center">${action || ""}${key ? pen(key, title) : ""}</div></div><div class="ri-cm-body">${body}</div></div>`;
      const trendBody = last3.length < 2
        ? `<p class="ri-cm-empty">Appears once there's a month before this one to compare with.</p>`
        : d.trendSummary ? pointsHtml(d.trendSummary, true)
        : `<p class="ri-cm-empty">Not written yet.</p>`;
      const trendAct = last3.length >= 2 ? `<button type="button" class="smm-btn smm-btn--sm" data-cm-draft="trends">${d.trendSummary ? "Rewrite" : "Write it"}</button>` : "";
      return `<div class="ri-cm">
        <p class="ri-note">Our own read of ${esc(RI_MONTHS[cur.month])}, for the team. The client never sees this page; what they read is on Client commentary.</p>
        ${card("What it means", "Everything the month's figures say, good and bad, and anything behind them the figures can't show.",
          platformsOf(d).length > 1
            ? platformsOf(d).map((k) => { const t = k === "instagram" ? d.summary : (d[k] || {}).summary; return `<div class="ri-cm-platblock">${platPill(k)}${t ? pointsHtml(t, false) : `<p class="ri-cm-empty">Nothing written yet.</p>`}</div>`; }).join("")
            : d.summary ? pointsHtml(d.summary, false) : `<p class="ri-cm-empty">Nothing written yet.</p>`, "", "summary")}
        ${card(`Into ${next}`, "What we plan to do, and how we see each one.", prios.length ? `<ul class="ri-cm-list">${prios.map((p) => { const [v, l] = label(p.type); return `<li>${platformsOf(d).length > 1 ? platPill(itemPlatform(p, d)) : ""}<span class="ri-cm-mark is-${v}">${l}</span><span>${p.title ? `<b class="ri-cm-t">${esc(p.title)}</b>` : ""}${esc(p.text)}</span></li>`; }).join("")}</ul>` : `<p class="ri-cm-empty">No plan written yet.</p>`, "", "priorities")}
        ${(() => {
          /* Goals: the team's own, free text, a row per goal (Danielle, 19
             Oct 2026). For the management report; the client never sees them. */
          const goals = (d.goals || []).filter((g) => g && (g.goal || g.measure));
          const multi = platformsOf(d).length > 1;
          return card("Goals", "What we're aiming for on each platform, and how we'll measure it. In the management report; never shown to the client.",
            goals.length ? `<table class="ri-tbl ri-goals"><thead><tr>${multi ? "<th>Platform</th>" : ""}<th>Goal</th><th>Measurement</th></tr></thead><tbody>${goals.map((g) => `<tr>${multi ? `<td>${platPill(itemPlatform(g, d))}</td>` : ""}<td>${esc(g.goal || "")}</td><td>${esc(g.measure || "")}</td></tr>`).join("")}</tbody></table>`
              : `<p class="ri-cm-empty">No goals yet. Add what you're aiming for, such as "Grow followers" measured as "1,200 by the end of December".</p>`, "", "goals");
        })()}
        ${card(`Trends · ${last3.length > 1 ? `${RI_MONTHS[last3[0].month]} to ${RI_MONTHS[last3[last3.length - 1].month]}` : "last three months"}`, "What's moving across up to three months. No further back: social changes too fast.", trendBody, trendAct, last3.length >= 2 ? "trends" : "")}
        <p class="smm-modal-status" id="ri-cm-status" hidden></p>
      </div>`;
    }

    /* ---- Client commentary: what the client reads, drafted for us ----
       Drafted in the account manager's voice (docs/smm-report-rules.md §10)
       from this month and up to two before it, then rewritten here. Reads as
       the finished words; each card has an edit button that opens a pop-out. */
    function renderCommentary(cur) {
      const d = cur.data || {}, c = d.client || null;
      const next = RI_MONTHS[(cur.month + 1) % 12];
      const coming = (d.comingSoon || []).filter(Boolean);
      const card = (key, title, sub, body) => `<div class="ri-panel ri-cm-card">
          <div class="ri-cm-head"><div><div class="ri-card-h" style="margin:0;">${esc(title)}</div><p class="ri-note" style="margin:3px 0 0;">${esc(sub)}</p></div>
          <button type="button" class="ri-cm-edit" data-cm-edit="${key}" title="Edit ${esc(title)}" aria-label="Edit ${esc(title)}">${PENCIL_SVG}</button></div>
          <div class="ri-cm-body">${body}</div></div>`;
      const top = `<div class="ri-cm-top"><p class="ri-note" style="margin:0;">What ${esc(RI_MONTHS[cur.month])}'s report says to the client. ${c && c.draftedAt ? "Drafted for you to rewrite; the numbers aren't edited here." : ""}</p>
        <button type="button" class="smm-btn smm-btn--sm" data-cm-draft="client">${c ? "Redraft" : "Draft it"}</button></div>`;
      if (!c) return `<div class="ri-cm">${top}<div class="ri-panel"><p class="ri-cm-empty" style="margin:0;">No client commentary yet. Draft it and we'll write a first version from this month and the two before it, in the client's voice, for you to rewrite.</p></div><p class="smm-modal-status" id="ri-cm-status" hidden></p></div>`;
      const prios = (c.priorities || []).filter((p) => p && p.text);
      return `<div class="ri-cm">${top}
        ${card("insights", "What it means", "Four headline figures, then two to four insights: as many as the month genuinely has.",
          `<p class="ri-cm-heads">${(((c.headline || []).length ? c.headline : defaultHeadline(d)).map((k) => { const m = HEADLINE_METRICS[k] || {}; return esc((platformsOf(d).length > 1 && m.platform ? `${PLATFORM_LABELS[m.platform]}: ` : "") + (m.label || k)); })).join(" · ")}</p>`
          + ((c.insights || []).length
            ? `<div class="ri-cm-ins">${c.insights.map(normaliseInsight).filter(Boolean).map((i) => `<div class="ri-cm-in"><span class="ri-cm-in-k">${platformsOf(d).length > 1 ? platPill(itemPlatform(i, d)) : ""}${esc(INSIGHT_CATEGORIES[i.category])}${i.confidence === "emerging" ? " · Early signal" : ""}</span><b>${esc(i.headline)}</b><p>${esc(i.analysis)}</p>${i.evidence.length ? `<p class="ri-cm-in-next">${i.evidence.map(esc).join(" · ")}</p>` : ""}</div>`).join("")}</div>`
            : c.summary ? `<div class="ri-cm-prose">${esc(c.summary)}</div><p class="ri-note" style="margin:10px 0 0;">Written before insights existed. Redraft to get insight cards.</p>` : `<p class="ri-cm-empty">Nothing written yet.</p>`))}
        ${card("next", `Into ${next}`, "A card each: what we'll do, and why.",
          (prios.length ? `<ul class="ri-cm-list ri-cm-list--client">${prios.map((p) => `<li>${platformsOf(d).length > 1 ? platPill(itemPlatform(p, d)) : ""}<span>${p.title ? `<b class="ri-cm-t">${esc(p.title)}</b>` : ""}${esc(p.text)}</span></li>`).join("")}</ul>` : `<p class="ri-cm-empty">No lines yet.</p>`))}
        ${card("coming", "Content coming up", `About six pieces of content planned for ${next}, and the content plan as a PDF if there is one. The client sees both under Into ${next}.`,
          (coming.length ? `<ol class="ri-cm-coming">${coming.map((x) => `<li>${esc(x)}</li>`).join("")}</ol>` : `<p class="ri-cm-empty">Nothing planned yet.</p>`)
          + (d.contentPlan && d.contentPlan.doc_id ? `<p class="ri-cm-plan">Content plan: <b>${esc(d.contentPlan.file_name || "PDF")}</b></p>` : ""))}
        <p class="smm-modal-status" id="ri-cm-status" hidden></p>
      </div>`;
    }
    // A patch to the client's words lands inside data.client; Content coming
    // up stays at the top level, where the upload puts it.
    async function saveCommentary(r, cur, patch) {
      const data = { ...(cur.data || {}) };
      if (patch.client) data.client = { ...(data.client || {}), ...patch.client };
      if (patch.comingSoon) data.comingSoon = patch.comingSoon;
      if ("contentPlan" in patch) { if (patch.contentPlan) data.contentPlan = patch.contentPlan; else delete data.contentPlan; }
      if (patch.team) Object.assign(data, patch.team);
      if (!isDemo(r)) {
        const token = await authToken();
        const res = await fetch(`${WORKER}/smm/report`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id, platform: cur.platform || "Instagram", month: cur.month, year: cur.year, data }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || "Couldn't save");
      }
      cur.data = data;
    }
    async function draftCommentary(r, cur, only) {
      if (isDemo(r)) throw new Error("Drafting runs on real clients only.");
      const token = await authToken();
      const res = await fetch(`${WORKER}/smm/report/draft`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ id: cur.id, only }) });
      const j = await res.json().catch(() => ({}));
      if (!res.ok || !j.data) throw new Error(j.error || "Couldn't draft it — try again.");
      cur.data = j.data;
    }
    function wireCommentary(r, cur) {
      document.querySelectorAll("[data-cm-edit]").forEach((b) => b.addEventListener("click", () => openCommentaryEdit(r, cur, b.getAttribute("data-cm-edit"))));
      document.querySelectorAll("[data-sm-edit]").forEach((b) => b.addEventListener("click", () => openSummaryEdit(r, cur, b.getAttribute("data-sm-edit"))));
      document.querySelectorAll("[data-cm-draft]").forEach((b) => b.addEventListener("click", async () => {
        const only = b.getAttribute("data-cm-draft");
        const has = only === "client" ? !!(cur.data && cur.data.client) : !!(cur.data && cur.data.trendSummary);
        if (has && !confirm(only === "client" ? "Redraft the client commentary? This replaces what's there, including your edits." : "Rewrite the trends summary?")) return;
        const status = $("ri-cm-status"), label = b.textContent;
        b.disabled = true; b.textContent = "Writing…";
        try { await draftCommentary(r, cur, only); renderInsights(r); }
        catch (e) { if (status) { status.hidden = false; status.textContent = e.message; } b.disabled = false; b.textContent = label; }
      }));
    }
    function openCommentaryEdit(r, cur, which) {
      const d = { ...(cur.data || {}), ...((cur.data || {}).client ? { summary: cur.data.client.summary, priorities: cur.data.client.priorities } : { summary: "", priorities: [] }) };
      const next = RI_MONTHS[(cur.month + 1) % 12];
      const prioRow = (p = {}) => `<div class="ri-cm-row" data-cm-prio>
          ${platSelect(cur.data, itemPlatform(p, cur.data), "data-cm-plat")}
          <select data-cm-type aria-label="How we see it">${PRIO_TYPES.map(([v, l]) => `<option value="${v}"${(p.type || "go") === v ? " selected" : ""}>${l}</option>`).join("")}</select>
          <div class="ri-cm-stack"><input type="text" data-cm-title value="${esc(p.title || "")}" placeholder="A short title, e.g. More reels" maxlength="40">
          <textarea rows="2" data-cm-text placeholder="What we're doing, in words the client will read. Two lines is about right.">${esc(p.text || "")}</textarea></div>
          <button type="button" class="ri-cm-x" data-cm-del aria-label="Remove">&times;</button></div>`;
      const comingRow = (c = "") => `<div class="ri-cm-row ri-cm-row--plain" data-cm-coming>
          <input type="text" data-cm-text value="${esc(c)}" placeholder="A piece of content on the way">
          <button type="button" class="ri-cm-x" data-cm-del aria-label="Remove">&times;</button></div>`;
      const insRow = (raw = {}) => { const i = normaliseInsight(raw) || { category: "working", headline: "", analysis: "", evidence: [], confidence: "strong" }; return `<div class="ri-cm-insrow" data-cm-ins>
          <div class="ri-cm-insrow-top">${platSelect(cur.data, itemPlatform(raw, cur.data), 'data-in-plat')}<select data-in="category" aria-label="Kind">${Object.entries(INSIGHT_CATEGORIES).map(([v, l]) => `<option value="${v}"${i.category === v ? " selected" : ""}>${l}</option>`).join("")}</select>
          <input type="text" data-in="headline" value="${esc(i.headline)}" placeholder="Headline, 7 words at most" maxlength="60">
          <select data-in="confidence" aria-label="Confidence"><option value="strong"${i.confidence === "strong" ? " selected" : ""}>Strong</option><option value="emerging"${i.confidence === "emerging" ? " selected" : ""}>Early signal</option></select>
          <button type="button" class="ri-cm-x" data-cm-del aria-label="Remove">&times;</button></div>
          <textarea rows="3" data-in="analysis" placeholder="What we're seeing, what it means for them, what we'll do. 40 words at most.">${esc(i.analysis)}</textarea>
          <input type="text" data-in="evidence" value="${esc(i.evidence.join(" · "))}" placeholder="The figures behind it, separated by · e.g. Reels 15.34% interaction rate · Posts 7.74%">
        </div>`; };
      const cl0 = (cur.data && cur.data.client) || {};
      const heads = ((cl0.headline || []).length ? cl0.headline : defaultHeadline(cur.data)).slice(0, 4);
      /* Several platforms: each figure can be one platform's or all of them
         added together, grouped by platform (Danielle, 19 Oct 2026). */
      const opts = headlineOptions(cur.data);
      const groupsOf = ["all", "instagram", "facebook", "linkedin"].filter((g) => opts.some((o) => o.platform === g));
      const onePlat = groupsOf.length === 1 ? groupsOf[0] : null;
      const optHtml = (sel) => groupsOf.length > 1
        ? groupsOf.map((g) => `<optgroup label="${esc(PLATFORM_LABELS[g])}">${opts.filter((o) => o.platform === g).map((o) => `<option value="${o.key}"${sel === o.key ? " selected" : ""}>${esc(o.label)}</option>`).join("")}</optgroup>`).join("")
        : opts.map((o) => `<option value="${o.key}"${sel === o.key ? " selected" : ""}>${esc(o.label)}</option>`).join("");
      /* Several platforms: two boxes per figure (Danielle, 22 Oct 2026): which
         platform (or all of them added together), then which figure. */
      const platOf = (key) => (opts.find((o) => o.key === key) || {}).platform || groupsOf[0];
      const metricOpts = (plat, sel) => opts.filter((o) => o.platform === plat).map((o) => `<option value="${o.key}"${sel === o.key ? " selected" : ""}>${esc(o.label)}</option>`).join("");
      const slot = (n) => groupsOf.length > 1
        ? `<div class="ri-cm-headslot"><select data-headplat="${n}" aria-label="Platform">${groupsOf.map((g) => `<option value="${g}"${platOf(heads[n]) === g ? " selected" : ""}>${esc(PLATFORM_LABELS[g])}</option>`).join("")}</select><select data-head="${n}" aria-label="Figure">${metricOpts(platOf(heads[n]), heads[n])}</select></div>`
        : `<select data-head="${n}">${optHtml(heads[n])}</select>`;
      const headPick = `<div class="smm-modal-field"><label>The four headline figures</label><div class="ri-cm-headpick">${[0, 1, 2, 3].map(slot).join("")}</div><p class="smm-hint">Pick the four that explain this month${groupsOf.length > 1 ? ": a platform's own figure, or all platforms added together. The label tells the client which" : ""}. The numbers are worked out from the report.${onePlat ? ` This month's report only has ${esc(PLATFORM_LABELS[onePlat])}: upload another platform's SocialPilot PDF into ${esc(RI_MONTHS[cur.month])} and its figures, and all platforms added together, appear here, with a platform for each insight.` : ""}</p></div>`;
      const body = which === "insights"
        ? `${headPick}<div class="smm-modal-field"><label>Insights</label><div id="ri-cm-ins">${(cl0.insights || []).map(insRow).join("")}</div>
           <button type="button" class="smm-btn smm-btn--sm" id="ri-cm-add-ins">${PLUS_SVG}Add an insight</button></div>`
        : which === "summary"
        ? `<div class="smm-modal-field"><label for="ri-cm-summary">What it means</label><textarea id="ri-cm-summary" rows="9">${esc(d.summary || "")}</textarea></div>`
        : `<div class="smm-modal-field"><label>Into ${esc(next)}</label><div id="ri-cm-prios">${(d.priorities || []).filter((p) => p && p.text).map(prioRow).join("")}</div>
             <button type="button" class="smm-btn smm-btn--sm" id="ri-cm-add-prio">${PLUS_SVG}Add a line</button></div>`;
      // Content coming up: its own card (Danielle, 19 Oct 2026). Six rows to
      // start, and the content plan as a PDF if there is one.
      const comingNow = (d.comingSoon || []).filter(Boolean);
      const plan = d.contentPlan && d.contentPlan.doc_id ? d.contentPlan : null;
      const comingBody = `<div class="smm-modal-field"><label>Content coming up</label><div id="ri-cm-coming">${[...comingNow, ...Array(Math.max(0, 6 - comingNow.length)).fill("")].map(comingRow).join("")}</div>
             <button type="button" class="smm-btn smm-btn--sm" id="ri-cm-add-coming">${PLUS_SVG}Add content</button></div>
           <div class="smm-modal-field"><label>Content plan (PDF, optional)</label>
             ${plan ? `<p class="ri-cm-plan" id="ri-cm-plan-now">Now: <b>${esc(plan.file_name || "PDF")}</b> <button type="button" class="ri-cm-x" id="ri-cm-plan-del" aria-label="Remove the plan" title="Remove">&times;</button></p>` : ""}
             <input type="file" id="ri-cm-plan-file" class="smm-file-input" accept="application/pdf,.pdf">
             <p class="smm-hint">If there's a content plan for ${esc(next)}, upload it here: the client can open it from their report. It's kept in their Files too.</p></div>`;
      $("smm-modal-host").innerHTML = `
        <div class="smm-modal-scrim" id="smm-modal">
          <div class="smm-modal ri-cm-modal" role="dialog" aria-modal="true" aria-label="Edit commentary">
            <h3>${which === "summary" || which === "insights" ? "What it means" : which === "coming" ? "Content coming up" : `Into ${esc(next)}`}</h3>
            <p class="smm-modal-sub">${which === "coming" ? `About six pieces of content planned for ${esc(next)}, a line each. The client sees them under Into ${esc(next)}.` : which === "insights" ? "Two to four insights, only as many as the month genuinely has. Each: a short headline, what it means for them and what we'll do, and the figures behind it. Never claim a change caused a result, and never compare figures counted differently." : which === "summary" ? "Tell them the story of the month: what moved, what we did that led to it, and what we're doing about anything that didn't. Plain English, no jargon." : `Each one is a card in the client's report: a short title, then what we'll do and why ("Into ${esc(next)} we'll… That's because…"). The mark is for us; the client never sees it.`}</p>
            ${which === "coming" ? comingBody : body}
            <p class="smm-modal-status" id="ri-cm-status" hidden></p>
            <div class="smm-modal-actions">
              <button type="button" class="smm-btn" data-mcancel>Cancel</button>
              <button type="button" class="smm-btn smm-btn--primary" id="ri-cm-save">Save</button>
            </div>
          </div>
        </div>`;
      const host = $("smm-modal-host"), scrim = $("smm-modal");
      scrim.addEventListener("click", (e) => { if (e.target === scrim) closeModal(); });
      host.querySelector("[data-mcancel]").addEventListener("click", closeModal);
      // A figure's platform changed: its figures are that platform's, keeping
      // the same kind where there is one (Reach stays a reach).
      host.querySelectorAll("[data-headplat]").forEach((ps) => ps.addEventListener("change", () => {
        const n = ps.dataset.headplat, m = host.querySelector(`[data-head="${n}"]`);
        const was = (m.options[m.selectedIndex] || {}).text ? m.options[m.selectedIndex].text.toLowerCase() : "";
