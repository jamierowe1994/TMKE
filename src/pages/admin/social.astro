      const clientName = nameOf(r) === "—" ? (r.business || "") : nameOf(r);
      panel.innerHTML = `
        <div class="smm-panel-head"><h4>Invoicing</h4></div>
        ${r.direct_debit ? `<div class="siv-dd-banner">💳 <span><strong>Direct Debit client${r.direct_debit_day ? ` — collected on the ${r.direct_debit_day}${ordinal(r.direct_debit_day)}` : ""}.</strong> Invoices are raised to your accounts team as reminders (not emailed to the customer), then you mark them paid.</span></div>` : ""}
        ${warn ? `<p class="smm-soon" style="margin-bottom:12px">${esc(warn)}</p>` : ""}
        ${r.direct_debit ? `
        <div class="siv-dd-recip">
          <label class="siv-f"><span>Ghost invoices sent to</span><input id="dd-recip" value="${esc(r.dd_invoice_email || "danielle@tmke.co.uk")}" placeholder="accounts@…"></label>
          <p class="smm-hint" id="dd-recip-status" style="min-height:15px"></p>
          <p class="smm-hint">Invoices auto-raise on the <strong>1st of each month</strong> — line "Social media management (month)", amount from <strong>Pricing</strong>, due on their DD date — and are emailed here as a reminder. Mark each paid once the Direct Debit clears.</p>
        </div>` : `
        <div class="siv-build">
          <div class="siv-tpl">
            <span class="siv-tpl-lbl">Template</span>
            <div class="siv-tpl-opts" id="siv-tpl">
              <button type="button" class="siv-tpl-opt" data-tpl="minimal">Minimal</button>
              <button type="button" class="siv-tpl-opt" data-tpl="banded">Banded</button>
            </div>
          </div>
          <div class="siv-tpl">
            <span class="siv-tpl-lbl">Card payment</span>
            <div class="siv-tpl-opts" id="siv-pay">
              <button type="button" class="siv-tpl-opt" data-pay="no">Off</button>
              <button type="button" class="siv-tpl-opt" data-pay="yes">On</button>
            </div>
            <span class="siv-pay-hint">Adds a &ldquo;Pay by card&rdquo; button to the email. Bank details stay on the invoice either way.</span>
          </div>
          <div class="siv-grid2">
            <label class="siv-f"><span>Bill to</span><input id="siv-name" value="${esc(billName)}"></label>
            <label class="siv-f"><span>Email</span><input id="siv-email" type="email" value="${esc(r.email || "")}"></label>
          </div>
          <label class="siv-f"><span>Client <small style="font-weight:400;opacity:.7">only when billing another brand - blank leaves it off the invoice</small></span><input id="siv-client" value="${esc(r.inter_brand_invoice ? clientName : "")}" placeholder="Who the work was for, if different"></label>
          <label class="siv-f"><span>Billing address</span><textarea id="siv-address" rows="2" placeholder="Optional">${esc(r.business_address || "")}</textarea></label>
          <label class="siv-f"><span>CC</span><input id="siv-cc" value="${esc(invSettings.accounts_cc_email || "")}" placeholder="Accounts, comma-separated"></label>
          <div class="siv-grid2">
            <label class="siv-f"><span>Issued</span><input id="siv-issued" type="date" value="${today}"></label>
            <label class="siv-f"><span>Due</span><input id="siv-due" type="date" value="${dueISO}"></label>
          </div>
          <div class="siv-f"><span>Line items</span><div id="siv-items"></div><button type="button" class="smm-btn smm-btn--sm" id="siv-add">${PLUS_SVG}Add line</button></div>
          <div class="siv-totals" id="siv-totals"></div>
          <label class="siv-f"><span>Notes (optional)</span><textarea id="siv-notes" rows="2" placeholder="e.g. Thank you for your business.">Thank you for your business - TMKE</textarea></label>
          <p class="smm-modal-status" id="siv-msg" hidden></p>
          <div class="siv-actions">
            <button type="button" class="smm-btn" id="siv-pdf">Preview / PDF</button>
            <button type="button" class="smm-btn" id="siv-create">Save draft</button>
            <button type="button" class="smm-btn smm-btn--primary" id="siv-send">Create &amp; send</button>
          </div>
        </div>`}
        <div class="siv-list-head">Raised invoices</div>
        <div id="siv-list"><p class="smm-soon">Loading…</p></div>
        ${uploaded.length ? `<div class="siv-list-head">Uploaded PDFs</div>${uploaded.map((d) => `<div class="smm-inv"><div class="smm-inv-top"><span class="smm-doc-ico">${DOC_SVG}</span><span class="smm-doc-main"><span class="smm-doc-name">${esc(d.title || d.file_name)}</span><span class="smm-doc-cat">Sent ${fmtDate(d.invoice_date)}</span></span><span class="smm-inv-status ${d.paid_date ? "is-paid" : "is-due"}">${d.paid_date ? "Paid" : "Outstanding"}</span></div><div class="smm-inv-foot"><label class="smm-inv-paid">Paid <input type="date" data-invpaid="${esc(d.id)}" value="${esc(d.paid_date || "")}"></label><span class="smm-doc-tools"><button type="button" class="smm-mini" data-docdl="${esc(d.id)}" data-docname="${esc(d.file_name || "invoice")}">Download</button><button type="button" class="smm-mini is-danger" data-docdel="${esc(d.id)}">Remove</button></span></div></div>`).join("")}` : ""}`;
      if (r.direct_debit) {
        // DD client — no manual builder. Save the ghost-invoice recipient, and
