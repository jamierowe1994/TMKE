        else if (thisInv) items.push(li(thisInv.status === "paid" || !(thisInv.due_date && thisInv.due_date < sfToday()), `${RI_MONTHS[now.getMonth()]} invoice ${esc(thisInv.number || "")}: ${thisInv.status === "paid" ? "paid " + esc(sfDay(thisInv.paid_date)) : thisInv.due_date && thisInv.due_date < sfToday() ? "overdue since " + esc(sfDay(thisInv.due_date)) : "sent" + (thisInv.due_date ? ", due " + esc(sfDay(thisInv.due_date)) : "")}`));
