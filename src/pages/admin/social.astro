---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
---

<AdminShell active="social" title="Social media">
  <div class="ash-panel ash-page">
    <section class="smm-bar">
      <div class="smm-bar-top">
        <div class="smm-filters" id="smm-filters" role="tablist">
          <button type="button" class="smm-chip is-active" data-filter="all">All</button>
          <button type="button" class="smm-chip" data-filter="enquiry">Enquiries</button>
          <button type="button" class="smm-chip" data-filter="brochure">Brochures</button>
          <button type="button" class="smm-chip" data-filter="meeting_set">Discovery calls</button>
          <button type="button" class="smm-chip" data-filter="proposal_sent">Proposals</button>
          <button type="button" class="smm-chip" data-filter="contract_signed">Contracts</button>
          <button type="button" class="smm-chip" data-filter="onboarding">Onboarding clients</button>
          <button type="button" class="smm-chip" data-filter="active_client">Clients</button>
        </div>
        <div class="smm-bar-actions">
          <label class="smm-lost-toggle"><input type="checkbox" id="smm-show-lost" /> Show lost</label>
          <button type="button" class="smm-add-btn" id="smm-add-lead"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>Add</button>
        </div>
      </div>
      <div class="smm-bar-bottom">
        <label class="smm-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="smm-search" placeholder="Search name, email, business…" aria-label="Search leads" />
        </label>
      </div>
    </section>

    <p class="smm-loading" id="smm-loading">Loading pipeline…</p>
    <div class="smm-scrolltop" id="smm-scrolltop" hidden><div id="smm-scrolltop-inner"></div></div>
    <div class="smm-board" id="smm-board" hidden></div>
  </div>

  <!-- Full-screen customer file -->
  <div class="smm-file-scrim" id="smm-file" hidden>
    <div class="smm-file-card" role="dialog" aria-modal="true" aria-label="Customer file">
      <button type="button" class="smm-file-x" id="smm-file-close" aria-label="Close">&times;</button>
      <div class="smm-file-body" id="smm-file-body"></div>
    </div>
  </div>

  <!-- Modal host (meeting booking / add file) -->
  <div id="smm-modal-host"></div>

  <style is:global>
    /* ---- Toolbar ---- */
    .smm-bar { display: flex; flex-direction: column; gap: 12px; max-width: 1440px; margin: 0 auto; padding: 34px 36px 20px; }
    .smm-bar-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
    .smm-bar-actions { display: flex; align-items: center; gap: 12px; flex: none; }
    .smm-filters { display: flex; gap: 6px; flex-wrap: wrap; flex: 1; min-width: 0; }
    .smm-chip { height: 34px; box-sizing: border-box; display: inline-flex; align-items: center; padding: 0 14px; background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 999px; font-family: var(--sans); font-size: 12px; font-weight: 600; color: rgba(28,29,34,0.7); cursor: pointer; transition: background .15s, border-color .15s, color .15s; }
    .smm-chip:hover { border-color: rgba(var(--violet-rgb),0.4); }
    .smm-chip.is-active { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .smm-search { height: 34px; box-sizing: border-box; display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 999px; padding: 0 14px; width: 340px; max-width: 100%; }
    .smm-search svg { width: 15px; height: 15px; color: rgba(28,29,34,0.42); flex: none; }
    .smm-search input { border: 0; outline: none; background: none; width: 100%; font-family: var(--sans); font-size: 13px; color: var(--ink); }
    .smm-lost-toggle { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); display: inline-flex; align-items: center; gap: 7px; cursor: pointer; white-space: nowrap; }
    .smm-loading { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); padding: 40px 36px; max-width: 1440px; margin: 0 auto; }

    /* ---- Pipeline board — comfortable columns, scroll along the bottom ---- */
    /* A synced scrollbar above the board so you don't have to scroll down a
       laptop screen to reach the native one. */
    .smm-scrolltop { max-width: 1440px; margin: 14px auto 6px; padding: 0 36px; overflow-x: auto; overflow-y: hidden; }
    .smm-scrolltop[hidden] { display: none; }
    #smm-scrolltop-inner { height: 1px; }
    .smm-board { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(300px, 1fr); gap: 14px; align-items: start; max-width: 1440px; margin: 0 auto; padding: 6px 36px 120px; overflow-x: auto; }
    /* Filter active → a single-column line view instead of the board. */
    .smm-board.is-list { display: block; overflow-x: visible; }
    .smm-list { max-width: 1000px; margin: 0 auto; display: flex; flex-direction: column; gap: 8px; }
    .smm-list-head { font-family: var(--sans); font-size: 11.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin: 2px 0 12px; }
    .smm-row { display: grid; grid-template-columns: 88px minmax(140px, 1.2fr) minmax(150px, 1.3fr) 118px auto; gap: 16px; align-items: center; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 12px 16px; cursor: pointer; transition: border-color .15s, box-shadow .15s; }
    .smm-row:hover { border-color: rgba(var(--violet-rgb),0.45); box-shadow: 0 8px 20px -16px rgba(28,29,34,0.4); }
    .smm-row-main { min-width: 0; }
    .smm-row-name { font-family: var(--sans); font-size: 14.5px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smm-row-biz { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-top: 1px; }
    .smm-row-email { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smm-row-stage { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.5); background: rgba(28,29,34,0.05); border-radius: 999px; padding: 4px 10px; text-align: center; white-space: nowrap; }
    .smm-row-acts { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    @media (max-width: 760px) { .smm-row { grid-template-columns: 1fr auto; } .smm-row-email, .smm-row-stage { display: none; } }
    .smm-col { background: transparent; min-width: 0; }
    .smm-col-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 0 4px 12px; }
    .smm-col-name { font-family: var(--sans); font-size: 11.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .smm-col-count { font-family: var(--sans); font-size: 11px; font-weight: 700; color: rgba(28,29,34,0.5); background: rgba(28,29,34,0.06); border-radius: 999px; padding: 1px 8px; }
    .smm-col-body { display: flex; flex-direction: column; gap: 10px; min-height: 120px; padding: 4px; border-radius: 12px; transition: background .15s, box-shadow .15s; }
    .smm-col-body.drop-hover { background: rgba(var(--violet-rgb),0.07); box-shadow: inset 0 0 0 2px rgba(var(--violet-rgb),0.35); }
    .smm-col-empty { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.32); padding: 14px 6px; }
    .smm-card { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 15px 16px; cursor: pointer; transition: border-color .16s, transform .16s, box-shadow .16s; }
    .smm-card:hover { border-color: rgba(var(--violet-rgb),0.45); transform: translateY(-1px); box-shadow: 0 10px 24px -18px rgba(28,29,34,0.4); }
    .smm-card.dragging { opacity: .45; }
    .smm-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 8px; }
    .smm-kind { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-kind.is-discovery { background: rgba(47,158,94,0.12); color: #2c7a4b; }
    .smm-kind.is-brochure { background: rgba(227,160,8,0.14); color: #9a6a04; }
    .smm-kind.is-package { background: var(--english-violet); color: #fff; }
    .smm-add-btn { height: 34px; box-sizing: border-box; display: inline-flex; align-items: center; gap: 6px; padding: 0 16px; background: var(--english-violet); border: 1px solid var(--english-violet); border-radius: 999px; font-family: var(--sans); font-size: 12.5px; font-weight: 700; color: #fff; cursor: pointer; transition: background .15s; white-space: nowrap; }
    .smm-add-btn:hover { background: var(--ink); border-color: var(--ink); }
    .smm-add-btn svg { width: 14px; height: 14px; }
    .smm-card-when { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.42); }
    .smm-card-name { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); }
    .smm-card-biz { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); margin-top: 2px; }
    .smm-card-line { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.5); margin-top: 8px; display: flex; align-items: center; gap: 6px; min-width: 0; }
    .smm-card-line svg { width: 13px; height: 13px; flex: none; color: rgba(28,29,34,0.4); }
    .smm-card-line-t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
    .smm-card-meta { font-family: var(--sans); font-size: 11.5px; color: var(--english-violet); margin-top: 8px; display: inline-flex; align-items: center; gap: 5px; }
    .smm-card-meta svg { width: 12px; height: 12px; }
    .smm-card-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 12px; }
    .smm-card-acts { display: flex; flex-wrap: wrap; gap: 6px; }
    .smm-card-act { font-family: var(--sans); font-size: 11px; font-weight: 700; color: var(--english-violet); background: rgba(var(--violet-rgb),0.08); border: 0; border-radius: 6px; padding: 5px 10px; cursor: pointer; transition: background .15s; }
    .smm-card-act:hover { background: rgba(var(--violet-rgb),0.18); }
    .smm-card-status { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; flex: none; }

    /* ---- Full-screen customer file ---- */
    .smm-file-scrim { position: fixed; inset: 0; z-index: 200; background: rgba(20,18,26,0.5); display: flex; align-items: stretch; justify-content: center; padding: 28px; }
    .smm-file-scrim[hidden] { display: none; }
    .smm-file-card { position: relative; width: min(1120px, 100%); background: #fff; border-radius: 14px; box-shadow: 0 40px 100px rgba(20,18,26,0.4); overflow-y: auto; padding: 34px 40px 48px; }
    .smm-file-x { position: absolute; top: 20px; right: 24px; background: none; border: 0; font-size: 30px; line-height: 1; color: rgba(28,29,34,0.4); cursor: pointer; z-index: 2; }
    .smm-file-x:hover { color: var(--ink); }
    .smm-file-head { margin: 0 40px 20px 0; }
    .smm-name-wrap { display: inline-flex; align-items: center; gap: 6px; }
    .smm-file-name { font-family: var(--serif); font-weight: 500; font-size: 30px; color: var(--ink); margin: 0; display: inline-flex; align-items: center; gap: 6px; }
    .smm-name-edit { background: none; border: 0; padding: 5px; border-radius: 7px; color: rgba(28,29,34,0.32); cursor: pointer; display: inline-flex; }
    .smm-name-edit:hover { background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-name-edit svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }
    .smm-name-input { font-family: var(--serif); font-weight: 500; font-size: 30px; color: var(--ink); border: 0; border-bottom: 2px solid var(--english-violet); outline: none; background: none; min-width: 220px; padding: 0 0 2px; }
    .smm-file-sub { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); margin: 5px 0 0; }
    .smm-status-pill { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; margin-left: 6px; position: relative; top: -4px; }
    .smm-status-pill.is-active, .smm-card-status.is-active { background: rgba(47,158,94,0.14); color: #2c7a4b; }
    .smm-status-pill.is-paused, .smm-card-status.is-paused { background: rgba(227,160,8,0.16); color: #9a6a04; }
    .smm-status-pill.is-ended, .smm-card-status.is-ended { background: rgba(28,29,34,0.09); color: rgba(28,29,34,0.55); }

    /* Pipeline stepper */
    .smm-pipe { position: relative; display: flex; margin: 8px 0 93px; padding-top: 4px; }
    .smm-pipe-track { position: absolute; top: 10px; left: 7px; right: 7px; height: 2px; background: rgba(28,29,34,0.12); }
    .smm-pipe-fill { position: absolute; left: 0; top: 0; height: 100%; background: var(--english-violet); transition: width .25s; }
    .smm-pipe-step { position: absolute; top: 4px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; }
    .smm-pipe-step--first { transform: translateX(0); align-items: flex-start; }
    .smm-pipe-step--last { transform: translateX(-100%); align-items: flex-end; }
    .smm-pipe-dot { width: 14px; height: 14px; border-radius: 50%; background: #fff; border: 2px solid rgba(28,29,34,0.25); position: relative; z-index: 1; transition: background .18s, border-color .18s, box-shadow .18s; }
    .smm-pipe-step.is-done .smm-pipe-dot { background: var(--english-violet); border-color: var(--english-violet); }
    .smm-pipe-step.is-current .smm-pipe-dot { box-shadow: 0 0 0 4px rgba(var(--violet-rgb),0.18); }
    .smm-pipe-label { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.5); white-space: nowrap; }
    .smm-pipe-step.is-done .smm-pipe-label, .smm-pipe-step.is-current .smm-pipe-label { color: var(--ink); font-weight: 600; }
    .smm-pipe-step:hover .smm-pipe-label { color: var(--english-violet); }

    /* File layout */
    .smm-file-grid { display: grid; grid-template-columns: 320px 1fr; gap: 34px; }
    @media (max-width: 860px) { .smm-file-grid { grid-template-columns: 1fr; } }
    .smm-sec { border-top: 1px solid rgba(28,29,34,0.09); padding: 18px 0; }
    .smm-sec:first-child { border-top: 0; padding-top: 0; }
    .smm-sec-h { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin: 0 0 12px; display: flex; align-items: center; justify-content: space-between; gap: 10px; }

    /* Contact details card */
    .smm-cd-card { border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 6px 16px; }
    .smm-cd-row { display: flex; align-items: center; gap: 12px; padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.07); }
    .smm-cd-row:last-child { border-bottom: 0; }
    .smm-cd-ico { width: 34px; height: 34px; flex: none; border-radius: 9px; background: rgba(var(--violet-rgb),0.09); color: var(--english-violet); display: inline-flex; align-items: center; justify-content: center; }
    .smm-cd-ico svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 2; }
    .smm-cd-main { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 1px; }
    .smm-cd-k { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.42); }
    .smm-cd-v { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); text-decoration: none; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    a.smm-cd-v:hover { color: var(--english-violet); }
    .smm-cd-input { width: 100%; border: 0; border-bottom: 1px solid transparent; background: none; font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); padding: 1px 0; }
    .smm-cd-input:hover { border-bottom-color: rgba(28,29,34,0.15); }
    .smm-cd-input:focus { outline: none; border-bottom-color: var(--english-violet); }
    .smm-cd-input::placeholder { color: rgba(28,29,34,0.3); font-weight: 500; }
    .smm-cd-status { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); margin: 8px 0 0; min-height: 14px; }
    .smm-copy { background: none; border: 0; padding: 6px; border-radius: 7px; color: rgba(28,29,34,0.38); cursor: pointer; display: inline-flex; flex: none; transition: background .15s, color .15s; }
    .smm-copy:hover { background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-copy svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; }
    .smm-copy.is-done { color: #2c7a4b; }

    /* See more */
    .smm-more-toggle { margin-top: 14px; background: none; border: 0; padding: 6px 0; font-family: var(--sans); font-size: 12.5px; font-weight: 600; color: var(--english-violet); cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .smm-more-toggle svg { width: 13px; height: 13px; fill: none; stroke: currentColor; stroke-width: 2.2; transition: transform .18s; }
    .smm-more-toggle.is-open svg { transform: rotate(180deg); }
    .smm-more { margin-top: 4px; }
    .smm-more[hidden] { display: none; }
    .smm-field { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 8px 0; border-bottom: 1px dashed rgba(28,29,34,0.09); font-family: var(--sans); font-size: 13.5px; color: var(--ink); }
    .smm-field:last-child { border-bottom: 0; }
    .smm-field-k { color: rgba(28,29,34,0.5); flex: 0 0 auto; font-size: 12.5px; }
    .smm-field-v { text-align: right; min-width: 0; }

    /* Actions */
    .smm-file-actions { display: flex; flex-wrap: wrap; gap: 8px; }
    .smm-btn { display: inline-flex; align-items: center; gap: 7px; padding: 9px 15px; border-radius: 8px; font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.02em; cursor: pointer; border: 1px solid rgba(var(--violet-rgb),0.3); background: #fff; color: var(--english-violet); text-decoration: none; transition: background .15s, border-color .15s, color .15s; }
    .smm-btn:hover { background: rgba(var(--violet-rgb),0.06); }
    .smm-btn svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 2; }
    .smm-btn--primary { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .smm-btn--primary:hover { background: var(--ink); color: #fff; }
    .smm-btn--block { width: 100%; justify-content: center; }
    .smm-btn--danger { border-color: #a05a3c; color: #a05a3c; }
    .smm-btn--danger:hover { background: #a05a3c; color: #fff; }
    .smm-btn--sm { padding: 6px 12px; font-size: 12px; }
    .smm-status-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 12px; }
    .smm-hint { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); margin: 8px 0 0; }
    .smm-eng { display: grid; grid-template-columns: 1fr 1fr; gap: 11px 12px; }
    .smm-eng-row { display: flex; flex-direction: column; gap: 4px; }
    .smm-eng-row--full { grid-column: 1 / -1; }
    .smm-eng-row > span { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .smm-eng-row input, .smm-eng-row textarea { width: 100%; box-sizing: border-box; padding: 8px 10px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; font-family: var(--sans); font-size: 13px; color: var(--ink); background: #fff; resize: vertical; }
    .smm-eng-row input:focus, .smm-eng-row textarea:focus { outline: none; border-color: var(--english-violet); }
    .smm-eng-status { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); margin: 8px 0 0; min-height: 14px; }
    .smm-platforms { margin-top: 12px; }
    .smm-plat-label { display: block; font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-bottom: 8px; }
    .smm-plat-grid { display: flex; flex-wrap: wrap; gap: 6px 14px; }
    .smm-plat { display: inline-flex; align-items: center; gap: 6px; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.68); cursor: pointer; }
    /* Invoices */
    .smm-inv { border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 12px 13px; margin-bottom: 9px; }
    .smm-inv-top { display: flex; align-items: center; gap: 10px; }
