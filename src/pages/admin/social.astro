    }

    // ---- What the file knows, worked out once per draw ----
    // Dates move by working days (Mon to Fri): proposals within 3 of the call,
    // contracts within 1 of the pricing call (Dani, 5 Nov 2026).
    const sfAddDays = (iso, n) => { const d = sfDate(iso); if (!d) return null; d.setDate(d.getDate() + n); return d.toISOString(); };
    const sfAddWork = (iso, n) => { const d = sfDate(iso); if (!d) return null; let left = n; while (left > 0) { d.setDate(d.getDate() + 1); const w = d.getDay(); if (w !== 0 && w !== 6) left--; } return d.toISOString(); };
    const sfDaysSince = (iso) => { const d = sfDate(iso); return d ? Math.floor((Date.now() - d.getTime()) / 864e5) : null; };
    const sfWhen = (iso) => { const d = sfDate(iso); return d ? d.toLocaleString("en-GB", { weekday: "long", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" }) : ""; };
    const sfMon = (ym) => { const [y, m] = String(ym).split("-").map(Number); return RI_MONTHS[m - 1].slice(0, 3); };
    // How they came in: the website routes from the card's kind, or what was
    // recorded for someone added by hand (supabase/smm_follow_ups.sql).
    // Who looks after a client, from the first enquiry (Danielle, 5 Nov 2026).
    const SF_MANAGERS = ["Abigail Saunders", "Samantha Thornicroft", "Danielle Law"];
    const sfMgrOptions = (cur) => { const v = String(cur || ""); return `<option value="">Choose…</option>${SF_MANAGERS.concat(v && !SF_MANAGERS.includes(v) ? [v] : []).map((o) => `<option${o === v ? " selected" : ""}>${esc(o)}</option>`).join("")}`; };
    // The person writing, for a plain email's footer: their name from Managed by's list.
    const sfMyName = () => { const first = String(ME || "").split("@")[0].split(/[._]/)[0].toLowerCase(); return SF_MANAGERS.find((n) => n.split(" ")[0].toLowerCase() === first) || sfStaff(ME); };
    // A ready-written email to open in Write (the proposal's, with it attached).
    let sfWritePreset = null;
    const SF_SOURCES = ["Website enquiry", "Email enquiry", "Brochure download", "Discovery call booking", "Waitlist", "Referral", "Phone call", "Event", "Existing client", "Internal", "Other"];
    const sfSource = (r) => { const k = r.source || ({ enquiry: "Website enquiry", brochure: "Brochure download", discovery: "Discovery call booking" }[r.kind] || (r.pipeline_stage === "waitlist" ? "Waitlist" : "")); return [k, r.source_detail].filter(Boolean).join(": "); };
    // Call notes are pinned notes headed "Discovery call notes" or "Pricing call
    // notes", one "Label: value" a line, so the file can read them back.
    const SF_CALLS = { discovery: "Discovery call notes", pricing: "Pricing call notes", onboarding: "Onboarding call notes" };
    function sfCallNotes(msgs, kind) {
      const m = msgs.filter((x) => x.channel === "note" && String(x.subject || "").toLowerCase() === SF_CALLS[kind].toLowerCase()).sort((a, b) => new Date(b.created_at) - new Date(a.created_at))[0];
      if (!m) return null;
      const f = { _m: m };
      String(m.body || "").split("\n").forEach((line) => { const i = line.indexOf(":"); if (i > 0) f[line.slice(0, i).trim().toLowerCase()] = line.slice(i + 1).trim(); });
      return f;
    }
    function sfFacts(r) {
      const st = stageOf(r), idx = STAGE_INDEX[st];
      const lost = r.pipeline_stage === "lost";
      const thread = r._thread || null;
      const msgs = (thread && thread.messages) || [], docs = (thread && thread.documents) || [];
      const cs = r.client_status || "active";
      const client = !lost && st === "active_client";
      const signedUp = !lost && idx >= STAGE_INDEX.onboarding;
      const reps = (r._reports || []).slice().sort((a, b) => b.year - a.year || b.month - a.month);
      const now = new Date(), ym = sfYm(now);
      const plans = docs.filter((d) => d.category === "content_plan").map((d) => {
        const m = String(d.title || d.file_name || "").match(/(January|February|March|April|May|June|July|August|September|October|November|December)\s+(\d{4})/i);
        const key = m ? `${m[2]}-${String(RI_MONTHS.findIndex((x) => x.toLowerCase() === m[1].toLowerCase()) + 1).padStart(2, "0")}` : sfYm(sfDate(d.created_at) || now);
        return Object.assign({}, d, { ym: key });
      }).sort((a, b) => (a.ym < b.ym ? 1 : a.ym > b.ym ? -1 : 0));
      const invs = (sfData.invoices || []).filter((v) => v.status !== "void").sort((a, b) => String(b.issued_date || b.created_at || "").localeCompare(String(a.issued_date || a.created_at || "")));
      const shoots = sfData.shoots || (thread && thread.shoots) || [];
      // The story so far: when each stage was reached, who said what, when.
