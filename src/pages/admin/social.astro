      const reached = (k) => { const e = ev.filter((x) => x.stage === k).sort((a, b) => new Date(b.reached_at) - new Date(a.reached_at))[0]; return e ? e.reached_at : null; };
      const asc = (a, b) => new Date(a.created_at) - new Date(b.created_at);
