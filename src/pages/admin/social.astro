    .cs-pill.is-late { background: rgba(165,53,47,0.12); color: #a5352f; }
    .cs-pill.is-wait { background: rgba(196,140,40,0.15); color: #8a5a10; }
    .cs-empty { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.5); margin: 8px 0 0; }
    /* Below the admin top bar, which sits above the page (and so above this):
       a tall pop-out used to start under it, its top out of reach (Danielle,
       21 Oct 2026). --smm-top is the bar's foot, set by the page. */
    .smm-modal-scrim { position: fixed; top: var(--smm-top, 0px); right: 0; bottom: 0; left: var(--ash-side-w, 0); z-index: 220; background: rgba(20,18,26,0.5); display: flex; align-items: center; justify-content: center; padding: 20px; box-sizing: border-box; }
    .smm-modal { max-height: calc(100vh - var(--smm-top, 0px) - 40px); overflow-y: auto; box-sizing: border-box; background: #fff; border-radius: 14px; width: min(440px, 100%); padding: 26px 28px 24px; box-shadow: 0 40px 100px rgba(20,18,26,0.45); }
    .smm-modal.smm-modal--email { width: min(620px, 100%); max-height: calc(100vh - var(--smm-top, 0px) - 40px); overflow-y: auto; }
    /* The booking form carries far more than a meeting does, so it needs the
       wider shell and has to scroll on a laptop screen. */
    .smm-modal.smm-modal--booking { width: min(620px, 100%); max-height: calc(100vh - var(--smm-top, 0px) - 40px); overflow-y: auto; }
    .smm-modal-field textarea { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 14px; line-height: 1.55; color: var(--ink); background: #fff; resize: vertical; }
    .smm-modal-field textarea:focus { outline: none; border-color: var(--english-violet); }
    .smm-modal-field input[readonly] { background: rgba(28,29,34,0.04); color: rgba(28,29,34,0.6); }
    .smm-modal h3 { font-family: var(--serif); font-weight: 500; font-size: 21px; color: var(--ink); margin: 0 0 4px; letter-spacing: -0.05em; }
    .smm-modal p.smm-modal-sub { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.55); margin: 0 0 18px; }
    .smm-modal-field { margin-bottom: 14px; }
    .smm-modal-hint { display: block; margin-top: 6px; font-family: var(--sans); font-size: 12px; line-height: 1.5; color: rgba(28,29,34,0.55); }
    .smm-modal-field > label { display: block; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin-bottom: 6px; }
    .smm-modal-field input[type=text], .smm-modal-field input[type=date], .smm-modal-field input[type=time], .smm-modal-field input[type=email], .smm-modal-field input[type=tel], .smm-modal-field input[type=datetime-local], .smm-modal-field select { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 14px; color: var(--ink); background: #fff; }
    .smm-modal-field input:focus, .smm-modal-field select:focus { outline: none; border-color: var(--english-violet); }
    .smm-modal-two { display: flex; gap: 12px; }
    .smm-modal-two > * { flex: 1; }
    .smm-check { display: flex; align-items: center; gap: 9px; font-family: var(--sans); font-size: 13.5px; color: var(--ink); cursor: pointer; margin: 4px 0 2px; }
    .smm-modal-actions { display: flex; gap: 8px; justify-content: flex-end; margin-top: 20px; }
    .smm-modal-status { font-family: var(--sans); font-size: 12.5px; color: #a05a3c; margin: 10px 0 0; }
      /* ===== The client file (Dani, 5 Nov 2026), from the TMKE OS mock-up =====
       In the page, not over it, the same as Videography's. Palette only:
       wine #371e28, taupe #7e6765, stone #c9bcb7, linen #eae5e1, on white;
       green and red only on status chips. One size, one weight: 14px at
       400; titles in the heading face at 300; buttons the house strip. */
    body.sf-open .page-header, body.sf-open .ash-panel.ash-page { display: none !important; }
    body.sf-open :is(.ash, .ash-content) { background: #fff !important; background-image: none !important; }
    #smm-file.smm-file-scrim { position: static; inset: auto; z-index: auto; background: none; display: block; padding: 0; }
    #smm-file.smm-file-scrim[hidden] { display: none; }
    #smm-file .smm-file-card { position: static; width: auto; background: none; border-radius: 0; box-shadow: none; overflow: visible; padding: 0; }
    #smm-file .smm-file-x { display: none; }
    #smm-file { --sf-line: #eae5e1; --sf-edge: #e2d9d4; --sf-tx: #7e6765; --sf-ink: #2b2226; --sf-wine: #371e28; --sf-stone: #c9bcb7; --sf-linen: #eae5e1; --sf-soft: #f7f4f2; --sf-row: 36px; }
    /* The reset reaches the file and the pop-out's own parts, not the older
       panels lent to it (the report dashboard keeps its own sizes). */
    #smm-file .sf :is(p, span, dt, dd, li, a, label, input, select, textarea, b, strong, em, i, small, div, td, th, button, code),
    #sf-pop :is(.sf-panel-h, .sf-panel-tabs, .sf-panel-f, .sf-sec-b, .sf-tbl, .sf-read, .sf-lock, .sf-ins) :is(p, span, dt, dd, li, a, label, input, select, textarea, b, strong, em, i, small, div, td, th, button, code),
    #sf-pop :is(.sf-say, .sf-note, .sf-read, .sf-lock) { font-family: var(--sans); font-size: 14px; font-weight: 400; letter-spacing: normal; text-transform: none; font-style: normal; line-height: 1.35; }
    #smm-file .sf label, #sf-pop .sf-sec-b label { display: inline; margin: 0; }
    .sf { display: flex; flex-direction: column; gap: 20px; color: var(--sf-ink); }
    #smm-file .sf-back { align-self: flex-start; margin: 0 0 -8px; padding: 0; border: 0; background: none; color: var(--sf-tx); cursor: pointer; }
    #smm-file .sf-back:hover { color: var(--sf-wine); }
    .sf-banner { position: relative; overflow: hidden; border-radius: 6px; min-height: clamp(220px, 20vw, 290px); background-size: cover; background-position: center 45%; color: #fff; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 18px 22px 32px; }
    .sf-banner::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(43,34,38,.05) 0%, rgba(43,34,38,0) 35%, rgba(43,34,38,.72) 100%); }
    .sf-banner > * { position: relative; }
    .sf-tags { display: flex; gap: 6px; flex-wrap: wrap; }
    #smm-file .sf-tag { display: inline-flex; align-items: center; height: 26px; padding: 0 10px; border-radius: 4px; background: rgba(255,255,255,.16); color: #fff; border: 1px solid rgba(255,255,255,.34); }
    #smm-file .sf-pay { border: 0; }
    .sf-pay::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; margin-right: 7px; }
    #smm-file .sf-pay.pay-awaiting { background: #c9bcb7; color: #371e28; }
    #smm-file .sf-pay.pay-overdue { background: #f9f0f0; color: #8a3f3f; }
    #smm-file .sf-pay.pay-paid { background: #edf4ef; color: #3f7a56; }
    .sf-row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 14px 20px; }
