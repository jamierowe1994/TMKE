    async function setInterBrand(r, on) {
      r.inter_brand_invoice = on;
      document.querySelectorAll("#ibi-toggle [data-ibi]").forEach((b) => b.classList.toggle("is-active", (b.getAttribute("data-ibi") === "yes") === on));
