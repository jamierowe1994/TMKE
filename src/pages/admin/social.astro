      const tags = status + (F.late ? '<span class="sf-tag sf-pay pay-overdue">Update needed</span>' : "") + (noInv ? '<span class="sf-tag sf-pay pay-overdue">No monthly invoice</span>' : "") + (r.social_media_manager ? `<span class="sf-tag">Managed by ${esc(r.social_media_manager)}</span>` : "");
      const sub = [r.business && r.business !== name ? r.business : "", F.client || leaving ? (r.start_date ? "Client since " + sfDayYear(r.start_date) : "") : F.st === "onboarding" ? (r.start_date ? "Starts " + sfDayYear(r.start_date) : "") : F.lost ? (r.lost_at ? "Lost " + sfDayYear(r.lost_at) : "") : "Enquiry received " + sfDayYear(r.created_at)].filter(Boolean).join(" · ");
      const banner = `<div class="sf-banner" style="background-image:url('/assets/hub/smm.jpg')">
