    /* Modals (meeting / add file) */
    /* ---- Client status ---- */
    .cs-note { font-family: var(--sans); font-size: 12.5px; color: #8a5a10; background: rgba(196,140,40,0.08); border-radius: 8px; padding: 10px 14px; margin: 0 0 14px; }
