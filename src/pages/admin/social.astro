    .cs-tab span { font-size: 9.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%; }
