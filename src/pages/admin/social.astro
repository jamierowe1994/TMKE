            ${SF_PLATS.map((p) => { const on = plats.includes(p), url = String(r[SF_URL[p]] || "").trim(); const href = url ? (/^https?:/i.test(url) ? url : "https://" + url) : ""; return sfR(`<span class="sf-chan">${sfIcon(p, !on && !url)}</span>`, url ? `<a href="${esc(href)}" target="_blank" rel="noopener">${esc(url.replace(/^https?:\/\/(www\.)?/i, ""))}</a>` : on ? sfMiss("No link yet") : '<span class="sf-none">Not included</span>', url); }).join("")}
