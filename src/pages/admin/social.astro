    async function saveLead() {
      const first = $("smm-nl-first").value.trim(), last = $("smm-nl-last").value.trim();
      const full = `${first} ${last}`.trim();
      const email = $("smm-nl-email").value.trim();
      const status = $("smm-nl-status");
      if (!full && !email) { status.hidden = false; status.textContent = "Add a name or email."; return; }
      const lead = {
        first_name: first || null, last_name: last || null, full_name: full || email,
        business: $("smm-nl-biz").value.trim() || null, email: email || null, phone: $("smm-nl-phone").value.trim() || null,
        pipeline_stage: $("smm-nl-stage").value, kind: "manual", created_at: new Date().toISOString(),
        source: $("smm-nl-src").value || null, source_detail: $("smm-nl-srcwho").value.trim() || null, message: $("smm-nl-msg").value.trim() || null,
        social_media_manager: $("smm-nl-mgr").value || null,
        client_status: $("smm-nl-stage").value === "active_client" ? "active" : null,
      };
      const btn = $("smm-nl-add"); btn.disabled = true; btn.textContent = "Adding…";
      // Preview / no worker: add locally.
      if (!WORKER) { lead.id = "demo-new-" + Date.now(); all.unshift(lead); closeModal(); renderBoard(); openFile(lead.id); return; }
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/smm/lead`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify(lead) });
        if (!res.ok) throw 0;
        const j = await res.json().catch(() => ({}));
        const row = j.lead || Object.assign({ id: "tmp-" + Date.now() }, lead);
        all.unshift(row); closeModal(); renderBoard(); openFile(row.id);
      } catch (_) { status.hidden = false; status.textContent = "Couldn't add — try again."; btn.disabled = false; btn.textContent = "Add person"; }
    }

    // ---------- Correspondence ----------
    function threadStatus(msg, ok) {
      const el = $("smm-thread-status"); if (!el) return;
      el.hidden = !msg; el.textContent = msg || ""; el.style.color = ok === false ? "#a05a3c" : "var(--english-violet)";
    }
    async function loadThread(r) {
      if (!$("smm-panel-notes")) return;
      if (isDemo(r)) { r._thread = r._thread || { messages: [], documents: [] }; renderThread(r, r._thread); return; }
      if (!WORKER) { renderThread(r, { messages: [], documents: [] }, "Connect the Worker (PUBLIC_R2_WORKER_URL) to log emails, notes and files."); return; }
      renderThread(r, { messages: [], documents: [] }, null, true);
      let data = { messages: [], documents: [] };
      try { const token = await authToken(); const res = await fetch(`${WORKER}/booking/thread?booking_id=${encodeURIComponent(r.id)}`, { headers: { Authorization: "Bearer " + token } }); if (res.ok) data = await res.json(); } catch (_) {}
      data.shoots = []; data.reports = [];
      r._thread = data;
      renderThread(r, data);
      if (activeTab === "emails") markCommsRead(r);
      /* Shoots and reports live in their own tables, so Client activity
         reads them too (Danielle, 20 Oct 2026): a shoot booked, its content
         done, a report published. Read after the thread so a slow one never
         holds the notes up. */
      const [shoots, reports] = await Promise.all([
        // gallery_sent_at comes with videography_edits_settled.sql; without
        // it, the shoots still show as booked.
        supabase.from("videography_bookings").select("id, service, shoot_date, stage, created_at, gallery_sent_at").eq("smm_lead_id", r.id)
          .then(({ data: d, error }) => error ? supabase.from("videography_bookings").select("id, service, shoot_date, stage, created_at").eq("smm_lead_id", r.id).then(({ data: d2 }) => d2 || []) : (d || []))
          .catch(() => []),
        authToken().then((token) => fetch(`${WORKER}/smm/reports?lead_id=${encodeURIComponent(r.id)}`, { headers: { Authorization: "Bearer " + token } }))
          .then((res) => res.ok ? res.json() : {}).then((j) => (j.reports || []).map((x) => ({ month: x.month, year: x.year, platform: x.platform, published_at: x.published_at, published_by: x.published_by, amended_at: x.amended_at })), () => []),
      ]);
      if (r._thread !== data || !$("smm-panel-notes")) return;
      data.shoots = shoots; data.reports = reports;
      renderActivity(data);
      renderOnboarding(r);
      sfRefresh(r);
    }
    // Build a chronological audit feed from the thread (notes, emails in/out,
    // meetings, files/invoices added, invoices marked paid).
    function buildActivity(data) {
      const ev = [];
      for (const m of (data.messages || [])) {
        const t = m.created_at, who = m.created_by && m.created_by !== "system" ? m.created_by : null;
        if (m.kind === "meeting") ev.push({ t, text: m.body || "Meeting booked", who });
        else if (m.channel === "activity") ev.push({ t, text: m.body || "Activity", who });
        else if (m.channel === "email") {
          if (m.direction === "inbound") ev.push({ t, text: `Reply received${m.subject ? ": " + m.subject : ""}`, who: null });
          else ev.push({ t, text: `${m.is_automated ? "Automated email" : "Email"} sent${m.subject ? ": " + m.subject : ""}`, who });
        } else if (m.channel === "hub") ev.push({ t, text: "Message from their hub", who: null });
        else if (m.channel === "note") ev.push({ t, text: "Note added", who });
        else if (m.channel === "system") ev.push({ t, text: m.subject || m.body || "Update", who });
      }
      for (const d of (data.documents || [])) {
        const who = d.uploaded_by && d.uploaded_by !== "system" ? d.uploaded_by : null;
        const name = d.title || d.file_name || "document";
        if (d.category === "invoice") {
          ev.push({ t: d.created_at, text: `Invoice added: ${name}`, who });
          if (d.paid_date) ev.push({ t: d.paid_date + "T12:00:00", text: `Invoice marked paid: ${name}`, who: null });
        } else {
          ev.push({ t: d.created_at, text: `File added: ${name} (${catLabel(d.category)})`, who });
        }
      }
      // Videography: booked, and its content done (Content ready, when the
      // social media manager is told it's in the Library).
      for (const b of (data.shoots || [])) {
        if (b.stage === "cancelled") continue;
        const what = b.service || "Video shoot";
        if (b.created_at) ev.push({ t: b.created_at, text: `Video shoot booked: ${what}${b.shoot_date ? ", " + dayDate(b.shoot_date) : ""}`, who: null, auto: true });
        if (b.gallery_sent_at) ev.push({ t: b.gallery_sent_at, text: `Videography content done: ${what}${b.shoot_date ? " (shot " + dayDate(b.shoot_date) + ")" : ""}`, who: null, auto: true });
      }
      // Social media reports: published, and republished.
      for (const x of (data.reports || [])) {
        const label = `${RI_MONTHS[x.month] || ""} ${x.year} report`.trim();
        if (x.published_at) ev.push({ t: x.published_at, text: `${label} published`, who: x.published_by || null, auto: true });
        if (x.amended_at && x.amended_at !== x.published_at) ev.push({ t: x.amended_at, text: `${label} republished`, who: null, auto: true });
      }
      // Undated items go last: a NaN in the comparison scrambles the order.
      return ev.sort((a, b) => (Date.parse(b.t) || 0) - (Date.parse(a.t) || 0));
    }
    // Unread: from the client (their hub, or an email in) and not yet seen.
    // read_at comes with supabase/smm_communication.sql; until then there's
    // no count rather than a count that never goes down.
    const isUnread = (m) => m.direction === "inbound" && (m.channel === "hub" || m.channel === "email") && ("read_at" in m) && !m.read_at;
    function setCommsCount(msgs) {
      const el = $("smm-comm-n"); if (!el) return;
      const n = (msgs || []).filter(isUnread).length;
      el.textContent = n ? ` (${n})` : "";
    }
    // Opening Communication marks them read (the Worker, which can write).
    async function markCommsRead(r) {
      const msgs = (r._thread && r._thread.messages) || [];
      if (!msgs.some(isUnread)) return;
      const now = new Date().toISOString();
      if (!isDemo(r)) {
        try { const token = await authToken(); const res = await fetch(`${WORKER}/booking/thread/read`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: r.id }) }); if (!res.ok) return; } catch (_) { return; }
      }
      // The New badges stay for this look; the count goes.
      msgs.forEach((m) => { if (isUnread(m)) m.read_at = now; });
      setCommsCount(msgs);
      sfRefresh(r);
    }
    // ACTIVITY LOG (derived audit of everything on the account): the latest
    // five, with the rest a click away (Danielle, 20 Oct 2026). Drawn on its
    // own, so the shoots and reports arriving later don't redraw the notes.
    function renderActivity(data) {
      const host = $("smm-activity-wrap"); if (!host) return;
      const acts = buildActivity(data);
      const rows = (list) => list.map((a) => `<div class="smm-act">
        <span class="smm-act-dot"></span>
        <div class="smm-act-main"><span class="smm-act-text">${esc(a.text)}</span><span class="smm-act-meta">${a.who ? esc(a.who) + " · " : a.auto ? "Automatic · " : ""}${esc(fmtWhen(a.t))}</span></div>
      </div>`).join("");
      host.innerHTML = acts.length
        ? `<div class="smm-activity" id="smm-activity">${rows(acts.slice(0, 5))}</div>${acts.length > 5 ? `<button type="button" class="smm-note-more smm-act-more" id="smm-act-more">Show all ${acts.length}</button>` : ""}`
        : `<p class="smm-mail-empty">No activity yet.</p>`;
      $("smm-act-more")?.addEventListener("click", (e) => {
        const all = e.currentTarget.dataset.open !== "1";
        $("smm-activity").innerHTML = rows(all ? acts : acts.slice(0, 5));
        e.currentTarget.dataset.open = all ? "1" : "";
        e.currentTarget.textContent = all ? "Show the latest 5" : `Show all ${acts.length}`;
      });
    }
    function renderThread(r, data, warn, loading) {
      const pNotes = $("smm-notes-list"), pMail = $("smm-panel-emails"), pFiles = $("smm-panel-files");
      if (!pNotes) return;
      const msgs = data.messages || [], docs = data.documents || [];
      const notes = msgs.filter((m) => m.channel === "note")
        .sort((a, b) => (b.is_pinned ? 1 : 0) - (a.is_pinned ? 1 : 0) || new Date(a.created_at) - new Date(b.created_at));
      const emails = msgs.filter((m) => m.channel === "email" || m.channel === "system")
        .sort((a, b) => new Date(a.created_at) - new Date(b.created_at));

      // NOTES
      const noteHtml = loading ? '<p class="smm-soon">Loading…</p>' : (notes.map((m) => {
        const who = m.created_by && m.created_by !== "system" ? m.created_by : "You";
        // A note belongs to whoever wrote it. Everyone can read the thread;
        // only the author gets Edit and Delete. The Worker enforces this too -
        // hiding a button is a courtesy, not a control.
        const mine = String(m.created_by || "").toLowerCase() === String(ME || "").toLowerCase();
        return `<div class="smm-note ${m.is_pinned ? "is-pinned" : ""}" data-note="${esc(m.id)}">
          <div class="smm-note-body is-clamped">${esc(m.body || "").replace(/\n/g, "<br>")}</div>
          <button type="button" class="smm-note-more" hidden>Show more</button>
          <div class="smm-note-foot">
            <span class="smm-note-meta">${m.is_pinned ? '<span class="smm-pin-badge">Pinned</span> · ' : ""}${esc(who)} · ${esc(fmtWhen(m.created_at))}${m.edited_at ? " · edited" : ""}</span>
            <span class="smm-note-tools">
              <button type="button" class="smm-mini" data-pin="${esc(m.id)}" data-pinned="${m.is_pinned ? 1 : 0}">${m.is_pinned ? "Unpin" : "Pin"}</button>
              ${mine ? `<button type="button" class="smm-mini" data-editnote="${esc(m.id)}">Edit</button>
              <button type="button" class="smm-mini is-danger" data-delnote="${esc(m.id)}">Delete</button>` : ""}
            </span>
          </div>
        </div>`;
      }).join("") || `<p class="smm-mail-empty">No notes yet.</p>`);
      pNotes.innerHTML = `
        <div class="smm-add">
          <textarea id="smm-note-input" rows="2" placeholder="Add an internal note…"></textarea>
          <div class="smm-add-row"><span></span><button type="button" class="smm-btn smm-btn--sm" id="smm-note-add">${PLUS_SVG}Add note</button></div>
        </div>
        ${noteHtml}`;
      if (!loading) renderActivity(data);
      renderPackage(r);
      clampNotes();

      // EMAILS
      const mailHtml = loading ? '<p class="smm-soon">Loading…</p>' : (emails.map((m) => {
        const out = m.direction !== "inbound";
        const who = m.is_automated ? "TMKE (automated)" : (out ? (m.created_by && m.created_by !== "system" ? m.created_by : "TMKE") : (r.email || "Client"));
        return `<div class="smm-mail ${out ? "is-out" : "is-in"}">
          <div class="smm-mail-head"><span class="smm-mail-who">${esc(who)}${m.is_automated ? '<span class="smm-mail-badge">Auto</span>' : ""}</span><span class="smm-mail-when">${esc(fmtWhen(m.created_at))}</span></div>
          ${m.subject ? `<div class="smm-mail-subj">${esc(m.subject)}</div>` : ""}
          <div class="smm-mail-body">${esc(m.body || "").replace(/\n/g, "<br>")}</div>
        </div>`;
      }).join("") || `<p class="smm-mail-empty">No emails logged yet.</p>`);
      /* Messages the client sent from their hub (Danielle, 20 Oct 2026):
         under the emails, each with Reply, which answers by email from here.
         Unread ones (from the hub, or emailed in) are counted on the tab. */
      const hubMsgs = msgs.filter((m) => m.channel === "hub").sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
      const hubHtml = loading ? "" : (hubMsgs.map((m) => `<div class="smm-mail is-in smm-hubmsg${isUnread(m) ? " is-unread" : ""}">
          <div class="smm-mail-head"><span class="smm-mail-who">${esc(nameOf(r) !== "—" ? nameOf(r) : (m.client_email || "Client"))}<span class="smm-mail-badge">Hub</span>${isUnread(m) ? '<span class="smm-mail-badge is-new">New</span>' : ""}</span><span class="smm-mail-when">${esc(fmtWhen(m.created_at))}</span></div>
          <div class="smm-mail-body">${esc(m.body || "").replace(/\n/g, "<br>")}</div>
          <div class="smm-hubmsg-foot"><button type="button" class="smm-mini" data-hubreply="${esc(m.id)}">Reply</button></div>
        </div>`).join("") || `<p class="smm-mail-empty">Nothing from their hub yet.</p>`);
      setCommsCount(msgs);
      pMail.innerHTML = `
        <h4 class="smm-comm-h">Emails</h4>
        ${mailHtml}
        <div class="smm-add" style="margin-top:14px">
          <input type="text" id="smm-mail-subj" placeholder="Subject" />
          <textarea id="smm-mail-body" rows="3" placeholder="Write an email to ${esc(r.email || "the client")}…"></textarea>
          <input type="file" id="smm-mail-file" class="smm-file-input" />
          <div class="smm-add-row">
            <p class="smm-hint">Sends from hello@tmke.co.uk (as TMKE) and logs here. Their reply goes to that inbox and shows here too.</p>
            <button type="button" class="smm-btn smm-btn--primary smm-btn--sm" id="smm-mail-send">Send email</button>
          </div>
        </div>
        <h4 class="smm-comm-h">Messages from their hub</h4>
        ${hubHtml}`;
      pMail.querySelectorAll("[data-hubreply]").forEach((b) => b.addEventListener("click", () => {
        const m = hubMsgs.find((x) => String(x.id) === b.getAttribute("data-hubreply"));
        const subj = $("smm-mail-subj"), body = $("smm-mail-body");
        if (subj && !subj.value) subj.value = "Re: your message";
        if (body) { if (m && !body.value) body.value = `\n\n> ${String(m.body || "").split("\n").join("\n> ")}`; body.focus(); body.setSelectionRange(0, 0); body.scrollIntoView({ block: "center", behavior: "smooth" }); }
      }));

      // FILES (everything except invoices)
      const files = docs.filter((d) => d.category !== "invoice");
      const docHtml = loading ? '<p class="smm-soon">Loading…</p>' : (files.map((d) => `<div class="smm-doc">
        <span class="smm-doc-ico">${DOC_SVG}</span>
        <span class="smm-doc-main"><span class="smm-doc-name">${esc(d.title || d.file_name)}</span><span class="smm-doc-cat">${esc(catLabel(d.category))}</span></span>
        <span class="smm-doc-tools">
          <button type="button" class="smm-mini" data-docdl="${esc(d.id)}" data-docname="${esc(d.file_name || "document")}">Download</button>
          <button type="button" class="smm-mini is-danger" data-docdel="${esc(d.id)}">Remove</button>
        </span>
      </div>`).join("") || `<p class="smm-doc-empty">No files attached yet.</p>`);
      pFiles.innerHTML = `
        <div class="smm-panel-head"><h4>Documents</h4><button type="button" class="smm-btn smm-btn--sm" id="smm-file-add">${PLUS_SVG}Add file</button></div>
        ${warn ? `<p class="smm-soon" style="margin-bottom:12px">${esc(warn)}</p>` : ""}
        ${docHtml}`;

      renderPaperwork(r, docs, loading);
      if (!loading) renderOnboarding(r);

      // INVOICING (active clients only) — the full builder + raised list.
      const pInv = $("smm-panel-invoices");
      r._lastDocs = docs; r._lastWarn = warn;   // cached so a DD toggle can re-render this panel
      if (pInv) renderInvoicing(r, pInv, docs, loading, warn);

      // Wire
      $("smm-note-add")?.addEventListener("click", () => addNote(r));
      $("smm-mail-send")?.addEventListener("click", () => sendEmail(r));
      $("smm-file-add")?.addEventListener("click", () => openAddFile(r));
      pNotes.querySelectorAll("[data-pin]").forEach((b) => b.addEventListener("click", () => pinNote(r, b.getAttribute("data-pin"), b.getAttribute("data-pinned") !== "1")));
      pNotes.querySelectorAll("[data-delnote]").forEach((b) => b.addEventListener("click", () => delNote(r, b.getAttribute("data-delnote"))));
      pNotes.querySelectorAll("[data-editnote]").forEach((b) => b.addEventListener("click", () => editNote(r, b.getAttribute("data-editnote"))));
      pFiles.querySelectorAll("[data-docdl]").forEach((b) => b.addEventListener("click", () => downloadDoc(b.getAttribute("data-docdl"), b.getAttribute("data-docname"))));
      pFiles.querySelectorAll("[data-docdel]").forEach((b) => b.addEventListener("click", () => deleteDoc(r, b.getAttribute("data-docdel"))));
      sfRefresh(r);
    }

    async function addNote(r) {
      const ta = $("smm-note-input"); const body = (ta?.value || "").trim(); if (!body) return;
      if (isDemo(r)) { r._thread.messages.push({ id: "n" + Date.now(), channel: "note", body, is_pinned: false, created_by: "You", created_at: new Date().toISOString() }); renderThread(r, r._thread); return; }
      const btn = $("smm-note-add"); btn.disabled = true;
      try { const token = await authToken(); const res = await fetch(`${WORKER}/booking/message`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: r.id, source: "smm", body }) }); if (!res.ok) throw 0; loadThread(r); }
      catch (_) { threadStatus("Couldn't save note.", false); btn.disabled = false; }
    }
    async function pinNote(r, id, pinned) {
      if (isDemo(r)) { const m = r._thread.messages.find((x) => x.id === id); if (m) m.is_pinned = pinned; renderThread(r, r._thread); return; }
      try { const token = await authToken(); await fetch(`${WORKER}/booking/message/pin`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ id, pinned }) }); loadThread(r); } catch (_) {}
    }
    /* Long notes stop at five lines, with Show more / Show less (Danielle,
       20 Oct 2026). Measured, so only a note that's actually cut gets the
       button; done again when the Notes tab is opened, since a hidden tab
       has no size to measure. */
    function clampNotes() {
      const panel = $("smm-notes-list"); if (!panel || !panel.offsetParent) return;
      panel.querySelectorAll(".smm-note").forEach((n) => {
        const body = n.querySelector(".smm-note-body"), more = n.querySelector(".smm-note-more");
        if (!body || !more || n.dataset.clampWired) return;
        if (body.scrollHeight <= body.clientHeight + 1) { body.classList.remove("is-clamped"); return; }
        n.dataset.clampWired = "1"; more.hidden = false;
