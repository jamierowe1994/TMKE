    .smm-file-input::file-selector-button:hover { background: rgba(var(--violet-rgb),0.06); }

    /* Modals (meeting / add file) */
    .smm-modal-scrim { position: fixed; inset: 0; z-index: 220; background: rgba(20,18,26,0.5); display: flex; align-items: center; justify-content: center; padding: 20px; }
