    // ---------- Monthly report (management) ----------
    let mgData = null;
    function wireMgmt() {
      const sel = $("mg-month"), pull = $("mg-pull"), st = $("mg-status"), prev = $("mg-preview");
      if (!sel || sel.dataset.wired) return; sel.dataset.wired = "1";
      // The last twelve months. From the 20th, this month's reports are
      // usually in, so it's the one picked; before then, last month.
      const now = new Date(), start = now.getDate() >= 20 ? 0 : 1;
      for (let i = 0; i < 12; i++) {
        const dt = new Date(now.getFullYear(), now.getMonth() - i, 1);
        const o = document.createElement("option"); o.value = `${dt.getFullYear()}-${dt.getMonth()}`; o.textContent = `${RI_MONTHS[dt.getMonth()]} ${dt.getFullYear()}`;
        if (i === start) o.selected = true; sel.appendChild(o);
      }
      const load = async () => {
        const [y, m] = sel.value.split("-").map(Number);
        mgData = null; pull.disabled = true; st.textContent = "Gathering the month…"; prev.innerHTML = "";
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER}/smm/management-report?month=${m}&year=${y}`, { headers: { Authorization: "Bearer " + token } });
          const j = await res.json().catch(() => ({}));
          if (!res.ok || !j.ok) throw new Error(j.error || `Couldn't gather the month (${res.status}).`);
          mgData = j;
          // Who's in: ticked by default, and can be narrowed, say to one
          // account manager's clients.
          // The platforms the month covers: the report's own column always
          // says Instagram, whatever is in it.
          const platsLabel = (rep) => { const ps = platformsIn(rep && rep.data); return ps.length ? ps.map((p) => PLATFORM_LABELS[p] || p).join(", ") : (rep && rep.platform) || ""; };
          const who = (x, platform) => `<span class="mg-who"><b>${esc(x.business || x.name)}</b><small>${esc([x.business && x.name && x.name !== x.business ? x.name : "", x.manager, platform].filter(Boolean).join(" · "))}</small></span>`;
          const managers = [...new Set(j.accounts.map((a) => a.lead.manager).filter(Boolean))].sort();
          prev.innerHTML = `<div class="mg-card"><h3>Accounts to include</h3>${j.accounts.length ? `<div class="mg-pick"><button type="button" data-mgpick="all">All</button><button type="button" data-mgpick="none">None</button>${managers.map((mg) => `<button type="button" data-mgpick="m:${esc(mg)}">${esc(mg)}'s</button>`).join("")}</div><ul>${j.accounts.map((a, i) => `<li><label><input type="checkbox" data-mgacc="${i}" checked>${who(a.lead, platsLabel(a.report))}</label></li>`).join("")}</ul>` : `<p class="mg-empty">No client has a published report for ${esc(RI_MONTHS[m])} yet.</p>`}</div>`
            + `<div class="mg-card"><h3>Not included</h3>${j.missing.length ? `<ul>${j.missing.map((x) => `<li>${who(x, x.platform)}<span>${esc(x.reason)}</span></li>`).join("")}</ul>` : `<p class="mg-empty">Every active client is in.</p>`}</div>`;
          const count = () => {
            const k = prev.querySelectorAll("[data-mgacc]:checked").length;
            st.textContent = j.accounts.length ? `${k} of ${j.accounts.length} account${j.accounts.length === 1 ? "" : "s"} ticked, ${k ? k + 1 : 0} pages.` : "Nothing published for this month yet.";
            pull.disabled = !k;
          };
          prev.querySelectorAll("[data-mgacc]").forEach((c) => c.addEventListener("change", count));
          prev.querySelectorAll("[data-mgpick]").forEach((b) => b.addEventListener("click", () => {
            const v = b.getAttribute("data-mgpick");
            prev.querySelectorAll("[data-mgacc]").forEach((c) => { const a = j.accounts[+c.getAttribute("data-mgacc")]; c.checked = v === "all" ? true : v === "none" ? false : a.lead.manager === v.slice(2); });
            count();
          }));
          count();
        } catch (e) { st.textContent = e.message; }
      };
      sel.addEventListener("change", load);
      pull.addEventListener("click", async () => {
        if (!mgData) return;
        const label = pull.textContent; pull.disabled = true;
        try {
          const { downloadManagementPdf } = await import("../../lib/management-pdf.js");
          const by = (ME.split("@")[0] || "").split(/[._]/)[0].replace(/^./, (c) => c.toUpperCase());
          const picked = [...$("mg-preview").querySelectorAll("[data-mgacc]:checked")].map((c) => mgData.accounts[+c.getAttribute("data-mgacc")]);
          if (!picked.length) return;
          // A narrower pull (say, one manager's clients) lists only those
          // managers' missing clients.
          const mans = new Set(picked.map((x) => x.lead.manager));
          const missing = picked.length === mgData.accounts.length ? mgData.missing : mgData.missing.filter((x) => mans.has(x.manager));
          await downloadManagementPdf({ ...mgData, accounts: picked, missing, by }, { onProgress: (i, n) => { pull.textContent = `Preparing… ${i} of ${n}`; } });
        } catch (e) { console.error("mgmt pdf", e); st.textContent = "Sorry, the PDF couldn't be made just now. Please try again."; }
        finally { pull.textContent = label; pull.disabled = false; }
      });
      // Loaded the first time the panel is opened.
      $("smm-cog-mgmt")?.addEventListener("click", () => { if (!mgData && !pull.dataset.loaded) { pull.dataset.loaded = "1"; load(); } });
    }

