      const ago = (d) => new Date(now - d * 86400000).toISOString();
      const mk = (o) => Object.assign({ id: "demo-" + Math.abs((o.email || "").length * 7 + (o.full_name || "").length), kind: "enquiry", marketing_opt_in: false, created_at: new Date(now - (o.ageDays || 1) * 86400000).toISOString() }, o);
      const rows = [
        mk({ full_name: "Harriet Vance", email: "harriet@vancehomes.co.uk", phone: "07700 900111", business: "Vance & Co Estate Agents", kind: "enquiry", message: "We'd love help running our Instagram and reels — struggling to post consistently.", pipeline_stage: "inquiry", ageDays: 1 }),
        mk({ full_name: "Marcus Bell", email: "marcus@thelettingsexperts.co.uk", phone: "07700 900222", business: "The Lettings Experts", kind: "discovery", call_at: new Date(now + 2 * 86400000).toISOString(), pipeline_stage: "meeting_set", ageDays: 3 }),
        mk({ full_name: "Priya Anand", email: "priya@anandproperty.com", business: "Anand Property", kind: "brochure", pipeline_stage: "inquiry", ageDays: 2 }),
        mk({ full_name: "Tom Whitfield", email: "tom@whitfield.co.uk", phone: "07700 900333", business: "Whitfield & Sons", kind: "discovery", meeting_at: new Date(now + 5 * 86400000).toISOString(), pipeline_stage: "contract_sent", ageDays: 8 }),
        mk({ full_name: "Sofia Reyes", email: "sofia@reyeshomes.co.uk", business: "Reyes Homes", kind: "enquiry", pipeline_stage: "contract_signed", ageDays: 12 }),
        mk({ full_name: "James Okafor", email: "james@fineandcountry.com", phone: "07700 900444", business: "Fine & Country (Kettering)", kind: "enquiry", marketing_opt_in: true, pipeline_stage: "active_client", client_status: "active", ageDays: 40 }),
        mk({ full_name: "Elena Frost", email: "elena@frostandco.co.uk", phone: "07700 900555", business: "Frost & Co", kind: "discovery", marketing_opt_in: true, pipeline_stage: "active_client", client_status: "paused", ageDays: 90 }),
      ];
      // Seed a couple of threads so the customer file shows populated notes / emails / documents in the preview.
      rows[0]._thread = { messages: [
        { id: "n1", channel: "note", body: "Warm lead — followed us on Instagram first. Wants reels + a content plan.", is_pinned: true, created_by: "Abby", created_at: ago(0.5) },
      ], documents: [] };
      rows[5]._thread = { messages: [
        { id: "n2", channel: "note", body: "On the £750/mo Growth plan. Prefers a monthly call on the first Tuesday.", is_pinned: true, created_by: "Abby", created_at: ago(38) },
        { id: "e1", channel: "email", direction: "inbound", subject: "Social media help", body: "Hi — we're looking to hand over our Instagram and Facebook. Can you tell me how it works?", created_at: ago(41) },
        { id: "e2", channel: "email", direction: "outbound", subject: "Re: Social media help", body: "Hi James, absolutely — I've attached our brochure. Shall we set up a quick discovery call this week?", created_by: "Danielle", created_at: ago(40) },
        { id: "e3", channel: "email", direction: "outbound", subject: "Your contract", body: "Great to chat today. Your agreement is attached — sign at your leisure and we'll get started.", is_automated: false, created_by: "Abby", created_at: ago(37) },
        { id: "n3", channel: "note", body: "Contract signed 2 days after sending. Onboarding call booked.", is_pinned: false, created_by: "Abby", created_at: ago(35) },
      ], documents: [
        { id: "doc1", file_name: "TMKE-Social-Brochure.pdf", title: "Social media brochure", category: "prep" },
        { id: "doc2", file_name: "Fine-and-Country-Agreement.pdf", title: "Signed agreement", category: "agreement" },
      ] };
      return rows;
    }

    // ---------- Boot ----------
    (async () => {
      let session;
      if (import.meta.env.DEV) session = (await supabase.auth.getSession()).data.session || { user: { email: "dev@tmke.co.uk", id: "dev" } };
      else { session = await requireAdmin(); if (!session) return; }

      let rows = [];
      try { const { data } = await supabase.from("smm_leads").select("*").order("created_at", { ascending: false }); rows = data || []; } catch (_) {}
      if (!rows.length && import.meta.env.DEV) rows = demoRows();
      all = rows;

      $("smm-loading").hidden = true;
      $("smm-board").hidden = false;
      renderBoard();

      $("smm-filters").addEventListener("click", (e) => {
        const btn = e.target.closest(".smm-chip"); if (!btn) return;
        document.querySelectorAll(".smm-chip").forEach((c) => c.classList.remove("is-active"));
        btn.classList.add("is-active");
        kindFilter = btn.getAttribute("data-filter") || "all";
        renderBoard();
      });
      $("smm-search").addEventListener("input", (e) => { q = e.target.value.toLowerCase().trim(); renderBoard(); });
      $("smm-show-lost").addEventListener("change", (e) => { showLost = e.target.checked; renderBoard(); });
      $("smm-file-close").addEventListener("click", closeFile);
      $("smm-file").addEventListener("click", (e) => { if (e.target === $("smm-file")) closeFile(); });
      document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !$("smm-file").hidden) closeFile(); });
    })();
  </script>
</AdminShell>
