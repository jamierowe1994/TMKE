        jobs.push(fetch(`${WORKER}/invoicing/invoices?booking_id=${encodeURIComponent(id)}`, { headers: H }).then((x) => x.json().catch(() => ({}))).then((j) => { if (stillHere()) { sfData.invoices = (j && j.invoices) || []; sfRefresh(r); } }).catch(() => { if (stillHere()) { sfData.invoices = []; sfRefresh(r); } }));
        jobs.push(fetch(`${WORKER}/invoicing/recurring`, { headers: H }).then((x) => x.json().catch(() => ({}))).then((j) => { if (stillHere()) { sfData.recurring = ((j && j.recurring) || []).find((x) => String(x.lead_id || "") === String(id)) || null; sfRefresh(r); } }).catch(() => { if (stillHere()) { sfData.recurring = null; sfRefresh(r); } }));
        jobs.push(fetch(`${WORKER}/smm/reports?lead_id=${encodeURIComponent(id)}`, { headers: H }).then((x) => x.json().then((j) => ({ ok: x.ok, j })).catch(() => ({ ok: false, j: {} }))).then(({ ok, j }) => {
          if (!stillHere()) return;
