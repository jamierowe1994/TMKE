    /* ===================== Calculator figures + Package calculator (Dani, 5 Nov 2026) =====================
       The figures live in smm_pricing_settings (one row). Management edit them on
       Packages & pricing; unsaved edits are kept in this browser until saved, and
       "Saved" shows only once the database hands the same figures back. The
       calculator prices from the saved figures (src/lib/smm-calc.js). `var`, not
       let: a ?go= link can open these panels before this part of the script runs. */
    var PF = mergeFigures(null), pfRow = null, pfState = "loading", pfErr = "", pfDraft = null, pfLoading = null;
    var PF_DRAFT_KEY = "tmke-smm-pricing-draft";
    var pcS = { buyer: "standard", maker: "own", v: 2, c: 1, s: 1, platforms: ["Instagram", "Facebook"], stories: false, comments: false, pack: 0, budget: 500 };
    var pcWired = false, pcHome = null, pcLast = null;
    function pcEl(id) { return document.getElementById(id); }
    function pcGbp(n) { return "£" + Math.round(n).toLocaleString("en-GB"); }

    function loadPricing(force) {
      if (pfLoading && !force) return pfLoading;
      pfLoading = (async () => {
        const { data, error } = await supabase.from("smm_pricing_settings").select("figures, updated_at, updated_by").eq("id", 1).maybeSingle();
        if (error) {
          pfState = /does not exist|schema cache|relation/i.test(error.message || "") ? "missing" : "error";
          pfErr = error.message || "";
          pfRow = null; PF = mergeFigures(null);
        } else {
          pfRow = data || null; pfState = data ? "saved" : "unsaved";
          PF = mergeFigures(data && data.figures);
        }
        try { const d = localStorage.getItem(PF_DRAFT_KEY); pfDraft = d ? mergeFigures(JSON.parse(d)) : null; } catch (_) { pfDraft = null; }
        drawFigures(); drawCalc();
      })();
      return pfLoading;
    }

    function pfStateText() {
      if (pfState === "missing") return "These figures can't be saved yet: run supabase/smm_pricing_settings.sql in Supabase. Until then the calculator uses the starting figures from 5 November.";
      if (pfState === "error") return "Couldn't load the saved figures (" + pfErr + "). The calculator is using the starting figures from 5 November.";
      if (pfState === "unsaved") return "These are the starting figures from 5 November. They haven't been saved yet, so press Save figures once they're right.";
      if (pfState === "saved" && pfRow) {
        const when = pfRow.updated_at ? new Date(pfRow.updated_at).toLocaleString("en-GB", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" }) : "";
        return "The calculator prices from these. Last saved " + when + (pfRow.updated_by ? " by " + pfRow.updated_by : "") + ".";
      }
      return "Loading…";
    }

    function drawFigures() {
      const box = pcEl("pf-box"); if (!box) return;
      pcEl("pf-state").textContent = pfStateText();
      const F = pfDraft || PF;
      CAN_MONEY.then((can) => {
        const dis = can && pfState !== "missing" ? "" : " disabled";
        const inp = (path, val, step) => `<input type="number" min="0" step="${step || 0.5}" data-pf="${path}" value="${esc(val)}"${dis}>`;
        const card = (title, head, rows) => `<div class="pf-card"><h4>${title}</h4><table>${head ? `<thead><tr>${head}</tr></thead>` : ""}<tbody>${rows}</tbody></table></div>`;
        const planning = PLANNING_STEPS.map((n) => `<tr><td>${n} posts a month<span class="pf-sub">${n / 4} a week</span></td><td class="pf-in">${inp("planning." + n, F.planning[n])}</td></tr>`).join("");
        const creation = POST_TYPES.map((t) => `<tr><td>${esc(t.label)}${t.note ? `<span class="pf-sub">${esc(t.note)}</span>` : ""}</td><td class="pf-in">${inp("creation." + t.key + ".create", F.creation[t.key].create, 5)}</td><td class="pf-in">${inp("creation." + t.key + ".caption", F.creation[t.key].caption, 5)}</td></tr>`).join("");
        const reporting = PLATFORM_STEPS.map((n) => `<tr><td>${n} ${n === 1 ? "platform" : "platforms"}</td><td class="pf-in">${inp("reporting." + n, F.reporting[n])}</td></tr>`).join("");
        const other = [
          ["strategy_hours_quarter", "Strategy meeting, hours a quarter", F.strategy_hours_quarter, 0.25],
          ["amends_hours_month", "Amends, hours a month", F.amends_hours_month, 0.25, "One request built in"],
          ["stories_minutes_per_post", "Stories and groups, minutes a post", F.stories_minutes_per_post, 5, "Its own add-on"],
          ["comments.minutes_per_post", "Comments and messages, minutes a post", F.comments.minutes_per_post, 5, "Its own section"],
        ].map((r) => `<tr><td>${r[1]}${r[4] ? `<span class="pf-sub">${r[4]}</span>` : ""}</td><td class="pf-in">${inp(r[0], r[2], r[3])}</td></tr>`).join("")
          + `<tr><td>Offer comments and messages<span class="pf-sub">Shows it in the calculator</span></td><td class="pf-in"><select data-pf="comments.offered"${dis}><option value="no"${F.comments.offered ? "" : " selected"}>Not yet</option><option value="yes"${F.comments.offered ? " selected" : ""}>Yes</option></select></td></tr>`;
        const money = [
          ["rates.content", "Content creation, £ an hour", F.rates.content, 1, "Creating posts"],
          ["rates.management", "Social media management, £ an hour", F.rates.management, 1, "Everything else"],
          ["software.upto8", "Software, £ a month, up to 8 posts", F.software.upto8, 1],
          ["software.upto16", "Software, £ a month, 12 or 16 posts", F.software.upto16, 1],
          ["software.more", "Software, £ a month, 20 or more posts", F.software.more, 1],
          ["pack_per_4", "Property pack, £ for every 4 posts", F.pack_per_4, 5],
          ["margins.teg_markup", "TEG brand, % added to cost", F.margins.teg_markup, 1],
          ["margins.external_margin", "External agency, % of the price that's margin", F.margins.external_margin, 1],
        ].map((r) => `<tr><td>${r[1]}${r[4] ? `<span class="pf-sub">${r[4]}</span>` : ""}</td><td class="pf-in">${inp(r[0], r[2], r[3])}</td></tr>`).join("");
        box.innerHTML =
          card("1. Planning", "<th>Posts</th><th class=\"pf-in\">Hours a month</th>", planning)
          + card("2. Creation", "<th>Post</th><th class=\"pf-in\">Create, min</th><th class=\"pf-in\">Caption and schedule, min</th>", creation)
          + card("3. Reporting", "<th>Platforms</th><th class=\"pf-in\">Hours a month</th>", reporting)
          + card("Other time", "", other)
          + card("Rates, software and margins", "", money);
        pcEl("pf-foot").hidden = !(can && pfState !== "missing");
        pfMarkDirty();
      });
    }

    function pfSet(obj, path, val) { const k = path.split("."); let o = obj; for (let i = 0; i < k.length - 1; i++) o = o[k[i]]; o[k[k.length - 1]] = val; }
    function pfMarkDirty() {
      const st = pcEl("pf-status"); if (!st) return;
      st.className = "pf-status"; st.textContent = pfDraft ? "Not saved yet. These changes are kept in this browser until you save." : "";
    }

    async function pfSave() {
      const btn = pcEl("pf-save"), st = pcEl("pf-status");
      const figures = pfDraft || PF;
      btn.disabled = true; btn.textContent = "Saving…";
      const { error } = await supabase.from("smm_pricing_settings").upsert({ id: 1, figures, updated_by: sfMyName() || ME || null }, { onConflict: "id" });
      let back = null, err2 = null;
      if (!error) { const r = await supabase.from("smm_pricing_settings").select("figures, updated_at, updated_by").eq("id", 1).maybeSingle(); back = r.data; err2 = r.error; }
      btn.disabled = false; btn.textContent = "Save figures";
      const same = back && JSON.stringify(mergeFigures(back.figures)) === JSON.stringify(mergeFigures(figures));
      if (error || err2 || !same) {
        st.className = "pf-status is-bad";
        st.textContent = "Couldn't save: " + ((error || err2 || {}).message || "the saved figures didn't come back the same") + ". Your changes are still here.";
        return;
      }
      pfRow = back; pfState = "saved"; PF = mergeFigures(back.figures); pfDraft = null;
      try { localStorage.removeItem(PF_DRAFT_KEY); } catch (_) {}
      pcEl("pf-state").textContent = pfStateText();
      st.className = "pf-status is-ok"; st.textContent = "Saved.";
      drawCalc();
    }

    /* ---- the calculator ---- */
    function pcItems(w) {
      const a = [];
      const parts = [];
      if (w.v) parts.push(w.v + (w.v === 1 ? " reel" : " reels"));
      if (w.c) parts.push(w.c + (w.c === 1 ? " carousel" : " carousels"));
      if (w.s) parts.push(w.s + (w.s === 1 ? " static" : " statics"));
      if (parts.length) a.push(pcList(parts) + " a week" + (w.v ? (w.maker === "us" ? ", filmed by us" : ", from their footage") : ""));
      if (parts.length) a.push(pcList(w.platforms));
      if (w.stories) a.push("Shared to Stories and 5 groups");
      if (w.comments) a.push("Replies to comments and messages");
      if (w.pack) a.push("A property pack of " + w.pack + " posts a month");
      return a;
    }
    function pcList(a) { return a.length < 2 ? a.join("") : a.slice(0, -1).join(", ") + " and " + a[a.length - 1]; }
    function pcDropped(W, w) {
      const out = [], n = (k, one, many) => k + " " + (k === 1 ? one : many);
      if (w.v < W.v) out.push(n(W.v - w.v, "reel", "reels") + " a week");
      if (w.c < W.c) out.push(n(W.c - w.c, "carousel", "carousels") + " a week");
      if (w.s < W.s) out.push(n(W.s - w.s, "static", "statics") + " a week");
      W.platforms.forEach((p) => { if (!w.platforms.includes(p)) out.push(p); });
      if (W.stories && !w.stories) out.push("Stories and groups");
      if (W.comments && !w.comments) out.push("Comments and messages");
      if (w.pack < W.pack) out.push((W.pack - w.pack) + " property pack posts");
      return out;
    }
    function pcWant() {
      return { maker: pcS.maker, v: pcS.v, c: pcS.c, s: pcS.s, platforms: pcS.platforms.slice(), stories: pcS.stories, comments: PF.comments.offered && pcS.comments, pack: pcS.pack };
    }

    function drawCalc() {
      if (!pcEl("pc-w1")) return;
      wireCalc();
      const F = PF, B = pcS.buyer, W = pcWant();
      const flag = pcEl("pc-flag");
      flag.hidden = pfState === "saved";
      flag.textContent = pfState === "saved" ? "" : pfStateText();
      pcEl("pc-comments-row").hidden = !F.comments.offered;
      pcEl("pc-maker-hint").textContent = pcS.maker === "us"
        ? "Filmed reels are priced from Shot and Scheduled, which includes a shoot each quarter."
        : "We make a cover for each reel, then caption and schedule it.";
      pcEl("pc-pack-hint").textContent = "Standard statics for their listings, the same property or different ones. " + pcGbp(F.pack_per_4) + " for every 4.";
      // Buttons show the state
      [["pc-buyer", pcS.buyer], ["pc-maker", pcS.maker], ["pc-v", pcS.v], ["pc-c", pcS.c], ["pc-s", pcS.s], ["pc-stories", pcS.stories ? 1 : 0], ["pc-comments", pcS.comments ? 1 : 0], ["pc-pack", pcS.pack]]
        .forEach(([id, v]) => pcEl(id).querySelectorAll("button").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.v) === String(v) ? "true" : "false")));
      pcEl("pc-plats").innerHTML = PC_PLATFORMS.map((p) => `<button type="button" data-plat="${esc(p)}" aria-pressed="${pcS.platforms.includes(p)}">${esc(p)}</button>`).join("");
      if (document.activeElement !== pcEl("pc-budget")) pcEl("pc-budget").value = pcS.budget;
      pcEl("pc-budget-r").value = Math.min(2500, Math.max(100, pcS.budget));

      const full = priceOf(W, B, F);
      pcEl("pc-w1").innerHTML = pcGbp(full.price) + " <small>a month</small>";
      const t1 = pcEl("pc-w1-tag");
      if (full.price <= pcS.budget) { t1.className = "pc-tag is-ok"; t1.textContent = full.price === pcS.budget ? "On budget" : pcGbp(pcS.budget - full.price) + " under budget"; }
      else { t1.className = "pc-tag is-over"; t1.textContent = pcGbp(full.price - pcS.budget) + " over budget"; }
      pcEl("pc-w1-list").innerHTML = pcItems(W).map((t) => `<li>${esc(t)}</li>`).join("");

      const fit = fitBudget(W, pcS.budget, B, F), t2 = pcEl("pc-w2-tag");
      if (fit) {
        const gone = pcDropped(W, fit.w);
        pcEl("pc-w2").innerHTML = pcGbp(fit.price) + " <small>a month</small>";
        t2.className = gone.length ? "pc-tag is-near" : "pc-tag is-ok";
        t2.textContent = gone.length ? "Within " + pcGbp(pcS.budget) : "Everything they asked for";
        pcEl("pc-w2-list").innerHTML = pcItems(fit.w).map((t) => `<li>${esc(t)}</li>`).join("") + gone.map((t) => `<li class="is-off">${esc(t)}</li>`).join("");
      } else {
        pcEl("pc-w2").textContent = "—"; t2.className = "pc-tag is-over"; t2.textContent = "Below the smallest plan"; pcEl("pc-w2-list").innerHTML = "";
      }

      // The packages, worked out from the same figures, plus their extras.
      const us = pcS.maker === "us";
      const fam = us ? SAS_PACKAGES.map((p) => ({ name: p.name, v: p.v, c: 0, s: 0, sheet: p.price[B] }))
                     : MGMT_PACKAGES.map((p) => ({ name: p.name, v: p.v, c: p.c, s: p.s, sheet: p.sheet[B] }));
      const pk = fam.map((p) => {
        const bare = { maker: pcS.maker, v: p.v, c: p.c, s: p.s, platforms: ["Instagram", "Facebook"].concat(us ? ["TikTok"] : []), stories: false, comments: false, pack: 0 };
        const withX = Object.assign({}, W, { v: p.v, c: p.c, s: p.s });
        const cov = Object.assign({}, W, { v: Math.min(p.v, W.v), c: Math.min(p.c, W.c), s: Math.min(p.s, W.s) });
        return { name: p.name, p, sheet: p.sheet, worked: priceOf(bare, B, F).price, withX: priceOf(withX, B, F).price, score: score(cov), w: withX };
      });
      pcEl("pc-pk-title").textContent = us ? "Against Shot and Scheduled" : "Against Social Media Management";

      const cands = pk.map((p) => ({ kind: "pkg", name: p.name, price: p.withX, score: p.score, w: p.w }));
      cands.push({ kind: "full", name: "Made to measure", price: full.price, score: score(W), w: W });
      if (fit) cands.push({ kind: "fit", name: "Made to measure", price: fit.price, score: fit.score, w: fit.w });
      let pick = null;
      cands.filter((c) => c.price <= pcS.budget).forEach((c) => {
        if (!pick || c.score > pick.score + 1e-9) { pick = c; return; }
        if (Math.abs(c.score - pick.score) < 1e-9) {
          if (c.kind === "pkg" && pick.kind !== "pkg" && c.price <= pick.price + 25) pick = c;
          else if (c.kind === pick.kind && c.price < pick.price) pick = c;
          else if (pick.kind === "pkg" && c.kind !== "pkg" && c.price + 25 < pick.price) pick = c;
        }
      });
      const fullScore = score(W);
      const under = (p) => (pcS.budget === p ? "exactly their budget" : pcGbp(pcS.budget - p) + " under their budget");
      let name = "Nothing fits yet", why = "", alt = "";
      if (!pick) {
        why = "Nothing we offer comes in at " + pcGbp(pcS.budget) + " a month.";
      } else {
        const xs = [];
        if (pick.kind === "pkg") {
          W.platforms.filter((p) => !["Instagram", "Facebook"].concat(us ? ["TikTok"] : []).includes(p)).forEach((p) => xs.push(p));
          if (W.stories) xs.push("Stories and groups");
          if (W.comments) xs.push("comments and messages");
          if (W.pack) xs.push("a " + W.pack + "-post property pack");
        }
        name = pick.name + (xs.length ? " with " + pcList(xs) : "");
        const all = pick.score >= fullScore - 1e-9;
        if (all && pick.kind === "pkg") why = "It covers everything they asked for, at " + pcGbp(pick.price) + " a month, " + under(pick.price) + ".";
        else if (all) why = "Everything they asked for comes to " + pcGbp(pick.price) + " a month, " + under(pick.price) + ". No package matches it, so we'd quote it as it stands.";
        else why = "Their budget doesn't stretch to everything, which is " + pcGbp(full.price) + " a month. The most we can do for " + pcGbp(pcS.budget) + " is " + pcItems(pick.w).join("; ").replace(/^./, (m) => m.toLowerCase()) + ", for " + pcGbp(pick.price) + ". Everything is " + pcGbp(full.price - pick.price) + " a month more.";
        if (!all && us) {
          const own = priceOf(Object.assign({}, W, { maker: "own" }), B, F).price;
          alt = "If they send their own footage instead, everything they asked for is " + pcGbp(own) + " a month" + (own <= pcS.budget ? ", within their budget." : ".");
        }
      }
      pcEl("pc-best").textContent = name; pcEl("pc-why").textContent = why; pcEl("pc-alt").textContent = alt;

      pcEl("pc-pk").innerHTML = pk.map((p) => {
        const diff = pcS.budget - p.withX;
        const tag = diff >= 0 ? `<span class="pc-tag is-ok">${pcGbp(diff)} under</span>` : `<span class="pc-tag is-over">${pcGbp(-diff)} over</span>`;
        const posts = pcList([p.p.v && p.p.v + (p.p.v === 1 ? " reel" : " reels"), p.p.c && p.p.c + (p.p.c === 1 ? " carousel" : " carousels"), p.p.s && p.p.s + (p.p.s === 1 ? " static" : " statics")].filter(Boolean));
        return `<tr${pick && pick.kind === "pkg" && pick.name === p.name ? ' class="is-pick"' : ""}><td>${esc(p.name)}</td><td>${esc(posts)}</td><td class="pc-num">${pcGbp(p.sheet)}</td><td class="pc-num">${us ? pcGbp(p.sheet) : pcGbp(p.worked)}</td><td class="pc-num">${pcGbp(p.withX)}</td><td>${tag}</td></tr>`;
      }).join("");
      pcEl("pc-pk-sheet-h").textContent = us ? "Rate card" : "On the sheet";

      // The working for "everything they asked for".
      const costLines = full.lines.filter((l) => !l.sold);
      const soldLines = full.lines.filter((l) => l.sold);
      const marginTxt = B === "teg" ? "TEG brand: cost plus " + F.margins.teg_markup + "%" : "External agency: " + F.margins.external_margin + "% of the price is margin";
      pcEl("pc-work").innerHTML = costLines.map((l) => `<tr><td>${esc(l.label)}</td><td class="pc-num">${pcGbp(l.amount)}</td></tr>`).join("")
        + (costLines.length ? `<tr class="is-total"><td>Cost a month</td><td class="pc-num">${pcGbp(full.cost)}</td></tr><tr><td>${esc(marginTxt)}</td><td class="pc-num">${pcGbp(sell(full.cost, B, F))}</td></tr>` : "")
        + soldLines.map((l) => `<tr><td>${esc(l.label)}</td><td class="pc-num">${pcGbp(l.amount)}</td></tr>`).join("")
        + `<tr class="is-total"><td>A month, rounded to the nearest £5</td><td class="pc-num">${pcGbp(full.price)}</td></tr>`;

      // Wording for the proposal email, written to the client (they change it before it goes).
      const client = pcClientWording(W, full.price, fit, pick);
      pcEl("pc-prop").textContent = client;
      pcLast = { W, full: full.price, fit: fit ? { w: fit.w, price: fit.price } : null, name, why, pickPrice: pick ? pick.price : null, client };
    }

    // To the client, in their terms: what they asked for, what fits their budget, and the closest package.
    function pcClientDesc(w) {
      const parts = [];
      if (w.v) parts.push(w.v + (w.v === 1 ? " reel" : " reels"));
      if (w.c) parts.push(w.c + (w.c === 1 ? " carousel" : " carousels"));
      if (w.s) parts.push(w.s + (w.s === 1 ? " static post" : " static posts"));
      const bits = [];
      if (parts.length) bits.push(pcList(parts) + " a week" + (w.v ? (w.maker === "us" ? " (we film the reels)" : " (from your own footage)") : "") + " on " + pcList(w.platforms));
      if (w.stories) bits.push("shared to your Stories and 5 groups");
      if (w.comments) bits.push("replies to your comments and messages");
      if (w.pack) bits.push("a property pack of " + w.pack + " posts a month");
      const t = pcList(bits);
      return t.charAt(0).toUpperCase() + t.slice(1);
    }
    function pcClientWording(W, full, fit, pick) {
      const ob = ((PKG_SERVICES.find((x) => x.key === "social-media-management") || {}).onboarding_pence || 11000) / 100;
      const L = [];
      if (full <= pcS.budget || !fit) {
        L.push("What you asked for: " + pcClientDesc(W) + ". " + pcGbp(full) + " a month.");
      } else {
        L.push("Everything you asked for: " + pcClientDesc(W) + ". " + pcGbp(full) + " a month.");
        L.push("Within your " + pcGbp(pcS.budget) + " budget: " + pcClientDesc(fit.w) + ". " + pcGbp(fit.price) + " a month.");
      }
      // A package is named only once it has a real name (Service one, two and three are placeholders).
      if (pick && pick.kind === "pkg" && !/^Service /.test(pick.name)) L.push("The closest of our packages is " + pick.name + ", at " + pcGbp(pick.price) + " a month.");
      L.push("Prices are a month, before VAT, with a one-off onboarding fee of " + pcGbp(ob) + ".");
      return L.join("\n\n");
    }
    function pcQuoteLine(q) {
      if (!q) return "";
      const when = q.at ? " (" + sfDay(q.at) + ")" : "";
      return q.within != null && q.everything > (q.inputs || {}).budget
        ? pcGbp(q.everything) + " a month for everything, " + pcGbp(q.within) + " within their " + pcGbp(q.inputs.budget) + when
        : pcGbp(q.everything) + " a month" + when;
    }

    // Price it, on a client's file: the calculator lent into the pop-out and filled in
    // from what we know about them; their own page goes back as it was afterwards.
    function pcForClient(r, F) {
      if (!pcHome) pcHome = JSON.parse(JSON.stringify(pcS));
      const q = (r.package_details || {}).quote;
      if (q && q.inputs) {
        Object.assign(pcS, JSON.parse(JSON.stringify(q.inputs)));
      } else {
        const notes = (F && (F.pricing || F.discovery)) || {};
        pcS.buyer = r.inter_brand_invoice ? "teg" : "standard";
        const from = notes.platforms ? String(notes.platforms).split(/[,;/]| and /) : (Array.isArray(r.platforms) ? r.platforms : []);
        const plats = from.map((x) => String(x).trim()).map((x) => (/^youtube/i.test(x) ? "YouTube Shorts" : PC_PLATFORMS.find((p) => p.toLowerCase() === x.toLowerCase()))).filter(Boolean);
        pcS.platforms = plats.length ? Array.from(new Set(plats)).sort((a, b) => PC_PLATFORMS.indexOf(a) - PC_PLATFORMS.indexOf(b)) : ["Instagram", "Facebook"];
        const m = String(notes.budget || "").replace(/,/g, "").match(/(\d+(?:\.\d+)?)/);
        if (m) pcS.budget = Math.round(Number(m[1]));
      }
      drawCalc();
      loadPricing().then(drawCalc);
    }
    function pcLeaveClient() {
      if (pcHome) { pcS = pcHome; pcHome = null; }
      setTimeout(drawCalc, 0);
    }
    async function sfSaveQuote(r, btn) {
      const L = pcLast; if (!L) return;
      const plist = pcS.buyer === "teg" ? "TEG brand" : "External agency";
      const quote = { at: new Date().toISOString(), by: sfMyName() || ME || "", inputs: JSON.parse(JSON.stringify(pcS)), everything: L.full, within: L.fit ? L.fit.price : null, best: L.name, best_price: L.pickPrice, wording: L.client };
      const next = Object.assign({}, r.package_details || {}, { quote });
      btn.disabled = true; sfMsg("Saving…");
      if (!isDemo(r)) {
        const { data, error } = await supabase.from("smm_leads").update({ package_details: next }).eq("id", r.id).select("package_details").maybeSingle();
        const back = data && data.package_details && data.package_details.quote;
        if (error || !back || back.at !== quote.at) { btn.disabled = false; sfMsg("Couldn't save it: " + ((error && error.message) || "it didn't come back from the database") + ".", true); return; }
      }
      r.package_details = next;
      const lines = ["Price list: " + plist, "What they want: " + pcItems(L.W).join("; "), "Everything they asked for: " + pcGbp(L.full) + " a month"];
      if (L.fit && L.full > pcS.budget) lines.push("Within their " + pcGbp(pcS.budget) + ": " + pcGbp(L.fit.price) + " a month, " + pcItems(L.fit.w).join("; "));
      if (L.pickPrice != null) lines.push("Best fit: " + L.name + ", " + pcGbp(L.pickPrice) + " a month");
      sfClosePop();
      await sfAutoNote(r, "Proposal pricing", lines.join("\n"));
      loadThread(r);
    }

    function wireCalc() {
      if (pcWired) return; pcWired = true;
      const seg = (id, from, to) => { const b = pcEl(id); for (let i = from; i <= to; i++) b.insertAdjacentHTML("beforeend", `<button type="button" data-v="${i}">${i}</button>`); };
      seg("pc-v", 0, 7); seg("pc-c", 0, 5); seg("pc-s", 0, 5);
      const on = (id, key, kind) => pcEl(id).addEventListener("click", (e) => {
        const b = e.target.closest("button[data-v]"); if (!b) return;
        pcS[key] = kind === "num" ? Number(b.dataset.v) : kind === "bool" ? b.dataset.v === "1" : b.dataset.v;
        drawCalc();
      });
      on("pc-buyer", "buyer", "str"); on("pc-maker", "maker", "str"); on("pc-v", "v", "num"); on("pc-c", "c", "num"); on("pc-s", "s", "num");
      on("pc-stories", "stories", "bool"); on("pc-comments", "comments", "bool"); on("pc-pack", "pack", "num");
      pcEl("pc-plats").addEventListener("click", (e) => {
        const b = e.target.closest("button[data-plat]"); if (!b) return;
        const p = b.dataset.plat, i = pcS.platforms.indexOf(p);
        if (i >= 0) { if (pcS.platforms.length > 1) pcS.platforms.splice(i, 1); } else pcS.platforms.push(p);
        pcS.platforms.sort((a, b2) => PC_PLATFORMS.indexOf(a) - PC_PLATFORMS.indexOf(b2));
        drawCalc();
      });
      const setB = (v) => { pcS.budget = Math.max(0, Math.round(Number(v) || 0)); drawCalc(); };
      pcEl("pc-budget").addEventListener("input", (e) => setB(e.target.value));
      pcEl("pc-budget-r").addEventListener("input", (e) => setB(e.target.value));
      pcEl("pc-copy").addEventListener("click", () => {
        const done = (ok) => { const c = pcEl("pc-copied"); c.className = "pf-status" + (ok ? " is-ok" : " is-bad"); c.textContent = ok ? "Copied." : "Couldn't copy. Select the text instead."; };
        try { navigator.clipboard.writeText(pcEl("pc-prop").textContent).then(() => done(true), () => done(false)); } catch (_) { done(false); }
      });
    }

    // The figures editor: typing keeps a draft; Save writes it; Undo drops it.
    document.addEventListener("input", (e) => {
      const el = e.target.closest && e.target.closest("[data-pf]"); if (!el) return;
      if (!pfDraft) pfDraft = JSON.parse(JSON.stringify(PF));
      const v = el.tagName === "SELECT" ? el.value === "yes" : (el.value === "" ? "" : Number(el.value));
      pfSet(pfDraft, el.dataset.pf, v);
      try { localStorage.setItem(PF_DRAFT_KEY, JSON.stringify(pfDraft)); } catch (_) {}
      pfMarkDirty();
    });
    document.addEventListener("change", (e) => { if (e.target.closest && e.target.closest("select[data-pf]")) e.target.dispatchEvent(new Event("input", { bubbles: true })); });
    document.addEventListener("click", (e) => {
      if (e.target.closest("#pf-save")) pfSave();
      if (e.target.closest("#pf-undo")) { pfDraft = null; try { localStorage.removeItem(PF_DRAFT_KEY); } catch (_) {} drawFigures(); }
    });
  </script>
</AdminShell>
