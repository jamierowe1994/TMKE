---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
---

<AdminShell active="social" title="Social media">
  <div class="ash-panel ash-page">
    <section class="smm-bar">
      <div class="smm-bar-left">
        <div class="smm-filters" id="smm-filters" role="tablist">
          <button type="button" class="smm-chip is-active" data-filter="all">All</button>
          <button type="button" class="smm-chip" data-filter="enquiry">Enquiries</button>
          <button type="button" class="smm-chip" data-filter="brochure">Brochures</button>
          <button type="button" class="smm-chip" data-filter="discovery">Discovery calls</button>
        </div>
      </div>
      <div class="smm-bar-right">
        <label class="smm-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="smm-search" placeholder="Search name, email, business…" aria-label="Search leads" />
        </label>
        <label class="smm-lost-toggle"><input type="checkbox" id="smm-show-lost" /> Show lost</label>
      </div>
    </section>

    <p class="smm-loading" id="smm-loading">Loading pipeline…</p>
    <div class="smm-board" id="smm-board" hidden></div>
  </div>

  <!-- Full-screen customer file -->
  <div class="smm-file-scrim" id="smm-file" hidden>
    <div class="smm-file-card" role="dialog" aria-modal="true" aria-label="Customer file">
      <button type="button" class="smm-file-x" id="smm-file-close" aria-label="Close">&times;</button>
      <div class="smm-file-body" id="smm-file-body"></div>
    </div>
  </div>

  <style is:global>
    /* ---- Toolbar ---- */
    .smm-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; max-width: 1440px; margin: 0 auto; padding: 34px 36px 20px; }
    .smm-bar-left, .smm-bar-right { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .smm-filters { display: inline-flex; gap: 6px; flex-wrap: wrap; }
    .smm-chip { padding: 7px 14px; background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 999px; font-family: var(--sans); font-size: 12px; font-weight: 600; color: rgba(28,29,34,0.7); cursor: pointer; transition: background .15s, border-color .15s, color .15s; }
    .smm-chip:hover { border-color: rgba(var(--violet-rgb),0.4); }
    .smm-chip.is-active { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .smm-search { display: flex; align-items: center; gap: 8px; background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 999px; padding: 8px 14px; min-width: 240px; }
    .smm-search svg { width: 15px; height: 15px; color: rgba(28,29,34,0.42); flex: none; }
    .smm-search input { border: 0; outline: none; background: none; width: 100%; font-family: var(--sans); font-size: 13px; color: var(--ink); }
    .smm-lost-toggle { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); display: inline-flex; align-items: center; gap: 7px; cursor: pointer; }
    .smm-loading { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); padding: 40px 36px; max-width: 1440px; margin: 0 auto; }

    /* ---- Pipeline board ---- */
    .smm-board { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(248px, 1fr); gap: 16px; align-items: start; max-width: 1440px; margin: 0 auto; padding: 6px 36px 160px; overflow-x: auto; }
    .smm-col { background: transparent; }
    .smm-col-head { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding: 0 4px 12px; position: sticky; top: 0; }
    .smm-col-name { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .smm-col-count { font-family: var(--sans); font-size: 11px; font-weight: 700; color: rgba(28,29,34,0.5); background: rgba(28,29,34,0.06); border-radius: 999px; padding: 1px 8px; }
    .smm-col-body { display: flex; flex-direction: column; gap: 10px; min-height: 40px; }
    .smm-col-empty { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.35); padding: 14px 4px; }
    .smm-card { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; padding: 14px 15px; cursor: pointer; transition: border-color .16s, transform .16s, box-shadow .16s; }
    .smm-card:hover { border-color: rgba(var(--violet-rgb),0.45); transform: translateY(-1px); box-shadow: 0 10px 24px -18px rgba(28,29,34,0.4); }
    .smm-card-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 6px; }
    .smm-kind { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; padding: 2px 7px; border-radius: 999px; background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-kind.is-discovery { background: rgba(47,158,94,0.12); color: #2c7a4b; }
    .smm-kind.is-brochure { background: rgba(227,160,8,0.14); color: #9a6a04; }
    .smm-card-when { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.42); }
    .smm-card-name { font-family: var(--sans); font-size: 14.5px; font-weight: 600; color: var(--ink); }
    .smm-card-biz { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); margin-top: 1px; }
    .smm-card-meta { font-family: var(--sans); font-size: 11.5px; color: var(--english-violet); margin-top: 8px; display: inline-flex; align-items: center; gap: 5px; }
    .smm-card-meta svg { width: 12px; height: 12px; }

    /* ---- Full-screen customer file ---- */
    .smm-file-scrim { position: fixed; inset: 0; z-index: 200; background: rgba(20,18,26,0.5); display: flex; align-items: stretch; justify-content: center; padding: 28px; }
    .smm-file-scrim[hidden] { display: none; }
    .smm-file-card { position: relative; width: min(1100px, 100%); background: #fff; border-radius: 14px; box-shadow: 0 40px 100px rgba(20,18,26,0.4); overflow-y: auto; padding: 34px 40px 48px; }
    .smm-file-x { position: absolute; top: 20px; right: 24px; background: none; border: 0; font-size: 30px; line-height: 1; color: rgba(28,29,34,0.4); cursor: pointer; }
    .smm-file-x:hover { color: var(--ink); }
    .smm-file-head { margin: 0 40px 22px 0; }
    .smm-file-name { font-family: var(--serif); font-weight: 500; font-size: 30px; color: var(--ink); margin: 0; }
    .smm-file-sub { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); margin: 4px 0 0; }

    /* Pipeline stepper */
    .smm-pipe { position: relative; display: flex; margin: 8px 0 40px; padding-top: 4px; }
    .smm-pipe-track { position: absolute; top: 10px; left: 7px; right: 7px; height: 2px; background: rgba(28,29,34,0.12); }
    .smm-pipe-fill { position: absolute; left: 0; top: 0; height: 100%; background: var(--english-violet); transition: width .25s; }
    .smm-pipe-step { position: absolute; top: 4px; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; gap: 8px; cursor: pointer; }
    .smm-pipe-step--first { transform: translateX(0); align-items: flex-start; }
    .smm-pipe-step--last { transform: translateX(-100%); align-items: flex-end; }
    .smm-pipe-dot { width: 14px; height: 14px; border-radius: 50%; background: #fff; border: 2px solid rgba(28,29,34,0.25); position: relative; z-index: 1; transition: background .18s, border-color .18s, box-shadow .18s; }
    .smm-pipe-step.is-done .smm-pipe-dot { background: var(--english-violet); border-color: var(--english-violet); }
    .smm-pipe-step.is-current .smm-pipe-dot { box-shadow: 0 0 0 4px rgba(var(--violet-rgb),0.18); }
    .smm-pipe-label { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.5); white-space: nowrap; }
    .smm-pipe-step.is-done .smm-pipe-label, .smm-pipe-step.is-current .smm-pipe-label { color: var(--ink); font-weight: 600; }
    .smm-pipe-step:hover .smm-pipe-label { color: var(--english-violet); }

    /* File layout */
    .smm-file-grid { display: grid; grid-template-columns: 300px 1fr; gap: 32px; }
    @media (max-width: 820px) { .smm-file-grid { grid-template-columns: 1fr; } }
    .smm-sec { border-top: 1px solid rgba(28,29,34,0.09); padding: 18px 0; }
    .smm-sec:first-child { border-top: 0; padding-top: 0; }
    .smm-sec-h { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.5); margin: 0 0 12px; }
    .smm-field { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 7px 0; border-bottom: 1px dashed rgba(28,29,34,0.09); font-family: var(--sans); font-size: 14px; color: var(--ink); }
    .smm-field:last-child { border-bottom: 0; }
    .smm-field-k { color: rgba(28,29,34,0.5); flex: 0 0 auto; font-size: 13px; }
    .smm-field-v { display: inline-flex; align-items: center; gap: 6px; text-align: right; min-width: 0; }
    .smm-field-v a { color: var(--english-violet); text-decoration: none; }
    .smm-copy { background: none; border: 0; padding: 3px; border-radius: 6px; color: rgba(28,29,34,0.4); cursor: pointer; display: inline-flex; transition: background .15s, color .15s; }
    .smm-copy:hover { background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-copy svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 1.8; }
    .smm-copy.is-done { color: #2c7a4b; }
    .smm-notes { width: 100%; min-height: 90px; padding: 12px 14px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 14px; line-height: 1.55; color: var(--ink); background: #fff; resize: vertical; box-sizing: border-box; }
    .smm-notes:focus { outline: none; border-color: var(--english-violet); }
    .smm-notes-status { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.5); margin-top: 6px; }
    .smm-msg { background: rgba(var(--violet-rgb),0.04); border-left: 3px solid var(--english-violet); padding: 14px 16px; border-radius: 6px; font-family: var(--sans); font-size: 14px; line-height: 1.6; color: var(--ink); white-space: pre-wrap; }
    .smm-soon { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.45); line-height: 1.6; }
    .smm-file-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 6px; }
    .smm-btn { display: inline-flex; align-items: center; gap: 7px; padding: 9px 15px; border-radius: 8px; font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.02em; cursor: pointer; border: 1px solid rgba(var(--violet-rgb),0.3); background: #fff; color: var(--english-violet); text-decoration: none; transition: background .15s, border-color .15s, color .15s; }
    .smm-btn:hover { background: rgba(var(--violet-rgb),0.06); }
    .smm-btn--primary { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .smm-btn--primary:hover { background: var(--ink); color: #fff; }
    .smm-btn--danger { border-color: #a05a3c; color: #a05a3c; }
    .smm-btn--danger:hover { background: #a05a3c; color: #fff; }

    /* ---- Thread: notes / emails / documents ---- */
    .smm-thread-status { font-family: var(--sans); font-size: 12.5px; margin: 10px 0 0; }
    .smm-add { display: flex; flex-direction: column; gap: 8px; margin-bottom: 14px; }
    .smm-add textarea, .smm-add input[type=text] { width: 100%; box-sizing: border-box; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 13.5px; line-height: 1.5; color: var(--ink); background: #fff; resize: vertical; }
    .smm-add textarea:focus, .smm-add input[type=text]:focus { outline: none; border-color: var(--english-violet); }
    .smm-add-row { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex-wrap: wrap; }

    /* Notes feed */
    .smm-note { border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; padding: 11px 13px; margin-bottom: 8px; background: #fff; }
    .smm-note.is-pinned { border-color: rgba(var(--violet-rgb),0.35); background: rgba(var(--violet-rgb),0.04); }
    .smm-note-body { font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: var(--ink); white-space: pre-wrap; }
    .smm-note-foot { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-top: 8px; }
    .smm-note-meta { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); display: inline-flex; align-items: center; gap: 6px; }
    .smm-pin-badge { color: var(--english-violet); font-weight: 700; }
    .smm-note-tools { display: inline-flex; gap: 4px; }
    .smm-mini { background: none; border: 0; padding: 3px 7px; border-radius: 6px; font-family: var(--sans); font-size: 11.5px; font-weight: 600; color: rgba(28,29,34,0.5); cursor: pointer; transition: background .15s, color .15s; }
    .smm-mini:hover { background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); }
    .smm-mini.is-danger:hover { background: rgba(160,90,60,0.12); color: #a05a3c; }

    /* Email dialogue */
    .smm-mail { max-width: 88%; margin-bottom: 10px; padding: 11px 14px; border-radius: 12px; font-family: var(--sans); }
    .smm-mail.is-in { background: rgba(28,29,34,0.045); border: 1px solid rgba(28,29,34,0.08); border-top-left-radius: 4px; margin-right: auto; }
    .smm-mail.is-out { background: rgba(var(--violet-rgb),0.07); border: 1px solid rgba(var(--violet-rgb),0.16); border-top-right-radius: 4px; margin-left: auto; }
    .smm-mail-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 5px; }
    .smm-mail-who { font-size: 11.5px; font-weight: 700; color: rgba(28,29,34,0.6); display: inline-flex; align-items: center; gap: 6px; }
    .smm-mail-badge { font-size: 9px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 1px 6px; border-radius: 999px; background: rgba(28,29,34,0.08); color: rgba(28,29,34,0.55); }
    .smm-mail-when { font-size: 11px; color: rgba(28,29,34,0.42); }
    .smm-mail-subj { font-size: 13px; font-weight: 700; color: var(--ink); margin-bottom: 2px; }
    .smm-mail-body { font-size: 13.5px; line-height: 1.55; color: var(--ink); white-space: pre-wrap; }
    .smm-mail-empty, .smm-doc-empty { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.4); padding: 4px 0 10px; }
    .smm-hint { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); margin: 2px 0 0; }

    /* Documents */
    .smm-doc { display: flex; align-items: center; gap: 10px; padding: 9px 12px; border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; margin-bottom: 7px; }
    .smm-doc-ico { width: 26px; height: 26px; flex: none; border-radius: 6px; background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); display: inline-flex; align-items: center; justify-content: center; }
    .smm-doc-ico svg { width: 14px; height: 14px; }
    .smm-doc-main { min-width: 0; flex: 1; }
    .smm-doc-name { font-family: var(--sans); font-size: 13px; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .smm-doc-cat { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.45); }
    .smm-doc-tools { display: inline-flex; gap: 2px; flex: none; }
    .smm-docadd { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 10px; }
    .smm-docadd select { padding: 8px 10px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 12.5px; color: var(--ink); background: #fff; }
    .smm-file-input { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.6); }
    .smm-file-input::file-selector-button { margin-right: 10px; padding: 8px 13px; border-radius: 8px; border: 1px solid rgba(var(--violet-rgb),0.3); background: #fff; color: var(--english-violet); font-family: var(--sans); font-size: 12.5px; font-weight: 700; cursor: pointer; }
    .smm-file-input::file-selector-button:hover { background: rgba(var(--violet-rgb),0.06); }

    /* Client status */
    .smm-status-row { display: flex; gap: 8px; flex-wrap: wrap; }
    .smm-status-pill { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; padding: 3px 10px; border-radius: 999px; margin-left: 12px; vertical-align: middle; position: relative; top: -3px; }
    .smm-card-status { display: inline-block; margin-top: 8px; font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; }
    .smm-status-pill.is-active, .smm-card-status.is-active { background: rgba(47,158,94,0.14); color: #2c7a4b; }
    .smm-status-pill.is-paused, .smm-card-status.is-paused { background: rgba(227,160,8,0.16); color: #9a6a04; }
    .smm-status-pill.is-ended, .smm-card-status.is-ended { background: rgba(28,29,34,0.09); color: rgba(28,29,34,0.55); }
  </style>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { supabase } from "../../lib/supabase.js";

    const STAGES = [
      { key: "inquiry", label: "Inquiry" },
      { key: "meeting_set", label: "Meeting set" },
      { key: "contract_sent", label: "Contract sent" },
      { key: "contract_signed", label: "Contract signed" },
      { key: "active_client", label: "Active client" },
    ];
    const STAGE_INDEX = Object.fromEntries(STAGES.map((s, i) => [s.key, i]));
    const KIND_LABEL = { enquiry: "Enquiry", brochure: "Brochure", discovery: "Discovery call" };
    const CLIENT_STATUS = { active: "Active", paused: "Paused", ended: "Ended" };

    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    const nameOf = (r) => (r.full_name || `${r.first_name || ""} ${r.last_name || ""}`).trim() || "—";
    function fmtWhen(iso) {
      if (!iso) return "";
      const d = new Date(iso), diff = (Date.now() - d) / 1000;
      if (diff < 3600) return Math.max(1, Math.floor(diff / 60)) + "m";
      if (diff < 86400) return Math.floor(diff / 3600) + "h";
      if (diff < 604800) return Math.floor(diff / 86400) + "d";
      return d.toLocaleDateString("en-GB", { day: "numeric", month: "short" });
    }
    const fmtDateTime = (iso) => { try { return new Date(iso).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }); } catch (_) { return ""; } };
    const stageOf = (r) => (r.pipeline_stage && STAGE_INDEX[r.pipeline_stage] != null ? r.pipeline_stage : "inquiry");

    let all = [], kindFilter = "all", q = "", showLost = false, current = null;

    // ---------- Board ----------
    function visible() {
      return all
        .filter((r) => showLost ? true : r.pipeline_stage !== "lost" && r.status !== "spam")
        .filter((r) => kindFilter === "all" || r.kind === kindFilter)
        .filter((r) => !q || (nameOf(r) + " " + (r.email || "") + " " + (r.business || "")).toLowerCase().includes(q));
    }
    function renderBoard() {
      const board = $("smm-board");
      const rows = visible();
      board.innerHTML = STAGES.map((s) => {
        const cards = rows.filter((r) => stageOf(r) === s.key);
        return `<div class="smm-col">
          <div class="smm-col-head"><span class="smm-col-name">${esc(s.label)}</span><span class="smm-col-count">${cards.length}</span></div>
          <div class="smm-col-body">${cards.length ? cards.map(cardHtml).join("") : '<div class="smm-col-empty">—</div>'}</div>
        </div>`;
      }).join("");
      board.querySelectorAll("[data-id]").forEach((el) => el.addEventListener("click", () => openFile(el.getAttribute("data-id"))));
    }
    function cardHtml(r) {
      const kc = r.kind === "discovery" ? " is-discovery" : r.kind === "brochure" ? " is-brochure" : "";
      const when = r.kind === "discovery" && r.call_at ? `<span class="smm-card-meta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg>${esc(fmtDateTime(r.call_at))}</span>`
        : r.meeting_at ? `<span class="smm-card-meta"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="17" rx="2"/><line x1="3" y1="9" x2="21" y2="9"/></svg>Meeting ${esc(fmtDateTime(r.meeting_at))}</span>` : "";
      const cstatus = r.client_status && r.client_status !== "active" ? `<span class="smm-card-status is-${r.client_status}">${esc(CLIENT_STATUS[r.client_status] || r.client_status)}</span>` : "";
      return `<div class="smm-card" data-id="${esc(r.id)}">
        <div class="smm-card-top"><span class="smm-kind${kc}">${esc(KIND_LABEL[r.kind] || r.kind || "Lead")}</span><span class="smm-card-when">${esc(fmtWhen(r.created_at))}</span></div>
        <div class="smm-card-name">${esc(nameOf(r))}</div>
        ${r.business ? `<div class="smm-card-biz">${esc(r.business)}</div>` : ""}
        ${when}${cstatus}
      </div>`;
    }

    // ---------- Customer file ----------
    const COPY_SVG = '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
    function copyField(label, value, href) {
      if (!value) return `<div class="smm-field"><span class="smm-field-k">${esc(label)}</span><span class="smm-field-v">—</span></div>`;
      const shown = href ? `<a href="${esc(href)}">${esc(value)}</a>` : esc(value);
      return `<div class="smm-field"><span class="smm-field-k">${esc(label)}</span><span class="smm-field-v">${shown}<button type="button" class="smm-copy" data-copy="${esc(value)}" title="Copy">${COPY_SVG}</button></span></div>`;
    }
    function openFile(id) {
      const r = all.find((x) => x.id === id); if (!r) return;
      current = r;
      const idx = STAGE_INDEX[stageOf(r)];
      const n = STAGES.length;
      const pipe = `<div class="smm-pipe"><div class="smm-pipe-track"><div class="smm-pipe-fill" style="width:${(idx / (n - 1)) * 100}%"></div></div>${STAGES.map((s, i) => {
        const cls = (i <= idx ? " is-done" : "") + (i === idx ? " is-current" : "") + (i === 0 ? " smm-pipe-step--first" : "") + (i === n - 1 ? " smm-pipe-step--last" : "");
        return `<div class="smm-pipe-step${cls}" data-stage="${s.key}" style="left:${(i / (n - 1)) * 100}%"><span class="smm-pipe-dot"></span><span class="smm-pipe-label">${esc(s.label)}</span></div>`;
      }).join("")}</div>`;
      const acct = r.account_created ? "Created at submission" : (r.account_user_id ? "Existing account" : "None");
      const isActive = idx === n - 1;
      const cs = r.client_status || "active";
      $("smm-file-body").innerHTML = `
        <header class="smm-file-head">
          <h2 class="smm-file-name">${esc(nameOf(r))}${isActive ? `<span class="smm-status-pill is-${cs}">${esc(CLIENT_STATUS[cs])}</span>` : ""}</h2>
          <p class="smm-file-sub">${esc(r.business || KIND_LABEL[r.kind] || "Lead")}</p>
        </header>
        ${pipe}
        <div class="smm-file-grid">
          <div>
            <div class="smm-sec">
              <h3 class="smm-sec-h">Contact</h3>
              ${copyField("Email", r.email, "mailto:" + (r.email || ""))}
              ${copyField("Phone", r.phone, r.phone ? "tel:" + r.phone : "")}
              ${copyField("Business", r.business)}
              <div class="smm-field"><span class="smm-field-k">Type</span><span class="smm-field-v"><span class="smm-kind">${esc(KIND_LABEL[r.kind] || r.kind || "Lead")}</span></span></div>
              <div class="smm-field"><span class="smm-field-k">Received</span><span class="smm-field-v">${esc(fmtDateTime(r.created_at))}</span></div>
              ${r.call_at ? `<div class="smm-field"><span class="smm-field-k">Discovery call</span><span class="smm-field-v">${esc(fmtDateTime(r.call_at))}</span></div>` : ""}
              <div class="smm-field"><span class="smm-field-k">Marketing</span><span class="smm-field-v">${r.marketing_opt_in ? "Opted in" : "Not opted in"}</span></div>
              <div class="smm-field"><span class="smm-field-k">Account</span><span class="smm-field-v">${esc(acct)}</span></div>
            </div>
            <div class="smm-sec">
              <h3 class="smm-sec-h">${isActive ? "Client status" : "Actions"}</h3>
              ${isActive ? `<div class="smm-status-row">
                <button type="button" class="smm-btn ${cs === "active" ? "smm-btn--primary" : ""}" data-cstatus="active">Active</button>
                <button type="button" class="smm-btn ${cs === "paused" ? "smm-btn--primary" : ""}" data-cstatus="paused">Paused</button>
                <button type="button" class="smm-btn ${cs === "ended" ? "smm-btn--primary" : ""}" data-cstatus="ended">Ended</button>
              </div>
              <p class="smm-hint">Sets the CRM tag <strong>SMM-Status: ${esc(CLIENT_STATUS[cs])}</strong>${cs === "active" ? " and marks them a Customer" : ""}.</p>` : ""}
              <div class="smm-file-actions"${isActive ? ' style="margin-top:12px"' : ""}>
                <button type="button" class="smm-btn smm-btn--danger" data-lost>Mark lost</button>
              </div>
            </div>
          </div>
          <div>
            ${r.message ? `<div class="smm-sec"><h3 class="smm-sec-h">Their message</h3><div class="smm-msg">${esc(r.message)}</div></div>` : ""}
            <div id="smm-thread"><div class="smm-sec"><p class="smm-soon">Loading correspondence…</p></div></div>
          </div>
        </div>`;
      $("smm-file").hidden = false;
      document.body.style.overflow = "hidden";
      wireFile(r);
    }
    function closeFile() { $("smm-file").hidden = true; current = null; document.body.style.overflow = ""; }

    function wireFile(r) {
      // Quick-copy
      $("smm-file-body").querySelectorAll("[data-copy]").forEach((b) => b.addEventListener("click", async (e) => {
        e.stopPropagation();
        try { await navigator.clipboard.writeText(b.getAttribute("data-copy")); b.classList.add("is-done"); setTimeout(() => b.classList.remove("is-done"), 1200); } catch (_) {}
      }));
      // Pipeline advance
      $("smm-file-body").querySelectorAll("[data-stage]").forEach((s) => s.addEventListener("click", () => setStage(r, s.getAttribute("data-stage"))));
      // Mark lost
      $("smm-file-body").querySelector("[data-lost]")?.addEventListener("click", () => setStage(r, "lost"));
      // Client status (active / paused / ended)
      $("smm-file-body").querySelectorAll("[data-cstatus]").forEach((b) => b.addEventListener("click", () => setClientStatus(r, b.getAttribute("data-cstatus"))));
      // Correspondence (notes / emails / documents)
      loadThread(r);
    }
    async function setStage(r, stage) {
      r.pipeline_stage = stage;
      if (!isDemo(r)) { try { await supabase.from("smm_leads").update({ pipeline_stage: stage }).eq("id", r.id); } catch (_) {} }
      // Landing on Active client tags them Active + Customer in the CRM.
      if (stage === "active_client") { if (!r.client_status) r.client_status = "active"; pushClientStatus(r, "active"); }
      renderBoard();
      if (stage === "lost") closeFile(); else openFile(r.id);
    }
    async function pushClientStatus(r, status) {
      if (isDemo(r)) return;
      try { const token = await authToken(); await fetch(`${WORKER}/smm/status`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ lead_id: r.id, status }) }); } catch (_) {}
    }
    async function setClientStatus(r, status) {
      r.client_status = status;
      await pushClientStatus(r, status);
      renderBoard(); openFile(r.id);
    }

    // ---------- Correspondence: notes, emails, documents ----------
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const SMM_CATS = [["agreement", "Contract"], ["prep", "Proposal"], ["invoice", "Invoice"], ["delivery", "Deliverables"], ["other", "Other"]];
    const catLabel = (c) => (SMM_CATS.find((x) => x[0] === c) || [, "Document"])[1];
    const isDemo = (r) => String(r.id).startsWith("demo");
    async function authToken() { try { return (await supabase.auth.getSession()).data.session?.access_token || ""; } catch (_) { return ""; } }
    const DOC_SVG = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>';

    function threadStatus(msg, ok) {
      const el = $("smm-thread-status"); if (!el) return;
      el.hidden = !msg; el.textContent = msg || ""; el.style.color = ok === false ? "#a05a3c" : "var(--english-violet)";
    }
    async function loadThread(r) {
      const host = $("smm-thread"); if (!host) return;
      if (isDemo(r)) { r._thread = r._thread || { messages: [], documents: [] }; renderThread(r, r._thread); return; }
      if (!WORKER) { renderThread(r, { messages: [], documents: [] }, "Connect the Worker (PUBLIC_R2_WORKER_URL) to log emails, notes and documents."); return; }
      host.innerHTML = '<div class="smm-sec"><p class="smm-soon">Loading correspondence…</p></div>';
      let data = { messages: [], documents: [] };
      try { const token = await authToken(); const res = await fetch(`${WORKER}/booking/thread?booking_id=${encodeURIComponent(r.id)}`, { headers: { Authorization: "Bearer " + token } }); if (res.ok) data = await res.json(); } catch (_) {}
      renderThread(r, data);
    }
    function renderThread(r, data, warn) {
      const host = $("smm-thread"); if (!host) return;
      const msgs = data.messages || [], docs = data.documents || [];
      const notes = msgs.filter((m) => m.channel === "note")
        .sort((a, b) => (b.is_pinned ? 1 : 0) - (a.is_pinned ? 1 : 0) || new Date(a.created_at) - new Date(b.created_at));
      const emails = msgs.filter((m) => m.channel === "email" || m.channel === "system")
        .sort((a, b) => new Date(a.created_at) - new Date(b.created_at));

      const noteHtml = notes.map((m) => {
        const who = m.created_by && m.created_by !== "system" ? m.created_by : "You";
        return `<div class="smm-note ${m.is_pinned ? "is-pinned" : ""}">
          <div class="smm-note-body">${esc(m.body || "").replace(/\n/g, "<br>")}</div>
          <div class="smm-note-foot">
            <span class="smm-note-meta">${m.is_pinned ? '<span class="smm-pin-badge">Pinned</span> · ' : ""}${esc(who)} · ${esc(fmtWhen(m.created_at))}</span>
            <span class="smm-note-tools">
              <button type="button" class="smm-mini" data-pin="${esc(m.id)}" data-pinned="${m.is_pinned ? 1 : 0}">${m.is_pinned ? "Unpin" : "Pin"}</button>
              <button type="button" class="smm-mini is-danger" data-delnote="${esc(m.id)}">Delete</button>
            </span>
          </div>
        </div>`;
      }).join("") || `<p class="smm-mail-empty">No notes yet.</p>`;

      const mailHtml = emails.map((m) => {
        const out = m.direction !== "inbound";
        const who = m.is_automated ? "TMKE (automated)" : (out ? (m.created_by && m.created_by !== "system" ? m.created_by : "TMKE") : (r.email || "Client"));
        return `<div class="smm-mail ${out ? "is-out" : "is-in"}">
          <div class="smm-mail-head"><span class="smm-mail-who">${esc(who)}${m.is_automated ? '<span class="smm-mail-badge">Auto</span>' : ""}</span><span class="smm-mail-when">${esc(fmtWhen(m.created_at))}</span></div>
          ${m.subject ? `<div class="smm-mail-subj">${esc(m.subject)}</div>` : ""}
          <div class="smm-mail-body">${esc(m.body || "").replace(/\n/g, "<br>")}</div>
        </div>`;
      }).join("") || `<p class="smm-mail-empty">No emails logged yet.</p>`;

      const docHtml = docs.map((d) => `<div class="smm-doc">
        <span class="smm-doc-ico">${DOC_SVG}</span>
        <span class="smm-doc-main"><span class="smm-doc-name">${esc(d.title || d.file_name)}</span><span class="smm-doc-cat">${esc(catLabel(d.category))}</span></span>
        <span class="smm-doc-tools">
          <button type="button" class="smm-mini" data-docdl="${esc(d.id)}" data-docname="${esc(d.file_name || "document")}">Download</button>
          <button type="button" class="smm-mini is-danger" data-docdel="${esc(d.id)}">Remove</button>
        </span>
      </div>`).join("") || `<p class="smm-doc-empty">No documents attached.</p>`;

      host.innerHTML = `
        ${warn ? `<div class="smm-sec"><p class="smm-soon">${esc(warn)}</p></div>` : ""}
        <div class="smm-sec">
          <h3 class="smm-sec-h">Notes</h3>
          <div class="smm-add">
            <textarea id="smm-note-input" rows="2" placeholder="Add an internal note…"></textarea>
            <div class="smm-add-row"><span></span><button type="button" class="smm-btn" id="smm-note-add">Add note</button></div>
          </div>
          ${noteHtml}
        </div>
        <div class="smm-sec">
          <h3 class="smm-sec-h">Emails</h3>
          ${mailHtml}
          <div class="smm-add" style="margin-top:14px">
            <input type="text" id="smm-mail-subj" placeholder="Subject" />
            <textarea id="smm-mail-body" rows="3" placeholder="Write an email to ${esc(r.email || "the client")}…"></textarea>
            <input type="file" id="smm-mail-file" class="smm-file-input" />
            <div class="smm-add-row">
              <p class="smm-hint">Sends from the TMKE inbox and logs to this file.</p>
              <button type="button" class="smm-btn smm-btn--primary" id="smm-mail-send">Send email</button>
            </div>
          </div>
        </div>
        <div class="smm-sec">
          <h3 class="smm-sec-h">Documents</h3>
          ${docHtml}
          <div class="smm-docadd">
            <select id="smm-doc-cat">${SMM_CATS.map((c) => `<option value="${c[0]}">${c[1]}</option>`).join("")}</select>
            <input type="file" id="smm-doc-file" class="smm-file-input" />
            <button type="button" class="smm-btn" id="smm-doc-up">Attach</button>
          </div>
        </div>
        <p class="smm-thread-status" id="smm-thread-status" hidden></p>`;

      $("smm-note-add")?.addEventListener("click", () => addNote(r));
      $("smm-mail-send")?.addEventListener("click", () => sendEmail(r));
      $("smm-doc-up")?.addEventListener("click", () => uploadDoc(r));
      host.querySelectorAll("[data-pin]").forEach((b) => b.addEventListener("click", () => pinNote(r, b.getAttribute("data-pin"), b.getAttribute("data-pinned") !== "1")));
      host.querySelectorAll("[data-delnote]").forEach((b) => b.addEventListener("click", () => delNote(r, b.getAttribute("data-delnote"))));
      host.querySelectorAll("[data-docdl]").forEach((b) => b.addEventListener("click", () => downloadDoc(b.getAttribute("data-docdl"), b.getAttribute("data-docname"))));
      host.querySelectorAll("[data-docdel]").forEach((b) => b.addEventListener("click", () => deleteDoc(r, b.getAttribute("data-docdel"))));
    }

    async function addNote(r) {
      const ta = $("smm-note-input"); const body = (ta?.value || "").trim(); if (!body) return;
      if (isDemo(r)) { r._thread.messages.push({ id: "n" + Date.now(), channel: "note", body, is_pinned: false, created_by: "You", created_at: new Date().toISOString() }); renderThread(r, r._thread); return; }
      const btn = $("smm-note-add"); btn.disabled = true;
      try { const token = await authToken(); const res = await fetch(`${WORKER}/booking/message`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: r.id, source: "smm", body }) }); if (!res.ok) throw 0; loadThread(r); }
      catch (_) { threadStatus("Couldn't save note.", false); btn.disabled = false; }
    }
    async function pinNote(r, id, pinned) {
      if (isDemo(r)) { const m = r._thread.messages.find((x) => x.id === id); if (m) m.is_pinned = pinned; renderThread(r, r._thread); return; }
      try { const token = await authToken(); await fetch(`${WORKER}/booking/message/pin`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ id, pinned }) }); loadThread(r); } catch (_) {}
    }
    async function delNote(r, id) {
      if (!confirm("Delete this note?")) return;
      if (isDemo(r)) { r._thread.messages = r._thread.messages.filter((x) => x.id !== id); renderThread(r, r._thread); return; }
      try { const token = await authToken(); await fetch(`${WORKER}/booking/message?id=${encodeURIComponent(id)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } }); loadThread(r); } catch (_) {}
    }
    async function sendEmail(r) {
      const subject = ($("smm-mail-subj")?.value || "").trim();
      const body = ($("smm-mail-body")?.value || "").trim();
      const fileEl = $("smm-mail-file"); const file = fileEl && fileEl.files && fileEl.files[0];
      if (!body && !file) return;
      if (isDemo(r)) { r._thread.messages.push({ id: "e" + Date.now(), channel: "email", direction: "outbound", subject, body: body || `Attachment: ${file.name}`, is_automated: false, created_by: "You", created_at: new Date().toISOString() }); if (file) r._thread.documents.push({ id: "d" + Date.now(), file_name: file.name, category: "other" }); renderThread(r, r._thread); return; }
      const btn = $("smm-mail-send"); btn.disabled = true; btn.textContent = "Sending…";
      try {
        const token = await authToken();
        let documentId = null;
        if (file) {
          const qs = new URLSearchParams({ booking_id: r.id, source: "smm", category: "other", file_name: file.name, content_type: file.type || "application/octet-stream" });
          const up = await fetch(`${WORKER}/booking/document?${qs.toString()}`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": file.type || "application/octet-stream" }, body: file });
          if (up.ok) { const j = await up.json().catch(() => ({})); documentId = j.document ? j.document.id : null; }
        }
        const res = await fetch(`${WORKER}/booking/message`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: r.id, source: "smm", subject, body: body || `I've attached a document for you: ${file.name}`, notify: true, document_id: documentId }) });
        if (!res.ok) throw 0; loadThread(r);
      } catch (_) { threadStatus("Couldn't send email.", false); btn.disabled = false; btn.textContent = "Send email"; }
    }
    async function uploadDoc(r) {
      const fileEl = $("smm-doc-file"); const file = fileEl && fileEl.files && fileEl.files[0];
      const cat = $("smm-doc-cat")?.value || "other";
      if (!file) { threadStatus("Choose a file first.", false); return; }
      if (isDemo(r)) { r._thread.documents.push({ id: "d" + Date.now(), file_name: file.name, category: cat }); renderThread(r, r._thread); return; }
      const btn = $("smm-doc-up"); btn.disabled = true; btn.textContent = "Uploading…";
      try { const token = await authToken(); const qs = new URLSearchParams({ booking_id: r.id, source: "smm", category: cat, file_name: file.name, content_type: file.type || "application/octet-stream" }); const res = await fetch(`${WORKER}/booking/document?${qs.toString()}`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": file.type || "application/octet-stream" }, body: file }); if (!res.ok) throw 0; loadThread(r); }
      catch (_) { threadStatus("Couldn't upload.", false); btn.disabled = false; btn.textContent = "Attach"; }
    }
    async function downloadDoc(id, name) {
      if (current && isDemo(current)) return; // demo documents aren't real files
      if (!WORKER) return;
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/booking/document?id=${encodeURIComponent(id)}`, { headers: { Authorization: "Bearer " + token } });
        if (!res.ok) return;
        const blob = await res.blob(); const u = URL.createObjectURL(blob);
        const a = document.createElement("a"); a.href = u; a.download = name || "document"; document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(u);
      } catch (_) {}
    }
    async function deleteDoc(r, id) {
      if (!confirm("Remove this document?")) return;
      if (isDemo(r)) { r._thread.documents = r._thread.documents.filter((x) => x.id !== id); renderThread(r, r._thread); return; }
      try { const token = await authToken(); await fetch(`${WORKER}/booking/document?id=${encodeURIComponent(id)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } }); loadThread(r); } catch (_) {}
    }

    // ---------- Demo data (preview only) ----------
    function demoRows() {
