      const st = $("smm-eng-status"); if (st) st.textContent = "Saving…";
      if (isDemo(r)) { if (st) st.textContent = "Saved (demo)."; return; }
      try { await supabase.from("smm_leads").update({ direct_debit_day: day }).eq("id", r.id); if (st) st.textContent = "Saved."; }
