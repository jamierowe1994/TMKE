      }
      if (F.cs === "paused") return box("Paused", [li(1, "No monthly invoice, no chasing, no missing-report flags"), r.follow_up_on ? li(sfDate(r.follow_up_on) < new Date() ? 0 : 1, `Check-in ${esc((r.follow_up_how || "call").toLowerCase())}: ${esc(sfDayYear(r.follow_up_on))}`) : li(0, "No check-in booked")],
        sfHb(false, 'data-sf="followup"', r.follow_up_on ? "Move the check-in" : "Book a check-in") + sfHb(true, 'data-sf="make-active"', "Make client active"));
      // An active client: this month at a glance.
      const now = F.now, lm = new Date(now.getFullYear(), now.getMonth() - 1, 1);
      const rep = F.reps.find((x) => x.year === lm.getFullYear() && x.month === lm.getMonth());
      const items = [];
      if (sfData.reports) items.push(rep && rep.published_at ? li(1, `${RI_MONTHS[lm.getMonth()]} report published ${esc(sfDay(rep.published_at))}`) : li(0, `${RI_MONTHS[lm.getMonth()]} report ${rep ? "built, not published" : "not uploaded yet"}`));
      const plan = F.plans.find((p) => p.ym === F.ym);
