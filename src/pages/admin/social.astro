      const box = (h, items, acts, cls) => { if (teamsTodo) { items = items.concat(li(0, "Teams link: not added yet")); acts = sfHb(true, 'data-sf="teams-link"', "Add the Teams link") + String(acts || "").replace(/sf-hb sf-hb--primary/g, "sf-hb"); } return box0(h, items, acts, cls); };
      const box0 = (h, items, acts, cls) => `<div class="sf-call${cls ? " " + cls : ""}"><div><h4>${h}</h4>${items.length ? `<ul>${items.join("")}</ul>` : ""}</div>${acts || links ? `<div class="sf-call-side">${links}${acts ? `<div class="sf-call-acts">${acts}</div>` : ""}</div>` : ""}</div>`;
      const reason = r.lost_reason ? esc(r.lost_reason) : "";
      const fu = r.follow_up_on ? li(sfDate(r.follow_up_on) < new Date() ? 0 : 1, `Follow-up: ${esc((r.follow_up_how || "call").toLowerCase())}, ${esc(sfDayYear(r.follow_up_on))}${r.follow_up_by ? ", " + esc(r.follow_up_by) : ""}`) : "";
      const lateH = (h) => F.late ? `Update needed: ${F.quiet} days since anything` : h;
      const lateC = F.late ? "is-late" : "";
      if (F.lost) {
        const back = r.lost_from_stage && r.lost_from_stage !== "active_client" && STAGE_INDEX[r.lost_from_stage] != null ? r.lost_from_stage : "inquiry";
        return box(wasClient(r) ? "Lost, was a client" : "Lost", [reason ? li(1, "Why: " + reason) : "", r.lost_at ? li(1, `Lost ${esc(sfDayYear(r.lost_at))}${r.lost_from_stage ? ", at " + esc(r.lost_from_stage === "active_client" ? "Active client" : sfStageLabel(r.lost_from_stage)) : ""}`) : "", fu].filter(Boolean),
          sfHb(false, 'data-sf="followup"', r.follow_up_on ? "Move the follow-up" : "Schedule a follow-up") + sfHb(true, `data-sf-force="${back}"`, "Bring back"));
      }
      if (r.leaving_on) return box(`${r.leaving_as === "ended" ? "Leaving" : "Lost"} on ${esc(sfDayYear(r.leaving_on))}`, [reason ? li(1, "Why: " + reason) : "", li(0, `On ${esc(sfDay(r.leaving_on))} the card moves to Lost${r.leaving_as === "ended" ? ", was a client" : ""}`)].filter(Boolean), sfHb(false, 'data-sf="cancel-leaving"', "Cancel the date"));
      const st = F.st;
      const name1 = sfFirst(r);
      if (st === "waitlist") return box("On the waitlist", [li(1, `Joined ${esc(sfDay(r.created_at))}`), fu].filter(Boolean), sfHb(true, 'data-sf-force="inquiry"', "Move to Enquiry"), lateC);
      if (st === "inquiry") {
        const base = F.firstReply ? F.firstReply.created_at : r.created_at;
        const src = sfSource(r);
        const items = [li(1, `Enquiry received ${esc(sfDay(r.created_at))}${src ? ", " + esc(/^referral/i.test(src) ? src.replace(/^referral:?\s*/i, "referral from ").replace(/ from $/, "") : (src.split(":")[0].toLowerCase() + (src.includes(":") ? ":" + src.slice(src.indexOf(":") + 1) : ""))) : ""}`),
          F.firstReply ? li(1, `Replied ${esc(sfDay(F.firstReply.created_at))}${F.firstReply.created_by && F.firstReply.created_by !== "system" ? ", by " + esc(sfStaff(F.firstReply.created_by)) : ""}`) : li(0, `Reply due by ${esc(sfDay(sfAddWork(r.created_at, 1)))}`),
          r.meeting_at ? li(1, `Discovery call booked for ${esc(sfWhen(r.meeting_at))}`) : li(0, `Discovery call booked: due by ${esc(sfDay(sfAddDays(base, 5)))}`), fu].filter(Boolean);
        return box(lateH(r.meeting_at ? "Discovery call booked" : "Next: book the discovery call"), items,
          r.meeting_at ? sfHb(true, 'data-sf-force="meeting_set"', "Move to Discovery call") : sfHb(false, 'data-sf-force="meeting_set"', "Move to Discovery call") + sfHb(true, 'data-sf="book-call"', "Book the discovery call"), lateC);
      }
      if (st === "meeting_set") {
