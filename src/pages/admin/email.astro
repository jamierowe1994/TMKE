---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin.css";
import PageHero from "../../components/PageHero.astro";
import AdminBack from "../../components/AdminBack.astro";
---

<BaseLayout
  title="Email studio — Admin · TMKE"
  description="Build, save, and send branded email templates — TMKE's in-house mailer."
  hideNav
  hideFooter
>
  <div class="admin-hero-pad">
    <PageHero
      chapter="Admin — Email"
      title="The <em>email studio.</em>"
      sub="Build branded emails from blocks, save them as templates, and send a test. Confirmation triggers and newsletters build on these."
    />
  </div>

  <section class="admin-bar wrap">
    <AdminBack />
    <div class="admin-bar-actions">
      <div class="enquiry-chips" role="tablist">
        <button type="button" class="enquiry-chip is-active" data-filter="all">All</button>
        <button type="button" class="enquiry-chip" data-filter="active">Active</button>
        <button type="button" class="enquiry-chip" data-filter="draft">Drafts</button>
        <button type="button" class="enquiry-chip" data-filter="archived">Archived</button>
      </div>
      <input type="search" id="em-search" class="admin-search" placeholder="Search name, subject, trigger…" />
      <span class="admin-bar-count" id="em-count">…</span>
      <button type="button" id="em-seed" class="admin-btn admin-btn-ghost">Load starter templates</button>
      <a href="/admin/email/editor?id=new" class="admin-btn admin-btn-primary">+ New template</a>
    </div>
  </section>

  <section class="em-list wrap" id="em-list" aria-busy="true">
    <p class="em-state" id="em-loading">Loading templates…</p>
    <p class="em-state" id="em-empty" hidden>No templates yet. Hit <strong>+ New template</strong> to build your first one.</p>
    <p class="em-state" id="em-error" hidden></p>
    <div class="em-table" id="em-table" role="table"></div>
  </section>

  <style is:global>
    .admin-hero-pad { padding-top: 100px; }
    @media (max-width: 720px) { .admin-hero-pad { padding-top: 56px; } }

    .admin-bar {
      display: flex; justify-content: space-between; align-items: center;
      gap: 16px; max-width: 1360px; margin: 0 auto; padding: 0 36px 16px;
    }
    .admin-bar-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .admin-search {
      padding: 8px 12px; border: 1px solid rgba(55, 30, 40, 0.3); border-radius: 2px;
      font-family: var(--sans); font-size: 13px; color: var(--ink);
      background: var(--paper); min-width: 240px;
    }
    .admin-search:focus { outline: none; border-color: var(--english-violet); }
    .admin-bar-count {
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.22em;
      text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.5);
    }
    .enquiry-chips { display: inline-flex; gap: 4px; align-items: center; }
    .enquiry-chip {
      background: transparent; border: 1px solid rgba(28,29,34,0.18);
      padding: 7px 13px; font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.65);
      cursor: pointer; border-radius: 999px;
      transition: background 0.25s, color 0.25s, border-color 0.25s;
    }
    .enquiry-chip:hover { color: var(--ink); }
    .enquiry-chip.is-active { background: var(--ink); color: var(--paper); border-color: var(--ink); }

    .admin-btn {
      padding: 9px 16px; font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; border: 1px solid transparent;
      border-radius: 2px; cursor: pointer; text-decoration: none;
      display: inline-flex; align-items: center; gap: 6px;
    }
    .admin-btn-primary { background: var(--english-violet); color: var(--paper); }
    .admin-btn-primary:hover { background: var(--ink); }

    .em-list { max-width: 1360px; margin: 32px auto 200px; padding: 0 36px; }
    .em-state { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); padding: 32px 0; }
    .em-table { display: flex; flex-direction: column; border-top: 1px solid rgba(28,29,34,0.1); }
    .em-row {
      display: grid;
      grid-template-columns: 1fr 150px 110px 130px 200px;
      gap: 16px; align-items: center; padding: 16px 12px;
      border-bottom: 1px solid rgba(28,29,34,0.06); transition: background 0.2s;
    }
    .em-row:hover { background: rgba(55, 30, 40, 0.04); }
    .em-row-info { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
    .em-row-title {
      font-family: var(--serif); font-size: 19px; color: var(--ink); line-height: 1.2;
      text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .em-row-title:hover { color: var(--english-violet); }
    .em-row-sub {
      font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55);
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .em-trigger {
      font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 11px;
      color: var(--english-violet); background: rgba(55,30,40,0.07);
      padding: 3px 8px; border-radius: 999px; justify-self: start;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 100%;
    }
    .em-trigger.is-none { color: rgba(28,29,34,0.4); background: rgba(28,29,34,0.05); }
    .em-row-date { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.6); }
    .em-status-pill {
      display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px;
      border-radius: 999px; font-family: var(--sans); font-size: 10px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; justify-self: start;
    }
    .em-status-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; }
    .em-status-active { background: rgba(60, 130, 80, 0.12); color: #2d6a44; }
    .em-status-active::before { background: #2d6a44; }
    .em-status-draft { background: rgba(55, 30, 40, 0.1); color: var(--english-violet); }
    .em-status-draft::before { background: var(--english-violet); }
    .em-status-archived { background: rgba(28, 29, 34, 0.08); color: rgba(28,29,34,0.55); }
    .em-status-archived::before { background: rgba(28,29,34,0.55); }
    .em-row-actions { display: flex; gap: 6px; justify-content: flex-end; flex-wrap: wrap; }
    .em-row-action {
      padding: 5px 10px; background: transparent; border: 1px solid rgba(28,29,34,0.18);
      border-radius: 2px; cursor: pointer; font-family: var(--sans); font-size: 10px;
      font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(28,29,34,0.7); text-decoration: none;
    }
    .em-row-action:hover { color: var(--ink); border-color: rgba(28,29,34,0.4); }
    .em-row-action.danger:hover { color: #a05a3c; border-color: rgba(160,90,60,0.5); }

    @media (max-width: 980px) {
      .em-row { grid-template-columns: 1fr auto; }
      .em-trigger, .em-row-date { display: none; }
      .em-status-pill { grid-column: 2; }
      .em-row-actions { grid-column: 1 / -1; justify-content: flex-start; }
    }
  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { STARTER_TEMPLATES } from "../../lib/email-starters.js";

    const $loading = document.getElementById("em-loading");
    const $empty = document.getElementById("em-empty");
    const $error = document.getElementById("em-error");
    const $table = document.getElementById("em-table");
    const $count = document.getElementById("em-count");
    const $search = document.getElementById("em-search");
    const chips = document.querySelectorAll(".enquiry-chip");

    let all = [];
    let activeFilter = "all";
    let activeSearch = "";

    function escapeHtml(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
      }[c]));
    }
    function fmtDate(iso) {
      if (!iso) return "—";
      try {
        return new Date(iso).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
      } catch (_) { return "—"; }
    }
    function statusPill(status) {
      const label = (status || "draft").toLowerCase();
      const txt = label.charAt(0).toUpperCase() + label.slice(1);
      return `<span class="em-status-pill em-status-${label}">${txt}</span>`;
    }

    function render() {
      const q = activeSearch.trim().toLowerCase();
      const filtered = all.filter((t) => {
        if (activeFilter !== "all" && t.status !== activeFilter) return false;
        if (q) {
          const hay = [t.name, t.subject, t.trigger_key].map((x) => String(x || "").toLowerCase()).join(" ");
          if (!hay.includes(q)) return false;
        }
        return true;
      });

      $loading.hidden = true;
      $empty.hidden = filtered.length > 0;
      $count.textContent = `${filtered.length} of ${all.length}`;

      $table.innerHTML = filtered.map((t) => {
        const editUrl = `/admin/email/editor?id=${t.id}`;
        const trig = t.trigger_key
          ? `<span class="em-trigger" title="Fires on: ${escapeHtml(t.trigger_key)}">${escapeHtml(t.trigger_key)}</span>`
          : `<span class="em-trigger is-none">manual</span>`;
        return `
          <div class="em-row" data-id="${t.id}" role="row">
            <div class="em-row-info">
              <a href="${editUrl}" class="em-row-title">${escapeHtml(t.name || "(untitled)")}</a>
              <span class="em-row-sub">${escapeHtml(t.subject || "No subject yet")}</span>
            </div>
            ${trig}
            ${statusPill(t.status)}
            <span class="em-row-date">${fmtDate(t.updated_at)}</span>
            <div class="em-row-actions">
              <a href="${editUrl}" class="em-row-action">Edit</a>
              <button type="button" class="em-row-action" data-dupe="${t.id}">Duplicate</button>
              <button type="button" class="em-row-action danger" data-delete="${t.id}">Delete</button>
            </div>
          </div>`;
      }).join("");

      $table.querySelectorAll("[data-delete]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute("data-delete");
          const row = all.find((t) => t.id === id);
          if (!row) return;
          if (!confirm(`Delete "${row.name}"? This can't be undone.`)) return;
          btn.setAttribute("disabled", "true");
          btn.textContent = "Deleting…";
          const { error } = await supabase.from("email_templates").delete().eq("id", id);
          if (error) { btn.removeAttribute("disabled"); btn.textContent = "Delete"; alert(`Couldn't delete: ${error.message}`); return; }
          all = all.filter((t) => t.id !== id);
          render();
        });
      });

      $table.querySelectorAll("[data-dupe]").forEach((btn) => {
        btn.addEventListener("click", async () => {
          const id = btn.getAttribute("data-dupe");
          const row = all.find((t) => t.id === id);
          if (!row) return;
          btn.setAttribute("disabled", "true");
          btn.textContent = "Copying…";
          const copy = {
            name: `${row.name} (copy)`,
            subject: row.subject,
            preheader: row.preheader,
            trigger_key: null, // a trigger can only bind to one active template
            mode: row.mode,
            blocks: row.blocks,
            custom_html: row.custom_html,
            branding: row.branding,
            status: "draft",
          };
          const { data, error } = await supabase.from("email_templates").insert(copy).select().single();
          if (error) { btn.removeAttribute("disabled"); btn.textContent = "Duplicate"; alert(`Couldn't duplicate: ${error.message}`); return; }
          location.href = `/admin/email/editor?id=${data.id}`;
        });
      });
    }

    chips.forEach((c) => c.addEventListener("click", () => {
      chips.forEach((b) => b.classList.remove("is-active"));
      c.classList.add("is-active");
      activeFilter = c.getAttribute("data-filter");
      render();
    }));
    $search.addEventListener("input", () => { activeSearch = $search.value || ""; render(); });

    (async () => {
      // In local dev the page renders without a login so the UI is previewable;
      // production stays gated. (Supabase calls still need a real session/env.)
      const DEV = import.meta.env.DEV;
      if (!DEV) {
        const session = await requireAdmin("/admin/login");
        if (!session) return;
      }
      const { data, error } = await supabase
        .from("email_templates")
        .select("id, name, subject, preheader, trigger_key, mode, blocks, custom_html, branding, status, updated_at")
        .order("updated_at", { ascending: false });
      if (error) {
        if (DEV) { all = []; render(); return; } // dev preview without DB — show empty chrome
        $loading.hidden = true;
        $error.hidden = false;
        $error.innerHTML = `Couldn't load templates: ${escapeHtml(error.message)}.<br />If this is the first run, apply <code>supabase/email_templates.sql</code> in the Supabase SQL editor.`;
        return;
      }
      all = data || [];
      render();
    })();

    // Load the branded starter templates (skips any already added by name).
    document.getElementById("em-seed")?.addEventListener("click", async () => {
      const btn = document.getElementById("em-seed");
      const existing = new Set((all || []).map((t) => (t.name || "").toLowerCase()));
      const toAdd = STARTER_TEMPLATES.filter((t) => !existing.has(t.name.toLowerCase()))
        .map((t) => ({ name: t.name, subject: t.subject, preheader: t.preheader, mode: t.mode, blocks: t.blocks, custom_html: "", branding: t.branding, trigger_key: t.trigger_key, status: t.status }));
      if (!toAdd.length) { btn.textContent = "All loaded ✓"; setTimeout(() => (btn.textContent = "Load starter templates"), 1800); return; }
      btn.disabled = true; btn.textContent = "Loading…";
      const { error } = await supabase.from("email_templates").insert(toAdd);
      btn.disabled = false; btn.textContent = "Load starter templates";
      if (error) { alert("Couldn't load starters: " + error.message); return; }
      location.reload();
    });
  </script>
</BaseLayout>
