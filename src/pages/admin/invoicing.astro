    .ci-totals .r { display: flex; justify-content: space-between; font-size: 13.5px; padding: 3px 0; color: rgba(28,29,34,0.7); }
    .ci-totals .r.grand { font-size: 16px; font-weight: 800; color: var(--ink); margin-top: 4px; }
    .inv-list { display: flex; flex-direction: column; gap: 8px; overflow-x: auto; }

    .rep-controls { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
