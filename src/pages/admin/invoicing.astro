    .mc-raise:hover { background: var(--english-violet); color: #fff; }
    .mc-alloc { width: min(640px, 100%); }
    .mc-alloc-q { width: 100%; box-sizing: border-box; height: 40px; padding: 0 12px; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; font: 13px var(--sans); margin-bottom: 8px; }
    .mc-alloc-list { max-height: 50vh; overflow-y: auto; border-top: 1px solid rgba(28,29,34,0.08); }
