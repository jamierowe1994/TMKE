    /* A line above the header as well as below, so Client reads as the table's. */
    .mc-tbl thead tr:first-child th { border-top: 1px solid rgba(28,29,34,0.14); padding-top: 10px; }
    .inv-msg { font-family: var(--sans); font-size: 13px; border-radius: 8px; padding: 9px 12px; margin: 4px 0 0; }
    .inv-msg.is-ok { background: rgba(60,150,90,0.1); color: #2e6b40; }
