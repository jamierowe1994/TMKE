    .mc-raise { appearance: none; cursor: pointer; margin-left: 6px; padding: 2px 8px; border-radius: 6px; border: 1px solid var(--english-violet); background: #fff; color: var(--english-violet); font: 700 10.5px var(--sans); letter-spacing: 0.04em; }
    .mc-raise:hover { background: var(--english-violet); color: #fff; }
    .mc-alloc { width: min(640px, 100%); }
    .mc-alloc-q { width: 100%; box-sizing: border-box; height: 40px; padding: 0 12px; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; font: 13px var(--sans); margin-bottom: 8px; }
    .mc-alloc-list { max-height: 50vh; overflow-y: auto; border-top: 1px solid rgba(28,29,34,0.08); }
    .mc-alloc-row { appearance: none; display: flex; justify-content: space-between; gap: 16px; width: 100%; text-align: left; background: none; border: 0; border-bottom: 1px solid rgba(28,29,34,0.07); padding: 10px 6px; cursor: pointer; font: 13px var(--sans); color: var(--ink); }
