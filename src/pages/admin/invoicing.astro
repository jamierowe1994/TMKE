      padding: 7px 10px; border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 3px;
      font-family: var(--sans); font-size: 13px; color: var(--ink); background: #fff;
    }
    .rep-totals { display: flex; gap: 26px; flex-wrap: wrap; margin: 0 0 22px; }
