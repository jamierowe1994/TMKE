    .inv-colour input[type="text"] { flex: 1; font-family: ui-monospace, Menlo, monospace; }
    .inv-toggle { display: flex; align-items: center; gap: 10px; font-family: var(--sans); font-size: 14px; color: var(--ink); cursor: pointer; margin-top: 4px; }
    .inv-toggle input { width: 17px; height: 17px; accent-color: var(--english-violet); }
    .inv-preview-wrap { position: sticky; top: 16px; }
    /* Matches the "Create an invoice" card on the left instead of the
       label+button row floating loose on the grey background, then the
       invoice itself sits below as its own thing — not nested in the card. */
    .inv-preview-head-card { padding: 16px 18px; margin-bottom: 16px; }
    .inv-preview-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .inv-preview-lbl { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .inv-pdf-btn { appearance: none; cursor: pointer; background: #fff; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; padding: 7px 12px; font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--english-violet); transition: background 0.15s, border-color 0.15s; }
    .inv-pdf-btn:hover { background: var(--paper); border-color: var(--english-violet); }
    /* True-size A4 iframe (794x1123 @96dpi) scaled uniformly to fit the column,
       so the on-screen proportions exactly match a printed A4 sheet. */
    .inv-preview-box { width: 100%; overflow: hidden; border: 1px solid rgba(28,29,34,0.12); border-radius: 12px; background: #cfccc8; }
    /* pointer-events:none because it is a picture of the invoice, not a thing
       to interact with. An iframe overlapping the form - which happens whenever
       ciScaleFit hasn't run, e.g. it was sized while the panel was hidden -
       silently swallows clicks and keystrokes, and focus lands inside the
       iframe's document where nothing you type reaches the form.
       overflow:hidden on the box stops it escaping in the first place. */
    #inv-preview, #ci-preview { width: 794px; height: 1123px; border: 0; display: block; transform-origin: top left; pointer-events: none; }
    .inv-preview-box { overflow: hidden; }
    .inv-panel[data-panel="create"] { max-width: 1180px; }
    .inv-row2b { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 640px) { .inv-row2b { grid-template-columns: 1fr; } }
    .ci-tpl { display: flex; align-items: center; gap: 12px; margin: 0 0 20px; }
    .ci-tpl-lbl { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .ci-tpl-opts { display: inline-flex; gap: 4px; padding: 3px; background: rgba(28,29,34,0.05); border-radius: 9px; }
    .ci-tpl-opt { appearance: none; cursor: pointer; background: none; border: 0; border-radius: 7px; padding: 7px 16px; font-family: var(--sans); font-size: 12.5px; font-weight: 700; color: rgba(28,29,34,0.55); transition: background 0.15s, color 0.15s; }
    .ci-tpl-opt.is-active { background: var(--english-violet); color: #fff; }
    .cim-pay { font-family: var(--sans); font-size: 12px; line-height: 1.5; color: rgba(28,29,34,0.55); margin: 0 0 12px; padding: 9px 12px; border-radius: 7px; background: rgba(28,29,34,0.05); }
    .cim-pay.is-on { color: var(--english-violet); background: rgba(var(--violet-rgb), 0.09); font-weight: 700; }
    .ci-pay-hint { font-family: var(--sans); font-size: 11.5px; line-height: 1.45; color: rgba(28,29,34,0.5); }
    .ci-item { display: grid; grid-template-columns: 1fr 130px 34px; gap: 8px; align-items: center; margin-bottom: 8px; }
    .ci-item input { font-family: var(--sans); font-size: 14px; padding: 9px 11px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; background: #fff; color: var(--ink); }
    .ci-item input:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .ci-del { appearance: none; cursor: pointer; border: 1px solid rgba(28,29,34,0.14); background: #fff; border-radius: 8px; height: 38px; font-size: 18px; line-height: 1; color: rgba(28,29,34,0.55); }
    .ci-del:hover { background: rgba(200,70,50,0.08); border-color: rgba(200,70,50,0.4); color: #a3372b; }
    .ci-totals { margin-top: 14px; border-top: 1px solid rgba(28,29,34,0.1); padding-top: 12px; font-family: var(--sans); }
    .ci-totals .r { display: flex; justify-content: space-between; font-size: 13.5px; padding: 3px 0; color: rgba(28,29,34,0.7); }
    .ci-totals .r.grand { font-size: 16px; font-weight: 800; color: var(--ink); margin-top: 4px; }
    .inv-list { display: flex; flex-direction: column; gap: 8px; overflow-x: auto; }

    .rep-controls { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .rep-month {
      padding: 7px 10px; border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 3px;
      font-family: var(--sans); font-size: 13px; color: var(--ink); background: #fff;
    }
    .rep-totals { display: flex; gap: 26px; flex-wrap: wrap; margin: 0 0 22px; }
    .rep-tot-k {
      display: block; font-family: var(--sans); font-size: 10px; letter-spacing: 0.16em;
      text-transform: uppercase; color: rgba(28,29,34,0.5); margin-bottom: 4px;
