---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/money-os.css";
---

<AdminShell active="invoicing" title="Invoicing" skin="hub">
  <div class="ash-panel ash-page">
  <div class="inv-wrap mo">
    <!-- Invoicing, stripped back (Dani, 5-6 Nov 2026; agreed on the mock-up):
         the month, what needs you and what's open. Everything else is under
         Settings, and each opens in the same place with a way back. -->
    <section class="mo-head">
      <div>
        <p class="mo-eye">Money</p>
        <div class="mo-title" id="io-title">Invoicing</div>
        <p class="mo-sub" id="io-sub">What's been raised this month, what's been paid and what needs you. Accounts confirm payments on their own page, so nobody has to chase by email.</p>
      </div>
      <div class="mo-acts">
        <button type="button" class="btn" id="io-back" hidden>Back to invoicing</button>
        <button type="button" class="btn" id="io-set" aria-expanded="false">Settings</button>
        <a class="btn" href="/admin/revenue">Revenue</a>
        <button type="button" class="btn primary" id="io-new">New invoice</button>
        <div class="mo-menu" id="io-menu" hidden>
          <button type="button" data-open="monthly">Regular invoices</button>
          <button type="button" data-open="approvals">Automatic invoicing</button>
          <button type="button" data-open="portal">Accounts portal</button>
          <button type="button" data-open="settings">Company and bank</button>
          <button type="button" data-open="template">Invoice template</button>
          <button type="button" data-open="book">Address book</button>
        </div>
      </div>
    </section>

    <!-- The month -->
    <section class="inv-panel" data-panel="overview">
      <p class="state" id="io-state">Loading…</p>
      <div id="io-main" hidden>
        <div class="bar">
          <div class="nav"><button type="button" id="io-prev" aria-label="Earlier month">‹</button><span id="io-month"></span><button type="button" id="io-next" aria-label="Later month">›</button></div>
          <label class="find"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input type="search" id="io-q" placeholder="Client or invoice number" aria-label="Client or invoice number"></label>
          <div class="chips" id="io-chips" role="group" aria-label="Type of work"></div>
          <div class="mo-acts" style="margin-left:auto"><button type="button" class="btn" id="io-mend">Month-end email</button><button type="button" class="btn" id="io-mrev">Month-end review</button></div>
        </div>
        <div class="figs" id="io-figs" role="group" aria-label="This month"></div>
        <div class="section" id="io-needs-sec"><div class="strip"><div class="strip-t">Needs you<span id="io-needs-n"></span></div></div><div class="needs" id="io-needs"></div></div>
        <div id="io-open"></div>
        <div id="io-streams"></div>
      </div>
    </section>

    <!-- The accounts portal: its link, passcode and emails -->
    <section class="inv-panel" data-panel="portal" hidden>
      <p class="state" id="pt-state">Loading…</p>
      <div class="cp" id="pt-main" hidden style="max-width:720px">
        <label class="field"><span>The link. This is what goes in their email.</span><span class="io-copy"><input id="pt-link" readonly><button type="button" class="btn" id="pt-copy">Copy</button></span></label>
        <label class="field"><span>The passcode. Tell them this yourself; it's never in an email. Changing it signs everyone out.</span><span class="io-copy"><input id="pt-code" maxlength="12" autocomplete="off" spellcheck="false"><button type="button" class="btn" id="pt-gen">New one</button></span></label>
        <label class="field"><span>Who gets the month-end email</span><input id="pt-to" type="email"></label>
        <div class="field"><span>The page</span><span class="tog" id="pt-on"><button type="button" data-v="1">On</button><button type="button" data-v="0">Off</button></span></div>
        <div class="field"><span>Send the month-end email by itself, on the 20th and again on the 28th if anything's still open</span><span class="tog" id="pt-auto"><button type="button" data-v="1">On</button><button type="button" data-v="0">Off</button></span></div>
        <p id="pt-last"></p>
        <div><button type="button" class="btn primary" id="pt-save">Save</button></div>
      </div>
    </section>

    <!-- Create invoice -->
    <section class="inv-panel" data-panel="create" hidden>
      <div class="inv-tpl-grid">
        <div class="ash-card">
          <div class="ash-card-head"><div class="ash-card-title">Create an invoice</div></div>
          <div class="ash-card-body">
            <p class="inv-intro">Build it, preview it, then save or send. It's numbered automatically.</p>
            <div class="ci-tpl">
              <span class="ci-tpl-lbl">Template</span>
              <div class="ci-tpl-opts" id="ci-tpl">
                <button type="button" class="ci-tpl-opt" data-tpl="minimal">Minimal</button>
                <button type="button" class="ci-tpl-opt" data-tpl="banded">Banded</button>
              </div>
            </div>
            <div class="ci-tpl">
              <span class="ci-tpl-lbl">Card payment</span>
              <div class="ci-tpl-opts" id="ci-pay">
                <button type="button" class="ci-tpl-opt" data-pay="no">Off</button>
                <button type="button" class="ci-tpl-opt" data-pay="yes">On</button>
              </div>
              <span class="ci-pay-hint">Adds a &ldquo;Pay by card&rdquo; button to the email. Bank details stay on the invoice either way.</span>
            </div>
            <h3 class="inv-h">Bill to</h3>
            <!-- Ties the invoice to a recurring one on the Monthly checklist,
                 for a month: the sure link, whatever address it goes to. -->
            <div class="inv-row2b ci-rec-row">
              <label class="inv-field"><span>Recurring invoice (optional)</span><select id="ci-recurring"><option value="">— Not a recurring invoice —</option></select></label>
              <label class="inv-field" id="ci-month-f" hidden><span>For month</span><input id="ci-month" type="month" /></label>
            </div>
            <label class="inv-field"><span>From the address book</span><select id="ci-recip"><option value="">— Choose a partner, or type below —</option></select></label>
            <label class="inv-field"><span>Invoice to *</span><input id="ci-name" placeholder="e.g. Fine &amp; Country — Rugby" /></label>
            <!-- Who the work was FOR, which on inter-brand billing is not who
                 pays. One finance department settles for several clients, so
                 without this both accounts teams reconcile on invoice numbers. -->
            <label class="inv-field"><span>Client</span><input id="ci-client" placeholder="Who the work was for, if different" /></label>
            <div class="inv-row2b">
              <label class="inv-field"><span>Email</span><input id="ci-email" type="email" /></label>
              <label class="inv-field"><span>Address</span><input id="ci-address" /></label>
            </div>
            <label class="inv-field"><span>CC</span><input id="ci-cc" placeholder="Accounts, comma-separated" /></label>
            <h3 class="inv-h">Dates</h3>
            <div class="inv-row2b">
              <label class="inv-field"><span>Issued</span><input id="ci-issued" type="date" /></label>
              <label class="inv-field"><span>Due</span><input id="ci-due" type="date" /></label>
              <label class="inv-field"><span>Terms (days)</span><input id="ci-terms" type="number" min="0" step="1" placeholder="Default" /></label>
            </div>
            <h3 class="inv-h">Line items</h3>
            <div id="ci-items"></div>
            <button type="button" class="inv-pdf-btn" id="ci-add-item">+ Add line</button>
            <div class="ci-totals" id="ci-totals"></div>
            <label class="inv-field" style="margin-top:16px"><span>Notes (optional)</span><textarea id="ci-notes" rows="2" placeholder="e.g. Thank you for your business."></textarea></label>
            <p class="inv-msg" id="ci-msg" hidden></p>
            <div class="ci-actions">
              <button type="button" class="inv-ghost" id="ci-create">Save draft</button>
              <button type="button" class="inv-save" id="ci-send">Create &amp; send</button>
            </div>
          </div>
        </div>
        <div class="inv-preview-wrap">
          <div class="ash-card inv-preview-head-card">
            <div class="inv-preview-head"><span class="inv-preview-lbl">Preview — A4</span><button type="button" class="inv-pdf-btn" id="ci-open-pdf">Open / save as PDF ↗</button></div>
          </div>
          <div class="inv-preview-box" id="ci-preview-box"><iframe id="ci-preview" title="Invoice preview" scrolling="no"></iframe></div>
        </div>
      </div>
    </section>

    <!-- Monthly checklist: every client billed monthly, and whether this
         month's invoice has gone out and been paid. -->
    <section class="inv-panel" data-panel="monthly" hidden>
      <div class="ash-card">
        <div class="ash-card-head">
          <div class="ash-card-title">Monthly checklist</div>
          <div class="mc-nav"><button type="button" class="mc-arrow" id="mc-prev" aria-label="Earlier months">&larr;</button><span id="mc-range"></span><button type="button" class="mc-arrow" id="mc-next" aria-label="Later months">&rarr;</button></div>
        </div>
        <div class="ash-card-body">
          <p class="inv-intro">Every active social media client, and the recurring invoices added below, month by month: has the invoice gone out, and has it been paid. A reminder comes on the 14th and 21st for anything not sent yet.</p>
          <p class="inv-msg is-err" id="mc-msg" hidden></p>
          <div class="mc-wrap"><table class="mc-tbl" id="mc-tbl"></table></div>
          <p class="mc-key"><span class="mc-y">&#10003;</span> done &nbsp; <span class="mc-n">&#10007;</span> not yet &nbsp; <span class="mc-d">Draft</span> raised, not sent &nbsp; <span class="mc-na">&ndash;</span> not due (before they started, or a month still to come) &nbsp; <span class="mc-note">&#9998;</span> a note (click any month to add one)</p>

          <!-- Videography: one-off, so a list of shoots rather than a month grid. -->
          <div class="mc-shoots-head"><h3 class="mc-h">Videography shoots</h3><span class="mc-shoots-sum" id="mc-shoots-sum"></span></div>
          <p class="inv-intro">This month's shoots, plus any earlier shoot still not invoiced or not yet paid; settled ones drop off. A shoot is invoiced two days before it happens; anything not sent by then shows as late. Click a shoot to open it in Videography.</p>
          <div class="mc-wrap"><table class="mc-tbl mc-shoots" id="mc-shoots"></table></div>

          <h3 class="mc-h" id="mc-form-h">Add a recurring invoice</h3>
          <p class="inv-intro">For anyone billed every month who isn't a social media client, such as a brand's marketing assets and hub. An invoice counts for a month when it goes to this address; add words that are always on it if the same address gets other invoices too.</p>
          <form id="mc-form" class="inv-book-form">
            <div class="inv-row">
              <label class="inv-field"><span>Name *</span><input name="name" placeholder="e.g. The Lettings Experts — assets &amp; hub" /></label>
              <label class="inv-field"><span>Contact name</span><input name="contact_name" /></label>
            </div>
            <div class="inv-row">
              <label class="inv-field"><span>Invoice goes to (email) *</span><input name="match_email" type="email" list="mc-emails" placeholder="accounts@…" /></label>
              <label class="inv-field"><span>Monthly amount (£)</span><input name="amount" type="number" step="0.01" min="0" /></label>
            </div>
            <div class="inv-row">
              <label class="inv-field"><span>Words always on it (optional)</span><input name="match_text" placeholder="e.g. Hub" /></label>
              <label class="inv-field"><span>First month</span><input name="start_month" type="month" /></label>
            </div>
            <!-- Sent automatically (Danielle, 21 Oct 2026): on its day, until
                 it's stopped, with nothing to press. -->
            <fieldset class="mc-auto">
              <label class="mc-auto-on"><input type="checkbox" name="auto_send" /> <span>Send it automatically</span></label>
              <p class="inv-intro">On its day it's raised and emailed to them, with accounts copied, every time it's due until you stop it. You get an email saying what went out.</p>
              <div class="inv-row">
                <label class="inv-field"><span>Day of the month it goes out</span><input name="day_of_month" type="number" min="1" max="28" placeholder="e.g. 5" /></label>
                <label class="inv-field"><span>How often</span><select name="frequency"><option value="monthly">Every month</option><option value="quarterly">Every 3 months</option><option value="6monthly">Every 6 months</option><option value="yearly">Every year</option><option value="oneoff">Once only</option></select></label>
              </div>
              <div class="inv-row">
                <label class="inv-field"><span>Invoice to (company)</span><input name="bill_to_name" placeholder="e.g. Prestige Property Experts" /></label>
                <label class="inv-field"><span>Last month (blank to run until stopped)</span><input name="end_month" type="month" /></label>
              </div>
              <div class="inv-row">
                <label class="inv-field"><span>Invoice email (if not the one above)</span><input name="bill_to_email" type="email" placeholder="accounts@…" /></label>
                <label class="inv-field"><span>CC</span><input name="cc_email" placeholder="Comma-separated" /></label>
              </div>
              <label class="inv-field"><span>What goes on the invoice</span><input name="line" placeholder="e.g. Marketing assets and hub (Month YYYY)" /></label>
              <div class="inv-row">
                <label class="inv-field"><span>Invoice address</span><textarea name="bill_to_address" rows="2"></textarea></label>
                <label class="inv-field"><span>Payment terms (days)</span><input name="terms_days" type="number" min="0" placeholder="Your usual terms" /></label>
              </div>
              <p class="inv-intro">Write (Month YYYY) where the month should go: it becomes, for example, (November 2026).</p>
            </fieldset>
            <datalist id="mc-emails"></datalist>
            <p class="inv-msg" id="mc-form-msg" hidden></p>
            <div class="mc-form-acts"><button type="submit" class="inv-save" id="mc-form-btn">Add to the checklist</button><button type="button" class="inv-ghost" id="mc-form-cancel" hidden>Cancel</button></div>
          </form>
          <div class="mc-modal" id="mc-modal" hidden></div>
        </div>
      </div>
    </section>

    <!-- Approvals: what the automatic invoicing is waiting on (Danielle, 21 Oct 2026) -->
    <section class="inv-panel" data-panel="approvals" hidden>
      <div class="ap-head">
        <div>
          <h3 class="mc-h" style="margin-top:0">Automatic invoicing</h3>
          <p class="inv-intro">Each morning, recurring invoices go out on their day, and a shoot's invoice is drafted two days before and sent to Jack to approve. Approve sends it to the client; Reject comes back to you with his notes.</p>
        </div>
        <div class="ap-mode">
          <label class="inv-field"><span>Mode</span><select id="ap-mode"><option value="off">Off</option><option value="test">Test: everything comes to you</option><option value="live">Live: sends to clients</option></select></label>
          <button type="button" class="inv-ghost" id="ap-run">Run it now</button>
        </div>
      </div>
      <div class="ap-numbers" id="ap-jobs">
        <h3 class="mc-h">The 8am jobs</h3>
        <p class="inv-intro" id="ap-jobs-note"></p>
        <span class="tog" id="ap-jobs-tog"><button type="button" data-v="1">On</button><button type="button" data-v="0">Off</button></span>
      </div>
      <p class="inv-msg" id="ap-msg" hidden></p>
      <!-- Numbers an invoice needs each month before it can go: the TPE hub's
           agents, typed in until the Team Hub can be counted on for it. -->
      <div class="ap-numbers" id="ap-numbers" hidden></div>
      <div class="mc-wrap"><table class="mc-tbl ap-tbl" id="ap-tbl"></table></div>
    </section>

    <!-- Settings -->
    <section class="inv-panel" data-panel="settings" hidden>
      <div class="ash-card">
        <div class="ash-card-head"><div class="ash-card-title">Your invoice details</div></div>
        <div class="ash-card-body">
          <p class="inv-intro">These appear on every invoice you send, and set your numbering + terms. Your accounts team is copied on every invoice.</p>
          <form id="inv-form" class="inv-form">
            <h3 class="inv-h">Company</h3>
            <label class="inv-field"><span>Company name</span><input name="company_name" placeholder="The Marketing Experts (Nationwide) Ltd" /></label>
            <label class="inv-field"><span>Registered address</span><textarea name="company_address" rows="2"></textarea></label>
            <div class="inv-row">
              <label class="inv-field"><span>Company no.</span><input name="company_reg_no" /></label>
              <label class="inv-field"><span>VAT number</span><input name="vat_number" /></label>
              <label class="inv-field"><span>VAT rate (%)</span><input name="vat_rate" type="number" step="0.1" /></label>
            </div>

            <h3 class="inv-h">Payment (bank transfer)</h3>
            <div class="inv-row">
              <label class="inv-field"><span>Account name</span><input name="account_name" /></label>
              <label class="inv-field"><span>Sort code</span><input name="sort_code" placeholder="00-00-00" /></label>
              <label class="inv-field"><span>Account number</span><input name="account_number" /></label>
            </div>

            <h3 class="inv-h">Invoicing</h3>
            <div class="inv-row">
              <label class="inv-field"><span>Invoice prefix</span><input name="invoice_prefix" placeholder="TMKE" /></label>
              <label class="inv-field"><span>Next number</span><input name="next_number" type="number" /></label>
              <label class="inv-field"><span>Payment terms (days)</span><input name="payment_terms_days" type="number" /></label>
            </div>
            <label class="inv-field"><span>Accounts team — CC on every invoice</span><input name="accounts_cc_email" placeholder="accounts@…, another@…" /></label>
            <label class="inv-field"><span>Invoice footer note (on the PDF)</span><textarea name="footer_note" rows="2" placeholder="e.g. Thank you for your business."></textarea></label>

            <h3 class="inv-h">Invoice email</h3>
            <label class="inv-field"><span>Footer image (appears at the bottom of every invoice email)</span><span class="inv-logo-row">
              <input name="email_footer_image_url" id="set-footer-img" placeholder="Paste an image URL, or upload →" />
              <label class="inv-upload"><input type="file" id="set-footer-file" accept="image/png,image/jpeg,image/webp" hidden /><span id="set-footer-lbl">Upload</span></label>
            </span></label>
            <img id="set-footer-preview" class="inv-footer-preview" alt="" hidden />

            <p class="inv-msg" id="inv-msg" hidden></p>
            <button type="submit" class="inv-save" id="inv-save">Save details</button>
          </form>
        </div>
      </div>
    </section>

    <!-- Template -->
    <section class="inv-panel" data-panel="template" hidden>
      <div class="inv-tpl-grid">
        <div class="ash-card">
          <div class="ash-card-head"><div class="ash-card-title">Design</div></div>
          <div class="ash-card-body">
            <p class="inv-intro">Pick a starting style, then tweak the colour and logo. The preview updates live.</p>
            <h3 class="inv-h">Style</h3>
            <div class="inv-styles" id="inv-styles">
              <button type="button" class="inv-style" data-style="minimal"><span class="inv-style-name">Minimal</span><span class="inv-style-sub">Big type on paper</span></button>
              <button type="button" class="inv-style" data-style="banded"><span class="inv-style-name">Banded</span><span class="inv-style-sub">Wine header + beige footer</span></button>
            </div>
            <h3 class="inv-h">Typeface <span class="inv-h-note">Outlook-safe fonts only</span></h3>
            <div class="inv-row2">
              <label class="inv-field"><span>Font</span><select id="tpl-font">
                <option value="Arial, Helvetica, sans-serif">Arial</option>
                <option value="Calibri, Candara, Segoe, 'Segoe UI', Optima, Arial, sans-serif">Calibri</option>
                <option value="'Trebuchet MS', Tahoma, sans-serif">Trebuchet MS</option>
                <option value="Verdana, Geneva, sans-serif">Verdana</option>
                <option value="Tahoma, Geneva, sans-serif">Tahoma</option>
                <option value="Georgia, 'Times New Roman', serif">Georgia</option>
                <option value="'Times New Roman', Times, serif">Times New Roman</option>
              </select></label>
              <label class="inv-field"><span>Base size (px)</span><input id="tpl-fs" type="number" min="10" max="18" step="1" /></label>
            </div>

            <h3 class="inv-h">Brand</h3>
            <label class="inv-field"><span>Accent colour</span><span class="inv-colour"><input type="color" id="tpl-accent-c" /><input type="text" id="tpl-accent-h" placeholder="#371e28" /></span></label>
            <label class="inv-field"><span>Logo</span><span class="inv-logo-row">
              <input id="tpl-logo" placeholder="Paste an image URL, or upload →" />
              <label class="inv-upload"><input type="file" id="tpl-logo-file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden /><span id="tpl-upload-lbl">Upload</span></label>
            </span></label>
            <label class="inv-toggle"><input type="checkbox" id="tpl-bank" /><span>Show bank details on the invoice</span></label>
            <p class="inv-msg" id="tpl-msg" hidden></p>
            <button type="button" class="inv-save" id="tpl-save">Save template</button>
          </div>
        </div>
        <div class="inv-preview-wrap">
          <div class="ash-card inv-preview-head-card">
            <div class="inv-preview-head">
              <span class="inv-preview-lbl">Preview — to-scale A4</span>
              <button type="button" class="inv-pdf-btn" id="inv-open-pdf">Open full size / save as PDF ↗</button>
            </div>
          </div>
          <div class="inv-preview-box" id="inv-preview-box"><iframe id="inv-preview" title="Invoice preview" scrolling="no"></iframe></div>
        </div>
      </div>
    </section>

    <!-- Address book -->
    <section class="inv-panel" data-panel="book" hidden>
      <div class="ash-card">
        <div class="ash-card-head"><div class="ash-card-title">Address book</div></div>
        <div class="ash-card-body">
          <p class="inv-intro">The partners you invoice — Fine &amp; Country offices, The Property Experts finance, etc. Pick from these when sending an invoice.</p>
          <form id="rec-form" class="inv-book-form">
            <div class="inv-row">
              <label class="inv-field"><span>Name *</span><input name="name" placeholder="e.g. Fine &amp; Country — Rugby" /></label>
              <label class="inv-field"><span>Billing email *</span><input name="email" type="email" placeholder="accounts@…" /></label>
            </div>
            <div class="inv-row">
              <label class="inv-field"><span>Contact name</span><input name="contact_name" /></label>
              <label class="inv-field"><span>Address</span><input name="address" /></label>
            </div>
            <p class="inv-msg" id="rec-msg" hidden></p>
            <button type="submit" class="inv-save" id="rec-add">Add to address book</button>
          </form>
          <div class="inv-book-list" id="rec-list"><p class="inv-empty">Loading…</p></div>
        </div>
      </div>
    </section>

    <div id="io-pop"></div>
    <div class="tip" id="io-tip" hidden></div>
    <div class="toast" id="io-toast" role="status" aria-live="polite"></div>

    <!-- Email review (QuickBooks-style edit-before-send) -->
    <div class="cim-scrim" id="ci-email-modal" hidden>
      <div class="cim" role="dialog" aria-modal="true" aria-label="Send invoice">
        <h3>Send invoice <span id="cim-num"></span></h3>
        <p class="cim-sub">Review the email — edit anything before it goes. The invoice PDF and your footer image are added automatically.</p>
        <label class="cim-f"><span>To</span><input id="cim-to" readonly /></label>
        <label class="cim-f"><span>CC</span><input id="cim-cc" placeholder="Comma-separated" /></label>
        <label class="cim-f"><span>Subject</span><input id="cim-subject" /></label>
        <label class="cim-f"><span>Message</span><textarea id="cim-body" rows="11"></textarea></label>
        <p class="cim-pay" id="cim-pay"></p>
        <p class="inv-msg" id="cim-msg" hidden></p>
        <div class="cim-actions">
          <button type="button" class="inv-ghost" id="cim-cancel">Cancel</button>
          <button type="button" class="inv-save" id="cim-send">Send invoice</button>
        </div>
      </div>
    </div>
  </div>
  </div>

  <style is:global>
    /* Was 900px, which made this the only admin page on a different width and
       left the invoice rows wider than the card they sat on. The page card now
