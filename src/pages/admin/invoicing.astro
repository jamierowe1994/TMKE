    .mc-alloc-row.is-other { opacity: 0.6; }
    .mc-modal { position: fixed; inset: 0; z-index: 200; background: rgba(28,24,28,0.4); display: flex; align-items: flex-start; justify-content: center; padding: 12vh 16px 16px; }
