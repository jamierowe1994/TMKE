    }
    const riFind = (id) => (RI.d && RI.d.rows || []).find((x) => x.id === id);

    /* Raise a regular invoice for a month. The Worker makes it from the
       invoice's own setup, the same as the automatic one, then it's straight
       to the email review. */
    function riRaise(r, want) {
      const rec = riRecId(r); if (!r || !rec) return;
      const d = RI.d;
      const opts = [...d.months].reverse().filter((m) => m <= d.today && !(r.cells[m] && (r.cells[m].sent || r.cells[m].paid)));
      if (!opts.length) { toast("Every month shown has gone already."); return; }
      const pick = want && opts.includes(want) ? want : opts.includes(RI.m) ? RI.m : opts[0];
      const unit = r.amount_pence || 0, a = r.auto || {};
      popShell("Raise an invoice", esc(r.client), "",
        `<label class="field"><span>Which month it's for</span><select id="mr-month">${opts.map((m) => `<option value="${m}"${m === pick ? " selected" : ""}>${esc(ymLabel(m))}${r.cells[m] && r.cells[m].draft ? " (draft raised)" : ""}</option>`).join("")}</select></label>
         ${r.quantity_label ? `<label class="field"><span>${esc(r.quantity_label)}</span><input id="mr-qty" type="number" min="0" step="1" inputmode="numeric"></label>` : ""}
         <dl class="rows">${a.bill_to_name ? `<div><dt>Billed to</dt><dd>${esc(a.bill_to_name)}</dd></div>` : ""}${a.bill_to_email || r.match_email ? `<div><dt>Sent to</dt><dd>${esc(a.bill_to_email || r.match_email)}</dd></div>` : ""}${a.cc_email ? `<div><dt>Copied in</dt><dd>${esc(a.cc_email)}</dd></div>` : ""}<div><dt>Net</dt><dd id="mr-net"></dd></div></dl>
         <p style="margin:0">Made from this invoice's own setup, the same as the automatic one, so it gets the right email${r.brand ? " and goes on the accounts portal" : ""}. You'll see the email before anything goes.</p>
         <p class="state bad" id="mr-msg" hidden></p>`,
        `<button type="button" class="mbtn" data-close>Cancel</button><button type="button" class="mbtn primary" id="mr-go">Raise and review the email</button>`);
      const sync = () => {
        const m = $("mr-month").value, q = $("mr-qty");
        if (q && !q.dataset.typed) q.value = r.quantities && r.quantities[m] != null ? r.quantities[m] : "";
        const n = q ? Number(q.value || 0) : 1;
        $("mr-net").textContent = r.quantity_label ? `${gb(unit * n)} (${gb(unit)} × ${n || 0})` : gb(unit);
        $("mr-go").textContent = r.cells[m] && r.cells[m].draft ? "Review the draft's email" : "Raise and review the email";
      };
      $("mr-month").addEventListener("change", () => { const q = $("mr-qty"); if (q) delete q.dataset.typed; sync(); });
      if ($("mr-qty")) $("mr-qty").addEventListener("input", (e) => { e.target.dataset.typed = "1"; sync(); });
      sync();
      $("mr-go").addEventListener("click", async () => {
        const btn = $("mr-go"), m = $("mr-month").value, q = $("mr-qty");
        if (q && !(r.cells[m] && r.cells[m].draft) && (q.value === "" || Number(q.value) < 0)) { $("mr-msg").textContent = `Add the ${String(r.quantity_label).toLowerCase()} for ${ymLabel(m)}.`; $("mr-msg").hidden = false; return; }
        btn.disabled = true; btn.textContent = "Raising…";
        try {
          const out = await postJson("/invoicing/recurring/raise", { recurring_id: rec, month: m, qty: q ? q.value : undefined });
          BOOK = null; loadMonthly(); riReview(out.invoice);
        } catch (err) { $("mr-msg").textContent = err.message; $("mr-msg").hidden = false; btn.disabled = false; sync(); }
      });
    }
    // The email that goes with it, in the words the automatic invoicing uses
    // (src/lib/invoice-email.js via the Worker), editable before it goes.
    async function riReview(inv) {
      if (!inv) return;
      popShell("Review the email", `Invoice ${esc(inv.number || "")}`, "", '<p class="state">Loading the email…</p>', '<button type="button" class="mbtn" data-close>Close</button>', true);
      let draft = {};
      try { draft = await api(`/invoicing/email-draft?id=${encodeURIComponent(inv.id)}`); } catch (_) { draft = { subject: defaultEmailSubject(inv, currentSettings), body: defaultEmailBody(inv, currentSettings) }; }
      popShell("Review the email", `Invoice ${esc(inv.number || "")}`, "",
        `<div class="ri-grid2"><label class="field"><span>To</span><input value="${esc(inv.bill_to_email || "")}" readonly></label><label class="field"><span>Copied in</span><input id="rv-cc" value="${esc(inv.cc_email || "")}"></label></div>
         <label class="field"><span>Subject</span><input id="rv-sub" value="${esc(draft.subject || "")}"></label>
         <label class="field"><span>Message. The PDF is attached${/\[Accounts portal button\]/.test(draft.body || "") ? ", and the portal line becomes a button" : /\[Pay by card button\]/.test(draft.body || "") ? ", and the card line becomes a button" : ""}.</span><textarea id="rv-body" rows="14">${esc(draft.body || "")}</textarea></label>
         <p style="margin:0">${esc(payLine(inv))} Total ${gb(inv.total_pence || 0)} with VAT.</p>
         <p class="state bad" id="rv-msg" hidden></p>`,
        `<button type="button" class="mbtn" data-close>Keep as a draft</button><button type="button" class="mbtn" data-pdf="${esc(inv.id)}">View PDF</button><button type="button" class="mbtn primary" id="rv-send">Send invoice</button>`, true);
      $("rv-send").addEventListener("click", async () => {
        const btn = $("rv-send"); btn.disabled = true; btn.textContent = "Sending…";
        try {
          await postJson("/invoicing/invoices/send", { id: inv.id, email_subject: $("rv-sub").value.trim(), email_body: $("rv-body").value, cc: $("rv-cc").value.trim() });
          closePop(); BOOK = null; toast(`${inv.number} sent.`);
          if (!$("ri-tbl").closest(".inv-panel").hidden) loadMonthly(); else if (!$("io-main").closest(".inv-panel").hidden) loadBook();
        } catch (err) { $("rv-msg").textContent = err.message; $("rv-msg").hidden = false; btn.disabled = false; btn.textContent = "Send invoice"; }
      });
    }
    async function riView(id) {
      if (!BOOK) { try { const d = await api("/invoicing/book"); BOOK = d.invoices || []; TODAY = d.today; PENDING = d.pending || []; NUMBERS = d.numbers || []; TICKS = d.ticks || null; RELEASED = d.released || []; } catch (err) { toast(err.message); return; } }
      if (byId(id)) openInv(id); else toast("Couldn't find that invoice.");
    }
    // A row's last six months, and the chosen month's note.
    function riRowPop(r) {
      const m = RI.m, c = r.cells[m] || {};
      const rec = RI.tab === "recurring";
      popShell(rec ? "Recurring invoice" : "Social media client", esc(r.client), "",
        `<dl class="rows">${[...RI.d.months].reverse().map((ym) => {
            const x = riCell(r, ym), can = riRecId(r) && ym <= RI.d.today && ym >= MC_FIRST;
            const btn = x.k === "draft" && x.inv ? `<button type="button" class="ri-btn go" data-rpsend="${esc(x.inv.id)}">Send</button>`
              : x.inv ? `<button type="button" class="ri-btn" data-rpview="${esc(x.inv.id)}">View</button>`
              : can && ["miss", "na"].includes(x.k) ? `<button type="button" class="ri-btn${x.k === "miss" ? " go" : ""}" data-rpraise="${ym}">Raise</button>` : "";
            return `<div><dt>${esc(ymLabel(ym))}</dt><dd style="display:flex;align-items:center;gap:8px"><span class="chip ${x.chip}">${esc(x.label)}</span>${x.inv ? `<span style="color:var(--tx)">${esc(x.inv.number)}</span>` : ""}<span style="margin-left:auto">${btn}</span></dd></div>`;
          }).join("")}</dl>
         <label class="field"><span>Note for ${esc(ymLabel(m))}</span><textarea id="rn-note" rows="3" placeholder="e.g. Not charged this month, agreed with Sean">${esc(c.note || "")}</textarea></label>
         <label class="ri-check"><input type="checkbox" id="rn-skip"${c.skip ? " checked" : ""}> No invoice for ${esc(ymLabel(m))}, so it isn't flagged as missing</label>
         <p class="state bad" id="rn-msg" hidden></p>`,
        `<button type="button" class="mbtn" data-close>Close</button>${rec ? `<button type="button" class="mbtn danger" id="rn-stop">Stop it</button><button type="button" class="mbtn" id="rn-edit">Edit</button>` : `<a class="mbtn" href="/admin/social?lead=${encodeURIComponent(r.id)}">Open their file</a>`}<button type="button" class="mbtn primary" id="rn-save">Save</button>`);
      $("io-pop").querySelectorAll("[data-rpraise]").forEach((b) => b.addEventListener("click", () => riRaise(r, b.dataset.rpraise)));
      $("io-pop").querySelectorAll("[data-rpsend]").forEach((b) => b.addEventListener("click", () => fullInvoice(b.dataset.rpsend).then(riReview).catch((err) => toast(err.message))));
      $("io-pop").querySelectorAll("[data-rpview]").forEach((b) => b.addEventListener("click", () => riView(b.dataset.rpview)));
      $("rn-save").addEventListener("click", async () => {
        try { await postJson("/invoicing/month-note", { row_kind: r.kind, row_id: r.id, month: m, note: $("rn-note").value, skip: $("rn-skip").checked }); closePop(); toast("Saved."); loadMonthly(); }
        catch (err) { $("rn-msg").textContent = err.message; $("rn-msg").hidden = false; }
      });
      if (rec) {
        $("rn-edit").addEventListener("click", () => riEdit(r));
        $("rn-stop").addEventListener("click", async () => {
          if (!confirm(`Stop ${r.client}? Nothing more is raised for it. Its invoices aren't touched.`)) return;
          try { await api(`/invoicing/recurring?id=${encodeURIComponent(r.id)}`, { method: "DELETE" }); closePop(); toast("Stopped."); loadMonthly(); loadRecurringOptions(); }
          catch (err) { $("rn-msg").textContent = err.message; $("rn-msg").hidden = false; }
        });
      }
    }
    // Add or edit a recurring invoice: everything the automatic run needs.
    function riEdit(r) {
      const a = (r && r.auto) || {}, v = (x) => esc(x == null ? "" : x);
      const freq = [["monthly", "Every month"], ["quarterly", "Every 3 months"], ["6monthly", "Every 6 months"], ["yearly", "Every year"], ["oneoff", "Once only"]];
      popShell("Recurring invoice", r ? "Edit " + esc(r.client) : "Add a regular invoice", "",
        `<div class="ri-grid2">
           <label class="field"><span>Name</span><input id="re-name" value="${v(r && r.client)}" placeholder="e.g. The Letting Experts: agent assets"></label>
           <label class="field"><span>Contact name</span><input id="re-contact" value="${v(r && r.contact)}"></label>
           <label class="field"><span>Billed to (company)</span><input id="re-billname" value="${v(a.bill_to_name)}"></label>
           <label class="field"><span>Invoice email</span><input id="re-email" type="email" value="${v(r && r.match_email)}" placeholder="accounts@…"></label>
           <label class="field"><span>Copied in. Separate several with commas.</span><input id="re-cc" value="${v(a.cc_email)}"></label>
           <label class="field"><span>Amount, net (£)${r && r.quantity_label ? ", each" : ""}</span><input id="re-amt" type="number" step="0.01" min="0" value="${r && r.amount_pence != null ? (r.amount_pence / 100).toFixed(2) : ""}"></label>
         </div>
         <label class="field"><span>What goes on the invoice. Month YYYY becomes the month${r && r.quantity_label ? ", {qty} the number" : ""}.</span><input id="re-line" value="${v(a.line)}" placeholder="e.g. Monthly Agent Assets (Month YYYY)"></label>
         <div class="ri-grid2">
           <label class="field"><span>Goes out on the (day of the month)</span><input id="re-day" type="number" min="1" max="28" value="${v(a.day_of_month)}" placeholder="e.g. 5"></label>
           <label class="field"><span>How often</span><select id="re-freq">${freq.map(([k, l]) => `<option value="${k}"${(a.frequency || "monthly") === k ? " selected" : ""}>${l}</option>`).join("")}</select></label>
           <label class="field"><span>First month</span><input id="re-start" type="month" value="${v(r && r.start_month)}"></label>
           <label class="field"><span>Last month. Blank runs until it's stopped.</span><input id="re-end" type="month" value="${v(a.end_month)}"></label>
           <label class="field"><span>Payment terms (days). Blank uses your usual.</span><input id="re-terms" type="number" min="0" value="${v(a.terms_days)}"></label>
           <label class="field"><span>Invoice email, if not the one above</span><input id="re-billemail" type="email" value="${v(a.bill_to_email)}"></label>
         </div>
         <label class="field"><span>Invoice address</span><textarea id="re-addr" rows="2">${v(a.bill_to_address)}</textarea></label>
         <label class="field"><span>Words always on it, if the same address gets other invoices too (optional)</span><input id="re-text" value="${v(r && r.match_text)}"></label>
         <label class="ri-check"><input type="checkbox" id="re-auto"${a.auto_send ? " checked" : ""}> Send it by itself on its day. Off: it waits for you to raise it here.</label>
         <p class="state bad" id="re-msg" hidden></p>`,
        `<button type="button" class="mbtn" data-close>Cancel</button><button type="button" class="mbtn primary" id="re-save">${r ? "Save" : "Add"}</button>`, true);
      $("re-save").addEventListener("click", async () => {
        const g = (id) => $(id).value.trim(), amt = g("re-amt");
        try {
          await postJson("/invoicing/recurring", {
            id: r ? r.id : undefined, name: g("re-name"), contact_name: g("re-contact"), match_email: g("re-email"), match_text: g("re-text"),
            amount_pence: amt ? Math.round(Number(amt) * 100) : null, start_month: g("re-start") || null,
            auto: { auto_send: $("re-auto").checked, day_of_month: g("re-day"), frequency: $("re-freq").value, end_month: g("re-end"),
              bill_to_name: g("re-billname"), bill_to_email: g("re-billemail"), cc_email: g("re-cc"), bill_to_address: $("re-addr").value.trim(),
              line: g("re-line"), terms_days: g("re-terms") },
          });
          closePop(); toast(r ? "Saved." : "Added."); loadMonthly(); loadRecurringOptions();
        } catch (err) { $("re-msg").textContent = err.message; $("re-msg").hidden = false; }
      });
    }
    // Allocate: an invoice already sent becomes this row's for the month.
    async function riAlloc(r) {
      const rec = riRecId(r); if (!rec) return;
      const m = RI.m;
      popShell("Allocate an invoice", esc(r.client), "", '<p class="state">Loading invoices…</p>', '<button type="button" class="mbtn" data-close>Cancel</button>');
      let list = [];
      try { list = (await api("/invoicing/allocate")).invoices || []; } catch (err) { popShell("Allocate an invoice", esc(r.client), "", `<p class="state bad">${esc(err.message)}</p>`, '<button type="button" class="mbtn" data-close>Close</button>'); return; }
      const want = String(r.match_email || (r.auto && r.auto.bill_to_email) || "").toLowerCase();
      list.sort((a, b) => ((String(b.bill_to_email || "").toLowerCase() === want) - (String(a.bill_to_email || "").toLowerCase() === want)));
      popShell("Allocate an invoice", esc(r.client), "",
        `<p style="margin:0">Pick the invoice that was sent for ${esc(ymLabel(m))}. From then on its payment shows here.</p>
         <label class="find" style="flex:none"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg><input type="search" id="ra-q" placeholder="Number, name or amount"></label>
         <div class="ri-alloc" id="ra-list"></div><p class="state bad" id="ra-msg" hidden></p>`,
        '<button type="button" class="mbtn" data-close>Cancel</button>');
      const draw = (q) => {
        const rows = list.filter((iv) => !q || [iv.number, iv.bill_to_name, iv.client_name, iv.line, iv.bill_to_email, (iv.total_pence / 100).toFixed(2)].join(" ").toLowerCase().includes(q)).slice(0, 80);
        $("ra-list").innerHTML = rows.map((iv) => `<button type="button" data-raiv="${esc(iv.id)}"><span>${esc(iv.number || "—")} ${esc(iv.bill_to_name || "")}<small>${esc([iv.line, iv.issued_date ? day(iv.issued_date) : ""].filter(Boolean).join(" · "))}</small></span><span style="text-align:right">${gb(iv.total_pence || 0)}<small>${iv.status === "paid" ? "Paid" : "Sent"}${iv.recurring_id && iv.recurring_id !== rec ? ", allocated elsewhere" : ""}</small></span></button>`).join("") || '<p class="state">No invoices match.</p>';
        $("ra-list").querySelectorAll("[data-raiv]").forEach((b) => b.addEventListener("click", async () => {
          const iv = list.find((x) => x.id === b.dataset.raiv);
          if (iv.recurring_id && iv.recurring_id !== rec && !confirm(`${iv.number} is already allocated to another regular invoice. Move it to ${r.client}, ${ymLabel(m)}?`)) return;
          b.disabled = true;
          try { await postJson("/invoicing/allocate", { invoice_id: iv.id, recurring_id: rec, month: m }); closePop(); toast("Allocated."); loadMonthly(); }
          catch (err) { $("ra-msg").textContent = err.message; $("ra-msg").hidden = false; b.disabled = false; }
        }));
      };
      draw(""); $("ra-q").addEventListener("input", (e) => draw(e.target.value.trim().toLowerCase())); $("ra-q").focus();
    }
    // Clicks on the panel.
    document.querySelector('.inv-panel[data-panel="monthly"]').addEventListener("click", (e) => {
      const t = (s) => e.target.closest(s);
      let b;
      if ((b = t("[data-ritab]"))) { RI.tab = b.dataset.ritab; RI.show = "all"; riDraw(); return; }
      if ((b = t("[data-rishow]"))) { RI.show = b.dataset.rishow; riDraw(); return; }
      if ((b = t("[data-riraise]"))) { e.stopPropagation(); riRaise(riFind(b.dataset.riraise)); return; }
      if ((b = t("[data-risend]"))) {
        e.stopPropagation(); const r = riFind(b.dataset.risend), c = r && riCell(r, RI.m);
        if (c && c.inv) fullInvoice(c.inv.id).then(riReview).catch((err) => toast(err.message)); else if (r && riRecId(r)) riRaise(r);
        return;
      }
      if ((b = t("[data-rialloc]"))) { e.stopPropagation(); riAlloc(riFind(b.dataset.rialloc)); return; }
      if ((b = t("[data-riview]"))) { e.stopPropagation(); riView(b.dataset.riview); return; }
      if ((b = t("[data-rinote]"))) { e.stopPropagation(); riRowPop(riFind(b.dataset.rinote)); return; }
      if (t("#ri-add")) { riEdit(null); return; }
      if ((b = t("[data-rishoot]"))) { location.href = `/admin/videography?booking=${encodeURIComponent(b.dataset.rishoot)}`; return; }
      if ((b = t("[data-rirow]"))) { riRowPop(riFind(b.dataset.rirow)); return; }
    });
    $("ri-prev").addEventListener("click", () => { if (RI.m > MC_FIRST) { RI.m = ymAdd(RI.m, -1); loadMonthly(); } });
    $("ri-next").addEventListener("click", () => { if (RI.m < nowYm) { RI.m = ymAdd(RI.m, 1); loadMonthly(); } });
    $("ri-q").addEventListener("input", (e) => { RI.q = e.target.value.trim().toLowerCase(); riDraw(); });

    /* ---- Approvals (automatic invoicing) ---- */
    const AP_STATUS = { pending: "Waiting", approved: "Approved", rejected: "Rejected", superseded: "Replaced" };
    async function loadApprovals() {
      const tbl = $("ap-tbl"); tbl.innerHTML = `<tr><td class="inv-empty">Loading…</td></tr>`;
      try {
        const d = await api("/invoicing/approvals");
        $("ap-mode").value = d.mode || "off";
        drawNumbers(d.numbers || []);
        const rows = (d.approvals || []).filter((x) => x.status !== "superseded");
        if (!rows.length) { tbl.innerHTML = `<tr><td class="inv-empty">Nothing yet. Invoices put to someone to approve show here.</td></tr>`; return; }
        const when = (x) => x ? new Date(x).toLocaleString("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }) : "";
        tbl.innerHTML = `<thead><tr><th>Invoice</th><th>To</th><th class="mc-num">Total</th><th>Approver</th><th>Asked</th><th>Status</th><th></th></tr></thead><tbody>${rows.map((x) => {
          const inv = x.invoice || {};
          const again = x.status === "rejected" && inv.status === "draft";
          return `<tr><td><strong>${esc(inv.number || "")}</strong></td><td>${esc(inv.bill_to_name || "")}</td><td class="mc-num">${inv.total_pence != null ? "£" + (inv.total_pence / 100).toFixed(2) : ""}</td>
            <td>${esc(String(x.approver_email || "").split("@")[0])}</td><td>${when(x.requested_at)}${x.round > 1 ? ` · round ${x.round}` : ""}</td>
            <td><span class="ap-pill is-${x.status}">${AP_STATUS[x.status] || x.status}</span>${x.notes ? `<div class="ap-notes">${esc(x.notes)}</div>` : ""}</td>
            <td>${again ? `<button type="button" class="inv-save ap-again" data-again="${esc(x.invoice_id)}">Send to ${esc(String(x.approver_email || "").split("@")[0].split(/[._]/)[0].replace(/^./, (m) => m.toUpperCase()) || "Jack")} again</button>` : inv.booking_id ? `<a class="ap-open" href="/admin/videography?booking=${esc(inv.booking_id)}">Open</a>` : ""}</td></tr>`;
        }).join("")}</tbody>`;
        tbl.querySelectorAll("[data-again]").forEach((b) => b.addEventListener("click", async () => {
          b.disabled = true; b.textContent = "Sending…";
          try { const r = await api("/invoicing/approval/request", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ invoice_id: b.dataset.again }) }); msg("ap-msg", r.test ? "Sent for approval (test mode: it came to you)." : "Sent back for approval.", true); loadApprovals(); }
          catch (err) { msg("ap-msg", err.message, false); b.disabled = false; b.textContent = "Try again"; }
        }));
      } catch (err) { tbl.innerHTML = `<tr><td class="inv-empty">${esc(/invoice_approvals|automation_mode/.test(err.message) ? "Run supabase/invoicing_automation.sql first." : err.message)}</td></tr>`; }
    }
    function drawNumbers(nums) {
      const host = $("ap-numbers");
      if (!nums.length) { host.hidden = true; return; }
      host.hidden = false;
      host.innerHTML = `<h3 class="mc-h">Numbers needed</h3><p class="inv-intro">These invoices need a number from you each month before they can go out. Fill it in any time before the day it goes.</p>` +
        nums.map((n) => `<div class="ap-num-row"><span class="ap-num-name"><strong>${esc(n.name)}</strong> · ${esc(n.month_label)}<em>${esc(n.label)}${n.unit_pence ? `, £${(n.unit_pence / 100).toFixed(2)} each` : ""}. Goes out on the ${n.day}${[11, 12, 13].includes(n.day % 100) ? "th" : ({ 1: "st", 2: "nd", 3: "rd" }[n.day % 10] || "th")}.</em></span>
          <input type="number" min="0" step="1" value="${n.qty ?? ""}" data-numfor="${esc(n.recurring_id)}" data-month="${esc(n.month)}" aria-label="${esc(n.label)}" />
          <button type="button" class="inv-save" data-numsave="${esc(n.recurring_id)}|${esc(n.month)}">${n.qty != null ? "Update" : "Save"}</button>
          <span class="ap-num-done">${n.qty != null ? `Saved${n.entered_by ? ` by ${esc(String(n.entered_by).split("@")[0])}` : ""}` : ""}</span></div>`).join("");
      host.querySelectorAll("[data-numsave]").forEach((b) => b.addEventListener("click", async () => {
        const [rid, month] = b.dataset.numsave.split("|");
        const inp = host.querySelector(`[data-numfor="${rid}"][data-month="${month}"]`);
        if (inp.value === "") { msg("ap-msg", "Type the number first.", false); return; }
        b.disabled = true;
        try { await api("/invoicing/recurring/quantity", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ recurring_id: rid, month, qty: Number(inp.value) }) }); msg("ap-msg", "Saved. It goes out on its day with that number.", true); loadApprovals(); }
        catch (err) { msg("ap-msg", /recurring_quantities/.test(err.message) ? "Run supabase/invoicing_automation_2.sql first." : err.message, false); b.disabled = false; }
      }));
    }
    // The switch for everything the morning run sends (Dani, 6 Nov 2026).
    function drawJobs() {
      const on = currentSettings.morning_jobs_on, ready = on !== undefined;
      $("ap-jobs-note").textContent = !ready ? "Run supabase/morning_jobs_switch.sql first. Until then, they stay off." : on
        ? "On. Each morning: the note to clients the day after a shoot, invoice due-date reminders, the gallery expiry warning, alerts to the team, the TEG sheet sync and the automatic invoicing above, in whichever mode it's set to."
        : "Off, so nothing goes by itself at 8am. Turning it on starts the note to clients the day after a shoot, invoice due-date reminders, the gallery expiry warning, alerts to the team, the TEG sheet sync and the automatic invoicing above, in whichever mode it's set to.";
      $("ap-jobs-tog").querySelectorAll("button").forEach((b) => { b.disabled = !ready; b.setAttribute("aria-pressed", String((b.dataset.v === "1") === !!on)); });
    }
    $("ap-jobs-tog").addEventListener("click", async (e) => {
      const b = e.target.closest("[data-v]"); if (!b) return;
      const v = b.dataset.v === "1";
      if (v === !!currentSettings.morning_jobs_on) return;
      if (v && !confirm("Turn the 8am jobs on? From tomorrow morning, reminders and alerts go by themselves.")) return;
      try { await api("/invoicing/settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ morning_jobs_on: v }) }); currentSettings.morning_jobs_on = v; drawJobs(); msg("ap-msg", v ? "The 8am jobs are on." : "The 8am jobs are off.", true); }
      catch (err) { msg("ap-msg", err.message, false); }
    });
    $("ap-mode").addEventListener("change", async (e) => {
      const v = e.target.value;
      if (v === "live" && !confirm("Live: recurring invoices will go to clients on their day, and approved shoot invoices will go to clients straight away. Carry on?")) { loadApprovals(); return; }
      try { await api("/invoicing/settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ automation_mode: v }) }); msg("ap-msg", v === "off" ? "Automatic invoicing is off." : v === "test" ? "Test mode: drafts are made and every email comes to you." : "Live: invoices go to clients.", true); }
      catch (err) { msg("ap-msg", /automation_mode/.test(err.message) ? "Run supabase/invoicing_automation.sql first." : err.message, false); }
    });
    $("ap-run").addEventListener("click", async (e) => {
      const b = e.currentTarget; b.disabled = true; b.textContent = "Running…";
      try { const r = await api("/invoicing/automation/run", { method: "POST" }); msg("ap-msg", r.mode === "off" ? "It's off: switch it to Test or Live first." : r.lines ? `Done: ${r.lines} thing${r.lines === 1 ? "" : "s"} happened, and you've been emailed what.` : "Done: nothing was due today.", true); loadApprovals(); }
      catch (err) { msg("ap-msg", err.message, false); }
      finally { b.disabled = false; b.textContent = "Run it now"; }
    });

    /* ---- The month (Dani, 5-6 Nov 2026) ----------------------------------
       Worked out from the invoices by Worker /invoicing/book, never typed in. */
    let BOOK = null, TODAY = "", PENDING = [], NUMBERS = [], TICKS = null, RELEASED = [];
    const S = { month: "", kind: "all", status: "", q: "" };
    const KINDS = [["social", "Social media"], ["video", "Videography"], ["agent", "Agent services"], ["oneoff", "One-offs"]];
    const svc = (v) => (v.kind === "video" ? "Videography" : v.kind === "agent" ? "Agent services" : v.kind === "social" ? "Social media" : "One-off");
    const ICON_NOTE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v12l-5 5H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 21v-5h5M9 8h6M9 12h6"/></svg>';
    const ICON_MAIL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>';
    const day = (d) => (d ? new Date(d + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short" }) : "");
    const sum = (a) => a.reduce((t, v) => t + v.net_pence, 0);
    const isOver = (v) => v.status === "sent" && v.due && v.due < TODAY;
    const state = (v) => (v.status === "paid" ? "paid" : v.status === "draft" ? "draft" : isOver(v) ? "over" : "wait");
    const byId = (id) => (BOOK || []).find((x) => x.id === id);
    const held = (v) => v.content_ready && v.status !== "paid";
    function chip(v) {
      const s = state(v);
      if (s === "paid") return `<span class="chip good">Paid ${esc(day(v.paid_on))}</span>`;
      // With someone to approve (Jack, for shoots): nothing for you to do (Dani, 10 Nov).
      if (s === "draft") return PENDING.some((x) => x.invoice_id === v.id) ? '<span class="chip wait">Waiting for approval</span>' : '<span class="chip plain">Draft, not sent</span>';
      if (s === "over") return '<span class="chip bad">Overdue</span>';
      // Sent, and its due date hasn't come: waiting on payment.
      return '<span class="chip plain">Sent, not due yet</span>';
    }
    const flags = (v) => `<div class="flags">${chip(v)}${held(v) ? '<span class="chip wait">Content ready</span>' : ""}</div>`;
    function pass(v) {
      if (S.kind !== "all" && v.kind !== S.kind) return false;
      if (S.q && `${v.client} ${v.payer} ${v.number}`.toLowerCase().indexOf(S.q) < 0) return false;
      if (S.status === "paid" && v.status !== "paid") return false;
      if (S.status === "wait" && state(v) !== "wait") return false;
      if (S.status === "over" && state(v) !== "over") return false;
      return true;
    }
    function row(v) {
      const open = v.status === "sent";
      return `<tr class="click" data-inv="${esc(v.id)}" tabindex="0"><td>${esc(v.client)}</td><td class="tx">${esc(v.what)}</td><td class="tx">${esc(v.number)}</td><td class="tx">${esc(v.payer)}</td><td class="tx">${v.sent ? esc(day(v.sent)) : "—"}</td><td class="tx">${esc(day(v.due))}</td><td class="num">${gb(v.net_pence)}</td><td>${flags(v)}</td><td><div class="row-acts"><button type="button" class="ic${v.note ? " has" : ""}" data-note="${esc(v.id)}" aria-label="${v.note ? "Read the note" : "Add a note"}" title="${v.note ? "There's a note" : "Add a note"}">${ICON_NOTE}</button>${open ? `<button type="button" class="ic" data-email="${esc(v.id)}" aria-label="Email accounts about this one" title="Email accounts about this one">${ICON_MAIL}</button>` : ""}</div></td></tr>`;
    }
    const THEAD = '<thead><tr><th>Client</th><th>For</th><th>Invoice</th><th>Who pays</th><th>Sent</th><th>Due</th><th class="num">Net</th><th>Status</th><th></th></tr></thead>';
    const table = (list) => `<div class="tablewrap" data-lenis-prevent><table class="grid-us">${THEAD}<tbody>${list.map(row).join("")}</tbody></table></div>`;

    async function loadBook() {
      const st = $("io-state"), main = $("io-main");
      if (!BOOK) { st.hidden = false; st.className = "state"; st.textContent = "Loading…"; main.hidden = true; }
      try {
        const d = await api("/invoicing/book");
        BOOK = d.invoices || []; TODAY = d.today; PENDING = d.pending || []; NUMBERS = d.numbers || []; TICKS = d.ticks || null; RELEASED = d.released || [];
        if (!S.month) S.month = TODAY.slice(0, 7);
        st.hidden = true; main.hidden = false;
        drawBook();
      } catch (err) { st.hidden = false; st.className = "state bad"; st.textContent = err.message; main.hidden = true; }
    }
    function months() {
      const now = TODAY.slice(0, 7), first = (BOOK.map((v) => v.month).filter(Boolean).sort()[0]) || now, out = [];
      for (let m = first; m <= now; m = ymAddMonths(m, 1)) out.push(m);
      return out;
    }
    function drawBook() {
      const ms = months();
      $("io-month").textContent = ymLong(S.month);
      $("io-prev").disabled = S.month === ms[0]; $("io-next").disabled = S.month === ms[ms.length - 1];
      const inMonth = BOOK.filter((v) => v.month === S.month);
      const c = {}; inMonth.forEach((v) => { c[v.kind] = (c[v.kind] || 0) + 1; });
      const overAll = BOOK.filter((v) => state(v) === "over");
      $("io-chips").innerHTML = `<button type="button" data-kind="all" aria-pressed="${S.kind === "all"}">All</button>` + KINDS.filter((k) => c[k[0]]).map((k) => `<button type="button" data-kind="${k[0]}" aria-pressed="${S.kind === k[0]}">${k[1]} <i>${c[k[0]]}</i></button>`).join("") + `<button type="button" data-status="over" aria-pressed="${S.status === "over"}">Overdue <i>${overAll.length}</i></button>`;
      const live = inMonth.filter((v) => v.status !== "draft"), paid = live.filter((v) => v.status === "paid"), wait = live.filter((v) => state(v) === "wait");
      const n = (a) => `${a.length} ${a.length === 1 ? "invoice" : "invoices"}`;
      const fig = (cls, key, val, label) => `<button type="button" class="fig ${cls}" data-status="${key}" aria-pressed="${!!key && S.status === key}"><b>${val}</b><span>${label}</span></button>`;
      $("io-figs").innerHTML = fig("lin", "", gb(sum(live)), `Raised in ${ymLong(S.month).split(" ")[0]}, ${n(live)}`) + fig("lin", "paid", gb(sum(paid)), `Paid, ${n(paid)}`) + fig("lin", "wait", gb(sum(wait)), `Waiting on payment, ${wait.length} not yet due`) + fig("dark", "over", gb(sum(overAll)), `Overdue, ${overAll.length} from any month`);

      // Needs you: only things someone has to do, worked out from the invoices.
      const needs = [];
      const need = (title, words, foot) => `<div class="need"><div class="need-t">${esc(title)}</div><p>${words}</p><div class="need-f">${foot}</div></div>`;
      RELEASED.forEach((x) => needs.push(need(x.client, `Released before payment${x.service ? `: ${esc(x.service)}` : ""}. ${x.number ? `${esc(x.number)} ${x.status === "draft" ? "is still a draft" : "isn't paid yet"}.` : "No invoice raised yet."}`, `<a class="mbtn" href="/admin/videography?booking=${encodeURIComponent(x.id)}">Open the shoot</a>`)));
      BOOK.filter(held).forEach((v) => {
        const last = v.reminders[v.reminders.length - 1];
        needs.push(need(v.client, `Jack's finished, but ${esc(v.number)} isn't marked paid, so their content is held.${last ? ` Reminder sent ${esc(day(last))}.` : ""}`, `<button type="button" class="mbtn" data-inv="${esc(v.id)}">Open</button><button type="button" class="mbtn primary" data-email="${esc(v.id)}">Urgent reminder</button>`));
      });
      BOOK.filter((v) => v.status === "draft").forEach((v) => {
        const ap = PENDING.find((x) => x.invoice_id === v.id);
        const who = ap ? String(ap.approver_email || "").split("@")[0].split(/[._-]/)[0].replace(/^./, (m) => m.toUpperCase()) : "";
        needs.push(need(v.client, ap ? `Invoice ${esc(v.number)} is drafted, waiting for ${esc(who)} to approve.${v.kind === "video" ? " It goes two days before the shoot." : ""}` : `Invoice ${esc(v.number)} is a draft. It hasn't been sent.`, `<button type="button" class="mbtn" data-inv="${esc(v.id)}">Open</button>${ap ? `<button type="button" class="mbtn primary" data-approve="${esc(ap.id)}">Approve and send</button>` : `<button type="button" class="mbtn primary" data-send="${esc(v.id)}">Send</button>`}`));
      });
      NUMBERS.forEach((x) => needs.push(need(x.name, `${esc(x.label)} in ${esc(x.month_label.split(" ")[0])}?${x.unit_pence ? ` ${gb(x.unit_pence)} each,` : ""} goes out on the ${x.day}${[11, 12, 13].includes(x.day % 100) ? "th" : ({ 1: "st", 2: "nd", 3: "rd" }[x.day % 10] || "th")}.`, `<input type="number" min="0" step="1" data-numfor="${esc(x.recurring_id)}|${esc(x.month)}" aria-label="${esc(x.label)}" placeholder="0"><button type="button" class="mbtn primary" data-numsave="${esc(x.recurring_id)}|${esc(x.month)}">Save</button>`)));
      if (TICKS) needs.push(need("Social media ticks", `Abigail has ticked ${TICKS.ticked} of ${TICKS.total} clients for ${esc(TICKS.month_label.split(" ")[0])}. Anyone not ticked isn't invoiced.`, `<a class="mbtn" href="/admin/social?go=invoices">Open the list</a>`));
      $("io-needs-n").textContent = needs.length; $("io-needs").innerHTML = needs.join(""); $("io-needs-sec").hidden = !needs.length;

      const earlier = BOOK.filter((v) => v.month < S.month && ["over", "wait"].includes(state(v)) && pass(v));
      $("io-open").innerHTML = earlier.length ? `<div class="section" style="margin-top:26px"><div class="strip"><div class="strip-t">Still open from earlier months<span>${earlier.length}</span></div></div>${table(earlier)}</div>` : "";
      let html = "";
      KINDS.forEach((k) => {
        const list = inMonth.filter((v) => v.kind === k[0] && pass(v));
        if (list.length) html += `<div class="section" style="margin-top:26px"><div class="strip"><div class="strip-t">${k[1]}<span>${list.length}</span></div><span class="aside">${gb(sum(list))}</span></div>${table(list)}</div>`;
      });
      $("io-streams").innerHTML = html || (earlier.length ? "" : '<div class="empty" style="margin-top:26px">Nothing matches that.</div>');
    }
    $("io-prev").addEventListener("click", () => { const m = months(), i = m.indexOf(S.month); if (i > 0) { S.month = m[i - 1]; drawBook(); } });
    $("io-next").addEventListener("click", () => { const m = months(), i = m.indexOf(S.month); if (i < m.length - 1) { S.month = m[i + 1]; drawBook(); } });
    $("io-q").addEventListener("input", (e) => { S.q = e.target.value.trim().toLowerCase(); drawBook(); });

    /* ---- Pop-outs ---- */
    function popShell(eye, title, chips, body, foot, wide) {
      $("io-pop").innerHTML = `<div class="scrim" id="io-scrim"><div class="pop${wide ? " wide" : ""}" role="dialog" aria-modal="true" aria-label="${esc(eye)}"><div class="pop-h"><div><p class="mo-eye" style="margin:0">${esc(eye)}</p><div class="pop-title">${title}</div>${chips || ""}</div><button type="button" class="x" data-close aria-label="Close">×</button></div><div class="pop-b" data-lenis-prevent>${body}</div><div class="pop-f">${foot}</div></div></div>`;
      fitScrim();
    }
    window.addEventListener("resize", fitScrim);
    const closePop = () => { $("io-pop").innerHTML = ""; };
    let toastT;
    function toast(m) { const t = $("io-toast"); t.textContent = m; t.classList.add("on"); clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove("on"), 2800); }
    const postJson = (path, data) => api(path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });

    function openInv(id) {
      const v = byId(id); if (!v) return;
      const who = v.route === "internal" ? "Inter-brand. Accounts settle it on the portal." : v.method === "direct_debit" ? "Direct debit, so it isn't on the portal." : v.status === "paid" && v.paid_how === "Card" ? "Paid by card, so it confirmed itself." : "External client. Accounts confirm it on the portal.";
      const tl = [];
      if (v.sent) tl.push(`<li>Sent to ${esc(v.payer)}, ${esc(day(v.sent))}</li>`);
      v.reminders.forEach((d) => tl.push(`<li>Reminder sent to accounts, ${esc(day(d))}</li>`));
      if (v.status === "paid") tl.push(`<li>Paid ${esc(day(v.paid_on))} (${esc(v.paid_how)})</li>`);
      else if (v.status === "draft") tl.push(`<li class="next">${PENDING.some((x) => x.invoice_id === v.id) ? "Waiting to be approved, then it sends" : "Not sent yet"}</li>`);
      else tl.push('<li class="next">On the accounts portal, waiting to be confirmed</li>');
      if (v.release) tl.push(`<li class="next">${esc(v.release)} held until this is paid</li>`);
      const sectorName = v.sector === "pick" ? "not chosen yet" : SECTOR_NAME[v.sector];
      const sectors = `<option value="">As the rule says (${esc(sectorName)})</option>` + Object.keys(SECTOR_NAME).map((k) => `<option value="${k}"${v.sector_chosen && v.sector === k ? " selected" : ""}>${esc(SECTOR_NAME[k])}</option>`).join("");
      const foot = ['<button type="button" class="mbtn" data-close>Close</button>', `<button type="button" class="mbtn" data-pdf="${esc(v.id)}">View PDF</button>`];
      if (v.status === "draft") foot.push(`<button type="button" class="mbtn" data-edit="${esc(v.id)}">Edit</button>`, `<button type="button" class="mbtn danger" data-del="${esc(v.id)}">Delete</button>`, `<button type="button" class="mbtn primary" data-send="${esc(v.id)}">Send</button>`);
      else {
        foot.push(`<button type="button" class="mbtn" data-edit="${esc(v.id)}">Reissue</button>`, `<button type="button" class="mbtn danger" data-void="${esc(v.id)}">Void</button>`, `<button type="button" class="mbtn" data-send="${esc(v.id)}">Resend</button>`);
        if (v.status === "sent") foot.push(`<button type="button" class="mbtn" data-email="${esc(v.id)}">Email accounts</button>`, `<button type="button" class="mbtn primary" data-mark="${esc(v.id)}">Mark paid</button>`);
      }
      popShell(`Invoice ${v.number}`, esc(v.client), flags(v),
        `<dl class="rows"><div><dt>For</dt><dd>${esc(v.what)}</dd></div><div><dt>Type</dt><dd>${esc(svc(v))}</dd></div><div><dt>Who pays</dt><dd>${esc(v.payer)}</dd></div><div><dt>How</dt><dd>${esc(who)}</dd></div><div><dt>Sent</dt><dd>${v.sent ? esc(day(v.sent)) : "Not yet"}</dd></div><div><dt>Due</dt><dd>${esc(day(v.due))}</dd></div><div><dt>Net</dt><dd>${gb(v.net_pence)} (${gb(v.total_pence)} with VAT)</dd></div>` +
        v.lines.map((l) => `<div><dt>${esc(gb(l.net_pence))} + VAT</dt><dd>${esc(l.description)}</dd></div>`).join("") +
        `<div><dt>Revenue goes under</dt><dd><select data-sector="${esc(v.id)}" aria-label="Which sector its revenue goes under">${sectors}</select></dd></div>` +
        `<div><dt>Was a card link sent?</dt><dd><span class="tog"><button type="button" data-card="${esc(v.id)}" data-v="1" aria-pressed="${!!v.pay_by_card}">Yes</button><button type="button" data-card="${esc(v.id)}" data-v="0" aria-pressed="${!v.pay_by_card}">No</button></span></dd></div>` +
        (v.note ? `<div><dt>Note</dt><dd style="white-space:normal">${esc(v.note)}</dd></div>` : "") +
        `</dl><div><p class="mo-eye">What's happened</p><ul class="tl">${tl.join("")}</ul></div>`,
        foot.join(""), true);
    }
    function openNote(id) {
      const v = byId(id); if (!v) return;
      popShell(`${v.number}, ${v.client}`, "A note", "", `<label class="field"><span>Anything worth remembering on this one. Both sides can see it.</span><textarea id="io-note" rows="10" placeholder="e.g. Paying with the next batch on Friday">${esc(v.note || "")}</textarea></label>`, `<button type="button" class="mbtn" data-close>Cancel</button><button type="button" class="mbtn primary" data-savenote="${esc(v.id)}">Save</button>`);
      $("io-note").focus();
    }
    function openEmail(id) {
      const v = byId(id); if (!v) return;
      const urgent = held(v), amt = `${gb(v.net_pence)} + VAT`;
      const words = urgent
        ? `${v.client}'s content is finished, but we can't release it until invoice ${v.number} for ${amt} is marked as paid. Could you take a look today?`
        : `Invoice ${v.number} for ${amt} (${v.client}) is still open. Could you let us know where it's up to?`;
      popShell("Email accounts", urgent ? "Urgent reminder" : "A reminder", "",
        `<label class="field"><span>To</span><input value="The accounts team, as set in Settings" readonly></label><label class="field"><span>Subject</span><input id="io-em-sub" value="${esc((urgent ? "Urgent: " : "") + v.number + (urgent ? ", content waiting on payment." : ", still open."))}"></label><label class="field"><span>Message</span><textarea id="io-em-body" rows="9">${esc(`Hi Paula,\n\n${words}\n\nYou can mark it on your page: [link to the portal]\n\nThank you.`)}</textarea></label>`,
        `<button type="button" class="mbtn" data-close>Cancel</button><button type="button" class="mbtn primary" data-sendemail="${esc(v.id)}">Send</button>`);
    }

    // The month-end email: to Paula, short, and what to do.
    async function openMonthEnd() {
      popShell("Month-end email", "Coming up to month end", "", '<p class="state">Loading…</p>', '<button type="button" class="mbtn" data-close>Close</button>', true);
      try {
        const d = await api("/invoicing/month-end");
        popShell("Month-end email", "Coming up to month end", "",
          `${whoLine(d)}<p style="margin:0;color:var(--tx)">${d.emails_on ? "Goes by itself on the 20th, and again on the 28th if anything's still open. This is what it says." : "This is what it says. It isn't going by itself yet: switch that on in Settings, under Accounts portal, once you've tested it."}</p><div class="mail">${d.html}</div>`,
          `<button type="button" class="mbtn" data-close>Close</button><button type="button" class="mbtn" data-mesend="test">Send me a test</button><button type="button" class="mbtn primary" data-mesend="live">Send to accounts</button>`, true);
      } catch (err) { popShell("Month-end email", "Coming up to month end", "", `<p class="state bad">${esc(err.message)}</p>`, '<button type="button" class="mbtn" data-close>Close</button>', true); }
    }

    // The Month-end review, for whichever month you're on.
    let REVIEW = null, reviewDraft = null;
    async function openReview() {
      const m = S.month, thisMonth = TODAY.slice(0, 7), title = esc(ymLong(m)) + (m === thisMonth ? " so far" : "");
      const shell = (body, foot) => popShell("Month-end review", title, "", body, foot, true);
      shell('<p class="state">Reading the payments. This can take a few seconds.</p>', '<button type="button" class="mbtn" data-close>Close</button>');
      try {
        if (!REVIEW) {
          const [pay, costs] = await Promise.all([api("/admin/payments?days=400"), api("/revenue/costs")]);
          REVIEW = { rev: revenueByMonth(pay.payments), costs: costs.rows || [] };
        }
        const last = m < thisMonth && m < ymAddMonths(thisMonth, -5) ? m : thisMonth;
        const list = []; for (let i = 5; i >= 0; i--) list.push(ymAddMonths(last, -i));
        const revenueByMonthShown = {}; list.forEach((k) => { revenueByMonthShown[k] = REVIEW.rev[k] || { social: 0, video: 0, studio: 0, agent: 0, pick: 0 }; });
        const open = BOOK.filter((v) => v.month === m && v.status === "sent" && v.method !== "direct_debit");
        const box = (a) => ({ n: a.length, p: sum(a) });
        reviewDraft = { month: m, thisMonth, months: list, revenueByMonth: revenueByMonthShown, costs: REVIEW.costs, open: { interBrand: box(open.filter((v) => v.route === "internal")), client: box(open.filter((v) => v.route !== "internal")), overdue: box(open.filter(isOver)) } };
        shell(reviewBody(reviewDraft, 780), '<button type="button" class="mbtn" data-close>Close</button><button type="button" class="mbtn" id="io-rv-dl">Download</button><button type="button" class="mbtn primary" id="io-rv-send">Send to Sam</button>');
      } catch (err) { shell(`<p class="state bad">${esc(err.message)}</p>`, '<button type="button" class="mbtn" data-close>Close</button>'); }
    }
    async function reviewPdf(btn) {
      const was = btn.textContent; btn.disabled = true; btn.textContent = "Building…";
      try {
        const res = await fetch(`${WORKER}/invoicing/month-review`, { method: "POST", headers: { "Content-Type": "application/json", Authorization: "Bearer " + (await authToken()) }, body: JSON.stringify({ action: "download", data: reviewDraft }) });
        if (!res.ok) { const b = await res.json().catch(() => ({})); throw new Error(b.error || "Couldn't build the PDF."); }
        const blob = await res.blob(), a = document.createElement("a");
        a.href = URL.createObjectURL(blob); a.download = `TMKE-month-end-review-${reviewDraft.month}.pdf`;
        document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      } catch (err) { toast(err.message); }
      finally { btn.disabled = false; btn.textContent = was; }
    }

    // Who's doing what: every click on the month and its pop-outs.
    async function fullInvoice(id) { return (await api(`/invoicing/invoice?id=${encodeURIComponent(id)}`)).invoice; }
    document.addEventListener("click", async (e) => {
      const t = e.target; if (!t.closest) return;
      let b;
      if (!t.closest(".mo")) return;
      if (t.closest("[data-close]") || t.id === "io-scrim") { closePop(); return; }
      if ((b = t.closest("[data-kind]"))) { S.kind = b.dataset.kind; drawBook(); return; }
      if ((b = t.closest("[data-status]"))) { const st = b.dataset.status; S.status = S.status === st ? "" : st; drawBook(); return; }
      if (t.closest("#io-mend")) { openMonthEnd(); return; }
      if (t.closest("#io-mrev")) { openReview(); return; }
      if ((b = t.closest("#io-rv-dl"))) { reviewPdf(b); return; }
      if ((b = t.closest("#io-rv-send"))) {
        b.disabled = true;
        try { const r = await postJson("/invoicing/month-review", { action: "email", data: reviewDraft }); toast(`Sent to ${r.to}.`); } catch (err) { toast(err.message); }
        b.disabled = false; return;
      }
      if ((b = t.closest("[data-mesend]"))) {
        const test = b.dataset.mesend === "test"; b.disabled = true;
        try { const r = await postJson("/invoicing/month-end", { test }); toast(`Sent to ${r.to}.`); } catch (err) { toast(err.message); }
        b.disabled = false; return;
      }
      if ((b = t.closest("[data-note]"))) { e.stopPropagation(); openNote(b.dataset.note); return; }
      if ((b = t.closest("[data-savenote]"))) {
        const v = byId(b.dataset.savenote), note = $("io-note").value.trim(); b.disabled = true;
        try { await postJson("/invoicing/book/update", { id: v.id, note }); v.note = note; closePop(); toast(note ? "Saved. Accounts can see it too." : "Note removed."); drawBook(); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-email]"))) { openEmail(b.dataset.email); return; }
      if ((b = t.closest("[data-sendemail]"))) {
        const v = byId(b.dataset.sendemail); b.disabled = true;
        try { const r = await postJson("/invoicing/accounts-email", { id: v.id, subject: $("io-em-sub").value, body: $("io-em-body").value }); v.reminders = r.reminders; closePop(); toast(`Sent to ${r.to}. It's on the invoice's history.`); drawBook(); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-approve]"))) {
        b.disabled = true;
        try { const r = await postJson("/invoicing/approval/decide", { approval_id: b.dataset.approve }); toast(r.title || "Done."); closePop(); await loadBook(); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-send]"))) {
        b.disabled = true;
        try { const inv = await fullInvoice(b.dataset.send); riReview(inv); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-mark]"))) {
        b.disabled = true;
        try { await api("/invoicing/invoices", { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: b.dataset.mark, status: "paid" }) }); closePop(); toast("Marked paid."); await loadBook(); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-pdf]"))) {
        const tab = window.open("", "_blank"); b.disabled = true;
        try { const out = await api(`/invoicing/invoice-pdf?id=${encodeURIComponent(b.dataset.pdf)}`); if (tab) tab.location = out.url; else location = out.url; }
        catch (err) { if (tab) tab.close(); toast(err.message); }
        b.disabled = false; return;
      }
      if ((b = t.closest("[data-edit]"))) { const id = b.dataset.edit; closePop(); editInvoice(id); return; }
      if ((b = t.closest("[data-void]"))) {
        const reason = prompt("Void this invoice? It'll be removed and accounts + you will be emailed.\n\nReason for voiding:"); if (reason === null) return;
        b.disabled = true;
        try { await postJson("/invoicing/invoices/void", { id: b.dataset.void, reason }); closePop(); toast("Voided."); await loadBook(); } catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-del]"))) {
        if (!confirm("Delete this invoice? This permanently removes it and its PDF. It can't be undone.")) return;
        b.disabled = true;
        try { await api(`/invoicing/invoices?id=${encodeURIComponent(b.dataset.del)}`, { method: "DELETE" }); closePop(); toast("Deleted."); await loadBook(); } catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-card]"))) {
        const v = byId(b.dataset.card), val = b.dataset.v === "1";
        try { await postJson("/invoicing/book/update", { id: v.id, pay_by_card: val }); v.pay_by_card = val; openInv(v.id); } catch (err) { toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-numsave]"))) {
        const [rid, month] = b.dataset.numsave.split("|"), inp = document.querySelector(`[data-numfor="${rid}|${month}"]`);
        if (!inp || inp.value === "") { toast("Type the number first."); return; }
        b.disabled = true;
        try { await postJson("/invoicing/recurring/quantity", { recurring_id: rid, month, qty: Number(inp.value) }); toast("Saved. It goes out on its day with that number."); await loadBook(); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-inv]")) && !t.closest("a")) { openInv(b.dataset.inv); return; }
    });
    document.addEventListener("change", async (e) => {
      const sel = e.target.closest && e.target.closest("[data-sector]"); if (!sel) return;
      const v = byId(sel.dataset.sector), val = sel.value;
      try { await postJson("/invoicing/book/update", { id: v.id, sector: val }); toast("Saved."); REVIEW = null; await loadBook(); openInv(v.id); } catch (err) { toast(err.message); }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closePop();
      const r = e.target.closest && e.target.closest("tr[data-inv]"); if (r && e.key === "Enter" && e.target === r) openInv(r.dataset.inv);
    });
    document.addEventListener("mousemove", (e) => {
      const tg = e.target.closest && e.target.closest("[data-tip]"), tip = $("io-tip");
      if (!tg) { tip.hidden = true; return; }
      tip.textContent = tg.getAttribute("data-tip"); tip.hidden = false;
      tip.style.left = Math.min(e.clientX + 12, innerWidth - 170) + "px"; tip.style.top = (e.clientY - 34) + "px";
    });

    /* ---- The accounts portal's settings ---- */
    let PT = {};
    const PT_CC_READY = () => !$("pt-cc").disabled;
    const whoLine = (d) => `<p style="margin:0"><b style="font-weight:400;color:var(--tx)">To:</b> ${esc(d.to)}${d.cc ? `<br><b style="font-weight:400;color:var(--tx)">Copied in:</b> ${esc(d.cc)}` : ""}</p>`;
    const ptTog = (id, on) => $(id).querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String((x.dataset.v === "1") === !!on)));
    function ptDraw(d) {
      PT = { enabled: d.enabled, emails_on: d.emails_on };
      $("pt-link").value = d.link; $("pt-code").value = d.passcode; $("pt-to").value = d.email_to; $("pt-cc").value = d.email_cc || ""; $("pt-cc").disabled = !d.cc_ready; $("pt-cc").placeholder = d.cc_ready ? "" : "Run supabase/accounts_portal_recipients.sql first";
      ptTog("pt-on", d.enabled); ptTog("pt-auto", d.emails_on);
      $("pt-last").textContent = d.last_opened_at ? `Last opened ${new Date(d.last_opened_at).toLocaleString("en-GB", { day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" })}.` : "Nobody has opened it yet.";
    }
    async function loadPortal() {
      const st = $("pt-state"), main = $("pt-main");
      st.hidden = false; st.className = "state"; st.textContent = "Loading…"; main.hidden = true;
      try { ptDraw(await api("/invoicing/portal-settings")); st.hidden = true; main.hidden = false; drawFirstLast(); }
      catch (err) { st.className = "state bad"; st.textContent = err.message; }
    }
    // The first email: read it, test it, send it.
    async function drawFirstLast() {
      try { const d = await api("/invoicing/first-email"); $("pt-first-last").textContent = d.last_sent_at ? `Last sent to ${d.last_sent_to} on ${new Date(d.last_sent_at).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })}.` : "Not sent yet."; return d; }
      catch (err) { $("pt-first-last").textContent = err.message; return null; }
    }
    $("pt-first").addEventListener("click", async () => {
      popShell("Accounts portal", "First email", "", '<p class="state">Loading…</p>', '<button type="button" class="mbtn" data-close>Close</button>', true);
      const d = await drawFirstLast();
      if (!d) { popShell("Accounts portal", "First email", "", '<p class="state bad">Couldn\'t load the email. Please try again.</p>', '<button type="button" class="mbtn" data-close>Close</button>', true); return; }
      popShell("Accounts portal", "First email", "", `${whoLine(d)}<p style="margin:0"><b style="font-weight:400;color:var(--tx)">Subject:</b> ${esc(d.subject)}</p><div class="mail">${d.html}</div><p style="margin:0">Then this goes straight after it, to the same people.</p><p style="margin:0"><b style="font-weight:400;color:var(--tx)">Subject:</b> ${esc(d.passcode_subject)}</p><div class="mail">${d.passcode_html}</div>`, `<button type="button" class="mbtn" data-close>Close</button><button type="button" class="mbtn" data-firstsend="test">Send me a test</button><button type="button" class="mbtn primary" data-firstsend="live" data-again="${d.last_sent_at ? "1" : ""}">Send to accounts</button>`, true);
    });
    document.addEventListener("click", async (e) => {
      const b = e.target.closest && e.target.closest("[data-firstsend]"); if (!b) return;
      const test = b.dataset.firstsend === "test";
      if (!test && b.dataset.again && !confirm("This has been sent before. Send it again?")) return;
      b.disabled = true;
      try { const r = await postJson("/invoicing/first-email", { test }); toast(`Both emails sent to ${r.to}.`); if (!test) { closePop(); drawFirstLast(); } }
      catch (err) { toast(err.message); }
      b.disabled = false;
    });
    $("pt-on").addEventListener("click", (e) => { const b = e.target.closest("[data-v]"); if (b) { PT.enabled = b.dataset.v === "1"; ptTog("pt-on", PT.enabled); } });
    $("pt-auto").addEventListener("click", (e) => { const b = e.target.closest("[data-v]"); if (b) { PT.emails_on = b.dataset.v === "1"; ptTog("pt-auto", PT.emails_on); } });
    $("pt-copy").addEventListener("click", async () => { try { await navigator.clipboard.writeText($("pt-link").value); toast("Link copied."); } catch (_) { $("pt-link").select(); toast("Press Cmd+C to copy it."); } });
    $("pt-gen").addEventListener("click", () => {
      const A = "ABCDEFGHJKMNPQRSTUVWXYZ23456789", r = crypto.getRandomValues(new Uint8Array(6));
      $("pt-code").value = [...r].map((x) => A[x % A.length]).join("");
      toast("That's the new one. Press Save to use it.");
    });
    $("pt-save").addEventListener("click", async (e) => {
      const b = e.currentTarget; b.disabled = true;
      try { ptDraw(await postJson("/invoicing/portal-settings", { enabled: PT.enabled, emails_on: PT.emails_on, email_to: $("pt-to").value, ...(PT_CC_READY() ? { email_cc: $("pt-cc").value } : {}), passcode: $("pt-code").value })); toast("Saved."); }
      catch (err) { toast(err.message); }
      b.disabled = false;
    });


    document.addEventListener("ash:ready", () => {
      initTemplate(); loadSettings(); loadRecipients(); loadRecurringOptions();
      // Deep link from the reminder: /admin/invoicing?tab=monthly
      const want = new URLSearchParams(location.search).get("tab");
      showPanel(PANEL_HEAD[want] ? want : "overview");
    });
  </script>
</AdminShell>
