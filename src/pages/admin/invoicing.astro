    .ap-notes { margin-top: 4px; font-size: 12px; color: rgba(28,29,34,0.65); max-width: 320px; }
    .ap-numbers { border: 1px solid rgba(28,29,34,0.12); border-radius: 8px; padding: 14px 16px; margin: 0 0 18px; background: #fff; }
