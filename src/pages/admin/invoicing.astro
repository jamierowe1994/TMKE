    .mc-chip { display: inline-block; padding: 3px 9px; border-radius: 999px; font-family: var(--sans); font-size: 11.5px; font-weight: 700; white-space: nowrap; }
    .mc-chip.is-late { background: rgba(179,38,30,0.12); color: #a3261e; }
