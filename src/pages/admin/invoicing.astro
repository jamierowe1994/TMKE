    .mc-y { color: #2e7d46; font-weight: 700; } .mc-n { color: #b3261e; font-weight: 700; } .mc-d { color: #8a6a24; font-weight: 700; font-size: 11.5px; } .mc-na { color: rgba(28,29,34,0.3); }
