---
import AdminShell from "../../components/admin/AdminShell.astro";
---

<AdminShell active="invoicing" title="Invoicing">
  <div class="inv-wrap">
    <nav class="inv-tabs" id="inv-tabs">
      <button type="button" class="inv-tab is-active" data-tab="create">Create invoice</button>
      <button type="button" class="inv-tab" data-tab="invoices">Invoices</button>
      <button type="button" class="inv-tab" data-tab="settings">Settings</button>
      <button type="button" class="inv-tab" data-tab="template">Template</button>
      <button type="button" class="inv-tab" data-tab="book">Address book</button>
    </nav>

    <!-- Create invoice -->
    <section class="inv-panel" data-panel="create">
      <div class="inv-tpl-grid">
        <div class="ash-card">
          <div class="ash-card-head"><div class="ash-card-title">Create an invoice</div></div>
          <div class="ash-card-body">
            <p class="inv-intro">Build it, preview it, then save. It's numbered automatically and uses your saved template.</p>
            <h3 class="inv-h">Bill to</h3>
            <label class="inv-field"><span>From the address book</span><select id="ci-recip"><option value="">— Choose a partner, or type below —</option></select></label>
            <label class="inv-field"><span>Name *</span><input id="ci-name" placeholder="e.g. Fine &amp; Country — Rugby" /></label>
            <div class="inv-row2b">
              <label class="inv-field"><span>Email</span><input id="ci-email" type="email" /></label>
              <label class="inv-field"><span>Address</span><input id="ci-address" /></label>
            </div>
            <h3 class="inv-h">Dates</h3>
            <div class="inv-row2b">
              <label class="inv-field"><span>Issued</span><input id="ci-issued" type="date" /></label>
              <label class="inv-field"><span>Due</span><input id="ci-due" type="date" /></label>
            </div>
            <h3 class="inv-h">Line items</h3>
            <div id="ci-items"></div>
            <button type="button" class="inv-pdf-btn" id="ci-add-item">+ Add line</button>
            <div class="ci-totals" id="ci-totals"></div>
            <label class="inv-field" style="margin-top:16px"><span>Notes (optional)</span><textarea id="ci-notes" rows="2" placeholder="e.g. Thank you for your business."></textarea></label>
            <p class="inv-msg" id="ci-msg" hidden></p>
            <button type="button" class="inv-save" id="ci-create">Create invoice</button>
          </div>
        </div>
        <div class="inv-preview-wrap">
          <div class="inv-preview-head"><span class="inv-preview-lbl">Preview — A4</span><button type="button" class="inv-pdf-btn" id="ci-open-pdf">Open / save as PDF ↗</button></div>
          <div class="inv-preview-box" id="ci-preview-box"><iframe id="ci-preview" title="Invoice preview" scrolling="no"></iframe></div>
        </div>
      </div>
    </section>

    <!-- Invoices list -->
    <section class="inv-panel" data-panel="invoices" hidden>
      <div class="ash-card">
        <div class="ash-card-head"><div class="ash-card-title">Invoices</div></div>
        <div class="ash-card-body">
          <div class="inv-list" id="inv-list"><p class="inv-empty">Loading…</p></div>
        </div>
      </div>
    </section>

    <!-- Settings -->
    <section class="inv-panel" data-panel="settings" hidden>
      <div class="ash-card">
        <div class="ash-card-head"><div class="ash-card-title">Your invoice details</div></div>
        <div class="ash-card-body">
          <p class="inv-intro">These appear on every invoice you send, and set your numbering + terms. Your accounts team is copied on every invoice.</p>
          <form id="inv-form" class="inv-form">
            <h3 class="inv-h">Company</h3>
            <label class="inv-field"><span>Company name</span><input name="company_name" placeholder="The Marketing Experts (Nationwide) Ltd" /></label>
            <label class="inv-field"><span>Registered address</span><textarea name="company_address" rows="2"></textarea></label>
            <div class="inv-row">
              <label class="inv-field"><span>Company no.</span><input name="company_reg_no" /></label>
              <label class="inv-field"><span>VAT number</span><input name="vat_number" /></label>
              <label class="inv-field"><span>VAT rate (%)</span><input name="vat_rate" type="number" step="0.1" /></label>
            </div>

            <h3 class="inv-h">Payment (bank transfer)</h3>
            <div class="inv-row">
              <label class="inv-field"><span>Account name</span><input name="account_name" /></label>
              <label class="inv-field"><span>Sort code</span><input name="sort_code" placeholder="00-00-00" /></label>
              <label class="inv-field"><span>Account number</span><input name="account_number" /></label>
            </div>

            <h3 class="inv-h">Invoicing</h3>
            <div class="inv-row">
              <label class="inv-field"><span>Invoice prefix</span><input name="invoice_prefix" placeholder="TMKE" /></label>
              <label class="inv-field"><span>Next number</span><input name="next_number" type="number" /></label>
              <label class="inv-field"><span>Payment terms (days)</span><input name="payment_terms_days" type="number" /></label>
            </div>
            <label class="inv-field"><span>Accounts team — CC on every invoice</span><input name="accounts_cc_email" placeholder="accounts@…, another@…" /></label>
            <label class="inv-field"><span>Footer note (optional)</span><textarea name="footer_note" rows="2" placeholder="e.g. Thank you for your business."></textarea></label>

            <p class="inv-msg" id="inv-msg" hidden></p>
            <button type="submit" class="inv-save" id="inv-save">Save details</button>
          </form>
        </div>
      </div>
    </section>

    <!-- Template -->
    <section class="inv-panel" data-panel="template" hidden>
      <div class="inv-tpl-grid">
        <div class="ash-card">
          <div class="ash-card-head"><div class="ash-card-title">Design</div></div>
          <div class="ash-card-body">
            <p class="inv-intro">Pick a starting style, then tweak the colour and logo. The preview updates live.</p>
            <h3 class="inv-h">Style</h3>
            <div class="inv-styles" id="inv-styles">
              <button type="button" class="inv-style" data-style="editorial"><span class="inv-style-name">Editorial</span><span class="inv-style-sub">Big type, paper</span></button>
              <button type="button" class="inv-style" data-style="banded"><span class="inv-style-name">Banded</span><span class="inv-style-sub">Wine header + beige footer</span></button>
              <button type="button" class="inv-style" data-style="minimal"><span class="inv-style-name">Minimal</span><span class="inv-style-sub">Airy, hairlines</span></button>
            </div>
            <h3 class="inv-h">Typeface <span class="inv-h-note">Outlook-safe fonts only</span></h3>
            <div class="inv-row2">
              <label class="inv-field"><span>Font</span><select id="tpl-font">
                <option value="Arial, Helvetica, sans-serif">Arial</option>
                <option value="Calibri, Candara, Segoe, 'Segoe UI', Optima, Arial, sans-serif">Calibri</option>
                <option value="'Trebuchet MS', Tahoma, sans-serif">Trebuchet MS</option>
                <option value="Verdana, Geneva, sans-serif">Verdana</option>
                <option value="Tahoma, Geneva, sans-serif">Tahoma</option>
                <option value="Georgia, 'Times New Roman', serif">Georgia</option>
                <option value="'Times New Roman', Times, serif">Times New Roman</option>
              </select></label>
              <label class="inv-field"><span>Base size (px)</span><input id="tpl-fs" type="number" min="10" max="18" step="1" /></label>
            </div>

            <h3 class="inv-h">Brand</h3>
            <label class="inv-field"><span>Accent colour</span><span class="inv-colour"><input type="color" id="tpl-accent-c" /><input type="text" id="tpl-accent-h" placeholder="#371e28" /></span></label>
            <label class="inv-field"><span>Logo</span><span class="inv-logo-row">
              <input id="tpl-logo" placeholder="Paste an image URL, or upload →" />
              <label class="inv-upload"><input type="file" id="tpl-logo-file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden /><span id="tpl-upload-lbl">Upload</span></label>
            </span></label>
            <label class="inv-toggle"><input type="checkbox" id="tpl-bank" /><span>Show bank details on the invoice</span></label>
            <p class="inv-msg" id="tpl-msg" hidden></p>
            <button type="button" class="inv-save" id="tpl-save">Save template</button>
          </div>
        </div>
        <div class="inv-preview-wrap">
          <div class="inv-preview-head">
            <span class="inv-preview-lbl">Preview — to-scale A4</span>
            <button type="button" class="inv-pdf-btn" id="inv-open-pdf">Open full size / save as PDF ↗</button>
          </div>
          <div class="inv-preview-box" id="inv-preview-box"><iframe id="inv-preview" title="Invoice preview" scrolling="no"></iframe></div>
        </div>
      </div>
    </section>

    <!-- Address book -->
    <section class="inv-panel" data-panel="book" hidden>
      <div class="ash-card">
        <div class="ash-card-head"><div class="ash-card-title">Address book</div></div>
        <div class="ash-card-body">
          <p class="inv-intro">The partners you invoice — Fine &amp; Country offices, The Property Experts finance, etc. Pick from these when sending an invoice.</p>
          <form id="rec-form" class="inv-book-form">
            <div class="inv-row">
              <label class="inv-field"><span>Name *</span><input name="name" placeholder="e.g. Fine &amp; Country — Rugby" /></label>
              <label class="inv-field"><span>Billing email *</span><input name="email" type="email" placeholder="accounts@…" /></label>
            </div>
            <div class="inv-row">
              <label class="inv-field"><span>Contact name</span><input name="contact_name" /></label>
              <label class="inv-field"><span>Address</span><input name="address" /></label>
            </div>
            <p class="inv-msg" id="rec-msg" hidden></p>
            <button type="submit" class="inv-save" id="rec-add">Add to address book</button>
          </form>
          <div class="inv-book-list" id="rec-list"><p class="inv-empty">Loading…</p></div>
        </div>
      </div>
    </section>
  </div>

  <style is:global>
    .inv-wrap { max-width: 900px; }
    .inv-tabs { display: flex; gap: 4px; margin-bottom: 18px; }
    .inv-tab { appearance: none; cursor: pointer; background: none; border: 0; border-radius: 9px; padding: 9px 16px; font-family: var(--sans); font-size: 13.5px; font-weight: 700; color: rgba(28,29,34,0.55); transition: background 0.15s, color 0.15s; }
    .inv-tab:hover { background: rgba(28,29,34,0.05); color: var(--ink); }
    .inv-tab.is-active { background: var(--english-violet); color: #fff; }
    .inv-panel[hidden] { display: none; }
    .inv-intro { font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: rgba(28,29,34,0.65); margin: 0 0 20px; max-width: 640px; }
    .inv-h { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin: 22px 0 12px; padding-bottom: 8px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .inv-h:first-child { margin-top: 0; }
    .inv-form, .inv-book-form { display: flex; flex-direction: column; gap: 14px; }
    .inv-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .inv-book-form .inv-row { grid-template-columns: 1fr 1fr; }
    @media (max-width: 640px) { .inv-row, .inv-book-form .inv-row { grid-template-columns: 1fr; } }
    .inv-field { display: flex; flex-direction: column; gap: 6px; }
    .inv-field > span { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .inv-field input, .inv-field textarea { font-family: var(--sans); font-size: 14.5px; padding: 10px 12px; border-radius: 9px; border: 1px solid rgba(28,29,34,0.14); background: #fff; color: var(--ink); resize: vertical; }
    .inv-field input:focus, .inv-field textarea:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .inv-save { align-self: flex-start; margin-top: 8px; appearance: none; cursor: pointer; background: var(--english-violet); color: #fff; border: 0; border-radius: 9px; padding: 12px 24px; font-family: var(--sans); font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; transition: opacity 0.2s; }
    .inv-save:hover { opacity: 0.9; }
    .inv-save:disabled { opacity: 0.5; cursor: not-allowed; }
    .inv-msg { font-family: var(--sans); font-size: 13px; border-radius: 8px; padding: 9px 12px; margin: 4px 0 0; }
    .inv-msg.is-ok { background: rgba(60,150,90,0.1); color: #2e6b40; }
    .inv-msg.is-err { background: rgba(200,70,50,0.1); color: #a3372b; }
    .inv-book-list { margin-top: 22px; display: flex; flex-direction: column; gap: 10px; }
    .inv-empty { font-family: var(--sans); font-size: 13.5px; color: rgba(28,29,34,0.5); margin: 0; }
    .rec-row { display: flex; align-items: center; gap: 14px; padding: 13px 16px; background: var(--paper); border: 1px solid rgba(28,29,34,0.09); border-radius: 12px; }
    .rec-meta { flex: 1; min-width: 0; }
    .rec-name { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); }
    .rec-sub { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .rec-remove { appearance: none; cursor: pointer; background: none; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; padding: 7px 13px; font-family: var(--sans); font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.7); flex: none; transition: background 0.2s, border-color 0.2s, color 0.2s; }
    .rec-remove:hover { background: rgba(200,70,50,0.08); border-color: rgba(200,70,50,0.4); color: #a3372b; }

    /* Template tab */
    .inv-panel[data-panel="template"] { max-width: 1180px; }
    .inv-tpl-grid { display: grid; grid-template-columns: 380px 1fr; gap: 20px; align-items: start; }
    @media (max-width: 900px) { .inv-tpl-grid { grid-template-columns: 1fr; } }
    .inv-styles { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 10px; margin-bottom: 4px; }
    @media (max-width: 460px) { .inv-styles { grid-template-columns: 1fr; } }
    .inv-style { text-align: left; cursor: pointer; background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 10px; padding: 12px 13px; display: flex; flex-direction: column; gap: 3px; transition: border-color 0.15s, box-shadow 0.15s; }
    .inv-style:hover { border-color: rgba(55,30,40,0.4); }
    .inv-style.is-active { border-color: var(--english-violet); box-shadow: 0 0 0 2px var(--english-violet); }
    .inv-style-name { font-family: var(--sans); font-size: 13.5px; font-weight: 700; color: var(--ink); }
    .inv-style-sub { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.5); }
    .inv-colour { display: flex; gap: 8px; align-items: center; }
    .inv-colour input[type="color"] { width: 42px; height: 40px; padding: 2px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; background: #fff; cursor: pointer; }
    .inv-colour input[type="text"] { flex: 1; font-family: ui-monospace, Menlo, monospace; }
    .inv-toggle { display: flex; align-items: center; gap: 10px; font-family: var(--sans); font-size: 14px; color: var(--ink); cursor: pointer; margin-top: 4px; }
    .inv-toggle input { width: 17px; height: 17px; accent-color: var(--english-violet); }
    .inv-preview-wrap { position: sticky; top: 16px; }
    .inv-preview-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 8px; }
    .inv-preview-lbl { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .inv-pdf-btn { appearance: none; cursor: pointer; background: #fff; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; padding: 7px 12px; font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--english-violet); transition: background 0.15s, border-color 0.15s; }
    .inv-pdf-btn:hover { background: var(--paper); border-color: var(--english-violet); }
    /* True-size A4 iframe (794x1123 @96dpi) scaled uniformly to fit the column,
       so the on-screen proportions exactly match a printed A4 sheet. */
    .inv-preview-box { width: 100%; overflow: hidden; border: 1px solid rgba(28,29,34,0.12); border-radius: 12px; background: #cfccc8; }
    #inv-preview, #ci-preview { width: 794px; height: 1123px; border: 0; display: block; transform-origin: top left; }
    .inv-panel[data-panel="create"] { max-width: 1180px; }
    .inv-row2b { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
    @media (max-width: 640px) { .inv-row2b { grid-template-columns: 1fr; } }
    .ci-item { display: grid; grid-template-columns: 1fr 130px 34px; gap: 8px; align-items: center; margin-bottom: 8px; }
    .ci-item input { font-family: var(--sans); font-size: 14px; padding: 9px 11px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; background: #fff; color: var(--ink); }
    .ci-item input:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .ci-del { appearance: none; cursor: pointer; border: 1px solid rgba(28,29,34,0.14); background: #fff; border-radius: 8px; height: 38px; font-size: 18px; line-height: 1; color: rgba(28,29,34,0.55); }
    .ci-del:hover { background: rgba(200,70,50,0.08); border-color: rgba(200,70,50,0.4); color: #a3372b; }
    .ci-totals { margin-top: 14px; border-top: 1px solid rgba(28,29,34,0.1); padding-top: 12px; font-family: var(--sans); }
    .ci-totals .r { display: flex; justify-content: space-between; font-size: 13.5px; padding: 3px 0; color: rgba(28,29,34,0.7); }
    .ci-totals .r.grand { font-size: 16px; font-weight: 800; color: var(--ink); margin-top: 4px; }
    .inv-list { display: flex; flex-direction: column; gap: 8px; }
    .invrow { display: grid; grid-template-columns: 110px 1fr 110px 96px auto; gap: 14px; align-items: center; padding: 12px 16px; background: var(--paper); border: 1px solid rgba(28,29,34,0.09); border-radius: 10px; font-family: var(--sans); font-size: 13.5px; }
    .invrow .num { font-weight: 700; color: var(--ink); }
    .invrow .amt { text-align: right; font-weight: 700; }
    .inv-badge { justify-self: start; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; }
    .inv-badge.draft { background: rgba(28,29,34,0.08); color: rgba(28,29,34,0.6); }
    .inv-badge.sent { background: rgba(55,30,40,0.1); color: var(--english-violet); }
    .inv-badge.paid { background: rgba(60,150,90,0.14); color: #2e6b40; }
    .inv-badge.void { background: rgba(200,70,50,0.1); color: #a3372b; }
    .invrow .markpaid { appearance: none; cursor: pointer; border: 1px solid rgba(28,29,34,0.16); background: none; border-radius: 8px; padding: 6px 12px; font-family: var(--sans); font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.7); }
    .invrow .markpaid:hover { background: rgba(60,150,90,0.1); border-color: rgba(60,150,90,0.4); color: #2e6b40; }
    .inv-h-note { font-weight: 400; letter-spacing: 0; text-transform: none; color: rgba(28,29,34,0.4); margin-left: 8px; font-size: 11px; }
    .inv-row2 { display: grid; grid-template-columns: 1fr 120px; gap: 12px; }
    .inv-field select { font-family: var(--sans); font-size: 14.5px; padding: 10px 12px; border-radius: 9px; border: 1px solid rgba(28,29,34,0.14); background: #fff; color: var(--ink); }
    .inv-logo-row { display: flex; gap: 8px; align-items: stretch; }
    .inv-logo-row input { flex: 1; }
    .inv-upload { display: inline-flex; align-items: center; padding: 0 16px; border-radius: 9px; border: 1px solid rgba(28,29,34,0.14); background: #fff; font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--ink); cursor: pointer; white-space: nowrap; transition: background 0.15s; }
    .inv-upload:hover { background: var(--paper); }
  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";
    import { renderInvoiceHtml, sampleInvoice } from "../../lib/invoice-render.js";
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    let currentSettings = {};
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    async function authToken() {
      try {
        let s = (await supabase.auth.getSession()).data.session;
        if (!s || (s.expires_at && s.expires_at * 1000 < Date.now() + 60000)) { try { const r = await supabase.auth.refreshSession(); if (r.data && r.data.session) s = r.data.session; } catch (_) {} }
        return (s && s.access_token) || "";
      } catch (_) { return ""; }
    }
    async function api(pathname, opts = {}) {
      const token = await authToken();
      const res = await fetch(`${WORKER}${pathname}`, { ...opts, headers: { ...(opts.headers || {}), Authorization: "Bearer " + token } });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.error || "Something went wrong.");
      return d;
    }

    // Tabs
    $("inv-tabs").addEventListener("click", (e) => {
      const b = e.target.closest("[data-tab]"); if (!b) return;
      document.querySelectorAll(".inv-tab").forEach((t) => t.classList.toggle("is-active", t === b));
      document.querySelectorAll(".inv-panel").forEach((p) => { p.hidden = p.getAttribute("data-panel") !== b.getAttribute("data-tab"); });
      const tab = b.getAttribute("data-tab");
      if (tab === "template") scaleFit();
      if (tab === "create") ciScaleFit();
      if (tab === "invoices") loadInvoices();
    });

    function msg(id, text, ok) { const m = $(id); m.textContent = text; m.className = "inv-msg " + (ok ? "is-ok" : "is-err"); m.hidden = false; }

    // The editable settings fields (must match the <input name="…"> set below).
    const FIELDS = ["company_name", "company_address", "company_reg_no", "vat_number", "vat_rate", "account_name", "sort_code", "account_number", "invoice_prefix", "next_number", "payment_terms_days", "accounts_cc_email", "footer_note"];

    // ---- Settings ----
    async function loadSettings() {
      if (!WORKER) { msg("inv-msg", "Connect the Worker (PUBLIC_R2_WORKER_URL) to manage invoicing.", false); return; }
      try {
        const { settings } = await api("/invoicing/settings");
        currentSettings = settings || {};
        const f = $("inv-form");
        for (const k of FIELDS) { const el = f.elements[k]; if (el && currentSettings[k] != null) el.value = currentSettings[k]; }
        initTemplate();
        initCreate();
      } catch (err) { msg("inv-msg", err.message, false); }
    }
    $("inv-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target, btn = $("inv-save");
      const body = {};
      for (const k of FIELDS) { const el = f.elements[k]; const v = el ? el.value.trim() : ""; body[k] = (["vat_rate", "payment_terms_days", "next_number"].includes(k)) ? (v === "" ? null : Number(v)) : (v || null); }
      btn.disabled = true; btn.textContent = "Saving…";
      try { await api("/invoicing/settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) }); msg("inv-msg", "Saved.", true); }
      catch (err) { msg("inv-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Save details"; }
    });

    // ---- Address book ----
    function renderRecipients(list) {
      const wrap = $("rec-list");
      if (!list.length) { wrap.innerHTML = '<p class="inv-empty">No partners yet — add one above.</p>'; return; }
      wrap.innerHTML = list.map((r) => `<div class="rec-row">
        <div class="rec-meta"><div class="rec-name">${esc(r.name)}</div><div class="rec-sub">${esc(r.email)}${r.contact_name ? " · " + esc(r.contact_name) : ""}${r.address ? " · " + esc(r.address) : ""}</div></div>
        <button type="button" class="rec-remove" data-id="${esc(r.id)}" data-name="${esc(r.name)}">Remove</button>
      </div>`).join("");
    }
    async function loadRecipients() {
      const wrap = $("rec-list");
      if (!WORKER) { wrap.innerHTML = '<p class="inv-empty">Connect the Worker to manage the address book.</p>'; return; }
      try { const { recipients } = await api("/invoicing/recipients"); ciRecipients = recipients || []; renderRecipients(ciRecipients); fillRecipientSelect(); }
      catch (err) { wrap.innerHTML = `<p class="inv-empty">${esc(err.message)}</p>`; }
    }
    function fillRecipientSelect() {
      const sel = $("ci-recip"); if (!sel) return;
      sel.innerHTML = '<option value="">— Choose a partner, or type below —</option>' + ciRecipients.map((r) => `<option value="${esc(r.id)}">${esc(r.name)}</option>`).join("");
    }
    $("rec-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target, btn = $("rec-add");
      const name = f.name.value.trim(), email = f.email.value.trim();
      if (!name || !email) { msg("rec-msg", "A name and billing email are required.", false); return; }
      btn.disabled = true; btn.textContent = "Adding…";
      try {
        await api("/invoicing/recipients", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name, email, contact_name: f.contact_name.value.trim(), address: f.address.value.trim() }) });
        f.reset(); $("rec-msg").hidden = true; loadRecipients();
      } catch (err) { msg("rec-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Add to address book"; }
    });
    $("rec-list").addEventListener("click", async (e) => {
      const btn = e.target.closest(".rec-remove"); if (!btn) return;
      if (!confirm(`Remove ${btn.getAttribute("data-name")} from the address book?`)) return;
      try { await api(`/invoicing/recipients?id=${encodeURIComponent(btn.getAttribute("data-id"))}`, { method: "DELETE" }); loadRecipients(); }
      catch (err) { alert(err.message); }
    });

    // ---- Template ----
    const tplState = { template: "editorial", accent_color: "#371e28", logo_url: "", show_bank: true, font_family: "Arial, Helvetica, sans-serif", font_size: 13 };
    const LEGACY_STYLE = { classic: "editorial", modern: "banded" };
    function currentInvoiceHtml() {
      const settings = { ...currentSettings, ...tplState };
      return renderInvoiceHtml({ settings, invoice: sampleInvoice(settings) });
    }
    // Scale the true-size (794px) A4 iframe down to fit the column so the preview
    // is exactly proportional to a printed sheet.
    function scaleFit() {
      const box = $("inv-preview-box"); if (!box || !box.clientWidth) return;
      const k = Math.min(1, box.clientWidth / 794);
      $("inv-preview").style.transform = `scale(${k})`;
      box.style.height = Math.round(1123 * k) + "px";
    }
    function renderPreview() { $("inv-preview").srcdoc = currentInvoiceHtml(); scaleFit(); }
    window.addEventListener("resize", scaleFit);
    $("inv-open-pdf").addEventListener("click", () => {
      const w = window.open("", "_blank"); if (!w) return;
      w.document.open(); w.document.write(currentInvoiceHtml()); w.document.close();
    });
    function syncStyleButtons() { document.querySelectorAll(".inv-style").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-style") === tplState.template)); }
    function initTemplate() {
      const t = LEGACY_STYLE[currentSettings.template] || currentSettings.template;
      tplState.template = ["editorial", "banded", "minimal"].includes(t) ? t : "editorial";
      tplState.accent_color = currentSettings.accent_color || "#371e28";
      tplState.logo_url = currentSettings.logo_url || "";
      tplState.show_bank = currentSettings.show_bank !== false;
      tplState.font_family = currentSettings.font_family || "Arial, Helvetica, sans-serif";
      tplState.font_size = currentSettings.font_size || 13;
      $("tpl-accent-c").value = /^#[0-9a-fA-F]{6}$/.test(tplState.accent_color) ? tplState.accent_color : "#371e28";
      $("tpl-accent-h").value = tplState.accent_color;
      $("tpl-logo").value = tplState.logo_url;
      $("tpl-bank").checked = tplState.show_bank;
      $("tpl-font").value = tplState.font_family;
      $("tpl-fs").value = tplState.font_size;
      syncStyleButtons();
      renderPreview();
    }
    $("inv-styles").addEventListener("click", (e) => { const b = e.target.closest(".inv-style"); if (!b) return; tplState.template = b.getAttribute("data-style"); syncStyleButtons(); renderPreview(); });
    $("tpl-accent-c").addEventListener("input", (e) => { tplState.accent_color = e.target.value; $("tpl-accent-h").value = e.target.value; renderPreview(); });
    $("tpl-accent-h").addEventListener("input", (e) => { const v = e.target.value.trim(); tplState.accent_color = v; if (/^#[0-9a-fA-F]{6}$/.test(v)) $("tpl-accent-c").value = v; renderPreview(); });
    $("tpl-logo").addEventListener("input", (e) => { tplState.logo_url = e.target.value.trim(); renderPreview(); });
    $("tpl-bank").addEventListener("change", (e) => { tplState.show_bank = e.target.checked; renderPreview(); });
    $("tpl-font").addEventListener("change", (e) => { tplState.font_family = e.target.value; renderPreview(); });
    $("tpl-fs").addEventListener("input", (e) => { const n = parseInt(e.target.value, 10); tplState.font_size = (n >= 10 && n <= 18) ? n : 13; renderPreview(); });
    // Logo upload → Supabase storage (public), sets the URL.
    $("tpl-logo-file").addEventListener("change", async (e) => {
      const file = e.target.files && e.target.files[0]; if (!file) return;
      if (file.size > 3 * 1024 * 1024) { msg("tpl-msg", "That image is a bit large — keep it under ~3 MB.", false); return; }
      const lbl = $("tpl-upload-lbl"), prev = lbl.textContent; lbl.textContent = "Uploading…";
      try {
        const ext = (file.name.split(".").pop() || "png").toLowerCase().replace(/[^a-z0-9]/g, "");
        const path = `invoice-logo/logo-${Date.now()}.${ext}`;
        const { error } = await supabase.storage.from("avatars").upload(path, file, { upsert: true, cacheControl: "3600", contentType: file.type });
        if (error) throw error;
        const { data } = supabase.storage.from("avatars").getPublicUrl(path);
        tplState.logo_url = data.publicUrl; $("tpl-logo").value = data.publicUrl; renderPreview();
        msg("tpl-msg", "Logo uploaded — don't forget to Save template.", true);
      } catch (err) { msg("tpl-msg", err.message || "Couldn't upload that image.", false); }
      finally { lbl.textContent = prev; }
    });
    $("tpl-save").addEventListener("click", async () => {
      const btn = $("tpl-save"); btn.disabled = true; btn.textContent = "Saving…";
      try {
        await api("/invoicing/settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ template: tplState.template, accent_color: tplState.accent_color, logo_url: tplState.logo_url || null, show_bank: tplState.show_bank, font_family: tplState.font_family, font_size: tplState.font_size }) });
        Object.assign(currentSettings, tplState);
        msg("tpl-msg", "Template saved.", true);
      } catch (err) { msg("tpl-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Save template"; }
    });

    // ---- Create invoice ----
    let ciRecipients = [];
    let ciItems = [{ description: "", amount: "" }];
    const gbp = (p) => "£" + ((p || 0) / 100).toFixed(2);
    const isoToday = () => new Date().toISOString().slice(0, 10);
    function ciTotals() {
      const vatRate = Number(currentSettings.vat_rate != null ? currentSettings.vat_rate : 20);
      const subtotal = ciItems.reduce((s, it) => s + Math.round((parseFloat(it.amount) || 0) * 100), 0);
      const vat = Math.round(subtotal * vatRate / 100);
      return { subtotal, vat, total: subtotal + vat, vatRate };
    }
    function ciBuildInvoice() {
      const t = ciTotals();
      return {
        number: (currentSettings.invoice_prefix || "TMKE") + (currentSettings.next_number || 1001),
        issued_date: $("ci-issued").value || null, due_date: $("ci-due").value || null,
        bill_to_name: $("ci-name").value.trim(), bill_to_email: $("ci-email").value.trim(), bill_to_address: $("ci-address").value.trim(),
        line_items: ciItems.map((it) => ({ description: it.description, qty: 1, unit_pence: Math.round((parseFloat(it.amount) || 0) * 100) })),
        subtotal_pence: t.subtotal, vat_pence: t.vat, total_pence: t.total,
      };
    }
    function ciRenderItems() {
      $("ci-items").innerHTML = ciItems.map((it, i) => `<div class="ci-item"><input class="ci-desc" data-i="${i}" placeholder="Description of the service" value="${esc(it.description)}"/><input class="ci-amt" data-i="${i}" type="number" step="0.01" placeholder="0.00" value="${esc(it.amount)}"/><button type="button" class="ci-del" data-i="${i}" title="Remove">&times;</button></div>`).join("");
    }
    function ciRenderTotals() {
      const t = ciTotals();
      $("ci-totals").innerHTML = `<div class="r"><span>Sub-total</span><span>${gbp(t.subtotal)}</span></div><div class="r"><span>VAT (${t.vatRate}%)</span><span>${gbp(t.vat)}</span></div><div class="r grand"><span>Total</span><span>${gbp(t.total)}</span></div>`;
    }
    function ciScaleFit() { const box = $("ci-preview-box"); if (!box || !box.clientWidth) return; const k = Math.min(1, box.clientWidth / 794); $("ci-preview").style.transform = `scale(${k})`; box.style.height = Math.round(1123 * k) + "px"; }
    function ciPreview() { $("ci-preview").srcdoc = renderInvoiceHtml({ settings: currentSettings, invoice: ciBuildInvoice() }); ciScaleFit(); }
    function ciRefresh() { ciRenderItems(); ciRenderTotals(); ciPreview(); }
    function initCreate() {
      if (!$("ci-issued").value) $("ci-issued").value = isoToday();
      if (!$("ci-due").value) { const d = new Date(); d.setDate(d.getDate() + Number(currentSettings.payment_terms_days || 7)); $("ci-due").value = d.toISOString().slice(0, 10); }
      ciRefresh();
    }
    $("ci-items").addEventListener("input", (e) => { const i = +e.target.getAttribute("data-i"); if (e.target.classList.contains("ci-desc")) ciItems[i].description = e.target.value; else if (e.target.classList.contains("ci-amt")) ciItems[i].amount = e.target.value; ciRenderTotals(); ciPreview(); });
    $("ci-items").addEventListener("click", (e) => { const b = e.target.closest(".ci-del"); if (!b) return; ciItems.splice(+b.getAttribute("data-i"), 1); if (!ciItems.length) ciItems.push({ description: "", amount: "" }); ciRefresh(); });
    $("ci-add-item").addEventListener("click", () => { ciItems.push({ description: "", amount: "" }); ciRefresh(); });
    ["ci-name", "ci-email", "ci-address", "ci-issued", "ci-due"].forEach((id) => $(id).addEventListener("input", ciPreview));
    $("ci-recip").addEventListener("change", (e) => { const r = ciRecipients.find((x) => x.id === e.target.value); if (r) { $("ci-name").value = r.name; $("ci-email").value = r.email || ""; $("ci-address").value = r.address || ""; ciPreview(); } });
    $("ci-open-pdf").addEventListener("click", () => { const w = window.open("", "_blank"); if (!w) return; w.document.open(); w.document.write(renderInvoiceHtml({ settings: currentSettings, invoice: ciBuildInvoice() })); w.document.close(); });
    $("ci-create").addEventListener("click", async () => {
      const inv = ciBuildInvoice();
      if (!inv.bill_to_name) { msg("ci-msg", "Enter a recipient name.", false); return; }
      if (!inv.line_items.some((it) => it.description || it.unit_pence)) { msg("ci-msg", "Add at least one line item.", false); return; }
      const btn = $("ci-create"); btn.disabled = true; btn.textContent = "Creating…";
      try {
        const { invoice } = await api("/invoicing/invoices", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ bill_to_name: inv.bill_to_name, bill_to_email: inv.bill_to_email || null, bill_to_address: inv.bill_to_address || null, recipient_id: $("ci-recip").value || null, issued_date: inv.issued_date, due_date: inv.due_date, notes: $("ci-notes").value.trim() || null, line_items: inv.line_items }) });
        msg("ci-msg", `Invoice ${invoice.number} created (draft) — see the Invoices tab.`, true);
        ciItems = [{ description: "", amount: "" }]; ["ci-name", "ci-email", "ci-address", "ci-notes"].forEach((id) => { $(id).value = ""; }); $("ci-recip").value = "";
        currentSettings.next_number = (currentSettings.next_number || 1001) + 1;
        ciRefresh();
      } catch (err) { msg("ci-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Create invoice"; }
    });
    window.addEventListener("resize", ciScaleFit);

    // ---- Invoices list ----
    async function loadInvoices() {
      const wrap = $("inv-list");
      if (!WORKER) { wrap.innerHTML = '<p class="inv-empty">Connect the Worker to view invoices.</p>'; return; }
      try {
        const { invoices } = await api("/invoicing/invoices");
        if (!invoices.length) { wrap.innerHTML = '<p class="inv-empty">No invoices yet — create one.</p>'; return; }
        const d = (x) => x ? new Date(x + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : "—";
        wrap.innerHTML = invoices.map((v) => `<div class="invrow"><span class="num">${esc(v.number)}</span><span>${esc(v.bill_to_name)}<div style="font-size:11.5px;color:rgba(28,29,34,0.5)">Due ${d(v.due_date)}</div></span><span class="amt">${gbp(v.total_pence)}</span><span class="inv-badge ${esc(v.status)}">${esc(v.status)}</span>${v.status !== "paid" && v.status !== "void" ? `<button type="button" class="markpaid" data-id="${esc(v.id)}">Mark paid</button>` : `<span style="font-size:11.5px;color:rgba(28,29,34,0.45)">${v.paid_date ? "Paid " + d(v.paid_date) : ""}</span>`}</div>`).join("");
      } catch (err) { wrap.innerHTML = `<p class="inv-empty">${esc(err.message)}</p>`; }
    }
    $("inv-list").addEventListener("click", async (e) => { const b = e.target.closest(".markpaid"); if (!b) return; b.disabled = true; try { await api("/invoicing/invoices", { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: b.getAttribute("data-id"), status: "paid" }) }); loadInvoices(); } catch (err) { alert(err.message); b.disabled = false; } });

    document.addEventListener("ash:ready", () => { initTemplate(); loadSettings(); loadRecipients(); });
  </script>
</AdminShell>
