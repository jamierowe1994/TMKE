    .mc-alloc-row .a { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .mc-alloc-row.is-other { opacity: 0.6; }
    .mc-modal { position: fixed; inset: 0; z-index: 200; background: rgba(28,24,28,0.4); display: flex; align-items: flex-start; justify-content: center; padding: 12vh 16px 16px; }
    .mc-modal[hidden] { display: none; }
    .mc-modal-box { background: #fff; border-radius: 12px; width: min(520px, 100%); padding: 20px 22px; box-shadow: 0 24px 60px -24px rgba(20,18,26,0.5); }
    .mc-modal-box h3 { font-family: var(--serif); font-size: 19px; font-weight: 500; color: var(--ink); margin: 0; letter-spacing: -0.05em; }
    .mc-skip { display: flex; align-items: center; gap: 8px; font-family: var(--sans); font-size: 13px; color: var(--ink); margin: 10px 0 4px; cursor: pointer; }
    .mc-skip input { accent-color: var(--english-violet); }
    .mc-modal-acts, .mc-form-acts { display: flex; gap: 10px; justify-content: flex-end; margin-top: 14px; }
    .mc-form-acts { justify-content: flex-start; }
    .mc-key { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); margin: 0 0 22px; }
    /* Section headings in the card title's style ("Monthly checklist"). */
    .mc-h { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted, #887d77); margin: 8px 0 8px; }
    /* Automatic invoicing (Danielle, 21 Oct 2026) */
    .mc-auto { border: 1px solid rgba(28,29,34,0.12); border-radius: 8px; padding: 14px 16px 6px; margin: 14px 0 6px; }
    .hub-skin .mc-auto-on, .mc-auto-on { display: inline-flex; align-items: center; gap: 8px; font-weight: 700; font-size: 13px; text-transform: none; letter-spacing: 0; margin: 0 0 6px; cursor: pointer; }
    .mc-auto-on input { width: 16px; height: 16px; accent-color: var(--english-violet); }
    .ap-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; margin-bottom: 14px; }
    .ap-head > div:first-child { flex: 1 1 420px; }
    .ap-mode { display: flex; align-items: flex-end; gap: 10px; }
    .ap-pill { display: inline-block; padding: 2px 9px; border-radius: 999px; font-size: 11px; font-weight: 700; background: rgba(28,29,34,0.07); color: rgba(28,29,34,0.6); }
    .ap-pill.is-pending { background: #fff1c9; color: #7a5a05; }
    .ap-pill.is-approved { background: rgba(46,107,64,0.12); color: #2e6b40; }
