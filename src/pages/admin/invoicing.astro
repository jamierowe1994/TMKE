    .ci-totals { margin-top: 14px; border-top: 1px solid rgba(28,29,34,0.1); padding-top: 12px; font-family: var(--sans); }
    .ci-totals .r { display: flex; justify-content: space-between; font-size: 13.5px; padding: 3px 0; color: rgba(28,29,34,0.7); }
    .ci-totals .r.grand { font-size: 16px; font-weight: 800; color: var(--ink); margin-top: 4px; }
    .inv-list { display: flex; flex-direction: column; gap: 8px; overflow-x: auto; }

    .rep-controls { display: flex; gap: 10px; align-items: center; flex-wrap: wrap; }
    .rep-month {
      padding: 7px 10px; border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 3px;
      font-family: var(--sans); font-size: 13px; color: var(--ink); background: #fff;
    }
    .rep-totals { display: flex; gap: 26px; flex-wrap: wrap; margin: 0 0 22px; }
    .rep-tot-k {
      display: block; font-family: var(--sans); font-size: 10px; letter-spacing: 0.16em;
      text-transform: uppercase; color: rgba(28,29,34,0.5); margin-bottom: 4px;
    }
    .rep-tot-v { font-family: var(--sans); font-size: 19px; font-weight: 700; color: var(--ink); }
    .rep-group { margin: 0 0 28px; }
    .rep-group h4 {
      font-family: var(--sans); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--english-violet); margin: 0 0 4px;
    }
    .rep-group p.rep-why { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); margin: 0 0 12px; }
    .rep-table { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: 13px; }
    .rep-table th {
      text-align: left; font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
      color: rgba(28,29,34,0.5); padding: 0 10px 8px 0; border-bottom: 1px solid rgba(28,29,34,0.12);
    }
    .rep-table td { padding: 9px 10px 9px 0; border-bottom: 1px solid rgba(28,29,34,0.07); vertical-align: top; }
    .rep-table .num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .rep-late { color: #a05a3c; font-weight: 600; }
    .rep-wrap { overflow-x: auto; }
    .invrow { min-width: 860px; }
    /* No cap on this panel: the row needs the width, and capping it was what
       forced the name column and the buttons to compete for the same pixels. */
    .inv-panel[data-panel="invoices"] { max-width: none; }
    .invrow .num, .invrow .amt { white-space: nowrap; }
    /* The paid date has its own column and the tools column is reserved at a
       fixed width. Before, the date sat inside the tools cluster, so a paid row
       held different content to an unpaid one and every column shifted with it -
       which is why the amount and status stopped lining up down the list. */
    /* minmax(0, 1fr), not 1fr. A plain 1fr refuses to go below its min-content
       width, so when the row overflows, the name column stops shrinking and
       every column after it moves by however wide THAT row's client name
       happens to be - which is why rows drifted a couple of pixels apart. */
    .invrow { display: grid; grid-template-columns: 88px minmax(160px, 1fr) 86px 70px auto; gap: 12px; align-items: center; padding: 12px 16px; background: var(--paper); border: 1px solid rgba(28,29,34,0.09); border-radius: 10px; font-family: var(--sans); font-size: 13.5px; }
    /* Five fixed action slots. A row keeps every slot whether or not it has a
       button in it, so Edit sits under Edit and Delete under Delete all the way
       down - and Send and Resend are the same width despite different words. */
    /* Fixed width, not auto. Each row is its own grid, so an `auto` tools
       column is measured per row - which let rows drift a couple of pixels
       apart depending on their own contents. Pinned, they cannot. */
    .invrow-tools { display: grid; grid-template-columns: repeat(5, 84px); gap: 8px; width: 452px; align-items: center; justify-self: end; }
    .invrow-tools > button { width: 100%; justify-content: center; }
    /* The paid date takes the first slot, so it starts where the first button
       would have. */
    .invrow .paidon { grid-column: 1; justify-self: start; font-size: 11.5px; color: rgba(28,29,34,0.45); white-space: nowrap; }
    @media (max-width: 1100px) { .invrow { grid-template-columns: 100px 1fr 100px 92px; } .invrow .invrow-tools { grid-column: 1 / -1; justify-self: start; } }
    .invrow .num { font-weight: 700; color: var(--ink); }
    .invrow .amt { text-align: right; font-weight: 700; }
    .inv-badge { justify-self: start; font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; }
    .inv-badge.draft { background: rgba(28,29,34,0.08); color: rgba(28,29,34,0.6); }
    .inv-badge.sent { background: rgba(55,30,40,0.1); color: var(--english-violet); }
    .inv-badge.paid { background: rgba(60,150,90,0.14); color: #2e6b40; }
    .inv-badge.void { background: rgba(200,70,50,0.1); color: #a3372b; }

    /* Same treatment as Mark paid / Void / Delete - it was inheriting nothing
       and rendering as a bare browser button. */
    .invrow .invedit { appearance: none; cursor: pointer; border: 1px solid rgba(28,29,34,0.16); background: none; border-radius: 8px; padding: 6px 12px; font-family: var(--sans); font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.7); }
    .invrow .invedit:hover { background: rgba(55,30,40,0.07); border-color: rgba(var(--violet-rgb),0.4); color: var(--english-violet); }
    .invrow .markpaid { appearance: none; cursor: pointer; border: 1px solid rgba(28,29,34,0.16); background: none; border-radius: 8px; padding: 6px 12px; font-family: var(--sans); font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.7); }
    .invrow .markpaid:hover { background: rgba(60,150,90,0.1); border-color: rgba(60,150,90,0.4); color: #2e6b40; }
    .invrow .invvoid, .invrow .invdel { appearance: none; cursor: pointer; border: 1px solid rgba(28,29,34,0.16); background: none; border-radius: 8px; padding: 6px 12px; font-family: var(--sans); font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.55); }
    .invrow .invvoid:hover { background: rgba(227,160,8,0.12); border-color: rgba(227,160,8,0.45); color: #9a6a04; }
    .invrow .invdel:hover { background: rgba(200,70,50,0.1); border-color: rgba(200,70,50,0.4); color: #a3372b; }
    .inv-h-note { font-weight: 400; letter-spacing: 0; text-transform: none; color: rgba(28,29,34,0.4); margin-left: 8px; font-size: 11px; }
    .inv-row2 { display: grid; grid-template-columns: 1fr 120px; gap: 12px; }
    .inv-field select { font-family: var(--sans); font-size: 14.5px; padding: 10px 12px; border-radius: 9px; border: 1px solid rgba(28,29,34,0.14); background: #fff; color: var(--ink); }
    .inv-footer-preview { display: block; max-width: 100%; margin-top: 10px; border-radius: 8px; border: 1px solid rgba(28,29,34,0.1); }
    /* Email review modal */
    .cim-scrim { position: fixed; inset: 0; background: rgba(20,18,26,0.5); display: flex; align-items: flex-start; justify-content: center; padding: 40px 16px; z-index: 200; overflow-y: auto; }
    .cim-scrim[hidden] { display: none; }
    .cim { width: 100%; max-width: 620px; background: #fff; border-radius: 14px; padding: 24px 26px; box-shadow: 0 20px 60px rgba(20,18,26,0.3); }
    .cim h3 { font-family: var(--serif, var(--sans)); font-size: 19px; margin: 0 0 4px; color: var(--ink); }
    .cim-sub { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.55); margin: 0 0 18px; }
    .cim-f { display: block; margin-bottom: 14px; }
    .cim-f > span { display: block; font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-bottom: 6px; }
    .cim-f input, .cim-f textarea { width: 100%; padding: 9px 11px; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; font-family: var(--sans); font-size: 14px; color: var(--ink); background: #fff; }
    .cim-f input:read-only { background: rgba(28,29,34,0.04); color: rgba(28,29,34,0.6); }
    .cim-f textarea { line-height: 1.55; resize: vertical; }
    .cim-note { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); margin: 0 0 16px; }
    .cim-actions { display: flex; justify-content: flex-end; gap: 10px; }
    /* A native dialog sits in the browser's top layer, so nothing on the page -
       no iframe, no overlay, no stacking context - can cover it or take its
       keystrokes. That is the point of using one here. */
    .inv-logo-row { display: flex; gap: 8px; align-items: stretch; }
    .inv-logo-row input { flex: 1; }
    .inv-upload { display: inline-flex; align-items: center; padding: 0 16px; border-radius: 9px; border: 1px solid rgba(28,29,34,0.14); background: #fff; font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--ink); cursor: pointer; white-space: nowrap; transition: background 0.15s; }
    .inv-upload:hover { background: var(--paper); }
  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";
    import { renderInvoiceHtml, sampleInvoice } from "../../lib/invoice-render.js";
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    let currentSettings = {};
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    async function authToken() {
      try {
        let s = (await supabase.auth.getSession()).data.session;
        if (!s || (s.expires_at && s.expires_at * 1000 < Date.now() + 60000)) { try { const r = await supabase.auth.refreshSession(); if (r.data && r.data.session) s = r.data.session; } catch (_) {} }
        return (s && s.access_token) || "";
      } catch (_) { return ""; }
    }
    async function api(pathname, opts = {}) {
      const token = await authToken();
      const res = await fetch(`${WORKER}${pathname}`, { ...opts, headers: { ...(opts.headers || {}), Authorization: "Bearer " + token } });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.error || "Something went wrong.");
      return d;
    }

    // Tabs
    $("inv-tabs").addEventListener("click", (e) => {
      const b = e.target.closest("[data-tab]"); if (!b) return;
      document.querySelectorAll(".inv-tab").forEach((t) => t.classList.toggle("is-active", t === b));
      document.querySelectorAll(".inv-panel").forEach((p) => { p.hidden = p.getAttribute("data-panel") !== b.getAttribute("data-tab"); });
      const tab = b.getAttribute("data-tab");
      if (tab === "template") scaleFit();
      if (tab === "create") ciScaleFit();
      if (tab === "invoices") loadInvoices();
      if (tab === "report") loadReport();
    });

    function msg(id, text, ok) { const m = $(id); m.textContent = text; m.className = "inv-msg " + (ok ? "is-ok" : "is-err"); m.hidden = false; }

    // The editable settings fields (must match the <input name="…"> set below).
    const FIELDS = ["company_name", "company_address", "company_reg_no", "vat_number", "vat_rate", "account_name", "sort_code", "account_number", "invoice_prefix", "next_number", "payment_terms_days", "accounts_cc_email", "footer_note", "email_footer_image_url"];

    // ---- Settings ----
    async function loadSettings() {
      if (!WORKER) { msg("inv-msg", "Connect the Worker (PUBLIC_R2_WORKER_URL) to manage invoicing.", false); initTemplate(); initCreate(); return; }
      try {
        const { settings } = await api("/invoicing/settings");
        currentSettings = settings || {};
        const f = $("inv-form");
        for (const k of FIELDS) { const el = f.elements[k]; if (el && currentSettings[k] != null) el.value = currentSettings[k]; }
        syncFooterPreview();
      } catch (err) { msg("inv-msg", err.message, false); }
      // Always initialise the preview + builder, even if settings failed to load.
      initTemplate();
      initCreate();
    }
    // Email footer image — live preview + upload to Supabase storage (public).
    function syncFooterPreview() { const url = $("set-footer-img").value.trim(); const img = $("set-footer-preview"); if (url) { img.src = url; img.hidden = false; } else { img.hidden = true; } }
    $("set-footer-img").addEventListener("input", syncFooterPreview);
    $("set-footer-file").addEventListener("change", async (e) => {
      const file = e.target.files && e.target.files[0]; if (!file) return;
      const lbl = $("set-footer-lbl"), prev = lbl.textContent; lbl.textContent = "Uploading…";
      try {
        const ext = (file.name.split(".").pop() || "png").toLowerCase();
        const path = `invoice-footer/footer-${Date.now()}.${ext}`;
        const { error } = await supabase.storage.from("avatars").upload(path, file, { upsert: true, cacheControl: "3600", contentType: file.type });
        if (error) throw error;
        const { data } = supabase.storage.from("avatars").getPublicUrl(path);
        $("set-footer-img").value = data.publicUrl; syncFooterPreview();
        msg("inv-msg", "Footer image uploaded — don't forget to Save details.", true);
      } catch (err) { msg("inv-msg", err.message || "Couldn't upload that image.", false); }
      finally { lbl.textContent = prev; e.target.value = ""; }
    });
    $("inv-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target, btn = $("inv-save");
      const body = {};
      for (const k of FIELDS) { const el = f.elements[k]; const v = el ? el.value.trim() : ""; body[k] = (["vat_rate", "payment_terms_days", "next_number"].includes(k)) ? (v === "" ? null : Number(v)) : (v || null); }
      btn.disabled = true; btn.textContent = "Saving…";
      try { await api("/invoicing/settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) }); msg("inv-msg", "Saved.", true); }
      catch (err) { msg("inv-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Save details"; }
    });

    // ---- Address book ----
    function renderRecipients(list) {
      const wrap = $("rec-list");
      if (!list.length) { wrap.innerHTML = '<p class="inv-empty">No partners yet — add one above.</p>'; return; }
      wrap.innerHTML = list.map((r) => `<div class="rec-row">
        <div class="rec-meta"><div class="rec-name">${esc(r.name)}</div><div class="rec-sub">${esc(r.email)}${r.contact_name ? " · " + esc(r.contact_name) : ""}${r.address ? " · " + esc(r.address) : ""}</div></div>
        <button type="button" class="rec-remove" data-id="${esc(r.id)}" data-name="${esc(r.name)}">Remove</button>
      </div>`).join("");
    }
    async function loadRecipients() {
      const wrap = $("rec-list");
      if (!WORKER) { wrap.innerHTML = '<p class="inv-empty">Connect the Worker to manage the address book.</p>'; return; }
      try { const { recipients } = await api("/invoicing/recipients"); ciRecipients = recipients || []; renderRecipients(ciRecipients); fillRecipientSelect(); }
      catch (err) { wrap.innerHTML = `<p class="inv-empty">${esc(err.message)}</p>`; }
    }
    function fillRecipientSelect() {
      const sel = $("ci-recip"); if (!sel) return;
      sel.innerHTML = '<option value="">— Choose a partner, or type below —</option>' + ciRecipients.map((r) => `<option value="${esc(r.id)}">${esc(r.name)}</option>`).join("");
    }
    $("rec-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target, btn = $("rec-add");
      const name = f.name.value.trim(), email = f.email.value.trim();
      if (!name || !email) { msg("rec-msg", "A name and billing email are required.", false); return; }
      btn.disabled = true; btn.textContent = "Adding…";
      try {
        await api("/invoicing/recipients", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name, email, contact_name: f.contact_name.value.trim(), address: f.address.value.trim() }) });
        f.reset(); $("rec-msg").hidden = true; loadRecipients();
      } catch (err) { msg("rec-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Add to address book"; }
    });
    $("rec-list").addEventListener("click", async (e) => {
      const btn = e.target.closest(".rec-remove"); if (!btn) return;
      if (!confirm(`Remove ${btn.getAttribute("data-name")} from the address book?`)) return;
      try { await api(`/invoicing/recipients?id=${encodeURIComponent(btn.getAttribute("data-id"))}`, { method: "DELETE" }); loadRecipients(); }
      catch (err) { alert(err.message); }
    });

    // ---- Template ----
    const tplState = { template: "minimal", accent_color: "#371e28", logo_url: "", show_bank: true, font_family: "Arial, Helvetica, sans-serif", font_size: 13 };
    // Only two styles now; every legacy/aliased key maps onto one of them.
    const LEGACY_STYLE = { classic: "minimal", editorial: "minimal", modern: "banded" };
    function currentInvoiceHtml() {
      const settings = { ...currentSettings, ...tplState };
      return renderInvoiceHtml({ settings, invoice: sampleInvoice(settings) });
    }
    // Scale the true-size (794px) A4 iframe down to fit the column so the preview
    // is exactly proportional to a printed sheet.
    function scaleFit() {
      const box = $("inv-preview-box"); if (!box || !box.clientWidth) return;
      const k = Math.min(1, box.clientWidth / 794);
      $("inv-preview").style.transform = `scale(${k})`;
      box.style.height = Math.round(1123 * k) + "px";
    }
    function renderPreview() { $("inv-preview").srcdoc = currentInvoiceHtml(); scaleFit(); }
    window.addEventListener("resize", scaleFit);
    $("inv-open-pdf").addEventListener("click", () => {
      const w = window.open("", "_blank"); if (!w) return;
      w.document.open(); w.document.write(currentInvoiceHtml()); w.document.close();
    });
    function syncStyleButtons() { document.querySelectorAll(".inv-style").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-style") === tplState.template)); }
    function initTemplate() {
      const t = LEGACY_STYLE[currentSettings.template] || currentSettings.template;
      tplState.template = ["minimal", "banded"].includes(t) ? t : "minimal";
      tplState.accent_color = currentSettings.accent_color || "#371e28";
      tplState.logo_url = currentSettings.logo_url || "";
      tplState.show_bank = currentSettings.show_bank !== false;
      tplState.font_family = currentSettings.font_family || "Arial, Helvetica, sans-serif";
      tplState.font_size = currentSettings.font_size || 13;
      $("tpl-accent-c").value = /^#[0-9a-fA-F]{6}$/.test(tplState.accent_color) ? tplState.accent_color : "#371e28";
      $("tpl-accent-h").value = tplState.accent_color;
      $("tpl-logo").value = tplState.logo_url;
      $("tpl-bank").checked = tplState.show_bank;
      $("tpl-font").value = tplState.font_family;
      $("tpl-fs").value = tplState.font_size;
      syncStyleButtons();
      renderPreview();
    }
    $("inv-styles").addEventListener("click", (e) => { const b = e.target.closest(".inv-style"); if (!b) return; tplState.template = b.getAttribute("data-style"); syncStyleButtons(); renderPreview(); });
    $("tpl-accent-c").addEventListener("input", (e) => { tplState.accent_color = e.target.value; $("tpl-accent-h").value = e.target.value; renderPreview(); });
    $("tpl-accent-h").addEventListener("input", (e) => { const v = e.target.value.trim(); tplState.accent_color = v; if (/^#[0-9a-fA-F]{6}$/.test(v)) $("tpl-accent-c").value = v; renderPreview(); });
    $("tpl-logo").addEventListener("input", (e) => { tplState.logo_url = e.target.value.trim(); renderPreview(); });
    $("tpl-bank").addEventListener("change", (e) => { tplState.show_bank = e.target.checked; renderPreview(); });
    $("tpl-font").addEventListener("change", (e) => { tplState.font_family = e.target.value; renderPreview(); });
    $("tpl-fs").addEventListener("input", (e) => { const n = parseInt(e.target.value, 10); tplState.font_size = (n >= 10 && n <= 18) ? n : 13; renderPreview(); });
    // Logo upload → Supabase storage (public), sets the URL.
    $("tpl-logo-file").addEventListener("change", async (e) => {
      const file = e.target.files && e.target.files[0]; if (!file) return;
      if (file.size > 3 * 1024 * 1024) { msg("tpl-msg", "That image is a bit large — keep it under ~3 MB.", false); return; }
      const lbl = $("tpl-upload-lbl"), prev = lbl.textContent; lbl.textContent = "Uploading…";
      try {
        const ext = (file.name.split(".").pop() || "png").toLowerCase().replace(/[^a-z0-9]/g, "");
        const path = `invoice-logo/logo-${Date.now()}.${ext}`;
        const { error } = await supabase.storage.from("avatars").upload(path, file, { upsert: true, cacheControl: "3600", contentType: file.type });
        if (error) throw error;
        const { data } = supabase.storage.from("avatars").getPublicUrl(path);
        tplState.logo_url = data.publicUrl; $("tpl-logo").value = data.publicUrl; renderPreview();
        msg("tpl-msg", "Logo uploaded — don't forget to Save template.", true);
      } catch (err) { msg("tpl-msg", err.message || "Couldn't upload that image.", false); }
      finally { lbl.textContent = prev; }
    });
    $("tpl-save").addEventListener("click", async () => {
      const btn = $("tpl-save"); btn.disabled = true; btn.textContent = "Saving…";
      try {
        await api("/invoicing/settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ template: tplState.template, accent_color: tplState.accent_color, logo_url: tplState.logo_url || null, show_bank: tplState.show_bank, font_family: tplState.font_family, font_size: tplState.font_size }) });
        Object.assign(currentSettings, tplState);
        msg("tpl-msg", "Template saved.", true);
      } catch (err) { msg("tpl-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Save template"; }
    });

    // ---- Create invoice ----
    const NOTES_DEFAULT = "Thank you for your business - TMKE";
    let ciRecipients = [];
    let ciItems = [{ description: "", amount: "" }];
    let ciTemplate = "minimal";
    // Off by default - a pay link should be a deliberate choice per invoice,
    // not something that quietly appears on every one.
    let ciPayByCard = false;
    // Shoot invoices are raised from the videography client file, not here, so
    // there is no control for this. It is still tracked, because an invoice
    // EDITED here may have been raised there and must keep its terms rather
    // than silently losing the content-release wording.
    let ciRelease = false;
    const gbp = (p) => "£" + ((p || 0) / 100).toFixed(2);
    const isoToday = () => new Date().toISOString().slice(0, 10);
    function ciTotals() {
      const vatRate = Number(currentSettings.vat_rate != null ? currentSettings.vat_rate : 20);
      const subtotal = ciItems.reduce((s, it) => s + Math.round((parseFloat(it.amount) || 0) * 100), 0);
      const vat = Math.round(subtotal * vatRate / 100);
      return { subtotal, vat, total: subtotal + vat, vatRate };
    }
    function ciBuildInvoice() {
      const t = ciTotals();
      return {
        number: (currentSettings.invoice_prefix || "TMKE") + (currentSettings.next_number || 1001),
        issued_date: $("ci-issued").value || null, due_date: $("ci-due").value || null,
        bill_to_name: $("ci-name").value.trim(), bill_to_email: $("ci-email").value.trim(), bill_to_address: $("ci-address").value.trim(),
        notes: $("ci-notes").value.trim() || null,
        line_items: ciItems.map((it) => ({ description: it.description, qty: 1, unit_pence: Math.round((parseFloat(it.amount) || 0) * 100) })),
        subtotal_pence: t.subtotal, vat_pence: t.vat, total_pence: t.total,
        pay_by_card: ciPayByCard,   // drives the "How to pay" wording in the preview
        release_on_payment: ciRelease,
        terms_days: $("ci-terms").value === "" ? null : Math.max(0, Math.round(Number($("ci-terms").value))),
      };
    }
    const ciSettings = () => ({ ...currentSettings, template: ciTemplate });
    function syncCiTpl() { document.querySelectorAll("#ci-tpl .ci-tpl-opt").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-tpl") === ciTemplate)); }
    function syncCiPay() { document.querySelectorAll("#ci-pay .ci-tpl-opt").forEach((b) => b.classList.toggle("is-active", (b.getAttribute("data-pay") === "yes") === ciPayByCard)); }
    function syncCiRelease() { /* no control here any more - see ciRelease above */ }
    function ciRenderItems() {
      $("ci-items").innerHTML = ciItems.map((it, i) => `<div class="ci-item"><input class="ci-desc" data-i="${i}" placeholder="Description of the service" value="${esc(it.description)}"/><input class="ci-amt" data-i="${i}" type="number" step="0.01" placeholder="0.00" value="${esc(it.amount)}"/><button type="button" class="ci-del" data-i="${i}" title="Remove">&times;</button></div>`).join("");
    }
    function ciRenderTotals() {
      const t = ciTotals();
      $("ci-totals").innerHTML = `<div class="r"><span>Sub-total</span><span>${gbp(t.subtotal)}</span></div><div class="r"><span>VAT (${t.vatRate}%)</span><span>${gbp(t.vat)}</span></div><div class="r grand"><span>Total</span><span>${gbp(t.total)}</span></div>`;
    }
    function ciScaleFit() { const box = $("ci-preview-box"); if (!box || !box.clientWidth) return; const k = Math.min(1, box.clientWidth / 794); $("ci-preview").style.transform = `scale(${k})`; box.style.height = Math.round(1123 * k) + "px"; }
    function ciPreview() { $("ci-preview").srcdoc = renderInvoiceHtml({ settings: ciSettings(), invoice: ciBuildInvoice() }); ciScaleFit(); }
    function ciRefresh() { ciRenderItems(); ciRenderTotals(); ciPreview(); }
    function initCreate() {
      const t = { classic: "minimal", editorial: "minimal", modern: "banded" }[currentSettings.template] || currentSettings.template;
      ciTemplate = ["minimal", "banded"].includes(t) ? t : "minimal"; syncCiTpl();
      if (!$("ci-issued").value) $("ci-issued").value = isoToday();
      if (!$("ci-due").value) { const d = new Date(); d.setDate(d.getDate() + Number(currentSettings.payment_terms_days || 7)); $("ci-due").value = d.toISOString().slice(0, 10); }
      if (!$("ci-notes").value) $("ci-notes").value = NOTES_DEFAULT;
      if (!$("ci-cc").value) $("ci-cc").value = currentSettings.accounts_cc_email || "";
      syncCiRelease();
      ciRefresh();
    }
    $("ci-tpl").addEventListener("click", (e) => { const b = e.target.closest(".ci-tpl-opt"); if (!b) return; ciTemplate = b.getAttribute("data-tpl"); syncCiTpl(); ciPreview(); });
    $("ci-pay").addEventListener("click", (e) => { const b = e.target.closest(".ci-tpl-opt"); if (!b) return; ciPayByCard = b.getAttribute("data-pay") === "yes"; syncCiPay(); ciPreview(); });
    $("ci-terms").addEventListener("input", () => { ciApplyTerms(); ciPreview(); });

    // Keep the due date honest: it is what the client actually reads.
    function ciApplyTerms() {
      const n = Number($("ci-terms").value);
      if (!$("ci-terms").value || isNaN(n)) return;
      const from = $("ci-issued").value ? new Date($("ci-issued").value) : new Date();
      if (isNaN(from)) return;
      from.setDate(from.getDate() + n);
      $("ci-due").value = from.toISOString().slice(0, 10);
    }
    syncCiPay();
    $("ci-items").addEventListener("input", (e) => { const i = +e.target.getAttribute("data-i"); if (e.target.classList.contains("ci-desc")) ciItems[i].description = e.target.value; else if (e.target.classList.contains("ci-amt")) ciItems[i].amount = e.target.value; ciRenderTotals(); ciPreview(); });
    $("ci-items").addEventListener("click", (e) => { const b = e.target.closest(".ci-del"); if (!b) return; ciItems.splice(+b.getAttribute("data-i"), 1); if (!ciItems.length) ciItems.push({ description: "", amount: "" }); ciRefresh(); });
    $("ci-add-item").addEventListener("click", () => { ciItems.push({ description: "", amount: "" }); ciRefresh(); });
    ["ci-name", "ci-email", "ci-address", "ci-issued", "ci-due", "ci-notes"].forEach((id) => $(id).addEventListener("input", ciPreview));
    $("ci-recip").addEventListener("change", (e) => { const r = ciRecipients.find((x) => x.id === e.target.value); if (r) { $("ci-name").value = r.name; $("ci-email").value = r.email || ""; $("ci-address").value = r.address || ""; ciPreview(); } });
    $("ci-open-pdf").addEventListener("click", () => { const w = window.open("", "_blank"); if (!w) return; w.document.open(); w.document.write(renderInvoiceHtml({ settings: ciSettings(), invoice: ciBuildInvoice() })); w.document.close(); });
    // Create a draft; returns the saved invoice (or null on validation/error).
    async function ciCreate(requireEmail) {
      const inv = ciBuildInvoice();
      if (!inv.bill_to_name) { msg("ci-msg", "Enter a recipient name.", false); return null; }
      if (requireEmail && !inv.bill_to_email) { msg("ci-msg", "Enter a recipient email to send to.", false); return null; }
      if (!inv.line_items.some((it) => it.description || it.unit_pence)) { msg("ci-msg", "Add at least one line item.", false); return null; }
      const payload = { bill_to_name: inv.bill_to_name, bill_to_email: inv.bill_to_email || null, bill_to_address: inv.bill_to_address || null, cc_email: $("ci-cc").value.trim(), recipient_id: $("ci-recip").value || null, issued_date: inv.issued_date, due_date: inv.due_date, notes: inv.notes, template: ciTemplate, pay_by_card: ciPayByCard, release_on_payment: ciRelease, terms_days: inv.terms_days, line_items: inv.line_items };

      // A draft is edited in place - nothing has been sent, so there is no
      // reason to burn a number or leave a void behind.
      if (ciEditing && ciEditing.status === "draft") {
        const { invoice } = await api("/invoicing/invoices", {
          method: "PATCH", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: ciEditing.id, ...payload }),
        });
        return invoice;
      }

      const { invoice } = await api("/invoicing/invoices", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      currentSettings.next_number = (currentSettings.next_number || 1001) + 1;

      // Reissuing a sent invoice: void the original, but only now that its
      // replacement exists.
      if (ciEditing && ciEditing.status !== "draft") {
        try {
          await api("/invoicing/invoices", {
            method: "PATCH", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: ciEditing.id, status: "void" }),
          });
        } catch (_) {}
      }
      return invoice;
    }
    function ciReset() { ciEditing = null; $("ci-create").textContent = "Save draft"; $("ci-send").textContent = "Create & send"; ciItems = [{ description: "", amount: "" }]; ["ci-name", "ci-email", "ci-address"].forEach((id) => { $(id).value = ""; }); $("ci-notes").value = NOTES_DEFAULT; $("ci-cc").value = currentSettings.accounts_cc_email || ""; $("ci-recip").value = ""; ciRefresh(); }
    $("ci-create").addEventListener("click", async () => {
      const btn = $("ci-create"); btn.disabled = true; btn.textContent = "Saving…";
      try {
        const invoice = await ciCreate(false);
        if (invoice) {
          const was = ciEditing;
          msg("ci-msg", was && was.status === "draft"
            ? `${invoice.number} updated.`
            : `Draft ${invoice.number} saved — see the Invoices tab.${was ? ` ${was.number} voided.` : ""}`, true);
          ciReset(); loadInvoices();
        }
      }
      catch (err) { msg("ci-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Save draft"; }
    });
    $("ci-send").addEventListener("click", async () => {
      const btn = $("ci-send"); btn.disabled = true; btn.textContent = "Creating…";
      try { const invoice = await ciCreate(true); if (invoice) { ciEditing = null; openEmailModal(invoice, true); } }
      catch (err) { msg("ci-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Create & send"; }
    });
    window.addEventListener("resize", ciScaleFit);

    // ---- Email review modal (edit before send) ----
    let cimInvoiceId = null, cimResetOnSend = false;
    const dLong = (x) => x ? new Date(x + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) : null;
    function defaultEmailSubject(inv) { return `Invoice ${inv.number} from ${currentSettings.company_name || "The Marketing Experts (Nationwide) Ltd"}`; }
    function defaultEmailBody(inv) {
      const company = currentSettings.company_name || "The Marketing Experts (Nationwide) Ltd";
      const due = dLong(inv.due_date);
      const lines = [`Dear ${inv.bill_to_name || "Sir or Madam"},`, "", `Please find attached invoice ${inv.number} from ${company}.`, "", `Amount due: ${gbp(inv.total_pence || 0)}`];
      if (due) lines.push(`Due date: ${due}`);
      // When the invoice carries a pay link, say so - telling someone to pay by
  // bank transfer while a card button sits above it just reads as contradictory.
  lines.push("", inv.pay_by_card ? `Payment is due${due ? ` by ${due}` : ""}. You can pay by card using the button in this email, or by bank transfer using the account details on the invoice, quoting ${inv.number} as the reference. If you have any questions, just reply to this email.`
    : `Payment is due${due ? ` by ${due}` : ""} by bank transfer — the account details are on the invoice, and please quote ${inv.number} as the reference. If you have any questions, just reply to this email.`, "", "Kind regards,", company);
      // Shoots only. An SMM invoice must not promise anything about content.
      if (inv.release_on_payment) {
        lines.splice(lines.length - 2, 0, "", "Payment isn't required until your shoot has taken place. Your content stays watermarked and locked until payment reaches us — once it does we'll email your PIN, which unlocks downloading from your gallery.");
      }
      return lines.join("\n");
    }
    function openEmailModal(inv, resetOnSend) {
      cimInvoiceId = inv.id; cimResetOnSend = !!resetOnSend;
      $("cim-num").textContent = inv.number || "";
      $("cim-to").value = inv.bill_to_email || "";
      $("cim-cc").value = inv.cc_email || "";
      // Say plainly what is about to go out - you cannot tell from the subject
      // and body alone whether this carries a payment link.
      const payEl = $("cim-pay");
      if (payEl) {
        payEl.textContent = inv.pay_by_card
          ? "This email includes a Pay by card button (Stripe)."
          : "No payment link - bank transfer only, using the details on the invoice.";
        payEl.className = "cim-pay" + (inv.pay_by_card ? " is-on" : "");
      }
      $("cim-subject").value = defaultEmailSubject(inv);
      $("cim-body").value = defaultEmailBody(inv);
      $("cim-msg").hidden = true;
      $("ci-email-modal").hidden = false;
    }
    function closeEmailModal() { $("ci-email-modal").hidden = true; cimInvoiceId = null; }
    $("cim-cancel").addEventListener("click", closeEmailModal);
    $("ci-email-modal").addEventListener("click", (e) => { if (e.target === $("ci-email-modal")) closeEmailModal(); });
    $("cim-send").addEventListener("click", async () => {
      if (!cimInvoiceId) return;
      const btn = $("cim-send"); btn.disabled = true; btn.textContent = "Sending…";
      try {
        await api("/invoicing/invoices/send", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: cimInvoiceId, email_subject: $("cim-subject").value.trim(), email_body: $("cim-body").value, cc: $("cim-cc").value.trim() }) });
        const reset = cimResetOnSend; closeEmailModal();
        if (reset) { msg("ci-msg", "Invoice sent.", true); ciReset(); }
        loadInvoices();
      } catch (err) { msg("cim-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Send invoice"; }
    });

    // ---- Invoices list ----
    let invList = [];
    /* Editing an invoice.

       A draft is edited in place - nothing has left the building, so there is
       no reason to burn a number. A SENT invoice is reissued instead: the
       client holds a numbered document, and quietly changing ours would leave
       two different papers claiming to be TMKE1022. The Worker enforces the
       same rule, so this cannot be bypassed from the page. */

    /* Editing reuses the Create view - same fields, same live preview - rather
       than a separate dialog. A draft saves back to itself; a sent invoice is
       reissued, because the client already holds a numbered document and two
       papers must not claim to be the same invoice. */
    let ciEditing = null;   // { id, number, status } while editing

    async function editInvoice(id) {
      if (!id) return;
      document.querySelector('[data-tab="create"]')?.click();
      msg("ci-msg", "Loading…", true);
      let full;
      try { full = (await api(`/invoicing/invoice?id=${encodeURIComponent(id)}`)).invoice; }
      catch (err) { msg("ci-msg", "Couldn't load that invoice: " + err.message, false); return; }
      if (!full) { msg("ci-msg", "Couldn't load that invoice.", false); return; }

      ciItems = (full.line_items || []).map((it) => ({
        description: it.description || "",
        amount: (((it.unit_pence || 0) * (it.qty || 1)) / 100).toFixed(2),
      }));
      if (!ciItems.length) ciItems = [{ description: "", amount: "" }];
      $("ci-name").value = full.bill_to_name || "";
      $("ci-email").value = full.bill_to_email || "";
      $("ci-address").value = full.bill_to_address || "";
      $("ci-cc").value = full.cc_email || "";
      $("ci-issued").value = (full.issued_date || "").slice(0, 10) || isoToday();
      $("ci-due").value = (full.due_date || "").slice(0, 10) || "";
      $("ci-notes").value = full.notes || "";
      $("ci-terms").value = full.terms_days ?? "";
      ciPayByCard = !!full.pay_by_card; syncCiPay();
      ciRelease = !!full.release_on_payment;
      ciEditing = { id: full.id, number: full.number, status: full.status };

      const draft = full.status === "draft";
      $("ci-create").textContent = draft ? "Save changes" : "Reissue as draft";
      $("ci-send").textContent = draft ? "Save & send" : "Reissue & send";
      msg("ci-msg", draft
        ? `Editing draft ${full.number} — saving updates it.`
        : `Editing ${full.number}, which has been sent. Saving raises a NEW invoice and voids ${full.number}.`, true);
      ciRefresh();
    }

    async function loadInvoices() {
      const wrap = $("inv-list");
      if (!WORKER) { wrap.innerHTML = '<p class="inv-empty">Connect the Worker to view invoices.</p>'; return; }
      try {
        const { invoices } = await api("/invoicing/invoices");
        invList = invoices || [];
        if (!invoices.length) { wrap.innerHTML = '<p class="inv-empty">No invoices yet — create one.</p>'; return; }
        const d = (x) => x ? new Date(x + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : "—";
        wrap.innerHTML = invoices.map((v) => `<div class="invrow"><span class="num">${esc(v.number)}</span><span>${esc(v.bill_to_name)}<div style="font-size:11.5px;color:rgba(28,29,34,0.5)">Due ${d(v.due_date)}</div></span><span class="amt">${gbp(v.total_pence)}</span><span class="inv-badge ${esc(v.status)}">${esc(v.status)}</span><span class="invrow-tools">
            ${v.paid_date
              ? `<span class="paidon">Paid ${d(v.paid_date)}</span><span></span>`
              : `${v.status !== "void" && v.bill_to_email ? `<button type="button" class="invsend" data-sendid="${esc(v.id)}">${v.status === "sent" ? "Resend" : "Send"}</button>` : "<span></span>"}
                 ${v.status !== "void" ? `<button type="button" class="markpaid" data-id="${esc(v.id)}">Paid</button>` : "<span></span>"}`}
            ${v.status !== "void" ? `<button type="button" class="invedit" data-editid="${esc(v.id)}">Edit</button>` : "<span></span>"}
            <button type="button" class="invvoid" data-voidid="${esc(v.id)}">Void</button>
            <button type="button" class="invdel" data-delid="${esc(v.id)}">Delete</button>
          </span></div>`).join("");
      } catch (err) { wrap.innerHTML = `<p class="inv-empty">${esc(err.message)}</p>`; }
    }
    $("inv-list").addEventListener("click", async (e) => {
      const paid = e.target.closest(".markpaid");
      if (paid) { paid.disabled = true; try { await api("/invoicing/invoices", { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: paid.getAttribute("data-id"), status: "paid" }) }); loadInvoices(); } catch (err) { alert(err.message); paid.disabled = false; } return; }
      const ed = e.target.closest(".invedit");
      if (ed) { editInvoice(ed.getAttribute("data-editid")); return; }
      const send = e.target.closest(".invsend");
      if (send) { const inv = invList.find((x) => x.id === send.getAttribute("data-sendid")); if (inv) openEmailModal(inv, false); return; }
      const del = e.target.closest(".invdel");
      if (del) { if (!confirm("Delete this invoice? This permanently removes it and its PDF — it can't be undone.")) return; del.disabled = true; try { await api(`/invoicing/invoices?id=${encodeURIComponent(del.getAttribute("data-delid"))}`, { method: "DELETE" }); loadInvoices(); } catch (err) { alert(err.message); del.disabled = false; } return; }
      const vd = e.target.closest(".invvoid");
      if (vd) { const reason = prompt("Void this invoice? It'll be removed and accounts + you will be emailed.\n\nReason for voiding:"); if (reason === null) return; vd.disabled = true; try { await api("/invoicing/invoices/void", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: vd.getAttribute("data-voidid"), reason }) }); loadInvoices(); } catch (err) { alert(err.message); vd.disabled = false; } return; }
    });

    // ---- Month end -------------------------------------------------------
    // Two questions, so two tables: has the inter-brand transfer actually been
    // done, and has the ordinary invoice landed in the bank. Accounts answers
    // them per row, which is why this exists as a table to paste into an email
    // rather than a figure on a screen.
    let repRows = [];
    let repMonth = "";

    function repMonthLabel(m) {
      const [y, mo] = String(m || "").split("-").map(Number);
      if (!y || !mo) return m || "";
      return new Date(Date.UTC(y, mo - 1, 1)).toLocaleDateString("en-GB", { month: "long", year: "numeric", timeZone: "UTC" });
    }
    const repDate = (x) => x ? new Date(x + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : "—";

    function repTable(rows) {
      if (!rows.length) return '<p class="inv-empty">Nothing here.</p>';
      return `<div class="rep-wrap"><table class="rep-table">
        <thead><tr><th>Invoice</th><th>Billed to</th><th>Client</th><th>Issued</th><th>Due</th><th class="num">Amount</th><th>Status</th></tr></thead>
        <tbody>${rows.map((r) => `<tr>
          <td>${esc(r.number)}</td>
          <td>${esc(r.bill_to)}${r.brand ? `<br><span style="font-size:11.5px;color:rgba(28,29,34,0.5)">${esc(r.brand)}</span>` : ""}</td>
          <td>${esc(r.client || "—")}${r.strand ? `<br><span style="font-size:11.5px;color:rgba(28,29,34,0.5)">${esc(r.strand)}</span>` : ""}</td>
          <td>${esc(repDate(r.issued_date))}</td>
          <td>${esc(repDate(r.due_date))}</td>
          <td class="num">${gbp(r.total_pence)}</td>
          <td>${r.status === "paid"
                ? `Paid ${esc(repDate(r.paid_date))}`
                : r.days_overdue
                  ? `<span class="rep-late">${r.days_overdue} day${r.days_overdue === 1 ? "" : "s"} overdue</span>`
                  : esc(r.status)}</td>
        </tr>`).join("")}</tbody></table></div>`;
    }

    async function loadReport() {
      const state = $("rep-state"), out = $("rep-out");
      state.hidden = false; state.textContent = "Loading…"; out.hidden = true;
      $("rep-msg").hidden = true;
      if (!WORKER) { state.textContent = "Connect the Worker to pull a report."; return; }
      try {
        const q = repMonth ? `?month=${encodeURIComponent(repMonth)}` : "";
        const d = await api("/invoicing/report" + q);
        repRows = d.payments || [];
        repMonth = d.month;
        $("rep-month").value = d.month;

        const t = d.totals || {};
        $("rep-totals").innerHTML = [
          ["Raised this month", t.raised],
          ["Outstanding &mdash; inter-brand", t.outstanding_inter_brand],
          ["Outstanding &mdash; everything else", t.outstanding_other],
        ].map(([k, v]) => `<div><span class="rep-tot-k">${k}</span><span class="rep-tot-v">${gbp(v || 0)}</span></div>`).join("");

        const brandRows = repRows.filter((r) => r.outstanding && r.inter_brand);
        const otherRows = repRows.filter((r) => r.outstanding && !r.inter_brand);
        const paidRows  = repRows.filter((r) => !r.outstanding && r.raised_this_month);

        $("rep-tables").innerHTML = `
          <div class="rep-group">
            <h4>Inter-brand &mdash; outstanding</h4>
            <p class="rep-why">Please confirm each of these transfers has actually been made.</p>
            ${repTable(brandRows)}
          </div>
          <div class="rep-group">
            <h4>Outstanding &mdash; everything else</h4>
            <p class="rep-why">Please confirm whether payment has landed in the bank account.</p>
            ${repTable(otherRows)}
          </div>
          <div class="rep-group">
            <h4>Settled this month</h4>
            <p class="rep-why">For the record &mdash; no action needed.</p>
            ${repTable(paidRows)}
          </div>`;
        state.hidden = true; out.hidden = false;
      } catch (err) { state.textContent = err.message; }
    }

    // Copied as HTML *and* plain text: Outlook takes the table, anything that
    // can't renders a readable list instead of one long unbroken line.
    async function copyReport() {
      if (!repRows.length) return;
      const msg = $("rep-msg");
      const brandRows = repRows.filter((r) => r.outstanding && r.inter_brand);
      const otherRows = repRows.filter((r) => r.outstanding && !r.inter_brand);
      const money = (p) => "£" + ((p || 0) / 100).toFixed(2);

      const htmlTable = (rows) => rows.length
        ? `<table border="1" cellpadding="6" cellspacing="0" style="border-collapse:collapse;font-family:Verdana,sans-serif;font-size:12px;">
             <tr style="background:#f4f2f1;"><th align="left">Invoice</th><th align="left">Billed to</th><th align="left">Client</th><th align="left">Issued</th><th align="left">Due</th><th align="right">Amount</th><th align="left">Status</th></tr>
             ${rows.map((r) => `<tr><td>${esc(r.number)}</td><td>${esc(r.bill_to)}${r.brand ? " (" + esc(r.brand) + ")" : ""}</td><td>${esc(r.client || "—")}${r.strand ? " (" + esc(r.strand) + ")" : ""}</td><td>${esc(repDate(r.issued_date))}</td><td>${esc(repDate(r.due_date))}</td><td align="right">${money(r.total_pence)}</td><td>${r.days_overdue ? esc(r.days_overdue + " days overdue") : esc(r.status)}</td></tr>`).join("")}
           </table>`
        : "<p>Nothing outstanding.</p>";

      const html = `<div style="font-family:Verdana,sans-serif;font-size:12px;">
        <p><strong>Invoice position &mdash; ${esc(repMonthLabel(repMonth))}</strong></p>
        <p><strong>Inter-brand &mdash; please confirm each transfer has been made:</strong></p>
        ${htmlTable(brandRows)}
        <p><strong>Everything else &mdash; please confirm whether payment has landed:</strong></p>
        ${htmlTable(otherRows)}
      </div>`;

      const textTable = (rows) => rows.length
        ? rows.map((r) => `  ${r.number}  billed to ${r.bill_to}${r.brand ? " (" + r.brand + ")" : ""}  for ${r.client || "—"}${r.strand ? " (" + r.strand + ")" : ""}  issued ${repDate(r.issued_date)}  due ${repDate(r.due_date)}  ${money(r.total_pence)}  ${r.days_overdue ? r.days_overdue + " days overdue" : r.status}`).join("\n")
        : "  Nothing outstanding.";
      const text = `Invoice position - ${repMonthLabel(repMonth)}\n\n`
        + `Inter-brand - please confirm each transfer has been made:\n${textTable(brandRows)}\n\n`
        + `Everything else - please confirm whether payment has landed:\n${textTable(otherRows)}\n`;

      try {
        if (window.ClipboardItem && navigator.clipboard && navigator.clipboard.write) {
          await navigator.clipboard.write([new ClipboardItem({
            "text/html": new Blob([html], { type: "text/html" }),
            "text/plain": new Blob([text], { type: "text/plain" }),
          })]);
        } else {
          await navigator.clipboard.writeText(text);
        }
        msg.hidden = false; msg.textContent = "Copied — paste it straight into an email.";
      } catch (_) {
        msg.hidden = false; msg.textContent = "Couldn't reach the clipboard. Select the tables above and copy manually.";
      }
    }

    $("rep-month").addEventListener("change", (e) => { repMonth = e.target.value; loadReport(); });
    $("rep-copy").addEventListener("click", copyReport);

    document.addEventListener("ash:ready", () => { initTemplate(); loadSettings(); loadRecipients(); });
  </script>
</AdminShell>
