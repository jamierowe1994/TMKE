    .ap-num-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; padding: 8px 0; border-top: 1px solid rgba(28,29,34,0.07); font-size: 13px; }
    .ap-num-name { flex: 1 1 320px; display: flex; flex-direction: column; gap: 2px; }
    .ap-num-name em { font-style: normal; font-size: 12px; color: rgba(28,29,34,0.55); }
