    .inv-intro { font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: rgba(28,29,34,0.65); margin: 0 0 20px; max-width: 640px; }
    .inv-h { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin: 22px 0 12px; padding-bottom: 8px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .inv-h:first-child { margin-top: 0; }
    .inv-form, .inv-book-form { display: flex; flex-direction: column; gap: 14px; }
    .inv-row { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
    .inv-book-form .inv-row { grid-template-columns: 1fr 1fr; }
    @media (max-width: 640px) { .inv-row, .inv-book-form .inv-row { grid-template-columns: 1fr; } }
    .inv-field { display: flex; flex-direction: column; gap: 6px; }
    .inv-field[hidden] { display: none; }
    .inv-field > span { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .inv-field input, .inv-field textarea { font-family: var(--sans); font-size: 14.5px; padding: 10px 12px; border-radius: 9px; border: 1px solid rgba(28,29,34,0.14); background: #fff; color: var(--ink); resize: vertical; }
    /* Fill the label rather than sitting at the browser's default ~155px. The
       label is already full width; without this every box looked half-finished
       and a long client or partner name scrolled inside a stub of a field. */
    .inv-field input, .inv-field select, .inv-field textarea { width: 100%; box-sizing: border-box; }
    .inv-field input:focus, .inv-field textarea:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .inv-save { align-self: flex-start; margin-top: 8px; appearance: none; cursor: pointer; background: var(--english-violet); color: #fff; border: 0; border-radius: 9px; padding: 12px 24px; font-family: var(--sans); font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; transition: opacity 0.2s; }
    .inv-save:hover { opacity: 0.9; }
    .inv-save:disabled { opacity: 0.5; cursor: not-allowed; }
    .ci-actions { display: flex; align-items: center; gap: 10px; margin-top: 8px; }
    .inv-ghost { appearance: none; cursor: pointer; background: #fff; color: var(--english-violet); border: 1px solid rgba(55,30,40,0.25); border-radius: 9px; padding: 12px 20px; font-family: var(--sans); font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; transition: background 0.15s; }
    .inv-ghost:hover { background: rgba(55,30,40,0.05); }
    .inv-ghost:disabled { opacity: 0.5; cursor: not-allowed; }
    /* Fixed box. The word inside does not decide the size - Send and Resend are
       the same button with different text in it. */
    .invrow-tools > button { width: 84px; display: inline-flex; align-items: center; justify-content: center; height: 30px; padding: 0; font-size: 12px; white-space: nowrap; }
    .invrow .invsend { appearance: none; cursor: pointer; border: 1px solid var(--english-violet); background: var(--english-violet); color: #fff; border-radius: 8px; padding: 6px 12px; font-family: var(--sans); font-size: 12px; font-weight: 700; }
    .invrow .invsend:hover { opacity: 0.9; }
    .invrow .invsend:disabled { opacity: 0.5; cursor: not-allowed; }
    /* Monthly checklist */
    .mc-nav { display: flex; align-items: center; gap: 10px; font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--ink); }
    .mc-arrow { appearance: none; cursor: pointer; width: 32px; height: 32px; border-radius: 8px; border: 1px solid rgba(28,29,34,0.16); background: #fff; color: var(--english-violet); font-size: 15px; }
    .mc-arrow:disabled { opacity: 0.35; cursor: default; }
