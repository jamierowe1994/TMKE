  <script>
    import { supabase } from "../../lib/supabase.js";
    import { renderInvoiceHtml, sampleInvoice } from "../../lib/invoice-render.js";
    import { defaultEmailSubject, defaultEmailBody, payLine } from "../../lib/invoice-email.js";
    import { SECTOR_NAME, gbp as gb, revenueByMonth, reviewBody, ymLabel as ymLong, ymAddMonths } from "../../lib/revenue.js";
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    let currentSettings = {};
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));

    async function authToken() {
      try {
        let s = (await supabase.auth.getSession()).data.session;
        if (!s || (s.expires_at && s.expires_at * 1000 < Date.now() + 60000)) { try { const r = await supabase.auth.refreshSession(); if (r.data && r.data.session) s = r.data.session; } catch (_) {} }
        return (s && s.access_token) || "";
      } catch (_) { return ""; }
    }
    async function api(pathname, opts = {}) {
      const token = await authToken();
      const res = await fetch(`${WORKER}${pathname}`, { ...opts, headers: { ...(opts.headers || {}), Authorization: "Bearer " + token } });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.error || "Something went wrong.");
      return d;
    }

    // Everything under Settings opens in the page, with a way back.
    const PANEL_HEAD = {
      overview: ["Invoicing", "What's been raised this month, what's been paid and what needs you. Accounts confirm payments on their own page, so nobody has to chase by email."],
      create: ["New invoice", "Build it, preview it, then save or send. It's numbered automatically."],
      monthly: ["Regular invoices", "Every invoice that repeats, and this month's shoots, month by month."],
      approvals: ["Automatic invoicing", "What the morning run does, and what it's waiting on."],
      portal: ["Accounts portal", "The page where accounts confirm invoices: its link, its passcode and who gets the emails."],
      settings: ["Company and bank", "The details on every invoice, and how they're numbered."],
      template: ["Invoice template", "How the invoice looks."],
      book: ["Address book", "The people and companies you bill."],
    };
    function showPanel(tab) {
      document.querySelectorAll(".inv-panel").forEach((p) => { p.hidden = p.getAttribute("data-panel") !== tab; });
      const h = PANEL_HEAD[tab] || PANEL_HEAD.overview;
      $("io-title").textContent = h[0]; $("io-sub").textContent = h[1];
      $("io-back").hidden = tab === "overview";
      $("io-new").hidden = tab !== "overview";
      $("io-menu").hidden = true; $("io-set").setAttribute("aria-expanded", "false");
      if (tab === "template") scaleFit();
      if (tab === "create") ciScaleFit();
      if (tab === "overview") loadBook();
      if (tab === "monthly") loadMonthly();
      if (tab === "approvals") { loadApprovals(); drawJobs(); }
      if (tab === "portal") loadPortal();
      window.scrollTo(0, 0);
    }
    $("io-back").addEventListener("click", () => showPanel("overview"));
    $("io-new").addEventListener("click", () => { ciReset(); showPanel("create"); });
    $("io-set").addEventListener("click", (e) => { e.stopPropagation(); const m = $("io-menu"); m.hidden = !m.hidden; $("io-set").setAttribute("aria-expanded", String(!m.hidden)); });
    $("io-menu").addEventListener("click", (e) => { const b = e.target.closest("[data-open]"); if (b) showPanel(b.dataset.open); });
    document.addEventListener("click", (e) => { if (!e.target.closest("#io-menu")) $("io-menu").hidden = true; });

    function msg(id, text, ok) { const m = $(id); m.textContent = text; m.className = "inv-msg " + (ok ? "is-ok" : "is-err"); m.hidden = false; }

    // The editable settings fields (must match the <input name="…"> set below).
    const FIELDS = ["company_name", "company_address", "company_reg_no", "vat_number", "vat_rate", "account_name", "sort_code", "account_number", "invoice_prefix", "next_number", "payment_terms_days", "accounts_cc_email", "footer_note", "email_footer_image_url"];

    // ---- Settings ----
    async function loadSettings() {
      if (!WORKER) { msg("inv-msg", "Connect the Worker (PUBLIC_R2_WORKER_URL) to manage invoicing.", false); initTemplate(); initCreate(); return; }
      try {
        const { settings } = await api("/invoicing/settings");
        currentSettings = settings || {};
        const f = $("inv-form");
        for (const k of FIELDS) { const el = f.elements[k]; if (el && currentSettings[k] != null) el.value = currentSettings[k]; }
        syncFooterPreview();
      } catch (err) { msg("inv-msg", err.message, false); }
      // Always initialise the preview + builder, even if settings failed to load.
      initTemplate();
      initCreate();
    }
    // Email footer image — live preview + upload to Supabase storage (public).
    function syncFooterPreview() { const url = $("set-footer-img").value.trim(); const img = $("set-footer-preview"); if (url) { img.src = url; img.hidden = false; } else { img.hidden = true; } }
    $("set-footer-img").addEventListener("input", syncFooterPreview);
    $("set-footer-file").addEventListener("change", async (e) => {
      const file = e.target.files && e.target.files[0]; if (!file) return;
      const lbl = $("set-footer-lbl"), prev = lbl.textContent; lbl.textContent = "Uploading…";
      try {
        const ext = (file.name.split(".").pop() || "png").toLowerCase();
        const path = `invoice-footer/footer-${Date.now()}.${ext}`;
        const { error } = await supabase.storage.from("avatars").upload(path, file, { upsert: true, cacheControl: "3600", contentType: file.type });
        if (error) throw error;
        const { data } = supabase.storage.from("avatars").getPublicUrl(path);
        $("set-footer-img").value = data.publicUrl; syncFooterPreview();
        msg("inv-msg", "Footer image uploaded — don't forget to Save details.", true);
      } catch (err) { msg("inv-msg", err.message || "Couldn't upload that image.", false); }
      finally { lbl.textContent = prev; e.target.value = ""; }
    });
    $("inv-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target, btn = $("inv-save");
      const body = {};
      for (const k of FIELDS) { const el = f.elements[k]; const v = el ? el.value.trim() : ""; body[k] = (["vat_rate", "payment_terms_days", "next_number"].includes(k)) ? (v === "" ? null : Number(v)) : (v || null); }
      btn.disabled = true; btn.textContent = "Saving…";
      try {
        await api("/invoicing/settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) });
        // The preview and the builder on this page read from currentSettings;
        // without this they showed the old details until the page was reloaded.
        currentSettings = { ...currentSettings, ...body };
        try { renderPreview(); } catch (_) {}
        msg("inv-msg", "Saved.", true);
      }
      catch (err) { msg("inv-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Save details"; }
    });

    // ---- Address book ----
    function renderRecipients(list) {
      const wrap = $("rec-list");
      if (!list.length) { wrap.innerHTML = '<p class="inv-empty">No partners yet — add one above.</p>'; return; }
      wrap.innerHTML = list.map((r) => `<div class="rec-row">
        <div class="rec-meta"><div class="rec-name">${esc(r.name)}</div><div class="rec-sub">${esc(r.email)}${r.contact_name ? " · " + esc(r.contact_name) : ""}${r.address ? " · " + esc(r.address) : ""}</div></div>
        <button type="button" class="rec-remove" data-id="${esc(r.id)}" data-name="${esc(r.name)}">Remove</button>
      </div>`).join("");
    }
    async function loadRecipients() {
      const wrap = $("rec-list");
      if (!WORKER) { wrap.innerHTML = '<p class="inv-empty">Connect the Worker to manage the address book.</p>'; return; }
      try { const { recipients } = await api("/invoicing/recipients"); ciRecipients = recipients || []; renderRecipients(ciRecipients); fillRecipientSelect(); }
      catch (err) { wrap.innerHTML = `<p class="inv-empty">${esc(err.message)}</p>`; }
    }
    function fillRecipientSelect() {
      const sel = $("ci-recip"); if (!sel) return;
      sel.innerHTML = '<option value="">— Choose a partner, or type below —</option>' + ciRecipients.map((r) => `<option value="${esc(r.id)}">${esc(r.name)}</option>`).join("");
    }
    $("rec-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target, btn = $("rec-add");
      const name = f.name.value.trim(), email = f.email.value.trim();
      if (!name || !email) { msg("rec-msg", "A name and billing email are required.", false); return; }
      btn.disabled = true; btn.textContent = "Adding…";
      try {
        await api("/invoicing/recipients", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ name, email, contact_name: f.contact_name.value.trim(), address: f.address.value.trim() }) });
        f.reset(); $("rec-msg").hidden = true; loadRecipients();
      } catch (err) { msg("rec-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Add to address book"; }
    });
    $("rec-list").addEventListener("click", async (e) => {
      const btn = e.target.closest(".rec-remove"); if (!btn) return;
      if (!confirm(`Remove ${btn.getAttribute("data-name")} from the address book?`)) return;
      try { await api(`/invoicing/recipients?id=${encodeURIComponent(btn.getAttribute("data-id"))}`, { method: "DELETE" }); loadRecipients(); }
      catch (err) { alert(err.message); }
    });

    // ---- Template ----
    const tplState = { template: "minimal", accent_color: "#371e28", logo_url: "", show_bank: true, font_family: "Arial, Helvetica, sans-serif", font_size: 13 };
    // Only two styles now; every legacy/aliased key maps onto one of them.
    const LEGACY_STYLE = { classic: "minimal", editorial: "minimal", modern: "banded" };
    function currentInvoiceHtml() {
      const settings = { ...currentSettings, ...tplState };
      return renderInvoiceHtml({ settings, invoice: sampleInvoice(settings) });
    }
    // Scale the true-size (794px) A4 iframe down to fit the column so the preview
    // is exactly proportional to a printed sheet.
    function scaleFit() {
      const box = $("inv-preview-box"); if (!box || !box.clientWidth) return;
      const k = Math.min(1, box.clientWidth / 794);
      $("inv-preview").style.transform = `scale(${k})`;
      box.style.height = Math.round(1123 * k) + "px";
    }
    function renderPreview() { $("inv-preview").srcdoc = currentInvoiceHtml(); scaleFit(); }
    window.addEventListener("resize", scaleFit);
    $("inv-open-pdf").addEventListener("click", () => {
      const w = window.open("", "_blank"); if (!w) return;
      w.document.open(); w.document.write(currentInvoiceHtml()); w.document.close();
    });
    function syncStyleButtons() { document.querySelectorAll(".inv-style").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-style") === tplState.template)); }
    function initTemplate() {
      const t = LEGACY_STYLE[currentSettings.template] || currentSettings.template;
      tplState.template = ["minimal", "banded"].includes(t) ? t : "minimal";
      tplState.accent_color = currentSettings.accent_color || "#371e28";
      tplState.logo_url = currentSettings.logo_url || "";
      tplState.show_bank = currentSettings.show_bank !== false;
      tplState.font_family = currentSettings.font_family || "Arial, Helvetica, sans-serif";
      tplState.font_size = currentSettings.font_size || 13;
      $("tpl-accent-c").value = /^#[0-9a-fA-F]{6}$/.test(tplState.accent_color) ? tplState.accent_color : "#371e28";
      $("tpl-accent-h").value = tplState.accent_color;
      $("tpl-logo").value = tplState.logo_url;
      $("tpl-bank").checked = tplState.show_bank;
      $("tpl-font").value = tplState.font_family;
      $("tpl-fs").value = tplState.font_size;
      syncStyleButtons();
      renderPreview();
    }
    $("inv-styles").addEventListener("click", (e) => { const b = e.target.closest(".inv-style"); if (!b) return; tplState.template = b.getAttribute("data-style"); syncStyleButtons(); renderPreview(); });
    $("tpl-accent-c").addEventListener("input", (e) => { tplState.accent_color = e.target.value; $("tpl-accent-h").value = e.target.value; renderPreview(); });
    $("tpl-accent-h").addEventListener("input", (e) => { const v = e.target.value.trim(); tplState.accent_color = v; if (/^#[0-9a-fA-F]{6}$/.test(v)) $("tpl-accent-c").value = v; renderPreview(); });
    $("tpl-logo").addEventListener("input", (e) => { tplState.logo_url = e.target.value.trim(); renderPreview(); });
    $("tpl-bank").addEventListener("change", (e) => { tplState.show_bank = e.target.checked; renderPreview(); });
    $("tpl-font").addEventListener("change", (e) => { tplState.font_family = e.target.value; renderPreview(); });
    $("tpl-fs").addEventListener("input", (e) => { const n = parseInt(e.target.value, 10); tplState.font_size = (n >= 10 && n <= 18) ? n : 13; renderPreview(); });
    // Logo upload → Supabase storage (public), sets the URL.
    $("tpl-logo-file").addEventListener("change", async (e) => {
      const file = e.target.files && e.target.files[0]; if (!file) return;
      if (file.size > 3 * 1024 * 1024) { msg("tpl-msg", "That image is a bit large — keep it under ~3 MB.", false); return; }
      const lbl = $("tpl-upload-lbl"), prev = lbl.textContent; lbl.textContent = "Uploading…";
      try {
        const ext = (file.name.split(".").pop() || "png").toLowerCase().replace(/[^a-z0-9]/g, "");
        const path = `invoice-logo/logo-${Date.now()}.${ext}`;
        const { error } = await supabase.storage.from("avatars").upload(path, file, { upsert: true, cacheControl: "3600", contentType: file.type });
        if (error) throw error;
        const { data } = supabase.storage.from("avatars").getPublicUrl(path);
        tplState.logo_url = data.publicUrl; $("tpl-logo").value = data.publicUrl; renderPreview();
        msg("tpl-msg", "Logo uploaded — don't forget to Save template.", true);
      } catch (err) { msg("tpl-msg", err.message || "Couldn't upload that image.", false); }
      finally { lbl.textContent = prev; }
    });
    $("tpl-save").addEventListener("click", async () => {
      const btn = $("tpl-save"); btn.disabled = true; btn.textContent = "Saving…";
      try {
        await api("/invoicing/settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ template: tplState.template, accent_color: tplState.accent_color, logo_url: tplState.logo_url || null, show_bank: tplState.show_bank, font_family: tplState.font_family, font_size: tplState.font_size }) });
        Object.assign(currentSettings, tplState);
        msg("tpl-msg", "Template saved.", true);
      } catch (err) { msg("tpl-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Save template"; }
    });

    // ---- Create invoice ----
    const NOTES_DEFAULT = "Thank you for your business - TMKE";
    let ciRecipients = [];
    let ciItems = [{ description: "", amount: "" }];
    let ciTemplate = "minimal";
    // Off by default - a pay link should be a deliberate choice per invoice,
    // not something that quietly appears on every one.
    let ciPayByCard = false;
    // Shoot invoices are raised from the videography client file, not here, so
    // there is no control for this. It is still tracked, because an invoice
    // EDITED here may have been raised there and must keep its terms rather
    // than silently losing the content-release wording.
    let ciRelease = false;
    const gbp = (p) => "£" + ((p || 0) / 100).toFixed(2);
    const isoToday = () => new Date().toISOString().slice(0, 10);
    function ciTotals() {
      const vatRate = Number(currentSettings.vat_rate != null ? currentSettings.vat_rate : 20);
      const subtotal = ciItems.reduce((s, it) => s + Math.round((parseFloat(it.amount) || 0) * 100), 0);
      const vat = Math.round(subtotal * vatRate / 100);
      return { subtotal, vat, total: subtotal + vat, vatRate };
    }
    function ciBuildInvoice() {
      const t = ciTotals();
      return {
        number: (currentSettings.invoice_prefix || "TMKE") + (currentSettings.next_number || 1001),
        issued_date: $("ci-issued").value || null, due_date: $("ci-due").value || null,
        bill_to_name: $("ci-name").value.trim(), bill_to_email: $("ci-email").value.trim(), bill_to_address: $("ci-address").value.trim(),
        client_name: $("ci-client").value.trim(),
        notes: $("ci-notes").value.trim() || null,
        line_items: ciItems.map((it) => ({ description: it.description, qty: 1, unit_pence: Math.round((parseFloat(it.amount) || 0) * 100) })),
        subtotal_pence: t.subtotal, vat_pence: t.vat, total_pence: t.total,
        pay_by_card: ciPayByCard,   // drives the "How to pay" wording in the preview
        release_on_payment: ciRelease,
        terms_days: $("ci-terms").value === "" ? null : Math.max(0, Math.round(Number($("ci-terms").value))),
      };
    }
    const ciSettings = () => ({ ...currentSettings, template: ciTemplate });
    function syncCiTpl() { document.querySelectorAll("#ci-tpl .ci-tpl-opt").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-tpl") === ciTemplate)); }
    function syncCiPay() { document.querySelectorAll("#ci-pay .ci-tpl-opt").forEach((b) => b.classList.toggle("is-active", (b.getAttribute("data-pay") === "yes") === ciPayByCard)); }
    function syncCiRelease() { /* no control here any more - see ciRelease above */ }
    function ciRenderItems() {
      $("ci-items").innerHTML = ciItems.map((it, i) => `<div class="ci-item"><input class="ci-desc" data-i="${i}" placeholder="Description of the service" value="${esc(it.description)}"/><input class="ci-amt" data-i="${i}" type="number" step="0.01" placeholder="0.00" value="${esc(it.amount)}"/><button type="button" class="ci-del" data-i="${i}" title="Remove">&times;</button></div>`).join("");
    }
    function ciRenderTotals() {
      const t = ciTotals();
      $("ci-totals").innerHTML = `<div class="r"><span>Sub-total</span><span>${gbp(t.subtotal)}</span></div><div class="r"><span>VAT (${t.vatRate}%)</span><span>${gbp(t.vat)}</span></div><div class="r grand"><span>Total</span><span>${gbp(t.total)}</span></div>`;
    }
    function ciScaleFit() { const box = $("ci-preview-box"); if (!box || !box.clientWidth) return; const k = Math.min(1, box.clientWidth / 794); $("ci-preview").style.transform = `scale(${k})`; box.style.height = Math.round(1123 * k) + "px"; }
    function ciPreview() { $("ci-preview").srcdoc = renderInvoiceHtml({ settings: ciSettings(), invoice: ciBuildInvoice() }); ciScaleFit(); }
    function ciRefresh() { ciRenderItems(); ciRenderTotals(); ciPreview(); }
    function initCreate() {
      const t = { classic: "minimal", editorial: "minimal", modern: "banded" }[currentSettings.template] || currentSettings.template;
      ciTemplate = ["minimal", "banded"].includes(t) ? t : "minimal"; syncCiTpl();
      if (!$("ci-issued").value) $("ci-issued").value = isoToday();
      if (!$("ci-due").value) { const d = new Date(); d.setDate(d.getDate() + Number(currentSettings.payment_terms_days || 7)); $("ci-due").value = d.toISOString().slice(0, 10); }
      if (!$("ci-notes").value) $("ci-notes").value = NOTES_DEFAULT;
      if (!$("ci-cc").value) $("ci-cc").value = currentSettings.accounts_cc_email || "";
      syncCiRelease();
      ciRefresh();
    }
    $("ci-tpl").addEventListener("click", (e) => { const b = e.target.closest(".ci-tpl-opt"); if (!b) return; ciTemplate = b.getAttribute("data-tpl"); syncCiTpl(); ciPreview(); });
    $("ci-pay").addEventListener("click", (e) => { const b = e.target.closest(".ci-tpl-opt"); if (!b) return; ciPayByCard = b.getAttribute("data-pay") === "yes"; syncCiPay(); ciPreview(); });
    $("ci-terms").addEventListener("input", () => { ciApplyTerms(); ciPreview(); });

    // Keep the due date honest: it is what the client actually reads.
    function ciApplyTerms() {
      const n = Number($("ci-terms").value);
      if (!$("ci-terms").value || isNaN(n)) return;
      const from = $("ci-issued").value ? new Date($("ci-issued").value) : new Date();
      if (isNaN(from)) return;
      from.setDate(from.getDate() + n);
      $("ci-due").value = from.toISOString().slice(0, 10);
    }
    syncCiPay();
    $("ci-items").addEventListener("input", (e) => { const i = +e.target.getAttribute("data-i"); if (e.target.classList.contains("ci-desc")) ciItems[i].description = e.target.value; else if (e.target.classList.contains("ci-amt")) ciItems[i].amount = e.target.value; ciRenderTotals(); ciPreview(); });
    $("ci-items").addEventListener("click", (e) => { const b = e.target.closest(".ci-del"); if (!b) return; ciItems.splice(+b.getAttribute("data-i"), 1); if (!ciItems.length) ciItems.push({ description: "", amount: "" }); ciRefresh(); });
    $("ci-add-item").addEventListener("click", () => { ciItems.push({ description: "", amount: "" }); ciRefresh(); });
    ["ci-name", "ci-client", "ci-email", "ci-address", "ci-issued", "ci-due", "ci-notes"].forEach((id) => $(id).addEventListener("input", ciPreview));
    // Recurring invoices, for the Create form's link and prefill.
    let ciRecurring = [];
    async function loadRecurringOptions() {
      try { const d = await api("/invoicing/recurring"); ciRecurring = d.recurring || []; } catch (_) { ciRecurring = []; }
      const sel = $("ci-recurring"), keep = sel.value;
      sel.innerHTML = `<option value="">— Not a recurring invoice —</option>` + ciRecurring.map((r) => `<option value="${esc(r.id)}">${esc(r.name)}</option>`).join("");
      sel.value = keep;
    }
    // Choosing one fills in who it goes to and the line, if those are empty.
    function ciApplyRecurring(id, ym) {
      const r = ciRecurring.find((x) => x.id === id);
      $("ci-month-f").hidden = !r;
      if (!r) return;
      $("ci-month").value = ym || $("ci-month").value || new Date().toISOString().slice(0, 7);
      const book = ciRecipients.find((x) => String(x.email || "").toLowerCase() === String(r.match_email || "").toLowerCase());
      if (book && !$("ci-name").value) { $("ci-recip").value = book.id; $("ci-name").value = book.name; $("ci-address").value = book.address || ""; }
      if (!$("ci-name").value) $("ci-name").value = r.name;
      if (!$("ci-email").value) $("ci-email").value = r.match_email || "";
      if (ciItems.length === 1 && !ciItems[0].description && !ciItems[0].amount) {
        const label = new Date($("ci-month").value + "-15T12:00:00Z").toLocaleDateString("en-GB", { month: "long", year: "numeric" });
        ciItems = [{ description: `${r.name} — ${label}`, amount: r.amount_pence != null ? (r.amount_pence / 100).toFixed(2) : "" }];
      }
      ciRefresh();
    }
    $("ci-recurring").addEventListener("change", (e) => ciApplyRecurring(e.target.value));
    $("ci-recip").addEventListener("change", (e) => { const r = ciRecipients.find((x) => x.id === e.target.value); if (r) { $("ci-name").value = r.name; $("ci-email").value = r.email || ""; $("ci-address").value = r.address || ""; ciPreview(); } });
    $("ci-open-pdf").addEventListener("click", () => { const w = window.open("", "_blank"); if (!w) return; w.document.open(); w.document.write(renderInvoiceHtml({ settings: ciSettings(), invoice: ciBuildInvoice() })); w.document.close(); });
    // Create a draft; returns the saved invoice (or null on validation/error).
    async function ciCreate(requireEmail) {
      const inv = ciBuildInvoice();
      if (!inv.bill_to_name) { msg("ci-msg", "Enter a recipient name.", false); return null; }
      if (requireEmail && !inv.bill_to_email) { msg("ci-msg", "Enter a recipient email to send to.", false); return null; }
      if (!inv.line_items.some((it) => it.description || it.unit_pence)) { msg("ci-msg", "Add at least one line item.", false); return null; }
      const recId = $("ci-recurring").value || null, recMonth = recId ? ($("ci-month").value || null) : null;
      if (recId && !recMonth) { msg("ci-msg", "Choose which month this recurring invoice is for.", false); return null; }
      const payload = { recurring_id: recId, billing_month: recMonth, bill_to_name: inv.bill_to_name, client_name: inv.client_name || null, bill_to_email: inv.bill_to_email || null, bill_to_address: inv.bill_to_address || null, cc_email: $("ci-cc").value.trim(), recipient_id: $("ci-recip").value || null, issued_date: inv.issued_date, due_date: inv.due_date, notes: inv.notes, template: ciTemplate, pay_by_card: ciPayByCard, release_on_payment: ciRelease, terms_days: inv.terms_days, line_items: inv.line_items };

      // A draft is edited in place - nothing has been sent, so there is no
      // reason to burn a number or leave a void behind.
      if (ciEditing && ciEditing.status === "draft") {
        const { invoice } = await api("/invoicing/invoices", {
          method: "PATCH", headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ id: ciEditing.id, ...payload }),
        });
        return invoice;
      }

      const { invoice } = await api("/invoicing/invoices", {
        method: "POST", headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      currentSettings.next_number = (currentSettings.next_number || 1001) + 1;

      // Reissuing a sent invoice: void the original, but only now that its
      // replacement exists.
      if (ciEditing && ciEditing.status !== "draft") {
        try {
          await api("/invoicing/invoices", {
            method: "PATCH", headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: ciEditing.id, status: "void" }),
          });
        } catch (_) {}
      }
      return invoice;
    }
    function ciReset() { ciEditing = null; $("ci-create").textContent = "Save draft"; $("ci-send").textContent = "Create & send"; ciItems = [{ description: "", amount: "" }]; ["ci-name", "ci-client", "ci-email", "ci-address"].forEach((id) => { $(id).value = ""; }); $("ci-notes").value = NOTES_DEFAULT; $("ci-cc").value = currentSettings.accounts_cc_email || ""; $("ci-recip").value = ""; $("ci-recurring").value = ""; $("ci-month").value = ""; $("ci-month-f").hidden = true; ciRefresh(); }
    $("ci-create").addEventListener("click", async () => {
      const btn = $("ci-create"); btn.disabled = true; btn.textContent = "Saving…";
      try {
        const invoice = await ciCreate(false);
        if (invoice) {
          const was = ciEditing;
          msg("ci-msg", was && was.status === "draft"
            ? `${invoice.number} updated.`
            : `Draft ${invoice.number} saved.${was ? ` ${was.number} voided.` : ""}`, true);
          ciReset(); BOOK = null;
        }
      }
      catch (err) { msg("ci-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Save draft"; }
    });
    $("ci-send").addEventListener("click", async () => {
      const btn = $("ci-send"); btn.disabled = true; btn.textContent = "Creating…";
      try { const invoice = await ciCreate(true); if (invoice) { ciEditing = null; openEmailModal(invoice, true); } }
      catch (err) { msg("ci-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Create & send"; }
    });
    window.addEventListener("resize", ciScaleFit);

    // ---- Email review modal (edit before send) ----
    let cimInvoiceId = null, cimResetOnSend = false;
    const dLong = (x) => x ? new Date(x + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) : null;
    // The wording lives in src/lib/invoice-email.js so Videography sends the
    // same email — it used to send a different one, with no way to amend it.
    function openEmailModal(inv, resetOnSend) {
      cimInvoiceId = inv.id; cimResetOnSend = !!resetOnSend;
      $("cim-num").textContent = inv.number || "";
      $("cim-to").value = inv.bill_to_email || "";
      $("cim-cc").value = inv.cc_email || "";
      // Say plainly what is about to go out - you cannot tell from the subject
      // and body alone whether this carries a payment link.
      const payEl = $("cim-pay");
      if (payEl) {
        payEl.textContent = payLine(inv);
        payEl.className = "cim-pay" + (inv.pay_by_card ? " is-on" : "");
      }
      $("cim-subject").value = defaultEmailSubject(inv, currentSettings);
      $("cim-body").value = defaultEmailBody(inv, currentSettings);
      $("cim-msg").hidden = true;
      $("ci-email-modal").hidden = false;
      // The right email for this invoice (social media, a brand's, a shoot's…),
      // the same words the automatic invoicing sends. Only if nobody's typed yet.
      const s0 = $("cim-subject").value, b0 = $("cim-body").value;
      if (inv.id) api(`/invoicing/email-draft?id=${encodeURIComponent(inv.id)}`).then((d) => {
        if (cimInvoiceId !== inv.id) return;
        if ($("cim-subject").value === s0 && d.subject) $("cim-subject").value = d.subject;
        if ($("cim-body").value === b0 && d.body) $("cim-body").value = d.body;
      }).catch(() => {});
    }
    function closeEmailModal() { $("ci-email-modal").hidden = true; cimInvoiceId = null; }
    $("cim-cancel").addEventListener("click", closeEmailModal);
    $("ci-email-modal").addEventListener("click", (e) => { if (e.target === $("ci-email-modal")) closeEmailModal(); });
    $("cim-send").addEventListener("click", async () => {
      if (!cimInvoiceId) return;
      const btn = $("cim-send"); btn.disabled = true; btn.textContent = "Sending…";
      try {
        await api("/invoicing/invoices/send", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: cimInvoiceId, email_subject: $("cim-subject").value.trim(), email_body: $("cim-body").value, cc: $("cim-cc").value.trim() }) });
        const reset = cimResetOnSend; closeEmailModal();
        if (reset) { msg("ci-msg", "Invoice sent.", true); ciReset(); }
        BOOK = null; if (!$("io-main").closest(".inv-panel").hidden) loadBook();
      } catch (err) { msg("cim-msg", err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Send invoice"; }
    });

    // ---- Invoices list ----
    /* Editing an invoice.

       A draft is edited in place - nothing has left the building, so there is
       no reason to burn a number. A SENT invoice is reissued instead: the
       client holds a numbered document, and quietly changing ours would leave
       two different papers claiming to be TMKE1022. The Worker enforces the
       same rule, so this cannot be bypassed from the page. */

    /* Editing reuses the Create view - same fields, same live preview - rather
       than a separate dialog. A draft saves back to itself; a sent invoice is
       reissued, because the client already holds a numbered document and two
       papers must not claim to be the same invoice. */
    let ciEditing = null;   // { id, number, status } while editing

    async function editInvoice(id) {
      if (!id) return;
      showPanel("create");
      msg("ci-msg", "Loading…", true);
      let full;
      try { full = (await api(`/invoicing/invoice?id=${encodeURIComponent(id)}`)).invoice; }
      catch (err) { msg("ci-msg", "Couldn't load that invoice: " + err.message, false); return; }
      if (!full) { msg("ci-msg", "Couldn't load that invoice.", false); return; }

      ciItems = (full.line_items || []).map((it) => ({
        description: it.description || "",
        amount: (((it.unit_pence || 0) * (it.qty || 1)) / 100).toFixed(2),
      }));
      if (!ciItems.length) ciItems = [{ description: "", amount: "" }];
      $("ci-name").value = full.bill_to_name || "";
      $("ci-client").value = full.client_name || "";
      $("ci-email").value = full.bill_to_email || "";
      $("ci-address").value = full.bill_to_address || "";
      $("ci-cc").value = full.cc_email || "";
      $("ci-issued").value = (full.issued_date || "").slice(0, 10) || isoToday();
      $("ci-due").value = (full.due_date || "").slice(0, 10) || "";
      $("ci-notes").value = full.notes || "";
      $("ci-terms").value = full.terms_days ?? "";
      ciPayByCard = !!full.pay_by_card; syncCiPay();
      ciRelease = !!full.release_on_payment;
      ciEditing = { id: full.id, number: full.number, status: full.status };

      const draft = full.status === "draft";
      $("ci-create").textContent = draft ? "Save changes" : "Reissue as draft";
      $("ci-send").textContent = draft ? "Save & send" : "Reissue & send";
      msg("ci-msg", draft
        ? `Editing draft ${full.number} — saving updates it.`
        : `Editing ${full.number}, which has been sent. Saving raises a NEW invoice and voids ${full.number}.`, true);
      ciRefresh();
    }

    // ---- Monthly checklist ----
    // From August 2026, when monthly invoicing started here; six months at a time.
    const MC_FIRST = "2026-08";
    const ymAdd = (ym, k) => { const [y, m] = ym.split("-").map(Number); const d = new Date(Date.UTC(y, m - 1 + k, 1)); return d.toISOString().slice(0, 7); };
    const ymLabel = (ym) => new Date(ym + "-15T12:00:00Z").toLocaleDateString("en-GB", { month: "short", year: "numeric" });
    const nowYm = new Date().toISOString().slice(0, 7);
    let mcFrom = [MC_FIRST, ymAdd(nowYm, -5)].sort()[1];
    async function loadMonthly() {
      const tbl = $("mc-tbl"), m = $("mc-msg");
      m.hidden = true; tbl.innerHTML = `<tbody><tr><td class="l">Loading…</td></tr></tbody>`;
      $("mc-prev").disabled = mcFrom <= MC_FIRST;
      try {
        const d = await api(`/invoicing/monthly?from=${mcFrom}`);
        $("mc-range").textContent = `${ymLabel(d.months[0])} – ${ymLabel(d.months[d.months.length - 1])}`;
        const notes = [];
        if (!d.recurringReady) notes.push("Recurring invoices need supabase/recurring_invoices.sql running once in Supabase; social clients show without it.");
        (d.warnings || []).forEach((w) => notes.push("Couldn't read " + w));
        if (notes.length) { m.textContent = notes.join(" "); m.hidden = false; }
        const noteMark = (c) => c && (c.note || c.skip) ? `<span class="mc-note" title="${esc((c.skip ? "No invoice this month. " : "") + (c.note || ""))}">&#9998;</span>` : "";
        const mark = (c, which, ym) => {
          if (c && c.skip) return which === "sent" ? `<span class="mc-na">No invoice</span>` : `<span class="mc-na">&ndash;</span>`;
          if (!c || !c.due || ym > d.today) return `<span class="mc-na">&ndash;</span>`;
          if (which === "sent") return c.sent ? `<span class="mc-y" title="${esc(c.numbers.join(", "))}">&#10003;</span>` : c.draft ? `<span class="mc-d" title="${esc(c.numbers.join(", "))}">Draft</span>` : `<span class="mc-n">&#10007;</span>`;
          return !c.sent ? `<span class="mc-na">&ndash;</span>` : c.paid ? `<span class="mc-y">&#10003;</span>` : `<span class="mc-n">&#10007;</span>`;
        };
        const cls = (ym, i) => `${i === 0 ? "m0" : ""}${ym === d.today ? " is-now" : ""}`;
        // A recurring month not sent yet can be raised from here, linked.
        // ... or an invoice already sent can be allocated to it.
        const raise = (r, ym) => { const c = r.cells[ym]; if (r.kind !== "recurring" || !c || !c.due || c.sent || ym > d.today) return "";
          return (c.draft ? "" : `<button type="button" class="mc-raise" data-mcraise="${esc(r.id)}|${ym}">Raise</button>`) + `<button type="button" class="mc-raise" data-mcalloc="${esc(r.id)}|${ym}">Allocate</button>`; };
        const row = (r) => `<tr><td class="l"><b>${esc(r.client)}</b><small>${esc([r.contact, r.kind === "social" ? r.manager : r.match_email, r.note].filter(Boolean).join(" · "))}</small></td>
          <td class="amt">${r.amount_pence != null ? gbp(r.amount_pence) : "–"}${r.kind === "recurring" ? `<button type="button" class="mc-x" data-mcedit="${esc(r.id)}" title="Edit" aria-label="Edit ${esc(r.client)}">&#9998;</button><button type="button" class="mc-x" data-mcdel="${esc(r.id)}" title="Take off the checklist" aria-label="Take ${esc(r.client)} off the checklist">&times;</button>` : ""}</td>
          ${d.months.map((ym) => (r.cells[ym] && r.cells[ym].skip)
            // No invoice that month: one cell across Sent and Paid, so it reads in full.
            ? `<td colspan="2" class="${cls(ym, 0)} mc-cell mc-skipcell" data-mcnote="${r.kind}|${esc(r.id)}|${ym}" title="${esc(r.cells[ym].note || "No invoice this month")}"><span class="mc-na">No invoice</span>${noteMark(r.cells[ym])}</td>`
            : `<td class="${cls(ym, 0)} mc-cell" data-mcnote="${r.kind}|${esc(r.id)}|${ym}" title="Click to add a note">${mark(r.cells[ym], "sent", ym)}${raise(r, ym)}${noteMark(r.cells[ym])}</td><td class="${cls(ym, 1)} mc-cell" data-mcnote="${r.kind}|${esc(r.id)}|${ym}">${mark(r.cells[ym], "paid", ym)}</td>`).join("")}</tr>`;
        MC_ROWS = d.rows;
        mcShoots(d);
        const social = d.rows.filter((r) => r.kind === "social"), rec = d.rows.filter((r) => r.kind === "recurring");
        const span = 2 + d.months.length * 2;
        tbl.innerHTML = `<thead><tr><th class="l" rowspan="2">Client</th><th rowspan="2" style="text-align:right">Monthly</th>${d.months.map((ym) => `<th colspan="2" class="m0${ym === d.today ? " is-now" : ""}">${esc(ymLabel(ym))}</th>`).join("")}</tr>
          <tr>${d.months.map((ym) => `<th class="m0${ym === d.today ? " is-now" : ""}">Sent</th><th class="${ym === d.today ? "is-now" : ""}">Paid</th>`).join("")}</tr></thead>
          <tbody>
            <tr class="mc-sec"><td colspan="${span}">Social media clients · ${social.length}</td></tr>
            ${social.map(row).join("") || `<tr><td class="l" colspan="${span}">No active social media clients.</td></tr>`}
            <tr class="mc-sec"><td colspan="${span}">Recurring invoices · ${rec.length}</td></tr>
            ${rec.map(row).join("") || `<tr><td class="l" colspan="${span}">None yet. Add one below.</td></tr>`}
          </tbody>`;
        tbl.querySelectorAll("[data-mcedit]").forEach((b) => b.addEventListener("click", () => mcEdit(d.rows.find((x) => x.id === b.dataset.mcedit))));
        tbl.querySelectorAll("[data-mcraise]").forEach((b) => b.addEventListener("click", (e) => {
          e.stopPropagation();
          const [id, ym] = b.dataset.mcraise.split("|");
          // The row carries what the form needs, so Raise works even before
          // the recurring list has loaded on the Create tab.
          const row = d.rows.find((x) => x.id === id);
          if (row && !ciRecurring.some((x) => x.id === id)) ciRecurring.push({ id, name: row.client, match_email: row.match_email, amount_pence: row.amount_pence });
          if (row && !$("ci-recurring").querySelector(`option[value="${id}"]`)) $("ci-recurring").insertAdjacentHTML("beforeend", `<option value="${esc(id)}">${esc(row.client)}</option>`);
          ciReset(); showPanel("create");
          $("ci-recurring").value = id; ciApplyRecurring(id, ym);
          window.scrollTo({ top: 0, behavior: "smooth" });
        }));
        tbl.querySelectorAll("[data-mcalloc]").forEach((b) => b.addEventListener("click", (e) => { e.stopPropagation(); const [id, ym] = b.dataset.mcalloc.split("|"); mcAllocate(d.rows.find((x) => x.id === id), ym); }));
        tbl.querySelectorAll("[data-mcnote]").forEach((td) => td.addEventListener("click", () => { const [kind, id, ym] = td.dataset.mcnote.split("|"); mcNote(kind, id, ym); }));
        if (d.notesReady === false) { m.textContent = (m.hidden ? "" : m.textContent + " ") + "Notes need supabase/invoice_month_notes.sql running once in Supabase."; m.hidden = false; }
        tbl.querySelectorAll("[data-mcdel]").forEach((b) => b.addEventListener("click", async () => {
          if (!confirm("Take this off the monthly checklist? Its invoices aren't touched.")) return;
          try { await api(`/invoicing/recurring?id=${encodeURIComponent(b.dataset.mcdel)}`, { method: "DELETE" }); loadMonthly(); } catch (err) { alert(err.message); }
        }));
      } catch (err) { tbl.innerHTML = ""; m.textContent = "Couldn't load the checklist: " + err.message; m.hidden = false; }
      // Addresses from the address book, to pick from.
      try { const rr = await api("/invoicing/recipients"); $("mc-emails").innerHTML = (rr.recipients || rr.rows || []).map((x) => `<option value="${esc(x.email)}">${esc(x.name)}</option>`).join(""); } catch (_) {}
    }
    let MC_ROWS = [];
    // Videography shoots and where each invoice is.
    const SHOOT_STATUS = {
      late: ["is-late", "Late: not sent"], not_due: ["is-wait", "Not due yet"], sent: ["is-sent", "Sent"],
      payment_overdue: ["is-late", "Sent, payment overdue"], paid: ["is-paid", "Paid"], package: ["is-wait", "Covered by social package"],
    };
    function mcShoots(d) {
      const list = d.shoots || [];
      const dd = (x) => x ? new Date(String(x).slice(0, 10) + "T12:00:00Z").toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short" }) : "–";
      const late = list.filter((x) => x.status === "late").length, owed = list.filter((x) => x.status === "payment_overdue").length;
      $("mc-shoots-sum").innerHTML = list.length ? [late ? `<b class="mc-n">${late} late</b>` : "", owed ? `<b class="mc-n">${owed} payment overdue</b>` : "", `${list.length} shoot${list.length === 1 ? "" : "s"}`].filter(Boolean).join(" · ") : "";
      $("mc-shoots").innerHTML = list.length ? `<thead><tr><th class="l">Shoot</th><th class="l">Client</th><th class="l">Service</th><th style="text-align:right">Amount</th><th class="l">Invoice by</th><th class="l">Invoice</th></tr></thead><tbody>${list.map((x) => {
        const [cls, label] = SHOOT_STATUS[x.status] || ["", x.status];
        const extra = x.draft && (x.status === "late" || x.status === "not_due") ? " · draft raised" : "";
        return `<tr class="mc-shoot ${x.status === "late" || x.status === "payment_overdue" ? "is-late" : ""}" data-shoot="${esc(x.id)}" title="${esc(x.numbers.join(", ") || "No invoice yet")}">
          <td class="l">${esc(dd(x.shoot_date))}</td>
          <td class="l"><b>${esc(x.client)}</b>${x.company ? `<small>${esc(x.company)}${x.billed_to ? " · billed to the brand" : ""}</small>` : x.billed_to ? "<small>Billed to the brand</small>" : ""}</td>
          <td class="l">${esc(x.service || "")}</td>
          <td class="amt">${x.amount_pence != null ? gbp(x.amount_pence) : "–"}</td>
          <td class="l">${x.status === "package" ? "–" : esc(dd(x.due_by))}</td>
          <td class="l"><span class="mc-chip ${cls}">${esc(label + extra)}</span></td></tr>`;
      }).join("")}</tbody>` : `<tbody><tr><td class="l">No shoots this month, and nothing earlier waiting on an invoice or payment.</td></tr></tbody>`;
      $("mc-shoots").querySelectorAll("[data-shoot]").forEach((tr) => tr.addEventListener("click", () => { location.href = `/admin/videography?booking=${encodeURIComponent(tr.dataset.shoot)}`; }));
    }
    // A note on a month, and whether an invoice is due at all.
    function mcNote(kind, id, ym) {
      const r = MC_ROWS.find((x) => x.id === id && x.kind === kind); if (!r) return;
      const c = r.cells[ym] || {};
      const host = $("mc-modal");
      host.innerHTML = `<div class="mc-modal-box" role="dialog" aria-modal="true" aria-label="Note">
        <h3>${esc(r.client)} · ${esc(new Date(ym + "-15T12:00:00Z").toLocaleDateString("en-GB", { month: "long", year: "numeric" }))}</h3>
        <p class="inv-intro" style="margin:4px 0 12px">${c.numbers && c.numbers.length ? "Invoices: " + esc(c.numbers.join(", ")) : "No invoice for this month yet."}</p>
        <label class="inv-field"><span>Note</span><textarea id="mc-note-t" rows="3" placeholder="e.g. Not charged this month, agreed with Sean">${esc(c.note || "")}</textarea></label>
        <label class="mc-skip"><input type="checkbox" id="mc-note-skip" ${c.skip ? "checked" : ""}> No invoice this month (not flagged as missing)</label>
        <p class="inv-msg" id="mc-note-msg" hidden></p>
        <div class="mc-modal-acts"><button type="button" class="inv-ghost" data-mcclose>Cancel</button><button type="button" class="inv-save" id="mc-note-save">Save</button></div>
      </div>`;
      host.hidden = false; $("mc-note-t").focus();
      $("mc-note-save").addEventListener("click", async () => {
        try {
          await api("/invoicing/month-note", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ row_kind: kind, row_id: id, month: ym, note: $("mc-note-t").value, skip: $("mc-note-skip").checked }) });
          host.hidden = true; loadMonthly();
        } catch (err) { msg("mc-note-msg", err.message, false); }
      });
    }
    $("mc-modal").addEventListener("click", (e) => { if (e.target.id === "mc-modal" || e.target.closest("[data-mcclose]")) $("mc-modal").hidden = true; });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") $("mc-modal").hidden = true; });
    // Allocate: pick an invoice already sent for this recurring row and month.
    async function mcAllocate(r, ym) {
      if (!r) return;
      const host = $("mc-modal");
      const monthName = new Date(ym + "-15T12:00:00Z").toLocaleDateString("en-GB", { month: "long", year: "numeric" });
      host.innerHTML = `<div class="mc-modal-box mc-alloc" role="dialog" aria-modal="true" aria-label="Allocate an invoice">
        <h3>Allocate an invoice</h3>
        <p class="inv-intro" style="margin:4px 0 10px">${esc(r.client)} · ${esc(monthName)}. Pick the invoice that was sent for it; from then on its payment shows here.</p>
        <input type="search" class="mc-alloc-q" id="mc-alloc-q" placeholder="Search number, name or amount">
        <div class="mc-alloc-list" id="mc-alloc-list"><p class="inv-intro">Loading invoices…</p></div>
        <p class="inv-msg" id="mc-alloc-msg" hidden></p>
        <div class="mc-modal-acts"><button type="button" class="inv-ghost" data-mcclose>Cancel</button></div>
      </div>`;
      host.hidden = false;
      let list = [];
      try { list = (await api("/invoicing/allocate")).invoices || []; } catch (err) { $("mc-alloc-list").innerHTML = ""; msg("mc-alloc-msg", err.message, false); return; }
      const want = String(r.match_email || "").toLowerCase();
      // Sent to this row's address first, then newest.
      list.sort((a, b) => ((String(b.bill_to_email || "").toLowerCase() === want) - (String(a.bill_to_email || "").toLowerCase() === want)));
      const dd = (x) => x ? new Date(x + "T12:00:00Z").toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : "";
      const draw = (q) => {
        const rows = list.filter((iv) => !q || [iv.number, iv.bill_to_name, iv.client_name, iv.line, iv.bill_to_email, (iv.total_pence / 100).toFixed(2)].join(" ").toLowerCase().includes(q));
        $("mc-alloc-list").innerHTML = rows.length ? rows.map((iv) => {
          const here = iv.recurring_id === r.id, other = iv.recurring_id && !here;
          return `<button type="button" class="mc-alloc-row${other ? " is-other" : ""}" data-iv="${esc(iv.id)}">
            <span class="n"><b>${esc(iv.number || "—")}</b> ${esc(iv.bill_to_name || "")}<small>${esc([iv.line, dd(iv.issued_date)].filter(Boolean).join(" · "))}</small></span>
            <span class="a">${gbp(iv.total_pence)}<small>${iv.status === "paid" ? "Paid" : "Sent"}${here ? " · already here" : other ? " · allocated elsewhere" : ""}</small></span>
          </button>`;
        }).join("") : `<p class="inv-intro">No invoices match.</p>`;
        $("mc-alloc-list").querySelectorAll("[data-iv]").forEach((b) => b.addEventListener("click", async () => {
          const iv = list.find((x) => x.id === b.dataset.iv);
          if (iv.recurring_id && iv.recurring_id !== r.id && !confirm(`${iv.number} is already allocated to another recurring invoice. Move it to ${r.client}, ${monthName}?`)) return;
          b.disabled = true;
          try { await api("/invoicing/allocate", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ invoice_id: iv.id, recurring_id: r.id, month: ym }) }); host.hidden = true; loadMonthly(); }
          catch (err) { msg("mc-alloc-msg", err.message, false); b.disabled = false; }
        }));
      };
      draw("");
      $("mc-alloc-q").addEventListener("input", (e) => draw(e.target.value.trim().toLowerCase()));
      $("mc-alloc-q").focus();
    }
    // Editing a recurring invoice: back into the form, saved in place.
    let mcEditing = null;
    function mcEdit(r) {
      if (!r) return;
      const f = $("mc-form");
      mcEditing = r.id;
      f.name.value = r.client; f.contact_name.value = r.contact || ""; f.match_email.value = r.match_email || "";
      f.amount.value = r.amount_pence != null ? (r.amount_pence / 100).toFixed(2) : ""; f.match_text.value = r.match_text || ""; f.start_month.value = r.start_month || "";
      const a = r.auto || {};
      f.auto_send.checked = !!a.auto_send; f.day_of_month.value = a.day_of_month ?? ""; f.frequency.value = a.frequency || "monthly"; f.end_month.value = a.end_month || "";
      f.bill_to_name.value = a.bill_to_name || ""; f.bill_to_email.value = a.bill_to_email || ""; f.cc_email.value = a.cc_email || ""; f.bill_to_address.value = a.bill_to_address || "";
      f.line.value = a.line || ""; f.terms_days.value = a.terms_days ?? "";
      $("mc-form-h").textContent = "Edit a recurring invoice"; $("mc-form-btn").textContent = "Save changes"; $("mc-form-cancel").hidden = false;
      f.scrollIntoView({ behavior: "smooth", block: "center" });
    }
    function mcEditDone() { mcEditing = null; $("mc-form").reset(); $("mc-form-h").textContent = "Add a recurring invoice"; $("mc-form-btn").textContent = "Add to the checklist"; $("mc-form-cancel").hidden = true; }
    $("mc-form-cancel").addEventListener("click", mcEditDone);
    $("mc-prev").addEventListener("click", () => { mcFrom = [MC_FIRST, ymAdd(mcFrom, -6)].sort()[1]; loadMonthly(); });
    $("mc-next").addEventListener("click", () => { mcFrom = ymAdd(mcFrom, 6); loadMonthly(); });
    $("mc-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = new FormData(e.target);
      const amt = String(f.get("amount") || "").trim();
      try {
        const was = mcEditing;
        await api("/invoicing/recurring", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({
          id: mcEditing || undefined, name: f.get("name"), contact_name: f.get("contact_name"), match_email: f.get("match_email"), match_text: f.get("match_text"),
          amount_pence: amt ? Math.round(Number(amt) * 100) : null, start_month: f.get("start_month") || null,
          auto: { auto_send: !!f.get("auto_send"), day_of_month: f.get("day_of_month"), frequency: f.get("frequency"), end_month: f.get("end_month"),
            bill_to_name: f.get("bill_to_name"), bill_to_email: f.get("bill_to_email"), cc_email: f.get("cc_email"), bill_to_address: f.get("bill_to_address"),
            line: f.get("line"), terms_days: f.get("terms_days") },
        }) });
        mcEditDone(); msg("mc-form-msg", was ? "Saved." : "Added.", true); loadMonthly(); loadRecurringOptions();
      } catch (err) { msg("mc-form-msg", err.message, false); }
    });

    /* ---- Approvals (automatic invoicing) ---- */
    const AP_STATUS = { pending: "Waiting", approved: "Approved", rejected: "Rejected", superseded: "Replaced" };
    async function loadApprovals() {
      const tbl = $("ap-tbl"); tbl.innerHTML = `<tr><td class="inv-empty">Loading…</td></tr>`;
      try {
        const d = await api("/invoicing/approvals");
        $("ap-mode").value = d.mode || "off";
        drawNumbers(d.numbers || []);
        const rows = (d.approvals || []).filter((x) => x.status !== "superseded");
        if (!rows.length) { tbl.innerHTML = `<tr><td class="inv-empty">Nothing yet. Invoices put to someone to approve show here.</td></tr>`; return; }
        const when = (x) => x ? new Date(x).toLocaleString("en-GB", { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }) : "";
        tbl.innerHTML = `<thead><tr><th>Invoice</th><th>To</th><th class="mc-num">Total</th><th>Approver</th><th>Asked</th><th>Status</th><th></th></tr></thead><tbody>${rows.map((x) => {
          const inv = x.invoice || {};
          const again = x.status === "rejected" && inv.status === "draft";
          return `<tr><td><strong>${esc(inv.number || "")}</strong></td><td>${esc(inv.bill_to_name || "")}</td><td class="mc-num">${inv.total_pence != null ? "£" + (inv.total_pence / 100).toFixed(2) : ""}</td>
            <td>${esc(String(x.approver_email || "").split("@")[0])}</td><td>${when(x.requested_at)}${x.round > 1 ? ` · round ${x.round}` : ""}</td>
            <td><span class="ap-pill is-${x.status}">${AP_STATUS[x.status] || x.status}</span>${x.notes ? `<div class="ap-notes">${esc(x.notes)}</div>` : ""}</td>
            <td>${again ? `<button type="button" class="inv-save ap-again" data-again="${esc(x.invoice_id)}">Send to ${esc(String(x.approver_email || "").split("@")[0].split(/[._]/)[0].replace(/^./, (m) => m.toUpperCase()) || "Jack")} again</button>` : inv.booking_id ? `<a class="ap-open" href="/admin/videography?booking=${esc(inv.booking_id)}">Open</a>` : ""}</td></tr>`;
        }).join("")}</tbody>`;
        tbl.querySelectorAll("[data-again]").forEach((b) => b.addEventListener("click", async () => {
          b.disabled = true; b.textContent = "Sending…";
          try { const r = await api("/invoicing/approval/request", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ invoice_id: b.dataset.again }) }); msg("ap-msg", r.test ? "Sent for approval (test mode: it came to you)." : "Sent back for approval.", true); loadApprovals(); }
          catch (err) { msg("ap-msg", err.message, false); b.disabled = false; b.textContent = "Try again"; }
        }));
      } catch (err) { tbl.innerHTML = `<tr><td class="inv-empty">${esc(/invoice_approvals|automation_mode/.test(err.message) ? "Run supabase/invoicing_automation.sql first." : err.message)}</td></tr>`; }
    }
    function drawNumbers(nums) {
      const host = $("ap-numbers");
      if (!nums.length) { host.hidden = true; return; }
      host.hidden = false;
      host.innerHTML = `<h3 class="mc-h">Numbers needed</h3><p class="inv-intro">These invoices need a number from you each month before they can go out. Fill it in any time before the day it goes.</p>` +
        nums.map((n) => `<div class="ap-num-row"><span class="ap-num-name"><strong>${esc(n.name)}</strong> · ${esc(n.month_label)}<em>${esc(n.label)}${n.unit_pence ? `, £${(n.unit_pence / 100).toFixed(2)} each` : ""}. Goes out on the ${n.day}${[11, 12, 13].includes(n.day % 100) ? "th" : ({ 1: "st", 2: "nd", 3: "rd" }[n.day % 10] || "th")}.</em></span>
          <input type="number" min="0" step="1" value="${n.qty ?? ""}" data-numfor="${esc(n.recurring_id)}" data-month="${esc(n.month)}" aria-label="${esc(n.label)}" />
          <button type="button" class="inv-save" data-numsave="${esc(n.recurring_id)}|${esc(n.month)}">${n.qty != null ? "Update" : "Save"}</button>
          <span class="ap-num-done">${n.qty != null ? `Saved${n.entered_by ? ` by ${esc(String(n.entered_by).split("@")[0])}` : ""}` : ""}</span></div>`).join("");
      host.querySelectorAll("[data-numsave]").forEach((b) => b.addEventListener("click", async () => {
        const [rid, month] = b.dataset.numsave.split("|");
        const inp = host.querySelector(`[data-numfor="${rid}"][data-month="${month}"]`);
        if (inp.value === "") { msg("ap-msg", "Type the number first.", false); return; }
        b.disabled = true;
        try { await api("/invoicing/recurring/quantity", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ recurring_id: rid, month, qty: Number(inp.value) }) }); msg("ap-msg", "Saved. It goes out on its day with that number.", true); loadApprovals(); }
        catch (err) { msg("ap-msg", /recurring_quantities/.test(err.message) ? "Run supabase/invoicing_automation_2.sql first." : err.message, false); b.disabled = false; }
      }));
    }
    // The switch for everything the morning run sends (Dani, 6 Nov 2026).
    function drawJobs() {
      const on = currentSettings.morning_jobs_on, ready = on !== undefined;
      $("ap-jobs-note").textContent = !ready ? "Run supabase/morning_jobs_switch.sql first. Until then, they stay off." : on
        ? "On. Each morning: the note to clients the day after a shoot, invoice due-date reminders, the gallery expiry warning, alerts to the team, the TEG sheet sync and the automatic invoicing above, in whichever mode it's set to."
        : "Off, so nothing goes by itself at 8am. Turning it on starts the note to clients the day after a shoot, invoice due-date reminders, the gallery expiry warning, alerts to the team, the TEG sheet sync and the automatic invoicing above, in whichever mode it's set to.";
      $("ap-jobs-tog").querySelectorAll("button").forEach((b) => { b.disabled = !ready; b.setAttribute("aria-pressed", String((b.dataset.v === "1") === !!on)); });
    }
    $("ap-jobs-tog").addEventListener("click", async (e) => {
      const b = e.target.closest("[data-v]"); if (!b) return;
      const v = b.dataset.v === "1";
      if (v === !!currentSettings.morning_jobs_on) return;
      if (v && !confirm("Turn the 8am jobs on? From tomorrow morning, reminders and alerts go by themselves.")) return;
      try { await api("/invoicing/settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ morning_jobs_on: v }) }); currentSettings.morning_jobs_on = v; drawJobs(); msg("ap-msg", v ? "The 8am jobs are on." : "The 8am jobs are off.", true); }
      catch (err) { msg("ap-msg", err.message, false); }
    });
    $("ap-mode").addEventListener("change", async (e) => {
      const v = e.target.value;
      if (v === "live" && !confirm("Live: recurring invoices will go to clients on their day, and approved shoot invoices will go to clients straight away. Carry on?")) { loadApprovals(); return; }
      try { await api("/invoicing/settings", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ automation_mode: v }) }); msg("ap-msg", v === "off" ? "Automatic invoicing is off." : v === "test" ? "Test mode: drafts are made and every email comes to you." : "Live: invoices go to clients.", true); }
      catch (err) { msg("ap-msg", /automation_mode/.test(err.message) ? "Run supabase/invoicing_automation.sql first." : err.message, false); }
    });
    $("ap-run").addEventListener("click", async (e) => {
      const b = e.currentTarget; b.disabled = true; b.textContent = "Running…";
      try { const r = await api("/invoicing/automation/run", { method: "POST" }); msg("ap-msg", r.mode === "off" ? "It's off: switch it to Test or Live first." : r.lines ? `Done: ${r.lines} thing${r.lines === 1 ? "" : "s"} happened, and you've been emailed what.` : "Done: nothing was due today.", true); loadApprovals(); }
      catch (err) { msg("ap-msg", err.message, false); }
      finally { b.disabled = false; b.textContent = "Run it now"; }
    });

    /* ---- The month (Dani, 5-6 Nov 2026) ----------------------------------
       Worked out from the invoices by Worker /invoicing/book, never typed in. */
    let BOOK = null, TODAY = "", PENDING = [], NUMBERS = [], TICKS = null;
    const S = { month: "", kind: "all", status: "", q: "" };
    const KINDS = [["social", "Social media"], ["video", "Videography"], ["agent", "Agent services"], ["oneoff", "One-offs"]];
    const svc = (v) => (v.kind === "video" ? "Videography" : v.kind === "agent" ? "Agent services" : v.kind === "social" ? "Social media" : "One-off");
    const ICON_NOTE = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v12l-5 5H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M14 21v-5h5M9 8h6M9 12h6"/></svg>';
    const ICON_MAIL = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>';
    const day = (d) => (d ? new Date(d + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short" }) : "");
    const sum = (a) => a.reduce((t, v) => t + v.net_pence, 0);
    const isOver = (v) => v.status === "sent" && v.due && v.due < TODAY;
    const state = (v) => (v.status === "paid" ? "paid" : v.status === "draft" ? "draft" : v.not_paid ? "notpaid" : isOver(v) ? "over" : "wait");
    const byId = (id) => (BOOK || []).find((x) => x.id === id);
    const held = (v) => v.content_ready && v.status !== "paid";
    function chip(v) {
      const s = state(v);
      if (s === "paid") return `<span class="chip good">Paid ${esc(day(v.paid_on))}</span>`;
      if (s === "draft") return '<span class="chip plain">Draft, not sent</span>';
      if (s === "notpaid") return '<span class="chip bad">Accounts: not paid</span>';
      if (s === "over") return '<span class="chip bad">Overdue</span>';
      return '<span class="chip wait">Waiting</span>';
    }
    const flags = (v) => `<div class="flags">${chip(v)}${held(v) ? '<span class="chip wait">Content ready</span>' : ""}</div>`;
    function pass(v) {
      if (S.kind !== "all" && v.kind !== S.kind) return false;
      if (S.q && `${v.client} ${v.payer} ${v.number}`.toLowerCase().indexOf(S.q) < 0) return false;
      if (S.status === "paid" && v.status !== "paid") return false;
      if (S.status === "wait" && state(v) !== "wait") return false;
      if (S.status === "over" && !(state(v) === "over" || state(v) === "notpaid")) return false;
      return true;
    }
    function row(v) {
      const open = v.status === "sent";
      return `<tr class="click" data-inv="${esc(v.id)}" tabindex="0"><td>${esc(v.client)}</td><td class="tx">${esc(v.what)}</td><td class="tx">${esc(v.number)}</td><td class="tx">${esc(v.payer)}</td><td class="tx">${v.sent ? esc(day(v.sent)) : "—"}</td><td class="tx">${esc(day(v.due))}</td><td class="num">${gb(v.net_pence)}</td><td>${flags(v)}</td><td><div class="row-acts"><button type="button" class="ic${v.note ? " has" : ""}" data-note="${esc(v.id)}" aria-label="${v.note ? "Read the note" : "Add a note"}" title="${v.note ? "There's a note" : "Add a note"}">${ICON_NOTE}</button>${open ? `<button type="button" class="ic" data-email="${esc(v.id)}" aria-label="Email accounts about this one" title="Email accounts about this one">${ICON_MAIL}</button>` : ""}</div></td></tr>`;
    }
    const THEAD = '<thead><tr><th>Client</th><th>For</th><th>Invoice</th><th>Who pays</th><th>Sent</th><th>Due</th><th class="num">Net</th><th>Status</th><th></th></tr></thead>';
    const table = (list) => `<div class="tablewrap" data-lenis-prevent><table class="grid-us">${THEAD}<tbody>${list.map(row).join("")}</tbody></table></div>`;

    async function loadBook() {
      const st = $("io-state"), main = $("io-main");
      if (!BOOK) { st.hidden = false; st.className = "state"; st.textContent = "Loading…"; main.hidden = true; }
      try {
        const d = await api("/invoicing/book");
        BOOK = d.invoices || []; TODAY = d.today; PENDING = d.pending || []; NUMBERS = d.numbers || []; TICKS = d.ticks || null;
        if (!S.month) S.month = TODAY.slice(0, 7);
        st.hidden = true; main.hidden = false;
        drawBook();
      } catch (err) { st.hidden = false; st.className = "state bad"; st.textContent = err.message; main.hidden = true; }
    }
    function months() {
      const now = TODAY.slice(0, 7), first = (BOOK.map((v) => v.month).filter(Boolean).sort()[0]) || now, out = [];
      for (let m = first; m <= now; m = ymAddMonths(m, 1)) out.push(m);
      return out;
    }
    function drawBook() {
      const ms = months();
      $("io-month").textContent = ymLong(S.month);
      $("io-prev").disabled = S.month === ms[0]; $("io-next").disabled = S.month === ms[ms.length - 1];
      const inMonth = BOOK.filter((v) => v.month === S.month);
      const c = {}; inMonth.forEach((v) => { c[v.kind] = (c[v.kind] || 0) + 1; });
      const overAll = BOOK.filter((v) => state(v) === "over" || state(v) === "notpaid");
      $("io-chips").innerHTML = `<button type="button" data-kind="all" aria-pressed="${S.kind === "all"}">All</button>` + KINDS.filter((k) => c[k[0]]).map((k) => `<button type="button" data-kind="${k[0]}" aria-pressed="${S.kind === k[0]}">${k[1]} <i>${c[k[0]]}</i></button>`).join("") + `<button type="button" data-status="over" aria-pressed="${S.status === "over"}">Overdue <i>${overAll.length}</i></button>`;
      const live = inMonth.filter((v) => v.status !== "draft"), paid = live.filter((v) => v.status === "paid"), wait = live.filter((v) => state(v) === "wait");
      const n = (a) => `${a.length} ${a.length === 1 ? "invoice" : "invoices"}`;
      const fig = (cls, key, val, label) => `<button type="button" class="fig ${cls}" data-status="${key}" aria-pressed="${!!key && S.status === key}"><b>${val}</b><span>${label}</span></button>`;
      $("io-figs").innerHTML = fig("lin", "", gb(sum(live)), `Raised in ${ymLong(S.month).split(" ")[0]}, ${n(live)}`) + fig("lin", "paid", gb(sum(paid)), `Paid, ${n(paid)}`) + fig("lin", "wait", gb(sum(wait)), `Waiting, ${wait.length} not yet due`) + fig("dark", "over", gb(sum(overAll)), `Overdue, ${overAll.length} from any month`);

      // Needs you: only things someone has to do, worked out from the invoices.
      const needs = [];
      const need = (title, words, foot) => `<div class="need"><div class="need-t">${esc(title)}</div><p>${words}</p><div class="need-f">${foot}</div></div>`;
      BOOK.filter((v) => v.not_paid).forEach((v) => needs.push(need(v.client, `Accounts say ${esc(v.number)} isn't paid: "${esc(v.not_paid)}"`, `<button type="button" class="btn" data-inv="${esc(v.id)}">Open</button>`)));
      BOOK.filter(held).forEach((v) => {
        const last = v.reminders[v.reminders.length - 1];
        needs.push(need(v.client, `Jack's finished, but ${esc(v.number)} isn't marked paid, so their content is held.${last ? ` Reminder sent ${esc(day(last))}.` : ""}`, `<button type="button" class="btn" data-inv="${esc(v.id)}">Open</button><button type="button" class="btn primary" data-email="${esc(v.id)}">Urgent reminder</button>`));
      });
      BOOK.filter((v) => v.status === "draft").forEach((v) => {
        const ap = PENDING.find((x) => x.invoice_id === v.id);
        const who = ap ? String(ap.approver_email || "").split("@")[0].split(/[._-]/)[0].replace(/^./, (m) => m.toUpperCase()) : "";
        needs.push(need(v.client, ap ? `Invoice ${esc(v.number)} is drafted, waiting for ${esc(who)} to approve.${v.kind === "video" ? " It goes two days before the shoot." : ""}` : `Invoice ${esc(v.number)} is a draft. It hasn't been sent.`, `<button type="button" class="btn" data-inv="${esc(v.id)}">Open</button>${ap ? `<button type="button" class="btn primary" data-approve="${esc(ap.id)}">Approve and send</button>` : `<button type="button" class="btn primary" data-send="${esc(v.id)}">Send</button>`}`));
      });
      NUMBERS.forEach((x) => needs.push(need(x.name, `${esc(x.label)} in ${esc(x.month_label.split(" ")[0])}?${x.unit_pence ? ` ${gb(x.unit_pence)} each,` : ""} goes out on the ${x.day}${[11, 12, 13].includes(x.day % 100) ? "th" : ({ 1: "st", 2: "nd", 3: "rd" }[x.day % 10] || "th")}.`, `<input type="number" min="0" step="1" data-numfor="${esc(x.recurring_id)}|${esc(x.month)}" aria-label="${esc(x.label)}" placeholder="0"><button type="button" class="btn primary" data-numsave="${esc(x.recurring_id)}|${esc(x.month)}">Save</button>`)));
      if (TICKS) needs.push(need("Social media ticks", `Abigail has ticked ${TICKS.ticked} of ${TICKS.total} clients for ${esc(TICKS.month_label.split(" ")[0])}. Anyone not ticked isn't invoiced.`, `<a class="btn" href="/admin/social?go=invoices">Open the list</a>`));
      $("io-needs-n").textContent = needs.length; $("io-needs").innerHTML = needs.join(""); $("io-needs-sec").hidden = !needs.length;

      const earlier = BOOK.filter((v) => v.month < S.month && ["over", "wait", "notpaid"].includes(state(v)) && pass(v));
      $("io-open").innerHTML = earlier.length ? `<div class="section" style="margin-top:26px"><div class="strip"><div class="strip-t">Still open from earlier months<span>${earlier.length}</span></div></div>${table(earlier)}</div>` : "";
      let html = "";
      KINDS.forEach((k) => {
        const list = inMonth.filter((v) => v.kind === k[0] && pass(v));
        if (list.length) html += `<div class="section" style="margin-top:26px"><div class="strip"><div class="strip-t">${k[1]}<span>${list.length}</span></div><span class="aside">${gb(sum(list))}</span></div>${table(list)}</div>`;
      });
      $("io-streams").innerHTML = html || (earlier.length ? "" : '<div class="empty" style="margin-top:26px">Nothing matches that.</div>');
    }
    $("io-prev").addEventListener("click", () => { const m = months(), i = m.indexOf(S.month); if (i > 0) { S.month = m[i - 1]; drawBook(); } });
    $("io-next").addEventListener("click", () => { const m = months(), i = m.indexOf(S.month); if (i < m.length - 1) { S.month = m[i + 1]; drawBook(); } });
    $("io-q").addEventListener("input", (e) => { S.q = e.target.value.trim().toLowerCase(); drawBook(); });

    /* ---- Pop-outs ---- */
    function popShell(eye, title, chips, body, foot, wide) {
      $("io-pop").innerHTML = `<div class="scrim" id="io-scrim"><div class="pop${wide ? " wide" : ""}" role="dialog" aria-modal="true" aria-label="${esc(eye)}"><div class="pop-h"><div><p class="mo-eye" style="margin:0">${esc(eye)}</p><div class="pop-title">${title}</div>${chips || ""}</div><button type="button" class="x" data-close aria-label="Close">×</button></div><div class="pop-b" data-lenis-prevent>${body}</div><div class="pop-f">${foot}</div></div></div>`;
    }
    const closePop = () => { $("io-pop").innerHTML = ""; };
    let toastT;
    function toast(m) { const t = $("io-toast"); t.textContent = m; t.classList.add("on"); clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove("on"), 2800); }
    const postJson = (path, data) => api(path, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(data) });

    function openInv(id) {
      const v = byId(id); if (!v) return;
      const who = v.route === "internal" ? "Inter-brand. Accounts settle it on the portal." : v.method === "direct_debit" ? "Direct debit, so it isn't on the portal." : v.status === "paid" && v.paid_how === "Card" ? "Paid by card, so it confirmed itself." : "External client. Accounts confirm it on the portal.";
      const tl = [];
      if (v.sent) tl.push(`<li>Sent to ${esc(v.payer)}, ${esc(day(v.sent))}</li>`);
      v.reminders.forEach((d) => tl.push(`<li>Reminder sent to accounts, ${esc(day(d))}</li>`));
      if (v.status === "paid") tl.push(`<li>Paid ${esc(day(v.paid_on))} (${esc(v.paid_how)})</li>`);
      else if (v.not_paid) tl.push(`<li>Accounts: not paid. "${esc(v.not_paid)}"</li>`);
      else if (v.status === "draft") tl.push(`<li class="next">${PENDING.some((x) => x.invoice_id === v.id) ? "Waiting to be approved, then it sends" : "Not sent yet"}</li>`);
      else tl.push('<li class="next">On the accounts portal, waiting to be confirmed</li>');
      if (v.release) tl.push(`<li class="next">${esc(v.release)} held until this is paid</li>`);
      const sectorName = v.sector === "pick" ? "not chosen yet" : SECTOR_NAME[v.sector];
      const sectors = `<option value="">As the rule says (${esc(sectorName)})</option>` + Object.keys(SECTOR_NAME).map((k) => `<option value="${k}"${v.sector_chosen && v.sector === k ? " selected" : ""}>${esc(SECTOR_NAME[k])}</option>`).join("");
      const foot = ['<button type="button" class="btn" data-close>Close</button>', `<button type="button" class="btn" data-pdf="${esc(v.id)}">View PDF</button>`];
      if (v.status === "draft") foot.push(`<button type="button" class="btn" data-edit="${esc(v.id)}">Edit</button>`, `<button type="button" class="btn danger" data-del="${esc(v.id)}">Delete</button>`, `<button type="button" class="btn primary" data-send="${esc(v.id)}">Send</button>`);
      else {
        foot.push(`<button type="button" class="btn" data-edit="${esc(v.id)}">Reissue</button>`, `<button type="button" class="btn danger" data-void="${esc(v.id)}">Void</button>`, `<button type="button" class="btn" data-send="${esc(v.id)}">Resend</button>`);
        if (v.status === "sent") foot.push(`<button type="button" class="btn" data-email="${esc(v.id)}">Email accounts</button>`, `<button type="button" class="btn primary" data-mark="${esc(v.id)}">Mark paid</button>`);
      }
      popShell(`Invoice ${v.number}`, esc(v.client), flags(v),
        `<dl class="rows"><div><dt>For</dt><dd>${esc(v.what)}</dd></div><div><dt>Type</dt><dd>${esc(svc(v))}</dd></div><div><dt>Who pays</dt><dd>${esc(v.payer)}</dd></div><div><dt>How</dt><dd>${esc(who)}</dd></div><div><dt>Sent</dt><dd>${v.sent ? esc(day(v.sent)) : "Not yet"}</dd></div><div><dt>Due</dt><dd>${esc(day(v.due))}</dd></div><div><dt>Net</dt><dd>${gb(v.net_pence)} (${gb(v.total_pence)} with VAT)</dd></div>` +
        v.lines.map((l) => `<div><dt>${esc(gb(l.net_pence))} + VAT</dt><dd>${esc(l.description)}</dd></div>`).join("") +
        `<div><dt>Revenue goes under</dt><dd><select data-sector="${esc(v.id)}" aria-label="Which sector its revenue goes under">${sectors}</select></dd></div>` +
        `<div><dt>Was a card link sent?</dt><dd><span class="tog"><button type="button" data-card="${esc(v.id)}" data-v="1" aria-pressed="${!!v.pay_by_card}">Yes</button><button type="button" data-card="${esc(v.id)}" data-v="0" aria-pressed="${!v.pay_by_card}">No</button></span></dd></div>` +
        (v.note ? `<div><dt>Note</dt><dd style="white-space:normal">${esc(v.note)}</dd></div>` : "") +
        `</dl><div><p class="mo-eye">What's happened</p><ul class="tl">${tl.join("")}</ul></div>`,
        foot.join(""), true);
    }
    function openNote(id) {
      const v = byId(id); if (!v) return;
      popShell(`${v.number}, ${v.client}`, "A note", "", `<label class="field"><span>Anything worth remembering on this one. Both sides can see it.</span><textarea id="io-note" rows="10" placeholder="e.g. Paying with the next batch on Friday">${esc(v.note || "")}</textarea></label>`, `<button type="button" class="btn" data-close>Cancel</button><button type="button" class="btn primary" data-savenote="${esc(v.id)}">Save</button>`);
      $("io-note").focus();
    }
    function openEmail(id) {
      const v = byId(id); if (!v) return;
      const urgent = held(v), amt = `${gb(v.net_pence)} + VAT`;
      const words = urgent
        ? `${v.client}'s content is finished, but we can't release it until invoice ${v.number} for ${amt} is marked as paid. Could you take a look today?`
        : `Invoice ${v.number} for ${amt} (${v.client}) is still open. Could you let us know where it's up to?`;
      popShell("Email accounts", urgent ? "Urgent reminder" : "A reminder", "",
        `<label class="field"><span>To</span><input value="Paula and the accounts team" readonly></label><label class="field"><span>Subject</span><input id="io-em-sub" value="${esc((urgent ? "Urgent: " : "") + v.number + (urgent ? ", content waiting on payment." : ", still open."))}"></label><label class="field"><span>Message</span><textarea id="io-em-body" rows="9">${esc(`Hi Paula,\n\n${words}\n\nYou can mark it on your page: [link to the portal]\n\nThank you.`)}</textarea></label>`,
        `<button type="button" class="btn" data-close>Cancel</button><button type="button" class="btn primary" data-sendemail="${esc(v.id)}">Send</button>`);
    }

    // The month-end email: to Paula, short, and what to do.
    async function openMonthEnd() {
      popShell("Month-end email", "Coming up to month end", "", '<p class="state">Loading…</p>', '<button type="button" class="btn" data-close>Close</button>', true);
      try {
        const d = await api("/invoicing/month-end");
        popShell("Month-end email", "Coming up to month end", "",
          `<p style="margin:0;color:var(--tx)">${d.emails_on ? "Goes by itself on the 20th, and again on the 28th if anything's still open. This is what it says." : "This is what it says. It isn't going by itself yet: switch that on in Settings, under Accounts portal, once you've tested it."}</p><div class="mail">${d.html}</div>`,
          `<button type="button" class="btn" data-close>Close</button><button type="button" class="btn" data-mesend="test">Send me a test</button><button type="button" class="btn primary" data-mesend="live">Send to ${esc(d.to)}</button>`, true);
      } catch (err) { popShell("Month-end email", "Coming up to month end", "", `<p class="state bad">${esc(err.message)}</p>`, '<button type="button" class="btn" data-close>Close</button>', true); }
    }

    // The Month-end review, for whichever month you're on.
    let REVIEW = null, reviewDraft = null;
    async function openReview() {
      const m = S.month, thisMonth = TODAY.slice(0, 7), title = esc(ymLong(m)) + (m === thisMonth ? " so far" : "");
      const shell = (body, foot) => popShell("Month-end review", title, "", body, foot, true);
      shell('<p class="state">Reading the payments. This can take a few seconds.</p>', '<button type="button" class="btn" data-close>Close</button>');
      try {
        if (!REVIEW) {
          const [pay, costs] = await Promise.all([api("/admin/payments?days=400"), api("/revenue/costs")]);
          REVIEW = { rev: revenueByMonth(pay.payments), costs: costs.rows || [] };
        }
        const last = m < thisMonth && m < ymAddMonths(thisMonth, -5) ? m : thisMonth;
        const list = []; for (let i = 5; i >= 0; i--) list.push(ymAddMonths(last, -i));
        const revenueByMonthShown = {}; list.forEach((k) => { revenueByMonthShown[k] = REVIEW.rev[k] || { social: 0, video: 0, studio: 0, agent: 0, pick: 0 }; });
        const open = BOOK.filter((v) => v.month === m && v.status === "sent" && v.method !== "direct_debit");
        const box = (a) => ({ n: a.length, p: sum(a) });
        reviewDraft = { month: m, thisMonth, months: list, revenueByMonth: revenueByMonthShown, costs: REVIEW.costs, open: { interBrand: box(open.filter((v) => v.route === "internal")), client: box(open.filter((v) => v.route !== "internal")), overdue: box(open.filter(isOver)) } };
        shell(reviewBody(reviewDraft, 780), '<button type="button" class="btn" data-close>Close</button><button type="button" class="btn" id="io-rv-dl">Download</button><button type="button" class="btn primary" id="io-rv-send">Send to Sam</button>');
      } catch (err) { shell(`<p class="state bad">${esc(err.message)}</p>`, '<button type="button" class="btn" data-close>Close</button>'); }
    }
    async function reviewPdf(btn) {
      const was = btn.textContent; btn.disabled = true; btn.textContent = "Building…";
      try {
        const res = await fetch(`${WORKER}/invoicing/month-review`, { method: "POST", headers: { "Content-Type": "application/json", Authorization: "Bearer " + (await authToken()) }, body: JSON.stringify({ action: "download", data: reviewDraft }) });
        if (!res.ok) { const b = await res.json().catch(() => ({})); throw new Error(b.error || "Couldn't build the PDF."); }
        const blob = await res.blob(), a = document.createElement("a");
        a.href = URL.createObjectURL(blob); a.download = `TMKE-month-end-review-${reviewDraft.month}.pdf`;
        document.body.appendChild(a); a.click(); a.remove(); setTimeout(() => URL.revokeObjectURL(a.href), 2000);
      } catch (err) { toast(err.message); }
      finally { btn.disabled = false; btn.textContent = was; }
    }

    // Who's doing what: every click on the month and its pop-outs.
    async function fullInvoice(id) { return (await api(`/invoicing/invoice?id=${encodeURIComponent(id)}`)).invoice; }
    document.addEventListener("click", async (e) => {
      const t = e.target; if (!t.closest) return;
      let b;
      if (!t.closest(".mo")) return;
      if (t.closest("[data-close]") || t.id === "io-scrim") { closePop(); return; }
      if ((b = t.closest("[data-kind]"))) { S.kind = b.dataset.kind; drawBook(); return; }
      if ((b = t.closest("[data-status]"))) { const st = b.dataset.status; S.status = S.status === st ? "" : st; drawBook(); return; }
      if (t.closest("#io-mend")) { openMonthEnd(); return; }
      if (t.closest("#io-mrev")) { openReview(); return; }
      if ((b = t.closest("#io-rv-dl"))) { reviewPdf(b); return; }
      if ((b = t.closest("#io-rv-send"))) {
        b.disabled = true;
        try { const r = await postJson("/invoicing/month-review", { action: "email", data: reviewDraft }); toast(`Sent to ${r.to}.`); } catch (err) { toast(err.message); }
        b.disabled = false; return;
      }
      if ((b = t.closest("[data-mesend]"))) {
        const test = b.dataset.mesend === "test"; b.disabled = true;
        try { const r = await postJson("/invoicing/month-end", { test }); toast(`Sent to ${r.to}.`); } catch (err) { toast(err.message); }
        b.disabled = false; return;
      }
      if ((b = t.closest("[data-note]"))) { e.stopPropagation(); openNote(b.dataset.note); return; }
      if ((b = t.closest("[data-savenote]"))) {
        const v = byId(b.dataset.savenote), note = $("io-note").value.trim(); b.disabled = true;
        try { await postJson("/invoicing/book/update", { id: v.id, note }); v.note = note; closePop(); toast(note ? "Saved. Accounts can see it too." : "Note removed."); drawBook(); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-email]"))) { openEmail(b.dataset.email); return; }
      if ((b = t.closest("[data-sendemail]"))) {
        const v = byId(b.dataset.sendemail); b.disabled = true;
        try { const r = await postJson("/invoicing/accounts-email", { id: v.id, subject: $("io-em-sub").value, body: $("io-em-body").value }); v.reminders = r.reminders; closePop(); toast(`Sent to ${r.to}. It's on the invoice's history.`); drawBook(); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-approve]"))) {
        b.disabled = true;
        try { const r = await postJson("/invoicing/approval/decide", { approval_id: b.dataset.approve }); toast(r.title || "Done."); closePop(); await loadBook(); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-send]"))) {
        b.disabled = true;
        try { const inv = await fullInvoice(b.dataset.send); closePop(); openEmailModal(inv, false); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-mark]"))) {
        b.disabled = true;
        try { await api("/invoicing/invoices", { method: "PATCH", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ id: b.dataset.mark, status: "paid" }) }); closePop(); toast("Marked paid."); await loadBook(); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-pdf]"))) {
        const tab = window.open("", "_blank"); b.disabled = true;
        try { const out = await api(`/invoicing/invoice-pdf?id=${encodeURIComponent(b.dataset.pdf)}`); if (tab) tab.location = out.url; else location = out.url; }
        catch (err) { if (tab) tab.close(); toast(err.message); }
        b.disabled = false; return;
      }
      if ((b = t.closest("[data-edit]"))) { const id = b.dataset.edit; closePop(); editInvoice(id); return; }
      if ((b = t.closest("[data-void]"))) {
        const reason = prompt("Void this invoice? It'll be removed and accounts + you will be emailed.\n\nReason for voiding:"); if (reason === null) return;
        b.disabled = true;
        try { await postJson("/invoicing/invoices/void", { id: b.dataset.void, reason }); closePop(); toast("Voided."); await loadBook(); } catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-del]"))) {
        if (!confirm("Delete this invoice? This permanently removes it and its PDF. It can't be undone.")) return;
        b.disabled = true;
        try { await api(`/invoicing/invoices?id=${encodeURIComponent(b.dataset.del)}`, { method: "DELETE" }); closePop(); toast("Deleted."); await loadBook(); } catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-card]"))) {
        const v = byId(b.dataset.card), val = b.dataset.v === "1";
        try { await postJson("/invoicing/book/update", { id: v.id, pay_by_card: val }); v.pay_by_card = val; openInv(v.id); } catch (err) { toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-numsave]"))) {
        const [rid, month] = b.dataset.numsave.split("|"), inp = document.querySelector(`[data-numfor="${rid}|${month}"]`);
        if (!inp || inp.value === "") { toast("Type the number first."); return; }
        b.disabled = true;
        try { await postJson("/invoicing/recurring/quantity", { recurring_id: rid, month, qty: Number(inp.value) }); toast("Saved. It goes out on its day with that number."); await loadBook(); }
        catch (err) { b.disabled = false; toast(err.message); }
        return;
      }
      if ((b = t.closest("[data-inv]")) && !t.closest("a")) { openInv(b.dataset.inv); return; }
    });
    document.addEventListener("change", async (e) => {
      const sel = e.target.closest && e.target.closest("[data-sector]"); if (!sel) return;
      const v = byId(sel.dataset.sector), val = sel.value;
      try { await postJson("/invoicing/book/update", { id: v.id, sector: val }); toast("Saved."); REVIEW = null; await loadBook(); openInv(v.id); } catch (err) { toast(err.message); }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") closePop();
      const r = e.target.closest && e.target.closest("tr[data-inv]"); if (r && e.key === "Enter" && e.target === r) openInv(r.dataset.inv);
    });
    document.addEventListener("mousemove", (e) => {
      const tg = e.target.closest && e.target.closest("[data-tip]"), tip = $("io-tip");
      if (!tg) { tip.hidden = true; return; }
      tip.textContent = tg.getAttribute("data-tip"); tip.hidden = false;
      tip.style.left = Math.min(e.clientX + 12, innerWidth - 170) + "px"; tip.style.top = (e.clientY - 34) + "px";
    });

    /* ---- The accounts portal's settings ---- */
    let PT = {};
    const ptTog = (id, on) => $(id).querySelectorAll("button").forEach((x) => x.setAttribute("aria-pressed", String((x.dataset.v === "1") === !!on)));
    function ptDraw(d) {
      PT = { enabled: d.enabled, emails_on: d.emails_on };
      $("pt-link").value = d.link; $("pt-code").value = d.passcode; $("pt-to").value = d.email_to;
      ptTog("pt-on", d.enabled); ptTog("pt-auto", d.emails_on);
      $("pt-last").textContent = d.last_opened_at ? `Last opened ${new Date(d.last_opened_at).toLocaleString("en-GB", { day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" })}.` : "Nobody has opened it yet.";
    }
    async function loadPortal() {
      const st = $("pt-state"), main = $("pt-main");
      st.hidden = false; st.className = "state"; st.textContent = "Loading…"; main.hidden = true;
      try { ptDraw(await api("/invoicing/portal-settings")); st.hidden = true; main.hidden = false; }
      catch (err) { st.className = "state bad"; st.textContent = err.message; }
    }
    $("pt-on").addEventListener("click", (e) => { const b = e.target.closest("[data-v]"); if (b) { PT.enabled = b.dataset.v === "1"; ptTog("pt-on", PT.enabled); } });
    $("pt-auto").addEventListener("click", (e) => { const b = e.target.closest("[data-v]"); if (b) { PT.emails_on = b.dataset.v === "1"; ptTog("pt-auto", PT.emails_on); } });
    $("pt-copy").addEventListener("click", async () => { try { await navigator.clipboard.writeText($("pt-link").value); toast("Link copied."); } catch (_) { $("pt-link").select(); toast("Press Cmd+C to copy it."); } });
    $("pt-gen").addEventListener("click", () => {
      const A = "ABCDEFGHJKMNPQRSTUVWXYZ23456789", r = crypto.getRandomValues(new Uint8Array(6));
      $("pt-code").value = [...r].map((x) => A[x % A.length]).join("");
      toast("That's the new one. Press Save to use it.");
    });
    $("pt-save").addEventListener("click", async (e) => {
      const b = e.currentTarget; b.disabled = true;
      try { ptDraw(await postJson("/invoicing/portal-settings", { enabled: PT.enabled, emails_on: PT.emails_on, email_to: $("pt-to").value, passcode: $("pt-code").value })); toast("Saved."); }
      catch (err) { toast(err.message); }
      b.disabled = false;
    });


    document.addEventListener("ash:ready", () => {
      initTemplate(); loadSettings(); loadRecipients(); loadRecurringOptions();
      // Deep link from the reminder: /admin/invoicing?tab=monthly
      const want = new URLSearchParams(location.search).get("tab");
      showPanel(PANEL_HEAD[want] ? want : "overview");
    });
  </script>
</AdminShell>
