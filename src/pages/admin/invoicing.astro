    // ---- Regular invoices (Dani, 10 Nov 2026) ----
    // Social media, Videography and Recurring, one month at a time. The data is
    // the Worker's monthly checklist, six months ending at the chosen month, so
    // each row also shows its last six months.
    const MC_FIRST = "2026-08";
    const ymAdd = (ym, k) => { const [y, m] = ym.split("-").map(Number); const d = new Date(Date.UTC(y, m - 1 + k, 1)); return d.toISOString().slice(0, 7); };
    const ymLabel = (ym) => new Date(ym + "-15T12:00:00Z").toLocaleDateString("en-GB", { month: "long", year: "numeric" });
    const ymShortLabel = (ym) => new Date(ym + "-15T12:00:00Z").toLocaleDateString("en-GB", { month: "short" });
    const nowYm = new Date().toLocaleDateString("en-CA", { timeZone: "Europe/London" }).slice(0, 7);
    const ord = (n) => n + (n % 10 === 1 && n !== 11 ? "st" : n % 10 === 2 && n !== 12 ? "nd" : n % 10 === 3 && n !== 13 ? "rd" : "th");
    const RI = { tab: "social", m: nowYm, show: "all", q: "", d: null };
    const RI_TABS = {
      social: ["Every active social media client, one month at a time. Their invoices go out on the 5th once Abbie has ticked them, or raise one here.", "Social media clients"],
      video: ["The month's shoots. This month also shows any earlier shoot still not invoiced or paid. A shoot is invoiced two days before it happens; open one to raise or send it in Videography.", "Shoots"],
      recurring: ["The brands' regular invoices, such as agent assets and the TPE Marketing Hub. Each is made from its own setup, so it goes with the right email and onto the accounts portal.", "Recurring invoices"],
    };
    async function loadMonthly() {
      const st = $("ri-state"), main = $("ri-main");
      st.hidden = false; st.className = "state"; st.textContent = "Loading…"; main.hidden = true;
      riDraw();
      try {
        const d = await api(`/invoicing/monthly?from=${ymAdd(RI.m, -5)}`);
        RI.d = d; st.hidden = true; main.hidden = false; riDraw();
        const notes = [];
        if (!d.recurringReady) notes.push("Recurring invoices need supabase/recurring_invoices.sql running once in Supabase.");
        (d.warnings || []).forEach((w) => notes.push("Couldn't read " + w));
        if (notes.length) { st.hidden = false; st.className = "state bad"; st.textContent = notes.join(" "); }
      } catch (err) { st.className = "state bad"; st.textContent = "Couldn't load regular invoices: " + err.message; }
    }
    const riSocialIds = () => new Set((RI.d.rows || []).filter((r) => r.kind === "social").map((r) => r.id));
    function riRows() {
      const rows = RI.d.rows || [];
      if (RI.tab === "social") return rows.filter((r) => r.kind === "social");
      // A social client's own monthly-invoice row shows under Social media, not twice.
      const soc = riSocialIds();
      return rows.filter((r) => r.kind === "recurring" && !(r.sub === "social" && r.lead_id && soc.has(r.lead_id)));
    }
    // What a row's month is: paid, sent, a draft, still to send, no invoice or not due.
    function riCell(r, ym) {
      const c = r.cells[ym], d = RI.d;
      const live = (c && c.invs || []).filter((v) => v.status !== "void");
      const pickInv = (st) => live.find((v) => v.status === st) || null;
      // Before August 2026, invoicing wasn't done here, so nothing shows as missing.
      if (!c || ym < MC_FIRST) return { k: "na", label: "Not due", chip: "plain" };
      if (c.skip) return { k: "skip", label: "No invoice", chip: "plain" };
      if (!c.due || ym > d.today) return { k: "na", label: "Not due", chip: "plain" };
      if (c.paid) return { k: "paid", label: "Paid", chip: "good", inv: pickInv("paid") };
      if (c.sent) return { k: "sent", label: "Sent", chip: "plain", inv: pickInv("sent") };
      if (c.draft) return { k: "draft", label: "Draft, not sent", chip: "wait", inv: pickInv("draft") };
      const dayN = (r.auto && r.auto.day_of_month) || 5;
      const late = ym < d.today || new Date().getDate() > dayN;
      return late ? { k: "miss", late: true, label: "Not invoiced", chip: "bad" } : { k: "miss", label: `Goes on the ${ord(dayN)}`, chip: "plain" };
    }
    const riAmount = (r, ym) => r.quantity_label ? (r.quantities && r.quantities[ym] != null ? (r.amount_pence || 0) * r.quantities[ym] : null) : r.amount_pence;
    const riRecId = (r) => r.kind === "recurring" ? r.id : r.recurring_id || null;
    function riDraw() {
      document.querySelectorAll("[data-ritab]").forEach((b) => { const on = b.dataset.ritab === RI.tab; b.classList.toggle("on", on); b.setAttribute("aria-selected", String(on)); });
      $("ri-sub").textContent = RI_TABS[RI.tab][0]; $("ri-strip").textContent = RI_TABS[RI.tab][1];
      $("ri-add").hidden = RI.tab !== "recurring";

      $("ri-month").textContent = ymLabel(RI.m);
      $("ri-prev").disabled = RI.m <= MC_FIRST; $("ri-next").disabled = RI.m >= nowYm;
      if (!RI.d) return;
      if (RI.tab === "video") return riDrawVideo();
      const m = RI.m;
      const rows = riRows().map((r) => ({ r, c: riCell(r, m) })).filter((x) => RI.tab === "recurring" || x.c.k !== "na");
      const due = rows.filter((x) => !["na", "skip"].includes(x.c.k));
      const sent = due.filter((x) => ["sent", "paid"].includes(x.c.k)), paid = due.filter((x) => x.c.k === "paid"), toSend = due.filter((x) => (x.c.k === "miss" && x.c.late) || x.c.k === "draft");
      const owed = sent.filter((x) => x.c.k === "sent").reduce((t, x) => t + (riAmount(x.r, m) || 0), 0);
      $("ri-figs").innerHTML = [["lin", due.length, "Due this month"], ["lin", sent.length, "Sent"], ["lin", paid.length, "Paid"], ["lin", toSend.length, "To invoice"], ["dark", gb(owed), "Waiting on payment, net"]]
        .map(([k, b, s]) => `<div class="fig static ${k}"><b>${b}</b><span>${s}</span></div>`).join("");
      const CH = [["all", "All", rows.length], ["send", "To invoice", toSend.length], ["owed", "Waiting on payment", sent.length - paid.length], ["paid", "Paid", paid.length]];
      $("ri-chips").innerHTML = CH.map(([k, l, n]) => `<button type="button" data-rishow="${k}" aria-pressed="${RI.show === k}">${l} <i>${n}</i></button>`).join("");
      const q = RI.q;
      const shown = rows.filter((x) => (RI.show === "all" || (RI.show === "send" && ((x.c.k === "miss" && x.c.late) || x.c.k === "draft")) || (RI.show === "owed" && x.c.k === "sent") || (RI.show === "paid" && x.c.k === "paid"))
        && (!q || [x.r.client, x.r.contact, x.r.payer, x.r.match_email, x.c.inv && x.c.inv.number].join(" ").toLowerCase().includes(q)));
      $("ri-count").textContent = `${shown.length} of ${rows.length}`;
      const hist = (r) => `<span class="ri-hist">${RI.d.months.map((ym) => { const c = riCell(r, ym); return `<i class="${c.k === "na" ? "" : c.k}${ym === m ? " cur" : ""}" title="${esc(ymLabel(ym))}: ${esc(c.label)}${c.inv ? " (" + esc(c.inv.number) + ")" : ""}"></i>`; }).join("")}</span>`;
      const act = (r, c) => {
        const rec = riRecId(r);
        if (c.k === "miss") return (rec ? `<button type="button" class="ri-btn go" data-riraise="${esc(r.id)}">Raise</button>` : `<a class="ri-btn" href="/admin/social?lead=${encodeURIComponent(r.id)}" title="Their monthly invoice isn't set up yet">Set up</a>`) + (rec ? `<button type="button" class="ri-btn" data-rialloc="${esc(r.id)}">Allocate</button>` : "");
        if (c.k === "draft") return `<button type="button" class="ri-btn go" data-risend="${esc(r.id)}">Send</button>`;
        if (c.inv) return `<button type="button" class="ri-btn" data-riview="${esc(c.inv.id)}">View</button>`;
        if (RI.tab === "recurring" && c.k === "na") return `<button type="button" class="ri-btn" data-riraise="${esc(r.id)}">Raise</button>`;
        return "";
      };
      const head = RI.tab === "social"
        ? `<thead><tr><th>Client</th><th>Managed by</th><th class="num">Monthly, net</th><th>Invoice</th><th>Status</th><th>Last six months</th><th></th></tr></thead>`
        : `<thead><tr><th>Invoice</th><th>Goes out</th><th class="num">Amount, net</th><th>Invoice</th><th>Status</th><th>Last six months</th><th></th></tr></thead>`;
      const body = shown.map(({ r, c }) => {
        const noteIc = `<button type="button" class="ic${(r.cells[m] && r.cells[m].note) ? " has" : ""}" data-rinote="${esc(r.id)}" aria-label="Notes and history" title="Notes and history">${ICON_NOTE}</button>`;
        const who = RI.tab === "social"
          ? `<td class="two">${esc(r.client)}<small>${esc([r.contact !== r.client ? r.contact : "", r.note].filter(Boolean).join(" · "))}</small></td><td class="tx">${esc(r.manager || "")}</td><td class="num">${r.amount_pence != null ? gb(r.amount_pence) : "–"}</td>`
          : (() => {
              const a = r.auto || {}, amt = riAmount(r, m);
              const goes = a.auto_send && a.day_of_month ? `The ${ord(a.day_of_month)}, by itself` : a.day_of_month ? `The ${ord(a.day_of_month)}, raised here` : "Raised here";
              const amount = r.quantity_label ? (amt != null ? `${gb(amt)}<small>${gb(r.amount_pence || 0)} × ${r.quantities[m]}</small>` : `–<small>${gb(r.amount_pence || 0)} each</small>`) : (r.amount_pence != null ? gb(r.amount_pence) : "–");
              return `<td class="two">${esc(r.client)}<small>${esc(a.bill_to_name || r.contact || r.match_email || "")}${r.brand ? ", on the accounts portal" : ""}</small></td><td class="two">${esc(goes)}${r.quantity_label ? `<small>Needs the ${esc(String(r.quantity_label).toLowerCase())}</small>` : ""}</td><td class="num two">${amount}</td>`;
            })();
        return `<tr class="click" data-rirow="${esc(r.id)}">${who}<td class="tx">${c.inv ? esc(c.inv.number) : "—"}</td><td><span class="chip ${c.chip}">${esc(c.label)}</span></td><td>${hist(r)}</td><td><div class="ri-acts">${act(r, c)}${noteIc}</div></td></tr>`;
      }).join("");
      $("ri-tbl").innerHTML = head + `<tbody>${body || `<tr><td colspan="7" class="tx">Nothing here for ${esc(ymLabel(m))}.</td></tr>`}</tbody>`;
      $("ri-key").innerHTML = `<span><span class="ri-hist"><i class="paid"></i></span>Paid</span><span><span class="ri-hist"><i class="sent"></i></span>Sent</span><span><span class="ri-hist"><i class="draft"></i></span>Draft</span><span><span class="ri-hist"><i class="miss"></i></span>Due, not sent</span><span><span class="ri-hist"><i class="skip"></i></span>No invoice that month</span><span><span class="ri-hist"><i></i></span>Not due</span>`;
    }
    const SHOOT_STATUS = {
      late: ["bad", "Not invoiced"], with_jack: ["wait", "With Jack to approve"], not_due: ["plain", "Not due yet"], sent: ["plain", "Sent"],
      payment_overdue: ["bad", "Sent, payment overdue"], paid: ["good", "Paid"], package: ["plain", "Covered by social package"],
    };
    function riDrawVideo() {
      const list = RI.d.shoots || [];
      const dd = (x) => x ? new Date(String(x).slice(0, 10) + "T12:00:00Z").toLocaleDateString("en-GB", { weekday: "short", day: "numeric", month: "short" }) : "—";
      const owed = list.filter((x) => ["sent", "payment_overdue"].includes(x.status)).reduce((t, x) => t + (x.amount_pence || 0), 0);
      $("ri-figs").innerHTML = [["lin", list.length, "Shoots"], ["lin", list.filter((x) => ["sent", "payment_overdue", "paid"].includes(x.status)).length, "Invoiced"], ["lin", list.filter((x) => x.status === "paid").length, "Paid"], ["lin", list.filter((x) => ["late", "with_jack"].includes(x.status)).length, "To invoice"], ["dark", gb(owed), "Waiting on payment, net"]]
        .map(([k, b, s]) => `<div class="fig static ${k}"><b>${b}</b><span>${s}</span></div>`).join("");
      // To invoice: due now and not sent (not raised, or with Jack). Not due yet stays out (Dani, 10 Nov).
      const GROUP = { send: ["late", "with_jack"], owed: ["sent", "payment_overdue"], paid: ["paid"] };
      const CH = [["all", "All", list.length], ["send", "To invoice", list.filter((x) => GROUP.send.includes(x.status)).length], ["owed", "Waiting on payment", list.filter((x) => GROUP.owed.includes(x.status)).length], ["paid", "Paid", list.filter((x) => x.status === "paid").length]];
      $("ri-chips").innerHTML = CH.map(([k, l, n]) => `<button type="button" data-rishow="${k}" aria-pressed="${RI.show === k}">${l} <i>${n}</i></button>`).join("");
      const q = RI.q;
      const shown = list.filter((x) => (RI.show === "all" || (GROUP[RI.show] || []).includes(x.status)) && (!q || [x.client, x.company, x.service, (x.numbers || []).join(" ")].join(" ").toLowerCase().includes(q)));
