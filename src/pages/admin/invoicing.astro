    .invrow-tools > button.inv-ico { width: 32px; height: 30px; padding: 0; display: inline-flex; align-items: center; justify-content: center; }
    .inv-ico svg { width: 15px; height: 15px; display: block; }
    .invrow .inv-ico.is-busy { opacity: 0.5; cursor: progress; }

    /* The filter bar. */
