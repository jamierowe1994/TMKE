      }).join("") || `<tr><td colspan="7" class="tx">${RI.m < nowYm ? `No shoots in ${esc(ymLabel(RI.m))}.` : "No shoots this month, and nothing earlier waiting on an invoice or payment."}</td></tr>`}</tbody>`;
