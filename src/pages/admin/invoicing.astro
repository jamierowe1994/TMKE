    .mc-tbl { width: 100%; min-width: 980px; border-collapse: collapse; font-family: var(--sans); font-size: 13px; }
    .mc-tbl th { font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,29,34,0.55); padding: 6px 8px; text-align: center; white-space: nowrap; }
    .mc-tbl thead tr:first-child th { border-bottom: 0; padding-bottom: 2px; }
