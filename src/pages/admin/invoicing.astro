    .ci-tpl-opt.is-active { background: var(--english-violet); color: #fff; }
    .cim-pay { font-family: var(--sans); font-size: 12px; line-height: 1.5; color: rgba(28,29,34,0.55); margin: 0 0 12px; padding: 9px 12px; border-radius: 7px; background: rgba(28,29,34,0.05); }
    .cim-pay.is-on { color: var(--english-violet); background: rgba(var(--violet-rgb), 0.09); font-weight: 700; }
    .ci-pay-hint { font-family: var(--sans); font-size: 11.5px; line-height: 1.45; color: rgba(28,29,34,0.5); }
    .ci-item { display: grid; grid-template-columns: 1fr 130px 34px; gap: 8px; align-items: center; margin-bottom: 8px; }
    .ci-item input { font-family: var(--sans); font-size: 14px; padding: 9px 11px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; background: #fff; color: var(--ink); }
    .ci-item input:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
