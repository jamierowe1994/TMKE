  </style>

  <p class="gadm-toast" id="g-toast" hidden></p>

  <script>
    import { supabase, isConfigured } from "../../lib/supabase.js";
    import { markSubheads } from "../../lib/guide-subheads.js";
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { GUIDE_TOPIC_LABEL, GUIDE_KIND_LABEL } from "../../data/guide-topics.js";
    import { TRAINING_GUIDES, PRINT_GUIDES, CALENDAR_GUIDES } from "../../data/training-guides.js";
    import { CONTENT_IDEAS_GUIDE } from "../../data/content-ideas-guide.js";
    import { PRINT_MATERIAL_GUIDES } from "../../data/print-materials.js";
    import { copyRowFor } from "../../lib/guide-merge.js";
    /* The courses made with Claude live in the site's code, not the guides
       table, so this list never showed them (Danielle, 20 Nov: "make sure the
       ones we've designed here via Claude, you can also view them from the
       admin center"). They are listed in their own group, read only, with the
       link that opens each as a member sees it. Their words change in code. */
    const BUILT_IN = [...TRAINING_GUIDES, ...CALENDAR_GUIDES, ...PRINT_GUIDES, ...PRINT_MATERIAL_GUIDES, CONTENT_IDEAS_GUIDE]
      .filter((g, i, a) => g && a.findIndex((x) => x.slug === g.slug) === i);
    // The print materials guides are their own A4 pages, not lessons: nothing to copy.
    const canCopy = (g) => !g.href;
    const AUDIENCE = { public: "Everyone (public)", members: "All members", teg: "The Experts Group agents (not Fine & Country)" };
    const builtHref = (g, part) => g.href || `/account/guides/read?g=${encodeURIComponent(g.slug)}${part ? `&p=${part}` : ""}`;
    const builtWhere = (g) => g.held ? "Held off Learn until it launches; opens by its link"
      : (g.topic === "getting-started" ? "Learn, Getting Started" : "Learn, " + GUIDE_TOPIC_LABEL(g.topic));

    const $ = (s) => document.querySelector(s);
    const DEV = import.meta.env.DEV;
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;" }[c]));
    const slugify = (s) => String(s || "").toLowerCase().trim().replace(/[^a-z0-9\s-]/g, "").replace(/\s+/g, "-").replace(/-+/g, "-").slice(0, 80);
    function toast(m){ const t=$("#g-toast"); t.textContent=m; t.hidden=false; clearTimeout(toast._t); toast._t=setTimeout(()=>t.hidden=true,Math.max(2400,String(m).length*70)); }

    let list = [];
    let cur = null;            // current guide id (null = new/unsaved)
    import { WALK_LIST } from "../../data/walkthroughs.js";
    let lessons = [];          // [{ title, body_html, video_url?, walk? }]

    /* ---------- lessons: a list on the course, each opening as its own page ---------- */
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const plainTitle = (t) => String(t || "").replace(/<[^>]+>/g, "").trim();
    let pageAt = -1;            // the lesson open as a page, or -1 for the course
    function renderLessons() {
      const wrap = $("#g-lessons");
      wrap.innerHTML = lessons.map((l, i) => `
        <li data-open="${i}" title="Open this lesson">
          <span class="gle-l-t${plainTitle(l.title) ? "" : " is-empty"}">${esc(plainTitle(l.title) || "Untitled lesson")}</span>
          <button type="button" class="gadm-mini" data-up="${i}" ${i===0?"disabled":""} title="Move up">↑</button>
          <button type="button" class="gadm-mini" data-down="${i}" ${i===lessons.length-1?"disabled":""} title="Move down">↓</button>
          <span class="gadm-btn gle-l-open">Open</span>
        </li>`).join("");
      wrap.querySelectorAll("[data-open]").forEach((li) => li.addEventListener("click", (e) => { if (e.target.closest("[data-up],[data-down]")) return; openPage(+li.dataset.open); }));
      wrap.querySelectorAll("[data-up]").forEach((b) => b.addEventListener("click", () => { const i=+b.dataset.up; [lessons[i-1],lessons[i]]=[lessons[i],lessons[i-1]]; renderLessons(); markDirty(); }));
      wrap.querySelectorAll("[data-down]").forEach((b) => b.addEventListener("click", () => { const i=+b.dataset.down; [lessons[i+1],lessons[i]]=[lessons[i],lessons[i+1]]; renderLessons(); markDirty(); }));
    }
    $("#g-add-lesson").addEventListener("click", () => { lessons.push({ title: "", body_html: "<p></p>" }); renderLessons(); markDirty(); openPage(lessons.length - 1); });

    // The page: the lesson's HTML drawn with the reader's own styles, every
    // run of words editable where it sits. Only the words: an element is
    // editable when it holds text and nothing block-shaped, so a card, a
    // picture or a layout can't be broken by a stray Backspace.
    const BLOCKS = "div,figure,img,ul,ol,p,h1,h2,h3,h4,h5,h6,blockquote,table,section,video,iframe,svg,figcaption,li,button";
    function makeEditable(root) {
      markSubheads(root, { divsToP: true });
      root.querySelectorAll("*").forEach((el) => {
        if (el.closest('[contenteditable="true"]')) return;
        if (/^(IMG|SVG|VIDEO|IFRAME|BR|HR)$/i.test(el.tagName)) return;
        const ownText = [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim());
        // An empty paragraph, heading or list item is a place to type, too.
        const emptyLine = !el.children.length && !el.textContent.trim() && /^(P|H[1-6]|LI|BLOCKQUOTE|FIGCAPTION)$/.test(el.tagName);
        if (!(ownText || emptyLine) || el.querySelector(BLOCKS)) return;
        el.setAttribute("contenteditable", "true");
        el.setAttribute("spellcheck", "true");
      });
    }
    // Back to HTML without the editing marks.
    function pageHtml() {
      const c = $("#g-page-body").cloneNode(true);
      c.querySelectorAll("[contenteditable]").forEach((el) => { el.removeAttribute("contenteditable"); el.removeAttribute("spellcheck"); });
      c.querySelectorAll(".gr-subhead").forEach((el) => { el.classList.remove("gr-subhead"); if (!el.getAttribute("class")) el.removeAttribute("class"); });
      c.querySelectorAll(".gle-sel").forEach((el) => { el.classList.remove("gle-sel"); if (!el.getAttribute("class")) el.removeAttribute("class"); });
      c.querySelectorAll('[style=""]').forEach((el) => el.removeAttribute("style"));
      return c.innerHTML;
    }
    function drawPageBody() {
      const body = $("#g-page-body");
      // Taking a focused box off the page fires its blur; the tidy-up below must not run on a half-drawn page.
      quiet(() => { body.innerHTML = (lessons[pageAt].body_html || "").trim() || "<p></p>"; });
      makeEditable(body);
      sel = null; curBox = null; updateTools();
    }
    function openPage(i) {
      if (i < 0 || i >= lessons.length) return;
      pageAt = i;
      const l = lessons[i], n = lessons.length;
      $("#g-course").hidden = true; $("#g-page").hidden = false;
      $("#g-page-no").textContent = `Lesson ${i + 1} of ${n}`;
      $("#g-page-part").textContent = $("#g-kind").value === "course" ? `Part ${i + 1} of ${n}` : "";
      $("#g-page-part").hidden = $("#g-kind").value !== "course";
      $("#g-page-title").value = plainTitle(l.title);
      $("#g-page-video").value = l.video_url || "";
      $("#g-page-walk").value = l.walk || "";
      $("#g-page-prev").disabled = i === 0; $("#g-page-next").disabled = i === n - 1;
      $("#g-page-html").value = l.body_html || "";
      undo = [];
      drawPageBody(); walkNote();
      const slug = $("#g-slug").value.trim();
      $("#g-open").href = slug ? `/account/guides/read?g=${encodeURIComponent(slug)}&p=${i + 1}` : "#";
      $("#g-edit").scrollIntoView({ block: "start" });
    }
    function closePage() {
      pageAt = -1; $("#g-page").hidden = true; $("#g-course").hidden = false; renderLessons(); setOpenLink();
    }
    function walkNote() {
      const id = $("#g-page-walk").value, w = WALK_LIST.find((x) => x.id === id);
      $("#g-page-walknote").hidden = !w;
      $("#g-page-walknote").textContent = w ? `The "Show me" box for ${w.title} sits here.` : "";
    }
    WALK_LIST.forEach((w) => { const o = document.createElement("option"); o.value = w.id; o.textContent = w.title; $("#g-page-walk").appendChild(o); });
    function syncPage() { if (pageAt < 0) return; markSubheads($("#g-page-body")); lessons[pageAt].body_html = pageHtml(); $("#g-page-html").value = lessons[pageAt].body_html; markDirty(); }
    $("#g-page-body").addEventListener("input", syncPage);
    // Links and buttons in the lesson are words to edit here, not places to go.
    $("#g-page-body").addEventListener("click", (e) => { if (e.target.closest("a,button")) e.preventDefault(); });

    // Emptied boxes go, and Backspace at the start of a paragraph joins it to
    // the one above (a line break, no paragraph gap; Backspace again puts it
    // on the same line). The page always keeps one box to type in.
    const boxes = () => [...$("#g-page-body").querySelectorAll('[contenteditable="true"]')];
    const isBlank = (el) => !el.textContent.trim() && !el.querySelector("img,video,iframe,svg");
    function caretAtStart(el) {
      const s = getSelection();
      if (!s.rangeCount || !s.isCollapsed) return false;
      const r = s.getRangeAt(0), pre = document.createRange();
      pre.selectNodeContents(el); pre.setEnd(r.startContainer, r.startOffset);
      const f = pre.cloneContents();
      return !f.textContent.length && !f.querySelector("br,img");
    }
    function caretTo(el, atEnd) {
      el.focus();
      const r = document.createRange(); r.selectNodeContents(el); r.collapse(!atEnd);
      const s = getSelection(); s.removeAllRanges(); s.addRange(r);
    }
    // Takes a wrapper with it when the box was all it held (a card left with nothing in it).
    function removeBox(el) {
      let n = el;
      while (n.parentElement && n.parentElement.id !== "g-page-body" && n.parentElement.children.length === 1 && isBlank(n.parentElement)) n = n.parentElement;
      n.remove();
    }
    let redrawing = false;
    function quiet(fn) { redrawing = true; try { fn(); } finally { redrawing = false; } }
    $("#g-page-body").addEventListener("focusout", (e) => {
      if (redrawing) return;
      const el = e.target.closest && e.target.closest('[contenteditable="true"]');
      if (!el || !el.isConnected || !isBlank(el) || boxes().length < 2) return;
      removeBox(el); syncPage(); updateTools();
    });
    $("#g-page-body").addEventListener("keydown", (e) => {
      const el = e.target.closest('[contenteditable="true"]');
      if (!el) return;
      if (e.key === "Enter") { e.preventDefault(); document.execCommand("insertLineBreak"); return; }
      if (e.key !== "Backspace" || !caretAtStart(el)) return;
      const all = boxes(), i = all.indexOf(el), prev = all[i - 1];
      if (isBlank(el)) {
        if (all.length < 2) return;
        e.preventDefault();
        if (prev) caretTo(prev, true); else if (all[i + 1]) caretTo(all[i + 1], false);
        removeBox(el);
        syncPage(); updateTools(); return;
      }
      // Only paragraph into paragraph (or heading into the same heading), side by side.
      if (!prev || el.previousElementSibling !== prev || prev.tagName !== el.tagName) return;
      e.preventDefault();
      if (prev.lastChild && prev.lastChild.nodeName === "BR") prev.lastChild.remove();
      const br = document.createElement("br"), first = el.firstChild;
      prev.appendChild(br);
      while (el.firstChild) prev.appendChild(el.firstChild);
      prev.focus(); // before the box goes, or focus falls to the page
      el.remove();
      // Caret inside the moved words, so a second Backspace takes the line break.
      const r = document.createRange();
      if (first && first.nodeType === 3) r.setStart(first, 0); else r.setStartAfter(br);
      r.collapse(true);
      const s = getSelection(); s.removeAllRanges(); s.addRange(r);
      syncPage();
    });
    // Pasted words come in plain, so nothing from Word or a web page sneaks in.
    $("#g-page-body").addEventListener("paste", (e) => {
      if (!e.target.closest('[contenteditable="true"]')) return;
      e.preventDefault(); document.execCommand("insertText", false, (e.clipboardData || window.clipboardData).getData("text/plain"));
    });

    // ---- The lesson's tools (Danielle, 23 Nov): move, copy and delete boxes,
    // format words, add text, pictures and sets of boxes. Everything builds on
    // the lesson's own blocks and classes, so the formatting stays as it is.
    // A "box" is the nearest thing that can be moved: a card in a set, an item
    // in a list, or a whole block of the page. ----
    const SETS = ".bk-cards,.bk-formats,.ci-pillars,.ci-grid,.bk-tools,ul,ol";
    // Boxes that can take a colour (src/styles/guide-reader.css, .bk-tone--*).
    const TONEABLE = ".bk-card,.bk-provide,.bk-panel,.bk-cta,.bk-check > li";
    const TONES = ["linen", "stone", "wine"];
    function toneTargets() {
      if (!sel) return [];
      if (sel.matches(TONEABLE)) return [sel];
      const inside = [...sel.querySelectorAll(TONEABLE)];
      if (inside.length) return inside;
      const up = sel.closest(TONEABLE); return up ? [up] : [];
    }
    const toneOf = (el) => TONES.find((t) => el.classList.contains("bk-tone--" + t)) || "";
    const bodyEl = $("#g-page-body"), tools = $("#g-tools");
    let sel = null, curBox = null, undo = [];
    function unitOf(node) {
      const el = node && (node.nodeType === 1 ? node : node.parentElement);
      if (!el || el === bodyEl || !bodyEl.contains(el)) return null;
      let top = el; while (top.parentElement !== bodyEl) top = top.parentElement;
      for (let n = el; n !== top; n = n.parentElement) if (n.parentElement.matches(SETS)) return n;
      return top;
    }
    const outerOf = (u) => (!u || u.parentElement === bodyEl ? null : unitOf(u.parentElement));
    const isPic = (u) => !!u && (u.tagName === "IMG" || (u.tagName === "FIGURE" && !!u.querySelector("img") && !u.textContent.trim()));
    function kindName(u) {
      if (!u) return "Box";
      if (isPic(u)) return "Picture";
      if (u.matches(".bk-cards,.bk-formats,.ci-pillars,.ci-grid,.bk-tools,.bk-open-grid")) return "Set of boxes";
      if (u.matches(".bk-check")) return "Checklist";
      if (u.matches(".bk-check > li")) return "Checklist item";
      if (u.tagName === "LI") return "List item";
      if (/^(UL|OL)$/.test(u.tagName)) return "List";
      if (u.parentElement !== bodyEl || u.matches(".bk-panel,.bk-card,.bk-provide,.bk-eg")) return "Box";
      return "Text";
    }
    // What the Words buttons act on: the box the caret is in, or every text box in the selection.
    function wordTargets() {
      if (!sel) return [];
      if (curBox && curBox.isConnected && sel.contains(curBox)) return [curBox];
      return sel.matches('[contenteditable="true"]') ? [sel] : [...sel.querySelectorAll('[contenteditable="true"]')];
    }
    function updateTools() {
      if (sel && !sel.isConnected) sel = null;
      if (curBox && !curBox.isConnected) curBox = null;
      const sideways = !!sel && sel.parentElement !== bodyEl && !/^(UL|OL)$/.test(sel.parentElement.tagName);
      const back = tools.querySelector('[data-move="-1"]'), on = tools.querySelector('[data-move="1"]');
      back.innerHTML = sideways ? "&larr;" : "&uarr;"; back.title = sideways ? "Move left" : "Move up";
      on.innerHTML = sideways ? "&rarr;" : "&darr;"; on.title = sideways ? "Move right" : "Move down";
      back.disabled = !sel || !sel.previousElementSibling; on.disabled = !sel || !sel.nextElementSibling;
      tools.querySelector("[data-dup]").disabled = !sel; tools.querySelector("[data-del]").disabled = !sel;
      tools.querySelector("[data-outer]").disabled = !outerOf(sel);
      const words = wordTargets().length > 0, pic = isPic(sel);
      tools.querySelectorAll("[data-cmd]").forEach((b) => { b.disabled = !curBox; });
      tools.querySelectorAll("[data-size],[data-align]").forEach((b) => { b.disabled = !(words || pic); });
      const tt = toneTargets(), tone = tt.length && tt.every((el) => toneOf(el) === toneOf(tt[0])) ? toneOf(tt[0]) : null;
      tools.querySelectorAll("[data-tone]").forEach((b) => { b.disabled = !tt.length; b.classList.toggle("is-on", tt.length > 0 && b.dataset.tone === tone); });
      tools.querySelector("[data-undo]").disabled = !undo.length;
      $("#g-tool-kind").textContent = sel ? "Selected: " + kindName(sel).toLowerCase() : "Click a box to select it";
    }
    function select(u) {
      if (sel && sel !== u) { sel.classList.remove("gle-sel"); if (!sel.getAttribute("class")) sel.removeAttribute("class"); }
      sel = u || null;
      if (sel) sel.classList.add("gle-sel");
      updateTools();
    }
    const snap = () => { undo.push(pageHtml()); if (undo.length > 40) undo.shift(); };
    const settle = () => { makeEditable(bodyEl); syncPage(); updateTools(); };
    function tidyStyle(el) { if (!el.getAttribute("style")) el.removeAttribute("style"); }
    function selectWords(el) { el.focus(); const r = document.createRange(); r.selectNodeContents(el); const s = getSelection(); s.removeAllRanges(); s.addRange(r); }
    // New blocks go in under the selected one (under its whole set, if it is in one), or at the end.
    function insertBlock(html) {
      snap();
      const t = document.createElement("template"); t.innerHTML = html.trim();
      const node = t.content.firstElementChild;
      let top = sel; while (top && top.parentElement !== bodyEl) top = top.parentElement;
      if (top) top.after(node); else bodyEl.appendChild(node);
      settle(); select(node); node.scrollIntoView({ block: "center", behavior: "smooth" });
      return node;
    }
    const WORD_SIZES = [12, 13, 0, 16, 18, 22, 28], PIC_SIZES = [33, 50, 66, 100];
    function resize(step) {
      snap();
      if (isPic(sel)) {
        const at = PIC_SIZES.indexOf(parseInt(sel.style.width, 10) || 100), to = PIC_SIZES[Math.max(0, Math.min(PIC_SIZES.length - 1, (at < 0 ? 3 : at) + step))];
        sel.style.width = to === 100 ? "" : to + "%"; tidyStyle(sel);
      } else wordTargets().forEach((el) => {
        const at = WORD_SIZES.indexOf(parseInt(el.style.fontSize, 10) || 0), to = WORD_SIZES[Math.max(0, Math.min(WORD_SIZES.length - 1, (at < 0 ? 2 : at) + step))];
        el.style.fontSize = to ? to + "px" : ""; tidyStyle(el);
      });
      syncPage(); updateTools();
    }
    function align(side) {
      snap();
      if (isPic(sel)) {
        sel.style.marginLeft = side === "left" ? "" : "auto"; sel.style.marginRight = side === "right" ? "0" : side === "center" ? "auto" : ""; tidyStyle(sel);
      } else wordTargets().forEach((el) => { el.style.textAlign = side === "left" ? "" : side; tidyStyle(el); });
      syncPage(); updateTools();
    }
    const BOXES = (n) => `<div class="bk-cards bk-cards--${n}">${'<div class="bk-card"><strong>Title</strong><span>Write here.</span></div>'.repeat(n)}</div>`;
    async function addPicture(file) {
      if (!WORKER) { toast("Uploads need the site's Worker address."); return; }
      toast("Uploading…");
      try {
        const { data: { session: s } } = await supabase.auth.getSession();
        const fd = new FormData(); fd.append("file", file);
        const res = await fetch(`${WORKER}/admin/upload`, { method: "POST", headers: s?.access_token ? { Authorization: `Bearer ${s.access_token}` } : {}, body: fd });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.url) { toast("Upload failed: " + (j.error || ("HTTP " + res.status))); return; }
        if (pageAt < 0) return;
        insertBlock(`<figure class="gr-pic"><img src="${esc(j.url)}" alt="" loading="lazy"></figure>`);
        toast("Picture added. A− and A+ change its size.");
      } catch (err) { toast("Upload failed: " + (err.message || err)); }
    }
    $("#g-img-file").addEventListener("change", (e) => { const file = e.target.files?.[0]; e.target.value = ""; if (file) addPicture(file); });
    // Pressing a tool mustn't take the caret out of the words.
    tools.addEventListener("mousedown", (e) => { if (e.target.closest("button")) e.preventDefault(); });
    tools.addEventListener("click", (e) => {
      const b = e.target.closest("button"); if (!b || b.disabled || pageAt < 0) return;
      const d = b.dataset;
      if (d.cmd) { if (curBox) { curBox.focus(); document.execCommand(d.cmd); syncPage(); } return; }
      if (d.size) { resize(+d.size); return; }
      if (d.align) { align(d.align); return; }
      if ("tone" in d) {
        snap();
        toneTargets().forEach((el) => { TONES.forEach((t) => el.classList.remove("bk-tone--" + t)); if (d.tone) el.classList.add("bk-tone--" + d.tone); if (!el.getAttribute("class")) el.removeAttribute("class"); });
        syncPage(); updateTools(); return;
      }
      if (d.move) {
        const sib = +d.move < 0 ? sel.previousElementSibling : sel.nextElementSibling; if (!sib) return;
        const had = curBox && sel.contains(curBox) ? curBox : null;
        snap(); quiet(() => { if (+d.move < 0) sib.before(sel); else sib.after(sel); });
        settle(); sel.scrollIntoView({ block: "nearest" }); if (had) had.focus({ preventScroll: true });
        return;
      }
      if ("dup" in d) { snap(); const c = sel.cloneNode(true); c.classList.remove("gle-sel"); c.removeAttribute("id"); c.querySelectorAll("[id]").forEach((x) => x.removeAttribute("id")); sel.after(c); settle(); select(c); return; }
      if ("del" in d) {
        snap();
        let n = sel; while (n.parentElement !== bodyEl && n.parentElement.children.length === 1) n = n.parentElement;
        quiet(() => n.remove()); sel = null; if (!bodyEl.children.length) bodyEl.innerHTML = "<p></p>";
        settle(); toast("Deleted. Undo puts it back."); return;
      }
      if ("outer" in d) { const o = outerOf(sel); if (o) { curBox = null; if (document.activeElement && bodyEl.contains(document.activeElement)) document.activeElement.blur(); select(o); } return; }
      if ("undo" in d) { const html = undo.pop(); if (html == null) return; lessons[pageAt].body_html = html; $("#g-page-html").value = html; drawPageBody(); markDirty(); return; }
      if (d.add === "text") { const n = insertBlock("<p></p>"); n.focus(); return; }
      if (d.add === "heading") { const n = insertBlock("<p><strong>Heading</strong></p>"); selectWords(n.querySelector("strong")); return; }
      if (d.add === "image") { $("#g-img-file").click(); return; }
      if (d.add === "check") { const n = insertBlock(`<ol class="bk-check">${'<li><button type="button" class="bk-check-box" aria-label="Tick when done"></button><div class="bk-check-b"><strong>Something to do</strong><p>What it involves.</p></div></li>'.repeat(3)}</ol>`); selectWords(n.querySelector("strong")); return; }
      if (d.add === "2" || d.add === "3") { const n = insertBlock(BOXES(+d.add)); selectWords(n.querySelector("strong")); return; }
    });
    bodyEl.addEventListener("click", (e) => select(unitOf(e.target)));
    bodyEl.addEventListener("focusin", (e) => { const b = e.target.closest && e.target.closest('[contenteditable="true"]'); if (b) { curBox = b; if (!sel || !sel.contains(b)) select(unitOf(b)); else updateTools(); } });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && pageAt >= 0 && sel) { select(null); } });
    updateTools();

    $("#g-page-html").addEventListener("change", () => { if (pageAt < 0) return; lessons[pageAt].body_html = $("#g-page-html").value; drawPageBody(); markDirty(); });
    $("#g-page-title").addEventListener("input", () => { if (pageAt < 0) return; lessons[pageAt].title = $("#g-page-title").value; markDirty(); });
    $("#g-page-video").addEventListener("input", () => { if (pageAt < 0) return; lessons[pageAt].video_url = $("#g-page-video").value; markDirty(); });
    $("#g-page-walk").addEventListener("change", () => { if (pageAt < 0) return; lessons[pageAt].walk = $("#g-page-walk").value; walkNote(); markDirty(); });
    $("#g-page-back").addEventListener("click", closePage);
    $("#g-page-prev").addEventListener("click", () => openPage(pageAt - 1));
    $("#g-page-next").addEventListener("click", () => openPage(pageAt + 1));
    $("#g-page-del").addEventListener("click", () => {
      if (pageAt < 0 || !confirm(`Remove lesson ${pageAt + 1}${plainTitle(lessons[pageAt].title) ? `, "${plainTitle(lessons[pageAt].title)}"` : ""}? It goes when you save.`)) return;
      lessons.splice(pageAt, 1); if (!lessons.length) lessons.push({ title: "", body_html: "<p></p>" });
      markDirty(); closePage();
    });

    /* ---------- the cover, changed on the picture ---------- */
    function drawCover() {
      const url = ($("#g-cover").value || "").trim(), box = $("#g-cover-box");
      box.style.backgroundImage = url ? `url('${url.replace(/'/g, "%27")}')` : "";
      box.classList.toggle("has-img", !!url);
    }
    function coverStat(t) { const el = $("#g-cover-stat"); el.textContent = t || ""; el.hidden = !t; }
    $("#g-cover-link").addEventListener("click", () => { const w = $("#g-cover-url-wrap"); w.hidden = !w.hidden; if (!w.hidden) $("#g-cover").focus(); });
    $("#g-cover-clear").addEventListener("click", () => { $("#g-cover").value = ""; drawCover(); coverStat("Cover removed. Members will see the standard Learn picture once you save."); markDirty(); });
    $("#g-cover-file").addEventListener("change", async (e) => {
      const file = e.target.files?.[0]; e.target.value = ""; if (!file) return;
      if (!WORKER) { coverStat("Uploads need the site's Worker address."); return; }
      coverStat("Uploading…");
      try {
        const { data: { session: s } } = await supabase.auth.getSession();
        const fd = new FormData(); fd.append("file", file);
        const res = await fetch(`${WORKER}/admin/upload`, { method: "POST", headers: s?.access_token ? { Authorization: `Bearer ${s.access_token}` } : {}, body: fd });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.url) { coverStat("Upload failed: " + (j.error || ("HTTP " + res.status))); return; }
        $("#g-cover").value = j.url; drawCover(); markDirty();
        const img = new Image();
        img.onload = () => coverStat(img.naturalWidth < 1600 ? `Uploaded. It's ${img.naturalWidth} pixels wide; the cover fills the page, so 1600 or wider looks sharper.` : "Uploaded. Save to keep it.");
        img.onerror = () => coverStat("Uploaded. Save to keep it.");
        img.src = j.url;
      } catch (err) { coverStat("Upload failed: " + (err.message || err)); }
    });
    // The title and summary boxes grow with their words.
    function fit(el) { el.style.height = "auto"; el.style.height = el.scrollHeight + "px"; }
    $("#g-summary").addEventListener("input", () => fit($("#g-summary")));
    function setOpenLink() { const slug = $("#g-slug").value.trim(); $("#g-open").href = slug ? `/account/guides/read?g=${encodeURIComponent(slug)}` : "#"; }

    /* ---------- form <-> state ---------- */
    function setStatusPill(s){ const p=$("#g-status-pill"); p.dataset.status=s; p.textContent=s.charAt(0).toUpperCase()+s.slice(1); }
    let curStatus = "draft", dirty = false, booted = false;
    function markDirty(){ if(booted){ dirty=true; $("#g-saved").textContent="Unsaved changes"; } }

    function showEditor(guide) {
      $("#g-empty").hidden = true; $("#g-built").hidden = true; $("#g-edit").hidden = false;
      cur = guide ? guide.id : null;
      curStatus = guide?.status || "draft";
      $("#g-title").value = guide?.title || "";
      $("#g-slug").value = guide?.slug || "";
      $("#g-topic").value = guide?.topic || "getting-started";
      $("#g-kind").value = guide?.kind || "guide";
      $("#g-audience").value = guide?.audience || "members";
      $("#g-level").value = guide?.level || "free";
      $("#g-lock").value = guide?.level_lock === "locked" ? "locked" : "hide";
      lockState();
      $("#g-mins").value = guide?.est_minutes ?? "";
      $("#g-summary").value = guide?.summary || "";
      $("#g-cover").value = guide?.cover_url || "";
      $("#g-cover-url-wrap").hidden = true; coverStat(""); drawCover();
      lessons = Array.isArray(guide?.lessons) && guide.lessons.length ? JSON.parse(JSON.stringify(guide.lessons)) : [{ title: "", body_html: "<p></p>" }];
      pageAt = -1; $("#g-page").hidden = true; $("#g-course").hidden = false;
      renderLessons(); setStatusPill(curStatus); updateTypeHint(); setOpenLink();
      requestAnimationFrame(() => fit($("#g-summary")));
      $("#g-saved").textContent = guide?.updated_at ? "Saved " + new Date(guide.updated_at).toLocaleString("en-GB",{day:"2-digit",month:"short",hour:"2-digit",minute:"2-digit"}) : "";
      dirty = false;
      document.querySelectorAll(".gadm-item").forEach((el) => el.classList.toggle("is-active", el.dataset.id === (cur||"")));
    }
    // Copy a built-in into the guides table, published with its own words, so
    // nothing changes for members until it is edited here.
    async function copyBuilt(slugs) {
      if (!isConfigured) { toast("Connect Supabase to copy."); return null; }
      const rows = BUILT_IN.filter((g) => slugs.includes(g.slug) && canCopy(g) && !list.some((x) => x.slug === g.slug)).map(copyRowFor);
      if (!rows.length) return null;
      toast("Copying…");
      // One at a time, so one refusal (say the Experts Group audience before
      // guides_audience_teg.sql has run) names itself and the rest still copy.
      const done = [], failed = [];
      for (const row of rows) {
        const { data, error } = await supabase.from("guides").insert(row).select("id,slug").maybeSingle();
        if (error || !data) failed.push(`${row.title}${error ? ` (${error.message})` : ""}`); else done.push(data);
      }
      await loadList();
      if (failed.length) { toast(`Copied ${done.length} of ${rows.length}. Not copied: ${failed.join("; ")}`); return done; }
      toast(rows.length === 1 ? "Copied. You can edit it now." : `${rows.length} courses copied. You can edit them now.`);
      return done;
    }
    $("#g-built-copy").addEventListener("click", async (e) => {
      const done = await copyBuilt([e.currentTarget.dataset.slug]);
      if (done && done[0]) { const { data } = await supabase.from("guides").select("*").eq("id", done[0].id).maybeSingle(); if (data) showEditor(data); }
    });

    function showBuilt(slug) {
      const g = BUILT_IN.find((x) => x.slug === slug); if (!g) return;
      if (dirty && !confirm("Leave without saving your changes?")) return;
      cur = null; dirty = false;
      $("#g-empty").hidden = true; $("#g-edit").hidden = true; $("#g-built").hidden = false;
      const cover = g.cover_url || g.art || "";
      const c = $("#g-built-cover"); c.hidden = !cover; c.style.backgroundImage = cover ? `url('${cover.replace(/'/g, "%27")}')` : "";
      $("#g-built-title").textContent = g.title || "Untitled";
      $("#g-built-sum").textContent = g.summary || "";
      const lessons = Array.isArray(g.lessons) ? g.lessons : [];
      const brands = Array.isArray(g.brands) && g.brands.length ? g.brands.join(", ") + " agents" : "";
      const facts = [
        ["Type", GUIDE_KIND_LABEL(g.kind)],
        ["Topic", GUIDE_TOPIC_LABEL(g.topic)],
        ["Who sees it", brands || AUDIENCE[g.audience || "members"] || "All members"],
        ["Where", builtWhere(g)],
        ["Length", g.est_minutes ? `About ${g.est_minutes} minutes` : (lessons.length ? `${lessons.length} lessons` : "")],
      ].filter((f) => f[1]);
      $("#g-built-facts").innerHTML = facts.map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join("");
      $("#g-built-note").textContent = list.some((x) => x.slug === g.slug) ? "A database guide has the same link and shows instead of this one" : "";
      $("#g-built-open").href = builtHref(g);
      $("#g-built-copy").hidden = !canCopy(g);
      $("#g-built-copy").dataset.slug = g.slug;
      if (!canCopy(g)) $("#g-built-note").textContent = "Its own pages; its words change in the site's code";
      $("#g-built-lessons").innerHTML = lessons.length
        ? lessons.map((l, i) => `<li><span>${esc((l.title || "").replace(/<[^>]+>/g, "") || "Untitled lesson")}</span>${g.href ? "" : `<a href="${esc(builtHref(g, i + 1))}" target="_blank" rel="noopener">Open</a>`}</li>`).join("")
        : `<li><span>Its own pages, opened with the button above</span></li>`;
      document.querySelectorAll(".gadm-item").forEach((el) => el.classList.toggle("is-active", el.dataset.built === g.slug));
    }

    // The lock only means something on a guide with a level.
    function lockState() { $("#g-lock").disabled = $("#g-level").value === "free"; }
    $("#g-level").addEventListener("change", lockState);
    ["g-title","g-slug","g-topic","g-kind","g-audience","g-level","g-lock","g-mins","g-summary","g-cover"].forEach((id) => {
      const el = $("#"+id); const ev = el.tagName === "SELECT" ? "change" : "input";
      el.addEventListener(ev, () => { if(id==="g-title" && !cur && !$("#g-slug").value) $("#g-slug").value = slugify($("#g-title").value); if(id==="g-kind") updateTypeHint(); if(id==="g-cover") drawCover(); if(id==="g-slug") setOpenLink(); markDirty(); });
    });

    // One-line reminder of what the chosen Type gives you in the hub.
    function updateTypeHint() {
      const kind = $("#g-kind").value;
      $("#g-type-hint").textContent = kind === "course"
        ? "Course — plays as a click-through mini-deck: one lesson per slide, with a progress bar members can resume."
        : kind === "article"
          ? "Article — one flowing page, like a Guide, labelled Article on Learn. For a read rather than a how-to."
          : "Guide — one flowing page, like a quick how-to read.";
    }

    function gather() {
      const cleanLessons = lessons.map((l) => {
        const row = { title: (l.title||"").trim(), body_html: (l.body_html||"").trim() };
        if ((l.video_url || "").trim()) row.video_url = l.video_url.trim();
        if (l.walk) row.walk = l.walk;
        return row;
      }).filter((l) => l.title || l.body_html);
      return {
        title: ($("#g-title").value || "").trim() || "Untitled guide",
        slug: slugify($("#g-slug").value || $("#g-title").value || "guide-" + Date.now()),
        topic: $("#g-topic").value, kind: $("#g-kind").value, audience: $("#g-audience").value,
        level: $("#g-level").value,
        level_lock: $("#g-lock").value === "locked" ? "locked" : "hide",
        est_minutes: $("#g-mins").value ? Number($("#g-mins").value) : null,
        summary: ($("#g-summary").value || "").trim() || null,
        cover_url: ($("#g-cover").value || "").trim() || null,
        lessons: cleanLessons, status: curStatus,
      };
    }

    async function save(newStatus) {
      if (!isConfigured) { toast("Connect Supabase to save."); return; }
      if (newStatus) { curStatus = newStatus; setStatusPill(curStatus); }
      const payload = gather();
      toast("Saving…");
      const q = cur
        ? supabase.from("guides").update(payload).eq("id", cur).select().maybeSingle()
        : supabase.from("guides").insert(payload).select().maybeSingle();
      let { data, error } = await q;
      // Before supabase/guides_kind_article.sql has run the table refuses "article". Nothing is saved; she is told why.
      if (error && /guides_kind_check/i.test(error.message || "")) { toast("Not saved: the Article type needs guides_kind_article.sql running first. Choose Guide for now, or run that file."); return; }
      // Before supabase/guides_level_lock.sql has run there is no level_lock
      // column. The rest is saved, and she is told the choice wasn't.
      let lockMissing = false;
      if (error && /level_lock/i.test(error.message || "")) {
        lockMissing = payload.level_lock === "locked";
        delete payload.level_lock;
        ({ data, error } = await (cur
          ? supabase.from("guides").update(payload).eq("id", cur).select().maybeSingle()
          : supabase.from("guides").insert(payload).select().maybeSingle()));
      }
      // Before supabase/content_calendar_months.sql has run there is no level column.
      if (error && /level/i.test(error.message || "")) {
        delete payload.level;
        ({ data, error } = await (cur
          ? supabase.from("guides").update(payload).eq("id", cur).select().maybeSingle()
          : supabase.from("guides").insert(payload).select().maybeSingle()));
      }
      if (error) { toast("Save failed: " + error.message); return; }
      cur = data.id; dirty = false; $("#g-saved").textContent = "All changes saved";
      toast(lockMissing ? "Saved, but \"They see it locked\" can't be kept until guides_level_lock.sql has run. For now it is hidden from members without the level." : newStatus === "published" ? "Published ✓" : "Saved ✓");
      if (lockMissing) { $("#g-lock").value = "hide"; }
      await loadList();
      document.querySelectorAll(".gadm-item").forEach((el) => el.classList.toggle("is-active", el.dataset.id === cur));
    }
    $("#g-save").addEventListener("click", () => save());
    $("#g-publish").addEventListener("click", () => save("published"));
    $("#g-delete").addEventListener("click", async () => {
      if (!cur) { $("#g-edit").hidden = true; $("#g-empty").hidden = false; return; }
      if (!confirm("Delete this guide? This can't be undone.")) return;
      const { error } = await supabase.from("guides").delete().eq("id", cur);
      if (error) { toast("Delete failed: " + error.message); return; }
      toast("Deleted"); cur = null; $("#g-edit").hidden = true; $("#g-empty").hidden = false; await loadList();
    });
    $("#g-new").addEventListener("click", () => showEditor(null));
    $("#g-new-2").addEventListener("click", () => showEditor(null));

    /* ---------- list ---------- */
    async function loadList() {
      if (!isConfigured) { $("#g-items").innerHTML = '<p class="gadm-muted">Connect Supabase to manage guides.</p>'; return; }
      const { data, error } = await supabase.from("guides")
        .select("id,slug,title,topic,kind,status,updated_at,sort_order")
        .order("sort_order", { ascending: true }).order("updated_at", { ascending: false });
      if (error) { $("#g-items").innerHTML = '<p class="gadm-muted">Could not load guides.</p>'; return; }
      list = data || [];
      const notCopied = BUILT_IN.filter((g) => !list.some((x) => x.slug === g.slug));
      const copyable = notCopied.filter(canCopy);
      const builtHtml = (copyable.length > 1 ? `<button type="button" class="gadm-new gadm-copyall" id="g-copy-all">Copy all ${copyable.length} to edit</button>` : "") + notCopied.map((g) => `
        <button type="button" class="gadm-item" data-built="${esc(g.slug)}">
          <span class="gadm-item-t">${esc(g.title || "Untitled")}${Array.isArray(g.brands) && g.brands.length ? ", " + esc(g.brands.join(", ")) : ""}</span>
          <span class="gadm-item-m"><span class="gadm-dot ${g.held ? "is-draft" : "is-published"}"></span>${g.held ? "held" : "built in"} · ${esc(GUIDE_TOPIC_LABEL(g.topic))} · ${GUIDE_KIND_LABEL(g.kind)}</span>
        </button>`).join("");
      $("#g-items").innerHTML = (notCopied.length ? '<p class="gadm-group">Made with Claude, not copied yet</p>' + builtHtml : "") + '<p class="gadm-group">Editable here</p>' + (list.length ? list.map((g) => `
        <button type="button" class="gadm-item${g.id===cur?" is-active":""}" data-id="${g.id}">
          <span class="gadm-item-t">${esc(g.title || "Untitled")}</span>
          <span class="gadm-item-m"><span class="gadm-dot is-${g.status}"></span>${g.status}${BUILT_IN.some((b) => b.slug === g.slug && b.held) ? " · held off Learn" : ""} · ${esc(GUIDE_TOPIC_LABEL(g.topic))} · ${GUIDE_KIND_LABEL(g.kind)}</span>
        </button>`).join("") : '<p class="gadm-muted">No guides yet. Click “+ New”.</p>');
      $("#g-copy-all")?.addEventListener("click", () => copyBuilt(copyable.map((g) => g.slug)));
      $("#g-items").querySelectorAll(".gadm-item[data-built]").forEach((el) => el.addEventListener("click", () => showBuilt(el.dataset.built)));
      $("#g-items").querySelectorAll(".gadm-item[data-id]").forEach((el) => el.addEventListener("click", async () => {
        const { data } = await supabase.from("guides").select("*").eq("id", el.dataset.id).maybeSingle();
        if (data) showEditor(data);
      }));
    }

    (async () => {
      let session;
      if (DEV) session = (await supabase.auth.getSession()).data.session || { user: { id: "dev", email: "dev@tmke.co.uk" } };
      else { session = await requireAdmin("/admin/login"); if (!session) return; }
      await loadList();
      booted = true;
    })();
  </script>
</AdminShell>
