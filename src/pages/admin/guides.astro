---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
import "../../styles/guide-reader.css";   // a lesson drawn as members see it
import { GUIDE_TOPICS } from "../../data/guide-topics.js";
---

<AdminShell active="guides" title="Guides" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Guides</div>
          <div class="page-header-sub">Single guides and multi-lesson courses for the Learn hub.</div>
        </div>
      </div>
    </div>
  </div>
  <div class="gadm">
    <!-- ───────── list ───────── -->
    <aside class="gadm-list">
      <div class="gadm-list-head">
        <h2>Guides</h2>
        <button type="button" class="gadm-new" id="g-new">+ New</button>
      </div>
      <div class="gadm-items" id="g-items"><p class="gadm-muted">Loading…</p></div>
    </aside>

    <!-- ───────── editor ─────────
         Laid out like the built-in view (Danielle, 20 Nov): the cover, title,
         summary and facts are changed where they sit, and each lesson opens as
         its own page, drawn as members see it, with its words editable. -->
    <section class="gadm-edit" id="g-edit" hidden>
      <div class="gadm-bar">
        <span class="gadm-status-pill" id="g-status-pill" data-status="draft">Draft</span>
        <span class="gadm-saved" id="g-saved"></span>
        <div class="gadm-bar-r">
          <button type="button" class="gadm-btn gadm-btn--danger" id="g-delete">Delete</button>
          <a class="gadm-btn gadm-btn--link" id="g-open" href="#" target="_blank" rel="noopener">Open as a member sees it</a>
          <button type="button" class="gadm-btn" id="g-save">Save draft</button>
          <button type="button" class="gadm-btn gadm-btn--solid" id="g-publish">Publish</button>
        </div>
      </div>

      <!-- the course -->
      <div class="gle-course" id="g-course">
        <div class="gadm-built-cover gle-cover" id="g-cover-box">
          <div class="gle-cover-acts">
            <label class="gadm-btn gle-photo-btn">Change cover<input type="file" id="g-cover-file" accept="image/jpeg,image/png,image/webp" hidden /></label>
            <button type="button" class="gadm-btn gle-photo-btn" id="g-cover-link">Use a link</button>
            <button type="button" class="gadm-btn gle-photo-btn" id="g-cover-clear">Remove</button>
          </div>
          <span class="gle-cover-empty">No cover yet. Members see the standard Learn picture.</span>
        </div>
        <p class="gadm-muted gle-cover-stat" id="g-cover-stat" hidden></p>
        <label class="gadm-f" id="g-cover-url-wrap" hidden><span>Cover picture link</span><input id="g-cover" type="text" inputmode="url" spellcheck="false" placeholder="https://…" /></label>

        <input class="gle-h" id="g-title" placeholder="Course title" aria-label="Title" />
        <textarea class="gle-sum" id="g-summary" rows="1" placeholder="One line that sells it. It shows on the cards in Learn." aria-label="Summary"></textarea>

        <span class="gadm-sub gle-sec">Details</span>
        <dl class="gadm-built-facts gle-facts">
          <div><dt>Type</dt><dd><select id="g-kind" aria-label="Type"><option value="guide">Guide</option><option value="article">Article</option><option value="course">Course</option></select></dd></div>
          <div><dt>Topic</dt><dd><select id="g-topic" aria-label="Topic">{GUIDE_TOPICS.map((t) => (<option value={t.slug}>{t.label}</option>))}</select></dd></div>
          <div><dt>Who sees it</dt><dd><select id="g-audience" aria-label="Who sees it"><option value="members">All members</option><option value="public">Everyone (public)</option><option value="teg">The Experts Group agents (not Fine &amp; Country)</option></select></dd></div>
          <div title="The Content Calendar level it comes with. Members on that level or a higher one get it; Free is for everyone in Who sees it."><dt>Level</dt><dd><select id="g-level" aria-label="Level"><option value="free">Free</option><option value="calendar">Content Calendar</option><option value="scheduling">Content Calendar Plus</option><option value="done_for_you">Done For You</option></select></dd></div>
          <div title="What members without that level see. Hidden: it isn't listed and its link doesn't open. Locked: it is listed with a padlock and the level it comes with."><dt>Without the level</dt><dd><select id="g-lock" aria-label="Without the level"><option value="hide">They don't see it</option><option value="locked">They see it locked</option></select></dd></div>
          <div><dt>Length</dt><dd class="gle-mins">About <input id="g-mins" type="number" min="1" max="240" placeholder="6" aria-label="Minutes" /> minutes</dd></div>
          <div><dt>Link</dt><dd class="gle-slug">/guides/<input id="g-slug" placeholder="its-link" aria-label="Link" /></dd></div>
        </dl>
        <p class="gadm-muted gadm-typehint" id="g-type-hint"></p>

        <div class="gadm-lessons-head">
          <span class="gadm-sub gle-sec">Lessons</span>
          <span class="gadm-muted" id="g-lessons-hint">Click a lesson to read it as members see it and change its words.</span>
        </div>
        <ol class="gadm-built-lessons gle-lessons" id="g-lessons"></ol>
        <button type="button" class="gadm-addlesson" id="g-add-lesson">+ Add lesson</button>
      </div>

      <!-- one lesson, as members see it -->
      <div class="gle-page" id="g-page" hidden>
        <div class="gle-page-bar">
          <button type="button" class="gadm-btn" id="g-page-back">Back to the course</button>
          <span class="gadm-sub" id="g-page-no"></span>
          <div class="gadm-bar-r">
            <button type="button" class="gadm-btn" id="g-page-prev">Previous</button>
            <button type="button" class="gadm-btn" id="g-page-next">Next</button>
            <button type="button" class="gadm-btn gadm-btn--danger" id="g-page-del">Remove lesson</button>
          </div>
        </div>
        <div class="gle-tools" id="g-tools">
          <span class="gle-tl">Text</span>
          <div class="gle-tg">
            <button type="button" class="gle-tb gle-tb--i" data-cmd="bold" title="Bold"><b>B</b></button>
            <button type="button" class="gle-tb gle-tb--i" data-cmd="italic" title="Italic"><i>I</i></button>
            <button type="button" class="gle-tb gle-tb--i" data-size="-1" title="Smaller">A&minus;</button>
            <button type="button" class="gle-tb gle-tb--i" data-size="1" title="Bigger">A+</button>
            <button type="button" class="gle-tb gle-tb--i" data-align="left" title="Left"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M2 6.5h8M2 9.5h12M2 12.5h8"/></svg></button>
            <button type="button" class="gle-tb gle-tb--i" data-align="center" title="Centre"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M4 6.5h8M2 9.5h12M4 12.5h8"/></svg></button>
            <button type="button" class="gle-tb gle-tb--i" data-align="right" title="Right"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M6 6.5h8M2 9.5h12M6 12.5h8"/></svg></button>
            <button type="button" class="gle-tb gle-tb--i" data-align="justify" title="Justified"><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 3.5h12M2 6.5h12M2 9.5h12M2 12.5h12"/></svg></button>
            <span class="gle-tl gle-tl--in">Style</span>
            <button type="button" class="gle-tb gle-tb--sw" data-tone="" title="White box" style="--sw:#ffffff"></button>
            <button type="button" class="gle-tb gle-tb--sw" data-tone="linen" title="Linen box" style="--sw:#eae5e1"></button>
            <button type="button" class="gle-tb gle-tb--sw" data-tone="stone" title="Stone box" style="--sw:#c9bcb7"></button>
            <button type="button" class="gle-tb gle-tb--sw" data-tone="wine" title="Wine box" style="--sw:#371e28"></button>
          </div>
          <span class="gle-tl">Layout</span>
          <div class="gle-tg">
            <button type="button" class="gle-tb gle-tb--i" data-move="-1" title="Move up">&uarr;</button>
            <button type="button" class="gle-tb gle-tb--i" data-move="1" title="Move down">&darr;</button>
            <button type="button" class="gle-tb" data-dup title="Make a copy of the selected box, next to it">Copy</button>
            <button type="button" class="gle-tb" data-del title="Delete the selected box">Delete</button>
            <button type="button" class="gle-tb" data-outer title="Select the box this one sits inside">Select outer</button>
            <span class="gle-tk" id="g-tool-kind"></span>
          </div>
          <span class="gle-tl">Add</span>
          <div class="gle-tg">
            <button type="button" class="gle-tb" data-add="text">Text</button>
            <button type="button" class="gle-tb" data-add="heading">Heading</button>
            <button type="button" class="gle-tb" data-add="image">Picture</button>
            <button type="button" class="gle-tb" data-add="2">2 boxes</button>
            <button type="button" class="gle-tb" data-add="3">3 boxes</button>
            <button type="button" class="gle-tb" data-add="check">Checklist</button>
            <input type="file" id="g-img-file" accept="image/jpeg,image/png,image/webp" hidden />
            <button type="button" class="gle-tb gle-tb--undo" data-undo title="Put back the last move, copy, delete or add">Undo</button>
          </div>
        </div>
        <p class="gadm-muted gle-page-tip">Click any words to change them. Click a box to select it, then move, copy or delete it from the bar. New things go in under the selected box.</p>
        <div class="ws gle-ws">
          <div class="gc-slide gc-slide--part gle-slide">
            <span class="gc-part" id="g-page-part"></span>
            <input class="gc-slide-title gle-ltitle" id="g-page-title" placeholder="Lesson title" aria-label="Lesson title" />
            <div class="gc-slide-body gr-body gle-body" id="g-page-body"></div>
            <p class="gle-walk-note" id="g-page-walknote" hidden></p>
          </div>
        </div>
        <div class="gadm-l-extras">
          <label><span>Video link</span><input id="g-page-video" placeholder="YouTube, Vimeo or an MP4 link (optional)" /></label>
          <label><span>Show me walkthrough</span><select id="g-page-walk"><option value="">None</option></select></label>
        </div>
        <details class="gle-html" id="g-page-htmlbox">
          <summary>Edit the HTML</summary>
          <textarea id="g-page-html" rows="14" spellcheck="false"></textarea>
          <p class="gadm-lesson-hint">Paragraphs &lt;p&gt;, sub-heads &lt;h3&gt;, lists &lt;ul&gt;&lt;li&gt;, bold &lt;strong&gt;, links &lt;a href&gt;. The page above updates when you click out of the box.</p>
        </details>
      </div>
    </section>

    <!-- ───────── a built-in course: read only ───────── -->
    <section class="gadm-edit" id="g-built" hidden>
      <div class="gadm-bar">
        <span class="gadm-status-pill" data-status="published" id="g-built-pill">Built in</span>
        <span class="gadm-saved" id="g-built-note"></span>
        <div class="gadm-bar-r">
          <a class="gadm-btn gadm-btn--link" id="g-built-open" href="#" target="_blank" rel="noopener">Open as a member sees it</a>
          <button type="button" class="gadm-btn gadm-btn--solid" id="g-built-copy">Copy to edit</button>
        </div>
      </div>
      <div class="gadm-built-cover" id="g-built-cover" hidden></div>
      <div class="gadm-built-h" id="g-built-title"></div>
      <p class="gadm-built-sum" id="g-built-sum"></p>
      <dl class="gadm-built-facts" id="g-built-facts"></dl>
      <div class="gadm-lessons-head"><span class="gadm-sub">Lessons</span></div>
      <ol class="gadm-built-lessons" id="g-built-lessons"></ol>
    </section>

    <section class="gadm-empty" id="g-empty">
      <h2>Guides</h2>
      <p>Pick a guide on the left to edit it, or start a new one.</p>
      <button type="button" class="gadm-btn gadm-btn--solid" id="g-new-2">+ New guide</button>
    </section>
  </div>

  <style is:global>
    .gadm { display: grid; grid-template-columns: 320px 1fr; gap: 20px; align-items: start; }
    @media (max-width: 900px) { .gadm { grid-template-columns: 1fr; } }
    .gadm-muted { color: rgba(28,29,34,0.5); font-size: 13px; }
    .gadm-sub { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.55); }

    /* list */
    .gadm-list { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 16px; position: sticky; top: 16px; }
    .gadm-list-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
    .gadm-list-head h2 { font-family: var(--serif); font-weight: 400; font-size: 20px; margin: 0; letter-spacing: -0.05em; }
    .gadm-new, .gadm-addlesson { font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--english-violet); background: #fff; border: 1px solid var(--english-violet); border-radius: 4px; height: 28px; box-sizing: border-box; padding: 0 12px; cursor: pointer; }
    .gadm-new:hover, .gadm-addlesson:hover { background: rgba(55,30,40,0.06); }
    .gadm-items { display: flex; flex-direction: column; gap: 6px; max-height: 70vh; overflow: auto; }
    .gadm-item { text-align: left; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 9px; padding: 11px 13px; cursor: pointer; }
    .gadm-item:hover { border-color: var(--english-violet); }
    .gadm-item.is-active { border-color: var(--english-violet); box-shadow: inset 0 0 0 1px var(--english-violet); }
    .gadm-item-t { font-family: var(--sans); font-size: 14px; font-weight: 600; color: var(--ink); display: block; }
    .gadm-item-m { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.5); margin-top: 3px; display: flex; gap: 8px; align-items: center; }
    .gadm-dot { width: 7px; height: 7px; border-radius: 50%; background: #c9c3bf; }
    .gadm-dot.is-published { background: #3f9468; }
    .gadm-dot.is-draft { background: #caa63c; }

    /* editor */
    .gadm-edit { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 22px; display: flex; flex-direction: column; gap: 14px; }
    .gadm-edit[hidden] { display: none; }
    .gadm-empty { background: #fff; border: 1px dashed rgba(28,29,34,0.2); border-radius: 12px; padding: 60px 22px; text-align: center; color: rgba(28,29,34,0.55); }
    .gadm-empty h2 { font-family: var(--serif); font-weight: 400; color: var(--ink); margin: 0 0 6px; letter-spacing: -0.05em; }
    .gadm-empty p { margin: 0 0 16px; font-size: 14px; }
    .gadm-bar { display: flex; align-items: center; gap: 10px; padding-bottom: 14px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .gadm-bar-r { margin-left: auto; display: flex; gap: 20px; }
    .gadm-btn { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; height: 28px; box-sizing: border-box; padding: 0 15px; border-radius: 4px; border: 1px solid rgba(55,30,40,0.25); background: #fff; color: var(--english-violet); cursor: pointer; }
    .gadm-btn:hover { background: rgba(55,30,40,0.05); }
    .gadm-btn--solid { background: var(--english-violet); color: #fff; border-color: var(--english-violet); }
    .gadm-btn--solid:hover { background: var(--ink); }
    .gadm-btn--danger { color: #a05a3c; border-color: rgba(160,90,60,0.4); }
    .gadm-btn--danger:hover { background: rgba(160,90,60,0.08); }
    .gadm-status-pill { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; }
    .gadm-status-pill[data-status="draft"] { background: rgba(202,166,60,0.16); color: #8a6d1e; }
    .gadm-status-pill[data-status="published"] { background: rgba(63,148,104,0.16); color: #2d6a44; }
    .gadm-status-pill[data-status="archived"] { background: rgba(28,29,34,0.08); color: rgba(28,29,34,0.55); }
    .gadm-saved { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.45); }
    .gadm-f { display: flex; flex-direction: column; gap: 6px; }
    .gadm-f > span { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .gadm-f input, .gadm-f select, .gadm-f textarea { font-family: var(--sans); font-size: 14px; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; background: #fff; color: var(--ink); width: 100%; }
    .gadm-f input:focus, .gadm-f select:focus, .gadm-f textarea:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .gadm-f4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
    .gadm-typehint { margin: 8px 0 0; }
    @media (max-width: 640px) { .gadm-f4 { grid-template-columns: 1fr 1fr; } }
    .gadm-lessons-head { display: flex; align-items: baseline; gap: 12px; margin-top: 6px; }
    .gadm-lesson { border: 1px solid rgba(28,29,34,0.12); border-radius: 10px; padding: 12px; margin-bottom: 10px; background: #fbfaf8; }
    .gadm-lesson-bar { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .gadm-lesson-no { font-family: var(--sans); font-size: 11px; font-weight: 700; color: var(--english-violet); }
    .gadm-lesson-bar .gadm-mini { margin-left: auto; }
    .gadm-mini { font-family: var(--sans); font-size: 12px; border: 1px solid rgba(28,29,34,0.16); background: #fff; border-radius: 6px; padding: 4px 8px; cursor: pointer; color: rgba(28,29,34,0.6); }
    .gadm-mini:hover { border-color: var(--english-violet); color: var(--english-violet); }
    .gadm-lesson textarea { font-family: ui-monospace, Menlo, monospace; font-size: 12.5px; line-height: 1.5; }
    .gadm-lesson-hint { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.45); margin: 6px 0 0; }
    .gadm-l-extras { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 8px; }
    .gadm-l-extras label { display: flex; flex-direction: column; gap: 4px; font-family: var(--sans); font-size: 11px; font-weight: 700; color: rgba(28,29,34,0.55); }
    .gadm-l-extras input, .gadm-l-extras select { font-family: var(--sans); font-size: 12.5px; padding: 7px 9px; border: 1px solid rgba(28,29,34,0.15); border-radius: 6px; background: #fff; }
    @media (max-width: 640px) { .gadm-l-extras { grid-template-columns: 1fr; } }
    /* Built-in courses (the ones made with Claude, in the site's code): their own part of the list, read only. */
    .gadm-group { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.55); margin: 12px 0 2px; padding-bottom: 6px; border-bottom: 1px solid rgba(28,29,34,0.12); }
    .gadm-group:first-child { margin-top: 0; }
    .gadm-copyall { align-self: flex-start; margin: 4px 0 2px; }
    .gadm-btn--link { display: inline-flex; align-items: center; text-decoration: none; }
    .gadm-built-cover { aspect-ratio: 16 / 7; border-radius: 10px; background: #e9e6e2 center / cover no-repeat; }
    .gadm-built-h { font-family: var(--serif); font-weight: 400; font-size: 26px; line-height: 1.15; color: var(--ink); }
    .gadm-built-sum { margin: 0; font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.7); }
    .gadm-built-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 0; }
    .gadm-built-facts div { display: flex; flex-direction: column; gap: 4px; }
    .gadm-built-facts dt { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .gadm-built-facts dd { margin: 0; font-family: var(--sans); font-size: 14px; color: var(--ink); }
    .gadm-built-lessons { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; counter-reset: l; }
    .gadm-built-lessons li { counter-increment: l; display: flex; gap: 10px; align-items: baseline; border: 1px solid rgba(28,29,34,0.12); border-radius: 10px; padding: 10px 12px; background: #fbfaf8; font-family: var(--sans); font-size: 14px; color: var(--ink); }
    .gadm-built-lessons li::before { content: "Lesson " counter(l); flex: 0 0 auto; font-size: 11px; font-weight: 700; color: var(--english-violet); }
    .gadm-built-lessons a { margin-left: auto; font-size: 12px; font-weight: 700; color: var(--english-violet); text-decoration: none; white-space: nowrap; }
    /* ---- The editable view: the built-in layout, changed in place ---- */
    .gle-course, .gle-page { display: flex; flex-direction: column; gap: 14px; }
    .gle-course[hidden], .gle-page[hidden], .gadm-f[hidden] { display: none; }
    .gle-cover { position: relative; display: flex; align-items: flex-end; justify-content: flex-end; padding: 14px; box-sizing: border-box; }
    .gle-cover-acts { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .gadm .gle-photo-btn { display: inline-flex; align-items: center; margin: 0; background: rgba(255,255,255,0.92); text-transform: none; font-size: 12px; letter-spacing: 0.06em; color: var(--english-violet); cursor: pointer; }
    .gle-cover-empty { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); text-align: center; }
    .gle-cover.has-img .gle-cover-empty, .gle-cover:not(.has-img) #g-cover-clear { display: none; }
    .gle-cover-stat { margin: -6px 0 0; }
    .gle-cover-stat[hidden] { display: none; }
    /* Words that look like the page until you touch them. */
    .gadm .gle-h, .gadm .gle-sum, .gadm .gle-ltitle { width: 100%; box-sizing: border-box; border: 1px solid transparent; border-radius: 4px; background: transparent; padding: 2px 6px; margin: 0 -6px; min-height: 0; resize: none; overflow: hidden; transition: border-color .15s, background .15s; }
    .gadm .gle-h:hover, .gadm .gle-sum:hover, .gadm .gle-ltitle:hover { border-color: rgba(28,29,34,0.14); }
    .gadm .gle-h:focus, .gadm .gle-sum:focus, .gadm .gle-ltitle:focus { outline: none; border-color: var(--english-violet); background: #fff; box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
