---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
import "../../styles/guide-reader.css";   // a lesson drawn as members see it
import { GUIDE_TOPICS } from "../../data/guide-topics.js";
---

<AdminShell active="guides" title="Guides" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Guides</div>
          <div class="page-header-sub">Single guides and multi-lesson courses for the Learn hub.</div>
        </div>
      </div>
    </div>
  </div>
  <div class="gadm">
    <!-- ───────── list ───────── -->
    <aside class="gadm-list">
      <div class="gadm-list-head">
        <h2>Guides</h2>
        <button type="button" class="gadm-new" id="g-new">+ New</button>
      </div>
      <div class="gadm-items" id="g-items"><p class="gadm-muted">Loading…</p></div>
    </aside>

    <!-- ───────── editor ─────────
         Laid out like the built-in view (Danielle, 20 Nov): the cover, title,
         summary and facts are changed where they sit, and each lesson opens as
         its own page, drawn as members see it, with its words editable. -->
    <section class="gadm-edit" id="g-edit" hidden>
      <div class="gadm-bar">
        <span class="gadm-status-pill" id="g-status-pill" data-status="draft">Draft</span>
        <span class="gadm-saved" id="g-saved"></span>
        <div class="gadm-bar-r">
          <button type="button" class="gadm-btn gadm-btn--danger" id="g-delete">Delete</button>
          <a class="gadm-btn gadm-btn--link" id="g-open" href="#" target="_blank" rel="noopener">Open as a member sees it</a>
          <button type="button" class="gadm-btn" id="g-save">Save draft</button>
          <button type="button" class="gadm-btn gadm-btn--solid" id="g-publish">Publish</button>
        </div>
      </div>

      <!-- the course -->
      <div class="gle-course" id="g-course">
        <div class="gadm-built-cover gle-cover" id="g-cover-box">
          <div class="gle-cover-acts">
            <label class="gadm-btn gle-photo-btn">Change cover<input type="file" id="g-cover-file" accept="image/jpeg,image/png,image/webp" hidden /></label>
            <button type="button" class="gadm-btn gle-photo-btn" id="g-cover-link">Use a link</button>
            <button type="button" class="gadm-btn gle-photo-btn" id="g-cover-clear">Remove</button>
          </div>
          <span class="gle-cover-empty">No cover yet. Members see the standard Learn picture.</span>
        </div>
        <p class="gadm-muted gle-cover-stat" id="g-cover-stat" hidden></p>
        <label class="gadm-f" id="g-cover-url-wrap" hidden><span>Cover picture link</span><input id="g-cover" type="text" inputmode="url" spellcheck="false" placeholder="https://…" /></label>

        <input class="gle-h" id="g-title" placeholder="Course title" aria-label="Title" />
        <textarea class="gle-sum" id="g-summary" rows="1" placeholder="One line that sells it. It shows on the cards in Learn." aria-label="Summary"></textarea>

        <dl class="gadm-built-facts gle-facts">
          <div><dt>Type</dt><dd><select id="g-kind" aria-label="Type"><option value="guide">Article</option><option value="course">Course</option></select></dd></div>
          <div><dt>Topic</dt><dd><select id="g-topic" aria-label="Topic">{GUIDE_TOPICS.map((t) => (<option value={t.slug}>{t.label}</option>))}</select></dd></div>
          <div><dt>Who sees it</dt><dd><select id="g-audience" aria-label="Who sees it"><option value="members">All members</option><option value="public">Everyone (public)</option><option value="teg">The Experts Group agents (not Fine &amp; Country)</option></select></dd></div>
          <div title="Which Content Calendar level includes it. Everything is Free until the subscription launches."><dt>Level</dt><dd><select id="g-level" aria-label="Level"><option value="free">Free</option><option value="calendar">Content Calendar</option><option value="scheduling">Content Calendar Plus</option><option value="done_for_you">Done For You</option></select></dd></div>
          <div><dt>Length</dt><dd class="gle-mins">About <input id="g-mins" type="number" min="1" max="240" placeholder="6" aria-label="Minutes" /> minutes</dd></div>
          <div><dt>Link</dt><dd class="gle-slug">/guides/<input id="g-slug" placeholder="its-link" aria-label="Link" /></dd></div>
        </dl>
        <p class="gadm-muted gadm-typehint" id="g-type-hint"></p>

        <div class="gadm-lessons-head">
          <span class="gadm-sub">Lessons</span>
          <span class="gadm-muted" id="g-lessons-hint">Click a lesson to read it as members see it and change its words.</span>
        </div>
        <ol class="gadm-built-lessons gle-lessons" id="g-lessons"></ol>
        <button type="button" class="gadm-addlesson" id="g-add-lesson">+ Add lesson</button>
      </div>

      <!-- one lesson, as members see it -->
      <div class="gle-page" id="g-page" hidden>
        <div class="gle-page-bar">
          <button type="button" class="gadm-btn" id="g-page-back">Back to the course</button>
          <span class="gadm-sub" id="g-page-no"></span>
          <div class="gadm-bar-r">
            <button type="button" class="gadm-btn" id="g-page-prev">Previous</button>
            <button type="button" class="gadm-btn" id="g-page-next">Next</button>
            <button type="button" class="gadm-btn gadm-btn--danger" id="g-page-del">Remove lesson</button>
          </div>
        </div>
        <p class="gadm-muted gle-page-tip">Click any words to change them. Pictures, cards and layout stay as they are; change those in the HTML below.</p>
        <div class="ws gle-ws">
          <div class="gc-slide gc-slide--part gle-slide">
            <span class="gc-part" id="g-page-part"></span>
            <input class="gc-slide-title gle-ltitle" id="g-page-title" placeholder="Lesson title" aria-label="Lesson title" />
            <div class="gc-slide-body gr-body gle-body" id="g-page-body"></div>
            <p class="gle-walk-note" id="g-page-walknote" hidden></p>
          </div>
        </div>
        <div class="gadm-l-extras">
          <label><span>Video link</span><input id="g-page-video" placeholder="YouTube, Vimeo or an MP4 link (optional)" /></label>
          <label><span>Show me walkthrough</span><select id="g-page-walk"><option value="">None</option></select></label>
        </div>
        <details class="gle-html" id="g-page-htmlbox">
          <summary>Edit the HTML (for pictures, cards and layout)</summary>
          <textarea id="g-page-html" rows="14" spellcheck="false"></textarea>
          <p class="gadm-lesson-hint">Paragraphs &lt;p&gt;, sub-heads &lt;h3&gt;, lists &lt;ul&gt;&lt;li&gt;, bold &lt;strong&gt;, links &lt;a href&gt;. The page above updates when you click out of the box.</p>
        </details>
      </div>
    </section>

    <!-- ───────── a built-in course: read only ───────── -->
    <section class="gadm-edit" id="g-built" hidden>
      <div class="gadm-bar">
        <span class="gadm-status-pill" data-status="published" id="g-built-pill">Built in</span>
        <span class="gadm-saved" id="g-built-note"></span>
        <div class="gadm-bar-r">
          <a class="gadm-btn gadm-btn--link" id="g-built-open" href="#" target="_blank" rel="noopener">Open as a member sees it</a>
          <button type="button" class="gadm-btn gadm-btn--solid" id="g-built-copy">Copy to edit</button>
        </div>
      </div>
      <div class="gadm-built-cover" id="g-built-cover" hidden></div>
      <div class="gadm-built-h" id="g-built-title"></div>
      <p class="gadm-built-sum" id="g-built-sum"></p>
      <dl class="gadm-built-facts" id="g-built-facts"></dl>
      <div class="gadm-lessons-head"><span class="gadm-sub">Lessons</span></div>
      <ol class="gadm-built-lessons" id="g-built-lessons"></ol>
    </section>

    <section class="gadm-empty" id="g-empty">
      <h2>Guides</h2>
      <p>Pick a guide on the left to edit it, or start a new one.</p>
      <button type="button" class="gadm-btn gadm-btn--solid" id="g-new-2">+ New guide</button>
    </section>
  </div>

  <style is:global>
    .gadm { display: grid; grid-template-columns: 320px 1fr; gap: 20px; align-items: start; }
    @media (max-width: 900px) { .gadm { grid-template-columns: 1fr; } }
    .gadm-muted { color: rgba(28,29,34,0.5); font-size: 13px; }
    .gadm-sub { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.55); }

    /* list */
    .gadm-list { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 16px; position: sticky; top: 16px; }
    .gadm-list-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px; }
    .gadm-list-head h2 { font-family: var(--serif); font-weight: 400; font-size: 20px; margin: 0; letter-spacing: -0.05em; }
    .gadm-new, .gadm-addlesson { font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--english-violet); background: #fff; border: 1px solid var(--english-violet); border-radius: 4px; height: 28px; box-sizing: border-box; padding: 0 12px; cursor: pointer; }
    .gadm-new:hover, .gadm-addlesson:hover { background: rgba(55,30,40,0.06); }
    .gadm-items { display: flex; flex-direction: column; gap: 6px; max-height: 70vh; overflow: auto; }
    .gadm-item { text-align: left; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 9px; padding: 11px 13px; cursor: pointer; }
    .gadm-item:hover { border-color: var(--english-violet); }
    .gadm-item.is-active { border-color: var(--english-violet); box-shadow: inset 0 0 0 1px var(--english-violet); }
    .gadm-item-t { font-family: var(--sans); font-size: 14px; font-weight: 600; color: var(--ink); display: block; }
    .gadm-item-m { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.5); margin-top: 3px; display: flex; gap: 8px; align-items: center; }
    .gadm-dot { width: 7px; height: 7px; border-radius: 50%; background: #c9c3bf; }
    .gadm-dot.is-published { background: #3f9468; }
    .gadm-dot.is-draft { background: #caa63c; }

    /* editor */
    .gadm-edit { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 22px; display: flex; flex-direction: column; gap: 14px; }
    .gadm-edit[hidden] { display: none; }
    .gadm-empty { background: #fff; border: 1px dashed rgba(28,29,34,0.2); border-radius: 12px; padding: 60px 22px; text-align: center; color: rgba(28,29,34,0.55); }
    .gadm-empty h2 { font-family: var(--serif); font-weight: 400; color: var(--ink); margin: 0 0 6px; letter-spacing: -0.05em; }
    .gadm-empty p { margin: 0 0 16px; font-size: 14px; }
    .gadm-bar { display: flex; align-items: center; gap: 10px; padding-bottom: 14px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .gadm-bar-r { margin-left: auto; display: flex; gap: 20px; }
    .gadm-btn { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.06em; height: 28px; box-sizing: border-box; padding: 0 15px; border-radius: 4px; border: 1px solid rgba(55,30,40,0.25); background: #fff; color: var(--english-violet); cursor: pointer; }
    .gadm-btn:hover { background: rgba(55,30,40,0.05); }
    .gadm-btn--solid { background: var(--english-violet); color: #fff; border-color: var(--english-violet); }
    .gadm-btn--solid:hover { background: var(--ink); }
    .gadm-btn--danger { color: #a05a3c; border-color: rgba(160,90,60,0.4); }
    .gadm-btn--danger:hover { background: rgba(160,90,60,0.08); }
    .gadm-status-pill { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; }
    .gadm-status-pill[data-status="draft"] { background: rgba(202,166,60,0.16); color: #8a6d1e; }
    .gadm-status-pill[data-status="published"] { background: rgba(63,148,104,0.16); color: #2d6a44; }
    .gadm-status-pill[data-status="archived"] { background: rgba(28,29,34,0.08); color: rgba(28,29,34,0.55); }
    .gadm-saved { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.45); }
    .gadm-f { display: flex; flex-direction: column; gap: 6px; }
    .gadm-f > span { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .gadm-f input, .gadm-f select, .gadm-f textarea { font-family: var(--sans); font-size: 14px; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; background: #fff; color: var(--ink); width: 100%; }
    .gadm-f input:focus, .gadm-f select:focus, .gadm-f textarea:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .gadm-f4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; }
    .gadm-typehint { margin: 8px 0 0; }
    @media (max-width: 640px) { .gadm-f4 { grid-template-columns: 1fr 1fr; } }
    .gadm-lessons-head { display: flex; align-items: baseline; gap: 12px; margin-top: 6px; }
    .gadm-lesson { border: 1px solid rgba(28,29,34,0.12); border-radius: 10px; padding: 12px; margin-bottom: 10px; background: #fbfaf8; }
    .gadm-lesson-bar { display: flex; align-items: center; gap: 8px; margin-bottom: 8px; }
    .gadm-lesson-no { font-family: var(--sans); font-size: 11px; font-weight: 700; color: var(--english-violet); }
    .gadm-lesson-bar .gadm-mini { margin-left: auto; }
    .gadm-mini { font-family: var(--sans); font-size: 12px; border: 1px solid rgba(28,29,34,0.16); background: #fff; border-radius: 6px; padding: 4px 8px; cursor: pointer; color: rgba(28,29,34,0.6); }
    .gadm-mini:hover { border-color: var(--english-violet); color: var(--english-violet); }
    .gadm-lesson textarea { font-family: ui-monospace, Menlo, monospace; font-size: 12.5px; line-height: 1.5; }
    .gadm-lesson-hint { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.45); margin: 6px 0 0; }
    .gadm-l-extras { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 8px; }
    .gadm-l-extras label { display: flex; flex-direction: column; gap: 4px; font-family: var(--sans); font-size: 11px; font-weight: 700; color: rgba(28,29,34,0.55); }
    .gadm-l-extras input, .gadm-l-extras select { font-family: var(--sans); font-size: 12.5px; padding: 7px 9px; border: 1px solid rgba(28,29,34,0.15); border-radius: 6px; background: #fff; }
    @media (max-width: 640px) { .gadm-l-extras { grid-template-columns: 1fr; } }
    /* Built-in courses (the ones made with Claude, in the site's code): their own part of the list, read only. */
    .gadm-group { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.55); margin: 12px 0 2px; padding-bottom: 6px; border-bottom: 1px solid rgba(28,29,34,0.12); }
    .gadm-group:first-child { margin-top: 0; }
    .gadm-copyall { align-self: flex-start; margin: 4px 0 2px; }
    .gadm-btn--link { display: inline-flex; align-items: center; text-decoration: none; }
    .gadm-built-cover { aspect-ratio: 16 / 7; border-radius: 10px; background: #e9e6e2 center / cover no-repeat; }
    .gadm-built-h { font-family: var(--serif); font-weight: 400; font-size: 26px; line-height: 1.15; color: var(--ink); }
    .gadm-built-sum { margin: 0; font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.7); }
    .gadm-built-facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 0; }
    .gadm-built-facts div { display: flex; flex-direction: column; gap: 4px; }
    .gadm-built-facts dt { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .gadm-built-facts dd { margin: 0; font-family: var(--sans); font-size: 14px; color: var(--ink); }
    .gadm-built-lessons { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px; counter-reset: l; }
    .gadm-built-lessons li { counter-increment: l; display: flex; gap: 10px; align-items: baseline; border: 1px solid rgba(28,29,34,0.12); border-radius: 10px; padding: 10px 12px; background: #fbfaf8; font-family: var(--sans); font-size: 14px; color: var(--ink); }
    .gadm-built-lessons li::before { content: "Lesson " counter(l); flex: 0 0 auto; font-size: 11px; font-weight: 700; color: var(--english-violet); }
    .gadm-built-lessons a { margin-left: auto; font-size: 12px; font-weight: 700; color: var(--english-violet); text-decoration: none; white-space: nowrap; }
    /* ---- The editable view: the built-in layout, changed in place ---- */
    .gle-course, .gle-page { display: flex; flex-direction: column; gap: 14px; }
    .gle-course[hidden], .gle-page[hidden], .gadm-f[hidden] { display: none; }
    .gle-cover { position: relative; display: flex; align-items: flex-end; justify-content: flex-end; padding: 14px; box-sizing: border-box; }
    .gle-cover-acts { display: flex; gap: 8px; flex-wrap: wrap; justify-content: flex-end; }
    .gadm .gle-photo-btn { display: inline-flex; align-items: center; margin: 0; background: rgba(255,255,255,0.92); text-transform: none; font-size: 12px; letter-spacing: 0.06em; color: var(--english-violet); cursor: pointer; }
    .gle-cover-empty { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); text-align: center; }
    .gle-cover.has-img .gle-cover-empty, .gle-cover:not(.has-img) #g-cover-clear { display: none; }
    .gle-cover-stat { margin: -6px 0 0; }
    .gle-cover-stat[hidden] { display: none; }
    /* Words that look like the page until you touch them. */
    .gadm .gle-h, .gadm .gle-sum, .gadm .gle-ltitle { width: 100%; box-sizing: border-box; border: 1px solid transparent; border-radius: 4px; background: transparent; padding: 2px 6px; margin: 0 -6px; min-height: 0; resize: none; overflow: hidden; transition: border-color .15s, background .15s; }
    .gadm .gle-h:hover, .gadm .gle-sum:hover, .gadm .gle-ltitle:hover { border-color: rgba(28,29,34,0.14); }
    .gadm .gle-h:focus, .gadm .gle-sum:focus, .gadm .gle-ltitle:focus { outline: none; border-color: var(--english-violet); background: #fff; box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .gadm .gle-h { font-family: var(--serif); font-weight: 400; font-size: 26px; line-height: 1.15; letter-spacing: -0.05em; color: var(--ink); }
    .gadm .gle-sum { font-family: var(--sans); font-size: 14px; line-height: 1.5; color: rgba(28,29,34,0.7); }
    .gadm .gle-ltitle { font-family: var(--serif); font-weight: 500; font-size: clamp(26px, 3.4vw, 40px); line-height: 1.08; letter-spacing: -0.05em; color: var(--ws-ink); margin-bottom: 6px; }
    .gle-facts dd { display: flex; align-items: center; gap: 4px; }
    .gadm .gle-facts select, .gadm .gle-facts input { font-family: var(--sans); font-size: 14px; color: var(--ink); border: 1px solid transparent; border-radius: 4px; background: transparent; padding: 3px 6px; margin-left: -7px; max-width: 100%; min-width: 0; cursor: pointer; }
    .gadm .gle-facts select:hover, .gadm .gle-facts input:hover { border-color: rgba(28,29,34,0.14); }
    .gadm .gle-facts select:focus, .gadm .gle-facts input:focus { outline: none; border-color: var(--english-violet); background: #fff; }
    .gadm .gle-mins input { width: 54px; margin: 0; text-align: center; cursor: text; }
    .gle-slug { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.5); }
    .gadm .gle-slug input { margin: 0; flex: 1; cursor: text; }
    /* Lesson rows: the whole row opens the page. */
    .gle-lessons li { cursor: pointer; align-items: center; transition: border-color .15s; }
    .gle-lessons li:hover { border-color: var(--english-violet); }
    .gle-lessons .gle-l-t { flex: 1; min-width: 0; }
    .gle-lessons .gle-l-t.is-empty { color: rgba(28,29,34,0.45); }
    .gle-lessons .gadm-mini { padding: 2px 7px; }
    .gle-l-open { font-size: 12px; font-weight: 700; color: var(--english-violet); white-space: nowrap; margin-left: 6px; }
    /* One lesson. */
    .gle-page-bar { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .gle-page-tip { margin: 0; }
    .gle-ws.ws { min-height: 0; background: var(--ws-bg); padding: clamp(14px, 2vw, 26px); border-radius: 8px; }
    .gle-slide > * { animation: none; }
    .gle-body [contenteditable="true"] { border-radius: 3px; outline: 1px dashed transparent; outline-offset: 2px; cursor: text; transition: outline-color .15s, background .15s; }
    .gle-body [contenteditable="true"]:hover { outline-color: rgba(55,30,40,0.35); }
    .gle-body [contenteditable="true"]:focus { outline: 2px solid var(--english-violet); background: rgba(255,255,255,0.7); }
    .gle-body a, .gle-body button { cursor: text; }
    .gle-body [contenteditable="true"]:empty { min-height: 1.6em; }
    .gle-body [contenteditable="true"]:empty::before { content: "Type here"; color: rgba(28,29,34,0.35); }
    /* Parts members open by tapping a card are shown here so their words can be changed. */
    .gle-body .bk-open-body[hidden] { display: block; grid-column: 1 / -1; padding: 14px 16px; border: 1px dashed rgba(55,30,40,0.3); border-radius: 4px; background: rgba(255,255,255,0.6); }
    .gle-body .bk-open-body[hidden]::before { content: "Opens when they tap the card"; display: block; margin-bottom: 6px; font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .gle-walk-note { margin: 18px 0 0; padding: 12px 14px; border: 1px dashed rgba(55,30,40,0.3); border-radius: 4px; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); }
    .gle-walk-note[hidden] { display: none; }
    .gle-html summary { cursor: pointer; font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--english-violet); }
    .gadm .gle-html textarea { width: 100%; box-sizing: border-box; margin-top: 8px; font-family: ui-monospace, Menlo, monospace; font-size: 12.5px; line-height: 1.5; }
    .gadm-toast { position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%); background: var(--ink); color: #fff; padding: 10px 18px; border-radius: 8px; font-family: var(--sans); font-size: 13px; z-index: 100; }
  </style>

  <p class="gadm-toast" id="g-toast" hidden></p>

  <script>
    import { supabase, isConfigured } from "../../lib/supabase.js";
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { GUIDE_TOPIC_LABEL } from "../../data/guide-topics.js";
    import { TRAINING_GUIDES, PRINT_GUIDES, CALENDAR_GUIDES } from "../../data/training-guides.js";
    import { CONTENT_IDEAS_GUIDE } from "../../data/content-ideas-guide.js";
    import { PRINT_MATERIAL_GUIDES } from "../../data/print-materials.js";
    import { copyRowFor } from "../../lib/guide-merge.js";
    /* The courses made with Claude live in the site's code, not the guides
       table, so this list never showed them (Danielle, 20 Nov: "make sure the
       ones we've designed here via Claude, you can also view them from the
       admin center"). They are listed in their own group, read only, with the
       link that opens each as a member sees it. Their words change in code. */
    const BUILT_IN = [...TRAINING_GUIDES, ...CALENDAR_GUIDES, ...PRINT_GUIDES, ...PRINT_MATERIAL_GUIDES, CONTENT_IDEAS_GUIDE]
      .filter((g, i, a) => g && a.findIndex((x) => x.slug === g.slug) === i);
    // The print materials guides are their own A4 pages, not lessons: nothing to copy.
    const canCopy = (g) => !g.href;
    const AUDIENCE = { public: "Everyone (public)", members: "All members", teg: "The Experts Group agents (not Fine & Country)" };
    const builtHref = (g, part) => g.href || `/account/guides/read?g=${encodeURIComponent(g.slug)}${part ? `&p=${part}` : ""}`;
    const builtWhere = (g) => g.held ? "Held off Learn until it launches; opens by its link"
      : (g.topic === "getting-started" ? "Learn, Getting Started" : "Learn, " + GUIDE_TOPIC_LABEL(g.topic));

    const $ = (s) => document.querySelector(s);
    const DEV = import.meta.env.DEV;
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;","\"":"&quot;" }[c]));
    const slugify = (s) => String(s || "").toLowerCase().trim().replace(/[^a-z0-9\s-]/g, "").replace(/\s+/g, "-").replace(/-+/g, "-").slice(0, 80);
    function toast(m){ const t=$("#g-toast"); t.textContent=m; t.hidden=false; clearTimeout(toast._t); toast._t=setTimeout(()=>t.hidden=true,Math.max(2400,String(m).length*70)); }

    let list = [];
    let cur = null;            // current guide id (null = new/unsaved)
    import { WALK_LIST } from "../../data/walkthroughs.js";
    let lessons = [];          // [{ title, body_html, video_url?, walk? }]

    /* ---------- lessons: a list on the course, each opening as its own page ---------- */
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const plainTitle = (t) => String(t || "").replace(/<[^>]+>/g, "").trim();
    let pageAt = -1;            // the lesson open as a page, or -1 for the course
    function renderLessons() {
      const wrap = $("#g-lessons");
      wrap.innerHTML = lessons.map((l, i) => `
        <li data-open="${i}" title="Open this lesson">
          <span class="gle-l-t${plainTitle(l.title) ? "" : " is-empty"}">${esc(plainTitle(l.title) || "Untitled lesson")}</span>
          <button type="button" class="gadm-mini" data-up="${i}" ${i===0?"disabled":""} title="Move up">↑</button>
          <button type="button" class="gadm-mini" data-down="${i}" ${i===lessons.length-1?"disabled":""} title="Move down">↓</button>
          <span class="gle-l-open">Open</span>
        </li>`).join("");
      wrap.querySelectorAll("[data-open]").forEach((li) => li.addEventListener("click", (e) => { if (e.target.closest("[data-up],[data-down]")) return; openPage(+li.dataset.open); }));
      wrap.querySelectorAll("[data-up]").forEach((b) => b.addEventListener("click", () => { const i=+b.dataset.up; [lessons[i-1],lessons[i]]=[lessons[i],lessons[i-1]]; renderLessons(); markDirty(); }));
      wrap.querySelectorAll("[data-down]").forEach((b) => b.addEventListener("click", () => { const i=+b.dataset.down; [lessons[i+1],lessons[i]]=[lessons[i],lessons[i+1]]; renderLessons(); markDirty(); }));
    }
    $("#g-add-lesson").addEventListener("click", () => { lessons.push({ title: "", body_html: "<p></p>" }); renderLessons(); markDirty(); openPage(lessons.length - 1); });

    // The page: the lesson's HTML drawn with the reader's own styles, every
    // run of words editable where it sits. Only the words: an element is
    // editable when it holds text and nothing block-shaped, so a card, a
    // picture or a layout can't be broken by a stray Backspace.
    const BLOCKS = "div,figure,img,ul,ol,p,h1,h2,h3,h4,h5,h6,blockquote,table,section,video,iframe,svg,figcaption,li,button";
    function makeEditable(root) {
      root.querySelectorAll("*").forEach((el) => {
        if (el.closest('[contenteditable="true"]')) return;
        if (/^(IMG|SVG|VIDEO|IFRAME|BR|HR)$/i.test(el.tagName)) return;
        const ownText = [...el.childNodes].some((n) => n.nodeType === 3 && n.textContent.trim());
        // An empty paragraph, heading or list item is a place to type, too.
        const emptyLine = !el.children.length && !el.textContent.trim() && /^(P|H[1-6]|LI|BLOCKQUOTE|FIGCAPTION)$/.test(el.tagName);
        if (!(ownText || emptyLine) || el.querySelector(BLOCKS)) return;
        el.setAttribute("contenteditable", "true");
        el.setAttribute("spellcheck", "true");
      });
    }
    // Back to HTML without the editing marks.
    function pageHtml() {
      const c = $("#g-page-body").cloneNode(true);
      c.querySelectorAll("[contenteditable]").forEach((el) => { el.removeAttribute("contenteditable"); el.removeAttribute("spellcheck"); });
      return c.innerHTML;
    }
    function drawPageBody() {
      const body = $("#g-page-body");
      body.innerHTML = (lessons[pageAt].body_html || "").trim() || "<p></p>";
      makeEditable(body);
    }
    function openPage(i) {
      if (i < 0 || i >= lessons.length) return;
      pageAt = i;
      const l = lessons[i], n = lessons.length;
      $("#g-course").hidden = true; $("#g-page").hidden = false;
      $("#g-page-no").textContent = `Lesson ${i + 1} of ${n}`;
      $("#g-page-part").textContent = $("#g-kind").value === "course" ? `Part ${i + 1} of ${n}` : "";
      $("#g-page-part").hidden = $("#g-kind").value !== "course";
      $("#g-page-title").value = plainTitle(l.title);
      $("#g-page-video").value = l.video_url || "";
      $("#g-page-walk").value = l.walk || "";
      $("#g-page-prev").disabled = i === 0; $("#g-page-next").disabled = i === n - 1;
      $("#g-page-html").value = l.body_html || "";
      drawPageBody(); walkNote();
      const slug = $("#g-slug").value.trim();
      $("#g-open").href = slug ? `/account/guides/read?g=${encodeURIComponent(slug)}&p=${i + 1}` : "#";
      $("#g-edit").scrollIntoView({ block: "start" });
    }
    function closePage() {
      pageAt = -1; $("#g-page").hidden = true; $("#g-course").hidden = false; renderLessons(); setOpenLink();
    }
    function walkNote() {
      const id = $("#g-page-walk").value, w = WALK_LIST.find((x) => x.id === id);
      $("#g-page-walknote").hidden = !w;
      $("#g-page-walknote").textContent = w ? `The "Show me" box for ${w.title} sits here.` : "";
    }
    WALK_LIST.forEach((w) => { const o = document.createElement("option"); o.value = w.id; o.textContent = w.title; $("#g-page-walk").appendChild(o); });
    function syncPage() { if (pageAt < 0) return; lessons[pageAt].body_html = pageHtml(); $("#g-page-html").value = lessons[pageAt].body_html; markDirty(); }
    $("#g-page-body").addEventListener("input", syncPage);
    // Links and buttons in the lesson are words to edit here, not places to go.
    $("#g-page-body").addEventListener("click", (e) => { if (e.target.closest("a,button")) e.preventDefault(); });

    // Emptied boxes go, and Backspace at the start of a paragraph joins it to
    // the one above (a line break, no paragraph gap; Backspace again puts it
    // on the same line). The page always keeps one box to type in.
    const boxes = () => [...$("#g-page-body").querySelectorAll('[contenteditable="true"]')];
    const isBlank = (el) => !el.textContent.trim() && !el.querySelector("img,video,iframe,svg");
    function caretAtStart(el) {
      const s = getSelection();
      if (!s.rangeCount || !s.isCollapsed) return false;
      const r = s.getRangeAt(0), pre = document.createRange();
      pre.selectNodeContents(el); pre.setEnd(r.startContainer, r.startOffset);
      const f = pre.cloneContents();
      return !f.textContent.length && !f.querySelector("br,img");
    }
    function caretTo(el, atEnd) {
      el.focus();
      const r = document.createRange(); r.selectNodeContents(el); r.collapse(!atEnd);
      const s = getSelection(); s.removeAllRanges(); s.addRange(r);
    }
    // Takes a wrapper with it when the box was all it held (a card left with nothing in it).
    function removeBox(el) {
      let n = el;
      while (n.parentElement && n.parentElement.id !== "g-page-body" && n.parentElement.children.length === 1 && isBlank(n.parentElement)) n = n.parentElement;
      n.remove();
    }
    $("#g-page-body").addEventListener("focusout", (e) => {
      const el = e.target.closest && e.target.closest('[contenteditable="true"]');
      if (!el || !el.isConnected || !isBlank(el) || boxes().length < 2) return;
      removeBox(el); syncPage();
    });
    $("#g-page-body").addEventListener("keydown", (e) => {
      const el = e.target.closest('[contenteditable="true"]');
      if (!el) return;
      if (e.key === "Enter") { e.preventDefault(); document.execCommand("insertLineBreak"); return; }
      if (e.key !== "Backspace" || !caretAtStart(el)) return;
      const all = boxes(), i = all.indexOf(el), prev = all[i - 1];
      if (isBlank(el)) {
        if (all.length < 2) return;
        e.preventDefault();
        if (prev) caretTo(prev, true); else if (all[i + 1]) caretTo(all[i + 1], false);
        removeBox(el);
        syncPage(); return;
      }
      // Only paragraph into paragraph (or heading into the same heading), side by side.
      if (!prev || el.previousElementSibling !== prev || prev.tagName !== el.tagName) return;
      e.preventDefault();
      if (prev.lastChild && prev.lastChild.nodeName === "BR") prev.lastChild.remove();
      const br = document.createElement("br"), first = el.firstChild;
      prev.appendChild(br);
      while (el.firstChild) prev.appendChild(el.firstChild);
      prev.focus(); // before the box goes, or focus falls to the page
      el.remove();
      // Caret inside the moved words, so a second Backspace takes the line break.
      const r = document.createRange();
      if (first && first.nodeType === 3) r.setStart(first, 0); else r.setStartAfter(br);
      r.collapse(true);
      const s = getSelection(); s.removeAllRanges(); s.addRange(r);
      syncPage();
    });
    // Pasted words come in plain, so nothing from Word or a web page sneaks in.
    $("#g-page-body").addEventListener("paste", (e) => {
      if (!e.target.closest('[contenteditable="true"]')) return;
      e.preventDefault(); document.execCommand("insertText", false, (e.clipboardData || window.clipboardData).getData("text/plain"));
    });
    $("#g-page-html").addEventListener("change", () => { if (pageAt < 0) return; lessons[pageAt].body_html = $("#g-page-html").value; drawPageBody(); markDirty(); });
    $("#g-page-title").addEventListener("input", () => { if (pageAt < 0) return; lessons[pageAt].title = $("#g-page-title").value; markDirty(); });
    $("#g-page-video").addEventListener("input", () => { if (pageAt < 0) return; lessons[pageAt].video_url = $("#g-page-video").value; markDirty(); });
    $("#g-page-walk").addEventListener("change", () => { if (pageAt < 0) return; lessons[pageAt].walk = $("#g-page-walk").value; walkNote(); markDirty(); });
    $("#g-page-back").addEventListener("click", closePage);
    $("#g-page-prev").addEventListener("click", () => openPage(pageAt - 1));
    $("#g-page-next").addEventListener("click", () => openPage(pageAt + 1));
    $("#g-page-del").addEventListener("click", () => {
      if (pageAt < 0 || !confirm(`Remove lesson ${pageAt + 1}${plainTitle(lessons[pageAt].title) ? `, "${plainTitle(lessons[pageAt].title)}"` : ""}? It goes when you save.`)) return;
      lessons.splice(pageAt, 1); if (!lessons.length) lessons.push({ title: "", body_html: "<p></p>" });
      markDirty(); closePage();
    });

    /* ---------- the cover, changed on the picture ---------- */
    function drawCover() {
      const url = ($("#g-cover").value || "").trim(), box = $("#g-cover-box");
      box.style.backgroundImage = url ? `url('${url.replace(/'/g, "%27")}')` : "";
      box.classList.toggle("has-img", !!url);
    }
    function coverStat(t) { const el = $("#g-cover-stat"); el.textContent = t || ""; el.hidden = !t; }
    $("#g-cover-link").addEventListener("click", () => { const w = $("#g-cover-url-wrap"); w.hidden = !w.hidden; if (!w.hidden) $("#g-cover").focus(); });
    $("#g-cover-clear").addEventListener("click", () => { $("#g-cover").value = ""; drawCover(); coverStat("Cover removed. Members will see the standard Learn picture once you save."); markDirty(); });
    $("#g-cover-file").addEventListener("change", async (e) => {
      const file = e.target.files?.[0]; e.target.value = ""; if (!file) return;
      if (!WORKER) { coverStat("Uploads need the site's Worker address."); return; }
      coverStat("Uploading…");
      try {
        const { data: { session: s } } = await supabase.auth.getSession();
        const fd = new FormData(); fd.append("file", file);
        const res = await fetch(`${WORKER}/admin/upload`, { method: "POST", headers: s?.access_token ? { Authorization: `Bearer ${s.access_token}` } : {}, body: fd });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.url) { coverStat("Upload failed: " + (j.error || ("HTTP " + res.status))); return; }
        $("#g-cover").value = j.url; drawCover(); markDirty();
        const img = new Image();
        img.onload = () => coverStat(img.naturalWidth < 1600 ? `Uploaded. It's ${img.naturalWidth} pixels wide; the cover fills the page, so 1600 or wider looks sharper.` : "Uploaded. Save to keep it.");
        img.onerror = () => coverStat("Uploaded. Save to keep it.");
        img.src = j.url;
      } catch (err) { coverStat("Upload failed: " + (err.message || err)); }
    });
    // The title and summary boxes grow with their words.
    function fit(el) { el.style.height = "auto"; el.style.height = el.scrollHeight + "px"; }
    $("#g-summary").addEventListener("input", () => fit($("#g-summary")));
    function setOpenLink() { const slug = $("#g-slug").value.trim(); $("#g-open").href = slug ? `/account/guides/read?g=${encodeURIComponent(slug)}` : "#"; }

    /* ---------- form <-> state ---------- */
    function setStatusPill(s){ const p=$("#g-status-pill"); p.dataset.status=s; p.textContent=s.charAt(0).toUpperCase()+s.slice(1); }
    let curStatus = "draft", dirty = false, booted = false;
    function markDirty(){ if(booted){ dirty=true; $("#g-saved").textContent="Unsaved changes"; } }

    function showEditor(guide) {
      $("#g-empty").hidden = true; $("#g-built").hidden = true; $("#g-edit").hidden = false;
      cur = guide ? guide.id : null;
      curStatus = guide?.status || "draft";
      $("#g-title").value = guide?.title || "";
      $("#g-slug").value = guide?.slug || "";
      $("#g-topic").value = guide?.topic || "getting-started";
      $("#g-kind").value = guide?.kind || "guide";
      $("#g-audience").value = guide?.audience || "members";
      $("#g-level").value = guide?.level || "free";
      $("#g-mins").value = guide?.est_minutes ?? "";
      $("#g-summary").value = guide?.summary || "";
      $("#g-cover").value = guide?.cover_url || "";
      $("#g-cover-url-wrap").hidden = true; coverStat(""); drawCover();
      lessons = Array.isArray(guide?.lessons) && guide.lessons.length ? JSON.parse(JSON.stringify(guide.lessons)) : [{ title: "", body_html: "<p></p>" }];
      pageAt = -1; $("#g-page").hidden = true; $("#g-course").hidden = false;
      renderLessons(); setStatusPill(curStatus); updateTypeHint(); setOpenLink();
      requestAnimationFrame(() => fit($("#g-summary")));
      $("#g-saved").textContent = guide?.updated_at ? "Saved " + new Date(guide.updated_at).toLocaleString("en-GB",{day:"2-digit",month:"short",hour:"2-digit",minute:"2-digit"}) : "";
      dirty = false;
      document.querySelectorAll(".gadm-item").forEach((el) => el.classList.toggle("is-active", el.dataset.id === (cur||"")));
    }
    // Copy a built-in into the guides table, published with its own words, so
    // nothing changes for members until it is edited here.
    async function copyBuilt(slugs) {
      if (!isConfigured) { toast("Connect Supabase to copy."); return null; }
      const rows = BUILT_IN.filter((g) => slugs.includes(g.slug) && canCopy(g) && !list.some((x) => x.slug === g.slug)).map(copyRowFor);
      if (!rows.length) return null;
      toast("Copying…");
      // One at a time, so one refusal (say the Experts Group audience before
      // guides_audience_teg.sql has run) names itself and the rest still copy.
      const done = [], failed = [];
      for (const row of rows) {
        const { data, error } = await supabase.from("guides").insert(row).select("id,slug").maybeSingle();
        if (error || !data) failed.push(`${row.title}${error ? ` (${error.message})` : ""}`); else done.push(data);
      }
      await loadList();
      if (failed.length) { toast(`Copied ${done.length} of ${rows.length}. Not copied: ${failed.join("; ")}`); return done; }
      toast(rows.length === 1 ? "Copied. You can edit it now." : `${rows.length} courses copied. You can edit them now.`);
      return done;
    }
    $("#g-built-copy").addEventListener("click", async (e) => {
      const done = await copyBuilt([e.currentTarget.dataset.slug]);
      if (done && done[0]) { const { data } = await supabase.from("guides").select("*").eq("id", done[0].id).maybeSingle(); if (data) showEditor(data); }
    });

    function showBuilt(slug) {
      const g = BUILT_IN.find((x) => x.slug === slug); if (!g) return;
      if (dirty && !confirm("Leave without saving your changes?")) return;
      cur = null; dirty = false;
      $("#g-empty").hidden = true; $("#g-edit").hidden = true; $("#g-built").hidden = false;
      const cover = g.cover_url || g.art || "";
      const c = $("#g-built-cover"); c.hidden = !cover; c.style.backgroundImage = cover ? `url('${cover.replace(/'/g, "%27")}')` : "";
      $("#g-built-title").textContent = g.title || "Untitled";
      $("#g-built-sum").textContent = g.summary || "";
      const lessons = Array.isArray(g.lessons) ? g.lessons : [];
      const brands = Array.isArray(g.brands) && g.brands.length ? g.brands.join(", ") + " agents" : "";
      const facts = [
        ["Type", g.kind === "course" ? "Course" : "Article"],
        ["Topic", GUIDE_TOPIC_LABEL(g.topic)],
        ["Who sees it", brands || AUDIENCE[g.audience || "members"] || "All members"],
        ["Where", builtWhere(g)],
        ["Length", g.est_minutes ? `About ${g.est_minutes} minutes` : (lessons.length ? `${lessons.length} lessons` : "")],
      ].filter((f) => f[1]);
      $("#g-built-facts").innerHTML = facts.map(([k, v]) => `<div><dt>${esc(k)}</dt><dd>${esc(v)}</dd></div>`).join("");
      $("#g-built-note").textContent = list.some((x) => x.slug === g.slug) ? "A database guide has the same link and shows instead of this one" : "";
      $("#g-built-open").href = builtHref(g);
      $("#g-built-copy").hidden = !canCopy(g);
      $("#g-built-copy").dataset.slug = g.slug;
      if (!canCopy(g)) $("#g-built-note").textContent = "Its own pages; its words change in the site's code";
      $("#g-built-lessons").innerHTML = lessons.length
        ? lessons.map((l, i) => `<li><span>${esc((l.title || "").replace(/<[^>]+>/g, "") || "Untitled lesson")}</span>${g.href ? "" : `<a href="${esc(builtHref(g, i + 1))}" target="_blank" rel="noopener">Open</a>`}</li>`).join("")
        : `<li><span>Its own pages, opened with the button above</span></li>`;
      document.querySelectorAll(".gadm-item").forEach((el) => el.classList.toggle("is-active", el.dataset.built === g.slug));
    }

    ["g-title","g-slug","g-topic","g-kind","g-audience","g-level","g-mins","g-summary","g-cover"].forEach((id) => {
      const el = $("#"+id); const ev = el.tagName === "SELECT" ? "change" : "input";
      el.addEventListener(ev, () => { if(id==="g-title" && !cur && !$("#g-slug").value) $("#g-slug").value = slugify($("#g-title").value); if(id==="g-kind") updateTypeHint(); if(id==="g-cover") drawCover(); if(id==="g-slug") setOpenLink(); markDirty(); });
    });

    // One-line reminder of what the chosen Type gives you in the hub.
    function updateTypeHint() {
      const isCourse = $("#g-kind").value === "course";
      $("#g-type-hint").textContent = isCourse
        ? "Course — plays as a click-through mini-deck: one lesson per slide, with a progress bar members can resume."
        : "Article — one flowing page, like a quick how-to read.";
    }

    function gather() {
      const cleanLessons = lessons.map((l) => {
        const row = { title: (l.title||"").trim(), body_html: (l.body_html||"").trim() };
        if ((l.video_url || "").trim()) row.video_url = l.video_url.trim();
        if (l.walk) row.walk = l.walk;
        return row;
      }).filter((l) => l.title || l.body_html);
      return {
        title: ($("#g-title").value || "").trim() || "Untitled guide",
        slug: slugify($("#g-slug").value || $("#g-title").value || "guide-" + Date.now()),
        topic: $("#g-topic").value, kind: $("#g-kind").value, audience: $("#g-audience").value,
        level: $("#g-level").value,
        est_minutes: $("#g-mins").value ? Number($("#g-mins").value) : null,
        summary: ($("#g-summary").value || "").trim() || null,
        cover_url: ($("#g-cover").value || "").trim() || null,
        lessons: cleanLessons, status: curStatus,
      };
    }

    async function save(newStatus) {
      if (!isConfigured) { toast("Connect Supabase to save."); return; }
      if (newStatus) { curStatus = newStatus; setStatusPill(curStatus); }
      const payload = gather();
      toast("Saving…");
      const q = cur
        ? supabase.from("guides").update(payload).eq("id", cur).select().maybeSingle()
        : supabase.from("guides").insert(payload).select().maybeSingle();
      let { data, error } = await q;
      // Before supabase/content_calendar_months.sql has run there is no level column.
      if (error && /level/i.test(error.message || "")) {
        delete payload.level;
        ({ data, error } = await (cur
          ? supabase.from("guides").update(payload).eq("id", cur).select().maybeSingle()
          : supabase.from("guides").insert(payload).select().maybeSingle()));
      }
      if (error) { toast("Save failed: " + error.message); return; }
      cur = data.id; dirty = false; $("#g-saved").textContent = "All changes saved";
      toast(newStatus === "published" ? "Published ✓" : "Saved ✓");
      await loadList();
      document.querySelectorAll(".gadm-item").forEach((el) => el.classList.toggle("is-active", el.dataset.id === cur));
    }
    $("#g-save").addEventListener("click", () => save());
    $("#g-publish").addEventListener("click", () => save("published"));
    $("#g-delete").addEventListener("click", async () => {
      if (!cur) { $("#g-edit").hidden = true; $("#g-empty").hidden = false; return; }
      if (!confirm("Delete this guide? This can't be undone.")) return;
      const { error } = await supabase.from("guides").delete().eq("id", cur);
      if (error) { toast("Delete failed: " + error.message); return; }
      toast("Deleted"); cur = null; $("#g-edit").hidden = true; $("#g-empty").hidden = false; await loadList();
    });
    $("#g-new").addEventListener("click", () => showEditor(null));
    $("#g-new-2").addEventListener("click", () => showEditor(null));

    /* ---------- list ---------- */
    async function loadList() {
      if (!isConfigured) { $("#g-items").innerHTML = '<p class="gadm-muted">Connect Supabase to manage guides.</p>'; return; }
      const { data, error } = await supabase.from("guides")
        .select("id,slug,title,topic,kind,status,updated_at,sort_order")
        .order("sort_order", { ascending: true }).order("updated_at", { ascending: false });
      if (error) { $("#g-items").innerHTML = '<p class="gadm-muted">Could not load guides.</p>'; return; }
      list = data || [];
      const notCopied = BUILT_IN.filter((g) => !list.some((x) => x.slug === g.slug));
      const copyable = notCopied.filter(canCopy);
      const builtHtml = (copyable.length > 1 ? `<button type="button" class="gadm-new gadm-copyall" id="g-copy-all">Copy all ${copyable.length} to edit</button>` : "") + notCopied.map((g) => `
        <button type="button" class="gadm-item" data-built="${esc(g.slug)}">
          <span class="gadm-item-t">${esc(g.title || "Untitled")}${Array.isArray(g.brands) && g.brands.length ? ", " + esc(g.brands.join(", ")) : ""}</span>
          <span class="gadm-item-m"><span class="gadm-dot ${g.held ? "is-draft" : "is-published"}"></span>${g.held ? "held" : "built in"} · ${esc(GUIDE_TOPIC_LABEL(g.topic))} · ${g.kind==="course"?"Course":"Article"}</span>
        </button>`).join("");
      $("#g-items").innerHTML = (notCopied.length ? '<p class="gadm-group">Made with Claude, not copied yet</p>' + builtHtml : "") + '<p class="gadm-group">Editable here</p>' + (list.length ? list.map((g) => `
        <button type="button" class="gadm-item${g.id===cur?" is-active":""}" data-id="${g.id}">
          <span class="gadm-item-t">${esc(g.title || "Untitled")}</span>
          <span class="gadm-item-m"><span class="gadm-dot is-${g.status}"></span>${g.status}${BUILT_IN.some((b) => b.slug === g.slug && b.held) ? " · held off Learn" : ""} · ${esc(GUIDE_TOPIC_LABEL(g.topic))} · ${g.kind==="course"?"Course":"Article"}</span>
        </button>`).join("") : '<p class="gadm-muted">No guides yet. Click “+ New”.</p>');
      $("#g-copy-all")?.addEventListener("click", () => copyBuilt(copyable.map((g) => g.slug)));
      $("#g-items").querySelectorAll(".gadm-item[data-built]").forEach((el) => el.addEventListener("click", () => showBuilt(el.dataset.built)));
      $("#g-items").querySelectorAll(".gadm-item[data-id]").forEach((el) => el.addEventListener("click", async () => {
        const { data } = await supabase.from("guides").select("*").eq("id", el.dataset.id).maybeSingle();
        if (data) showEditor(data);
      }));
    }

    (async () => {
      let session;
      if (DEV) session = (await supabase.auth.getSession()).data.session || { user: { id: "dev", email: "dev@tmke.co.uk" } };
      else { session = await requireAdmin("/admin/login"); if (!session) return; }
      await loadList();
      booted = true;
    })();
  </script>
</AdminShell>
