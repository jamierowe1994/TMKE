---
// Creative Studio (Dani, 8 Nov 2026): the Library, Client portals, Video editing
// and Photo editing in one place. Kept at /admin/content because every "Open in
// Library" link in the admin already points here. The files are the same objects
// in the same R2 bucket the deliveries use; nothing is copied to make this work.
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
import "../../styles/creative-studio.css";
---

<AdminShell active="content" title="Creative Studio" skin="hub">
  <div class="cs">
    <header class="cs-head">
      <div class="cs-h1">Creative Studio</div>
      <nav class="cs-tabs" id="cs-tabs" aria-label="Creative Studio">
        <button type="button" data-v="library">Library</button>
        <button type="button" data-v="portals">Client portals</button>
        <button type="button" data-v="video">Video editing</button>
        <button type="button" data-v="photo">Photo editing</button>
      </nav>
    </header>
    <div class="cs-page" id="cs-v-library"></div>
    <div class="cs-page" id="cs-v-portals" hidden></div>
    <div class="cs-page" id="cs-v-video" hidden>
      <div class="cs-soon">
        <img src="/assets/hub/studio.jpg" alt="" />
        <div class="cs-soon-t">
          <div class="cs-soon-h">Video editing</div>
          <p>Coming soon</p>
          <p style="opacity:.75">Captions stay in Videography, Settings, Video captions until then.</p>
        </div>
      </div>
    </div>
    <div class="cs-page" id="cs-v-photo" hidden></div>
    <div id="cs-popup"></div>
    <input type="file" id="cs-file" multiple hidden />
    <div id="cs-toast" hidden role="status"></div>
  </div>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { $, $$, hooks, WORKER } from "../../lib/creative-studio/common.js";
    import { startLibrary, drawLibrary } from "../../lib/creative-studio/library.js";
    import { startPortals } from "../../lib/creative-studio/portals.js";
    import { photoOpen, editPhotos } from "../../lib/creative-studio/photo.js";

    const VIEWS = ["library", "portals", "video", "photo"];
    let portalsStarted = false;
    function show(v) {
      if (!VIEWS.includes(v)) v = "library";
      VIEWS.forEach((x) => ($("#cs-v-" + x).hidden = x !== v));
      $$("#cs-tabs button").forEach((b) => b.classList.toggle("on", b.dataset.v === v));
      if (location.hash.slice(1) !== v) history.replaceState(null, "", location.pathname + location.search + "#" + v);
      if (v === "photo") photoOpen();
      if (v === "portals" && !portalsStarted) { portalsStarted = true; startPortals(); }
    }
    hooks.show = show;
    hooks.editPhotos = editPhotos;
    hooks.drawLibrary = drawLibrary;
    $$("#cs-tabs button").forEach((b) => (b.onclick = () => show(b.dataset.v)));
    addEventListener("hashchange", () => show(location.hash.slice(1)));

    (async () => {
      const session = await requireAdmin();
      if (!session) return;
      if (!WORKER) { $("#cs-v-library").textContent = "Storage isn't configured (PUBLIC_R2_WORKER_URL)."; return; }
      show(location.hash.slice(1) || "library");
      startLibrary(new URLSearchParams(location.search).get("folder"));
    })();
  </script>
</AdminShell>
