---
import AdminShell from "../../components/admin/AdminShell.astro";
import StudioBar from "../../components/admin/StudioBar.astro";
import "../../styles/admin.css";
---

<AdminShell active="studio" title="Uploaded fonts" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Uploaded fonts</div>
          <div class="page-header-sub">Typefaces that aren't on Google Fonts. Upload one here and it sits at the top of every font picker in the Studio — yours and every member's — so a brand whose font we can't link to can still be set in it.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="ash-panel ash-page">
  <StudioBar active="fonts" countId="font-count">
    <Fragment slot="actions">
      <button type="button" id="upload-btn" class="admin-btn admin-btn-primary">+ Upload font</button>
      <input type="file" id="font-input" multiple accept=".ttf,.otf,.woff,.woff2,font/ttf,font/otf,font/woff,font/woff2,application/font-sfnt,application/x-font-ttf,application/x-font-opentype" hidden />
    </Fragment>
  </StudioBar>

  <section class="font-list">
    <p class="font-loading" id="font-loading">Loading custom fonts…</p>
    <p class="font-empty" id="font-empty" hidden>
      No custom fonts yet — click <strong>+ Upload font</strong> to add your brand typeface. Accepts <code>.ttf</code>, <code>.otf</code>, <code>.woff</code>, <code>.woff2</code>.
    </p>
    <div class="font-grid" id="font-grid"></div>
  </section>
  </div>

  <!-- Modal: optional metadata after picking a file -->
  <div class="modal-backdrop" id="meta-modal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="meta-title">
      <header class="modal-head">
        <h2 id="meta-title">New font</h2>
        <button type="button" class="modal-close" id="meta-close" aria-label="Close">&times;</button>
      </header>
      <form id="meta-form" class="meta-form" novalidate>
        <label class="field">
          <span>Font family name</span>
          <input type="text" name="family" required maxlength="80" />
          <small>One name for the whole family — <em>The Seasons</em>, not <em>TheSeasons-BoldItalic</em>. Every file below is filed under it.</small>
        </label>
        <label class="field">
          <span>Display name (optional)</span>
          <input type="text" name="display_name" maxlength="80" />
          <small>How it appears in the font picker. Defaults to the family above.</small>
        </label>
        <div class="field">
          <span>The files</span>
          <div class="meta-files" id="meta-files"></div>
          <small>A family is one font with several cuts in it. Upload every cut under the same family name and the Studio shows one font that can be bolded and italicised — the weights are read from the filenames, so check them here.</small>
        </div>
        <p class="form-error" id="meta-error" hidden></p>
        <footer class="modal-foot">
          <button type="button" class="admin-btn admin-btn-ghost" id="meta-cancel">Cancel</button>
          <button type="submit" class="admin-btn admin-btn-primary" id="meta-save">Save</button>
        </footer>
      </form>
    </div>
  </div>

  <style is:global>

    .admin-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      max-width: 1360px;
      margin: 0 auto;
      padding: 12px 36px 0;
    }
    .admin-back {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--english-violet);
      text-decoration: none;
      font-weight: 700;
    }
    .admin-back:hover { color: var(--ink); }
    .admin-bar-actions { display: flex; align-items: center; gap: 12px; }
    .admin-bar-count {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.6);
      font-weight: 600;
    }

    .admin-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 2px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid transparent;
      text-decoration: none;
    }
    .admin-btn-primary { background: var(--english-violet); color: var(--paper); }
    .admin-btn-primary:hover { background: var(--ink); }
    .admin-btn-ghost { background: transparent; border-color: rgba(var(--violet-rgb), 0.4); color: var(--english-violet); }
    .admin-btn-ghost:hover { background: rgba(var(--violet-rgb), 0.06); }
    .admin-btn-danger { background: transparent; border-color: #a05a3c; color: #a05a3c; }
    .admin-btn-danger:hover { background: #a05a3c; color: var(--paper); }
    .admin-btn[disabled] { opacity: 0.55; cursor: progress; }

    .font-list {
      max-width: 1360px;
      margin: 0 auto;
      padding: 24px 36px 200px;
    }
    .font-loading {
      font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.5);
      padding: 24px 0;
    }
    .font-empty {
      padding: 32px;
      border: 1px dashed rgba(var(--violet-rgb),0.4);
      border-radius: 2px;
      font-family: var(--sans);
      color: rgba(28,29,34,0.7);
      max-width: 620px;
    }
    .font-empty strong { color: var(--ink); }
    .font-empty code {
      background: rgba(28,29,34,0.06);
      padding: 2px 6px; border-radius: 2px;
      font-size: 12px;
    }

    .font-grid { display: block; }
    .font-family { margin-bottom: 30px; }
    .font-family-head {
      display: flex; align-items: baseline; gap: 12px;
      margin-bottom: 12px; padding-bottom: 9px;
      border-bottom: 1px solid rgba(28,29,34,0.12);
    }
    .font-family-name { font-family: var(--serif); font-size: 21px; color: var(--ink); }
    .font-family-count {
      font-family: var(--sans); font-size: 10.5px; font-weight: 600;
      letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.45);
    }
    .font-family-cuts {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
    }
    @media (max-width: 720px) { .font-family-cuts { grid-template-columns: 1fr; } }

    /* One file in the upload sheet: its name, and the cut we read from it. */
    .meta-files { display: flex; flex-direction: column; gap: 8px; margin: 4px 0 8px; }
    .meta-file {
      display: grid; grid-template-columns: minmax(0, 1fr) auto auto; gap: 8px; align-items: center;
    }
    .meta-file-name {
      font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.65);
      overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .meta-file select {
      font-family: var(--sans); font-size: 12px; padding: 6px 8px;
      border: 1px solid rgba(28,29,34,0.18); border-radius: 5px; background: #fff;
    }

    .font-card {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      /* Delete sits bottom-right, its baseline with the font's details, rather
         than floating in the middle of the card. */
      align-items: end;
      gap: 14px;
      padding: 20px 22px;
      border: 1px solid rgba(var(--violet-rgb),0.3);
      border-radius: 2px;
      background: rgba(255,255,255,0.5);
      min-width: 0;
    }
    /* The specimen has to FIT the card — two cards across the page — so it is
       sized to the column rather than set at a fixed 28px that pushed the
       sentence out of its own box. */
    .font-preview {
      font-size: clamp(12px, 4.4cqw, 26px);
      line-height: 1.15;
      color: var(--ink);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      margin-bottom: 2px;
    }
    .font-card > div:first-child { min-width: 0; container-type: inline-size; }
    .font-meta {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-top: 6px;
      font-family: var(--sans);
      font-size: 11px;
      color: rgba(28,29,34,0.55);
      letter-spacing: 0.04em;
    }
    .font-meta-name {
      font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--english-violet);
    }

    /* Modal */
    .modal-backdrop {
      position: fixed; inset: 0;
      background: rgba(28,29,34,0.55);
      display: flex; align-items: flex-start; justify-content: center;
      padding: 8vh 16px;
      z-index: 100;
      overflow-y: auto;
    }
    .modal-backdrop[hidden] { display: none; }
    .modal {
      width: 100%; max-width: 520px;
      background: var(--paper);
      border-radius: 2px;
      box-shadow: 0 30px 80px rgba(0,0,0,0.25);
    }
    .modal-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 18px 22px;
      border-bottom: 1px solid rgba(var(--violet-rgb),0.18);
    }
    .modal-head h2 {
      font-family: var(--serif); font-size: 24px; font-weight: 500; margin: 0;
    }
    .modal-close {
      background: none; border: none; font-size: 26px;
      color: var(--english-violet); cursor: pointer; line-height: 1;
    }
    .meta-form {
      display: flex; flex-direction: column; gap: 14px;
      padding: 18px 22px 4px;
    }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field > span {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--english-violet);
    }
    .field input,
    .field select {
      font-family: var(--sans);
      font-size: 14px;
      padding: 9px 12px;
      border: 1px solid rgba(var(--violet-rgb), 0.3);
      border-radius: 2px;
      background: #fff;
      color: var(--ink);
      outline: none;
      width: 100%;
      box-sizing: border-box;
    }
    .field small { font-size: 11px; color: rgba(28,29,34,0.55); }
    .field-row {
      display: grid; grid-template-columns: 1fr 1fr; gap: 12px;
    }
    .form-error {
      margin: 0;
      padding: 8px 10px;
      background: rgba(160, 90, 60, 0.1);
      border-left: 3px solid #a05a3c;
      color: #a05a3c;
      font-size: 13px;
      font-family: var(--sans);
    }
    .modal-foot {
      display: flex; justify-content: flex-end; gap: 10px;
      padding: 18px 22px 22px;
      border-top: 1px solid rgba(var(--violet-rgb),0.15);
      margin-top: 8px;
    }
  </style>

  <script>
    import { requireAdmin } from '../../lib/admin-gate.js';
    import { supabase } from '../../lib/supabase.js';

    const BUCKET = 'brand-fonts';

    const els = {
      grid: document.getElementById('font-grid'),
      loading: document.getElementById('font-loading'),
      empty: document.getElementById('font-empty'),
      count: document.getElementById('font-count'),
      uploadBtn: document.getElementById('upload-btn'),
      fileInput: document.getElementById('font-input'),
      modal: document.getElementById('meta-modal'),
      modalClose: document.getElementById('meta-close'),
      modalCancel: document.getElementById('meta-cancel'),
      metaForm: document.getElementById('meta-form'),
      metaError: document.getElementById('meta-error'),
      metaSave: document.getElementById('meta-save'),
    };

    let pendingFiles = [];
    const _registered = new Set();

    /* Read a font's cut from its filename. "TheSeasons-BoldItalic.otf" is a
       bold italic of The Seasons, and typing that in eleven times by hand is
       how a family ends up with three spellings and a wrong weight. Detected,
       then shown for checking — never silently trusted. */
    const WEIGHTS = [
      [/\b(extra|ultra)[-_ ]?black\b|\bultra\b/i, 900],
      [/\bblack\b|\bheavy\b/i, 900],
      [/\b(extra|ultra)[-_ ]?bold\b|\bxbold\b|\bebold\b/i, 800],
      [/\bsemi[-_ ]?bold\b|\bdemi[-_ ]?bold\b|\bsbold\b/i, 600],
      [/\bbold\b|\bbd\b/i, 700],
      [/\bmedium\b|\bmed\b/i, 500],
      [/\b(extra|ultra)[-_ ]?light\b|\bxlight\b/i, 200],
      [/\blight\b|\blt\b/i, 300],
      [/\bthin\b|\bhairline\b/i, 100],
      [/\bregular\b|\bnormal\b|\bbook\b|\breg\b|\brg\b/i, 400],
    ];

    function parseFontFile(name) {
      const stem = String(name || '').replace(/\.(ttf|otf|woff2?)$/i, '');
      // The cut usually follows a dash or an underscore: TheSeasons-BoldItalic.
      const parts = stem.split(/[-_]/);
      const head = parts.shift() || stem;
      const tail = parts.join(' ');
      const hay = ' ' + tail.replace(/([a-z])([A-Z])/g, '$1 $2') + ' ';
      const italic = /\b(italic|oblique|it|bdit|ltit)\b/i.test(hay);
      let weight = 400;
      for (const [re, w] of WEIGHTS) { if (re.test(hay)) { weight = w; break; } }
      // "TheSeasons" is The Seasons; a name someone already spaced is left alone.
      const family = head.replace(/([a-z0-9])([A-Z])/g, '$1 $2').replace(/\s+/g, ' ').trim();
      return { family, weight, style: italic ? 'italic' : 'normal' };
    }

    const WEIGHT_NAMES = {
      100: 'Thin', 200: 'Extra Light', 300: 'Light', 400: 'Regular', 500: 'Medium',
      600: 'Semibold', 700: 'Bold', 800: 'Extra Bold', 900: 'Black',
    };

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    function registerFontFace(f) {
      // Register the font with the document so the preview row paints in
      // the correct typeface and editor pages downstream pick it up too.
      if (_registered.has(f.id)) return;
      _registered.add(f.id);
      try {
        const face = new FontFace(f.family, `url("${f.file_url}")`, {
          weight: String(f.weight || 400),
          style: f.style || 'normal',
          display: 'swap',
        });
        face.load().then((loaded) => document.fonts.add(loaded)).catch(() => {});
      } catch (_) {}
    }

    function renderCard(f) {
      const label = f.display_name || f.family;
      const weightLabel = ({
        100: 'Thin', 200: 'Extra Light', 300: 'Light', 400: 'Regular',
        500: 'Medium', 600: 'Semibold', 700: 'Bold', 800: 'Extra Bold', 900: 'Black',
      })[f.weight] || ('Weight ' + f.weight);
      return `
        <article class="font-card" data-id="${f.id}">
          <div>
            <div class="font-preview" style="font-family: '${escapeHtml(f.family)}', sans-serif; font-weight: ${f.weight || 400}; font-style: ${f.style || 'normal'};">
              The quick brown fox jumps over the lazy dog.
            </div>
            <div class="font-meta">
              <span class="font-meta-name">${weightLabel}${f.style === 'italic' ? ' Italic' : ''}</span>
              <span>${escapeHtml(f.family)} · ${f.weight}</span>
            </div>
          </div>
          <button class="admin-btn admin-btn-danger admin-btn-sm" data-delete="${f.id}" data-path="${escapeHtml(f.file_url)}">Delete</button>
        </article>
      `;
    }

    async function loadFonts() {
      els.loading.hidden = false;
      const { data, error } = await supabase
        .from('brand_fonts')
        .select('*')
        .order('family', { ascending: true })
        .order('weight', { ascending: true });

      els.loading.hidden = true;

      if (error) {
        els.grid.innerHTML = `<p>Could not load fonts: ${escapeHtml(error.message)}</p>`;
        return;
      }

      const fonts = data ?? [];
      fonts.forEach(registerFontFace);
      const families = new Set(fonts.map((f) => f.family)).size;
      els.count.textContent = fonts.length
        ? `${families} font${families === 1 ? '' : 's'} · ${fonts.length} cut${fonts.length === 1 ? '' : 's'}`
        : '0 fonts';
      els.empty.hidden = fonts.length !== 0;
      // Grouped by family, because that is what a font IS: one name with
      // several cuts under it, not six fonts that look alike.
      const byFamily = new Map();
      fonts.forEach((f) => {
        if (!byFamily.has(f.family)) byFamily.set(f.family, []);
        byFamily.get(f.family).push(f);
      });
      const order = { normal: 0, italic: 1 };
      els.grid.innerHTML = [...byFamily.entries()].map(([family, cuts]) => {
        cuts.sort((a, b) => (a.weight - b.weight) || (order[a.style] - order[b.style]));
        const label = cuts[0].display_name || family;
        return `<section class="font-family">
          <div class="font-family-head">
            <span class="font-family-name">${escapeHtml(label)}</span>
            <span class="font-family-count">${cuts.length} cut${cuts.length === 1 ? '' : 's'}</span>
          </div>
          <div class="font-family-cuts">${cuts.map(renderCard).join('')}</div>
        </section>`;
      }).join('');
    }

    function openModal(files) {
      pendingFiles = Array.from(files || []);
      if (!pendingFiles.length) return;
      els.metaError.hidden = true;
      els.metaForm.reset();

      const parsed = pendingFiles.map((f) => parseFontFile(f.name));
      // The family they share. If the files disagree, the commonest wins and
      // she corrects it once instead of eleven times.
      const tally = {};
      parsed.forEach((p) => { if (p.family) tally[p.family] = (tally[p.family] || 0) + 1; });
      const family = Object.keys(tally).sort((a, b) => tally[b] - tally[a])[0] || 'Custom font';
      els.metaForm.elements.family.value = family;

      document.getElementById('meta-files').innerHTML = pendingFiles.map((f, i) => `
        <div class="meta-file" data-i="${i}">
          <span class="meta-file-name" title="${escapeHtml(f.name)}">${escapeHtml(f.name)}</span>
          <select data-weight="${i}">
            ${[100, 200, 300, 400, 500, 600, 700, 800, 900].map((w) =>
              `<option value="${w}"${w === parsed[i].weight ? ' selected' : ''}>${WEIGHT_NAMES[w]} · ${w}</option>`).join('')}
          </select>
          <select data-style="${i}">
            <option value="normal"${parsed[i].style === 'normal' ? ' selected' : ''}>Normal</option>
            <option value="italic"${parsed[i].style === 'italic' ? ' selected' : ''}>Italic</option>
          </select>
        </div>`).join('');

      document.getElementById('meta-title').textContent =
        pendingFiles.length === 1 ? 'New font' : `${pendingFiles.length} font files`;
      els.modal.hidden = false;
      els.metaForm.elements.family.focus();
    }
    function closeModal() {
      els.modal.hidden = true;
      pendingFiles = [];
    }

    async function uploadFont(e) {
      e.preventDefault();
      if (!pendingFiles.length) return;
      els.metaError.hidden = true;
      els.metaSave.setAttribute('disabled', 'true');

      try {
        const fd = new FormData(els.metaForm);
        const family = String(fd.get('family') || '').trim();
        const displayName = String(fd.get('display_name') || '').trim();
        if (!family) throw new Error('Family name is required.');

        const rows = [];
        for (let i = 0; i < pendingFiles.length; i++) {
          const file = pendingFiles[i];
          els.metaSave.textContent = pendingFiles.length > 1
            ? `Uploading ${i + 1} of ${pendingFiles.length}…`
            : 'Uploading…';

          const weight = parseInt(document.querySelector(`[data-weight="${i}"]`)?.value, 10) || 400;
          const style = document.querySelector(`[data-style="${i}"]`)?.value || 'normal';
          const ext = (file.name.split('.').pop() || 'ttf').toLowerCase();
          const path = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;

          const { error: upErr } = await supabase.storage
            .from(BUCKET)
            .upload(path, file, {
              cacheControl: '31536000', // 1 year — fonts rarely change once uploaded
              contentType: file.type || `font/${ext}`,
              upsert: false,
            });
          if (upErr) throw new Error(`${file.name}: ${upErr.message}`);

          const { data: pub } = supabase.storage.from(BUCKET).getPublicUrl(path);
          rows.push({
            family,
            display_name: displayName || null,
            file_url: pub.publicUrl,
            weight,
            style,
          });
        }

        els.metaSave.textContent = 'Saving…';
        const { error: insErr } = await supabase.from('brand_fonts').insert(rows);
        if (insErr) throw insErr;

        closeModal();
        await loadFonts();
      } catch (err) {
        els.metaError.textContent = err.message || 'Upload failed.';
        els.metaError.hidden = false;
      } finally {
        els.metaSave.removeAttribute('disabled');
        els.metaSave.textContent = 'Save';
      }
    }

    async function deleteFont(id, fileUrl) {
      if (!confirm('Delete this font? Designs that use it will lose their typeface.')) return;
      try {
        // Best-effort delete from storage too — extract path from public URL.
        // Public URLs look like .../storage/v1/object/public/brand-fonts/<path>
        const m = (fileUrl || '').match(/\/object\/public\/brand-fonts\/(.+)$/);
        const path = m ? decodeURIComponent(m[1]) : null;
        if (path) await supabase.storage.from(BUCKET).remove([path]);
        const { error } = await supabase.from('brand_fonts').delete().eq('id', id);
        if (error) throw error;
        await loadFonts();
      } catch (err) {
        alert(`Delete failed: ${err.message || err}`);
      }
    }

    // ===== Wire-up =====
    (async () => {
      const session = await requireAdmin();
      if (!session) return;
      await loadFonts();
    })();

    els.uploadBtn.addEventListener('click', () => els.fileInput.click());
    els.fileInput.addEventListener('change', (e) => {
      const files = Array.from(e.target.files || []);
      els.fileInput.value = '';
      if (!files.length) return;
      openModal(files);
    });

    els.modalClose.addEventListener('click', closeModal);
    els.modalCancel.addEventListener('click', closeModal);
    els.modal.addEventListener('click', (e) => {
      if (e.target === els.modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !els.modal.hidden) closeModal();
    });

    els.metaForm.addEventListener('submit', uploadFont);

    els.grid.addEventListener('click', (e) => {
      const t = e.target;
      if (!(t instanceof HTMLElement)) return;
      const id = t.getAttribute('data-delete');
      const path = t.getAttribute('data-path');
      if (id) deleteFont(id, path);
    });
  </script>
</AdminShell>
