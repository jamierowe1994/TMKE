---
// Email › Automations (Danielle, 25 Nov 2026; agreed on the "TMKE OS Email"
// mock-up). Emails that send themselves when something happens: the system
// workflows built in the step builder, and the built-in emails the platform
// sends. Marketing funnels moved to Email › Campaigns
// (/admin/email/campaigns); which page a funnel is on is the builder's own
// Marketing / Service answer (src/lib/email-campaigns.js).
import AdminShell from "../../../components/admin/AdminShell.astro";
import EmailTabs from "../../../components/admin/EmailTabs.astro";
import "../../../styles/money-os.css";
import { EMAIL_CATALOG, EMAIL_GROUPS } from "../../../lib/email-catalog.js";

const builtIn = EMAIL_GROUPS.map((group) => {
  const items = EMAIL_CATALOG.filter((e) => e.group === group);
  return { group, count: items.length, names: items.slice(0, 3).map((e) => e.name).join(", ") + (items.length > 3 ? ", and more" : "") };
}).filter((g) => g.count);
const builtInTotal = builtIn.reduce((n, g) => n + g.count, 0);
---

<AdminShell active="automations" title="Automations" skin="hub">
  <div class="ash-panel ash-page">
    <div class="mo" id="ea">
      <section class="mo-head">
        <div>
          <p class="mo-eye">Email</p>
          <div class="mo-title">Automations</div>
          <p class="mo-sub">Emails that send themselves when something happens in the Studio or the business. Nobody presses send.</p>
        </div>
        <div class="mo-acts">
          <a class="mbtn" href="/admin/email/styles">Email styles</a>
          <button type="button" class="mbtn" id="ea-sync" title="Pull new Pro/Academy starters from the TEG sheet and enrol them">Sync new starters</button>
          <button type="button" class="mbtn primary" id="ea-new">New automation</button>
        </div>
      </section>
      <EmailTabs active="automations" />

      <div class="section">
        <div class="strip"><span class="strip-t">Automations you built<span id="ea-n"></span></span></div>
        <p class="state" id="ea-state">Reading the automations.</p>
        <div id="ea-main" hidden></div>
      </div>

      <div class="section">
        <div class="strip"><span class="strip-t">Built-in emails<span>{builtInTotal}</span></span><a class="ea-all" href="/admin/email/automated">See them all</a></div>
        <div class="tablewrap">
          <table class="ea-tbl">
            <tbody>
              {builtIn.map((g) => (
                <tr>
                  <td><div class="ea-rowname"><b>{g.group}</b><span>{g.names}</span></div></td>
                  <td class="tx">{g.count} {g.count === 1 ? "email" : "emails"}</td>
                  <td class="ea-acts"><a class="mbtn small" href="/admin/email/automated">View</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <div class="toast" id="ea-toast" role="status" aria-live="polite"></div>
    </div>
  </div>

  <style is:global>
    #ea .mo-head { margin-bottom: 14px; }
    #ea .strip .ea-all { color: #fff; text-underline-offset: 3px; }
    #ea .blk { display: inline-flex; align-items: center; justify-content: center; width: 104px; height: 24px; border-radius: 4px; font-size: 13px; white-space: nowrap; }
    #ea .blk.run { background: var(--good-l); color: var(--good); }
    #ea .blk.pause { background: var(--stone); color: var(--wine); }
    #ea .blk.plan, #ea .blk.end { background: #fff; color: var(--tx); box-shadow: inset 0 0 0 1px var(--edge); }
    #ea table.ea-tbl td { height: 56px; }
    #ea .ea-rowname { display: grid; gap: 2px; line-height: 1.2; padding: 8px 0; white-space: normal; }
    #ea .ea-rowname a, #ea .ea-rowname b { font-size: 16px; font-weight: 400; color: var(--ink); text-decoration: none; }
    #ea .ea-rowname a:hover { color: var(--wine); text-decoration: underline; text-underline-offset: 3px; }
    #ea .ea-rowname span { font-size: 13px; color: var(--tx); }
    #ea .ea-k { display: block; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--tx); }
    #ea td.ea-acts { text-align: right; }
    #ea td.ea-acts .mbtn { margin-left: 6px; }
    #ea .mbtn.small { height: 26px; padding: 0 10px; }
    #ea .state { padding: 26px 0; }
    #ea .ea-old { border-bottom: 1px solid var(--linen); }
    #ea .ea-old summary { display: flex; align-items: center; min-height: 42px; padding: 0 2px; cursor: pointer; list-style: none; color: var(--wine); text-decoration: underline; text-underline-offset: 3px; }
    #ea .ea-old summary::-webkit-details-marker { display: none; }
  </style>

  <script>
    import { requireAdmin } from "../../../lib/admin-gate.js";
    import { supabase } from "../../../lib/supabase.js";
    import { TRIGGER_LABELS, emptyGraph } from "../../../lib/automations.js";
    import { kindOf } from "../../../lib/email-campaigns.js";

    const DEV = import.meta.env.DEV;
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const fmtDate = (d) => { try { return new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); } catch (_) { return ""; } };

    const OLD_DRAFT_DAYS = 30;
    let ALL = [];           // system workflows only
    let LIVE = new Map();   // automation id -> how many are in it now

    function toast(msg) {
      const t = $("ea-toast"); if (!t) return;
      t.textContent = msg; t.classList.add("on");
      clearTimeout(toast._t); toast._t = setTimeout(() => t.classList.remove("on"), 2600);
    }

    const BLK = { active: ["run", "Running"], paused: ["pause", "Paused"], draft: ["plan", "Draft"], archived: ["end", "Archived"] };

    function row(a) {
      const id = encodeURIComponent(a.id);
      const blk = BLK[a.status] || BLK.draft;
      const stopped = a.status !== "active";
      return `<tr>
        <td><div class="ea-rowname"><a href="/admin/automations/edit?id=${id}">${esc(a.name)}</a><span>Edited ${esc(fmtDate(a.updated_at))}</span></div></td>
        <td><span class="ea-k">Starts when</span>${esc(TRIGGER_LABELS[a.trigger_type] || "Not set up yet")}</td>
        <td><span class="ea-k">In it now</span>${LIVE.get(a.id) || 0}</td>
        <td><span class="blk ${blk[0]}">${blk[1]}</span></td>
        <td class="ea-acts">
          <a class="mbtn small" href="/admin/automations/edit?id=${id}">Open</a><a class="mbtn small" href="/admin/automations/audit?id=${id}">Who is in it</a><button type="button" class="mbtn small" data-dup="${esc(a.id)}">Duplicate</button>${stopped ? `<button type="button" class="mbtn small danger" data-del="${esc(a.id)}">Delete</button>` : ""}
        </td>
      </tr>`;
    }

    function render() {
      const rank = { active: 0, paused: 1, draft: 2, archived: 3 };
      const rows = [...ALL].sort((x, y) => (rank[x.status] ?? 4) - (rank[y.status] ?? 4) || String(y.updated_at).localeCompare(String(x.updated_at)));
      // Drafts nobody has touched for a month are tests and false starts:
      // one line to open, so they never bury the ones that run.
      const cutoff = Date.now() - OLD_DRAFT_DAYS * 864e5;
      const isOld = (a) => a.status === "draft" && new Date(a.updated_at).getTime() < cutoff;
      const main = rows.filter((a) => !isOld(a));
      const old = rows.filter(isOld);
      $("ea-n").textContent = String(main.length);
      let html = main.length
        ? `<div class="tablewrap"><table class="ea-tbl"><tbody>${main.map(row).join("")}</tbody></table></div>`
        : `<div class="empty">No automations yet. Press New automation to build one, for example a welcome email when someone signs up.</div>`;
      if (old.length) {
        html += `<details class="ea-old"><summary>${old.length} old ${old.length === 1 ? "draft" : "drafts"}, not touched for ${OLD_DRAFT_DAYS} days or more. Tidy them up</summary>
          <div class="tablewrap"><table class="ea-tbl"><tbody>${old.map(row).join("")}</tbody></table></div></details>`;
      }
      $("ea-main").innerHTML = html;
    }

    async function load() {
      const { data, error } = await supabase.from("automations").select("*").order("updated_at", { ascending: false });
      if (error) { $("ea-state").textContent = "Couldn't read the automations: " + error.message; $("ea-state").classList.add("bad"); return; }
      ALL = (data || []).filter((a) => kindOf(a) !== "marketing");
      LIVE = new Map();
      try {
        // Only the ids come back, a thousand at a time, so a busy workflow is still counted in full.
        for (let from = 0; from < 20000; from += 1000) {
          const r = await supabase.from("automation_enrollments").select("automation_id").in("status", ["active", "waiting"]).order("id", { ascending: true }).range(from, from + 999);
          if (r.error) break;
          (r.data || []).forEach((e) => LIVE.set(e.automation_id, (LIVE.get(e.automation_id) || 0) + 1));
          if ((r.data || []).length < 1000) break;
        }
      } catch (_) {}
      if (DEV && !ALL.length && new URLSearchParams(location.search).has("demo")) {
        // An example row for a development copy, where a signed-out visitor is handed nothing.
        ALL = [{ id: "d1", name: "TEG Pro / Academy Videography", status: "active", trigger_type: "new_starter_videography", updated_at: "2026-07-12T10:00:00Z", graph: emptyGraph() },
          { id: "d2", name: "Untitled automation", status: "draft", trigger_type: null, updated_at: "2026-09-07T10:00:00Z", graph: emptyGraph() }];
      }
      $("ea-state").hidden = true;
      $("ea-main").hidden = false;
      render();
    }

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    $("ea-sync")?.addEventListener("click", async () => {
      const btn = $("ea-sync");
      if (!WORKER) { alert("Worker URL not set (PUBLIC_R2_WORKER_URL)."); return; }
      const prev = btn.textContent; btn.disabled = true; btn.textContent = "Syncing…";
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) { alert("Please sign in."); return; }
        const res = await fetch(`${WORKER}/agent/sync`, { method: "POST", headers: { Authorization: "Bearer " + session.access_token } });
        const j = await res.json().catch(() => ({}));
        if (!res.ok || !j.ok) { alert("Sync failed: " + (j.error || res.status)); return; }
        const cols = j.columns || {};
        const wb = [
          `Shoot Booked column: ${cols.booked ? `"${cols.booked}"` : "NOT FOUND - add a column headed \"Shoot Booked\""}`,
          `Gallery link column: ${cols.link ? `"${cols.link}"` : "NOT FOUND - add a column headed \"Headshot Link\""}`,
          `Cells written this run: ${j.written || 0}`,
          j.write_error ? `Write failed: ${j.write_error}\n(The sheet needs to be shared with EDIT access to the service account.)` : null,
        ].filter(Boolean).join("\n");
        const perRow = (j.details || []).filter((d) => d.writeback).map((d) => {
          const w = d.writeback;
          if (w.error) return `Row ${d.row} ${d.email}: write failed - ${w.error}`;
          if (!w.booking) return `Row ${d.row} ${d.email}: ${w.why || "no booking"}`;
          const bits = [];
          bits.push(w.booked ? `booked ${w.booked}` : "no shoot date on the booking");
          bits.push(w.link ? "link ready" : (w.why || "no link yet"));
          if (w.wrote && w.wrote.length) bits.push(`wrote: ${w.wrote.join(", ")}`);
          else if (w.booked || w.link) bits.push("already on the sheet");
          if (w.missing_columns && w.missing_columns.length) bits.push(`no column for: ${w.missing_columns.join(", ")}`);
          return `Row ${d.row} ${d.email}: ${bits.join(" · ")}`;
        }).join("\n");
        alert(`Synced.\n\nRows read: ${j.rows}\nNew starters processed: ${j.processed}\nEnrolled in a funnel: ${j.enrolled}\nCancelled (code voided + DND): ${j.cancelled || 0}\nSkipped (not Pro/Academy or no email): ${j.skipped}\n\nWrite-back\n${wb}${perRow ? "\n\n" + perRow : ""}`);
        await load();
      } catch (e) { alert("Sync failed: " + (e && e.message || e)); }
      finally { btn.disabled = false; btn.textContent = prev; }
    });

    $("ea-new")?.addEventListener("click", async () => {
      const name = (prompt("Name your automation:", "Untitled automation") || "").trim();
      if (!name) return;
      const { data, error } = await supabase.from("automations").insert({ name }).select("id").single();
      if (error) { alert("Couldn't create: " + error.message); return; }
      location.href = `/admin/automations/edit?id=${data.id}`;
    });

    $("ea-main")?.addEventListener("click", async (e) => {
      const t = e.target instanceof HTMLElement ? e.target.closest("[data-dup], [data-del]") : null;
      if (!t) return;
      const id = t.dataset.dup || t.dataset.del;
      const src = ALL.find((a) => a.id === id);
      if (!src) return;
      if (t.dataset.dup) {
        // A copy is a brand-new automation: a draft, with none of the original's
        // life story (went live, paused, archived) carried across.
        const copy = JSON.parse(JSON.stringify(src.graph || emptyGraph()));
        if (copy.meta) ["went_live_at", "paused_at", "archived_at", "reactivated_at"].forEach((k) => delete copy.meta[k]);
        const { error } = await supabase.from("automations").insert({ name: src.name + " (copy)", trigger_type: src.trigger_type, trigger_config: src.trigger_config, graph: copy, status: "draft" });
        if (error) { toast("Couldn't duplicate: " + error.message); return; }
        toast("Copied. The copy is a draft.");
      } else {
        if (!confirm(`Delete "${src.name}"? This can't be undone.`)) return;
        const { error } = await supabase.from("automations").delete().eq("id", id);
        if (error) { toast("Couldn't delete: " + error.message); return; }
        toast("Deleted.");
      }
      await load();
    });

    (async () => {
      if (!DEV) { const s = await requireAdmin(); if (!s) return; }
      await load();
    })();
  </script>
</AdminShell>
