---
import AdminShell from "../../../components/admin/AdminShell.astro";
import "../../../styles/admin.css";
---

<!--
  Funnel audit — /admin/automations/audit?id=<automation_id>
  Every person enrolled (and when), and every step that ran for them, including
  the exact email sent and whether it actually went out. Built from
  automation_enrollments (who + when) + automation_runs (what happened).
-->
<AdminShell active="automations" title="Funnel audit" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Funnel audit</div>
          <div class="page-header-sub">Everyone enrolled, and exactly what ran for them.</div>
        </div>
      </div>
    </div>
  </div>
  <div class="ash-panel ash-page">
    <section class="admin-bar">
      <div class="admin-bar-top">
        <div>
          <a class="aud-back" href="/admin/automations">&larr; Automations</a>
          <h1 class="aud-title" id="aud-name">Funnel audit</h1>
          <p class="aud-sub" id="aud-sub">Loading…</p>
        </div>
        <div class="admin-bar-tools">
          <!-- Shown only when a send step errored for someone: runs it again for
               them once whatever broke it has been fixed. -->
          <button type="button" class="aud-retry" id="aud-retry" hidden>Resend missed emails</button>
        </div>
      </div>
    </section>

    <!-- Insights — what happened to this funnel's emails, fed by the Resend
         webhook. Hidden until there are events to show. -->
    <section class="aud-ins" id="aud-ins" hidden>
      <div class="aud-ins-head">
        <h2 class="aud-ins-h">Email insights</h2>
        <span class="aud-ins-sub">Click any number to see who. Rates are out of emails delivered; each person counts once.</span>
      </div>
      <p class="aud-ins-warn" id="aud-ins-warn" hidden></p>
      <div class="aud-stats" id="aud-stats"></div>
      <div class="aud-ins-wrap"><table class="aud-ins-table" id="aud-ins-table"></table></div>
    </section>
    <!-- AI read on the numbers + anything to do before the next send. -->
    <div class="aud-ai" id="aud-ai" hidden></div>
    <p class="aud-retry-msg" id="aud-retry-msg" hidden></p>

    <p class="aud-loading" id="aud-loading">Loading the audit…</p>
    <p class="aud-empty" id="aud-empty" hidden>Nobody has entered this funnel yet.</p>
    <!-- Everyone, one line each, opened only when wanted: on a big funnel a
         card per person buried the numbers (Danielle, 30 Sep 2026). -->
    <details class="aud-people" id="aud-people" hidden>
      <summary><span class="aud-people-h">Everyone in the funnel</span><span class="aud-people-n" id="aud-people-n"></span></summary>
      <div class="aud-people-tools">
        <input type="search" id="aud-search" placeholder="Search a name or email" aria-label="Search people">
        <select class="auto-filter" id="aud-filter" aria-label="Show">
          <option value="all">Everyone</option>
          <option value="problems">Only people with a problem</option>
        </select>
      </div>
      <div class="aud-list" id="aud-list"></div>
    </details>
  </div>
  <div class="aud-modal" id="aud-modal" hidden></div>

  <style is:global>
    .aud-back { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.55); text-decoration: none; }
    .aud-back:hover { color: var(--english-violet); }
    .aud-retry { appearance: none; cursor: pointer; margin-right: 10px; padding: 9px 16px; border-radius: 8px; border: 1px solid var(--english-violet);
      background: var(--english-violet); color: #fff; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; }
    .aud-retry:hover { opacity: 0.9; }
    .aud-retry:disabled { opacity: 0.55; cursor: progress; }
    .aud-retry-msg { font-family: var(--sans); font-size: 13px; border-radius: 8px; padding: 10px 14px; margin: 12px 0 0; background: rgba(55,30,40,0.06); color: var(--ink); }
    .aud-retry-msg.is-ok { background: rgba(60,150,90,0.1); color: #2e6b40; }
    .aud-retry-msg.is-err { background: rgba(200,70,50,0.1); color: #a3372b; }
    .aud-title { font-family: var(--serif); font-size: 26px; font-weight: 500; color: var(--ink); margin: 8px 0 2px; }
    .aud-sub { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); margin: 0; }
    .aud-loading, .aud-empty { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.55); padding: 24px 0; }
    .aud-stats { display: flex; gap: 10px; flex-wrap: wrap; margin: 14px 0 4px; }
    .aud-ins { margin: 18px 0 6px; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 18px 20px 16px; }
    .aud-ins-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .aud-ins-h { font-family: var(--serif); font-size: 19px; font-weight: 500; color: var(--ink); margin: 0; }
    .aud-ins-sub { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.5); }
    .aud-ins-warn { font-family: var(--sans); font-size: 13px; line-height: 1.5; margin: 12px 0 0; padding: 10px 14px; border-radius: 8px; background: rgba(227,160,8,0.12); color: #7a5405; }
    .aud-ins .aud-stat { background: var(--paper, #f4f2f1); border-color: transparent; }
    .aud-ins-wrap { overflow-x: auto; margin-top: 14px; }
    /* Counts open the list of people behind them. */
    .ins-n { appearance: none; border: 0; background: none; padding: 0; font: inherit; font-weight: 700; color: var(--ink); cursor: pointer; border-bottom: 1px dotted rgba(55,30,40,0.45); }
    .ins-n:hover { color: var(--english-violet); border-bottom-color: var(--english-violet); }
    .aud-stat .ins-n { font-family: var(--serif); font-size: 22px; font-weight: 500; line-height: 1.1; border-bottom-width: 1px; }
    .aud-modal { position: fixed; inset: 0; z-index: 200; background: rgba(28,24,28,0.4); display: flex; align-items: flex-start; justify-content: center; padding: 8vh 16px 16px; }
    .aud-modal[hidden] { display: none; }
    .aud-modal-box { background: #fff; border-radius: 12px; width: min(720px, 100%); max-height: 84vh; display: flex; flex-direction: column; box-shadow: 0 24px 60px -24px rgba(20,18,26,0.5); font-family: var(--sans); }
    .aud-modal-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; padding: 18px 22px 12px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .aud-modal-head h3 { font-family: var(--serif); font-size: 20px; font-weight: 500; color: var(--ink); margin: 0; }
    .aud-modal-head p { margin: 3px 0 0; font-size: 12.5px; color: rgba(28,29,34,0.55); }
    .aud-modal-x { appearance: none; border: 0; background: none; font-size: 24px; line-height: 1; cursor: pointer; color: rgba(28,29,34,0.5); }
    .aud-modal-body { overflow-y: auto; padding: 6px 22px 18px; }
    .aud-who { list-style: none; margin: 0; padding: 0; }
    .aud-who li { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; padding: 10px 0; border-bottom: 1px solid rgba(28,29,34,0.07); font-size: 13.5px; }
    .aud-who li b { font-weight: 600; color: var(--ink); }
    .aud-who li small { font-size: 12px; color: rgba(28,29,34,0.55); }
    .aud-who li .w { font-size: 12px; color: rgba(28,29,34,0.5); white-space: nowrap; text-align: right; }
    .aud-who li .l { grid-column: 1 / -1; font-size: 12px; color: rgba(28,29,34,0.6); word-break: break-all; }
    .aud-who.is-bot li { color: rgba(28,29,34,0.5); }
    .aud-bots { margin-top: 14px; font-size: 13px; }
    .aud-bots summary { cursor: pointer; color: rgba(28,29,34,0.6); font-weight: 600; }
    .aud-bots p { font-size: 12px; color: rgba(28,29,34,0.55); margin: 8px 0 4px; line-height: 1.5; }
    /* Everyone in the funnel: collapsed, then one line a person. */
    .aud-people { margin: 18px 0 60px; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 0; }
    .aud-people > summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 16px 20px; }
    .aud-people > summary::-webkit-details-marker { display: none; }
    .aud-people > summary::after { content: "Show"; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--english-violet); }
    .aud-people[open] > summary::after { content: "Hide"; }
    .aud-people-h { font-family: var(--serif); font-size: 19px; font-weight: 500; color: var(--ink); }
    .aud-people-n { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); margin-left: 10px; flex: 1; }
    .aud-people-tools { display: flex; gap: 10px; flex-wrap: wrap; padding: 0 20px 12px; }
    .aud-people-tools input { flex: 1; min-width: 200px; height: 36px; padding: 0 12px; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; font: 13px var(--sans); }
    .aud-ins-table { width: 100%; min-width: 760px; border-collapse: collapse; font-family: var(--sans); font-size: 13px; }
    .aud-ins-table th { text-align: right; font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.5); padding: 0 12px 8px 0; border-bottom: 1px solid rgba(28,29,34,0.12); white-space: nowrap; }
    .aud-ins-table th:first-child, .aud-ins-table td:first-child { text-align: left; }
    .aud-ins-table td { text-align: right; padding: 11px 12px 11px 0; border-bottom: 1px solid rgba(28,29,34,0.07); vertical-align: top; font-variant-numeric: tabular-nums; white-space: nowrap; }
    .aud-ins-table td:first-child { white-space: normal; }
    .aud-ins-table td b { font-weight: 700; color: var(--ink); }
    .aud-ins-table td small { display: block; font-size: 11px; color: rgba(28,29,34,0.45); margin-top: 2px; }
    .aud-ins-table .ins-name { font-weight: 600; color: var(--ink); }
    .aud-ins-table .ins-when { font-size: 11.5px; color: rgba(28,29,34,0.5); }
    /* What the filter took out, so a 0 reads as "nobody, and here is why"
       rather than as a broken page. */
    .aud-ins-table .ins-bot { display: block; font-size: 11px; color: #8a6a24; margin-top: 2px; }
    .aud-ins-table tr.is-waiting td { color: rgba(28,29,34,0.4); }
    .aud-stat { background: #fff; border: 1px solid rgba(28,29,34,0.12); border-radius: 10px; padding: 10px 16px; min-width: 92px; }
    .aud-stat b { display: block; font-family: var(--serif); font-size: 22px; font-weight: 500; color: var(--ink); line-height: 1.1; }
    .aud-stat span { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .aud-stat small { display: block; font-family: var(--sans); font-size: 10.5px; color: rgba(28,29,34,0.45); margin-top: 2px; }
    .aud-stat.is-bad b { color: #b3261e; }
    .aud-ai { background: #fff; border: 1px solid rgba(28,29,34,0.12); border-radius: 10px; padding: 14px 18px; margin: 10px 0 4px; font-family: var(--sans); font-size: 13px; line-height: 1.6; color: var(--ink); white-space: pre-wrap; }
    .aud-ai.is-loading { color: rgba(28,29,34,0.5); }
    .aud-ai-label { display: block; font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin-bottom: 6px; white-space: normal; }
    .aud-list { display: flex; flex-direction: column; border-top: 1px solid rgba(28,29,34,0.08); }
    .aud-person { border-bottom: 1px solid rgba(28,29,34,0.07); padding: 0 20px; }
    .aud-person > summary { list-style: none; cursor: pointer; padding: 11px 0; }
    .aud-person > summary::-webkit-details-marker { display: none; }
    .aud-person[open] { background: rgba(55,30,40,0.025); }
    .aud-person-top { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; }
    .aud-person-last { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.6); margin-left: auto; margin-right: 12px; }
    .aud-person .aud-steps { margin: 0 0 14px; }
    .aud-person-name { font-family: var(--sans); font-weight: 700; font-size: 13.5px; color: var(--ink); }
    .aud-person-meta { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.5); }
    .aud-badge { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; border-radius: 999px; padding: 3px 9px; }
    .aud-badge.active, .aud-badge.waiting { background: rgba(55,30,40,0.1); color: var(--english-violet); }
    .aud-badge.completed { background: rgba(47,122,63,0.12); color: #2f7a3f; }
    .aud-badge.stopped, .aud-badge.error { background: rgba(179,38,30,0.1); color: #b3261e; }
    .aud-steps { margin: 12px 0 0; border-top: 1px solid rgba(28,29,34,0.08); padding-top: 10px; display: flex; flex-direction: column; gap: 8px; }
    .aud-step { display: grid; grid-template-columns: 120px 1fr auto; gap: 12px; align-items: baseline; }
    @media (max-width: 700px) { .aud-step { grid-template-columns: 1fr; gap: 2px; } }
    .aud-step-type { font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .aud-step-detail { font-family: var(--sans); font-size: 12.5px; color: var(--ink); line-height: 1.45; }
    .aud-step-when { font-family: var(--sans); font-size: 10.5px; color: rgba(28,29,34,0.45); white-space: nowrap; }
    .aud-step.is-error .aud-step-detail { color: #b3261e; }
    .aud-step.is-skipped .aud-step-detail { color: rgba(28,29,34,0.5); }
    .aud-none { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.45); }
  </style>

  <script>
    import { supabase } from "../../../lib/supabase.js";
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const dt = (d) => { try { return new Date(d).toLocaleString("en-GB", { day: "numeric", month: "short", year: "numeric", hour: "2-digit", minute: "2-digit" }); } catch (_) { return ""; } };
    const TYPE_LABEL = {
      send_email: "Email", wait: "Wait", if_else: "Condition", add_tag: "Tag added",
      remove_tag: "Tag removed", add_note: "Note", create_task: "Task", set_dnd: "Do-not-contact",
      set_field: "Field set", notify_team: "Team notified", goal: "Goal",
    };

    const id = new URLSearchParams(location.search).get("id");
    let PEOPLE = [];
    let filter = "all";

    let q = "";
    function render() {
      const rows = PEOPLE.filter((p) => {
        if (filter === "problems" && !p.steps.some((s) => s.outcome === "error")) return false;
        return !q || (p.name + " " + p.email).toLowerCase().includes(q);
      });
      $("aud-empty").hidden = PEOPLE.length !== 0;
      $("aud-people").hidden = PEOPLE.length === 0;
      // Their latest email, so the line says where each person has got to.
      const lastEmail = (p) => { const e = p.steps.filter((s) => s.node_type === "send_email" && s.outcome === "ok").pop(); return e ? `Last email ${new Date(e.created_at).toLocaleDateString("en-GB", { day: "numeric", month: "short" })}` : "No email yet"; };
      $("aud-list").innerHTML = rows.map((p) => `
        <details class="aud-person">
          <summary class="aud-person-top">
            <div>
              <div class="aud-person-name">${esc(p.name)}${p.steps.some((s) => s.outcome === "error") ? ' <span class="aud-badge error">problem</span>' : ""}</div>
              <div class="aud-person-meta">${esc(p.email)} · entered ${esc(dt(p.created_at))}${p.next_run_at && (p.status === "active" || p.status === "waiting") ? " · next step " + esc(dt(p.next_run_at)) : ""}</div>
            </div>
            <span class="aud-person-last">${esc(lastEmail(p))}</span>
            <span class="aud-badge ${esc(p.status)}">${esc(p.status)}</span>
          </summary>
          <div class="aud-steps">
            ${p.steps.length ? p.steps.map((s) => `
              <div class="aud-step ${s.outcome === "error" ? "is-error" : s.outcome === "skipped" ? "is-skipped" : ""}">
                <span class="aud-step-type">${esc(TYPE_LABEL[s.node_type] || s.node_type)}</span>
                <span class="aud-step-detail">${esc(s.detail || (s.outcome === "ok" ? "ran" : s.outcome))}${s.outcome === "error" ? " ✗" : s.outcome === "ok" && s.node_type === "send_email" ? " ✓" : ""}</span>
                <span class="aud-step-when">${esc(dt(s.created_at))}</span>
              </div>`).join("") : '<div class="aud-none">Nothing has run for them yet.</div>'}
          </div>
        </details>`).join("") || '<p class="aud-none" style="padding:14px 20px">Nobody matches that.</p>';
    }

    // Insights: counts per event for this automation, from email_events (fed by
    // our send log + the Resend webhook). Unique contacts for opens/clicks so
    // one person opening six times counts once. Fails silently if the
    // email_events_automation.sql migration hasn't run yet.
    async function loadStats() {
      try {
        // Supabase hands back 1,000 rows at most per request, whatever the
        // limit says, so a funnel's events are read a thousand at a time.
        // Asking once, oldest first, showed the first emails and left a later
        // one at 0 sent (Autumn Edit email 3, 30 Sep 2026).
        const readAll = async (cols) => {
          const out = [];
          for (let from = 0; from < 50000; from += 1000) {
            const r = await supabase.from("email_events").select(cols)
              .eq("automation_id", id).order("occurred_at", { ascending: true }).order("id", { ascending: true }).range(from, from + 999);
            if (r.error) return { error: r.error };
            out.push(...(r.data || []));
            if ((r.data || []).length < 1000) break;
          }
          return { data: out };
        };
        // node_id arrives with a migration; before it has run, ask without it.
        let res = await readAll("event, contact_id, email, node_id, subject, message_id, provider, detail, occurred_at, raw");
        if (res.error) res = await readAll("event, contact_id, email, subject, message_id, provider, detail, occurred_at");
        const ev = (res.data || []);
        const { data: autoRow } = await supabase.from("automations").select("graph, name").eq("id", id).maybeSingle();
        const nodes = ((autoRow && autoRow.graph && autoRow.graph.nodes) || []);
        const sendNodes = nodes.filter((n) => n.type === "send_email");
        if (!ev.length && !sendNodes.length) return;

        // Which email each event belongs to. Our own "sent" row knows the step
        // (and the subject); the provider's delivered/opened/clicked reports
        // are tied back to it through the message id.
        const byMsg = new Map();
        ev.filter((e) => e.event === "sent" && e.message_id).forEach((e) => byMsg.set(e.message_id, e));
        const keyOf = (e) => {
          if (e.node_id) return "n:" + e.node_id;
          const s = e.message_id && byMsg.get(e.message_id);
          if (s && s.node_id) return "n:" + s.node_id;
          const subj = (s && s.subject) || e.subject;
          return subj ? "s:" + subj : "";
        };

        // Template names, for steps that don't override the subject.
        const tplIds = [...new Set(sendNodes.map((n) => n.config && n.config.template_id).filter(Boolean))];
        const tplName = new Map();
        if (tplIds.length) {
          const { data: tpls } = await supabase.from("email_templates").select("id, name, subject").in("id", tplIds);
          (tpls || []).forEach((t) => tplName.set(t.id, t));
        }
        const groups = new Map();
        const group = (key) => {
          if (!groups.has(key)) groups.set(key, { key, name: "", when: "", first: null, ev: [] });
          return groups.get(key);
        };
        // Every email in the funnel gets a row, sent yet or not.
        sendNodes.forEach((n) => {
          const c = n.config || {};
          const t = tplName.get(c.template_id);
          const g = group("n:" + n.id);
          g.name = (c.subject && String(c.subject).trim()) || (t && (t.subject || t.name)) || "Email";
          g.when = c.send_on ? "Scheduled " + new Date(c.send_on + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short" }) + (c.send_at ? ", " + c.send_at : "") : "";
          g.order = nodes.indexOf(n);
        });
        ev.forEach((e) => {
          const k = keyOf(e);
          const g = group(k || "other");
          if (!g.name) g.name = k.startsWith("s:") ? k.slice(2) : "Across the funnel";
          g.ev.push(e);
          if (e.event === "sent" && (!g.first || e.occurred_at < g.first)) g.first = e.occurred_at;
        });

        /* Opens and clicks are not all people.
           Microsoft Defender, Mimecast and the rest fetch every link in every
           message before anyone sees it, and load the tracking pixel while
           they are at it. Resend records each as a click or an open, from a
           real IP with an ordinary Chrome user agent, so a campaign can report
           80 clicks and the website see two visits.

           Two tells, both from the data itself rather than a list of known
           bots — lists go stale, behaviour doesn't:
             · one IP acting for more than one recipient. A person has one
               inbox; a scanner works through the queue.
             · a click landing within 30 seconds of delivery. Nobody reads an
               email and follows a link that fast.

           What is left is reported as the number, because that is the number
           you would plan against. The machines are still counted, and still
           shown, just not mistaken for interest. */
        const ipOf = (e) => {
          const d = e.raw && e.raw.data;
          return (d && ((d.click && d.click.ipAddress) || (d.open && d.open.ipAddress))) || null;
        };
        const deliveredAt = new Map();
        ev.filter((e) => e.event === "delivered").forEach((e) => {
          const k = e.email || e.contact_id;
          if (k && (!deliveredAt.has(k) || e.occurred_at < deliveredAt.get(k))) deliveredAt.set(k, e.occurred_at);
        });
        const ipReach = new Map();
        ev.forEach((e) => {
          if (e.event !== "clicked" && e.event !== "opened") return;
          const ip = ipOf(e);
          if (!ip) return;
          if (!ipReach.has(ip)) ipReach.set(ip, new Set());
          ipReach.get(ip).add(e.email || e.contact_id);
        });
        /* Two recipients on one IP is not proof: a whole office can share one
           address on the way out. Three or more, within the hour of delivery,
           is — that is a queue being worked through, not a team all reading
           their post at once. */
        const SCANNER_RANGES = [/^172\.186\./, /^85\.210\./];
        const knownScanner = (ip) => !!ip && SCANNER_RANGES.some((re) => re.test(ip));

        const uaOf = (e) => {
          const d = e.raw && e.raw.data;
          return (d && ((d.click && d.click.userAgent) || (d.open && d.open.userAgent))) || null;
        };
        const linkOf = (e) => {
          const d = e.raw && e.raw.data;
          return (d && d.click && d.click.link) || null;
        };
        /* A mail client rendering the message, rather than a browser.
           Apple Mail's agent stops dead at "(KHTML, like Gecko)" — no product,
           no version. A scanner presents itself as a browser, because it is
           pretending to be one. So this is a positive sign of a person, not a
           machine, and it is the signature on every open we have confirmed
           was real. */
        const isMailClient = (ua) => /\(KHTML, like Gecko\)\s*$/.test(ua || "");

        /* THE MACHINE PASS.

           Timing from delivery was the old test and it cannot work: mail held
           in quarantine is scanned when it is RELEASED, which for The Autumn
           Edit was two days later. Everything after that looked late and human
           and was neither.

           What a scan actually looks like, from the payloads:

             09:51:45  open   Chrome 109.0.0.0
             09:52:08  click  Chrome 142.0.7444.163
             09:53:01  click  Chrome 142.0.7444.162

           One IP, 76 seconds, three different Chrome builds. A browser cannot
           change version between clicks. And elsewhere: three distinct links
           fetched in a third of a second, which no hand can do.

           So we judge an IP by how it behaved for THIS message and THIS
           recipient, and anything that IP did is the machine's:
             · two or more different links within seconds, or
             · its user agent changing at all.
           Everything outside those addresses is a person. */
        /* Five, not twenty. The scans we have actually watched fetched three
           links in three tenths of a second; a person going back to the email
           for a second link cannot beat five, so this catches the machine
           without ever calling somebody keen a robot. */
        const BURST_SECONDS = 5;
        const msgKey = (e) => (e.message_id || e.subject || "") + "|" + (e.email || e.contact_id || "");
        const machineIp = new Set();          // "<message>|<recipient>|<ip>"
        (function findMachinePasses() {
          const byKeyIp = new Map();
          ev.forEach((e) => {
            if (e.event !== "clicked" && e.event !== "opened") return;
            const ip = ipOf(e);
            if (!ip) return;
            const k = msgKey(e) + "|" + ip;
            if (!byKeyIp.has(k)) byKeyIp.set(k, []);
            byKeyIp.get(k).push(e);
          });
          byKeyIp.forEach((list, k) => {
            list.sort((a, b) => new Date(a.occurred_at) - new Date(b.occurred_at));
            // Its agent changed while it worked: not one browser, one farm.
            const agents = new Set(list.map(uaOf).filter(Boolean));
            if (agents.size > 1) { machineIp.add(k); return; }
            // Two different links inside a few seconds: not one pair of hands.
            for (let a = 0; a < list.length; a++) {
              for (let b = a + 1; b < list.length; b++) {
                const gap = (new Date(list[b].occurred_at) - new Date(list[a].occurred_at)) / 1000;
                if (gap > BURST_SECONDS) break;
                const la = linkOf(list[a]), lb = linkOf(list[b]);
                if (la && lb && la !== lb) { machineIp.add(k); return; }
              }
            }
          });
        })();

        /* ONE ADDRESS, SEVERAL PEOPLE'S POST.

           The strongest signal of all, and it is only visible ACROSS
           recipients: 135.232.20.144 clicked for six different agents inside
           two and a half minutes. Judged one recipient at a time that address
           looks blameless -- one click, one agent, no burst -- which is
           exactly how sixteen scanner clicks were reported as people.

           A person has one inbox. Three different recipients on one address is
           a queue being worked through, and it is true whenever it happens:
           this rule used to be gated to the hour after delivery, which is the
           same quarantine trap as before -- mail held for two days is scanned
           on release, and every rule keyed to delivery time looks the other
           way. Behaviour does not expire. */
        const MACHINE_IP_REACH = 3;
        function isMachine(e) {
          if (e.event !== "clicked" && e.event !== "opened") return false;
          const ip = ipOf(e);
          if (knownScanner(ip)) return true;
          const reach = ip ? (ipReach.get(ip) || new Set()).size : 0;
          if (reach >= MACHINE_IP_REACH) return true;
          // How this address behaved for this one message and recipient.
          if (ip && machineIp.has(msgKey(e) + "|" + ip)) return true;
          // A mail client rendering the message is a person reading it.
          if (e.event === "opened" && isMailClient(uaOf(e))) return false;
          return false;
        }

        const who = (e) => e.contact_id || e.email || Math.random();
        const uniq = (list, name) => new Set(list.filter((x) => x.event === name).map(who)).size;
        const count = (list, name) => list.filter((x) => x.event === name).length;
        // "Not sent" splits two very different things: people the funnel is
        // right not to email (no opt-in, unsubscribed), and sends that failed.
        /* The one number no machine can fake.
           Every link we send carries the funnel's name and the step's id, and
           the site records a visit only when a real browser runs our code —
           which a link scanner never does. So: who actually turned up. Opens
           and clicks are what the mail world can see; this is what happened. */
        const visitsByStep = new Map();
        let visitsTotal = 0;
        try {
          const name = (autoRow && autoRow.name) || "";
          if (name) {
            const { data: visits } = await supabase
              .from("site_events")
              .select("session_id, id, props, created_at")
              .eq("props->from->>campaign", name)
              .limit(20000);
            const seen = new Map();
            (visits || []).forEach((v) => {
              const sid = v.session_id || v.id;
              const step = ((v.props || {}).from || {}).content || "";
              if (!seen.has(sid)) seen.set(sid, step);
            });
            seen.forEach((step) => {
              visitsTotal++;
              const k = "n:" + step;
              visitsByStep.set(k, (visitsByStep.get(k) || 0) + 1);
            });
          }
        } catch (_) { /* the rest of the page still stands */ }

        const gateReason = /opt-?in|unsubscribed|do-not-contact|suppressed/i;
        // One per message: Resend's own "sent" report for a message we'd
        // already logged used to count it twice (380 for 190, 30 Sep 2026).
        const sentOnce = (list) => new Set(list.filter((x) => x.event === "sent").map((x) => x.message_id || (x.subject || "") + "|" + who(x))).size;
        const stats = (list) => {
          const sent = sentOnce(list);
          const delivered = uniq(list, "delivered");
          const people = list.filter((x) => !isMachine(x));
          return {
            sent, delivered,
            opened: uniq(people, "opened"), clicked: uniq(people, "clicked"),
            botOpened: uniq(list, "opened") - uniq(people, "opened"),
            botClicked: uniq(list, "clicked") - uniq(people, "clicked"),
            unsub: uniq(list, "unsubscribed"),
            bounced: uniq(list, "bounced"), spam: uniq(list, "complained"),
            skipped: list.filter((x) => x.event === "blocked" && gateReason.test(x.detail || "")).length,
            failed: list.filter((x) => x.event === "blocked" && !gateReason.test(x.detail || "")).length,
            base: delivered || sent,
          };
        };
        const pct = (n, of) => (of ? Math.round((n / of) * 100) + "%" : "");
        const all = stats(ev);

        // The people behind each number, for the pop-outs. Names from the
        // contacts; each person once, at the first time it happened.
        const names = new Map();
        const cidList = [...new Set(ev.map((e) => e.contact_id).filter(Boolean))];
        for (let i = 0; i < cidList.length; i += 200) {
          const { data: cs } = await supabase.from("contacts").select("id, first_name, last_name").in("id", cidList.slice(i, i + 200));
          (cs || []).forEach((c) => names.set(c.id, [c.first_name, c.last_name].filter(Boolean).join(" ")));
        }
        const shortLink = (u) => { try { const x = new URL(u); return (x.hostname.replace(/^www\./, "") + x.pathname).replace(/\/$/, "") || u; } catch (_) { return u || ""; } };
        const peopleOf = (list, evName, keep) => {
          const by = new Map();
          list.filter((x) => x.event === evName && (!keep || keep(x))).forEach((x) => {
            const k = who(x);
            const cur = by.get(k) || { name: names.get(x.contact_id) || "", email: x.email || "", at: x.occurred_at, links: new Set(), detail: x.detail || "" };
            if (x.occurred_at < cur.at) cur.at = x.occurred_at;
            const l = linkOf(x) || x.url; if (l) cur.links.add(shortLink(l));
            by.set(k, cur);
          });
          return [...by.values()].sort((a, b) => (a.at < b.at ? -1 : 1));
        };
        const lists = (list) => {
          const humans = list.filter((x) => !isMachine(x));
          const opened = peopleOf(humans, "opened"), clicked = peopleOf(humans, "clicked");
          const on = (arr) => new Set(arr.map((x) => x.email));
          return {
            sent: peopleOf(list, "sent"), delivered: peopleOf(list, "delivered"),
            opened, clicked,
            openedBots: peopleOf(list, "opened").filter((x) => !on(opened).has(x.email)),
            clickedBots: peopleOf(list, "clicked").filter((x) => !on(clicked).has(x.email)),
            unsub: peopleOf(list, "unsubscribed"), bounced: peopleOf(list, "bounced"),
          };
        };
        const LISTS = new Map();
        LISTS.set("all", { title: "All emails", ...lists(ev) });
        const btn = (key, m, n) => n ? `<button type="button" class="ins-n" data-k="${esc(key)}" data-m="${m}">${n}</button>` : `<b>${n}</b>`;

        const stat = (label, n, rate, bad, m) => `<div class="aud-stat${bad && n ? " is-bad" : ""}">${m ? btn("all", m, n) : `<b>${n}</b>`}<span>${label}</span>${rate ? `<small>${rate}</small>` : ""}</div>`;
        $("aud-stats").innerHTML =
          stat("Sent", all.sent, "", false, "sent") +
          stat("Delivered", all.delivered, pct(all.delivered, all.sent), false, "delivered") +
          stat("Opened", all.opened, pct(all.opened, all.base), false, "opened") +
          stat("Clicked", all.clicked, pct(all.clicked, all.base), false, "clicked") +
          stat("Came to the site", visitsTotal, pct(visitsTotal, all.base)) +
          stat("Unsubscribed", all.unsub, pct(all.unsub, all.base), true, "unsub") +
          (all.bounced ? stat("Bounced", all.bounced, pct(all.bounced, all.sent), true, "bounced") : "") +
          (all.spam ? stat("Spam reports", all.spam, "", true) : "") +
          (all.skipped ? stat("Not emailed", all.skipped, "no opt-in or unsubscribed") : "") +
          (all.failed ? stat("Failed", all.failed, "didn't send", true) : "");

        const rows = [...groups.values()]
          .filter((g) => g.ev.length || g.key.startsWith("n:"))
          .sort((x, y) => {
            if (x.first && y.first) return x.first < y.first ? -1 : 1;
            if (x.first) return -1; if (y.first) return 1;
            return (x.order ?? 999) - (y.order ?? 999);
          });
        const cell = (key, m, n, rate) => `<td>${m ? btn(key, m, n) : `<b>${n}</b>`}${rate ? `<small>${rate}</small>` : ""}</td>`;
        $("aud-ins-table").innerHTML = `<thead><tr><th>Email</th><th>Sent</th><th>Delivered</th><th>Opened</th><th>Clicked</th><th>Came to the site</th><th>Unsubscribed</th><th>Bounced</th></tr></thead><tbody>` +
          rows.map((g) => {
            const t = stats(g.ev);
            LISTS.set(g.key, { title: g.name, ...lists(g.ev) });
            const sentOn = g.first ? "Sent " + new Date(g.first).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : (g.when || "Not sent yet");
            return `<tr class="${t.sent ? "" : "is-waiting"}"><td><div class="ins-name">${esc(g.name)}</div><div class="ins-when">${esc(sentOn)}</div></td>` +
              cell(g.key, "sent", t.sent) + cell(g.key, "delivered", t.delivered, pct(t.delivered, t.sent)) +
              cell(g.key, "opened", t.opened, pct(t.opened, t.base)) +
              cell(g.key, "clicked", t.clicked, pct(t.clicked, t.base)) +
              cell(g.key, "", visitsByStep.get(g.key) || 0, pct(visitsByStep.get(g.key) || 0, t.base)) +
              cell(g.key, "unsub", t.unsub, pct(t.unsub, t.base)) + cell(g.key, "bounced", t.bounced, pct(t.bounced, t.sent)) + `</tr>`;
          }).join("") + `</tbody>`;

        // A number clicked: who's behind it, in a pop-out. Opens and clicks
        // that were security scanners are listed apart, and not counted.
        const LABEL = { sent: "Sent", delivered: "Delivered", opened: "Opened", clicked: "Clicked", unsub: "Unsubscribed", bounced: "Bounced" };
        const whoList = (arr, bot) => `<ul class="aud-who${bot ? " is-bot" : ""}">${arr.map((x) => `<li><span><b>${esc(x.name || x.email)}</b>${x.name ? `<br><small>${esc(x.email)}</small>` : ""}</span><span class="w">${esc(dt(x.at))}</span>${x.links.size ? `<span class="l">${[...x.links].map(esc).join(" · ")}</span>` : ""}${x.detail && !x.links.size ? `<span class="l">${esc(x.detail)}</span>` : ""}</li>`).join("")}</ul>`;
        window.__audOpen = (key, m) => {
          const L = LISTS.get(key); if (!L) return;
          const arr = L[m] || [], bots = m === "opened" ? L.openedBots : m === "clicked" ? L.clickedBots : [];
          const box = $("aud-modal");
          box.innerHTML = `<div class="aud-modal-box" role="dialog" aria-modal="true" aria-label="${esc(LABEL[m])}">
            <div class="aud-modal-head"><div><h3>${esc(LABEL[m])} · ${arr.length} ${arr.length === 1 ? "person" : "people"}</h3><p>${esc(L.title)}</p></div><button type="button" class="aud-modal-x" data-close aria-label="Close">&times;</button></div>
            <div class="aud-modal-body">${arr.length ? whoList(arr) : '<p class="aud-none">Nobody yet.</p>'}
              ${bots.length ? `<details class="aud-bots"><summary>Security scanners · ${bots.length}, not counted</summary><p>Work email filters open and click every link before the person sees the email. These were caught doing that, so they're left out of the numbers.</p>${whoList(bots, true)}</details>` : ""}</div></div>`;
          box.hidden = false;
        };

        // Say so when the numbers can't be right, rather than showing zeros
        // that look like nobody opened anything.
        const resendSent = ev.filter((e) => e.event === "sent" && e.provider === "resend");
        const oldest = resendSent.length ? new Date(resendSent[0].occurred_at).getTime() : 0;
        const warn = $("aud-ins-warn");
        const heard = ev.some((e) => e.provider === "resend" && e.event !== "sent");
        if (resendSent.length && !heard && Date.now() - oldest > 60 * 60e3) {
          warn.hidden = false;
          warn.textContent = "Resend hasn't reported back on any of these emails yet, so delivered, opened and clicked can't be counted. That usually means the webhook isn't set up in the Resend account that sends them (Resend → Webhooks).";
        } else if (all.delivered >= 20 && !all.opened && !all.clicked) {
          warn.hidden = false;
          warn.textContent = "Deliveries are coming through but no opens or clicks at all - open and click tracking are probably switched off for tmke.co.uk in Resend (Domains → tmke.co.uk → Configuration).";
        } else warn.hidden = true;

        $("aud-ins").hidden = false;
        if (ev.length) loadAiSummary();   // only worth asking the AI once something has happened
      } catch (_) { /* insights are a bonus, never break the audit */ }
    }

    // The AI's read on the funnel — only asked for once there are events, and
    // failures just leave the box hidden; the numbers above stand on their own.
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    async function loadAiSummary() {
      if (!WORKER) return;
      const box = $("aud-ai");
      try {
        box.className = "aud-ai is-loading"; box.hidden = false;
        box.innerHTML = '<span class="aud-ai-label">Funnel summary</span>Reading the numbers…';
        const { data: { session } } = await supabase.auth.getSession();
        const r = await fetch(`${WORKER}/automations/insights`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: session ? "Bearer " + session.access_token : "" },
          body: JSON.stringify({ automation_id: id }),
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok || !d.summary) { box.hidden = true; return; }
        box.className = "aud-ai";
        box.innerHTML = '<span class="aud-ai-label">Funnel summary</span>';
        box.appendChild(document.createTextNode(d.summary));
      } catch (_) { box.hidden = true; }
    }

    // ---- Resend missed emails ----------------------------------------------
    async function workerCall(path, body) {
      const { data: { session } } = await supabase.auth.getSession();
      const r = await fetch(`${WORKER}${path}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: session ? "Bearer " + session.access_token : "" },
        body: JSON.stringify(body),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(d.error || "Something went wrong.");
      return d;
    }
    async function checkRetry() {
      if (!WORKER || !id) return;
      try {
        const d = await workerCall("/automations/retry-failed-sends", { automation_id: id, dry_run: true });
        const btn = $("aud-retry");
        btn.hidden = !d.found;
        btn.textContent = `Resend missed emails (${d.found})`;
        btn.dataset.found = d.found;
      } catch (_) { /* the button just stays hidden */ }
    }
    $("aud-retry").addEventListener("click", async () => {
      const btn = $("aud-retry"), msg = $("aud-retry-msg");
      const found = Number(btn.dataset.found || 0);
      if (!found) return;
      if (!confirm(`Send the email again to the ${found} ${found === 1 ? "person" : "people"} it failed for?\n\nOnly failed sends are retried. Anyone who has since opted out is still skipped, and nobody is moved in the funnel.`)) return;
      btn.disabled = true;
      msg.hidden = false; msg.className = "aud-retry-msg";
      let sent = 0, failed = 0, skipped = 0, error = null;
      try {
        for (let guard = 0; guard < 200; guard++) {
          const d = await workerCall("/automations/retry-failed-sends", { automation_id: id });
          sent += d.sent || 0; skipped += d.skipped || 0; failed += d.failed || 0;
          msg.textContent = `Sending… ${sent} sent${skipped ? `, ${skipped} skipped` : ""}.`;
          if (d.failed) { error = d.error; break; }
          if (!d.remaining || !(d.sent || d.skipped)) break;
        }
        if (failed) {
          msg.className = "aud-retry-msg is-err";
          msg.textContent = `Stopped after ${sent} sent: it's still failing - ${error || "send failed"}`;
        } else {
          msg.className = "aud-retry-msg is-ok";
          msg.textContent = `Done: ${sent} sent${skipped ? `, ${skipped} skipped (opted out or suppressed since)` : ""}.`;
        }
      } catch (err) {
        msg.className = "aud-retry-msg is-err";
        msg.textContent = "Couldn't resend: " + err.message;
      }
      btn.disabled = false;
      checkRetry();
      load();
    });

    async function load() {
      if (!id) { $("aud-loading").textContent = "No automation id in the link."; return; }
      checkRetry();
      const { data: auto } = await supabase.from("automations").select("name, status").eq("id", id).maybeSingle();
      if (auto) { $("aud-name").textContent = auto.name; }
      loadStats();

      const rows = [];
      for (let from = 0; from < 100000; from += 1000) {
        const { data: page, error } = await supabase
          .from("automation_enrollments")
          .select("id, contact_id, status, next_run_at, created_at")
          .eq("automation_id", id)
          .order("created_at", { ascending: false }).order("id", { ascending: true })
          .range(from, from + 999);
        if (error) { $("aud-loading").textContent = "Couldn't load the audit: " + error.message; return; }
        rows.push(...(page || []));
        if (!page || page.length < 1000) break;
      }

      // Contacts (names) + every step that ran, in one round-trip each.
      const cids = Array.from(new Set(rows.map((r) => r.contact_id))).filter(Boolean);
      const byContact = new Map();
      if (cids.length) {
        for (let i = 0; i < cids.length; i += 200) {
          const { data: cs } = await supabase.from("contacts").select("id, first_name, last_name, email").in("id", cids.slice(i, i + 200));
          (cs || []).forEach((c) => byContact.set(c.id, c));
        }
      }
      const runsBy = new Map();
      if (rows.length) {
        // A thousand rows a request at most, so read in pages: in one go the
        // newest steps (the latest email) never arrived (30 Sep 2026).
        const runs = [];
        for (let from = 0; from < 100000; from += 1000) {
          const { data: page } = await supabase
            .from("automation_runs")
            .select("id, enrollment_id, node_type, outcome, detail, created_at")
            .eq("automation_id", id)
            .order("created_at", { ascending: true }).order("id", { ascending: true })
            .range(from, from + 999);
          runs.push(...(page || []));
          if (!page || page.length < 1000) break;
        }
        runs.forEach((r) => {
          const list = runsBy.get(r.enrollment_id) || [];
          list.push(r);
          runsBy.set(r.enrollment_id, list);
        });
      }

      PEOPLE = rows.map((r) => {
        const c = byContact.get(r.contact_id) || {};
        return {
          ...r,
          name: [c.first_name, c.last_name].filter(Boolean).join(" ") || c.email || "Someone",
          email: c.email || "",
          steps: runsBy.get(r.id) || [],
        };
      });

      const emails = PEOPLE.reduce((n, p) => n + p.steps.filter((s) => s.node_type === "send_email" && s.outcome === "ok").length, 0);
      const failed = PEOPLE.reduce((n, p) => n + p.steps.filter((s) => s.outcome === "error").length, 0);
      $("aud-sub").textContent = `${PEOPLE.length} ${PEOPLE.length === 1 ? "person has" : "people have"} entered · ${emails} email${emails === 1 ? "" : "s"} sent${failed ? ` · ${failed} problem${failed === 1 ? "" : "s"}` : ""}`;
      $("aud-loading").hidden = true;
      $("aud-people-n").textContent = `${PEOPLE.length} ${PEOPLE.length === 1 ? "person" : "people"}${failed ? ` · ${failed} problem${failed === 1 ? "" : "s"}` : ""}`;
      render();
    }

    document.addEventListener("click", (e) => {
      const b = e.target.closest(".ins-n");
      if (b && window.__audOpen) { window.__audOpen(b.dataset.k, b.dataset.m); return; }
      const m = $("aud-modal");
      if (!m.hidden && (e.target === m || e.target.closest("[data-close]"))) m.hidden = true;
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") $("aud-modal").hidden = true; });
    $("aud-filter")?.addEventListener("change", (e) => { filter = e.target.value; render(); });
    $("aud-search")?.addEventListener("input", (e) => { q = e.target.value.trim().toLowerCase(); render(); });
    load();
  </script>
</AdminShell>
