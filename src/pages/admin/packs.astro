---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
---

<BaseLayout
  title="Catalogue — Admin · TMKE"
  description="Manage The Edit catalogue — add, edit, archive purchasable packs."
>
  <PageHero
    chapter="Admin — Catalogue"
    title="The <em>Edit catalogue.</em>"
    sub="Add, edit, swap, archive. Changes go live the second you save."
  />

  <section class="admin-bar wrap">
    <a href="/admin" class="admin-back">&larr; Dashboard</a>
    <div class="admin-bar-actions">
      <span class="admin-bar-count" id="pack-count">…</span>
      <button type="button" id="new-pack" class="admin-btn admin-btn-primary">+ New pack</button>
    </div>
  </section>

  <section class="pack-list wrap" id="pack-list" aria-busy="true">
    <p class="pack-empty" id="pack-empty" hidden>No packs yet — click <strong>New pack</strong> to add the first one.</p>
    <div class="pack-loading" id="pack-loading">Loading catalogue…</div>
    <div class="pack-grid" id="pack-grid"></div>
  </section>

  <!-- Modal: add / edit pack -->
  <div class="modal-backdrop" id="modal" hidden>
    <div class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title">
      <header class="modal-head">
        <h2 id="modal-title">New pack</h2>
        <button type="button" class="modal-close" id="modal-close" aria-label="Close">&times;</button>
      </header>
      <form id="pack-form" class="pack-form" novalidate>
        <input type="hidden" name="id" />

        <div class="field-row">
          <label class="field">
            <span>Title</span>
            <input type="text" name="title" required maxlength="120" />
          </label>
          <label class="field">
            <span>Slug</span>
            <input type="text" name="slug" required maxlength="80" pattern="[a-z0-9-]+" />
            <small>Lowercase, hyphens. Used in URLs.</small>
          </label>
        </div>

        <div class="field-row">
          <label class="field">
            <span>Price (£)</span>
            <input type="number" name="price_gbp" min="0" step="0.01" required />
          </label>
          <label class="field">
            <span>Category</span>
            <select name="category">
              <option value="">—</option>
              <option value="contemporary">Contemporary</option>
              <option value="classic">Classic</option>
              <option value="seasonal">Seasonal</option>
              <option value="lifestyle">Lifestyle</option>
              <option value="planning">Planning</option>
              <option value="free">Free</option>
            </select>
          </label>
          <label class="field">
            <span>Status</span>
            <select name="status">
              <option value="active">Active (live)</option>
              <option value="draft">Draft (hidden)</option>
              <option value="archived">Archived</option>
            </select>
          </label>
        </div>

        <label class="field">
          <span>Description</span>
          <textarea name="description" rows="3" maxlength="500"></textarea>
        </label>

        <label class="field">
          <span>Contents (one bullet per line)</span>
          <textarea name="contents" rows="5" placeholder="20 Instagram post templates&#10;6 reel cover designs&#10;Story templates"></textarea>
        </label>

        <div class="field-row">
          <label class="field">
            <span>Sort order</span>
            <input type="number" name="sort_order" step="1" value="0" />
            <small>Lower numbers appear first on the storefront.</small>
          </label>
          <div class="field">
            <span>Cover image</span>
            <div class="cover-uploader">
              <img id="cover-preview" alt="" />
              <label class="cover-upload-btn">
                <input type="file" id="cover-file" accept="image/*" hidden />
                <span>Upload image</span>
              </label>
              <input type="hidden" name="cover_image_url" />
              <small id="cover-status"></small>
            </div>
          </div>
        </div>

        <p class="form-error" id="form-error" hidden></p>

        <footer class="modal-foot">
          <button type="button" id="delete-pack" class="admin-btn admin-btn-danger" hidden>Delete</button>
          <div class="spacer"></div>
          <button type="button" class="admin-btn admin-btn-ghost" id="modal-cancel">Cancel</button>
          <button type="submit" class="admin-btn admin-btn-primary" id="save-pack">Save pack</button>
        </footer>
      </form>
    </div>
  </div>

  <style is:global>
    /* Global so the JS-injected pack cards inherit the styles —
       Astro scopes by data-attribute which dynamic innerHTML never gets. */
    .admin-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      max-width: 1360px;
      margin: 0 auto;
      padding: 12px 36px 0;
    }
    .admin-back {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--english-violet);
      text-decoration: none;
      font-weight: 700;
    }
    .admin-back:hover { color: var(--ink); }
    .admin-bar-actions { display: flex; align-items: center; gap: 16px; }
    .admin-bar-count {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.6);
      font-weight: 600;
    }

    .admin-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 2px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid transparent;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .admin-btn-primary { background: var(--english-violet); color: var(--paper); }
    .admin-btn-primary:hover { background: var(--ink); }
    .admin-btn-ghost { background: transparent; border-color: rgba(71, 66, 84, 0.4); color: var(--english-violet); }
    .admin-btn-ghost:hover { background: rgba(71, 66, 84, 0.06); }
    .admin-btn-danger { background: transparent; border-color: #a05a3c; color: #a05a3c; }
    .admin-btn-danger:hover { background: #a05a3c; color: var(--paper); }
    .admin-btn[disabled] { opacity: 0.5; cursor: not-allowed; }

    .pack-list {
      max-width: 1360px;
      margin: 0 auto;
      padding: 24px 36px 200px;
    }
    .pack-loading {
      font-family: var(--sans);
      font-size: 13px;
      color: rgba(28,29,34,0.5);
      padding: 24px 0;
    }
    .pack-empty {
      padding: 32px;
      border: 1px dashed rgba(71,66,84,0.4);
      border-radius: 2px;
      font-family: var(--sans);
      color: rgba(28,29,34,0.7);
    }
    .pack-empty strong { color: var(--ink); }
    .pack-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    @media (max-width: 1080px) { .pack-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 720px)  { .pack-grid { grid-template-columns: 1fr; } }

    .pack-card {
      display: flex;
      flex-direction: column;
      border: 1px solid rgba(71, 66, 84, 0.4);
      border-radius: 2px;
      overflow: hidden;
      background: rgba(255, 255, 255, 0.4);
    }
    .pack-card.is-archived { opacity: 0.55; }
    .pack-card.is-draft { border-style: dashed; }
    .pack-cover {
      aspect-ratio: 4 / 3;
      background: var(--platinum);
      background-size: cover;
      background-position: center;
      position: relative;
    }
    .pack-status {
      position: absolute;
      top: 10px;
      left: 10px;
      padding: 4px 10px;
      background: rgba(28, 29, 34, 0.78);
      color: var(--paper);
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      border-radius: 2px;
    }
    .pack-status.is-draft { background: #8a7a36; }
    .pack-status.is-archived { background: rgba(28,29,34,0.5); }
    .pack-body { padding: 18px 18px 16px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
    .pack-title {
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 500;
      color: var(--ink);
      margin: 0;
    }
    .pack-meta {
      display: flex;
      justify-content: space-between;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.55);
      margin-bottom: 4px;
    }
    .pack-price { color: var(--english-violet); font-weight: 700; }
    .pack-desc {
      font-size: 13px;
      line-height: 1.55;
      color: rgba(28,29,34,0.65);
      flex: 1;
    }
    .pack-actions {
      display: flex;
      gap: 8px;
      padding: 12px 18px 16px;
      border-top: 1px solid rgba(71, 66, 84, 0.18);
    }

    /* Modal */
    .modal-backdrop {
      position: fixed; inset: 0;
      background: rgba(28, 29, 34, 0.55);
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 5vh 16px;
      z-index: 100;
      overflow-y: auto;
    }
    .modal {
      width: 100%;
      max-width: 760px;
      background: var(--paper);
      border-radius: 2px;
      box-shadow: 0 30px 80px rgba(0,0,0,0.25);
    }
    .modal-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 26px;
      border-bottom: 1px solid rgba(71, 66, 84, 0.18);
    }
    .modal-head h2 {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 500;
      margin: 0;
    }
    .modal-close {
      background: none;
      border: none;
      font-size: 28px;
      color: var(--english-violet);
      cursor: pointer;
      line-height: 1;
    }
    .pack-form {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 22px 26px 4px;
    }
    .field-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .field-row:has(> :nth-child(2):last-child) { grid-template-columns: 1fr 1fr; }
    @media (max-width: 640px) {
      .field-row { grid-template-columns: 1fr; }
    }
    .field { display: flex; flex-direction: column; gap: 6px; }
    .field > span {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--english-violet);
    }
    .field input,
    .field select,
    .field textarea {
      font-family: var(--sans);
      font-size: 15px;
      padding: 10px 12px;
      border: 1px solid rgba(71, 66, 84, 0.3);
      border-radius: 2px;
      background: rgba(255,255,255,0.5);
      color: var(--ink);
      outline: none;
      transition: border-color 0.2s;
      font: inherit;
      width: 100%;
    }
    .field input:focus, .field select:focus, .field textarea:focus { border-color: var(--english-violet); }
    .field small { font-size: 11px; color: rgba(28,29,34,0.55); }
    .field textarea { resize: vertical; min-height: 64px; }

    .cover-uploader {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
    }
    #cover-preview {
      width: 100%;
      max-width: 220px;
      aspect-ratio: 4 / 3;
      object-fit: cover;
      background: var(--platinum);
      border: 1px solid rgba(71, 66, 84, 0.25);
      border-radius: 2px;
      display: block;
    }
    #cover-preview:not([src]) { object-fit: contain; }
    .cover-upload-btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid rgba(71, 66, 84, 0.4);
      border-radius: 2px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--english-violet);
      cursor: pointer;
    }
    .cover-upload-btn:hover { background: rgba(71,66,84,0.06); }
    #cover-status { color: rgba(28,29,34,0.55); font-size: 11px; }

    .form-error {
      margin: 0;
      padding: 10px 12px;
      background: rgba(160, 90, 60, 0.1);
      border-left: 3px solid #a05a3c;
      color: #a05a3c;
      font-size: 13px;
      font-family: var(--sans);
    }

    .modal-foot {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 18px 26px 22px;
      border-top: 1px solid rgba(71,66,84,0.15);
      margin-top: 8px;
    }
    .modal-foot .spacer { flex: 1; }
  </style>

  <script>
    import { requireAdmin } from '../../lib/admin-gate.js';
    import { supabase, gbpFromPence, slugify } from '../../lib/supabase.js';

    const PACK_IMAGES_BUCKET = 'pack-images';

    const els = {
      grid: document.getElementById('pack-grid'),
      empty: document.getElementById('pack-empty'),
      loading: document.getElementById('pack-loading'),
      count: document.getElementById('pack-count'),
      newBtn: document.getElementById('new-pack'),
      modal: document.getElementById('modal'),
      modalTitle: document.getElementById('modal-title'),
      modalClose: document.getElementById('modal-close'),
      modalCancel: document.getElementById('modal-cancel'),
      form: document.getElementById('pack-form'),
      formError: document.getElementById('form-error'),
      saveBtn: document.getElementById('save-pack'),
      deleteBtn: document.getElementById('delete-pack'),
      coverPreview: document.getElementById('cover-preview'),
      coverFile: document.getElementById('cover-file'),
      coverStatus: document.getElementById('cover-status'),
      titleInput: null, // resolved below
      slugInput: null,
    };
    els.titleInput = els.form.elements.title;
    els.slugInput = els.form.elements.slug;

    let slugTouched = false;

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    function renderPack(p) {
      const status = p.status === 'active' ? '' : `<span class="pack-status is-${p.status}">${p.status}</span>`;
      const cover = p.cover_image_url ? `style="background-image:url('${escapeHtml(p.cover_image_url)}')"` : '';
      return `
        <article class="pack-card is-${p.status}" data-id="${p.id}">
          <div class="pack-cover" ${cover}>${status}</div>
          <div class="pack-body">
            <div class="pack-meta">
              <span>#${p.sort_order} · ${escapeHtml(p.category || '—')}</span>
              <span class="pack-price">${gbpFromPence(p.price_pence)}</span>
            </div>
            <h3 class="pack-title">${escapeHtml(p.title)}</h3>
            <p class="pack-desc">${escapeHtml(p.description || '')}</p>
          </div>
          <div class="pack-actions">
            <button type="button" class="admin-btn admin-btn-ghost" data-edit="${p.id}">Edit</button>
            ${p.status === 'archived'
              ? `<button type="button" class="admin-btn admin-btn-ghost" data-restore="${p.id}">Restore</button>`
              : `<button type="button" class="admin-btn admin-btn-ghost" data-archive="${p.id}">Archive</button>`}
          </div>
        </article>
      `;
    }

    async function loadPacks() {
      els.loading.hidden = false;
      const { data, error } = await supabase
        .from('packs')
        .select('*')
        .order('status', { ascending: true })
        .order('sort_order', { ascending: true })
        .order('created_at', { ascending: false });

      els.loading.hidden = true;

      if (error) {
        els.grid.innerHTML = `<p class="form-error">Failed to load packs: ${escapeHtml(error.message)}</p>`;
        return;
      }

      const packs = data ?? [];
      const active = packs.filter((p) => p.status === 'active').length;
      els.count.textContent = `${active} active · ${packs.length} total`;
      els.empty.hidden = packs.length !== 0;
      els.grid.innerHTML = packs.map(renderPack).join('');
    }

    function openModal(pack = null) {
      els.form.reset();
      els.formError.hidden = true;
      els.coverStatus.textContent = '';
      els.coverPreview.removeAttribute('src');
      slugTouched = Boolean(pack);

      if (pack) {
        els.modalTitle.textContent = 'Edit pack';
        els.form.elements.id.value = pack.id;
        els.form.elements.title.value = pack.title;
        els.form.elements.slug.value = pack.slug;
        els.form.elements.price_gbp.value = (pack.price_pence / 100).toFixed(2);
        els.form.elements.category.value = pack.category ?? '';
        els.form.elements.status.value = pack.status;
        els.form.elements.description.value = pack.description ?? '';
        els.form.elements.contents.value = (pack.contents ?? []).join('\n');
        els.form.elements.sort_order.value = pack.sort_order ?? 0;
        els.form.elements.cover_image_url.value = pack.cover_image_url ?? '';
        if (pack.cover_image_url) els.coverPreview.src = pack.cover_image_url;
        els.deleteBtn.hidden = false;
      } else {
        els.modalTitle.textContent = 'New pack';
        els.form.elements.id.value = '';
        els.form.elements.status.value = 'active';
        els.form.elements.sort_order.value = 0;
        els.deleteBtn.hidden = true;
      }

      els.modal.hidden = false;
      els.form.elements.title.focus();
    }

    function closeModal() {
      els.modal.hidden = true;
    }

    async function uploadCover(file) {
      const ext = (file.name.split('.').pop() || 'jpg').toLowerCase();
      const path = `covers/${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
      els.coverStatus.textContent = 'Uploading…';

      const { error } = await supabase.storage
        .from(PACK_IMAGES_BUCKET)
        .upload(path, file, { cacheControl: '3600', upsert: false, contentType: file.type });

      if (error) {
        els.coverStatus.textContent = `Upload failed: ${error.message}`;
        return null;
      }

      const { data } = supabase.storage.from(PACK_IMAGES_BUCKET).getPublicUrl(path);
      els.coverStatus.textContent = 'Uploaded.';
      return data.publicUrl;
    }

    async function savePack(e) {
      e.preventDefault();
      els.formError.hidden = true;
      els.saveBtn.setAttribute('disabled', 'true');
      els.saveBtn.textContent = 'Saving…';

      try {
        const fd = new FormData(els.form);
        const id = String(fd.get('id') || '').trim();
        const title = String(fd.get('title') || '').trim();
        const slug = String(fd.get('slug') || '').trim();
        const priceGbp = Number(fd.get('price_gbp') || 0);
        const contentsRaw = String(fd.get('contents') || '');
        const contents = contentsRaw
          .split('\n')
          .map((l) => l.trim())
          .filter(Boolean);

        if (!title) throw new Error('Title is required.');
        if (!slug) throw new Error('Slug is required.');
        if (Number.isNaN(priceGbp) || priceGbp < 0) throw new Error('Price must be 0 or more.');

        const payload = {
          title,
          slug,
          price_pence: Math.round(priceGbp * 100),
          category: String(fd.get('category') || '') || null,
          status: String(fd.get('status') || 'active'),
          description: String(fd.get('description') || '').trim() || null,
          contents,
          sort_order: Number(fd.get('sort_order') || 0),
          cover_image_url: String(fd.get('cover_image_url') || '').trim() || null,
        };

        let result;
        if (id) {
          result = await supabase.from('packs').update(payload).eq('id', id).select().single();
        } else {
          result = await supabase.from('packs').insert(payload).select().single();
        }

        if (result.error) throw result.error;

        closeModal();
        await loadPacks();
      } catch (err) {
        els.formError.textContent = err.message || 'Could not save pack.';
        els.formError.hidden = false;
      } finally {
        els.saveBtn.removeAttribute('disabled');
        els.saveBtn.textContent = 'Save pack';
      }
    }

    async function archivePack(id) {
      if (!confirm('Archive this pack? It will be hidden from the storefront but kept in the database.')) return;
      const { error } = await supabase.from('packs').update({ status: 'archived' }).eq('id', id);
      if (error) return alert(`Archive failed: ${error.message}`);
      await loadPacks();
    }

    async function restorePack(id) {
      const { error } = await supabase.from('packs').update({ status: 'active' }).eq('id', id);
      if (error) return alert(`Restore failed: ${error.message}`);
      await loadPacks();
    }

    async function deletePack(id) {
      if (!confirm('Permanently delete this pack? This cannot be undone.')) return;
      const { error } = await supabase.from('packs').delete().eq('id', id);
      if (error) return alert(`Delete failed: ${error.message}`);
      closeModal();
      await loadPacks();
    }

    // --- Wire up ---
    (async () => {
      const session = await requireAdmin();
      if (!session) return;
      await loadPacks();
    })();

    els.newBtn.addEventListener('click', () => openModal(null));
    els.modalClose.addEventListener('click', closeModal);
    els.modalCancel.addEventListener('click', closeModal);
    els.modal.addEventListener('click', (e) => {
      if (e.target === els.modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !els.modal.hidden) closeModal();
    });

    els.form.addEventListener('submit', savePack);

    els.deleteBtn.addEventListener('click', () => {
      const id = els.form.elements.id.value;
      if (id) deletePack(id);
    });

    // Auto-slug from title until user edits slug manually
    els.titleInput.addEventListener('input', () => {
      if (!slugTouched) els.slugInput.value = slugify(els.titleInput.value);
    });
    els.slugInput.addEventListener('input', () => { slugTouched = true; });
    els.slugInput.addEventListener('blur', () => {
      els.slugInput.value = slugify(els.slugInput.value);
    });

    els.coverFile.addEventListener('change', async (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      const url = await uploadCover(file);
      if (url) {
        els.form.elements.cover_image_url.value = url;
        els.coverPreview.src = url;
      }
    });

    // Delegated handlers for pack-card buttons
    els.grid.addEventListener('click', async (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;

      const editId = target.getAttribute('data-edit');
      if (editId) {
        const { data, error } = await supabase.from('packs').select('*').eq('id', editId).single();
        if (error) return alert(`Load failed: ${error.message}`);
        openModal(data);
        return;
      }
      const archiveId = target.getAttribute('data-archive');
      if (archiveId) return archivePack(archiveId);
      const restoreId = target.getAttribute('data-restore');
      if (restoreId) return restorePack(restoreId);
    });
  </script>
</BaseLayout>
