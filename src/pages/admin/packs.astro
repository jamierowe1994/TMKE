    }
    .catalogue-grid.is-view-grid .pack-title {
      font-family: var(--sans);
      font-size: 14px;
      font-weight: 700;
      margin: 2px 0 4px;
      color: var(--ink);
    }
    .catalogue-grid.is-view-grid .pack-desc {
      font-family: var(--sans);
      font-size: 13px;
      line-height: 1.5;
      color: rgba(28, 29, 34, 0.65);
