      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .gift-field input:focus {
      outline: none; border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(var(--violet-rgb), 0.12);
    }
    .gift-error {
      font-family: var(--sans); font-size: 13px;
      color: #a23b3b; background: rgba(162, 59, 59, 0.08);
      border: 1px solid rgba(162, 59, 59, 0.25);
      padding: 9px 12px; border-radius: 4px; margin: 0 0 16px;
    }
    .gift-error[hidden] { display: none; }
    .gift-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 6px; }

    @media (max-width: 720px) {
      .catalogue-top { padding: 32px 22px 12px; }
      .catalogue-controls { padding: 14px 22px; }
      .catalogue-body { padding: 20px 22px 120px; }
      .catalogue-grid.is-view-list .pack-card {
        grid-template-columns: 24px 56px 1fr auto;
        row-gap: 6px;
      }
      .catalogue-grid.is-view-list .pack-meta,
      .catalogue-grid.is-view-list .pack-status { display: none; }
      .catalogue-grid.is-view-list .pack-price { grid-column: 3 / -1; text-align: left; font-size: 15px; }
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js" is:inline></script>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { supabase, gbpFromPence } from "../../lib/supabase.js";
    import { rebuildSite } from "../../lib/site-rebuild.js";

    // Network tag from the email domain (mirrors the Worker's crmTags).
    const netTag = (email) => { const d = (String(email || "").toLowerCase().match(/@([^@\s]+)$/) || [])[1] || ""; if (!d) return null; if (d.endsWith("experts.co.uk")) return "Network: TEG"; if (d === "fineandcountry.com") return "Network: Fine-and-Country"; return "Network: External"; };

    /** @type {any[]} */
    let allPacks = [];
    let filter = "all";
    let sortBy = "manual";
    let view = "grid";

    // Persisted UI prefs
    try {
      const saved = JSON.parse(localStorage.getItem("tmke.admin.catalogue.prefs") || "{}");
      if (saved.view === "grid" || saved.view === "list") view = saved.view;
      if (typeof saved.sortBy === "string") sortBy = saved.sortBy;
      if (typeof saved.filter === "string") filter = saved.filter;
    } catch {}

    function savePrefs() {
      try {
        localStorage.setItem(
          "tmke.admin.catalogue.prefs",
          JSON.stringify({ view, sortBy, filter }),
        );
      } catch {}
    }

    function escapeHtml(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
      }[c]));
    }

    // Which half of the catalogue is on show. Kept in the address so a reload,
    // or coming back from the pack editor, lands where you were.
    let kind = new URLSearchParams(location.search).get("kind") === "print" ? "print" : "social";

    function syncKindTabs() {
      document.querySelectorAll(".cat-tab").forEach((b) => {
        b.classList.toggle("is-on", b.getAttribute("data-kind") === kind);
      });
      const nu = document.getElementById("cat-new");
      if (nu) {
        nu.href = kind === "print" ? "/admin/packs/editor?kind=print" : "/admin/packs/editor";
        nu.textContent = kind === "print" ? "+ New print pack" : "+ New pack";
      }
      const demo = document.getElementById("demo-pack");
      if (demo) demo.hidden = kind === "print";   // the demo pack is a social one
    }

    document.querySelectorAll(".cat-tab").forEach((b) => {
      b.addEventListener("click", () => {
        kind = b.getAttribute("data-kind") === "print" ? "print" : "social";
        const u = new URL(location.href);
        if (kind === "print") u.searchParams.set("kind", "print"); else u.searchParams.delete("kind");
        history.replaceState(null, "", u);
        render();
      });
    });

    function visiblePacks() {
      let rows = allPacks.filter((p) => p.demo !== true);   // the demo pack has its own panel above
      // Print packs are a different trade from social ones — different
      // questions when you make them, different people allowed to see them —
      // so they get their own half of the catalogue rather than being mixed in.
      rows = rows.filter((p) => (p.kind || "social") === kind);
      if (filter !== "all") rows = rows.filter((p) => p.status === filter);
      switch (sortBy) {
        case "newest":
          rows.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
          break;
        case "oldest":
          rows.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
          break;
        case "price-desc":
          rows.sort((a, b) => (b.price_pence || 0) - (a.price_pence || 0));
          break;
        case "price-asc":
          rows.sort((a, b) => (a.price_pence || 0) - (b.price_pence || 0));
          break;
        case "title":
          rows.sort((a, b) => String(a.title).localeCompare(String(b.title)));
          break;
        case "manual":
        default:
          rows.sort((a, b) => (a.sort_order ?? 0) - (b.sort_order ?? 0));
      }
      return rows;
    }

    function packCardHtml(p) {
      const cover = p.cover_image_url
        ? `style="background-image:url('${escapeHtml(p.cover_image_url)}')"`
        : "";
      const editHref = `/admin/packs/editor?id=${encodeURIComponent(p.id)}`;
      const dragHandle = `
        <span class="pack-handle" aria-hidden="true" title="Drag to reorder">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
            <circle cx="4" cy="3" r="1"/><circle cx="10" cy="3" r="1"/>
            <circle cx="4" cy="7" r="1"/><circle cx="10" cy="7" r="1"/>
            <circle cx="4" cy="11" r="1"/><circle cx="10" cy="11" r="1"/>
          </svg>
        </span>`;
      const statusPill = `<span class="pack-status is-${p.status}">${p.status}</span>`;
      const archiveOrRestore = p.status === "archived"
        ? `<button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-restore="${p.id}">Restore</button>`
        : `<button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-archive="${p.id}">Archive</button>`;
      const editBtn = `<a href="${editHref}" class="admin-btn admin-btn-primary admin-btn-sm" data-edit="${p.id}">Edit</a>`;
      const giftBtn = `<button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-gift="${p.id}">Gift</button>`;

      if (view === "list") {
        return `
          <article class="pack-card is-${p.status}" data-id="${p.id}">
            ${dragHandle}
            <div class="pack-cover" ${cover}></div>
            <div class="pack-body">
              <h3 class="pack-title">${escapeHtml(p.title)}</h3>
              <p class="pack-desc">${escapeHtml(p.description || "—")}</p>
            </div>
            <div class="pack-meta">${escapeHtml(p.category || "—")}</div>
            ${statusPill}
            <div class="pack-price">${gbpFromPence(p.price_pence)}</div>
            <div class="pack-actions">${giftBtn} ${editBtn} ${archiveOrRestore}</div>
          </article>
        `;
      }
      return `
        <article class="pack-card is-${p.status}" data-id="${p.id}">
          <div class="pack-cover" ${cover}>
            ${dragHandle}
            ${statusPill}
          </div>
          <div class="pack-body">
            <div class="pack-meta">
              <span>${escapeHtml(p.category || "—")}</span>
              <span class="pack-price">${gbpFromPence(p.price_pence)}</span>
            </div>
            <h3 class="pack-title">${escapeHtml(p.title)}</h3>
            <p class="pack-desc">${escapeHtml(p.description || "")}</p>
            <div class="pack-actions">${giftBtn} ${editBtn} ${archiveOrRestore}</div>
          </div>
        </article>
      `;
    }

    function render() {
      syncKindTabs();
      const grid = document.getElementById("catalogue-grid");
      const emptyEl = document.getElementById("catalogue-empty");
      const sub = document.getElementById("catalogue-sub");
      if (!grid) return;
      const rows = visiblePacks();
      const active = allPacks.filter((p) => p.status === "active").length;
      const draft = allPacks.filter((p) => p.status === "draft").length;
      const archived = allPacks.filter((p) => p.status === "archived").length;
      if (sub) {
        sub.textContent =
          `${active} active · ${draft} draft · ${archived} archived · ${rows.length} shown`;
      }
      grid.className = `catalogue-grid is-view-${view}` + (sortBy === "manual" ? "" : " is-locked");
      if (rows.length === 0) {
        grid.innerHTML = "";
        if (emptyEl) {
          emptyEl.hidden = false;
          emptyEl.innerHTML = kind === "print"
            ? 'No print packs yet \u2014 <strong>+ New print pack</strong> makes one. A print pack isn\u2019t sold: you pick the brands it is for, and only their agents ever see it.'
            : 'No packs yet \u2014 click <strong>+ New pack</strong> to add the first one.';
        }
      } else {
        if (emptyEl) emptyEl.hidden = true;
        grid.innerHTML = rows.map(packCardHtml).join("");
      }

      wireSortable(grid);
    }

    /** @type {any} */
    let currentSortable = null;
    function wireSortable(grid) {
      if (currentSortable && typeof currentSortable.destroy === "function") {
        currentSortable.destroy();
        currentSortable = null;
      }
      const Sortable = /** @type {any} */ (window).Sortable;
      if (!Sortable || sortBy !== "manual" || filter !== "all") return;
      currentSortable = Sortable.create(grid, {
        animation: 180,
        handle: ".pack-handle",
        ghostClass: "sortable-ghost",
        dragClass: "sortable-drag",
        onEnd: persistOrder,
      });
    }

    let toastTimer = null;
    function toast(msg) {
      const el = document.getElementById("catalogue-toast");
      if (!el) return;
      el.textContent = msg;
      el.hidden = false;
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { el.hidden = true; }, msg.length > 40 ? 5000 : 1800);
    }
    // A note carried over from the pack editor (the site rebuild it started).
    try { const n = sessionStorage.getItem("tmke.admin.packsNote"); if (n) { sessionStorage.removeItem("tmke.admin.packsNote"); setTimeout(() => toast(n), 300); } } catch (_) {}
    // Archive, restore and reorder change the shop, which is built at deploy time.
    async function rebuildAndSay(done) { const m = await rebuildSite(supabase); toast(m ? done + " " + m : done); }

    async function persistOrder() {
      const grid = document.getElementById("catalogue-grid");
      if (!grid) return;
      const ids = Array.from(grid.querySelectorAll("[data-id]"))
        .map((el) => el.getAttribute("data-id"))
        .filter(Boolean);
      const updates = ids.map((id, idx) => ({ id, sort_order: idx }));

      // Optimistically update local state
      const map = new Map(updates.map((u) => [u.id, u.sort_order]));
      allPacks.forEach((p) => {
        if (map.has(p.id)) p.sort_order = map.get(p.id);
      });

      const promises = updates.map((u) =>
        supabase.from("packs").update({ sort_order: u.sort_order }).eq("id", u.id),
      );
      const results = await Promise.all(promises);
      const failures = results.filter((r) => r.error);
      if (failures.length) {
        console.error("[TMKE] reorder failures", failures);
        toast(`Couldn't save order (${failures.length} failed). Refresh to reset.`);
      } else {
        rebuildAndSay("Order saved.");
      }
    }

    async function archivePack(id) {
      const { error } = await supabase.from("packs").update({ status: "archived" }).eq("id", id);
      if (error) { alert("Archive failed: " + error.message); return; }
      const row = allPacks.find((p) => p.id === id);
      if (row) row.status = "archived";
      render();
      rebuildAndSay("Pack archived.");
    }

    async function restorePack(id) {
      const { error } = await supabase.from("packs").update({ status: "active" }).eq("id", id);
      try { await supabase.from("packs").update({ launched_at: new Date().toISOString() }).eq("id", id).is("launched_at", null); } catch (_) {}
      if (error) { alert("Restore failed: " + error.message); return; }
      const row = allPacks.find((p) => p.id === id);
      if (row) row.status = "active";
      render();
      rebuildAndSay("Pack restored.");
    }

    // ---- The demo pack: one flagged pack, copies of chosen templates ----
    // Folded by default (it is tall); the choice is remembered on this browser.
    let demoPack = null;
    (function foldDemoPack() {
      const panel = document.getElementById("demo-pack"), btn = document.getElementById("demo-pack-toggle");
      let open = false;
      try { open = localStorage.getItem("tmke.admin.demoPackOpen") === "1"; } catch (_) {}
      const apply = () => { panel.classList.toggle("is-collapsed", !open); btn.setAttribute("aria-expanded", open ? "true" : "false"); };
      apply();
      btn.addEventListener("click", () => { open = !open; try { localStorage.setItem("tmke.admin.demoPackOpen", open ? "1" : "0"); } catch (_) {} apply(); });
    })();
    function dpSummary(text) { const el = document.getElementById("demo-pack-summary"); if (el) el.textContent = text || ""; }
    const dpEl = (id) => document.getElementById(id);
    function dpNote(text) { const n = dpEl("demo-pack-note"); n.textContent = text || ""; n.hidden = !text; }
    async function loadDemoPack() {
      const actions = dpEl("demo-pack-actions"), body = dpEl("demo-pack-body");
      actions.innerHTML = "";
      const { data, error } = await supabase.from("packs").select("*").eq("demo", true).limit(1);
      if (error) {
        body.hidden = true;
        dpSummary("needs the SQL run");
        dpNote("The catalogue has no demo flag yet. Run supabase/packs_demo.sql in the Supabase SQL editor, then reload this page.");
        return;
      }
      demoPack = (data && data[0]) || null;
      if (!demoPack) {
        body.hidden = true;
        dpSummary("not created yet");
        dpNote("");
        actions.innerHTML = `<button type="button" class="admin-btn admin-btn-primary" id="demo-pack-create">Create the demo pack</button>`;
        dpEl("demo-pack-create").addEventListener("click", async () => {
          const { error: e } = await supabase.from("packs").insert({ slug: "demo-pack", title: "Demo pack", description: "A few templates to try the Studio with.", price_pence: 0, category: "free", status: "active", demo: true, sort_order: 9999, contents: [] });
          if (e) { dpNote("Couldn't create it: " + e.message); return; }
          loadDemoPack();
        });
        return;
      }
      actions.innerHTML = `<span class="demo-pack-note" style="margin:0">Live · ${escapeHtml(demoPack.title)}</span>`;
      body.hidden = false;
      dpNote("");
      /* source_id is the original a Demo pack template follows
         (supabase/templates_follow_source.sql). Asked for first; a database
         that has not had that SQL run yet is read without it. */
      const demoQ = (cols) => supabase.from("templates").select(cols).eq("pack_id", demoPack.id).order("sort_order", { ascending: true });
      const [{ data: inPack }, { data: all }, { data: packs }] = await Promise.all([
        demoQ("id, name, thumb_url, category, sort_order, source_id").then((r) => r.error ? demoQ("id, name, thumb_url, category, sort_order") : r),
        supabase.from("templates").select("id, name, pack_id, thumb_url, sort_order").eq("status", "active").neq("pack_id", demoPack.id).order("sort_order", { ascending: true }),
        supabase.from("packs").select("id, title, sort_order").eq("demo", false).order("sort_order", { ascending: true }),
      ]);
      const packTitle = new Map((packs || []).map((p) => [p.id, p.title]));
      const originPack = new Map((all || []).map((t) => [t.id, t.pack_id]));
      dpSummary(`${(inPack || []).length} template${(inPack || []).length === 1 ? "" : "s"}`);
      const list = dpEl("demo-pack-list");
      list.innerHTML = (inPack || []).length ? (inPack || []).map((t) => `
        <div class="demo-pack-item">
          <div class="dp-thumb"${t.thumb_url ? ` style="background-image:url('${escapeHtml(t.thumb_url)}')"` : ""}></div>
          <div class="dp-name">${escapeHtml(t.name)}</div>
          <div class="dp-from">${t.source_id
            ? "Follows " + escapeHtml(packTitle.get(originPack.get(t.source_id)) || "its original")
            : "A copy &mdash; not linked to its original"}</div>
          <button type="button" data-dp-remove="${escapeHtml(t.id)}">Remove</button>
        </div>`).join("") : `<p class="demo-pack-empty">Nothing in it yet. Add a template below.</p>`;
      list.querySelectorAll("[data-dp-remove]").forEach((b) => b.addEventListener("click", async () => {
        const { error: e } = await supabase.from("templates").delete().eq("id", b.getAttribute("data-dp-remove")).eq("pack_id", demoPack.id);
        if (e) { dpNote("Couldn't remove it: " + e.message); return; }
        loadDemoPack();
      }));
      // The picker: thumbnails, grouped by pack in the catalogue's order.
      const picker = dpEl("demo-pack-picker");
      const byPack = new Map();
      (all || []).filter((t) => t.pack_id).forEach((t) => { if (!byPack.has(t.pack_id)) byPack.set(t.pack_id, []); byPack.get(t.pack_id).push(t); });
      const order = (packs || []).map((p) => p.id).filter((id) => byPack.has(id));
      picker.innerHTML = order.length ? order.map((pid) => `
        <h3>${escapeHtml(packTitle.get(pid) || "Pack")}</h3>
        <div class="dp-grid">${byPack.get(pid).map((t) => `
          <button type="button" class="dp-pick" data-dp-add="${escapeHtml(t.id)}" title="${escapeHtml(t.name)}">
            <span class="dp-thumb"${t.thumb_url ? ` style="background-image:url('${escapeHtml(t.thumb_url)}')"` : ""}></span>
            <span class="dp-name">${escapeHtml(t.name)}</span>
          </button>`).join("")}</div>`).join("") : `<p class="demo-pack-empty">No templates in the catalogue yet.</p>`;
      picker.querySelectorAll("[data-dp-add]").forEach((b) => b.addEventListener("click", () => { b.disabled = true; addToDemoPack(b.getAttribute("data-dp-add")); }));
    }
    async function addToDemoPack(id) {
      if (!id || !demoPack) return;
      const { data: src, error: e1 } = await supabase.from("templates").select("*").eq("id", id).single();
      if (e1 || !src) { dpNote("Couldn't read that template."); return; }
      const copy = { ...src };
      delete copy.created_at; delete copy.updated_at;
      copy.id = "tmpl-" + Math.random().toString(36).slice(2, 8);
      copy.pack_id = demoPack.id;
      copy.status = "active";
      copy.sort_order = Date.now() % 100000;
      /* Linked, not just copied: the database brings it up to date every time
         the original is saved (supabase/templates_follow_source.sql). It used
         to be a copy and nothing more, so a change to the original never
         reached the Demo pack -- Testimonial 3's new quotation mark, 12 Oct. */
      copy.source_id = src.id;
      let { error: e2 } = await supabase.from("templates").insert(copy);
      let unlinked = false;
      if (e2 && /source_id/.test(e2.message || "")) {
        delete copy.source_id;
        ({ error: e2 } = await supabase.from("templates").insert(copy));
        unlinked = !e2;
      }
      if (e2) { dpNote("Couldn't add it: " + e2.message); return; }
      await loadDemoPack();   // clears the note, so anything to say comes after
      if (unlinked) dpNote("Added, but as a copy: run supabase/templates_follow_source.sql so the Demo pack follows its originals.");
    }

    async function loadPacks() {
      const { data, error } = await supabase
        .from("packs")
        .select("*")
        .order("sort_order", { ascending: true })
        .order("created_at", { ascending: false });

      const loading = document.getElementById("catalogue-loading");
      if (loading) loading.hidden = true;
      const body = document.getElementById("catalogue-body");
      if (body) body.removeAttribute("aria-busy");

      if (error) {
        if (loading) {
          loading.hidden = false;
          loading.textContent = "Failed to load catalogue: " + error.message;
        }
        return;
      }

      allPacks = data || [];
      render();
    }

    function syncInitialUI() {
      document.querySelectorAll("[data-filter]").forEach((el) => {
        el.classList.toggle("is-active", el.getAttribute("data-filter") === filter);
      });
      document.querySelectorAll("[data-view]").forEach((el) => {
        el.classList.toggle("is-active", el.getAttribute("data-view") === view);
      });
      const sortEl = document.getElementById("catalogue-sort");
      if (sortEl) sortEl.value = sortBy;
    }

    (async () => {
      const session = await requireAdmin();
      if (!session) return;
      syncInitialUI();
      await loadPacks();
      loadDemoPack();
      loadHubNotices();
      loadCustomerEmails();
    })();

    // ---- Hub notifications (supabase/member_broadcasts.sql) ----
    // The admin writes the notice; the Worker puts it in every member's bell
    // when it's due (runMemberBroadcasts), and is nudged straight away for
    // "Now" and for a withdrawal rather than waiting for its five-minute tick.
    const hnEl = (id) => document.getElementById(id);
    const HN_WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    (function foldHubNotices() {
      const panel = hnEl("hn"), btn = hnEl("hn-toggle");
      let open = false;
      try { open = localStorage.getItem("tmke.admin.hubNoticesOpen") === "1"; } catch (_) {}
      const apply = () => { panel.classList.toggle("is-collapsed", !open); btn.setAttribute("aria-expanded", open ? "true" : "false"); };
      apply();
      btn.addEventListener("click", () => { open = !open; try { localStorage.setItem("tmke.admin.hubNoticesOpen", open ? "1" : "0"); } catch (_) {} apply(); });
    })();
    function hnNote(text) { const n = hnEl("hn-note"); n.textContent = text || ""; n.hidden = !text; }
    function hnError(text) { const n = hnEl("hn-error"); n.textContent = text || ""; n.hidden = !text; }
    async function hnNudge() {
      if (!HN_WORKER) return;
      try {
        const { data: { session } } = await supabase.auth.getSession();
        await fetch(`${HN_WORKER}/admin/broadcasts/run`, { method: "POST", headers: { Authorization: "Bearer " + (session && session.access_token) } });
      } catch (_) {}
    }
    const hnWhen = (iso) => new Date(iso).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
    // The Studio's packs for the "Takes them to" list: the demo pack first.
    let hnPacks = [];
    async function loadHubNoticePacks() {
      const { data } = await supabase.from("packs").select("id, title, demo, status, sort_order").neq("status", "archived").order("sort_order", { ascending: true });
      hnPacks = data || [];
      const sel = hnEl("hn-pack");
      const others = hnPacks.filter((p) => !p.demo);
      sel.innerHTML = `<option value="demo">Demo pack</option>` + others.map((p) =>
        `<option value="${escapeHtml(p.id)}">${escapeHtml(p.title)}${p.status === "draft" ? " (draft)" : ""}</option>`).join("");
    }
    function hnTarget() {
      const kind = hnEl("hn-link").value;
      if (kind === "pack") {
        const id = hnEl("hn-pack").value;
        const p = id === "demo" ? null : hnPacks.find((x) => x.id === id);
        return { href: `/account/editor?pack=${encodeURIComponent(id)}`, label: p ? p.title : "Demo pack" };
      }
      if (kind === "url") {
        const u = hnEl("hn-url").value.trim();
        return { href: u, label: u };
      }
      return { href: kind, label: hnEl("hn-link").selectedOptions[0].textContent };
    }
    function hnSyncForm() {
      const kind = hnEl("hn-link").value;
      hnEl("hn-pack-wrap").hidden = kind !== "pack";
      hnEl("hn-url-wrap").hidden = kind !== "url";
      const later = document.querySelector('input[name="hn-when"]:checked').value === "later";
      hnEl("hn-at").disabled = !later;
      hnEl("hn-send").textContent = later ? "Schedule for every member" : "Send to every member";
      const t = hnEl("hn-title").value.trim(), m = hnEl("hn-text").value.trim();
      hnEl("hn-pv-title").textContent = t || "Your headline";
      hnEl("hn-pv-text").textContent = m.slice(0, 90);
      const c = hnEl("hn-count");
      c.textContent = m.length > 90 ? `${m.length} characters. The bell shows the first 90, so put the point first.` : "The bell shows the first 90 characters.";
      c.classList.toggle("is-over", m.length > 90);
    }
    ["hn-title", "hn-text", "hn-url", "hn-at"].forEach((id) => hnEl(id).addEventListener("input", hnSyncForm));
    ["hn-link", "hn-pack"].forEach((id) => hnEl(id).addEventListener("change", hnSyncForm));
    document.querySelectorAll('input[name="hn-when"]').forEach((r) => r.addEventListener("change", () => {
      if (r.value === "later" && !hnEl("hn-at").value) {
        // Tomorrow at 9am to start from.
        const d = new Date(); d.setDate(d.getDate() + 1); d.setHours(9, 0, 0, 0);
        const pad = (n) => String(n).padStart(2, "0");
        hnEl("hn-at").value = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T09:00`;
      }
      hnSyncForm();
    }));
    hnEl("hn-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      hnError("");
      const title = hnEl("hn-title").value.trim();
      const body = hnEl("hn-text").value.trim();
      if (!title) { hnError("Add a headline."); hnEl("hn-title").focus(); return; }
      const target = hnTarget();
      if (hnEl("hn-link").value === "url" && !/^https?:\/\/\S+\.\S+/i.test(target.href)) { hnError("Add the full web address, starting https://"); hnEl("hn-url").focus(); return; }
      const later = document.querySelector('input[name="hn-when"]:checked').value === "later";
      let sendAt = new Date();
      if (later) {
        const v = hnEl("hn-at").value;
        sendAt = v ? new Date(v) : null;
        if (!sendAt || isNaN(sendAt)) { hnError("Choose the date and time it goes out."); return; }
        if (sendAt < new Date()) { hnError("That time has passed. Choose a later one, or send it now."); return; }
      }
      const ask = later
        ? `Schedule "${title}" for every member's hub on ${hnWhen(sendAt)}?`
        : `Send "${title}" to every member's hub now?`;
      if (!confirm(ask)) return;
      const btn = hnEl("hn-send");
      btn.disabled = true;
      const { error } = await supabase.from("member_broadcasts").insert({
        title, body: body || null, href: target.href, link_label: target.label, send_at: sendAt.toISOString(), status: "scheduled",
      });
      btn.disabled = false;
      if (error) { hnError("Couldn't save it: " + error.message); return; }
      hnEl("hn-title").value = ""; hnEl("hn-text").value = "";
      hnSyncForm();
      if (!later) { await hnNudge(); toast("Sent. It's in every member's bell."); }
      else toast(`Scheduled for ${hnWhen(sendAt)}.`);
      loadHubNotices();
    });
    async function loadHubNotices() {
      hnSyncForm();
      if (!hnPacks.length) loadHubNoticePacks().then(hnSyncForm);
      const { data, error } = await supabase.from("member_broadcasts").select("*").order("send_at", { ascending: false }).limit(20);
      const list = hnEl("hn-list");
      if (error) {
        hnEl("hn-body").hidden = true;
        hnEl("hn-summary").textContent = "needs the SQL run";
        hnNote("Run supabase/member_broadcasts.sql in the Supabase SQL editor, then reload this page.");
        return;
      }
      hnEl("hn-body").hidden = false;
      hnNote("");
      const rows = data || [];
      const upcoming = rows.filter((r) => r.status === "scheduled").length;
      hnEl("hn-summary").textContent = upcoming ? `${upcoming} scheduled` : "";
      const STATUS = { scheduled: ["Scheduled", "scheduled"], sending: ["Sending", "sending"], sent: ["Sent", "sent"], failed: ["Didn't send", "failed"], cancelled: ["Cancelled", "off"], withdraw: ["Withdrawing", "sending"], withdrawn: ["Withdrawn", "off"] };
      list.innerHTML = rows.length ? rows.map((r) => {
        const [label, tone] = STATUS[r.status] || [r.status, "off"];
        const when = r.status === "sent" || r.status === "withdrawn"
          ? `Sent ${hnWhen(r.sent_at || r.send_at)} to ${r.sent_count || 0} account${r.sent_count === 1 ? "" : "s"}`
          : r.status === "scheduled" ? `Goes out ${hnWhen(r.send_at)}` : hnWhen(r.send_at);
        const action = r.status === "scheduled" ? `<button type="button" data-hn-cancel="${escapeHtml(r.id)}">Cancel</button>`
          : r.status === "sent" ? `<button type="button" data-hn-withdraw="${escapeHtml(r.id)}">Withdraw</button>` : "";
        return `<div class="hn-item">
          <div class="hn-item-title">${escapeHtml(r.title)}</div>
          <div class="hn-item-side"><span class="hn-pill hn-pill--${tone}">${label}</span>${action}</div>
          <div class="hn-item-meta">${escapeHtml(when)}${r.link_label ? " · Opens " + escapeHtml(r.link_label) : ""}${r.error ? " · " + escapeHtml(r.error) : ""}</div>
        </div>`;
      }).join("") : `<p class="demo-pack-empty">Nothing yet.</p>`;
      list.querySelectorAll("[data-hn-cancel]").forEach((b) => b.addEventListener("click", async () => {
        if (!confirm("Cancel this notification? It won't go out.")) return;
        const { error: e } = await supabase.from("member_broadcasts").update({ status: "cancelled" }).eq("id", b.getAttribute("data-hn-cancel")).eq("status", "scheduled");
        if (e) { hnError("Couldn't cancel it: " + e.message); return; }
        loadHubNotices();
      }));
      list.querySelectorAll("[data-hn-withdraw]").forEach((b) => b.addEventListener("click", async () => {
        if (!confirm("Take this out of every member's bell?")) return;
        const { error: e } = await supabase.from("member_broadcasts").update({ status: "withdraw" }).eq("id", b.getAttribute("data-hn-withdraw")).eq("status", "sent");
        if (e) { hnError("Couldn't withdraw it: " + e.message); return; }
        await hnNudge();
        toast("Withdrawn from every member's bell.");
        loadHubNotices();
      }));
    }

    // Filter chips
    document.querySelectorAll("[data-filter]").forEach((el) => {
      el.addEventListener("click", () => {
        filter = el.getAttribute("data-filter") || "all";
        document.querySelectorAll("[data-filter]").forEach((c) => c.classList.remove("is-active"));
        el.classList.add("is-active");
        savePrefs();
        render();
      });
    });

    // View toggle
    document.querySelectorAll("[data-view]").forEach((el) => {
      el.addEventListener("click", () => {
        view = el.getAttribute("data-view") || "grid";
        document.querySelectorAll("[data-view]").forEach((c) => c.classList.remove("is-active"));
        el.classList.add("is-active");
        savePrefs();
        render();
      });
    });

    // Sort dropdown
    document.getElementById("catalogue-sort")?.addEventListener("change", (e) => {
      sortBy = e.target.value;
      savePrefs();
      render();
    });

    // Action delegation
    document.getElementById("catalogue-grid")?.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      const archiveId = target.getAttribute("data-archive");
      if (archiveId) { e.preventDefault(); archivePack(archiveId); return; }
      const restoreId = target.getAttribute("data-restore");
      if (restoreId) { e.preventDefault(); restorePack(restoreId); return; }
      const giftId = target.getAttribute("data-gift");
      if (giftId) { e.preventDefault(); openGift(giftId); return; }
    });

    // ===== Gift a pack =====
    // Lets an admin drop a pack into someone's library as a £0 "paid" order,
    // so it shows up in their /account library without a real purchase.
    let customerEmails = [];
    let giftPackId = null;

    async function loadCustomerEmails() {
      const { data, error } = await supabase
        .from("orders")
        .select("buyer_email")
        .eq("status", "paid");
      if (error) return;
      customerEmails = [...new Set((data || []).map((o) => o.buyer_email).filter(Boolean))].sort();
      const list = document.getElementById("gift-email-list");
      if (list) list.innerHTML = customerEmails.map((e) => `<option value="${escapeHtml(e)}"></option>`).join("");
    }

    const giftModal = document.getElementById("gift-modal");
    const giftEmailInput = document.getElementById("gift-email");
    const giftNameInput = document.getElementById("gift-name");
    const giftConfirmBtn = document.getElementById("gift-confirm");
    const giftErrorEl = document.getElementById("gift-error");

    function showGiftError(msg) {
      if (!giftErrorEl) return;
      giftErrorEl.textContent = msg;
      giftErrorEl.hidden = false;
    }

    function openGift(id) {
      const pack = allPacks.find((p) => p.id === id);
      if (!pack || !giftModal) return;
      giftPackId = id;
      const nameEl = document.getElementById("gift-pack-name");
      if (nameEl) nameEl.textContent = pack.title;
      if (giftErrorEl) giftErrorEl.hidden = true;
      if (giftEmailInput) giftEmailInput.value = "";
      if (giftNameInput) giftNameInput.value = "";
      giftModal.hidden = false;
      setTimeout(() => giftEmailInput && giftEmailInput.focus(), 40);
    }

    function closeGift() {
      if (giftModal) giftModal.hidden = true;
      giftPackId = null;
    }

    async function confirmGift() {
      const pack = allPacks.find((p) => p.id === giftPackId);
      if (!pack) return;
      const email = (giftEmailInput.value || "").trim().toLowerCase();
      const name = (giftNameInput.value || "").trim();
      if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        showGiftError("Enter a valid email address for the recipient.");
        return;
      }
      if (giftErrorEl) giftErrorEl.hidden = true;
      giftConfirmBtn.disabled = true;
      giftConfirmBtn.textContent = "Gifting…";

      const { error } = await supabase.from("orders").insert({
        pack_id: pack.id,
        pack_slug: pack.slug,
        pack_title: pack.title,
        amount_pence: 0,
        buyer_name: name || email.split("@")[0],
        buyer_email: String(email || "").trim().toLowerCase(),   // an account's email always is, so an order's is too
        buyer_company: "",
        payment_method: "gift",
        payment_ref: "gift_" + Date.now(),
        status: "paid",
      });

      giftConfirmBtn.disabled = false;
      giftConfirmBtn.textContent = "Gift this pack →";

      if (error) {
        showGiftError(error.message || "Couldn't gift the pack. Please try again.");
        return;
      }
      // Fire the "order placed" marketing automation (e.g. purchase
      // confirmation). Fire-and-forget so the UI never waits on it.
      try {
        const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
        const { data: { session } } = await supabase.auth.getSession();
        if (WORKER && session) {
          const parts = (name || "").trim().split(/\s+/);
          fetch(`${WORKER}/automations/fire`, {
            method: "POST",
            headers: { "Content-Type": "application/json", Authorization: `Bearer ${session.access_token}` },
            body: JSON.stringify({
              trigger: "order_placed", email,
              first_name: parts.shift() || (name || email.split("@")[0]), last_name: parts.join(" ") || null,
              source: "pack_gift", lifecycle: "customer",
              tags: ["Pack-Purchased", "Pack Name: " + pack.title, netTag(email)].filter(Boolean),
              payload: { pack: pack.title, pack_slug: pack.slug, amount_pence: 0 },
            }),
          }).catch(() => {});
        }
      } catch (_) {}

      if (!customerEmails.includes(email)) {
        customerEmails.push(email);
        customerEmails.sort();
        const list = document.getElementById("gift-email-list");
        if (list) list.innerHTML = customerEmails.map((e) => `<option value="${escapeHtml(e)}"></option>`).join("");
      }
      closeGift();
      toast(`Gifted “${pack.title}” to ${email}.`);
    }

    giftConfirmBtn?.addEventListener("click", confirmGift);
    giftEmailInput?.addEventListener("keydown", (e) => { if (e.key === "Enter") confirmGift(); });
    document.querySelectorAll("[data-gift-close]").forEach((el) =>
      el.addEventListener("click", closeGift)
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && giftModal && !giftModal.hidden) closeGift();
    });
  </script>
</AdminShell>
