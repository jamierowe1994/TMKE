---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
---

<AdminShell active="catalogue" title="Catalogue" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Catalogue</div>
          <div class="page-header-sub" id="catalogue-sub">Loading…</div>
        </div>
      </div>
      <div class="page-header-actions">
        <nav class="cat-tabs">
          <button type="button" class="cat-tab is-on" data-kind="social">Social</button>
          <button type="button" class="cat-tab" data-kind="print">Print</button>
        </nav>
        <a href="/admin/packs/editor" class="admin-btn admin-btn-primary" id="cat-new">+ New pack</a>
      </div>
    </div>
  </div>
  <div class="ash-panel demo-pack is-collapsed" id="demo-pack">
    <div class="demo-pack-head">
      <button type="button" class="demo-pack-toggle" id="demo-pack-toggle" aria-expanded="false" aria-controls="demo-pack-inner">
        <span class="demo-pack-chev" aria-hidden="true">&#9662;</span>
        <span><h2>The demo pack</h2><span class="demo-pack-summary" id="demo-pack-summary"></span></span>
      </button>
      <div id="demo-pack-actions"></div>
    </div>
    <div class="demo-pack-inner" id="demo-pack-inner">
    <p class="demo-pack-intro">Hidden from the shop. Shown in the demo for visitors to try the Studio with, and free with every account. Three to five templates is plenty; each is a copy of the original, so the original pack is untouched.</p>
    <p class="demo-pack-note" id="demo-pack-note" hidden></p>
    <div class="demo-pack-body" id="demo-pack-body" hidden>
      <div class="demo-pack-list" id="demo-pack-list"></div>
      <div class="demo-pack-add">
        <p class="demo-pack-add-h">Add a template</p>
        <p class="demo-pack-add-sub">Click one to copy it into the demo pack.</p>
        <div class="demo-pack-picker" id="demo-pack-picker"></div>
      </div>
    </div>
    </div>
  </div>

  <!-- Hub notices: one message in every member's bell, sent when it's set for
       (supabase/member_broadcasts.sql; the Worker sends them). -->
  <div class="ash-panel demo-pack hn is-collapsed" id="hn">
    <div class="demo-pack-head">
      <button type="button" class="demo-pack-toggle" id="hn-toggle" aria-expanded="false" aria-controls="hn-inner">
        <span class="demo-pack-chev" aria-hidden="true">&#9662;</span>
        <span><h2>Hub notifications</h2><span class="demo-pack-summary" id="hn-summary"></span></span>
      </button>
    </div>
    <div class="demo-pack-inner" id="hn-inner">
      <p class="demo-pack-intro">Tell every member about something new, such as a pack, new templates in the demo pack or an update. It appears in the bell in their hub at the time you set.</p>
      <p class="demo-pack-note" id="hn-note" hidden></p>
      <div class="hn-body" id="hn-body">
        <form class="hn-form" id="hn-form" novalidate>
          <label class="hn-field">
            <span>Headline</span>
            <input type="text" id="hn-title" maxlength="80" placeholder="e.g. New in your demo pack: Testimonial 4" required />
          </label>
          <label class="hn-field">
            <span>Message <em>(optional)</em></span>
            <textarea id="hn-text" rows="2" maxlength="200" placeholder="e.g. A fresh testimonial layout is ready to use in the Studio."></textarea>
            <small id="hn-count">The bell shows the first 90 characters.</small>
          </label>
          <div class="hn-row">
            <label class="hn-field">
              <span>Takes them to</span>
              <select id="hn-link">
                <option value="pack">A pack in the Studio</option>
                <option value="/account/studio">The Studio</option>
                <option value="/account">Their dashboard</option>
                <option value="/account/guides">Learn</option>
                <option value="/account/blog">Inside the Edit (blog)</option>
                <option value="url">A web address</option>
              </select>
            </label>
            <label class="hn-field" id="hn-pack-wrap">
              <span>Pack</span>
              <select id="hn-pack"><option value="demo">Demo pack</option></select>
            </label>
            <label class="hn-field" id="hn-url-wrap" hidden>
              <span>Web address</span>
              <input type="url" id="hn-url" placeholder="https://" />
            </label>
          </div>
          <div class="hn-row">
            <fieldset class="hn-field hn-when">
              <span>When</span>
              <div class="hn-when-opts">
                <label><input type="radio" name="hn-when" value="now" checked /> Now</label>
                <label><input type="radio" name="hn-when" value="later" /> Later</label>
                <input type="datetime-local" id="hn-at" disabled />
              </div>
            </fieldset>
          </div>
          <div class="hn-preview" aria-label="How it looks in the bell">
            <span class="hn-preview-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span>
            <span class="hn-preview-txt"><b id="hn-pv-title">Your headline</b><i id="hn-pv-text"></i></span>
            <span class="hn-preview-time">now</span>
          </div>
          <p class="gift-error" id="hn-error" hidden></p>
          <div class="hn-actions">
            <button type="submit" class="admin-btn admin-btn-primary" id="hn-send">Send to every member</button>
          </div>
        </form>
        <div class="hn-list-wrap">
          <p class="demo-pack-add-h">Scheduled and sent</p>
          <div class="hn-list" id="hn-list"><p class="demo-pack-empty">Loading…</p></div>
        </div>
      </div>
    </div>
  </div>

  <div class="ash-panel ash-page">

  <section class="catalogue-controls">
    <div class="catalogue-controls-group" role="group" aria-label="Status filter">
      <button type="button" class="catalogue-chip is-active" data-filter="all">All</button>
      <button type="button" class="catalogue-chip" data-filter="active">Active</button>
      <button type="button" class="catalogue-chip" data-filter="draft">Draft</button>
      <button type="button" class="catalogue-chip" data-filter="archived">Archived</button>
    </div>

    <div class="catalogue-controls-spacer"></div>

    <label class="catalogue-select">
      <span>Sort</span>
      <select id="catalogue-sort">
        <option value="manual">Manual (drag to reorder)</option>
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
        <option value="price-desc">Price (high → low)</option>
        <option value="price-asc">Price (low → high)</option>
        <option value="title">Title A → Z</option>
      </select>
    </label>

    <div class="catalogue-controls-group" role="group" aria-label="View mode">
      <button type="button" class="catalogue-view-btn is-active" data-view="grid" aria-label="Grid view">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="1" y="1" width="5" height="5" /><rect x="8" y="1" width="5" height="5" />
          <rect x="1" y="8" width="5" height="5" /><rect x="8" y="8" width="5" height="5" />
        </svg>
      </button>
      <button type="button" class="catalogue-view-btn" data-view="list" aria-label="List view">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="1" y1="3" x2="13" y2="3" /><line x1="1" y1="7" x2="13" y2="7" /><line x1="1" y1="11" x2="13" y2="11" />
        </svg>
      </button>
    </div>
  </section>

  <section class="catalogue-body" id="catalogue-body" aria-busy="true">
    <p class="catalogue-loading" id="catalogue-loading">Loading catalogue…</p>
    <p class="catalogue-empty" id="catalogue-empty" hidden>
      No packs yet — click <strong>+ New pack</strong> to add the first one.
    </p>
    <div class="catalogue-grid is-view-grid" id="catalogue-grid"></div>
  </section>
  </div>

  <div class="catalogue-toast" id="catalogue-toast" hidden></div>

  <!-- Gift-a-pack modal: drops a pack into someone's library as a £0 order. -->
  <div class="gift-modal" id="gift-modal" hidden>
    <div class="gift-modal-backdrop" data-gift-close></div>
    <div class="gift-modal-card" role="dialog" aria-modal="true" aria-labelledby="gift-modal-title">
      <button type="button" class="gift-modal-x" data-gift-close aria-label="Close">&times;</button>
      <p class="gift-modal-eyebrow">Gift a pack</p>
      <h2 class="gift-modal-title" id="gift-modal-title">Gift &ldquo;<span id="gift-pack-name"></span>&rdquo;</h2>
      <p class="gift-modal-sub">
        Drops this pack straight into someone&rsquo;s library as a &pound;0 order &mdash;
        no payment needed. Use it to set up an example client or comp a customer.
      </p>

      <label class="gift-field">
        <span>Recipient email</span>
        <input type="email" id="gift-email" list="gift-email-list" placeholder="name@company.co.uk" autocomplete="off" />
        <datalist id="gift-email-list"></datalist>
      </label>
      <label class="gift-field">
        <span>Recipient name <em>(optional)</em></span>
        <input type="text" id="gift-name" placeholder="e.g. Danielle" autocomplete="off" />
      </label>

      <p class="gift-error" id="gift-error" hidden></p>

      <div class="gift-actions">
        <button type="button" class="admin-btn admin-btn-ghost" data-gift-close>Cancel</button>
        <button type="button" class="admin-btn admin-btn-primary" id="gift-confirm">Gift this pack &rarr;</button>
      </div>
    </div>
  </div>

  <style is:global>
    /* ============ Catalogue (admin) ============ */
    /* The Social / Print tabs sit on the dark page header, so they are light
       on dark like everything else up there — never the browser's own button. */
    .cat-tabs { display: inline-flex; gap: 4px; margin-right: 10px; }
    .cat-tab {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.08em; text-transform: uppercase;
      padding: 10px 18px; border-radius: 999px; cursor: pointer;
      color: rgba(255,255,255,0.72);
      background: transparent;
      border: 1px solid rgba(255,255,255,0.28);
      transition: background 0.18s, color 0.18s, border-color 0.18s;
    }
    .cat-tab:hover { color: #fff; border-color: rgba(255,255,255,0.6); background: rgba(255,255,255,0.08); }
    .cat-tab.is-on {
      background: var(--paper, #f4f2f1); color: var(--english-violet, #371e28);
      border-color: var(--paper, #f4f2f1);
    }
    .cat-tab:focus-visible { outline: 2px solid rgba(255,255,255,0.7); outline-offset: 2px; }

    body:has(.catalogue-top) { background: var(--paper); }

    .catalogue-top {
      max-width: 1400px;
      margin: 0 auto;
      padding: 48px 36px 16px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .catalogue-top-left { display: flex; flex-direction: column; align-items: flex-start; gap: 16px; }
    .catalogue-top-left > .catalogue-back { order: -1; }
    .catalogue-top-right { display: flex; align-items: center; gap: 12px; }
    .catalogue-back {
      display: inline-block;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--english-violet);
      font-weight: 700;
      padding-bottom: 8px;
    }
    .catalogue-back:hover { color: var(--ink); }
    .catalogue-title {
      font-family: var(--serif);
      font-size: clamp(36px, 4.6vw, 56px);
      font-weight: 500;
      margin: 0;
      line-height: 1;
      color: var(--ink);
    }
    .catalogue-title em { font-style: italic; color: var(--english-violet); }
    .demo-pack { margin-bottom: 16px; }
    .demo-pack-head { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; }
    .demo-pack-toggle { display: flex; align-items: center; gap: 12px; background: none; border: 0; padding: 0; font: inherit; color: inherit; cursor: pointer; text-align: left; }
    .demo-pack-toggle h2 { margin: 0; font-size: 16px; display: inline; }
    .demo-pack-summary { margin-left: 10px; font-size: 13px; color: var(--muted, #6b6670); }
    .demo-pack-chev { display: inline-block; font-size: 12px; color: var(--muted, #6b6670); transition: transform 0.2s; }
    .demo-pack.is-collapsed .demo-pack-chev { transform: rotate(-90deg); }
    .demo-pack.is-collapsed .demo-pack-inner { display: none; }
    .demo-pack-intro { margin: 12px 0 0; font-size: 13.5px; line-height: 1.5; color: var(--muted, #6b6670); max-width: 80%; }
    .demo-pack-note { margin: 12px 0 0; font-size: 13px; color: var(--muted, #6b6670); }
    .demo-pack-body { margin-top: 16px; }
    .demo-pack-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .demo-pack-item { border: 1px solid rgba(28,29,34,0.12); border-radius: 8px; padding: 8px; background: #fff; display: grid; gap: 6px; }
    .demo-pack-item .dp-thumb { aspect-ratio: 3 / 4; background: #e9e6e2 center / cover; border-radius: 4px; }
    .demo-pack-item .dp-name { font-size: 13px; line-height: 1.3; }
    .demo-pack-item .dp-from { font-size: 11px; color: var(--muted, #6b6670); }
    .demo-pack-item button { justify-self: start; background: none; border: 0; padding: 0; font: inherit; font-size: 12px; color: #8a2a2a; cursor: pointer; }
    .demo-pack-empty { font-size: 13px; color: var(--muted, #6b6670); }
    .demo-pack-add { border-top: 1px solid rgba(28,29,34,0.1); padding-top: 14px; }
    .demo-pack-add-h { margin: 0 0 2px; font-size: 10.5px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted, #6b6670); }
    .demo-pack-add-sub { margin: 0 0 12px; font-size: 13px; color: var(--muted, #6b6670); }
    .demo-pack-picker h3 { margin: 14px 0 8px; font-size: 13px; font-weight: 600; }
    .demo-pack-picker h3:first-child { margin-top: 0; }

    /* Hub notifications: a form on the left, what's scheduled and sent beside it. */
    .hn-body { margin-top: 16px; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 28px; align-items: start; }
    @media (max-width: 900px) { .hn-body { grid-template-columns: 1fr; } }
    .hn-form { display: grid; gap: 14px; }
    .hn-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; }
    .hn-field { display: flex; flex-direction: column; gap: 6px; min-width: 0; border: 0; padding: 0; margin: 0; }
    .hn-field[hidden] { display: none; }
    .hn-field > span {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.55);
    }
    .hn-field > span em { font-style: normal; font-weight: 500; color: rgba(28,29,34,0.4); letter-spacing: 0.04em; text-transform: none; }
    .hn-field input[type="text"], .hn-field input[type="url"], .hn-field input[type="datetime-local"], .hn-field textarea, .hn-field select {
      font-family: var(--sans); font-size: 14px; padding: 10px 12px;
      border: 1px solid rgba(var(--violet-rgb), 0.28); border-radius: 4px;
      background: #fff; color: var(--ink); width: 100%; box-sizing: border-box;
    }
    .hn-field textarea { resize: vertical; line-height: 1.45; }
    .hn-field input:focus, .hn-field textarea:focus, .hn-field select:focus { outline: none; border-color: #371e28; box-shadow: 0 0 0 3px rgba(55,30,40,0.12); }
    .hn-field small { font-size: 12px; color: var(--muted, #6b6670); }
    .hn-field small.is-over { color: #8a2a2a; }
    .hn-when-opts { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .hn-when-opts label { display: inline-flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer; }
    .hn-when-opts input[type="radio"] { accent-color: #371e28; }
    .hn-when-opts input[type="datetime-local"] { width: auto; }
    .hn-when-opts input:disabled { opacity: 0.45; }
    /* The bell item as members will see it. */
    .hn-preview { display: grid; grid-template-columns: 34px 1fr auto; gap: 12px; align-items: start; padding: 12px 14px; border: 1px dashed rgba(55,30,40,0.25); border-radius: 8px; background: #fbf9f7; }
    .hn-preview-ic { width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; color: #371e28; background: rgba(55,30,40,0.1); }
    .hn-preview-ic svg { width: 16px; height: 16px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
    .hn-preview-txt { display: grid; gap: 2px; min-width: 0; }
    .hn-preview-txt b { font-size: 13.5px; font-weight: 600; color: var(--ink); overflow-wrap: anywhere; }
    .hn-preview-txt i { font-style: normal; font-size: 12.5px; color: var(--muted, #6b6670); overflow-wrap: anywhere; }
    .hn-preview-time { font-size: 11.5px; color: var(--muted, #6b6670); }
    .hn-actions { display: flex; justify-content: flex-start; }
    .hn-list { display: grid; gap: 8px; margin-top: 10px; }
    .hn-item { display: grid; grid-template-columns: 1fr auto; gap: 4px 12px; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; background: #fff; }
    .hn-item-title { font-size: 13.5px; font-weight: 600; overflow-wrap: anywhere; }
    .hn-item-meta { grid-column: 1; font-size: 12px; color: var(--muted, #6b6670); }
    .hn-item-side { grid-row: 1 / span 2; grid-column: 2; display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
    .hn-pill { font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 8px; border-radius: 999px; white-space: nowrap; }
    .hn-pill--scheduled { background: rgba(55,30,40,0.1); color: #371e28; }
    .hn-pill--sending { background: rgba(196,140,40,0.15); color: #8a5a10; }
    .hn-pill--sent { background: rgba(47,158,94,0.12); color: #2f7a4e; }
    .hn-pill--failed { background: rgba(138,42,42,0.12); color: #8a2a2a; }
    .hn-pill--off { background: rgba(28,29,34,0.07); color: rgba(28,29,34,0.55); }
    .hn-item button { background: none; border: 0; padding: 0; font: inherit; font-size: 12px; color: #8a2a2a; cursor: pointer; }
    .dp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(64px, 1fr)); gap: 8px; }
    .dp-pick { border: 1px solid rgba(28,29,34,0.12); border-radius: 6px; padding: 4px; background: #fff; cursor: pointer; display: grid; gap: 5px; text-align: left; font: inherit; color: inherit; }
    .dp-pick:hover { border-color: var(--english-violet, #371e28); }
    .dp-pick .dp-thumb { aspect-ratio: 3 / 4; background: #e9e6e2 center / cover; border-radius: 4px; }
    .dp-pick .dp-name { font-size: 10px; line-height: 1.2; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; color: var(--muted, #6b6670); }
    .dp-pick[disabled] { opacity: 0.45; cursor: default; }
    .catalogue-sub {
      font-family: var(--sans);
      font-size: 13px;
      color: rgba(28, 29, 34, 0.6);
      margin: 8px 0 0;
    }

    .catalogue-controls {
      max-width: 1360px;
      margin: 16px auto 0;
      padding: 18px 36px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-top: 1px solid rgba(var(--violet-rgb), 0.12);
      border-bottom: 1px solid rgba(var(--violet-rgb), 0.12);
      flex-wrap: wrap;
    }
    .catalogue-controls-spacer { flex: 1; }

    .catalogue-controls-group {
      display: inline-flex;
      gap: 2px;
      padding: 2px;
      background: #fff;
      border: 1px solid rgba(var(--violet-rgb), 0.14);
      border-radius: 4px;
    }
    .catalogue-chip,
    .catalogue-view-btn {
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 7px 14px;
      border-radius: 3px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--english-violet);
      transition: background 0.15s, color 0.15s;
    }
    .catalogue-view-btn {
      padding: 7px 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .catalogue-chip:hover,
    .catalogue-view-btn:hover { background: rgba(var(--violet-rgb), 0.08); }
    .catalogue-chip.is-active,
    .catalogue-view-btn.is-active {
      background: var(--english-violet);
      color: var(--paper);
    }

    .catalogue-select {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28, 29, 34, 0.6);
    }
    .catalogue-select select {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.04em;
      text-transform: none;
      color: var(--ink);
      background: var(--paper);
      border: 1px solid rgba(var(--violet-rgb), 0.3);
      border-radius: 3px;
      padding: 7px 10px;
      font-weight: 500;
      cursor: pointer;
    }
    .catalogue-select select:focus { outline: none; border-color: var(--english-violet); }

    /* ----- Body ----- */
    .catalogue-body {
      max-width: 1360px;
      margin: 0 auto;
      padding: 28px 36px 200px;
    }
    .catalogue-loading, .catalogue-empty {
      font-family: var(--sans);
      font-size: 14px;
      color: rgba(28, 29, 34, 0.55);
      padding: 60px 0;
      text-align: center;
    }

    /* ----- Grid view ----- */
    .catalogue-grid.is-view-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 18px;
    }
    .catalogue-grid.is-view-grid .pack-card {
      display: flex;
      flex-direction: column;
      background: var(--paper);
      border: 1px solid rgba(var(--violet-rgb), 0.18);
      border-radius: 3px;
      overflow: hidden;
      transition: transform 0.2s cubic-bezier(.2,.7,.2,1), box-shadow 0.2s, border-color 0.2s;
      cursor: grab;
    }
    .catalogue-grid.is-view-grid .pack-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 32px rgba(28, 29, 34, 0.08);
      border-color: rgba(var(--violet-rgb), 0.35);
    }
    .catalogue-grid.is-view-grid .pack-card.is-archived { opacity: 0.55; }
    .catalogue-grid.is-view-grid .pack-cover {
      width: 100%;
      aspect-ratio: 4 / 3;
      background: var(--platinum);
      background-size: cover;
      background-position: center;
      position: relative;
    }
    .catalogue-grid.is-view-grid .pack-status {
      position: absolute;
      top: 10px; right: 10px;
      padding: 4px 9px;
      border-radius: 999px;
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 700;
      background: rgba(20, 18, 26, 0.7);
      color: var(--paper);
      backdrop-filter: blur(4px);
    }
    .catalogue-grid.is-view-grid .pack-status.is-draft { background: #b78a2e; }
    .catalogue-grid.is-view-grid .pack-status.is-archived { background: rgba(28,29,34,0.6); }
    .catalogue-grid.is-view-grid .pack-handle {
      position: absolute;
      top: 10px; left: 10px;
      width: 28px; height: 28px;
      display: inline-flex;
      align-items: center;
