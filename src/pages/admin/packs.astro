---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Catalogue — Admin · TMKE"
  description="Manage The Edit catalogue — every pack, drag to reorder, switch view modes."
  hideNav
  hideFooter
>
  <header class="catalogue-top">
    <div class="catalogue-top-left">
      <a href="/admin" class="catalogue-back" aria-label="Back to dashboard">&larr; Dashboard</a>
      <div>
        <h1 class="catalogue-title">The Edit <em>Catalogue</em></h1>
        <p class="catalogue-sub" id="catalogue-sub">Loading…</p>
      </div>
    </div>
    <div class="catalogue-top-right">
      <a href="/admin/packs/editor" class="admin-btn admin-btn-primary">+ New pack</a>
    </div>
  </header>

  <section class="catalogue-controls">
    <div class="catalogue-controls-group" role="group" aria-label="Status filter">
      <button type="button" class="catalogue-chip is-active" data-filter="all">All</button>
      <button type="button" class="catalogue-chip" data-filter="active">Active</button>
      <button type="button" class="catalogue-chip" data-filter="draft">Draft</button>
      <button type="button" class="catalogue-chip" data-filter="archived">Archived</button>
    </div>

    <div class="catalogue-controls-spacer"></div>

    <label class="catalogue-select">
      <span>Sort</span>
      <select id="catalogue-sort">
        <option value="manual">Manual (drag to reorder)</option>
        <option value="newest">Newest first</option>
        <option value="oldest">Oldest first</option>
        <option value="price-desc">Price (high → low)</option>
        <option value="price-asc">Price (low → high)</option>
        <option value="title">Title A → Z</option>
      </select>
    </label>

    <div class="catalogue-controls-group" role="group" aria-label="View mode">
      <button type="button" class="catalogue-view-btn is-active" data-view="grid" aria-label="Grid view">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <rect x="1" y="1" width="5" height="5" /><rect x="8" y="1" width="5" height="5" />
          <rect x="1" y="8" width="5" height="5" /><rect x="8" y="8" width="5" height="5" />
        </svg>
      </button>
      <button type="button" class="catalogue-view-btn" data-view="list" aria-label="List view">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5">
          <line x1="1" y1="3" x2="13" y2="3" /><line x1="1" y1="7" x2="13" y2="7" /><line x1="1" y1="11" x2="13" y2="11" />
        </svg>
      </button>
    </div>
  </section>

  <section class="catalogue-body" id="catalogue-body" aria-busy="true">
    <p class="catalogue-loading" id="catalogue-loading">Loading catalogue…</p>
    <p class="catalogue-empty" id="catalogue-empty" hidden>
      No packs yet — click <strong>+ New pack</strong> to add the first one.
    </p>
    <div class="catalogue-grid is-view-grid" id="catalogue-grid"></div>
  </section>

  <div class="catalogue-toast" id="catalogue-toast" hidden></div>

  <!-- Gift-a-pack modal: drops a pack into someone's library as a £0 order. -->
  <div class="gift-modal" id="gift-modal" hidden>
    <div class="gift-modal-backdrop" data-gift-close></div>
    <div class="gift-modal-card" role="dialog" aria-modal="true" aria-labelledby="gift-modal-title">
      <button type="button" class="gift-modal-x" data-gift-close aria-label="Close">&times;</button>
      <p class="gift-modal-eyebrow">Gift a pack</p>
      <h2 class="gift-modal-title" id="gift-modal-title">Gift &ldquo;<span id="gift-pack-name"></span>&rdquo;</h2>
      <p class="gift-modal-sub">
        Drops this pack straight into someone&rsquo;s library as a &pound;0 order &mdash;
        no payment needed. Use it to set up an example client or comp a customer.
      </p>

      <label class="gift-field">
        <span>Recipient email</span>
        <input type="email" id="gift-email" list="gift-email-list" placeholder="name@company.co.uk" autocomplete="off" />
        <datalist id="gift-email-list"></datalist>
      </label>
      <label class="gift-field">
        <span>Recipient name <em>(optional)</em></span>
        <input type="text" id="gift-name" placeholder="e.g. Danielle" autocomplete="off" />
      </label>

      <p class="gift-error" id="gift-error" hidden></p>

      <div class="gift-actions">
        <button type="button" class="admin-btn admin-btn-ghost" data-gift-close>Cancel</button>
        <button type="button" class="admin-btn admin-btn-primary" id="gift-confirm">Gift this pack &rarr;</button>
      </div>
    </div>
  </div>

  <style is:global>
    /* ============ Catalogue (admin) ============ */
    body:has(.catalogue-top) { background: var(--paper); }

    .catalogue-top {
      max-width: 1400px;
      margin: 0 auto;
      padding: 48px 36px 16px;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 24px;
      flex-wrap: wrap;
    }
    .catalogue-top-left { display: flex; gap: 24px; align-items: flex-end; flex-wrap: wrap; }
    .catalogue-top-right { display: flex; align-items: center; gap: 12px; }
    .catalogue-back {
      display: inline-block;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--english-violet);
      font-weight: 700;
      padding-bottom: 8px;
    }
    .catalogue-back:hover { color: var(--ink); }
    .catalogue-title {
      font-family: var(--serif);
      font-size: clamp(36px, 4.6vw, 56px);
      font-weight: 500;
      margin: 0;
      line-height: 1;
      color: var(--ink);
    }
    .catalogue-title em { font-style: italic; color: var(--english-violet); }
    .catalogue-sub {
      font-family: var(--sans);
      font-size: 13px;
      color: rgba(28, 29, 34, 0.6);
      margin: 8px 0 0;
    }

    .catalogue-controls {
      max-width: 1400px;
      margin: 16px auto 0;
      padding: 18px 36px;
      display: flex;
      align-items: center;
      gap: 12px;
      border-top: 1px solid rgba(71, 66, 84, 0.12);
      border-bottom: 1px solid rgba(71, 66, 84, 0.12);
      flex-wrap: wrap;
    }
    .catalogue-controls-spacer { flex: 1; }

    .catalogue-controls-group {
      display: inline-flex;
      gap: 2px;
      padding: 2px;
      background: rgba(71, 66, 84, 0.06);
      border-radius: 4px;
    }
    .catalogue-chip,
    .catalogue-view-btn {
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 7px 14px;
      border-radius: 3px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--english-violet);
      transition: background 0.15s, color 0.15s;
    }
    .catalogue-view-btn {
      padding: 7px 10px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .catalogue-chip:hover,
    .catalogue-view-btn:hover { background: rgba(71, 66, 84, 0.08); }
    .catalogue-chip.is-active,
    .catalogue-view-btn.is-active {
      background: var(--english-violet);
      color: var(--paper);
    }

    .catalogue-select {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28, 29, 34, 0.6);
    }
    .catalogue-select select {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.04em;
      text-transform: none;
      color: var(--ink);
      background: var(--paper);
      border: 1px solid rgba(71, 66, 84, 0.3);
      border-radius: 3px;
      padding: 7px 10px;
      font-weight: 500;
      cursor: pointer;
    }
    .catalogue-select select:focus { outline: none; border-color: var(--english-violet); }

    /* ----- Body ----- */
    .catalogue-body {
      max-width: 1400px;
      margin: 0 auto;
      padding: 28px 36px 200px;
    }
    .catalogue-loading, .catalogue-empty {
      font-family: var(--sans);
      font-size: 14px;
      color: rgba(28, 29, 34, 0.55);
      padding: 60px 0;
      text-align: center;
    }

    /* ----- Grid view ----- */
    .catalogue-grid.is-view-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 18px;
    }
    .catalogue-grid.is-view-grid .pack-card {
      display: flex;
      flex-direction: column;
      background: var(--paper);
      border: 1px solid rgba(71, 66, 84, 0.18);
      border-radius: 3px;
      overflow: hidden;
      transition: transform 0.2s cubic-bezier(.2,.7,.2,1), box-shadow 0.2s, border-color 0.2s;
      cursor: grab;
    }
    .catalogue-grid.is-view-grid .pack-card:hover {
      transform: translateY(-2px);
      box-shadow: 0 16px 32px rgba(28, 29, 34, 0.08);
      border-color: rgba(71, 66, 84, 0.35);
    }
    .catalogue-grid.is-view-grid .pack-card.is-archived { opacity: 0.55; }
    .catalogue-grid.is-view-grid .pack-cover {
      width: 100%;
      aspect-ratio: 4 / 3;
      background: var(--platinum);
      background-size: cover;
      background-position: center;
      position: relative;
    }
    .catalogue-grid.is-view-grid .pack-status {
      position: absolute;
      top: 10px; right: 10px;
      padding: 4px 9px;
      border-radius: 999px;
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 700;
      background: rgba(20, 18, 26, 0.7);
      color: var(--paper);
      backdrop-filter: blur(4px);
    }
    .catalogue-grid.is-view-grid .pack-status.is-draft { background: #b78a2e; }
    .catalogue-grid.is-view-grid .pack-status.is-archived { background: rgba(28,29,34,0.6); }
    .catalogue-grid.is-view-grid .pack-handle {
      position: absolute;
      top: 10px; left: 10px;
      width: 28px; height: 28px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      background: rgba(20, 18, 26, 0.5);
      color: var(--paper);
      border-radius: 4px;
      backdrop-filter: blur(4px);
      cursor: grab;
      opacity: 0;
      transition: opacity 0.15s;
    }
    .catalogue-grid.is-view-grid .pack-card:hover .pack-handle { opacity: 1; }
    .catalogue-grid.is-view-grid .pack-body { padding: 16px 18px 18px; flex: 1; display: flex; flex-direction: column; gap: 6px; }
    .catalogue-grid.is-view-grid .pack-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28, 29, 34, 0.55);
    }
    .catalogue-grid.is-view-grid .pack-price {
      font-family: var(--serif);
      font-size: 18px;
      font-weight: 500;
      letter-spacing: 0;
      color: var(--ink);
      text-transform: none;
    }
    .catalogue-grid.is-view-grid .pack-title {
      font-family: var(--serif);
      font-size: 22px;
      font-weight: 500;
      letter-spacing: -0.01em;
      margin: 2px 0 4px;
      color: var(--ink);
    }
    .catalogue-grid.is-view-grid .pack-desc {
      font-family: var(--sans);
      font-size: 13px;
      line-height: 1.5;
      color: rgba(28, 29, 34, 0.65);
      margin: 0 0 12px;
      flex: 1;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .catalogue-grid.is-view-grid .pack-actions {
      display: flex;
      gap: 6px;
      padding-top: 12px;
      border-top: 1px solid rgba(71, 66, 84, 0.12);
    }

    /* ----- List view ----- */
    .catalogue-grid.is-view-list {
      display: flex;
      flex-direction: column;
      gap: 1px;
      background: rgba(71, 66, 84, 0.18);
      border: 1px solid rgba(71, 66, 84, 0.18);
      border-radius: 3px;
      overflow: hidden;
    }
    .catalogue-grid.is-view-list .pack-card {
      display: grid;
      grid-template-columns: 24px 56px 1.4fr 110px 90px 100px auto;
      gap: 14px;
      align-items: center;
      padding: 12px 16px;
      background: var(--paper);
      transition: background 0.15s;
      cursor: grab;
    }
    .catalogue-grid.is-view-list .pack-card:hover { background: rgba(71, 66, 84, 0.04); }
    .catalogue-grid.is-view-list .pack-card.is-archived { opacity: 0.55; }
    .catalogue-grid.is-view-list .pack-handle {
      color: rgba(28, 29, 34, 0.35);
      cursor: grab;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .catalogue-grid.is-view-list .pack-card:hover .pack-handle { color: var(--english-violet); }
    .catalogue-grid.is-view-list .pack-cover {
      width: 56px; height: 56px;
      background: var(--platinum);
      background-size: cover;
      background-position: center;
      border-radius: 3px;
      flex: 0 0 auto;
    }
    .catalogue-grid.is-view-list .pack-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .catalogue-grid.is-view-list .pack-title {
      font-family: var(--sans);
      font-size: 14px;
      font-weight: 700;
      color: var(--ink);
      margin: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .catalogue-grid.is-view-list .pack-desc {
      font-family: var(--sans);
      font-size: 12px;
      color: rgba(28, 29, 34, 0.6);
      margin: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .catalogue-grid.is-view-list .pack-meta {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28, 29, 34, 0.55);
    }
    .catalogue-grid.is-view-list .pack-price {
      font-family: var(--serif);
      font-size: 18px;
      font-weight: 500;
      color: var(--ink);
      text-align: right;
    }
    .catalogue-grid.is-view-list .pack-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      border-radius: 999px;
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 700;
      justify-self: start;
    }
    .catalogue-grid.is-view-list .pack-status.is-active   { color: #2c7a4b; background: rgba(44, 122, 75, 0.1); }
    .catalogue-grid.is-view-list .pack-status.is-draft    { color: #b78a2e; background: rgba(183, 138, 46, 0.12); }
    .catalogue-grid.is-view-list .pack-status.is-archived { color: rgba(28,29,34,0.6); background: rgba(28, 29, 34, 0.06); }
    .catalogue-grid.is-view-list .pack-actions {
      display: flex;
      gap: 6px;
      justify-self: end;
    }

    /* ----- Drag-only-when-manual ----- */
    .catalogue-grid.is-locked .pack-card { cursor: default; }
    .catalogue-grid.is-locked .pack-handle { display: none !important; }

    /* ----- SortableJS placeholder ----- */
    .sortable-ghost {
      opacity: 0.4;
      background: rgba(71, 66, 84, 0.08) !important;
    }
    .sortable-drag {
      box-shadow: 0 24px 50px rgba(20, 18, 26, 0.25);
      cursor: grabbing !important;
    }

    /* ----- Buttons (admin) ----- */
    .admin-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 9px 14px;
      border-radius: 3px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 700;
      cursor: pointer;
      border: 1px solid transparent;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
      text-decoration: none;
      color: inherit;
    }
    .admin-btn-primary { background: var(--english-violet); color: var(--paper); }
    .admin-btn-primary:hover { background: var(--ink); }
    .admin-btn-ghost {
      background: transparent;
      border-color: rgba(71, 66, 84, 0.35);
      color: var(--english-violet);
    }
    .admin-btn-ghost:hover { background: rgba(71, 66, 84, 0.08); }
    .admin-btn-danger {
      background: transparent;
      border-color: #a05a3c;
      color: #a05a3c;
    }
    .admin-btn-danger:hover { background: #a05a3c; color: var(--paper); }
    .admin-btn-sm { padding: 6px 10px; font-size: 10px; letter-spacing: 0.16em; }

    /* ----- Toast ----- */
    .catalogue-toast {
      position: fixed;
      left: 50%; bottom: 24px;
      transform: translateX(-50%);
      background: var(--ink);
      color: var(--paper);
      padding: 10px 20px;
      border-radius: 3px;
      font-family: var(--sans);
      font-size: 13px;
      letter-spacing: 0.04em;
      box-shadow: 0 20px 50px rgba(20, 18, 26, 0.35);
      z-index: 200;
    }
    .catalogue-toast[hidden] { display: none; }

    /* ----- Gift-a-pack modal ----- */
    .gift-modal {
      position: fixed; inset: 0; z-index: 300;
      display: flex; align-items: center; justify-content: center;
      padding: 24px;
    }
    .gift-modal[hidden] { display: none; }
    .gift-modal-backdrop {
      position: absolute; inset: 0;
      background: rgba(20, 18, 26, 0.55);
      backdrop-filter: blur(3px);
    }
    .gift-modal-card {
      position: relative;
      width: 100%; max-width: 440px;
      background: var(--paper);
      border: 1px solid rgba(71, 66, 84, 0.2);
      border-radius: 8px;
      padding: 32px 32px 28px;
      box-shadow: 0 40px 90px -30px rgba(20, 18, 26, 0.55);
    }
    .gift-modal-x {
      position: absolute; top: 14px; right: 16px;
      appearance: none; background: none; border: 0;
      font-size: 22px; line-height: 1; color: rgba(28,29,34,0.45);
      cursor: pointer; padding: 4px; transition: color 0.2s;
    }
    .gift-modal-x:hover { color: var(--ink); }
    .gift-modal-eyebrow {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.24em; text-transform: uppercase;
      color: var(--english-violet); margin: 0 0 8px;
    }
    .gift-modal-title {
      font-family: var(--serif); font-size: 26px; font-weight: 500;
      letter-spacing: -0.01em; color: var(--ink); margin: 0 0 8px;
    }
    .gift-modal-sub {
      font-family: var(--sans); font-size: 13px; line-height: 1.55;
      color: rgba(28,29,34,0.6); margin: 0 0 22px;
    }
    .gift-field { display: flex; flex-direction: column; gap: 6px; margin-bottom: 16px; }
    .gift-field > span {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(28,29,34,0.55);
    }
    .gift-field > span em { font-style: normal; font-weight: 500; color: rgba(28,29,34,0.4); letter-spacing: 0.04em; }
    .gift-field input {
      font-family: var(--sans); font-size: 15px;
      padding: 11px 13px;
      border: 1px solid rgba(71, 66, 84, 0.28);
      border-radius: 4px; background: #fff; color: var(--ink);
      transition: border-color 0.2s, box-shadow 0.2s;
    }
    .gift-field input:focus {
      outline: none; border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(71, 66, 84, 0.12);
    }
    .gift-error {
      font-family: var(--sans); font-size: 13px;
      color: #a23b3b; background: rgba(162, 59, 59, 0.08);
      border: 1px solid rgba(162, 59, 59, 0.25);
      padding: 9px 12px; border-radius: 4px; margin: 0 0 16px;
    }
    .gift-error[hidden] { display: none; }
    .gift-actions { display: flex; justify-content: flex-end; gap: 10px; margin-top: 6px; }

    @media (max-width: 720px) {
      .catalogue-top { padding: 32px 22px 12px; }
      .catalogue-controls { padding: 14px 22px; }
      .catalogue-body { padding: 20px 22px 120px; }
      .catalogue-grid.is-view-list .pack-card {
        grid-template-columns: 24px 56px 1fr auto;
        row-gap: 6px;
      }
      .catalogue-grid.is-view-list .pack-meta,
      .catalogue-grid.is-view-list .pack-status { display: none; }
      .catalogue-grid.is-view-list .pack-price { grid-column: 3 / -1; text-align: left; font-size: 15px; }
    }
  </style>

  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js" is:inline></script>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { supabase, gbpFromPence } from "../../lib/supabase.js";

    /** @type {any[]} */
    let allPacks = [];
    let filter = "all";
    let sortBy = "manual";
    let view = "grid";

    // Persisted UI prefs
    try {
      const saved = JSON.parse(localStorage.getItem("tmke.admin.catalogue.prefs") || "{}");
      if (saved.view === "grid" || saved.view === "list") view = saved.view;
      if (typeof saved.sortBy === "string") sortBy = saved.sortBy;
      if (typeof saved.filter === "string") filter = saved.filter;
    } catch {}

    function savePrefs() {
      try {
        localStorage.setItem(
          "tmke.admin.catalogue.prefs",
          JSON.stringify({ view, sortBy, filter }),
        );
      } catch {}
    }

    function escapeHtml(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
      }[c]));
    }

    function visiblePacks() {
      let rows = allPacks.slice();
      if (filter !== "all") rows = rows.filter((p) => p.status === filter);
      switch (sortBy) {
        case "newest":
          rows.sort((a, b) => new Date(b.created_at) - new Date(a.created_at));
          break;
        case "oldest":
          rows.sort((a, b) => new Date(a.created_at) - new Date(b.created_at));
          break;
        case "price-desc":
          rows.sort((a, b) => (b.price_pence || 0) - (a.price_pence || 0));
          break;
        case "price-asc":
          rows.sort((a, b) => (a.price_pence || 0) - (b.price_pence || 0));
          break;
        case "title":
          rows.sort((a, b) => String(a.title).localeCompare(String(b.title)));
          break;
        case "manual":
        default:
          rows.sort((a, b) => (a.sort_order ?? 0) - (b.sort_order ?? 0));
      }
      return rows;
    }

    function packCardHtml(p) {
      const cover = p.cover_image_url
        ? `style="background-image:url('${escapeHtml(p.cover_image_url)}')"`
        : "";
      const editHref = `/admin/packs/editor?id=${encodeURIComponent(p.id)}`;
      const dragHandle = `
        <span class="pack-handle" aria-hidden="true" title="Drag to reorder">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor">
            <circle cx="4" cy="3" r="1"/><circle cx="10" cy="3" r="1"/>
            <circle cx="4" cy="7" r="1"/><circle cx="10" cy="7" r="1"/>
            <circle cx="4" cy="11" r="1"/><circle cx="10" cy="11" r="1"/>
          </svg>
        </span>`;
      const statusPill = `<span class="pack-status is-${p.status}">${p.status}</span>`;
      const archiveOrRestore = p.status === "archived"
        ? `<button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-restore="${p.id}">Restore</button>`
        : `<button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-archive="${p.id}">Archive</button>`;
      const editBtn = `<a href="${editHref}" class="admin-btn admin-btn-primary admin-btn-sm" data-edit="${p.id}">Edit</a>`;
      const giftBtn = `<button type="button" class="admin-btn admin-btn-ghost admin-btn-sm" data-gift="${p.id}">Gift</button>`;

      if (view === "list") {
        return `
          <article class="pack-card is-${p.status}" data-id="${p.id}">
            ${dragHandle}
            <div class="pack-cover" ${cover}></div>
            <div class="pack-body">
              <h3 class="pack-title">${escapeHtml(p.title)}</h3>
              <p class="pack-desc">${escapeHtml(p.description || "—")}</p>
            </div>
            <div class="pack-meta">${escapeHtml(p.category || "—")}</div>
            ${statusPill}
            <div class="pack-price">${gbpFromPence(p.price_pence)}</div>
            <div class="pack-actions">${giftBtn} ${editBtn} ${archiveOrRestore}</div>
          </article>
        `;
      }
      return `
        <article class="pack-card is-${p.status}" data-id="${p.id}">
          <div class="pack-cover" ${cover}>
            ${dragHandle}
            ${statusPill}
          </div>
          <div class="pack-body">
            <div class="pack-meta">
              <span>${escapeHtml(p.category || "—")}</span>
              <span class="pack-price">${gbpFromPence(p.price_pence)}</span>
            </div>
            <h3 class="pack-title">${escapeHtml(p.title)}</h3>
            <p class="pack-desc">${escapeHtml(p.description || "")}</p>
            <div class="pack-actions">${giftBtn} ${editBtn} ${archiveOrRestore}</div>
          </div>
        </article>
      `;
    }

    function render() {
      const grid = document.getElementById("catalogue-grid");
      const emptyEl = document.getElementById("catalogue-empty");
      const sub = document.getElementById("catalogue-sub");
      if (!grid) return;
      const rows = visiblePacks();
      const active = allPacks.filter((p) => p.status === "active").length;
      const draft = allPacks.filter((p) => p.status === "draft").length;
      const archived = allPacks.filter((p) => p.status === "archived").length;
      if (sub) {
        sub.textContent =
          `${active} active · ${draft} draft · ${archived} archived · ${rows.length} shown`;
      }
      grid.className = `catalogue-grid is-view-${view}` + (sortBy === "manual" ? "" : " is-locked");
      if (rows.length === 0) {
        grid.innerHTML = "";
        if (emptyEl) emptyEl.hidden = false;
      } else {
        if (emptyEl) emptyEl.hidden = true;
        grid.innerHTML = rows.map(packCardHtml).join("");
      }

      wireSortable(grid);
    }

    /** @type {any} */
    let currentSortable = null;
    function wireSortable(grid) {
      if (currentSortable && typeof currentSortable.destroy === "function") {
        currentSortable.destroy();
        currentSortable = null;
      }
      const Sortable = /** @type {any} */ (window).Sortable;
      if (!Sortable || sortBy !== "manual" || filter !== "all") return;
      currentSortable = Sortable.create(grid, {
        animation: 180,
        handle: ".pack-handle",
        ghostClass: "sortable-ghost",
        dragClass: "sortable-drag",
        onEnd: persistOrder,
      });
    }

    let toastTimer = null;
    function toast(msg) {
      const el = document.getElementById("catalogue-toast");
      if (!el) return;
      el.textContent = msg;
      el.hidden = false;
      if (toastTimer) clearTimeout(toastTimer);
      toastTimer = setTimeout(() => { el.hidden = true; }, 1800);
    }

    async function persistOrder() {
      const grid = document.getElementById("catalogue-grid");
      if (!grid) return;
      const ids = Array.from(grid.querySelectorAll("[data-id]"))
        .map((el) => el.getAttribute("data-id"))
        .filter(Boolean);
      const updates = ids.map((id, idx) => ({ id, sort_order: idx }));

      // Optimistically update local state
      const map = new Map(updates.map((u) => [u.id, u.sort_order]));
      allPacks.forEach((p) => {
        if (map.has(p.id)) p.sort_order = map.get(p.id);
      });

      const promises = updates.map((u) =>
        supabase.from("packs").update({ sort_order: u.sort_order }).eq("id", u.id),
      );
      const results = await Promise.all(promises);
      const failures = results.filter((r) => r.error);
      if (failures.length) {
        console.error("[TMKE] reorder failures", failures);
        toast(`Couldn't save order (${failures.length} failed). Refresh to reset.`);
      } else {
        toast("Order saved.");
      }
    }

    async function archivePack(id) {
      const { error } = await supabase.from("packs").update({ status: "archived" }).eq("id", id);
      if (error) { alert("Archive failed: " + error.message); return; }
      const row = allPacks.find((p) => p.id === id);
      if (row) row.status = "archived";
      render();
      toast("Pack archived.");
    }

    async function restorePack(id) {
      const { error } = await supabase.from("packs").update({ status: "active" }).eq("id", id);
      if (error) { alert("Restore failed: " + error.message); return; }
      const row = allPacks.find((p) => p.id === id);
      if (row) row.status = "active";
      render();
      toast("Pack restored.");
    }

    async function loadPacks() {
      const { data, error } = await supabase
        .from("packs")
        .select("*")
        .order("sort_order", { ascending: true })
        .order("created_at", { ascending: false });

      const loading = document.getElementById("catalogue-loading");
      if (loading) loading.hidden = true;
      const body = document.getElementById("catalogue-body");
      if (body) body.removeAttribute("aria-busy");

      if (error) {
        if (loading) {
          loading.hidden = false;
          loading.textContent = "Failed to load catalogue: " + error.message;
        }
        return;
      }

      allPacks = data || [];
      render();
    }

    function syncInitialUI() {
      document.querySelectorAll("[data-filter]").forEach((el) => {
        el.classList.toggle("is-active", el.getAttribute("data-filter") === filter);
      });
      document.querySelectorAll("[data-view]").forEach((el) => {
        el.classList.toggle("is-active", el.getAttribute("data-view") === view);
      });
      const sortEl = document.getElementById("catalogue-sort");
      if (sortEl) sortEl.value = sortBy;
    }

    (async () => {
      const session = await requireAdmin();
      if (!session) return;
      syncInitialUI();
      await loadPacks();
      loadCustomerEmails();
    })();

    // Filter chips
    document.querySelectorAll("[data-filter]").forEach((el) => {
      el.addEventListener("click", () => {
        filter = el.getAttribute("data-filter") || "all";
        document.querySelectorAll("[data-filter]").forEach((c) => c.classList.remove("is-active"));
        el.classList.add("is-active");
        savePrefs();
        render();
      });
    });

    // View toggle
    document.querySelectorAll("[data-view]").forEach((el) => {
      el.addEventListener("click", () => {
        view = el.getAttribute("data-view") || "grid";
        document.querySelectorAll("[data-view]").forEach((c) => c.classList.remove("is-active"));
        el.classList.add("is-active");
        savePrefs();
        render();
      });
    });

    // Sort dropdown
    document.getElementById("catalogue-sort")?.addEventListener("change", (e) => {
      sortBy = e.target.value;
      savePrefs();
      render();
    });

    // Action delegation
    document.getElementById("catalogue-grid")?.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      const archiveId = target.getAttribute("data-archive");
      if (archiveId) { e.preventDefault(); archivePack(archiveId); return; }
      const restoreId = target.getAttribute("data-restore");
      if (restoreId) { e.preventDefault(); restorePack(restoreId); return; }
      const giftId = target.getAttribute("data-gift");
      if (giftId) { e.preventDefault(); openGift(giftId); return; }
    });

    // ===== Gift a pack =====
    // Lets an admin drop a pack into someone's library as a £0 "paid" order,
    // so it shows up in their /account library without a real purchase.
    let customerEmails = [];
    let giftPackId = null;

    async function loadCustomerEmails() {
      const { data, error } = await supabase
        .from("orders")
        .select("buyer_email")
        .eq("status", "paid");
      if (error) return;
      customerEmails = [...new Set((data || []).map((o) => o.buyer_email).filter(Boolean))].sort();
      const list = document.getElementById("gift-email-list");
      if (list) list.innerHTML = customerEmails.map((e) => `<option value="${escapeHtml(e)}"></option>`).join("");
    }

    const giftModal = document.getElementById("gift-modal");
    const giftEmailInput = document.getElementById("gift-email");
    const giftNameInput = document.getElementById("gift-name");
    const giftConfirmBtn = document.getElementById("gift-confirm");
    const giftErrorEl = document.getElementById("gift-error");

    function showGiftError(msg) {
      if (!giftErrorEl) return;
      giftErrorEl.textContent = msg;
      giftErrorEl.hidden = false;
    }

    function openGift(id) {
      const pack = allPacks.find((p) => p.id === id);
      if (!pack || !giftModal) return;
      giftPackId = id;
      const nameEl = document.getElementById("gift-pack-name");
      if (nameEl) nameEl.textContent = pack.title;
      if (giftErrorEl) giftErrorEl.hidden = true;
      if (giftEmailInput) giftEmailInput.value = "";
      if (giftNameInput) giftNameInput.value = "";
      giftModal.hidden = false;
      setTimeout(() => giftEmailInput && giftEmailInput.focus(), 40);
    }

    function closeGift() {
      if (giftModal) giftModal.hidden = true;
      giftPackId = null;
    }

    async function confirmGift() {
      const pack = allPacks.find((p) => p.id === giftPackId);
      if (!pack) return;
      const email = (giftEmailInput.value || "").trim().toLowerCase();
      const name = (giftNameInput.value || "").trim();
      if (!email || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        showGiftError("Enter a valid email address for the recipient.");
        return;
      }
      if (giftErrorEl) giftErrorEl.hidden = true;
      giftConfirmBtn.disabled = true;
      giftConfirmBtn.textContent = "Gifting…";

      const { error } = await supabase.from("orders").insert({
        pack_id: pack.id,
        pack_slug: pack.slug,
        pack_title: pack.title,
        amount_pence: 0,
        buyer_name: name || email.split("@")[0],
        buyer_email: email,
        buyer_company: "",
        payment_method: "gift",
        payment_ref: "gift_" + Date.now(),
        status: "paid",
      });

      giftConfirmBtn.disabled = false;
      giftConfirmBtn.textContent = "Gift this pack →";

      if (error) {
        showGiftError(error.message || "Couldn't gift the pack. Please try again.");
        return;
      }
      if (!customerEmails.includes(email)) {
        customerEmails.push(email);
        customerEmails.sort();
        const list = document.getElementById("gift-email-list");
        if (list) list.innerHTML = customerEmails.map((e) => `<option value="${escapeHtml(e)}"></option>`).join("");
      }
      closeGift();
      toast(`Gifted “${pack.title}” to ${email}.`);
    }

    giftConfirmBtn?.addEventListener("click", confirmGift);
    giftEmailInput?.addEventListener("keydown", (e) => { if (e.key === "Enter") confirmGift(); });
    document.querySelectorAll("[data-gift-close]").forEach((el) =>
      el.addEventListener("click", closeGift)
    );
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && giftModal && !giftModal.hidden) closeGift();
    });
  </script>
</BaseLayout>
