      justify-self: start;
    }
    .catalogue-grid.is-view-list .pack-status.is-active   { color: #2c7a4b; background: rgba(44, 122, 75, 0.1); }
    .catalogue-grid.is-view-list .pack-status.is-draft    { color: #b78a2e; background: rgba(183, 138, 46, 0.12); }
    .catalogue-grid.is-view-list .pack-status.is-archived { color: rgba(28,29,34,0.6); background: rgba(28, 29, 34, 0.06); }
    .catalogue-grid.is-view-list .pack-actions {
      display: flex;
      gap: 6px;
      justify-self: end;
    }

    /* ----- Drag-only-when-manual ----- */
    .catalogue-grid.is-locked .pack-card { cursor: default; }
    .catalogue-grid.is-locked .pack-handle { display: none !important; }

    /* ----- SortableJS placeholder ----- */
    .sortable-ghost {
      opacity: 0.4;
      background: rgba(var(--violet-rgb), 0.08) !important;
    }
    .sortable-drag {
      box-shadow: 0 24px 50px rgba(20, 18, 26, 0.25);
      cursor: grabbing !important;
    }

    /* ----- Buttons (admin) ----- */
    .admin-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 9px 14px;
      border-radius: 3px;
      font-family: var(--sans);
