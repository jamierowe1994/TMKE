    .catalogue-grid.is-view-list .pack-card:hover .pack-handle { color: var(--english-violet); }
    .catalogue-grid.is-view-list .pack-cover {
      width: 56px; height: 56px;
      background: var(--platinum);
      background-size: cover;
      background-position: center;
      border-radius: 3px;
      flex: 0 0 auto;
    }
    .catalogue-grid.is-view-list .pack-body { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .catalogue-grid.is-view-list .pack-title {
      font-family: var(--sans);
      font-size: 14px;
      font-weight: 700;
      color: var(--ink);
      margin: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .catalogue-grid.is-view-list .pack-desc {
      font-family: var(--sans);
      font-size: 12px;
      color: rgba(28, 29, 34, 0.6);
      margin: 0;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .catalogue-grid.is-view-list .pack-meta {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28, 29, 34, 0.55);
    }
    .catalogue-grid.is-view-list .pack-price {
      font-family: var(--serif);
      font-size: 18px;
      font-weight: 500;
      color: var(--ink);
      text-align: right;
    }
    .catalogue-grid.is-view-list .pack-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 10px;
      border-radius: 999px;
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
