      padding: 24px;
    }
    .gift-modal[hidden] { display: none; }
    .gift-modal-backdrop {
      position: absolute; inset: 0;
      background: rgba(20, 18, 26, 0.55);
      backdrop-filter: blur(3px);
    }
    .gift-modal-card {
      position: relative;
      width: 100%; max-width: 440px;
      background: var(--paper);
      border: 1px solid rgba(var(--violet-rgb), 0.2);
