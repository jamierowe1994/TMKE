      $("ct-merge-sum").innerHTML = `<b>${esc(fullName(k))}</b> stays, on <b>${esc(k.email || "no email")}</b>. ${gains.length ? `They gain ${esc(gains.join(", "))}.` : "Nothing needs filling in."}${keepsEmail ? ` <b>${esc(lose.email)}</b> is kept as their second email, so that address still finds them.` : ""} Notes, tasks, bookings and automation history from the other record move across.${mergeBrandNote(k, lose)}`;
    }
    function mergeBrandNote(keep, lose) {
      const brands = (list) => (list || []).map((r) => String(r.brand || "").trim()).filter(Boolean);
      const kb = brands(keep.agentProfiles || profilesOf(keep)), lb = brands(lose.agentProfiles || profilesOf(lose));
      const coming = lb.filter((b) => !kb.some((x) => lc(x) === lc(b)));
