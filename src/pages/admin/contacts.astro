      if (isAgentView || p.date_joined) col1.push(row("Date joined", short(p.date_joined)));
      if (p.left_at) col1.push(row("Left", short(p.left_at)));
      const col2 = [row("Work email", p.email || c.email), row("Work number", p.phone || c.phone)];
      if (isAgentView) {
        col2.push(row("New starter", nsText));
        col2.push(row("Booking link", link ? `<span class="linkcell"><span title="${esc(link)}">${esc(link.replace(/^https?:\/\//, ""))}</span><button type="button" class="mbtn small" data-act="copy-link" data-url="${esc(link)}">Copy</button></span>` : "", { html: true }));
      }
      const pulls = !p.brand_photo_url ? rows.filter((r) => r.id !== p.id && r.brand_photo_url && !r.left_at) : [];
      const others = rows.filter((r) => String(r.id) !== String(p.id));
      const what = !others.length
        ? " It's their only brand, so they'll be in no brand at all: no brand kit in their Studio and no brand print packs."
        : p.is_primary && !p.left_at ? ` Their Studio opens in this brand now, so it will open in ${(mainOf(others) || others[0]).brand || "their other brand"} instead.` : "";
      body = tabHtml + `<div class="bview">
          <div class="pimg${p.brand_photo_url ? " has" : ""}"${p.brand_photo_url ? ` style="background-image:url('${esc(p.brand_photo_url)}')"` : ""}>${p.brand_photo_url ? "" : "No brand photo yet"}</div>
          <div>${col1.join("")}</div>
          <div>${col2.join("")}</div>
        </div>
        <div class="addrow">
          ${!p.is_primary && !p.left_at && p.brand ? `<button type="button" class="mbtn small" data-act="primary">Open their Studio in this brand</button>` : ""}
          ${p.brand ? (p.left_at ? `<button type="button" class="mbtn small" data-act="unleave">They're back</button>` : `<button type="button" class="mbtn small" data-act="leave">Mark as left</button>`) : ""}
          ${pulls.map((r) => `<button type="button" class="mbtn small" data-act="pull" data-id="${esc(r.id)}">Pull photo from ${esc(r.brand)}</button>`).join("")}
          <button type="button" class="mbtn small danger" data-act="rm-ask">Remove brand</button>
        </div>
        ${CS.confirm === "rm" ? `<div class="confirm"><p>Remove ${esc(p.brand || "this brand")} from ${esc(c.first_name || fullName(c))}? Their brand photo and details go too.${esc(what)} If they've left, Mark as left keeps the history.</p><div><button type="button" class="mbtn" data-act="noconfirm">Keep it</button><button type="button" class="mbtn primary" data-act="rm">Remove</button></div></div>` : ""}`;
      return box("Brands", body, { head });
    }

    function tagsBox(c) {
      const mine = new Set(c.tags || []);
      const body = `<div class="taglist">${(c.tags || []).length ? c.tags.map((t) => `<span class="tagx">${esc(t)}<button type="button" data-act="untag" data-tag="${esc(t)}" aria-label="Remove ${esc(t)}">&times;</button></span>`).join("") : `<span class="note">No tags.</span>`}</div>
        <div class="tagadd"><select id="ct-tagpick" aria-label="Add a tag"><option value="">Add a tag…</option>${tagGroups().map(([g, t]) => { const left = t.filter((x) => !mine.has(x)); return left.length ? `<optgroup label="${esc(g)}">${left.map((x) => `<option value="${esc(x)}">${esc(tagLabel(x))}</option>`).join("")}</optgroup>` : ""; }).join("")}</select><button type="button" class="mbtn" data-act="tag-add">Add</button></div>`;
      return box("Tags", body);
    }

    const stageText = (s) => cap(String(s || "").replace(/_/g, " "));
    function boughtBox(c, d, rows) {
      const cards = [
        ...d.orders.map((o) => `<div class="card"><span class="k">Pack</span><span class="t">${esc(String(o.pack_title || "Pack").replace(/ pack$/i, ""))}</span><span class="m">${esc(short(o.created_at))}<b>${esc(gbp(o.amount_pence))}</b></span><span class="f"><span class="chip ${o.status === "paid" ? "good" : "plain"}">${esc(o.status === "paid" ? "Paid" : stageText(o.status || "Not paid"))}</span></span></div>`),
        ...d.vrows.filter((b) => b.kind === "booking" || b.kind === "discovery" || b.service_type === "discovery").map((b) => {
          const call = b.kind === "discovery" || b.service_type === "discovery";
          const done = /deliver|complete|done/i.test(b.stage || "");
          return `<div class="card"><span class="k">${call ? "Videography call" : "Videography"}</span><span class="t">${esc(call ? "Discovery call" : (b.service || b.service_type || "Videography session"))}</span><span class="m">${esc(short(b.shoot_date) || "No date yet")}</span><span class="f">${b.stage ? `<span class="chip ${done ? "good" : "wait"}">${esc(stageText(b.stage))}</span>` : ""}<a class="lnk" href="/admin/videography?booking=${encodeURIComponent(b.id)}">Open</a></span></div>`;
        }),
        ...d.srows.filter((l) => l.client_status || l.kind === "discovery").map((l) => {
          const client = !!l.client_status;
          const tone = /active/i.test(l.client_status || "") ? "good" : /paused/i.test(l.client_status || "") ? "wait" : "plain";
          return `<div class="card"><span class="k">${client ? "Social media" : "Social media call"}</span><span class="t">${client ? "Monthly management" : "Discovery call"}</span><span class="m">${client ? `Since ${esc(short(l.created_at))}` : esc(short(l.call_at) || "No date yet")}</span><span class="f">${client ? `<span class="chip ${tone}">${esc(stageText(l.client_status))}</span>` : l.stage ? `<span class="chip wait">${esc(stageText(l.stage))}</span>` : ""}<a class="lnk" href="/admin/social?lead=${encodeURIComponent(l.id)}">Open</a></span></div>`;
        }),
        ...(c.user_id && liveOf(rows).some((p) => ["The Property Experts", "Prestige Property Experts"].includes(p.brand)) ? [`<div class="card"><span class="k">Studio plan</span><span class="t">Content Calendar</span><span class="m">Part of their brand licence</span><span class="f"><span class="chip plain">Included</span></span></div>`] : []),
      ];
      return box("Bought and booked", cards.length ? `<div class="cards">${cards.join("")}</div>` : `<p class="note">Nothing bought or booked yet.</p>`);
    }

    function notesBox(c, d) {
      const nt = CS.ntab;
      const openTasks = d.tasks.filter((t) => t.status !== "done").length;
      const mails = groupEmails(d.emails);
      let inner = "";
      if (CS.ntOpen) {
        if (nt === "notes") {
          const today = dayStart(Date.now());
          const items = [...d.notes.map((n) => ({ k: "note", at: n.created_at, n })), ...d.tasks.map((t) => ({ k: "task", at: t.created_at, t }))].sort((a, b) => new Date(b.at) - new Date(a.at));
          const me = PEOPLE.includes(ME) ? ME : "Danielle";
          inner = `<div class="compose"><span class="seg2"><button type="button" data-act="addmode" data-mode="note" aria-pressed="${CS.addMode === "note"}">Note</button><button type="button" data-act="addmode" data-mode="task" aria-pressed="${CS.addMode === "task"}">Task</button></span>
            ${CS.addMode === "note"
              ? `<textarea id="ct-nt-text" placeholder="Write a note about ${esc(c.first_name || "them")}…" aria-label="Note"></textarea><div class="addrow"><button type="button" class="mbtn primary" data-act="note-add">Add note</button></div>`
              : `<input type="text" id="ct-tk-text" class="tk-line" placeholder="What needs doing…" aria-label="Task"><div class="addrow"><input type="date" id="ct-tk-due" aria-label="Due"><select id="ct-tk-who" aria-label="Who">${PEOPLE.map((p) => `<option ${p === me ? "selected" : ""}>${p}</option>`).join("")}</select><span style="flex:1"></span><button type="button" class="mbtn primary" data-act="task-add">Add task</button></div>`}</div>
            <p class="sub-h">Notes and tasks</p>
            <div class="erows">${items.length ? items.map((x) => {
              if (x.k === "task") {
                const t = x.t, done = t.status === "done";
                const over = !done && t.due_at && new Date(t.due_at) < today;
                const who = taskWho(t);
                const line = [who ? `Task for ${who}` : "Task", t.due_at ? `due ${short(t.due_at)}` : "no due date"].join(" · ");
                return `<div class="erow"><label><input type="checkbox" data-act="task-done" data-id="${esc(t.id)}" ${done ? "checked" : ""} aria-label="Done"><span class="nm"><b class="${done ? "done" : ""}">${esc(t.title)}</b><span class="${over ? "due" : ""}">${esc(line)}</span></span></label><span class="chip ${done ? "good" : "wait"}">${done ? "Done" : "To do"}</span></div>`;
              }
              const n = x.n;
              return `<div class="erow"><span class="nm"><b class="body">${esc(n.body)}</b><span>Note${n.author ? " by " + esc(personName(n.author)) : ""} · ${esc(short(n.created_at))}</span></span><span class="chip plain">Note</span></div>`;
            }).join("") : `<div class="erow"><span class="note">Nothing yet.</span></div>`}</div>`;
        } else if (nt === "activity") {
          const acts = activityOf(c, d);
          inner = `<div class="tl">${acts.length ? acts.map((a) => `<div class="${a.bad ? "bad" : ""}"><i></i><div>${esc(a.label)}<small>${esc(short(a.when))}</small></div></div>`).join("") : `<div><i></i><div class="note">No activity yet.</div></div>`}</div><p class="note">Filled in for you: sign-ups, purchases, bookings and Studio visits.</p>`;
        } else {
          const sent = mails.filter((e) => !notSent(e));
          const n = (xs) => sent.filter((e) => xs.some((x) => e.ev.has(x))).length;
          inner = `<div class="mstats"><div><b>${sent.length}</b><span>Sent</span></div><div><b>${n(["delivered", "opened", "clicked"])}</b><span>Delivered</span></div><div><b>${n(["opened", "clicked"])}</b><span>Opened</span></div><div><b>${n(["clicked"])}</b><span>Clicked</span></div></div>
            <div class="erows">${mails.length ? mails.map((e) => { const [tone, label] = furthest(e); return `<div class="erow"><span class="nm"><b>${esc(e.subject || "(no subject)")}</b><span>${esc(emailKind(e))} · ${esc(short(e.at))}</span></span><span class="chip ${tone}">${label}</span></div>`; }).join("") : `<div class="erow"><span class="note">No emails yet.</span></div>`}</div>
            <p class="note">Opened can include email scanners, so clicks are the surer sign.</p>`;
        }
        inner = `<div class="subtabs"><button type="button" data-act="ntab" data-tab="notes" class="${nt === "notes" ? "on" : ""}">Notes and tasks <i>${d.notes.length + openTasks}</i></button><button type="button" data-act="ntab" data-tab="activity" class="${nt === "activity" ? "on" : ""}">Activity</button><button type="button" data-act="ntab" data-tab="emails" class="${nt === "emails" ? "on" : ""}">Emails <i>${mails.length}</i></button></div><div class="ntscroll" id="ct-ntscroll" data-lenis-prevent>${inner}</div>`;
      }
      return box("Notes, tasks, activity and emails", inner, { fold: true, open: CS.ntOpen });
    }

    // ---- Send one email, now ----
    function sendBoxHtml() {
      const opts = SEND_TPLS === null ? `<option value="">Loading the templates</option>`
        : SEND_TPLS.length ? `<option value="">Choose an email…</option>` + SEND_TPLS.map((t) => `<option value="${esc(t.id)}" data-subject="${esc(t.subject || "")}">${esc(t.name)}</option>`).join("")
        : `<option value="">No active email templates yet</option>`;
      return box("Send an email", `<div class="sendbox">
          <div class="facts"><label class="field"><span>Email</span><select id="ct-sd-tpl">${opts}</select></label>
          <label class="field"><span>Kind</span><select id="ct-sd-kind"><option value="transactional">Service: something they expect</option><option value="marketing">Marketing: needs their opt-in</option></select></label></div>
          <label class="field"><span>Subject (blank uses the template's)</span><input id="ct-sd-subject"></label>
          <div id="ct-sd-confirm"></div>
          <p class="msg" id="ct-sd-msg"></p>
        </div>`, { foot: `<button type="button" class="mbtn" data-act="send-toggle">Cancel</button><button type="button" class="mbtn primary" data-act="send-go">Send now</button>` });
    }
    async function loadSendTemplates() {
      if (SEND_TPLS) return;
      try {
        const { data } = await supabase.from("email_templates").select("id, name, subject").eq("status", "active").order("name");
        SEND_TPLS = data || [];
      } catch (_) { SEND_TPLS = []; }
    }
    async function sendEmail(force) {
      const c = cardContact(); if (!c) return;
      const tplId = $("ct-sd-tpl")?.value;
      const msg = $("ct-sd-msg");
      const say = (m, cls) => { msg.textContent = m; msg.className = "msg" + (cls ? " " + cls : ""); };
      if (!tplId) { say("Choose an email first.", "bad"); return; }
      if (!WORKER) { say("The Worker isn't connected.", "bad"); return; }
      say("Sending.");
      try {
        const { ok, status, j } = await workerPost("/email/send-to-contact", { contact_id: c.id, template_id: tplId, send_kind: $("ct-sd-kind").value, subject: ($("ct-sd-subject").value || "").trim() || null, force: !!force });
        if (status === 409 && j.blocked && /opt/i.test(j.error || "") && !force) {
          say("");
          $("ct-sd-confirm").innerHTML = `<div class="confirm"><p>${esc(j.error)} Send it anyway? Only do this for an email they'd expect.</p><div><button type="button" class="mbtn" data-act="send-noforce">Don't send</button><button type="button" class="mbtn primary" data-act="send-force">Send anyway</button></div></div>`;
          return;
        }
        $("ct-sd-confirm").innerHTML = "";
        if (!ok) { say(j.error || "Couldn't send.", "bad"); return; }
        say(`Sent to ${j.to}: "${j.subject}".`, "ok");
        const { data: note } = await supabase.from("contact_notes").insert({ contact_id: c.id, body: `Sent email by hand: "${j.subject}"`, author: ME }).select("*").maybeSingle();
        if (note && CS && CS.id === c.id) CS.d.notes.unshift(note);
      } catch (_) { say("Couldn't reach the server.", "bad"); }
    }

    // ---- Studio account: check, link, invite ----
    async function checkAccount(c, force) {
      if (!WORKER) return;
      const box = $("ct-acct-msg"); if (!box) return;
      box.innerHTML = `<p class="note" style="padding:6px 0">Checking.</p>`;
      const r = await acctApi("/contacts/link", { contact_id: c.id, force: !!force });
      if (r.ok && r.linked) { toast("Linked to their Studio account."); await load(); openDrawer(c.id); return; }
      if (r.nameMismatch) {
        box.innerHTML = `<div class="confirm plain"><p>There's an account for ${esc(r.email)}, but its name (${esc(r.account_name || "unknown")}) doesn't match this card (${esc(r.card_name || "")}). Link them anyway?</p><div><button type="button" class="mbtn" data-act="acct-cancel">Cancel</button><button type="button" class="mbtn primary" data-act="acct-force">Link anyway</button></div></div>`;
        return;
      }
      if (r.noAccount) { box.innerHTML = `<p class="note" style="padding:6px 0">No Studio account for ${esc(c.email)} yet. Invite to the Studio makes one.</p>`; return; }
      box.innerHTML = `<p class="note bad" style="padding:6px 0">${esc(r.error || "Couldn't check just now. Please try again.")}</p>`;
    }
    /* Invite to the Studio (Danielle, 12 Nov 2026): the Worker makes their
       account, links it to this card and emails them a link to choose a
       password. Someone with an account already is just linked. */
    async function studioInvite(c) {
      const name = fullName(c) || c.email;
      if (!c.email) { toast("Add an email to this card first."); return; }
      document.querySelectorAll("#ct-drawer-body [data-act='invite-send']").forEach((b) => { b.disabled = true; b.textContent = "Sending"; });
      const r = await acctApi("/contacts/invite-studio", { contact_id: c.id });
      CS.confirm = null;
      if (r.ok && r.alreadyHasAccount) {
        toast(r.linked ? `${name} already has a Studio account, so we've linked it to this card. No invite was sent.`
          : `${name} already has a Studio account, but this card is linked to a different one. No invite was sent.`, 5000);
        if (r.linked) { await load(); openDrawer(c.id); } else renderCard();
        return;
      }
      if (r.ok && r.invited) { toast(`Invite sent to ${r.invited}. The link works for 14 days.`, 4000); await load(); openDrawer(c.id); return; }
      if (r.emailFailed) { toast(r.error, 6000); await load(); openDrawer(c.id); return; }
      renderCard();
      toast(r.error || "The invite didn't send. Please try again.", 5000);
    }

    // ---- Saves (each says Saved. only once the database returns the row) ----
    async function updateContact(c, patch) {
      const { data, error } = await supabase.from("contacts").update(patch).eq("id", c.id).select("*").maybeSingle();
      if (error || !data) return { error: error || { message: "The database didn't return the card." } };
      Object.assign(c, data);
      return { data };
    }
    async function saveDetails(confirmed) {
      const c = cardContact(); if (!c) return;
      const v = (id) => ($(id)?.value || "").trim();
      const errEl = $("ct-err-details");
      const err = (m) => { if (errEl) errEl.textContent = m; };
      const email = v("f-email").toLowerCase(), sec = v("f-sec").toLowerCase(), type = v("f-type"), stage = v("f-stage");
      if (!email) return err("A contact has to have an email address.");
      if (!EMAIL_RE.test(email)) return err("That email doesn't look right. Check it and save again.");
      if (sec && !EMAIL_RE.test(sec)) return err("The second email doesn't look right.");
      const was = lc(c.email);
      if (email !== was) {
        // Email is unique: catching the clash here turns a raw error into what you'd want to do.
        const dupe = ALL.find((x) => x.id !== c.id && lc(x.email) === email);
        if (dupe) return err(`${fullName(dupe)} already uses that address. Use Merge instead.`);
        if (!confirmed) {
          $("f-confirm").innerHTML = `<div class="confirm plain"><p>Change ${esc(fullName(c))}'s email from ${esc(was || "nothing")} to ${esc(email)}? ${c.user_id ? "Their Studio sign-in stays on the old address. This only changes their contact record." : "Orders and bookings are matched by email, so history under the old address will stop showing here."}</p><div><button type="button" class="mbtn" data-act="email-no">Keep the old one</button><button type="button" class="mbtn primary" data-act="email-yes">Change it</button></div></div>`;
          return;
        }
      }
      const live = liveOf(CS.d.profiles || []);
      if (type === "external" && live.length) return err(`They still work for ${live.map((p) => p.brand).join(" and ")}. Mark them as left in Brands first.`);
      const patch = { first_name: v("f-first") || null, last_name: v("f-last") || null, phone: v("f-phone") || null, company: v("f-company") || null };
      if (email !== was) patch.email = email;
      if ((sec || null) !== (c.secondary_email || null)) patch.secondary_email = sec || null;
      const hadSupport = isSupport(c);
      if ((type === "support") !== hadSupport) patch.tags = normalizeTags(type === "support" ? [...(c.tags || []), TEG_SUPPORT_TAG] : (c.tags || []).filter((t) => t !== TEG_SUPPORT_TAG));
      if (stage === "past" && c.lifecycle !== "past") patch.lifecycle = "past";
      if (stage !== "past" && c.lifecycle === "past") patch.lifecycle = "lead";
      err("Saving.");
      const { error } = await updateContact(c, patch);
      if (error) {
        const m = error.message || "";
        return err(/duplicate key|unique/i.test(m) ? "Another contact already uses that address. Merge the two cards instead."
          : /secondary_email/i.test(m) ? "The second email needs a database step: run supabase/contact_secondary_email.sql in Supabase."
          : "That didn't save: " + m);
      }
      if (patch.lifecycle) fire("contact_changed", c, { field: "lifecycle", value: patch.lifecycle });
     
      CS.editing = null; CS.err = "";
      // A new agent or manager needs a brand before they count as one.
      if (type !== "external" && !live.length) { CS.pendingType = type; CS.editing = "brandAdd"; }
      renderList(); renderCard();
      toast(CS.editing === "brandAdd" ? "Saved. Now add the brand they work for." : "Saved.");
    }
    async function toggleMarketing(c) {
      const on = !c.marketing_opt_in;
      const base = (c.tags || []).filter((t) => t !== "Marketing-Opt-In" && t !== "Marketing-Not-Opted-In" && !(t === "Newsletter-Subscriber" && !on));
      const tags = normalizeTags([...base, on ? "Marketing-Opt-In" : "Marketing-Not-Opted-In"]);
      const { error } = await updateContact(c, { marketing_opt_in: on, tags });
      if (error) { renderCard(); toast("That didn't save. Please try again."); return; }
      // The only place a person sets consent by hand, so the trail records who.
      try {
        const who = (await supabase.auth.getUser())?.data?.user?.email || "Admin";
        await supabase.from("contact_consent_events").insert({
          contact_id: c.id, email: lc(c.email), action: on ? "opted_in" : "opted_out",
          basis: on ? "legitimate_interest" : "withdrawn", source: "admin_toggle",
          detail: on ? "Set to Yes by an admin in the contact card, not by an act of consent by the contact." : "Set to No by an admin in the contact card.",
          actor: who,
        });
      } catch (_) {}
      fire("contact_changed", c, { field: "marketing_opt_in", value: on });
      renderList(); renderCard();
      toast(on ? "Opted in to marketing. Logged with today's date." : "Opted out of marketing. Logged with today's date.");
    }
    async function toggleDnd(c) {
      const on = !c.dnd;
      const { error } = await updateContact(c, { dnd: on });
      if (error) { renderCard(); toast("That didn't save. Please try again."); return; }
      if (on) fire("dnd_set", c, {});
      renderList(); renderCard();
      toast(on ? "Marked do not contact." : "Do not contact is off.");
    }
    async function setTags(c, next, trigger, tag) {
      const { error } = await updateContact(c, { tags: normalizeTags(next) });
      if (error) { toast("That didn't save. Please try again."); return; }
      fire(trigger, c, { tag });
      renderList(); renderCard();
      toast(trigger === "tag_added" ? "Tag added." : "Tag removed.");
    }

    // ---- Brands: save, primary, left, back, remove, photo ----
    async function brandPost(c, body) {
      if (!WORKER) { toast("The Worker isn't connected, so brands can't be saved."); return null; }
      const { ok, j } = await workerPost("/agent/profile", { contact_id: c.id, ...body });
      if (!ok || !Array.isArray(j.profiles)) { renderCard(); toast(j.error || "That didn't save. Please try again.", 4000); return null; }
      setProfiles(c, j.profiles);
      return j;
    }
    async function saveBrand(add) {
      const c = cardContact(); if (!c) return;
      const v = (id) => ($(id)?.value || "").trim();
      const errEl = $(add ? "ct-err-brandAdd" : "ct-err-brand");
      const err = (m) => { if (errEl) errEl.textContent = m; };
      const rows = CS.d.profiles || [];
      const p = add ? null : rows.find((r) => String(r.id) === String(CS.tab));
      const brand = (add || !(p && p.brand)) ? v("bf-brand") : p.brand;
      if (!brand) return err("Choose the brand.");
      const pkg = v("bf-pkg");
      const body = {
        brand, job_title: v("bf-job"), area: v("bf-area"), postcode: v("bf-post"), date_joined: v("bf-joined") || null,
        email: v("bf-email"), phone: v("bf-phone"),
        // Always sent, so clearing the box clears the photo.
        brand_photo_url: v("bf-photo"),
        make_primary: !!$("bf-primary")?.checked,
      };
      if ($("bf-pkg")) Object.assign(body, {
        is_new_starter: !!pkg, package: pkg || null, induction_month: v("bf-month") || null,
        // Only sent for a new starter, or every save stamps a trainer on someone never inducted.
        trainer_name: pkg ? v("bf-trainer") : null, trainer_email: pkg ? v("bf-trainer-email") : null,
      });
      err("Saving.");
      const j = await brandPost(c, body);
      if (!j) return err("");
      const saved = j.profiles.find((r) => lc(r.brand) === lc(brand));
      if (saved) CS.tab = saved.id;
      // An agent carries their network tag; Fine & Country has its own (Dani, 6 Nov 2026).
      if (!isSupport(c)) {
        const net = /fine\s*(&|and)\s*country/i.test(brand) || /@fineandcountry\./i.test(c.email || "") ? "Network: Fine-and-Country" : "Network: TEG";
        if (!(c.tags || []).includes(net)) await updateContact(c, { tags: normalizeTags([...(c.tags || []), net]) });
      }
      CS.editing = null; CS.pendingType = null;
      renderList(); renderCard();
      toast(saved && saved.promo_code && body.package ? `Saved. Their free code is ${saved.promo_code}.` : "Saved.");
    }
    async function brandAction(kind) {
      const c = cardContact(); if (!c) return;
      const p = (CS.d.profiles || []).find((r) => String(r.id) === String(CS.tab)); if (!p || !p.brand) return;
      if (kind === "primary") { if (await brandPost(c, { brand: p.brand, make_primary: true })) { renderList(); renderCard(); toast("Their Studio opens in this brand now."); } return; }
      if (kind === "leave") { if (await brandPost(c, { brand: p.brand, left_at: todayIso() })) { renderList(); renderCard(); toast(`Marked as left ${p.brand} today. Their history stays.`); } return; }
      if (kind === "unleave") { if (await brandPost(c, { brand: p.brand, left_at: null })) { renderList(); renderCard(); toast(`Back at ${p.brand}.`); } return; }
    }
    async function removeBrand() {
      const c = cardContact(); if (!c) return;
      const p = (CS.d.profiles || []).find((r) => String(r.id) === String(CS.tab)); if (!p) return;
      const { ok, j } = await workerPost("/agent/profile/remove", { id: p.id });
      if (!ok) { renderCard(); toast(j.error || "Couldn't remove that brand.", 4000); return; }
      let rows = (CS.d.profiles || []).filter((r) => String(r.id) !== String(p.id));
      // The Worker says which brand it made primary in place of this one.
      if (j.primary) rows = rows.map((r) => ({ ...r, is_primary: String(r.id) === String(j.primary) }));
      setProfiles(c, rows);
      CS.confirm = null; CS.tab = null;
      renderList(); renderCard(); toast("Brand removed.");
    }
    async function pullPhoto(id) {
      const c = cardContact(); if (!c) return;
      const rows = CS.d.profiles || [];
      const src = rows.find((r) => String(r.id) === String(id));
      const p = rows.find((r) => String(r.id) === String(CS.tab));
      if (!src || !p || !src.brand_photo_url) return;
      if (await brandPost(c, { brand: p.brand, brand_photo_url: src.brand_photo_url })) { renderCard(); toast(`Using their ${src.brand} photo.`); }
    }
    /* Uploading the brand photo: straight into the public bucket the brand
       logos already use, so a design can fetch it. Saved with the brand. */
    async function uploadPhoto(file) {
      const msg = $("bf-photo-msg");
      const say = (m) => { if (msg) msg.textContent = m; };
      if (!file || !file.type.startsWith("image/")) return;
      say("Uploading the photo.");
      const ext = (file.name.split(".").pop() || "png").toLowerCase();
      const path = `agent-photos/${Date.now()}-${Math.random().toString(36).slice(2, 7)}.${ext}`;
      const { error } = await supabase.storage.from("pack-images").upload(path, file, { cacheControl: "3600", upsert: false, contentType: file.type });
      if (error) { say("That didn't upload: " + error.message); return; }
      const { data } = supabase.storage.from("pack-images").getPublicUrl(path);
      $("bf-photo").value = data.publicUrl;
      showPhoto(data.publicUrl);
      say("Uploaded. Save to keep it.");
    }
    function showPhoto(url) {
      const tile = $("bf-tile"); if (!tile) return;
      tile.classList.toggle("has", !!url);
      tile.style.backgroundImage = url ? `url('${url.replace(/'/g, "%27")}')` : "";
      const label = tile.childNodes[tile.childNodes.length - 1];
      if (label && label.nodeType === 3) label.textContent = url ? "" : "No photo";
      else if (!url) tile.append("No photo");
      const clr = $("bf-clear"); if (clr) clr.hidden = !url;
    }

    // ---- Notes and tasks ----
    async function addNote(btn) {
      const c = cardContact(); if (!c) return;
      const v = ($("ct-nt-text")?.value || "").trim();
      if (!v) { toast("Write something first."); return; }
      btn.disabled = true;
      const { data, error } = await supabase.from("contact_notes").insert({ contact_id: c.id, body: v, author: ME }).select("*").maybeSingle();
      if (error || !data) { btn.disabled = false; toast("That note didn't save: " + ((error && error.message) || "please try again.")); return; }
      CS.d.notes.unshift(data);
      fire("note_added", c, {});
      renderCard(); toast("Note added.");
    }
    let TASK_ASSIGNEE = true;   // false once we know contact_tasks has no assigned_to yet
    async function addTask(btn) {
      const c = cardContact(); if (!c) return;
      const title = ($("ct-tk-text")?.value || "").trim();
      if (!title) { toast("Say what needs doing first."); return; }
      btn.disabled = true;
      const due = $("ct-tk-due")?.value || "", who = $("ct-tk-who")?.value || "";
      const base = { contact_id: c.id, title, due_at: due ? new Date(due + "T09:00:00").toISOString() : null };
      let res = null;
      if (TASK_ASSIGNEE) {
        res = await supabase.from("contact_tasks").insert({ ...base, assigned_to: who || null }).select("*").maybeSingle();
        // supabase/contact_tasks_assignee.sql not run yet: keep working, with the person in the detail.
        if (res.error && /assigned_to/i.test(res.error.message || "")) { TASK_ASSIGNEE = false; res = null; }
      }
      if (!res) res = await supabase.from("contact_tasks").insert({ ...base, detail: who ? `For ${who}` : null }).select("*").maybeSingle();
      if (res.error || !res.data) { btn.disabled = false; toast("That task didn't save: " + ((res.error && res.error.message) || "please try again.")); return; }
      CS.d.tasks.unshift(res.data);
      renderCard(); toast(`Task added${who ? " for " + who : ""}.`);
    }
    async function toggleTask(id, done) {
      const c = cardContact(); if (!c) return;
      const t = CS.d.tasks.find((x) => String(x.id) === String(id)); if (!t) return;
      const { data, error } = await supabase.from("contact_tasks").update({ status: done ? "done" : "open", completed_at: done ? new Date().toISOString() : null }).eq("id", t.id).select("*").maybeSingle();
      if (error || !data) { toast("That didn't save. Please try again."); renderCard(); return; }
      Object.assign(t, data);
      if (done) fire("task_completed", c, { task: t.title });
      renderCard();
    }

    // ---- Merge picker (More, Merge with another card) ----
    function paintMergePicks(q) {
      const c = cardContact(); const box = $("ct-mp-res"); if (!c || !box) return;
      const words = lc(q).split(/\s+/).filter(Boolean);
      if (!words.length) { box.innerHTML = ""; return; }
      const hits = ALL.filter((x) => x.id !== c.id && words.every((w) => haystack(x).includes(w))).slice(0, 6);
      box.innerHTML = hits.length ? hits.map((x) => `<button type="button" data-act="mergewith" data-id="${esc(x.id)}"><b>${esc(fullName(x))}</b><span>${esc(x.email || "")}</span></button>`).join("") : `<p class="note">Nobody matches.</p>`;
    }

    // ---- The card's one click handler ----
    $("ct-drawer").addEventListener("click", async (e) => {
      const t = e.target.closest("[data-act]"); if (!t) return;
      const a = t.dataset.act, c = cardContact();
      if (a === "close") { closeDrawer(); return; }
      if (!c || !CS) return;
      const redraw = () => renderCard();
      switch (a) {
        case "more": CS.confirm = CS.confirm === "more" ? null : "more"; return redraw();
        case "noconfirm": CS.confirm = null; return redraw();
        case "ask-delete": CS.confirm = "delete"; return redraw();
        case "merge-pick": CS.confirm = "mergepick"; return redraw();
        case "mergewith": { const o = ALL.find((x) => x.id === t.dataset.id); if (o) openMerge(c, o); return; }
        case "delete": {
          t.disabled = true;
          const { data, error } = await supabase.from("contacts").delete().eq("id", c.id).select("id");
          if (error || !data || !data.length) { t.disabled = false; toast("That didn't delete. Please try again."); return; }
          ALL = ALL.filter((x) => x.id !== c.id); PROFILES.delete(c.id); S.sel.delete(c.id);
          closeDrawer(); renderList(); toast(`${fullName(c)} deleted.`); return;
        }
        case "send-toggle": CS.send = !CS.send; redraw(); if (CS.send && SEND_TPLS === null) { await loadSendTemplates(); if (CS && CS.send) redraw(); } return;
        case "send-go": return sendEmail(false);
        case "send-force": return sendEmail(true);
        case "send-noforce": $("ct-sd-confirm").innerHTML = ""; return;
        case "edit": CS.editing = t.dataset.box; CS.confirm = null; CS.err = ""; if (t.dataset.box !== "brandAdd") CS.pendingType = null; redraw(); $("ct-drawer-body").querySelector(".box.editing input:not([type=hidden]):not([type=file]), .box.editing select")?.focus(); return;
        case "cancel": CS.editing = null; CS.pendingType = null; CS.err = ""; return redraw();
        case "save": { t.disabled = true; const k = t.dataset.box; if (k === "details") await saveDetails(false); else await saveBrand(k === "brandAdd"); if (t.isConnected) t.disabled = false; return; }
        case "email-yes": return saveDetails(true);
        case "email-no": $("f-confirm").innerHTML = ""; return;
        case "dup-clear": {
          const em = lc(c.email);
          const { error } = await supabase.from("contacts").update({ needs_review: false, review_reason: null }).ilike("email", em);
          if (error) { toast("That didn't save. Please try again."); return; }
          ALL.forEach((x) => { if (lc(x.email) === em) { x.needs_review = false; x.review_reason = null; } });
          renderList(); redraw(); toast("Cleared. It won't flag again."); return;
        }
        case "tog-mkt": t.disabled = true; return toggleMarketing(c);
        case "tog-dnd": t.disabled = true; return toggleDnd(c);
        case "invite-ask": CS.confirm = "invite"; return redraw();
        case "invite-send": return studioInvite(c);
        case "acct-check": return checkAccount(c, false);
        case "acct-force": return checkAccount(c, true);
        case "acct-cancel": $("ct-acct-msg").innerHTML = ""; return;
        case "btab": CS.tab = t.dataset.id; CS.confirm = null; return redraw();
        case "primary": case "leave": case "unleave": t.disabled = true; return brandAction(a);
        case "rm-ask": CS.confirm = "rm"; return redraw();
        case "rm": t.disabled = true; return removeBrand();
        case "pull": t.disabled = true; return pullPhoto(t.dataset.id);
        case "pull-edit": { const src = (CS.d.profiles || []).find((r) => String(r.id) === t.dataset.id); if (src) { $("bf-photo").value = src.brand_photo_url; showPhoto(src.brand_photo_url); $("bf-photo-msg").textContent = `Using their ${src.brand} photo. Save to keep it.`; } return; }
        case "photo-upload": $("bf-file")?.click(); return;
        case "photo-clear": $("bf-photo").value = ""; showPhoto(""); return;
        case "copy-link": try { await navigator.clipboard.writeText(t.dataset.url); toast("Booking link copied. Their free code is already in it."); } catch (_) { toast("Couldn't copy. Select the link and copy it."); } return;
        case "untag": return setTags(c, (c.tags || []).filter((x) => x !== t.dataset.tag), "tag_removed", t.dataset.tag);
        case "tag-add": { const v = $("ct-tagpick")?.value; if (!v) { toast("Pick a tag first."); return; } return setTags(c, [...(c.tags || []), v], "tag_added", v); }
        case "fold": CS.ntOpen = !CS.ntOpen; return redraw();
        case "ntab": CS.ntab = t.dataset.tab; return redraw();
        case "addmode": CS.addMode = t.dataset.mode; return redraw();
        case "note-add": return addNote(t);
        case "task-add": return addTask(t);
        case "task-done": return toggleTask(t.dataset.id, t.checked);
      }
    });
    $("ct-drawer").addEventListener("change", (e) => {
      const t = e.target;
      if (t.id === "bf-file") { const f = t.files && t.files[0]; t.value = ""; uploadPhoto(f); return; }
      if (t.id === "ct-sd-tpl") { const o = t.selectedOptions[0]; $("ct-sd-subject").placeholder = o && o.dataset.subject ? o.dataset.subject : ""; return; }
      // A new brand starts with that brand's usual job title, unless one's been typed.
      if (t.id === "bf-brand") { const j = $("bf-job"); if (j && (!j.value || Object.values(TITLES).includes(j.value))) j.value = TITLES[lc(t.value)] || ""; return; }
    });
    $("ct-drawer").addEventListener("input", (e) => {
      const t = e.target;
      if (t.id === "ct-mp-q") { paintMergePicks(t.value); return; }
      if (t.id === "bf-photo") { showPhoto(t.value.trim()); return; }
      if (t.id === "f-email") {
        const c = cardContact(); const note = $("f-email-note"); if (!c || !note) return;
        const changed = lc(t.value) !== lc(c.email);
        note.hidden = !changed;
        note.textContent = changed ? (c.user_id ? "Their Studio sign-in stays on the old address. This only changes their contact record." : "Orders and bookings are matched by email, so history under the old address will stop showing here.") : "";
        $("f-confirm").innerHTML = "";
      }
    });

    /* .ash-content is position:relative with z-index:2, a stacking context the
       card can't climb out of: the frosted top bar would sit over it. Moving the
       card, its scrim, the pop-outs and the toast to <body> puts them where
       z-index means what it says. */
    document.body.append($("ct-scrim"), $("ct-drawer"), $("ct-merge"), $("ct-import"), $("ct-add"), $("ct-toast"));
    // Start the card below the app bar, measured from the bar itself.
    function fitDrawerTop() {
      const bar = document.querySelector(".ash-top");
      const top = bar ? Math.round(bar.getBoundingClientRect().bottom) + 12 : 84;
      document.documentElement.style.setProperty("--ct-drawer-top", top + "px");
    }
    fitDrawerTop();
    window.addEventListener("resize", fitDrawerTop);
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      if (!$("ct-merge").hidden) { closeMerge(); return; }
      if (!$("ct-import").hidden) { $("ct-import").hidden = true; return; }
      if (!$("ct-add").hidden) { $("ct-add").hidden = true; return; }
      if (S.menu) { S.menu = null; renderBar(); return; }
