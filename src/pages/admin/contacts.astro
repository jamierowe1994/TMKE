    .ct-row { display: flex; gap: 8px; }
    .ct-row input, .ct-row select, .ct-drawer textarea { font-family: var(--sans); font-size: 13.5px; padding: 8px 11px; border: 1px solid rgba(28,29,34,0.18); border-radius: 7px; background: #fff; color: var(--ink); flex: 1; }
    .ct-field { display: flex; flex-direction: column; gap: 5px; margin-bottom: 12px; }
    .ct-field > label { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .ct-field input, .ct-field select { font-family: var(--sans); font-size: 13.5px; padding: 8px 11px; border: 1px solid rgba(28,29,34,0.18); border-radius: 7px; background: #fff; color: var(--ink); }
    .ct-field input:focus, .ct-field select:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .teg-code code { font-family: ui-monospace, Menlo, monospace; font-size: 14px; font-weight: 700; color: var(--english-violet); background: var(--paper); border: 1px solid rgba(28,29,34,0.12); border-radius: 6px; padding: 4px 10px; display: inline-block; letter-spacing: 0.03em; }
    .ct-teg-detect { font-family: var(--sans); font-size: 12.5px; line-height: 1.45; color: var(--english-violet); background: rgba(55,30,40,0.06); border-radius: 8px; padding: 9px 12px; margin: 10px 0 0; }
    .ct-teg-msg { font-family: var(--sans); font-size: 13px; border-radius: 8px; padding: 9px 12px; margin: 12px 0 0; }
    .ct-teg-msg.is-ok { background: rgba(60,150,90,0.1); color: #2e6b40; }
    .ct-teg-msg.is-err { background: rgba(200,70,50,0.1); color: #a3372b; }
    .ct-mini { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; border: 1px solid var(--english-violet); background: transparent; color: var(--english-violet); border-radius: 6px; padding: 8px 12px; cursor: pointer; }
    .ct-mini:hover { background: var(--english-violet); color: #fff; }
    .ct-item { padding: 10px 0; border-bottom: 1px solid rgba(28,29,34,0.06); font-family: var(--sans); font-size: 13px; color: var(--ink); }
    .ct-item-meta { font-size: 11px; color: rgba(28,29,34,0.45); margin-top: 2px; }
    .ct-mini-ghost { border-color: rgba(28,29,34,0.2); color: rgba(28,29,34,0.6); }
    .ct-flag { color: #b0592e; font-size: 13px; cursor: help; }
    .ct-chip-review.is-active { background: #b0592e; border-color: #b0592e; color: #fff; }
    .ct-dup { border: 1px solid rgba(176,89,46,0.35); background: rgba(176,89,46,0.06); border-radius: 10px; padding: 14px 16px; }
    .ct-dup-head { font-family: var(--sans); font-size: 13px; font-weight: 700; color: #8f4522; margin-bottom: 6px; }
    .ct-dup-p { font-family: var(--sans); font-size: 12.5px; line-height: 1.5; color: rgba(28,29,34,0.7); margin: 0 0 12px; }
    .ct-dup-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 9px 0; border-top: 1px solid rgba(176,89,46,0.2); }
    .ct-dup-row strong { font-family: var(--sans); font-size: 13.5px; color: var(--ink); }
    .ct-dup-acts { margin-top: 10px; }
    .ct-task { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
    .ct-task.done { opacity: 0.5; text-decoration: line-through; }
    .ct-toggle { font-family: var(--sans); font-size: 12px; color: var(--english-violet); cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }

    /* Tag filter dropdown */
    .ct-tagfilter { position: relative; }
    /* The bar and the contact list are sibling stacking contexts (both z 2), so
       the later-in-DOM list painted OVER the open menu — the menu's own z-index
       can't escape its parent context. Lift the bar while the menu is open. */
    .admin-bar:has(#ct-tagfilter-menu:not([hidden])) { z-index: 30; }
    .ct-tagfilter-btn { gap: 6px; }
    .ct-tagfilter-btn.is-on { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .ct-tagfilter-btn.is-on b { background: rgba(255,255,255,0.22); color: #fff; }
    .ct-tagfilter-caret { width: 12px; height: 12px; flex: none; }
    /* Fixed (not absolute) so it escapes the .ash-content / .ash overflow
       clipping — otherwise its lower half is cut off (looks see-through) and the
       scrollbar can't be reached. top/left/max-height are set in JS from the
       button's position so it always sits below the button and fits the viewport. */
    .ct-tagfilter-menu { position: fixed; z-index: 400; width: 288px; overflow-y: auto; background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 12px; box-shadow: 0 24px 50px -22px rgba(20,18,26,0.35); padding: 8px; }
    .ct-tagfilter-menu[hidden] { display: none; }
    .ct-tagfilter-empty { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); padding: 10px 8px; }
    .ct-tagfilter-group + .ct-tagfilter-group { margin-top: 2px; }
    .ct-tagfilter-group-h { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.45); padding: 10px 9px 4px; }
    .ct-tagfilter-opt { display: flex; align-items: center; gap: 9px; padding: 7px 9px; border-radius: 8px; font-family: var(--sans); font-size: 13px; color: var(--ink); cursor: pointer; }
    .ct-tagfilter-opt:hover { background: rgba(55,30,40,0.05); }
    .ct-tagfilter-opt input { accent-color: var(--english-violet); width: 15px; height: 15px; flex: none; }
    .ct-tagfilter-foot { display: flex; justify-content: flex-end; padding: 8px 6px 2px; margin-top: 4px; border-top: 1px solid rgba(28,29,34,0.08); }
    .ct-tagfilter-clear { border: 0; background: none; color: var(--english-violet); font-family: var(--sans); font-size: 12px; font-weight: 700; cursor: pointer; }

    /* Bulk select + delete */
    .ct-bulkbar { display: flex; align-items: center; gap: 12px; margin: 0 0 10px; padding: 8px 14px; background: rgba(55,30,40,0.06); border: 1px solid rgba(var(--violet-rgb),0.2); border-radius: 4px; }
    .ct-bulkbar[hidden] { display: none; }
    .ct-bulk-count { font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--english-violet); margin-right: auto; }
    .ct-bulk-del { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.04em; border: 1px solid #a5352f; background: #a5352f; color: #fff; border-radius: 8px; padding: 8px 15px; cursor: pointer; transition: background 0.15s; }
    .ct-bulk-del:hover { background: #7f2a25; }
    .ct-bulk-clear { font-family: var(--sans); font-size: 12px; font-weight: 600; border: 1px solid rgba(28,29,34,0.18); background: #fff; color: rgba(28,29,34,0.7); border-radius: 8px; padding: 8px 14px; cursor: pointer; }
    .ct-check-col { width: 40px; }
    .ct-table td.ct-check-cell { cursor: default; }
    .ct-check-col input, .ct-check-cell input { accent-color: var(--english-violet); width: 15px; height: 15px; cursor: pointer; }

    /* Drawer tabs */
    .ct-tabs { display: flex; gap: 4px; padding: 4px 24px 0; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .ct-tab { position: relative; appearance: none; background: none; border: 0; font-family: var(--sans); font-size: 13px; font-weight: 600; color: rgba(28,29,34,0.55); padding: 12px 6px 13px; cursor: pointer; transition: color 0.15s; }
    .ct-tab:hover { color: var(--ink); }
    .ct-tab.is-active { color: var(--english-violet); }
    .ct-tab.is-active::after { content: ""; position: absolute; left: 0; right: 0; bottom: -1px; height: 2px; border-radius: 2px; background: var(--english-violet); }
    .ct-tabpanel { display: flex; flex-direction: column; gap: 0; }
    .ct-tabpanel[hidden] { display: none; }
    /* Sections separated by a hairline rule for a clearer, scannable read. */
    .ct-tabpanel .ct-sec { margin-top: 18px; padding-top: 18px; border-top: 1px solid rgba(28,29,34,0.09); }
    .ct-tabpanel .ct-sec:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
    /* Details as a tidy label/value list (consistent row spacing). */
    .ct-dl { display: flex; flex-direction: column; gap: 9px; margin: 0; }
    .ct-dl > div { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; font-family: var(--sans); font-size: 13.5px; line-height: 1.4; }
    .ct-dl dt { color: rgba(28,29,34,0.5); flex: none; }
    .ct-dl dd { color: var(--ink); margin: 0; text-align: right; min-width: 0; word-break: break-word; }
  </style>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { supabase } from "../../lib/supabase.js";
    import { TAG_GROUPS } from "../../lib/contact-tags.js";

    const DEV = import.meta.env.DEV;
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const fmtDate = (d) => { if (!d) return "—"; try { return new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); } catch (_) { return ""; } };
    const fullName = (c) => [c.first_name, c.last_name].filter(Boolean).join(" ") || "(no name)";
    const gbp = (p) => (p == null ? "—" : "£" + (p / 100).toLocaleString("en-GB", { minimumFractionDigits: p % 100 ? 2 : 0, maximumFractionDigits: 2 }));
    const humanizeSource = (s) => { if (!s) return "—"; return String(s).replace(/_/g, " ").replace(/\bsmm\b/gi, "SMM").replace(/\btmke\b/gi, "TMKE").replace(/^./, (ch) => ch.toUpperCase()); };
    // Single lifecycle label from attributes, most-progressed first:
    // Customer (paid/booked) > Member (has account) > TEG (came in via The
    // Experts Group) > Lead (contact only). 'past' is a manual override.
    // So a TEG starter shows as TEG rather than Lead, and is promoted to
    // Member/Customer the moment they create an account or book something.
    // The lifecycle ladder, least → most progressed. "TEG" is written out (not
    // title-cased from the value) because it's an acronym.
    const LIFECYCLES = [["lead", "Lead"], ["teg", "TEG"], ["member", "Member"], ["customer", "Customer"], ["past", "Past"]];
    const lifecycleLabel = (v) => (LIFECYCLES.find(([x]) => x === v) || [v, v])[1];
    const isTeg = (c) => (c.tags || []).some((t) => /^Videography-New-Starter:/i.test(t) || t === "Network: TEG")
      || c.source === "agent_sheet_sync" || c.lifecycle === "teg";
    function deriveLifecycle(c) {
      if (c.lifecycle === "past") return "past";
      if (isPurchaser(c) || isSession(c)) return "customer";
      if (c.user_id) return "member";
      if (isTeg(c)) return "teg";
      return "lead";
    }
    // Framework tags (the manual "add tag" dropdown) — shared catalogue, no free-text.

    // Reconcile a contact's tags to the CRM rules (mirrors the Worker's
    // normalizeTags + normalize_contact_tags in SQL — keep the three in sync).
    const TAG_ALIASES = {
      "TEG": "Network: TEG",
      "Estate Agent": "Type: Estate-Agent",
      "Lettings": "Type: Lettings",
      "Financial Services": "Type: Financial-Services",
      "Fine & Country": "Network: Fine-and-Country",
      "Fine and Country": "Network: Fine-and-Country",
    };
    function normalizeTags(tags) {
      let t = Array.from(new Set((tags || []).map((x) => String(x || "").trim()).filter(Boolean).map((x) => TAG_ALIASES[x] || x)));
      const has = (x) => t.includes(x);
      const dropAll = (...xs) => { t = t.filter((v) => !xs.includes(v)); };
      if (has("Unsubscribed")) dropAll("Newsletter-Subscriber", "Marketing-Not-Opted-In");
      else if (has("Newsletter-Subscriber")) dropAll("Marketing-Not-Opted-In");
      if (t.filter((v) => v.startsWith("SMM-Status:")).length > 1) {
        const keep = has("SMM-Status: Active") ? "SMM-Status: Active" : has("SMM-Status: Paused") ? "SMM-Status: Paused" : "SMM-Status: Ended";
        t = t.filter((v) => !v.startsWith("SMM-Status:")).concat(keep);
      }
      if (t.some((v) => v.startsWith("SMM-Status:"))) dropAll("Interest: SMM", "Discovery-Call-Booked: SMM");
      if (has("Videography-Client")) dropAll("Interest: Videography", "Discovery-Call-Booked: Videography");
      return t;
    }

    let ALL = [], q = "", seg = "all", current = null;
    let selectedTags = new Set();   // tag-filter pill (multi-select)
    let selectedIds = new Set();    // bulk-select for delete
    let activeTab = "info";         // contact drawer tab
    // Who has actually purchased / booked — read live from orders + bookings by
    // email (not just the tag), so the chips are reliable even before a backfill.
    let PURCHASER_EMAILS = new Set(), SESSION_EMAILS = new Set(), CALL_EMAILS = new Set();
    const lc = (e) => String(e || "").toLowerCase().trim();
    const isPurchaser = (c) => PURCHASER_EMAILS.has(lc(c.email)) || (c.tags || []).includes("Pack-Purchased");
    const isSession = (c) => SESSION_EMAILS.has(lc(c.email)) || (c.tags || []).includes("Videography-Client");
    const isCall = (c) => CALL_EMAILS.has(lc(c.email)) || (c.tags || []).some((t) => t.indexOf("Discovery-Call-Booked") === 0);
    const isBooked = (c) => isSession(c) || isCall(c);
    // Attribute-based segments (what the CRM slices by).
    const SEGMENTS = {
      all: () => true,
      members: (c) => !!c.user_id,
      email: (c) => c.marketing_opt_in === true,
      purchasers: isPurchaser,
      booked: isBooked,
      // Live social media management clients. Paused and Ended are deliberately
      // excluded: this is "who are we running social for right now", which is
      // the question anyone actually asks of this list.
      smm: (c) => (c.tags || []).includes("SMM-Status: Active"),
      // Just a contact: no account, no marketing consent, and not a customer.
      contact: (c) => !c.user_id && c.marketing_opt_in !== true && !isPurchaser(c) && !isBooked(c),
      review: (c) => !!c.needs_review,
      // Unsubscribed, suppressed (dead address) or currently soft-bouncing —
      // the people a campaign can't or mustn't reach.
      issues: (c) => !!c.unsubscribed_at || !!c.suppressed_at || (Number(c.soft_bounce_count) || 0) > 0,
    };

    // Fire a contact-action trigger into the automations engine (admin authed).
    async function fire(trigger, contact, payload) {
      if (!WORKER) return;
      try {
        const { data } = await supabase.auth.getSession();
        if (!data?.session) return;
        await fetch(`${WORKER}/automations/fire`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${data.session.access_token}` },
          body: JSON.stringify({ trigger, email: contact.email, first_name: contact.first_name, last_name: contact.last_name, company: contact.company, payload: payload || {} }),
        });
      } catch (_) {}
    }

    // Paging state. perPage 0 means "All" - kept as a real option because the
    // export and a bulk select over everything are both easier with the whole
    // list on screen.
    let page = 1, perPage = 25, pageRows = [];

    // Any change to what is being filtered has to go back to page one, or you
    // land on page 4 of a two-page result and see nothing at all.
    function refilter() { page = 1; render(); }

    function getFiltered() {
      return ALL
        .filter(SEGMENTS[seg] || SEGMENTS.all)
        .filter((c) => !q || (fullName(c) + " " + c.email + " " + (c.company || "")).toLowerCase().includes(q))
        .filter((c) => !selectedTags.size || (c.tags || []).some((t) => selectedTags.has(t)));
    }
    function updateCounts() {
      Object.keys(SEGMENTS).forEach((k) => { const el = document.querySelector(`[data-n="${k}"]`); if (el) el.textContent = ALL.filter(SEGMENTS[k]).length; });
    }
    // The board shows a curated summary, not every tag: network, consent, and
    // the high-level services (packs / videography / SMM). Everything else
    // lives in the drawer; "+N" hints at how much more is on the card.
    function summaryTags(c) {
      const t = c.tags || [];
      const picked = [
        t.find((x) => x.startsWith("Network:")),
        t.includes("Unsubscribed") ? "Unsubscribed"
          : t.includes("Newsletter-Subscriber") ? "Newsletter-Subscriber"
          : t.includes("Marketing-Not-Opted-In") ? "Marketing-Not-Opted-In" : null,
        t.includes("Pack-Purchased") ? "Pack-Purchased" : null,
        t.includes("Videography-Client") ? "Videography-Client" : null,
        t.find((x) => x.startsWith("SMM-Status:")),
      ].filter(Boolean);
      return { picked, more: t.length - picked.length };
    }
    function render() {
      updateCounts();
      const list = getFiltered();
      $("ct-count").textContent = `${ALL.length} contact${ALL.length === 1 ? "" : "s"}`;
      $("ct-empty").hidden = ALL.length !== 0;
      $("ct-table").hidden = list.length === 0;
      // Drop selections no longer visible so the bulk bar stays accurate.
      const visibleIds = new Set(list.map((c) => c.id));
      Array.from(selectedIds).forEach((id) => { if (!visibleIds.has(id)) selectedIds.delete(id); });
      // Selections survive paging - they are pruned against the whole filtered
      // list above, not just the rows on screen.
      const size = perPage || list.length || 1;
      const pages = Math.max(1, Math.ceil(list.length / size));
      if (page > pages) page = pages;
      const from = (page - 1) * size;
      pageRows = perPage ? list.slice(from, from + size) : list;
      renderPager(list.length, pages, from);
      $("ct-rows").innerHTML = pageRows.map((c) => `
        <tr data-id="${esc(c.id)}">
          <td class="ct-check-cell"><input type="checkbox" class="ct-row-check" data-check="${esc(c.id)}" ${selectedIds.has(c.id) ? "checked" : ""} aria-label="Select ${esc(fullName(c))}" /></td>
          <td>${esc(fullName(c))}${c.needs_review ? ' <span class="ct-flag" title="Possible duplicate — needs review">⚠</span>' : ""}</td>
          <td class="ct-brand-cell">${esc(brandOf(c))}</td>
          <td><span class="ct-life ${c.dnd ? "dnd" : esc(deriveLifecycle(c))}">${c.dnd ? "DND" : esc(lifecycleLabel(deriveLifecycle(c)))}</span></td>
          <td>${(() => { const s = summaryTags(c); return s.picked.map((t) => `<span class="ct-tag">${esc(t)}</span>`).join("") + (s.more > 0 ? `<span class="ct-tag ct-tag-more" title="${s.more} more tag${s.more === 1 ? "" : "s"} on the card">+${s.more}</span>` : "") || "—"; })()}</td>
          <td>${esc(fmtDate(c.last_seen_at))}</td>
        </tr>`).join("");
      $("ct-rows").querySelectorAll("[data-id]").forEach((tr) => tr.addEventListener("click", (e) => {
        if (e.target.closest(".ct-check-cell")) return;   // selection handled on the checkbox
        openDrawer(tr.getAttribute("data-id"));
      }));
      $("ct-rows").querySelectorAll(".ct-row-check").forEach((cb) => cb.addEventListener("change", () => {
        const id = cb.getAttribute("data-check");
        if (cb.checked) selectedIds.add(id); else selectedIds.delete(id);
        syncSelection(pageRows);
      }));
      syncSelection(pageRows);
    }

    function renderPager(total, pages, from) {
      const pager = $("ct-pager");
      // One page of everything needs no controls at all.
      pager.hidden = total <= 25;
      if (pager.hidden) return;
      const shown = pageRows.length;
      $("ct-pager-range").textContent = shown
        ? `Showing ${from + 1}–${from + shown} of ${total}`
        : `No contacts on this page`;
      $("ct-pager-pages").textContent = `Page ${page} of ${pages}`;
      $("ct-prev").disabled = page <= 1;
      $("ct-next").disabled = page >= pages;
      // "All" hides the arrows - there is nowhere to go.
      $("ct-pager-nav").style.visibility = perPage ? "" : "hidden";
    }

    // Keep the bulk bar + "select all" checkbox in step with the selection.
    function syncSelection(list) {
      const rows = list || getFiltered();
      const n = selectedIds.size;
      $("ct-bulkbar").hidden = n === 0;
      $("ct-bulk-count").textContent = `${n} selected`;
      const all = $("ct-check-all");
      if (all) {
        all.checked = rows.length > 0 && rows.every((c) => selectedIds.has(c.id));
        all.indeterminate = n > 0 && !all.checked;
      }
    }

    async function openDrawer(id) {
      // Reopening the SAME contact is a refresh - adding a note or a tag calls
      // this - so hold the tab you were on. A different contact starts on
      // Information, as it always has.
      const sameContact = !!(current && current.id === id);
      current = ALL.find((c) => c.id === id);
      if (!current) return;
      $("ct-d-name").textContent = fullName(current);
      $("ct-d-email").textContent = current.email;
      $("ct-scrim").hidden = false; $("ct-drawer").hidden = false;
      if (!sameContact) activeTab = "info";  // a new contact opens on Information
      setTab(activeTab);
      $("ct-drawer-body").innerHTML = `<p class="ct-meta">Loading…</p>`;
      const email = current.email;
      // Purchases, bookings + activity are derived live by email, always accurate.
      const [{ data: notes }, { data: tasks }, ord, vidb, smmb, agentProfile, consent] = await Promise.all([
        supabase.from("contact_notes").select("*").eq("contact_id", id).order("created_at", { ascending: false }),
        supabase.from("contact_tasks").select("*").eq("contact_id", id).order("created_at", { ascending: false }),
        supabase.from("orders").select("pack_title, amount_pence, status, created_at").ilike("buyer_email", email).order("created_at", { ascending: false }),
        supabase.from("videography_bookings").select("service, service_type, kind, shoot_date, stage, created_at").ilike("client_email", email).order("created_at", { ascending: false }),
        supabase.from("smm_leads").select("kind, call_at, stage, created_at").ilike("email", email).order("created_at", { ascending: false }),
        fetchAgentProfile(id),
        supabase.from("contact_consent_events").select("action, basis, source, occurred_at").eq("contact_id", id).order("occurred_at", { ascending: false }),
      ]);
      current.agentProfile = agentProfile;
      const orders = (ord && ord.data) || [], vrows = (vidb && vidb.data) || [], srows = (smmb && smmb.data) || [];
      // Empty until supabase/contact_consent_events.sql has been run.
      const crows = (consent && consent.data) || [];
      // Booked = actual sessions + discovery calls (not enquiries/brochures).
      const bookings = [
        ...vrows.filter((b) => b.kind === "booking").map((b) => ({ label: b.service || b.service_type || "Videography session", when: b.shoot_date, stage: b.stage })),
        ...vrows.filter((b) => b.kind === "discovery" || b.service_type === "discovery").map((b) => ({ label: "Videography discovery call", when: b.shoot_date, stage: b.stage })),
        ...srows.filter((b) => b.kind === "discovery").map((b) => ({ label: "Social media discovery call", when: b.call_at, stage: b.stage })),
      ];
      // Activity = every dated action, newest first.
      const VID_ACT = { booking: "Booked a videography session", discovery: "Booked a videography discovery call", brochure: "Downloaded the videography brochure", enquiry: "Made a videography enquiry", register_interest: "Registered interest in the Content Studio" };
      const SMM_ACT = { discovery: "Booked a social media discovery call", brochure: "Downloaded the social media brochure", enquiry: "Made a social media enquiry" };
      // Where a marketing opt-in came from, in plain English.
      const CONSENT_SRC = {
        newsletter_footer: "the newsletter box", join_signup: "the member signup form", contact_form: "the contact form",
        videography: "a videography enquiry", videography_brochure: "the videography brochure form",
        videography_discovery: "a videography discovery call",
        videography_register_interest: "the Content Studio interest form",
        smm_enquiry: "a social media enquiry", smm_brochure: "the social media brochure form",
        smm_discovery: "a social media discovery call",
        csv_import: "a contact import", admin_toggle: "an admin, by hand", merge: "a contact merge",
        footer_link: "the unsubscribe link", list_unsubscribe: "the Gmail/Outlook unsubscribe button",
        spam_complaint: "a spam complaint", resubscribe: "the resubscribe link",
      };
      // A TEG agent was opted in by us, not by an act of consent. The timeline
      // says which, because that difference is the whole point of the record.
      const consentLabel = (e) => {
        const via = CONSENT_SRC[e.source] || e.source;
        if (e.action === "opted_out") return `Unsubscribed from marketing — via ${via}`;
        if (e.source === "teg_auto") return "Opted in to marketing — automatically, as a TEG network member (not an act of consent)";
        if (e.source === "admin_toggle") return "Opted in to marketing — set by an admin by hand (not an act of consent)";
        if (e.source === "backfill") return "Opted in to marketing — recorded before the audit trail existed, original route unknown";
        return `Opted in to marketing — via ${via}`;
      };
      const activity = [
        ...orders.map((o) => ({ when: o.created_at, label: `Purchased ${o.pack_title || "a pack"}` })),
        ...vrows.map((b) => ({ when: b.created_at || b.shoot_date, label: VID_ACT[b.kind] || "Videography activity" })),
        ...srows.map((b) => ({ when: b.created_at || b.call_at, label: SMM_ACT[b.kind] || "Social media activity" })),
        ...crows.map((e) => ({ when: e.occurred_at, label: consentLabel(e) })),
      ].filter((a) => a.when).sort((a, b) => new Date(b.when) - new Date(a.when));
      drawNote(notes || [], tasks || [], orders, bookings, activity);
    }
    function closeDrawer() { $("ct-scrim").hidden = true; $("ct-drawer").hidden = true; current = null; }
    $("ct-close").addEventListener("click", closeDrawer);
    $("ct-scrim").addEventListener("click", closeDrawer);

    // Contact drawer tabs — Information / Purchases / Activity.
    function setTab(tab) {
      activeTab = tab;
      document.querySelectorAll("#ct-tabs .ct-tab").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-tab") === tab));
      document.querySelectorAll("#ct-drawer-body .ct-tabpanel").forEach((p) => { p.hidden = p.getAttribute("data-panel") !== tab; });
    }
    $("ct-tabs").addEventListener("click", (e) => { const b = e.target.closest("[data-tab]"); if (b) setTab(b.getAttribute("data-tab")); });

    // ---- TEG (internal agent) tab -------------------------------------------
    // The Experts Group brands — anyone working within one of these is TEG.
    const TEG_BRANDS = ["The Property Experts", "Prestige Property Experts", "The Lettings Experts", "The Recruitment Experts", "The Marketing Experts", "Fine & Country", "The Mortgage Experts"];
    // Identify a TEG brand from a work email domain. Returns the brand name, ""
    // for a generic *experts.co.uk we can't pin to one brand, or null if not TEG.
    // (New starters often use personal emails — those are caught via the import's
    // Brand column instead.)
    // What to show in the Brand column. The email domain is the reliable
    // signal - a TEG address tells us the brand regardless of what anyone
    // typed into the company field - so it wins, with company as the fallback
    // for everyone outside the group.
    function brandOf(c) {
      return tegBrandFromEmail(c.email) || c.company || "\u2014";
    }

    function tegBrandFromEmail(email) {
      const dom = String(email || "").toLowerCase().split("@")[1] || "";
      if (!dom) return null;
      if (dom === "fineandcountry.com" || dom.endsWith(".fineandcountry.com")) return "Fine & Country";
      if (dom.endsWith("prestigepropertyexperts.co.uk")) return "Prestige Property Experts";
      if (dom.endsWith("thepropertyexperts.co.uk")) return "The Property Experts";
      if (dom.endsWith("thelettingsexperts.co.uk")) return "The Lettings Experts";
      if (dom.endsWith("therecruitmentexperts.co.uk")) return "The Recruitment Experts";
      if (dom.endsWith("themarketingexperts.co.uk")) return "The Marketing Experts";
      if (dom.endsWith("themortgageexperts.co.uk")) return "The Mortgage Experts";
      if (dom.endsWith("experts.co.uk")) return "";
      return null;
    }
    // Read the agent profile through the Worker (domain-aware admin check +
    // service role) rather than the client — avoids the agent_profiles is_admin()
    // RLS denying a @tmke.co.uk admin who isn't in the admins table.
    async function fetchAgentProfile(id) {
      if (!WORKER) return null;
      try {
        const { data } = await supabase.auth.getSession();
        const token = data?.session?.access_token;
        const r = await fetch(`${WORKER}/agent/profile?contact_id=${encodeURIComponent(id)}`, { headers: token ? { Authorization: "Bearer " + token } : {} });
        const j = await r.json().catch(() => ({}));
        return j.profile || null;
      } catch (_) { return null; }
    }
    function tegPanelHtml(p, detect) {
      // Auto-detect from the email domain when there's no saved profile yet, so
      // the TEG card appears for anyone in a TEG brand (incl. Fine & Country).
      const detectedBrand = detect ? detect.brand : null;      // brand name | "" (generic TEG) | null (not TEG)
      const isTegDetected = detectedBrand !== null && detectedBrand !== undefined;
      const isAgent = !!p || isTegDetected;
      const val = (x) => esc(x == null ? "" : x);
      const brandVal = (p && p.brand) || (detectedBrand || "");
      return `
        <div class="ct-sec">
          <label class="ct-toggle"><input type="checkbox" id="teg-is-agent" ${isAgent ? "checked" : ""}/> Internal agent — TEG (The Experts Group)</label>
          ${!p && isTegDetected ? `<p class="ct-teg-detect">Auto-detected as TEG from their email${detectedBrand ? ` (${esc(detectedBrand)})` : ""} — add any details and Save to confirm.</p>` : ""}
          <p class="ct-meta" id="teg-empty" ${isAgent ? "hidden" : ""} style="margin-top:8px">Turn this on to record their agent details and (for new starters) generate their free videography code.</p>
        </div>
        <div id="teg-fields" ${isAgent ? "" : "hidden"}>
          <div class="ct-sec">
            <h3>Agent details</h3>
            <div class="ct-field"><label>Brand</label><input id="teg-brand" list="teg-brand-list" value="${val(brandVal)}" placeholder="Select or type…" /><datalist id="teg-brand-list">${TEG_BRANDS.map((b) => `<option value="${esc(b)}"></option>`).join("")}</datalist></div>
            <div class="ct-field"><label>Date joined</label><input type="date" id="teg-joined" value="${val(p && p.date_joined)}" /></div>
            <div class="ct-field"><label>Postcode</label><input id="teg-postcode" value="${val(p && p.postcode)}" placeholder="e.g. NN14 1AA" /></div>
            <div class="ct-field"><label>Trainer name</label><input id="teg-trainer-name" value="${val((p && p.trainer_name) || "Kelly Bailey")}" /></div>
            <div class="ct-field"><label>Trainer email</label><input id="teg-trainer-email" type="email" value="${val((p && p.trainer_email) || "kelly@theexpertsgroup.co.uk")}" /></div>
          </div>
          <div class="ct-sec">
            <h3>New starter</h3>
            <label class="ct-toggle"><input type="checkbox" id="teg-newstarter" ${p && p.is_new_starter ? "checked" : ""}/> New-starter onboarding (free videography shoot)</label>
            <div id="teg-ns-fields" ${p && p.is_new_starter ? "" : "hidden"} style="margin-top:12px">
              <div class="ct-field"><label>Induction month</label><input type="month" id="teg-month" value="${val(p && p.induction_month)}" /></div>
              <div class="ct-field"><label>Package</label><select id="teg-package"><option value="">—</option><option value="academy" ${p && p.package === "academy" ? "selected" : ""}>Academy</option><option value="pro" ${p && p.package === "pro" ? "selected" : ""}>Pro</option></select></div>
              <div class="ct-field"><label>Free videography code</label><div class="teg-code">${p && p.promo_code ? `<code>${esc(p.promo_code)}</code>` : '<span class="ct-meta">Generated on save — Academy/Pro only</span>'}</div></div>
            </div>
          </div>
          <button type="button" class="ct-mini" id="teg-save">Save agent details</button>
          <p class="ct-teg-msg" id="teg-msg" hidden></p>
        </div>`;
    }
    const tegVal = (id) => { const el = document.getElementById(id); return el ? el.value.trim() : ""; };
    function tegMsg(t, ok) { const m = document.getElementById("teg-msg"); if (!m) return; m.textContent = t; m.className = "ct-teg-msg " + (ok ? "is-ok" : "is-err"); m.hidden = false; }
    function wireTeg() {
      const c = current;
      const isAgentCb = document.getElementById("teg-is-agent");
      if (!isAgentCb) return;
      isAgentCb.addEventListener("change", () => {
        document.getElementById("teg-fields").hidden = !isAgentCb.checked;
        const em = document.getElementById("teg-empty"); if (em) em.hidden = isAgentCb.checked;
      });
      const nsCb = document.getElementById("teg-newstarter");
      nsCb?.addEventListener("change", () => { document.getElementById("teg-ns-fields").hidden = !nsCb.checked; });
      document.getElementById("teg-save")?.addEventListener("click", async () => {
        if (!WORKER) { tegMsg("Connect the Worker to save agent details.", false); return; }
        const btn = document.getElementById("teg-save");
        const body = {
          contact_id: c.id,
          brand: tegVal("teg-brand"),
          date_joined: tegVal("teg-joined") || null,
          postcode: tegVal("teg-postcode"),
          is_new_starter: !!document.getElementById("teg-newstarter")?.checked,
          induction_month: tegVal("teg-month") || null,
          package: tegVal("teg-package") || null,
          trainer_name: tegVal("teg-trainer-name"),
          trainer_email: tegVal("teg-trainer-email"),
        };
        btn.disabled = true; btn.textContent = "Saving…";
        try {
          const { data } = await supabase.auth.getSession();
          const token = data?.session?.access_token;
          const res = await fetch(`${WORKER}/agent/profile`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify(body) });
          const j = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(j.error || "Couldn't save agent details.");
          c.agentProfile = j.profile || null;
          // Flag them TEG on the main list too. The list derives lifecycle from
          // the contact's OWN tags (agent_profiles isn't loaded there), so mark
          // "internal agent" with the Network: TEG tag the derivation recognises.
          if (document.getElementById("teg-is-agent")?.checked && !(c.tags || []).includes("Network: TEG")) {
            c.tags = normalizeTags([...(c.tags || []), "Network: TEG"]);
            try { await supabase.from("contacts").update({ tags: c.tags }).eq("id", c.id); } catch (_) {}
            render();
          }
          document.getElementById("ct-teg-panel").innerHTML = tegPanelHtml(c.agentProfile, { brand: tegBrandFromEmail(c.email) });
          wireTeg();
          tegMsg(c.agentProfile && c.agentProfile.promo_code ? `Saved. Their free code is ${c.agentProfile.promo_code}.` : "Saved.", true);
        } catch (err) { tegMsg(err.message || "Couldn't save agent details.", false); }
        finally { btn.disabled = false; btn.textContent = "Save agent details"; }
      });
    }

    // Other contacts that share this email (the split precaution can create these).
    function sameEmailOthers(c) {
      const e = String(c.email || "").toLowerCase();
      return ALL.filter((x) => x.id !== c.id && String(x.email || "").toLowerCase() === e);
    }
    function dupPanelHtml(c) {
      const others = sameEmailOthers(c);
      if (!others.length && !c.needs_review) return "";
      if (!others.length) {
        return `<div class="ct-dup"><div class="ct-dup-head">⚠ Flagged for review</div>
          <p class="ct-dup-p">Flagged as a possible duplicate, but no other contact with this email is loaded — it may already have been merged.</p>
          <div class="ct-dup-acts"><button class="ct-mini ct-mini-ghost" data-dup-dismiss>Clear flag</button></div></div>`;
      }
      const rows = others.map((o) => `
        <div class="ct-dup-row">
          <div><strong>${esc(fullName(o) || "(no name)")}</strong><div class="ct-item-meta">${esc(o.email)} · last seen ${esc(fmtDate(o.last_seen_at))}</div></div>
          <button class="ct-mini" data-merge="${esc(o.id)}" title="Fold that contact into this one">Merge in</button>
        </div>`).join("");
      return `<div class="ct-dup">
        <div class="ct-dup-head">⚠ Possible duplicate — same email, different name</div>
        <p class="ct-dup-p">If it's the same person, <strong>Merge in</strong> folds their notes, tasks, tags and history onto this card (nothing lost). If they're genuinely different people sharing an inbox, clear the flag.</p>
        ${rows}
        <div class="ct-dup-acts"><button class="ct-mini ct-mini-ghost" data-dup-dismiss>Not duplicates — clear flag</button></div>
      </div>`;
    }

    function drawNote(notes, tasks, orders, bookings, activity) {
      const c = current;
      // Email health — unsubscribes and bounces, written by the unsubscribe
      // page and the Resend webhook. Shown only when something is wrong.
      const UNSUB_SRC = { footer_link: "via the unsubscribe link", list_unsubscribe: "via the Gmail/Outlook unsubscribe button", spam_complaint: "via a spam report", admin: "by an admin", import: "on import" };
      const SUPP_REASON = { hard_bounce: "address bounced permanently", spam_complaint: "reported an email as spam", resend_suppressed: "blocked by the email provider", repeated_soft_bounce: "kept soft-bouncing", admin: "by an admin" };
      const softBounces = Number(c.soft_bounce_count) || 0;
      const lastEv = c.last_email_event && c.last_email_event.event ? c.last_email_event : null;
      const emailHealth = [
        c.unsubscribed_at ? `Unsubscribed ${fmtDate(c.unsubscribed_at)} ${UNSUB_SRC[c.unsubscribe_source] || ""}`.trim() : null,
        c.suppressed_at ? `Suppressed ${fmtDate(c.suppressed_at)} — ${SUPP_REASON[c.suppression_reason] || c.suppression_reason || "undeliverable"}. No email will be sent to this address.` : null,
        !c.suppressed_at && softBounces ? `${softBounces} recent soft bounce${softBounces === 1 ? "" : "s"} — clears itself on the next successful delivery.` : null,
        lastEv ? `Last email event: ${lastEv.event}${lastEv.subject ? ` — “${lastEv.subject}”` : ""}${lastEv.at ? ` · ${fmtDate(lastEv.at)}` : ""}` : null,
      ].filter(Boolean);
      $("ct-drawer-body").innerHTML = `
        <div class="ct-tabpanel" data-panel="info"${activeTab !== "info" ? " hidden" : ""}>
          ${dupPanelHtml(c)}
          <div class="ct-twocol">
          <div class="ct-col">
          <div class="ct-sec">
            <h3>Status</h3>
            <div class="ct-badges">
              <span class="ct-badge ${c.user_id ? "is-on" : ""}">${c.user_id ? "Member — Has account" : "No account"}</span>
              <span class="ct-badge ${c.marketing_opt_in ? "is-on" : ""}">Marketing: ${c.marketing_opt_in ? "Yes" : "No"}</span>
              ${c.unsubscribed_at ? '<span class="ct-badge is-bad">Unsubscribed</span>' : ""}
              ${c.suppressed_at ? '<span class="ct-badge is-bad">Suppressed</span>' : ""}
              ${!c.suppressed_at && softBounces ? '<span class="ct-badge is-warn">Bouncing</span>' : ""}
            </div>
            ${emailHealth.length ? `<div class="ct-emailhealth">${emailHealth.map((l) => `<p>${esc(l)}</p>`).join("")}</div>` : ""}
            ${c.user_id ? "" : `
            <div class="ct-acct" id="ct-acct">
              <p class="ct-meta" style="margin:12px 0 8px">Not linked to a member account yet.</p>
              <button class="ct-mini" id="ct-acct-check">Check for a member account</button>
            </div>`}
          </div>
          <div class="ct-sec">
            <h3>Details</h3>
            <dl class="ct-dl">
              <div><dt>Email</dt><dd>${esc(c.email || "—")}</dd></div>
              ${c.agentProfile && c.agentProfile.postcode ? `<div><dt>Postcode</dt><dd>${esc(c.agentProfile.postcode)}</dd></div>` : ""}
              <div><dt>Source</dt><dd>${esc(humanizeSource(c.source))}</dd></div>
            </dl>
            <!-- Editable details — some contacts arrive email-only (e.g. the
                 newsletter form), so anything learned later is filled in here.
                 Each field saves itself when you click/tab away. -->
            <div class="ct-add-grid" style="margin-top:12px">
              <div class="ct-field"><label>First name</label><input id="ct-d-first" value="${esc(c.first_name || "")}" placeholder="—" /></div>
              <div class="ct-field"><label>Last name</label><input id="ct-d-last" value="${esc(c.last_name || "")}" placeholder="—" /></div>
            </div>
            <div class="ct-add-grid">
              <div class="ct-field"><label>Phone</label><input id="ct-d-phone" type="tel" value="${esc(c.phone || "")}" placeholder="—" /></div>
              <div class="ct-field"><label>Company</label><input id="ct-d-company" value="${esc(c.company || "")}" placeholder="—" /></div>
            </div>
            <div class="ct-row" style="margin-top:14px">
              <select id="ct-life-sel">${LIFECYCLES.map(([v, label]) => `<option value="${v}" ${c.lifecycle === v ? "selected" : ""}>${label}</option>`).join("")}</select>
              <label class="ct-toggle"><input type="checkbox" id="ct-dnd" ${c.dnd ? "checked" : ""}/> Do-not-contact</label>
            </div>
            <div class="ct-row" style="margin-top:10px">
              <label class="ct-toggle"><input type="checkbox" id="ct-mkt" ${c.marketing_opt_in ? "checked" : ""}/> Marketing opt-in</label>
            </div>
            <div class="ct-row" style="margin-top:12px; align-items:center">
              <label class="ct-meta" for="ct-sec-email" style="flex:0 0 auto; margin:0">Secondary email</label>
              <input id="ct-sec-email" type="email" placeholder="e.g. personal address (optional)" value="${esc(c.secondary_email || "")}" />
            </div>
            <p class="ct-meta" style="margin:6px 0 0">Extra delivery address for funnel emails only — they also go to ${esc(c.email || "their email above")}. Handy for a new starter who can't read their work inbox yet. Never used for marketing: that always uses the email above.</p>
          </div>
          </div>
          <div class="ct-col">
          <div class="ct-sec">
            <h3>Tags</h3>
            <div class="ct-chips" id="ct-tags">${(c.tags || []).map((t) => `<span class="ct-chip">${esc(t)}<button data-untag="${esc(t)}" title="Remove">&times;</button></span>`).join("") || '<span class="ct-meta">No tags</span>'}</div>
            <div class="ct-row" style="margin-top:12px">
              <select id="ct-tag-input"><option value="">Add a tag…</option>${TAG_GROUPS.map(([g, tags]) => `<optgroup label="${esc(g)}">${tags.map((t) => `<option value="${esc(t)}">${esc(t)}</option>`).join("")}</optgroup>`).join("")}</select>
              <button class="ct-mini" id="ct-tag-add">Add</button>
            </div>
          </div>
          <!-- Notes again, in the space the wider drawer bought. Same records as
               the Notes tab - written and read here so you don't have to leave
               the contact's details to jot down what was just said. -->
          <div class="ct-sec">
            <h3>Notes</h3>
            <div id="ct-inotes" class="ct-notelist">${notes.length ? notes.map((n) => `<div class="ct-item">${esc(n.body)}<div class="ct-item-meta">${esc(n.author || "")} · ${fmtDate(n.created_at)}</div></div>`).join("") : '<p class="ct-meta">No notes</p>'}</div>
            <div class="ct-row" style="margin-top:10px"><textarea id="ct-inote-input" class="ct-notebox" rows="5" placeholder="Add a note"></textarea></div>
            <button class="ct-mini" id="ct-inote-add" style="margin-top:8px">Add note</button>
          </div>
          <!-- Activity, mirrored from its own tab. Twelve is as far back as is
               useful at a glance; the tab has the lot. -->
          <div class="ct-sec">
            <h3>Activity</h3>
            <div class="ct-timeline">${activity && activity.length ? activity.slice(0, 12).map((a) => `<div class="ct-tl-item"><span class="ct-tl-dot"></span><div class="ct-tl-body"><div>${esc(a.label)}</div><div class="ct-item-meta">${fmtDate(a.when)}</div></div></div>`).join("") : '<p class="ct-meta">No activity yet</p>'}</div>
          </div>
          </div>
          </div>
        </div>
        <div class="ct-tabpanel" data-panel="teg"${activeTab !== "teg" ? " hidden" : ""}>
          <div id="ct-teg-panel">${tegPanelHtml(c.agentProfile, { brand: tegBrandFromEmail(c.email) })}</div>
        </div>
        <div class="ct-tabpanel" data-panel="purchases"${activeTab !== "purchases" ? " hidden" : ""}>
          <div class="ct-sec">
            <h3>Purchased</h3>
            ${orders.length ? orders.map((o) => `<div class="ct-item">${esc(o.pack_title || "Pack")}<div class="ct-item-meta">${gbp(o.amount_pence)}${o.status && o.status !== "paid" ? " · " + esc(o.status) : ""} · ${fmtDate(o.created_at)}</div></div>`).join("") : '<p class="ct-meta">No purchases</p>'}
          </div>
        </div>
        <div class="ct-tabpanel" data-panel="booked"${activeTab !== "booked" ? " hidden" : ""}>
          <div class="ct-sec">
            <h3>Booked</h3>
            ${bookings.length ? bookings.map((b) => `<div class="ct-item">${esc(b.label)}<div class="ct-item-meta">${b.when ? fmtDate(b.when) : "—"}${b.stage ? " · " + esc(b.stage) : ""}</div></div>`).join("") : '<p class="ct-meta">No bookings</p>'}
          </div>
        </div>
        <div class="ct-tabpanel" data-panel="activity"${activeTab !== "activity" ? " hidden" : ""}>
          <div class="ct-sec">
            <h3>Activity</h3>
            <dl class="ct-dl" style="margin-bottom:16px">
              <div><dt>First interaction</dt><dd>${fmtDate(c.created_at)}</dd></div>
              ${c.user_id ? `<div><dt>Last hub login</dt><dd id="ct-lastlogin">…</dd></div>` : ""}
            </dl>
            <div class="ct-timeline">${activity && activity.length ? activity.map((a) => `<div class="ct-tl-item"><span class="ct-tl-dot"></span><div class="ct-tl-body"><div>${esc(a.label)}</div><div class="ct-item-meta">${fmtDate(a.when)}</div></div></div>`).join("") : '<p class="ct-meta">No activity yet</p>'}</div>
          </div>
        </div>
        <div class="ct-tabpanel" data-panel="notes"${activeTab !== "notes" ? " hidden" : ""}>
          <div class="ct-sec">
            <h3>Tasks</h3>
            <div id="ct-tasks">${tasks.length ? tasks.map((t) => `
              <div class="ct-item ct-task ${t.status === "done" ? "done" : ""}">
                <div>${esc(t.title)}<div class="ct-item-meta">${t.due_at ? "Due " + fmtDate(t.due_at) : ""}</div></div>
                ${t.status === "done" ? "✓" : `<button class="ct-mini" data-done="${esc(t.id)}">Complete</button>`}
              </div>`).join("") : '<p class="ct-meta">No tasks</p>'}</div>
            <div class="ct-row" style="margin-top:10px"><input id="ct-task-input" placeholder="New task (e.g. Send LinkedIn message)" /><button class="ct-mini" id="ct-task-add">Add</button></div>
          </div>
          <div class="ct-sec">
            <h3>Notes</h3>
            <div id="ct-notes">${notes.length ? notes.map((n) => `<div class="ct-item">${esc(n.body)}<div class="ct-item-meta">${esc(n.author || "")} · ${fmtDate(n.created_at)}</div></div>`).join("") : '<p class="ct-meta">No notes</p>'}</div>
            <div class="ct-row" style="margin-top:10px"><textarea id="ct-note-input" rows="2" placeholder="Add a note"></textarea></div>
            <button class="ct-mini" id="ct-note-add" style="margin-top:8px">Add note</button>
          </div>
        </div>`;
      wireDrawer(notes, tasks);
      if (c.user_id) loadLastLogin(c);
    }

    // Members only — the last time they signed into the hub (auth.users via the
    // Worker, service-role). Fills the placeholder in the Activity tab.
    async function loadLastLogin(c) {
      const el = document.getElementById("ct-lastlogin");
      if (!el || !WORKER) return;
      try {
        const { data } = await supabase.auth.getSession();
        const token = data?.session?.access_token;
        const res = await fetch(`${WORKER}/contacts/member-login?user_id=${encodeURIComponent(c.user_id)}`, {
          headers: token ? { Authorization: "Bearer " + token } : {},
        });
        const j = await res.json().catch(() => ({}));
        if (current !== c) return;   // drawer moved on to another contact
        el.textContent = j.last_sign_in_at ? fmtDate(j.last_sign_in_at) : "Never logged in";
      } catch (_) { if (current === c) el.textContent = "—"; }
    }

    // Member-account linking — POST to the Worker with the admin's token.
    async function acctApi(path, body) {
      const { data } = await supabase.auth.getSession();
      const token = data?.session?.access_token;
      const res = await fetch(`${WORKER}${path}`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: token ? "Bearer " + token : "" },
        body: JSON.stringify(body),
      });
      return res.json().catch(() => ({}));
    }

    // "Check for a member account": looks up an auth user for this email. On a
    // name-matched hit it links the card (→ reload as a member); on a name
    // mismatch it offers "Link anyway"; on no account it offers an invite.
    async function checkAccount(c, force) {
      if (!WORKER) return;
      const box = document.getElementById("ct-acct"); if (!box) return;
      box.innerHTML = `<p class="ct-meta" style="margin:12px 0">Checking…</p>`;
      const r = await acctApi("/contacts/link", { contact_id: c.id, force: !!force });
      if (r.ok && r.linked) { await load(); openDrawer(c.id); return; }
      if (r.nameMismatch) {
        box.innerHTML = `
          <p class="ct-meta" style="margin:12px 0 8px">An account exists for <b>${esc(r.email)}</b>, but its name (<b>${esc(r.account_name || "unknown")}</b>) doesn't match this contact (<b>${esc(r.card_name || "")}</b>). Link them anyway?</p>
          <button class="ct-mini" id="ct-acct-force">Link anyway</button>
          <button class="ct-mini" id="ct-acct-cancel">Cancel</button>`;
        document.getElementById("ct-acct-force").addEventListener("click", () => checkAccount(c, true));
        document.getElementById("ct-acct-cancel").addEventListener("click", () => openDrawer(c.id));
        return;
      }
      if (r.noAccount) {
        box.innerHTML = `
          <p class="ct-meta" style="margin:12px 0 8px">No member account found for <b>${esc(c.email)}</b>.</p>
          <button class="ct-mini" id="ct-acct-invite">Invite them to create an account</button>`;
        document.getElementById("ct-acct-invite").addEventListener("click", () => inviteAccount(c));
        return;
      }
      box.innerHTML = `<p class="ct-meta" style="margin:12px 0 8px">${esc(r.error || "Couldn't check right now.")}</p><button class="ct-mini" id="ct-acct-retry">Try again</button>`;
      document.getElementById("ct-acct-retry").addEventListener("click", () => checkAccount(c));
    }

    // Send the branded "create your account" invite (links to the join page).
    async function inviteAccount(c) {
      const btn = document.getElementById("ct-acct-invite");
      if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
      const r = await acctApi("/contacts/invite", { contact_id: c.id });
      const box = document.getElementById("ct-acct"); if (!box) return;
      if (r.ok && r.invited) { box.innerHTML = `<p class="ct-meta" style="margin:12px 0;color:#2f7a3f">✓ Invitation sent to ${esc(r.invited)}.</p>`; return; }
      if (r.alreadyHasAccount) { box.innerHTML = `<p class="ct-meta" style="margin:12px 0 8px">They already have an account — linking it now…</p>`; checkAccount(c); return; }
      box.innerHTML = `<p class="ct-meta" style="margin:12px 0 8px">${esc(r.error || "Couldn't send the invite.")}</p><button class="ct-mini" id="ct-acct-invite">Try again</button>`;
      document.getElementById("ct-acct-invite").addEventListener("click", () => inviteAccount(c));
    }

    function wireDrawer(notes, tasks) {
      const c = current;
      wireTeg();
      const acctChk = document.getElementById("ct-acct-check");
      if (acctChk) acctChk.addEventListener("click", () => checkAccount(c));
      // Possible-duplicate review: merge a sibling in, or clear the flag.
      $("ct-drawer-body").querySelectorAll("[data-merge]").forEach((b) => b.addEventListener("click", async () => {
        const dropId = b.getAttribute("data-merge");
        const other = ALL.find((x) => x.id === dropId);
        if (!confirm(`Merge "${fullName(other) || "that contact"}" into "${fullName(c) || "this contact"}"?\n\nTheir notes, tasks, tags and history move onto this card, and the other card is removed. This can't be undone.`)) return;
        b.disabled = true; b.textContent = "Merging…";
        const { error } = await supabase.rpc("merge_contacts", { p_keep: c.id, p_drop: dropId });
        if (error) { alert("Couldn't merge: " + error.message); b.disabled = false; b.textContent = "Merge in"; return; }
        await load(); openDrawer(c.id);
      }));
      const dismissBtn = $("ct-drawer-body").querySelector("[data-dup-dismiss]");
      if (dismissBtn) dismissBtn.addEventListener("click", async () => {
        const em = String(c.email || "").toLowerCase();
        await supabase.from("contacts").update({ needs_review: false, review_reason: null }).ilike("email", em);
        await load(); openDrawer(c.id);
      });
      $("ct-life-sel").addEventListener("change", async (e) => {
        c.lifecycle = e.target.value;
        await supabase.from("contacts").update({ lifecycle: c.lifecycle }).eq("id", c.id);
        fire("contact_changed", c, { field: "lifecycle", value: c.lifecycle }); render();
      });
      // Editable details — save on change, refresh the header + board so a
      // newly named contact stops showing as "—" everywhere.
      [["ct-d-first", "first_name"], ["ct-d-last", "last_name"], ["ct-d-phone", "phone"], ["ct-d-company", "company"]].forEach(([id, col]) => {
        $(id)?.addEventListener("change", async (e) => {
          const v = e.target.value.trim() || null;
          c[col] = v;
          const { error } = await supabase.from("contacts").update({ [col]: v }).eq("id", c.id);
          if (error) { alert("Couldn't save that: " + error.message); return; }
          $("ct-d-name").textContent = fullName(c);
          render();
        });
      });
      // Secondary email — a delivery address for funnel email, not an identity.
      $("ct-sec-email")?.addEventListener("change", async (e) => {
        const v = (e.target.value || "").trim().toLowerCase();
        if (v && !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(v)) { e.target.setCustomValidity("That doesn't look like an email address."); e.target.reportValidity(); return; }
        e.target.setCustomValidity("");
        c.secondary_email = v || null;
        const { error } = await supabase.from("contacts").update({ secondary_email: c.secondary_email }).eq("id", c.id);
        if (error) alert(/column .*secondary_email/i.test(error.message || "")
          ? "This needs a quick database step: run supabase/contact_secondary_email.sql in the Supabase SQL editor."
          : "Couldn't save that: " + error.message);
      });
      $("ct-dnd").addEventListener("change", async (e) => {
        c.dnd = e.target.checked;
        await supabase.from("contacts").update({ dnd: c.dnd }).eq("id", c.id);
        if (c.dnd) fire("dnd_set", c, {}); render();
      });
      // Marketing opt-in — editable here (e.g. flip a TEG agent to Yes). Keeps the
      // consent tags in step: Yes → Newsletter-Subscriber, No → Marketing-Not-Opted-In.
      $("ct-mkt").addEventListener("change", async (e) => {
        c.marketing_opt_in = e.target.checked;
        const base = (c.tags || []).filter((t) => t !== "Newsletter-Subscriber" && t !== "Marketing-Not-Opted-In");
        c.tags = normalizeTags([...base, c.marketing_opt_in ? "Newsletter-Subscriber" : "Marketing-Not-Opted-In"]);
        await supabase.from("contacts").update({ marketing_opt_in: c.marketing_opt_in, tags: c.tags }).eq("id", c.id);
        // The only place a human sets consent by hand, so the trail records who.
        // Best-effort: never block the toggle on the audit write.
        try {
          const who = (await supabase.auth.getUser())?.data?.user?.email || "Admin";
          await supabase.from("contact_consent_events").insert({
            contact_id: c.id, email: (c.email || "").toLowerCase(),
            action: c.marketing_opt_in ? "opted_in" : "opted_out",
            basis: c.marketing_opt_in ? "legitimate_interest" : "withdrawn",
            source: "admin_toggle",
            detail: c.marketing_opt_in
              ? "Set to Yes by an admin in the contact card, not by an act of consent by the contact."
              : "Set to No by an admin in the contact card.",
            actor: who,
          });
        } catch (_) {}
        fire("contact_changed", c, { field: "marketing_opt_in", value: c.marketing_opt_in }); render();
      });
      $("ct-tag-add").addEventListener("click", async () => {
        const v = ($("ct-tag-input").value || "").trim(); if (!v) return;
        c.tags = normalizeTags([...(c.tags || []), v]);
        await supabase.from("contacts").update({ tags: c.tags }).eq("id", c.id);
        fire("tag_added", c, { tag: v }); openDrawer(c.id);
      });
      $("ct-tags").querySelectorAll("[data-untag]").forEach((b) => b.addEventListener("click", async () => {
        const v = b.getAttribute("data-untag");
        c.tags = normalizeTags((c.tags || []).filter((t) => t !== v));
        await supabase.from("contacts").update({ tags: c.tags }).eq("id", c.id);
        fire("tag_removed", c, { tag: v }); openDrawer(c.id);
      }));
      $("ct-task-add").addEventListener("click", async () => {
        const v = ($("ct-task-input").value || "").trim(); if (!v) return;
        await supabase.from("contact_tasks").insert({ contact_id: c.id, title: v });
        openDrawer(c.id);
      });
      $("ct-tasks").querySelectorAll("[data-done]").forEach((b) => b.addEventListener("click", async () => {
        const id = b.getAttribute("data-done");
        await supabase.from("contact_tasks").update({ status: "done", completed_at: new Date().toISOString() }).eq("id", id);
        const t = tasks.find((x) => x.id === id);
        fire("task_completed", c, { task: t ? t.title : "" }); openDrawer(c.id);
      }));
      async function addNote(inputId, btnId) {
        const input = document.getElementById(inputId); if (!input) return;
        const v = (input.value || "").trim(); if (!v) return;
        const btn = document.getElementById(btnId);
        if (btn) { btn.disabled = true; btn.textContent = "Saving…"; }
        const { error } = await supabase.from("contact_notes").insert({ contact_id: c.id, body: v, author: "Admin" });
        if (error) {
          if (btn) { btn.disabled = false; btn.textContent = "Add note"; }
          alert("Couldn't save that note: " + error.message);
          return;
        }
        fire("note_added", c, {});
        openDrawer(c.id);
      }
      $("ct-inote-add")?.addEventListener("click", () => addNote("ct-inote-input", "ct-inote-add"));
      $("ct-note-add").addEventListener("click", async () => {
        await addNote("ct-note-input", "ct-note-add");
      });
    }

    // .ash-content is position:relative with z-index:2, which makes it a
    // stacking context the drawer cannot climb out of - the frosted top bar
    // composited straight over its header however high z-index went. Moving
    // both to <body> puts them in the root context where z-index means what it
    // says. Done in script because the markup has to live inside the page's
    // <AdminShell> slot.
    document.body.append($("ct-scrim"), $("ct-drawer"));

    $("ct-search").addEventListener("input", (e) => { q = e.target.value.toLowerCase().trim(); refilter(); });

    $("ct-prev").addEventListener("click", () => { if (page > 1) { page--; render(); scrollListTop(); } });
    $("ct-next").addEventListener("click", () => { page++; render(); scrollListTop(); });
    $("ct-per").addEventListener("change", (e) => { perPage = Number(e.target.value) || 0; page = 1; render(); });
    // Paging without this leaves you halfway down the next page.
    function scrollListTop() {
      document.querySelector(".ash-content")?.scrollTo({ top: 0, behavior: "smooth" });
    }

    // The search is an icon until you ask for it. Closing clears the term as
    // well as the box - a collapsed search that is still filtering would look
    // like the list had simply lost people.
    (function wireSearch() {
      const wrap = $("ct-search-wrap"), btn = $("ct-search-btn"), input = $("ct-search");
      function setOpen(open) {
        wrap.classList.toggle("is-open", open);
        btn.setAttribute("aria-expanded", open ? "true" : "false");
        if (open) { input.focus(); return; }
        if (q) { input.value = ""; q = ""; refilter(); }
      }
      btn.addEventListener("click", () => setOpen(!wrap.classList.contains("is-open")));
      input.addEventListener("keydown", (e) => { if (e.key === "Escape") setOpen(false); });
      // Clicking away tidies it up again, but only while it is empty.
      document.addEventListener("click", (e) => {
        if (!wrap.contains(e.target) && wrap.classList.contains("is-open") && !input.value) setOpen(false);
      });
    })();
    $("ct-chips").addEventListener("click", (e) => {
      const b = e.target.closest("[data-seg]"); if (!b) return;
      seg = b.getAttribute("data-seg");
      $("ct-chips").querySelectorAll("[data-seg]").forEach((x) => x.classList.toggle("is-active", x === b));
      refilter();
    });

    // ---- Tag filter (multi-select dropdown; matches any selected tag) ----
    function syncTagPill() {
      const n = selectedTags.size, nb = $("ct-tagfilter-n");
      nb.hidden = n === 0; nb.textContent = n;
      $("ct-tagfilter-btn").classList.toggle("is-on", n > 0);
    }
    function buildTagMenu() {
      const menu = $("ct-tagfilter-menu");
      // Show the full tag taxonomy (grouped, like the add-tag menu) so every tag
      // is visible to pick from — plus any tags in use that aren't in the framework.
      const inUse = Array.from(new Set(ALL.flatMap((c) => c.tags || [])));
      const framework = new Set(TAG_GROUPS.flatMap(([, tags]) => tags));
      const extra = inUse.filter((t) => !framework.has(t)).sort((a, b) => a.localeCompare(b));
      const groups = extra.length ? [...TAG_GROUPS, ["Other", extra]] : TAG_GROUPS;
      const opt = (t) => `<label class="ct-tagfilter-opt"><input type="checkbox" value="${esc(t)}" ${selectedTags.has(t) ? "checked" : ""}/> ${esc(t)}</label>`;
      menu.innerHTML = groups.map(([g, tags]) => `<div class="ct-tagfilter-group"><div class="ct-tagfilter-group-h">${esc(g)}</div>${tags.map(opt).join("")}</div>`).join("")
        + `<div class="ct-tagfilter-foot"><button type="button" class="ct-tagfilter-clear" id="ct-tagfilter-clear">Clear tags</button></div>`;
      menu.querySelectorAll('input[type="checkbox"]').forEach((cb) => cb.addEventListener("change", () => {
        if (cb.checked) selectedTags.add(cb.value); else selectedTags.delete(cb.value);
        syncTagPill(); refilter();
      }));
      const clr = document.getElementById("ct-tagfilter-clear");
      if (clr) clr.addEventListener("click", () => { selectedTags.clear(); buildTagMenu(); syncTagPill(); refilter(); });
    }
    // Position the fixed menu just below the button, capped to the viewport so
    // it's always fully visible and scrolls inside itself.
    function positionTagMenu() {
      const menu = $("ct-tagfilter-menu"), r = $("ct-tagfilter-btn").getBoundingClientRect();
      const vh = window.innerHeight || document.documentElement.clientHeight || 800;
      // The button now sits at the right-hand end of the bar, so hang the menu
      // from its right edge - anchoring the left edge runs it off the screen.
      const vw = window.innerWidth || document.documentElement.clientWidth || 1280;
      menu.style.left = Math.round(Math.max(12, Math.min(r.right - menu.offsetWidth, vw - menu.offsetWidth - 12))) + "px";
      menu.style.top = Math.round(r.bottom + 8) + "px";
      menu.style.maxHeight = Math.min(360, Math.max(180, vh - r.bottom - 24)) + "px";
    }
    $("ct-tagfilter-btn").addEventListener("click", (e) => {
      e.stopPropagation();
      const menu = $("ct-tagfilter-menu"), willOpen = menu.hidden;
      if (willOpen) { buildTagMenu(); menu.hidden = false; positionTagMenu(); }
      else menu.hidden = true;
      $("ct-tagfilter-btn").setAttribute("aria-expanded", String(willOpen));
    });
    document.addEventListener("click", (e) => {
      if (!e.target.closest("#ct-tagfilter")) { $("ct-tagfilter-menu").hidden = true; $("ct-tagfilter-btn").setAttribute("aria-expanded", "false"); }
    });
    // Keep it aligned to the button if the page scrolls or the window resizes.
    const repositionIfOpen = () => { if (!$("ct-tagfilter-menu").hidden) positionTagMenu(); };
    window.addEventListener("resize", repositionIfOpen);
    document.querySelector(".ash-content")?.addEventListener("scroll", repositionIfOpen, { passive: true });

    // ---- Bulk select + delete ----
    // Selects the page in front of you, not all 125 - ticking a header box and
    // silently arming a delete over records you have never seen is the kind of
    // thing that only goes wrong once.
    $("ct-check-all").addEventListener("change", (e) => {
      const on = e.target.checked, rows = pageRows;
      rows.forEach((c) => { if (on) selectedIds.add(c.id); else selectedIds.delete(c.id); });
      $("ct-rows").querySelectorAll(".ct-row-check").forEach((cb) => { cb.checked = on; });
      syncSelection(rows);
    });
    $("ct-bulk-clear").addEventListener("click", () => {
      selectedIds.clear();
      $("ct-rows").querySelectorAll(".ct-row-check").forEach((cb) => { cb.checked = false; });
      syncSelection();
    });
    $("ct-bulk-del").addEventListener("click", async () => {
      const ids = Array.from(selectedIds);
      if (!ids.length) return;
      if (!confirm(`Delete ${ids.length} contact${ids.length === 1 ? "" : "s"}? This can't be undone.`)) return;
      const btn = $("ct-bulk-del"); btn.disabled = true; btn.textContent = "Deleting…";
      const { error } = await supabase.from("contacts").delete().in("id", ids);
      btn.disabled = false; btn.textContent = "Delete selected";
      if (error) { alert("Couldn't delete those contacts: " + error.message); return; }
      ALL = ALL.filter((c) => !selectedIds.has(c.id));
      selectedIds.clear();
      render();
    });

    // ---- Export the current (filtered) list as CSV ----
    const csvCell = (v) => { const s = String(v ?? ""); return /[",\n\r]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s; };
    function exportCsv() {
      const rows = getFiltered();
      const iso = (d) => { try { return d ? new Date(d).toISOString().slice(0, 10) : ""; } catch (_) { return ""; } };
      // One column per tag present (Yes / blank), so tags can be filtered in a spreadsheet.
      const allTags = Array.from(new Set(rows.flatMap((c) => c.tags || []))).sort();
      const base = ["First name", "Last name", "Email", "Phone", "Company", "Lifecycle", "Member", "Marketing opt-in", "Do-not-contact", "Source", "Created", "Last seen"];
      const cols = base.concat(allTags);
      const lines = [cols.map(csvCell).join(",")];
      rows.forEach((c) => {
        const row = [
          c.first_name || "", c.last_name || "", c.email || "", c.phone || "", c.company || "",
          lifecycleLabel(deriveLifecycle(c)), c.user_id ? "Yes" : "No", c.marketing_opt_in ? "Yes" : "No", c.dnd ? "Yes" : "No",
          humanizeSource(c.source), iso(c.created_at), iso(c.last_seen_at),
        ];
        allTags.forEach((t) => row.push((c.tags || []).includes(t) ? "Yes" : ""));
        lines.push(row.map(csvCell).join(","));
      });
      const blob = new Blob(["﻿" + lines.join("\r\n")], { type: "text/csv;charset=utf-8;" });
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = `tmke-contacts-${iso(Date.now())}.csv`;
      document.body.appendChild(a); a.click(); a.remove(); URL.revokeObjectURL(url);
    }
    $("ct-export").addEventListener("click", exportCsv);

    // ---- Import CSV ----
    const IMPORT_FIELDS = [
      { key: "email", label: "Email", required: true, match: ["email", "e-mail", "email address"] },
      { key: "first_name", label: "First name", match: ["first name", "firstname", "first", "forename"] },
      { key: "last_name", label: "Last name", match: ["last name", "lastname", "last", "surname"] },
      { key: "name", label: "Full name (if not split)", match: ["name", "full name", "contact name"] },
      { key: "phone", label: "Phone", match: ["phone", "mobile", "telephone", "tel"] },
      { key: "company", label: "Company / Brand", match: ["company", "business", "brand", "organisation", "organization", "agency"] },
      { key: "postcode", label: "Postcode", match: ["postcode", "post code", "postal code", "zip"] },
      { key: "date_joined", label: "Date joined", match: ["date joined", "join date", "joined", "start date", "induction date", "date_joined"] },
      { key: "type", label: "Type (→ a tag, e.g. Estate Agent)", match: ["tag type", "tag-type", "tagtype", "type", "role", "category"] },
      { key: "tags", label: "Tags (; or , separated)", match: ["tags", "tag"] },
    ];
    let importHeaders = [], importData = [];
    function parseCSV(text) {
      const rows = []; let row = [], field = "", inQ = false;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i], nx = text[i + 1];
        if (inQ) { if (ch === '"' && nx === '"') { field += '"'; i++; } else if (ch === '"') inQ = false; else field += ch; }
        else if (ch === '"') inQ = true;
        else if (ch === ",") { row.push(field); field = ""; }
        else if (ch === "\r") { /* skip */ }
        else if (ch === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
        else field += ch;
      }
      if (field !== "" || row.length) { row.push(field); rows.push(row); }
      return rows.filter((r) => r.some((c) => String(c).trim() !== ""));
    }
    $("ct-import-tag").innerHTML = `<option value="">Add a tag…</option>` + TAG_GROUPS.map(([g, tags]) => `<optgroup label="${esc(g)}">${tags.map((t) => `<option value="${esc(t)}">${esc(t)}</option>`).join("")}</optgroup>`).join("");
    // Batch tags — pick as many as you like; each becomes a removable chip.
    let importBatchTags = [];
    function renderImportTags() {
      const box = $("ct-import-tags");
      box.innerHTML = importBatchTags.length
        ? importBatchTags.map((t) => `<span class="ct-chip">${esc(t)}<button data-untag="${esc(t)}" title="Remove">&times;</button></span>`).join("")
        : '<span class="ct-meta">No tags yet — add as many as you like.</span>';
      box.querySelectorAll("[data-untag]").forEach((b) => b.addEventListener("click", () => {
        importBatchTags = importBatchTags.filter((t) => t !== b.getAttribute("data-untag")); renderImportTags();
      }));
    }
    $("ct-import-tag").addEventListener("change", (e) => {
      const v = e.target.value; e.target.value = "";
      if (v && !importBatchTags.includes(v)) { importBatchTags.push(v); renderImportTags(); }
    });
    renderImportTags();
    // ---- Add a single contact (reuses the /contacts/import path) ----
    function closeAdd() { $("ct-add").hidden = true; }
    function addMsg(t, ok) { const m = $("ct-add-msg"); m.textContent = t; m.className = "ct-teg-msg " + (ok ? "is-ok" : "is-err"); m.hidden = false; }
    $("ct-add-btn").addEventListener("click", () => { $("ct-add-msg").hidden = true; $("ct-add-form").reset(); $("ct-add").hidden = false; setTimeout(() => $("ct-add-form").first_name.focus(), 30); });
    $("ct-add-close").addEventListener("click", closeAdd);
    $("ct-add-cancel").addEventListener("click", closeAdd);
    $("ct-add").addEventListener("click", (e) => { if (e.target === $("ct-add")) closeAdd(); });
    $("ct-add-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target;
      const email = f.email.value.trim();
      if (!email) { addMsg("Enter an email address.", false); return; }
      if (!WORKER) { addMsg("The contacts backend isn't connected.", false); return; }
      const row = { email, first_name: f.first_name.value.trim() || null, last_name: f.last_name.value.trim() || null, phone: f.phone.value.trim() || null, company: f.company.value.trim() || null };
      const btn = $("ct-add-save"); btn.disabled = true; btn.textContent = "Adding…";
      try {
        const { data: { session } } = await supabase.auth.getSession();
        const token = session && session.access_token;
        const res = await fetch(`${WORKER}/contacts/import`, { method: "POST", headers: { "Content-Type": "application/json", Authorization: token ? "Bearer " + token : "" }, body: JSON.stringify({ rows: [row], batch_tags: [], marketing_opt_in: f.optin.checked, source: "manual" }) });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || "Couldn't add the contact.");
        if (!d.imported) throw new Error("That email address looks invalid.");
        closeAdd();
        await load();
        const created = ALL.find((c) => (c.email || "").toLowerCase() === email.toLowerCase());
        if (created) openDrawer(created.id);
      } catch (err) { addMsg(err.message || "Couldn't add the contact.", false); }
      finally { btn.disabled = false; btn.textContent = "Add contact"; }
    });

    $("ct-import-btn").addEventListener("click", () => { $("ct-import").hidden = false; });
    $("ct-import-close").addEventListener("click", () => { $("ct-import").hidden = true; });
    $("ct-import").addEventListener("click", (e) => { if (e.target === $("ct-import")) $("ct-import").hidden = true; });
    $("ct-import-input").addEventListener("change", async (e) => {
      const file = e.target.files[0]; if (!file) return;
      const rows = parseCSV(await file.text());
      const prev = $("ct-import-preview");
      if (rows.length < 2) { $("ct-import-map").hidden = true; prev.hidden = false; prev.textContent = "That file has no data rows."; return; }
      importHeaders = rows[0].map((h) => String(h).trim());
      importData = rows.slice(1);
      const norm = (s) => String(s).toLowerCase().trim();
      const opts = (sel) => `<option value="">— skip —</option>` + importHeaders.map((h, i) => `<option value="${i}" ${sel === i ? "selected" : ""}>${esc(h)}</option>`).join("");
      $("ct-map-rows").innerHTML = IMPORT_FIELDS.map((f) => {
        const auto = importHeaders.findIndex((h) => f.match.some((m) => norm(h) === m || norm(h).includes(m)));
        return `<div class="ct-map-row"><label>${f.label}${f.required ? " *" : ""}</label><select data-field="${f.key}">${opts(auto)}</select></div>`;
      }).join("");
      $("ct-import-preview").textContent = `${importData.length} row${importData.length === 1 ? "" : "s"} ready to import.`;
      $("ct-import-map").hidden = false;
    });
    function setImportStatus(msg, ok) { const el = $("ct-import-status"); el.hidden = false; el.textContent = msg; el.style.color = ok ? "#2c7a4b" : "#a05a3c"; }
    async function doImport() {
      const map = {};
      $("ct-map-rows").querySelectorAll("[data-field]").forEach((s) => { if (s.value !== "") map[s.getAttribute("data-field")] = parseInt(s.value, 10); });
      if (map.email == null) { setImportStatus("Please map the Email column first.", false); return; }
      const optin = $("ct-import-optin").checked, internal = $("ct-import-internal").checked;
      const rows = importData.map((r) => {
        const val = (k) => (map[k] != null ? String(r[map[k]] || "").trim() : "");
        let fn = val("first_name"), ln = val("last_name");
        if (!fn && !ln && map.name != null) { const p = val("name").split(/\s+/); fn = p.shift() || ""; ln = p.join(" "); }
        // The Type column value rides along as a per-row tag (e.g. "Estate Agent").
        const rowTags = [val("tags"), val("type")].filter(Boolean).join(";");
        return { email: val("email"), first_name: fn || null, last_name: ln || null, phone: val("phone") || null, company: val("company") || null, postcode: val("postcode") || null, date_joined: val("date_joined") || null, tags: rowTags };
      }).filter((r) => r.email);
      if (!rows.length) { setImportStatus("No rows had an email address.", false); return; }
      if (!WORKER) { setImportStatus("Import backend isn't connected.", false); return; }
      const btn = $("ct-import-go"); btn.disabled = true;
      const { data: { session } } = await supabase.auth.getSession();
      const token = session && session.access_token;
      let imported = 0, skipped = 0, teg = 0;
      const CHUNK = 200;
      for (let i = 0; i < rows.length; i += CHUNK) {
        btn.textContent = `Importing… ${Math.min(i + CHUNK, rows.length)}/${rows.length}`;
        try {
          const res = await fetch(`${WORKER}/contacts/import`, { method: "POST", headers: { "Content-Type": "application/json", Authorization: token ? "Bearer " + token : "" }, body: JSON.stringify({ rows: rows.slice(i, i + CHUNK), batch_tags: importBatchTags, marketing_opt_in: optin, internal }) });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) { setImportStatus(d.error || "Import failed.", false); btn.disabled = false; btn.textContent = "Import"; return; }
          imported += d.imported || 0; skipped += d.skipped || 0; teg += d.teg || 0;
        } catch (_) { setImportStatus("Network error during import.", false); btn.disabled = false; btn.textContent = "Import"; return; }
      }
      btn.disabled = false; btn.textContent = "Import";
      setImportStatus(`Imported ${imported} contact${imported === 1 ? "" : "s"}${teg ? `, ${teg} flagged as internal agents (TEG)` : ""}${skipped ? `, skipped ${skipped} (no/invalid email)` : ""}.`, true);
      load();
    }
    $("ct-import-go").addEventListener("click", doImport);
    $("ct-import-internal")?.addEventListener("change", (e) => { $("ct-import-internal-note").hidden = !e.target.checked; });

    async function load() {
      const [cRes, oRes, vRes, sRes] = await Promise.all([
        supabase.from("contacts").select("*").order("updated_at", { ascending: false }).limit(2000),
        supabase.from("orders").select("buyer_email").eq("status", "paid"),
        supabase.from("videography_bookings").select("client_email, kind, service_type"),
        supabase.from("smm_leads").select("email, kind").eq("kind", "discovery"),
      ]);
      $("ct-loading").hidden = true;
      if (cRes.error) { $("ct-loading").hidden = false; $("ct-loading").textContent = "Couldn't load contacts: " + cRes.error.message; return; }
      PURCHASER_EMAILS = new Set(((oRes && oRes.data) || []).map((o) => lc(o.buyer_email)).filter(Boolean));
      const vb = (vRes && vRes.data) || [];
      SESSION_EMAILS = new Set(vb.filter((b) => b.kind === "booking").map((b) => lc(b.client_email)).filter(Boolean));
      CALL_EMAILS = new Set([
        ...vb.filter((b) => b.kind === "discovery" || b.service_type === "discovery").map((b) => lc(b.client_email)),
        ...((sRes && sRes.data) || []).map((b) => lc(b.email)),
      ].filter(Boolean));
      ALL = (cRes && cRes.data) || [];
      render();
    }

    (async () => {
      if (!DEV) { const s = await requireAdmin(); if (!s) return; }
      await load();
      // ?contact=<id> opens that card straight away, so anything that creates a
      // contact elsewhere can hand the user to it ready to finish filling in.
      const want = new URLSearchParams(location.search).get("contact");
      if (want && ALL.some((c) => String(c.id) === want)) openDrawer(want);
    })();
  </script>
</AdminShell>
