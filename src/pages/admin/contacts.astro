    }
    function closeMerge() { $("ct-merge").hidden = true; }
    async function doMerge() {
      const [keep, lose] = mergePair;
      const btn = $("ct-merge-go");
      const say = (m, cls) => { $("ct-merge-status").textContent = m; $("ct-merge-status").className = "msg" + (cls ? " " + cls : ""); };
      btn.disabled = true; btn.textContent = "Merging";
      try {
        // 1. Fill the survivor's blanks, union the tags, take the safer flags.
        const patch = {};
