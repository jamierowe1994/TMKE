          <div class="sw tall"><div>Email health<small>${esc(health[0])}${lastEv ? esc(` Last: ${lastEv.event}${lastEv.subject ? `, "${lastEv.subject}"` : ""}${lastEv.at ? `, ${short(lastEv.at)}` : ""}.`) : ""}</small></div><span class="chip ${health[1]}">${health[2]}</span></div>
        </div>`;
