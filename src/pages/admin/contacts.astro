    let importHeaders = [], importData = [], importBatchTags = [];
    function parseCSV(text) {
      const rows = []; let row = [], field = "", inQ = false;
      for (let i = 0; i < text.length; i++) {
        const ch = text[i], nx = text[i + 1];
        if (inQ) { if (ch === '"' && nx === '"') { field += '"'; i++; } else if (ch === '"') inQ = false; else field += ch; }
        else if (ch === '"') inQ = true;
        else if (ch === ",") { row.push(field); field = ""; }
        else if (ch === "\r") { /* skip */ }
        else if (ch === "\n") { row.push(field); rows.push(row); row = []; field = ""; }
        else field += ch;
      }
      if (field !== "" || row.length) { row.push(field); rows.push(row); }
      return rows.filter((r) => r.some((c) => String(c).trim() !== ""));
    }
    const paintImportTags = () => { $("ct-import-tag").innerHTML = `<option value="">Add a tag…</option>` + tagGroups().map(([g, tags]) => `<optgroup label="${esc(g)}">${tags.map((t) => `<option value="${esc(t)}">${esc(tagLabel(t))}</option>`).join("")}</optgroup>`).join(""); };
    function renderImportTags() {
      $("ct-import-tags").innerHTML = importBatchTags.length
        ? importBatchTags.map((t) => `<span class="tagx">${esc(t)}<button type="button" data-untag="${esc(t)}" aria-label="Remove ${esc(t)}">&times;</button></span>`).join("")
        : `<span class="note">No tags yet. Add as many as you like.</span>`;
    }
    $("ct-import-tags").addEventListener("click", (e) => {
      const b = e.target.closest("[data-untag]"); if (!b) return;
      importBatchTags = importBatchTags.filter((t) => t !== b.dataset.untag); renderImportTags();
    });
    $("ct-import-tag").addEventListener("change", (e) => {
      const v = e.target.value; e.target.value = "";
      if (v && !importBatchTags.includes(v)) { importBatchTags.push(v); renderImportTags(); }
    });
    function setImportStatus(msg, ok) { const el = $("ct-import-status"); el.textContent = msg; el.className = "msg" + (ok === true ? " ok" : ok === false ? " bad" : ""); }
    $("ct-import-btn").addEventListener("click", () => { $("ct-import").hidden = false; });
    $("ct-import-close").addEventListener("click", () => { $("ct-import").hidden = true; });
    $("ct-import-cancel").addEventListener("click", () => { $("ct-import").hidden = true; });
    $("ct-import").addEventListener("click", (e) => { if (e.target === $("ct-import")) $("ct-import").hidden = true; });
    $("ct-import-input").addEventListener("change", async (e) => {
      const file = e.target.files[0]; if (!file) return;
      const rows = parseCSV(await file.text());
      setImportStatus("");
      if (rows.length < 2) { $("ct-import-map").hidden = true; $("ct-import-go").disabled = true; $("ct-import-preview").textContent = "That file has no rows under its headings."; return; }
      importHeaders = rows[0].map((h) => String(h).trim());
      importData = rows.slice(1);
      const norm = (s) => String(s).toLowerCase().trim();
      const opts = (sel) => `<option value="">Skip</option>` + importHeaders.map((h, i) => `<option value="${i}" ${sel === i ? "selected" : ""}>${esc(h)}</option>`).join("");
      $("ct-map-rows").innerHTML = IMPORT_FIELDS.map((f) => {
        const auto = importHeaders.findIndex((h) => f.match.some((m) => norm(h) === m || norm(h).includes(m)));
        return `<div class="maprow"><span>${f.label}${f.required ? " (needed)" : ""}</span><select data-field="${f.key}" aria-label="${esc(f.label)}">${opts(auto)}</select></div>`;
      }).join("");
      $("ct-import-preview").textContent = `${importData.length} ${importData.length === 1 ? "row" : "rows"} ready to import.`;
      $("ct-import-map").hidden = false;
      $("ct-import-go").disabled = false;
    });
    async function doImport() {
      const map = {};
      $("ct-map-rows").querySelectorAll("[data-field]").forEach((s) => { if (s.value !== "") map[s.getAttribute("data-field")] = parseInt(s.value, 10); });
      if (map.email == null) { setImportStatus("Match the Email column first.", false); return; }
      const optin = $("ct-import-optin").checked, internal = $("ct-import-internal").checked;
      const rows = importData.map((r) => {
        const val = (k) => (map[k] != null ? String(r[map[k]] || "").trim() : "");
        let fn = val("first_name"), ln = val("last_name");
        if (!fn && !ln && map.name != null) { const p = val("name").split(/\s+/); fn = p.shift() || ""; ln = p.join(" "); }
        // The Type column rides along as a per-row tag (like "Estate Agent").
        const rowTags = [val("tags"), val("type")].filter(Boolean).join(";");
        return { email: val("email"), first_name: fn || null, last_name: ln || null, phone: val("phone") || null, company: val("company") || null, postcode: val("postcode") || null, date_joined: val("date_joined") || null, tags: rowTags };
      }).filter((r) => r.email);
      if (!rows.length) { setImportStatus("No rows had an email address.", false); return; }
      if (!WORKER) { setImportStatus("The import isn't connected.", false); return; }
      const btn = $("ct-import-go"); btn.disabled = true;
      const t = await token();
      let imported = 0, skipped = 0, teg = 0;
      const CHUNK = 200;
      for (let i = 0; i < rows.length; i += CHUNK) {
        setImportStatus(`Importing ${Math.min(i + CHUNK, rows.length)} of ${rows.length}.`);
        try {
          const res = await fetch(`${WORKER}/contacts/import`, { method: "POST", headers: { "Content-Type": "application/json", Authorization: t ? "Bearer " + t : "" }, body: JSON.stringify({ rows: rows.slice(i, i + CHUNK), batch_tags: importBatchTags, marketing_opt_in: optin, internal }) });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) { setImportStatus(d.error || "The import failed.", false); btn.disabled = false; return; }
          imported += d.imported || 0; skipped += d.skipped || 0; teg += d.teg || 0;
        } catch (_) { setImportStatus("The connection dropped during the import.", false); btn.disabled = false; return; }
      }
      btn.disabled = false;
      setImportStatus(`Imported ${imported} ${imported === 1 ? "contact" : "contacts"}${teg ? `, ${teg} as internal agents (TEG)` : ""}${skipped ? `, skipped ${skipped} with no email or a wrong one` : ""}.`, true);
      load();
    }
    $("ct-import-go").addEventListener("click", doImport);
    $("ct-import-internal").addEventListener("change", (e) => { $("ct-import-internal-note").hidden = !e.target.checked; });
    paintImportTags();
    renderImportTags();
    loadPackTagGroup(supabase).then((g) => { packGroup = g; paintImportTags(); });

    // =========================================================================
    // Add one contact (the same /contacts/import path)
    // =========================================================================
    function closeAdd() { $("ct-add").hidden = true; }
    function addMsg(t, ok) { const m = $("ct-add-msg"); m.textContent = t; m.className = "msg" + (ok === false ? " bad" : ""); }
    $("ct-add-btn").addEventListener("click", () => { addMsg(""); $("ct-add-form").reset(); $("ct-add").hidden = false; setTimeout(() => $("ct-add-form").first_name.focus(), 30); });
    $("ct-add-close").addEventListener("click", closeAdd);
    $("ct-add-cancel").addEventListener("click", closeAdd);
    $("ct-add").addEventListener("click", (e) => { if (e.target === $("ct-add")) closeAdd(); });
    $("ct-add-form").addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target;
      const email = f.email.value.trim();
      if (!email) { addMsg("Enter an email address.", false); return; }
      if (!WORKER) { addMsg("The contacts backend isn't connected.", false); return; }
      const row = { email, first_name: f.first_name.value.trim() || null, last_name: f.last_name.value.trim() || null, phone: f.phone.value.trim() || null, company: f.company.value.trim() || null };
      const btn = $("ct-add-save"); btn.disabled = true; addMsg("Adding.");
      try {
        const { ok, j } = await workerPost("/contacts/import", { rows: [row], batch_tags: [], marketing_opt_in: f.optin.checked, source: "manual" });
        if (!ok) throw new Error(j.error || "Couldn't add the contact.");
        if (!j.imported) throw new Error("That email address doesn't look right.");
        closeAdd();
        await load();
        const created = ALL.find((c) => lc(c.email) === lc(email));
        if (created) openDrawer(created.id);
      } catch (err) { addMsg(err.message || "Couldn't add the contact.", false); }
      finally { btn.disabled = false; }
    });

    // =========================================================================
    // Load
    // =========================================================================
    /* The Worker's account facts (member since, last sign-in, invited). If it
       doesn't answer, the list carries on without them rather than showing
       anything that would change later. */
    async function loadMeta() {
      if (!WORKER) return null;
      try {
        const t = await token();
        const ctl = new AbortController(); const tm = setTimeout(() => ctl.abort(), 12000);
        const r = await fetch(`${WORKER}/contacts/members-meta`, { headers: { Authorization: "Bearer " + t }, signal: ctl.signal });
        clearTimeout(tm);
        if (!r.ok) return null;
        const j = await r.json().catch(() => null);
        return j && j.ok && j.users ? j.users : null;
      } catch (_) { return null; }
    }
    async function load() {
      const [cRes, oRes, vRes, sRes, pRes, bRes, mRes] = await Promise.all([
        readAll(() => supabase.from("contacts").select("*").order("created_at", { ascending: false }).order("id")),
        readAll(() => supabase.from("orders").select("buyer_email").eq("status", "paid").order("id")),
        readAll(() => supabase.from("videography_bookings").select("client_email, kind, service_type").order("id")),
        readAll(() => supabase.from("smm_leads").select("email, kind").eq("kind", "discovery").order("id")),
        readAll(() => supabase.from("agent_profiles").select("id, contact_id, brand, left_at, is_primary, job_title, area, postcode").order("id")),
        supabase.from("brand_profiles").select("brand, colors"),
        loadMeta(),
      ]);
      try {
        const { data: au } = await supabase.from("automations").select("id, name, trigger_type, trigger_config").eq("status", "active").in("trigger_type", ["tag_added", "audience"]);
        AUTOS = au || [];
      } catch (_) { AUTOS = []; }
      if (cRes.error) { $("ct-loading").hidden = false; $("ct-loading").className = "state bad"; $("ct-loading").textContent = "Couldn't load contacts: " + cRes.error.message; return; }
      PURCHASER_EMAILS = new Set(oRes.data.map((o) => lc(o.buyer_email)).filter(Boolean));
      const vb = vRes.data;
      SESSION_EMAILS = new Set(vb.filter((b) => b.kind === "booking").map((b) => lc(b.client_email)).filter(Boolean));
      CALL_EMAILS = new Set([...vb.filter((b) => b.kind === "discovery" || b.service_type === "discovery").map((b) => lc(b.client_email)), ...sRes.data.map((b) => lc(b.email))].filter(Boolean));
      PROFILES_OK = !pRes.error;
      const pm = new Map();
      pRes.data.forEach((p) => { if (!pm.has(p.contact_id)) pm.set(p.contact_id, []); pm.get(p.contact_id).push(p); });
      PROFILES = pm;
      BRAND_COL = new Map(((bRes && bRes.data) || []).map((r) => [lc(r.brand), firstColour(r.colors)]).filter(([, h]) => h));
      META = mRes;
      ALL = cRes.data;
     
      $("ct-loading").hidden = true;
      $("ct-main").hidden = false;
      renderList();
    }

    (async () => {
      if (!DEV) { const s = await requireAdmin(); if (!s) return; }
      whoAmI();
      await load();
      // ?contact=<id> opens that card straight away, so anything that creates a
      // contact elsewhere can hand the user to it ready to finish filling in.
      const want = new URLSearchParams(location.search).get("contact");
      if (want && ALL.some((c) => String(c.id) === want)) {
        await openDrawer(want);
        if (EMBED) try { parent.postMessage({ type: "tmke-contact-ready" }, location.origin); } catch (_) {}
      }
      else if (EMBED) try { parent.postMessage({ type: "tmke-contact-missing" }, location.origin); } catch (_) {}
    })();
  </script>
</AdminShell>
