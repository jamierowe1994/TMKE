      if (!CS.tab || !rows.some((r) => String(r.id) === String(CS.tab))) CS.tab = (mainOf(rows) || rows[0] || {}).id || null;
      const p = rows.find((r) => String(r.id) === String(CS.tab));
      const detected = tegBrandFromEmail(c.email);
      const canAdd = ty !== "external" || detected !== null || !!CS.pendingType || rows.length > 0;
      let body;
      if (CS.editing === "brandAdd") {
        const free = TEG_BRANDS.filter((b) => !rows.some((r) => lc(r.brand) === lc(b)));
        body = free.length ? brandForm(c, null, true, rows, (CS.pendingType || ty) !== "support") : `<p class="note">They already have every brand. Use They're back on a brand they've left.</p>`;
