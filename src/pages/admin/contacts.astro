        ${!(p && p.is_primary && !p.left_at) ? `<label class="chk"><input type="checkbox" id="bf-primary" ${add && !liveOf(rows).length ? "checked" : ""}> Open their Studio in this brand</label>` : ""}
        ${isAgentForm ? `<p class="sub-h">New starter</p>
        <div class="facts three">
          <label class="field"><span>Package</span><select id="bf-pkg"><option value="">Not a new starter</option><option value="academy" ${pkg === "academy" ? "selected" : ""}>Academy</option><option value="pro" ${pkg === "pro" ? "selected" : ""}>Pro</option></select></label>
          ${fld("bf-month", "Induction month", p && p.induction_month, "month")}
          ${fld("bf-trainer", "Trainer", (p && p.trainer_name) || "Kelly Bailey")}
          ${fld("bf-trainer-email", "Trainer email", (p && p.trainer_email) || "kelly@theexpertsgroup.co.uk", "email")}
        </div>
        <p class="note">${p && p.promo_code ? `Their free videography code is ${esc(p.promo_code)}.` : ns ? "Their free code is made when you save with a package and month." : "Academy and Pro get a free videography code and booking link when you save."}</p>` : ""}`;
    }
    function brandsBox(c, rows, ty) {
      const isAgentView = ty !== "support";
