---
// Contacts (Danielle, 12 Nov 2026, agreed line by line on the mock-up
// docs/tmke-os/contacts/index.html): the TMKE OS look, views as one bar, one
// filter bar, and the contact card as a wide right-hand panel of boxes that
// each edit in place. Every confirm sits in the page: no alert, confirm or
// prompt anywhere.
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/contacts-os.css";
---

<AdminShell active="contacts" title="Contacts" skin="hub">
  <!-- ?embed=1: this page as a pop-out on another admin page (the TEG
       sync's Team Hub check). Only the contact card shows; set before it
       paints, so the list never flashes up. -->
  <script is:inline>if (new URLSearchParams(location.search).get("embed") === "1") document.documentElement.classList.add("ct-embed");</script>
  <div class="ash-panel ash-page">
    <div class="cx" id="cx">
      <div class="mo-head">
        <div>
          <p class="mo-eye">People</p>
          <div class="mo-title">Contacts</div>
          <p class="mo-sub">Everyone we know: TEG agents and their teams, members, customers and leads. Search, filter or pick a view, then open anyone to see and change everything about them in one place.</p>
        </div>
        <div class="mo-acts">
          <button type="button" class="mbtn" id="ct-import-btn">Import</button>
          <button type="button" class="mbtn" id="ct-export">Export</button>
          <button type="button" class="mbtn primary" id="ct-add-btn">Add contact</button>
        </div>
      </div>
      <p class="state" id="ct-loading">Loading contacts.</p>
      <div id="ct-main" hidden>
        <div class="figs" id="ct-figs"></div>
        <div class="views" id="ct-views" role="group" aria-label="Views"></div>
        <div class="bar" id="ct-bar">
          <label class="find">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input id="ct-q" type="search" placeholder="Search name, email, brand, area…" aria-label="Search contacts" autocomplete="off" />
          </label>
          <div class="dds" id="ct-dds"></div>
        </div>
        <div class="active" id="ct-active"></div>
        <div id="ct-bulk"></div>
        <div class="tablewrap"><table id="ct-table"></table></div>
        <div class="pager" id="ct-pager"></div>
      </div>
    </div>
  </div>

  <!-- The contact card. Moved to <body> on boot (see the reparent below). -->
  <div class="cx-scrim" id="ct-scrim" hidden></div>
  <aside class="cx cx-drawer" id="ct-drawer" hidden role="dialog" aria-modal="true" aria-label="Contact">
    <div class="pbar"><button type="button" class="x" data-act="close" aria-label="Close">&times;</button></div>
    <div class="pb" id="ct-drawer-body" data-lenis-prevent></div>
  </aside>

  <!-- Merge two contacts -->
  <div class="cx cx-popscrim" id="ct-merge" hidden>
    <div class="pop" role="dialog" aria-modal="true" aria-label="Merge two contacts">
      <div class="pop-h"><div><p class="mo-eye" style="margin:0">Contacts</p><div class="pop-title">Merge two contacts</div></div><button type="button" class="x" id="ct-merge-close" aria-label="Close">&times;</button></div>
      <div class="pop-b" data-lenis-prevent>
        <p>Pick the record to keep. Everything on the other one moves across: notes, tasks, tags, bookings and history. Anything the kept record is missing is filled in from it, then the other record is deleted.</p>
        <div class="merge-grid" id="ct-merge-grid"></div>
        <p class="merge-sum" id="ct-merge-sum"></p>
      </div>
      <div class="pop-f"><span class="msg" id="ct-merge-status"></span><button type="button" class="mbtn" id="ct-merge-cancel">Cancel</button><button type="button" class="mbtn primary" id="ct-merge-go">Merge them</button></div>
    </div>
  </div>

  <!-- Import a CSV -->
  <div class="cx cx-popscrim" id="ct-import" hidden>
    <div class="pop" role="dialog" aria-modal="true" aria-label="Import contacts">
      <div class="pop-h"><div><p class="mo-eye" style="margin:0">Contacts</p><div class="pop-title">Import contacts</div></div><button type="button" class="x" id="ct-import-close" aria-label="Close">&times;</button></div>
      <div class="pop-b" data-lenis-prevent>
        <p>Upload a CSV (in Excel, Save As, then CSV). We match on email, so importing the same people again never duplicates them: it merges.</p>
        <label class="field"><span>CSV file</span><input type="file" id="ct-import-input" accept=".csv,text/csv" /></label>
        <p class="note" id="ct-import-preview"></p>
        <div id="ct-import-map" hidden style="display:grid;gap:12px">
          <p class="sub-h">Match your columns</p>
          <div class="maprows" id="ct-map-rows"></div>
          <p class="sub-h">Tags for everyone in this file</p>
          <div class="taglist" id="ct-import-tags"></div>
          <div class="tagadd"><select id="ct-import-tag" aria-label="Add a tag for everyone in this file"></select></div>
          <label class="chk"><input type="checkbox" id="ct-import-optin" /> These contacts have opted into marketing</label>
          <label class="chk"><input type="checkbox" id="ct-import-internal" /> These are internal (Experts Group) agents</label>
          <p class="note" id="ct-import-internal-note" hidden>Marks each as an internal agent (TEG), fills their brand from the Company or Brand, Postcode and Date joined columns, and sets marketing opt-in to Yes.</p>
        </div>
      </div>
      <div class="pop-f"><span class="msg" id="ct-import-status"></span><button type="button" class="mbtn" id="ct-import-cancel">Close</button><button type="button" class="mbtn primary" id="ct-import-go" disabled>Import</button></div>
    </div>
  </div>

  <!-- Add a contact -->
  <div class="cx cx-popscrim" id="ct-add" hidden>
    <div class="pop short" role="dialog" aria-modal="true" aria-label="Add a contact">
      <div class="pop-h"><div><p class="mo-eye" style="margin:0">Contacts</p><div class="pop-title">Add a contact</div></div><button type="button" class="x" id="ct-add-close" aria-label="Close">&times;</button></div>
      <div class="pop-b" data-lenis-prevent>
        <p>We match on email, so adding someone who's already here just updates their card. Their card opens next, for their type and brands.</p>
        <form id="ct-add-form" autocomplete="off" style="display:grid;gap:12px">
          <div class="facts">
            <label class="field"><span>First name</span><input name="first_name" /></label>
            <label class="field"><span>Last name</span><input name="last_name" /></label>
          </div>
          <label class="field"><span>Email</span><input name="email" type="email" required placeholder="name@example.com" /></label>
          <div class="facts">
            <label class="field"><span>Phone</span><input name="phone" type="tel" /></label>
            <label class="field"><span>Company</span><input name="company" /></label>
          </div>
          <label class="chk"><input type="checkbox" name="optin" /> They've opted into marketing</label>
        </form>
      </div>
      <div class="pop-f"><span class="msg" id="ct-add-msg"></span><button type="button" class="mbtn" id="ct-add-cancel">Cancel</button><button type="submit" form="ct-add-form" class="mbtn primary" id="ct-add-save">Add contact</button></div>
    </div>
  </div>

  <!-- Export, chosen here rather than in the spreadsheet (Danielle, 12 Nov). -->
  <div class="cx cx-popscrim" id="ct-exp" hidden>
    <div class="pop" role="dialog" aria-modal="true" aria-label="Export contacts">
      <div class="pop-h"><div><p class="mo-eye" style="margin:0">Contacts</p><div class="pop-title">Export</div></div><button type="button" class="x" id="ct-exp-close" aria-label="Close">&times;</button></div>
      <div class="pop-b" data-lenis-prevent id="ct-exp-body"></div>
      <div class="pop-f"><span class="msg" id="ct-exp-count"></span><button type="button" class="mbtn" id="ct-exp-cancel">Cancel</button><button type="button" class="mbtn primary" id="ct-exp-go">Download CSV</button></div>
    </div>
  </div>

  <div class="cx cx-toast" id="ct-toast" role="status" aria-live="polite"></div>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { supabase } from "../../lib/supabase.js";
    import { loadPackTagGroup, withPackTags, tagLabel } from "../../lib/contact-tags.js";

    // Framework tags plus a "Pack Name: …" tag for every pack in the shop.
    let packGroup = null;
    const tagGroups = () => withPackTags(packGroup);

    const DEV = import.meta.env.DEV;
    const EMBED = document.documentElement.classList.contains("ct-embed");
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const $ = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    const lc = (e) => String(e || "").toLowerCase().trim();
    const EMAIL_RE = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
    const short = (d) => { if (!d) return ""; const t = new Date(d); return isNaN(t) ? "" : t.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); };
    const dayStart = (t) => { const x = new Date(t); x.setHours(0, 0, 0, 0); return x; };
    function ago(d) {
      if (!d) return "Never";
      const t = new Date(d); if (isNaN(t)) return "Never";
      const n = Math.round((dayStart(Date.now()) - dayStart(t)) / 86400000);
      if (n <= 0) return "Today";
      if (n === 1) return "Yesterday";
      if (n < 7) return n + " days ago";
      if (n < 60) { const w = Math.round(n / 7); return w === 1 ? "1 week ago" : w + " weeks ago"; }
      return short(d);
    }
    const todayIso = () => { const t = new Date(); return `${t.getFullYear()}-${String(t.getMonth() + 1).padStart(2, "0")}-${String(t.getDate()).padStart(2, "0")}`; };
    const fullName = (c) => [c.first_name, c.last_name].filter(Boolean).join(" ") || "(no name)";
    const gbp = (p) => (p == null ? "" : "£" + (p / 100).toLocaleString("en-GB", { minimumFractionDigits: p % 100 ? 2 : 0, maximumFractionDigits: 2 }));
    const cap = (s) => String(s || "").charAt(0).toUpperCase() + String(s || "").slice(1);
    const humanizeSource = (s) => { if (!s) return ""; return String(s).replace(/_/g, " ").replace(/\bsmm\b/gi, "SMM").replace(/\btmke\b/gi, "TMKE").replace(/\bteg\b/gi, "TEG").replace(/^./, (ch) => ch.toUpperCase()); };
    const personName = (a) => !a ? "" : String(a).includes("@") ? cap(String(a).split("@")[0].split(/[._]/)[0]) : String(a);
    const CHEV = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>';

    let toastT;
    function toast(m, ms) { const t = $("ct-toast"); t.textContent = m; t.classList.add("on"); clearTimeout(toastT); toastT = setTimeout(() => t.classList.remove("on"), ms || 2800); }

    async function token() { try { const { data } = await supabase.auth.getSession(); return data?.session?.access_token || ""; } catch (_) { return ""; } }
    async function workerPost(path, body) {
      const t = await token();
      const r = await fetch(`${WORKER}${path}`, { method: "POST", headers: { "Content-Type": "application/json", Authorization: t ? "Bearer " + t : "" }, body: JSON.stringify(body) });
      return { ok: r.ok, status: r.status, j: await r.json().catch(() => ({})) };
    }
    // Member-account linking, kept as it was: POST to the Worker with the admin's token.
    async function acctApi(path, body) { return (await workerPost(path, body)).j; }
    async function pool(items, n, fn) {
      let i = 0;
      const run = async () => { while (i < items.length) { const it = items[i++]; await fn(it); } };
      await Promise.all(Array.from({ length: Math.min(n, items.length) }, run));
    }
    /* Every REST read stops at 1,000 rows without saying so, so anything that
       grows is read a page at a time until a short page comes back. */
    async function readAll(build) {
      const out = [];
      for (let from = 0; from < 500000; from += 1000) {
        const { data, error } = await build().range(from, from + 999);
        if (error) return { data: out, error };
        out.push(...(data || []));
        if (!data || data.length < 1000) break;
      }
      return { data: out, error: null };
    }

    // ---- Who is signed in, for "Note by" and the task picker ----------------
    let ME = "Admin";
    const PEOPLE = ["Danielle", "Sam", "Abigail", "Jack", "Angel"];
    async function whoAmI() {
      try {
        const { data } = await supabase.auth.getUser();
        const u = data?.user;
        const n = String((u?.user_metadata && (u.user_metadata.full_name || u.user_metadata.name)) || "").trim().split(/\s+/)[0];
        ME = n || (u?.email ? personName(u.email) : "Admin");
        if (/^abbie$/i.test(ME)) ME = "Abigail";
      } catch (_) {}
    }

    // ---- Lifecycle (unchanged rules) ----------------------------------------
    // Customer (paid/booked) > Member (has account) > TEG > Lead; 'past' is a
    // manual override. The list's Stage folds TEG into Lead, because Type now
    // says who's at TEG.
    const LIFECYCLES = [["lead", "Lead"], ["teg", "TEG"], ["member", "Member"], ["customer", "Customer"], ["past", "Past"]];
    const lifecycleLabel = (v) => (LIFECYCLES.find(([x]) => x === v) || [v, v])[1];
    const isTeg = (c) => (c.tags || []).some((t) => /^Videography-New-Starter:/i.test(t) || t === "Network: TEG" || t === "Network: Fine-and-Country")
      || c.source === "agent_sheet_sync" || c.lifecycle === "teg";
    function deriveLifecycle(c) {
      if (c.lifecycle === "past") return "past";
      if (isPurchaser(c) || isSession(c)) return "customer";
      if (c.user_id) return "member";
      if (isTeg(c)) return "teg";
      return "lead";
    }
    const stageOf = (c) => { const l = deriveLifecycle(c); return l === "teg" ? "lead" : l; };
    const STAGES = { lead: "Lead", member: "Member", customer: "Customer", past: "Past" };
    const STAGE_BLK = { customer: "cust", member: "mem", lead: "lead", past: "past" };

    // Reconcile a contact's tags to the CRM rules (mirrors the Worker's
    // normalizeTags + normalize_contact_tags in SQL; keep the three in sync).
    const TAG_ALIASES = {
      "TEG": "Network: TEG",
      "Estate Agent": "Type: Estate-Agent",
      "Lettings": "Type: Lettings",
      "Financial Services": "Type: Financial-Services",
      "Fine & Country": "Network: Fine-and-Country",
      "Fine and Country": "Network: Fine-and-Country",
    };
    function normalizeTags(tags) {
      let t = Array.from(new Set((tags || []).map((x) => String(x || "").trim()).filter(Boolean).map((x) => TAG_ALIASES[x] || x)));
      const has = (x) => t.includes(x);
      const dropAll = (...xs) => { t = t.filter((v) => !xs.includes(v)); };
      if (has("Unsubscribed")) dropAll("Marketing-Opt-In", "Marketing-Not-Opted-In", "Newsletter-Subscriber");
      else {
        if (has("Newsletter-Subscriber") && !has("Marketing-Opt-In")) t.push("Marketing-Opt-In");
        if (has("Marketing-Opt-In")) dropAll("Marketing-Not-Opted-In");
      }
      if (t.filter((v) => v.startsWith("SMM-Status:")).length > 1) {
        const keep = has("SMM-Status: Active") ? "SMM-Status: Active" : has("SMM-Status: Paused") ? "SMM-Status: Paused" : "SMM-Status: Ended";
        t = t.filter((v) => !v.startsWith("SMM-Status:")).concat(keep);
      }
      if (t.some((v) => v.startsWith("SMM-Status:"))) dropAll("Interest: SMM", "Discovery-Call-Booked: SMM");
      if (has("Videography-Client")) dropAll("Interest: Videography", "Discovery-Call-Booked: Videography");
      return t;
    }

    // ---- Data ----------------------------------------------------------------
    let ALL = [];
    let PROFILES = new Map();     // contact_id -> agent_profiles rows (slim)
    let PROFILES_OK = true;
    let META = null;              // user_id -> { member_since, last_sign_in_at, invited, invite_expires }, or null if the Worker didn't answer
    let AUTOS = [];
    let BRAND_COL = new Map();    // lower-case brand -> first kit colour
    let PURCHASER_EMAILS = new Set(), SESSION_EMAILS = new Set(), CALL_EMAILS = new Set();
    const isPurchaser = (c) => PURCHASER_EMAILS.has(lc(c.email)) || (c.tags || []).includes("Pack-Purchased");
    const isSession = (c) => SESSION_EMAILS.has(lc(c.email)) || (c.tags || []).includes("Videography-Client");

    const TEG_SUPPORT_TAG = "TEG-Role: Management-or-Support";
    const TEG_BRANDS = ["The Property Experts", "Prestige Property Experts", "The Letting Experts", "The Letting Experts Scotland", "Fine & Country", "The Mortgage Experts", "The Recruitment Experts", "The Marketing Experts"];
    const BSHORT = { "The Property Experts": "TPE", "Prestige Property Experts": "PPE", "The Letting Experts": "TLE", "The Letting Experts Scotland": "TLE Scotland", "Fine & Country": "F&C", "The Mortgage Experts": "TMGE", "The Recruitment Experts": "TRE", "The Marketing Experts": "TMKE", "The Experts Group": "TEG" };
    // Used only when a brand's kit has no colour yet.
    const FALLBACK_COL = { "the property experts": ["#c8102e"], "prestige property experts": ["#1f2a3a"], "the letting experts": ["#0f6e6a"], "the letting experts scotland": ["#0f6e6a"], "fine & country": ["#1a1a1a", "#d9c389"], "the mortgage experts": ["#15406b"], "the recruitment experts": ["#5a2d7a"], "the marketing experts": ["#371e28"] };
    const WINE = "#371e28";
    // Short names so every brand fits its block (Danielle, 12 Nov: TEG, TMGE).
    // A brand not listed is matched case-blind, then shortened to its initials.
    const BSHORT_LC = Object.fromEntries(Object.entries(BSHORT).map(([k, v]) => [k.toLowerCase(), v]));
    const shortBrand = (b) => {
      const t = String(b || "").trim();
      const hit = BSHORT[t] || BSHORT_LC[t.toLowerCase()];
      if (hit) return hit;
      return t.length > 12 ? t.split(/\s+/).filter((w) => /^[A-Za-z]/.test(w)).map((w) => w[0].toUpperCase()).join("") : t;
    };
    function firstColour(colors) {
      for (const x of (Array.isArray(colors) ? colors : [])) {
        const h = String(x && typeof x === "object" ? (x.hex || x.value || "") : (x || "")).trim();
        if (/^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(h)) return h;
      }
      return null;
    }
    function brandHex(brand) { const k = lc(brand); return BRAND_COL.get(k) || (FALLBACK_COL[k] && FALLBACK_COL[k][0]) || WINE; }
    function textOn(hex) {
      let h = String(hex || "").replace("#", "");
      if (h.length === 3) h = h.split("").map((x) => x + x).join("");
      const n = parseInt(h, 16); if (isNaN(n)) return "#fff";
      const ch = (v) => { v /= 255; return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4); };
      const L = 0.2126 * ch((n >> 16) & 255) + 0.7152 * ch((n >> 8) & 255) + 0.0722 * ch(n & 255);
      return L > 0.4 ? "#2b2226" : "#fff";
    }
    // The name box's colours: the brand's first kit colour at full strength.
    function nameBoxColours(brand) {
      if (!brand) return [WINE, "#fff"];
      const k = lc(brand);
      if (BRAND_COL.has(k)) { const hx = BRAND_COL.get(k); return [hx, textOn(hx)]; }
      const fb = FALLBACK_COL[k];
      if (fb) return [fb[0], fb[1] || textOn(fb[0])];
      return [WINE, "#fff"];
    }

    const profilesOf = (c) => PROFILES.get(c.id) || [];
    const liveOf = (rows) => (rows || []).filter((p) => !p.left_at && p.brand);
    const liveBrands = (c) => liveOf(profilesOf(c));
    const mainOf = (rows) => { const live = liveOf(rows); return live.find((p) => p.is_primary) || live[0] || null; };
    const isSupport = (c) => (c.tags || []).includes(TEG_SUPPORT_TAG);
    // Agent = a live brand and not management or support; External = neither.
    const typeOf = (c) => isSupport(c) ? "support" : liveBrands(c).length ? "agent" : "external";
    const TYPES = { agent: "Agent", support: "Management or support", external: "External" };
    const isLeaver = (c) => { const p = profilesOf(c); return p.length > 0 && p.every((x) => x.left_at); };
    const isUnsub = (c) => !!c.unsubscribed_at || (c.tags || []).includes("Unsubscribed");
    const mktOf = (c) => isUnsub(c) ? "unsub" : c.marketing_opt_in ? "in" : "out";
    const meta = (c) => (META && c.user_id && META[c.user_id]) || null;
    const studioOf = (c) => !c.user_id ? "none" : (meta(c) && meta(c).invited ? "invited" : "linked");
    const memberSince = (c) => (meta(c) && meta(c).member_since) || null;
    const lastSignIn = (c) => (meta(c) && meta(c).last_sign_in_at) || null;
    /* Studio filter values (Danielle, 12 Nov): has an account, signed in at
       least once, account but never signed in, invited, none. Signing in is
       read from the account itself, so it needs the Worker's answer (META). */
    function studioMatch(c, v) {
      if (v === "signed") return !!c.user_id && !!lastSignIn(c);
      if (v === "never") return !!c.user_id && !!META && !lastSignIn(c) && studioOf(c) !== "invited";
      return studioOf(c) === v;
    }
    const isBouncing = (c) => !!c.suppressed_at || (Number(c.soft_bounce_count) || 0) > 0;
    function attnOf(c) {
      const a = [];
      if (c.needs_review) a.push("review");
      if (isBouncing(c)) a.push("bounce");
      if (c.user_id && isLeaver(c)) a.push("leaver");
      return a;
    }

    // The brand an email address belongs to, for someone not set up yet.
    function tegBrandFromEmail(email) {
      const dom = String(email || "").toLowerCase().split("@")[1] || "";
      if (!dom) return null;
      if (dom === "fineandcountry.com" || dom.endsWith(".fineandcountry.com")) return "Fine & Country";
      if (dom.endsWith("prestigepropertyexperts.co.uk")) return "Prestige Property Experts";
      if (dom.endsWith("thepropertyexperts.co.uk")) return "The Property Experts";
      if (dom.endsWith("thelettingsexperts.co.uk")) return "The Letting Experts";
      if (dom.endsWith("therecruitmentexperts.co.uk")) return "The Recruitment Experts";
      if (dom.endsWith("themarketingexperts.co.uk")) return "The Marketing Experts";
      if (dom.endsWith("themortgageexperts.co.uk")) return "The Mortgage Experts";
      if (dom.endsWith("experts.co.uk")) return "";
      return null;
    }
    // The personalised booking link the funnel emails carry. Same shape as the Worker's {{bookingLink}}.
    function newStarterLink(p, c) {
      if (!p || !p.promo_code || !c) return "";
      const params = new URLSearchParams({ code: p.promo_code });
      const nm = [c.first_name, c.last_name].filter(Boolean).join(" ");
      if (nm) params.set("name", nm);
      if (c.email) params.set("email", c.email);
      if (p.induction_month) params.set("month", p.induction_month);
      return `${location.origin}/videography/new-starter?${params.toString()}`;
    }
    // Fire a contact-action trigger into the automations engine (admin authed).
    async function fire(trigger, contact, payload) {
      if (!WORKER) return;
      try {
        const t = await token(); if (!t) return;
        await fetch(`${WORKER}/automations/fire`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: `Bearer ${t}` },
          body: JSON.stringify({ trigger, email: contact.email, first_name: contact.first_name, last_name: contact.last_name, company: contact.company, payload: payload || {} }),
        });
      } catch (_) {}
    }

    // =========================================================================
    // The list
    // =========================================================================
    const VIEWS = [
      ["all", "All", () => true],
      ["teg", "TEG agents", (c) => typeOf(c) === "agent"],
      ["support", "Management and support", isSupport],
      ["external", "External", (c) => typeOf(c) === "external"],
      ["members", "Members", (c) => !!c.user_id],
      ["customers", "Customers", (c) => stageOf(c) === "customer"],
      ["leads", "Leads", (c) => stageOf(c) === "lead"],
      ["attention", "Needs attention", (c) => attnOf(c).length > 0],
    ];
    const SORTS = { added: "Newest added", seen: "Last in the Studio", member: "Newest member", name: "Name A to Z", brand: "Brand A to Z", type: "Type" };
    const MKT = { in: "Opted in", out: "Not opted in", unsub: "Unsubscribed" };
    const STUDIO = { linked: "Has an account", signed: "Has signed in", never: "Never signed in", invited: "Invited", none: "No account" };
    const S = { view: "all", q: "", brands: [], stages: [], tags: [], tagMode: "all", mkt: "", studio: "", sort: "added", page: 1, per: 25, sel: new Set(), allMatching: false, menu: null, step: null };

    function brandList() {
      const extra = new Set();
      PROFILES.forEach((rows) => rows.forEach((p) => { if (p.brand && !TEG_BRANDS.includes(p.brand)) extra.add(p.brand); }));
      return TEG_BRANDS.concat([...extra].sort());
    }
    function haystack(c) {
      const p = profilesOf(c);
      return [fullName(c), c.email, c.secondary_email, c.company, c.phone, ...p.map((x) => `${x.brand || ""} ${shortBrand(x.brand)} ${x.area || ""} ${x.postcode || ""}`)].join(" ").toLowerCase();
    }
    function matches(c) {
      const v = VIEWS.find((x) => x[0] === S.view);
      if (v && !v[2](c)) return false;
      if (S.q) {
        const hay = haystack(c);
        if (!S.q.toLowerCase().split(/\s+/).filter(Boolean).every((w) => hay.includes(w))) return false;
      }
      if (S.brands.length && !liveBrands(c).some((p) => S.brands.includes(p.brand))) return false;
      if (S.stages.length && !S.stages.includes(stageOf(c))) return false;
      if (S.tags.length) {
        const has = (t) => (c.tags || []).includes(t);
        if (S.tagMode === "all" ? !S.tags.every(has) : !S.tags.some(has)) return false;
      }
      if (S.mkt && mktOf(c) !== S.mkt) return false;
      if (S.studio && !studioMatch(c, S.studio)) return false;
      return true;
    }
    const ts = (d) => { const t = d ? new Date(d).getTime() : NaN; return isNaN(t) ? null : t; };
    const desc = (ka, kb) => (ka == null && kb == null) ? 0 : ka == null ? 1 : kb == null ? -1 : kb - ka;
    const nameKey = (c) => lc(`${c.last_name || ""} ${c.first_name || ""}`.trim() || "~" + (c.email || ""));
    function sorted(list) {
      const by = {
        added: (a, b) => desc(ts(a.created_at), ts(b.created_at)),
        // Last in the Studio: their last sign-in, not any touchpoint.
        seen: (a, b) => desc(ts(lastSignIn(a)), ts(lastSignIn(b))),
        // Newest member: when they made their account. Without the Worker's
        // answer, a member's card age stands in.
        member: (a, b) => {
          const k = (c) => META ? ts(memberSince(c)) : (c.user_id ? ts(c.created_at) : null);
          return desc(k(a), k(b));
        },
        name: (a, b) => nameKey(a).localeCompare(nameKey(b)),
        // Brand A to Z: by their main brand; external people after, by company.
        brand: (a, b) => {
          const k = (c) => { const m = mainOf(profilesOf(c)); return m ? "0" + lc(m.brand) : "1" + (lc(c.company) || "~"); };
          return k(a).localeCompare(k(b)) || nameKey(a).localeCompare(nameKey(b));
        },
        // Type (Danielle, 12 Nov): External, then Agent, then Management or
        // support; A to Z by name within each.
        type: (a, b) => {
          const r = { external: 0, agent: 1, support: 2 };
          return (r[typeOf(a)] - r[typeOf(b)]) || nameKey(a).localeCompare(nameKey(b));
        },
      };
      return list.slice().sort(by[S.sort] || by.added);
    }
    function currentList() { return sorted(ALL.filter(matches)); }
    function selectedRows() { return S.allMatching ? currentList() : ALL.filter((c) => S.sel.has(c.id)); }

    function renderFigs() {
      const month = Date.now() - 30 * 86400000;
      const f = [
        ["lin", ALL.length, "Contacts", "all"],
        ["lin", ALL.filter((c) => !!c.user_id).length, "With a Studio account", "members"],
        ["lin", ALL.filter((c) => (ts(c.created_at) || 0) >= month).length, "Added in the last 30 days", "recent"],
        ["dark", ALL.filter((c) => attnOf(c).length).length, "Need attention", "attention"],
      ];
      $("ct-figs").innerHTML = f.map(([k, n, l, v]) => `<button type="button" class="fig ${k}" data-fig="${v}"><b>${n.toLocaleString("en-GB")}</b><span>${l}</span></button>`).join("");
    }
    function renderViews() {
      $("ct-views").innerHTML = VIEWS.map(([k, l, fn]) => `<button type="button" data-view="${k}" aria-pressed="${S.view === k}">${l} <i>${ALL.filter(fn).length.toLocaleString("en-GB")}</i></button>`).join("");
    }
    function ddBtn(key, label, has) { return `<div class="dd"><button type="button" class="ddb${has ? " has" : ""}" data-menu="${key}" aria-expanded="${S.menu === key}">${esc(label)} ${CHEV}</button>${S.menu === key ? menuHtml(key) : ""}</div>`; }
    function menuHtml(key) {
      const cb = (name, val, on, label) => `<label><input type="checkbox" data-f="${name}" value="${esc(val)}" ${on ? "checked" : ""}> ${esc(label)}</label>`;
      const rd = (name, val, on, label) => `<label><input type="radio" name="ct-${name}" data-f="${name}" value="${esc(val)}" ${on ? "checked" : ""}> ${esc(label)}</label>`;
      const wrap = (inner, right) => `<div class="ddm${right ? " right" : ""}" data-lenis-prevent>${inner}</div>`;
      if (key === "brand") return wrap(brandList().map((b) => cb("brands", b, S.brands.includes(b), b)).join(""));
      if (key === "stage") return wrap(Object.entries(STAGES).map(([k, l]) => cb("stages", k, S.stages.includes(k), l)).join(""));
      if (key === "tags") {
        // The whole catalogue, plus any tag in use that isn't in it.
        const framework = new Set(tagGroups().flatMap(([, t]) => t));
        const extra = Array.from(new Set(ALL.flatMap((c) => c.tags || []))).filter((t) => !framework.has(t)).sort((a, b) => a.localeCompare(b));
        const groups = extra.length ? [...tagGroups(), ["Other", extra]] : tagGroups();
        return wrap(`<div class="seg"><button type="button" data-tagmode="all" aria-pressed="${S.tagMode === "all"}">Has all of these</button><button type="button" data-tagmode="any" aria-pressed="${S.tagMode === "any"}">Has any</button></div>`
          + groups.map(([g, t]) => `<div class="grp">${esc(g)}</div>${t.map((x) => cb("tags", x, S.tags.includes(x), x)).join("")}`).join(""));
      }
      if (key === "more") return wrap(`<div class="grp">Marketing</div>${rd("mkt", "", !S.mkt, "Anyone")}${rd("mkt", "in", S.mkt === "in", "Opted in")}${rd("mkt", "out", S.mkt === "out", "Not opted in")}${rd("mkt", "unsub", S.mkt === "unsub", "Unsubscribed")}<div class="grp">Studio account</div>${rd("studio", "", !S.studio, "Anyone")}${rd("studio", "linked", S.studio === "linked", "Has an account")}${rd("studio", "signed", S.studio === "signed", "Has signed in")}${rd("studio", "never", S.studio === "never", "Has an account, never signed in")}${rd("studio", "invited", S.studio === "invited", "Invited, not set up yet")}${rd("studio", "none", S.studio === "none", "No account")}`);
      if (key === "sort") return wrap(Object.entries(SORTS).map(([k, l]) => `<label><input type="radio" name="ct-sort" data-f="sort" value="${k}" ${S.sort === k ? "checked" : ""}> ${l}</label>`).join(""), true);
      return "";
    }
    function renderBar() {
      const keep = document.querySelector("#ct-dds .ddm")?.scrollTop || 0;
      const more = (S.mkt ? 1 : 0) + (S.studio ? 1 : 0);
      $("ct-dds").innerHTML = `
        ${ddBtn("brand", "Brand" + (S.brands.length ? " · " + S.brands.length : ""), S.brands.length)}
        ${ddBtn("stage", "Stage" + (S.stages.length ? " · " + S.stages.length : ""), S.stages.length)}
        ${ddBtn("tags", "Tags" + (S.tags.length ? " · " + S.tags.length : ""), S.tags.length)}
        ${ddBtn("more", "More filters" + (more ? " · " + more : ""), more)}
        <div class="sortto">${ddBtn("sort", "Sort: " + SORTS[S.sort], false)}</div>`;
      placeMenu(keep);
      const pills = [];
      S.brands.forEach((b) => pills.push(["brands", b, shortBrand(b)]));
      S.stages.forEach((s) => pills.push(["stages", s, STAGES[s]]));
      S.tags.forEach((t) => pills.push(["tags", t, t]));
      if (S.mkt) pills.push(["mkt", "", MKT[S.mkt]]);
      if (S.studio) pills.push(["studio", "", STUDIO[S.studio]]);
      const n = ALL.filter(matches).length;
      $("ct-active").innerHTML = `<span>${n.toLocaleString("en-GB")} ${n === 1 ? "contact" : "contacts"}</span>`
        + (pills.length ? pills.map(([k, v, l]) => `<span class="pill">${esc(l)}<button type="button" data-unpill="${k}" data-v="${esc(v)}" aria-label="Remove ${esc(l)}">&times;</button></span>`).join("")
          + (S.tags.length > 1 ? `<span>${S.tagMode === "all" ? "with all of these tags" : "with any of these tags"}</span>` : "") : "")
        + (pills.length || S.q ? `<button type="button" class="lnk" data-clearall>Clear all</button>` : "")
        + (!PROFILES_OK ? `<span class="warn">Brands didn't load, so Type and Brand may be wrong. Reload to try again.</span>` : "")
        + (!META ? `<span>Studio invites and member dates aren't showing yet: the server didn't answer.</span>` : "");
    }
    // The open menu is fixed to the screen under its button, so the scrolling page can't clip it.
    function placeMenu(keep) {
      const m = document.querySelector("#ct-dds .ddm"); if (!m) return;
      const b = m.parentElement.querySelector(".ddb"); const r = b.getBoundingClientRect();
      const vw = window.innerWidth || 1280, vh = window.innerHeight || 800;
      m.style.top = Math.round(r.bottom + 4) + "px";
      const w = m.offsetWidth;
      const left = m.classList.contains("right") ? r.right - w : r.left;
      m.style.left = Math.round(Math.max(12, Math.min(left, vw - w - 12))) + "px";
      m.style.maxHeight = Math.min(340, Math.max(160, vh - r.bottom - 20)) + "px";
      if (keep) m.scrollTop = keep;
    }
    function renderBulk() {
      const total = ALL.filter(matches).length;
      const n = S.allMatching ? total : S.sel.size;
      if (!n) { $("ct-bulk").innerHTML = ""; S.step = null; return; }
      const st = S.step;
      let step = "";
      if (st === "add" || st === "remove") {
        const rows = selectedRows();
        const opts = st === "add"
          ? tagGroups().map(([g, t]) => `<optgroup label="${esc(g)}">${t.map((x) => `<option value="${esc(x)}">${esc(tagLabel(x))}</option>`).join("")}</optgroup>`).join("")
          : Array.from(new Set(rows.flatMap((c) => c.tags || []))).sort((a, b) => a.localeCompare(b)).map((x) => `<option value="${esc(x)}">${esc(x)}</option>`).join("");
        step = `<div class="bulk-step" id="ct-bulk-step"><select id="ct-bulk-tag" aria-label="Tag"><option value="">${st === "add" ? "Pick a tag to add to all " + n : (opts ? "Pick a tag to take off all " + n : "None of them has a tag")}</option>${opts}</select><button type="button" class="mbtn primary" data-bulk="tag-go">${st === "add" ? "Add tag" : "Remove tag"}</button><button type="button" class="mbtn" data-bulk="step-cancel">Cancel</button><span class="note" id="ct-bulk-msg"></span></div>`;
      } else if (st === "delete") {
        step = `<div class="bulk-step bad"><p>Delete ${n.toLocaleString("en-GB")} ${n === 1 ? "contact" : "contacts"}? Their notes, tasks and brands go too. Orders and bookings stay, without the link to the card. This can't be undone.</p><button type="button" class="mbtn" data-bulk="step-cancel">Keep them</button><button type="button" class="mbtn primary" data-bulk="delete-go">Delete</button></div>`;
      }
      $("ct-bulk").innerHTML = `<div class="bulk"><span>${n.toLocaleString("en-GB")} selected</span>${!S.allMatching && S.sel.size < total ? `<button type="button" class="lnk" data-bulk="all">Select all ${total.toLocaleString("en-GB")} that match</button>` : ""}<span class="sp"></span>
        <button type="button" class="mbtn${st === "add" ? " on" : ""}" data-bulk="add">Add tag</button>
        <button type="button" class="mbtn${st === "remove" ? " on" : ""}" data-bulk="remove">Remove tag</button>
        <button type="button" class="mbtn" data-bulk="email">Send email</button>
        <button type="button" class="mbtn" data-bulk="export">Export</button>
        ${n === 2 ? `<button type="button" class="mbtn" data-bulk="merge">Merge</button>` : ""}
        <button type="button" class="mbtn${st === "delete" ? " on" : ""}" data-bulk="delete">Delete</button>
        <button type="button" class="mbtn" data-bulk="clear">Clear</button></div>${step}`;
    }
    function brandBlocks(c) {
      const live = liveBrands(c);
      if (!live.length) return `<span class="blk ext" title="${esc(c.company || "External")}">${esc(c.company || "External")}</span>`;
      // Their main brand only (Danielle, 12 Nov: most TPE agents are PPE too);
      // the others are in the tooltip and on the card.
      const p = live.find((x) => x.is_primary) || live[0];
      const x = brandHex(p.brand);
      const all = live.map((y) => y.brand).join(", ");
      return `<span class="blk br" style="background:color-mix(in srgb, ${x} 50%, #fff);color:color-mix(in srgb, ${x} 55%, #000)" title="${esc(all)}">${esc(shortBrand(p.brand))}</span>`;
    }
    /* "Last active" used to be last_seen_at, which moves on any touchpoint
       (a form, an import, a booking), so people with no account showed
       activity. Now it's only signing in to the Studio (Danielle, 12 Nov). */
    function lastInCell(c) {
      if (!c.user_id) return "No account";
      const t = lastSignIn(c);
      if (t) return esc(ago(t));
      if (!META) return "";
      return studioOf(c) === "invited" ? "Invited" : "Never";
    }
    function renderTable() {
      const L = currentList();
      // Selections only ever cover people still in the list.
      const vis = new Set(L.map((c) => c.id));
      Array.from(S.sel).forEach((id) => { if (!vis.has(id)) S.sel.delete(id); });
      const pages = Math.max(1, Math.ceil(L.length / S.per));
      if (S.page > pages) S.page = pages;
      const rows = L.slice((S.page - 1) * S.per, S.page * S.per);
      const allOn = rows.length && rows.every((c) => S.allMatching || S.sel.has(c.id));
      const th = (k, l) => k ? `<th><button type="button" data-sort="${k}" class="${S.sort === k ? "on" : ""}">${l}${S.sort === k ? " ↓" : ""}</button></th>` : `<th>${l}</th>`;
      if (!L.length) {
        $("ct-table").innerHTML = "";
        $("ct-pager").innerHTML = ALL.length
          ? `<div class="cx-empty">Nobody matches. Try fewer filters, or <button type="button" class="lnk" data-clearall>clear them all</button>.</div>`
          : `<div class="cx-empty">No contacts yet. They appear here as people enquire, book, sign up or buy.</div>`;
        return;
      }
      $("ct-table").innerHTML = `<thead><tr><th class="ck"><input type="checkbox" id="ct-ck-all" ${allOn ? "checked" : ""} aria-label="Select this page"></th>${th("name", "Name")}${th("type", "Type")}${th("brand", "Brand")}${th("", "Studio")}${th("", "Marketing")}${th("seen", "Last in Studio")}${th("added", "Added")}${th("", "Stage")}</tr></thead><tbody>${rows.map((c) => {
        const on = S.allMatching || S.sel.has(c.id);
        const a = attnOf(c);
        const ty = typeOf(c);
        const st = studioOf(c), mk = mktOf(c), sg = stageOf(c);
        return `<tr data-open="${esc(c.id)}" class="${on ? "sel" : ""}">
          <td class="ck"><input type="checkbox" data-ck="${esc(c.id)}" ${on ? "checked" : ""} aria-label="Select ${esc(fullName(c))}"></td>
          <td><div class="nm"><b>${esc(fullName(c))}${a.length ? ` <span class="warn" title="Needs attention">●</span>` : ""}</b><span>${esc(c.email || "")}</span></div></td>
          <td class="tx">${ty === "support" ? "Management" : TYPES[ty]}</td>
          <td>${brandBlocks(c)}</td>
          <td>${st === "linked" ? `<span class="blk yes">Has account</span>` : st === "invited" ? `<span class="blk wait">Invited</span>` : `<span class="blk no">None</span>`}</td>
          <td>${mk === "unsub" ? `<span class="blk bad">Unsubscribed</span>` : mk === "in" ? `<span class="blk yes">Opted in</span>` : `<span class="blk no">Not opted in</span>`}</td>
          <td class="tx">${lastInCell(c)}</td>
          <td class="tx">${short(c.created_at)}</td>
          <td><span class="blk ${STAGE_BLK[sg]}">${STAGES[sg]}</span></td></tr>`;
      }).join("")}</tbody>`;
      $("ct-pager").innerHTML = `<span>Showing ${((S.page - 1) * S.per + 1).toLocaleString("en-GB")} to ${Math.min(S.page * S.per, L.length).toLocaleString("en-GB")} of ${L.length.toLocaleString("en-GB")}</span><div><select id="ct-per" aria-label="Rows per page">${[25, 50, 100].map((n) => `<option value="${n}" ${S.per === n ? "selected" : ""}>${n} a page</option>`).join("")}</select><button type="button" class="mbtn" data-pg="-1" ${S.page <= 1 ? "disabled" : ""}>Previous</button><span>Page ${S.page} of ${pages}</span><button type="button" class="mbtn" data-pg="1" ${S.page >= pages ? "disabled" : ""}>Next</button></div>`;
    }
    function renderList() { renderFigs(); renderViews(); renderBar(); renderTable(); renderBulk(); }
    function refilter() { S.page = 1; S.allMatching = false; S.step = null; renderBar(); renderTable(); renderBulk(); renderViews(); }
    function scrollListTop() { document.querySelector(".ash-content")?.scrollTo({ top: 0, behavior: "smooth" }); }

    $("ct-q").addEventListener("input", (e) => { S.q = e.target.value.trim(); refilter(); });
    $("cx").addEventListener("click", (e) => {
      const t = e.target.closest("button, input[type=checkbox], [data-open]");
      if (!t || !$("cx").contains(t)) { if (S.menu && !e.target.closest(".ddm")) { S.menu = null; renderBar(); } return; }
      const d = t.dataset;
      if (S.menu && !t.closest(".dd")) { S.menu = null; renderBar(); }
      if (d.fig) {
        if (d.fig === "recent") { S.view = "all"; S.sort = "added"; } else S.view = d.fig;
        S.sel.clear(); refilter(); renderList(); return;
      }
      if (d.view) { S.view = d.view; S.sel.clear(); refilter(); return; }
      if (d.menu) { S.menu = S.menu === d.menu ? null : d.menu; renderBar(); return; }
      if (d.tagmode) { S.tagMode = d.tagmode; refilter(); return; }
      if (d.unpill) { const k = d.unpill; if (Array.isArray(S[k])) S[k] = S[k].filter((x) => x !== d.v); else S[k] = ""; refilter(); return; }
      if (d.clearall !== undefined) { Object.assign(S, { q: "", brands: [], stages: [], tags: [], mkt: "", studio: "" }); $("ct-q").value = ""; refilter(); return; }
      if (d.sort) { S.sort = d.sort; S.page = 1; renderBar(); renderTable(); return; }
      if (d.pg) { S.page += Number(d.pg); renderTable(); scrollListTop(); return; }
      if (t.id === "ct-ck-all") {
        const L = currentList().slice((S.page - 1) * S.per, S.page * S.per);
        if (S.allMatching) { S.allMatching = false; currentList().forEach((c) => S.sel.add(c.id)); }
        if (t.checked) L.forEach((c) => S.sel.add(c.id)); else L.forEach((c) => S.sel.delete(c.id));
        renderTable(); renderBulk(); return;
      }
      if (d.ck) {
        if (S.allMatching) { S.allMatching = false; currentList().forEach((c) => S.sel.add(c.id)); }
        if (t.checked) S.sel.add(d.ck); else S.sel.delete(d.ck);
        renderTable(); renderBulk(); return;
      }
      if (d.bulk) { onBulk(d.bulk); return; }
      if (d.open && !e.target.closest("td.ck")) { openDrawer(d.open); return; }
    });
    $("cx").addEventListener("change", (e) => {
      const t = e.target;
      if (t.id === "ct-per") { S.per = Number(t.value) || 25; S.page = 1; renderTable(); return; }
      const f = t.dataset && t.dataset.f; if (!f) return;
      if (f === "sort") { S.sort = t.value; S.menu = null; S.page = 1; renderBar(); renderTable(); return; }
      if (f === "mkt" || f === "studio") { S[f] = t.value; refilter(); return; }
      if (t.checked) { if (!S[f].includes(t.value)) S[f].push(t.value); } else S[f] = S[f].filter((x) => x !== t.value);
      refilter();
    });
    // A click anywhere else closes an open filter menu.
    // (A target the list has just redrawn away is ignored: that click was the menu's own button.)
    document.addEventListener("click", (e) => { if (S.menu && e.target.isConnected && !e.target.closest("#ct-dds")) { S.menu = null; renderBar(); } });
    window.addEventListener("resize", () => placeMenu());
    document.querySelector(".ash-content")?.addEventListener("scroll", () => placeMenu(), { passive: true });

    // ---- Bulk actions ----
    async function onBulk(k) {
      if (k === "all") { S.allMatching = true; renderTable(); renderBulk(); return; }
      if (k === "clear") { S.sel.clear(); S.allMatching = false; S.step = null; renderTable(); renderBulk(); return; }
      if (k === "add" || k === "remove" || k === "delete") { S.step = S.step === k ? null : k; renderBulk(); return; }
      if (k === "step-cancel") { S.step = null; renderBulk(); return; }
      if (k === "email") { toast("One-off emails to a group come with the Email suite. For now, send from each card.", 4000); return; }
      if (k === "export") { exportCsv(selectedRows()); return; }
      if (k === "merge") { const r = selectedRows(); if (r.length === 2) openMerge(r[0], r[1]); return; }
      if (k === "tag-go") {
        const tag = $("ct-bulk-tag")?.value; if (!tag) { toast("Pick a tag first."); return; }
        /* A tag that starts an automation starts it for everyone tagged, so
           say which first and wait for a second press (Danielle, 12 Nov). */
        if (S.step === "add" && S.armed !== tag) {
          const fs = funnelsFor(tag);
          if (fs.length) {
            const n = selectedRows().filter((c) => !(c.tags || []).includes(tag)).length;
            S.armed = tag;
            const m = $("ct-bulk-msg");
            if (m) { m.className = "note warn"; m.textContent = `This starts ${fs.map((a) => a.name || "an automation").join(" and ")} for ${n === 1 ? "this person" : "all " + n.toLocaleString("en-GB") + " of them"}, and its emails will go out. Press Add tag again to go ahead.`; }
            return;
          }
        }
        S.armed = null;
        await bulkTag(S.step, tag); return;
      }
      if (k === "delete-go") { await bulkDelete(); return; }
    }
    /* Add or take off one tag across everyone selected, through the same rules
       as the card. Each person's row is written and read back; the count says
       only what the database confirmed. */
    // Live automations a tag starts: "tag added" ones for that tag, and
    // audience funnels that include it (the same rule fireTrigger uses).
    function funnelsFor(tag) {
      return AUTOS.filter((a) => {
        const tc = a.trigger_config || {};
        if (a.trigger_type === "tag_added") return !tc.tag || tc.tag === tag;
        if (a.trigger_type === "audience") return Array.isArray(tc.tags) && tc.tags.includes(tag);
        return false;
      });
    }
    async function bulkTag(mode, tag) {
      const rows = selectedRows();
      const work = rows.filter((c) => mode === "add" ? !(c.tags || []).includes(tag) : (c.tags || []).includes(tag));
      if (!work.length) { toast(mode === "add" ? "They all have that tag already." : "None of them has that tag."); return; }
      document.querySelectorAll("#ct-bulk-step button, #ct-bulk-step select").forEach((x) => { x.disabled = true; });
      let done = 0, failed = 0;
      const msg = $("ct-bulk-msg");
      await pool(work, 6, async (c) => {
        const next = normalizeTags(mode === "add" ? [...(c.tags || []), tag] : (c.tags || []).filter((t) => t !== tag));
        const { data, error } = await supabase.from("contacts").update({ tags: next }).eq("id", c.id).select("id, tags").maybeSingle();
        if (error || !data) { failed++; return; }
        c.tags = data.tags || next; done++;
        if (msg) msg.textContent = `${done} of ${work.length} done`;
        await fire(mode === "add" ? "tag_added" : "tag_removed", c, { tag });
      });
      S.step = null; renderList();
      const what = mode === "add" ? `Added ${tag} to` : `Took ${tag} off`;
      toast(failed ? `${what} ${done} of ${work.length}. ${failed} didn't save; try again.` : `${what} ${done} ${done === 1 ? "contact" : "contacts"}.`, 4000);
    }
    async function bulkDelete() {
      const ids = selectedRows().map((c) => c.id);
      if (!ids.length) return;
      document.querySelectorAll("#ct-bulk button").forEach((x) => { x.disabled = true; });
      const gone = new Set();
      for (let i = 0; i < ids.length; i += 200) {
        const { data, error } = await supabase.from("contacts").delete().in("id", ids.slice(i, i + 200)).select("id");
        if (error) break;
        (data || []).forEach((r) => gone.add(r.id));
      }
      ALL = ALL.filter((c) => !gone.has(c.id));
      gone.forEach((id) => { S.sel.delete(id); PROFILES.delete(id); });
      if (gone.size === ids.length) { S.sel.clear(); S.allMatching = false; }
      S.step = null; renderList();
      toast(gone.size === ids.length ? `${gone.size} ${gone.size === 1 ? "contact" : "contacts"} deleted.` : `${gone.size} of ${ids.length} deleted. The rest didn't go; try again.`, 4000);
    }

    // =========================================================================
    // The contact card
    // =========================================================================
    let CS = null;           // card state: { id, d (loaded data), tab, editing, confirm, send, ntOpen, ntab, addMode, err }
    let SEND_TPLS = null;
    const cardContact = () => CS && ALL.find((c) => c.id === CS.id);

    async function fetchProfiles(id) {
      if (!WORKER) return null;
      try {
        const t = await token();
        const r = await fetch(`${WORKER}/agent/profile?contact_id=${encodeURIComponent(id)}`, { headers: t ? { Authorization: "Bearer " + t } : {} });
        if (!r.ok) return null;
        const j = await r.json().catch(() => ({}));
        return Array.isArray(j.profiles) ? j.profiles : (j.profile ? [j.profile] : []);
      } catch (_) { return null; }
    }
    async function fetchLastLogin(uid) {
      if (!WORKER || !uid) return null;
      try {
        const t = await token();
        const r = await fetch(`${WORKER}/contacts/member-login?user_id=${encodeURIComponent(uid)}`, { headers: t ? { Authorization: "Bearer " + t } : {} });
        const j = await r.json().catch(() => ({}));
        return { at: j.last_sign_in_at || null };
      } catch (_) { return null; }
    }
    // Every email we've sent them: by their card, or by their address.
    async function fetchEmails(c) {
      const cols = "id, contact_id, email, event, provider, message_id, subject, detail, occurred_at";
      const qs = [supabase.from("email_events").select(cols).eq("contact_id", c.id).order("occurred_at", { ascending: false }).limit(1000)];
      if (c.email) qs.push(supabase.from("email_events").select(cols).ilike("email", c.email).order("occurred_at", { ascending: false }).limit(1000));
      const res = await Promise.all(qs);
      const seen = new Map();
      res.forEach((r) => (r.data || []).forEach((x) => {
        if (x.contact_id !== c.id && lc(x.email) !== lc(c.email)) return;
        seen.set(x.id, x);
      }));
      return [...seen.values()];
    }

    // Keeps the list's copy of someone's brands in step with what the card just saved.
    function setProfiles(c, rows) {
      CS && CS.id === c.id && (CS.d.profiles = rows);
      PROFILES.set(c.id, (rows || []).map((p) => ({ id: p.id, contact_id: c.id, brand: p.brand, left_at: p.left_at, is_primary: p.is_primary, job_title: p.job_title, area: p.area, postcode: p.postcode })));
    }

    async function openDrawer(id) {
      const c = ALL.find((x) => x.id === id); if (!c) return;
      const same = CS && CS.id === id;
      if (!same) CS = { id, d: null, tab: null, editing: null, confirm: null, send: false, ntOpen: false, ntab: "notes", addMode: "note", err: "", pendingType: null };
      $("ct-scrim").hidden = false; $("ct-drawer").hidden = false;
      if (!same || !CS.d) $("ct-drawer-body").innerHTML = `<p class="state">Opening ${esc(fullName(c))}'s card.</p>`;
      const email = c.email || "";
      const none = Promise.resolve({ data: [] });
      const [notes, tasks, ord, vidb, smmb, profiles, consent, emails, login] = await Promise.all([
        supabase.from("contact_notes").select("*").eq("contact_id", id).order("created_at", { ascending: false }),
        supabase.from("contact_tasks").select("*").eq("contact_id", id).order("created_at", { ascending: false }),
        email ? supabase.from("orders").select("id, pack_title, amount_pence, status, created_at").ilike("buyer_email", email).order("created_at", { ascending: false }) : none,
        email ? supabase.from("videography_bookings").select("id, service, service_type, kind, shoot_date, stage, created_at").ilike("client_email", email).order("created_at", { ascending: false }) : none,
        email ? supabase.from("smm_leads").select("*").ilike("email", email).order("created_at", { ascending: false }) : none,
        fetchProfiles(id),
        supabase.from("contact_consent_events").select("action, basis, source, occurred_at").eq("contact_id", id).order("occurred_at", { ascending: false }),
        fetchEmails(c).catch(() => []),
        c.user_id && !META ? fetchLastLogin(c.user_id) : Promise.resolve(null),
      ]);
      if (!CS || CS.id !== id) return;   // moved on to someone else meanwhile
      CS.d = {
        notes: (notes && notes.data) || [], tasks: (tasks && tasks.data) || [],
        orders: (ord && ord.data) || [], vrows: (vidb && vidb.data) || [], srows: (smmb && smmb.data) || [],
        profiles: profiles || profilesOf(c), profilesFailed: profiles === null,
        crows: (consent && consent.data) || [], emails: emails || [], lastLogin: login,
      };
      if (profiles) setProfiles(c, profiles);
      renderCard();
    }
    function closeDrawer() {
      $("ct-scrim").hidden = true; $("ct-drawer").hidden = true; CS = null;
      // In a pop-out, closing the card closes the pop-out.
      if (EMBED) try { parent.postMessage({ type: "tmke-contact-closed" }, location.origin); } catch (_) {}
    }
    $("ct-scrim").addEventListener("click", closeDrawer);

    function box(title, body, o = {}) {
      if (o.fold) {
        return `<div class="box"><div class="bh"><span class="bh-t">${title}</span><div class="bh-a"><button type="button" class="mbtn" data-act="fold" aria-expanded="${!!o.open}">${o.open ? "Hide" : "Show"}</button></div></div>${o.open ? `<div class="bb">${body}</div>` : ""}</div>`;
      }
      return `<div class="box${o.editing ? " editing" : ""}"${o.id ? ` id="${o.id}"` : ""}><div class="bh"><span class="bh-t">${title}</span>${o.head ? `<div class="bh-a">${o.head}</div>` : ""}</div><div class="bb">${body}</div>${o.foot ? `<div class="bf">${o.foot}</div>` : ""}</div>`;
    }
    const row = (l, v, opts = {}) => `<div class="sw"><div>${l}</div><div class="v${v ? "" : " none"}">${v ? (opts.html ? v : esc(v)) : "Not given"}</div></div>`;
    const fld = (id, l, v, t = "text", extra = "") => `<label class="field"><span>${l}</span><input id="${id}" type="${t}" value="${esc(v ?? "")}" ${extra}></label>`;
    const editFoot = (key) => `<span class="err" id="ct-err-${key}">${esc(CS.err || "")}</span><button type="button" class="mbtn" data-act="cancel">Cancel</button><button type="button" class="mbtn primary" data-act="save" data-box="${key}">Save</button>`;

    // What happened, newest first: worked out from orders, bookings, consent and account emails.
    const VID_ACT = { booking: "Booked a videography session", discovery: "Booked a videography discovery call", brochure: "Downloaded the videography brochure", enquiry: "Made a videography enquiry", register_interest: "Registered interest in the Content Studio" };
    const SMM_ACT = { discovery: "Booked a social media discovery call", brochure: "Downloaded the social media brochure", enquiry: "Made a social media enquiry" };
    const CONSENT_SRC = {
      newsletter_footer: "the newsletter box", join_signup: "the member signup form", contact_form: "the contact form",
      videography: "a videography enquiry", videography_brochure: "the videography brochure form",
      videography_discovery: "a videography discovery call", videography_register_interest: "the Content Studio interest form",
      smm_enquiry: "a social media enquiry", smm_brochure: "the social media brochure form", smm_discovery: "a social media discovery call",
      csv_import: "a contact import", admin_toggle: "an admin, by hand", merge: "a contact merge",
      footer_link: "the unsubscribe link", list_unsubscribe: "the Gmail or Outlook unsubscribe button",
      spam_complaint: "a spam complaint", resubscribe: "the resubscribe link",
    };
    function consentLabel(e) {
      const via = CONSENT_SRC[e.source] || e.source;
      if (e.action === "opted_out") return `Unsubscribed from marketing, via ${via}`;
      if (e.source === "teg_auto") return "Opted in to marketing automatically, as a TEG network member (not an act of consent)";
      if (e.source === "admin_toggle") return "Opted in to marketing by an admin, by hand (not an act of consent)";
      if (e.source === "backfill") return "Opted in to marketing before the audit trail existed, original route unknown";
      return `Opted in to marketing, via ${via}`;
    }
    const acctWhat = (subj) => /invited you to the TMKE Studio/i.test(subj || "") ? "Studio invite email" : /confirm/i.test(subj || "") ? "Confirmation email" : /password/i.test(subj || "") ? "Password reset email" : "Account email";
    function activityOf(c, d) {
      const since = memberSince(c), last = lastSignIn(c) || (d.lastLogin && d.lastLogin.at);
      return [
        { when: c.created_at, label: `Added to Contacts${c.source ? ", from " + humanizeSource(c.source).toLowerCase() : ""}` },
        ...d.orders.map((o) => ({ when: o.created_at, label: `Bought ${o.pack_title || "a pack"}${o.amount_pence != null ? " (" + gbp(o.amount_pence) + ")" : ""}` })),
        ...d.vrows.map((b) => ({ when: b.created_at || b.shoot_date, label: VID_ACT[b.kind] || "Videography activity" })),
        ...d.srows.map((b) => ({ when: b.created_at || b.call_at, label: SMM_ACT[b.kind] || "Social media activity" })),
        ...d.crows.map((e) => ({ when: e.occurred_at, label: consentLabel(e) })),
        ...d.emails.filter((e) => e.provider === "m365").map((e) => e.event === "sent"
          ? { when: e.occurred_at, label: `${acctWhat(e.subject)} sent, from hello@tmke.co.uk` }
          : { when: e.occurred_at, label: `${acctWhat(e.subject)} failed: ${e.detail || "Microsoft 365 didn't accept it"}`, bad: true }),
        since ? { when: since, label: "Made a Studio account" } : null,
        last ? { when: last, label: "Last signed in to the Studio" } : null,
      ].filter((a) => a && a.when).sort((a, b) => new Date(b.when) - new Date(a.when));
    }
    // One row per email: grouped by the provider's id, or by subject and day.
    function groupEmails(rows) {
      const g = new Map();
      rows.forEach((r) => {
        const key = r.message_id || ("s:" + (r.subject || "") + "|" + String(r.occurred_at || "").slice(0, 10));
        let e = g.get(key);
        if (!e) { e = { subject: "", provider: r.provider, at: r.occurred_at, ev: new Set() }; g.set(key, e); }
        if (!e.subject && r.subject) e.subject = r.subject;
        if (r.occurred_at && (!e.at || new Date(r.occurred_at) < new Date(e.at))) e.at = r.occurred_at;
        e.ev.add(r.event);
      });
      return [...g.values()].sort((a, b) => new Date(b.at) - new Date(a.at));
    }
    function furthest(e) {
      const h = (x) => e.ev.has(x);
      if (h("clicked")) return ["good", "Clicked"];
      if (h("opened")) return ["wait", "Opened"];
      if (h("bounced") || h("suppressed")) return ["bad", "Bounced"];
      if (h("complained")) return ["bad", "Marked as spam"];
      if (h("delivered")) return ["plain", "Delivered"];
      if (h("sent") || h("delivery_delayed")) return ["plain", "Sent"];
      if (h("blocked") || h("failed")) return ["bad", "Not sent"];
      return ["plain", "Sent"];
    }
    const notSent = (e) => !["sent", "delivered", "delivery_delayed", "opened", "clicked", "bounced", "complained", "suppressed"].some((x) => e.ev.has(x));
    const emailKind = (e) => e.provider === "m365" ? acctWhat(e.subject) : e.provider === "internal" ? "Internal" : "Email";

    function taskWho(t) { if (t.assigned_to) return t.assigned_to; const m = /^For (\w+)/.exec(t.detail || ""); return m ? m[1] : ""; }

    function renderCard() {
      const c = cardContact(); if (!c || !CS || !CS.d) return;
      const d = CS.d;
      const body = $("ct-drawer-body");
      const keep = body.scrollTop;
      const ntKeep = $("ct-ntscroll") ? $("ct-ntscroll").scrollTop : 0;
      const ntWas = CS._ntab;
      const rows = d.profiles || [];
      const prim = mainOf(rows);
      const [hb, hf] = nameBoxColours(prim && prim.brand);
      const ty = isSupport(c) ? "support" : liveOf(rows).length ? "agent" : "external";
      const studio = studioOf(c);

      // ---- name box ----
      const eye = prim ? `${prim.brand} · ${prim.job_title || (ty === "support" ? "Management or support" : "Agent")}` : (c.company || "External");
      let html = `
        <div class="ph" style="--hb:${hb};--hf:${hf}">
          <div style="min-width:0">
            <p class="ph-eye">${esc(eye)}</p>
            <div class="ph-name">${esc(fullName(c))}</div>
            <div class="ph-line">${esc(c.email || "")}${c.phone ? " · " + esc(c.phone) : ""}</div>
          </div>
          <div class="ph-acts">
            <button type="button" class="mbtn" data-act="send-toggle">Send email</button>
            <button type="button" class="mbtn" data-act="more">More</button>
          </div>
        </div>`;
      if (CS.confirm === "more") html += `<div class="confirm plain"><p>More for ${esc(c.first_name || fullName(c))}</p><div><button type="button" class="mbtn" data-act="merge-pick">Merge with another card</button><button type="button" class="mbtn danger" data-act="ask-delete">Delete contact</button><button type="button" class="mbtn" data-act="noconfirm">Close</button></div></div>`;
      if (CS.confirm === "mergepick") html += `<div class="confirm plain"><p>Merge ${esc(c.first_name || fullName(c))} with another card. Find the other one:</p><div><input type="search" id="ct-mp-q" placeholder="Search name or email" aria-label="Find the other card" autocomplete="off"><button type="button" class="mbtn" data-act="noconfirm">Close</button></div><div class="picks" id="ct-mp-res"></div></div>`;
      if (CS.confirm === "delete") html += `<div class="confirm"><p>Delete ${esc(fullName(c))}? Their notes, tasks and brands go too. Orders and bookings stay, without the link to this card. This can't be undone.</p><div><button type="button" class="mbtn" data-act="noconfirm">Keep them</button><button type="button" class="mbtn primary" data-act="delete">Delete</button></div></div>`;
      if (CS.send) html += sendBoxHtml();

      // ---- needs attention ----
      if (c.needs_review) {
        const others = ALL.filter((x) => x.id !== c.id && lc(x.email) && lc(x.email) === lc(c.email));
        if (others.length) others.forEach((o) => { html += `<div class="attn"><span>Possible duplicate of <b>${esc(fullName(o))}</b> (${esc(o.email)}).</span><span class="sp"></span><button type="button" class="mbtn small" data-act="mergewith" data-id="${esc(o.id)}">Merge</button><button type="button" class="mbtn small" data-act="dup-clear">Not the same person</button></div>`; });
        else html += `<div class="attn"><span>${esc(c.review_reason || "Flagged for review as a possible duplicate.")}</span><span class="sp"></span><button type="button" class="mbtn small" data-act="dup-clear">Done</button></div>`;
      }
      if (c.suppressed_at) html += `<div class="attn"><span>Emails to ${esc(c.email)} have stopped: ${esc(SUPP_REASON[c.suppression_reason] || c.suppression_reason || "the address doesn't take email")}.</span><span class="sp"></span><button type="button" class="mbtn small" data-act="edit" data-box="details">Change email</button></div>`;
      else if ((Number(c.soft_bounce_count) || 0) > 0) html += `<div class="attn"><span>Emails to ${esc(c.email)} are bouncing.</span><span class="sp"></span><button type="button" class="mbtn small" data-act="edit" data-box="details">Change email</button></div>`;
      if (c.user_id && rows.length && rows.every((p) => p.left_at)) html += `<div class="attn"><span>They've left every brand they were at, and still have a Studio account.</span></div>`;

      // ---- details + studio and email ----
      html += `<div class="row2">${detailsBox(c, prim, ty)}${commsBox(c, studio)}</div>`;
      html += brandsBox(c, rows, ty);
      html += tagsBox(c);
      html += boughtBox(c, d, rows);
      html += notesBox(c, d);
      body.innerHTML = html;
      body.scrollTop = keep;
      const sc = $("ct-ntscroll"); if (sc && ntWas === CS.ntab) sc.scrollTop = ntKeep;
      CS._ntab = CS.ntab;
      if (CS.confirm === "mergepick") { const q = $("ct-mp-q"); if (q) { q.focus(); paintMergePicks(""); } }
    }
    const SUPP_REASON = { hard_bounce: "the address bounced permanently", spam_complaint: "they reported an email as spam", resend_suppressed: "the email provider blocked it", repeated_soft_bounce: "it kept soft-bouncing", admin: "an admin stopped them" };
    const UNSUB_SRC = { footer_link: "using the unsubscribe link", list_unsubscribe: "using the Gmail or Outlook unsubscribe button", spam_complaint: "by reporting an email as spam", admin: "by an admin", import: "on import" };

    function detailsBox(c, prim, ty) {
      if (CS.editing === "details") {
        const curType = CS.pendingType || ty;
        const body = `<div class="facts">
            ${fld("f-first", "First name", c.first_name)}${fld("f-last", "Last name", c.last_name)}
            ${fld("f-email", "Email", c.email, "email")}${fld("f-phone", "Phone", c.phone, "tel")}
            ${fld("f-company", "Company", c.company)}
            <label class="field"><span>Type</span><select id="f-type">${Object.entries(TYPES).map(([k, l]) => `<option value="${k}" ${curType === k ? "selected" : ""}>${l}</option>`).join("")}</select></label>
            ${fld("f-sec", "Second email", c.secondary_email, "email", 'placeholder="For funnel emails only"')}
            <label class="field"><span>Stage</span><select id="f-stage"><option value="auto" ${c.lifecycle !== "past" ? "selected" : ""}>Worked out for them</option><option value="past" ${c.lifecycle === "past" ? "selected" : ""}>Past</option></select></label>
          </div>
          <p class="note" id="f-email-note" hidden></p>
          <div id="f-confirm"></div>`;
        return box("Details", body, { editing: true, foot: editFoot("details") });
      }
      const body = `<div>
          ${row("Email", c.email)}
          ${c.secondary_email ? row("Second email", c.secondary_email) : ""}
          ${row("Phone", c.phone)}
          ${row("Company", c.company || (prim && prim.brand))}
          ${row("Type", TYPES[ty])}
          ${row("Stage", STAGES[stageOf(c)])}
          ${row("Came from", humanizeSource(c.source))}
          ${row("Added", short(c.created_at))}
        </div>`;
      return box("Details", body, { head: CS.editing ? "" : `<button type="button" class="mbtn" data-act="edit" data-box="details">Edit</button>` });
    }

    function commsBox(c, studio) {
      const d = CS.d;
      const notesSayInvited = (d.notes || []).some((n) => /^Invited to the Studio/.test(n.body || ""));
      const last = lastSignIn(c) || (d.lastLogin && d.lastLogin.at);
      // Without the Worker's answer, an invite is read from the card's own note, as it was before.
      const invited = studio === "invited" || (!META && c.user_id && notesSayInvited && !last);
      let srow;
      if (c.user_id && !invited) {
        const since = memberSince(c);
        const bits = ["Linked."];
        if (since) bits.push(`Member since ${short(since)}.`);
        bits.push(last ? `Last in ${ago(last).toLowerCase()}.` : (META || d.lastLogin ? "Not signed in yet." : ""));
        srow = `<div class="sw tall"><div>Studio account<small>${esc(bits.filter(Boolean).join(" "))}</small></div><span class="chip good">Has account</span></div>`;
      } else if (invited) {
        const exp = meta(c) && meta(c).invite_expires;
        srow = `<div class="sw tall"><div>Studio account<small>Invited, not set up yet.${exp ? ` The link works until ${esc(short(exp))}.` : ""}</small></div><button type="button" class="mbtn small" data-act="invite-ask">Send again</button></div>`;
      } else {
        srow = `<div class="sw tall"><div>Studio account<small>None yet. We make the account and email them a link to choose a password. <button type="button" class="lnk" data-act="acct-check">Check for an account first</button></small></div><button type="button" class="mbtn small primary" data-act="invite-ask">Invite to the Studio</button></div>`;
      }
      const confirmInvite = CS.confirm === "invite" ? `<div class="confirm plain"><p>Send ${esc(fullName(c))} an invite to the Studio at ${esc(c.email || "")}?</p><div><button type="button" class="mbtn" data-act="noconfirm">Cancel</button><button type="button" class="mbtn primary" data-act="invite-send">Send invite</button></div></div>` : "";
      const unsub = isUnsub(c);
      const soft = Number(c.soft_bounce_count) || 0;
      const health = c.suppressed_at
