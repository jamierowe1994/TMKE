          <div class="photo-side">
            <span class="note">Brand-approved photo. Full length, no background. The only photo print uses.</span>
            <input type="text" id="bf-photo" value="${esc(photo)}" placeholder="Paste a link, or click the tile to upload" aria-label="Photo link">
            <div class="addrow"><button type="button" class="mbtn small" data-act="photo-upload">Upload</button><button type="button" class="mbtn small" data-act="photo-clear"${photo ? "" : " hidden"} id="bf-clear">Remove photo</button>${pulls.map((r) => `<button type="button" class="mbtn small" data-act="pull-edit" data-id="${esc(r.id)}">Pull from ${esc(r.brand)}</button>`).join("")}</div>
            <span class="note" id="bf-photo-msg"></span>
