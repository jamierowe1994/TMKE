---
// How to… Reporting (Dani, 20 Oct 2026): the team's own training for the
// monthly social media report, for Sam and Abbie. In the admin centre only
// (Social media › Settings › How to… › Reporting), so it sits behind the admin
// login and no client ever sees it.
//
// The screenshots are a local build of the Social media section with dummy
// clients (Rimberio Homes on three platforms, Borcelle Estates on Instagram
// alone), never a real client's figures; the client's side is the training
// account. The sample management report was pulled from the same dummy data
// by the real code. The rules behind the commentary are
// docs/smm-report-rules.md: change them there first, then here.
//
// Long screenshots open in a pop-out you scroll (Dani's review, 20 Oct), as
// the course pictures do; the management report opens as a working example.
import AdminShell from "../../../components/admin/AdminShell.astro";

const IMG = "/images/admin/how-to/reporting";
const PDF = `${IMG}/management-report-sample-v2.pdf`;
const CLIENT_PDF = `${IMG}/client-report-sample.pdf`;
// The six parts, named as the contents boxes name them (Dani, 20 Oct).
const PARTS = [
  ["in", "Pulling the report"],
  ["what", "Report contents"],
  ["commentary", "Client commentary"],
  ["publish", "Publishing the report"],
  ["management", "Management report"],
  ["client", "Client view"],
];
// The process, start to finish, as one row.
const STEPS = [
  ["Generate the report", "Download the client&rsquo;s monthly report from SocialPilot once the reporting period has ended."],
  ["Upload to the Hub", "Open the client&rsquo;s profile and head to Insights."],
  ["Review the figures", "Check the imported data against the original SocialPilot report before saving."],
  ["Review the Management Summary", "Check the internal analysis of the month&rsquo;s performance."],
  ["Refine the client commentary", "Review and edit the generated client commentary."],
  ["Publish the report", "Make the finished report available to both management and the client."],
  ["Generate the management report", "Once all client reports have been published, bring the month&rsquo;s results together."],
];
const esc = (s) => String(s).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
// A row with a strip of the picture; the whole picture opens in the pop-out.
const shot = (id, title, line, src, alt) => `<button type="button" class="ht-shot" data-ht-open="${id}">
    <img class="ht-shot-img" src="${IMG}/${src}" alt="" loading="lazy">
    <span class="ht-shot-tx"><span class="ht-shot-t">${title}</span><span class="ht-shot-b">${line}</span></span>
    <span class="ht-shot-go">Take a look &rarr;</span>
  </button><template id="${id}"><h3 class="ht-sheet-h">${title}</h3><img class="ht-sheet-img" src="${IMG}/${src}" alt="${esc(alt)}"></template>`;
// Two pictures side by side in one pop-out, each with its caption.
const shotPair = (id, title, line, pics) => `<button type="button" class="ht-shot" data-ht-open="${id}">
    <img class="ht-shot-img" src="${IMG}/${pics[0][0]}" alt="" loading="lazy">
    <span class="ht-shot-tx"><span class="ht-shot-t">${title}</span><span class="ht-shot-b">${line}</span></span>
    <span class="ht-shot-go">Take a look &rarr;</span>
  </button><template id="${id}"><h3 class="ht-sheet-h">${title}</h3><div class="ht-sheet-pair">${pics.map(([src, cap]) => `<figure><img class="ht-sheet-img" src="${IMG}/${src}" alt="${esc(cap)}"><figcaption>${cap}</figcaption></figure>`).join("")}</div></template>`;
---

<AdminShell active="social" title="How to… Reporting" skin="hub">
  <div class="ht">
    <header class="ht-head">
      <a class="ht-back" href="/admin/social">&larr; Social media</a>
      <p class="ht-eyebrow">How to&hellip;</p>
      <h1 class="ht-title">Reporting</h1>
      <p class="ht-lede">From SocialPilot to the Member Hub, this guide walks you through preparing, reviewing and publishing each client&rsquo;s monthly social media report, before bringing everything together in TMKE&rsquo;s management report.</p>
      <p class="ht-lede ht-lede--note">For internal TMKE use only. Clients cannot access this guide.</p>
    </header>

    <!-- The process as a flow, then the six parts as boxes to jump to, in one
         white box (Dani, 20 Oct). -->
    <section class="ht-top" aria-label="The process and contents">
      <h2 class="ht-sub">The process</h2>
      <ol class="ht-flow">
        {STEPS.map(([t, b], i) => (
          <li class="ht-flow-step">
            <span class="ht-flow-n">{i + 1}</span>
            <span class="ht-flow-t" set:html={t} />
            <span class="ht-flow-b" set:html={b} />
          </li>
        ))}
      </ol>
      <h2 class="ht-sub">Contents</h2>
      <nav class="ht-parts" aria-label="Parts">
        {PARTS.map(([id, label], i) => (
          <a class="ht-part-box" href={`#${id}`}>
            <span class="ht-part-box-n">Part {String(i + 1).padStart(2, "0")}</span>
            <span class="ht-part-box-t">{label}</span>
          </a>
        ))}
      </nav>
    </section>

    <!-- ── 01 ─────────────────────────────────────────────────────────── -->
    <section class="ht-part" id="in">
      <p class="ht-num">Part 01</p>
      <h2 class="ht-h">Pulling the report</h2>

      <h3 class="ht-sub">From SocialPilot</h3>
      <p class="ht-p">Run the client&rsquo;s report in SocialPilot for the month just gone and download it as a PDF.</p>
      <div class="ht-why">
        <p class="ht-why-k">Why straight after the month ends</p>
        <p>SocialPilot&rsquo;s follower total is the count on the day you run the report, not on the last day of the month. A report run four weeks late shows four weeks of someone else&rsquo;s month. That&rsquo;s why the report never compares follower totals between months: growth is shown as the month&rsquo;s new followers.</p>
      </div>

      <h3 class="ht-sub">Find the client</h3>
      <p class="ht-p">Use the admin centre to open the client&rsquo;s <b>social media</b> account. An active client&rsquo;s file has six tabs, and reporting lives on <b>Insights</b>.</p>
      <Fragment set:html={shot("ht-board", "The Social Media Board", "Filtered to clients: click a card to open the client&rsquo;s file.", "board.webp", "The Social media board filtered to clients")} />
      <Fragment set:html={shot("ht-file", "A Client&rsquo;s File", "Rimberio Homes&rsquo; file, open on the Insights tab.", "client-file.webp", "A client's file open on the Insights tab")} />

      <h3 class="ht-sub">Upload the PDF</h3>
      <ol class="ht-ol">
        <li>On Insights, click <b>Upload report</b>.</li>
        <li>Pick the <b>Month</b> and <b>Year</b> the report covers.</li>
        <li>Choose the PDF under <b>SocialPilot PDF</b>.</li>
      </ol>
      <Fragment set:html={shotPair("ht-upload", "Upload a Monthly Report", "The window with the PDF chosen, then once it&rsquo;s been read into JSON.", [["upload-chosen.webp", "The PDF chosen: it starts reading straight away."], ["upload-read-v2.webp", "Read: the month as JSON, ready to check."]])} />
      <p class="ht-p">Two things happen at once, and take a few seconds:</p>
      <ul class="ht-ul">
        <li><b>The figures.</b> The PDF goes to Claude, which reads the pages and charts and writes the month out as JSON in the <b>Report JSON</b> box.</li>
        <li><b>The posts.</b> Each post&rsquo;s link and picture are taken from the PDF and matched to its row, so the client can see and open their best posts.</li>
      </ul>
      <p class="ht-p">You&rsquo;ll see <i class="ht-ui">Reading the PDF with Claude…</i>, then <i class="ht-ui">Adding each post&rsquo;s link and picture…</i>, then <i class="ht-ui">Read ✓ … Check the figures below, then save.</i></p>

      <h3 class="ht-sub">What the JSON is, and what to check</h3>
      <p class="ht-p">JSON is just the report written out as data: every figure with a name. It also holds a first read of the month and a plan for next month, which become the Management Summary.</p>
      <p class="ht-p">You don&rsquo;t need to read all of it, but before you save, check three or four headline figures against the PDF: <b>followers</b>, <b>reach</b>, <b>views</b> and <b>posts published</b>. If one is wrong, close the window and upload again.</p>
      <div class="ht-why">
        <p class="ht-why-k">Why check at all</p>
        <p>Everything the client reads is built from these figures. A misread number here becomes a wrong sentence in their report. Instagram Stories pages are skipped on purpose: they only cover the last 24 hours, not the month.</p>
      </div>
      <p class="ht-p">Then click <b>Save report</b>. As soon as it&rsquo;s saved, the client commentary is drafted for you: <i class="ht-ui">Saved. Writing a first draft of the client commentary…</i></p>

      <h3 class="ht-sub">A client on more than one platform</h3>
      <p class="ht-p">Where possible, we recommend including all of a client&rsquo;s social media accounts in a single SocialPilot report. However, you can also generate and upload separate reports for each platform.</p>
      <p class="ht-p">Each upload updates only the relevant platform, keeping the others and any existing commentary intact. If commentary has already been written, you&rsquo;ll be asked whether you&rsquo;d like to regenerate it to include the newly added platform.</p>

      <h3 class="ht-sub">If something goes wrong</h3>
      <table class="ht-table">
        <thead><tr><th>You see</th><th>What to do</th></tr></thead>
        <tbody>
          <tr><td>Couldn&rsquo;t read the PDF: try again or paste the JSON.</td><td>Upload it again. If it fails twice, tell Danni.</td></tr>
          <tr><td>That doesn&rsquo;t look like valid JSON.</td><td>Something in the box was changed by mistake: a missing comma or quote. Upload the PDF again to start clean.</td></tr>
          <tr><td>Couldn&rsquo;t read the AI output.</td><td>Try again: it&rsquo;s a one-off.</td></tr>
          <tr><td>Admins only.</td><td>You&rsquo;ve been signed out. Sign in to the admin centre again.</td></tr>
        </tbody>
      </table>
    </section>

    <!-- ── 02 ─────────────────────────────────────────────────────────── -->
    <section class="ht-part" id="what">
      <p class="ht-num">Part 02</p>
      <h2 class="ht-h">Report contents</h2>
      <p class="ht-p">Once saved, the month appears as a pill above the tabs. A dot on a pill means the client can see that month. Hover over one to see where it stands: <i class="ht-ui">Draft: the client can&rsquo;t see this yet</i>, <i class="ht-ui">Live in the client&rsquo;s hub</i>, or <i class="ht-ui">Live, with changes the client can&rsquo;t see yet</i>.</p>
      <p class="ht-p"><b>Overview</b>, <b>Content</b>, <b>Audience</b> and <b>Trends</b> are our working figures, straight from SocialPilot. The client doesn&rsquo;t see these tabs, but their report is built from them.</p>

      <h3 class="ht-sub">How platforms are displayed</h3>
      <p class="ht-p">&ldquo;In this report&rdquo; shows which social media platforms are included in the month&rsquo;s report.</p>
      <p class="ht-p">Each platform has its own section, displayed one after another. If a client only uses Instagram, you&rsquo;ll see one section. If they use Instagram, Facebook and LinkedIn, you&rsquo;ll see all three within the same report.</p>
      <Fragment set:html={shot("ht-ov-single", "One Platform: Borcelle Estates", "Instagram only.", "overview-single-full.webp", "Overview for a client on Instagram only")} />
      <Fragment set:html={shot("ht-ov-multi", "Several Platforms: Rimberio Homes", "Instagram, then Facebook, then LinkedIn, on one Overview.", "overview-multi-full.webp", "Overview for a client on three platforms")} />

      <h3 class="ht-sub">Content, Audience and Trends</h3>
      <ul class="ht-ul">
        <li><b>Content</b>: a breakdown of the month&rsquo;s posts and reels, including their performance and best-performing content.</li>
        <li><b>Audience</b>: insights into who follows the account, including audience demographics and locations.</li>
        <li><b>Trends</b>: a comparison of the current month&rsquo;s performance against the previous two months, helping you identify changes and patterns over time.</li>
      </ul>
      <div class="ht-trio">
        <figure class="ht-fig"><img src={`${IMG}/content-v2.webp`} alt="The Content tab" loading="lazy" /><figcaption>Content</figcaption></figure>
        <figure class="ht-fig"><img src={`${IMG}/audience.webp`} alt="The Audience tab" loading="lazy" /><figcaption>Audience</figcaption></figure>
        <figure class="ht-fig"><img src={`${IMG}/trends.webp`} alt="The Trends tab" loading="lazy" /><figcaption>Trends</figcaption></figure>
      </div>

      <h3 class="ht-sub">How the client&rsquo;s report changes with it</h3>
      <p class="ht-p">The client report automatically adapts to the number of platforms included.</p>
      <p class="ht-p">For clients using a single platform, the report provides a concise overview of their performance, audience, best-performing content, key insights and recommendations for the following month.</p>
      <p class="ht-p">For clients using multiple platforms, each account has its own performance breakdown, followed by an <b>Across your accounts</b> section that brings together the overall insights and recommendations.</p>
      <p class="ht-p">Individual metrics are clearly labelled by platform, while combined figures reflect performance across all included accounts. Insights and recommendations are also labelled so clients can see which platform they relate to.</p>
    </section>

    <!-- ── 03 ─────────────────────────────────────────────────────────── -->
    <section class="ht-part" id="commentary">
      <p class="ht-num">Part 03</p>
      <h2 class="ht-h">Client commentary</h2>
      <p class="ht-p">The <b>Client Commentary</b> tab contains the written insights and recommendations that appear in the client&rsquo;s monthly report.</p>
      <p class="ht-p">The commentary is automatically drafted when you save the report, using the performance data provided. However, <b>it&rsquo;s a starting point, not a finished report</b>. Every section needs to be reviewed, refined and approved before publishing.</p>
      <div class="ht-why">
        <p class="ht-why-k">Why it always needs you</p>
        <p>The system can analyse the figures, but it doesn&rsquo;t know everything that&rsquo;s happened throughout the month.</p>
        <p>You know the client, the content we&rsquo;ve created, the decisions we&rsquo;ve made and anything else that may have influenced performance. Use that knowledge to add context, explain results and make sure the commentary accurately reflects the work we&rsquo;ve delivered.</p>
        <p><b>Nothing should be published without being reviewed by the account manager.</b></p>
      </div>
      <Fragment set:html={shot("ht-commentary", "The Client Commentary Tab", "Three cards, each with a pencil to edit. Scroll to see them all.", "commentary-full.webp", "The Client commentary tab")} />

      <h3 class="ht-sub">The three cards</h3>
      <div class="ht-cards">
        <div class="ht-card">
          <p class="ht-card-k">What it means</p>
          <p>This section brings together four headline metrics and two to four key insights explaining the month&rsquo;s performance.</p>
          <p>Each insight includes a category (What&rsquo;s Working, What We&rsquo;re Learning, One to Watch or From Last Month), a short headline, supporting analysis and the figures behind it.</p>
          <p class="ht-card-s">These appear on the client&rsquo;s <b>What It Means</b> slide, with the first insight also featured on their Your Socials page.</p>
        </div>
        <div class="ht-card">
          <p class="ht-card-k">Into next month</p>
          <p>This section outlines what we&rsquo;re planning to do next and why, based on the month&rsquo;s performance and our wider understanding of the client&rsquo;s account.</p>
          <p>Each recommendation has an internal priority label (Do More, Improve or Fix Now), which helps us organise our approach but isn&rsquo;t visible to the client.</p>
          <p class="ht-card-s">The recommendations appear as individual cards on the client&rsquo;s <b>Into Next Month</b> slide.</p>
        </div>
        <div class="ht-card">
          <p class="ht-card-k">Content coming up</p>
          <p>Add approximately six pieces of content planned for the following month, giving the client a preview of what&rsquo;s ahead.</p>
          <p>This section is completed manually rather than automatically generated. You can also attach the upcoming content plan as a PDF, where available.</p>
          <p class="ht-card-s">The client sees this beneath their recommendations, with an <b>Open the Content Plan</b> link when a document has been attached.</p>
        </div>
      </div>
      <div class="ht-trio">
        <figure class="ht-fig"><img src={`${IMG}/edit-what-it-means-v3.webp`} alt="Editing What it means" loading="lazy" /><figcaption>What it means</figcaption></figure>
        <figure class="ht-fig"><img src={`${IMG}/edit-into-next-v2.webp`} alt="Editing Into October" loading="lazy" /><figcaption>Into October</figcaption></figure>
        <figure class="ht-fig"><img src={`${IMG}/edit-coming-up-v3.webp`} alt="Editing Content coming up" loading="lazy" /><figcaption>Content coming up</figcaption></figure>
      </div>

      <h3 class="ht-sub">What to check before publishing</h3>
      <ul class="ht-check">
        <li><b>Accuracy:</b> every figure must match the report. Don&rsquo;t estimate results or exaggerate performance.</li>
        <li><b>Context:</b> only explain why something happened when there&rsquo;s evidence or relevant information to support it.</li>
        <li><b>Recommendations:</b> focus on what we&rsquo;re going to do, why we&rsquo;re doing it and what we&rsquo;re hoping to improve. Avoid promising specific results.</li>
        <li><b>Comparisons:</b> keep insights focused on the client&rsquo;s own performance, not comparisons with other clients.</li>
        <li><b>New accounts:</b> for clients in their first or second month, focus on establishing a starting point rather than drawing conclusions from limited data.</li>
        <li><b>Tone of voice:</b> write directly to the client using &ldquo;we&rdquo; and &ldquo;your&rdquo;. Keep the language professional, conversational and easy to understand.</li>
        <li><b>Presentation:</b> use British English, short paragraphs and clear language. Avoid unnecessary jargon, exclamation marks and overly promotional wording.</li>
        <li><b>Headline metrics:</b> make sure the four headline figures represent the most relevant aspects of the month&rsquo;s performance. Change them if other metrics tell the story more accurately.</li>
      </ul>
      <h3 class="ht-sub">Regenerating commentary</h3>
      <p class="ht-p">The <b>Redraft</b> option generates a completely new version of the commentary using the report data.</p>
      <p class="ht-p"><b>Be careful:</b> redrafting replaces any changes you&rsquo;ve already made. If you need to regenerate the commentary, do so before starting your manual edits.</p>

      <h3 class="ht-sub">Management Summary</h3>
      <p class="ht-p">The <b>Management Summary</b> is our internal review of each client&rsquo;s monthly performance. It brings together what we&rsquo;ve learned, what we&rsquo;re planning next, the client&rsquo;s goals and how their performance is changing over time.</p>
      <p class="ht-p">Unlike the Client Commentary, this section isn&rsquo;t intended for the client. It feeds into TMKE&rsquo;s monthly management report, giving us a consistent overview of every account, how it&rsquo;s performing and where we need to focus our attention.</p>
      <p class="ht-p ht-p--label"><b>What&rsquo;s included?</b></p>
      <ul class="ht-ul">
        <li><b>What It Means:</b> AI-generated insights explaining the month&rsquo;s performance, with a separate analysis for each platform. Review the findings, check their accuracy and add any relevant context.</li>
        <li><b>Into Next Month:</b> AI-generated recommendations for what we should focus on next. Make sure they reflect our actual plans for the account, rather than simply repeating what the figures suggest.</li>
        <li><b>Goals:</b> the objectives we&rsquo;re working towards with the client. These are added manually and should reflect their individual priorities.</li>
        <li><b>Trends:</b> an AI-generated analysis comparing performance across up to three months. At least two months of reporting data are needed. Use <b>Write it</b> or <b>Rewrite</b> to generate or refresh the analysis.</li>
      </ul>
      <Fragment set:html={shot("ht-summary", "The Management Summary Tab", "What it means, Into October, Goals and Trends. Scroll to see them all.", "management-summary-full.webp", "The Management Summary tab")} />
      <div class="ht-why">
        <p class="ht-why-k">Why both sections matter</p>
        <p>Although the Management Summary and Client Commentary cover similar information, they serve different purposes.</p>
        <p><b>Management Summary</b><br>Our internal assessment of the account. It contributes to the combined monthly management report and provides the starting point for generating the client&rsquo;s commentary.</p>
        <p><b>Client Commentary</b><br>The client-facing version of the month&rsquo;s performance. It appears in their monthly report, downloadable PDF and Your Socials page, with insights and recommendations written specifically for them.</p>
        <p>Review the Management Summary first to check the analysis, refine the recommendations and make sure the client&rsquo;s goals are up to date. Then, generate or redraft the Client Commentary, as this uses the Management Summary as its starting point, including our plans for the following month. Finally, review the client-facing wording. Make sure it&rsquo;s accurate, relevant and suitable for the client before publishing.</p>
        <p><b>Important: don&rsquo;t publish without client commentary.</b><br>If no Client Commentary has been prepared, the system will display the Management Summary to the client instead, including our internal working language. The publishing window will warn you if this is about to happen.</p>
      </div>
    </section>

    <!-- ── 04 ─────────────────────────────────────────────────────────── -->
    <section class="ht-part" id="publish">
      <p class="ht-num">Part 04</p>
      <h2 class="ht-h">Publishing the report</h2>
      <p class="ht-p">Once you&rsquo;ve reviewed the figures, completed the Management Summary and finalised the Client Commentary, you&rsquo;re ready to publish.</p>
      <p class="ht-p">Publishing makes the month&rsquo;s report available to the client through their Member Hub. It also adds their results to TMKE&rsquo;s monthly management reporting. Until a report is published, it won&rsquo;t appear in either.</p>
      <p class="ht-p">To publish, click <b>Publish to client</b>, select the relevant month and click <b>Publish</b> to confirm.</p>
      <figure class="ht-fig ht-fig--narrow"><img src={`${IMG}/publish.webp`} alt="The Publish window" loading="lazy" /><figcaption>A live month shows when it went live, and can be taken down.</figcaption></figure>

      <h3 class="ht-sub">What happens when you publish?</h3>
      <p class="ht-p">Once the report is published, the client can access it through their Member Hub. You can also choose to notify them by email.</p>
      <ul class="ht-ul">
        <li><b>Member Hub notification:</b> clients with an active Hub account automatically receive a notification letting them know their monthly report is ready, with a direct link to view it.</li>
        <li><b>Email notification:</b> select <b>Email … that a new report is ready</b> to send an additional notification. If the client hasn&rsquo;t registered for their Member Hub yet, the email will invite them to create an account, where their report will be waiting.</li>
        <li><b>Taking down a report:</b> if you need to remove a published report from the client&rsquo;s view, select <b>Take down</b>. This hides the report until you&rsquo;re ready to publish it again.</li>
      </ul>
      <button type="button" class="ht-shot ht-shot--slim" data-ht-email>
        <span class="ht-shot-img ht-shot-mail" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m2 7 10 6 10-6"/></svg></span>
        <span class="ht-shot-tx"><span class="ht-shot-t">The Email the Client Gets</span><span class="ht-shot-b">&ldquo;Your September social media report is ready.&rdquo; Exactly as it&rsquo;s sent, for our example client.</span></span>
        <span class="ht-shot-go">Take a look &rarr;</span>
      </button>

      <h3 class="ht-sub">Changing a month that&rsquo;s already live</h3>
      <p class="ht-p">Ideally, all figures, commentary and recommendations should be checked before publishing. However, if you spot an error or need to update something after the report has gone live, you can still make changes.</p>
      <p class="ht-p">Any edits to the client-facing report are saved internally until you choose to publish them. A yellow <b>Changes not published</b> banner will appear to let you know there are updates waiting.</p>
      <figure class="ht-fig ht-fig--narrow"><img src={`${IMG}/republish-bar.webp`} alt="Changes not published bar" loading="lazy" /></figure>
      <p class="ht-p">Click <b>Republish</b> and choose how you&rsquo;d like to update the report:</p>
      <ul class="ht-ul">
        <li><b>Republish quietly:</b> for minor corrections, such as spelling mistakes or incorrect figures. The updated version will appear the next time the client views their report, without sending another notification.</li>
        <li><b>Republish and tell them:</b> for more significant changes the client should be aware of. This sends a new Member Hub notification and email, and updates the report cover to show when it was revised.</li>
      </ul>
      <figure class="ht-fig ht-fig--narrow"><img src={`${IMG}/republish.webp`} alt="The Republish window" loading="lazy" /></figure>
      <p class="ht-p">Changes to the Management Summary work differently. As this is an internal section, updates are saved automatically and reflected in the management report without needing to republish the client-facing report.</p>
    </section>

    <!-- ── 05 ─────────────────────────────────────────────────────────── -->
    <section class="ht-part" id="management">
      <p class="ht-num">Part 05</p>
      <h2 class="ht-h">Monthly management report</h2>
      <p class="ht-p">The Monthly Management Report brings together the performance of every client account into one document, giving the TMKE management team a clear overview of how our social media services are performing across the business.</p>
      <p class="ht-p">Rather than reviewing individual client reports, management can see the key figures, insights and plans for every account in one place, making it easier to identify what&rsquo;s working, where improvements are needed and whether we&rsquo;re making progress towards each client&rsquo;s goals.</p>
      <p class="ht-p">Each client&rsquo;s report is condensed into a single page, combining their key performance metrics and best-performing content with the information recorded in their Management Summary.</p>

      <h3 class="ht-sub">What&rsquo;s included</h3>
      <p class="ht-p">Alongside the month&rsquo;s performance figures, each account&rsquo;s page includes four key areas:</p>
      <ul class="ht-ul">
        <li><b>Overview:</b> our assessment of the month&rsquo;s performance, including what&rsquo;s working, what we&rsquo;ve learned and anything that needs attention.</li>
        <li><b>Plans for next month:</b> the actions and improvements we&rsquo;re planning, based on the results and the client&rsquo;s wider marketing objectives.</li>
        <li><b>Goals:</b> the individual objectives we&rsquo;re working towards with the client, helping management understand what we&rsquo;re trying to achieve.</li>
        <li><b>Trends:</b> any patterns or changes identified across recent months, providing additional context to the current results.</li>
      </ul>
      <p class="ht-p">The report also includes a cover page showing which client accounts have been included and highlighting any missing reports.</p>
      <p class="ht-p">This is an internal document for management review only. Every page is marked accordingly, and access to generate the report is restricted to Danielle, Sam and Abbie.</p>

      <h3 class="ht-sub">Pulling a report</h3>
      <ol class="ht-ol">
        <li>From <b>Social media</b>, click <b>Settings</b>, then <b>Monthly management report</b>.</li>
        <li>Select the <b>Month</b> you&rsquo;d like to report on.</li>
        <li>Choose the client accounts you&rsquo;d like to include.</li>
        <li>Click <b>Pull monthly report</b> to generate and download your PDF.</li>
      </ol>

      <h3 class="ht-sub">Choosing the right accounts</h3>
      <ul class="ht-ul">
        <li><b>Accounts to include:</b> displays all clients with a published report for the selected month. All eligible accounts are selected by default.</li>
        <li><b>Quick selection:</b> use <b>All</b> or <b>None</b> to select or deselect every account. Alternatively, select <b>Abbie&rsquo;s</b> or <b>Sam&rsquo;s</b> to include only the clients managed by that person.</li>
        <li><b>Not included:</b> shows any active clients who cannot be included, along with the reason. This could be because their report hasn&rsquo;t been uploaded, hasn&rsquo;t been published or contains no data.</li>
      </ul>
      <button type="button" class="ht-shot" data-ht-open="ht-mgmt-demo">
        <img class="ht-shot-img" src={`${IMG}/management-report-v2.webp`} alt="" loading="lazy" />
        <span class="ht-shot-tx"><span class="ht-shot-t">Try It: September 2026</span><span class="ht-shot-b">The page with our example clients. Tick and untick accounts, try All, None and each manager&rsquo;s button, then pull the report.</span></span>
        <span class="ht-shot-go">Open it &rarr;</span>
      </button>
      <div class="ht-why">
        <p class="ht-why-k">Why a client is missing</p>
        <p>Only published client reports can be included in the Monthly Management Report. If a client is missing, check the <b>Not included</b> section to see why.</p>
        <p>For example, Aldenaire &amp; Co won&rsquo;t appear because their September report is still a draft. Once it&rsquo;s published, you can generate the management report again to include them.</p>
        <p>The report also uses the latest information from each client&rsquo;s Management Summary, so any changes made there will automatically be reflected the next time you generate it.</p>
      </div>
      <a class="ht-file" href={PDF} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15h6M9 18h4"/></svg>
        <span><b>Sample management report</b><small>September 2026, pulled from the example clients. PDF</small></span>
      </a>

      <!-- The example page, working: the real panel's layout with the example
           clients in it. Pull monthly report opens the sample PDF. -->
      <template id="ht-mgmt-demo">
        <h3 class="ht-sheet-h">Monthly Management Report</h3>
        <p class="ht-sheet-note">An example with our dummy clients: nothing here changes anything real.</p>
        <div class="mgd" data-mgd>
          <p class="mgd-sub">Every client report published for a month, in one A4 PDF: a cover listing every account and anyone missing, then a page per account with its figures for each platform, the top five posts, and our own read of the month from the Management Summary tab. A client is in it once their report for the month has been published to them.</p>
          <div class="mgd-controls">
            <label class="mgd-f"><span>Month</span><select><option>September 2026</option></select></label>
            <a class="mgd-pull" href={PDF} target="_blank" rel="noopener" data-mgd-pull>Pull monthly report</a>
            <span class="mgd-status" data-mgd-status>2 of 2 accounts ticked, 3 pages.</span>
          </div>
          <div class="mgd-grid">
            <div class="mgd-card">
              <h4>Accounts to include</h4>
              <div class="mgd-pick"><button type="button" data-mgd-pick="all">All</button><button type="button" data-mgd-pick="none">None</button><button type="button" data-mgd-pick="Abbie">Abbie&rsquo;s</button><button type="button" data-mgd-pick="Sam">Sam&rsquo;s</button></div>
              <ul>
                <li><label><input type="checkbox" checked data-mgd-acc="Abbie" /><span class="mgd-who"><b>Rimberio Homes</b><small>Alex Mercer · Abbie · Instagram, Facebook, LinkedIn</small></span></label></li>
                <li><label><input type="checkbox" checked data-mgd-acc="Sam" /><span class="mgd-who"><b>Borcelle Estates</b><small>Jordan Hale · Sam · Instagram</small></span></label></li>
              </ul>
            </div>
            <div class="mgd-card">
              <h4>Not included</h4>
              <ul>
                <li><span class="mgd-who"><b>Aldenaire &amp; Co</b><small>Taylor Quinn · Sam · Instagram, Facebook</small></span><span>Report not published</span></li>
                <li><span class="mgd-who"><b>Larana &amp; Co</b><small>Morgan Ellis · Abbie · Instagram, Facebook</small></span><span>No report uploaded</span></li>
              </ul>
            </div>
          </div>
          <p class="mgd-foot">In the example, Pull monthly report opens the sample PDF of both accounts. On the real page it downloads the PDF of whichever accounts are ticked.</p>
        </div>
      </template>
    </section>

    <!-- ── 06 ─────────────────────────────────────────────────────────── -->
    <section class="ht-part" id="client">
      <p class="ht-num">Part 06</p>
      <h2 class="ht-h">Client view</h2>
      <p class="ht-p">Clients can access their monthly social media reports through the <b>Your SMM</b> section of their Member Hub.</p>
      <p class="ht-p">This page displays their social media management plan, followed by their latest monthly report and a history of previous reports.</p>
      <p class="ht-p">The latest report includes a cover highlighting the month&rsquo;s key insight, taken from the Client Commentary, alongside their combined followers, reach and interactions across all included platforms.</p>
      <Fragment set:html={shot("ht-socials", "Your SMM: Rimberio Homes", "Their plan, then the latest report and every month before it.", "client-your-socials.webp", "The client's Your SMM page")} />

      <h3 class="ht-sub">Viewing the client report</h3>
      <p class="ht-p">Each monthly report is presented as an interactive slideshow, allowing clients to move through their results one section at a time. They can also download the complete report as a PDF.</p>
      <p class="ht-p">Open Rimberio Homes&rsquo; September report and use <b>Start</b>, followed by <b>Next</b>, to explore it from the client&rsquo;s perspective.</p>
      <p class="ht-p">Pay particular attention to how the information you&rsquo;ve prepared appears in the finished report:</p>
      <ul class="ht-ul">
        <li><b>What It Means:</b> displays the key insights and analysis from your Client Commentary.</li>
        <li><b>Into Next Month:</b> brings together your recommendations and upcoming content plans, giving the client a clear picture of what&rsquo;s planned.</li>
      </ul>
      <button type="button" class="ht-shot" data-ht-report>
        <img class="ht-shot-img" src={`${IMG}/client-report-thumb.webp`} alt="" loading="lazy" />
        <span class="ht-shot-tx"><span class="ht-shot-t">Rimberio Homes: September 2026</span><span class="ht-shot-b">The report as the client sees it, on Instagram, Facebook and LinkedIn.</span></span>
        <span class="ht-shot-go">Open it &rarr;</span>
      </button>
      <a class="ht-file" href={CLIENT_PDF} target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 15h6M9 18h4"/></svg>
        <span><b>The client&rsquo;s PDF</b><small>The same report as the client downloads it. PDF</small></span>
      </a>
      <p class="ht-p">Every report finishes with a <b>Message</b> option and the name of the client&rsquo;s account manager, making it easy for them to get in touch.</p>
      <p class="ht-p">Any messages are received through our usual communication channels, so be prepared to answer questions or discuss the results following publication. This is also a good opportunity to explain our recommendations and reinforce the work we&rsquo;re planning for the following month.</p>
    </section>
  </div>

  <!-- One picture full size (click any figure). -->
  <div class="ht-lb" id="ht-lb" hidden><img alt="" /></div>
  <!-- The pop-out: a long picture to scroll, or the working example. -->
  <div class="ht-sheet" id="ht-sheet" hidden>
    <div class="ht-sheet-card" role="dialog" aria-modal="true">
      <button type="button" class="ht-sheet-x" id="ht-sheet-x" aria-label="Close">&times;</button>
      <div class="ht-sheet-body" id="ht-sheet-body" data-lenis-prevent></div>
    </div>
  </div>
</AdminShell>

<style is:global>
  /* One rhythm for the whole page (Dani, 20 Oct): body text 15px, small
     notes 13px, and 18px between blocks. Boxes have the bars' 4px corners;
     screenshots keep their own. */
  .ht { --ht-gap: 18px; padding: 8px 0 80px; color: #2a1d22; }
  .ht-head { margin-bottom: 32px; }
  .ht-back { display: inline-block; margin-bottom: 18px; font-size: 13px; font-weight: 600; color: #371e28; text-decoration: none; }
  .ht-back:hover { text-decoration: underline; text-underline-offset: 3px; }
  .ht-eyebrow, .ht-num { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #8a7a80; margin: 0 0 4px; }
  /* The page title and each part's title are the same size and weight. */
  .ht-title, .ht-h { font-size: clamp(32px, 4vw, 44px); line-height: 1.05; margin: 0 0 12px; color: #371e28; font-weight: 500; }
  .ht-h { margin-bottom: 24px; }
  .ht-lede { font-size: 15px; line-height: 1.65; margin: 0; color: #4a3d42; }
  .ht-lede--note { margin-top: 6px; font-size: 13px; font-style: italic; color: #7a6b70; }
  .ht-p--label { margin-bottom: 8px; }
  .ht-top { background: #fff; border: 1px solid #e3dcd8; border-radius: 4px; padding: 24px 24px 26px; }
  /* The process: seven steps along one line. */
  .ht-flow { list-style: none; margin: 4px 0 0; padding: 0; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0 14px; counter-reset: none; }
  .ht-flow-step { position: relative; display: flex; flex-direction: column; gap: 4px; padding-top: 44px; }
  .ht-flow-step::before { content: ""; position: absolute; top: 15px; left: 34px; right: -14px; height: 1px; background: #d9cfca; }
  .ht-flow-step:last-child::before { display: none; }
  .ht-flow-n { position: absolute; top: 0; left: 0; width: 30px; height: 30px; border-radius: 50%; background: var(--english-violet, #371e28); color: #fff; display: grid; place-items: center; font-size: 13px; font-weight: 700; }
  .ht-flow-t { font-size: 15px; font-weight: 700; color: #371e28; line-height: 1.3; }
  .ht-flow-b { font-size: 13px; line-height: 1.5; color: #5f5257; }
  /* The contents: six boxes, evenly split. */
  .ht-parts { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 12px; }
  .ht-part-box { display: flex; flex-direction: column; gap: 6px; padding: 14px 16px 16px; border: 1px solid #e3dcd8; border-radius: 4px; background: #faf7f5; text-decoration: none; transition: border-color .2s, transform .2s; }
  .ht-part-box:hover { border-color: #371e28; transform: translateY(-2px); }
  .ht-part-box-n { font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #8a7a80; }
  .ht-part-box-t { font-size: 15px; font-weight: 700; color: #371e28; line-height: 1.3; }
  /* A part ends 40px above its rule and starts 40px under it, the gap above
     a subheading too (Dani, 20 Oct: equal margins). Block margins merge, so
     the 18px under the block before sits inside these 40px. */
  .ht-part { border-top: 1px solid #e3dcd8; padding-top: 40px; margin-top: 40px; scroll-margin-top: 80px; }
  .ht-top { margin-bottom: var(--ht-gap); }
  /* Subheadings: the house section strip, exactly (ws-system.css
     .ws-block-head / .ws-block-h, "the same device the admin centre and the
     Hub use"): a wine bar, 10px bold capitals (Dani, 20 Oct). */
  .ht-sub { margin: 40px 0 var(--ht-gap); padding: 11px 18px; background: var(--english-violet, #371e28); border-radius: 4px; color: #fff; font-family: "Space Grotesk", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; line-height: 1.4; }
  .ht-h + .ht-sub, .ht-top .ht-sub:first-child { margin-top: 0; }
  .ht-p, .ht-ul, .ht-ol, .ht-check { font-size: 15px; line-height: 1.65; margin: 0 0 var(--ht-gap); }
  .ht-ul, .ht-ol { padding-left: 22px; }
  .ht-ul li, .ht-ol li { margin-bottom: 6px; }
  .ht-ui { font-style: normal; background: #f3eeeb; border-radius: 4px; padding: 1px 6px; font-size: 0.93em; }
  .ht code { background: #f3eeeb; border-radius: 4px; padding: 1px 5px; font-size: 0.9em; }
  .ht-why { background: #fff; border: 1px solid #ebe3df; border-left: 3px solid #371e28; border-radius: 4px; padding: 18px 22px; margin: 0 0 var(--ht-gap); font-size: 15px; line-height: 1.65; }
  .ht-why p { margin: 0 0 8px; } .ht-why p:last-child { margin-bottom: 0; }
  .ht-why ul { margin: 0 0 8px; padding-left: 20px; }
  .ht-why-k { font-size: 11px !important; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: #371e28; }
  .ht-draft { background: #fff6dc; border: 1px dashed #d8b84a; border-radius: 4px; padding: 12px 16px; margin: 0 0 var(--ht-gap); font-size: 15px; }
  .ht-fig { margin: 0 0 var(--ht-gap); max-width: 760px; }
  .ht-fig img { display: block; width: 100%; height: auto; border: 1px solid #e3dcd8; border-radius: 10px; cursor: zoom-in; background: #fff; }
  .ht-fig figcaption { font-size: 13px; color: #7a6b70; margin-top: 8px; }
  .ht-trio .ht-fig figcaption { font-weight: 700; color: #371e28; }
  /* Three pictures side by side show at one height, from the top. */
  .ht-trio .ht-fig img { aspect-ratio: 4 / 3; object-fit: cover; object-position: top left; }
  .ht-fig--narrow { max-width: 620px; }
  .ht-pair, .ht-trio { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px; align-items: start; margin: 0 0 var(--ht-gap); }
  .ht-trio { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .ht-pair .ht-fig, .ht-trio .ht-fig { margin: 0; max-width: none; }
  .ht-cards { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; margin: 0 0 var(--ht-gap); }
  .ht-card { border: 1px solid #e3dcd8; border-radius: 4px; padding: 18px; background: #fff; font-size: 15px; line-height: 1.55; display: flex; flex-direction: column; }
  .ht-card p { margin: 0 0 10px; }
  .ht-card-k { font-weight: 700; color: #371e28; }
  .ht-card-s { margin-top: auto !important; margin-bottom: 0 !important; padding-top: 10px; border-top: 1px solid #efe8e4; color: #5f5257; font-size: 13px; }
  .ht-check { list-style: none; padding: 0; }
  .ht-check li { position: relative; padding-left: 28px; margin-bottom: 8px; }
  .ht-check li::before { content: ""; position: absolute; left: 2px; top: 5px; width: 14px; height: 14px; border: 1.6px solid #371e28; border-radius: 4px; }
  /* The header row is enough: no heavy rules top and bottom (Dani, 20 Oct). */
  .ht-table { border-collapse: collapse; width: 100%; font-size: 15px; margin: 0 0 var(--ht-gap); }
  .ht-table th { text-align: left; font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; color: #7a6b70; padding: 10px 12px 8px 0; border-bottom: 1px solid #e3dcd8; }
  .ht-table td { padding: 10px 12px 10px 0; border-bottom: 1px solid #efe8e4; vertical-align: top; line-height: 1.55; }
  .ht-table tr:last-child td { border-bottom: 0; }
  .ht-file { display: flex; width: fit-content; align-items: center; gap: 14px; border: 1px solid #e3dcd8; border-radius: 4px; padding: 14px 18px; text-decoration: none; color: #371e28; background: #fff; margin: 0 0 var(--ht-gap); font-size: 15px; }
  .ht-file:hover { border-color: #371e28; }
  .ht-file svg { width: 28px; height: 28px; flex: none; }
  .ht-file span { display: flex; flex-direction: column; }
  .ht-file small { color: #7a6b70; font-size: 13px; }

  /* A picture worth a proper look: one row, a strip of it, the whole thing in
     the pop-out (as the course pictures do). */
  .ht-shot { display: grid; grid-template-columns: 148px minmax(0, 1fr) auto; align-items: center; gap: 18px; width: 100%; margin: 0 0 var(--ht-gap); padding: 14px 18px 14px 14px; text-align: left; cursor: pointer; font: inherit; background: #fff; border: 1px solid #e3dcd8; border-radius: 4px; color: inherit; transition: border-color .2s, transform .2s; }
  .ht-shot:hover { border-color: #371e28; transform: translateY(-2px); }
  .ht-shot-img { display: block; width: 148px; aspect-ratio: 16 / 9; object-fit: cover; object-position: top left; border-radius: 4px; border: 1px solid #ebe3df; background: #fff; }
  .ht-shot-tx { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .ht-shot-t { font-size: 15px; font-weight: 700; color: #371e28; }
  .ht-shot-b { font-size: 15px; line-height: 1.55; color: #4a3d42; }
  .ht-shot-go { font-size: 11px; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; color: #371e28; white-space: nowrap; }
  /* A row with no picture (the email): the PDF links' height, full width. */
  .ht-shot--slim { grid-template-columns: 28px minmax(0, 1fr) auto; padding: 14px 18px; gap: 14px; }
  .ht-shot--slim .ht-shot-mail { width: 28px; height: 28px; aspect-ratio: auto; background: none; border: 0; }
  .ht-shot--slim .ht-shot-mail svg { width: 28px; height: 28px; }
  .ht-shot--slim .ht-shot-tx { gap: 0; }
  .ht-shot--slim .ht-shot-b { font-size: 13px; color: #7a6b70; }
  .ht-sheet-pair { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; align-items: start; }
  .ht-sheet-pair figure { margin: 0; }
  .ht-sheet-pair figcaption { font-size: 13px; color: #7a6b70; margin-top: 8px; }

  /* The pop-out: moved to the top of the page when it opens, beside the
     sidebar, the same gap above and below, scrolling inside. */
  .ht-sheet { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1000; background: rgba(20,18,26,0.6); display: flex; align-items: center; justify-content: center; padding: 40px 32px; box-sizing: border-box; }
  .ht-sheet[hidden] { display: none; }
  .ht-sheet-card { position: relative; width: min(900px, 100%); max-height: 100%; background: #fff; border-radius: 4px; overflow: hidden; box-shadow: 0 24px 70px rgba(20,18,26,0.35); display: flex; flex-direction: column; }
  .ht-sheet-card.is-wide { width: min(1240px, 100%); height: 100%; }
  .ht-sheet-card.is-mail { width: min(760px, 100%); }
  .ht-sheet-body { overflow-y: auto; padding: 28px 32px 32px; overscroll-behavior: contain; flex: 1 1 auto; min-height: 0; }
  .ht-sheet-card.is-wide .ht-sheet-body { display: flex; flex-direction: column; padding: 22px 24px 24px; }
  .ht-frame { display: block; width: 100%; border: 1px solid #e3dcd8; border-radius: 4px; background: #fff; }
  .ht-sheet-card.is-wide .ht-frame { flex: 1 1 auto; min-height: 0; }
  .ht-sheet-load { font-size: 14px; color: #7a6b70; margin: 0; }
  .ht-sheet-x { position: absolute; top: 12px; right: 14px; width: 36px; height: 36px; border: 0; border-radius: 4px; background: #f3eeeb; color: #371e28; font-size: 22px; line-height: 1; cursor: pointer; z-index: 1; }
  .ht-sheet-x:hover { background: #e9e1dd; }
  .ht-sheet-h { font-size: 20px; font-weight: 700; color: #371e28; margin: 0 48px 16px 0; }
  .ht-sheet-note { font-size: 13px; color: #7a6b70; margin: -8px 0 18px; }
  .ht-sheet-img { display: block; width: 100%; margin: 0 auto; height: auto; border: 1px solid #e3dcd8; border-radius: 10px; }
  .ht-shot-mail { display: grid; place-items: center; color: #371e28; background: #f3eeeb; }
  .ht-shot-mail svg { width: 34px; height: 34px; }


  /* The working example of the management report page. */
  .mgd { background: #f6f3f1; border-radius: 10px; padding: 22px 24px; }
  .mgd-sub { font-size: 13.5px; line-height: 1.6; color: #5f5257; margin: 0 0 16px; }
  .mgd-controls { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin: 0 0 18px; }
  .mgd-f { display: flex; align-items: center; gap: 14px; margin: 0; }
  .mgd-f span { font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
  .mgd-f select { height: 40px; padding: 0 34px 0 14px; border: 1px solid rgba(55,30,40,0.3); border-radius: 8px; background: #fff; color: #371e28; font-family: inherit; font-size: 13px; font-weight: 700; min-width: 210px; }
  .mgd-pull { height: 40px; display: inline-flex; align-items: center; padding: 0 18px; border-radius: 8px; background: #371e28; color: #fff; font-size: 13px; font-weight: 700; text-decoration: none; }
  .mgd-pull:hover { background: #4a2a37; }
  .mgd-pull.is-off { opacity: 0.45; pointer-events: none; }
  .mgd-status { font-size: 13px; color: rgba(28,29,34,0.6); }
  .mgd-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  .mgd-card { border: 1px solid rgba(28,29,34,0.12); border-radius: 8px; background: #fff; padding: 16px 18px; }
  .mgd-card h4 { margin: 0 0 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.6); }
  .mgd-pick { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 10px; }
  .mgd-pick button { font-family: inherit; font-size: 12px; font-weight: 700; padding: 5px 10px; border-radius: 99px; border: 1px solid rgba(55,30,40,0.25); background: #fff; color: #371e28; cursor: pointer; }
  .mgd-pick button:hover { border-color: #371e28; }
  .mgd-card ul { list-style: none; margin: 0; padding: 0; }
  .mgd-card li { display: flex; justify-content: space-between; gap: 12px; padding: 9px 0; border-top: 1px solid rgba(28,29,34,0.07); font-size: 14px; }
  .mgd-card li:first-child { border-top: 0; }
  .mgd-card li > span:last-child { color: rgba(28,29,34,0.55); text-align: right; }
  .mgd-card label { display: flex; align-items: flex-start; gap: 10px; cursor: pointer; }
  .mgd-card label input { margin-top: 3px; accent-color: #371e28; }
  .mgd-who { display: grid; gap: 1px; }
  .mgd-who b { font-weight: 700; color: #1c1d22; }
  .mgd-who small { font-size: 12.5px; color: rgba(28,29,34,0.55); }
  .mgd-foot { font-size: 13px; color: #7a6b70; margin: 16px 0 0; }

  .ht-lb { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 1010; background: rgba(20,18,26,0.82); display: flex; align-items: center; justify-content: center; padding: 24px; cursor: zoom-out; overflow: auto; }
  .ht-lb[hidden] { display: none; }
  .ht-lb img { max-width: min(1400px, 100%); max-height: none; border-radius: 10px; background: #fff; margin: auto; }
  @media (max-width: 900px) {
    .ht-pair, .ht-trio, .ht-cards, .mgd-grid { grid-template-columns: 1fr; }
    .ht-flow { grid-template-columns: 1fr; gap: 14px; }
    .ht-flow-step { padding: 4px 0 0 44px; }
    .ht-flow-step::before { display: none; }
    .ht-parts { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ht-shot { grid-template-columns: 96px minmax(0, 1fr); }
    .ht-shot-img { width: 96px; }
    .ht-shot-go { grid-column: 2; }
    .ht-sheet-body { padding: 22px 18px 24px; }
  }
</style>

<script>
  import { supabase } from "../../../lib/supabase.js";
  const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
  // Both pop-outs live at the top of the page, so nothing in the admin's
  // layout can move them; they start beside the sidebar.
  const lb = document.getElementById("ht-lb");
  const sideW = () => { const a = document.getElementById("ash"); return a ? getComputedStyle(a).getPropertyValue("--ash-side-w").trim() || "0px" : "0px"; };
  [lb, document.getElementById("ht-sheet")].forEach((el) => { if (el) document.body.appendChild(el); });
  // Click a screenshot to see it full size; click again, or Escape, to close.
  const big = lb?.querySelector("img");
  document.querySelectorAll(".ht-fig img").forEach((img) => img.addEventListener("click", () => {
    if (!lb || !big) return;
    big.src = (img as HTMLImageElement).src; big.alt = (img as HTMLImageElement).alt; lb.style.left = sideW(); lb.hidden = false;
  }));
  lb?.addEventListener("click", () => { lb.hidden = true; });

  // The pop-out: a row's picture, or the working example, to scroll through.
  const sheet = document.getElementById("ht-sheet");
  const body = document.getElementById("ht-sheet-body");
  const card = sheet?.querySelector(".ht-sheet-card");
  const closeSheet = () => { if (sheet && body) { sheet.hidden = true; body.innerHTML = ""; document.documentElement.style.overflow = ""; } };
  const openSheet = (kind = "") => {
    if (!sheet || !body || !card) return false;
    card.className = "ht-sheet-card" + (kind ? " is-" + kind : "");
    body.innerHTML = ""; body.scrollTop = 0;
    sheet.style.left = sideW(); sheet.hidden = false; document.documentElement.style.overflow = "hidden";
    return true;
  };
  document.querySelectorAll("[data-ht-open]").forEach((b) => b.addEventListener("click", () => {
    const tpl = document.getElementById(b.getAttribute("data-ht-open") || "") as HTMLTemplateElement | null;
    if (!tpl || !openSheet()) return;
    body!.appendChild(tpl.content.cloneNode(true));
    wireDemo(body!);
  }));

  // The client's report, stepped through as they would: the training
  // account's September, shown as a sample, so nobody's login changes.
  document.querySelector("[data-ht-report]")?.addEventListener("click", () => {
    if (!openSheet("wide")) return;
    body!.innerHTML = `<h3 class="ht-sheet-h">Rimberio Homes: September 2026</h3><p class="ht-sheet-note">The report as the client sees it. Start, then Next; Download PDF on the cover gives you their PDF.</p><iframe class="ht-frame" src="/account/social/report?sample=training-2026-09" title="Rimberio Homes' September report"></iframe>`;
  });

  // The email, as it's sent: the Worker's own preview, branded, for the
  // example client (the same one Email studio › Automated emails shows).
  document.querySelector("[data-ht-email]")?.addEventListener("click", async () => {
    if (!openSheet("mail")) return;
    body!.innerHTML = `<h3 class="ht-sheet-h">The Email the Client Gets</h3><p class="ht-sheet-load">Loading the email…</p>`;
    try {
      const token = (await supabase.auth.getSession()).data.session?.access_token || "";
      const res = await fetch(`${WORKER}/email/preview?id=smm_report_ready&branded=1`, { headers: { Authorization: "Bearer " + token } });
      const j = await res.json().catch(() => ({}));
      if (!res.ok || !j.html) throw new Error(j.error || "");
      body!.innerHTML = `<h3 class="ht-sheet-h">The Email the Client Gets</h3><p class="ht-sheet-note">Subject: ${String(j.subject || "").replace(/</g, "&lt;")}</p><iframe class="ht-frame" title="The report email" style="height:600px"></iframe>`;
      const fr = body!.querySelector("iframe") as HTMLIFrameElement;
      fr.srcdoc = j.html;
      fr.addEventListener("load", () => { try { fr.style.height = (fr.contentDocument!.documentElement.scrollHeight + 4) + "px"; } catch (_) {} });
    } catch (e) {
      body!.innerHTML = `<h3 class="ht-sheet-h">The Email the Client Gets</h3><p class="ht-sheet-load">Couldn&rsquo;t load the email just now. It&rsquo;s also in Email studio › Automated emails, under the social media report.</p>`;
    }
  });
  document.getElementById("ht-sheet-x")?.addEventListener("click", closeSheet);
  sheet?.addEventListener("click", (e) => { if (e.target === sheet) closeSheet(); });
  addEventListener("keydown", (e) => { if (e.key !== "Escape") return; if (lb && !lb.hidden) lb.hidden = true; else closeSheet(); });

  // The example management report: the ticks, the pick buttons and the count
  // behave as the real page's do.
  function wireDemo(root: HTMLElement) {
    const d = root.querySelector("[data-mgd]"); if (!d) return;
    const boxes = [...d.querySelectorAll<HTMLInputElement>("[data-mgd-acc]")];
    const st = d.querySelector("[data-mgd-status]"), pull = d.querySelector("[data-mgd-pull]");
    const count = () => {
      const k = boxes.filter((c) => c.checked).length;
      if (st) st.textContent = `${k} of ${boxes.length} account${boxes.length === 1 ? "" : "s"} ticked, ${k ? k + 1 : 0} pages.`;
      pull?.classList.toggle("is-off", !k);
    };
    boxes.forEach((c) => c.addEventListener("change", count));
    d.querySelectorAll<HTMLButtonElement>("[data-mgd-pick]").forEach((b) => b.addEventListener("click", () => {
      const v = b.getAttribute("data-mgd-pick");
      boxes.forEach((c) => { c.checked = v === "all" ? true : v === "none" ? false : c.getAttribute("data-mgd-acc") === v; });
      count();
    }));
    count();
  }
</script>
