<script>
  // Click a screenshot to see it full size; click again, or Escape, to close.
  const lb = document.getElementById("ht-lb");
  const big = lb?.querySelector("img");
  document.querySelectorAll(".ht-fig img").forEach((img) => img.addEventListener("click", () => {
    if (!lb || !big) return;
    big.src = (img as HTMLImageElement).src; big.alt = (img as HTMLImageElement).alt; lb.hidden = false;
  }));
  lb?.addEventListener("click", () => { lb.hidden = true; });
  addEventListener("keydown", (e) => { if (e.key === "Escape" && lb) lb.hidden = true; });
</script>
