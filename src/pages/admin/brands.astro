---
import AdminShell from "../../components/admin/AdminShell.astro";
import StudioBar from "../../components/admin/StudioBar.astro";
import BrandKitForm from "../../components/admin/BrandKitForm.astro";
import "../../styles/admin.css";
---

<AdminShell active="studio" title="Brands" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Brands</div>
          <div class="page-header-sub">What a brand's kit starts as. An agent opens the Studio already set up — their colours, their fonts, their logo, their voice — instead of an empty form and a hunt for the brand guidelines.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="ash-panel ash-page">
    <StudioBar active="brands" countId="br-count">
      <Fragment slot="filters">
        <label class="tpl-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
          <input type="search" id="br-search" placeholder="Search brands…" aria-label="Search brands" />
        </label>
      </Fragment>
      <Fragment slot="actions">
        <button type="button" class="admin-btn admin-btn-ghost" id="br-add">+ Add a brand</button>
      </Fragment>
    </StudioBar>

    <!-- Agents on personal addresses, asking to be placed. Hidden when empty,
         which is most of the time. -->
    <section class="br-reqs" id="br-reqs" hidden></section>

    <p id="br-loading" class="br-note">Loading…</p>

    <!-- Pick a brand, then fill its kit. One at a time, with room to work. -->
    <nav class="br-pills" id="br-pills" hidden></nav>

    <p id="br-empty" class="br-note" hidden>
      No brands yet. One appears the moment an agent's TEG profile names it — or add one here.
    </p>

    <div id="br-kit" hidden>
      <BrandKitForm idPrefix="br" />
    </div>
  </div>

  <style is:global>
    .br-note { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.55); }

    .br-reqs { margin-bottom: 30px; }
    .br-reqs[hidden] { display: none; }
    .br-reqs-head {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; color: #8a6a24;
      margin-bottom: 12px;
    }
    .br-req {
      background: #fff; border: 1px solid rgba(138,122,54,0.45); border-radius: 12px;
      padding: 20px 22px; margin-bottom: 12px;
    }
    .br-req-top { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 4px; }
    .br-req-who { font-family: var(--serif); font-size: 20px; color: var(--ink); }
    .br-req-meta { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); }
    .br-req-says { font-family: var(--sans); font-size: 13.5px; color: var(--ink); margin: 0 0 14px; }
    .br-req-says strong { font-weight: 700; }
    .br-cands { display: grid; gap: 8px; margin-bottom: 14px; }
    .br-cand {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      padding: 11px 13px; border-radius: 8px; cursor: pointer;
      border: 1px solid rgba(28,29,34,0.16); background: #fff;
      font-family: var(--sans); font-size: 13px; color: var(--ink);
    }
    .br-cand:hover { border-color: rgba(28,29,34,0.4); }
    .br-cand.is-on { border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.1); }
    .br-cand input { accent-color: var(--english-violet); margin: 0; }
    .br-cand em { font-style: normal; color: rgba(28,29,34,0.5); font-size: 12px; }
    .br-cand-tag {
      font-size: 10px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      padding: 3px 8px; border-radius: 999px; background: rgba(46,107,74,0.14); color: #2e6b4a;
    }
    .br-cand-tag.is-other { background: rgba(163,55,43,0.12); color: #8c2f24; }
    .br-req-acts { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
    .br-req-status { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); }
    .br-pills { display: flex; gap: 8px; flex-wrap: wrap; margin: 4px 0 26px; }
    .br-pill {
      display: inline-flex; align-items: baseline; gap: 8px;
      font-family: var(--sans); font-size: 13px; font-weight: 600;
      padding: 9px 17px; border-radius: 999px; cursor: pointer;
      background: #fff; color: rgba(28,29,34,0.7);
      border: 1px solid rgba(28,29,34,0.16);
      transition: border-color 0.18s, color 0.18s, background 0.18s;
    }
    .br-pill:hover { border-color: rgba(28,29,34,0.42); color: var(--ink); }
    .br-pill.is-on { background: var(--english-violet); border-color: var(--english-violet); color: var(--paper); }
    .br-pill em {
      font-style: normal; font-size: 11px; font-weight: 600; opacity: 0.6;
      font-variant-numeric: tabular-nums;
    }
    .br-pill.is-empty::after {
      content: "•"; color: #a3372b; font-size: 15px; line-height: 0.6;
    }
    .br-pill.is-on.is-empty::after { color: rgba(255,255,255,0.8); }
    .br-kit-head {
      display: flex; align-items: baseline; gap: 14px; flex-wrap: wrap; margin-bottom: 18px;
    }
    .br-kit-name { font-family: var(--serif); font-size: 27px; color: var(--ink); }
    .br-kit-sub { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); }
  </style>

  <script>
    import { requireAdmin } from '../../lib/admin-gate.js';
    import { supabase } from '../../lib/supabase.js';
    import { escapeHtml } from '../../lib/design-preview.js';
    import { byBrandOrder } from '../../data/brands.js';
    import { GOOGLE_FONTS } from '../../data/google-fonts.js';
    import { GOOGLE_FONTS_ALL } from '../../data/google-fonts-all.js';
    import { fillForm, readForm, wireColors, wireLogos, fillFontList } from '../../lib/brand-kit-form.js';

    const els = {
      pills: document.getElementById('br-pills'),
      kit: document.getElementById('br-kit'),
      empty: document.getElementById('br-empty'),
      loading: document.getElementById('br-loading'),
      count: document.getElementById('br-count'),
      search: document.getElementById('br-search'),
    };
    const root = els.kit.querySelector('[data-kit]');
    let ROWS = [];
    let AGENTS = {};
    let CURRENT = null;

    // A brand with nothing filled in is the thing you came here to fix, so
    // it carries a dot rather than looking like all the others.
    const isEmpty = (r) => !(r.tone || r.slogan || r.website
      || (Array.isArray(r.colors) && r.colors.length)
      || (Array.isArray(r.logos) && r.logos.length));

    async function load() {
      els.loading.hidden = false;
      const [bp, ap] = await Promise.all([
        supabase.from('brand_profiles').select('*').order('brand'),
        supabase.from('agent_profiles').select('brand').not('brand', 'is', null),
      ]);
      els.loading.hidden = true;

      if (bp.error) {
        els.loading.hidden = false;
        els.loading.innerHTML = /brand_profiles|relation|column/i.test(bp.error.message || '')
          ? 'The database hasn’t got the brands table yet. Run <strong>supabase/brand_profiles.sql</strong>, then reload.'
          : 'Could not load brands: ' + escapeHtml(bp.error.message);
        return;
      }

      AGENTS = {};
      (ap.data || []).forEach((r) => {
        const b = (r.brand || '').trim();
        if (b) AGENTS[b] = (AGENTS[b] || 0) + 1;
      });

      // Studio branding lives in this table too, under a reserved key, but it
      // has its own tab — it is ours, not a brand.
      ROWS = (bp.data || []).filter((r) => r.brand !== '__studio__');
      Object.keys(AGENTS).forEach((b) => {
        if (!ROWS.some((r) => r.brand === b)) ROWS.push({ brand: b, colors: [], fonts: {}, logos: [] });
      });
      // House order, not agent count: the brand we are working on comes first.
      ROWS.sort((a, b) => byBrandOrder(a.brand, b.brand));

      const done = ROWS.filter((r) => !isEmpty(r)).length;
      els.count.textContent = ROWS.length
        ? `${ROWS.length} brand${ROWS.length === 1 ? '' : 's'} · ${done} set up`
        : 'None yet';
      els.empty.hidden = ROWS.length !== 0;
      renderPills();
      if (ROWS.length) select(CURRENT || ROWS[0].brand);
    }

    function renderPills() {
      const q = (els.search?.value || '').toLowerCase().trim();
      const list = q ? ROWS.filter((r) => r.brand.toLowerCase().includes(q)) : ROWS;
      els.pills.hidden = !list.length;
      els.pills.innerHTML = list.map((r) => {
        const n = AGENTS[r.brand] || 0;
        return `<button type="button" class="br-pill${r.brand === CURRENT ? ' is-on' : ''}${isEmpty(r) ? ' is-empty' : ''}" data-brand="${escapeHtml(r.brand)}">
          ${escapeHtml(r.brand)}${n ? ` <em>${n}</em>` : ''}
        </button>`;
      }).join('');
    }

    function select(brand) {
      const row = ROWS.find((r) => r.brand === brand);
      if (!row) return;
      CURRENT = brand;
      renderPills();
      els.kit.hidden = false;
      let head = els.kit.querySelector('.br-kit-head');
      if (!head) {
        head = document.createElement('div');
        head.className = 'br-kit-head';
        els.kit.prepend(head);
      }
      const n = AGENTS[brand] || 0;
      head.innerHTML = `<span class="br-kit-name">${escapeHtml(brand)}</span>
        <span class="br-kit-sub">${n} agent${n === 1 ? '' : 's'} open the Studio with this kit</span>`;
      fillForm(root, Object.assign({ company: row.company || brand }, row));
    }

    els.pills.addEventListener('click', (e) => {
      const b = e.target.closest('[data-brand]');
      if (b) select(b.getAttribute('data-brand'));
    });

    els.search?.addEventListener('input', renderPills);

    document.getElementById('br-add')?.addEventListener('click', () => {
      const name = prompt('Brand name — exactly as it is written on an agent’s TEG profile:');
      const brand = (name || '').trim();
      if (!brand) return;
      if (ROWS.some((r) => r.brand.toLowerCase() === brand.toLowerCase())) { select(brand); return; }
      ROWS.push({ brand, colors: [], fonts: {}, logos: [] });
      select(brand);
    });

    const status = (msg) => {
      const el = root.querySelector('[data-status]');
      if (el) el.textContent = msg || '';
    };

    root.querySelector('[data-save]')?.addEventListener('click', async (e) => {
      if (!CURRENT) return;
      const btn = e.currentTarget;
      const payload = readForm(root, CURRENT);
      btn.disabled = true;
      status('Saving…');
      const { error } = await supabase.from('brand_profiles').upsert(payload, { onConflict: 'brand' });
      btn.disabled = false;
      if (error) { status('Could not save: ' + error.message); return; }
      status('Saved');
      const row = ROWS.find((r) => r.brand === CURRENT);
      if (row) Object.assign(row, payload);
      renderPills();
      setTimeout(() => status(''), 2200);
    });

    wireColors(root);
    wireLogos(root, supabase, status);

    /* Requests from agents we can't place: their sign-in email isn't one we
       hold. Approving binds their account to the contact we already have —
       which is what gives them back their real details — and files them under
       the brand. Nothing is released until someone presses it. */
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');

    async function loadRequests() {
      const box = document.getElementById('br-reqs');
      if (!WORKER || !box) return;
      let token = null;
      try {
        const { data } = await supabase.auth.getSession();
        token = data?.session?.access_token || null;
      } catch (_) {}
      if (!token) return;

      let out = null;
      try {
        const res = await fetch(WORKER + '/admin/brand-requests', { headers: { Authorization: 'Bearer ' + token } });
        out = await res.json().catch(() => null);
      } catch (_) {}
      const reqs = (out && out.ok && out.requests) || [];
      box.hidden = !reqs.length;
      if (!reqs.length) return;

      box.innerHTML = `<div class="br-reqs-head">${reqs.length} waiting to be placed</div>` + reqs.map((r) => {
        const cands = (r.candidates || []).map((c) => `
          <label class="br-cand">
            <input type="radio" name="cand-${escapeHtml(r.id)}" value="${escapeHtml(c.id)}" />
            <span>${escapeHtml(c.name || '—')}</span>
            <em>${escapeHtml(c.email)}${c.phone ? ' · ' + escapeHtml(c.phone) : ''}</em>
            ${c.brand === r.brand ? '<span class="br-cand-tag">Same brand</span>'
              : c.brand ? `<span class="br-cand-tag is-other">${escapeHtml(c.brand)}</span>` : ''}
            ${c.left ? '<span class="br-cand-tag is-other">Has left</span>' : ''}
            ${c.linked ? '<em>already linked to an account</em>' : ''}
          </label>`).join('');
        return `
        <article class="br-req" data-req="${escapeHtml(r.id)}">
          <div class="br-req-top">
            <span class="br-req-who">${escapeHtml(r.name || r.email)}</span>
            <span class="br-req-meta">${escapeHtml(r.email)}</span>
          </div>
          <p class="br-req-says">Says they work for <strong>${escapeHtml(r.brand)}</strong>.</p>
          ${cands ? `<div class="br-cands">
            <label class="br-cand"><input type="radio" name="cand-${escapeHtml(r.id)}" value="" checked /><span>No match — use the address they signed up with</span></label>
            ${cands}
          </div>` : '<p class="br-note" style="margin-bottom:14px">Nobody in Contacts shares their surname. Approving will use the address they signed up with.</p>'}
          <div class="br-req-acts">
            <button type="button" class="admin-btn admin-btn-primary" data-approve="${escapeHtml(r.id)}">Approve</button>
            <button type="button" class="admin-btn admin-btn-ghost" data-reject="${escapeHtml(r.id)}">Not them</button>
            <span class="br-req-status" data-status></span>
          </div>
        </article>`;
      }).join('');

      box.querySelectorAll('.br-cands').forEach((g) => {
        g.addEventListener('change', () => {
          g.querySelectorAll('.br-cand').forEach((l) => l.classList.toggle('is-on', !!l.querySelector('input').checked));
        });
      });

      box.addEventListener('click', async (e) => {
        const el = e.target;
        if (!(el instanceof HTMLElement)) return;
        const id = el.getAttribute('data-approve') || el.getAttribute('data-reject');
        if (!id) return;
        const card = el.closest('.br-req');
        const status = card.querySelector('[data-status]');
        const decision = el.hasAttribute('data-approve') ? 'approve' : 'reject';
        const picked = card.querySelector(`input[name="cand-${id}"]:checked`);
        el.disabled = true;
        status.textContent = decision === 'approve' ? 'Setting them up…' : 'Closing…';
        try {
          const res = await fetch(WORKER + '/admin/brand-requests/decide', {
            method: 'POST',
            headers: { Authorization: 'Bearer ' + token, 'Content-Type': 'application/json' },
            body: JSON.stringify({ id, decision, contact_id: (picked && picked.value) || null }),
          });
          const o = await res.json().catch(() => null);
          if (!o || !o.ok) throw new Error((o && o.error) || 'That did not go through.');
          card.remove();
          if (!document.querySelectorAll('.br-req').length) document.getElementById('br-reqs').hidden = true;
          await load();
        } catch (err) {
          el.disabled = false;
          status.textContent = err.message;
        }
      }, { once: false });
    }

    (async () => {
      if (!import.meta.env.DEV) {
        const session = await requireAdmin();
        if (!session) return;
      }
      loadRequests();
      fillFontList(root, supabase, GOOGLE_FONTS.concat(
        GOOGLE_FONTS_ALL.filter((f) => !GOOGLE_FONTS.includes(f))));
      await load();
    })();
  </script>
</AdminShell>
