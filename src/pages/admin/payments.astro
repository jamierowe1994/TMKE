---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
---

<AdminShell active="payments" title="Payments" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Payments</div>
          <div class="page-header-sub">Every payment that has reached your Stripe account, whatever sold it.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="ash-panel ash-page">
    <section class="admin-bar">
      <div class="admin-bar-actions">
        <div class="order-filters" id="pay-range" role="tablist">
          <button type="button" class="enquiry-chip" data-days="30">30 days</button>
          <button type="button" class="enquiry-chip is-active" data-days="90">90 days</button>
          <button type="button" class="enquiry-chip" data-days="365">A year</button>
          <button type="button" class="enquiry-chip" data-days="3650">Everything</button>
        </div>
        <span class="admin-bar-count" id="pay-count">…</span>
      </div>
      <div class="admin-bar-actions">
        <div class="order-filters" id="pay-source" role="tablist">
          <button type="button" class="enquiry-chip is-active" data-source="all">All</button>
          <button type="button" class="enquiry-chip" data-source="pack">Packs</button>
          <button type="button" class="enquiry-chip" data-source="videography">Videography</button>
          <button type="button" class="enquiry-chip" data-source="social">Social media</button>
          <button type="button" class="enquiry-chip" data-source="invoice">Invoices</button>
          <button type="button" class="enquiry-chip" data-source="external">External</button>
        </div>
        <input type="search" id="pay-search" class="admin-search" placeholder="Search customer or item…" />
        <button type="button" class="admin-btn admin-btn-ghost" id="pay-csv">Export CSV</button>
      </div>
    </section>

    <section class="g4 order-stats-grid" id="pay-stats">
      <div class="stat">
        <div class="stat-num" data-stat="gross">…</div>
        <div class="stat-label">Gross taken</div>
      </div>
      <div class="stat">
        <div class="stat-num" data-stat="vat">…</div>
        <div class="stat-label">VAT within it</div>
      </div>
      <div class="stat">
        <div class="stat-num" data-stat="fees">…</div>
        <div class="stat-label">Stripe fees</div>
      </div>
      <div class="stat">
        <div class="stat-num" data-stat="received">…</div>
        <div class="stat-label">Landed in the bank</div>
      </div>
    </section>

    <section class="order-list" id="pay-list" aria-busy="true">
      <p class="pay-state" id="pay-loading">Reading your Stripe account…</p>
      <p class="pay-state" id="pay-empty" hidden>No payments match this filter.</p>
      <p class="pay-note" id="pay-note" hidden></p>
      <div class="pay-table" id="pay-table" role="table"></div>
    </section>
  </div>

  <div class="modal-backdrop" id="pay-modal" hidden>
    <div class="modal pay-modal" role="dialog" aria-modal="true" aria-labelledby="pay-modal-title">
      <header class="modal-head">
        <h2 id="pay-modal-title">Receipt</h2>
        <button type="button" class="modal-close" id="pay-modal-close" aria-label="Close">&times;</button>
      </header>
      <div class="pay-receipt" id="pay-receipt"></div>
      <footer class="modal-foot">
        <span class="pay-modal-msg" id="pay-modal-msg"></span>
        <button type="button" class="admin-btn admin-btn-ghost" id="pay-modal-cancel">Close</button>
        <button type="button" class="admin-btn admin-btn-ghost" id="pay-send">Send to accounts</button>
        <button type="button" class="admin-btn admin-btn-primary" id="pay-download">Download PDF</button>
      </footer>
    </div>
  </div>

  <style is:global>
    /* is:global on purpose. The rows below are built in JavaScript, so they
       carry none of Astro's scoping attributes and a scoped block would miss
       them entirely — which is exactly how this page first shipped as one long
       unstyled column. Everything here is namespaced under .pay-* or an id, so
       going global costs nothing.

       .admin-bar, .enquiry-chip and .admin-search are defined per page across
       the backstage rather than centrally; these match the other admin pages. */

    .admin-bar {
      display: flex; flex-direction: column; align-items: stretch; gap: 12px;
      max-width: 1360px; margin: 0 auto; padding: 12px 36px 28px;
    }
    .admin-bar-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .admin-bar-count {
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.18em;
      text-transform: uppercase; color: rgba(28, 29, 34, 0.5); margin-left: auto;
    }
    .admin-search {
      padding: 8px 12px; border: 1px solid rgba(var(--violet-rgb), 0.3);
      border-radius: 2px; font-family: var(--sans); font-size: 13px;
      color: var(--ink); background: var(--paper); min-width: 200px; flex: 1 1 200px;
    }
    .admin-search:focus { outline: none; border-color: var(--english-violet); }

    .order-filters { display: inline-flex; gap: 4px; flex-wrap: wrap; }
    .enquiry-chip {
      display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px;
      background: #fff; border: 1px solid rgba(var(--violet-rgb), 0.3);
      border-radius: 999px; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700;
      color: var(--english-violet); cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .enquiry-chip:hover { background: rgba(var(--violet-rgb), 0.06); }
    .enquiry-chip.is-active { background: var(--english-violet); color: var(--paper); border-color: var(--english-violet); }

    .order-stats-grid { max-width: 1360px; margin: 0 auto 28px; padding: 0 36px; }
    @media (max-width: 860px) { .order-stats-grid.g4 { grid-template-columns: repeat(2, 1fr); } }

    .order-list { max-width: 1360px; margin: 0 auto; padding: 0 36px 200px; }
    .pay-state, .pay-note {
      font-family: var(--sans); font-size: 13px; line-height: 1.6;
      color: rgba(28, 29, 34, 0.6); padding: 18px 20px; margin: 0 0 12px;
      background: var(--paper); border-radius: 4px;
    }
    .pay-note { color: #8a6a3c; background: rgba(183, 138, 46, 0.09); }

    /* The table scrolls inside itself rather than pushing the page sideways. */
    .pay-table { overflow-x: auto; border-radius: 4px; }
    .pay-row {
      display: grid;
      /* Tight enough to fit an ordinary laptop without scrolling. When the
         table does scroll, the right-hand column is the one that goes off the
         edge, which reads as lopsided padding even though it isn't. */
      grid-template-columns: 86px 112px minmax(166px, 1.5fr) minmax(122px, 1fr) 88px 88px 92px 96px;
      gap: 12px; align-items: center; min-width: 920px;
      padding: 15px 20px; background: var(--paper);
      border-bottom: 1px solid rgba(28, 29, 34, 0.07);
      font-family: var(--sans); font-size: 13px; color: var(--ink);
      cursor: pointer; transition: background 0.15s;
    }
    .pay-row:not(.is-header):hover { background: rgba(var(--violet-rgb), 0.05); }
    .pay-row:not(.is-header):focus-visible { outline: 2px solid var(--english-violet); outline-offset: -2px; }
    .pay-row.is-header {
      cursor: default; background: rgba(var(--violet-rgb), 0.04);
      font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
      font-weight: 700; color: rgba(28, 29, 34, 0.55);
    }
    .pay-row.is-header:hover { background: rgba(var(--violet-rgb), 0.04); }

    .pay-when { font-size: 12px; color: rgba(28, 29, 34, 0.62); }
    .pay-what { font-weight: 600; }
    .pay-cust { color: rgba(28, 29, 34, 0.66); overflow-wrap: anywhere; }
    .pay-num { text-align: right; font-variant-numeric: tabular-nums; }
    .pay-gross { font-weight: 700; }
    .pay-est { font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: #8a6a3c; }
    .pay-refund { display: block; font-size: 11px; color: #a05a3c; margin-top: 3px; font-weight: 400; }

    .pay-src {
      display: inline-block; font-size: 10px; font-weight: 700;
      letter-spacing: 0.14em; text-transform: uppercase;
      padding: 4px 9px; border-radius: 3px; white-space: nowrap;
      background: rgba(28, 29, 34, 0.07); color: rgba(28, 29, 34, 0.7);
    }
    .pay-src[data-s="videography"] { background: rgba(78, 42, 90, 0.13);  color: #4e2a5a; }
    .pay-src[data-s="pack"]        { background: rgba(46, 107, 64, 0.13); color: #2e6b40; }
    .pay-src[data-s="social"]      { background: rgba(38, 106, 106, 0.13); color: #266a6a; }
    .pay-src[data-s="invoice"]     { background: rgba(52, 96, 140, 0.13); color: #34608c; }
    .pay-src[data-s="external"]    { background: rgba(160, 90, 60, 0.14); color: #a05a3c; }

    /* ---- Receipt ---- */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 200;
      background: rgba(20, 18, 26, 0.55);
      display: flex; align-items: center; justify-content: center; padding: 24px;
    }
    .modal-backdrop[hidden] { display: none; }
    .modal.pay-modal {
      background: var(--paper); max-width: 620px; width: 100%; max-height: 86vh;
      display: flex; flex-direction: column; border-radius: 4px; overflow: hidden;
      box-shadow: 0 30px 80px rgba(20, 18, 26, 0.35);
    }
    .modal-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 20px 28px; border-bottom: 1px solid rgba(var(--violet-rgb), 0.12);
    }
    .modal-head h2 { font-family: var(--serif); font-size: 22px; font-weight: 500; margin: 0; color: var(--ink); }
    .modal-close {
      background: transparent; border: none; font-size: 28px; line-height: 1;
      color: var(--english-violet); cursor: pointer; padding: 0 4px;
    }
    .modal-foot {
      display: flex; justify-content: flex-end; align-items: center; gap: 10px;
      padding: 16px 28px; border-top: 1px solid rgba(var(--violet-rgb), 0.12);
      flex-wrap: wrap;
    }
    .pay-modal-msg {
      margin-right: auto; font-family: var(--sans); font-size: 12px;
      line-height: 1.4; color: #2e6b40;
    }
    .pay-modal-msg.is-bad { color: #a05a3c; }
    .pay-receipt { padding: 28px; overflow-y: auto; flex: 1; font-family: var(--sans); }
    .rc-brand {
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.22em;
      text-transform: uppercase; color: rgba(28, 29, 34, 0.5); margin: 0 0 6px;
    }
    .rc-title { font-family: var(--serif); font-size: 26px; font-weight: 400; margin: 0 0 22px; color: var(--ink); }
    .rc-line { display: flex; justify-content: space-between; gap: 18px; padding: 9px 0; font-size: 13px; }
    .rc-line + .rc-line { border-top: 1px solid rgba(28, 29, 34, 0.07); }
    .rc-k { color: rgba(28, 29, 34, 0.55); flex: none; }
    .rc-v { text-align: right; overflow-wrap: anywhere; }
    .rc-total { margin-top: 14px; border-top: 2px solid var(--english-violet); padding-top: 14px; }
    .rc-total .rc-k, .rc-total .rc-v { font-weight: 700; font-size: 15px; color: var(--ink); }
    .rc-foot { margin: 22px 0 0; font-size: 11px; line-height: 1.6; color: rgba(28, 29, 34, 0.5); }

  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";
    import { requireAdmin } from "../../lib/admin-gate.js";

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").trim().replace(/\/+$/, "");

    const gbp = (p) =>
      p == null ? "—" : (p / 100).toLocaleString("en-GB", { style: "currency", currency: "GBP" });
    const esc = (v) =>
      String(v ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    // Invoices are filed by the service that earned them, so "Invoice" here
    // means genuinely ad-hoc billing that is neither a shoot nor social.
    const SOURCE_LABEL = { pack: "Pack", videography: "Videography", social: "Social media", invoice: "Invoice", external: "External" };
    const longDate = (iso) =>
      new Date(iso).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });

    let all = [];
    let days = 90;
    let source = "all";
    let query = "";

    const el = (id) => document.getElementById(id);

    function visible() {
      const q = query.trim().toLowerCase();
      return all.filter((p) => {
        if (source !== "all" && p.source !== source) return false;
        if (!q) return true;
        return `${p.label} ${p.customer || ""}`.toLowerCase().includes(q);
      });
    }

    function render() {
      const rows = visible();
      const sum = (k) => rows.reduce((t, r) => t + (Number(r[k]) || 0), 0);

      el("pay-count").textContent = `${rows.length} payment${rows.length === 1 ? "" : "s"}`;
      const stats = { gross: sum("gross_pence"), vat: sum("vat_pence"), fees: sum("fee_pence"), received: sum("received_pence") };
      Object.entries(stats).forEach(([k, v]) => {
        const node = document.querySelector(`[data-stat="${k}"]`);
        if (node) node.textContent = gbp(v);
      });

      el("pay-empty").hidden = rows.length > 0;

      // Any derived VAT in view is said out loud. A figure we worked backwards
      // from the total must never be mistaken for one we were given.
      const derived = rows.filter((r) => r.vat_derived).length;
      const note = el("pay-note");
      if (derived) {
        note.hidden = false;
        note.textContent = `${derived} payment${derived === 1 ? " has its" : "s have their"} VAT worked back from the total (marked “est”) — those came from outside the Hub, so we hold no split for them. Check the source before filing a return.`;
      } else {
        note.hidden = true;
      }

      el("pay-table").innerHTML = rows.length
        ? `<div class="pay-row is-header" role="row">
             <div>Date</div><div>Source</div><div>What</div><div>Customer</div>
             <div class="pay-num">Net</div><div class="pay-num">VAT</div>
             <div class="pay-num">Gross</div><div class="pay-num">Received</div>
           </div>` +
          rows.map((p, i) => `
            <div class="pay-row" role="row" tabindex="0" data-i="${i}" title="Open receipt">
              <div class="pay-when">${esc(new Date(p.paid_at).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "2-digit" }))}</div>
              <div><span class="pay-src" data-s="${esc(p.source)}">${esc(SOURCE_LABEL[p.source] || p.source)}</span></div>
              <div class="pay-what">${esc(p.label)}${p.refunded_pence ? `<span class="pay-refund">${esc(gbp(p.refunded_pence))} refunded</span>` : ""}</div>
              <div class="pay-cust">${esc(p.customer || "—")}</div>
              <div class="pay-num">${esc(gbp(p.net_pence))}</div>
              <div class="pay-num">${esc(gbp(p.vat_pence))}${p.vat_derived ? ' <span class="pay-est">est</span>' : ""}</div>
              <div class="pay-num pay-gross">${esc(gbp(p.gross_pence))}</div>
              <div class="pay-num">${esc(gbp(p.received_pence))}</div>
            </div>`).join("")
        : "";
    }

    // ---- Receipt -----------------------------------------------------------
    // Built from the payment in front of us rather than raised as an invoice:
    // an invoice would consume a number from the sequence and read as a second
    // sale of money that has already been taken. This is a record of a payment,
    // for matching against the bank.
    let openPayment = null;

    function openReceipt(p) {
      openPayment = p;
      const msg = el("pay-modal-msg");
      msg.textContent = "";
      msg.classList.remove("is-bad");
      const line = (k, v, cls) => `<div class="rc-line ${cls || ""}"><span class="rc-k">${esc(k)}</span><span class="rc-v">${v}</span></div>`;
      el("pay-receipt").innerHTML = `
        <p class="rc-brand">TMKE &middot; Payment received</p>
        <h3 class="rc-title">${esc(p.label)}</h3>
        ${line("Received from", esc(p.customer || "—"))}
        ${line("Date", esc(longDate(p.paid_at)))}
        ${line("Source", esc(SOURCE_LABEL[p.source] || p.source))}
        ${line("Net", esc(gbp(p.net_pence)) + (p.vat_derived ? ' <span class="pay-est">est</span>' : ""))}
        ${line("VAT", esc(gbp(p.vat_pence)) + (p.vat_derived ? ' <span class="pay-est">est</span>' : ""))}
        ${line("Gross paid", esc(gbp(p.gross_pence)), "rc-total")}
        ${p.off_stripe ? "" : line("Stripe fee", esc(gbp(p.fee_pence)))}
        ${line("Received in bank", esc(gbp(p.received_pence)))}
        ${p.refunded_pence ? line("Refunded", esc(gbp(p.refunded_pence))) : ""}
        ${line(p.off_stripe ? "Reference" : "Stripe reference", esc(p.off_stripe ? p.label : p.id))}
        <p class="rc-foot">
          ${p.off_stripe ? "Settled outside Stripe, so the full amount reached the bank. " : ""}${p.vat_derived
            ? "The VAT on this payment was worked back from the total at the standard rate — it was taken outside the Hub, so no split was recorded at the time. Confirm against the source before relying on it for a return."
            : "The VAT split shown is the one recorded when the payment was taken."}
          <br>A record of a payment received, not a VAT invoice.
        </p>`;
      el("pay-modal").hidden = false;
    }
    function closeReceipt() { el("pay-modal").hidden = true; openPayment = null; }

    // The PDF is rendered by the Worker, not by the browser's print dialog -
    // that dialog was dropping the top of the document, and it produced
    // something you had to save, find and attach by hand.
    async function receiptRequest(action, btn) {
      if (!openPayment) return;
      const msg = el("pay-modal-msg");
      const orig = btn.textContent;
      btn.setAttribute("disabled", "true");
      btn.textContent = action === "email" ? "Sending…" : "Building…";
      msg.textContent = "";
      msg.classList.remove("is-bad");

      const { data } = await supabase.auth.getSession();
      const token = data?.session?.access_token;
      const p = openPayment;
      try {
        const res = await fetch(`${WORKER}/admin/payments/receipt`, {
          method: "POST",
          headers: { "Content-Type": "application/json", ...(token ? { Authorization: "Bearer " + token } : {}) },
          body: JSON.stringify({
            action, id: p.id, label: p.label, customer: p.customer,
            source: SOURCE_LABEL[p.source] || p.source,
            vat_pence: p.vat_pence, vat_derived: p.vat_derived,
          }),
        });
        if (!res.ok) {
          const body = await res.json().catch(() => ({}));
          throw new Error(body.error || `That didn't work (${res.status})`);
        }
        if (action === "email") {
          const body = await res.json().catch(() => ({}));
          msg.textContent = `Sent to ${body.sent_to || "accounts"}.`;
        } else {
          const blob = await res.blob();
          const a = document.createElement("a");
          a.href = URL.createObjectURL(blob);
          a.download = `TMKE-receipt-${p.paid_at.slice(0, 10)}-${p.id}.pdf`;
          document.body.appendChild(a);
          a.click();
          a.remove();
          setTimeout(() => URL.revokeObjectURL(a.href), 2000);
          msg.textContent = "Downloaded.";
        }
      } catch (e) {
        msg.classList.add("is-bad");
        msg.textContent = e.message;
      }
      btn.removeAttribute("disabled");
      btn.textContent = orig;
    }

    function exportCsv() {
      const rows = visible();
      if (!rows.length) return;
      const head = ["Date", "Source", "Item", "Customer", "Net", "VAT", "VAT estimated", "Gross", "Stripe fee", "Received", "Refunded", "Stripe charge id"];
      const cell = (v) => `"${String(v ?? "").replace(/"/g, '""')}"`;
      const money = (p) => (p == null ? "" : (p / 100).toFixed(2));
      const body = rows.map((p) => [
        new Date(p.paid_at).toISOString().slice(0, 10),
        SOURCE_LABEL[p.source] || p.source,
        p.label, p.customer || "",
        money(p.net_pence), money(p.vat_pence), p.vat_derived ? "yes" : "no",
        money(p.gross_pence), money(p.fee_pence), money(p.received_pence),
        money(p.refunded_pence), p.id,
      ].map(cell).join(","));
      const blob = new Blob([[head.map(cell).join(","), ...body].join("\r\n")], { type: "text/csv;charset=utf-8" });
      const a = document.createElement("a");
      a.href = URL.createObjectURL(blob);
      a.download = `tmke-payments-${new Date().toISOString().slice(0, 10)}.csv`;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    }

    async function load() {
      const listEl = el("pay-list");
      const loading = el("pay-loading");
      listEl.setAttribute("aria-busy", "true");
      loading.hidden = false;
      loading.textContent = "Reading your Stripe account…";
      el("pay-table").innerHTML = "";

      const { data } = await supabase.auth.getSession();
      const token = data?.session?.access_token;
      try {
        const res = await fetch(`${WORKER}/admin/payments?days=${encodeURIComponent(days)}`, {
          headers: token ? { Authorization: "Bearer " + token } : {},
        });
        const body = await res.json().catch(() => ({}));
        if (!res.ok || !body.ok) throw new Error(body.error || `Stripe request failed (${res.status})`);
        all = Array.isArray(body.payments) ? body.payments : [];
        loading.hidden = true;
        listEl.removeAttribute("aria-busy");
        render();
        if (body.truncated) {
          const note = el("pay-note");
          note.hidden = false;
          note.textContent = "There are more payments in this period than one request can return. Narrow the date range to see the rest.";
        }
      } catch (e) {
        loading.hidden = false;
        loading.textContent = `Could not load payments: ${e.message}`;
        listEl.removeAttribute("aria-busy");
      }
    }

    function wireChips(hostId, attr, onPick) {
      const host = el(hostId);
      if (!host) return;
      host.addEventListener("click", (ev) => {
        const btn = ev.target.closest(`[data-${attr}]`);
        if (!btn) return;
        host.querySelectorAll(".enquiry-chip").forEach((b) => b.classList.remove("is-active"));
        btn.classList.add("is-active");
        onPick(btn.getAttribute(`data-${attr}`));
      });
    }

    (async () => {
      const session = await requireAdmin();
      if (!session) return;

      wireChips("pay-range", "days", (v) => { days = Number(v) || 90; load(); });
      wireChips("pay-source", "source", (v) => { source = v; render(); });
      el("pay-search").addEventListener("input", (ev) => { query = ev.target.value || ""; render(); });
      el("pay-csv").addEventListener("click", exportCsv);

      // Delegated: the rows don't exist until a fetch has come back.
      el("pay-table").addEventListener("click", (ev) => {
        const row = ev.target.closest(".pay-row:not(.is-header)");
        if (!row) return;
        const p = visible()[Number(row.dataset.i)];
        if (p) openReceipt(p);
      });
      el("pay-table").addEventListener("keydown", (ev) => {
        if (ev.key !== "Enter" && ev.key !== " ") return;
        const row = ev.target.closest(".pay-row:not(.is-header)");
        if (!row) return;
        ev.preventDefault();
        const p = visible()[Number(row.dataset.i)];
        if (p) openReceipt(p);
      });

      el("pay-modal-close").addEventListener("click", closeReceipt);
      el("pay-modal-cancel").addEventListener("click", closeReceipt);
      el("pay-modal").addEventListener("click", (ev) => { if (ev.target === el("pay-modal")) closeReceipt(); });
      document.addEventListener("keydown", (ev) => { if (ev.key === "Escape") closeReceipt(); });
      el("pay-download").addEventListener("click", (ev) => receiptRequest("download", ev.currentTarget));
      el("pay-send").addEventListener("click", (ev) => receiptRequest("email", ev.currentTarget));

      await load();
    })();
  </script>
</AdminShell>
