---
import AdminShell from "../../../components/admin/AdminShell.astro";
import "../../../styles/admin.css";
import { EMAIL_STYLE_DEFAULTS, EMAIL_FONT_STACKS } from "../../../lib/email-styles.js";

// The emails worth previewing against: one of each shape. A short list on
// purpose — the point is to see a change land, not to browse all 28.
const SAMPLES = [
  { id: "waitlist_register", label: "Cancellation list" },
  { id: "vid_booking_client", label: "Booking confirmation" },
  { id: "post_reminder", label: "Scheduled post reminder" },
  { id: "setup_reminder", label: "Setup reminder" },
  { id: "invoice_sent", label: "Invoice" },
];
const D = EMAIL_STYLE_DEFAULTS;
---

<AdminShell active="email" title="Email styles" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Email styles</div>
          <div class="page-header-sub">The shared look for all 28 automated emails — change a value, watch the preview.</div>
        </div>
      </div>
      <div class="page-header-actions">
        <button type="button" class="ct-tool-btn" id="es-reset">Reset to defaults</button>
        <button type="button" class="ct-tool-btn ct-tool-primary" id="es-save">Save</button>
      </div>
    </div>
  </div>
  <div class="ash-panel ash-page">
    <p class="es-warn" id="es-setup" hidden>
      This needs a one-off database step: run <code>supabase/email_styles.sql</code> in the Supabase SQL editor, then reload.
    </p>

    <div class="es-wrap">
      <!-- ── controls ── -->
      <div class="es-controls">
        <h3 class="es-h">Layout</h3>
        <div class="es-f3">
          <label class="es-f"><span>Content width</span><input type="number" data-s="contentWidth" min="320" max="800" step="10" /></label>
          <label class="es-f"><span>Side padding</span><input type="number" data-s="contentPadX" min="0" max="80" /></label>
        </div>
        <div class="es-f3">
          <label class="es-f"><span>Divider thickness</span><input type="number" data-s="ruleWidth" min="0" max="8" /></label>
          <label class="es-f"><span>Space around divider</span><input type="number" data-s="ruleGap" min="0" max="60" /></label>
        </div>
        <p class="es-hint">Side padding sits inside the branded base's own inset, so it narrows the column further rather than replacing it.</p>

        <h3 class="es-h">Type</h3>
        <label class="es-f"><span>Font</span>
          <select data-s="font">{EMAIL_FONT_STACKS.map((f) => <option value={f.key}>{f.label}</option>)}</select>
        </label>
        <div class="es-f3">
          <label class="es-f"><span>Heading size</span><input type="number" data-s="headingSize" min="10" max="60" /></label>
          <label class="es-f"><span>Body size</span><input type="number" data-s="bodySize" min="8" max="24" /></label>
          <label class="es-f"><span>Small print</span><input type="number" data-s="smallSize" min="7" max="20" /></label>
        </div>
        <div class="es-f3">
          <label class="es-f"><span>Heading weight</span>
            <select data-s="headingWeight"><option value="400">Normal</option><option value="700">Bold</option></select>
          </label>
          <label class="es-f"><span>Heading tracking</span><input type="number" data-s="headingTracking" min="-3" max="10" step="0.5" /></label>
          <label class="es-f"><span>Heading line height</span><input type="number" data-s="headingLine" min="1" max="2.5" step="0.05" /></label>
        </div>
        <div class="es-f3">
          <label class="es-f"><span>Gap under heading</span><input type="number" data-s="headingGap" min="0" max="60" /></label>
          <label class="es-f"><span>Gap under paragraph</span><input type="number" data-s="bodyGap" min="0" max="60" /></label>
          <label class="es-f"><span>Body line height</span><input type="number" data-s="bodyLine" min="1" max="2.5" step="0.05" /></label>
        </div>

        <div class="es-f3">
          <label class="es-f"><span>Small print colour</span><input type="color" data-s="smallColor" /></label>
          <label class="es-f"><span>Gap above small print</span><input type="number" data-s="smallGap" min="0" max="60" /></label>
        </div>

        <h3 class="es-h">Colours</h3>
        <div class="es-f3">
          <label class="es-f"><span>Dark (text)</span><input type="color" data-s="dark" /></label>
          <label class="es-f"><span>Light (panels)</span><input type="color" data-s="light" /></label>
        </div>

        <h3 class="es-h">Buttons</h3>
        <div class="es-f3">
          <label class="es-f"><span>Size</span><input type="number" data-s="buttonSize" min="8" max="24" /></label>
          <label class="es-f"><span>Weight</span>
            <select data-s="buttonWeight"><option value="400">Normal</option><option value="700">Bold</option></select>
          </label>
          <label class="es-f"><span>Corner radius</span><input type="number" data-s="buttonRadius" min="0" max="40" /></label>
        </div>
        <div class="es-f3">
          <label class="es-f"><span>Background</span><input type="color" data-s="buttonBg" /></label>
          <label class="es-f"><span>Text</span><input type="color" data-s="buttonColor" /></label>
        </div>
        <div class="es-f3">
          <label class="es-f"><span>Padding — vertical</span><input type="number" data-s="buttonPadY" min="0" max="40" /></label>
          <label class="es-f"><span>Padding — sides</span><input type="number" data-s="buttonPadX" min="0" max="60" /></label>
        </div>

        <h3 class="es-h">Quote box</h3>
        <label class="es-check"><input type="checkbox" data-s="quoteEnabled" /> Use a quote box</label>
        <p class="es-hint">Off = the quoted text renders as an ordinary paragraph, with no panel or border. A <strong>negative</strong> side margin pulls the box wider than the text column, towards full-bleed.</p>
        <div class="es-f3">
          <label class="es-f"><span>Background</span><input type="color" data-s="quoteBg" /></label>
          <label class="es-f"><span>Border colour</span><input type="color" data-s="quoteBorderColor" /></label>
          <label class="es-f"><span>Border width</span><input type="number" data-s="quoteBorderWidth" min="0" max="12" /></label>
        </div>
        <div class="es-f3">
          <label class="es-f"><span>Line height</span><input type="number" data-s="quoteLine" min="1" max="2.5" step="0.05" /></label>
          <label class="es-f"><span>Side margin</span><input type="number" data-s="quoteMarginX" min="-60" max="60" /></label>
          <label class="es-f"><span>Corner radius</span><input type="number" data-s="quoteRadius" min="0" max="40" /></label>
          <label class="es-f"><span>Padding — vertical</span><input type="number" data-s="quotePadY" min="0" max="40" /></label>
          <label class="es-f"><span>Padding — sides</span><input type="number" data-s="quotePadX" min="0" max="40" /></label>
        </div>
      </div>

      <!-- ── preview ── -->
      <div class="es-preview">
        <div class="es-pv-bar">
          <select id="es-sample">{SAMPLES.map((s) => <option value={s.id}>{s.label}</option>)}</select>
          <label class="es-check"><input type="checkbox" id="es-branded" checked /> In the branded base</label>
          <span class="es-pv-state" id="es-state"></span>
        </div>
        <iframe id="es-frame" title="Email preview" sandbox=""></iframe>
      </div>
    </div>
  </div>
</AdminShell>

<script>
  // NOT define:vars — that forces the script inline, which stops Astro bundling
  // it and ships these imports as unresolvable relative paths. The defaults are
  // imported from the shared module instead, which is where they belong anyway.
  import { supabase } from "../../../lib/supabase.js";
  import { requireAdmin } from "../../../lib/admin-gate.js";
  import { EMAIL_STYLE_DEFAULTS as DEFAULTS } from "../../../lib/email-styles.js";

  const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").trim().replace(/\/+$/, "");
  const $ = (s) => document.querySelector(s);
  const state = { ...DEFAULTS };
  let token = null, timer = null;

  const NUMERIC = new Set(Object.keys(DEFAULTS).filter((k) => typeof DEFAULTS[k] === "number"));

  function readControls() {
    document.querySelectorAll("[data-s]").forEach((el) => {
      const k = el.getAttribute("data-s");
      if (el.type === "checkbox") state[k] = el.checked;
      else if (NUMERIC.has(k)) state[k] = el.value === "" ? DEFAULTS[k] : Number(el.value);
      else state[k] = el.value;
    });
  }
  function writeControls() {
    document.querySelectorAll("[data-s]").forEach((el) => {
      const k = el.getAttribute("data-s");
      if (el.type === "checkbox") el.checked = state[k] !== false;
      else el.value = state[k] != null ? state[k] : "";
    });
  }

  // Previewed through the Worker's REAL pipeline with the unsaved settings, so
  // what's on screen is what would send — not a browser approximation of it.
  async function preview() {
    if (!WORKER || !token) return;
    $("#es-state").textContent = "Rendering…";
    try {
      const res = await fetch(`${WORKER}/email/preview`, {
        method: "POST",
        headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
        body: JSON.stringify({ id: $("#es-sample").value, branded: $("#es-branded").checked, styles: state }),
      });
      const out = await res.json();
      $("#es-frame").srcdoc = out && out.html ? out.html : "<p style='font:13px sans-serif;padding:16px'>No preview for this one.</p>";
      $("#es-state").textContent = "";
    } catch (e) { $("#es-state").textContent = "Preview failed"; }
  }
  const schedulePreview = () => { clearTimeout(timer); timer = setTimeout(preview, 250); };

  document.addEventListener("input", (e) => {
    if (!e.target.closest("[data-s]") && e.target.id !== "es-sample" && e.target.id !== "es-branded") return;
    readControls(); schedulePreview();
  });
  document.addEventListener("change", (e) => {
    if (e.target.id === "es-sample" || e.target.id === "es-branded") schedulePreview();
  });

  $("#es-reset").addEventListener("click", () => {
    if (!confirm("Reset every value back to the defaults? This doesn't save until you press Save.")) return;
    Object.assign(state, DEFAULTS); writeControls(); preview();
  });

  $("#es-save").addEventListener("click", async () => {
    readControls();
    const btn = $("#es-save"); btn.disabled = true; btn.textContent = "Saving…";
    const { error } = await supabase.from("email_styles")
      .update({ styles: state, updated_at: new Date().toISOString() }).eq("id", 1);
    btn.disabled = false; btn.textContent = "Save";
    if (error) {
      // The table not existing is by far the likeliest cause, and the raw
      // Postgres message doesn't say what to do about it.
      $("#es-setup").hidden = !/email_styles/i.test(error.message || "");
      alert("Couldn't save: " + error.message);
      return;
    }
    $("#es-state").textContent = "Saved — live within a minute";
    setTimeout(() => ($("#es-state").textContent = ""), 4000);
  });

  (async () => {
    const session = await requireAdmin("/admin/login");
    if (!session) return;
    token = session.access_token;
    const { data, error } = await supabase.from("email_styles").select("styles").eq("id", 1).maybeSingle();
    if (error && /email_styles/i.test(error.message || "")) $("#es-setup").hidden = false;
    Object.assign(state, DEFAULTS, (data && data.styles) || {});
    writeControls();
    preview();
  })();
</script>

<style is:global>
  .es-title { font-family: var(--serif); font-size: 20px; margin: 0 0 2px; }
  /* One line: it's a single instruction, and wrapping it made the actions
     beside it sit tight against both the copy and the controls below. */
  .es-sub { font-size: 12.5px; color: #6b6b70; margin: 0; white-space: nowrap; }
  @media (max-width: 1100px) { .es-sub { white-space: normal; } }
  .es-actions { margin: 16px 0 20px; }
  .es-warn { background: #fff4e5; border: 1px solid #f0d3a4; border-radius: 8px; padding: 10px 14px; font-size: 13px; margin: 0 0 14px; }
  .es-warn code { background: rgba(0,0,0,0.06); padding: 1px 5px; border-radius: 4px; }
  .es-wrap { display: grid; grid-template-columns: minmax(320px, 420px) 1fr; gap: 20px; align-items: start; }
  @media (max-width: 900px) { .es-wrap { grid-template-columns: 1fr; } }
  .es-controls { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; padding: 16px 18px; }
  .es-h { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.45); margin: 16px 0 8px; }
  .es-h:first-child { margin-top: 0; }
  .es-f { display: block; margin: 0 0 10px; }
  .es-f > span { display: block; font-size: 11.5px; color: #6b6b70; margin: 0 0 3px; }
  .es-f input, .es-f select { width: 100%; padding: 7px 9px; border: 1px solid rgba(28,29,34,0.16); border-radius: 6px; font-size: 13px; background: #fff; }
  .es-f input[type="color"] { padding: 2px; height: 34px; }
  .es-f3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
  .es-f3:has(> :nth-child(2):last-child) { grid-template-columns: repeat(2, 1fr); }
  .es-check { display: flex; align-items: center; gap: 7px; font-size: 13px; margin: 0 0 6px; }
  .es-hint { font-size: 11.5px; color: #8a8796; margin: 0 0 10px; }
  .es-preview { position: sticky; top: 16px; }
  .es-pv-bar { display: flex; align-items: center; gap: 12px; margin: 0 0 8px; }
  .es-pv-bar select { padding: 7px 9px; border: 1px solid rgba(28,29,34,0.16); border-radius: 6px; font-size: 13px; background: #fff; }
  .es-pv-state { font-size: 12px; color: #6b6b70; }
  #es-frame { width: 100%; height: 78vh; border: 1px solid rgba(28,29,34,0.12); border-radius: 10px; background: #fff; }
</style>
