      const brand = { ...defaultBrand(), ...(t.branding || {}) };
      const ctx = mergeContextFor({ name: me.split("@")[0], email: me, company: SAMPLE_RECIPIENT.company }, brand);
      const { subject, html } = renderTemplate({ subject: t.subject, preheader: t.preheader, mode: t.mode, blocks: t.blocks, customHtml: t.custom_html, branding: t.branding }, { brand, mergeCtx: ctx });
      await workerPost("/email/send", { to: me, subject: "[Test] " + (subject || t.name), html });
