        const d = new Date(`${PLAN.start_on}T12:00:00`); d.setDate(d.getDate() + i * gap);
        return { on: d.toLocaleDateString("en-CA"), at: PLAN.start_at };
      });
    }
    function drawPlan() {
      if (!PLAN) planStart();
