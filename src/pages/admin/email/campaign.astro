    }
    function openKeep(email) {
      $("cp-pop").innerHTML = `<div class="scrim" id="cp-scrim"><div class="pop" style="height:500px" role="dialog" aria-modal="true" aria-labelledby="cp-k-t">
        <div class="pop-h"><div><p class="mo-eye">Templates</p><div class="pop-title" id="cp-k-t">Save as a template</div></div><button type="button" class="x" data-close aria-label="Close">×</button></div>
        <div class="pop-b">
          <p>A copy goes into Templates. The email in this campaign stays as it is.</p>
          <label class="field"><span>Title</span><input type="text" id="cp-k-title" maxlength="120" value="${esc(email.name || "")}" /></label>
          <label class="field"><span>What area of the business is this for?</span><select id="cp-k-area"><option value="">Choose an area</option>${AREAS.map((x) => `<option${x === areaOf(A) ? " selected" : ""}>${esc(x)}</option>`).join("")}</select></label>
          <label class="field"><span>Description</span><textarea id="cp-k-desc" maxlength="400" placeholder="What is it for, and when would you use it?"></textarea></label>
          <p class="err" id="cp-k-err" hidden></p>
        </div>
        <div class="pop-f"><button type="button" class="mbtn" data-close>Cancel</button><button type="button" class="mbtn primary" id="cp-k-go">Save template</button></div>
      </div></div>`;
      const scrim = $("cp-scrim"); const close = () => { $("cp-pop").innerHTML = ""; };
      scrim.addEventListener("click", (e) => { if (e.target === scrim || (e.target instanceof HTMLElement && e.target.closest("[data-close]"))) close(); });
      scrim.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
      $("cp-k-title").focus();
      $("cp-k-go").addEventListener("click", async () => {
        const err = $("cp-k-err"), say = (t) => { err.textContent = t; err.hidden = false; };
        const fields = { title: $("cp-k-title").value.trim(), area: $("cp-k-area").value, description: $("cp-k-desc").value };
        if (!fields.title) { say("Give the template a title."); return; }
        if (!fields.area) { say("Choose the area of the business it is for."); return; }
        if (DEMO) { say("This is the example copy: nothing is saved from here."); return; }
        const full = await supabase.from("email_templates").select("*").eq("id", email.id).single();
        if (full.error) { say("Couldn't read the email: " + full.error.message); return; }
        const r = await saveAsTemplate(supabase, full.data, fields);
        if (r.error) { say(r.needsSql ? "Templates need one database step first: run supabase/email_templates_library.sql." : "Couldn't save: " + r.error.message); return; }
        close(); toast("Saved to Templates.");
      });
    }

    // ---- 3 Schedule ------------------------------------------------------------
    const gapText = (a, b) => {
      const days = Math.round((new Date(`${b}T12:00:00`) - new Date(`${a}T12:00:00`)) / 864e5);
      if (days <= 0) return ""; if (days === 7) return "Wait a week"; if (days === 14) return "Wait two weeks"; return `Wait ${plural(days, "day", "days")}`;
    };
    function problems() {
      const pr = progress(); const out = []; const now = new Date();
      if (!pr.length) out.push("There are no emails in the plan.");
      if (!tags().length) out.push("Nobody is chosen yet: add a tag in the plan.");
      const unwritten = pr.filter((p) => !p.email).length;
      if (unwritten) out.push(`${plural(unwritten, "email is", "emails are")} not written yet.`);
      const undated = pr.filter((p) => !isDate((p.it.node.config || {}).send_on) || !isTime((p.it.node.config || {}).send_at)).length;
      if (undated) out.push(`${plural(undated, "email has", "emails have")} no date and time.`);
      const past = pr.filter((p) => { const c = p.it.node.config || {}; return isDate(c.send_on) && isTime(c.send_at) && new Date(`${c.send_on}T${c.send_at}`) <= now; }).length;
      if (past) out.push(`${plural(past, "email is", "emails are")} dated in the past, and would go straight away.`);
      if (WHO.ok === 0) out.push("Nobody in that group can be sent this.");
      return out;
    }
    function drawSchedule() {
      const pr = progress(); const can = SIMPLE && A.status !== "archived"; const t = tags();
      let rows = `<div class="cp-row"><span class="cp-dot start"></span><div class="cp-rt"><b>Start: ${t.length ? `everyone tagged ${esc(t.join(" or "))}` : "nobody chosen yet"}</b><span>${draft() ? "They are added on the day you approve it" : `${plural(LIVE, "person is", "people are")} in it now`}</span></div><span></span></div>`;
      let prevDate = "";
      ITEMS.forEach((it) => {
        const id = esc(it.node.id); const c = it.node.config || {};
        if (it.kind === "send") {
          const p = pr.find((x) => x.it === it);
          if (prevDate && isDate(c.send_on)) { const g = gapText(prevDate, c.send_on); if (g) rows += `<div class="cp-row soft"><span class="cp-dot wait"></span><div class="cp-rt"><span>${g}</span></div><span></span></div>`; }
          if (isDate(c.send_on)) prevDate = c.send_on;
          rows += `<div class="cp-row"><span class="cp-dot"></span><div class="cp-rt"><b>Send email ${p.n}${p.email ? ": " + esc(p.email.name) : ""}</b><span>${esc(stepWhen(it.node) || "No date yet")}${p.sent ? ` · sent${p.count ? " to " + p.count : ""}` : p.email ? "" : " · not written yet"}</span></div>${can && !p.sent ? `<button type="button" class="mbtn small" data-change="${id}">Change</button>` : "<span></span>"}</div>`;
          if (editing === it.node.id) rows += `<div class="cp-edit"><label><span class="cp-lab">Date</span><input type="date" id="sc-on" value="${esc(c.send_on || "")}" min="${todayLondon()}" /></label><label><span class="cp-lab">Time</span><input type="time" id="sc-at" value="${esc(c.send_at || "")}" /></label><button type="button" class="mbtn primary" data-savewhen="${id}">Save</button><button type="button" class="mbtn" data-cancel>Cancel</button></div>`;
        } else if (it.kind === "check") {
          const want = Array.isArray(c.values) && c.values.length ? c.values : (c.value ? [c.value] : []);
          const isTag = (c.field || "has_tag") === "has_tag" || c.field === "tag";
          const tagQ = (c.op || "is") === "is_not" ? "are they without" : "do they have";
          const q = isTag ? `${tagQ} ${want.length ? "the tag " + esc(want.join(" or ")) : "a tag (none chosen)"}?` : `${esc(c.field)} ${esc(c.op || "is")} ${esc(c.value || "")}?`;
          rows += `<div class="cp-row"><span class="cp-dot check"></span><div class="cp-rt"><b>Check: ${q}</b><span>Looked at for each person just before the next email</span></div>${can && draft() ? `<button type="button" class="mbtn small" data-change="${id}">Change</button>` : "<span></span>"}</div>`;
          const line = (yes) => `<div class="cp-row branch"><span class="cp-dot none"></span><div class="cp-rt"><b><span class="cp-yn${yes ? "" : " no"}">${yes ? "Yes" : "No"}</span>${(it.leaves === "yes") === yes ? "They leave the campaign" : "They carry on"}</b><span>${(it.leaves === "yes") === yes ? "No more of these emails" : "On to the next email below"}</span></div><span></span></div>`;
          rows += line(true) + line(false);
          if (editing === it.node.id) rows += `<div class="cp-edit"><label class="grow"><span class="cp-lab">Leave the campaign if they have the tag</span><select id="sc-tag">${tagOptions(want[0] || "")}</select></label><button type="button" class="mbtn primary" data-savecheck="${id}">Save</button><button type="button" class="mbtn danger" data-dropcheck="${id}">Remove the check</button><button type="button" class="mbtn" data-cancel>Cancel</button></div>`;
        } else if (it.kind === "wait") {
          const amt = c.amount || c.value || ""; const unit = c.unit || "";
          rows += `<div class="cp-row soft"><span class="cp-dot wait"></span><div class="cp-rt"><span>Wait ${esc(String(amt))} ${esc(String(unit))}</span></div><span></span></div>`;
        } else {
          rows += `<div class="cp-row soft"><span class="cp-dot wait"></span><div class="cp-rt"><span>A step from the step builder (${esc(it.node.type)})</span></div><span></span></div>`;
        }
      });
      rows += `<div class="cp-row"><span class="cp-dot start"></span><div class="cp-rt"><b>Finish</b><span>The campaign moves to Previous</span></div><span></span></div>`;
      const adding = editing === "+check";
      const tools = can && draft() ? `<div class="cp-foot" style="justify-content:flex-start;margin-top:12px"><button type="button" class="mbtn small" data-addcheck>Add a check</button><a class="mbtn small" href="/admin/automations/edit?id=${encodeURIComponent(A.id)}">Open the full step builder</a></div>
        ${adding ? `<div class="cp-edit" style="margin-top:10px"><label><span class="cp-lab">Before</span><select id="sc-before">${pr.filter((p) => !p.sent && p.n > 1).map((p) => `<option value="${esc(p.it.node.id)}">Email ${p.n}</option>`).join("")}</select></label><label class="grow"><span class="cp-lab">Leave the campaign if they have the tag</span><select id="sc-tag">${tagOptions("")}</select></label><button type="button" class="mbtn primary" data-newcheck>Add</button><button type="button" class="mbtn" data-cancel>Cancel</button></div>` : ""}` : "";

      const probs = draft() ? problems() : [];
      let side = `<div class="cp-side"><h2>Who gets it</h2>
          <div><b id="sc-who">${t.length ? "Counting…" : "Nobody yet"}</b><p id="sc-out" style="color:var(--tx)"></p></div>
          <p style="color:var(--tx)">${draft() ? "The group is fixed when you approve. Anyone given the tag after that is not added, so nobody is sent emails that have already gone." : "The group was fixed when it was approved. Anyone given the tag since is not in it."}</p>
          ${draft() ? "" : `<a class="cp-link" href="/admin/automations/audit?id=${encodeURIComponent(A.id)}">See who is in it</a>`}</div>`;
      if (draft()) side += `<div class="cp-side fill"><h2>Before it starts</h2>
          ${probs.length ? `<ul>${probs.map((p) => `<li class="todo">${esc(p)}</li>`).join("")}</ul>` : `<p>Everything is ready. Approving adds the group and lines up every email for its date.</p>`}
          <button type="button" class="mbtn primary" id="sc-go" ${probs.length || !SIMPLE ? "disabled" : ""}>Approve and start</button>
          <button type="button" class="mbtn" id="sc-tests">Send every email to me first</button>
          <p id="sc-msg" role="status"></p></div>`;
      else side += `<div class="cp-side fill"><h2>${A.status === "active" ? "Running" : A.status === "paused" ? "Paused" : "Finished"}</h2>
          <p>${A.status === "active" ? `Approved ${meta().went_live_at ? fmtWhen(meta().went_live_at) : ""}. Emails that have gone are locked; change the date of one still to come with Change.` : A.status === "paused" ? "Nothing sends and nobody moves while it is paused. Reactivate it in the step builder, which shows anything that fell due meanwhile." : "This campaign has ended."}</p>
          ${A.status === "active" ? `<button type="button" class="mbtn" data-do="pause">Pause the campaign</button><button type="button" class="mbtn danger" data-do="end">End the campaign</button>` : A.status === "paused" ? `<a class="mbtn" href="/admin/automations/edit?id=${encodeURIComponent(A.id)}">Open the step builder</a>` : ""}
          <p id="sc-msg" role="status"></p></div>`;
      $("cp-main").innerHTML = `${told()}<div class="cp-two"><section><div class="strip"><span class="strip-t">${draft() ? "Suggested from your plan" : "The schedule"}</span></div>${rows}${tools}</section><aside>${side}</aside></div>`;
      scheduleWho();
    }
    function tagOptions(cur) {
      return `<option value="">Choose a tag</option>${TAGS.map(([g, list]) => `<optgroup label="${esc(g)}">${list.map((t) => `<option value="${esc(t)}"${t === cur ? " selected" : ""}>${esc(tagText(t))}</option>`).join("")}</optgroup>`).join("")}`;
    }
    async function scheduleWho() {
      const t = tags(); if (!t.length || !$("sc-who")) return;
      const run = ++whoRun;
      const w = await whoCount(t, kind());
      if (run !== whoRun || !$("sc-who")) return;
      const first = WHO.ok == null; WHO = w;
      $("sc-who").textContent = draft() ? `${plural(w.ok, "person", "people")} would get it today` : `${plural(w.ok, "person", "people")} carry that tag today`;
      $("sc-out").textContent = w.total > w.ok ? `${w.total - w.ok} left out: ${kind() === "marketing" ? "not opted in, unsubscribed or do-not-contact" : "unsubscribed or do-not-contact"}` : "";
      if (first && draft() && w.ok === 0) drawSchedule();
    }
    async function everyoneIds() {
      const ids = [];
      for (let from = 0; from < 100000; from += 1000) {
        const { data, error } = await supabase.from("contacts").select("id").overlaps("tags", tags()).order("id", { ascending: true }).range(from, from + 999);
        if (error) throw error;
        ids.push(...(data || []).map((r) => r.id));
        if ((data || []).length < 1000) break;
      }
      return ids;
    }
    async function approve(btn) {
      const say = (t, bad) => { const m = $("sc-msg"); if (m) { m.textContent = t; m.style.color = bad ? "var(--bad)" : ""; } };
      if (DEMO) { say("This is the example copy: nothing starts from here.", true); return; }
      if (!WORKER) { say("The Worker isn't connected, so nothing can be sent.", true); return; }
      if (problems().length) { drawSchedule(); return; }
      if (btn.dataset.armed !== "1") { btn.dataset.armed = "1"; btn.textContent = `Press again to start it for ${plural(WHO.ok || 0, "person", "people")}`; say("You can pause or end it afterwards, but an email that has gone can't be taken back."); return; }
      btn.disabled = true; let enrolled = 0, total = 0;
      try {
        say("Saving.");
        const group = [...tags()];
        meta().campaign = true; meta().to = { mode: "tags", tags: group };
        A.trigger_type = "manual"; A.trigger_config = {};
        await save(false);
        const ids = await everyoneIds(); total = ids.length;
        if (!total) throw new Error("Nobody matches that group any more.");
        await workerPost("/automations/set-status", { automation_id: A.id, status: "active" });
        for (let i = 0; i < ids.length; i += ENROL_BATCH) {
          say(`Adding people: ${Math.min(i + ENROL_BATCH, total)} of ${total}.`);
          const d = await workerPost("/automations/enroll-contacts", { automation_id: A.id, contact_ids: ids.slice(i, i + ENROL_BATCH) });
          enrolled += d.enrolled || 0;
        }
        toast(`Started. ${plural(enrolled, "person is", "people are")} in the campaign.`);
        await load(); go("insights");
      } catch (e) {
        say(`${enrolled ? `${enrolled} of ${total} were added before it stopped. ` : ""}Couldn't finish: ${(e && e.message) || e}`, true);
        try { await load(); draw(); } catch (_) {}
      }
    }

    // ---- 4 Insights ------------------------------------------------------------
    // Sent, opened and clicked for each email, each person once and a click
    // counting as an open. These are the figures as reported: the full report
    // (the audit page) is where email security scanners are told apart.
    async function readStats() {
      const out = new Map();
      if (DEMO) { sends().slice(0, 2).forEach((it, i) => out.set(it.node.id, { sent: 112, opened: 35 - i * 3, clicked: 5 + i })); return out; }
      const ev = [];
      for (let from = 0; from < 50000; from += 1000) {
        const r = await supabase.from("email_events").select("event, contact_id, email, node_id, message_id").eq("automation_id", A.id).order("occurred_at", { ascending: true }).order("id", { ascending: true }).range(from, from + 999);
        if (r.error) break;
        ev.push(...(r.data || []));
        if ((r.data || []).length < 1000) break;
      }
      const byMsg = new Map(); ev.forEach((e) => { if (e.event === "sent" && e.message_id && e.node_id) byMsg.set(e.message_id, e.node_id); });
      const sets = new Map(); const get = (id) => { if (!sets.has(id)) sets.set(id, { sent: new Set(), opened: new Set(), clicked: new Set() }); return sets.get(id); };
      ev.forEach((e) => {
        const node = e.node_id || (e.message_id && byMsg.get(e.message_id)); const who = e.contact_id || e.email;
        if (!node || !who) return;
        const s = get(node);
        if (e.event === "sent") s.sent.add(who);
        else if (e.event === "opened") s.opened.add(who);
        else if (e.event === "clicked") { s.clicked.add(who); s.opened.add(who); }
      });
      sets.forEach((s, id) => out.set(id, { sent: s.sent.size, opened: s.opened.size, clicked: s.clicked.size }));
      return out;
    }
    function drawInsights() {
      const pr = progress(); const sent = pr.filter((p) => p.sent).length;
      const pct = (a, b) => (b ? Math.round((a / b) * 100) + "%" : "");
      let o = 0, c = 0, s = 0;
      if (STATS) pr.forEach((p) => { const x = STATS.get(p.it.node.id); if (x && x.sent) { s += x.sent; o += x.opened; c += x.clicked; } });
      const next = pr.find((p) => !p.sent && isDate((p.it.node.config || {}).send_on));
      const todo = pr.filter((p) => !p.email && !p.sent).length;
      const row = (p) => {
        const st = stateOf(p); const x = STATS && STATS.get(p.it.node.id);
        return `<tr><td class="tx">${p.n}</td><td><div class="cp-tname"><b>${esc(p.email ? p.email.name : "Not written yet")}</b><span>${esc((p.email && p.email.subject) || "")}</span></div></td>
          <td>${esc(stepWhen(p.it.node) || "No date")}</td><td><span class="blk ${st[0]}">${st[1]}</span></td>
          <td>${x && x.sent ? x.sent : p.sent && p.count ? p.count : ""}</td><td>${x && x.sent ? pct(x.opened, x.sent) : ""}</td><td>${x && x.sent ? pct(x.clicked, x.sent) : ""}</td></tr>`;
      };
      $("cp-main").innerHTML = `${told()}
        <div class="figs">
          <div class="fig lin static"><span>Emails sent</span><b>${sent} of ${pr.length}</b><small>${next ? "Next: " + esc(stepWhen(next.it.node)) : sent === pr.length && pr.length ? "All sent" : "Nothing scheduled"}</small></div>
          <div class="fig lin static"><span>Opened</span><b>${STATS ? (s ? pct(o, s) : "No sends yet") : "Reading…"}</b><small>Across the emails sent</small></div>
          <div class="fig lin static"><span>Clicked</span><b>${STATS ? (s ? pct(c, s) : "No sends yet") : "Reading…"}</b><small>Across the emails sent</small></div>
          <div class="fig ${todo ? "dark" : "lin"} static"><span>${todo ? "Needs attention" : "In it now"}</span><b>${todo ? todo : LIVE}</b><small>${todo ? `${plural(todo, "email is", "emails are")} not written yet` : plural(LIVE, "person", "people")}</small></div>
        </div>
        <div class="section"><div class="strip"><span class="strip-t">Email by email</span><a class="aside" style="color:#fff;text-underline-offset:3px" href="/admin/automations/audit?id=${encodeURIComponent(A.id)}">Full report</a></div>
          <div class="tablewrap"><table class="cp-tbl"><thead><tr><th>No.</th><th>Email</th><th>When</th><th>Status</th><th>People</th><th>Opened</th><th>Clicked</th></tr></thead><tbody>${pr.map(row).join("")}</tbody></table></div>
          <p class="cp-hint">Opened and clicked are as reported, each person once, and can include email security scanners. The full report tells them apart and shows who did what.</p>
        </div>`;
      if (!STATS) readStats().then((m) => { STATS = m; if (step === "insights") drawInsights(); });
    }

    // ---- Loading ---------------------------------------------------------------
    async function load() {
      const [auto, lib] = await Promise.all([supabase.from("automations").select("*").eq("id", ID).maybeSingle(), loadEmails(supabase, { light: true })]);
      if (DEV && !auto.data && params.has("demo")) demo();
      else {
        if (auto.error || !auto.data) { $("cp-state").textContent = "That campaign couldn't be found."; $("cp-state").classList.add("bad"); return false; }
        A = auto.data; EMAILS = lib.rows;
      }
      A.graph = A.graph && typeof A.graph === "object" ? A.graph : { nodes: [{ id: "trigger", type: "trigger", x: 360, y: 40, config: {} }], edges: [] };
      parse();
      STATS = null; WHO = { total: null, ok: null }; PLAN = null;
      if (!DEMO && A.status !== "draft") {
        SENT = new Map();
        const jobs = sends().map((it) => count("email_events", (x) => x.eq("automation_id", A.id).eq("node_id", it.node.id).eq("event", "sent")).then((c) => { if (c) SENT.set(it.node.id, c); }));
        jobs.push(count("email_events", (x) => x.eq("automation_id", A.id).eq("event", "sent")).then((c) => { SENT_ALL = c || 0; }));
        jobs.push(count("automation_enrollments", (x) => x.eq("automation_id", A.id).in("status", ["active", "waiting"])).then((c) => { LIVE = c || 0; }));
        await Promise.all(jobs);
      }
      return true;
    }
    // An example campaign for a development copy, where a signed-out visitor
    // is handed nothing. Never runs on the live site; nothing is saved from it.
    function demo() {
      DEMO = true;
      const day = (n) => new Date(Date.now() + n * 864e5).toLocaleDateString("en-CA");
      const s = (id, on, tpl) => ({ id, type: "send_email", config: { body_mode: "template", template_id: tpl, send_on: on, send_at: "07:00", send_kind: "marketing" } });
      const live = params.get("demo") === "live";
      const nodes = [{ id: "trigger", type: "trigger" }, s("a", day(live ? -13 : 2), "e1"), s("b", day(live ? -6 : 9), "e2"), { id: "k", type: "if_else", config: { field: "has_tag", op: "is", values: ["Pack-Purchased"] } }, s("c", day(live ? 1 : 16), "e3"), s("d", day(live ? 8 : 23), "e4"), s("e", day(live ? 15 : 30), "")];
      const edges = [{ from: "trigger", to: "a", branch: "next" }, { from: "a", to: "b", branch: "next" }, { from: "b", to: "k", branch: "next" }, { from: "k", to: "c", branch: "no" }, { from: "c", to: "d", branch: "next" }, { from: "d", to: "e", branch: "next" }];
      A = { id: "demo", name: "The Winter Edit", status: live ? "active" : "draft", trigger_type: "manual", trigger_config: {}, updated_at: new Date().toISOString(),
        graph: { nodes, edges, meta: { kind: "marketing", campaign: true, area: "The Edit", to: { mode: "tags", tags: ["Network: TEG"] }, plan: { every: "week", start_on: day(live ? -13 : 2), start_at: "07:00" }, notes: { a: "Introduce the Winter Edit and what is in it.", b: "Three ways to use the templates this month." }, went_live_at: live ? new Date(Date.now() - 14 * 864e5).toISOString() : undefined } } };
      EMAILS = [1, 2, 3, 4].map((n) => ({ id: "e" + n, name: `The Winter Edit: email ${n}`, subject: "Example subject line", status: "active" }))
        .concat([{ id: "t1", name: "Launch announcement", is_template: true, area: "The Studio", status: "active" }, { id: "p1", name: "TMKE - Halloween Member Email", subject: "Something spooky has landed in your Studio", status: "active" }]);
      if (live) { SENT = new Map([["a", 112], ["b", 112]]); SENT_ALL = 224; LIVE = 111; }
    }

    // ---- Wiring ----------------------------------------------------------------
    const main = $("cp-main");
    document.getElementById("cp").addEventListener("click", async (e) => {
      const t = e.target instanceof HTMLElement ? e.target : null; if (!t || !A) return;
      const stepBtn = t.closest("[data-step]");
      // Leaving the plan saves it, so a note is never lost by moving on.
      if (stepBtn) { if (step === "plan" && PLAN && stepBtn.dataset.step !== "plan") { await planSave(stepBtn.dataset.step); } else go(stepBtn.dataset.step); return; }
      const act = t.closest("[data-do]");
      if (act) { doAct(act.dataset.do, act); return; }
      if (!main.contains(t)) return;
      // Plan
      if (t.dataset.untag) { PLAN.tags = PLAN.tags.filter((x) => x !== t.dataset.untag); drawPlan(); return; }
      if (t.id === "pl-save") { planSave(""); return; }
      if (t.id === "pl-next") { planSave("emails"); return; }
      // Emails
      const find = (id) => ITEMS.find((it) => it.node.id === id);
      const create = t.closest("[data-create]"); if (create) { openCreate(find(create.dataset.create)); return; }
      const keep = t.closest("[data-keep]"); if (keep) { const em = emailOf(find(keep.dataset.keep).node); if (em) openKeep(em); return; }
      const test = t.closest("[data-test]");
      if (test) {
        const em = emailOf(find(test.dataset.test).node); const msg = $("em-msg");
        if (DEMO || !WORKER) { msg.textContent = "A test can't be sent from this copy."; return; }
        msg.classList.remove("bad"); msg.textContent = "Sending you a test.";
        try { const me = await sendTest(em.id); msg.textContent = `Test sent to ${me}.`; } catch (err) { msg.classList.add("bad"); msg.textContent = "Couldn't send the test: " + ((err && err.message) || err); }
        return;
      }
      // Schedule
      if (t.closest("[data-change]")) { editing = t.closest("[data-change]").dataset.change; drawSchedule(); return; }
      if (t.closest("[data-cancel]")) { editing = null; drawSchedule(); return; }
      if (t.closest("[data-addcheck]")) { editing = "+check"; drawSchedule(); return; }
      try {
        if (t.closest("[data-savewhen]")) {
          const it = find(t.closest("[data-savewhen]").dataset.savewhen); const on = $("sc-on").value, at = $("sc-at").value;
          if (!isDate(on) || !isTime(at)) { toast("Set both the date and the time."); return; }
          if (new Date(`${on}T${at}`) <= new Date()) { toast("That time has already passed. Pick a later one."); return; }
          it.node.config = { ...(it.node.config || {}), send_on: on, send_at: at };
          if (meta().plan) meta().plan.every = "custom";
          editing = null; await save(true); draw(); toast("Date changed."); return;
        }
        if (t.closest("[data-savecheck]")) {
          const it = find(t.closest("[data-savecheck]").dataset.savecheck); const tag = $("sc-tag").value;
          if (!tag) { toast("Choose a tag."); return; }
          it.node.config = { field: "has_tag", op: "is", values: [tag] }; it.leaves = "yes";
          editing = null; rebuild(); parse(); await save(false); draw(); return;
        }
        if (t.closest("[data-dropcheck]")) {
          const id = t.closest("[data-dropcheck]").dataset.dropcheck; ITEMS = ITEMS.filter((it) => it.node.id !== id);
          editing = null; rebuild(); parse(); await save(false); draw(); return;
        }
        if (t.closest("[data-newcheck]")) {
          const before = $("sc-before").value, tag = $("sc-tag").value;
          if (!before || !tag) { toast("Choose the email and the tag."); return; }
          const at = ITEMS.findIndex((it) => it.node.id === before);
          ITEMS.splice(at, 0, { kind: "check", leaves: "yes", node: { id: newId(), type: "if_else", config: { field: "has_tag", op: "is", values: [tag] } } });
          editing = null; rebuild(); parse(); await save(false); draw(); return;
        }
      } catch (err) { toast("Couldn't save: " + ((err && err.message) || err)); return; }
      if (t.id === "sc-go") { approve(t); return; }
      if (t.id === "sc-tests") {
        const msg = $("sc-msg"); const written = progress().filter((p) => p.email && !p.sent);
        if (DEMO || !WORKER) { msg.textContent = "Tests can't be sent from this copy."; return; }
        if (!written.length) { msg.textContent = "There are no written emails to send yet."; return; }
        t.disabled = true;
        try { let me = ""; for (const p of written) { msg.textContent = `Sending email ${p.n} to you.`; me = await sendTest(p.email.id); } msg.textContent = `${plural(written.length, "test", "tests")} sent to ${me}.`; }
        catch (err) { msg.textContent = "Couldn't send the tests: " + ((err && err.message) || err); }
        t.disabled = false;
      }
    });
    main.addEventListener("input", (e) => {
      const t = e.target; if (step !== "plan" || !PLAN) return;
      if (t instanceof HTMLTextAreaElement && t.dataset.note != null) { PLAN.notes[Number(t.dataset.note)] = t.value; return; }
      if (t instanceof HTMLInputElement && t.id === "pl-name") PLAN.name = t.value;
    });
    main.addEventListener("change", (e) => {
      const t = e.target; if (step !== "plan" || !PLAN) return;
      if (!(t instanceof HTMLInputElement || t instanceof HTMLSelectElement)) return;
      if (t.id === "pl-area") PLAN.area = t.value;
      else if (t.id === "pl-count") { PLAN.count = Math.min(20, Math.max(1, parseInt(t.value, 10) || 1)); drawPlan(); }
      else if (t.id === "pl-tag" && t.value) { PLAN.tags.push(t.value); drawPlan(); }
      else if (t.id === "pl-kind") { PLAN.kind = t.value; planWho(); }
      else if (t.id === "pl-on") { PLAN.start_on = t.value; drawPlan(); }
      else if (t.id === "pl-at") { PLAN.start_at = t.value; drawPlan(); }
      else if (t.id === "pl-every") { PLAN.every = t.value; drawPlan(); }
    });
    async function doAct(what, btn) {
      if (DEMO) { toast("This is the example copy: nothing is changed from here."); return; }
      try {
        if (what === "dupe") {
          const copy = JSON.parse(JSON.stringify(A.graph || {}));
          if (copy.meta) ["went_live_at", "paused_at", "archived_at", "reactivated_at"].forEach((k) => delete copy.meta[k]);
          const { data, error } = await supabase.from("automations").insert({ name: A.name + " (copy)", trigger_type: A.trigger_type, trigger_config: A.trigger_config, graph: copy, status: "draft" }).select("id").single();
          if (error) throw error;
          location.href = `/admin/email/campaign?id=${data.id}&step=plan`;
        } else if (what === "pause" || what === "end") {
          const label = what === "pause" ? "pause it" : "end it for good";
          if (btn.dataset.armed !== "1") { const old = btn.textContent; btn.dataset.armed = "1"; btn.textContent = `Press again to ${label}`; setTimeout(() => { if (btn.isConnected) { btn.dataset.armed = ""; btn.textContent = old; } }, 5000); return; }
          btn.disabled = true;
          const d = await workerPost("/automations/set-status", { automation_id: A.id, status: what === "pause" ? "paused" : "archived" });
          toast(what === "pause" ? "Paused. Nothing sends until it is reactivated." : `Ended.${d.taken_out ? ` ${plural(d.taken_out, "person was", "people were")} taken out.` : ""}`);
          await load(); draw();
        }
      } catch (err) { toast("Couldn't do that: " + ((err && err.message) || err)); }
    }

    (async () => {
      if (!DEV) { const s = await requireAdmin(); if (!s) return; }
      try { TAGS = withPackTags(await loadPackTagGroup(supabase)); } catch (_) { TAGS = withPackTags(null); }
      if (!(await load())) return;
      document.title = `${A.name || "Campaign"} — TMKE admin`;
      if (!step) step = A.status === "draft" ? (sends().length ? "emails" : "plan") : "insights";
      $("cp-state").hidden = true; $("cp-shell").hidden = false;
      draw();
    })();
  </script>
</AdminShell>
