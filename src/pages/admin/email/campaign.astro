      };
      $("cp-main").innerHTML = `${told()}
        <div class="section"><div class="strip"><span class="strip-t">A space for each email in your plan</span></div>
          ${pr.length ? `<div class="cp-cards">${pr.map(card).join("")}</div>` : `<div class="empty">There are no emails in the plan yet. Go back to Plan and say how many.</div>`}
        </div>
        <div class="cp-foot split"><button type="button" class="mbtn" data-step="plan">Back to the plan</button><button type="button" class="mbtn primary" data-step="schedule">Next: check the schedule</button></div>
        <p class="cp-msg" id="em-msg" role="status"></p>`;
    }
    const sendName = (it) => `${A.name}: email ${sends().indexOf(it) + 1}`;
    async function assign(it, emailId) {
      const c = (it.node.config = it.node.config || {});
      c.body_mode = "template"; c.template_id = emailId;
      if (!c.send_kind) c.send_kind = kind() === "marketing" ? "marketing" : "transactional";
      await save(false);
    }
    // The four ways to start an email (Danielle, 25 Nov): from scratch, from a
    // template, from a previous email, or a duplicate of one already made here.
    // Each of the last three is a copy, so the original stays as it is.
    function openCreate(it) {
      const n = sends().indexOf(it) + 1;
      const mine = sends().filter((x) => x !== it && emailOf(x.node)).map((x) => ({ e: emailOf(x.node), label: `Email ${sends().indexOf(x) + 1}` }));
      const used = new Set(sends().map((x) => x.node.config && x.node.config.template_id).filter(Boolean));
      const templates = EMAILS.filter((t) => t.is_template && t.status !== "archived");
      const previous = EMAILS.filter((t) => !t.is_template && t.status !== "archived" && !used.has(t.id));
      const pick = (rows, what) => rows.length
        ? rows.map((r) => `<button type="button" data-copy="${esc(r.e.id)}">${esc(r.e.name)}<span>${esc(r.label || "")} ${what}</span></button>`).join("")
        : `<p>Nothing to choose from yet.</p>`;
      $("cp-pop").innerHTML = `<div class="scrim" id="cp-scrim"><div class="pop tall" role="dialog" aria-modal="true" aria-labelledby="cp-c-t">
        <div class="pop-h"><div><p class="mo-eye">${esc(A.name)} · Email ${n}${stepWhen(it.node) ? " · " + esc(stepWhen(it.node)) : ""}</p><div class="pop-title" id="cp-c-t">Create this email</div></div><button type="button" class="x" data-close aria-label="Close">×</button></div>
        <div class="pop-b">
          <p>How do you want to start?</p>
          <button type="button" class="cp-opt" data-new="1"><b>Start from scratch</b><span>A blank email in the editor.</span></button>
          <button type="button" class="cp-opt" data-open="tpl" aria-expanded="false"><b>Start from a template</b><span>Pick one of your saved templates. You work on a copy, so the template stays as it is.</span></button>
          <div class="cp-pick" data-list="tpl" hidden>${pick(templates.map((e) => ({ e, label: e.area || "" })), "Use")}</div>
          <button type="button" class="cp-opt" data-open="prev" aria-expanded="false"><b>Copy a previous email</b><span>Any email from another campaign or a one-off send. You work on a copy.</span></button>
          <div class="cp-pick" data-list="prev" hidden>${pick(previous.map((e) => ({ e, label: "" })), "Copy")}</div>
          <button type="button" class="cp-opt" data-open="mine" aria-expanded="${mine.length ? "true" : "false"}"><b>Duplicate one from this campaign</b><span>Keeps the layout of an email you have already made for ${esc(A.name)}.</span></button>
          <div class="cp-pick" data-list="mine" ${mine.length ? "" : "hidden"}>${pick(mine, "Duplicate")}</div>
          <p class="err" id="cp-c-err" hidden></p>
        </div>
      </div></div>`;
      const scrim = $("cp-scrim"); const close = () => { $("cp-pop").innerHTML = ""; };
      const fail = (t) => { const e = $("cp-c-err"); e.textContent = t; e.hidden = false; };
      const done = async (row) => { await assign(it, row.id); location.href = `/admin/email/editor?id=${encodeURIComponent(row.id)}&back=${encodeURIComponent(`/admin/email/campaign?id=${A.id}&step=emails`)}`; };
      scrim.addEventListener("keydown", (e) => { if (e.key === "Escape") close(); });
      scrim.addEventListener("click", async (e) => {
        const t = e.target instanceof HTMLElement ? e.target : null; if (!t) return;
        if (t === scrim || t.closest("[data-close]")) { close(); return; }
        const open = t.closest("[data-open]");
        if (open) { const l = scrim.querySelector(`[data-list="${open.dataset.open}"]`); l.hidden = !l.hidden; open.setAttribute("aria-expanded", String(!l.hidden)); return; }
