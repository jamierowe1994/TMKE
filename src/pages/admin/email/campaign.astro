      $("cp-main").innerHTML = `${told()}
        <div class="section"><div class="strip"><span class="strip-t">The plan</span></div>
          ${can ? "" : `<p class="cp-hint">${draft() ? "Who it goes to and when are set in the step builder for this campaign." : "This campaign has started, so who it goes to is fixed. Change a date under Schedule. The name, area and notes can still be changed here."}</p>`}
          <div class="cp-form">
            <label><span class="cp-lab">Campaign name</span><input type="text" id="pl-name" maxlength="120" value="${esc(PLAN.name)}" /></label>
            <label><span class="cp-lab">What area of the business is it about?</span><select id="pl-area"><option value="">Choose an area</option>${AREAS.map((x) => `<option${x === PLAN.area ? " selected" : ""}>${esc(x)}</option>`).join("")}</select></label>
            <label><span class="cp-lab">How many emails?</span><input type="number" id="pl-count" min="1" max="20" value="${PLAN.count}" ${dis} /></label>
            <div class="wide"><span class="cp-lab">Who is it going to?</span>
              <div class="cp-box">${PLAN.tags.map((t) => `<span class="cp-chip">${esc(tagText(t))}${can ? `<button type="button" data-untag="${esc(t)}" aria-label="Remove ${esc(t)}">×</button>` : ""}</span>`).join("")}
                ${can ? `<select id="pl-tag" aria-label="Add a tag"><option value="">Add a tag</option>${TAGS.map(([g, list]) => `<optgroup label="${esc(g)}">${list.filter((t) => !PLAN.tags.includes(t)).map((t) => `<option value="${esc(t)}">${esc(tagText(t))}</option>`).join("")}</optgroup>`).join("")}</select>` : (PLAN.tags.length ? "" : `<span class="cp-hint" style="margin:0">Set in the step builder</span>`)}
              </div>
              <p class="cp-hint" id="pl-who">${PLAN.tags.length > 1 ? "Anyone with any one of these tags. " : ""}</p>
            </div>
            <label><span class="cp-lab">Marketing or service message?</span><select id="pl-kind" ${dis}><option value="marketing"${PLAN.kind === "marketing" ? " selected" : ""}>Marketing (opted-in people only)</option><option value="service"${PLAN.kind === "service" ? " selected" : ""}>Service message (everyone)</option></select></label>
            <label><span class="cp-lab">First email goes on</span><input type="date" id="pl-on" value="${esc(PLAN.start_on)}" min="${todayLondon()}" ${dis} /></label>
            <label><span class="cp-lab">At</span><input type="time" id="pl-at" value="${esc(PLAN.start_at)}" ${dis} /></label>
            <label><span class="cp-lab">Then one</span><select id="pl-every" ${dis}>${EVERY.map(([k, l]) => `<option value="${k}"${k === PLAN.every ? " selected" : ""}>${l}</option>`).join("")}</select></label>
          </div>
        </div>
        <div class="section"><div class="strip"><span class="strip-t">Notes and copy ideas, email by email</span></div>
          ${Array.from({ length: PLAN.count }, (_, i) => `<div class="cp-note"><div><b>Email ${i + 1}</b><span>${dates[i] ? esc(stepWhen({ config: { send_on: dates[i].on, send_at: dates[i].at } })) : "No date yet"}</span></div>
            <textarea data-note="${i}" aria-label="Notes for email ${i + 1}" placeholder="What is this email about? Copy ideas, links, anything to remember.">${esc(PLAN.notes[i] || "")}</textarea></div>`).join("")}
        </div>
        <div class="cp-foot"><button type="button" class="mbtn" id="pl-save">Save plan</button><button type="button" class="mbtn primary" id="pl-next">Next: write the emails</button></div>
        <p class="cp-msg" id="pl-msg" role="status"></p>`;
      planWho();
    }
    const okFor = (x, k) => { let y = x.eq("dnd", false).eq("dnd_email", false).not("tags", "cs", "{Unsubscribed}"); if (k === "marketing") y = y.eq("marketing_opt_in", true); return y; };
    let whoRun = 0;
    async function whoCount(list, k) {
      if (!list.length) return { total: 0, ok: 0 };
      if (DEMO) return { total: 126, ok: k === "marketing" ? 112 : 124 };
      const [total, ok] = await Promise.all([count("contacts", (x) => x.overlaps("tags", list)), count("contacts", (x) => okFor(x.overlaps("tags", list), k))]);
      return { total: total || 0, ok: ok || 0 };
    }
    async function planWho() {
