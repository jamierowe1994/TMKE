      if (PLAN.area) m.area = PLAN.area; else delete m.area;
      if (planned()) {
        const list = sends(); const pr = progress();
        // More emails: new steps on the end. Fewer: the last ones go, never one that has been sent.
        if (PLAN.count > list.length) for (let i = list.length; i < PLAN.count; i++) ITEMS.push({ kind: "send", node: { id: newId(), type: "send_email", config: { body_mode: "template", template_id: "" } } });
        else if (PLAN.count < list.length) {
          const drop = new Set(list.slice(PLAN.count).filter((it) => !(pr.find((p) => p.it === it) || {}).sent).map((it) => it.node.id));
          ITEMS = ITEMS.filter((it) => !drop.has(it.node.id));
          while (ITEMS.length && ITEMS[ITEMS.length - 1].kind !== "send") ITEMS.pop();
        }
        const dates = planDates();
        sends().forEach((it, i) => {
          const c = (it.node.config = it.node.config || {});
          c.send_kind = PLAN.kind === "marketing" ? "marketing" : "transactional";
          if (PLAN.every !== "custom" && dates[i]) { c.send_on = dates[i].on; c.send_at = dates[i].at; }
        });
        m.kind = PLAN.kind; m.campaign = true;
        m.to = { mode: "tags", tags: [...PLAN.tags] };
        m.plan = { every: PLAN.every, start_on: PLAN.start_on, start_at: PLAN.start_at };
        A.trigger_type = "manual"; A.trigger_config = {};
        rebuild(); parse();
      }
      m.notes = {}; sends().forEach((it, i) => { const t = (PLAN.notes[i] || "").trim(); if (t) m.notes[it.node.id] = t; });
      say("Saving.");
      try { await save(true); PLAN = null; if (then) go(then); else { draw(); toast("Plan saved."); } }
      catch (e) { say("Couldn't save: " + ((e && e.message) || e), true); }
    }

    // ---- 2 Emails --------------------------------------------------------------
    function drawEmails() {
      const pr = progress(); const m = meta();
      const editor = (id) => `/admin/email/editor?id=${encodeURIComponent(id)}&back=${encodeURIComponent(`/admin/email/campaign?id=${A.id}&step=emails`)}`;
      const card = (p) => {
        const c = p.it.node.config || {}; const st = stateOf(p); const id = esc(p.it.node.id);
        const note = (m.notes && m.notes[p.it.node.id]) || "";
        const acts = p.email
          ? `<a class="mbtn" href="${editor(p.email.id)}">${p.sent ? "View email" : "Edit email"}</a>${p.sent ? "" : `<button type="button" class="mbtn" data-test="${id}">Send me a test</button>`}<button type="button" class="mbtn" data-keep="${id}">Save as a template</button>${p.sent ? "" : `<button type="button" class="mbtn" data-create="${id}">Swap the email</button>`}`
          : `<button type="button" class="mbtn primary" data-create="${id}">Create email</button>`;
        return `<article class="cp-card">
          <div class="cp-thumb${p.email ? "" : " todo"}" aria-hidden="true"><i></i><i></i><i></i><i></i></div>
          <div class="cp-card-top"><span class="cp-lab" style="margin:0">Email ${p.n}</span><span class="blk ${st[0]}">${st[1]}</span></div>
          <div class="cp-card-id"><b>${esc(p.email ? p.email.name : "Not written yet")}</b><span>${esc(stepWhen(p.it.node) || "No date yet")}</span><span>${esc(note ? "Plan: " + note : "No notes in the plan.")}</span></div>
          <div class="cp-card-acts">${acts}</div>
