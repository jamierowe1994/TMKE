---
import AdminShell from "../../../components/admin/AdminShell.astro";
import "../../../styles/admin.css";
import { EMAIL_CATALOG, EMAIL_GROUPS } from "../../../lib/email-catalog.js";

const clientCount = EMAIL_CATALOG.filter((e) => e.audience === "client").length;
const internalCount = EMAIL_CATALOG.filter((e) => e.audience === "internal").length;
const searchText = (e) => [e.name, e.subject, e.trigger, e.summary, e.group, e.fires, e.to].filter(Boolean).join(" ").toLowerCase();
const AUD_LABEL = { client: "To client", internal: "Internal" };
// Emails the Worker can render a live preview for (its real builder + sample data).
// More are being added; the rest just show their catalogue details for now.
const PREVIEWABLE = new Set(["post_reminder", "setup_reminder", "waitlist_register", "vid_booking_client", "vid_booking_team", "invoice_sent", "invoice_dd_reminder"]);
---

<AdminShell active="email" title="Automated emails">
  <div class="ash-panel ash-page">
  <section class="admin-bar">
    <div class="admin-bar-actions">
      <div class="enquiry-chips" role="tablist">
        <button type="button" class="enquiry-chip is-active" data-filter="all">All</button>
        <button type="button" class="enquiry-chip" data-filter="client">To clients</button>
        <button type="button" class="enquiry-chip" data-filter="internal">Internal alerts</button>
      </div>
      <input type="search" id="ae-search" class="admin-search" placeholder="Search name, subject, trigger…" />
      <span class="admin-bar-count" id="ae-count">{EMAIL_CATALOG.length} emails</span>
      <a href="/admin/email" class="admin-btn admin-btn-ghost">Email studio →</a>
    </div>
  </section>

  <section class="ae-wrap">
    <p class="ae-note">
      Every automated email the platform sends — what fires it, who it goes to, and what it contains. These are hard-coded in the delivery Worker today;
      <strong>editing them in here is Phase 2.</strong>
    </p>
    <p class="ae-empty" id="ae-empty" hidden>No emails match that search.</p>

    {EMAIL_GROUPS.map((group) => {
      const items = EMAIL_CATALOG.filter((e) => e.group === group);
      if (!items.length) return null;
      return (
        <div class="ae-group" data-group={group}>
          <h2 class="ae-group-h">{group}</h2>
          {items.map((e) => (
            <div class="ae-item" data-audience={e.audience} data-text={searchText(e)}>
              <button type="button" class="ae-head" aria-expanded="false">
                <span class="ae-head-main">
                  <span class="ae-name">{e.name}</span>
                  <span class="ae-subject">{e.subject}</span>
                </span>
                <span class:list={["ae-badge", `is-${e.audience}`]}>{AUD_LABEL[e.audience] || e.audience}</span>
                <svg class="ae-chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><polyline points="6 9 12 15 18 9"></polyline></svg>
              </button>
              <div class="ae-body" hidden>
                <div class="ae-grid">
                  <div class="ae-field"><span class="ae-k">Triggered by</span><span class="ae-v">{e.trigger}</span></div>
                  <div class="ae-field"><span class="ae-k">Fires on</span><code class="ae-code">{e.fires}</code></div>
                  <div class="ae-field"><span class="ae-k">Sent to</span><span class="ae-v">{e.to}</span></div>
                  <div class="ae-field"><span class="ae-k">From</span><span class="ae-v">{e.sender}</span></div>
                  <div class="ae-field"><span class="ae-k">Subject</span><span class="ae-v">{e.subject}</span></div>
                  {e.attachments && <div class="ae-field"><span class="ae-k">Attaches</span><span class="ae-v">{e.attachments}</span></div>}
                </div>
                <p class="ae-summary">{e.summary}</p>
                {e.fields && e.fields.length && (
                  <div class="ae-fields"><span class="ae-k">Merge fields</span>{e.fields.map((f) => <code class="ae-tag">{"{{" + f + "}}"}</code>)}</div>
                )}
                {e.editableToday && <p class="ae-flag is-good">✓ Already editable today — this one is an Email Studio template.</p>}
                {e.external && <p class="ae-flag">↗ Managed outside the Worker (Supabase dashboard).</p>}
                {PREVIEWABLE.has(e.id)
                  ? <button type="button" class="ae-preview-btn" data-preview={e.id} data-name={e.name}>Preview email →</button>
                  : (!e.editableToday && !e.external && <p class="ae-flag">👁 Live preview being added for this one.</p>)}
              </div>
            </div>
          ))}
        </div>
      );
    })}
  </section>
  </div>

  <div class="ae-modal" id="ae-modal" hidden>
    <div class="ae-modal-scrim" id="ae-modal-scrim"></div>
    <div class="ae-modal-card">
      <div class="ae-modal-head">
        <div class="ae-modal-hed"><div class="ae-modal-title" id="ae-modal-title">Preview</div><div class="ae-modal-subj" id="ae-modal-subj"></div></div>
        <div class="ae-modal-toggle" role="group" aria-label="Preview style">
          <button type="button" class="ae-tog is-active" id="ae-tog-current" data-branded="0">Current</button>
          <button type="button" class="ae-tog" id="ae-tog-branded" data-branded="1">Branded base</button>
        </div>
        <button type="button" class="ae-modal-x" id="ae-modal-x" aria-label="Close">&times;</button>
      </div>
      <div class="ae-modal-body"><p class="ae-modal-loading" id="ae-modal-loading">Rendering…</p><iframe id="ae-modal-frame" title="Email preview" hidden></iframe></div>
      <div class="ae-modal-foot">
        <span>Rendered with sample data — this is exactly what the system builds and sends.</span>
        <!-- Send this exact render to yourself, so what you check is what goes out. -->
        <form class="ae-test" id="ae-test-form">
          <input type="email" id="ae-test-to" placeholder="you@tmke.co.uk" autocomplete="email" required />
          <button type="submit" class="ae-test-btn" id="ae-test-btn">Send test</button>
          <span class="ae-test-msg" id="ae-test-msg" hidden></span>
        </form>
      </div>
    </div>
  </div>

  <style is:global>
    .admin-bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; max-width: 1100px; margin: 0 auto; padding: 30px 36px 12px; flex-wrap: wrap; }
    .admin-bar-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
    .admin-search { padding: 8px 12px; border: 1px solid rgba(55, 30, 40, 0.3); border-radius: 2px; font-family: var(--sans); font-size: 13px; color: var(--ink); background: var(--paper); min-width: 240px; }
    .admin-search:focus { outline: none; border-color: var(--english-violet); }
    .admin-bar-count { font-family: var(--sans); font-size: 11px; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.5); white-space: nowrap; }
    .enquiry-chips { display: inline-flex; gap: 4px; align-items: center; }
    .enquiry-chip { background: transparent; border: 1px solid rgba(28,29,34,0.18); padding: 7px 13px; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.65); cursor: pointer; border-radius: 999px; transition: background .25s, color .25s, border-color .25s; }
    .enquiry-chip:hover { color: var(--ink); }
    .enquiry-chip.is-active { background: var(--ink); color: var(--paper); border-color: var(--ink); }
    .admin-btn { padding: 9px 16px; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; border: 1px solid transparent; border-radius: 2px; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 6px; }
    .admin-btn-ghost { background: transparent; border-color: rgba(28,29,34,0.2); color: rgba(28,29,34,0.7); }
    .admin-btn-ghost:hover { border-color: var(--english-violet); color: var(--english-violet); }

    .ae-wrap { max-width: 1100px; margin: 24px auto 200px; padding: 0 36px; }
    .ae-note { font-family: var(--sans); font-size: 13px; line-height: 1.6; color: rgba(28,29,34,0.6); background: rgba(55,30,40,0.05); border: 1px solid rgba(55,30,40,0.1); border-radius: 8px; padding: 12px 16px; margin: 0 0 28px; }
    .ae-empty { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.55); padding: 24px 0; }
    .ae-group { margin-bottom: 34px; }
    .ae-group[hidden] { display: none; }
    .ae-group-h { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--english-violet); margin: 0 0 12px; }
    .ae-item { border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; margin-bottom: 8px; background: #fff; overflow: hidden; }
    .ae-item[hidden] { display: none; }
    .ae-head { width: 100%; display: flex; align-items: center; gap: 14px; padding: 15px 18px; background: none; border: 0; cursor: pointer; text-align: left; }
    .ae-head:hover { background: rgba(55,30,40,0.03); }
    .ae-head-main { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 3px; }
    .ae-name { font-family: var(--sans); font-size: 15px; font-weight: 600; color: var(--ink); }
    .ae-subject { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ae-badge { flex: none; font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 9px; border-radius: 999px; }
    .ae-badge.is-client { background: rgba(47,158,94,0.13); color: #2c7a4b; }
    .ae-badge.is-internal { background: rgba(28,29,34,0.08); color: rgba(28,29,34,0.6); }
    .ae-chev { width: 17px; height: 17px; flex: none; color: rgba(28,29,34,0.4); transition: transform .2s; }
    .ae-head[aria-expanded="true"] .ae-chev { transform: rotate(180deg); }
    .ae-body { padding: 4px 18px 20px; border-top: 1px solid rgba(28,29,34,0.07); }
    .ae-body[hidden] { display: none; }
    .ae-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 24px; margin: 16px 0 4px; }
    @media (max-width: 640px) { .ae-grid { grid-template-columns: 1fr; } }
    .ae-field { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .ae-k { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.42); }
    .ae-v { font-family: var(--sans); font-size: 13.5px; color: var(--ink); line-height: 1.4; }
    .ae-code { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 12px; color: var(--english-violet); background: rgba(55,30,40,0.07); padding: 2px 7px; border-radius: 5px; align-self: flex-start; }
    .ae-summary { font-family: var(--sans); font-size: 13.5px; line-height: 1.6; color: rgba(28,29,34,0.75); margin: 14px 0 0; }
    .ae-fields { display: flex; flex-wrap: wrap; align-items: center; gap: 7px; margin-top: 14px; }
    .ae-tag { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 11.5px; color: rgba(28,29,34,0.6); background: rgba(28,29,34,0.05); padding: 2px 8px; border-radius: 5px; }
    .ae-flag { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); margin: 14px 0 0; }
    .ae-flag.is-good { color: #2c7a4b; }
    .ae-preview-btn { margin-top: 16px; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; border: 1px solid var(--english-violet); background: transparent; color: var(--english-violet); border-radius: 6px; padding: 9px 15px; cursor: pointer; }
    .ae-preview-btn:hover { background: var(--english-violet); color: #fff; }

    .ae-modal { position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center; padding: 24px; }
    .ae-modal[hidden] { display: none; }
    .ae-modal-scrim { position: absolute; inset: 0; background: rgba(20,18,26,0.45); }
    .ae-modal-card { position: relative; width: 680px; max-width: 96vw; max-height: 90vh; background: #fff; border-radius: 14px; box-shadow: 0 30px 80px -30px rgba(20,18,26,0.6); display: flex; flex-direction: column; overflow: hidden; }
    .ae-modal-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; padding: 16px 20px; border-bottom: 1px solid rgba(28,29,34,0.08); }
    .ae-modal-title { font-family: var(--sans); font-size: 15px; font-weight: 700; color: var(--ink); }
    .ae-modal-subj { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); margin-top: 3px; }
    .ae-modal-toggle { display: inline-flex; background: rgba(28,29,34,0.06); border-radius: 8px; padding: 3px; flex: none; }
    .ae-tog { border: 0; background: none; border-radius: 6px; padding: 6px 12px; font-family: var(--sans); font-size: 11.5px; font-weight: 700; color: rgba(28,29,34,0.55); cursor: pointer; }
    .ae-tog.is-active { background: #fff; color: var(--english-violet); box-shadow: 0 1px 3px rgba(28,29,34,0.14); }
    .ae-modal-x { border: 0; background: none; font-size: 24px; line-height: 1; color: rgba(28,29,34,0.4); cursor: pointer; }
    .ae-modal-body { flex: 1; min-height: 0; overflow: auto; background: #f4f2f1; padding: 18px; }
    .ae-modal-loading { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.55); text-align: center; padding: 40px 0; }
    #ae-modal-frame { width: 100%; height: 60vh; border: 0; background: #fff; border-radius: 8px; box-shadow: 0 1px 6px rgba(20,18,26,0.12); }
    .ae-modal-foot { padding: 11px 20px; border-top: 1px solid rgba(28,29,34,0.08); font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.5); display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    /* Send this exact preview to yourself as a test. */
    .ae-test { display: flex; align-items: center; gap: 7px; }
    .ae-test input { font-family: var(--sans); font-size: 12px; padding: 6px 9px; border: 1px solid rgba(28,29,34,0.18); border-radius: 6px; background: #fff; color: var(--ink); min-width: 180px; }
    .ae-test-btn { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; border: 0; background: var(--english-violet); color: var(--paper); border-radius: 6px; padding: 7px 12px; cursor: pointer; }
    .ae-test-btn:disabled { opacity: 0.55; cursor: default; }
    .ae-test-msg { font-size: 11px; }
    .ae-test-msg.ok { color: #2f7a3f; }
    .ae-test-msg.err { color: #b3261e; }
  </style>

  <script>
    import { requireAdmin } from "../../../lib/admin-gate.js";
    if (!import.meta.env.DEV) { requireAdmin("/admin/login"); }

    const items = [...document.querySelectorAll(".ae-item")];
    const groups = [...document.querySelectorAll(".ae-group")];
    const count = document.getElementById("ae-count");
    const empty = document.getElementById("ae-empty");
    const search = document.getElementById("ae-search");
    const chips = [...document.querySelectorAll(".enquiry-chip")];
    let filter = "all", q = "";

    // Expand / collapse
    items.forEach((it) => {
      const head = it.querySelector(".ae-head"), body = it.querySelector(".ae-body");
      head.addEventListener("click", () => {
        const open = head.getAttribute("aria-expanded") === "true";
        head.setAttribute("aria-expanded", open ? "false" : "true");
        body.hidden = open;
      });
    });

    function apply() {
      let shown = 0;
      items.forEach((it) => {
        const okAud = filter === "all" || it.getAttribute("data-audience") === filter;
        const okQ = !q || (it.getAttribute("data-text") || "").includes(q);
        const vis = okAud && okQ;
        it.hidden = !vis;
        if (vis) shown++;
      });
      groups.forEach((g) => { g.hidden = ![...g.querySelectorAll(".ae-item")].some((i) => !i.hidden); });
      empty.hidden = shown > 0;
      count.textContent = shown === items.length ? `${items.length} emails` : `${shown} of ${items.length}`;
    }
    chips.forEach((c) => c.addEventListener("click", () => {
      chips.forEach((b) => b.classList.remove("is-active"));
      c.classList.add("is-active");
      filter = c.getAttribute("data-filter"); apply();
    }));
    search.addEventListener("input", () => { q = (search.value || "").trim().toLowerCase(); apply(); });

    // ---- Live preview (renders the real email via the Worker, sample data) ----
    import { supabase } from "../../../lib/supabase.js";
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const modal = document.getElementById("ae-modal");
    const frame = document.getElementById("ae-modal-frame");
    const mLoading = document.getElementById("ae-modal-loading");
    const mTitle = document.getElementById("ae-modal-title");
    const mSubj = document.getElementById("ae-modal-subj");
    const togCurrent = document.getElementById("ae-tog-current");
    const togBranded = document.getElementById("ae-tog-branded");
    let curId = null, curName = "", branded = false;
    function closeModal() { modal.hidden = true; frame.hidden = true; frame.srcdoc = ""; }
    document.getElementById("ae-modal-x").addEventListener("click", closeModal);
    document.getElementById("ae-modal-scrim").addEventListener("click", closeModal);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !modal.hidden) closeModal(); });

    async function loadPreview() {
      togCurrent.classList.toggle("is-active", !branded);
      togBranded.classList.toggle("is-active", branded);
      frame.hidden = true; mLoading.hidden = false; mLoading.textContent = branded ? "Wrapping in your branded base…" : "Rendering…";
      try {
        const { data } = await supabase.auth.getSession();
        const token = data && data.session && data.session.access_token;
        if (!WORKER || !token) { mLoading.textContent = "Please sign in (or set the Worker URL)."; return; }
        const res = await fetch(`${WORKER}/email/preview?id=${encodeURIComponent(curId)}${branded ? "&branded=1" : ""}`, { headers: { Authorization: "Bearer " + token } });
        const j = await res.json().catch(() => ({}));
        if (!j.ok || !j.supported) { mLoading.textContent = j.error || "No live preview for this one yet."; return; }
        mSubj.textContent = "Subject: " + (j.subject || "");
        frame.srcdoc = j.html || "";
        mLoading.hidden = true; frame.hidden = false;
      } catch (_) { mLoading.textContent = "Couldn't load the preview."; }
    }
    togCurrent.addEventListener("click", () => { if (branded) { branded = false; loadPreview(); } });
    togBranded.addEventListener("click", () => { if (!branded) { branded = true; loadPreview(); } });

    // Send the preview you're looking at (same id + Current/Branded state) to
    // yourself — the worker re-renders from the same sample builder, so the test
    // can't drift from the preview.
    const testForm = document.getElementById("ae-test-form");
    const testTo = document.getElementById("ae-test-to");
    const testBtn = document.getElementById("ae-test-btn");
    const testMsg = document.getElementById("ae-test-msg");
    function setTestMsg(text, kind) {
      testMsg.hidden = !text; testMsg.textContent = text || "";
      testMsg.className = "ae-test-msg" + (kind ? " " + kind : "");
    }
    testForm?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const to = (testTo.value || "").trim();
      if (!to || !curId) return;
      testBtn.disabled = true; setTestMsg("Sending…", "");
      try {
        const { data } = await supabase.auth.getSession();
        const token = data?.session?.access_token;
        const res = await fetch(`${WORKER}/email/preview/send`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify({ id: curId, branded, to }),
        });
        const j = await res.json().catch(() => ({}));
        setTestMsg(j.ok ? `Sent to ${j.to}` : (j.error || "Couldn't send it."), j.ok ? "ok" : "err");
        if (j.ok) try { localStorage.setItem("tmke.testEmail", to); } catch (_) {}
      } catch (_) { setTestMsg("Couldn't send it.", "err"); }
      testBtn.disabled = false;
    });

    document.querySelectorAll("[data-preview]").forEach((btn) => btn.addEventListener("click", () => {
      curId = btn.getAttribute("data-preview"); curName = btn.getAttribute("data-name") || "Preview"; branded = false;
      // Fresh test row per open: clear the last result, keep the address.
      setTestMsg("", "");
      try { if (!testTo.value) testTo.value = localStorage.getItem("tmke.testEmail") || ""; } catch (_) {}
      mTitle.textContent = curName; mSubj.textContent = "";
      modal.hidden = false;
      loadPreview();
    }));
  </script>
</AdminShell>
