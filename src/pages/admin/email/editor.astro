    const DEV = import.meta.env.DEV;
    const WORKER_URL = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const $ = (s) => document.querySelector(s);

    // Block icons (Lucide-style)
    const ICONS = {
