    #eb-pv-frame { width:100%; border:0; border-radius:8px; background:#fff; height:60vh; transition:max-width 0.2s; }
    #eb-pv-frame.is-desktop { max-width:100%; }
    #eb-pv-frame.is-mobile { max-width:380px; }

    .eb-toast { position:fixed; bottom:24px; left:50%; transform:translateX(-50%); background:var(--ink); color:#fff; padding:10px 18px; border-radius:8px; font-family:var(--sans); font-size:13px; z-index:100; box-shadow:0 10px 30px rgba(0,0,0,0.3); }
  </style>

  <script>
    import { supabase, isConfigured } from "../../../lib/supabase.js";
    import { requireAdmin } from "../../../lib/admin-gate.js";
    import {
      renderTemplate, renderBlock, mergeContextFor, defaultBrand,
