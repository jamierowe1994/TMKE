        default: return "";
      }
    }
    function setPath(o,p,v){ const ks=p.split("."); let c=o; for(let i=0;i<ks.length-1;i++){ if(typeof c[ks[i]]!=="object"||c[ks[i]]==null) c[ks[i]]={}; c=c[ks[i]]; } c[ks[ks.length-1]]=v; }
    // Shared "Visible on" control appended to EVERY block's inspector — sets
    // b.hide.{desktop,mobile}. Uses the Outlook-safe hide technique in the renderer.
    function visibilityControl(b){
      const hide = b.hide || {}; const onD = !hide.desktop, onM = !hide.mobile;
      const hint = (hide.desktop && hide.mobile) ? `<p class="eb-vis-hint is-warn">Hidden on all devices — this block won't appear in the email.</p>`
        : hide.desktop ? `<p class="eb-vis-hint">Shows on mobile devices only — correctly hidden in Outlook &amp; other desktop clients.</p>`
        : hide.mobile ? `<p class="eb-vis-hint">Shows on desktop only — hidden on phones.</p>`
        : `<p class="eb-vis-hint">Shown on every device.</p>`;
      return `<div class="eb-vis-sec"><span class="eb-vis-label">Visible on</span>
        <div class="eb-vis-toggles">
          <button type="button" class="eb-vis-btn${onD?" is-on":""}" data-vis="desktop"><span class="eb-vis-tick">✓</span>🖥 Desktop</button>
          <button type="button" class="eb-vis-btn${onM?" is-on":""}" data-vis="mobile"><span class="eb-vis-tick">✓</span>📱 Mobile</button>
        </div>${hint}</div>`;
    }

    /* ─────────── selection-aware typography ───────────
       Highlight part of a text/heading block → a font / size / colour / letter-
       spacing change styles JUST that selection (wrapped in a <span>). With no
       highlight, the change applies to the whole block — and also strips that
       property off any inner spans, so "change everything" really does. */
    let savedSel = null; // { bid, range }
    const fontStackOf = (key)=>{ const f = FONT_STACKS.find(x=>x.key===key); return f ? f.stack : FONT_STACKS[0].stack; };
    const TYPO_CSS = { font:"font-family", size:"font-size", color:"color", letterSpacing:"letter-spacing" };
    function editableOf(node){ const el = node && (node.nodeType===1 ? node : node.parentElement); return el ? el.closest("[data-edit]") : null; }
    document.addEventListener("selectionchange", ()=>{
      const sel = window.getSelection(); if(!sel || !sel.rangeCount) return;
      const range = sel.getRangeAt(0);
      const ed = editableOf(range.commonAncestorContainer);
      if(!ed || !ed.dataset.id) return;          // not inside a block → keep the last saved selection
      savedSel = range.collapsed ? null : { bid: ed.dataset.id, range: range.cloneRange() };
    });
    function typoCssValue(field, v){ return field==="font" ? fontStackOf(v) : (field==="size"||field==="letterSpacing") ? (v+"px") : v; }
    // Wrap the selection in a <span> carrying one property; clear the same
    // property from descendants so the new value wins. Returns the new range.
    function styleRange(range, prop, value){
      const span = document.createElement("span");
      span.style.setProperty(prop, value);
      try { range.surroundContents(span); }
      catch(_){ const frag = range.extractContents(); span.appendChild(frag); range.insertNode(span); }
      span.querySelectorAll("[style]").forEach(el=>el.style.removeProperty(prop));
      const sel = window.getSelection(); sel.removeAllRanges();
      const r = document.createRange(); r.selectNodeContents(span); sel.addRange(r);
      return r;
    }
    function applyToSelection(bid, field, v){
      const ed = blocksWrap.querySelector(`[data-edit][data-id="${bid}"]`);
      if(!ed || !savedSel || savedSel.bid!==bid) return false;
      const range = savedSel.range;
      if(range.collapsed || !ed.contains(range.commonAncestorContainer)) return false;
      const sel = window.getSelection(); sel.removeAllRanges(); sel.addRange(range);
      const newR = styleRange(range, TYPO_CSS[field], typoCssValue(field, v));
      savedSel = { bid, range: newR.cloneRange() };
      const blk = findBlock(bid);
      if(blk){ blk.html = ed.innerHTML; blk.text = ed.innerText; }
      markDirty();
      return true;
    }
    // Strip a typography property from every inner span so a block-wide change
    // isn't overridden by earlier per-selection spans.
    function clearInlineProp(blk, field){
      if(!blk || blk.html==null || blk.html==="") return;
      const tmp = document.createElement("div"); tmp.innerHTML = blk.html;
      tmp.querySelectorAll("[style]").forEach(el=>el.style.removeProperty(TYPO_CSS[field]));
      blk.html = tmp.innerHTML;
    }

    // Reusable image-upload control (button + hidden file input + status) that
    // POSTs to the Worker → R2 and hands back a URL. Same flow everywhere:
    // image blocks, block backgrounds, column backgrounds.
    function uploadControl(key, label){
      return `<div class="eb-upl"><button type="button" class="eb-mini-btn" data-upload="${key}">⬆ ${esc(label||"Upload from file")}</button><input type="file" data-upload-input="${key}" accept="image/*" hidden /><span class="eb-note" data-upload-status="${key}"></span></div>`;
    }
    function wireUpload(scope, key, onDone){
      const btn = scope.querySelector(`[data-upload="${key}"]`);
      const inp = scope.querySelector(`[data-upload-input="${key}"]`);
      const stat = scope.querySelector(`[data-upload-status="${key}"]`);
      if(!btn || !inp) return;
      btn.addEventListener("click", ()=>inp.click());
      inp.addEventListener("change", async ()=>{
        const file = inp.files && inp.files[0]; if(!file) return;
        if(!WORKER_URL){ if(stat) stat.textContent = "Set PUBLIC_R2_WORKER_URL to upload."; return; }
        if(stat) stat.textContent = "Uploading…";
        try {
          const { data:{ session:s } } = await supabase.auth.getSession();
          const fd = new FormData(); fd.append("file", file);
          const res = await fetch(`${WORKER_URL}/admin/upload`, { method:"POST", headers: s&&s.access_token?{Authorization:`Bearer ${s.access_token}`}:{}, body: fd });
          const j = await res.json().catch(()=>({}));
          if(!res.ok || !j.url){ if(stat) stat.textContent = "Upload failed: "+(j.error||("HTTP "+res.status)); return; }
          if(stat) stat.textContent = "Uploaded ✓";
          onDone(j.url);
        } catch(e){ if(stat) stat.textContent = "Upload failed: "+(e.message||e); }
      });
    }

    function openInspector(bid) {
      const b = findBlock(bid); if(!b) return;
      const def = BLOCK_TYPES.find(d=>d.type===b.type);
      $("#eb-insp-title").textContent = def ? def.label : b.type;
      const wrap = $("#eb-insp-fields"); wrap.innerHTML = inspectorFields(b, canvasDevice) + visibilityControl(b);
      injectBrandSwatches(wrap);   // brand-colour presets under every colour picker
      wrap.querySelectorAll("[data-vis]").forEach((btn)=>btn.addEventListener("click", ()=>{
        if(!b.hide) b.hide = {};
        const dev = btn.dataset.vis; b.hide[dev] = !b.hide[dev];
        renderCanvas(); openInspector(bid);
      }));
      // Per-device size/spacing toggle → drives the shared canvas device state.
      wrap.querySelectorAll("[data-respdev]").forEach((btn)=>btn.addEventListener("click", ()=>setCanvasDevice(btn.dataset.respdev)));
      wrap.querySelectorAll("[data-field]").forEach((inp)=>{
        // font / size / colour / letter-spacing on a text/heading can target a
        // highlight — commit those on "change" so we don't re-wrap per keystroke.
        const baseField = inp.dataset.field.replace("mobile.","");
        const isTypo = (b.type==="text"||b.type==="heading") && TYPO_CSS[baseField];
        const evt = inp.type==="checkbox"||inp.tagName==="SELECT"||isTypo ? "change" : "input";
        inp.addEventListener(evt, ()=>{
          let v;
          if(inp.type==="checkbox") v=inp.checked;
          else if(inp.type==="number") v = inp.value==="" ? undefined : Number(inp.value);  // blank = unset (use default)
          else v=inp.value;
          // Highlighted text → style just the selection, leave the block default alone.
          if(isTypo && v!=null && v!=="" && applyToSelection(bid, baseField, v)) return;
          // Block-wide → also clear the same prop off inner spans so it truly applies to all.
          if(isTypo && v!=null && v!=="") clearInlineProp(b, baseField);
          setPath(b, inp.dataset.field, v); renderCanvas();
          blocksWrap.querySelectorAll(".cv-block").forEach((el)=>el.classList.toggle("is-selected", el.dataset.id===bid));
        });
      });
      // FAQ block: repeatable Q/A items.
      if (b.type === "faq") {
        if (!Array.isArray(b.items)) b.items = [];
        wrap.querySelectorAll("[data-faq]").forEach((inp)=>{
          inp.addEventListener("input", ()=>{
            const [i,k] = inp.dataset.faq.split("."); b.items[Number(i)] = b.items[Number(i)] || {q:"",a:""}; b.items[Number(i)][k] = inp.value; renderCanvas();
          });
        });
        wrap.querySelectorAll("[data-faq-del]").forEach((btn)=>btn.addEventListener("click", ()=>{ b.items.splice(Number(btn.dataset.faqDel),1); renderCanvas(); openInspector(bid); }));
        wrap.querySelector("#eb-faq-add")?.addEventListener("click", ()=>{ b.items.push({q:"",a:""}); renderCanvas(); openInspector(bid); });
      }
      // Columns block: changing layout adds/removes columns; when shrinking,
      // orphaned children fold into the last remaining column so nothing is lost.
      if (b.type === "columns") {
        if (!Array.isArray(b.cols)) b.cols = [[], []];
        wrap.querySelector('[data-field="layout"]')?.addEventListener("change", (e)=>{
          const lay = COLUMN_LAYOUTS.find(l=>l.key===e.target.value) || COLUMN_LAYOUTS[1];
          const need = lay.cols;
          while (b.cols.length < need) b.cols.push([]);
          if (b.cols.length > need){
            const extra = b.cols.splice(need);
            extra.forEach(col => (col||[]).forEach(cb => b.cols[need-1].push(cb)));
          }
          renderCanvas(); openInspector(bid);
        });
        // Per-column background — colour swatch + hex field stay in sync.
        const setColBg = (i, v)=>{ if(!Array.isArray(b.colBg)) b.colBg=[]; b.colBg[i]=v; renderCanvas(); };
        wrap.querySelectorAll("[data-colbg-sw]").forEach((sw)=>{
          sw.addEventListener("input", ()=>{ const i=Number(sw.dataset.colbgSw); const t=wrap.querySelector(`[data-colbg="${i}"]`); if(t) t.value=sw.value; setColBg(i, sw.value); });
        });
        wrap.querySelectorAll("[data-colbg]").forEach((inp)=>{
          inp.addEventListener("input", ()=>{ const i=Number(inp.dataset.colbg); let v=inp.value.trim(); if(v && !v.startsWith("#") && /^[0-9a-f]{3,8}$/i.test(v)) v="#"+v; const sw=wrap.querySelector(`[data-colbg-sw="${i}"]`); if(sw && /^#[0-9a-f]{6}$/i.test(v)) sw.value=v; setColBg(i, v); });
        });
        // Per-column background image — URL field + upload button (one per column).
        const setColBgImage = (i, v)=>{ if(!Array.isArray(b.colBgImage)) b.colBgImage=[]; b.colBgImage[i]=v; renderCanvas(); };
        wrap.querySelectorAll("[data-colbg-img]").forEach((inp)=>{
          inp.addEventListener("input", ()=>setColBgImage(Number(inp.dataset.colbgImg), inp.value.trim()));
        });
        (COLUMN_LAYOUTS.find(l=>l.key===(b.layout||"50-50"))||{w:[0,0]}).w.forEach((w,i)=>{
          wireUpload(wrap, "col"+i, (url)=>{ const f=wrap.querySelector(`[data-colbg-img="${i}"]`); if(f) f.value=url; setColBgImage(i, url); openInspector(bid); });
        });
      }
      // Products / Services — repeatable items.
      if (b.type === "products" || b.type === "services") {
        if (!Array.isArray(b.items)) b.items = [];
        wrap.querySelectorAll("[data-item]").forEach((inp)=>{
          inp.addEventListener("input", ()=>{ const [i,k]=inp.dataset.item.split("."); const ix=Number(i); b.items[ix]=b.items[ix]||{}; b.items[ix][k]=inp.value; renderCanvas(); });
        });
        wrap.querySelectorAll("[data-item-del]").forEach((btn)=>btn.addEventListener("click", ()=>{ b.items.splice(Number(btn.dataset.itemDel),1); renderCanvas(); openInspector(bid); }));
        wrap.querySelector("[data-item-add]")?.addEventListener("click", ()=>{ b.items.push(b.type==="products"?{title:"",price:"",image:"",url:"",cta:"View"}:{title:"",text:"",btnText:"",btnUrl:""}); renderCanvas(); openInspector(bid); });
        // Products: pull straight from the packs catalogue.
        wrap.querySelector("#eb-pack-load")?.addEventListener("click", async ()=>{
          try {
            const { data } = await supabase.from("packs").select("*").limit(12);
            (data||[]).forEach((p)=>{
              const price = p.price_label || (p.price_pence!=null?("£"+(p.price_pence/100)):"") || (p.price!=null?("£"+p.price):"");
              b.items.push({ title: p.title||p.name||"Pack", price, image: p.cover_url||p.image_url||p.thumb_url||p.cover||"", url: "https://tmke.co.uk/account", cta: "View pack" });
            });
            renderCanvas(); openInspector(bid);
          } catch(_) { alert("Couldn't load packs."); }
        });
      }
      // Image gallery — repeatable URLs.
      if (b.type === "slider") {
        if (!Array.isArray(b.images)) b.images = [];
        wrap.querySelectorAll("[data-img]").forEach((inp)=>{ inp.addEventListener("input", ()=>{ b.images[Number(inp.dataset.img)]=inp.value; renderCanvas(); }); });
        wrap.querySelectorAll("[data-img-del]").forEach((btn)=>btn.addEventListener("click", ()=>{ b.images.splice(Number(btn.dataset.imgDel),1); renderCanvas(); openInspector(bid); }));
        wrap.querySelector("#eb-img-add")?.addEventListener("click", ()=>{ b.images.push(""); renderCanvas(); openInspector(bid); });
      }
      // Form — fields textarea (one per line) → array.
      if (b.type === "form") {
        wrap.querySelector("[data-formfields]")?.addEventListener("input", (e)=>{ b.fields = e.target.value.split("\n").map(s=>s.trim()).filter(Boolean); renderCanvas(); });
      }
      // Image block — upload straight into the Image URL field.
      if (b.type === "image") {
        wireUpload(wrap, "image", (url)=>{ b.url = url; renderCanvas(); openInspector(bid); });
      }
      // Text block — background-image upload.
      if (b.type === "text") {
        wireUpload(wrap, "textbg", (url)=>{ b.bgImage = url; renderCanvas(); openInspector(bid); });
      }
      // Text — inline rich-text toolbar (bold/italic/underline/bullets). Keep the
      // canvas selection by preventing the button from stealing focus, then apply.
      if (b.type === "text") {
        wrap.querySelectorAll("[data-fmt]").forEach((btn)=>{
          btn.addEventListener("mousedown", (e)=>e.preventDefault());
          btn.addEventListener("click", ()=>{
            const ed = blocksWrap.querySelector(`[data-edit][data-id="${bid}"]`);
            if(!ed) return;
            if (document.activeElement !== ed) ed.focus();
            document.execCommand(btn.dataset.fmt, false, null);
            b.html = ed.innerHTML; b.text = ed.innerText;
          });
        });
        // Merge-field chips — insert a token at the cursor (keep canvas selection).
        wrap.querySelectorAll("[data-token]").forEach((chip)=>{
          chip.addEventListener("mousedown", (e)=>e.preventDefault());
          chip.addEventListener("click", ()=>{
            const ed = blocksWrap.querySelector(`[data-edit][data-id="${bid}"]`);
            if (ed) { lastEditable = ed; if (document.activeElement !== ed) ed.focus(); }
            insertToken(chip.dataset.token);
          });
        });
      }
      $("#eb-rail-blocks").hidden = true; $("#eb-rail-inspector").hidden = false;
    }
    $("#eb-insp-back").addEventListener("click", deselect);
    $("#eb-insp-del").addEventListener("click", ()=>{ if(selectedId) del(selectedId); });
    // click empty canvas to deselect
    $("#eb-canvas-pane").addEventListener("mousedown", (e)=>{ if(!e.target.closest(".cv-block")) deselect(); });

    /* ─────────── palette ─────────── */
    $("#eb-palette").innerHTML = BLOCK_TYPES.map(d=>`<button type="button" class="eb-tile" draggable="true" data-add="${d.type}" title="${d.hint}">${svg(ICONS[d.type]||"")}<span>${d.label}</span></button>`).join("");
    $("#eb-palette").querySelectorAll("[data-add]").forEach(btn=>{
      // Click still works; drag-and-drop feels more natural (drop where you want it).
      btn.addEventListener("click", ()=>addBlock(btn.dataset.add));
      btn.addEventListener("dragstart", (e)=>{ paletteDragType = btn.dataset.add; e.dataTransfer.effectAllowed = "copy"; try { e.dataTransfer.setData("text/plain", btn.dataset.add); } catch(_){} });
      btn.addEventListener("dragend", ()=>{ paletteDragType = null; });
    });
    // Dropping a palette block onto empty canvas space appends it.
    const canvasDropZones = [$("#eb-blocks"), $("#eb-canvas")].filter(Boolean);
    canvasDropZones.forEach((zone)=>{
      zone.addEventListener("dragover", (e)=>{ if (paletteDragType) { e.preventDefault(); zone.classList.add("eb-drop-live"); } });
      zone.addEventListener("dragleave", ()=>zone.classList.remove("eb-drop-live"));
      zone.addEventListener("drop", (e)=>{
        zone.classList.remove("eb-drop-live");
        if (!paletteDragType) return;
        if (e.target.closest(".cv-block")) return;   // a block-level handler already placed it
        e.preventDefault();
        const nb = makeBlock(paletteDragType); paletteDragType = null;
        state.blocks.push(nb); renderCanvas(); select(nb.id);
      });
