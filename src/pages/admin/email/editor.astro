    .eb-html-pane { flex:1; padding:24px 32px 80px; }
    .eb-html { width:100%; min-height:60vh; font-family:ui-monospace,Menlo,monospace; font-size:13px; line-height:1.6; padding:16px; border:1px solid var(--eb-line); border-radius:10px; background:#fff; color:var(--ink); }
    .eb-html:focus { outline:none; border-color:var(--english-violet); }

    /* Modals */
    .eb-modal { position:fixed; inset:0; z-index:60; background:rgba(20,18,26,0.45); display:flex; align-items:center; justify-content:center; padding:24px; }
