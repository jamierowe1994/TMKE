---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import "../../../styles/admin.css";
---

<BaseLayout
  title="Email template editor — Admin · TMKE"
  description="Build a branded email template from blocks, preview it, and send a test."
  hideNav
  hideFooter
>
  <!-- ───────────────── top bar ───────────────── -->
  <header class="eb-top">
    <div class="eb-top-l">
      <a href="/admin/email" class="eb-back" aria-label="Back to email studio">&larr;</a>
      <input id="eb-name" class="eb-name" placeholder="Untitled template" />
      <span class="eb-status-pill" id="eb-status-pill" data-status="draft">Draft</span>
      <span class="eb-saved" id="eb-saved"></span>
    </div>
    <div class="eb-top-r">
      <button type="button" class="eb-btn eb-btn-ghost eb-icon-btn" id="eb-undo" title="Undo (Ctrl+Z)" aria-label="Undo" disabled>&#8630;</button>
      <button type="button" class="eb-btn eb-btn-ghost eb-icon-btn" id="eb-redo" title="Redo (Ctrl+Shift+Z)" aria-label="Redo" disabled>&#8631;</button>
      <button type="button" class="eb-btn eb-btn-ghost" id="eb-settings">Settings</button>
      <button type="button" class="eb-btn eb-btn-ghost" id="eb-brand">Brand</button>
      <button type="button" class="eb-btn eb-btn-ghost" id="eb-preview">Preview</button>
      <button type="button" class="eb-btn eb-btn-ghost" id="eb-sendtest">Send test</button>
      <button type="button" class="eb-btn eb-btn-ghost" id="eb-save">Save</button>
      <button type="button" class="eb-btn eb-btn-solid" id="eb-activate">Activate</button>
    </div>
  </header>

  <div class="eb-shell">
    <!-- ───────────────── left rail ───────────────── -->
    <aside class="eb-rail">
      <!-- default view: blocks + edit mode + background -->
      <div id="eb-rail-blocks">
        <div class="eb-rail-sec">
          <h4 class="eb-rail-h">Blocks</h4>
          <div class="eb-palette" id="eb-palette"></div>
        </div>
        <div class="eb-rail-sec">
          <h4 class="eb-rail-h">Edit mode</h4>
          <button type="button" class="eb-mode is-active" data-mode="blocks">
            <span class="eb-mode-ic">▦</span>
            <span><strong>Visual blocks</strong><em>Click, edit, reorder</em></span>
          </button>
          <button type="button" class="eb-mode" data-mode="html">
            <span class="eb-mode-ic">&lt;/&gt;</span>
            <span><strong>HTML</strong><em>Write raw markup</em></span>
          </button>
        </div>
        <div class="eb-rail-sec">
          <h4 class="eb-rail-h">Email background</h4>
          <label class="eb-swatch-label">Page</label>
          <div class="eb-swatches" data-target="bgColor"></div>
          <input class="eb-hex" data-hex="bgColor" maxlength="7" />
          <label class="eb-swatch-label" style="margin-top:12px;">Card</label>
          <div class="eb-swatches" data-target="cardColor"></div>
          <input class="eb-hex" data-hex="cardColor" maxlength="7" />
        </div>
      </div>

      <!-- swapped-in view: inspector for the selected block -->
      <div id="eb-rail-inspector" hidden>
        <button type="button" class="eb-insp-back" id="eb-insp-back">&larr; Blocks</button>
        <h4 class="eb-rail-h" id="eb-insp-title">Block</h4>
        <div id="eb-insp-fields"></div>
        <button type="button" class="eb-insp-del" id="eb-insp-del">Delete block</button>
      </div>
    </aside>

    <!-- ───────────────── stage ───────────────── -->
    <main class="eb-stage">
      <div class="eb-subjbar">
        <div class="eb-subj-head">
          <span class="eb-subj-label">Subject</span>
          <div class="eb-var-wrap">
            <button type="button" class="eb-var-btn" id="eb-var-btn">{ } Variable ▾</button>
            <div class="eb-var-menu" id="eb-var-menu" hidden></div>
          </div>
        </div>
        <input id="eb-subject" class="eb-subject" placeholder="Subject line — e.g. You're booked in, {{firstName}}" data-editable />
      </div>

      <!-- visual canvas -->
      <div class="eb-canvas-pane" id="eb-canvas-pane">
        <div class="eb-canvas-devbar">
          <div class="eb-dev-toggle">
            <button type="button" class="eb-dev is-active" data-canvasdev="desktop" title="Preview the desktop layout">🖥 Desktop</button>
            <button type="button" class="eb-dev" data-canvasdev="mobile" title="Preview the mobile layout">📱 Mobile</button>
          </div>
        </div>
        <div class="eb-canvas" id="eb-canvas">
          <div class="eb-email" id="eb-email">
            <div class="eb-email-blocks" id="eb-blocks"></div>
          </div>
          <p class="eb-canvas-empty" id="eb-canvas-empty" hidden>Pick a block from the left to start building.</p>
        </div>
      </div>

      <!-- html mode -->
      <div class="eb-html-pane" id="eb-html-pane" hidden>
        <textarea id="eb-html" class="eb-html" placeholder="<p>Write raw HTML. Merge fields like {{firstName}} work too.</p>&#10;&#10;Paste a full <!doctype html>… document for total control, or just the inner body and we'll wrap it in the TMKE shell." data-editable></textarea>
      </div>
    </main>
  </div>

  <!-- ───────────────── modals ───────────────── -->
  <div class="eb-modal" id="eb-modal-settings" hidden>
    <div class="eb-modal-card">
      <div class="eb-modal-head"><h3>Settings</h3><button type="button" class="eb-modal-x" data-close>✕</button></div>
      <label class="eb-f"><span>Template name (internal)</span><input id="s-name" /></label>
      <label class="eb-f"><span>Preheader (inbox preview text)</span><input id="s-preheader" placeholder="Short line shown after the subject" /></label>
      <div class="eb-f2">
        <label class="eb-f"><span>Trigger</span>
          <select id="s-trigger">
            <option value="">Manual / newsletter</option>
            <option value="account_welcome">account_welcome</option>
            <option value="order_confirmation">order_confirmation</option>
            <option value="enquiry_received">enquiry_received</option>
            <option value="waitlist_confirmation">waitlist_confirmation</option>
          </select>
        </label>
        <label class="eb-f"><span>Status</span>
          <select id="s-status"><option value="draft">Draft</option><option value="active">Active</option><option value="archived">Archived</option></select>
        </label>
      </div>
      <p class="eb-note">Tagging a trigger reserves this template for that event (one active template per trigger). Automatic sending on these events is the next phase — for now templates are sent manually.</p>
    </div>
  </div>

  <div class="eb-modal" id="eb-modal-brand" hidden>
    <div class="eb-modal-card">
      <div class="eb-modal-head"><h3>Branding</h3><button type="button" class="eb-modal-x" data-close>✕</button></div>
      <div class="eb-f2">
        <label class="eb-f"><span>Company name</span><input data-brand="companyName" /></label>
        <label class="eb-f"><span>Sign-off</span><input data-brand="signatureName" placeholder="The TMKE Team" /></label>
      </div>
      <label class="eb-f"><span>Logo URL</span><input data-brand="logo" type="url" placeholder="https://…/logo.png" /></label>
      <div class="eb-checks" style="margin:2px 0 4px;">
        <label class="eb-check"><input type="checkbox" data-brand="showHeader" /> Show logo header at the top</label>
        <label class="eb-check"><input type="checkbox" data-brand="showSignoff" /> Show sign-off at the bottom</label>
      </div>
      <label class="eb-f"><span>Accent colour</span><input data-brand="accentColor" type="color" /></label>
      <h4 class="eb-rail-h" style="margin-top:6px;">Layout &amp; spacing</h4>
      <div class="eb-f2">
        <label class="eb-f"><span>Content padding (px)</span><input data-brand="contentPad" type="number" min="0" max="80" step="1" placeholder="24" /></label>
        <label class="eb-f"><span>Outer margin (px)</span><input data-brand="outerPad" type="number" min="0" max="80" step="1" placeholder="24" /></label>
      </div>
      <p class="eb-hint" style="margin:-2px 0 6px;color:#8a8796;font-size:11.5px;">Set content padding to <strong>0</strong> for full-width blocks (e.g. an edge-to-edge footer). Then add each block's own padding under its “Spacing” controls.</p>
      <h4 class="eb-rail-h" style="margin-top:6px;">Social links</h4>
      <div class="eb-f2">
        <label class="eb-f"><span>Website</span><input data-brand="website" type="url" /></label>
        <label class="eb-f"><span>LinkedIn</span><input data-brand="linkedin" type="url" /></label>
      </div>
      <div class="eb-f2">
        <label class="eb-f"><span>Instagram</span><input data-brand="instagram" type="url" /></label>
        <label class="eb-f"><span>Facebook</span><input data-brand="facebook" type="url" /></label>
      </div>
      <div class="eb-f2">
        <label class="eb-f"><span>X / Twitter</span><input data-brand="twitter" type="url" /></label>
        <label class="eb-f"><span>YouTube</span><input data-brand="youtube" type="url" /></label>
      </div>
    </div>
  </div>

  <div class="eb-modal" id="eb-modal-preview" hidden>
    <div class="eb-modal-card eb-modal-card--wide">
      <div class="eb-modal-head"><h3>Preview — true email render</h3>
        <div class="eb-dev-toggle"><button type="button" class="eb-dev is-active" data-dev="desktop">Desktop</button><button type="button" class="eb-dev" data-dev="mobile">Mobile</button></div>
        <button type="button" class="eb-modal-x" data-close>✕</button>
      </div>
      <div class="eb-modal-subject">Subject: <strong id="eb-pv-subject">—</strong></div>
      <div class="eb-pv-stage"><iframe id="eb-pv-frame" class="is-desktop" title="Email preview" sandbox=""></iframe></div>
    </div>
  </div>

  <p class="eb-toast" id="eb-toast" hidden></p>

  <style is:global>
    :root { --eb-line: rgba(28,29,34,0.1); --eb-line2: rgba(28,29,34,0.06); }
    body { overflow-x: hidden; }

    /* Buttons */
    .eb-btn { padding:8px 14px; font-family:var(--sans); font-size:12px; font-weight:700; letter-spacing:0.1em; text-transform:uppercase; border:1px solid transparent; border-radius:6px; cursor:pointer; background:transparent; }
    .eb-btn-ghost { color:var(--english-violet); border-color:rgba(55,30,40,0.22); }
    .eb-btn-ghost:hover { background:rgba(55,30,40,0.06); }
    .eb-icon-btn { padding:6px 10px; font-size:17px; line-height:1; letter-spacing:0; }
    .eb-btn:disabled { opacity:0.35; cursor:default; }
    .eb-btn:disabled:hover { background:transparent; }
    .eb-btn-solid { background:var(--english-violet); color:#fff; }
    .eb-btn-solid:hover { background:var(--ink); }

    /* Top bar */
    .eb-top { position:sticky; top:0; z-index:40; display:flex; justify-content:space-between; align-items:center; gap:16px; padding:12px 22px; background:rgba(255,255,255,0.94); backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px); border-bottom:1px solid var(--eb-line); }
    .eb-top-l { display:flex; align-items:center; gap:12px; min-width:0; }
    .eb-top-r { display:flex; gap:7px; flex-wrap:wrap; }
    .eb-back { font-family:var(--serif); font-size:20px; color:rgba(28,29,34,0.6); text-decoration:none; padding:0 4px; }
    .eb-back:hover { color:var(--english-violet); }
    .eb-name { font-family:var(--serif); font-size:21px; color:var(--ink); border:1px solid transparent; background:transparent; padding:5px 8px; border-radius:6px; min-width:260px; }
    .eb-name:hover { background:rgba(28,29,34,0.04); }
    .eb-name:focus { outline:none; border-color:var(--english-violet); background:#fff; }
    .eb-status-pill { font-family:var(--sans); font-size:10px; font-weight:700; letter-spacing:0.18em; text-transform:uppercase; padding:4px 10px; border-radius:999px; }
    .eb-status-pill[data-status="draft"] { background:rgba(55,30,40,0.1); color:var(--english-violet); }
    .eb-status-pill[data-status="active"] { background:rgba(60,130,80,0.14); color:#2d6a44; }
    .eb-status-pill[data-status="archived"] { background:rgba(28,29,34,0.08); color:rgba(28,29,34,0.55); }
    .eb-saved { font-family:var(--sans); font-size:11px; color:rgba(28,29,34,0.42); white-space:nowrap; }
    .eb-saved.is-dirty { color:#a05a3c; }

    /* Shell */
    .eb-shell { display:grid; grid-template-columns:288px 1fr; min-height:calc(100vh - 56px); align-items:stretch; }
    @media (max-width:920px){ .eb-shell { grid-template-columns:1fr; }
      /* Stacked single column — let the rail flow with the page again. */
      .eb-rail { position:static; height:auto; overflow:visible; } }

    /* Rail */
    /* Left rail pins under the sticky top bar and scrolls on its OWN scrollbar,
       so page-scrolling the email preview never drags the toolbar with it. */
    .eb-rail { background:#fff; border-right:1px solid var(--eb-line); padding:22px 18px 80px;
      position:sticky; top:61px; align-self:start; height:calc(100vh - 61px);
      overflow-y:auto; overscroll-behavior:contain; }
    .eb-rail-sec { margin-bottom:26px; }
    .eb-rail-h { font-family:var(--sans); font-size:10px; font-weight:700; letter-spacing:0.22em; text-transform:uppercase; color:rgba(28,29,34,0.45); margin:0 0 12px; }
    .eb-palette { display:grid; grid-template-columns:1fr 1fr; gap:8px; }
    .eb-tile { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:7px; padding:16px 6px; border:1px solid var(--eb-line); border-radius:9px; background:#fff; cursor:pointer; color:rgba(28,29,34,0.78); transition:border-color 0.18s, background 0.18s, transform 0.12s; }
    .eb-tile:hover { border-color:var(--english-violet); background:rgba(55,30,40,0.04); transform:translateY(-1px); }
    .eb-tile svg { color:var(--english-violet); }
    .eb-tile span { font-family:var(--sans); font-size:11.5px; font-weight:600; letter-spacing:0.02em; }

    .eb-mode { display:flex; align-items:center; gap:11px; width:100%; text-align:left; padding:11px 12px; margin-bottom:8px; border:1px solid var(--eb-line); border-radius:9px; background:#fff; cursor:pointer; }
    .eb-mode.is-active { border-color:var(--english-violet); background:rgba(55,30,40,0.05); }
    .eb-mode-ic { width:26px; height:26px; display:inline-flex; align-items:center; justify-content:center; border-radius:6px; background:rgba(28,29,34,0.06); font-size:13px; color:var(--english-violet); font-family:ui-monospace,Menlo,monospace; }
    .eb-mode strong { display:block; font-family:var(--sans); font-size:13px; color:var(--ink); }
    .eb-mode em { display:block; font-family:var(--sans); font-size:11px; font-style:normal; color:rgba(28,29,34,0.5); }

    .eb-swatch-label { font-family:var(--sans); font-size:11px; font-weight:600; color:rgba(28,29,34,0.6); display:block; margin-bottom:7px; }
    .eb-swatches { display:flex; flex-wrap:wrap; gap:6px; margin-bottom:8px; }
    .eb-sw { width:24px; height:24px; border-radius:6px; border:1px solid rgba(28,29,34,0.15); cursor:pointer; padding:0; position:relative; }
    .eb-sw.is-active { box-shadow:0 0 0 2px var(--english-violet); }
    .eb-sw[data-none="1"] { display:flex; align-items:center; justify-content:center; color:rgba(28,29,34,0.4); font-size:12px; background:#fff; }
    .eb-hex { width:100%; font-family:ui-monospace,Menlo,monospace; font-size:12px; padding:7px 10px; border:1px solid var(--eb-line); border-radius:6px; text-transform:uppercase; }
    .eb-hex:focus { outline:none; border-color:var(--english-violet); }
    /* Brand-colour presets shown under a native colour picker */
    .eb-bsw-row { display:flex; flex-wrap:wrap; gap:5px; margin-top:8px; }
    .eb-bsw { width:22px; height:22px; border-radius:5px; border:1px solid rgba(28,29,34,0.2); cursor:pointer; padding:0; transition:transform 0.1s; }
    .eb-bsw:hover { transform:scale(1.12); }

    /* Inspector */
    .eb-insp-back { background:none; border:0; cursor:pointer; font-family:var(--sans); font-size:11px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; color:var(--english-violet); padding:0 0 14px; }
    .eb-insp-del { margin-top:18px; width:100%; padding:9px; border:1px solid rgba(160,90,60,0.4); background:transparent; color:#a05a3c; border-radius:7px; cursor:pointer; font-family:var(--sans); font-size:11px; font-weight:700; letter-spacing:0.14em; text-transform:uppercase; }
    .eb-insp-del:hover { background:rgba(160,90,60,0.08); }

    /* Fields (rail inspector + modals) */
    .eb-f { display:flex; flex-direction:column; gap:6px; margin-bottom:12px; }
    .eb-f > span { font-family:var(--sans); font-size:10px; font-weight:700; letter-spacing:0.16em; text-transform:uppercase; color:rgba(28,29,34,0.55); }
    .eb-f input, .eb-f select, .eb-f textarea { font-family:var(--sans); font-size:13.5px; padding:9px 11px; border:1px solid var(--eb-line); border-radius:7px; background:#fff; color:var(--ink); width:100%; }
    .eb-f input[type="color"] { padding:3px; height:38px; cursor:pointer; }
    .eb-f input:focus, .eb-f select:focus, .eb-f textarea:focus { outline:none; border-color:var(--english-violet); box-shadow:0 0 0 3px rgba(55,30,40,0.08); }
    .eb-f2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .eb-checks { display:flex; flex-wrap:wrap; gap:8px 14px; margin-bottom:8px; }
    .eb-check { display:inline-flex; align-items:center; gap:6px; font-family:var(--sans); font-size:12.5px; color:rgba(28,29,34,0.75); }
    .eb-check input { accent-color:var(--english-violet); }
    .eb-note { font-family:var(--sans); font-size:11.5px; line-height:1.5; color:rgba(28,29,34,0.5); }

    /* Stage */
    .eb-stage { display:flex; flex-direction:column; background:#f1f0ef; min-width:0; }
    .eb-subjbar { background:#fff; border-bottom:1px solid var(--eb-line); padding:16px 32px; }
    .eb-subj-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:8px; }
    .eb-subj-label { font-family:var(--sans); font-size:10px; font-weight:700; letter-spacing:0.22em; text-transform:uppercase; color:rgba(28,29,34,0.45); }
    .eb-subject { width:100%; font-family:var(--sans); font-size:15px; padding:11px 14px; border:1px solid var(--eb-line); border-radius:8px; color:var(--ink); }
    .eb-subject:focus { outline:none; border-color:var(--english-violet); box-shadow:0 0 0 3px rgba(55,30,40,0.08); }
    .eb-var-wrap { position:relative; }
    .eb-var-btn { font-family:var(--sans); font-size:11px; font-weight:700; color:var(--english-violet); background:#fff; border:1px solid var(--eb-line); border-radius:7px; padding:6px 11px; cursor:pointer; }
    .eb-var-btn:hover { border-color:var(--english-violet); }
    .eb-var-menu { position:absolute; right:0; top:calc(100% + 6px); z-index:20; background:#fff; border:1px solid var(--eb-line); border-radius:9px; box-shadow:0 16px 40px -16px rgba(20,18,26,0.4); padding:6px; min-width:200px; }
    .eb-var-item { display:flex; justify-content:space-between; gap:14px; width:100%; padding:8px 10px; border:0; background:transparent; cursor:pointer; border-radius:6px; font-family:var(--sans); font-size:13px; color:var(--ink); }
    .eb-var-item:hover { background:rgba(55,30,40,0.06); }
    .eb-var-item code { font-family:ui-monospace,Menlo,monospace; font-size:11px; color:var(--english-violet); }

    .eb-canvas-pane { flex:1; overflow:auto; padding:32px 20px 120px; }
    .eb-canvas { max-width:680px; margin:0 auto; position:relative; }
    .eb-email { background:#fff; border-radius:14px; padding:30px; box-shadow:0 18px 50px -28px rgba(20,18,26,0.45); }
    .eb-email-blocks { display:flex; flex-direction:column; }
    .eb-canvas-empty { text-align:center; font-family:var(--sans); font-size:14px; color:rgba(28,29,34,0.45); padding:48px 0; }

    /* Canvas blocks */
    .cv-block { position:relative; padding:8px; margin:1px 0; border:1.5px solid transparent; border-radius:8px; }
    .cv-block:hover { border-color:rgba(55,30,40,0.25); }
    .cv-block.is-selected { border-color:var(--english-violet); }
    .cv-block.cv-drop-before { box-shadow:0 -2px 0 var(--english-violet); }
    .cv-block.cv-drop-after { box-shadow:0 2px 0 var(--english-violet); }
    .eb-drop-live { outline:2px dashed var(--english-violet); outline-offset:6px; border-radius:10px; }
    .eb-tile[draggable="true"] { cursor:grab; }
    .eb-tile[draggable="true"]:active { cursor:grabbing; }
    .eb-mini-btn { font-family:var(--sans); font-size:12px; font-weight:600; color:var(--english-violet); background:transparent; border:1px solid var(--english-violet); border-radius:6px; padding:6px 10px; cursor:pointer; margin-top:4px; }
    .eb-mini-btn:hover { background:rgba(55,30,40,0.06); }
    .cv-toolbar { position:absolute; top:-15px; right:8px; display:none; gap:2px; background:#fff; border:1px solid var(--eb-line); border-radius:7px; padding:3px; box-shadow:0 6px 18px -8px rgba(20,18,26,0.35); z-index:5; }
    .cv-block:hover .cv-toolbar, .cv-block.is-selected .cv-toolbar { display:flex; }
    .cv-tb { width:24px; height:24px; display:inline-flex; align-items:center; justify-content:center; border:0; background:transparent; border-radius:5px; cursor:pointer; color:rgba(28,29,34,0.65); font-size:13px; }
    .cv-tb:hover { background:rgba(28,29,34,0.08); color:var(--ink); }
    .cv-tb.danger:hover { background:rgba(160,90,60,0.12); color:#a05a3c; }
    .cv-grip { cursor:grab; }
    .cv-edit { outline:none; }
    .cv-edit:focus { background:rgba(55,30,40,0.03); border-radius:4px; }
    /* Kill the browser-default <p>/<div> margins so canvas spacing matches the
       sent email (paragraph gaps come from blank lines, not 1em margins). */
    .cv-edit p, .cv-edit div { margin-top:0; margin-bottom:0; }
    .cv-btn { display:inline-block; padding:11px 24px; color:#fff; border-radius:8px; font-family:Helvetica,Arial,sans-serif; font-size:14px; font-weight:600; }
    .cv-ph { display:flex; align-items:center; justify-content:center; min-height:120px; border:1.5px dashed rgba(28,29,34,0.2); border-radius:8px; color:rgba(28,29,34,0.45); font-family:var(--sans); font-size:13px; background:rgba(28,29,34,0.02); text-align:center; padding:12px; }
