      const f=$("#eb-pv-frame"); f.classList.toggle("is-mobile",b.dataset.dev==="mobile"); f.classList.toggle("is-desktop",b.dataset.dev!=="mobile");
    }));

    /* ─────────── save / send ─────────── */
    function gather(){ return {
      name:(state.name||"").trim()||"Untitled template", subject:state.subject||"",
      preheader:(state.preheader||"").trim()||null, trigger_key:state.trigger_key||null,
      mode:state.mode, blocks:state.blocks, custom_html:state.custom_html||null,
      branding:state.branding, status:state.status||"draft",
    }; }
    async function save(opts={}){
      if(!isConfigured){ toast("Connect Supabase to save (works on the live site)."); return false; }
      if(opts.activate){ state.status="active"; $("#s-status").value="active"; setStatusPill(); }
      const payload=gather(); toast(opts.activate?"Activating…":"Saving…");
      const q=id ? supabase.from("email_templates").update(payload).eq("id",id).select().single()
                 : supabase.from("email_templates").insert(payload).select().single();
      const {data,error}=await q;
      if(error){ toast(`Save failed: ${error.message}`); return false; }
      id=data.id; loaded=data;
      if(!params.get("id")||params.get("id")==="new"){ const u=new URL(location.href); u.searchParams.set("id",id); history.replaceState({},"",u.toString()); }
      dirty=false; setSaved("All changes saved");
      toast(opts.activate?"Activated ✓":"Saved ✓"); return true;
    }
    $("#eb-save").addEventListener("click", ()=>save());
    $("#eb-activate").addEventListener("click", ()=>save({activate:true}));
    $("#eb-undo").addEventListener("click", undo);
    $("#eb-redo").addEventListener("click", redo);
    document.addEventListener("keydown",(e)=>{
      if(!(e.ctrlKey||e.metaKey) || e.altKey) return;
      const k=e.key.toLowerCase();
      if(k==="s"){ e.preventDefault(); save(); }
      else if(k==="z" && !e.shiftKey){ e.preventDefault(); undo(); }
      else if((k==="z" && e.shiftKey) || k==="y"){ e.preventDefault(); redo(); }
    });

    /* ─────────── autosave (don't lose drafts on Back) ─────────── */
    let dirty=false, booted=false, autosaving=false;
    function setSaved(txt, cls){ const el=$("#eb-saved"); if(!el) return; el.textContent=txt||""; el.className="eb-saved"+(cls?(" "+cls):""); }
    function markDirty(){ if(booted){ dirty=true; setSaved("Unsaved changes","is-dirty"); scheduleHistory(); } }

    /* ─────────── undo / redo (snapshot history) ─────────── */
    let history=[], histIndex=-1, restoring=false, histTimer=null;
    const HISTORY_CAP=150;
    function snapshotState(){
      return JSON.stringify({ name:state.name, subject:state.subject, preheader:state.preheader,
        trigger_key:state.trigger_key, status:state.status, mode:state.mode,
        blocks:state.blocks, custom_html:state.custom_html, branding:state.branding });
    }
    function pushHistory(){
      const snap=snapshotState();
      if(history[histIndex]===snap) return;                 // nothing actually changed
      history=history.slice(0,histIndex+1);                 // drop any redo branch
      history.push(snap);
      if(history.length>HISTORY_CAP) history.shift();
      histIndex=history.length-1;
      updateUndoRedo();
    }
    function scheduleHistory(){
      if(restoring||!booted) return;
      clearTimeout(histTimer);
      histTimer=setTimeout(()=>{ histTimer=null; pushHistory(); }, 350);  // coalesce typing bursts
    }
    function flushHistory(){ if(histTimer){ clearTimeout(histTimer); histTimer=null; pushHistory(); } }
    function restoreSnapshot(str){
      restoring=true;
      const s=JSON.parse(str);
      Object.assign(state,{ name:s.name, subject:s.subject, preheader:s.preheader,
        trigger_key:s.trigger_key, status:s.status, mode:s.mode,
        blocks:s.blocks, custom_html:s.custom_html, branding:s.branding });
      fillMeta();          // re-hydrates every input + re-renders the canvas
      deselect();
      restoring=false;
      dirty=true; setSaved("Unsaved changes","is-dirty");
      updateUndoRedo();
    }
    function undo(){ flushHistory(); if(histIndex<=0) return; histIndex--; restoreSnapshot(history[histIndex]); }
    function redo(){ if(histIndex>=history.length-1) return; histIndex++; restoreSnapshot(history[histIndex]); }
    function updateUndoRedo(){
      const u=$("#eb-undo"), r=$("#eb-redo");
      if(u) u.disabled = histIndex<=0;
      if(r) r.disabled = histIndex>=history.length-1;
    }
    async function autosave(){
      if(!dirty || autosaving || !isConfigured) return;
      // Never autosave a still-empty brand-new template.
      if(!id && state.blocks.length===0 && !(state.custom_html||"").trim()) return;
      autosaving=true; const wasDirty=dirty; dirty=false; setSaved("Saving…");
      const payload=gather();
      try{
        const q = id ? supabase.from("email_templates").update(payload).eq("id",id).select().single()
                     : supabase.from("email_templates").insert(payload).select().single();
        const {data,error}=await q;
        if(error){ dirty=wasDirty; setSaved("Save pending…","is-dirty"); }
        else{
          id=data.id; loaded=data;
          if(!params.get("id")||params.get("id")==="new"){ const u=new URL(location.href); u.searchParams.set("id",id); history.replaceState({},"",u.toString()); }
          setSaved("All changes saved");
        }
      }catch(_){ dirty=wasDirty; setSaved("Save pending…","is-dirty"); }
      autosaving=false;
    }
    // Save before navigating away via the Back arrow.
    const backLink=$(".eb-back");
    backLink?.addEventListener("click", async (e)=>{
      if(!dirty || !isConfigured) return;   // nothing to save → normal nav
      e.preventDefault();
      const href=backLink.getAttribute("href")||"/admin/email";
      setSaved("Saving…"); await autosave().catch(()=>{}); location.href=href;
    });
    // Periodic + tab-hidden + unload safety nets.
    setInterval(autosave, 15000);
    document.addEventListener("visibilitychange", ()=>{ if(document.visibilityState==="hidden") autosave(); });
    window.addEventListener("beforeunload", ()=>{ if(dirty) autosave(); });

    $("#eb-sendtest").addEventListener("click", async ()=>{
      if(!WORKER_URL){ toast("Set PUBLIC_R2_WORKER_URL to send."); return; }
      const to=prompt("Send a test email to:", (session&&session.user&&session.user.email)||"");
      if(!to) return;
      const brand={...defaultBrand(),...state.branding};
      const ctx=mergeContextFor({name:to.split("@")[0],email:to,company:SAMPLE_RECIPIENT.company},brand);
      const {subject,html}=renderTemplate(state,{brand,mergeCtx:ctx});
      toast("Sending test…");
      try{
        const {data:{session:s}}=await supabase.auth.getSession();
        const res=await fetch(`${WORKER_URL}/email/send`,{method:"POST",headers:{"Content-Type":"application/json",Authorization:`Bearer ${s&&s.access_token}`},body:JSON.stringify({to,subject,html})});
        const j=await res.json().catch(()=>({}));
        if(!res.ok){ toast(`Send failed: ${j.error||res.status}`); return; }
        toast(`Test sent to ${to} ✓`);
      }catch(e){ toast(`Send failed: ${e.message||e}`); }
    });

    /* ─────────── fill + boot ─────────── */
    function fillMeta(){
      nameEl.value=state.name||""; $("#s-name").value=state.name||"";
      subjectEl.value=state.subject||""; $("#s-preheader").value=state.preheader||"";
      $("#s-trigger").value=state.trigger_key||""; $("#s-status").value=state.status||"draft"; setStatusPill();
      $("#eb-html").value=state.custom_html||"";
      const brand={...defaultBrand(),...state.branding};
      if(!brand.logo && brandKitLogo) brand.logo=brandKitLogo;   // default to the brand-kit logo
      state.branding=brand;
      document.querySelectorAll("[data-brand]").forEach(el=>{ const k=el.getAttribute("data-brand"); if(el.type==="checkbox"){ el.checked = brand[k]!==false; return; } if(el.type==="number"){ el.value = (brand[k]===0||brand[k]) ? brand[k] : ""; return; } let v=brand[k]||""; if(el.type==="color"&&!/^#[0-9a-f]{6}$/i.test(v)) v="#371e28"; el.value=v; });
      document.querySelectorAll(".eb-mode").forEach(x=>x.classList.toggle("is-active",x.dataset.mode===state.mode));
      $("#eb-canvas-pane").hidden=state.mode!=="blocks"; $("#eb-html-pane").hidden=state.mode!=="html";
      renderSwatches(); syncHex(); renderCanvas();
    }
    function seedSample(){ state.blocks=[makeBlock("logo"),makeBlock("heading"),makeBlock("text"),makeBlock("button")]; }

    (async ()=>{
      if (DEV) { const {data}=await supabase.auth.getSession(); session=data.session||{user:{email:"dev-preview@tmke.co.uk"}}; }
      else { session=await requireAdmin("/admin/login"); if(!session) return; }

      let realSession = true;
      if (DEV) { const {data}=await supabase.auth.getSession(); realSession=!!data.session; }

      if (id && (realSession || !DEV)) {
        const {data,error}=await supabase.from("email_templates").select("*").eq("id",id).maybeSingle();
        if (data) {
          loaded=data; Object.assign(state,{ name:data.name||"", subject:data.subject||"", preheader:data.preheader||"",
            trigger_key:data.trigger_key||"", status:data.status||"draft", mode:data.mode||"blocks",
            blocks:Array.isArray(data.blocks)?data.blocks:[], custom_html:data.custom_html||"",
            branding:{...defaultBrand(),...(data.branding||{})} });
          migrateColumns(state.blocks);
        } else if (!DEV) { alert("Couldn't load template. Returning to the list."); location.replace("/admin/email"); return; }
        else { seedSample(); }
      } else { seedSample(); }
      await loadBrandKit();   // pull the shared brand colours (→ swatches) + logo
      fillMeta();
      booted = true;   // now user edits count as dirty (enables autosave)
      history=[]; histIndex=-1; pushHistory();  // baseline = the loaded/seeded state
    })();
  </script>
</BaseLayout>
