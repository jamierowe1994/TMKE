            <button type="button" class="eb-mini-btn" data-item-del="${i}">Remove</button></div>`).join("");
          return colSel + rows + `<button type="button" class="eb-mini-btn" id="eb-pack-load">Add from packs</button> <button type="button" class="eb-mini-btn" data-item-add>+ Blank item</button>`;
        }
        case "services": {
          if(!Array.isArray(b.items)) b.items=[];
          const colSel = `<label class="eb-f"><span>Columns</span><select data-field="columns">${opts(["1","2","3","4"],String(b.columns||3))}</select></label>`;
          const rows = b.items.map((it,i)=>`<div style="border:1px solid var(--eb-line);border-radius:8px;padding:10px;margin-bottom:8px;"><strong style="font-size:12px;color:var(--english-violet);">Service ${i+1}</strong>
            <label class="eb-f"><span>Title</span><input type="text" data-item="${i}.title" value="${esc(it.title||"")}" /></label>
            <label class="eb-f"><span>Text</span><textarea data-item="${i}.text" rows="2">${esc(it.text||"")}</textarea></label>
