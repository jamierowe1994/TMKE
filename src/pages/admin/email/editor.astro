    $("#eb-brand").addEventListener("click", ()=>openModal("#eb-modal-brand"));

    const nameEl=$("#eb-name");
    nameEl.addEventListener("input", ()=>{ state.name=nameEl.value; $("#s-name").value=nameEl.value; markDirty(); });
    $("#s-name").addEventListener("input", (e)=>{ state.name=e.target.value; nameEl.value=e.target.value; markDirty(); });
    $("#s-preheader").addEventListener("input",(e)=>{ state.preheader=e.target.value; markDirty(); });
    $("#s-trigger").addEventListener("change",(e)=>{ state.trigger_key=e.target.value; markDirty(); });
    $("#s-status").addEventListener("change",(e)=>{ state.status=e.target.value; setStatusPill(); markDirty(); });
    function setStatusPill(){ const p=$("#eb-status-pill"); p.dataset.status=state.status; p.textContent=state.status.charAt(0).toUpperCase()+state.status.slice(1); }

    document.querySelectorAll("[data-brand]").forEach(el=>el.addEventListener(el.type==="checkbox"?"change":"input", ()=>{ state.branding[el.getAttribute("data-brand")] = el.type==="checkbox" ? el.checked : el.value; renderCanvas(); }));

    /* ─────────── preview modal ─────────── */
    $("#eb-preview").addEventListener("click", ()=>{
      const brand={...defaultBrand(),...state.branding};
      const {subject,html}=renderTemplate(state,{brand,mergeCtx:mergeContextFor(SAMPLE_RECIPIENT,brand)});
      $("#eb-pv-subject").textContent=subject||"—";
      // Swap in a FRESH iframe each time — re-setting srcdoc on an already-loaded
      // (and currently hidden) iframe renders blank on the 2nd+ open.
      const old=$("#eb-pv-frame");
      const f=document.createElement("iframe");
      f.id="eb-pv-frame"; f.className=old.className; f.title="Email preview"; f.setAttribute("sandbox","");
      f.srcdoc=html;
      old.replaceWith(f);
