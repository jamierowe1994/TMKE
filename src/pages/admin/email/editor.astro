      faq: '<circle cx="12" cy="12" r="10"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2.5-3 4"/><line x1="12" x2="12.01" y1="17" y2="17"/>',
      countdown: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2 2"/><path d="M5 3 2 6"/><path d="m22 6-3-3"/>',
      reviewlink: '<path d="M11.5 3.5 14 8.5l5.5.8-4 3.9.9 5.5-4.9-2.6L6.6 18.7l.9-5.5-4-3.9 5.5-.8z"/>',
      products: '<rect x="3" y="7" width="7" height="13" rx="1"/><rect x="14" y="7" width="7" height="13" rx="1"/><path d="M3 7l2-3h14l2 3"/>',
      services: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
      slider: '<rect x="3" y="6" width="18" height="12" rx="2"/><path d="M3 14l4-4 4 4 3-3 4 4"/><circle cx="8" cy="9" r="1"/>',
      form: '<rect x="4" y="3" width="16" height="18" rx="2"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><rect x="8" y="16" width="6" height="2" rx="1"/>',
      code: '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
    };
    const svg = (p) => `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" width="22" height="22">${p}</svg>`;
    const SOCIAL_SVG = {
      website:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a14 14 0 0 0 0 20 14 14 0 0 0 0-20"/></svg>',
      linkedin:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>',
      instagram:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5"/><circle cx="12" cy="12" r="4"/><line x1="17.5" x2="17.5" y1="6.5" y2="6.5"/></svg>',
      facebook:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>',
      twitter:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>',
      youtube:'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 17a24 24 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49 49 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24 24 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49 49 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>',
    };

    // Preset swatches. The TMKE Brand kit colours are prepended at boot (loadBrandKit).
    let SWATCHES = ["", "#ffffff", "#f4f2f1", "#f8fafc", "#fef9ef", "#eef2ff", "#ecfdf5", "#fdf2f8", "#371e28", "#1c1d22"];
    let brandKitLogo = "";
    let brandKitColors = [];   // the raw brand hexes — shown under every colour picker
    async function loadBrandKit() {
      if (!WORKER_URL) return;
      try {
        const { data: { session: s } } = await supabase.auth.getSession();
        if (!s || !s.access_token) return;
        const res = await fetch(`${WORKER_URL}/brand`, { headers: { Authorization: `Bearer ${s.access_token}` } });
        const j = await res.json().catch(() => ({}));
        const b = (j && j.brand) || {};
        if (Array.isArray(b.colors) && b.colors.length) {
          brandKitColors = b.colors.map((c) => String(c)).filter((c) => /^#[0-9a-f]{3,6}$/i.test(c));
          const brandHexes = brandKitColors.map((c) => c.toLowerCase());
          const rest = SWATCHES.filter((c) => c !== "" && !brandHexes.includes(c.toLowerCase()));
          SWATCHES = ["", ...brandHexes, ...rest];
        }
        if (b.logo_url) brandKitLogo = b.logo_url;
      } catch (_) {}
    }
    // Add a row of clickable brand-colour swatches under every colour picker in a
    // container (the native <input type=color> can't show presets itself).
    function injectBrandSwatches(wrap) {
      if (!brandKitColors.length || !wrap) return;
      wrap.querySelectorAll('input[type="color"]').forEach((inp) => {
        if (inp.dataset.bsw) return; inp.dataset.bsw = "1";
        const row = document.createElement("div"); row.className = "eb-bsw-row";
        row.innerHTML = brandKitColors.map((c) => `<button type="button" class="eb-bsw" data-c="${c}" style="background:${c}" title="${c}"></button>`).join("");
        (inp.closest(".eb-f") || inp.parentElement).appendChild(row);
        row.querySelectorAll(".eb-bsw").forEach((sw) => sw.addEventListener("click", () => { inp.value = sw.dataset.c; inp.dispatchEvent(new Event("input", { bubbles: true })); inp.dispatchEvent(new Event("change", { bubbles: true })); }));
      });
    }

    // ── State ──
    const params = new URLSearchParams(location.search);
    let id = params.get("id"); if (id === "new") id = null;
    let session = null, loaded = null, selectedId = null, dragId = null, paletteDragType = null;
    let canvasDevice = "desktop";   // which device layout the canvas is previewing

    const state = {
      name: "", subject: "", preheader: "", trigger_key: "", status: "draft",
      mode: "blocks", blocks: [], custom_html: "", branding: defaultBrand(),
    };

    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;" }[c]));
    const cvPad = (p) => (p && (p.t||p.r||p.b||p.l)) ? `padding:${+p.t||0}px ${+p.r||0}px ${+p.b||0}px ${+p.l||0}px;` : "";
    function toast(m){ const t=$("#eb-toast"); t.textContent=m; t.hidden=false; clearTimeout(toast._t); toast._t=setTimeout(()=>t.hidden=true,2600); }

    /* ─────────── canvas ─────────── */
    const blocksWrap = $("#eb-blocks");
    const emailEl = $("#eb-email");

    function canvasInner(b, brand) {
      const align = ["left","center","right"].includes(b.align) ? b.align : "center";
      switch (b.type) {
        case "heading":
          return `<h1 class="cv-edit" data-edit data-id="${b.id}" contenteditable="true" style="${headingInlineStyle(effectiveBlock(b, canvasDevice))}">${esc(b.text||"")}</h1>`;
        case "text": {
          // Rich content (b.html) — normalised so paragraph spacing + line
          // height match the sent email; plain text keeps whitespace.
          const content = (b.html != null && b.html !== "") ? normalizeRichHtml(b.html, resolveParaGap(b)) : esc(b.text||"");
          const wsp = (b.html != null && b.html !== "") ? "" : "white-space:pre-wrap;";
          return `<div class="cv-edit" data-edit data-rich data-id="${b.id}" contenteditable="true" style="${textInlineStyle(effectiveBlock(b, canvasDevice))}${wsp}">${content}</div>`;
        }
        case "image": {
          const eb = effectiveBlock(b, canvasDevice);
          const al = ["left","center","right"].includes(eb.align)?eb.align:"center";
          return b.url
            ? `<div style="text-align:${al};${cvPad(resolvePad(eb))}"><img src="${esc(b.url)}" alt="${esc(b.alt||"")}" style="${imageInlineStyle(eb)}" /></div>`
            : `<div class="cv-ph">Click, then add an image URL or upload one in the panel →</div>`;
        }
        case "button": {
          const eb = effectiveBlock(b, canvasDevice);
          const al = ["left","center","right"].includes(eb.align)?eb.align:"center";
          // Edit the button label right on the canvas.
          return `<div style="text-align:${al};"><span class="cv-edit" data-edit data-id="${b.id}" contenteditable="true" style="${buttonInlineStyle(eb, brand)}">${esc(eb.text||"Button")}</span></div>`;
        }
        case "divider": {
          const eb = effectiveBlock(b, canvasDevice);
          const al = ["left","center","right"].includes(eb.align)?eb.align:"center";
          const thick = Number(eb.thickness)||1;
          const w = (eb.width!=null&&eb.width!=="")?Math.max(1,Math.min(100,Number(eb.width))):100;
          return `<div style="text-align:${al};${cvPad(resolvePad(eb))}"><div style="display:inline-block;width:${w}%;border-top:${thick}px solid ${esc(eb.color||"#E2E8F0")};line-height:0;font-size:0;">&nbsp;</div></div>`;
        }
        case "columns": {
          const layout = COLUMN_LAYOUTS.find(l=>l.key===b.layout) || COLUMN_LAYOUTS[1];
          const cols = Array.isArray(b.cols)?b.cols:[];
          const colBg = Array.isArray(b.colBg)?b.colBg:[];
          const colBgImage = Array.isArray(b.colBgImage)?b.colBgImage:[];
          const radius = b.colRadius!=null && b.colRadius!=="" ? Math.max(0,Number(b.colRadius)) : 6;
          const colsHtml = layout.w.map((w,i)=>{
            const children = Array.isArray(cols[i])?cols[i]:[];
            const inner = children.length ? children.map(blockCard).join("") : `<div class="cv-col-empty">Drop a block here</div>`;
            const hasBg = colBg[i] || colBgImage[i];
            const bg = hasBg ? `${colBg[i]?`background-color:${esc(colBg[i])};`:""}${colBgImage[i]?`background-image:url('${esc(colBgImage[i])}');background-size:cover;background-position:center center;background-repeat:no-repeat;`:""}border-radius:${radius}px;border-style:solid;border-color:transparent;` : `border-radius:${radius}px;`;
            return `<div class="cv-col" data-colof="${b.id}" data-coli="${i}" style="flex:0 0 calc(${w}% - 6px);max-width:${w}%;${bg}">${inner}</div>`;
          }).join("");
          return `<div class="cv-cols">${colsHtml}</div>`;
        }
        case "spacer":
          return `<div class="cv-spacer" style="height:${Math.max(4,Math.min(160,Number(b.height)||24))}px;">Spacer · ${Math.max(4,Math.min(160,Number(b.height)||24))}px</div>`;
        case "logo":
          return brand.logo
            ? `<div style="text-align:${align};"><img src="${esc(brand.logo)}" alt="logo" style="height:42px;width:auto;display:inline-block;" /></div>`
            : `<div class="cv-ph" style="min-height:60px;">Logo — set a logo URL in Brand</div>`;
        case "social": {
          const show=b.show||{}; const nets=["website","linkedin","instagram","facebook","twitter","youtube"];
          const bare = b.iconStyle==="bare";
          const accent = brand.accentColor || "#371e28";
          const iconColor = b.iconColor || (bare ? accent : "#ffffff");
          const chipBg = b.iconBg || accent;
          let size = Number(b.iconSize); if(!isFinite(size)||size<=0) size = bare?24:34; size=Math.max(14,Math.min(72,size));
          const glyph = bare ? size : Math.max(10, Math.round(size*0.46));
          const items=nets.filter(n=>show[n]!==false).map(n=>{
            const svg=(SOCIAL_SVG[n]||"").replace("<svg ",`<svg style="width:${glyph}px;height:${glyph}px" `);
            const box = bare
              ? `width:auto;height:auto;border-radius:0;background:none;color:${esc(iconColor)};`
              : `width:${size}px;height:${size}px;border-radius:${Math.round(size/2)}px;background:${esc(chipBg)};color:${esc(iconColor)};`;
            return `<span style="${box}">${svg}</span>`;
          }).join("");
          const fill = b.bg ? `background:${esc(b.bg)};padding:16px;border-radius:8px;` : "";
          const justify = align==="left"?"flex-start":align==="right"?"flex-end":"center";
          return `<div class="cv-social" style="justify-content:${justify};${fill}">${items||'<span style="background:#ccc;"></span>'}</div>`;
        }
        case "video":
          return b.thumbnail
            ? `<div style="text-align:${align};"><div style="position:relative;display:inline-block;"><img src="${esc(b.thumbnail)}" style="max-width:100%;border-radius:10px;" /><span style="position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:56px;height:56px;border-radius:28px;background:rgba(220,38,38,0.95);color:#fff;display:flex;align-items:center;justify-content:center;font-size:22px;">▶</span></div></div>`
            : `<div class="cv-ph">Video — add a thumbnail URL in the panel →</div>`;
        // footer / faq / countdown / reviewlink / code — not inline-editable, so
        // render the real email HTML from the shared lib for an accurate preview.
        default: {
          const html = renderBlock(b, brand, mergeContextFor(SAMPLE_RECIPIENT, brand));
          return html || `<div class="cv-ph">Set this block up in the panel →</div>`;
        }
      }
    }

    // One block's editor card (toolbar + visibility badge + rendered content).
    // Reused at the top level AND inside columns, so children are fully editable.
    function blockCard(b){
      const brand = { ...defaultBrand(), ...state.branding };
      const hide = b.hide || {};
      const badge = (hide.mobile && hide.desktop) ? "Hidden" : hide.desktop ? "Mobile only" : hide.mobile ? "Desktop only" : "";
      const hiddenHere = (hide.mobile && hide.desktop)
        || (canvasDevice === "mobile" && hide.mobile)
        || (canvasDevice === "desktop" && hide.desktop);
      return `
        <div class="cv-block${b.id===selectedId?" is-selected":""}${badge?" has-vis":""}${hiddenHere?" cv-hidden-here":""}" data-id="${b.id}">
          ${badge?`<span class="cv-vis-badge">${badge}</span>`:""}
          <div class="cv-toolbar">
            <button type="button" class="cv-tb cv-grip" draggable="true" data-grip="${b.id}" title="Drag to reorder">⠿</button>
            <button type="button" class="cv-tb" data-dupe="${b.id}" title="Duplicate">⧉</button>
            <button type="button" class="cv-tb danger" data-del="${b.id}" title="Delete">✕</button>
          </div>
          <div class="cv-inner" style="${cvPad(resolveMargin(b))}">${canvasInner(b, brand)}</div>
        </div>`;
    }
    function renderCanvas() {
      emailEl.style.background = state.branding.cardColor || "#ffffff";
      const cp = state.branding.contentPad;
      emailEl.style.padding = (cp === 0 || (cp != null && cp !== "")) ? Number(cp) + "px" : "";
      $("#eb-canvas-pane").style.background = state.branding.bgColor || "#f1f0ef";
      $("#eb-canvas-empty").hidden = state.blocks.length > 0;
      blocksWrap.innerHTML = state.blocks.map(blockCard).join("");
      wireCanvas();
      markDirty();
    }

    function colArray(colEl){
      const cb = findBlock(colEl.dataset.colof); const i = Number(colEl.dataset.coli);
      if (!cb || !Array.isArray(cb.cols)) return null;
      if (!Array.isArray(cb.cols[i])) cb.cols[i] = [];
      return cb.cols[i];
    }
    function wireCanvas() {
      blocksWrap.querySelectorAll(".cv-block").forEach((el) => {
        const bid = el.dataset.id;
        // stopPropagation → clicking a child inside a column selects the child,
        // not the parent columns block.
        el.addEventListener("mousedown", (e) => { if (e.target.closest(".cv-tb")) return; e.stopPropagation(); select(bid); });
        // inline editing — only this block's own editables (not nested children's)
        el.querySelectorAll("[data-edit]").forEach((ed) => {
          if (ed.closest(".cv-block") !== el) return;
          ed.addEventListener("focus", () => { lastEditable = ed; select(bid); });
          ed.addEventListener("input", () => {
            const blk = findBlock(bid);
            if (!blk) return;
            if (ed.hasAttribute("data-rich")) { blk.html = ed.innerHTML; blk.text = ed.innerText; }
            else blk.text = ed.innerText;
            markDirty();
          });
        });
        // toolbar
        el.querySelector("[data-dupe]")?.addEventListener("click", (e) => { e.stopPropagation(); dupe(bid); });
        el.querySelector("[data-del]")?.addEventListener("click", (e) => { e.stopPropagation(); del(bid); });
        // drag reorder — works across containers via findLoc
        const grip = el.querySelector("[data-grip]");
        grip?.addEventListener("dragstart", (e) => { e.stopPropagation(); dragId = bid; e.dataTransfer.effectAllowed = "move"; });
        el.addEventListener("dragover", (e) => {
          if ((!dragId && !paletteDragType) || dragId === bid) return;
          e.preventDefault(); e.stopPropagation();
          const r = el.getBoundingClientRect(); const after = e.clientY > r.top + r.height/2;
          el.classList.toggle("cv-drop-after", after); el.classList.toggle("cv-drop-before", !after);
        });
        el.addEventListener("dragleave", () => el.classList.remove("cv-drop-after","cv-drop-before"));
        el.addEventListener("drop", (e) => {
          e.preventDefault(); e.stopPropagation(); el.classList.remove("cv-drop-after","cv-drop-before");
          const r = el.getBoundingClientRect(); const after = e.clientY > r.top + r.height/2;
          const tLoc = findLoc(bid); if (!tLoc) return;
          if (paletteDragType) {
            // No columns-inside-columns.
            if (paletteDragType === "columns" && tLoc.list !== state.blocks) { paletteDragType = null; return; }
            const nb = makeBlock(paletteDragType); paletteDragType = null;
            tLoc.list.splice(tLoc.index + (after?1:0), 0, nb); renderCanvas(); select(nb.id); return;
          }
          if (!dragId || dragId === bid) return;
          const sLoc = findLoc(dragId); if (!sLoc) return;
          if (sLoc.block.type === "columns" && tLoc.list !== state.blocks) { dragId=null; return; }  // don't nest a columns block
          const moved = sLoc.list.splice(sLoc.index, 1)[0];
          const t2 = findLoc(bid);
          if (!t2) { sLoc.list.splice(sLoc.index, 0, moved); dragId=null; renderCanvas(); return; }
          t2.list.splice(t2.index + (after?1:0), 0, moved);
          dragId = null; renderCanvas();
        });
      });
      // Column drop zones (drop onto a column's empty area / gaps)
      blocksWrap.querySelectorAll(".cv-col").forEach((col) => {
        // Only bail when the pointer is over a CHILD card inside THIS column — the
        // column itself lives inside the columns .cv-block, so a plain closest()
        // check would always match the parent.
        const onChild = (e) => { const hb = e.target.closest(".cv-block"); return hb && col.contains(hb); };
        col.addEventListener("dragover", (e) => {
          if (!dragId && !paletteDragType) return;
          if (onChild(e)) return;   // a child card handles it
          e.preventDefault(); e.stopPropagation(); col.classList.add("cv-col-drop");
        });
        col.addEventListener("dragleave", () => col.classList.remove("cv-col-drop"));
        col.addEventListener("drop", (e) => {
          col.classList.remove("cv-col-drop");
          if (onChild(e)) return;
          e.preventDefault(); e.stopPropagation();
          const arr = colArray(col); if (!arr) return;
          if (paletteDragType) {
            if (paletteDragType === "columns") { paletteDragType = null; return; }
            const nb = makeBlock(paletteDragType); paletteDragType = null;
            arr.push(nb); renderCanvas(); select(nb.id); return;
          }
          if (dragId) {
            const sLoc = findLoc(dragId); if (!sLoc || sLoc.block.type === "columns") { dragId=null; return; }
            const moved = sLoc.list.splice(sLoc.index, 1)[0];
            arr.push(moved); dragId = null; renderCanvas();
          }
        });
      });
    }

    // Find a block ANYWHERE — top level or inside a columns block — returning its
    // containing array + index so edits/moves work uniformly across containers.
    function findLoc(id){
      let i = state.blocks.findIndex(b=>b.id===id);
      if (i>=0) return { list: state.blocks, index: i, block: state.blocks[i] };
      for (const b of state.blocks){
        if (b.type==="columns" && Array.isArray(b.cols)){
          for (const col of b.cols){
            const j = (col||[]).findIndex(c=>c && c.id===id);
            if (j>=0) return { list: col, index: j, block: col[j] };
          }
        }
      }
      return null;
    }
    function findBlock(id){ const l=findLoc(id); return l?l.block:null; }
    const newId = ()=> "b_"+Math.random().toString(36).slice(2,10);
    function reId(b){ b.id=newId(); if(b.type==="columns"&&Array.isArray(b.cols)) b.cols.forEach(col=>(col||[]).forEach(reId)); return b; }
    // Convert any old fixed-cell columns (b.cells) into the new child-block model.
    function migrateColumns(blocks){
      (blocks||[]).forEach(b=>{
        if (b && b.type==="columns" && Array.isArray(b.cells) && !Array.isArray(b.cols)){
          b.cols = b.cells.map(c=>{
            const arr=[];
            if(c && c.image) arr.push({type:"image",id:newId(),url:c.image,align:"center"});
            if(c && c.title) arr.push({type:"heading",id:newId(),text:c.title,align:"left",size:20});
            if(c && c.text) arr.push({type:"text",id:newId(),text:c.text});
            if(c && c.btnText) arr.push({type:"button",id:newId(),text:c.btnText,url:c.btnUrl||"#"});
            return arr;
          });
          delete b.cells;
        }
      });
    }

    function select(bid) {
      selectedId = bid;
      blocksWrap.querySelectorAll(".cv-block").forEach((el)=>el.classList.toggle("is-selected", el.dataset.id===bid));
      openInspector(bid);
    }
    function deselect() {
      selectedId = null;
      blocksWrap.querySelectorAll(".cv-block").forEach((el)=>el.classList.remove("is-selected"));
      $("#eb-rail-inspector").hidden = true; $("#eb-rail-blocks").hidden = false;
    }
    function dupe(bid){ const loc=findLoc(bid); if(!loc)return; const c=reId(JSON.parse(JSON.stringify(loc.block))); loc.list.splice(loc.index+1,0,c); renderCanvas(); select(c.id); }
    function del(bid){ const loc=findLoc(bid); if(loc) loc.list.splice(loc.index,1); if(selectedId===bid) deselect(); renderCanvas(); }
    function addBlock(type){ const b=makeBlock(type); const loc=findLoc(selectedId); if(loc) loc.list.splice(loc.index+1,0,b); else state.blocks.push(b); renderCanvas(); select(b.id); }

    /* ─────────── inspector ─────────── */
    const ALIGN = ["left","center","right","justify"];
    const opts = (a,c)=>a.map(o=>`<option value="${o}"${o===c?" selected":""}>${o}</option>`).join("");

    // ── Shared typography controls (heading + text) ──
    const fontOpts = (cur)=>FONT_STACKS.map(f=>`<option value="${f.key}"${f.key===(cur||"arial")?" selected":""}>${esc(f.label)}</option>`).join("");
    const validHex = (v,fb)=>/^#[0-9a-f]{6}$/i.test(v||"")?v:fb;
    function deviceToggleMini(device){
      return `<div class="eb-dev-toggle eb-resp-dev">
        <button type="button" class="eb-dev${device!=="mobile"?" is-active":""}" data-respdev="desktop" title="Edit desktop values">🖥</button>
        <button type="button" class="eb-dev${device==="mobile"?" is-active":""}" data-respdev="mobile" title="Edit mobile values">📱</button>
      </div>`;
    }
    // ── Device-aware field builders (mobile writes to b.mobile.*; blank inherits) ──
    function dField(b, device, key, label, attrs, dflt){
      const isM = device==="mobile";
      const path = isM ? `mobile.${key}` : key;
      const val = isM ? ((b.mobile&&b.mobile[key]!=null)?b.mobile[key]:"") : (b[key]!=null?b[key]:"");
      const ph = isM ? ((b[key]!=null&&b[key]!=="")?b[key]:dflt) : dflt;
      return `<label class="eb-f"><span>${label}</span><input ${attrs} data-field="${path}" value="${val}" placeholder="${ph}"/></label>`;
    }
    function dAlign(b, device){
      const isM = device==="mobile";
      const cur = isM ? ((b.mobile&&b.mobile.align)||"") : (b.align||"center");
      const path = isM ? "mobile.align" : "align";
      const o = `${isM?`<option value=""${cur===""?" selected":""}>Inherit</option>`:""}${ALIGN.map(x=>`<option value="${x}"${x===cur?" selected":""}>${x}</option>`).join("")}`;
      return `<label class="eb-f"><span>Align</span><select data-field="${path}">${o}</select></label>`;
    }
    // Padding = INSIDE spacing (per-device). Placeholders show the block's
    // current default so you can see where it sits before adjusting.
    function dPad(b, device){
      const isM = device==="mobile";
      const dflt = spacingDefaults(b.type).pad;
      const pad = isM ? ((b.mobile&&b.mobile.pad)||{}) : (b.pad||{});
      const cell = (k,l)=>`<label class="eb-pad-cell"><span>${l}</span><input type="number" min="0" max="120" data-field="${isM?`mobile.pad.${k}`:`pad.${k}`}" value="${pad[k]!=null?pad[k]:""}" placeholder="${dflt[k]!=null?dflt[k]:0}"/></label>`;
      return `<div class="eb-pad"><span class="eb-f-sub">Padding · inside</span><div class="eb-pad-row">${cell("t","T")}${cell("r","R")}${cell("b","B")}${cell("l","L")}</div></div>`;
    }
    // Margin = OUTSIDE spacing (global). Placeholder shows the default gap.
    function marginFields(b){
      const dflt = spacingDefaults(b.type).margin;
      const mar = b.margin||{};
      const cell = (k,l)=>`<label class="eb-pad-cell"><span>${l}</span><input type="number" min="0" max="120" data-field="margin.${k}" value="${mar[k]!=null?mar[k]:""}" placeholder="${dflt[k]!=null?dflt[k]:0}"/></label>`;
      return `<div class="eb-pad"><span class="eb-f-sub">Margin · outside</span><div class="eb-pad-row">${cell("t","T")}${cell("r","R")}${cell("b","B")}${cell("l","L")}</div></div>`;
    }
    // Padding + margin ALWAYS travel together (padding inside, margin outside),
    // formatted identically on every block that has spacing.
    function spacingGrids(b, device){ return `${dPad(b, device)}${marginFields(b)}`; }
    // Standalone spacing box for blocks with no other per-device controls (e.g.
    // columns) so their spacing looks the same as everywhere else.
    function spacingBox(b, device){
      return `<div class="eb-resp"><div class="eb-resp-head"><span class="eb-f-sub">Spacing</span>${deviceToggleMini(device)}</div>${spacingGrids(b, device)}</div>`;
    }
    function respWrap(device, inner){
      return `<div class="eb-resp"><div class="eb-resp-head"><span class="eb-f-sub">Size &amp; spacing</span>${deviceToggleMini(device)}</div>${inner}
        <p class="eb-note">${device==="mobile"?"Size &amp; padding are per-device (blank = inherit desktop). Margin is the same on all devices.":"Size &amp; padding are per-device (tap 📱 for mobile). Margin is the same on all devices."}</p></div>`;
    }
    function buttonRespFields(b, device){
      return respWrap(device, `<div class="eb-f2">${dField(b,device,"size","Text size (px)",'type="number" min="8" max="40"',14)}${dField(b,device,"letterSpacing","Letter spacing",'type="number" min="-3" max="14" step="0.5"',0)}</div>${dAlign(b,device)}${spacingGrids(b,device)}`);
    }
    function imageRespFields(b, device){
      return respWrap(device, `<div class="eb-f2">${dField(b,device,"width","Width (px)",'type="number" min="20" max="1200"',"auto")}${dField(b,device,"height","Height (px)",'type="number" min="10" max="1200"',"auto")}</div>${dAlign(b,device)}${spacingGrids(b,device)}`);
    }
    function dividerRespFields(b, device){
      return respWrap(device, `${dAlign(b,device)}${spacingGrids(b,device)}`);
    }

    // Inline rich-text toolbar for the text block (execCommand — email-safe tags)
    // + one-click merge-field inserter (pulls from contact data at send time).
    // Every merge field (kept in sync with the shared MERGE_FIELDS list) so new
    // ones — e.g. the videography funnel's Booking link — show up automatically.
    const FIELD_CHIPS = MERGE_FIELDS.map((f) => ({ token: `{{${f.token}}}`, label: f.label }));
    // Format buttons only (bold/italic/underline/list/clear) — lives inside the Font card.
    function formatButtons(){
      return `<div class="eb-fmt" style="margin-bottom:0;"><span class="eb-f-sub">Format</span>
        <div class="eb-fmt-btns">
          <button type="button" class="eb-fmt-btn" data-fmt="bold" title="Bold"><b>B</b></button>
          <button type="button" class="eb-fmt-btn" data-fmt="italic" title="Italic"><i>I</i></button>
          <button type="button" class="eb-fmt-btn" data-fmt="underline" title="Underline"><u>U</u></button>
          <button type="button" class="eb-fmt-btn" data-fmt="insertUnorderedList" title="Bullet list">&bull; List</button>
          <button type="button" class="eb-fmt-btn" data-fmt="removeFormat" title="Clear formatting">&#10005;</button>
        </div></div>`;
    }
    // Insert-field chips — its own section (not grey).
    function insertFieldSection(){
      return `<div class="eb-sec"><span class="eb-f-sub">Insert field</span>
        <div class="eb-fmt-btns">${FIELD_CHIPS.map(f=>`<button type="button" class="eb-field-chip" data-token="${f.token}">${f.label}</button>`).join("")}</div>
        <p class="eb-note" style="margin-top:6px;">Click into the text, place your cursor, then insert. Fields fill from each contact on send.</p></div>`;
    }
    // Grey "Font" card — font, size, line height, letter spacing, alignment,
    // format, colour (size/lh/ls/align are per-device). Text + heading.
    function fontCard(b, device){
      const isM = device==="mobile";
      const dSize = b.type==="heading"?28:15, dLh = b.type==="heading"?"1.15":"1.6", dCol = b.type==="heading"?"#1c1d22":"#1f2937";
      const P=(k)=>isM?`mobile.${k}`:k;
      const V=(k)=>isM?((b.mobile&&b.mobile[k]!=null)?b.mobile[k]:""):(b[k]!=null?b[k]:"");
      // Desktop shows the effective value (the block's own, else the default) so the
      // field reflects the real size instead of a greyed placeholder. Mobile keeps
      // blank = "inherit desktop".
      const VE=(k,d)=>isM?V(k):((b[k]!=null&&b[k]!=="")?b[k]:d);
      const PH=(k,d)=>isM?((b[k]!=null&&b[k]!=="")?b[k]:d):d;
      const alignCur = isM?((b.mobile&&b.mobile.align)||""):(b.align||"left");
      const alignOpts = `${isM?`<option value=""${alignCur===""?" selected":""}>Inherit</option>`:""}${ALIGN.map(o=>`<option value="${o}"${o===alignCur?" selected":""}>${o}</option>`).join("")}`;
      const format = b.type==="heading"
        ? `<div class="eb-fmt" style="margin-bottom:0;"><span class="eb-f-sub">Format</span><div class="eb-checks" style="margin-bottom:0;">
             <label class="eb-check"><input type="checkbox" data-field="bold"${b.bold!==false?" checked":""}/> Bold</label>
             <label class="eb-check"><input type="checkbox" data-field="italic"${b.italic?" checked":""}/> Italic</label>
             <label class="eb-check"><input type="checkbox" data-field="underline"${b.underline?" checked":""}/> Underline</label></div></div>`
        : formatButtons();
      return `<div class="eb-resp"><div class="eb-resp-head"><span class="eb-f-sub">Font</span>${deviceToggleMini(device)}</div>
        <label class="eb-f"><span>Font</span><select data-field="font">${fontOpts(b.font)}</select></label>
        <div class="eb-f2">
          <label class="eb-f"><span>Size (px)</span><input type="number" min="8" max="90" data-field="${P("size")}" value="${VE("size",dSize)}" placeholder="${PH("size",dSize)}" /></label>
          <label class="eb-f"><span>Line height</span><input type="number" min="0.8" max="3" step="0.05" data-field="${P("lineHeight")}" value="${VE("lineHeight",dLh)}" placeholder="${PH("lineHeight",dLh)}" /></label>
        </div>
        <div class="eb-f2">
          <label class="eb-f"><span>Letter spacing</span><input type="number" min="-3" max="14" step="0.5" data-field="${P("letterSpacing")}" value="${VE("letterSpacing","0")}" placeholder="${PH("letterSpacing","0")}" /></label>
          <label class="eb-f"><span>Alignment</span><select data-field="${P("align")}">${alignOpts}</select></label>
        </div>
        ${format}
        <label class="eb-f" style="margin:12px 0 0;"><span>Colour</span><input type="color" data-field="color" value="${validHex(b.color,dCol)}" /></label>
        <p class="eb-note" style="margin-top:8px;"><strong>Tip:</strong> highlight text on the canvas first to change just that part (font, size, letter spacing &amp; colour) — otherwise it changes the whole block. Size, line height, letter spacing &amp; alignment are per-device (tap 📱).</p>
      </div>`;
    }
    function inspectorFields(b, device) {
      const align = `<label class="eb-f"><span>Align</span><select data-field="align">${opts(ALIGN,b.align||"center")}</select></label>`;
      switch (b.type) {
        case "heading": return `<p class="eb-note" style="margin-bottom:12px;">Edit the text right on the canvas.</p>
          ${fontCard(b, device)}
          ${spacingBox(b, device)}`;
        case "text": return `<p class="eb-note" style="margin-bottom:10px;">Edit the text right on the canvas. Press Enter for a new paragraph; the gap between paragraphs is set below.</p>
          ${fontCard(b, device)}
          <label class="eb-f"><span>Space between paragraphs (px)</span><input type="number" min="0" max="80" data-field="paraSpacing" value="${b.paraSpacing!=null?b.paraSpacing:""}" placeholder="12" /></label>
          ${insertFieldSection()}
          <div class="eb-sec"><span class="eb-f-sub">Background</span>
            <label class="eb-f"><span>Tint (hex, blank = none)</span><input type="text" data-field="bg" value="${esc(b.bg||"")}" placeholder="#f4f2f1" /></label>
            <label class="eb-f" style="margin-bottom:6px;"><span>Background image URL (blank = none)</span><input type="url" data-field="bgImage" value="${esc(b.bgImage||"")}" placeholder="https://…/image.jpg" /></label>
            ${uploadControl("textbg")}</div>
          ${spacingBox(b, device)}`;
        case "image": return `
          <label class="eb-f"><span>Image URL</span><input type="url" data-field="url" value="${esc(b.url||"")}" placeholder="https://…/image.jpg" /></label>
          ${uploadControl("image")}
          <label class="eb-f"><span>Alt text</span><input type="text" data-field="alt" value="${esc(b.alt||"")}" /></label>
          <label class="eb-f"><span>Link URL (optional)</span><input type="url" data-field="linkUrl" value="${esc(b.linkUrl||"")}" /></label>
