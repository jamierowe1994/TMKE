---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
import { STUDIO_SIZES } from "../../data/studio-sizes.js";

const SOCIAL = STUDIO_SIZES.find((g) => g.family === "social")?.sizes ?? [];
---

<AdminShell active="studio" title="Check the sizes" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title" id="sz-title">Check the sizes</div>
          <div class="page-header-sub">Every size a member can resize this to, laid out by the same code their Studio runs. What you see here is what they get.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="ash-panel ash-page">
    <section class="admin-bar">
      <div class="admin-bar-top">
        <span class="admin-bar-count" id="sz-count">…</span>
        <div class="admin-bar-tools">
          <button type="button" class="enquiry-chip is-on" data-fit="side">Side by side</button>
          <button type="button" class="enquiry-chip" data-fit="big">One at a time</button>
        </div>
      </div>
      <div class="admin-bar-actions">
        <a class="admin-btn admin-btn-ghost" id="sz-back" href="/admin/templates">Back</a>
        <a class="admin-btn admin-btn-primary" id="sz-edit" href="/admin/templates">Edit the design</a>
      </div>
    </section>

    <p id="sz-loading" class="sz-note">Loading…</p>
    <div id="sz-grid" class="sz-grid"></div>
  </div>

  <script id="sz-sizes" type="application/json" set:html={JSON.stringify(SOCIAL)}></script>

  <style is:global>
    .admin-bar { display: flex; flex-direction: column; gap: 14px; margin-bottom: 26px; }
    .admin-bar-top { display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
    .admin-bar-tools { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .admin-bar-actions { display: flex; gap: 10px; flex-wrap: wrap; }
    .admin-bar-count { font-family: var(--sans); font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .enquiry-chip {
      font-family: var(--sans); font-size: 12px; font-weight: 600;
      padding: 7px 14px; border-radius: 999px; cursor: pointer;
      background: transparent; color: rgba(28,29,34,0.62);
      border: 1px solid rgba(28,29,34,0.18);
      transition: background 0.18s, color 0.18s, border-color 0.18s;
    }
    .enquiry-chip:hover { color: var(--ink); border-color: rgba(28,29,34,0.4); }
    .enquiry-chip.is-on { background: var(--english-violet); border-color: var(--english-violet); color: var(--paper); }

    .sz-note { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.55); }

    .sz-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; align-items: start; }
    .sz-grid.is-big { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px; }
    @media (max-width: 1100px) { .sz-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
    @media (max-width: 680px) { .sz-grid, .sz-grid.is-big { grid-template-columns: 1fr; } }

    .sz-card { display: flex; flex-direction: column; gap: 10px; }
    .sz-head { display: flex; align-items: baseline; justify-content: space-between; gap: 8px; }
    .sz-name { font-family: var(--sans); font-size: 12.5px; font-weight: 700; color: var(--ink); }
    .sz-dims { font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.45); }
    .sz-stage {
      position: relative; width: 100%; container-type: size;
      background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 4px;
      overflow: hidden; box-shadow: 0 8px 24px -16px rgba(16,14,22,0.5);
    }
    .sz-stage.is-source { border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.12); }
    .sz-badge {
      position: absolute; top: 8px; left: 8px; z-index: 3;
      font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase;
      padding: 3px 8px; border-radius: 999px; background: var(--english-violet); color: var(--paper);
    }
    .sz-flags { display: flex; flex-direction: column; gap: 5px; }
    .sz-flag {
      font-family: var(--sans); font-size: 11.5px; line-height: 1.5;
      padding: 7px 9px; border-radius: 6px;
      background: rgba(138,122,54,0.13); color: #6f6120;
    }
    .sz-flag.is-bad { background: rgba(163,55,43,0.12); color: #8c2f24; }
    .sz-ok { font-family: var(--sans); font-size: 11.5px; color: rgba(46,107,74,0.95); }
  </style>

  <script>
    import { requireAdmin } from '../../lib/admin-gate.js';
    import { supabase } from '../../lib/supabase.js';
    import { escapeHtml, renderEl, fontStack, blockBoxOf } from '../../lib/design-preview.js';

    const SIZES = JSON.parse(document.getElementById('sz-sizes')?.textContent || '[]');
    const els = {
      grid: document.getElementById('sz-grid'),
      loading: document.getElementById('sz-loading'),
      count: document.getElementById('sz-count'),
      title: document.getElementById('sz-title'),
      back: document.getElementById('sz-back'),
      edit: document.getElementById('sz-edit'),
    };
    const id = new URLSearchParams(location.search).get('id');

    /* Text measurement, the one thing the engine can't do for itself. Same
       canvas trick the Studio uses: set the font, measure, wrap. */
    const _ctx = document.createElement('canvas').getContext('2d');
    function textLineCount(el, size) {
      _ctx.font = (el.italic ? 'italic ' : '') + (el.weight || 400) + ' ' + size + 'px ' + fontStack(el.font);
      try { _ctx.letterSpacing = (Number(el.letterSpacing) || 0) + 'px'; } catch (_) {}
      const width = Math.max(1, el.w || 1);
      let lines = 0;
      String(el.text || '').split('\n').forEach((para) => {
        let line = '';
        let n = 1;
        para.split(' ').forEach((word) => {
          const test = line ? line + ' ' + word : word;
          if (_ctx.measureText(test).width > width && line) { n++; line = word; }
          else line = test;
        });
        lines += n;
      });
      return Math.max(1, lines);
    }

    const clone = (o) => JSON.parse(JSON.stringify(o));

    /* What's worth flagging: type that has shrunk far enough to stop being
       readable, and anything that has ended up off the canvas. Both are
       things you can only see by looking, which is the point of this page. */
    function flagsFor(before, after, W, H) {
      const out = [];
      const smallest = after.elements
        .filter((el) => el.type === 'text' && el.text)
        .reduce((m, el) => Math.min(m, Number(el.size) || 999), 999);
      if (smallest < 999 && smallest < 18) {
        out.push({ bad: smallest < 13, text: `Smallest words are ${Math.round(smallest)}px — ${smallest < 13 ? 'too small to read on a phone' : 'getting tight on a phone'}.` });
      }
      const off = after.elements.filter((el) => (
        el.x < -2 || el.y < -2 || el.x + el.w > W + 2 || el.y + el.h > H + 2
      ));
      if (off.length) out.push({ bad: true, text: `${off.length} element${off.length === 1 ? '' : 's'} ${off.length === 1 ? 'sits' : 'sit'} over the edge of the canvas.` });

      // Words that now take more lines than they did are the classic ugly
      // resize: a headline that was one line and is now three.
      let wrapped = 0;
      before.elements.forEach((b) => {
        if (b.type !== 'text' || !b.text) return;
        const a = after.elements.find((x) => x.id === b.id);
        if (!a) return;
        if (textLineCount(a, a.size || 16) > textLineCount(b, b.size || 16)) wrapped++;
      });
      if (wrapped) out.push({ bad: false, text: `${wrapped} piece${wrapped === 1 ? '' : 's'} of text now ${wrapped === 1 ? 'takes' : 'take'} more lines than in the original.` });
      return out;
    }

    function renderStage(page, W, H, label, isSource) {
      const cv = page.canvas || {};
      const bg = cv.backgroundImage
        ? `<img src="${escapeHtml(cv.backgroundImage)}" alt="" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:${cv.backgroundOpacity ?? 1};" />`
        : '';
      return `<div class="sz-stage${isSource ? ' is-source' : ''}" style="aspect-ratio:${W}/${H};background:${escapeHtml(cv.background || '#f4f2f1')}">
        ${isSource ? '<span class="sz-badge">As drawn</span>' : ''}
        ${bg}${(page.elements || []).map((el) => renderEl(el, W, H)).join('')}
      </div>`;
    }

    async function run() {
      if (!id) { els.loading.textContent = 'No design chosen.'; return; }
      const { data, error } = await supabase
        .from('templates')
        .select('id, name, canvas, elements, kind, block_variant, block_box')
        .eq('id', id)
        .maybeSingle();
      els.loading.hidden = true;
      if (error || !data) { els.loading.hidden = false; els.loading.textContent = 'Could not load that design.'; return; }

      els.title.textContent = data.name || 'Check the sizes';
      const home = data.kind === 'block' ? '/admin/blocks' : '/admin/templates';
      els.back.href = home;
      els.edit.href = `/account/editor?id=${encodeURIComponent(data.id)}&mode=admin`;

      // Loaded at runtime from /public, not bundled: this is the very file the
      // member's Studio runs, so the check can't drift from the real thing.
      // Built from parts so the bundler leaves the path alone.
      const engineUrl = '/scripts/' + 'resize-engine.js';
      const engine = (await import(/* @vite-ignore */ engineUrl))
        .createResizeEngine({ textLineCount });

      const W0 = Number(data.canvas?.width) || 1080;
      const H0 = Number(data.canvas?.height) || 1440;
      const source = { canvas: clone(data.canvas || {}), elements: clone(data.elements || []) };

      // A block is drawn against its own box, so it is checked against the
      // sizes it will be dropped onto rather than the canvas it was drawn on.
      const isBlock = data.kind === 'block';
      const box = isBlock ? (data.block_box || blockBoxOf(data)) : null;

      els.count.textContent = isBlock
        ? `Contact block · drawn at ${box ? box.w + ' × ' + box.h : '—'}`
        : `Drawn at ${W0} × ${H0}`;

      const cards = SIZES.map((sz) => {
        const isSource = sz.w === W0 && sz.h === H0;
        const page = { canvas: clone(source.canvas), elements: clone(source.elements) };
        if (!isSource) {
          try { engine.resizePage(page, sz.w, sz.h); }
          catch (e) { return { sz, error: e.message }; }
        }
        const flags = isSource ? [] : flagsFor(source, page, sz.w, sz.h);
        return { sz, page, flags, isSource };
      });

      els.grid.innerHTML = cards.map((c) => {
        if (c.error) {
          return `<div class="sz-card"><div class="sz-head"><span class="sz-name">${escapeHtml(c.sz.name)}</span></div>
            <p class="sz-flag is-bad">Could not lay this out: ${escapeHtml(c.error)}</p></div>`;
        }
        return `<div class="sz-card">
          <div class="sz-head">
            <span class="sz-name">${escapeHtml(c.sz.name)}</span>
            <span class="sz-dims">${c.sz.w} × ${c.sz.h}</span>
          </div>
          ${renderStage(c.page, c.sz.w, c.sz.h, c.sz.name, c.isSource)}
          <div class="sz-flags">
            ${c.isSource
              ? '<span class="sz-ok">The size you drew it at.</span>'
              : c.flags.length
                ? c.flags.map((f) => `<span class="sz-flag${f.bad ? ' is-bad' : ''}">${escapeHtml(f.text)}</span>`).join('')
                : '<span class="sz-ok">Nothing to worry about here.</span>'}
          </div>
        </div>`;
      }).join('');
    }

    document.querySelectorAll('[data-fit]').forEach((chip) => {
      chip.addEventListener('click', () => {
        els.grid.classList.toggle('is-big', chip.getAttribute('data-fit') === 'big');
        document.querySelectorAll('[data-fit]').forEach((c) => c.classList.toggle('is-on', c === chip));
      });
    });

    (async () => {
      if (!import.meta.env.DEV) {
        const session = await requireAdmin();
        if (!session) return;
      }
      await run();
    })();
  </script>
</AdminShell>
