---
import AdminShell from "../../components/admin/AdminShell.astro";
---

<AdminShell active="settings" title="Settings" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Settings</div>
          <div class="page-header-sub">Your profile, and how this admin centre works for you.</div>
        </div>
      </div>
    </div>
  </div>
  <div class="set-wrap">
    <div class="ash-card set-card">
      <div class="ash-card-head"><div class="ash-card-title">Your profile</div></div>
      <div class="ash-card-body">
        <div class="set-avatar-row">
          <span class="set-avatar" id="set-avatar">·</span>
          <div class="set-avatar-actions">
            <label class="set-upload">
              <input type="file" id="set-avatar-input" accept="image/png,image/jpeg,image/webp" hidden />
              <span id="set-upload-label">Change headshot</span>
            </label>
            <p class="set-hint">JPG, PNG or WebP, up to ~3 MB.</p>
          </div>
        </div>

        <form id="set-form" class="set-form">
          <label class="set-field"><span>Full name</span><input name="full_name" autocomplete="name" placeholder="e.g. Mark Johnson" /></label>
          <div class="set-row">
            <label class="set-field"><span>Role / title</span><input name="role" placeholder="e.g. Marketing Manager" /></label>
            <label class="set-field"><span>Phone</span><input name="phone" type="tel" autocomplete="tel" placeholder="Optional" /></label>
          </div>
          <label class="set-field"><span>Email</span><input name="email" type="email" readonly /></label>
          <p class="set-msg" id="set-msg" hidden></p>
          <button type="submit" class="set-save" id="set-save">Save changes</button>
        </form>
      </div>
    </div>

    <div class="set-col">
      <div class="ash-card set-card">
        <div class="ash-card-head"><div class="ash-card-title">Preferences</div></div>
        <div class="ash-card-body">
          <label class="set-toggle"><input type="checkbox" id="pref-collapsed" /><span>Start with the sidebar collapsed</span></label>
          <p class="set-hint" style="margin-top:14px">More workspace preferences will live here as we flesh out the CRM.</p>
        </div>
      </div>

      <!-- Client report settings (super-admin) — compact card, opens a pop-out -->
      <div class="ash-card set-card set-card--report" id="report-card" hidden>
        <div class="ash-card-head"><div class="ash-card-title">Client report settings</div></div>
        <div class="ash-card-body">
          <p class="set-hint" style="margin:0 0 14px">Choose exactly what your clients see in their monthly social report. Hide anything internal; show the metrics that tell the story.</p>
          <p class="pop-status" id="report-status">Loading…</p>
          <button type="button" class="set-pop-open" data-pop-open="pop-report">Choose visible fields</button>
        </div>
      </div>
    </div>

    <!-- TMKE Brand kit — compact card (palette inline), full editor in a pop-out -->
    <div class="ash-card set-card set-card--brand" id="brand-card">
      <div class="ash-card-head"><div class="ash-card-title">TMKE Brand kit</div></div>
      <div class="ash-card-body">
        <p class="set-hint" style="margin:0 0 16px">Shared across the whole admin centre — the one place for TMKE's colours, fonts and logos. The Email Studio pulls these automatically.</p>
        <div class="brand-colors brand-colors--mini" id="brand-colors-mini"></div>
        <button type="button" class="set-pop-open" data-pop-open="pop-brand">Edit brand kit</button>
      </div>
    </div>

    <section class="set-team">
      <h2 class="set-team-h">Admin access</h2>
      <p class="set-team-intro">Anyone with an <strong>@tmke.co.uk</strong> email can sign in automatically. Grant access below to anyone else who needs the admin centre — they'll get their own login, emailed to them. Removing someone revokes their admin access straight away.</p>

      <form id="team-form" class="set-team-form">
        <label class="set-field"><span>Full name</span><input name="full_name" placeholder="e.g. Abby Taylor" autocomplete="off" /></label>
        <label class="set-field"><span>Email</span><input name="email" type="email" placeholder="name@example.com" autocomplete="off" /></label>
        <button type="submit" class="set-save" id="team-add">Grant access</button>
      </form>
      <p class="set-msg" id="team-msg" hidden></p>

      <div class="set-team-list" id="team-list">
        <p class="set-team-empty" id="team-empty">Loading team…</p>
      </div>
    </section>
  </div>

  <!-- ============ Pop-out: Client report settings ============ -->
  <div class="set-pop" id="pop-report" hidden aria-hidden="true">
    <div class="set-pop-scrim" data-pop-close></div>
    <div class="set-pop-panel" role="dialog" aria-modal="true" aria-label="Client report settings">
      <div class="set-pop-head">
        <div>
          <h2 class="set-pop-h">Client report settings</h2>
          <p class="set-pop-sub">Tick what appears in every client's monthly report. Unticked fields stay internal to TMKE.</p>
        </div>
        <button type="button" class="set-pop-x" data-pop-close aria-label="Close">&times;</button>
      </div>
      <div class="set-pop-body">
        <div class="report-groups" id="report-groups"></div>
      </div>
      <div class="set-pop-foot">
        <p class="set-msg" id="report-msg" hidden></p>
        <div class="set-pop-actions">
          <button type="button" class="set-mini" id="report-reset">Reset to defaults</button>
          <button type="button" class="set-save" id="report-save">Save settings</button>
        </div>
      </div>
    </div>
  </div>

  <!-- ============ Pop-out: TMKE Brand kit (full editor) ============ -->
  <div class="set-pop" id="pop-brand" hidden aria-hidden="true">
    <div class="set-pop-scrim" data-pop-close></div>
    <div class="set-pop-panel" role="dialog" aria-modal="true" aria-label="TMKE Brand kit">
      <div class="set-pop-head">
        <div>
          <h2 class="set-pop-h">TMKE Brand kit</h2>
          <p class="set-pop-sub">Colours, fonts, logos &amp; social links — shared across the whole admin centre.</p>
        </div>
        <button type="button" class="set-pop-x" data-pop-close aria-label="Close">&times;</button>
      </div>
      <div class="set-pop-body">
        <h3 class="set-h">Colours</h3>
        <p class="set-hint" style="margin:-4px 0 12px">These become preset swatches in the Email Studio colour picker.</p>
        <div class="brand-colors" id="brand-colors"></div>
        <div class="brand-add">
          <input type="color" id="brand-color-pick" value="#371E28" />
          <input type="text" id="brand-color-hex" class="brand-hex" placeholder="#371E28" />
          <button type="button" class="set-mini" id="brand-color-add">Add colour</button>
        </div>

        <h3 class="set-h">Fonts</h3>
        <p class="set-hint" style="margin:-4px 0 12px">Stored for reference and on-site use. Emails keep their Outlook-safe fonts, so these don't affect email designs.</p>
        <label class="set-field"><span>Heading font</span><input id="brand-heading-font" placeholder="Helios, Helvetica, Arial, sans-serif" /></label>
        <label class="set-field"><span>Sub-heading font</span><input id="brand-subheading-font" /></label>
        <label class="set-field"><span>Body font</span><input id="brand-body-font" /></label>

        <h3 class="set-h">Logos</h3>
        <div class="brand-logos">
          <div class="brand-logo">
            <span class="set-field-lbl">Primary logo</span>
            <div class="brand-logo-box"><img id="brand-logo-preview" alt="" hidden /></div>
            <div class="brand-logo-row">
              <input id="brand-logo-url" class="brand-url" placeholder="Paste a URL, or upload →" />
              <label class="set-upload"><input type="file" id="brand-logo-file" accept="image/png,image/jpeg,image/webp,image/svg+xml" hidden /><span id="brand-logo-lbl">Upload</span></label>
            </div>
          </div>
          <div class="brand-logo">
            <span class="set-field-lbl">Footer / banner</span>
            <div class="brand-logo-box"><img id="brand-footer-preview" alt="" hidden /></div>
            <div class="brand-logo-row">
              <input id="brand-footer-url" class="brand-url" placeholder="Paste a URL, or upload →" />
              <label class="set-upload"><input type="file" id="brand-footer-file" accept="image/png,image/jpeg,image/webp" hidden /><span id="brand-footer-lbl">Upload</span></label>
            </div>
          </div>
        </div>

        <h3 class="set-h">Social links</h3>
        <p class="set-hint" style="margin:-4px 0 12px">The master social URLs. Every email's social icons &amp; footer pull from here — set once, they flow everywhere. Leave a field blank to hide that network.</p>
        <div class="brand-socials">
          <label class="set-field"><span>Website</span><input id="brand-social-website" class="brand-url" type="url" placeholder="https://tmke.co.uk" /></label>
          <label class="set-field"><span>LinkedIn</span><input id="brand-social-linkedin" class="brand-url" type="url" placeholder="https://linkedin.com/company/…" /></label>
          <label class="set-field"><span>Instagram</span><input id="brand-social-instagram" class="brand-url" type="url" placeholder="https://instagram.com/…" /></label>
          <label class="set-field"><span>Facebook</span><input id="brand-social-facebook" class="brand-url" type="url" placeholder="https://facebook.com/…" /></label>
          <label class="set-field"><span>X / Twitter</span><input id="brand-social-twitter" class="brand-url" type="url" placeholder="https://x.com/…" /></label>
          <label class="set-field"><span>YouTube</span><input id="brand-social-youtube" class="brand-url" type="url" placeholder="https://youtube.com/@…" /></label>
        </div>
      </div>
      <div class="set-pop-foot">
        <p class="set-msg" id="brand-msg" hidden></p>
        <div class="set-pop-actions"><button type="button" class="set-save" id="brand-save">Save brand kit</button></div>
      </div>
    </div>
  </div>

  <style is:global>
    .set-wrap { display: grid; grid-template-columns: 1.4fr 1fr; gap: 16px; align-items: start; max-width: 1000px; }
    @media (max-width: 900px) { .set-wrap { grid-template-columns: 1fr; } }

    .set-avatar-row { display: flex; align-items: center; gap: 18px; margin-bottom: 24px; }
    .set-avatar { width: 84px; height: 84px; flex: none; border-radius: 50%; background: linear-gradient(135deg, var(--english-violet), #7e6765); display: inline-flex; align-items: center; justify-content: center; font-size: 30px; font-weight: 800; color: #fff; text-transform: uppercase; background-size: cover; background-position: center; border: 1px solid rgba(28,29,34,0.08); }
    .set-upload { display: inline-block; cursor: pointer; background: #fff; border: 1px solid rgba(28,29,34,0.14); border-radius: 9px; padding: 10px 16px; font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--ink); transition: background 0.2s, border-color 0.2s; }
    .set-upload:hover { background: var(--paper); border-color: rgba(28,29,34,0.24); }
    .set-hint { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); margin: 8px 0 0; }

    .set-form { display: flex; flex-direction: column; gap: 16px; }
    .set-row { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 560px) { .set-row { grid-template-columns: 1fr; } }
    .set-field { display: flex; flex-direction: column; gap: 7px; }
    .set-field > span { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .set-field input { font-family: var(--sans); font-size: 15px; padding: 12px 14px; border-radius: 9px; border: 1px solid rgba(28,29,34,0.14); background: #fff; color: var(--ink); transition: border-color 0.2s, box-shadow 0.2s; }
    .set-field input::placeholder { color: rgba(28,29,34,0.4); }
    .set-field input:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.1); }
    .set-field input[readonly] { background: var(--paper); color: rgba(28,29,34,0.6); cursor: not-allowed; }
    .set-save { align-self: flex-start; margin-top: 6px; appearance: none; cursor: pointer; background: var(--english-violet); color: #fff; border: 0; border-radius: 9px; padding: 13px 26px; font-family: var(--sans); font-size: 12px; font-weight: 800; letter-spacing: 0.14em; text-transform: uppercase; transition: opacity 0.2s, transform 0.2s; }
    .set-save:hover { opacity: 0.9; }
    .set-save:disabled { opacity: 0.5; cursor: not-allowed; }
    .set-msg { font-family: var(--sans); font-size: 13.5px; border-radius: 9px; padding: 11px 14px; margin: 0; }
    .set-msg.is-ok { background: rgba(60,150,90,0.1); color: #2e6b40; border: 1px solid rgba(60,150,90,0.3); }
    .set-msg.is-err { background: rgba(200,70,50,0.1); color: #a3372b; border: 1px solid rgba(200,70,50,0.3); }
    .set-toggle { display: flex; align-items: center; gap: 11px; font-family: var(--sans); font-size: 14px; color: var(--ink); cursor: pointer; }
    .set-toggle input { width: 18px; height: 18px; accent-color: var(--english-violet); }

    /* ---- Compact "click to pop out" cards ---- */
    .set-col { display: flex; flex-direction: column; gap: 16px; align-self: start; }
    .set-card--brand { grid-column: 1 / -1; }
    .pop-status { font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--english-violet); margin: 0 0 14px; }
    .set-pop-open { appearance: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; background: #fff; border: 1px solid rgba(28,29,34,0.16); border-radius: 9px; padding: 11px 17px; font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--ink); transition: background 0.18s, border-color 0.18s, transform 0.18s; }
    .set-pop-open::after { content: "→"; font-size: 14px; color: var(--english-violet); transition: transform 0.18s; }
    .set-pop-open:hover { background: var(--paper); border-color: rgba(28,29,34,0.28); }
    .set-pop-open:hover::after { transform: translateX(3px); }

    /* ---- Pop-out drawer (right slide-in) ---- */
    .set-pop { position: fixed; inset: 0; z-index: 200; }
    .set-pop[hidden] { display: none; }
    .set-pop-scrim { position: absolute; inset: 0; background: rgba(28,29,34,0.4); opacity: 0; transition: opacity 0.26s ease; }
    .set-pop.is-open .set-pop-scrim { opacity: 1; }
    .set-pop-panel { position: absolute; top: 0; right: 0; height: 100%; width: min(560px, 94vw); background: var(--paper, #f4f2f1); box-shadow: -18px 0 60px rgba(28,29,34,0.24); display: flex; flex-direction: column; transform: translateX(100%); transition: transform 0.28s cubic-bezier(0.22,0.61,0.36,1); }
    .set-pop.is-open .set-pop-panel { transform: translateX(0); }
    .set-pop-head { flex: none; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; padding: 22px 24px 16px; border-bottom: 1px solid rgba(28,29,34,0.1); background: #fff; }
    .set-pop-h { font-family: var(--serif); font-size: 21px; font-weight: 500; color: var(--ink); margin: 0 0 5px; }
    .set-pop-sub { font-family: var(--sans); font-size: 13px; line-height: 1.5; color: rgba(28,29,34,0.6); margin: 0; max-width: 42ch; }
    .set-pop-x { appearance: none; cursor: pointer; flex: none; width: 34px; height: 34px; border-radius: 50%; border: 1px solid rgba(28,29,34,0.14); background: #fff; color: rgba(28,29,34,0.6); font-size: 22px; line-height: 1; display: inline-flex; align-items: center; justify-content: center; transition: background 0.18s, color 0.18s; }
    .set-pop-x:hover { background: var(--paper); color: var(--ink); }
    .set-pop-body { flex: 1; overflow-y: auto; padding: 20px 24px 24px; }
    .set-pop-body > .set-h:first-of-type { margin-top: 0; }
    .set-pop-foot { flex: none; padding: 14px 24px; border-top: 1px solid rgba(28,29,34,0.1); background: #fff; }
    .set-pop-foot .set-msg { margin-bottom: 12px; }
    .set-pop-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; }
    .set-pop-actions .set-save { margin-top: 0; }

    /* ---- Report field toggles ---- */
    .report-group { margin-bottom: 22px; }
    .report-group:last-child { margin-bottom: 0; }
    .report-group-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 10px; }
    .report-group-title { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .report-group-all { appearance: none; cursor: pointer; background: none; border: 0; font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--english-violet); padding: 0; }
    .report-group-all:hover { text-decoration: underline; }
    .report-fields { display: flex; flex-direction: column; gap: 2px; }
    .report-field { display: flex; align-items: center; gap: 12px; padding: 9px 11px; border-radius: 8px; background: #fff; border: 1px solid rgba(28,29,34,0.08); cursor: pointer; transition: border-color 0.15s; }
    .report-field:hover { border-color: rgba(28,29,34,0.18); }
    .report-field input { width: 18px; height: 18px; flex: none; accent-color: var(--english-violet); cursor: pointer; }
    .report-field span { font-family: var(--sans); font-size: 13.5px; color: var(--ink); }
    .report-field.is-off span { color: rgba(28,29,34,0.5); }

    /* ---- Brand kit ---- */
    .set-h { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.55); margin: 24px 0 10px; }
    .set-field-lbl { display: block; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.55); margin-bottom: 8px; }
    .set-pop-body .set-field { margin-bottom: 12px; }
    .brand-colors { display: flex; flex-wrap: wrap; gap: 8px 10px; margin-bottom: 16px; }
    .brand-colors:empty { display: none; }
    /* Read-only palette preview on the compact card. */
    .brand-colors--mini { gap: 0; margin-bottom: 18px; }
    .brand-colors--mini .brand-swatch { width: 34px; height: 34px; border-radius: 0; margin-right: -1px; box-shadow: none; }
    .brand-colors--mini .brand-swatch:first-child { border-top-left-radius: 8px; border-bottom-left-radius: 8px; }
    .brand-colors--mini .brand-swatch:last-child { border-top-right-radius: 8px; border-bottom-right-radius: 8px; }
    .brand-colors--mini .brand-swatch .hex, .brand-colors--mini .brand-swatch button { display: none; }
    .brand-swatch { position: relative; width: 46px; height: 46px; border-radius: 9px; border: 1px solid rgba(28,29,34,0.16); }
    .brand-swatch .hex { position: absolute; bottom: -16px; left: 0; font-family: var(--sans); font-size: 9px; color: rgba(28,29,34,0.5); white-space: nowrap; }
    .brand-swatch button { position: absolute; top: -7px; right: -7px; width: 19px; height: 19px; border-radius: 50%; border: 0; background: #fff; box-shadow: 0 1px 5px rgba(0,0,0,0.28); color: #a3372b; font-size: 13px; line-height: 1; cursor: pointer; opacity: 0; transition: opacity 0.12s; }
    .brand-swatch:hover button { opacity: 1; }
    .brand-add { display: flex; align-items: center; gap: 8px; }
    .brand-add input[type=color] { width: 44px; height: 40px; padding: 2px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; background: #fff; cursor: pointer; }
    .brand-hex { width: 130px; font-family: var(--sans); font-size: 14px; padding: 10px 12px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; color: var(--ink); }
    .set-mini { appearance: none; cursor: pointer; background: #fff; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; padding: 10px 15px; font-family: var(--sans); font-size: 12.5px; font-weight: 700; color: var(--english-violet); }
    .set-mini:hover { background: var(--paper); }
    .brand-logos { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
    @media (max-width: 560px) { .brand-logos { grid-template-columns: 1fr; } }
    .brand-socials { display: grid; grid-template-columns: 1fr 1fr; gap: 6px 16px; }
    @media (max-width: 560px) { .brand-socials { grid-template-columns: 1fr; } }
    .brand-logo-box { background: var(--paper); border: 1px solid rgba(28,29,34,0.1); border-radius: 9px; min-height: 84px; display: flex; align-items: center; justify-content: center; padding: 10px; overflow: hidden; }
    .brand-logo-box img { max-width: 100%; max-height: 90px; display: block; }
    .brand-logo-box:has(img[hidden]) { color: rgba(28,29,34,0.3); }
    .brand-logo-row { display: flex; gap: 8px; margin-top: 8px; }
    .brand-url { flex: 1; min-width: 0; font-family: var(--sans); font-size: 13px; padding: 9px 11px; border: 1px solid rgba(28,29,34,0.14); border-radius: 8px; color: var(--ink); }

    /* ---- Admin access (team) — a card-less section so the member cards sit
       on the paper ground and read as individual wide cards, like the SMM list. ---- */
    .set-team { grid-column: 1 / -1; margin-top: 6px; }
    .set-team-h { font-family: var(--serif); font-size: 19px; font-weight: 500; color: var(--ink); margin: 0 0 8px; }
    .set-team-intro { font-family: var(--sans); font-size: 14px; line-height: 1.55; color: rgba(28,29,34,0.72); margin: 0 0 18px; max-width: 660px; }
    .set-team-intro strong { color: var(--ink); }
    .set-team-form { display: grid; grid-template-columns: 1fr 1fr auto; gap: 14px; align-items: end; }
    @media (max-width: 620px) { .set-team-form { grid-template-columns: 1fr; } }
    .set-team-form .set-save { margin-top: 0; align-self: end; height: 46px; padding: 0 24px; }
    @media (max-width: 620px) { .set-team-form .set-save { align-self: stretch; } }
    #team-msg { margin-top: 14px; }
    #team-msg code { font-family: ui-monospace, Menlo, monospace; font-weight: 700; background: rgba(255,255,255,0.6); border: 1px solid rgba(28,29,34,0.14); border-radius: 6px; padding: 1px 7px; }
    .set-team-list { margin-top: 22px; display: flex; flex-direction: column; gap: 10px; }
    .set-team-empty { font-family: var(--sans); font-size: 13.5px; color: rgba(28,29,34,0.5); margin: 0; }
    .team-row { display: flex; align-items: center; gap: 14px; padding: 14px 16px; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px; }
    .team-meta { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 3px; }
    .team-name { font-family: var(--sans); font-size: 14.5px; font-weight: 700; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .team-sub { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .team-edit-input { font-family: var(--sans); font-size: 14.5px; font-weight: 700; color: var(--ink); padding: 8px 11px; border-radius: 8px; border: 1px solid var(--english-violet); background: #fff; width: 100%; max-width: 320px; }
    .team-edit-input:focus { outline: none; box-shadow: 0 0 0 3px rgba(55,30,40,0.1); }
    .team-btn, .team-remove { appearance: none; cursor: pointer; background: none; border: 1px solid rgba(28,29,34,0.16); border-radius: 8px; padding: 8px 14px; font-family: var(--sans); font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.7); transition: background 0.2s, border-color 0.2s, color 0.2s; flex: none; }
    .team-btn:hover { background: rgba(28,29,34,0.05); border-color: rgba(28,29,34,0.28); color: var(--ink); }
    .team-btn.team-save-name { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }
    .team-btn.team-save-name:hover { opacity: 0.9; }
    .team-remove:hover { background: rgba(200,70,50,0.08); border-color: rgba(200,70,50,0.4); color: #a3372b; }
    .team-remove:disabled, .team-btn:disabled { opacity: 0.4; cursor: not-allowed; }
    .team-you { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.4); flex: none; padding-right: 4px; }
  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";
    import { REPORT_FIELD_GROUPS, REPORT_FIELD_KEYS, defaultClientVisibility, resolveVisibility } from "../../lib/report-fields.js";

    let uid = null, currentAvatar = null;
    const $ = (id) => document.getElementById(id);

    // ---- Pop-out drawers (Brand kit, Client report settings) ----
    function openPop(id) {
      const p = $(id); if (!p) return;
      p.hidden = false; p.setAttribute("aria-hidden", "false");
      requestAnimationFrame(() => p.classList.add("is-open"));
      document.body.style.overflow = "hidden";
    }
    function closePop(p) {
      if (!p) return;
      p.classList.remove("is-open"); p.setAttribute("aria-hidden", "true");
      setTimeout(() => { p.hidden = true; }, 280);
      document.body.style.overflow = "";
    }
    document.addEventListener("click", (e) => {
      const opener = e.target.closest("[data-pop-open]");
      if (opener) { openPop(opener.getAttribute("data-pop-open")); return; }
      const closer = e.target.closest("[data-pop-close]");
      if (closer) closePop(closer.closest(".set-pop"));
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape") document.querySelectorAll(".set-pop.is-open").forEach(closePop);
    });
    function initials(s) { return (String(s || "A").trim()[0] || "A").toUpperCase(); }
    function showMsg(text, ok) { const m = $("set-msg"); m.textContent = text; m.className = "set-msg " + (ok ? "is-ok" : "is-err"); m.hidden = false; }
    function paintAvatar(url, name) {
      const el = $("set-avatar");
      if (url) { el.textContent = ""; el.style.backgroundImage = `url('${url}')`; }
      else { el.style.backgroundImage = ""; el.textContent = initials(name); }
    }

    document.addEventListener("ash:ready", (e) => {
      const session = e.detail && e.detail.session;
      const profile = e.detail && e.detail.profile;
      if (!session) return;
      uid = session.user.id;
      const f = $("set-form");
      f.email.value = session.user.email || "";
      if (profile) {
        f.full_name.value = profile.full_name || "";
        f.role.value = profile.role || "";
        f.phone.value = profile.phone || "";
        currentAvatar = profile.avatar_url || null;
      }
      paintAvatar(currentAvatar, (profile && profile.full_name) || (session.user.email || ""));
      $("pref-collapsed").checked = localStorage.getItem("tmke-admin-collapsed") === "1";
      // The Brand kit, Client report settings + Admin access are owner-only
      // (server-enforced too). Other admins can fully operate the site but don't
      // see or manage these.
      const OWNER_EMAILS = ["james@therecruitmentexperts.co.uk", "danielle@tmke.co.uk"];
      const isOwner = OWNER_EMAILS.includes(String(session.user.email || "").toLowerCase().trim());
      if (isOwner) {
        loadTeam(); loadBrand(); loadReportSettings();
        $("report-card")?.removeAttribute("hidden");
      } else {
        ["brand-card", "report-card", "pop-report", "pop-brand"].forEach((id) => $(id)?.setAttribute("hidden", ""));
        document.querySelector(".set-team")?.setAttribute("hidden", "");
      }
    });

    // ---- Brand kit (shared across the admin centre) ----
    let brandColors = [];
    const brandMsg = (t, ok) => { const m = $("brand-msg"); m.hidden = false; m.textContent = t; m.className = "set-msg " + (ok ? "is-ok" : "is-err"); };
    function renderBrandColors() {
      $("brand-colors").innerHTML = brandColors.map((c, i) => `<span class="brand-swatch" style="background:${c}"><button type="button" data-rmc="${i}" title="Remove">&times;</button><span class="hex">${c}</span></span>`).join("");
      const mini = $("brand-colors-mini");
      if (mini) mini.innerHTML = brandColors.map((c) => `<span class="brand-swatch" style="background:${c}" title="${c}"></span>`).join("");
    }
    function setLogoPreview(imgId, url) { const img = $(imgId); if (url) { img.src = url; img.hidden = false; } else { img.hidden = true; img.removeAttribute("src"); } }
    async function loadBrand() {
      if (!WORKER) return;
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/brand`, { headers: { Authorization: `Bearer ${token}` } });
        const j = await res.json().catch(() => ({}));
        const b = (j && j.brand) || {};
        brandColors = Array.isArray(b.colors) ? b.colors.slice() : [];
        renderBrandColors();
        $("brand-heading-font").value = b.heading_font || "";
        $("brand-subheading-font").value = b.subheading_font || "";
        $("brand-body-font").value = b.body_font || "";
        $("brand-logo-url").value = b.logo_url || "";
        $("brand-footer-url").value = b.footer_image_url || "";
        setLogoPreview("brand-logo-preview", b.logo_url);
        setLogoPreview("brand-footer-preview", b.footer_image_url);
        ["website","linkedin","instagram","facebook","twitter","youtube"].forEach((k) => { const el = $("brand-social-" + k); if (el) el.value = b[k] || ""; });
      } catch (_) {}
    }
    $("brand-color-pick").addEventListener("input", (e) => { $("brand-color-hex").value = e.target.value.toUpperCase(); });
    $("brand-color-add").addEventListener("click", () => {
      let hex = ($("brand-color-hex").value || $("brand-color-pick").value).trim();
      if (hex && !hex.startsWith("#")) hex = "#" + hex;
      if (!/^#([0-9a-fA-F]{3}|[0-9a-fA-F]{6})$/.test(hex)) { brandMsg("That doesn't look like a hex colour.", false); return; }
      hex = hex.toUpperCase();
      if (!brandColors.includes(hex)) brandColors.push(hex);
      $("brand-color-hex").value = "";
      renderBrandColors();
    });
    $("brand-colors").addEventListener("click", (e) => { const b = e.target.closest("[data-rmc]"); if (!b) return; brandColors.splice(+b.getAttribute("data-rmc"), 1); renderBrandColors(); });
    $("brand-logo-url").addEventListener("input", (e) => setLogoPreview("brand-logo-preview", e.target.value.trim()));
    $("brand-footer-url").addEventListener("input", (e) => setLogoPreview("brand-footer-preview", e.target.value.trim()));
    async function uploadBrandImage(file, folder) {
      const ext = (file.name.split(".").pop() || "png").toLowerCase();
      // The avatars bucket's RLS requires the object path to start with the
      // uploader's user id (same as the headshot upload) — otherwise it's denied.
      const path = `${uid}/${folder}-${Date.now()}.${ext}`;
      const { error } = await supabase.storage.from("avatars").upload(path, file, { upsert: true, cacheControl: "3600", contentType: file.type });
      if (error) throw error;
      return supabase.storage.from("avatars").getPublicUrl(path).data.publicUrl;
    }
    $("brand-logo-file").addEventListener("change", async (e) => {
      const file = e.target.files && e.target.files[0]; if (!file) return;
      const lbl = $("brand-logo-lbl"), prev = lbl.textContent; lbl.textContent = "Uploading…";
      try { const url = await uploadBrandImage(file, "brand-logo"); $("brand-logo-url").value = url; setLogoPreview("brand-logo-preview", url); brandMsg("Logo uploaded — Save the brand kit to keep it.", true); }
      catch (err) { brandMsg(err.message || "Couldn't upload that image.", false); }
      finally { lbl.textContent = prev; e.target.value = ""; }
    });
    $("brand-footer-file").addEventListener("change", async (e) => {
      const file = e.target.files && e.target.files[0]; if (!file) return;
      const lbl = $("brand-footer-lbl"), prev = lbl.textContent; lbl.textContent = "Uploading…";
      try { const url = await uploadBrandImage(file, "brand-footer"); $("brand-footer-url").value = url; setLogoPreview("brand-footer-preview", url); brandMsg("Footer image uploaded — Save the brand kit to keep it.", true); }
      catch (err) { brandMsg(err.message || "Couldn't upload that image.", false); }
      finally { lbl.textContent = prev; e.target.value = ""; }
    });
    $("brand-save").addEventListener("click", async () => {
      if (!WORKER) { brandMsg("Connect the Worker to save the brand kit.", false); return; }
      const btn = $("brand-save"); btn.disabled = true; btn.textContent = "Saving…";
      try {
        const token = await authToken();
        const social = {}; ["website","linkedin","instagram","facebook","twitter","youtube"].forEach((k) => { social[k] = ($("brand-social-" + k).value || "").trim() || null; });
        const res = await fetch(`${WORKER}/brand`, { method: "POST", headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" }, body: JSON.stringify({ colors: brandColors, heading_font: $("brand-heading-font").value.trim() || null, subheading_font: $("brand-subheading-font").value.trim() || null, body_font: $("brand-body-font").value.trim() || null, logo_url: $("brand-logo-url").value.trim() || null, footer_image_url: $("brand-footer-url").value.trim() || null, ...social }) });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) { throw new Error(j.error || "Couldn't save."); }
        if (j.socialsSkipped) brandMsg("Colours, fonts & logos saved — but the social links didn't. The database needs the migration supabase/brand_social.sql run once; then re-save and they'll stick.", false);
        else brandMsg("Brand kit saved.", true);
      } catch (err) { brandMsg(err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Save brand kit"; }
    });

    // ---- Client report settings (super-admin: what clients see in reports) ----
    let reportVis = defaultClientVisibility();
    const reportMsg = (t, ok) => { const m = $("report-msg"); if (!m) return; m.hidden = false; m.textContent = t; m.className = "set-msg " + (ok ? "is-ok" : "is-err"); };
    function updateReportStatus() {
      const el = $("report-status"); if (!el) return;
      const total = REPORT_FIELD_KEYS.length;
      const on = REPORT_FIELD_KEYS.filter((k) => reportVis[k]).length;
      el.textContent = `${on} of ${total} fields shown to clients`;
    }
    function renderReportGroups() {
      const wrap = $("report-groups"); if (!wrap) return;
      wrap.innerHTML = REPORT_FIELD_GROUPS.map((g) => {
        const rows = g.fields.map((f) => {
          const on = !!reportVis[f.key];
          return `<label class="report-field ${on ? "" : "is-off"}" data-fk="${f.key}"><input type="checkbox" data-fk="${f.key}" ${on ? "checked" : ""} /><span>${f.label}</span></label>`;
        }).join("");
        return `<div class="report-group">
          <div class="report-group-head">
            <span class="report-group-title">${g.label}</span>
            <button type="button" class="report-group-all" data-grp="${g.tab}">Toggle all</button>
          </div>
          <div class="report-fields">${rows}</div>
        </div>`;
      }).join("");
    }
    async function loadReportSettings() {
      renderReportGroups(); updateReportStatus();
      if (!WORKER) return;
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/report-settings`, { headers: { Authorization: `Bearer ${token}` } });
        const j = await res.json().catch(() => ({}));
        reportVis = resolveVisibility(j && j.visibility);
      } catch (_) { reportVis = defaultClientVisibility(); }
      renderReportGroups(); updateReportStatus();
    }
    $("report-groups")?.addEventListener("change", (e) => {
      const cb = e.target.closest("input[type=checkbox][data-fk]"); if (!cb) return;
      const key = cb.getAttribute("data-fk");
      reportVis[key] = cb.checked;
      cb.closest(".report-field")?.classList.toggle("is-off", !cb.checked);
      updateReportStatus();
    });
    $("report-groups")?.addEventListener("click", (e) => {
      const btn = e.target.closest(".report-group-all"); if (!btn) return;
      const tab = btn.getAttribute("data-grp");
      const grp = REPORT_FIELD_GROUPS.find((g) => g.tab === tab); if (!grp) return;
      const allOn = grp.fields.every((f) => reportVis[f.key]);
      grp.fields.forEach((f) => { reportVis[f.key] = !allOn; });
      renderReportGroups(); updateReportStatus();
    });
    $("report-reset")?.addEventListener("click", () => { reportVis = defaultClientVisibility(); renderReportGroups(); updateReportStatus(); reportMsg("Reset to the recommended defaults — Save to keep it.", true); });
    $("report-save")?.addEventListener("click", async () => {
      if (!WORKER) { reportMsg("Connect the Worker to save report settings.", false); return; }
      const btn = $("report-save"); btn.disabled = true; btn.textContent = "Saving…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/report-settings`, {
          method: "POST", headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: JSON.stringify({ visibility: reportVis }),
        });
        const j = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(j.error || "Couldn't save.");
        reportMsg("Report settings saved — this is what your clients will see.", true);
      } catch (err) { reportMsg(err.message, false); }
      finally { btn.disabled = false; btn.textContent = "Save settings"; }
    });

    // ---------- Admin access (team) ----------
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    let selfId = null;
    const esc = (s) => String(s == null ? "" : s).replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]));
    function teamMsg(text, ok) { const m = $("team-msg"); m.innerHTML = text; m.className = "set-msg " + (ok ? "is-ok" : "is-err"); m.hidden = false; }
    async function authToken() {
      try {
        let s = (await supabase.auth.getSession()).data.session;
        if (!s || (s.expires_at && s.expires_at * 1000 < Date.now() + 60000)) {
          try { const r = await supabase.auth.refreshSession(); if (r.data && r.data.session) s = r.data.session; } catch (_) {}
        }
        return (s && s.access_token) || "";
      } catch (_) { return ""; }
    }

    let teamAdmins = [], editingId = null;

    function renderTeam() {
      const wrap = $("team-list");
      if (!teamAdmins.length) { wrap.innerHTML = '<p class="set-team-empty">No one else has been granted access yet. Add someone above.</p>'; return; }
      wrap.innerHTML = teamAdmins.map((a) => {
        const name = a.full_name || (a.email || "").split("@")[0];
        const isSelf = a.user_id === selfId;
        if (a.user_id === editingId) {
          return `<div class="team-row">
            <div class="team-meta">
              <input class="team-edit-input" id="team-edit-input" value="${esc(a.full_name || "")}" placeholder="Full name" />
              <div class="team-sub">${esc(a.email)}</div>
            </div>
            <button type="button" class="team-btn team-save-name" data-uid="${esc(a.user_id)}">Save</button>
            <button type="button" class="team-btn team-cancel-name">Cancel</button>
          </div>`;
        }
        const when = a.created_at ? new Date(a.created_at).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }) : "";
        const right = isSelf
          ? '<span class="team-you">You</span>'
          : `<button type="button" class="team-btn team-reset" data-uid="${esc(a.user_id)}" data-name="${esc(name)}">Reset password</button>
             <button type="button" class="team-remove" data-uid="${esc(a.user_id)}" data-name="${esc(name)}">Remove</button>`;
        return `<div class="team-row">
          <div class="team-meta">
            <div class="team-name">${esc(name)}${a.role ? ` · ${esc(a.role)}` : ""}</div>
            <div class="team-sub">${esc(a.email)}${when ? ` — added ${when}` : ""}</div>
          </div>
          <button type="button" class="team-btn team-edit" data-uid="${esc(a.user_id)}">Edit name</button>
          ${right}
        </div>`;
      }).join("");
      if (editingId) { const i = $("team-edit-input"); if (i) { i.focus(); i.select(); } }
    }

    async function loadTeam() {
      const wrap = $("team-list");
      if (!WORKER) { wrap.innerHTML = '<p class="set-team-empty">Connect the Worker (PUBLIC_R2_WORKER_URL) to manage admin access.</p>'; $("team-add").disabled = true; return; }
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/admin/team`, { headers: { Authorization: `Bearer ${token}` } });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || "Couldn't load the team.");
        selfId = d.self || null;
        teamAdmins = d.admins || [];
        editingId = null;
        renderTeam();
      } catch (err) { wrap.innerHTML = `<p class="set-team-empty">${esc(err.message || "Couldn't load the team.")}</p>`; }
    }

    async function saveTeamName(userId, newName) {
      const token = await authToken();
      const res = await fetch(`${WORKER}/admin/team`, {
        method: "PATCH", headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
        body: JSON.stringify({ user_id: userId, full_name: newName }),
      });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.error || "Couldn't save the name.");
      const row = teamAdmins.find((a) => a.user_id === userId);
      if (row) row.full_name = newName;
    }

    $("team-form")?.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      if (!WORKER) return;
      const f = ev.target; const btn = $("team-add");
      const email = f.email.value.trim(); const full_name = f.full_name.value.trim();
      if (!email) { teamMsg("Enter an email address to grant access.", false); return; }
      btn.disabled = true; btn.textContent = "Granting…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/admin/team`, {
          method: "POST", headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
          body: JSON.stringify({ email, full_name }),
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || "Couldn't grant access.");
        if (d.temp_password) {
          teamMsg(`Access granted for <strong>${esc(email)}</strong>. We've emailed them how to sign in. Temporary password (share if the email doesn't arrive): <code>${esc(d.temp_password)}</code>`, true);
        } else {
          teamMsg(`Access granted for <strong>${esc(email)}</strong>. They can sign in with their existing password.`, true);
        }
        f.reset();
        loadTeam();
      } catch (err) { teamMsg(err.message || "Couldn't grant access.", false); }
      finally { btn.disabled = false; btn.textContent = "Grant access"; }
    });

    $("team-list")?.addEventListener("click", async (ev) => {
      // Edit a name (inline).
      const editBtn = ev.target.closest(".team-edit");
      if (editBtn) { editingId = editBtn.getAttribute("data-uid"); renderTeam(); return; }
      const cancelBtn = ev.target.closest(".team-cancel-name");
      if (cancelBtn) { editingId = null; renderTeam(); return; }
      const saveBtn = ev.target.closest(".team-save-name");
      if (saveBtn) {
        const uid3 = saveBtn.getAttribute("data-uid");
        const input = $("team-edit-input");
        const newName = (input && input.value.trim()) || "";
        if (!newName) { teamMsg("Enter a name.", false); return; }
        saveBtn.disabled = true; saveBtn.textContent = "Saving…";
        try {
          await saveTeamName(uid3, newName);
          editingId = null; renderTeam();
          teamMsg(`Name updated to <strong>${esc(newName)}</strong>.`, true);
        } catch (err) { teamMsg(err.message || "Couldn't save the name.", false); saveBtn.disabled = false; saveBtn.textContent = "Save"; }
        return;
      }

      // Reset password — set a fresh temporary password and email it to them.
      const resetBtn = ev.target.closest(".team-reset");
      if (resetBtn) {
        const uidR = resetBtn.getAttribute("data-uid"); const nameR = resetBtn.getAttribute("data-name") || "this person";
        if (!confirm(`Send ${nameR} a new temporary password? Their current password will stop working.`)) return;
        resetBtn.disabled = true; resetBtn.textContent = "Resetting…";
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER}/admin/team/reset`, {
            method: "POST", headers: { Authorization: `Bearer ${token}`, "Content-Type": "application/json" },
            body: JSON.stringify({ user_id: uidR }),
          });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(d.error || "Couldn't reset the password.");
          teamMsg(`New password set for <strong>${esc(nameR)}</strong> and emailed to them. Temporary password (share if the email doesn't arrive): <code>${esc(d.temp_password)}</code>`, true);
        } catch (err) { teamMsg(err.message || "Couldn't reset the password.", false); }
        finally { resetBtn.disabled = false; resetBtn.textContent = "Reset password"; }
        return;
      }

      // Remove (revoke) access.
      const btn = ev.target.closest(".team-remove");
      if (!btn) return;
      const uid2 = btn.getAttribute("data-uid"); const name = btn.getAttribute("data-name") || "this person";
      if (!confirm(`Remove admin access for ${name}? They'll no longer be able to open the admin centre.`)) return;
      btn.disabled = true; btn.textContent = "Removing…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER}/admin/team?user_id=${encodeURIComponent(uid2)}`, {
          method: "DELETE", headers: { Authorization: `Bearer ${token}` },
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(d.error || "Couldn't remove access.");
        teamMsg(`Access removed for ${esc(name)}.`, true);
        loadTeam();
      } catch (err) { teamMsg(err.message || "Couldn't remove access.", false); btn.disabled = false; btn.textContent = "Remove"; }
    });

    // Save the inline name edit on Enter.
    $("team-list")?.addEventListener("keydown", (ev) => {
      if (ev.key === "Enter" && ev.target.classList.contains("team-edit-input")) {
        ev.preventDefault();
        const sb = ev.target.closest(".team-row")?.querySelector(".team-save-name");
        if (sb) sb.click();
      } else if (ev.key === "Escape" && ev.target.classList.contains("team-edit-input")) {
        editingId = null; renderTeam();
      }
    });

    // Sidebar-collapsed preference (stored locally — the shell reads this key).
    $("pref-collapsed")?.addEventListener("change", (ev) => {
      localStorage.setItem("tmke-admin-collapsed", ev.target.checked ? "1" : "0");
    });

    // Headshot upload → Supabase storage (avatars/<uid>/headshot.<ext>).
    $("set-avatar-input")?.addEventListener("change", async (ev) => {
      const file = ev.target.files && ev.target.files[0];
      if (!file || !uid) return;
      if (file.size > 4 * 1024 * 1024) { showMsg("That image is a bit large — please keep it under ~3 MB.", false); return; }
      const label = $("set-upload-label"); const prev = label.textContent; label.textContent = "Uploading…";
      try {
        const ext = (file.name.split(".").pop() || "jpg").toLowerCase().replace(/[^a-z0-9]/g, "");
        const path = `${uid}/headshot.${ext}`;
        const { error } = await supabase.storage.from("avatars").upload(path, file, { upsert: true, cacheControl: "3600", contentType: file.type });
        if (error) throw error;
        const { data } = supabase.storage.from("avatars").getPublicUrl(path);
        currentAvatar = `${data.publicUrl}?v=${Date.now()}`;
        paintAvatar(currentAvatar, $("set-form").full_name.value);
        showMsg("Headshot updated — don't forget to Save changes.", true);
      } catch (err) { showMsg(err.message || "Couldn't upload that image.", false); }
      finally { label.textContent = prev; }
    });

    // Save profile.
    $("set-form")?.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      if (!uid) return;
      const f = ev.target; const btn = $("set-save");
      btn.disabled = true; btn.textContent = "Saving…";
      try {
        const row = {
          user_id: uid,
          full_name: f.full_name.value.trim() || null,
          role: f.role.value.trim() || "Admin",
          phone: f.phone.value.trim() || null,
          avatar_url: currentAvatar,
          updated_at: new Date().toISOString(),
        };
        const { error } = await supabase.from("admin_profiles").upsert(row, { onConflict: "user_id" });
        if (error) throw error;
        showMsg("Saved. Your profile updates across the admin.", true);
      } catch (err) { showMsg(err.message || "Couldn't save — please try again.", false); }
      finally { btn.disabled = false; btn.textContent = "Save changes"; }
    });
  </script>
</AdminShell>
