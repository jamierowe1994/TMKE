    .cc-modal-box { background: #fff; border-radius: 4px; width: min(440px, 100%); max-height: 100%; display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 24px 60px -20px rgba(55,30,40,.6); }
    .cc-modal-wide { width: min(980px, 100%); height: min(720px, 100%); }
