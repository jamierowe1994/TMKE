    .cc-view-pic { aspect-ratio: 4 / 5; border-radius: 2px; background: var(--linen) center / cover no-repeat; }
    .cc-view-post h3 { margin: 0 0 10px; font-family: var(--serif); font-weight: 300; font-size: 22px; line-height: 1.15; letter-spacing: -0.04em; color: var(--ink); text-transform: none; }
    .cc-view-post p { margin: 0 0 12px; color: var(--tx); white-space: pre-wrap; }
    .cc-view-post p.lbl { margin: 0 0 4px; font-size: 11px; font-weight: 500; letter-spacing: .18em; text-transform: uppercase; }
    .cc-facts { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 14px; }
    @media (max-width: 760px) { .cc-view-post { grid-template-columns: minmax(0, 1fr); } }
  </style>

  <script>
    import { requireAdmin } from '../../lib/admin-gate.js';
    import { supabase } from '../../lib/supabase.js';
    import { escapeHtml as esc } from '../../lib/design-preview.js';
    import { upcomingDays } from '../../data/content-calendar.js';
    import {
      EDITIONS, editionLabel, POST_TYPES, PLATFORMS, MAX_CAPTIONS, PILLARS, weekdaysOf, MONTHS_MISSING,
    } from '../../lib/content-months.js';

    const DEV = import.meta.env.DEV;
    const $ = (id) => document.getElementById(id);
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');

    let MONTHS = [];        // every month, every edition
    let POSTS = [];         // the open month's posts
    let TPLS = new Map();   // calendar templates (and any other a post links), by id
    let CUR = null;         // the open month
    let OPEN = null;        // the post in the drawer

    const monthName = (iso) => new Date(iso + 'T12:00:00').toLocaleDateString('en-GB', { month: 'long', year: 'numeric' });
    const dayLabel = (iso) => {
      const d = new Date(iso + 'T12:00:00');
      return { day: d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }), wd: d.toLocaleDateString('en-GB', { weekday: 'short' }), weekend: d.getDay() === 0 || d.getDay() === 6 };
    };
    const typeLabel = (k) => (POST_TYPES.find((t) => t.key === k) || {}).label || k;
    const platShort = { instagram: 'IG', facebook: 'FB', linkedin: 'LI', tiktok: 'TT' };

    function saved(el, text = 'Saved') {
      el.textContent = text;
      clearTimeout(el._t);
      el._t = setTimeout(() => { el.textContent = ''; }, 2200);
    }
    function showMissing(err) {
      $('cc-loading').hidden = true;
      $('cc-missing').hidden = false;
      if (err && !MONTHS_MISSING.test(err)) $('cc-missing').innerHTML = `<p><strong>Couldn't load the Content Calendar.</strong></p><p>${esc(err)}</p>`;
    }

    // ---- Loading ----
    async function loadMonths() {
      const { data, error } = await supabase.from('content_months').select('*').order('month', { ascending: false });
      if (error) { showMissing(error.message); return false; }
      MONTHS = data || [];
      return true;
    }

    async function loadTemplates() {
      const { data, error } = await supabase.from('templates')
        .select('id, name, thumb_url, status, updated_at, canvas')
        .eq('collection', 'calendar').neq('status', 'archived')
        .order('updated_at', { ascending: false });
      TPLS = new Map();
      if (!error) (data || []).forEach((t) => TPLS.set(t.id, { ...t, calendar: true }));
    }

    async function loadPosts() {
      if (!CUR) { POSTS = []; return; }
      const { data, error } = await supabase.from('content_month_posts').select('*')
        .eq('month_id', CUR.id).order('post_date', { ascending: true, nullsFirst: false }).order('sort_order', { ascending: true });
      if (error) { alert(`Couldn't load the posts: ${error.message}`); POSTS = []; return; }
      POSTS = data || [];
      // A post can link a design that isn't a calendar one (picked before it was
      // marked); fetch those so the sheet can still show them.
      const missing = [...new Set(POSTS.map((p) => p.template_id).filter((id) => id && !TPLS.has(id)))];
      if (missing.length) {
        const { data: more } = await supabase.from('templates').select('id, name, thumb_url, status, updated_at').in('id', missing);
        (more || []).forEach((t) => TPLS.set(t.id, t));
      }
    }

    // ---- One month: the card, the steps and the table ----
    const STAGES = [[1, 'Initial planning'], [2, 'Creation'], [3, 'Captioning and guidance'], [4, 'Final checks']];
    const stageOf = () => (CUR && CUR.stage >= 1 && CUR.stage <= 4 ? CUR.stage : 1);
    const countOf = (f) => POSTS.filter(f).length;
    const hasCap = (p) => (p.captions || []).some((c) => c && c.trim());
    const thumbOf = (p) => { const t = p.template_id && TPLS.get(p.template_id); return (t && t.thumb_url) || ''; };
    const shortDate = (iso) => new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
    const GRIP = '<svg viewBox="0 0 10 16" aria-hidden="true"><circle cx="2" cy="2" r="1.5"/><circle cx="8" cy="2" r="1.5"/><circle cx="2" cy="8" r="1.5"/><circle cx="8" cy="8" r="1.5"/><circle cx="2" cy="14" r="1.5"/><circle cx="8" cy="14" r="1.5"/></svg>';

    async function openMonth(m) {
      if (CUR && CUR !== m) await saveNotes();   // typed notes stay with the month they were typed in
      CUR = m;
      if (!m) { history.replaceState(null, '', location.pathname); showTab('months'); return; }
      history.replaceState(null, '', `${location.pathname}?month=${m.month}&edition=${m.edition}`);
      await loadPosts();
      $('cc-intro').value = m.intro || '';
      showNotes();
      showView('calendar');
      renderMonth();
      renderTemplates();
      showTab('build');
    }

    function renderMonth() {
      const m = CUR, st = stageOf();
      const live = m.status === 'published';
      const withDesign = POSTS.filter((p) => p.template_id).length;
      const first = POSTS.find((p) => thumbOf(p));
      const img = m.image_url || (first && thumbOf(first)) || '';
      $('cc-banner').style.backgroundImage = img ? `url("${img.replace(/"/g, '%22')}")` : 'none';
      $('cc-title').textContent = monthName(m.month);
      $('cc-pill').textContent = live ? 'Live' : 'Draft';
      $('cc-ed-tag').textContent = editionLabel(m.edition);
      $('cc-stage-tag').textContent = `Stage ${st} of 4`;
      $('cc-count').textContent = `${POSTS.length} post${POSTS.length === 1 ? '' : 's'} · ${withDesign} with a design · ${live ? (m.published_at ? `Went live ${shortDate(m.published_at)}` : 'Live') : 'Not live yet'}`;
      $('cc-stage-back').hidden = st === 1;
      $('cc-stage-next').hidden = st === 4;
      if (st < 4) $('cc-stage-next').textContent = `Next: ${STAGES[st][1]} →`;
      $('cc-about').hidden = st !== 1;
      $('cc-funnel').hidden = st !== 4;
      renderProgress();
      renderRows();
    }

    function checks() {
      const n = POSTS.length, days = new Map(occasionsFor(CUR.month).map((o) => [o.name, isoOf(o.when)]));
      const dated = POSTS.filter((p) => p.post_date);
      return [
        ['Every post has a design', countOf((p) => p.template_id), n],
        ['Every post has a caption', countOf(hasCap), n],
        ['Every post has guidance on how to edit it', countOf((p) => p.how_to_edit), n],
        ['Every reel says what to film', countOf((p) => p.post_type !== 'reel' || p.reel_prompt), n],
        ['Posts tied to a day are still on that day', countOf((p) => !p.date_tied || !days.has(p.occasion) || days.get(p.occasion) === p.post_date), n],
        ['Every post has a date', dated.length, n],
        ['Only one post on each day', new Set(dated.map((p) => p.post_date)).size, dated.length],
      ];
    }
    let DRAFTING = null;   // { done, total } while Claude is working through the month
    function renderProgress() {
      const st = stageOf(), n = POSTS.length;
      const fill = (st - 1) / (STAGES.length - 1) * 100;
      $('cc-tl').innerHTML = `<div class="cc-tl-track"><div style="width:${fill}%"></div></div>` + STAGES.map(([s, l], i) =>
        `<button type="button" class="cc-tl-step${i === 0 ? ' first' : ''}${i === STAGES.length - 1 ? ' last' : ''}${s <= st ? ' done' : ''}${s === st ? ' cur' : ''}" style="left:${i / (STAGES.length - 1) * 100}%" data-stage="${s}"><span class="cc-tl-dot"></span><span>${l}</span></button>`).join('');
      const item = (ok, t) => `<li class="${ok ? 'ok' : ''}">${esc(t)}</li>`;
      const btn = (k, l, cls) => `<button type="button" class="mbtn${cls ? ' ' + cls : ''}" data-call="${k}">${l}</button>`;
      const boards = btn('grid', 'Instagram grid') + btn('client', 'Client calendar');
      const box = (title, items, acts, hint) => `<div class="cc-call"><div><h4>${title}</h4><ul>${items.join('')}</ul>${hint ? `<p>${hint}</p>` : ''}</div><div class="cc-call-acts">${acts}</div></div>`;
      const d = countOf((p) => p.template_id), c = countOf(hasCap), h = countOf((p) => p.how_to_edit), pl = countOf((p) => p.title && p.pillar);
      const reels = countOf((p) => p.post_type === 'reel'), film = countOf((p) => p.post_type === 'reel' && p.reel_prompt);
      let html;
      if (st === 1) html = box('Initial planning', [item(!!(CUR.intro && CUR.intro.trim()), 'What the month is about'), item(n > 0 && pl === n, `${pl} of ${n} posts planned`)],
        btn('fill', 'Create calendar template') + btn('copy', 'Copy posts from') + btn('add', 'Add a post'),
        "Create calendar template gives you a blank post for every Monday to Friday, ready to fill with your ideas. Posts you've already started aren't touched.");
      else if (st === 2) html = box('Creation', [item(n > 0 && d === n, `${d} of ${n} designs linked`)], btn('design', 'Create a design') + boards);
      else if (st === 3) html = box('Captioning and guidance', [...(reels ? [item(film === reels, `${film} of ${reels} reels say what to film`)] : []), item(n > 0 && h === n, `${h} of ${n} how to edit written`), item(n > 0 && c === n, `${c} of ${n} captions written`)],
        `<button type="button" class="mbtn primary" data-call="claude-all"${DRAFTING ? ' disabled' : ''}>${DRAFTING ? `Drafting ${DRAFTING.done} of ${DRAFTING.total}` : 'Draft the empty ones with Claude'}</button>` + boards,
        "Claude reads each post's design, title and notes, then writes a first draft for you to check and edit. Anything already written stays as it is.");
      else {
        const all = checks(), ready = n > 0 && all.every(([, a, b]) => a === b), live = CUR.status === 'published';
        html = box('Final checks', all.map(([l, a, b]) => item(a === b, a === b ? l : `${l} (${b - a} to do)`)), boards + (live
          ? btn('publish', 'Back to draft')
          : `<button type="button" class="mbtn primary" data-call="publish"${ready ? '' : ' disabled title="Finish the checks first"'}>Publish</button>`));
      }
      $('cc-call').innerHTML = html;
    }

    function renderRows() {
      const st = stageOf();
      const grip = () => '<td class="cc-grip-cell"><span class="cc-grip" draggable="true" title="Drag onto another day to swap them">' + GRIP + '</span></td>';
      const date = (p) => { const d = p.post_date ? dayLabel(p.post_date) : null; return `<td class="cc-date">${d ? `${esc(d.day)}<small>${esc(d.wd)}</small>` : '<span class="cc-none">No date</span>'}</td>`; };
      const thumb = (p) => { const t = p.template_id ? TPLS.get(p.template_id) : null; return `<td>${t ? `<span class="cc-thumb" style="background-image:url('${esc(t.thumb_url || '')}')"></span>` : '<span class="cc-thumb is-none">+</span>'}</td>`; };
      const post = (p) => `<td>${p.title ? esc(p.title) : '<span class="cc-none">Untitled</span>'}</td>`;
      const type = (p) => `<td class="tx">${esc(typeLabel(p.post_type))}</td>`;
      const pillar = (p) => `<td class="tx">${p.pillar ? esc(p.pillar) : '—'}</td>`;
      const state = (ok, yes, no) => `<td><span class="chip ${ok ? 'good' : 'wait'}">${ok ? yes : no}</span></td>`;
      const cap = (p) => { const c = (p.captions || []).find((x) => x && x.trim()); return `<td class="cc-clip">${c ? esc(c) : 'No caption yet'}</td>`; };
      const LAYOUT = {
        1: [['', 'Date', 'Post', 'Type', 'Pillar', 'Tied to a day', 'Note'], (p) => grip() + date(p) + post(p) + type(p) + pillar(p) + `<td class="tx">${p.date_tied ? esc(p.occasion || 'Yes') : '—'}</td><td class="cc-clip">${p.note ? esc(p.note) : '—'}</td>`],
        2: [['', 'Date', 'Design', 'Post', 'Type', 'Status'], (p) => grip() + date(p) + thumb(p) + post(p) + type(p) + state(p.template_id, 'Design linked', 'To design')],
        3: [['', 'Date', 'Design', 'Post', 'What to film', 'How to edit', 'Caption'], (p) => grip() + date(p) + thumb(p) + post(p) + (p.post_type === 'reel' ? state(p.reel_prompt, 'Written', 'To write') : '<td class="tx">Not a reel</td>') + state(p.how_to_edit, 'Written', 'To write') + cap(p)],
        4: [['', 'Date', 'Design', 'Post', 'Type', 'Pillar', 'Caption'], (p) => grip() + date(p) + thumb(p) + post(p) + type(p) + pillar(p) + cap(p)],
      }[st];
      $('cc-head').innerHTML = LAYOUT[0].map((h, i) => i === 0 ? '<th aria-label="Move"></th>' : `<th>${h}</th>`).join('');
      $('cc-rows').innerHTML = POSTS.map((p) => `<tr data-id="${p.id}" class="${OPEN && OPEN.id === p.id ? 'is-open' : ''}">${LAYOUT[1](p)}</tr>`).join('')
        || `<tr><td colspan="${LAYOUT[0].length}" class="cc-none">No posts yet. Click <strong style="font-weight:400">Create calendar template</strong> at Initial planning for a post on every Monday to Friday.</td></tr>`;
    }

    async function setStage(n) {
      if (!CUR || n === stageOf()) return;
      const m = CUR, was = m.stage;
      m.stage = n;
      renderMonth();
      const { error } = await supabase.from('content_months').update({ stage: n }).eq('id', m.id);
      if (error) { m.stage = was; if (m === CUR) renderMonth(); alert(`Couldn't save the step: ${error.message}`); }
    }

    function renderTemplates() {
      if (!CUR) return;
      const card = (p) => {
        const d = p.post_date ? dayLabel(p.post_date) : null, when = d ? `${d.wd} ${d.day}` : 'No date';
        const t = p.template_id ? TPLS.get(p.template_id) : null;
        return `<button type="button" class="cc-card${t ? '' : ' is-empty'}" data-open-post="${p.id}"><div class="cc-card-img" style="${t && t.thumb_url ? `background-image:url('${esc(t.thumb_url)}')` : ''}">${t ? '' : '+ Add a design'}</div><div class="cc-card-b"><div>${esc(p.title || (t && t.name) || 'No design yet')}</div><div class="cc-card-m">${esc(when)}</div></div></button>`;
      };
      const withDesign = POSTS.filter((p) => p.template_id).length;
      $('cc-tpl-count').textContent = `${withDesign} of ${POSTS.length} posts have a design`;
      $('cc-grid').innerHTML = POSTS.map(card).join('') || '<p class="cc-note">No posts yet.</p>';
      const short = CUR.shortlist || [];
      $('cc-short-n').textContent = String(short.length);
      $('cc-short').innerHTML = short.map((id) => {
        const t = TPLS.get(id);
        return `<div class="cc-card" style="cursor:default"><div class="cc-card-img" style="${t && t.thumb_url ? `background-image:url('${esc(t.thumb_url)}')` : ''}"></div><div class="cc-card-b"><div>${esc((t && t.name) || 'Untitled')}</div></div><div class="cc-card-f"><button type="button" class="mbtn" data-short-rm="${esc(id)}">Remove</button></div></div>`;
      }).join('') || '<p class="cc-note">Nothing shortlisted yet.</p>';
    }
    async function saveShortlist(next) {
      const m = CUR, was = m.shortlist;
      m.shortlist = next;
      renderTemplates();
      const { error } = await supabase.from('content_months').update({ shortlist: next }).eq('id', m.id);
      if (error) { m.shortlist = was; renderTemplates(); alert(`Couldn't save the shortlist: ${error.message}`); }
    }

    function showView(v) {
      document.querySelectorAll('#cc-views [data-view]').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === v)));
      $('cc-view-calendar').hidden = v !== 'calendar';
      $('cc-view-templates').hidden = v !== 'templates';
      $('cc-view-notes').hidden = v !== 'notes';
    }

    // ---- The Instagram grid and the Client calendar ----
    let BOARD = null, BOARD_POST = null;
    function openBoard(kind) { BOARD = kind; BOARD_POST = null; renderBoard(); $('cc-board').hidden = false; }
    function typeIcon(t) {
      if (t === 'carousel') return '<svg class="cc-ig-type" viewBox="0 0 16 16" fill="#fff" stroke="#371e28" stroke-width="1" aria-label="Carousel"><rect x="5" y="1" width="10" height="10" rx="1.5"/><rect x="1" y="5" width="10" height="10" rx="1.5"/></svg>';
      if (t === 'reel') return '<svg class="cc-ig-type" viewBox="0 0 16 16" fill="#fff" stroke="#371e28" stroke-width="1" aria-label="Reel"><path d="M3 1.5v13l11-6.5z"/></svg>';
      return '';
    }
    function renderBoard() {
      const box = $('cc-board-box'), b = $('cc-board-b');
      box.className = `cc-modal-box ${BOARD === 'grid' ? 'is-grid' : 'is-client'}`;
      if (BOARD === 'grid') {
        $('cc-board-title').textContent = 'Instagram grid';
        // Newest first, top left, the way a feed shows it.
        const list = POSTS.filter((p) => p.post_date && (p.platforms || []).includes('instagram')).slice().sort((x, y) => y.post_date.localeCompare(x.post_date) || y.sort_order - x.sort_order);
        b.innerHTML = list.length ? `<div class="cc-ig-grid">${list.map((p) => { const img = thumbOf(p), d = dayLabel(p.post_date);
          return img
            ? `<button type="button" class="cc-ig-tile" draggable="true" data-id="${p.id}" title="${esc(d.wd + ' ' + d.day)}" style="background-image:url('${esc(img)}')">${typeIcon(p.post_type)}</button>`
            : `<button type="button" class="cc-ig-tile none" draggable="true" data-id="${p.id}"><span>${esc(d.day)}</span><span>No design yet</span></button>`; }).join('')}</div>` : '<p class="cc-note">No posts for Instagram yet.</p>';
        return;
      }
      $('cc-board-title').textContent = 'Client calendar';
      if (BOARD_POST) {
        const p = BOARD_POST, img = thumbOf(p), d = p.post_date ? dayLabel(p.post_date) : null, cap = (p.captions || []).find((c) => c && c.trim());
        const part = (l, v) => (v ? `<p class="lbl">${l}</p><p>${esc(v)}</p>` : '');
        b.innerHTML = `<div style="margin:0 0 12px"><button type="button" class="mbtn" data-board-back>Back to the calendar</button></div><div class="cc-view-post"><div class="cc-view-pic" style="${img ? `background-image:url('${esc(img)}')` : ''}"></div><div><h3>${esc(p.title || 'Post')}</h3><div class="cc-facts">${d ? `<span class="chip plain">${esc(d.wd + ' ' + d.day)}</span>` : ''}<span class="chip plain">${esc(typeLabel(p.post_type))}</span>${p.pillar ? `<span class="chip plain">${esc(p.pillar)}</span>` : ''}</div>${p.post_type === 'reel' ? part('What to film', p.reel_prompt) : ''}${part('How to edit', p.how_to_edit)}${part('Caption', cap)}</div></div>`;
        return;
      }
      const [y, m] = CUR.month.split('-').map(Number), lead = (new Date(y, m - 1, 1).getDay() + 6) % 7, last = new Date(y, m, 0).getDate();
      const byDate = new Map(); POSTS.forEach((p) => { if (p.post_date && !byDate.has(p.post_date)) byDate.set(p.post_date, p); });
      let cells = '<div class="cc-cal-day other"></div>'.repeat(lead);
      for (let n = 1; n <= last; n++) {
        const iso = `${y}-${String(m).padStart(2, '0')}-${String(n).padStart(2, '0')}`, p = byDate.get(iso), img = p && thumbOf(p);
        cells += `<div class="cc-cal-day${img ? ' has' : ''}"><span class="cc-cal-num">${n}</span>${img ? `<button type="button" class="cc-cal-post" data-view-post="${p.id}" aria-label="${esc(p.title || 'Post')}" style="background-image:url('${esc(img)}')"></button>` : ''}</div>`;
      }
      const name = new Date(CUR.month + 'T12:00:00').toLocaleDateString('en-GB', { month: 'long' });
      b.innerHTML = `<div class="cc-cal-note"><p><strong>${esc(name)}'s posts.</strong> One for each weekday. Click a post to see it full size.</p><span class="chip plain">Preview: what members will see</span></div><div class="cc-cal-in"><div class="cc-cal-head"><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span></div><div class="cc-cal-grid">${cells}</div></div>`;
    }
    $('cc-board-b').addEventListener('click', (e) => {
      if (e.target.closest('[data-board-back]')) { BOARD_POST = null; renderBoard(); return; }
      const v = e.target.closest('[data-view-post]');
      if (v) { BOARD_POST = POSTS.find((p) => p.id === v.dataset.viewPost) || null; renderBoard(); return; }
      const t = e.target.closest('.cc-ig-tile[data-id]');
      if (t) { const p = POSTS.find((x) => x.id === t.dataset.id); if (p) { $('cc-board').hidden = true; openDrawer(p); } }
    });

    // ---- Claude drafts the words (Dani, 9 Nov). It never overwrites what's written. ----
    async function draftWords(p) {
      const { data: { session } } = await supabase.auth.getSession();
      const res = await fetch(`${WORKER}/calendar/draft-words`, { method: 'POST', headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${session.access_token}` }, body: JSON.stringify({ post_id: p.id }) });
      const d = await res.json().catch(() => ({}));
      if (!res.ok) throw new Error(d.error || "Claude couldn't draft that one.");
      return d;
    }
    async function draftAll() {
      if (DRAFTING) return;
      const empty = (p) => !p.how_to_edit || !hasCap(p) || (p.post_type === 'reel' && !p.reel_prompt);
      const todo = POSTS.filter((p) => p.template_id && empty(p)), skipped = countOf((p) => !p.template_id);
      if (!todo.length) { alert(skipped ? `Nothing to draft. ${skipped} post${skipped === 1 ? " has" : "s have"} no design yet, and Claude needs the design to read.` : 'Every post already has its words.'); return; }
      if (!confirm(`Claude will draft the empty words on ${todo.length} post${todo.length === 1 ? '' : 's'}. Anything already written stays as it is.${skipped ? ` ${skipped} with no design yet will be skipped.` : ''}`)) return;
      DRAFTING = { done: 0, total: todo.length };
      renderProgress();
      const m = CUR, failed = []; let i = 0;
      const worker = async () => {
        while (i < todo.length) {
          const p = todo[i++];
          try {
            const d = await draftWords(p), patch = {};
            if (p.post_type === 'reel' && !p.reel_prompt && d.what_to_film) patch.reel_prompt = d.what_to_film;
            if (!p.how_to_edit && d.how_to_edit) patch.how_to_edit = d.how_to_edit;
            if (!hasCap(p) && d.caption) patch.captions = [d.caption];
            if (Object.keys(patch).length) {
              const { data, error } = await supabase.from('content_month_posts').update(patch).eq('id', p.id).select('id');
              if (error || !data || !data.length) throw new Error((error && error.message) || "That post didn't save.");
              Object.assign(p, patch);
            }
          } catch (e) { failed.push(e.message); }
          DRAFTING.done++;
          if (m === CUR) { renderProgress(); renderRows(); }
        }
      };
      await Promise.all([worker(), worker(), worker()]);
      DRAFTING = null;
      if (m === CUR) renderMonth();
      if (failed.length) alert(`${failed.length} of ${todo.length} didn't draft: ${failed[0]}`);
      else saved($('cc-saved'), 'Drafted. Check and edit as you like.');
    }

    /* Notes save a second after typing stops, and when you leave the box. */
    var NOTES_T = null;   // var: openMonth can run before this line on load
    function showNotes() {
      clearTimeout(NOTES_T);
      $('cc-notes').value = (CUR && CUR.notes) || '';
      $('cc-notes-state').textContent = CUR && !('notes' in CUR) ? 'Notes save once supabase/content_calendar_notes.sql has run.' : '';
    }
    async function saveNotes() {
      clearTimeout(NOTES_T);
      if (!CUR) return;
      const notes = $('cc-notes').value.trim() ? $('cc-notes').value : null;
      if ((CUR.notes || null) === notes) return;
      const m = CUR;
      $('cc-notes-state').textContent = 'Saving…';
      const { error } = await supabase.from('content_months').update({ notes }).eq('id', m.id);
      if (error) {
        $('cc-notes-state').textContent = /notes/.test(error.message) ? 'Not saved: run supabase/content_calendar_notes.sql first.' : `Not saved: ${error.message}`;
        return;
      }
      m.notes = notes;
      if (m === CUR) saved($('cc-notes-state'));
    }
    $('cc-notes').addEventListener('input', () => { clearTimeout(NOTES_T); NOTES_T = setTimeout(saveNotes, 1000); });
    $('cc-notes').addEventListener('blur', saveNotes);
    $('cc-views').addEventListener('click', (e) => { const b = e.target.closest('[data-view]'); if (b) showView(b.dataset.view); });
    $('cc-grid').addEventListener('click', (e) => {
      const b = e.target.closest('[data-open-post]');
      if (!b) return;
      const p = POSTS.find((x) => x.id === b.dataset.openPost);
      if (p) openDrawer(p);
    });

    // ---- The drawer ----
    function occasionsFor(month) {
      const [y, m] = month.split('-').map(Number);
      const days = upcomingDays(new Date(y, m - 1, 1), 60).filter((d) => d.when.getMonth() === m - 1 && d.when.getFullYear() === y);
      return days;
    }

    function drawerHead(p) { return [p.post_date ? `${dayLabel(p.post_date).wd} ${dayLabel(p.post_date).day}` : 'Post', p.title].filter(Boolean).join(' · '); }
    // Each step shows only its own fields. A field that's hidden keeps its value.
    function syncStageFields() {
      const st = String(stageOf());
      document.querySelectorAll('#cc-drawer [data-in]').forEach((el) => { el.hidden = !el.dataset.in.includes(st); });
      $('cc-d-film-wrap').hidden = !((st === '3' || st === '4') && $('cc-d-type').value === 'reel');
    }
    function openDrawer(p) {
      OPEN = p;
      renderRows();
      const at = POSTS.findIndex((x) => x.id === p.id);
      $('cc-d-prev').disabled = at <= 0;
      $('cc-d-next').disabled = at < 0 || at >= POSTS.length - 1;
      $('cc-d-head').textContent = drawerHead(p);
      const [y, m] = CUR.month.split('-').map(Number);
      const last = new Date(Date.UTC(y, m, 0)).toISOString().slice(0, 10);
      $('cc-d-date').min = CUR.month; $('cc-d-date').max = last;
      $('cc-d-date').value = p.post_date || '';
      $('cc-d-type').value = p.post_type || 'single';
      $('cc-d-tied').checked = !!p.date_tied;
      $('cc-d-occ').value = p.occasion || '';
      $('cc-occasions').innerHTML = occasionsFor(CUR.month).map((d) => `<option value="${esc(d.name)}">${esc(d.when.toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }))}</option>`).join('');
      syncTied();
      $('cc-d-title').value = p.title || '';
      // A pillar typed before the list existed stays as an option, so it's never lost.
      $('cc-d-pillar').innerHTML = '<option value="">Choose a pillar</option>' + [...new Set([...PILLARS, ...(p.pillar ? [p.pillar] : [])])].map((x) => `<option value="${esc(x)}">${esc(x)}</option>`).join('');
      $('cc-d-pillar').value = p.pillar || '';
      $('cc-d-note').value = p.note || '';
      document.querySelectorAll('.cc-cap').forEach((ta, i) => { ta.value = (p.captions || [])[i] || ''; });
      $('cc-d-how').value = p.how_to_edit || '';
      $('cc-d-reel').value = p.reel_prompt || '';
      document.querySelectorAll('#cc-d-plats input').forEach((cb) => { cb.checked = (p.platforms || []).includes(cb.value); });
      renderDrawerTemplate();
      syncStageFields();
      $('cc-shade').hidden = false;
      $('cc-drawer').hidden = false;
    }
    function closeDrawer() {
      flushSave();
      OPEN = null;
      $('cc-shade').hidden = true;
      $('cc-drawer').hidden = true;
      renderRows();
    }
    function syncTied() {
      const tied = $('cc-d-tied').checked;
      $('cc-d-occ-wrap').hidden = !tied;
      $('cc-d-occ-hint').hidden = !tied;
      $('cc-d-occ-name').textContent = $('cc-d-occ').value.trim() || 'that day';
    }
    function renderDrawerTemplate() {
      const t = OPEN.template_id ? TPLS.get(OPEN.template_id) : null;
      $('cc-d-tpl').innerHTML = t
        ? `<div class="cc-thumb" style="${t.thumb_url ? `background-image:url('${esc(t.thumb_url)}')` : ''}"></div>
           <div class="cc-d-tpl-b"><span>${esc(t.name || 'Untitled')}</span>
           <div class="cc-d-tpl-acts"><button type="button" class="mbtn" data-act="pick">Change</button>
           <button type="button" class="mbtn" data-act="open">Open in the Studio</button>
           <button type="button" class="mbtn" data-act="unlink">Remove</button></div></div>`
        : `<div class="cc-thumb is-none">+</div>
           <div class="cc-d-tpl-b">No design yet
           <div class="cc-d-tpl-acts"><button type="button" class="mbtn" data-act="pick">Choose a design</button>
           <button type="button" class="mbtn" data-act="new">Create a design</button></div></div>`;
    }

    /* A design used in another month gets its own copy the first time it's
       opened here, so last month's stays exactly as it was (Dani, 9 Nov). */
    async function openDesign(post) {
      await flushSave();
      let id = post.template_id;
      const { data: others, error } = await supabase.from('content_month_posts').select('id').eq('template_id', id).neq('month_id', CUR.id).limit(1);
      if (error) { alert(`Couldn't open the design: ${error.message}`); return; }
      if (others && others.length) {
        const copy = await copyIntoCalendar(id, monthName(CUR.month));
        if (!copy) return;
        const { error: e2 } = await supabase.from('content_month_posts').update({ template_id: copy }).eq('id', post.id);
        if (e2) { alert(`The copy was made, but couldn't be linked to this post: ${e2.message}`); return; }
        post.template_id = copy;
        id = copy;
      }
      location.href = `/account/editor?id=${encodeURIComponent(id)}&mode=admin`;
    }

    // Read the drawer into a patch for the open post.
    function drawerPatch() {
      return {
        post_date: $('cc-d-date').value || null,
        post_type: $('cc-d-type').value,
        date_tied: $('cc-d-tied').checked,
        occasion: $('cc-d-occ').value.trim() || null,   // kept when not tied, so opening a post never changes it
        title: $('cc-d-title').value.trim() || null,
        pillar: $('cc-d-pillar').value.trim() || null,
        captions: [...document.querySelectorAll('.cc-cap')].map((ta) => ta.value.trim()).filter(Boolean).slice(0, MAX_CAPTIONS),
        how_to_edit: $('cc-d-how').value.trim() || null,
        note: $('cc-d-note').value.trim() || null,
        reel_prompt: $('cc-d-reel').value.trim() || null,
        platforms: [...document.querySelectorAll('#cc-d-plats input:checked')].map((cb) => cb.value),
      };
    }

    function sortPosts() {
      POSTS.sort((a, b) => String(a.post_date || '9999').localeCompare(String(b.post_date || '9999')) || a.sort_order - b.sort_order);
    }

    // ---- Moving a post (Danielle, 9 Nov 2026): drag a row by its handle, or a
    // square in the Instagram grid, onto another day and the two swap days.
    // Everything else stays where it is. ----
    async function swapPosts(a, b) {
      const tied = [a, b].filter((p) => p.date_tied);
      if (tied.length && !confirm(tied.map((p) => `"${p.title || 'This post'}" is tied to ${p.occasion || 'its day'}.`).join(' ') + ' Move it anyway?')) return;
      const slot = (p) => ({ post_date: p.post_date, sort_order: p.sort_order });
      const wasA = slot(a), wasB = slot(b);
      Object.assign(a, wasB); Object.assign(b, wasA);
      const redraw = () => { sortPosts(); renderMonth(); renderTemplates(); if (BOARD && !$('cc-board').hidden) { const y = $('cc-board-b').scrollTop; renderBoard(); $('cc-board-b').scrollTop = y; } };
      redraw();
      const save = async (p, patch) => {
        // .select() so a save the database turned down can't look like it worked.
        const { data, error } = await supabase.from('content_month_posts').update(patch).eq('id', p.id).select('id');
        return !error && data && data.length > 0;
      };
      const firstOk = await save(a, wasB);
      const bothOk = firstOk && await save(b, wasA);
      if (!bothOk) {
        if (firstOk) await save(a, wasA);   // never leave two posts on one day by halves
        await loadPosts();
        redraw();
        alert("Couldn't move the post. Nothing has changed, please try again.");
        return;
      }
      saved($('cc-saved'), 'Moved');
    }

    let DRAG = null;
    const DROP = '#cc-rows tr[data-id], .cc-ig-tile[data-id]';
    const clearDrop = () => document.querySelectorAll('#ccb .is-drop').forEach((r) => r.classList.remove('is-drop'));
    $('ccb').addEventListener('dragstart', (e) => {
      const h = e.target.closest && e.target.closest('.cc-grip, .cc-ig-tile[data-id]');
      if (!h) return;
      const el = h.closest(DROP);
      if (!el) { e.preventDefault(); return; }
      DRAG = POSTS.find((p) => p.id === el.dataset.id) || null;
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', el.dataset.id);
      e.dataTransfer.setDragImage(el, 16, 20);
      el.classList.add('is-dragging');
    });
    $('ccb').addEventListener('dragover', (e) => {
      if (!DRAG) return;
      // Scrolls by itself near the top and bottom, so any day can be reached.
      const pane = !$('cc-board').hidden ? $('cc-board-b') : document.querySelector('.ash-content');
      if (pane) {
        const r = pane.getBoundingClientRect();
        if (e.clientY < r.top + 70) pane.scrollTop -= 14;
        else if (e.clientY > r.bottom - 70) pane.scrollTop += 14;
      }
      const t = e.target.closest && e.target.closest(DROP);
      clearDrop();
      if (!t || t.dataset.id === DRAG.id) return;
      e.preventDefault();
      e.dataTransfer.dropEffect = 'move';
      t.classList.add('is-drop');
    });
    $('ccb').addEventListener('drop', (e) => {
      const t = e.target.closest && e.target.closest(DROP);
      const from = DRAG, to = t && POSTS.find((p) => p.id === t.dataset.id);
      if (!from || !to || from === to) return;
      e.preventDefault();
      swapPosts(from, to);
    });
    $('ccb').addEventListener('dragend', () => {
      DRAG = null; clearDrop();
      document.querySelectorAll('#ccb .is-dragging').forEach((r) => r.classList.remove('is-dragging'));
    });

    let saveTimer = null;
    function queueSave() {
      clearTimeout(saveTimer);
      saveTimer = setTimeout(flushSave, 600);
    }
    async function flushSave() {
      clearTimeout(saveTimer); saveTimer = null;
      if (!OPEN) return;
      const patch = drawerPatch();
      const changed = Object.keys(patch).some((k) => JSON.stringify(patch[k]) !== JSON.stringify(OPEN[k] ?? (Array.isArray(patch[k]) ? [] : null)));
      if (!changed) return;
      const post = OPEN;
      Object.assign(post, patch);
      const { error } = await supabase.from('content_month_posts').update(patch).eq('id', post.id);
      if (error) { alert(`Couldn't save the post: ${error.message}`); return; }
      saved($('cc-d-saved'));
      if ('post_date' in patch) sortPosts();
      if (OPEN === post) $('cc-d-head').textContent = drawerHead(post);
      renderMonth();
    }

    async function setTemplate(id) {
      if (!OPEN) return;
      const { error } = await supabase.from('content_month_posts').update({ template_id: id }).eq('id', OPEN.id);
      if (error) { alert(`Couldn't link the design: ${error.message}`); return; }
      OPEN.template_id = id;
      renderDrawerTemplate();
      renderMonth();
      renderTemplates();
    }

    // ---- Choosing a design ----
    /* The rest of the Studio's templates, for a post whose design already
       exists (Danielle, 28 Oct). Picking one copies it into the calendar, so
       the original never leaves its pack or the Templates tab. */
    let PICK_SRC = 'calendar';
    let ALL_TPLS = null;
    const PRINT_SIZES = new Set(['2551x3579', '3579x2551', '1819x2551', '2551x1819', '1075x720', '1311x1819']);
    async function loadAllTemplates() {
      if (ALL_TPLS) return;
      $('cc-pick-grid').innerHTML = '<p class="cc-note">Loading the templates…</p>';
      const { data } = await supabase.from('templates').select('id, name, thumb_url, canvas, kind, status, collection, updated_at')
        .neq('status', 'archived').order('updated_at', { ascending: false }).range(0, 1999);
      ALL_TPLS = (data || []).filter((t) => t.collection !== 'calendar' && t.kind !== 'block' && !(t.canvas && t.canvas.mockup)
        && !PRINT_SIZES.has(Math.round((t.canvas || {}).width) + 'x' + Math.round((t.canvas || {}).height)));
    }
    async function copyIntoCalendar(srcId, forMonth) {
      const FULL = 'id, name, category, thumb_url, render_url, canvas, elements, pages, size_variants';
      let { data: src, error } = await supabase.from('templates').select(FULL).eq('id', srcId).maybeSingle();
      if (error) ({ data: src, error } = await supabase.from('templates').select('id, name, category, thumb_url, canvas, elements, pages').eq('id', srcId).maybeSingle());
      if (error || !src) { alert(`Couldn't copy that template: ${error ? error.message : 'not found'}`); return null; }
      const id = 'tmpl-' + Math.random().toString(36).slice(2, 8);
      const name = forMonth ? `${String(src.name || 'Untitled').replace(/ [–-] [A-Z][a-z]+ \d{4}$/, '')} – ${forMonth}` : src.name;
      const row = { ...src, id, name, status: 'draft', sort_order: 9000, collection: 'calendar', pack_id: null };
      const { error: e2 } = await supabase.from('templates').insert(row);
      if (e2) { alert(`Couldn't copy that template: ${e2.message}`); return null; }
      TPLS.set(id, { id, name, thumb_url: src.thumb_url, status: 'draft', updated_at: new Date().toISOString(), calendar: true });
      return id;
    }
    $('cc-pick-src').addEventListener('click', async (e) => {
      const b = e.target.closest('[data-src]');
      if (!b) return;
      PICK_SRC = b.dataset.src;
      document.querySelectorAll('#cc-pick-src [data-src]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      $('cc-pick-note').hidden = PICK_SRC !== 'all';
      if (PICK_SRC === 'all') await loadAllTemplates();
      renderPicker();
    });

    /* One picker, three jobs: a design for a post, the month's shortlist, the month's image. */
    let PICK_MODE = 'post';
    function openPicker(mode = 'post') {
      PICK_MODE = mode;
      if (mode !== 'post') PICK_SRC = 'calendar';
      $('cc-pick-title').textContent = { post: 'Choose a design', short: 'Add to the shortlist', image: 'Choose a month image' }[mode];
      $('cc-pick-src').hidden = mode !== 'post';
      $('cc-pick-note').hidden = mode !== 'post' || PICK_SRC !== 'all';
      $('cc-pick-q').value = '';
      renderPicker();
      $('cc-pick').hidden = false;
      $('cc-pick-q').focus();
    }
    function renderPicker() {
      const q = $('cc-pick-q').value.trim().toLowerCase();
      const tile = (t, attr, on) => `<button type="button" ${attr} class="${on ? 'is-on' : ''}"><div class="cc-card-img" style="${t.thumb_url ? `background-image:url('${esc(t.thumb_url)}')` : ''}"></div><span>${esc(t.name || 'Untitled')}</span></button>`;
      if (PICK_MODE === 'image') {
        const list = [...new Set(POSTS.map((p) => p.template_id).filter(Boolean))].map((id) => TPLS.get(id)).filter((t) => t && t.thumb_url && (!q || (t.name || '').toLowerCase().includes(q)));
        $('cc-pick-grid').innerHTML = `<button type="button" class="cc-pick-new" data-img="">Use the month's first design</button>` + list.map((t) => tile(t, `data-img="${esc(t.thumb_url)}"`, CUR.image_url === t.thumb_url)).join('');
        return;
      }
      const short = (CUR && CUR.shortlist) || [];
      const all = PICK_MODE === 'post' && PICK_SRC === 'all';
      const pool = all ? (ALL_TPLS || []) : [...TPLS.values()].filter((t) => t.calendar);
      let list = pool.filter((t) => !q || (t.name || '').toLowerCase().includes(q));
      if (!all && PICK_MODE === 'post') list = [...list.filter((t) => short.includes(t.id)), ...list.filter((t) => !short.includes(t.id))];   // the shortlist first
      if (PICK_MODE === 'short') { $('cc-pick-grid').innerHTML = list.map((t) => tile(t, `data-short="${esc(t.id)}"`, short.includes(t.id))).join('') || '<p class="cc-note">No Content Calendar designs yet.</p>'; return; }
      $('cc-pick-grid').innerHTML = (all ? '' : '<button type="button" class="cc-pick-new" data-new>+ Create a design</button>') + list.map((t) => tile(t, `data-pick="${esc(t.id)}" ${all ? 'data-copy' : ''}`, OPEN && OPEN.template_id === t.id)).join('');
    }

    // ---- New template ----
    let NEW_FOR = null;   // the post a new template is drawn for, if any
    function openNewTemplate(forPost) {
      NEW_FOR = forPost || null;
      const nm = forPost
        ? [CUR ? monthName(CUR.month) : '', forPost.title || forPost.occasion || ''].filter(Boolean).join(' – ')
        : (CUR ? monthName(CUR.month) + ' – ' : '');
      $('cc-newtpl-name').value = nm;
      $('cc-newtpl-for').hidden = !forPost;
      if (forPost) $('cc-newtpl-for').textContent = `It's linked to the ${forPost.post_date ? dayLabel(forPost.post_date).day : 'open'} post straight away.`;
      $('cc-newtpl').hidden = false;
      $('cc-newtpl-name').focus();
    }
    async function createTemplate() {
      const name = $('cc-newtpl-name').value.trim();
      if (!name) { $('cc-newtpl-name').focus(); return; }
      const id = 'tmpl-' + Math.random().toString(36).slice(2, 8);
      const btn = $('cc-newtpl-go');
      btn.disabled = true;
      const { error } = await supabase.from('templates').insert({
        id, name, category: null, thumb_url: null,
        canvas: { width: 1080, height: 1350, background: '#f4f2f1', sizeChosen: true },
        elements: [], status: 'draft', sort_order: 9000, collection: 'calendar',
      });
      btn.disabled = false;
      if (error) { alert(`Couldn't create the template: ${error.message}`); return; }
      if (NEW_FOR) {
        const { error: e2 } = await supabase.from('content_month_posts').update({ template_id: id }).eq('id', NEW_FOR.id);
        if (e2) { alert(`The template was made, but couldn't be linked to the post: ${e2.message}`); }
      }
      location.href = `/account/editor?id=${encodeURIComponent(id)}&mode=admin&title=${encodeURIComponent(name)}`;
    }

    // ---- Months ----
    function openNewMonth() {
      const ed = $('cc-edition').value;
      // The first month from this one that this edition hasn't got.
      const have = new Set(MONTHS.filter((m) => m.edition === ed).map((m) => m.month));
      const d = new Date(); d.setDate(1);
      let iso = todayMonth();
      for (let i = 0; i < 24 && have.has(iso); i++) { d.setMonth(d.getMonth() + 1); iso = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-01`; }
      $('cc-new-m').value = iso.slice(0, 7);
      $('cc-new-e').value = ed;
      $('cc-new').hidden = false;
    }
    const todayMonth = () => { const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-01`; };
    async function createMonth() {
      const mv = $('cc-new-m').value, ed = $('cc-new-e').value;
      if (!mv) return;
      const month = mv + '-01';
      const existing = MONTHS.find((m) => m.month === month && m.edition === ed);
      $('cc-new').hidden = true;
      $('cc-edition').value = ed;
      if (existing) { await openMonth(existing); return; }
      const { data, error } = await supabase.from('content_months').insert({ month, edition: ed }).select().single();
      if (error) { alert(`Couldn't create the month: ${error.message}`); return; }
      MONTHS.push(data);
      await openMonth(data);
      if ($('cc-new-fill').checked) await fillWeekdays(true);
    }

    async function fillWeekdays(quiet) {
      if (!CUR) return;
      const have = new Set(POSTS.map((p) => p.post_date));
      const days = weekdaysOf(CUR.month).filter((d) => !have.has(d));
      if (!days.length) { if (!quiet) alert('Every weekday this month already has a post.'); return; }
      if (!quiet && !confirm(`Add a blank post to ${days.length} weekday${days.length === 1 ? '' : 's'} with nothing on yet? Posts you've already started aren't touched.`)) return;
      const tied = new Map(occasionsFor(CUR.month).map((o) => [isoOf(o.when), o.name]));
      const rows = days.map((d, i) => ({ month_id: CUR.id, post_date: d, sort_order: i, occasion: tied.get(d) || null }));
      const { error } = await supabase.from('content_month_posts').insert(rows);
      if (error) { alert(`Couldn't add the posts: ${error.message}`); return; }
      await loadPosts();
      renderMonth(); renderTemplates();
    }
    const isoOf = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

    async function addPost() {
      if (!CUR) return;
      const { data, error } = await supabase.from('content_month_posts')
        .insert({ month_id: CUR.id, sort_order: POSTS.length }).select().single();
      if (error) { alert(`Couldn't add a post: ${error.message}`); return; }
      POSTS.push(data);
      renderMonth();
      openDrawer(data);
    }

    async function deletePost() {
      if (!OPEN) return;
      if (!confirm('Delete this post from the month? Its design stays in the templates.')) return;
      const id = OPEN.id;
      clearTimeout(saveTimer);
      OPEN = null;
      const { error } = await supabase.from('content_month_posts').delete().eq('id', id);
      if (error) { alert(`Couldn't delete the post: ${error.message}`); return; }
      POSTS = POSTS.filter((p) => p.id !== id);
      $('cc-shade').hidden = true; $('cc-drawer').hidden = true;
      renderMonth(); renderTemplates();
    }

    async function togglePublish() {
      if (!CUR) return;
      const going = CUR.status !== 'published';
      if (going && !(POSTS.length && checks().every(([, a, b]) => a === b))) return;
      const status = going ? 'published' : 'draft', published_at = going ? new Date().toISOString() : null;
      const { error } = await supabase.from('content_months').update({ status, published_at }).eq('id', CUR.id);
      if (error) { alert(`Couldn't change the month: ${error.message}`); return; }
      CUR.status = status; CUR.published_at = published_at;
      // A published month's designs are live templates, so members can open them.
      if (going) {
        const ids = [...new Set(POSTS.map((p) => p.template_id).filter(Boolean))];
        if (ids.length) {
          await supabase.from('templates').update({ status: 'active' }).in('id', ids).eq('status', 'draft');
          ids.forEach((id) => { const t = TPLS.get(id); if (t && t.status === 'draft') t.status = 'active'; });
        }
      }
      renderMonth(); renderTemplates();
    }

    async function deleteMonth() {
      if (!CUR) return;
      if (!confirm(`Delete ${monthName(CUR.month)} for ${editionLabel(CUR.edition)} and its ${POSTS.length} post${POSTS.length === 1 ? '' : 's'}? The designs stay in the templates.`)) return;
      const { error } = await supabase.from('content_months').delete().eq('id', CUR.id);
      if (error) { alert(`Couldn't delete the month: ${error.message}`); return; }
      MONTHS = MONTHS.filter((m) => m.id !== CUR.id);
      CUR = null;
      await openMonth(null);
    }

    // ---- Copy posts from another month, to start from (Dani, 9 Nov) ----
    let COPY_SRC = [], COPY_FROM = null;
    function openCopy() {
      if (!CUR) return;
      const others = MONTHS.filter((m) => m.id !== CUR.id && (m.edition === CUR.edition || m.month === CUR.month))
        .sort((a, b) => (b.edition === CUR.edition) - (a.edition === CUR.edition) || b.month.localeCompare(a.month));
      if (!others.length) { alert('There are no other months to copy from yet.'); return; }
      $('cc-copy-from').innerHTML = others.map((m) => `<option value="${m.id}">${esc(monthName(m.month))} · ${esc(editionLabel(m.edition))}</option>`).join('');
      $('cc-copybox').hidden = false;
      loadCopyList();
    }
    async function loadCopyList() {
      COPY_FROM = MONTHS.find((m) => m.id === $('cc-copy-from').value) || null;
      if (!COPY_FROM) return;
      const sameEd = COPY_FROM.edition === CUR.edition;
      $('cc-copy-hint').textContent = sameEd
        ? "Tick the posts to bring across. They land on the same weekday where there's room, and their designs come with them. Opening one in the Studio makes a copy for this month, so the original stays as it was."
        : "Tick the posts to bring across. Designs don't come across, because each edition has its own.";
      $('cc-copy-words').checked = COPY_FROM.month === CUR.month;
      $('cc-copy-list').innerHTML = '<p class="cc-note">Reading the posts.</p>';
      const { data, error } = await supabase.from('content_month_posts').select('*').eq('month_id', COPY_FROM.id)
        .order('post_date', { ascending: true }).order('sort_order', { ascending: true });
      if (error) { $('cc-copy-list').innerHTML = `<p class="cc-note">Couldn't read those posts: ${esc(error.message)}</p>`; return; }
      COPY_SRC = data || [];
      $('cc-copy-list').innerHTML = COPY_SRC.map((p, i) => { const d = p.post_date ? dayLabel(p.post_date) : null;
        return `<label><input type="checkbox" data-copy-i="${i}"><span>${d ? esc(d.wd + ' ' + d.day) : 'No date'}</span><span>${esc(p.title || 'Untitled')}</span><span>${esc(typeLabel(p.post_type))}</span></label>`; }).join('') || '<p class="cc-note">That month has no posts.</p>';
    }
    async function copyPosts() {
      const chosen = [...document.querySelectorAll('#cc-copy-list input:checked')].map((c) => COPY_SRC[Number(c.dataset.copyI)]);
      if (!COPY_FROM || !chosen.length) { alert('Tick at least one post to copy.'); return; }
      const sameMonth = COPY_FROM.month === CUR.month, sameEd = COPY_FROM.edition === CUR.edition, words = $('cc-copy-words').checked;
      // Only an empty post can be filled. Anything already started is never touched.
      const isBlank = (p) => !p.title && !hasCap(p) && !p.template_id && !p.note && !p.how_to_edit;
      const blanks = new Map(POSTS.filter((p) => p.post_date && isBlank(p)).map((p) => [p.post_date, p]));
      const taken = new Set(POSTS.filter((p) => p.post_date && !isBlank(p)).map((p) => p.post_date));
      const srcDays = weekdaysOf(COPY_FROM.month), days = weekdaysOf(CUR.month);
      const dayFor = (p) => {
        if (sameMonth && p.post_date && !taken.has(p.post_date)) return p.post_date;
        const at = Math.max(srcDays.indexOf(p.post_date), 0);
        return [...days.slice(at), ...days.slice(0, at)].find((d) => !taken.has(d)) || null;
      };
      const fields = (p) => ({
        post_type: p.post_type, title: p.title, pillar: p.pillar, note: p.note, platforms: p.platforms,
        date_tied: sameMonth ? p.date_tied : false, occasion: sameMonth ? p.occasion : null,
        ...(sameEd ? { template_id: p.template_id } : {}),
        ...(words ? { captions: p.captions, how_to_edit: p.how_to_edit, reel_prompt: p.reel_prompt } : {}),
      });
      const inserts = [];
      for (const p of chosen) {
        const d = dayFor(p);
        if (d) taken.add(d);
        const blank = d && blanks.get(d);
        if (blank) {
          const { error: e } = await supabase.from('content_month_posts').update(fields(p)).eq('id', blank.id);
          if (e) { alert(`Couldn't copy a post: ${e.message}`); await loadPosts(); renderMonth(); renderTemplates(); return; }
        } else inserts.push({ ...fields(p), post_date: d, month_id: CUR.id, sort_order: p.sort_order });
      }
      if (inserts.length) {
        const { error: e } = await supabase.from('content_month_posts').insert(inserts);
        if (e) { alert(`Couldn't copy the posts: ${e.message}`); await loadPosts(); renderMonth(); renderTemplates(); return; }
      }
      $('cc-copybox').hidden = true;
      await loadPosts();
      renderMonth(); renderTemplates();
      saved($('cc-saved'), `${chosen.length} copied`);
    }

    // ---- Wiring ----
    let lastCap = null;
    document.querySelectorAll('.cc-cap').forEach((ta) => ta.addEventListener('focus', () => { lastCap = ta; }));
    $('cc-tags').addEventListener('click', (e) => {
      const b = e.target.closest('[data-tag]');
      if (!b) return;
      const ta = lastCap || document.querySelector('.cc-cap');
      const tag = b.dataset.tag;
      const s = ta.selectionStart ?? ta.value.length, en = ta.selectionEnd ?? s;
      ta.value = ta.value.slice(0, s) + tag + ta.value.slice(en);
      ta.focus();
      ta.selectionStart = ta.selectionEnd = s + tag.length;
      queueSave();
    });
    $('cc-drawer').addEventListener('input', (e) => {
      if (e.target.closest('.cc-drawer-body')) { if (e.target.id === 'cc-d-occ' || e.target.id === 'cc-d-tied') syncTied(); if (e.target.id === 'cc-d-type') syncStageFields(); queueSave(); }
    });
    $('cc-drawer').addEventListener('change', (e) => { if (e.target.id === 'cc-d-tied') syncTied(); queueSave(); });
    $('cc-d-tpl').addEventListener('click', (e) => {
      const a = e.target.closest('[data-act]');
      if (!a) return;
      if (a.dataset.act === 'pick') openPicker();
      if (a.dataset.act === 'new') { flushSave(); openNewTemplate(OPEN); }
      if (a.dataset.act === 'unlink') setTemplate(null);
      if (a.dataset.act === 'open') openDesign(OPEN);
    });
    $('cc-d-close').addEventListener('click', closeDrawer);
    $('cc-d-done').addEventListener('click', closeDrawer);
    // Step through the month's posts without closing the pop-out.
    function stepPost(dir) {
      if (!OPEN) return;
      const i = POSTS.findIndex((p) => p.id === OPEN.id);
      const next = POSTS[i + dir];
      if (!next) return;
      flushSave();
      openDrawer(next);
    }
    $('cc-d-prev').addEventListener('click', () => stepPost(-1));
    $('cc-d-next').addEventListener('click', () => stepPost(1));
    $('cc-shade').addEventListener('click', closeDrawer);
    $('cc-d-delete').addEventListener('click', deletePost);
    $('cc-d-claude').addEventListener('click', async (e) => {
      if (!OPEN) return;
      const btn = e.currentTarget, post = OPEN;
      if (!post.template_id) { alert('Link a design first. Claude reads it to write the words.'); return; }
      await flushSave();
      btn.disabled = true; btn.textContent = 'Drafting…';
      try {
        const d = await draftWords(post);
        if (OPEN === post) {
          // Only the empty boxes are filled.
          if ($('cc-d-type').value === 'reel' && !$('cc-d-reel').value.trim() && d.what_to_film) $('cc-d-reel').value = d.what_to_film;
          if (!$('cc-d-how').value.trim() && d.how_to_edit) $('cc-d-how').value = d.how_to_edit;
          const cap = document.querySelector('.cc-cap');
          if (![...document.querySelectorAll('.cc-cap')].some((t) => t.value.trim()) && d.caption) cap.value = d.caption;
          await flushSave();
        }
      } catch (err) { alert(err.message); }
      btn.disabled = false; btn.textContent = 'Draft with Claude';
    });
    $('cc-rows').addEventListener('click', (e) => {
      const tr = e.target.closest('tr[data-id]');
      if (!tr || e.target.closest('.cc-grip')) return;
      flushSave();
      const p = POSTS.find((x) => x.id === tr.dataset.id);
      if (p) openDrawer(p);
    });
    $('cc-pick-q').addEventListener('input', renderPicker);
    $('cc-pick-grid').addEventListener('click', async (e) => {
      const b = e.target.closest('button');
      if (!b) return;
      if (b.hasAttribute('data-short')) {
        const id = b.dataset.short, short = CUR.shortlist || [];
        await saveShortlist(short.includes(id) ? short.filter((x) => x !== id) : [...short, id]);
        renderPicker();
        return;
      }
      if (b.hasAttribute('data-img')) {
        const image_url = b.dataset.img || null, m = CUR;
        const { error } = await supabase.from('content_months').update({ image_url }).eq('id', m.id);
        if (error) { alert(`Couldn't save the image: ${error.message}`); return; }
        m.image_url = image_url;
        $('cc-pick').hidden = true;
        renderMonth();
        return;
      }
      $('cc-pick').hidden = true;
      if (b.hasAttribute('data-new')) { flushSave(); openNewTemplate(OPEN); return; }
      if (b.hasAttribute('data-copy')) {
        copyIntoCalendar(b.dataset.pick).then((id) => { if (id) { setTemplate(id); renderTemplates(); } });
        return;
      }
      setTemplate(b.dataset.pick);
    });
    document.querySelectorAll('.cc-modal').forEach((m) => m.addEventListener('click', (e) => {
      if (e.target === m || e.target.closest('[data-close]')) m.hidden = true;
    }));
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      const modal = [...document.querySelectorAll('.cc-modal')].find((m) => !m.hidden);
      if (modal) { modal.hidden = true; return; }
      if (!$('cc-drawer').hidden) closeDrawer();
    });

    $('cc-intro').addEventListener('change', async () => {
      if (!CUR) return;
      const intro = $('cc-intro').value.trim() || null;
      const { error } = await supabase.from('content_months').update({ intro }).eq('id', CUR.id);
      if (error) { alert(`Couldn't save: ${error.message}`); return; }
      CUR.intro = intro;
      saved($('cc-saved'));
      renderProgress();
    });
    $('cc-edition').addEventListener('change', renderMonths);
    $('cc-new-month').addEventListener('click', openNewMonth);
    $('cc-new-go').addEventListener('click', createMonth);
    $('cc-newtpl-go').addEventListener('click', createTemplate);
    $('cc-newtpl-name').addEventListener('keydown', (e) => { if (e.key === 'Enter') createTemplate(); });
    $('cc-call').addEventListener('click', (e) => {
      const b = e.target.closest('[data-call]');
      if (!b) return;
      const k = b.dataset.call;
      if (k === 'fill') fillWeekdays(false);
      if (k === 'copy') openCopy();
      if (k === 'add') addPost();
      if (k === 'design') openNewTemplate(null);
      if (k === 'grid' || k === 'client') openBoard(k);
      if (k === 'claude-all') draftAll();
      if (k === 'publish') togglePublish();
    });
    $('cc-tl').addEventListener('click', (e) => { const b = e.target.closest('[data-stage]'); if (b) setStage(Number(b.dataset.stage)); });
    $('cc-stage-back').addEventListener('click', () => setStage(stageOf() - 1));
    $('cc-stage-next').addEventListener('click', () => setStage(stageOf() + 1));
    $('cc-month-img').addEventListener('click', () => openPicker('image'));
    $('cc-short-add').addEventListener('click', () => openPicker('short'));
    $('cc-short').addEventListener('click', (e) => { const b = e.target.closest('[data-short-rm]'); if (b) saveShortlist((CUR.shortlist || []).filter((x) => x !== b.dataset.shortRm)); });
    $('cc-copy-from').addEventListener('change', loadCopyList);
    $('cc-copy-all').addEventListener('click', () => {
      const boxes = [...document.querySelectorAll('#cc-copy-list input')], on = boxes.some((c) => !c.checked);
      boxes.forEach((c) => { c.checked = on; });
    });
    $('cc-back').addEventListener('click', async () => { await flushSave(); await saveNotes(); CUR = null; history.replaceState(null, '', location.pathname); await loadMonthsTab(); showTab('months'); });
    $('cc-copy-go').addEventListener('click', copyPosts);
    $('cc-delete-month').addEventListener('click', deleteMonth);
    window.addEventListener('beforeunload', () => { if (saveTimer) flushSave(); });


    // ---- The opening page: a box for each month ----
    let MONTH_POSTS = [];
    async function loadMonthsTab() {
      const { data: months, error } = await supabase.from('content_months').select('*').order('month', { ascending: false });
      if (error) { showMissing(error.message); return; }
      MONTHS = months || [];
      const ids = MONTHS.map((m) => m.id);
      const { data: posts } = ids.length
        ? await supabase.from('content_month_posts').select('month_id, post_date, sort_order, template_id').in('month_id', ids).order('post_date', { ascending: true }).order('sort_order', { ascending: true }).range(0, 4999)
        : { data: [] };
      MONTH_POSTS = posts || [];
      const need = [...new Set(MONTH_POSTS.map((p) => p.template_id).filter((id) => id && !TPLS.has(id)))];
      if (need.length) {
        const { data: more } = await supabase.from('templates').select('id, name, thumb_url, status, updated_at').in('id', need);
        (more || []).forEach((t) => TPLS.set(t.id, t));
      }
      $('cc-loading').hidden = true;
      $('cc-months-body').hidden = false;
      renderMonths();
    }
    function renderMonths() {
      const ed = $('cc-edition').value, list = MONTHS.filter((m) => m.edition === ed);
      $('ccm-list').innerHTML = list.map((m) => {
        const ps = MONTH_POSTS.filter((p) => p.month_id === m.id), withD = ps.filter((p) => p.template_id);
        const firstT = withD.map((p) => TPLS.get(p.template_id)).find((t) => t && t.thumb_url);
        const img = m.image_url || (firstT && firstT.thumb_url) || '';
        const d = new Date(m.month + 'T12:00:00'), live = m.status === 'published';
        const name = d.toLocaleDateString('en-GB', { month: 'long' });
        return `<button type="button" class="cc-mcard" data-ccm-open="${m.id}">${img ? `<img src="${esc(img)}" alt="" loading="lazy">` : ''}<div class="cc-mcard-h"><div><div class="cc-mcard-t">${esc(name)}</div><div class="cc-mcard-y">${d.getFullYear()}</div></div><span class="chip ${live ? 'good' : 'wait'}">${live ? 'Live' : 'Draft'}</span></div><dl><div><dt>Posts</dt><dd>${ps.length}</dd></div><div><dt>With a design</dt><dd>${withD.length}</dd></div><div><dt>Went live</dt><dd>${live ? (m.published_at ? esc(shortDate(m.published_at)) : '—') : 'Not live yet'}</dd></div></dl></button>`;
      }).join('') || '<div class="empty" style="grid-column:1/-1">No months for this edition yet. Click Start new month to begin one.</div>';
    }
    $('ccm-list').addEventListener('click', async (e) => {
      const b = e.target.closest('[data-ccm-open]');
      if (!b) return;
      const m = MONTHS.find((x) => x.id === b.dataset.ccmOpen);
      if (m) await openMonth(m);
    });

    // ---- Overview: the levels (content_levels) ----
    const LEVEL_KEYS = ['free', 'calendar', 'scheduling', 'done_for_you'];
    let LEVELS = null;      // as saved
    let LEVEL_EDIT = null;  // as being edited
    let LEVEL_TRAINING = null;
    let LEVEL_WORD = null;  // the level in the wording pop-out
    const money = (v) => (v == null || v === '' ? '' : String(Number(v)));
    const libraryOpts = [['0', 'This month only'], ['1', 'The last month'], ['2', 'The last 2 months'], ['3', 'The last 3 months'], ['6', 'The last 6 months'], ['12', 'The last 12 months'], ['-1', 'Every month']];
    const LEVEL_ROWS = [
      { group: 'Price, a month' },
      { key: 'price_card', label: 'Independent agents', small: 'By card', kind: 'price' },
      { key: 'price_teg', label: 'TEG agents', small: 'The calendar is paid by their brand; anything above it, by card', kind: 'price' },
      { key: 'price_note', label: 'Price note', small: 'Anything still to decide', kind: 'note' },
      { group: 'What it opens' },
      { key: 'calendar', label: "This month's posts", small: 'The Content Calendar and its Studio pack', kind: 'check' },
      { key: 'preview', label: 'Blurred preview', small: "Shown when this month's posts aren't included", kind: 'derived' },
      { key: 'next_month', label: "Next month's preview", kind: 'check', needs: 'calendar' },
      { key: 'library_months', label: 'Past months', small: 'Never before the month they joined', kind: 'library', needs: 'calendar' },
      { key: 'scheduling', label: 'Scheduling', small: 'Post to Instagram and Facebook from the Hub', kind: 'check' },
      { key: 'done_for_you', label: 'Done For You', small: 'Ten posts branded for them each month', kind: 'check' },
      { key: 'training', label: 'Training', small: 'Published courses and guides it opens', kind: 'training' },
      { group: 'Members' },
      { key: 'members', label: 'On this level', kind: 'members' },
    ];

    let LEVELS_LOADING = null;
    function loadLevels() {
      if (!LEVELS_LOADING) LEVELS_LOADING = fetchLevels().finally(() => { if (!LEVELS) LEVELS_LOADING = null; });
      return LEVELS_LOADING;
    }
    async function fetchLevels() {
      const [lv, tr] = await Promise.all([
        supabase.from('content_levels').select('*').order('sort_order'),
        supabase.from('guides').select('level').eq('status', 'published'),
      ]);
      $('ccl-loading').hidden = true;
      if (lv.error || !(lv.data || []).length) {
        $('ccl-missing').hidden = false;
        if (lv.error && !/content_levels|does not exist|schema cache/i.test(lv.error.message)) $('ccl-missing').innerHTML = `<p><strong>Couldn't load the levels.</strong></p><p>${esc(lv.error.message)}</p>`;
        return;
      }
      $('ccl-missing').hidden = true;
      LEVELS = lv.data;
      LEVEL_EDIT = LEVELS.map((l) => ({ ...l, includes: [...(l.includes || [])] }));
      LEVEL_TRAINING = tr.error ? null : (tr.data || []).map((g) => g.level || 'free');
      $('ccl-body').hidden = false;
      renderLevels();
    }

    function levelCell(row, l, i) {
      const k = row.key, on = (f) => (l[f] ? ' checked' : '');
      const off = row.needs && !l[row.needs];
      if (row.kind === 'price') {
        if (l.key === 'free') return '<span class="ccl-fixed">Free</span>';
        return `<label class="ccl-price">£<input type="number" min="0" step="0.01" inputmode="decimal" data-l="${i}" data-k="${k}" value="${money(l[k])}" placeholder="Not set" aria-label="${esc(row.label)}, ${esc(l.name)}" /></label>`;
      }
      if (row.kind === 'note') return l.key === 'free' ? '<span class="ccl-fixed">–</span>' : `<textarea class="ccl-note-in" data-l="${i}" data-k="${k}" rows="3" aria-label="Price note, ${esc(l.name)}">${esc(l[k] || '')}</textarea>`;
      if (row.kind === 'check') return `<input type="checkbox" data-l="${i}" data-k="${k}"${on(k)}${off ? ' disabled' : ''} aria-label="${esc(row.label)}, ${esc(l.name)}" />`;
      if (row.kind === 'derived') return l.calendar ? '<span class="ccl-fixed">No</span>' : 'Yes';
      if (row.kind === 'library') {
        if (off) return '<span class="ccl-fixed">None</span>';
        const v = l.library_months == null ? '0' : String(l.library_months);
        return `<select data-l="${i}" data-k="${k}" aria-label="Past months, ${esc(l.name)}">${libraryOpts.map(([val, t]) => `<option value="${val}"${val === v ? ' selected' : ''}>${t}</option>`).join('')}</select>`;
      }
      if (row.kind === 'training') {
        if (!LEVEL_TRAINING) return '<span class="ccl-fixed">–</span>';
        const rank = LEVEL_KEYS.indexOf(l.key);
        const n = LEVEL_TRAINING.filter((g) => LEVEL_KEYS.indexOf(g) <= rank).length;
        const own = LEVEL_TRAINING.filter((g) => g === l.key).length;
        return `${n}${rank > 0 ? ` <span class="ccl-fixed">(${own} at this level)</span>` : ''}`;
      }
      if (row.kind === 'members') return l.key === 'free' ? 'Everyone' : '<span class="ccl-fixed">Nobody yet</span>';
      return '';
    }

    function renderLevels() {
      const L = LEVEL_EDIT;
      $('ccl-head').innerHTML = '<th></th>' + L.map((l, i) => `<th>
        <span class="ccl-rank">${i === 0 ? 'Free' : `Level ${i}`}</span>
        <span class="ccl-name">${esc(l.name)}</span>
        <span class="ccl-sum">${esc(l.summary || '')}</span>
        <button type="button" class="ccl-edit" data-word="${i}">Edit the wording</button></th>`).join('');
      $('ccl-rows').innerHTML = LEVEL_ROWS.map((r) => r.group
        ? `<tr class="ccl-group"><th colspan="${L.length + 1}">${esc(r.group)}</th></tr>`
        : `<tr><th>${esc(r.label)}${r.small ? `<small>${esc(r.small)}</small>` : ''}</th>${L.map((l, i) => `<td>${levelCell(r, l, i)}</td>`).join('')}</tr>`).join('');
      levelsDirty();
    }

    // What differs from the saved levels, as the rows to write.
    function levelChanges() {
      const out = [];
      LEVEL_EDIT.forEach((l, i) => {
        const was = LEVELS[i], diff = {};
        ['name', 'summary', 'price_card', 'price_teg', 'price_note', 'calendar', 'next_month', 'library_months', 'scheduling', 'done_for_you'].forEach((f) => {
          const a = l[f] == null || l[f] === '' ? null : l[f], b = was[f] == null || was[f] === '' ? null : was[f];
          if (String(a) !== String(b)) diff[f] = a;
        });
        if ((l.includes || []).join('\n') !== (was.includes || []).join('\n')) diff.includes = l.includes;
        if (Object.keys(diff).length) out.push({ key: l.key, diff });
      });
      return out;
    }
    function levelsDirty() {
      const n = levelChanges().length;
      $('ccl-save').disabled = !n;
      if (n) $('ccl-state').textContent = 'Not saved yet';
      else if ($('ccl-state').textContent === 'Not saved yet') $('ccl-state').textContent = '';
    }

    $('ccl-rows').addEventListener('input', (e) => {
      const el = e.target.closest('[data-k]');
      if (!el) return;
      const l = LEVEL_EDIT[+el.dataset.l], k = el.dataset.k;
      if (el.type === 'checkbox') l[k] = el.checked;
      else if (el.type === 'number') l[k] = el.value === '' ? null : Math.round(Number(el.value) * 100) / 100;
      else if (k === 'library_months') l[k] = Number(el.value);
      else l[k] = el.value.trim() || null;
      // A level without this month's posts has no next month or past months.
      if (k === 'calendar') {
        if (!l.calendar) { l.next_month = false; l.library_months = null; }
        else if (l.library_months == null) l.library_months = 0;
        renderLevels();
        return;
      }
      levelsDirty();
    });

    $('ccl-save').addEventListener('click', async () => {
      const changes = levelChanges();
      if (!changes.length) return;
      const btn = $('ccl-save');
      btn.disabled = true;
      $('ccl-state').textContent = 'Saving…';
      let who = null;
      try { who = (await supabase.auth.getSession()).data.session?.user?.email || null; } catch (_) {}
      for (const c of changes) {
        const { error } = await supabase.from('content_levels').update({ ...c.diff, updated_by: who }).eq('key', c.key);
        if (error) {
          $('ccl-state').textContent = '';
          alert(`Couldn't save ${LEVEL_EDIT.find((l) => l.key === c.key).name}: ${error.message}`);
          btn.disabled = false;
          return;
        }
        const i = LEVELS.findIndex((l) => l.key === c.key);
        LEVELS[i] = { ...LEVELS[i], ...c.diff, includes: [...(c.diff.includes || LEVELS[i].includes || [])] };
      }
      levelsDirty();
      saved($('ccl-state'), 'Saved. The access check picks it up within a minute.');
    });

    // The wording: name, the line under it, and what it includes.
    $('ccl-head').addEventListener('click', (e) => {
      const b = e.target.closest('[data-word]');
      if (!b) return;
      LEVEL_WORD = +b.dataset.word;
      const l = LEVEL_EDIT[LEVEL_WORD];
      $('ccl-word-head').textContent = l.name;
      $('ccl-w-name').value = l.name || '';
      $('ccl-w-summary').value = l.summary || '';
      $('ccl-w-includes').value = (l.includes || []).join('\n');
      $('ccl-word').hidden = false;
      $('ccl-w-name').focus();
    });
    $('ccl-w-go').addEventListener('click', () => {
      const l = LEVEL_EDIT[LEVEL_WORD];
      if (!l) return;
      l.name = $('ccl-w-name').value.trim() || l.name;
      l.summary = $('ccl-w-summary').value.trim() || null;
      l.includes = $('ccl-w-includes').value.split('\n').map((x) => x.trim()).filter(Boolean);
      $('ccl-word').hidden = true;
      renderLevels();
    });
    window.addEventListener('beforeunload', (e) => { if (LEVELS && levelChanges().length) e.preventDefault(); });

    function showTab(t) {
      document.querySelectorAll('.cat-tab').forEach((b) => b.classList.toggle('is-on', b.dataset.tab === (t === 'build' ? 'months' : t)));
      $('cc-tab-overview').hidden = t !== 'overview';
      $('cc-tab-months').hidden = t !== 'months';
      $('cc-tab-build').hidden = t !== 'build';
      if (t === 'overview') loadLevels();
    }
    document.querySelectorAll('.cat-tab').forEach((b) => b.addEventListener('click', async () => {
      if (b.dataset.tab === 'months' && CUR) { await flushSave(); await saveNotes(); CUR = null; history.replaceState(null, '', location.pathname); await loadMonthsTab(); }
      showTab(b.dataset.tab);
    }));

    (async () => {
      showTab('months');
      if (!DEV) {
        const session = await requireAdmin();
        if (!session) return;
      }
      if (!(await loadMonths())) return;
      await loadTemplates();
      // ?month=YYYY-MM-01&edition=… opens that month (it's also how a reload stays
      // in the month); ?new=1 starts a new one. Otherwise it opens on the boxes.
      const q = new URLSearchParams(location.search);
      const edition = q.get('edition');
      if (edition && EDITIONS.some((e) => e.key === edition)) $('cc-edition').value = edition;
      await loadMonthsTab();
      const m = q.get('month') && MONTHS.find((x) => x.month === q.get('month') && x.edition === $('cc-edition').value);
      if (m) await openMonth(m);
      if (q.get('new') === '1') openNewMonth();
    })();
  </script>
</AdminShell>
