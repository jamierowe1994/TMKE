    .cc-copy-list { display: grid; }
    .cc-copy-list label { display: grid; grid-template-columns: 18px 76px minmax(0, 1fr) auto; gap: 10px; align-items: center; min-height: 40px; margin: 0; border-top: 1px solid var(--linen); font-size: 14px; font-weight: 400; letter-spacing: 0; text-transform: none; cursor: pointer; }
    .cc-copy-list span:nth-child(2), .cc-copy-list span:last-child { color: var(--tx); }
