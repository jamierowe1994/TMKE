---
// Admin › Design studio › Content calendar (Danielle, 27 Oct 2026).
//
// The month builder for the Content Calendar subscription: one month per
// edition, about twenty posts, each linked to a template the way a pack's
// designs are. Draft until published, like Trending month. Below the sheet,
// the templates drawn for the calendar (templates.collection = 'calendar'),
// which stay off the Templates tab and out of packs and the shop.
//
// Tables: content_months, content_month_posts (supabase/content_calendar_months.sql).
// The build list is docs/content-calendar-build.md. Members see none of this
// until the subscription launches.
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/money-os.css";
import { EDITIONS, POST_TYPES, PLATFORMS, MAX_CAPTIONS, CAPTION_TAGS, CAPTION_FILL_INS } from "../../lib/content-months.js";
---

<AdminShell active="calendar" title="Content calendar" skin="hub">
  <div class="ash-panel ash-page">
  <div class="mo" id="ccb">
  <section class="mo-head">
    <div>
      <p class="mo-eye">Studio</p>
      <div class="mo-title">Content calendar</div>
      <p class="mo-sub">The monthly posts for the Content Calendar subscription: every month by edition, and the builder for each.</p>
    </div>
  </section>
  <nav class="cc-tabs" aria-label="Content calendar">
    <button type="button" class="cat-tab" data-tab="months">Catalogue</button>
    <button type="button" class="cat-tab" data-tab="overview">Overview</button>
  </nav>

  <!-- The levels: what each costs and what it opens (Danielle, 28–29 Oct).
       The Worker's access check reads the access rows, so this is where a
       level's permissions are decided. Table: content_levels
       (supabase/content_calendar_levels.sql). -->
  <section class="ccl" id="cc-tab-overview" hidden>
    <p class="ccl-intro">The four levels of the Content Calendar subscription: what each costs and what it opens. The Hub's access check reads these, so what you set here is what members on each level get. Nobody is on a paid level yet: everyone is Free until card subscriptions and TEG billing are built.</p>
    <p class="cc-note" id="ccl-loading">Loading the levels…</p>
    <div class="cc-missing" id="ccl-missing" hidden>
      <p><strong>The levels aren't in the database yet.</strong></p>
      <p>Run <code>supabase/content_calendar_levels.sql</code> in the Supabase SQL editor, then reload this page. Until then the access check uses the plan's levels.</p>
    </div>
    <div id="ccl-body" hidden>
      <div class="ccl-wrap">
        <table class="ccl-table">
          <thead><tr id="ccl-head"><th></th></tr></thead>
          <tbody id="ccl-rows"></tbody>
        </table>
      </div>
      <div class="ccl-foot">
        <p class="cc-hint">Prices are a month, ex VAT. Each paid level builds on the one before it. Courses take their level from the course editor in Guides.</p>
        <span class="cc-saved" id="ccl-state"></span>
        <button type="button" class="mbtn primary" id="ccl-save" disabled>Save changes</button>
      </div>
    </div>
  </section>

  <!-- The opening page (Dani, 9 Nov): a box for each month, Videography's cards
       nearer square, the month's picture coming in on hover. -->
  <section id="cc-tab-months" hidden>
    <p class="state" id="cc-loading">Reading the months.</p>
    <div class="cc-missing" id="cc-missing" hidden>
      <p><strong>The Content Calendar tables aren't in the database yet.</strong></p>
      <p>Run <code>supabase/content_calendar_months.sql</code> in the Supabase SQL editor, then reload this page.</p>
    </div>
    <div id="cc-months-body" hidden>
      <div class="bar">
        <label class="pick"><span>Edition</span><select id="cc-edition">{EDITIONS.map((e) => <option value={e.key}>{e.label}</option>)}</select></label>
        <div class="mo-acts" style="margin-left:auto"><button type="button" id="cc-new-month" class="mbtn primary">Start new month</button></div>
      </div>
      <div class="cc-months" id="ccm-list"></div>
    </div>
  </section>

  <!-- One month (Dani, 9 Nov, agreed on the mock-up): the photo card, the four
       steps, then the table with only what that step needs. -->
  <div id="cc-tab-build" hidden>
    <button type="button" class="cc-back" id="cc-back">&lsaquo; All months</button>
    <section class="cc-month" id="cc-month-panel">
      <div class="cc-banner" id="cc-banner">
        <div class="cc-tags">
          <span id="cc-pill"></span><span id="cc-ed-tag"></span><span id="cc-stage-tag"></span>
          <button type="button" class="cc-vbtn small" id="cc-month-img">Choose a month image</button>
          <span class="cc-saved" id="cc-saved"></span>
        </div>
        <div class="cc-ban-row">
          <div><h2 id="cc-title"></h2><p id="cc-count"></p></div>
          <div class="cc-ban-acts">
            <button type="button" class="cc-vbtn" id="cc-delete-month">Delete month</button>
            <button type="button" class="cc-vbtn" id="cc-stage-back">Move back a step</button>
            <button type="button" class="cc-vbtn primary" id="cc-stage-next"></button>
          </div>
        </div>
      </div>
      <div class="cc-prog">
        <div class="cc-tl" id="cc-tl"></div>
        <div id="cc-call"></div>
      </div>
      <label class="cc-f cc-about" id="cc-about"><span>About this month</span><input id="cc-intro" placeholder="A line about the month: what it's built around." /></label>
      <div class="section cc-funnel" id="cc-funnel" hidden>
        <div class="strip"><div class="strip-t">Marketing funnel</div><span class="aside">Coming soon</span></div>
        <div class="empty">The launch email and mid-month reminders for this month will be created and managed here.</div>
      </div>
      <div class="chips cc-view-chips" id="cc-views" role="group" aria-label="View">
        <button type="button" data-view="calendar" aria-pressed="true">Table</button>
        <button type="button" data-view="templates" aria-pressed="false">Templates</button>
        <button type="button" data-view="notes" aria-pressed="false">Notes</button>
      </div>

      <div id="cc-view-calendar">
        <div class="tablewrap" data-lenis-prevent>
          <table class="cc-sheet"><thead><tr id="cc-head"></tr></thead><tbody id="cc-rows"></tbody></table>
        </div>
      </div>

      <div id="cc-view-templates" hidden>
        <div class="section">
          <div class="strip"><div class="strip-t">Shortlist for this month</div><span class="aside" id="cc-short-n"></span></div>
          <p class="cc-hint">Templates you're thinking of using this month, as a reminder for Creation. They aren't linked to a date.</p>
          <div class="cc-grid" id="cc-short"></div>
          <div><button type="button" class="mbtn primary" id="cc-short-add">Add templates</button></div>
        </div>
        <div class="section">
          <div class="strip"><div class="strip-t">This month's designs</div><span class="aside" id="cc-tpl-count"></span></div>
          <div class="cc-grid" id="cc-grid"></div>
        </div>
      </div>

      <!-- Ideas and rough planning for the month, for the team only (Danielle,
           28 Oct). Saves as you type. -->
      <div id="cc-view-notes" hidden>
        <div class="section">
          <div class="strip"><div class="strip-t">Notes</div><span class="aside" id="cc-notes-state"></span></div>
          <p class="cc-hint">Ideas, rough plans, things to chase. For the team only; members never see these.</p>
          <textarea id="cc-notes" class="cc-notes" placeholder="e.g. Bonfire Night post with a safety angle? Ask Jack for autumn street shots."></textarea>
        </div>
      </div>
    </section>
  </div>

  <!-- One post. Each step shows only what that step is about: data-in lists the
       steps a part appears on (Dani, 9 Nov). -->
  <div class="cc-shade" id="cc-shade" hidden></div>
  <div class="cc-drawer" id="cc-drawer" hidden role="dialog" aria-modal="true" aria-label="Post" data-lenis-prevent>
    <div class="cc-drawer-bar">
      <strong id="cc-d-head">Post</strong>
      <span class="cc-saved" id="cc-d-saved"></span>
      <button type="button" class="cc-x" id="cc-d-close" aria-label="Close">&times;</button>
    </div>
    <div class="cc-drawer-body">
      <div class="cc-pop-l">
        <div class="cc-d-tpl" id="cc-d-tpl" data-in="234"></div>
        <div class="cc-f2" data-in="14">
          <label class="cc-f"><span>Date</span><input type="date" id="cc-d-date" /></label>
          <label class="cc-f"><span>Type</span><select id="cc-d-type">{POST_TYPES.map((t) => <option value={t.key}>{t.label}</option>)}</select></label>
        </div>
        <div class="cc-stack" data-in="14">
          <label class="cc-check"><input type="checkbox" id="cc-d-tied" /> Tied to a day</label>
          <label class="cc-f" id="cc-d-occ-wrap"><span>The day it's for</span><input id="cc-d-occ" list="cc-occasions" placeholder="e.g. Christmas Day" /><datalist id="cc-occasions"></datalist></label>
          <p class="cc-hint" id="cc-d-occ-hint">If an agent plans it for another date, they're asked: "This post is for <span id="cc-d-occ-name">that day</span>. Are you sure you want to post it on another day?"</p>
        </div>
        <div class="cc-f" data-in="14">
          <span>Platforms</span>
          <div class="cc-plats" id="cc-d-plats">
            {PLATFORMS.map((p) => <label class="cc-check"><input type="checkbox" value={p.key} /> {p.label}</label>)}
          </div>
        </div>
      </div>
      <div class="cc-pop-r">
        <div class="cc-f2" data-in="14">
          <label class="cc-f"><span>Post</span><input id="cc-d-title" placeholder="e.g. Five things buyers notice first" /></label>
          <label class="cc-f"><span>Pillar</span><select id="cc-d-pillar"></select></label>
        </div>
        <label class="cc-f" data-in="1234"><span>Note <em>(team only)</em></span><textarea id="cc-d-note" rows="3" placeholder="Anything the team needs to know about this post"></textarea></label>
        <label class="cc-f" id="cc-d-film-wrap"><span>What to film</span><textarea id="cc-d-reel" rows="3" placeholder="What to film and say."></textarea></label>
        <label class="cc-f" data-in="34"><span>How to edit</span><textarea id="cc-d-how" rows="3" placeholder="What the agent changes: the photo, the price, the street…"></textarea></label>
        <div class="cc-f" data-in="34">
          <span>Caption <em>(up to {MAX_CAPTIONS}; the first is the example)</em></span>
          <div class="cc-tags" id="cc-tags">
            {CAPTION_TAGS.map((t) => <button type="button" data-tag={`{${t}}`}>{`{${t}}`}</button>)}
            {CAPTION_FILL_INS.map((t) => <button type="button" class="is-fill" data-tag={t}>{t}</button>)}
          </div>
          <p class="cc-hint">Curly brackets fill in from the agent's brand kit. Square brackets are for the agent to type, and they're warned if any are left.</p>
          {Array.from({ length: MAX_CAPTIONS }, (_, i) => (
            <textarea class="cc-cap" data-cap={i} rows={i === 0 ? 6 : 3} placeholder={i === 0 ? "Caption" : `Caption ${i + 1} (optional)`}></textarea>
          ))}
        </div>
      </div>
    </div>
    <div class="cc-drawer-foot">
      <button type="button" class="mbtn danger" id="cc-d-delete">Delete this post</button>
      <span class="cc-foot-gap"></span>
      <button type="button" class="mbtn" id="cc-d-claude" data-in="34">Draft with Claude</button>
      <button type="button" class="mbtn" id="cc-d-prev">&lsaquo; Previous</button>
      <button type="button" class="mbtn" id="cc-d-next">Next &rsaquo;</button>
      <button type="button" class="mbtn primary" id="cc-d-done">Done</button>
    </div>
  </div>

  <!-- Choose a design, shortlist templates, or pick the month's image. -->
  <div class="cc-modal" id="cc-pick" hidden>
    <div class="cc-modal-box cc-modal-wide" data-lenis-prevent>
      <div class="cc-drawer-bar">
        <strong id="cc-pick-title">Choose a design</strong>
        <div class="chips cc-pick-src" id="cc-pick-src">
          <button type="button" data-src="calendar" aria-pressed="true">Content Calendar</button>
          <button type="button" data-src="all" aria-pressed="false">All templates</button>
        </div>
        <input type="search" id="cc-pick-q" class="cc-pick-q" placeholder="Search…" />
        <button type="button" class="cc-x" data-close aria-label="Close">&times;</button>
      </div>
      <p class="cc-hint cc-pick-note" id="cc-pick-note" hidden>Choosing one of these makes a Content Calendar copy for this post. The original stays where it is, in its pack and on the Templates tab.</p>
      <div class="cc-pick-grid" id="cc-pick-grid"></div>
    </div>
  </div>

  <!-- The Instagram grid and the Client calendar, from Creation on. -->
  <div class="cc-modal cc-board" id="cc-board" hidden>
    <div class="cc-modal-box" id="cc-board-box" data-lenis-prevent>
      <div class="cc-drawer-bar"><strong id="cc-board-title"></strong><button type="button" class="cc-x" data-close aria-label="Close">&times;</button></div>
      <div class="cc-board-b" id="cc-board-b"></div>
    </div>
  </div>

  <!-- Start new month. -->
  <div class="cc-modal" id="cc-new" hidden>
    <div class="cc-modal-box">
      <div class="cc-drawer-bar"><strong>Start new month</strong><button type="button" class="cc-x" data-close aria-label="Close">&times;</button></div>
      <div class="cc-modal-body">
        <label class="cc-f"><span>Month</span><input type="month" id="cc-new-m" /></label>
        <label class="cc-f"><span>Edition</span><select id="cc-new-e">{EDITIONS.map((e) => <option value={e.key}>{e.label}</option>)}</select></label>
        <label class="cc-check"><input type="checkbox" id="cc-new-fill" checked /> Add a blank post for every weekday</label>
        <div class="cc-modal-foot"><button type="button" class="mbtn primary" id="cc-new-go">Start month</button></div>
      </div>
    </div>
  </div>

  <!-- Bring posts across from another month, to start from (Dani, 9 Nov). -->
  <div class="cc-modal" id="cc-copybox" hidden>
    <div class="cc-modal-box cc-modal-mid" data-lenis-prevent>
      <div class="cc-drawer-bar"><strong>Copy posts from</strong><button type="button" class="cc-x" data-close aria-label="Close">&times;</button></div>
      <div class="cc-modal-body cc-copy-body">
        <label class="cc-f"><span>From</span><select id="cc-copy-from"></select></label>
        <p class="cc-hint" id="cc-copy-hint"></p>
        <div class="cc-copy-list" id="cc-copy-list"></div>
        <label class="cc-check"><input type="checkbox" id="cc-copy-words" /> Also bring across the captions and guidance</label>
      </div>
      <div class="cc-modal-foot cc-copy-foot">
        <button type="button" class="mbtn" id="cc-copy-all">Tick all</button>
        <button type="button" class="mbtn primary" id="cc-copy-go">Copy posts</button>
      </div>
    </div>
  </div>

  <!-- What members are told a level includes. -->
  <div class="cc-modal" id="ccl-word" hidden>
    <div class="cc-modal-box cc-modal-mid" data-lenis-prevent>
      <div class="cc-drawer-bar"><strong id="ccl-word-head">Wording</strong><button type="button" class="cc-x" data-close aria-label="Close">&times;</button></div>
      <div class="cc-modal-body ccl-word-body">
        <label class="cc-f"><span>Name</span><input id="ccl-w-name" /></label>
        <label class="cc-f"><span>The line under it</span><textarea id="ccl-w-summary" rows="3"></textarea></label>
        <label class="cc-f"><span>What it includes <em>(one per line)</em></span><textarea id="ccl-w-includes" rows="9"></textarea></label>
        <p class="cc-hint">For the account page and the upgrade prompts, once the subscription launches. Members don't see it yet.</p>
        <div class="cc-modal-foot"><button type="button" class="mbtn primary" id="ccl-w-go">Done</button></div>
      </div>
    </div>
  </div>

  <!-- New template. -->
  <div class="cc-modal" id="cc-newtpl" hidden>
    <div class="cc-modal-box">
      <div class="cc-drawer-bar"><strong>Create a design</strong><button type="button" class="cc-x" data-close aria-label="Close">&times;</button></div>
      <div class="cc-modal-body">
        <label class="cc-f"><span>Name</span><input id="cc-newtpl-name" placeholder="e.g. November – Bonfire Night" /></label>
        <p class="cc-hint" id="cc-newtpl-for" hidden></p>
        <p class="cc-hint">1080 &times; 1350, the 4:5 shape that suits both Instagram and Facebook. It opens in the Studio.</p>
        <div class="cc-modal-foot"><button type="button" class="mbtn primary" id="cc-newtpl-go">Create and open</button></div>
      </div>
    </div>
  </div>

  </div>
  </div>

  <style is:global>
    #ccb .mo-head { margin-bottom: 14px; }
    #ccb .cc-tabs { display: flex; gap: 26px; margin: 0 0 20px; overflow-x: auto; scrollbar-width: none; box-shadow: inset 0 -1px 0 var(--linen); }
    #ccb .cat-tab { flex: none; height: 34px; padding: 0; border: 0; border-bottom: 2px solid transparent; background: none; color: var(--tx); cursor: pointer; }
    #ccb .cat-tab.is-on { color: var(--wine); border-bottom-color: var(--wine); }
    #ccb .chips { order: 0; flex: 0 1 auto; }
    #ccb .ccl-table, #ccb .ccl-table th, #ccb .ccl-table td, #ccb .ccl-intro { font-size: 14px; }
    /* Overview: the levels side by side, ruled top and bottom. */
    .ccl[hidden] { display: none; }
    .ccl-intro { font-family: var(--sans); font-size: 14px; line-height: 1.6; color: rgba(28,29,34,0.75); max-width: 75%; margin: 0 0 22px; }
    @media (max-width: 860px) { .ccl-intro { max-width: none; } }
    .ccl-wrap { overflow-x: auto; border-top: 1px solid rgba(55,30,40,0.35); border-bottom: 1px solid rgba(55,30,40,0.35); }
    .ccl-table { width: 100%; min-width: 860px; border-collapse: collapse; font-family: var(--sans); font-size: 13px; color: var(--ink); table-layout: fixed; }
    .ccl-table th, .ccl-table td { padding: 11px 14px; border-bottom: 1px solid rgba(28,29,34,0.08); text-align: left; vertical-align: middle; }
    .ccl-table tr:last-child td { border-bottom: 0; }
    .ccl-table thead th { vertical-align: top; padding-top: 16px; padding-bottom: 14px; border-bottom: 1px solid rgba(28,29,34,0.14); }
    .ccl-table thead th:first-child, .ccl-table tbody th { width: 230px; }
    .ccl-table tbody th { font-size: 13px; font-weight: 600; color: var(--ink); }
    .ccl-table tbody th small { display: block; margin-top: 2px; font-size: 11px; font-weight: 400; color: rgba(28,29,34,0.5); }
    .ccl-group th { padding-top: 18px; font-size: 10px !important; font-weight: 700 !important; letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet) !important; border-bottom: 1px solid rgba(28,29,34,0.14) !important; }
    .ccl-name { font-size: 15px; font-weight: 700; color: var(--english-violet); }
    .ccl-rank { display: block; margin-bottom: 4px; font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.45); }
    .ccl-sum { display: block; margin-top: 6px; font-size: 12px; font-weight: 400; line-height: 1.45; color: rgba(28,29,34,0.6); }
    .ccl-edit { margin-top: 8px; padding: 0; border: 0; background: none; font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--english-violet); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
    .ccl-price { display: inline-flex; align-items: center; gap: 4px; }
    .ccl-price input { width: 84px; font-family: var(--sans); font-size: 14px; font-variant-numeric: tabular-nums; padding: 7px 9px; border: 1px solid rgba(28,29,34,0.16); border-radius: 6px; background: #fff; color: var(--ink); }
    .ccl-table select, .ccl-note-in { font-family: var(--sans); font-size: 13px; padding: 7px 9px; border: 1px solid rgba(28,29,34,0.16); border-radius: 6px; background: #fff; color: var(--ink); width: 100%; box-sizing: border-box; }
    .ccl-note-in { resize: vertical; line-height: 1.45; min-height: 74px; }
    .ccl-table input:focus, .ccl-table select:focus, .ccl-table textarea:focus { outline: none; border-color: var(--english-violet); box-shadow: 0 0 0 3px rgba(55,30,40,0.08); }
    .ccl-table input[type="checkbox"] { width: 17px; height: 17px; accent-color: var(--english-violet); cursor: pointer; }
    .ccl-fixed { color: rgba(28,29,34,0.5); }
    .ccl-foot { display: flex; align-items: center; gap: 16px; margin-top: 14px; }
    .ccl-foot .cc-hint { flex: 1; }
    .cc-modal-box.cc-modal-mid { width: min(620px, 100%); }
    .ccl-word-body { overflow-y: auto; }

    .cc-note { margin: 0; color: var(--tx); }
    .cc-missing { padding: 26px; border: 1px dashed var(--stone); border-radius: 4px; color: var(--tx); max-width: 640px; }
    .cc-missing p { margin: 0 0 8px; }
    .cc-missing p:last-child { margin: 0; }
    .cc-saved { color: var(--tx); }
    .cc-hint { margin: 0; color: var(--tx); }

    /* The months: Videography's boxes, nearer square. */
    .cc-months { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 10px; }
    .cc-mcard { position: relative; aspect-ratio: 1 / 1; display: flex; flex-direction: column; padding: 16px 16px 12px; border: 1px solid var(--edge); border-radius: 4px; background: #fff; cursor: pointer; overflow: hidden; text-align: left; transition: border-color .2s, transform .2s, box-shadow .2s; }
    .cc-mcard:hover, .cc-mcard:focus-visible { border-color: var(--stone); transform: translateY(-2px); box-shadow: 0 10px 24px -18px rgba(55,30,40,.5); }
    .cc-mcard img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .22s ease; z-index: 1; pointer-events: none; }
    @media (hover: hover) { .cc-mcard:hover img { opacity: 1; } }
    .cc-mcard-h { display: flex; align-items: flex-start; justify-content: space-between; gap: 10px; }
    .cc-mcard-t { font-family: var(--serif); font-weight: 300; font-size: 24px; line-height: 1.1; letter-spacing: -0.04em; }
    .cc-mcard-y { color: var(--tx); margin-top: 3px; }
    .cc-mcard dl { margin: auto 0 0; }
    .cc-mcard dl > div { display: flex; justify-content: space-between; gap: 10px; min-height: 32px; align-items: center; border-top: 1px solid var(--linen); }
    .cc-mcard dt { color: var(--tx); }
    .cc-mcard dd { margin: 0; font-variant-numeric: lining-nums tabular-nums; }
    @media (prefers-reduced-motion: reduce) { .cc-mcard { transition: none; } .cc-mcard img { transition: none; } }

    /* A month: the photo card, the steps, then the table. */
    .cc-back { display: inline-block; margin: 0 0 10px; padding: 0; border: 0; background: none; color: var(--tx); cursor: pointer; }
    .cc-back:hover { color: var(--wine); }
    .cc-banner { position: relative; overflow: hidden; border-radius: 6px; min-height: clamp(220px, 20vw, 290px); background: var(--wine) center 45% / cover no-repeat; color: #fff; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; padding: 18px 22px 32px; margin-bottom: 10px; }
    .cc-banner::before { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(43,34,38,.05) 0%, rgba(43,34,38,0) 35%, rgba(43,34,38,.72) 100%); }
    .cc-banner > * { position: relative; }
