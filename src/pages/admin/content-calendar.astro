    @media (max-width: 760px) { .cc-pick-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
    #ccb .cc-pick-grid button { border: 1px solid var(--edge); background: #fff; padding: 0; border-radius: 2px; cursor: pointer; text-align: left; overflow: hidden; }
