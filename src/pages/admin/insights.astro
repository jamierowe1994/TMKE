---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
---

<!--
  Website insights — what the site itself records.

  Reads public.site_events, the first-party log written by src/lib/track.js on
  every front-end page (consent-gated: a visitor who declines cookies is never
  recorded). No third party, no cookies of ours beyond the consent choice.

  This is step one of the insights project. Search appearances (Google Search
  Console) and the true visitor count including people who decline cookies
  (Cloudflare) come next, and the page says where each number comes from so
  nobody compares two that aren't the same thing.
-->
<AdminShell active="insights" title="Website insights" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Website insights</div>
          <div class="page-header-sub">Visits, the pages people read and what they click, recorded by the site itself.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="ash-panel ash-page">
    <section class="admin-bar">
      <div class="admin-bar-actions">
        <div class="order-filters" id="wi-range" role="tablist">
          <button type="button" class="enquiry-chip" data-days="7">7 days</button>
          <button type="button" class="enquiry-chip is-active" data-days="30">30 days</button>
          <button type="button" class="enquiry-chip" data-days="90">90 days</button>
          <button type="button" class="enquiry-chip" data-days="3650">Everything</button>
        </div>
        <span class="admin-bar-count" id="wi-count">Loading…</span>
      </div>
      <div class="admin-bar-actions">
        <div class="order-filters" id="wi-area" role="tablist">
          <button type="button" class="enquiry-chip is-active" data-area="site">Website</button>
          <button type="button" class="enquiry-chip" data-area="hub">Member hub</button>

          <button type="button" class="enquiry-chip" data-area="email">From our emails</button>
          <button type="button" class="enquiry-chip" data-area="all">Everything</button>
        </div>
      </div>
      <div class="admin-bar-actions">
        <button type="button" class="admin-btn admin-btn-ghost" id="wi-notrack">…</button>
        <button type="button" class="admin-btn admin-btn-ghost" id="wi-csv">Export CSV</button>
      </div>
    </section>

    <!-- Nothing recorded: say why, and what to do about it, rather than
         showing a page of zeros. -->
    <p class="wi-empty" id="wi-empty" hidden></p>
    <p class="wi-scope" id="wi-scope" hidden></p>

    <div id="wi-body" hidden>
      <section class="g4 order-stats-grid">
        <div class="stat"><div class="stat-num" data-stat="visits">…</div><div class="stat-label">Visits</div></div>
        <div class="stat"><div class="stat-num" data-stat="views">…</div><div class="stat-label">Page views</div></div>
        <div class="stat"><div class="stat-num" data-stat="perVisit">…</div><div class="stat-label">Pages per visit</div></div>
        <div class="stat"><div class="stat-num" data-stat="signedIn">…</div><div class="stat-label">Visits by members</div></div>
      </section>

      <section class="wi-card">
        <div class="wi-card-head"><h2>Visits a day</h2><span id="wi-chart-note"></span></div>
        <div class="wi-chart" id="wi-chart"></div>
      </section>

      <div class="wi-cols">
        <section class="wi-card">
          <div class="wi-card-head"><h2>Most-read pages</h2><span>Views · visits</span></div>
          <table class="wi-table" id="wi-pages"></table>
        </section>
        <section class="wi-card">
          <div class="wi-card-head"><h2>Where they came from</h2><span>Visits</span></div>
          <table class="wi-table" id="wi-refs"></table>
        </section>
      </div>

      <section class="wi-card">
        <div class="wi-card-head"><h2>What they did</h2><span>Everything the site records beyond a page view</span></div>
        <table class="wi-table" id="wi-events"></table>
      </section>

      <p class="wi-foot" id="wi-foot"></p>
    </div>

    <!-- Google Search Console: the people who found you by searching. -->
    <section class="wi-card" id="wi-gsc" hidden>
      <div class="wi-card-head">
        <h2>Found in Google</h2>
        <span id="wi-gsc-range">Search Console &mdash; real people, no bots</span>
      </div>
      <p class="wi-cf-msg" id="wi-gsc-msg" hidden></p>
      <div id="wi-gsc-body" hidden>
        <div class="wi-cf-stats">
          <div class="stat"><div class="stat-num" id="wi-gsc-clicks">…</div><div class="stat-label">Clicks to the site</div></div>
          <div class="stat"><div class="stat-num" id="wi-gsc-impr">…</div><div class="stat-label">Times you appeared</div></div>
          <div class="stat"><div class="stat-num" id="wi-gsc-pos">…</div><div class="stat-label">Average position</div></div>
        </div>
        <div class="wi-chart" id="wi-gsc-chart"></div>
        <div class="wi-cols" style="margin-top:14px">
          <div>
            <div class="wi-card-head"><h2 style="font-size:15px">What they searched</h2><span>Clicks · shown</span></div>
            <table class="wi-table" id="wi-gsc-queries"></table>
          </div>
          <div>
            <div class="wi-card-head"><h2 style="font-size:15px">Which pages they landed on</h2><span>Clicks · shown</span></div>
            <table class="wi-table" id="wi-gsc-pages"></table>
          </div>
        </div>
        <p class="wi-foot" id="wi-gsc-foot"></p>
      </div>
    </section>

    <!-- Cloudflare: counted at the edge, so everyone is in it. -->
    <section class="wi-card" id="wi-cf" hidden>
      <div class="wi-card-head">
        <h2>Everything that touched the site</h2>
        <span>Cloudflare, counted before the page loads &mdash; humans and machines together</span>
      </div>
      <p class="wi-cf-msg" id="wi-cf-msg" hidden></p>
      <div id="wi-cf-body" hidden>
        <div class="wi-cf-stats">
          <div class="stat"><div class="stat-num" id="wi-cf-visitors">…</div><div class="stat-label">Visitors a day, added up</div></div>
          <div class="stat"><div class="stat-num" id="wi-cf-views">…</div><div class="stat-label">Page views</div></div>
          <div class="stat"><div class="stat-num" id="wi-cf-share">…</div><div class="stat-label">Seen by our own tracker</div></div>
        </div>
        <div class="wi-chart" id="wi-cf-chart"></div>
        <p class="wi-foot" id="wi-cf-foot"></p>
        <!-- Every reason the two numbers differ. A gap this size invites the
             wrong conclusion in both directions, so none of it is implied. -->
        <details class="wi-why">
          <summary>Why is this so much bigger than the numbers above?</summary>
          <ul>
            <li><strong>Bots, crawlers and scanners.</strong> Usually most of it. Google and Bing crawling, link previews from WhatsApp, Slack and social posts, uptime checks, and a constant background of scanners trying addresses like /wp-admin. They fetch pages but never run the page's own code, so they can never appear in our figures.</li>
            <li><strong>People who never answer the cookie banner.</strong> Our tracker only records after someone presses Accept. Ignoring the banner, or pressing Reject, means no record - and most people ignore it.</li>
            <li><strong>Ad and tracker blockers.</strong> Common on phones and in browsers like Brave. They block the request our page makes to record a visit; they can't block Cloudflare, which counts before the page arrives.</li>
            <li><strong>Someone who visits on several days.</strong> Cloudflare counts unique visitors <em>per day</em>, and this figure adds those days together. One person visiting on ten days counts ten times here, but as one visit in our own numbers.</li>
            <li><strong>The admin centre and other non-customer traffic.</strong> Cloudflare counts every request to the domain, including the admin centre, the member hub, and anyone we have excluded with "Don't count this browser".</li>
            <li><strong>Pages that never finished loading.</strong> Someone who leaves before the page is ready is a visit to Cloudflare and nothing to us.</li>
          </ul>
          <p>So the honest reading: Cloudflare is the ceiling - everything that touched the domain, human or not. Our own numbers are the floor - people who arrived, stayed, and agreed to be counted. The truth about real visitors sits between the two, nearer the bottom.</p>
        </details>
      </div>
    </section>

    <!-- The two sources still to come, and what each adds. -->

  </div>

  <style is:global>
    /* The filter chips and the bar they sit in. Each admin page carries its
       own copy of these - this one was rendering as bare browser buttons. */
    .admin-bar { display: flex; align-items: center; justify-content: space-between; gap: 14px; flex-wrap: wrap; margin-bottom: 4px; }
    .admin-bar-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .admin-bar-count { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); white-space: nowrap; }
    .order-filters { display: inline-flex; gap: 4px; flex-wrap: wrap; }
    .enquiry-chip {
      display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px;
      background: #fff; border: 1px solid rgba(var(--violet-rgb), 0.3);
      border-radius: 999px; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700;
      color: var(--english-violet); cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .enquiry-chip:hover { background: rgba(var(--violet-rgb), 0.06); }
    .enquiry-chip.is-active { background: var(--english-violet); color: var(--paper); border-color: var(--english-violet); }
    /* The two plain actions match the chips rather than the browser's idea of
       a button, and the "not counted" state is the same on/off as a chip. */
    #wi-notrack, #wi-csv {
      display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px;
      background: #fff; border: 1px solid rgba(28,29,34,0.16); border-radius: 999px;
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
      font-weight: 700; color: rgba(28,29,34,0.65); cursor: pointer; transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    #wi-notrack:hover, #wi-csv:hover { background: rgba(28,29,34,0.05); color: var(--ink); }
    #wi-notrack.is-on { background: var(--english-violet); border-color: var(--english-violet); color: var(--paper); }
    #wi-notrack:focus-visible, #wi-csv:focus-visible, .enquiry-chip:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }

    /* Double the air under the filter bar, so the controls read as one thing
       and the figures as another. */
    .wi-scope { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.55); margin: 28px 0 0; }
    .wi-scope + .order-stats-grid, .wi-scope + #wi-body { margin-top: 10px; }
    .wi-empty { font-family: var(--sans); font-size: 14px; line-height: 1.65; color: rgba(28,29,34,0.7); background: rgba(227,160,8,0.1); border-radius: 10px; padding: 16px 18px; margin: 28px 0 0; }
    .wi-card { background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 12px; padding: 16px 18px; margin: 16px 0 0; }
    .wi-card-head { display: flex; align-items: baseline; justify-content: space-between; gap: 14px; margin-bottom: 10px; }
    .wi-card-head h2 { font-family: var(--serif); font-size: 17px; font-weight: 500; color: var(--ink); margin: 0; }
    .wi-card-head span { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.5); }
    .wi-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
    @media (max-width: 900px) { .wi-cols { grid-template-columns: 1fr; } }
    .wi-table { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: 13px; }
    .wi-table td { padding: 8px 10px 8px 0; border-bottom: 1px solid rgba(28,29,34,0.07); vertical-align: middle; }
    .wi-table td:first-child { width: 100%; color: var(--ink); word-break: break-word; }
    .wi-table td.num { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; color: rgba(28,29,34,0.7); }
    .wi-table .wi-bar { display: block; height: 4px; border-radius: 999px; background: rgba(var(--violet-rgb), 0.35); margin-top: 5px; }
    .wi-morerow td { border-bottom: 0; padding-top: 10px; }
    .wi-morebtn { appearance: none; background: none; border: 0; padding: 0; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700; color: var(--english-violet); }
    .wi-morebtn:hover { text-decoration: underline; }
    .wi-none { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.45); padding: 8px 0; }
    /* One bar a day. Plain divs: a chart library for eleven bars is a library
       to load, update and keep. */
    .wi-chart { display: flex; align-items: flex-end; gap: 3px; height: 140px; }
    .wi-chart .wi-col { flex: 1 1 0; background: rgba(var(--violet-rgb), 0.22); border-radius: 3px 3px 0 0; min-height: 2px; position: relative; }
    .wi-chart .wi-col:hover { background: var(--english-violet); }
    .wi-chart .wi-col::after { content: attr(data-label); position: absolute; bottom: 100%; left: 50%; transform: translateX(-50%); margin-bottom: 4px; white-space: nowrap;
      font-family: var(--sans); font-size: 11px; color: var(--ink); background: #fff; border: 1px solid rgba(28,29,34,0.12); border-radius: 5px; padding: 3px 7px; opacity: 0; pointer-events: none; transition: opacity .12s; }
    .wi-chart .wi-col:hover::after { opacity: 1; }
    .wi-cf-stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; margin: 0 0 14px; }
    @media (max-width: 700px) { .wi-cf-stats { grid-template-columns: 1fr; } }
    .wi-cf-stats .stat { background: var(--paper, #f4f2f1); border: 0; }
    .wi-cf-msg { font-family: var(--sans); font-size: 13px; line-height: 1.6; color: rgba(28,29,34,0.65); margin: 0; }
    .wi-why { margin-top: 12px; border-top: 1px solid rgba(28,29,34,0.08); padding-top: 10px; font-family: var(--sans); }
    .wi-why summary { cursor: pointer; font-size: 12.5px; font-weight: 700; color: var(--english-violet); }
    .wi-why ul { margin: 10px 0 0; padding-left: 18px; font-size: 13px; line-height: 1.6; color: rgba(28,29,34,0.7); }
    .wi-why li + li { margin-top: 6px; }
    .wi-why p { font-size: 13px; line-height: 1.6; color: rgba(28,29,34,0.7); margin: 10px 0 2px; }
    .wi-raw { display: inline-block; margin-top: 6px; font-size: 12px; color: rgba(28,29,34,0.5); }
    .wi-cf-msg code { font-family: ui-monospace, Menlo, monospace; font-size: 12px; background: rgba(28,29,34,0.06); padding: 1px 5px; border-radius: 4px; }
    .wi-foot { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.5); margin: 12px 0 0; }
    .wi-next ul { margin: 0; padding-left: 18px; font-family: var(--sans); font-size: 13px; line-height: 1.6; color: rgba(28,29,34,0.7); }
    .wi-next li + li { margin-top: 6px; }
  </style>

  <script>
    import { supabase } from "../../lib/supabase.js";
    import { requireAdmin } from "../../lib/admin-gate.js";

    const el = (id) => document.getElementById(id);
    const esc = (s) => String(s ?? "").replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
    const num = (n) => Number(n || 0).toLocaleString("en-GB");
    let days = 30, area = "site", ALL = [], EVENTS = [];

    // Where a page belongs. The tracker fires on every page the site serves,
    // so the log holds the public site, the member hub and the admin centre
    // together - and the admin ones are us, not customers.
    const areaOf = (path) => /^\/admin(\/|$)/.test(path || "") ? "admin"
      : /^\/account(\/|$)/.test(path || "") ? "hub" : "site";
    // One visitor: the browser's session, or the row itself if there isn't one.
    const who = (e) => e.session_id || e.id;
    const AREA_LABEL = { site: "the public website", hub: "the member hub", admin: "the admin centre", email: "visits that came from our own marketing emails", all: "the website and the member hub" };
    // Links in a marketing email are stamped utm_source=email as it is sent, and
    // the tracker keeps that for the whole visit - so a visit counts as "from
    // our emails" if any of its rows carries the stamp.
    const fromEmail = (e) => ((e.props || {}).from || {}).source === "email";
    const campaignOf = (e) => ((e.props || {}).from || {}).campaign || "(unnamed campaign)";

    /* A referrer is only interesting as a source: the site it came from, with
       our own pages folded into "Direct or from within the site".

       Email is the exception. Nearly every mail client strips the referrer, so
       somebody arriving from one of our campaigns looks identical to somebody
       typing the address in — and the one source we can prove, because we
       stamped the link ourselves, was the one hiding inside "Direct". The
       campaign tag wins over the referrer for exactly that reason. */
    function sourceOf(ref, ev) {
      if (ev && fromEmail(ev)) return "Our emails";
      const r = String(ref || "").trim();
      if (!r) return "Direct / typed in";
      try {
        const h = new URL(r).hostname.replace(/^www\./, "");
        if (/(^|\.)tmke\.co\.uk$/.test(h) || /themarketingexperts\.co\.uk$/.test(h)) return "Within the site";
        if (/google\./.test(h)) return "Google";
        if (/bing\./.test(h)) return "Bing";
        if (/facebook\.|fb\./.test(h)) return "Facebook";
        if (/instagram\./.test(h)) return "Instagram";
        if (/linkedin\./.test(h)) return "LinkedIn";
        if (/t\.co$|twitter\.|x\.com$/.test(h)) return "X / Twitter";
        return h;
      } catch (_) { return "Direct / typed in"; }
    }

    const SHOW = 8;   // enough to see the shape; the rest is one click away
    const rows = (items, total) => items.length
      ? items.map(([label, n, sub], i) => `<tr${i >= SHOW ? ' class="wi-more" hidden' : ""}><td>${esc(label)}<span class="wi-bar" style="width:${total ? Math.max(2, Math.round((n / total) * 100)) : 0}%"></span></td><td class="num">${num(n)}${sub != null ? ` · ${num(sub)}` : ""}</td></tr>`).join("")
        + (items.length > SHOW ? `<tr class="wi-morerow"><td colspan="2"><button type="button" class="wi-morebtn">Show the other ${items.length - SHOW}</button></td></tr>` : "")
      : `<tr><td class="wi-none">Nothing recorded yet.</td></tr>`;

    // Cut the log down to the area being looked at. For the public website
    // that also means dropping whole visits that touched the admin centre:
    // that is a member of staff, and counting our own browsing as customer
    // traffic is how an insights page ends up lying to you.
    function applyArea() {
      const staff = new Set(ALL.filter((e) => areaOf(e.path) === "admin").map((e) => e.session_id || e.id));
      // Whole visits, not single rows: someone who lands from an email and then
      // clicks about the site is one email visit throughout.
      const emailVisits = new Set(ALL.filter(fromEmail).map(who));
      EVENTS = ALL.filter((e) => {
        if (area === "email") return emailVisits.has(who(e));
        if (area === "all") return true;
        if (areaOf(e.path) !== area) return false;
        if (area === "site" && staff.has(e.session_id || e.id)) return false;
        return true;
      });
      const scope = el("wi-scope");
      scope.hidden = false;
      const dropped = area === "site" ? staff.size : 0;
      scope.textContent = `Showing ${AREA_LABEL[area]}.` + (dropped
        ? ` ${dropped} ${dropped === 1 ? "visit that" : "visits that"} also opened the admin centre ${dropped === 1 ? "is" : "are"} left out - that's us, not a customer.`
        : "");
    }

    function render() {
      const views = EVENTS.filter((e) => e.name === "pageview");
      const visits = new Set(EVENTS.map((e) => e.session_id || e.id)).size;
      const signedIn = new Set(EVENTS.filter((e) => e.user_id).map((e) => e.session_id || e.id)).size;
      el("wi-count").textContent = `${num(visits)} ${visits === 1 ? "visit" : "visits"} · ${num(views.length)} page ${views.length === 1 ? "view" : "views"}`;
      const stat = (k, v) => { const n = document.querySelector(`[data-stat="${k}"]`); if (n) n.textContent = v; };
      stat("visits", num(visits));
      stat("views", num(views.length));
      stat("perVisit", visits ? (views.length / visits).toFixed(1) : "0");
      stat("signedIn", num(signedIn));

      // A bar a day, oldest first.
      const byDay = new Map();
      const dayKey = (iso) => String(iso).slice(0, 10);
      EVENTS.forEach((e) => {
        const k = dayKey(e.created_at);
        if (!byDay.has(k)) byDay.set(k, new Set());
        byDay.get(k).add(e.session_id || e.id);
      });
      const first = EVENTS.length ? dayKey(EVENTS[EVENTS.length - 1].created_at) : null;
      const start = new Date(days > 400 && first ? first + "T00:00:00" : Date.now() - (days - 1) * 864e5);
      const daysOut = [];
      for (let d = new Date(start); d <= new Date(); d.setDate(d.getDate() + 1)) {
        const k = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
        daysOut.push([k, (byDay.get(k) || new Set()).size]);
      }
      const peak = Math.max(1, ...daysOut.map(([, n]) => n));
      el("wi-chart").innerHTML = daysOut.map(([k, n]) =>
        `<div class="wi-col" style="height:${Math.round((n / peak) * 100)}%" data-label="${esc(new Date(k + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short" }))} · ${num(n)}"></div>`).join("");
      el("wi-chart-note").textContent = `Busiest day: ${num(peak)}`;

      // Pages, by views, with how many separate visits saw each.
      const pages = new Map();
      views.forEach((e) => {
        const p = e.path || "/";
        if (!pages.has(p)) pages.set(p, { n: 0, who: new Set() });
        const row = pages.get(p); row.n++; row.who.add(e.session_id || e.id);
      });
      const topPages = [...pages.entries()].sort((a, b) => b[1].n - a[1].n).slice(0, 30);
      el("wi-pages").innerHTML = rows(topPages.map(([p, r]) => [p, r.n, r.who.size]), topPages.length ? topPages[0][1].n : 0);

      // Sources, counted once per visit.
      const srcSeen = new Map();
      EVENTS.forEach((e) => {
        const sid = e.session_id || e.id;
        // A visit that carries a campaign tag anywhere in it came from the
        // email, whatever its first page happened to say.
        if (fromEmail(e)) { srcSeen.set(sid, "Our emails"); return; }
        if (!srcSeen.has(sid)) srcSeen.set(sid, sourceOf(e.referrer));
      });
      const srcCount = new Map();
      srcSeen.forEach((src) => srcCount.set(src, (srcCount.get(src) || 0) + 1));
      let topSrc = [...srcCount.entries()].sort((a, b) => b[1] - a[1]).slice(0, 30);
      let srcTitle = "Where they came from";
      if (area === "email") {
        const byCampaign = new Map();
        const seenVisit = new Set();
        EVENTS.filter(fromEmail).forEach((e) => {
          if (seenVisit.has(who(e))) return;
          seenVisit.add(who(e));
          const c = campaignOf(e);
          byCampaign.set(c, (byCampaign.get(c) || 0) + 1);
        });
        topSrc = [...byCampaign.entries()].sort((a, b) => b[1] - a[1]).slice(0, 30);
        srcTitle = "Which email brought them";
      }
      document.querySelector("#wi-refs").closest(".wi-card").querySelector("h2").textContent = srcTitle;
      el("wi-refs").innerHTML = rows(topSrc, topSrc.length ? topSrc[0][1] : 0);

      // Everything that isn't a page view. Checkout and purchase are two points
      // in ONE journey, so counting both would count the same person twice:
      // anyone who bought is a purchase, and only the ones who stopped are
      // counted as a checkout started.
      const bought = new Set(EVENTS.filter((e) => e.name === "pack_purchased").map(who));
      const acts = new Map();
      EVENTS.filter((e) => e.name !== "pageview").forEach((e) => {
        if (e.name === "checkout_started" && bought.has(who(e))) return;   // they finished; counted as a purchase
        acts.set(e.name, (acts.get(e.name) || 0) + 1);
      });
      const topActs = [...acts.entries()].sort((a, b) => b[1] - a[1]);
      const LABELS = {
        checkout_started: "Checkout started, not finished",
        pack_purchased: "Pack purchased",
        member_joined: "Became a member",
        shoot_booked: "Videography shoot booked",
        brochure_requested: "Brochure requested",
        smm_enquiry: "Social media enquiry",
        waitlist_joined: "Joined the waitlist",
        enquiry_sent: "Contact form sent",
        blog_read: "Read a blog post",
      };
      const pretty = (n) => LABELS[n] || String(n).replace(/_/g, " ").replace(/^./, (c) => c.toUpperCase());
      el("wi-events").innerHTML = topActs.length
        ? rows(topActs.map(([n, c]) => [pretty(n), c]), topActs[0][1])
        : `<tr><td class="wi-none">Only page views are being recorded. The shop and checkout don't yet tell the site when someone adds a pack or starts paying, so there is nothing else to count.</td></tr>`;

      const last = EVENTS[0];
      el("wi-foot").textContent = last
        ? `Last recorded ${new Date(last.created_at).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" })}. Only visitors who accept cookies are counted, so the real figures are higher.`
        : "";
    }

    async function load() {
      el("wi-empty").hidden = true;
      el("wi-count").textContent = "Loading…";
      const since = new Date(Date.now() - days * 864e5).toISOString();
      let q = supabase.from("site_events").select("id, name, path, session_id, user_id, referrer, props, created_at")
        .order("created_at", { ascending: false }).limit(50000);
      if (days <= 400) q = q.gte("created_at", since);
      const { data, error } = await q;
      if (error) {
        el("wi-body").hidden = true;
        el("wi-empty").hidden = false;
        el("wi-empty").textContent = "Couldn't read the site's event log: " + error.message;
        el("wi-count").textContent = "";
        return;
      }
      ALL = data || [];
      applyArea();
      if (!EVENTS.length && ALL.length) {
        el("wi-body").hidden = true;
        el("wi-count").textContent = "Nothing here";
        el("wi-empty").hidden = false;
        el("wi-empty").textContent = `Nothing recorded for ${AREA_LABEL[area]} in this period. Try another area or a longer range.`;
        return;
      }
      if (!EVENTS.length) {
        el("wi-body").hidden = true;
        el("wi-count").textContent = "Nothing yet";
        el("wi-empty").hidden = false;
        el("wi-empty").innerHTML = days > 400
          ? "<strong>The site hasn't recorded anything at all yet.</strong> Visits are only recorded once a visitor accepts cookies, so if the banner is being declined - or the tracking hasn't been reaching the database - there is nothing here to show. Open tmke.co.uk in a private window, accept cookies, look at a couple of pages, then reload this page: if your own visit doesn't appear, the tracking itself needs fixing."
          : "Nothing recorded in this period. Try a longer range.";
        return;
      }
      el("wi-body").hidden = false;
      render();
      loadCloudflare().then(loadSearch);
    }

    // Stop this browser being recorded anywhere on the site. The admin centre
    // and tmke.co.uk share an origin, so a flag set here is read by the
    // tracker on the public pages too.
    const OFF_KEY = "tmke-notrack";
    const trackingOff = () => { try { return localStorage.getItem(OFF_KEY) === "1"; } catch (_) { return false; } };
    function syncNotrack() {
      const b = el("wi-notrack");
      const off = trackingOff();
      b.textContent = off ? "This browser isn't counted" : "Don't count this browser";
      b.classList.toggle("is-on", off);
      b.title = off
        ? "Nothing you do on tmke.co.uk from this browser is recorded. Click to start counting it again."
        : "Stop your own browsing being recorded as customer traffic. Do this on each browser you use.";
    }
    el("wi-notrack").addEventListener("click", () => {
      try { trackingOff() ? localStorage.removeItem(OFF_KEY) : localStorage.setItem(OFF_KEY, "1"); } catch (_) {}
      syncNotrack();
    });
    syncNotrack();

    // One button per table, revealing the rest of that table only.
    document.addEventListener("click", (ev) => {
      const b = ev.target.closest(".wi-morebtn"); if (!b) return;
      const table = b.closest("table");
      const hidden = table.querySelectorAll("tr.wi-more[hidden]");
      if (hidden.length) { hidden.forEach((r) => (r.hidden = false)); b.textContent = "Show fewer"; }
      else { table.querySelectorAll("tr.wi-more").forEach((r) => (r.hidden = true)); b.textContent = `Show the other ${table.querySelectorAll("tr.wi-more").length}`; }
    });

    el("wi-csv").addEventListener("click", () => {
      const head = "when,event,path,source,visit,member\n";
      const body = EVENTS.map((e) => [e.created_at, e.name, e.path || "", sourceOf(e.referrer, e), e.session_id || "", e.user_id ? "yes" : "no"]
        .map((v) => `"${String(v).replace(/"/g, '""')}"`).join(",")).join("\n");
      const url = URL.createObjectURL(new Blob([head + body], { type: "text/csv" }));
      const a = document.createElement("a");
      a.href = url; a.download = `website-insights-${new Date().toISOString().slice(0, 10)}.csv`; a.click();
      URL.revokeObjectURL(url);
    });

    el("wi-area").addEventListener("click", (ev) => {
      const b = ev.target.closest("[data-area]"); if (!b) return;
      el("wi-area").querySelectorAll(".enquiry-chip").forEach((x) => x.classList.remove("is-active"));
      b.classList.add("is-active");
      area = b.getAttribute("data-area") || "site";
      if (!ALL.length) { load(); return; }
      applyArea();
      if (!EVENTS.length) {
        el("wi-body").hidden = true; el("wi-empty").hidden = false;
        el("wi-count").textContent = "Nothing here";
        el("wi-empty").textContent = `Nothing recorded for ${AREA_LABEL[area]} in this period. Try another area or a longer range.`;
        return;
      }
      el("wi-empty").hidden = true; el("wi-body").hidden = false;
      render();
    });

    // ---- Cloudflare ---------------------------------------------------------
    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    async function loadCloudflare() {
      const card = el("wi-cf"), msg = el("wi-cf-msg"), body = el("wi-cf-body");
      if (!WORKER) return;
      card.hidden = false;
      msg.hidden = false; body.hidden = true;
      msg.textContent = "Asking Cloudflare…";
      try {
        const { data: sess } = await supabase.auth.getSession();
        const token = sess?.session?.access_token;
        const r = await fetch(`${WORKER}/admin/insights/cloudflare?days=${Math.min(days, 90)}`, {
          headers: { Authorization: token ? "Bearer " + token : "" },
        });
        const d = await r.json().catch(() => ({}));
        if (!d.ok) {
          msg.innerHTML = d.configured === false
            ? "Not connected yet. It needs a read-only Cloudflare token and the zone id on the Worker (<code>CF_ANALYTICS_TOKEN</code> and <code>CF_ZONE_ID</code>)."
            : (d.error ? esc(d.error) : "") + (d.raw ? `${d.error ? "<br>" : ""}<span class="wi-raw">Cloudflare said: ${esc(d.raw)}</span>` : "") || "Cloudflare didn't answer.";
          return;
        }
        const rows = d.days || [];
        const visitors = rows.reduce((n, x) => n + (x.visitors || 0), 0);
        const views = rows.reduce((n, x) => n + (x.views || 0), 0);
        el("wi-cf-visitors").textContent = num(visitors);
        el("wi-cf-views").textContent = num(views);
        // Like for like: Cloudflare counts unique visitors PER DAY and this
        // adds the days up, so our own side has to be counted the same way -
        // one visit per session per day - or the share is nonsense.
        const seen = new Set();
        let ours = 0;
        ALL.filter((e) => areaOf(e.path) !== "admin").forEach((e) => {
          const k = (e.session_id || e.id) + "|" + String(e.created_at).slice(0, 10);
          if (!seen.has(k)) { seen.add(k); ours++; }
        });
        const share = visitors ? (ours / visitors) * 100 : 0;
        el("wi-cf-share").textContent = visitors ? (share < 1 && share > 0 ? "<1%" : Math.round(share) + "%") : "—";
        const peak = Math.max(1, ...rows.map((x) => x.visitors || 0));
        el("wi-cf-chart").innerHTML = rows.map((x) =>
          `<div class="wi-col" style="height:${Math.round(((x.visitors || 0) / peak) * 100)}%" data-label="${esc(new Date(x.date + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short" }))} · ${num(x.visitors || 0)}"></div>`).join("");
        CF_VISITORS = visitors;
        el("wi-cf-foot").textContent = `Counted the same way - a visitor once a day - Cloudflare saw ${num(visitors)} and the site's own tracker recorded ${num(ours)}. Most of the gap is machines rather than people; the rest is below.`;
        msg.hidden = true; body.hidden = false;
      } catch (err) {
        msg.textContent = "Couldn't reach the Worker for Cloudflare's numbers.";
      }
    }

    // ---- Google Search Console ----------------------------------------------
    let CF_VISITORS = 0;
    async function loadSearch() {
      const card = el("wi-gsc"), msg = el("wi-gsc-msg"), body = el("wi-gsc-body");
      if (!WORKER) return;
      card.hidden = false; msg.hidden = false; body.hidden = true;
      msg.textContent = "Asking Google…";
      try {
        const { data: sess } = await supabase.auth.getSession();
        const token = sess?.session?.access_token;
        const r = await fetch(`${WORKER}/admin/insights/search?days=${days}`, { headers: { Authorization: token ? "Bearer " + token : "" } });
        const d = await r.json().catch(() => ({}));
        if (!d.ok) {
          // The one that actually happens: the property hasn't been shared with
          // the account yet. Give the address to add, and where to add it.
          msg.innerHTML = d.needs_api
            ? `${esc(d.error)}<br><span class="wi-raw">Open <a href="${esc(d.enable_url)}" target="_blank" rel="noopener">this Google page</a>, press Enable, wait a minute and reload here.</span>`
            : d.needs_access
              ? `${esc(d.error)}<br><span class="wi-raw">In Search Console: Settings &rsaquo; Users and permissions &rsaquo; Add user, paste <code>${esc(d.service_account)}</code> and give it Full access. Then reload this page.</span>`
              : esc(d.error || "Search Console didn't answer.") + (d.raw && d.raw !== d.error ? `<br><span class="wi-raw">Google said: ${esc(d.raw)}</span>` : "");
          return;
        }
        if (!d.impressions && !(d.days || []).length) {
          msg.hidden = false; body.hidden = true;
          msg.textContent = `Connected, but Google has nothing to report for ${d.start} to ${d.end}. It only counts from the day the property was verified and runs two to three days behind, so a newly verified site shows nothing at first.`;
          return;
        }
        el("wi-gsc-clicks").textContent = num(d.clicks);
        el("wi-gsc-impr").textContent = num(d.impressions);
        el("wi-gsc-pos").textContent = d.position != null ? d.position.toFixed(1) : "—";
        el("wi-gsc-range").textContent = `Search Console · ${d.start} to ${d.end}`;
        const rowsD = d.days || [];
        const peak = Math.max(1, ...rowsD.map((x) => x.clicks || 0));
        el("wi-gsc-chart").innerHTML = rowsD.map((x) =>
          `<div class="wi-col" style="height:${Math.round(((x.clicks || 0) / peak) * 100)}%" data-label="${esc(new Date(x.date + "T12:00:00").toLocaleDateString("en-GB", { day: "numeric", month: "short" }))} · ${num(x.clicks || 0)} ${x.clicks === 1 ? "click" : "clicks"}"></div>`).join("");
        const topQ = (d.queries || []).filter((q) => q.impressions).slice(0, 12);
        el("wi-gsc-queries").innerHTML = topQ.length
          ? rows(topQ.map((q) => [q.q, q.clicks, q.impressions]), Math.max(1, ...topQ.map((q) => q.clicks || 1)))
          : `<tr><td class="wi-none">No searches recorded yet. Search Console starts from the day it was verified, and takes a couple of days to catch up.</td></tr>`;
        const topP = (d.pages || []).slice(0, 10);
        el("wi-gsc-pages").innerHTML = rows(topP.map((p2) => [String(p2.url).replace(/^https?:\/\/[^/]+/, "") || "/", p2.clicks, p2.impressions]), Math.max(1, ...topP.map((p2) => p2.clicks || 1)));
        const ctr = d.impressions ? Math.round((d.clicks / d.impressions) * 1000) / 10 : 0;
        el("wi-gsc-foot").textContent =
          `You appeared ${num(d.impressions)} times in search and ${num(d.clicks)} of those turned into a visit (${ctr}%).`
          + (CF_VISITORS ? ` Cloudflare counted ${num(CF_VISITORS)} visitor-days over the same window, so search is a small, real slice of that - the rest is machines, direct visits and links from elsewhere.` : "");
        msg.hidden = true; body.hidden = false;
      } catch (_) {
        msg.textContent = "Couldn't reach the Worker for Google's numbers.";
      }
    }

    el("wi-range").addEventListener("click", (ev) => {
      const b = ev.target.closest("[data-days]"); if (!b) return;
      el("wi-range").querySelectorAll(".enquiry-chip").forEach((x) => x.classList.remove("is-active"));
      b.classList.add("is-active");
      days = Number(b.getAttribute("data-days")) || 30;
      load();
    });

    (async () => {
      const session = await requireAdmin();
      if (!session && !import.meta.env.DEV) return;
      load();
    })();
  </script>
</AdminShell>
