---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin.css";
import PageHero from "../../components/PageHero.astro";
import AdminBack from "../../components/AdminBack.astro";
---

<BaseLayout
  title="Orders — Admin · TMKE"
  description="View every Edit pack order, payment status, and buyer details."
  hideNav
  hideFooter
>
  <div class="admin-hero-pad">
    <PageHero
      chapter="Admin — Orders"
      title="The Edit <em>orders.</em>"
      sub="Every purchase, every invoice. Filter by status, search by buyer or pack."
    />
  </div>

  <section class="admin-bar wrap">
    <AdminBack />
    <div class="admin-bar-actions">
      <div class="order-filters" id="order-filters" role="tablist">
        <button type="button" class="enquiry-chip is-active" data-filter="all">All</button>
        <button type="button" class="enquiry-chip" data-filter="paid">Paid</button>
        <button type="button" class="enquiry-chip" data-filter="pending">Pending</button>
        <button type="button" class="enquiry-chip" data-filter="refunded">Refunded</button>
        <button type="button" class="enquiry-chip" data-filter="failed">Failed</button>
      </div>
      <input
        type="search"
        id="order-search"
        class="admin-search"
        placeholder="Search buyer, email, invoice…"
      />
      <span class="admin-bar-count" id="order-count">…</span>
    </div>
  </section>

  <section class="order-stats wrap" id="order-stats">
    <div class="order-stat">
      <div class="order-stat-label">Revenue (paid · last 30 days)</div>
      <div class="order-stat-value" data-stat="rev30">…</div>
    </div>
    <div class="order-stat">
      <div class="order-stat-label">Orders (last 30 days)</div>
      <div class="order-stat-value" data-stat="ord30">…</div>
    </div>
    <div class="order-stat">
      <div class="order-stat-label">Lifetime revenue (paid)</div>
      <div class="order-stat-value" data-stat="revLife">…</div>
    </div>
    <div class="order-stat">
      <div class="order-stat-label">Lifetime orders</div>
      <div class="order-stat-value" data-stat="ordLife">…</div>
    </div>
  </section>

  <section class="order-list wrap" id="order-list" aria-busy="true">
    <p class="enquiry-loading" id="order-loading">Loading orders…</p>
    <p class="enquiry-empty" id="order-empty" hidden>No orders match this filter.</p>
    <div class="enquiry-table" id="order-table" role="table"></div>
  </section>

  <div class="modal-backdrop" id="order-modal" hidden>
    <div class="modal enquiry-modal" role="dialog" aria-modal="true" aria-labelledby="order-modal-title">
      <header class="modal-head">
        <h2 id="order-modal-title">Order</h2>
        <button type="button" class="modal-close" id="order-modal-close" aria-label="Close">&times;</button>
      </header>
      <div class="enquiry-detail" id="order-detail"></div>
      <footer class="modal-foot enquiry-modal-foot">
        <button type="button" class="admin-btn admin-btn-danger" data-status="refunded">Mark refunded</button>
        <button type="button" class="admin-btn admin-btn-ghost" data-status="failed">Mark failed</button>
        <div class="spacer"></div>
        <button type="button" class="admin-btn admin-btn-ghost" data-status="pending">Mark pending</button>
        <button type="button" class="admin-btn admin-btn-primary" data-status="paid">Mark paid</button>
      </footer>
    </div>
  </div>

  <style is:global>
    .admin-hero-pad { padding-top: 100px; }
    @media (max-width: 720px) { .admin-hero-pad { padding-top: 56px; } }

    .admin-search {
      padding: 8px 12px;
      border: 1px solid rgba(55, 30, 40, 0.3);
      border-radius: 2px;
      font-family: var(--sans);
      font-size: 13px;
      color: var(--ink);
      background: var(--paper);
      min-width: 220px;
    }
    .admin-search:focus { outline: none; border-color: var(--english-violet); }

    .order-filters, .enquiry-filters { display: inline-flex; gap: 4px; flex-wrap: wrap; }
    .enquiry-chip {
      display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px;
      background: #fff; border: 1px solid rgba(55, 30, 40, 0.3);
      border-radius: 999px; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700;
      color: var(--english-violet); cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .enquiry-chip:hover { background: rgba(55, 30, 40, 0.06); }
    .enquiry-chip.is-active { background: var(--english-violet); color: var(--paper); border-color: var(--english-violet); }
    .enquiry-chip-count {
      display: inline-block; min-width: 18px; padding: 1px 6px; border-radius: 999px;
      background: rgba(28, 29, 34, 0.12); font-size: 10px; letter-spacing: 0;
    }
    .enquiry-chip.is-active .enquiry-chip-count { background: rgba(244, 242, 241, 0.2); }

    .order-stats {
      max-width: 1360px;
      margin: 24px auto 0;
      padding: 0 36px;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }
    .order-stat {
      padding: 16px 18px;
      background: rgba(55, 30, 40, 0.05);
      border: 1px solid rgba(55, 30, 40, 0.15);
      border-radius: 2px;
    }
    .order-stat-label {
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28, 29, 34, 0.55);
      margin-bottom: 8px;
    }
    .order-stat-value {
      font-family: var(--serif);
      font-size: 28px;
      font-weight: 500;
      color: var(--ink);
      line-height: 1;
    }
    @media (max-width: 860px) {
      .order-stats { grid-template-columns: repeat(2, 1fr); }
    }

    .order-list {
      max-width: 1360px;
      margin: 0 auto;
      padding: 24px 36px 200px;
    }
    .order-row {
      display: grid;
      grid-template-columns: 140px 1.2fr 1.4fr 1.2fr 110px 90px 24px;
      gap: 16px;
      padding: 16px 20px;
      background: var(--paper);
      align-items: center;
      cursor: pointer;
      transition: background 0.15s;
    }
    .order-row.is-header {
      cursor: default;
      background: rgba(55, 30, 40, 0.04);
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28, 29, 34, 0.55);
    }
    .order-row:not(.is-header):hover { background: rgba(55, 30, 40, 0.04); }
    .order-invoice {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.08em;
      color: var(--ink);
      font-weight: 700;
    }
    .order-invoice-when {
      font-family: var(--sans);
      font-size: 11px;
      color: rgba(28, 29, 34, 0.55);
      margin-top: 3px;
      letter-spacing: 0;
      font-weight: 400;
    }
    .order-amount {
      font-family: var(--serif);
      font-weight: 500;
      font-size: 18px;
      color: var(--ink);
    }
    .order-pay {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.16em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.55);
    }

    .enquiry-status-pill.is-paid     { color: #2c7a4b; background: rgba(44, 122, 75, 0.1); }
    .enquiry-status-pill.is-pending  { color: #b78a2e; background: rgba(183, 138, 46, 0.12); }
    .enquiry-status-pill.is-refunded { color: rgba(28, 29, 34, 0.6); background: rgba(28, 29, 34, 0.06); }
    .enquiry-status-pill.is-failed   { color: #a05a3c; background: rgba(160, 90, 60, 0.12); }

    @media (max-width: 980px) {
      .order-row {
        grid-template-columns: 1fr;
        gap: 6px;
        padding: 14px 16px;
      }
      .order-row.is-header { display: none; }
    }
  </style>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { supabase, gbpFromPence } from "../../lib/supabase.js";

    const STATUS_LABEL = { paid: "Paid", pending: "Pending", refunded: "Refunded", failed: "Failed" };
    const PAY_LABEL = { apple_pay: "Apple Pay", google_pay: "Google Pay", card: "Card" };

    function escapeHtml(s) {
      return String(s ?? "")
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;");
    }
    function fmtWhen(iso) {
      if (!iso) return "";
      const d = new Date(iso);
      return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
    }

    let all = [];
    let activeFilter = "all";
    let search = "";

    function visibleRows() {
      let rows = activeFilter === "all" ? all : all.filter((r) => r.status === activeFilter);
      const q = search.trim().toLowerCase();
      if (q) {
        rows = rows.filter((r) =>
          [r.buyer_name, r.buyer_email, r.buyer_company, r.invoice_number, r.pack_title]
            .filter(Boolean)
            .some((v) => String(v).toLowerCase().includes(q))
        );
      }
      return rows;
    }

    function applyFilter() {
      const grid = document.getElementById("order-table");
      const emptyEl = document.getElementById("order-empty");
      if (!grid) return;
      const rows = visibleRows();
      const countEl = document.getElementById("order-count");
      if (countEl) countEl.textContent = `${rows.length} ${rows.length === 1 ? "order" : "orders"}`;
      if (rows.length === 0) {
        grid.innerHTML = "";
        if (emptyEl) emptyEl.hidden = false;
        return;
      }
      if (emptyEl) emptyEl.hidden = true;
      grid.innerHTML =
        `<div class="order-row is-header">
          <div>Invoice</div><div>Buyer</div><div>Pack</div><div>Email</div>
          <div>Amount</div><div>Status</div><div></div>
        </div>` +
        rows
          .map(
            (r) => `
            <div class="order-row" data-id="${r.id}">
              <div>
                <div class="order-invoice">${escapeHtml(r.invoice_number || "—")}</div>
                <div class="order-invoice-when">${fmtWhen(r.created_at)}</div>
              </div>
              <div class="enquiry-who">
                <div class="enquiry-who-name">${escapeHtml(r.buyer_name)}</div>
                <div class="enquiry-who-meta">${escapeHtml(r.buyer_company || "—")}</div>
              </div>
              <div class="enquiry-who">
                <div>${escapeHtml(r.pack_title)}</div>
                <div class="enquiry-who-meta order-pay">${PAY_LABEL[r.payment_method] || r.payment_method}</div>
              </div>
              <div class="enquiry-who-meta">${escapeHtml(r.buyer_email)}</div>
              <div class="order-amount">${gbpFromPence(r.amount_pence)}</div>
              <div><span class="enquiry-status-pill is-${r.status}">${STATUS_LABEL[r.status] || r.status}</span></div>
              <div class="enquiry-row-arrow">&rarr;</div>
            </div>`
          )
          .join("");

      grid.querySelectorAll("[data-id]").forEach((el) => {
        el.addEventListener("click", () => openDetail(el.getAttribute("data-id")));
      });
    }

    function recomputeStats() {
      const now = Date.now();
      const THIRTY = 30 * 24 * 60 * 60 * 1000;
      let rev30 = 0, ord30 = 0, revLife = 0, ordLife = 0;
      for (const r of all) {
        if (r.status !== "paid") continue;
        revLife += r.amount_pence || 0;
        ordLife += 1;
        const ts = new Date(r.created_at).getTime();
        if (now - ts < THIRTY) {
          rev30 += r.amount_pence || 0;
          ord30 += 1;
        }
      }
      const set = (k, v) => {
        const el = document.querySelector(`[data-stat="${k}"]`);
        if (el) el.textContent = v;
      };
      set("rev30", gbpFromPence(rev30));
      set("ord30", String(ord30));
      set("revLife", gbpFromPence(revLife));
      set("ordLife", String(ordLife));
    }

    let current = null;

    function openDetail(id) {
      const row = all.find((r) => r.id === id);
      if (!row) return;
      current = row;
      const modal = document.getElementById("order-modal");
      const detail = document.getElementById("order-detail");
      const title = document.getElementById("order-modal-title");
      if (!modal || !detail || !title) return;
      title.textContent = row.invoice_number || "Order";
      detail.innerHTML = `
        <dl>
          <dt>Placed</dt><dd>${new Date(row.created_at).toLocaleString("en-GB")}</dd>
          <dt>Pack</dt><dd>${escapeHtml(row.pack_title)}</dd>
          <dt>Amount</dt><dd>${gbpFromPence(row.amount_pence)}</dd>
          <dt>Status</dt><dd><span class="enquiry-status-pill is-${row.status}">${STATUS_LABEL[row.status] || row.status}</span></dd>
          <dt>Buyer</dt><dd>${escapeHtml(row.buyer_name)}</dd>
          <dt>Email</dt><dd><a href="mailto:${row.buyer_email}">${escapeHtml(row.buyer_email)}</a></dd>
          <dt>Phone</dt><dd>${row.buyer_phone ? `<a href="tel:${row.buyer_phone}">${escapeHtml(row.buyer_phone)}</a>` : "—"}</dd>
          <dt>Company</dt><dd>${escapeHtml(row.buyer_company || "—")}</dd>
          <dt>Payment</dt><dd>${PAY_LABEL[row.payment_method] || row.payment_method}${row.payment_ref ? ` &middot; ${escapeHtml(row.payment_ref)}` : ""}</dd>
        </dl>
      `;
      modal.hidden = false;
    }

    function closeDetail() {
      const modal = document.getElementById("order-modal");
      if (modal) modal.hidden = true;
      current = null;
    }

    async function changeStatus(status) {
      if (!current) return;
      const id = current.id;
      const { error } = await supabase.from("orders").update({ status }).eq("id", id);
      if (error) {
        alert("Couldn't update status: " + error.message);
        return;
      }
      const row = all.find((r) => r.id === id);
      if (row) row.status = status;
      recomputeStats();
      applyFilter();
      closeDetail();
    }

    (async () => {
      const session = await requireAdmin();
      if (!session) return;

      const { data, error } = await supabase
        .from("orders")
        .select("*")
        .order("created_at", { ascending: false });

      const loading = document.getElementById("order-loading");
      if (loading) loading.hidden = true;
      const listEl = document.getElementById("order-list");
      if (listEl) listEl.removeAttribute("aria-busy");

      if (error) {
        if (loading) {
          loading.hidden = false;
          loading.textContent = "Could not load orders: " + error.message;
        }
        return;
      }

      all = data || [];
      recomputeStats();
      applyFilter();

      document.getElementById("order-filters")?.addEventListener("click", (e) => {
        const btn = e.target.closest(".enquiry-chip");
        if (!btn) return;
        document.querySelectorAll("#order-filters .enquiry-chip").forEach((c) => c.classList.remove("is-active"));
        btn.classList.add("is-active");
        activeFilter = btn.getAttribute("data-filter") || "all";
        applyFilter();
      });

      document.getElementById("order-search")?.addEventListener("input", (e) => {
        search = e.target.value || "";
        applyFilter();
      });

      document.getElementById("order-modal-close")?.addEventListener("click", closeDetail);
      document.getElementById("order-modal")?.addEventListener("click", (e) => {
        if (e.target instanceof HTMLElement && e.target.id === "order-modal") closeDetail();
      });
      document.querySelectorAll(".modal-foot [data-status]").forEach((btn) => {
        btn.addEventListener("click", () => changeStatus(btn.getAttribute("data-status")));
      });
    })();
  </script>
</BaseLayout>
