    async function saveArchive(b) {
      const note = document.getElementById("vid-arch-msg");
      const folder = (document.getElementById("vid-arch-folder")?.value || "").trim();
      if (!folder) { note.textContent = "Give the folder a name first."; return; }
      const folders = archiveFoldersFor(b.service_type, b.service);
      const btn = document.getElementById("vid-arch-save");
      const label = btn.textContent; btn.disabled = true; btn.textContent = "Creating…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/videography/archive-create`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ booking_id: b.id, folder, folders }),
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) { note.textContent = d.error || "Couldn't create the folders."; return; }
        b.archive_folder = folder;
        b.archive_url = d.url || null;
        const open = document.getElementById("vid-arch-open");
        if (open) { open.hidden = !b.archive_url; open.href = b.archive_url || "#"; }
        note.textContent = `Created ${d.created.length} folders. Files dropped below will go straight into them.`
          + (d.url ? "" : " (Set CF_ACCOUNT_ID on the Worker for an Open in Cloudflare link.)");
      } catch (err) { note.textContent = "Couldn't reach the Worker: " + err.message; }
      finally { btn.disabled = false; btn.textContent = label; }
    }

    /* ---- Delivery, in its pop-out (Dani, 4 Nov 2026) ----
       1 · Pixieset gallery: Jack adds the gallery while the shoot is still in
       editing; saving it with the link and the PIN moves the shoot to Gallery
       ready. Under it, a reminder that Pixieset is only the client's copy:
       our storage is the other half of the job. The gallery email and the PIN
       go from the foot of the pop-out. */
    var vdEdit = false;   // the gallery's fields are open
    /* Deliver by (Dani, 6 Nov): choosable from booking onwards. Picking a portal
       further down while on Pixieset gives both, as new starters have. */
    function renderDeliveryMethod(b) {
      const host = document.getElementById("vd-method");
      if (!host) return;
      if (isSmmCovered(b)) { host.innerHTML = ""; return; }
      const ready = "delivery_method" in b;
      const by = isPortalDelivery(b) ? "portal" : "pixieset";
      host.innerHTML = `<dl class="vc-pdl is-form">${vcPF("Deliver by", `<select class="vc-in" id="vd-method-sel"${ready ? "" : " disabled"}><option value="pixieset"${by === "pixieset" ? " selected" : ""}>Pixieset</option><option value="portal"${by === "portal" ? " selected" : ""}>Client portal</option></select>`, !ready ? "Run supabase/videography_delivery_method.sql first." : by === "portal" ? "No gallery and no PIN. It shows in their portal once Content ready is Yes and it's paid, or released before payment." : "A gallery and PIN. If you pick a portal below too, it also shows there once sent and paid.")}</dl>`;
      document.getElementById("vd-method-sel")?.addEventListener("change", (e) => {
        const to = e.target.value;
        if (to === "pixieset" && b.released_unpaid_at && !confirm("This also takes back the release before payment. Carry on?")) { e.target.value = "portal"; return; }
        saveBookingPatch(b, to === "pixieset" ? { delivery_method: to, ...(b.released_unpaid_at ? { released_unpaid_at: null, released_unpaid_by: null } : {}), ...("portal_ready_at" in b ? { portal_ready_at: null, portal_ready_by: null } : {}) } : { delivery_method: to });
      });
    }
    /* The cover photo on the client's emails (Dani, 7 Nov). Picked from the shoot's
       own photos and saved as a 16:9 JPEG at a permanent public address, because a
       storage link expires and an email lasts. Photos only: a video's frame came
       up black (Dani, 7 Nov). */
    let vdCover = { id: null, mode: "idle" };
    const coverIsPhoto = (f) => /\.(jpe?g|png|webp)$/i.test(f.name || "") || /^image\/(jpeg|png|webp)/.test(f.contentType || "");
    async function coverApi(path) {
      const token = await authToken();
      const res = await fetch(WORKER_URL + path, { headers: { Authorization: "Bearer " + token } });
      if (!res.ok) throw new Error("couldn't read the shoot's files");
      return res.json();
    }
    async function coverFiles(b) {
      const top = await coverApi(`/list?prefix=${encodeURIComponent(folderFor(b))}`);
      const inner = await Promise.all((top.folders || []).slice(0, 8).map((f) => coverApi(`/list?prefix=${encodeURIComponent(top.prefix + (String(f).endsWith("/") ? String(f).split("/").filter(Boolean).pop() + "/" : f + "/"))}`).catch(() => ({ files: [] }))));
      return [...(top.files || []), ...inner.flatMap((x) => x.files || [])].filter(coverIsPhoto);
    }
    // Cropped from the middle across, and from where it's been placed down.
    async function coverBlob(url, pos) {
      const img = new Image();
      img.crossOrigin = "anonymous"; img.src = url;
      await img.decode();
      const source = img, w = img.naturalWidth, h = img.naturalHeight;
      let sw = w, sh = w * 9 / 16;
      if (sh > h) { sh = h; sw = h * 16 / 9; }
      const sx = (w - sw) / 2, sy = pos === "top" ? 0 : pos === "bottom" ? h - sh : (h - sh) / 2;
      const c = document.createElement("canvas");
      c.width = Math.min(1200, Math.round(sw)); c.height = Math.round(c.width * 9 / 16);
      c.getContext("2d").drawImage(source, sx, sy, sw, sh, 0, 0, c.width, c.height);
      return new Promise((ok, no) => c.toBlob((x) => (x ? ok(x) : no(new Error("couldn't make the picture"))), "image/jpeg", 0.85));
    }
    async function renderCoverRow(b) {
      const host = document.getElementById("vd-cover");
      if (!host) return;
      const started = ["editing", "gallery_ready", "sent", "delivered"].includes(b.stage);
      if (isSmmCovered(b) || !started) { host.innerHTML = ""; return; }
      if (vdCover.id !== b.id) vdCover = { id: b.id, mode: "idle" };
      const row = (inner, hint) => `<dl class="vc-pdl is-form">${vcPF("Cover photo", inner, hint)}</dl><p class="vid-warn" id="vd-cover-msg" hidden></p>`;
      const say = (t) => { const m = document.getElementById("vd-cover-msg"); if (m) { m.hidden = !t; m.textContent = t || ""; m.style.color = "#8a3f3f"; } };
      if (!("cover_url" in b)) { host.innerHTML = row('<span class="vc-none">Not available yet</span>', "Run supabase/videography_cover.sql first."); return; }
      if (vdCover.mode === "idle") {
        host.innerHTML = row(`<div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap">${b.cover_url ? `<img src="${escapeHtml(b.cover_url)}" alt="The cover photo" style="display:block;width:160px;height:90px;object-fit:cover;border-radius:4px">` : ""}<button type="button" class="vc-hb" id="vd-cover-pick">${b.cover_url ? "Change" : "Choose a photo"}</button>${b.cover_url ? '<button type="button" class="vc-hb" id="vd-cover-clear">Remove</button>' : ""}</div>`, "Goes at the top of the client's emails, cropped to 16:9. With none chosen, the email goes without a photo.");
        document.getElementById("vd-cover-pick")?.addEventListener("click", () => { vdCover.mode = "choose"; renderCoverRow(b); });
        document.getElementById("vd-cover-clear")?.addEventListener("click", async () => {
          const { error } = await supabase.from("videography_bookings").update({ cover_url: null }).eq("id", b.id);
          if (error) { say("Couldn't remove it: " + error.message); return; }
          b.cover_url = null; renderCoverRow(b); renderClients(document.getElementById("vid-client-search")?.value || "");
        });
        return;
      }
      if (vdCover.mode === "choose") {
        host.innerHTML = row('<span class="vc-none">Loading the shoot\'s files…</span>');
        let files;
        try { files = await coverFiles(b); } catch (e) { vdCover.mode = "idle"; renderCoverRow(b).then(() => say("Couldn't load the files: " + e.message)); return; }
        if (vdCover.mode !== "choose" || vdCover.id !== b.id) return;
        const shown = files.slice(0, 48);
        host.innerHTML = row(`${shown.length ? `<div id="vd-cover-grid" style="display:grid;grid-template-columns:repeat(auto-fill,minmax(112px,1fr));gap:6px">${shown.map((f, i) => `<button type="button" data-cover="${i}" aria-label="Use ${escapeHtml(f.name)}" style="display:block;padding:0;border:1px solid var(--vc-edge);border-radius:4px;background:#eae5e1;aspect-ratio:16/9;overflow:hidden;cursor:pointer"></button>`).join("")}</div>` : '<span class="vc-none">No photos in this shoot\'s folder yet.</span>'}<div style="margin-top:8px"><button type="button" class="vc-hb" id="vd-cover-back">Cancel</button></div>`, shown.length && files.length > shown.length ? `Showing the newest ${shown.length} of ${files.length}.` : "");
        document.getElementById("vd-cover-back").addEventListener("click", () => { vdCover.mode = "idle"; renderCoverRow(b); });
        host.querySelectorAll("[data-cover]").forEach(async (el) => {
          const f = shown[Number(el.dataset.cover)];
          el.addEventListener("click", () => { vdCover = { id: b.id, mode: "place", file: f, pos: "center" }; renderCoverRow(b); });
          const small = f.thumb || f.key;
          try { const l = await coverApi(`/media-link?key=${encodeURIComponent(small)}`); el.innerHTML = `<img src="${escapeHtml(l.url)}" alt="" loading="lazy" style="display:block;width:100%;height:100%;object-fit:cover">`; } catch (_) {}
        });
        return;
      }
      // Placing the chosen one in the 16:9 frame.
      const f = vdCover.file;
      let link;
      try { link = await coverApi(`/media-link?key=${encodeURIComponent(f.key)}`); }
      catch (e) { vdCover.mode = "idle"; renderCoverRow(b).then(() => say("Couldn't open that file: " + e.message)); return; }
      const posCss = { top: "center top", center: "center center", bottom: "center bottom" };
      const media = `<img id="vd-cover-see" src="${escapeHtml(link.url)}" alt="" style="display:block;width:100%;height:100%;object-fit:cover;object-position:${posCss[vdCover.pos]}">`;
      host.innerHTML = row(`<div style="width:100%;max-width:420px;aspect-ratio:16/9;overflow:hidden;border-radius:4px;background:#eae5e1">${media}</div><div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">${["top", "center", "bottom"].map((p) => `<button type="button" class="vc-hb" data-coverpos="${p}" aria-pressed="${vdCover.pos === p}">${{ top: "Top", center: "Middle", bottom: "Bottom" }[p]}</button>`).join("")}<button type="button" class="vc-hb" id="vd-cover-back">Back</button><button type="button" class="vc-hb vc-hb--primary" id="vd-cover-use">Use this photo</button></div>`, "This is how it's cropped in the email. Choose which part of the photo stays in frame.");
      host.querySelectorAll("[data-coverpos]").forEach((x) => x.addEventListener("click", () => { vdCover.pos = x.dataset.coverpos; document.getElementById("vd-cover-see").style.objectPosition = posCss[vdCover.pos]; host.querySelectorAll("[data-coverpos]").forEach((y) => y.setAttribute("aria-pressed", String(y === x))); }));
      document.getElementById("vd-cover-back").addEventListener("click", () => { vdCover.mode = "choose"; renderCoverRow(b); });
      document.getElementById("vd-cover-use").addEventListener("click", async (e) => {
        const btn = e.currentTarget, was = btn.textContent;
        btn.disabled = true; btn.textContent = "Saving…"; say("");
        try {
          const blob = await coverBlob(link.url, vdCover.pos);
          const fd = new FormData();
          fd.append("file", new File([blob], "cover.jpg", { type: "image/jpeg" }));
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/admin/upload`, { method: "POST", headers: { Authorization: "Bearer " + token }, body: fd });
          const d = await res.json().catch(() => ({}));
          if (!res.ok || !d.url) throw new Error(d.error || "the upload didn't finish");
          const { error } = await supabase.from("videography_bookings").update({ cover_url: d.url }).eq("id", b.id);
          if (error) throw new Error(error.message);
          b.cover_url = d.url; vdCover = { id: b.id, mode: "idle" };
          renderCoverRow(b); renderClients(document.getElementById("vid-client-search")?.value || "");
        } catch (err) { btn.disabled = false; btn.textContent = was; say("Couldn't save the photo: " + err.message); }
      });
    }
    async function renderDeliveryCard(b) {
      renderDeliveryMethod(b);
      renderCoverRow(b);
      const host = document.getElementById("vid-cand-delivery");
      if (!host) return;
      if (!["editing", "gallery_ready", "sent", "delivered"].includes(b.stage)) { host.hidden = true; return; }
      host.hidden = false;

      if (isPortalDelivery(b)) {
        const [port, mgmt, allInv] = await Promise.all([portalForShoot(b), canMoney(), fetchInvoicesFor(b)]);
        if (b.id !== candId) return;
        const files = vcCache.files || 0, stored = !!(files || b.archived_at);
        const live = (allInv || []).filter((iv) => iv.status !== "void"), inv = live[0] || null;
        const paid = !!b.paid_at || live.some((iv) => iv.status === "paid"), early = !!b.released_unpaid_at, clear = paid || early;
        const yes = !!b.portal_ready_at, canSave = "portal_ready_at" in b;
        const whenDay = (iso) => escapeHtml(vcDay(iso));
        const missing = (t) => `<span class="vc-missing">${escapeHtml(t)}</span>`;
        const invLine = paid ? `Paid${inv && inv.number ? ": " + escapeHtml(inv.number) : ""}`
          : inv ? `${escapeHtml(inv.number || "Invoice")}: ${inv.status === "draft" ? "draft, not sent" : "sent, not paid"}`
          : missing("No invoice yet");
        const showing = !yes ? "No: Content ready is No"
          : !port ? "No: no portal chosen"
          : !port.enabled ? "No: their portal is turned off"
          : !clear ? (inv ? "No: waiting on payment" : "No: no invoice yet")
          : b.stage === "sent" || b.stage === "delivered" ? (b.gallery_sent_at ? `Yes, since ${whenDay(b.gallery_sent_at)}` : "Yes")
          : "Within about 5 minutes";
        const told = !!port && (port.notified_folders || []).includes(shootPortalKey(folderFor(b)));
        const shareHint = told ? "Emailed: they've been told this folder is in their portal, with the link to it."
          : !port || !port.notify_email ? "Nobody's told until there's an address here. Separate several with commas."
          : "We email this once, when the folder first shows in their portal, with the link and passcode. It's the same address for every shoot in this portal.";
        const rowBtn = (attr, label) => `<button type="button" class="vc-hb" ${attr} style="margin-left:10px">${escapeHtml(label)}</button>`;
        const form = vcPF("Content ready", `<div style="display:flex;gap:8px;align-items:center"><select class="vc-in" id="vd-ready-sel"${canSave ? "" : " disabled"}><option value="no"${yes ? "" : " selected"}>No</option><option value="yes"${yes ? " selected" : ""}>Yes</option></select><button type="button" class="vc-hb vc-hb--primary" id="vd-ready-save" disabled>Save</button></div>`, canSave ? (yes ? `Set to Yes${b.portal_ready_by ? ` by ${escapeHtml(b.portal_ready_by)}` : ""}, ${whenDay(b.portal_ready_at)}.` : "Change to Yes and save once editing's finished and the files are uploaded.") : "Run supabase/videography_portal_ready.sql first.");
        host.innerHTML = `<dl class="vc-pdl">${[
          vcPF("Their portal", '<div class="cpt-shoot" id="vd-portal"></div>'),
          vcPR("Files", (stored ? (files ? `All ${files} in our storage` : "In our storage") : missing("Not uploaded")) + rowBtn("data-vd-store", stored ? "Open files" : "Upload")),
          form,
          vcPR("Invoice", invLine + rowBtn("data-vd-inv", inv ? "Open invoice" : "Raise invoice")),
          paid ? "" : vcPR("Released early", (early ? `Yes, by ${escapeHtml(b.released_unpaid_by || "management")}, ${whenDay(b.released_unpaid_at)}` : "No") + (mgmt ? rowBtn('id="vd-early"', early ? "Take it back" : "Release before payment") : "")),
          vcPR("Showing", showing),
          port ? vcPF("Share", `<div style="display:flex;gap:8px;align-items:center"><input class="vc-in" type="text" id="vd-share-to" value="${escapeHtml(port.notify_email || "")}" placeholder="Who gets the email" autocomplete="off" spellcheck="false"><button type="button" class="vc-hb vc-hb--primary" id="vd-share-save" disabled>Save</button></div>`, shareHint) : "",
        ].join("")}</dl><p class="vid-warn" id="vd-msg" hidden></p>`;
        renderShootPortal(document.getElementById("vd-portal"), b, folderFor(b), { ...portalDeps(), compact: true, onChange: () => renderDeliveryCard(b) });
        const shareTo = document.getElementById("vd-share-to"), shareSave = document.getElementById("vd-share-save");
        shareTo?.addEventListener("input", () => { shareSave.disabled = shareTo.value.trim() === (port.notify_email || ""); });
        shareSave?.addEventListener("click", async () => {
          const list = shareTo.value.split(/[,;\s]+/).map((x) => x.trim()).filter(Boolean);
          if (list.some((x) => !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(x))) { vdMsg("One of those email addresses doesn't look right.", true); return; }
          shareSave.disabled = true;
          const { data: saved, error } = await supabase.from("client_portals").update({ notify_email: list.join(", ") || null }).eq("id", port.id).select();
          if (error || !saved || saved.length !== 1) { shareSave.disabled = false; vdMsg("Couldn't save that: " + (error ? error.message : "the database didn't confirm it"), true); return; }
          renderDeliveryCard(b);
        });
        host.querySelector("[data-vd-store]")?.addEventListener("click", () => vcOpen("content"));
        host.querySelector("[data-vd-inv]")?.addEventListener("click", () => vcOpen("invoice"));
        const readySel = document.getElementById("vd-ready-sel"), readySave = document.getElementById("vd-ready-save");
        readySel?.addEventListener("change", () => { readySave.disabled = (readySel.value === "yes") === yes; });
        readySave?.addEventListener("click", async () => {
          const to = readySel.value === "yes";
          if (to) { const problem = await portalReadyProblem(b); if (problem) { vdMsg(problem, true); return; } }
          readySave.disabled = true;
          const by = (await portalDeps().me().catch(() => "")) || null;
          const patch = to ? { portal_ready_at: new Date().toISOString(), portal_ready_by: by, ...(b.stage === "editing" ? { stage: "gallery_ready" } : {}) } : { portal_ready_at: null, portal_ready_by: null };
          const { error } = await supabase.from("videography_bookings").update(patch).eq("id", b.id);
          if (error) { readySave.disabled = false; vdMsg("Couldn't save that: " + error.message, true); return; }
