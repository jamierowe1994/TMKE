---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";

// Drop-box categories on the Deliver tab. Jack drags files into the right
// box so the client gallery can be grouped/filtered. "Other" is the catch-all.
const DELIVER_CATEGORIES = [
  "Headshots",
  "Exteriors",
  "Interiors",
  "Twilight",
  "Drone",
  "Video",
  "Other",
];
---

<AdminShell active="videography" title="Videography">
  <div class="ash-panel ash-page">
  <section class="admin-bar">
    <div class="admin-bar-actions">
      <button type="button" class="admin-btn admin-btn-primary" id="vid-new-booking">+ New booking</button>
      <div class="vid-cog-wrap">
        <button type="button" class="vid-cog" id="vid-cog" aria-label="Studio settings" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span>Settings</span>
        </button>
        <div class="vid-cog-menu" id="vid-cog-menu" hidden>
          <button type="button" data-go="clients">Clients</button>
          <button type="button" data-go="diary">Diary &amp; availability</button>
          <button type="button" data-go="deliver">Deliver work</button>
          <button type="button" data-go="settings">Pricing &amp; travel settings</button>
          <button type="button" data-go="connections">Connections</button>
          <a href="/admin/videography-promos" class="vid-cog-link">Promo codes</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CLIENTS (prioritised list) ===================== -->
  <section class="vid-panel wrap is-active" data-panel="clients">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Clients</h2>
        <p class="vid-panel-sub">Everyone Jack's working with right now, soonest first. Click a name to open their file.</p>
      </div>
      <input type="search" id="vid-client-search" class="admin-search" placeholder="Search client, company…" />
    </div>
    <p class="vid-loading" id="vid-clients-loading">Loading clients…</p>
    <div class="vid-clients" id="vid-clients" hidden></div>
    <p class="vid-loading" id="vid-clients-empty" hidden>No clients yet — add a booking to get started.</p>
  </section>

  <!-- ===================== CANDIDATE FILE (CRM one-pager) ===================== -->
  <section class="vid-panel wrap" data-panel="candidate">
    <button type="button" class="vid-cand-back" id="vid-cand-back">&larr; All clients</button>
    <div class="vid-cand" id="vid-cand"></div>
  </section>

  <!-- ===================== DIARY (weekly availability) ===================== -->
  <section class="vid-panel wrap" data-panel="diary">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Diary &amp; availability</h2>
        <p class="vid-panel-sub">Set the hours Jack is bookable each weekday. This drives the public booking page.</p>
      </div>
    </div>

    <div class="vid-conn-note">
      <strong>These are the hours Jack is bookable.</strong>
      Click a day, then tap the hours he's available — you can pick more than one
      block (e.g. 9–1 and 3–6). Anything already in his real 365 calendar is
      subtracted automatically, so clients only ever see genuinely free times.
    </div>

    <div class="vid-diary" id="vid-diary">
      <p class="vid-loading" id="vid-diary-loading">Loading diary…</p>
    </div>
    <button type="button" class="admin-btn admin-btn-primary vid-diary-save" id="vid-diary-save" hidden>Save diary</button>
  </section>

  <!-- ===================== DELIVER (uploads → client) ===================== -->
  <section class="vid-panel wrap" data-panel="deliver">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Deliver work</h2>
        <p class="vid-panel-sub">Upload the finished shoot, then send the client their gallery.</p>
      </div>
    </div>

    <div class="vid-conn-note is-pending" id="vid-deliver-config" hidden>
      <strong>Upload backend not connected yet.</strong>
      Deploy the Cloudflare Worker in <code>worker/</code> and set
      <code>PUBLIC_R2_WORKER_URL</code> in your env, then reload. See
      <code>worker/README.md</code>.
    </div>

    <div class="vid-deliver">
      <div class="vid-field vid-deliver-pick">
        <label>Deliver to booking</label>
        <select id="vid-deliver-booking">
          <option value="">— Select a client / shoot —</option>
        </select>
      </div>

      <p class="vid-catgrid-intro" id="vid-catgrid-intro">Drag photos &amp; videos into a category — or hit <em>Add</em>. Files go straight to Cloudflare R2 (50&nbsp;MB parts, resumable). The category is how the client's gallery is grouped.</p>
      <div class="vid-catgrid" id="vid-catgrid">
        {DELIVER_CATEGORIES.map((cat) => (
          <div class="vid-catbox" data-category={cat}>
            <div class="vid-catbox-top">
              <span class="vid-catbox-name">{cat}</span>
              <span class="vid-catbox-count" data-cat-count>0</span>
            </div>
            <div class="vid-catbox-drop">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                <polyline points="17 8 12 3 7 8" />
                <line x1="12" y1="3" x2="12" y2="15" />
              </svg>
              <span>Drag here</span>
            </div>
            <button type="button" class="vid-catbox-pick">+ Add files</button>
            <input type="file" class="vid-catbox-input" multiple hidden />
          </div>
        ))}
      </div>

      <div class="vid-uploads" id="vid-uploads"></div>

      <div class="vid-files">
        <h3 class="vid-files-head">Uploaded for this booking</h3>
        <p class="vid-loading" id="vid-files-empty">Select a booking to see its delivered files.</p>
        <div class="vid-files-list" id="vid-files-list"></div>
      </div>

      <div class="vid-delivery" id="vid-delivery" hidden>
        <div class="vid-delivery-head">
          <h3 class="vid-files-head" style="margin:0">Client delivery</h3>
          <span class="enquiry-status-pill is-pending" id="vid-dlv-status">Draft</span>
        </div>
        <p class="vid-panel-sub" style="margin:0 0 18px">Set the price and how many photos are free, create the link, then send it to the client. They preview the teasers and pay to unlock the full set.</p>
        <div class="vid-dlv-grid">
          <div class="vid-field"><label>Free teaser images</label><input type="number" id="vid-dlv-teaser" min="0" value="3" /></div>
          <div class="vid-field"><label>Shoot price (£)</label><input type="number" id="vid-dlv-base" min="0" step="0.01" /></div>
        </div>
        <div class="vid-dlv-extras">
          <span class="vid-field-label">Extras (travel, additional edits…)</span>
          <div id="vid-dlv-extra-rows"></div>
          <button type="button" class="admin-btn admin-btn-ghost" id="vid-dlv-add-extra">+ Add extra</button>
        </div>
        <div class="vid-dlv-total">Total <strong id="vid-dlv-total">£0</strong></div>
        <div class="vid-dlv-actions">
          <button type="button" class="admin-btn admin-btn-primary" id="vid-dlv-save">Save &amp; create link</button>
          <button type="button" class="admin-btn admin-btn-ghost" id="vid-dlv-copy" hidden>Copy client link</button>
          <button type="button" class="admin-btn admin-btn-ghost" id="vid-dlv-sent" hidden>Mark sent</button>
          <button type="button" class="admin-btn admin-btn-ghost" id="vid-dlv-paid" hidden>Mark paid (manual)</button>
        </div>
        <p class="vid-dlv-link" id="vid-dlv-link" hidden></p>
      </div>
    </div>
  </section>

  <!-- ===================== SETTINGS (pricing & travel) ===================== -->
  <section class="vid-panel wrap" data-panel="settings">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Pricing &amp; travel settings</h2>
        <p class="vid-panel-sub">Jack's base postcode and the travel surcharge that drives the booking quotes.</p>
      </div>
    </div>
    <div class="vid-conn-note">
      <strong>Jack's base postcode must be set before travel charges go live.</strong>
      Distance is measured from here to the shoot postcode; shoots within the free
      radius carry no surcharge, and every mile beyond it is charged at the rate below.
    </div>
    <div class="vid-settings">
      <div class="vid-field">
        <label>Jack's base postcode</label>
        <input type="text" id="vid-set-postcode" placeholder="NN14 1AA" />
      </div>
      <div class="vid-field-row">
        <div class="vid-field"><label>Free radius (miles)</label><input type="number" id="vid-set-radius" min="0" /></div>
        <div class="vid-field"><label>Surcharge per extra mile (pence)</label><input type="number" id="vid-set-rate" min="0" /></div>
        <div class="vid-field"><label>VAT rate (%)</label><input type="number" id="vid-set-vat" min="0" step="0.1" /></div>
      </div>
      <button type="button" class="admin-btn admin-btn-primary" id="vid-set-save">Save settings</button>
      <span class="vid-set-status" id="vid-set-status"></span>
    </div>
  </section>

  <!-- ===================== CONNECTIONS (integrations) ===================== -->
  <section class="vid-panel wrap" data-panel="connections">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Connections</h2>
        <p class="vid-panel-sub">The accounts that power booking, storage, and payments.</p>
      </div>
    </div>

    <div class="vid-conn-grid">
      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>Microsoft 365 — Jack's calendar</h3>
          <span class="enquiry-status-pill is-pending" id="vid-365-pill">Checking…</span>
        </div>
        <p>Status only — nothing to click. This just confirms the booking system can reach Jack's calendar in the background, so new bookings write into his real diary automatically.</p>
        <p class="vid-conn-meta" id="vid-365-meta">Verifying connection…</p>
      </div>

      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>Cloudflare R2 — media storage</h3>
          <span class="enquiry-status-pill is-pending" id="vid-r2-pill">Not connected</span>
        </div>
        <p>Fast, high-resolution storage for shoots. Direct-to-edge uploads for Jack, zero-egress fast downloads for clients.</p>
        <p class="vid-conn-meta" id="vid-r2-meta">Deploy the Worker in <code>worker/</code> and set <code>PUBLIC_R2_WORKER_URL</code>.</p>
      </div>

      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>Stripe — payments</h3>
          <span class="enquiry-status-pill is-pending">Not connected</span>
        </div>
        <p>Paywalls the full gallery and collects payment. Teaser images free, full set on payment.</p>
        <button type="button" class="admin-btn admin-btn-ghost" disabled>Connect Stripe (Phase 5)</button>
      </div>

      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>QuickBooks — invoicing</h3>
          <span class="enquiry-status-pill is-pending">Not connected</span>
        </div>
        <p>Raises and reconciles the invoice once a shoot is paid for. Keeps the books in sync.</p>
        <button type="button" class="admin-btn admin-btn-ghost" disabled>Connect QuickBooks (Phase 5)</button>
      </div>
    </div>
  </section>
  </div>

  <!-- ===================== Booking modal (add / edit) ===================== -->
  <div class="modal-backdrop" id="vid-modal" hidden>
    <div class="modal vid-modal" role="dialog" aria-modal="true" aria-labelledby="vid-modal-title">
      <header class="modal-head">
        <h2 id="vid-modal-title">New booking</h2>
        <button type="button" class="modal-close" id="vid-modal-close" aria-label="Close">&times;</button>
      </header>
      <div class="vid-form" id="vid-form">
        <div class="vid-field">
          <label>Client name *</label>
          <input type="text" data-f="client_name" />
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Email</label><input type="email" data-f="client_email" /></div>
          <div class="vid-field"><label>Phone</label><input type="tel" data-f="client_phone" /></div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Company</label><input type="text" data-f="client_company" /></div>
          <div class="vid-field">
            <label>Brand / price tier</label>
            <select data-f="brand">
              <option value="">— Select —</option>
              <option value="property-experts">The Property Experts</option>
              <option value="fine-and-country">Fine &amp; Country</option>
              <option value="other">Other / direct</option>
            </select>
          </div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Service</label><input type="text" data-f="service" placeholder="Property video, podcast…" /></div>
          <div class="vid-field"><label>Shoot date</label><input type="datetime-local" data-f="shoot_date" /></div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Location</label><input type="text" data-f="location" /></div>
          <div class="vid-field"><label>Quote (£)</label><input type="number" data-f="amount_gbp" min="0" step="0.01" /></div>
        </div>
        <div class="vid-field"><label>Notes</label><textarea data-f="notes" rows="3"></textarea></div>
      </div>
      <footer class="modal-foot">
        <button type="button" class="admin-btn admin-btn-danger" id="vid-delete" hidden>Delete</button>
        <div class="spacer"></div>
        <button type="button" class="admin-btn admin-btn-ghost" id="vid-cancel">Cancel</button>
        <button type="button" class="admin-btn admin-btn-primary" id="vid-save">Save booking</button>
      </footer>
    </div>
  </div>

  <style is:global>
    .admin-hero-pad { padding-top: 100px; }
    @media (max-width: 720px) { .admin-hero-pad { padding-top: 56px; } }

    .admin-bar {
      display: flex; justify-content: space-between; align-items: center;
      gap: 16px; max-width: 1360px; margin: 0 auto;
      padding: 12px 36px 24px; flex-wrap: wrap;
    }
    .admin-back {
      font-family: var(--sans); font-size: 12px; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--english-violet); font-weight: 700;
    }
    .admin-back:hover { color: var(--ink); }
    .admin-bar-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .admin-search {
      padding: 8px 12px; border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 2px;
      font-family: var(--sans); font-size: 13px; color: var(--ink);
      background: var(--paper); min-width: 220px;
    }
    .admin-search:focus { outline: none; border-color: var(--english-violet); }

    .vid-tabs { display: inline-flex; gap: 4px; flex-wrap: wrap; }
    .enquiry-chip {
      display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px;
      background: #fff; border: 1px solid rgba(var(--violet-rgb), 0.3);
      border-radius: 999px; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700;
      color: var(--english-violet); cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .enquiry-chip:hover { background: rgba(var(--violet-rgb), 0.06); }
    .enquiry-chip.is-active {
      background: var(--english-violet); color: var(--paper); border-color: var(--english-violet);
    }

    /* ---- Panels ---- */
    .vid-panel { max-width: 1360px; margin: 0 auto; padding: 0 36px 200px; display: none; }
    .vid-panel.is-active { display: block; }
    .vid-panel-head {
      display: flex; justify-content: space-between; align-items: flex-end;
      gap: 16px; flex-wrap: wrap; margin-bottom: 24px;
    }
    .vid-panel-title { font-family: var(--serif); font-size: 30px; font-weight: 500; color: var(--ink); margin: 0; }
    .vid-panel-sub { font-family: var(--sans); font-size: 14px; color: rgba(28, 29, 34, 0.6); margin: 4px 0 0; }
    .vid-loading { font-family: var(--sans); font-size: 14px; color: rgba(28, 29, 34, 0.55); padding: 40px 0; }

    /* ---- Settings cog ---- */
    .vid-cog-wrap { position: relative; }
    .vid-cog {
      display: inline-flex; align-items: center; gap: 8px; padding: 9px 14px;
      background: #fff; border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 999px;
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.16em; text-transform: uppercase;
      font-weight: 700; color: var(--english-violet); cursor: pointer; transition: background 0.2s;
    }
    .vid-cog:hover { background: rgba(var(--violet-rgb), 0.06); }
    .vid-cog-menu {
      position: absolute; right: 0; top: calc(100% + 8px); z-index: 30;
      background: var(--paper); border: 1px solid rgba(var(--violet-rgb), 0.2); border-radius: 8px;
      box-shadow: 0 18px 50px rgba(20, 18, 26, 0.18); padding: 6px; min-width: 220px;
      display: flex; flex-direction: column;
    }
    .vid-cog-menu[hidden] { display: none; }
    .vid-cog-menu button, .vid-cog-menu .vid-cog-link {
      text-align: left; background: none; border: none; cursor: pointer; border-radius: 6px;
      font-family: var(--sans); font-size: 13px; color: var(--ink); padding: 11px 12px;
      text-decoration: none; display: block;
    }
    .vid-cog-menu button:hover, .vid-cog-menu .vid-cog-link:hover { background: rgba(var(--violet-rgb), 0.07); color: var(--english-violet); }
    .vid-cog-menu .vid-cog-link { border-top: 1px solid rgba(var(--violet-rgb), 0.12); margin-top: 2px; }

    /* ---- Clients list ---- */
    .vid-clients { display: flex; flex-direction: column; gap: 10px; }
    .vid-client {
      display: grid; grid-template-columns: 1.4fr 1fr auto; gap: 18px; align-items: center;
      background: var(--paper); border: 1px solid rgba(var(--violet-rgb), 0.18); border-radius: 8px;
      padding: 18px 22px; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    }
    .vid-client:hover { border-color: var(--english-violet); box-shadow: 0 6px 20px rgba(20, 18, 26, 0.08); transform: translateY(-1px); }
    .vid-client.is-complete { opacity: 0.6; }
    .vid-client-name { font-family: var(--serif); font-size: 20px; font-weight: 500; color: var(--ink); }
    .vid-client-co { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.55); margin-top: 2px; }
    .vid-client-next { font-family: var(--sans); font-size: 13px; color: rgba(28, 29, 34, 0.7); }
    .vid-client-stage {
      justify-self: end; display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--sans); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
      font-weight: 700; color: var(--english-violet);
      background: rgba(var(--violet-rgb), 0.08); padding: 5px 12px; border-radius: 999px; white-space: nowrap;
    }
    .vid-client-when { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.5); margin-top: 4px; }
    @media (max-width: 720px) { .vid-client { grid-template-columns: 1fr; gap: 8px; } .vid-client-stage { justify-self: start; } }

    /* ---- Candidate file (CRM one-pager) ---- */
    .vid-cand-back {
      background: none; border: none; cursor: pointer; font-family: var(--sans);
      font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700;
      color: var(--english-violet); padding: 0; margin-bottom: 28px;
    }
    .vid-cand-back:hover { color: var(--ink); }
    .vid-cand {
      max-width: 820px; margin: 0 auto; text-align: left;
      background: var(--paper); border: 1px solid rgba(var(--violet-rgb), 0.16); border-radius: 14px;
      padding: clamp(26px, 3.5vw, 44px) clamp(24px, 3.5vw, 44px) clamp(28px, 3.5vw, 40px);
    }
    .vid-cand-who { font-family: var(--sans); font-size: 12px; letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700; color: rgba(28, 29, 34, 0.5); }
    .vid-cand-co { font-family: var(--sans); font-size: 13px; color: rgba(28, 29, 34, 0.55); margin-top: 4px; }
    .vid-cand-big {
      font-family: var(--serif); font-weight: 500; color: var(--ink);
      font-size: clamp(28px, 4vw, 44px); line-height: 1.08; letter-spacing: -0.01em;
      margin: 2px 0 0;
    }
    .vid-cand-sub { font-family: var(--serif); font-style: italic; font-size: clamp(16px, 1.7vw, 21px); color: var(--english-violet); margin: 8px 0 0; }
    .vid-cand-next {
      font-family: var(--sans); font-size: 14.5px; line-height: 1.6; color: rgba(28, 29, 34, 0.72);
      max-width: 62ch; margin: 10px 0 0;
    }
    .vid-cand-meta {
      display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 10px 26px;
      font-family: var(--sans); font-size: 13px; color: rgba(28, 29, 34, 0.6);
      margin: 22px 0 4px; padding-top: 22px; border-top: 1px solid rgba(var(--violet-rgb), 0.12);
    }
    .vid-cand-meta strong { color: var(--ink); font-weight: 700; }
    .vid-cand-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 10px; margin-top: 22px; }
    /* Progress timeline — runs edge-to-edge (same width as the meta above),
       evenly split, first step at the start, last at the end. */
    .vid-timeline { position: relative; margin-top: 26px; padding-top: 22px; border-top: 1px solid rgba(var(--violet-rgb), 0.12); height: 62px; }
    .vid-timeline.is-cancelled { opacity: 0.5; }
    .vid-tl-track { position: absolute; top: 29px; left: 7px; right: 7px; height: 2px; background: rgba(28, 29, 34, 0.15); }
    .vid-tl-track-fill { position: absolute; left: 0; top: 0; height: 100%; background: var(--english-violet); transition: width 0.3s ease; }
    .vid-tl-step { position: absolute; top: 22px; display: flex; flex-direction: column; align-items: center; gap: 9px; transform: translateX(-50%); }
    .vid-tl-step--first { transform: translateX(0); align-items: flex-start; }
    .vid-tl-step--last { transform: translateX(-100%); align-items: flex-end; }
    .vid-tl-dot { width: 14px; height: 14px; border-radius: 50%; background: #fff; border: 2px solid rgba(28, 29, 34, 0.22); position: relative; z-index: 1; transition: background 0.2s, border-color 0.2s, box-shadow 0.2s; }
    .vid-tl-step.is-done .vid-tl-dot { background: var(--english-violet); border-color: var(--english-violet); }
    .vid-tl-step.is-current .vid-tl-dot { box-shadow: 0 0 0 4px rgba(var(--violet-rgb), 0.18); }
    .vid-tl-label { font-family: var(--sans); font-size: 11.5px; color: rgba(28, 29, 34, 0.5); text-align: center; white-space: nowrap; }
    .vid-tl-step--first .vid-tl-label { text-align: left; }
    .vid-tl-step--last .vid-tl-label { text-align: right; }
    .vid-tl-step.is-done .vid-tl-label, .vid-tl-step.is-current .vid-tl-label { color: var(--ink); font-weight: 600; }
    .vid-cand-drawer {
      margin-top: 22px; padding-top: 22px; border-top: 1px solid rgba(var(--violet-rgb), 0.12);
      text-align: left; display: none;
    }
    .vid-cand-drawer.is-open { display: block; }
    .vid-cand-drawer h4 { font-family: var(--sans); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.55); margin: 0 0 12px; }
    .vid-add-opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    @media (max-width: 640px) { .vid-add-opts { grid-template-columns: 1fr; } }
    .vid-add-opt {
      text-align: left; background: rgba(var(--violet-rgb), 0.04); border: 1px solid rgba(var(--violet-rgb), 0.16);
      border-radius: 8px; padding: 14px 16px; cursor: pointer; font-family: var(--sans);
      transition: border-color 0.15s, background 0.15s;
    }
    .vid-add-opt:hover { border-color: var(--english-violet); background: rgba(var(--violet-rgb), 0.07); }
    .vid-add-opt strong { display: block; font-size: 14px; color: var(--ink); margin-bottom: 3px; }
    .vid-add-opt span { font-size: 12px; color: rgba(28,29,34,0.6); }
    .vid-cand-form { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin-top: 14px; }
    .vid-cand-form .vid-field { flex: 1; min-width: 160px; }
    .vid-cand-form .vid-field input { width: 100%; }
    /* ---- Client correspondence + documents ---- */
    .vid-cand-thread { margin-top: 26px; border-top: 1px solid rgba(28,29,34,0.1); padding-top: 20px; text-align: left; }
    .vid-cand-thread h4 { font-family: var(--sans); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.55); margin: 0 0 12px; }
    .vid-msg-sec { margin-top: 24px; padding-top: 22px; border-top: 1px solid rgba(var(--violet-rgb), 0.14); }
    .vid-thread { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }
    .vid-msg { border: 1px solid rgba(28,29,34,0.1); border-left: 3px solid var(--english-violet); border-radius: 8px; padding: 10px 12px; background: #fff; }
    .vid-msg.is-auto { border-left-color: rgba(28,29,34,0.3); }
    .vid-msg-meta { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; color: rgba(28,29,34,0.5); margin-bottom: 4px; }
    .vid-msg-meta strong { color: rgba(28,29,34,0.7); }
    .vid-msg-subj { font-size: 13.5px; font-weight: 700; color: var(--ink); margin-bottom: 2px; }
    .vid-msg-body { font-size: 13px; line-height: 1.5; color: rgba(28,29,34,0.78); }
    .vid-compose { display: flex; flex-direction: column; gap: 8px; max-width: 520px; }
    .vid-compose input[type="text"], .vid-compose textarea { width: 100%; font-family: var(--sans); font-size: 14px; padding: 9px 11px; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; background: #fff; }
    .vid-compose-notify { font-size: 12.5px; color: rgba(28,29,34,0.6); display: flex; align-items: center; gap: 7px; }
    .vid-compose-file { font-size: 12.5px; color: rgba(28,29,34,0.6); display: flex; flex-direction: column; gap: 5px; }
    .vid-compose-file span { font-weight: 700; letter-spacing: 0.02em; }
    .vid-compose-file input[type="file"] { font-family: var(--sans); font-size: 12.5px; }
    .vid-compose .admin-btn { align-self: flex-start; }
    .vid-docs { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
    .vid-doc { display: flex; align-items: center; gap: 10px; border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; padding: 8px 11px; background: #fff; }
    .vid-doc-name { font-size: 13.5px; color: var(--ink); flex: 1; }
    .vid-doc-cat { font-size: 11px; color: rgba(28,29,34,0.5); }
    .vid-doc-x { appearance: none; border: 0; background: none; font-size: 18px; color: rgba(28,29,34,0.4); cursor: pointer; line-height: 1; }
    .vid-doc-x:hover { color: #8a3b2f; }
    .vid-doc-upload { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .vid-doc-upload select { font-family: var(--sans); font-size: 13px; padding: 8px 10px; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; background: #fff; }
    /* Push the primary "Attach document" button to the end of the row. */
    .vid-doc-upload .admin-btn { margin-left: auto; }
    /* Native file inputs styled to match the outline (ghost) admin button. */
    .vid-file { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); }
    .vid-file::file-selector-button { font-family: var(--sans); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700; padding: 10px 16px; margin-right: 12px; border-radius: 2px; border: 1px solid rgba(var(--violet-rgb), 0.4); background: transparent; color: var(--english-violet); cursor: pointer; transition: background 0.2s, border-color 0.2s; }
    .vid-file::file-selector-button:hover { background: rgba(var(--violet-rgb), 0.06); }
    .vid-thread-status { font-size: 12.5px; margin-top: 10px; }

    /* ---- Settings ---- */
    .vid-settings { max-width: 640px; display: flex; flex-direction: column; gap: 16px; }
    .vid-settings .vid-field input { width: 100%; }
    .vid-set-status { font-family: var(--sans); font-size: 13px; color: #2c7a4b; margin-left: 12px; }

    /* ---- Pipeline — full-width stages stacked vertically ---- */
    .vid-board { display: flex; flex-direction: column; gap: 14px; padding-bottom: 8px; }
    .vid-col {
      background: rgba(var(--violet-rgb), 0.04); border: 1px solid rgba(var(--violet-rgb), 0.15);
      border-radius: 4px; display: flex; flex-direction: column;
    }
    .vid-col.is-drop { border-color: var(--english-violet); background: rgba(var(--violet-rgb), 0.1); }
    .vid-col-head {
      display: flex; justify-content: flex-start; align-items: center; gap: 10px;
      padding: 12px 18px; border-bottom: 1px solid rgba(var(--violet-rgb), 0.12);
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.18em;
      text-transform: uppercase; font-weight: 700; color: var(--english-violet);
    }
    .vid-col-count {
      min-width: 18px; text-align: center; padding: 1px 7px; border-radius: 999px;
      background: rgba(var(--violet-rgb), 0.12); font-size: 10px; color: rgba(28,29,34,0.7);
    }
    /* Cards flow left-to-right and wrap, so a busy stage fills the width */
    .vid-col-list { padding: 12px; display: flex; flex-wrap: wrap; gap: 10px; min-height: 56px; align-content: flex-start; }
    .vid-col-list:empty::after,
    .vid-col-list.is-empty::after { content: "Drop a job here"; font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.35); padding: 8px 6px; }
    .vid-card {
      flex: 0 0 clamp(220px, 24%, 280px); background: var(--paper);
      border: 1px solid rgba(var(--violet-rgb), 0.2); border-radius: 3px;
      padding: 12px 13px; cursor: grab; box-shadow: 0 1px 2px rgba(20, 18, 26, 0.04);
      transition: box-shadow 0.15s, transform 0.15s, border-color 0.15s;
    }
    @media (max-width: 640px) { .vid-card { flex-basis: 100%; } }
    .vid-card:hover { border-color: var(--english-violet); box-shadow: 0 4px 14px rgba(20, 18, 26, 0.1); }
    .vid-card.is-dragging { opacity: 0.5; }
    .vid-card-name { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); }
    .vid-card-meta { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.6); margin-top: 3px; }
    .vid-card-foot {
      display: flex; justify-content: space-between; align-items: center; margin-top: 10px;
      font-family: var(--sans); font-size: 11px; color: rgba(28, 29, 34, 0.55);
    }
    .vid-card-brand {
      font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700;
      padding: 2px 7px; border-radius: 999px; background: rgba(var(--violet-rgb), 0.1); color: var(--english-violet);
    }
    .vid-card-amount { font-family: var(--serif); font-size: 15px; font-weight: 500; color: var(--ink); }

    /* ---- Bookings table (reuses enquiry-table look) ---- */
    .enquiry-table {
      display: grid; gap: 1px; background: rgba(var(--violet-rgb), 0.18);
      border: 1px solid rgba(var(--violet-rgb), 0.18); border-radius: 2px; overflow: hidden;
    }
    .vid-brow {
      display: grid; grid-template-columns: 1.4fr 1.2fr 1fr 1fr 110px 24px;
      gap: 16px; padding: 16px 20px; background: var(--paper);
      align-items: center; cursor: pointer; transition: background 0.15s;
    }
    .vid-brow.is-header {
      cursor: default; background: rgba(var(--violet-rgb), 0.04); font-family: var(--sans);
      font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
      font-weight: 700; color: rgba(28, 29, 34, 0.55);
    }
    .vid-brow:not(.is-header):hover { background: rgba(var(--violet-rgb), 0.04); }
    .vid-bname { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); }
    .vid-bmeta { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.55); margin-top: 2px; }

    /* ---- Diary (per-day hour blocks) ---- */
    .vid-diary { display: flex; flex-direction: column; gap: 8px; max-width: 760px; }
    .vid-day { background: var(--paper); border: 1px solid rgba(var(--violet-rgb), 0.18); border-radius: 4px; overflow: hidden; }
    .vid-day-head {
      display: flex; align-items: center; gap: 14px; width: 100%; text-align: left;
      padding: 14px 18px; background: transparent; border: none; cursor: pointer;
      font-family: var(--sans);
    }
    .vid-day-head:hover { background: rgba(var(--violet-rgb),0.04); }
    .vid-day-name { font-size: 14px; font-weight: 700; color: var(--ink); min-width: 110px; }
    .vid-day-summary { font-size: 13px; color: rgba(28,29,34,0.6); flex: 1; }
    .vid-day-summary.is-off { color: rgba(28,29,34,0.4); }
    .vid-day-chev { font-family: var(--serif); color: var(--english-violet); transition: transform 0.2s; }
    .vid-day.is-open .vid-day-chev { transform: rotate(90deg); }
    .vid-day-hours { display: none; flex-wrap: wrap; gap: 6px; padding: 4px 18px 18px; }
    .vid-day.is-open .vid-day-hours { display: flex; }
    .vid-hour {
      padding: 7px 0; width: 64px; text-align: center; border: 1px solid rgba(var(--violet-rgb),0.25);
      border-radius: 999px; background: transparent; font-family: var(--sans); font-size: 12px;
      color: rgba(28,29,34,0.65); cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .vid-hour:hover { border-color: var(--english-violet); }
    .vid-hour.is-on { background: var(--english-violet); color: var(--paper); border-color: var(--english-violet); }
    .vid-diary-save { margin-top: 14px; }

    /* ---- Deliver ---- */
    .vid-deliver-pick { max-width: 440px; margin-bottom: 20px; }
    /* ---- Category drop-boxes ---- */
    .vid-catgrid-intro { font-family: var(--sans); font-size: 13px; line-height: 1.55; color: rgba(28,29,34,0.6); max-width: 640px; margin: 0 0 16px; }
    .vid-catgrid-intro em { font-style: normal; font-weight: 700; color: var(--english-violet); }
    .vid-catgrid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 12px;
    }
    .vid-catbox {
      display: flex; flex-direction: column; gap: 10px;
      border: 2px dashed rgba(var(--violet-rgb), 0.28); border-radius: 10px;
      padding: 16px 16px 14px;
      background: rgba(255, 255, 255, 0.5);
      transition: border-color 0.2s, background 0.2s, transform 0.15s;
    }
    .vid-catbox.is-drag { border-color: var(--english-violet); background: rgba(var(--violet-rgb), 0.08); transform: translateY(-2px); }
    .vid-catgrid.is-disabled { opacity: 0.5; pointer-events: none; }
    .vid-catbox-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; }
    .vid-catbox-name { font-family: var(--serif); font-size: 18px; font-weight: 500; color: var(--ink); }
    .vid-catbox-count {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      min-width: 22px; text-align: center; padding: 2px 7px; border-radius: 999px;
      background: rgba(var(--violet-rgb), 0.1); color: var(--english-violet);
    }
    .vid-catbox-drop {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 14px 0; color: rgba(28,29,34,0.45);
      font-family: var(--sans); font-size: 12px; letter-spacing: 0.04em;
    }
    .vid-catbox-pick {
      appearance: none; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.06em; color: var(--english-violet);
      background: rgba(var(--violet-rgb), 0.06); border: 1px solid rgba(var(--violet-rgb), 0.2);
      border-radius: 8px; padding: 9px 12px; transition: background 0.2s, color 0.2s;
    }
    .vid-catbox-pick:hover { background: var(--english-violet); color: var(--paper); }

    .vid-uploads { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
    .vid-up {
      border: 1px solid rgba(var(--violet-rgb), 0.18); border-radius: 4px;
      padding: 14px 16px; background: var(--paper);
    }
    .vid-up-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .vid-up-name { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); word-break: break-all; }
    .vid-up-stat { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.6); white-space: nowrap; }
    .vid-up-stat.is-done { color: #2c7a4b; }
    .vid-up-stat.is-error { color: #a05a3c; }
    .vid-up-bar { height: 6px; border-radius: 999px; background: rgba(var(--violet-rgb),0.12); margin-top: 10px; overflow: hidden; }
    .vid-up-fill { height: 100%; width: 0; background: var(--english-violet); border-radius: 999px; transition: width 0.2s ease; }
    .vid-up-fill.is-done { background: #2c7a4b; }
    .vid-up-fill.is-error { background: #a05a3c; }

    .vid-files { margin-top: 36px; }
    .vid-files-head { font-family: var(--sans); font-weight: 700; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.6); margin: 0 0 14px; }
    .vid-files-list { display: flex; flex-direction: column; gap: 1px; background: rgba(var(--violet-rgb),0.18); border: 1px solid rgba(var(--violet-rgb),0.18); border-radius: 3px; overflow: hidden; }
    .vid-fgroup {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 16px; background: rgba(var(--violet-rgb), 0.07);
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet);
    }
    .vid-fgroup-count { color: rgba(28,29,34,0.45); font-weight: 600; letter-spacing: 0.04em; }
    .vid-frow { display: grid; grid-template-columns: 1fr 130px 80px 100px 70px; gap: 14px; align-items: center; padding: 12px 16px; background: var(--paper); font-family: var(--sans); font-size: 13px; }
    .vid-frow-name { color: var(--ink); font-weight: 600; word-break: break-all; }
    .vid-frow-meta { color: rgba(28,29,34,0.55); font-size: 12px; }
    .vid-frow-cat select {
      width: 100%; font-family: var(--sans); font-size: 12px;
      padding: 6px 8px; border: 1px solid rgba(var(--violet-rgb),0.22); border-radius: 6px;
      background: #fff; color: var(--ink); cursor: pointer;
    }
    .vid-frow-cat select:focus { outline: none; border-color: var(--english-violet); }
    .vid-frow-act { text-align: right; }
    .vid-frow-link { color: var(--english-violet); font-weight: 700; cursor: pointer; background: none; border: none; font-family: var(--sans); font-size: 12px; }
    .vid-frow-del { color: #a05a3c; cursor: pointer; background: none; border: none; font-family: var(--sans); font-size: 12px; font-weight: 700; }
    .vid-delivery { margin-top: 36px; border-top: 1px solid rgba(var(--violet-rgb),0.18); padding-top: 28px; max-width: 640px; }
    .vid-delivery-head { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
    .vid-dlv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .vid-dlv-extras { margin-top: 18px; }
    .vid-field-label { display: block; font-family: var(--sans); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.6); margin-bottom: 8px; }
    .vid-dlv-extra { display: grid; grid-template-columns: 1fr 130px 34px; gap: 8px; margin-bottom: 8px; }
    .vid-dlv-extra input { padding: 8px 10px; border: 1px solid rgba(var(--violet-rgb),0.3); border-radius: 2px; font-family: var(--sans); font-size: 14px; color: var(--ink); background: var(--paper); }
    .vid-dlv-extra input:focus { outline: none; border-color: var(--english-violet); }
    .vid-dlv-extra-del { border: none; background: none; color: #a05a3c; cursor: pointer; font-size: 20px; line-height: 1; }
    .vid-dlv-total { margin-top: 20px; font-family: var(--sans); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.6); }
    .vid-dlv-total strong { font-family: var(--serif); font-size: 26px; font-weight: 500; color: var(--ink); margin-left: 10px; }
    .vid-dlv-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
    .vid-dlv-link { margin-top: 14px; font-family: var(--sans); font-size: 13px; color: var(--english-violet); word-break: break-all; }
    @media (max-width: 720px) { .vid-dlv-grid { grid-template-columns: 1fr; } .vid-dlv-extra { grid-template-columns: 1fr 100px 30px; } }
    .vid-conn-meta { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); margin: 0; }
    .vid-conn-meta code, .vid-conn-note code { background: rgba(var(--violet-rgb),0.1); padding: 1px 5px; border-radius: 3px; font-size: 11px; }
    @media (max-width: 720px) { .vid-frow { grid-template-columns: 1fr auto; } .vid-frow-meta { display: none; } }

    /* ---- Connections ---- */
    .vid-conn-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .vid-conn-card {
      padding: 22px 24px; border: 1px solid rgba(var(--violet-rgb), 0.2);
      border-radius: 4px; background: var(--paper);
    }
    .vid-conn-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px; }
    .vid-conn-card h3 { font-family: var(--serif); font-size: 20px; font-weight: 500; color: var(--ink); margin: 0; }
    .vid-conn-card p { font-family: var(--sans); font-size: 13px; line-height: 1.55; color: rgba(28, 29, 34, 0.6); margin: 0 0 16px; }
    .vid-conn-note {
      padding: 14px 18px; border-left: 3px solid var(--english-violet);
      background: rgba(var(--violet-rgb), 0.05); border-radius: 2px; margin-bottom: 20px;
      font-family: var(--sans); font-size: 13px; line-height: 1.55; color: rgba(28, 29, 34, 0.75);
    }
    .vid-conn-note.is-pending { border-left-color: #b78a2e; background: rgba(183, 138, 46, 0.08); }
    .vid-conn-note strong { color: var(--ink); }

    .enquiry-status-pill {
      display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px;
      border-radius: 999px; font-family: var(--sans); font-size: 10px;
      letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700;
    }
    .enquiry-status-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .enquiry-status-pill.is-pending { color: #b78a2e; background: rgba(183, 138, 46, 0.12); }
    .enquiry-status-pill.is-paid { color: #2c7a4b; background: rgba(44, 122, 75, 0.1); }

    /* ---- Modal ---- */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 200; background: rgba(20, 18, 26, 0.55);
      display: flex; align-items: center; justify-content: center; padding: 24px;
    }
    .modal-backdrop[hidden] { display: none; }
    .modal.vid-modal {
      background: var(--paper); max-width: 640px; width: 100%; max-height: 88vh;
      display: flex; flex-direction: column; border-radius: 4px; overflow: hidden;
      box-shadow: 0 30px 80px rgba(20, 18, 26, 0.35);
    }
    .modal-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 20px 28px; border-bottom: 1px solid rgba(var(--violet-rgb), 0.12);
    }
    .modal-head h2 { font-family: var(--serif); font-size: 22px; font-weight: 500; margin: 0; color: var(--ink); }
    .modal-close { background: transparent; border: none; font-size: 28px; line-height: 1; color: var(--english-violet); cursor: pointer; padding: 0 4px; }
    .vid-form { padding: 24px 28px; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 14px; }
    .vid-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .vid-field { display: flex; flex-direction: column; gap: 5px; }
    .vid-field label {
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.14em;
      text-transform: uppercase; font-weight: 700; color: rgba(28, 29, 34, 0.6);
    }
    .vid-field input, .vid-field select, .vid-field textarea {
      padding: 9px 12px; border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 2px;
      font-family: var(--sans); font-size: 14px; color: var(--ink); background: var(--paper);
      resize: vertical;
    }
    .vid-field input:focus, .vid-field select:focus, .vid-field textarea:focus { outline: none; border-color: var(--english-violet); }
    .modal-foot {
      display: flex; gap: 8px; align-items: center; padding: 16px 28px;
      border-top: 1px solid rgba(var(--violet-rgb), 0.12); flex-wrap: wrap;
    }
    .modal-foot .spacer { flex: 1; }
    .admin-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px;
      border-radius: 2px; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700;
      cursor: pointer; border: 1px solid transparent;
      transition: background 0.2s, color 0.2s, border-color 0.2s; text-decoration: none;
    }
    .admin-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .admin-btn-primary { background: var(--english-violet); color: var(--paper); }
    .admin-btn-primary:hover { background: var(--ink); color: var(--paper); }
    .admin-btn-ghost { background: transparent; border-color: rgba(var(--violet-rgb), 0.4); color: var(--english-violet); }
    .admin-btn-ghost:hover { background: rgba(var(--violet-rgb), 0.06); }
    .admin-btn-danger { background: transparent; border-color: #a05a3c; color: #a05a3c; }
    .admin-btn-danger:hover { background: #a05a3c; color: var(--paper); }

    @media (max-width: 980px) {
      .vid-conn-grid { grid-template-columns: 1fr; }
      .vid-deliver-steps { grid-template-columns: 1fr; }
      .vid-day { grid-template-columns: 1fr 1fr; }
      .vid-brow { grid-template-columns: 1fr; gap: 6px; }
      .vid-brow.is-header { display: none; }
    }
  </style>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { supabase, gbpFromPence } from "../../lib/supabase.js";
    import { bookingLocation } from "../../lib/videography-config.js";

    // Deployed Cloudflare Worker URL (worker/). Set PUBLIC_R2_WORKER_URL in env.
    const WORKER_URL = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const PART_SIZE = 50 * 1024 * 1024; // 50 MB parts

    const STAGES = [
      { key: "booked",      label: "Booked" },
      { key: "shoot_day",   label: "Shoot day" },
      { key: "editing",     label: "Editing" },
      { key: "final_draft", label: "Final draft" },
      { key: "invoice_out", label: "Invoice out" },
      { key: "complete",    label: "Complete" },
    ];
    const DAYS = [
      { d: 1, name: "Monday" }, { d: 2, name: "Tuesday" }, { d: 3, name: "Wednesday" },
      { d: 4, name: "Thursday" }, { d: 5, name: "Friday" }, { d: 6, name: "Saturday" },
      { d: 0, name: "Sunday" },
    ];

    function escapeHtml(s) {
      return String(s ?? "")
        .replace(/&/g, "&amp;").replace(/</g, "&lt;")
        .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }
    function fmtWhen(iso) {
      if (!iso) return "—";
      const d = new Date(iso);
      return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
    }
    const BRAND_LABEL = {
      "property-experts": "Property Experts",
      "fine-and-country": "Fine & Country",
      "other": "Direct",
    };

    let bookings = [];
    let vidSettings = { base_postcode: "NN14 1AA", free_radius_miles: 40, surcharge_pence_per_mile: 55, vat_rate: 0.20 };
    let baseCoords = null;

    /* ---------- Panel switching + settings cog ---------- */
    function showPanel(name) {
      document.querySelectorAll(".vid-panel").forEach((p) => {
        p.classList.toggle("is-active", p.getAttribute("data-panel") === name);
      });
      try { window.scrollTo({ top: 0, behavior: "instant" }); } catch (_) { window.scrollTo(0, 0); }
    }
    function initNav() {
      const cog = document.getElementById("vid-cog");
      const menu = document.getElementById("vid-cog-menu");
      cog?.addEventListener("click", (e) => {
        e.stopPropagation();
        const willOpen = menu.hidden;
        menu.hidden = !willOpen;
        cog.setAttribute("aria-expanded", String(willOpen));
      });
      document.addEventListener("click", () => { if (menu && !menu.hidden) menu.hidden = true; });
      menu?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-go]");
        if (!btn) return;
        e.stopPropagation();
        menu.hidden = true;
        const go = btn.getAttribute("data-go");
        showPanel(go);
        if (go === "deliver") populateDeliverBookings();
        if (go === "clients") renderClients(document.getElementById("vid-client-search")?.value || "");
      });
      document.getElementById("vid-cand-back")?.addEventListener("click", () => {
        showPanel("clients");
        renderClients(document.getElementById("vid-client-search")?.value || "");
      });
      document.getElementById("vid-client-search")?.addEventListener("input", (e) => renderClients(e.target.value || ""));
    }

    /* ---------- Pipeline (kanban) ---------- */
    function renderBoard() {
      const board = document.getElementById("vid-board");
      const loading = document.getElementById("vid-board-loading");
      if (!board) return;
      if (loading) loading.hidden = true;
      board.hidden = false;

      board.innerHTML = STAGES.map((s) => {
        const cards = bookings
          .filter((b) => b.stage === s.key)
          .sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));
        return `
          <div class="vid-col" data-stage="${s.key}">
            <div class="vid-col-head">
              <span>${s.label}</span>
              <span class="vid-col-count">${cards.length}</span>
            </div>
            <div class="vid-col-list" data-stage="${s.key}">
              ${cards.map(cardHtml).join("")}
            </div>
          </div>`;
      }).join("");

      board.querySelectorAll(".vid-card").forEach((el) => {
        el.addEventListener("dragstart", onDragStart);
        el.addEventListener("dragend", onDragEnd);
        el.addEventListener("click", () => openModal(el.getAttribute("data-id")));
      });
      board.querySelectorAll(".vid-col-list").forEach((col) => {
        col.addEventListener("dragover", onDragOver);
        col.addEventListener("dragleave", onDragLeave);
        col.addEventListener("drop", onDrop);
      });
    }

    function cardHtml(b) {
      const brand = b.brand ? `<span class="vid-card-brand">${escapeHtml(BRAND_LABEL[b.brand] || b.brand)}</span>` : "<span></span>";
      const amount = b.amount_pence != null ? `<span class="vid-card-amount">${gbpFromPence(b.amount_pence)}</span>` : "";
      return `
        <div class="vid-card" draggable="true" data-id="${b.id}">
          <div class="vid-card-name">${escapeHtml(b.client_name)}</div>
          <div class="vid-card-meta">${escapeHtml(b.service || b.client_company || "—")}</div>
          <div class="vid-card-meta">${b.shoot_date ? "📅 " + fmtWhen(b.shoot_date) : ""}</div>
          <div class="vid-card-foot">${brand}${amount}</div>
        </div>`;
    }

    let dragId = null;
    function onDragStart(e) { dragId = e.currentTarget.getAttribute("data-id"); e.currentTarget.classList.add("is-dragging"); e.dataTransfer.effectAllowed = "move"; }
    function onDragEnd(e) { e.currentTarget.classList.remove("is-dragging"); }
    function onDragOver(e) { e.preventDefault(); e.currentTarget.closest(".vid-col")?.classList.add("is-drop"); }
    function onDragLeave(e) { e.currentTarget.closest(".vid-col")?.classList.remove("is-drop"); }
    async function onDrop(e) {
      e.preventDefault();
      const col = e.currentTarget.closest(".vid-col");
      col?.classList.remove("is-drop");
      const newStage = e.currentTarget.getAttribute("data-stage");
      if (!dragId || !newStage) return;
      const b = bookings.find((x) => x.id === dragId);
      if (!b || b.stage === newStage) return;
      const prev = b.stage;
      b.stage = newStage;        // optimistic
      renderBoard();
      const { error } = await supabase.from("videography_bookings").update({ stage: newStage }).eq("id", dragId);
      if (error) { b.stage = prev; renderBoard(); alert("Couldn't move card: " + error.message); }
    }

    /* ---------- Bookings list ---------- */
    function renderBookings(filter = "") {
      const table = document.getElementById("vid-bookings-table");
      const empty = document.getElementById("vid-bookings-empty");
      if (!table) return;
      const q = filter.trim().toLowerCase();
      const rows = bookings.filter((b) =>
        !q || [b.client_name, b.client_company, b.brand, b.service, b.client_email]
          .filter(Boolean).some((v) => String(v).toLowerCase().includes(q)));
      if (!rows.length) { table.innerHTML = ""; if (empty) empty.hidden = false; return; }
      if (empty) empty.hidden = true;
      const stageLabel = (k) => (STAGES.find((s) => s.key === k) || {}).label || k;
      table.innerHTML =
        `<div class="vid-brow is-header"><div>Client</div><div>Service</div><div>Brand</div><div>Stage</div><div>Quote</div><div></div></div>` +
        rows.map((b) => `
          <div class="vid-brow" data-id="${b.id}">
            <div><div class="vid-bname">${escapeHtml(b.client_name)}</div><div class="vid-bmeta">${escapeHtml(b.client_company || b.client_email || "—")}</div></div>
            <div class="vid-bmeta">${escapeHtml(b.service || "—")}</div>
            <div class="vid-bmeta">${escapeHtml(BRAND_LABEL[b.brand] || b.brand || "—")}</div>
            <div class="vid-bmeta">${escapeHtml(stageLabel(b.stage))}</div>
            <div class="vid-bname">${b.amount_pence != null ? gbpFromPence(b.amount_pence) : "—"}</div>
            <div style="text-align:right;color:var(--english-violet)">&rarr;</div>
          </div>`).join("");
      table.querySelectorAll("[data-id]").forEach((el) =>
        el.addEventListener("click", () => openModal(el.getAttribute("data-id"))));
    }

    /* ---------- Clients list + candidate file (CRM) ---------- */
    const STAGE_FLOW = {
      booked:      { sub: "Booked in",   big: (b) => b.shoot_date ? fmtBig(b.shoot_date) : "Awaiting a date", next: "Confirm the details and prep the kit. This moves to Shoot day on its own when the day arrives.", advance: { to: "shoot_day",   label: "Start shoot day" } },
      shoot_day:   { sub: "Shoot day",   big: (b) => b.shoot_date ? fmtBig(b.shoot_date) : "Today",          next: "Shoot the job, then move it into editing.",                                                  advance: { to: "editing",     label: "Shot — move to editing" } },
      editing:     { sub: "In editing",  big: () => "Editing",                                                next: "Edit the footage, then prepare the final draft.",                                            advance: { to: "final_draft", label: "Editing done — final draft" } },
      final_draft: { sub: "Final draft", big: () => "Final draft",                                            next: "Send the draft for approval, then raise the invoice.",                                        advance: { to: "invoice_out", label: "Approved — raise invoice" } },
      invoice_out: { sub: "Invoice out", big: () => "Awaiting payment",                                       next: "Invoice is out. This completes on its own once the client pays.",                             advance: { to: "complete",    label: "Mark paid — complete" } },
      complete:    { sub: "Complete",    big: () => "Complete",                                               next: "All wrapped up — nothing left to do here.",                                                  advance: null },
    };
    function fmtBig(iso) {
      return new Date(iso).toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
    }
    // Progress timeline. DB stages in order; each display step maps to the stage
    // index it is "reached" at. Content Studio has a Prepped step (prompt pack);
    // Property / Agent don't (no prep element).
    const STAGE_ORDER = ["booked", "shoot_day", "editing", "final_draft", "invoice_out", "complete"];
    function renderTimeline(b) {
      const isStudio = /content|studio/i.test((b.service_type || "") + " " + (b.service || ""));
      const steps = isStudio
        ? [["Booked", 0], ["Prepped", 0.5], ["Shoot day", 1], ["Edited", 2], ["Preview sent", 3], ["Paid", 5]]
        : [["Booked", 0], ["Shoot day", 1], ["Edited", 2], ["Preview sent", 3], ["Paid", 5]];
      const cancelled = b.stage === "cancelled";
      const cur = STAGE_ORDER.indexOf(b.stage);
      const curIdx = cur < 0 ? 0 : cur;
      const n = steps.length;
      let lastReached = 0;
      steps.forEach(([, t], i) => { if (curIdx >= t) lastReached = i; });
      const fillPct = cancelled || n <= 1 ? 0 : (lastReached / (n - 1)) * 100;
      return `<div class="vid-timeline${cancelled ? " is-cancelled" : ""}">
        <div class="vid-tl-track"><div class="vid-tl-track-fill" style="width:${fillPct}%"></div></div>
        ${steps.map(([label, t], i) => {
          const pct = n <= 1 ? 0 : (i / (n - 1)) * 100;
          const done = !cancelled && curIdx >= t;
          const isCur = !cancelled && i === lastReached;
          return `<div class="vid-tl-step${i === 0 ? " vid-tl-step--first" : ""}${i === n - 1 ? " vid-tl-step--last" : ""}${done ? " is-done" : ""}${isCur ? " is-current" : ""}" style="left:${pct}%"><span class="vid-tl-dot"></span><span class="vid-tl-label">${escapeHtml(label)}</span></div>`;
        }).join("")}
      </div>`;
    }
    function nextActionHint(b) {
      if (b.stage === "booked" && b.shoot_date) return "Shoot " + fmtBig(b.shoot_date);
      return (STAGE_FLOW[b.stage] || {}).sub || b.stage;
    }
    function clientSort(a, b) {
      const order = STAGES.map((s) => s.key);
      const ac = a.stage === "complete", bc = b.stage === "complete";
      if (ac !== bc) return ac ? 1 : -1;
      const ad = a.shoot_date ? new Date(a.shoot_date).getTime() : Infinity;
      const bd = b.shoot_date ? new Date(b.shoot_date).getTime() : Infinity;
      if (ad !== bd) return ad - bd;
      return order.indexOf(a.stage) - order.indexOf(b.stage);
    }
    function renderClients(filter = "") {
      const wrap = document.getElementById("vid-clients");
      const loading = document.getElementById("vid-clients-loading");
      const empty = document.getElementById("vid-clients-empty");
      if (!wrap) return;
      if (loading) loading.hidden = true;
      const q = filter.trim().toLowerCase();
      const rows = bookings
        .filter((b) => !q || [b.client_name, b.client_company, b.service, b.client_email].filter(Boolean).some((v) => String(v).toLowerCase().includes(q)))
        .sort(clientSort);
      if (!rows.length) { wrap.hidden = true; if (empty) empty.hidden = false; return; }
      if (empty) empty.hidden = true;
      wrap.hidden = false;
      const stageLabel = (k) => (STAGES.find((s) => s.key === k) || {}).label || k;
      wrap.innerHTML = rows.map((b) => `
        <div class="vid-client ${b.stage === "complete" ? "is-complete" : ""}" data-id="${b.id}">
          <div>
            <div class="vid-client-name">${escapeHtml(b.client_name)}</div>
            <div class="vid-client-co">${escapeHtml(b.client_company || b.service || "—")}</div>
          </div>
          <div>
            <div class="vid-client-next">${escapeHtml(nextActionHint(b))}</div>
            ${b.shoot_date ? `<div class="vid-client-when">${escapeHtml(fmtWhen(b.shoot_date))}</div>` : ""}
          </div>
          <div class="vid-client-stage">${escapeHtml(stageLabel(b.stage))}</div>
        </div>`).join("");
      wrap.querySelectorAll("[data-id]").forEach((el) => el.addEventListener("click", () => openCandidate(el.getAttribute("data-id"))));
    }

    let candId = null;
    function openCandidate(id) { candId = id; showPanel("candidate"); renderCandidate(); }
    function renderCandidate() {
      const b = bookings.find((x) => x.id === candId);
      const el = document.getElementById("vid-cand");
      if (!b || !el) return;
      const f = STAGE_FLOW[b.stage] || STAGE_FLOW.booked;
      const amount = b.amount_pence != null ? gbpFromPence(b.amount_pence) : "—";
      const isStudio = /content|studio/i.test((b.service_type || "") + " " + (b.service || ""));
      const whenStr = b.shoot_date ? new Date(b.shoot_date).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }) : "";
      const loc = bookingLocation({ service_type: b.service_type, source: "videography", postcode: b.location || b.postcode });
      el.innerHTML = `
        <div class="vid-cand-who">${escapeHtml(b.client_name)}</div>
        ${b.client_company ? `<div class="vid-cand-co">${escapeHtml(b.client_company)}</div>` : ""}
        <div class="vid-cand-big">${escapeHtml(f.big(b))}</div>
        <div class="vid-cand-sub">${escapeHtml(f.sub)}</div>
        <p class="vid-cand-next">${escapeHtml(f.next)}</p>
        <div class="vid-cand-meta">
          ${b.service ? `<span>Service&nbsp; <strong>${escapeHtml(b.service)}</strong></span>` : ""}
          ${whenStr ? `<span>When&nbsp; <strong>${escapeHtml(whenStr)}</strong></span>` : ""}
          <span>Quote&nbsp; <strong>${amount}</strong></span>
          ${loc ? `<span>Location&nbsp; <strong>${escapeHtml(loc)}</strong></span>` : ""}
          ${!isStudio ? `<span data-distance>Distance&nbsp; <strong>…</strong></span>` : ""}
        </div>
        <div class="vid-cand-actions">
          ${f.advance ? `<button type="button" class="admin-btn admin-btn-primary" data-advance>${escapeHtml(f.advance.label)} &rarr;</button>` : ""}
          <button type="button" class="admin-btn admin-btn-ghost" data-act="reschedule">Reschedule</button>
          <button type="button" class="admin-btn admin-btn-ghost" data-act="edit">Edit</button>
          <button type="button" class="admin-btn admin-btn-ghost" data-act="add">Add</button>
          ${b.stage !== "booked" ? `<button type="button" class="admin-btn admin-btn-ghost" data-act="back">Move back a step</button>` : ""}
        </div>
        ${renderTimeline(b)}
        <div class="vid-cand-drawer" id="vid-cand-drawer"></div>
        <div class="vid-cand-thread" id="vid-cand-thread"></div>`;
      if (f.advance) el.querySelector("[data-advance]")?.addEventListener("click", () => advanceStage(f.advance.to));
      el.querySelectorAll("[data-act]").forEach((btn) => btn.addEventListener("click", () => candAction(btn.getAttribute("data-act"))));
      if (!isStudio) showDistance(b);
      loadThread(b);
    }

    // ---- Client correspondence + documents (booking_messages / booking_documents) ----
    const BK_CATS = [["prep", "Prep document"], ["agreement", "Agreement"], ["invoice", "Invoice"], ["delivery", "Delivered files"], ["other", "Other"]];
    async function loadThread(b) {
      const host = document.getElementById("vid-cand-thread");
      if (!host || !b) return;
      if (!WORKER_URL) { host.innerHTML = `<h4>Messages &amp; documents</h4><p class="vid-loading">Connect the Worker (PUBLIC_R2_WORKER_URL) to manage correspondence.</p>`; return; }
      host.innerHTML = `<h4>Messages &amp; documents</h4><p class="vid-loading">Loading…</p>`;
      let data = { messages: [], documents: [] };
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/booking/thread?booking_id=${encodeURIComponent(b.id)}`, { headers: { Authorization: "Bearer " + token } });
        if (res.ok) data = await res.json();
      } catch (_) {}
      renderThread(b, data);
    }
    function renderThread(b, data) {
      const host = document.getElementById("vid-cand-thread");
      if (!host) return;
      const msgs = (data.messages || []).map((m) => {
        const who = m.is_automated ? "Automated" : (m.created_by && m.created_by !== "system" ? m.created_by : "You");
        return `<div class="vid-msg ${m.is_automated ? "is-auto" : ""}"><div class="vid-msg-meta"><strong>${escapeHtml(who)}</strong><span>${escapeHtml(fmtWhen(m.created_at) || "")}</span></div>${m.subject ? `<div class="vid-msg-subj">${escapeHtml(m.subject)}</div>` : ""}<div class="vid-msg-body">${escapeHtml(m.body || "").replace(/\n/g, "<br>")}</div></div>`;
      }).join("") || `<p class="vid-loading">No messages yet.</p>`;
      const docs = (data.documents || []).map((d) => `<div class="vid-doc"><span class="vid-doc-name">${escapeHtml(d.title || d.file_name)}</span><span class="vid-doc-cat">${escapeHtml((BK_CATS.find((c) => c[0] === d.category) || [, "Other"])[1])}</span><button type="button" class="vid-doc-x" data-doc-del="${escapeHtml(d.id)}" title="Remove">&times;</button></div>`).join("") || `<p class="vid-loading">No documents attached.</p>`;
      host.innerHTML = `
        <h4>Internal Documents</h4>
        <div class="vid-docs">${docs}</div>
        <div class="vid-doc-upload">
          <select id="vid-doc-cat">${BK_CATS.map((c) => `<option value="${c[0]}">${c[1]}</option>`).join("")}</select>
          <input type="file" id="vid-doc-file" class="vid-file" />
          <button type="button" class="admin-btn admin-btn-primary" id="vid-doc-up">Attach document</button>
        </div>
        <div class="vid-msg-sec">
          <h4>Messages</h4>
          <div class="vid-thread">${msgs}</div>
          <div class="vid-compose">
            <input type="text" id="vid-msg-subj" placeholder="Subject (optional)" />
            <textarea id="vid-msg-body" rows="3" placeholder="Write a message to the client…"></textarea>
            <label class="vid-compose-file"><span>Attach a file (optional)</span><input type="file" id="vid-msg-file" class="vid-file" /></label>
            <label class="vid-compose-notify"><input type="checkbox" id="vid-msg-notify" checked /> Email the client too (any attachment rides along)</label>
            <button type="button" class="admin-btn admin-btn-primary" id="vid-msg-send">Send message</button>
          </div>
        </div>
        <p class="vid-thread-status" id="vid-thread-status" hidden></p>`;
      document.getElementById("vid-msg-send")?.addEventListener("click", () => sendMsg(b));
      document.getElementById("vid-doc-up")?.addEventListener("click", () => uploadDoc(b));
      host.querySelectorAll("[data-doc-del]").forEach((btn) => btn.addEventListener("click", () => deleteDoc(b, btn.getAttribute("data-doc-del"))));
    }
    function threadStatus(msg, ok) {
      const el = document.getElementById("vid-thread-status"); if (!el) return;
      el.hidden = false; el.textContent = msg; el.style.color = ok === false ? "#8a3b2f" : "var(--english-violet)";
    }
    async function sendMsg(b) {
      const body = document.getElementById("vid-msg-body")?.value.trim();
      const subject = document.getElementById("vid-msg-subj")?.value.trim();
      const notify = document.getElementById("vid-msg-notify")?.checked;
      const fileInput = document.getElementById("vid-msg-file");
      const file = fileInput && fileInput.files && fileInput.files[0];
      if (!body && !file) return;
      const btn = document.getElementById("vid-msg-send"); btn.disabled = true; btn.textContent = "Sending…";
      try {
        const token = await authToken();
        // If a file is attached, store it as a booking document first so it both
        // appears under the booking AND can be attached to the notification email.
        let documentId = null;
        if (file) {
          const qs = new URLSearchParams({ booking_id: b.id, source: "videography", category: "other", file_name: file.name, content_type: file.type || "application/octet-stream" });
          const up = await fetch(`${WORKER_URL}/booking/document?${qs.toString()}`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": file.type || "application/octet-stream" }, body: file });
          if (!up.ok) throw new Error(((await up.json().catch(() => ({}))).error) || "Attachment upload failed");
          const upd = await up.json().catch(() => ({}));
          documentId = upd && upd.document ? upd.document.id : null;
        }
        const finalBody = body || `I've attached a document for you: ${file.name}`;
        const res = await fetch(`${WORKER_URL}/booking/message`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: b.id, source: "videography", subject, body: finalBody, notify, document_id: documentId }) });
        if (!res.ok) throw new Error(((await res.json().catch(() => ({}))).error) || "Failed to send");
        loadThread(b);
      } catch (e) { threadStatus(e.message || "Couldn't send", false); btn.disabled = false; btn.textContent = "Send message"; }
    }
    async function uploadDoc(b) {
      const fileInput = document.getElementById("vid-doc-file");
      const cat = document.getElementById("vid-doc-cat")?.value || "other";
      const file = fileInput && fileInput.files && fileInput.files[0];
      if (!file) { threadStatus("Choose a file first.", false); return; }
      const btn = document.getElementById("vid-doc-up"); btn.disabled = true; btn.textContent = "Uploading…";
      try {
        const token = await authToken();
        const qs = new URLSearchParams({ booking_id: b.id, source: "videography", category: cat, file_name: file.name, content_type: file.type || "application/octet-stream" });
        const res = await fetch(`${WORKER_URL}/booking/document?${qs.toString()}`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": file.type || "application/octet-stream" }, body: file });
        if (!res.ok) throw new Error(((await res.json().catch(() => ({}))).error) || "Upload failed");
        loadThread(b);
      } catch (e) { threadStatus(e.message || "Couldn't upload", false); btn.disabled = false; btn.textContent = "Attach document"; }
    }
    async function deleteDoc(b, id) {
      if (!confirm("Remove this document?")) return;
      try {
        const token = await authToken();
        await fetch(`${WORKER_URL}/booking/document?id=${encodeURIComponent(id)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } });
        loadThread(b);
      } catch (_) {}
    }
    function prevStageOf(k) { const i = STAGES.findIndex((s) => s.key === k); return i > 0 ? STAGES[i - 1].key : k; }
    async function advanceStage(to) {
      const b = bookings.find((x) => x.id === candId);
      if (!b) return;
      const prev = b.stage; b.stage = to; renderCandidate();
      const { error } = await supabase.from("videography_bookings").update({ stage: to }).eq("id", b.id);
      if (error) { b.stage = prev; renderCandidate(); alert("Couldn't update stage: " + error.message); return; }
      renderClients(document.getElementById("vid-client-search")?.value || "");
    }
    function candAction(act) {
      const b = bookings.find((x) => x.id === candId);
      if (!b) return;
      if (act === "edit") { openModal(b.id); return; }
      if (act === "back") { advanceStage(prevStageOf(b.stage)); return; }
      const drawer = document.getElementById("vid-cand-drawer");
      if (!drawer) return;
      drawer.classList.add("is-open");
      if (act === "reschedule") {
        drawer.innerHTML = `<h4>Reschedule shoot</h4>
          <div class="vid-cand-form">
            <div class="vid-field"><label>New date &amp; time</label><input type="datetime-local" id="vid-resch" value="${b.shoot_date ? new Date(b.shoot_date).toISOString().slice(0, 16) : ""}" /></div>
            <button type="button" class="admin-btn admin-btn-primary" id="vid-resch-save">Save date</button>
          </div>`;
        document.getElementById("vid-resch-save").addEventListener("click", async () => {
          const v = document.getElementById("vid-resch").value;
          const iso = v ? new Date(v).toISOString() : null;
          const { error } = await supabase.from("videography_bookings").update({ shoot_date: iso }).eq("id", b.id);
          if (error) { alert("Couldn't save: " + error.message); return; }
          b.shoot_date = iso; renderCandidate();
          renderClients(document.getElementById("vid-client-search")?.value || "");
        });
        return;
      }
      if (act === "add") {
        drawer.innerHTML = `<h4>Add to this job — one thing at a time</h4>
          <div class="vid-add-opts">
            <button type="button" class="vid-add-opt" data-add="service"><strong>Additional service</strong><span>Add another service to the shoot.</span></button>
            <button type="button" class="vid-add-opt" data-add="cost"><strong>Extra cost</strong><span>Add a charge to the quote.</span></button>
            <button type="button" class="vid-add-opt" data-add="file"><strong>Edit the file</strong><span>Open the full details to edit.</span></button>
          </div>
          <div id="vid-add-form"></div>`;
        drawer.querySelectorAll("[data-add]").forEach((btn) => btn.addEventListener("click", () => addThing(btn.getAttribute("data-add"))));
      }
    }
    function addThing(kind) {
      const b = bookings.find((x) => x.id === candId);
      if (!b) return;
      if (kind === "file") { openModal(b.id); return; }
      const form = document.getElementById("vid-add-form");
      if (!form) return;
      if (kind === "service") {
        form.innerHTML = `<div class="vid-cand-form"><div class="vid-field"><label>Service to add</label><input type="text" id="vid-add-svc" placeholder="e.g. Drone footage" /></div><button type="button" class="admin-btn admin-btn-primary" id="vid-add-svc-save">Add service</button></div>`;
        document.getElementById("vid-add-svc-save").addEventListener("click", async () => {
          const v = document.getElementById("vid-add-svc").value.trim(); if (!v) return;
          const svc = b.service ? b.service + ", " + v : v;
          const { error } = await supabase.from("videography_bookings").update({ service: svc }).eq("id", b.id);
          if (error) { alert(error.message); return; }
          b.service = svc; renderCandidate(); renderClients(document.getElementById("vid-client-search")?.value || "");
        });
      }
      if (kind === "cost") {
        form.innerHTML = `<div class="vid-cand-form"><div class="vid-field"><label>What for</label><input type="text" id="vid-add-cl" placeholder="e.g. Travel" /></div><div class="vid-field"><label>Amount (£)</label><input type="number" id="vid-add-ca" min="0" step="0.01" /></div><button type="button" class="admin-btn admin-btn-primary" id="vid-add-c-save">Add cost</button></div>`;
        document.getElementById("vid-add-c-save").addEventListener("click", async () => {
          const label = document.getElementById("vid-add-cl").value.trim();
          const amt = parseFloat(document.getElementById("vid-add-ca").value) || 0;
          if (!amt) return;
          const pence = (b.amount_pence || 0) + Math.round(amt * 100);
          const note = (b.notes ? b.notes + "\n" : "") + ("+ £" + amt.toFixed(2) + (label ? " " + label : "")).trim();
          const { error } = await supabase.from("videography_bookings").update({ amount_pence: pence, notes: note }).eq("id", b.id);
          if (error) { alert(error.message); return; }
          b.amount_pence = pence; b.notes = note; renderCandidate(); renderClients(document.getElementById("vid-client-search")?.value || "");
        });
      }
    }

    /* Distance from a central Kettering postcode (Jack's base) via postcodes.io. */
    function haversineMiles(la1, lo1, la2, lo2) {
      const R = 3958.8, t = (x) => (x * Math.PI) / 180;
      const dLa = t(la2 - la1), dLo = t(lo2 - lo1);
      const a = Math.sin(dLa / 2) ** 2 + Math.cos(t(la1)) * Math.cos(t(la2)) * Math.sin(dLo / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(a));
    }
    async function showDistance(b) {
      const span = document.querySelector("#vid-cand [data-distance] strong");
      if (!span) return;
      const m = ((b.location || b.postcode) || "").match(/[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}/i);
      if (!m) { span.textContent = "add a postcode"; return; }
      try {
        const base = await getBaseCoords();
        const r = await fetch("https://api.postcodes.io/postcodes/" + encodeURIComponent(m[0].replace(/\s+/g, "")));
        const d = await r.json();
        if (!d.result) { span.textContent = "postcode not found"; return; }
        const miles = haversineMiles(base.lat, base.lon, d.result.latitude, d.result.longitude);
        span.textContent = Math.round(miles) + " mi from base";
      } catch (_) { span.textContent = "unknown"; }
    }

    /* Auto-advance: a booked job becomes "Shoot day" once its day arrives. */
    function startOfDay(d) { const x = new Date(d); x.setHours(0, 0, 0, 0); return x.getTime(); }
    async function autoAdvance() {
      const today = startOfDay(Date.now());
      const due = bookings.filter((b) => b.stage === "booked" && b.shoot_date && startOfDay(b.shoot_date) <= today);
      for (const b of due) {
        b.stage = "shoot_day";
        await supabase.from("videography_bookings").update({ stage: "shoot_day" }).eq("id", b.id);
      }
    }

    /* ---------- Diary (per-day hour blocks) ---------- */
    let availability = [];
    const DIARY_HOURS = []; for (let h = 6; h <= 21; h++) DIARY_HOURS.push(h); // 06:00–22:00 blocks
    let diaryState = {};   // weekday -> Set(hours)
    let diaryOpen = null;  // currently expanded weekday
    let diaryInit = false;

    function hoursForRow(a) {
      if (a && Array.isArray(a.hours) && a.hours.length) return a.hours.map(Number);
      if (a && a.is_available !== false && a.start_time && a.end_time) {
        const sh = parseInt(a.start_time.split(":")[0], 10);
        const [eh, em] = a.end_time.split(":").map(Number);
        const end = em > 0 ? eh + 1 : eh;
        const out = []; for (let h = sh; h < end; h++) out.push(h); return out;
      }
      return [];
    }
    function fmtHours(set) {
      const hrs = [...set].sort((a, b) => a - b);
      if (!hrs.length) return "Closed";
      const ranges = []; let start = hrs[0], prev = hrs[0];
      for (let i = 1; i < hrs.length; i++) {
        if (hrs[i] === prev + 1) prev = hrs[i];
        else { ranges.push([start, prev + 1]); start = prev = hrs[i]; }
      }
      ranges.push([start, prev + 1]);
      return ranges.map(([a, b]) => `${String(a).padStart(2, "0")}:00–${String(b).padStart(2, "0")}:00`).join(", ");
    }
    function renderDiary() {
      const wrap = document.getElementById("vid-diary");
      if (!wrap) return;
      if (!diaryInit) {
        const byDay = new Map(availability.map((a) => [a.weekday, a]));
        DAYS.forEach(({ d }) => { diaryState[d] = new Set(hoursForRow(byDay.get(d))); });
        diaryInit = true;
      }
      wrap.innerHTML = DAYS.map(({ d, name }) => {
        const set = diaryState[d] || new Set();
        const open = diaryOpen === d;
        return `
          <div class="vid-day ${open ? "is-open" : ""}" data-day="${d}">
            <button type="button" class="vid-day-head" data-day-head="${d}">
              <span class="vid-day-name">${name}</span>
              <span class="vid-day-summary ${set.size ? "" : "is-off"}">${fmtHours(set)}</span>
              <span class="vid-day-chev">›</span>
            </button>
            <div class="vid-day-hours">
              ${DIARY_HOURS.map((h) => `<button type="button" class="vid-hour ${set.has(h) ? "is-on" : ""}" data-day="${d}" data-hour="${h}">${String(h).padStart(2, "0")}:00</button>`).join("")}
            </div>
          </div>`;
      }).join("");
      wrap.querySelectorAll("[data-day-head]").forEach((b) => b.addEventListener("click", () => {
        const d = Number(b.getAttribute("data-day-head"));
        diaryOpen = diaryOpen === d ? null : d;
        renderDiary();
      }));
      wrap.querySelectorAll(".vid-hour").forEach((b) => b.addEventListener("click", () => {
        const d = Number(b.getAttribute("data-day")), h = Number(b.getAttribute("data-hour"));
        const set = diaryState[d] || (diaryState[d] = new Set());
        if (set.has(h)) set.delete(h); else set.add(h);
        renderDiary();
      }));
      const saveBtn = document.getElementById("vid-diary-save");
      if (saveBtn) saveBtn.hidden = false;
    }
    async function saveDiary() {
      const rows = DAYS.map(({ d }) => {
        const hrs = [...(diaryState[d] || new Set())].sort((a, b) => a - b);
        return {
          weekday: d,
          hours: hrs,
          is_available: hrs.length > 0,
          start_time: hrs.length ? `${String(hrs[0]).padStart(2, "0")}:00` : "09:00",
          end_time: hrs.length ? `${String(hrs[hrs.length - 1] + 1).padStart(2, "0")}:00` : "17:00",
        };
      });
      const btn = document.getElementById("vid-diary-save");
      if (btn) { btn.textContent = "Saving…"; btn.disabled = true; }
      const { error } = await supabase.from("videography_availability").upsert(rows, { onConflict: "weekday" });
      if (btn) { btn.disabled = false; btn.textContent = error ? "Error — run the hours migration?" : "Saved ✓"; }
      if (!error) availability = rows.map((r) => ({ ...r }));
      setTimeout(() => { if (btn) btn.textContent = "Save diary"; }, 2200);
    }

    /* ---------- Modal (add / edit booking) ---------- */
    let editingId = null;
    function openModal(id) {
      editingId = id || null;
      const b = id ? bookings.find((x) => x.id === id) : null;
      const set = (f, v) => { const el = document.querySelector(`[data-f="${f}"]`); if (el) el.value = v ?? ""; };
      set("client_name", b?.client_name);
      set("client_email", b?.client_email);
      set("client_phone", b?.client_phone);
      set("client_company", b?.client_company);
      set("brand", b?.brand);
      set("service", b?.service);
      set("shoot_date", b?.shoot_date ? new Date(b.shoot_date).toISOString().slice(0, 16) : "");
      set("location", b?.location);
      set("amount_gbp", b?.amount_pence != null ? (b.amount_pence / 100).toString() : "");
      set("notes", b?.notes);
      document.getElementById("vid-modal-title").textContent = b ? "Edit booking" : "New booking";
      document.getElementById("vid-delete").hidden = !b;
      document.getElementById("vid-modal").hidden = false;
    }
    function closeModal() { document.getElementById("vid-modal").hidden = true; editingId = null; }

    async function saveBooking() {
      const get = (f) => { const el = document.querySelector(`[data-f="${f}"]`); return el ? el.value.trim() : ""; };
      const name = get("client_name");
      if (!name) { alert("Client name is required."); return; }
      const gbp = get("amount_gbp");
      const payload = {
        client_name: name,
        client_email: get("client_email") || null,
        client_phone: get("client_phone") || null,
        client_company: get("client_company") || null,
        brand: get("brand") || null,
        service: get("service") || null,
        shoot_date: get("shoot_date") ? new Date(get("shoot_date")).toISOString() : null,
        location: get("location") || null,
        amount_pence: gbp ? Math.round(parseFloat(gbp) * 100) : null,
        notes: get("notes") || null,
      };
      const btn = document.getElementById("vid-save");
      if (btn) btn.textContent = "Saving…";
      if (editingId) {
        const { error } = await supabase.from("videography_bookings").update(payload).eq("id", editingId);
        if (error) { alert("Save failed: " + error.message); if (btn) btn.textContent = "Save booking"; return; }
        Object.assign(bookings.find((x) => x.id === editingId), payload);
      } else {
        payload.stage = "booked";
        const { data, error } = await supabase.from("videography_bookings").insert(payload).select().single();
        if (error) { alert("Save failed: " + error.message); if (btn) btn.textContent = "Save booking"; return; }
        bookings.unshift(data);
      }
      if (btn) btn.textContent = "Save booking";
      closeModal();
      renderClients(document.getElementById("vid-client-search")?.value || "");
      if (candId) renderCandidate();
      populateDeliverBookings();
    }

    async function deleteBooking() {
      if (!editingId) return;
      if (!confirm("Delete this booking? This can't be undone.")) return;
      const deletedId = editingId;
      const { error } = await supabase.from("videography_bookings").delete().eq("id", deletedId);
      if (error) { alert("Delete failed: " + error.message); return; }
      bookings = bookings.filter((x) => x.id !== deletedId);
      closeModal();
      if (candId === deletedId) { candId = null; showPanel("clients"); }
      renderClients(document.getElementById("vid-client-search")?.value || "");
      populateDeliverBookings();
    }

    /* ---------- Deliver (R2 uploads attached to a booking) ---------- */
    function fmtBytes(n) {
      if (n == null) return "—";
      const u = ["B", "KB", "MB", "GB", "TB"]; let i = 0; let v = Number(n);
      while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }
      return v.toFixed(v >= 10 || i === 0 ? 0 : 1) + " " + u[i];
    }
    function kindFromType(t) {
      if (!t) return "other";
      if (t.startsWith("video/")) return "video";
      if (t.startsWith("image/")) return "image";
      return "other";
    }
    async function authToken() {
      const { data } = await supabase.auth.getSession();
      return data.session ? data.session.access_token : "";
    }
    function deliverBooking() {
      const sel = document.getElementById("vid-deliver-booking");
      return sel ? sel.value : "";
    }
    function populateDeliverBookings() {
      const sel = document.getElementById("vid-deliver-booking");
      if (!sel) return;
      const keep = sel.value;
      const stageLabel = (k) => (STAGES.find((s) => s.key === k) || {}).label || k;
      sel.innerHTML = '<option value="">— Select a client / shoot —</option>' +
        bookings.map((b) => `<option value="${b.id}">${escapeHtml(b.client_name)}${b.client_company ? " · " + escapeHtml(b.client_company) : ""} — ${escapeHtml(stageLabel(b.stage))}</option>`).join("");
      if (keep) sel.value = keep;
    }

    // The set of category drop-boxes (also used to build the recategorise
    // dropdowns and to know which file-list groups to show).
    const DELIVER_CATS = Array.from(document.querySelectorAll(".vid-catbox"))
      .map((b) => b.getAttribute("data-category"));

    function initDeliver() {
      const grid = document.getElementById("vid-catgrid");
      const sel = document.getElementById("vid-deliver-booking");
      if (!grid) return;

      const connected = Boolean(WORKER_URL);
      const configNote = document.getElementById("vid-deliver-config");
      const r2pill = document.getElementById("vid-r2-pill");
      const r2meta = document.getElementById("vid-r2-meta");
      if (configNote) configNote.hidden = connected;
      if (!connected) grid.classList.add("is-disabled");
      if (connected && r2pill) { r2pill.textContent = "Connected"; r2pill.classList.remove("is-pending"); r2pill.classList.add("is-paid"); }
      if (connected && r2meta) r2meta.textContent = "Worker connected.";

      populateDeliverBookings();

      function guard() {
        if (!connected) { alert("Upload backend isn't connected yet — deploy the Worker and set PUBLIC_R2_WORKER_URL."); return false; }
        if (!deliverBooking()) { alert("Pick a booking to deliver to first."); return false; }
        return true;
      }

      // Wire each category box: its own drop target + "Add files" button.
      grid.querySelectorAll(".vid-catbox").forEach((box) => {
        const category = box.getAttribute("data-category");
        const input = box.querySelector(".vid-catbox-input");
        const pick = box.querySelector(".vid-catbox-pick");
        pick?.addEventListener("click", () => { if (guard()) input?.click(); });
        input?.addEventListener("change", () => { handleFiles(input.files, category); input.value = ""; });
        ["dragenter", "dragover"].forEach((ev) => box.addEventListener(ev, (e) => { e.preventDefault(); box.classList.add("is-drag"); }));
        ["dragleave", "drop"].forEach((ev) => box.addEventListener(ev, (e) => { e.preventDefault(); box.classList.remove("is-drag"); }));
        box.addEventListener("drop", (e) => { if (guard()) handleFiles(e.dataTransfer.files, category); });
      });

      sel?.addEventListener("change", () => { loadDeliverFiles(); loadDelivery(deliverBooking()); });

      // Client-delivery panel
      document.getElementById("vid-dlv-base")?.addEventListener("input", recomputeDlvTotal);
      document.getElementById("vid-dlv-add-extra")?.addEventListener("click", () => addExtraRow("", null));
      document.getElementById("vid-dlv-save")?.addEventListener("click", saveDelivery);
      document.getElementById("vid-dlv-copy")?.addEventListener("click", copyDeliveryLink);
      document.getElementById("vid-dlv-sent")?.addEventListener("click", () => setDeliveryStatus("sent"));
      document.getElementById("vid-dlv-paid")?.addEventListener("click", () => setDeliveryStatus("paid"));
    }

    function handleFiles(fileList, category) {
      const bookingId = deliverBooking();
      if (!WORKER_URL || !bookingId) return;
      Array.from(fileList || []).forEach((file) => uploadFile(file, bookingId, category || null));
    }

    function uploadRowUI(file, category) {
      const wrap = document.getElementById("vid-uploads");
      const row = document.createElement("div");
      row.className = "vid-up";
      row.innerHTML =
        `<div class="vid-up-top"><span class="vid-up-name"></span><span class="vid-up-stat">Starting…</span></div>` +
        `<div class="vid-up-bar"><div class="vid-up-fill"></div></div>`;
      row.querySelector(".vid-up-name").textContent = (category ? category + " · " : "") + file.name;
      wrap.prepend(row);
      return {
        setStat: (t, cls) => { const s = row.querySelector(".vid-up-stat"); s.textContent = t; s.className = "vid-up-stat" + (cls ? " " + cls : ""); },
        setPct: (p) => { row.querySelector(".vid-up-fill").style.width = Math.round(p) + "%"; },
        done: () => row.querySelector(".vid-up-fill").classList.add("is-done"),
        error: () => row.querySelector(".vid-up-fill").classList.add("is-error"),
        remove: () => row.remove(),
      };
    }

    function putPart(token, key, uploadId, partNumber, blob, onProgress) {
      return new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        const u = `${WORKER_URL}/part?key=${encodeURIComponent(key)}&uploadId=${encodeURIComponent(uploadId)}&partNumber=${partNumber}`;
        xhr.open("PUT", u);
        xhr.setRequestHeader("Authorization", "Bearer " + token);
        xhr.upload.onprogress = (e) => { if (e.lengthComputable) onProgress(e.loaded); };
        xhr.onload = () => {
          if (xhr.status >= 200 && xhr.status < 300) {
            try { resolve(JSON.parse(xhr.responseText)); } catch (_) { reject(new Error("Bad part response")); }
          } else reject(new Error("Part " + partNumber + " failed (" + xhr.status + ")"));
        };
        xhr.onerror = () => reject(new Error("Network error on part " + partNumber));
        xhr.send(blob);
      });
    }

    async function uploadFile(file, bookingId, category) {
      const ui = uploadRowUI(file, category);
      try {
        const token = await authToken();
        if (!token) throw new Error("Not signed in");
        ui.setStat("Preparing…");
        const cRes = await fetch(`${WORKER_URL}/create`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify({ bookingId, fileName: file.name, contentType: file.type || "application/octet-stream" }),
        });
        if (!cRes.ok) throw new Error("Create failed (" + cRes.status + ")");
        const { key, uploadId } = await cRes.json();

        const total = file.size;
        const partCount = Math.max(1, Math.ceil(total / PART_SIZE));
        const parts = [];
        let baseLoaded = 0;
        for (let i = 0; i < partCount; i++) {
          const start = i * PART_SIZE;
          const blob = file.slice(start, Math.min(start + PART_SIZE, total));
          const partNumber = i + 1;
          let attempt = 0;
          for (;;) {
            try {
              const res = await putPart(token, key, uploadId, partNumber, blob, (loaded) => {
                const pct = total ? ((baseLoaded + loaded) / total) * 100 : 0;
                ui.setPct(pct);
                ui.setStat("Uploading " + Math.round(pct) + "% · part " + partNumber + "/" + partCount);
              });
              parts.push({ partNumber, etag: res.etag });
              baseLoaded += blob.size;
              ui.setPct((baseLoaded / total) * 100);
              break;
            } catch (err) {
              if (++attempt >= 3) throw err;
              ui.setStat("Retrying part " + partNumber + " (" + attempt + ")…");
              await new Promise((r) => setTimeout(r, 800 * attempt));
            }
          }
        }

        ui.setStat("Finalising…");
        const fRes = await fetch(`${WORKER_URL}/complete`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify({ key, uploadId, parts }),
        });
        if (!fRes.ok) throw new Error("Complete failed (" + fRes.status + ")");

        await supabase.from("videography_deliverables").insert({
          booking_id: bookingId, file_name: file.name, r2_key: key,
          size_bytes: file.size, content_type: file.type || null, kind: kindFromType(file.type),
          category: category || null,
        });

        ui.setPct(100); ui.done(); ui.setStat(fmtBytes(file.size) + " · done", "is-done");
        setTimeout(() => ui.remove(), 2500);
        if (deliverBooking() === bookingId) loadDeliverFiles();
      } catch (err) {
        ui.error(); ui.setStat((err && err.message) || "Upload failed", "is-error");
      }
    }

    // Reset the per-box counts on the category drop-boxes.
    function setCatCounts(counts) {
      document.querySelectorAll(".vid-catbox").forEach((box) => {
        const cat = box.getAttribute("data-category");
        const el = box.querySelector("[data-cat-count]");
        if (el) el.textContent = String(counts[cat] || 0);
      });
    }

    function catOptions(selected) {
      return DELIVER_CATS.map((c) =>
        `<option value="${escapeHtml(c)}"${c === selected ? " selected" : ""}>${escapeHtml(c)}</option>`
      ).join("");
    }

    async function loadDeliverFiles() {
      const listEl = document.getElementById("vid-files-list");
      const emptyEl = document.getElementById("vid-files-empty");
      const bookingId = deliverBooking();
      if (!listEl) return;
      if (!bookingId) { listEl.innerHTML = ""; setCatCounts({}); if (emptyEl) { emptyEl.hidden = false; emptyEl.textContent = "Select a booking to see its delivered files."; } return; }
      if (emptyEl) { emptyEl.hidden = false; emptyEl.textContent = "Loading…"; }
      const { data, error } = await supabase
        .from("videography_deliverables").select("*")
        .eq("booking_id", bookingId).order("created_at", { ascending: false });
      if (error) { if (emptyEl) emptyEl.textContent = "Couldn't load files: " + error.message; listEl.innerHTML = ""; return; }
      if (!data || !data.length) { setCatCounts({}); if (emptyEl) { emptyEl.hidden = false; emptyEl.textContent = "No files delivered for this booking yet."; } listEl.innerHTML = ""; return; }
      if (emptyEl) emptyEl.hidden = true;

      // Group by category, in the drop-box order, with anything unknown last.
      const counts = {};
      data.forEach((f) => { const c = f.category || "Other"; counts[c] = (counts[c] || 0) + 1; });
      setCatCounts(counts);
      const order = DELIVER_CATS.slice();
      Object.keys(counts).forEach((c) => { if (!order.includes(c)) order.push(c); });

      let html = "";
      order.forEach((cat) => {
        const rows = data.filter((f) => (f.category || "Other") === cat);
        if (!rows.length) return;
        html += `<div class="vid-fgroup">${escapeHtml(cat)} <span class="vid-fgroup-count">· ${rows.length}</span></div>`;
        html += rows.map((f) => `
          <div class="vid-frow" data-id="${f.id}" data-key="${escapeHtml(f.r2_key)}">
            <div class="vid-frow-name">${escapeHtml(f.file_name)}</div>
            <div class="vid-frow-cat"><select data-recat>${catOptions(f.category || "Other")}</select></div>
            <div class="vid-frow-meta">${escapeHtml(f.kind || "file")}</div>
            <div class="vid-frow-meta">${fmtBytes(f.size_bytes)}</div>
            <div class="vid-frow-act"><button class="vid-frow-del" data-del>Delete</button></div>
          </div>`).join("");
      });
      listEl.innerHTML = html;
      listEl.querySelectorAll("[data-del]").forEach((btn) => btn.addEventListener("click", () => deleteDeliverable(btn.closest(".vid-frow"))));
      listEl.querySelectorAll("[data-recat]").forEach((seln) => seln.addEventListener("change", () => {
        const row = seln.closest(".vid-frow");
        recategorise(row && row.getAttribute("data-id"), seln.value);
      }));
    }

    async function recategorise(id, category) {
      if (!id) return;
      await supabase.from("videography_deliverables").update({ category: category || null }).eq("id", id);
      loadDeliverFiles();
    }

    async function deleteDeliverable(row) {
      if (!row) return;
      const id = row.getAttribute("data-id");
      const key = row.getAttribute("data-key");
      if (!confirm("Delete this file? It will be removed from storage.")) return;
      const token = await authToken();
      try {
        await fetch(`${WORKER_URL}/object?key=${encodeURIComponent(key)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } });
      } catch (_) { /* still remove the record */ }
      await supabase.from("videography_deliverables").delete().eq("id", id);
      loadDeliverFiles();
    }

    /* ---------- Client delivery (gallery link + paywall) ---------- */
    let currentDelivery = null;

    function genToken() {
      try { return crypto.randomUUID().replace(/-/g, ""); }
      catch (_) { return "d" + Date.now().toString(36) + Math.floor(Math.random() * 1e9).toString(36); }
    }
    function dlvExtrasFromDOM() {
      return Array.from(document.querySelectorAll("#vid-dlv-extra-rows .vid-dlv-extra")).map((row) => ({
        label: row.querySelector("[data-x-label]").value.trim(),
        amount_pence: Math.round((parseFloat(row.querySelector("[data-x-amt]").value) || 0) * 100),
      })).filter((e) => e.label || e.amount_pence);
    }
    function addExtraRow(label, pence) {
      const wrap = document.getElementById("vid-dlv-extra-rows");
      const row = document.createElement("div");
      row.className = "vid-dlv-extra";
      row.innerHTML = `<input type="text" data-x-label placeholder="e.g. Travel" /><input type="number" data-x-amt min="0" step="0.01" placeholder="£" /><button type="button" class="vid-dlv-extra-del" aria-label="Remove">&times;</button>`;
      row.querySelector("[data-x-label]").value = label || "";
      if (pence != null) row.querySelector("[data-x-amt]").value = (pence / 100).toString();
      row.querySelector("[data-x-amt]").addEventListener("input", recomputeDlvTotal);
      row.querySelector(".vid-dlv-extra-del").addEventListener("click", () => { row.remove(); recomputeDlvTotal(); });
      wrap.appendChild(row);
    }
    function recomputeDlvTotal() {
      const base = Math.round((parseFloat(document.getElementById("vid-dlv-base").value) || 0) * 100);
      const extras = dlvExtrasFromDOM().reduce((s, e) => s + e.amount_pence, 0);
      document.getElementById("vid-dlv-total").textContent = gbpFromPence(base + extras);
    }
    function setDeliveryStatusUI(status, token) {
      const pill = document.getElementById("vid-dlv-status");
      const copy = document.getElementById("vid-dlv-copy");
      const sent = document.getElementById("vid-dlv-sent");
      const paid = document.getElementById("vid-dlv-paid");
      const linkEl = document.getElementById("vid-dlv-link");
      pill.textContent = { draft: "Draft", sent: "Sent", paid: "Paid" }[status] || "Not created";
      pill.className = "enquiry-status-pill " + (status === "paid" ? "is-paid" : "is-pending");
      const hasLink = Boolean(token);
      copy.hidden = !hasLink; sent.hidden = !hasLink; paid.hidden = !hasLink;
      if (hasLink) {
        linkEl.textContent = `${location.origin}/deliver?d=${token}`;
        linkEl.hidden = false;
        sent.textContent = status === "sent" ? "Re-mark sent" : "Mark sent";
        paid.textContent = status === "paid" ? "Paid ✓" : "Mark paid (manual)";
      } else linkEl.hidden = true;
    }
    async function loadDelivery(bookingId) {
      const card = document.getElementById("vid-delivery");
      if (!card) return;
      if (!bookingId) { card.hidden = true; currentDelivery = null; return; }
      const booking = bookings.find((b) => b.id === bookingId);
      const { data } = await supabase.from("videography_deliveries").select("*").eq("booking_id", bookingId).maybeSingle();
      currentDelivery = data || null;
      document.getElementById("vid-dlv-teaser").value = data ? data.teaser_count : 3;
      const basePence = data ? data.base_pence : (booking && booking.amount_pence) || 0;
      document.getElementById("vid-dlv-base").value = basePence ? (basePence / 100).toString() : "";
      const rows = document.getElementById("vid-dlv-extra-rows");
      rows.innerHTML = "";
      (data && Array.isArray(data.extras) ? data.extras : []).forEach((e) => addExtraRow(e.label, e.amount_pence));
      recomputeDlvTotal();
      setDeliveryStatusUI(data ? data.status : null, data ? data.token : null);
      card.hidden = false;
    }
    async function saveDelivery() {
      const bookingId = deliverBooking();
      if (!bookingId) { alert("Pick a booking first."); return; }
      const booking = bookings.find((b) => b.id === bookingId);
      const base = Math.round((parseFloat(document.getElementById("vid-dlv-base").value) || 0) * 100);
      const extras = dlvExtrasFromDOM();
      const total = base + extras.reduce((s, e) => s + e.amount_pence, 0);
      const payload = {
        booking_id: bookingId,
        token: (currentDelivery && currentDelivery.token) || genToken(),
        client_name: booking ? booking.client_name : null,
        client_email: booking ? booking.client_email : null,
        teaser_count: parseInt(document.getElementById("vid-dlv-teaser").value, 10) || 0,
        base_pence: base, extras, total_pence: total,
        status: (currentDelivery && currentDelivery.status) || "draft",
      };
      const btn = document.getElementById("vid-dlv-save");
      btn.textContent = "Saving…";
      const { data, error } = await supabase.from("videography_deliveries").upsert(payload, { onConflict: "booking_id" }).select().single();
      btn.textContent = "Save & create link";
      if (error) { alert("Couldn't save delivery: " + error.message); return; }
      currentDelivery = data;
      setDeliveryStatusUI(data.status, data.token);
    }
    async function setDeliveryStatus(status) {
      if (!currentDelivery) return;
      const patch = { status };
      if (status === "sent") patch.sent_at = new Date().toISOString();
      if (status === "paid") patch.paid_at = new Date().toISOString();
      const { data, error } = await supabase.from("videography_deliveries").update(patch).eq("id", currentDelivery.id).select().single();
      if (error) { alert("Couldn't update: " + error.message); return; }
      currentDelivery = data;
      setDeliveryStatusUI(data.status, data.token);
      // Paid → the job completes itself.
      if (status === "paid") {
        const b = bookings.find((x) => x.id === currentDelivery.booking_id);
        if (b && b.stage !== "complete") {
          b.stage = "complete";
          await supabase.from("videography_bookings").update({ stage: "complete" }).eq("id", b.id);
          renderClients(document.getElementById("vid-client-search")?.value || "");
          if (candId === b.id) renderCandidate();
        }
      }
    }
    function copyDeliveryLink() {
      if (!currentDelivery || !navigator.clipboard) return;
      navigator.clipboard.writeText(`${location.origin}/deliver?d=${currentDelivery.token}`).then(() => {
        const b = document.getElementById("vid-dlv-copy"); const t = b.textContent;
        b.textContent = "Copied ✓"; setTimeout(() => (b.textContent = t), 1500);
      });
    }

    async function init365Status() {
      const pill = document.getElementById("vid-365-pill");
      const meta = document.getElementById("vid-365-meta");
      if (!pill) return;
      if (!WORKER_URL) { pill.textContent = "Not connected"; if (meta) meta.textContent = "Set PUBLIC_R2_WORKER_URL + deploy the Worker."; return; }
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/ms/status`, { headers: { Authorization: "Bearer " + token } });
        const d = await res.json();
        if (d && d.connected) {
          pill.textContent = "Connected"; pill.classList.remove("is-pending"); pill.classList.add("is-paid");
          if (meta) meta.textContent = `Linked to ${d.name || d.upn || "Jack's calendar"}.`;
        } else {
          pill.textContent = "Not connected";
          if (meta) meta.textContent = (d && d.error) ? ("Graph error: " + d.error) : "Check the Worker's MS_* secrets + Exchange policy.";
        }
      } catch (e) {
        pill.textContent = "Not connected";
        if (meta) meta.textContent = "Couldn't reach the Worker.";
      }
    }

    /* ---------- Settings (Jack's base postcode + travel surcharge) ---------- */
    async function initSettings() {
      const { data } = await supabase.from("videography_settings").select("*").eq("id", 1).maybeSingle();
      if (data) vidSettings = data;
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
      set("vid-set-postcode", vidSettings.base_postcode || "");
      set("vid-set-radius", vidSettings.free_radius_miles ?? 40);
      set("vid-set-rate", vidSettings.surcharge_pence_per_mile ?? 55);
      set("vid-set-vat", Math.round((vidSettings.vat_rate ?? 0.2) * 100));
      document.getElementById("vid-set-save")?.addEventListener("click", saveSettings);
    }
    async function saveSettings() {
      const num = (id, d) => { const v = parseFloat(document.getElementById(id)?.value); return isNaN(v) ? d : v; };
      const payload = {
        id: 1,
        base_postcode: (document.getElementById("vid-set-postcode")?.value || "").trim().toUpperCase(),
        free_radius_miles: Math.round(num("vid-set-radius", 40)),
        surcharge_pence_per_mile: Math.round(num("vid-set-rate", 55)),
        vat_rate: num("vid-set-vat", 20) / 100,
        updated_at: new Date().toISOString(),
      };
      const status = document.getElementById("vid-set-status");
      const btn = document.getElementById("vid-set-save");
      if (btn) { btn.disabled = true; btn.textContent = "Saving…"; }
      const { error } = await supabase.from("videography_settings").upsert(payload, { onConflict: "id" });
      if (btn) { btn.disabled = false; btn.textContent = "Save settings"; }
      if (error) { if (status) { status.style.color = "#a05a3c"; status.textContent = "Couldn't save: " + error.message + " — run supabase/videography_booking_flow.sql?"; } return; }
      vidSettings = { ...vidSettings, ...payload };
      baseCoords = null; // re-geocode on next distance lookup
      if (status) { status.style.color = "#2c7a4b"; status.textContent = "Saved ✓"; setTimeout(() => (status.textContent = ""), 2200); }
    }
    async function getBaseCoords() {
      if (baseCoords) return baseCoords;
      const pc = (vidSettings.base_postcode || "NN14 1AA").replace(/\s+/g, "");
      try {
        const r = await fetch("https://api.postcodes.io/postcodes/" + encodeURIComponent(pc));
        const d = await r.json();
        if (d.result) baseCoords = { lat: d.result.latitude, lon: d.result.longitude };
      } catch (_) { /* fall through */ }
      return baseCoords || { lat: 52.3936, lon: -0.7281 };
    }

    /* ---------- Boot ---------- */
    (async () => {
      const session = await requireAdmin();
      if (!session) return;
      initNav();

      const [bRes, aRes] = await Promise.all([
        supabase.from("videography_bookings").select("*").order("created_at", { ascending: false }),
        supabase.from("videography_availability").select("*"),
      ]);

      bookings = bRes.error ? [] : (bRes.data || []);
      availability = aRes.error ? [] : (aRes.data || []);

      if (bRes.error) {
        const l = document.getElementById("vid-clients-loading");
        if (l) l.textContent = "Could not load clients: " + bRes.error.message + " — have you run supabase/videography.sql?";
      } else {
        await autoAdvance();
        renderClients();
      }
      const dl = document.getElementById("vid-diary-loading");
      if (dl) dl.remove();
      renderDiary();
      initDeliver();
      init365Status();
      initSettings();

      document.getElementById("vid-new-booking")?.addEventListener("click", () => openModal(null));
      document.getElementById("vid-save")?.addEventListener("click", saveBooking);
      document.getElementById("vid-delete")?.addEventListener("click", deleteBooking);
      document.getElementById("vid-cancel")?.addEventListener("click", closeModal);
      document.getElementById("vid-modal-close")?.addEventListener("click", closeModal);
      document.getElementById("vid-modal")?.addEventListener("click", (e) => {
        if (e.target instanceof HTMLElement && e.target.id === "vid-modal") closeModal();
      });
      document.getElementById("vid-booking-search")?.addEventListener("input", (e) => renderBookings(e.target.value || ""));
      document.getElementById("vid-diary-save")?.addEventListener("click", saveDiary);
    })();
  </script>
</AdminShell>
