---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/admin.css";
import PageHero from "../../components/PageHero.astro";
import AdminBack from "../../components/AdminBack.astro";
---

<BaseLayout
  title="Videography — Admin · TMKE"
  description="Jack's videography studio — pipeline, bookings, diary, delivery, and connections."
  hideNav
  hideFooter
>
  <div class="admin-hero-pad">
    <PageHero
      chapter="Admin — Videography"
      title="Videography <em>studio.</em>"
      sub="Jack's home base — track every shoot from booking to invoice, manage the diary, and deliver the work."
    />
  </div>

  <section class="admin-bar wrap">
    <AdminBack />
    <div class="admin-bar-actions">
      <div class="vid-tabs" id="vid-tabs" role="tablist">
        <button type="button" class="enquiry-chip is-active" data-tab="pipeline">Pipeline</button>
        <button type="button" class="enquiry-chip" data-tab="bookings">Bookings</button>
        <button type="button" class="enquiry-chip" data-tab="diary">Diary</button>
        <button type="button" class="enquiry-chip" data-tab="deliver">Deliver</button>
        <button type="button" class="enquiry-chip" data-tab="connections">Connections</button>
      </div>
    </div>
  </section>

  <!-- ===================== PIPELINE (kanban / mini-CRM) ===================== -->
  <section class="vid-panel wrap is-active" data-panel="pipeline">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Pipeline</h2>
        <p class="vid-panel-sub">Drag a job between stages as it moves. Click a card to edit details.</p>
      </div>
      <button type="button" class="admin-btn admin-btn-primary" id="vid-new-booking">+ New booking</button>
    </div>

    <p class="vid-loading" id="vid-board-loading">Loading pipeline…</p>
    <div class="vid-board" id="vid-board" hidden></div>
  </section>

  <!-- ===================== BOOKINGS (client list) ===================== -->
  <section class="vid-panel wrap" data-panel="bookings">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Bookings &amp; clients</h2>
        <p class="vid-panel-sub">Every client who's booked Jack — pulled from the pipeline.</p>
      </div>
      <input type="search" id="vid-booking-search" class="admin-search" placeholder="Search client, company, brand…" />
    </div>
    <p class="vid-loading" id="vid-bookings-empty" hidden>No bookings yet.</p>
    <div class="enquiry-table" id="vid-bookings-table"></div>
  </section>

  <!-- ===================== DIARY (weekly availability) ===================== -->
  <section class="vid-panel wrap" data-panel="diary">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Diary &amp; availability</h2>
        <p class="vid-panel-sub">Set the hours Jack is bookable each weekday. This drives the public booking page.</p>
      </div>
    </div>

    <div class="vid-conn-note">
      <strong>These are the hours Jack is bookable.</strong>
      Click a day, then tap the hours he's available — you can pick more than one
      block (e.g. 9–1 and 3–6). Anything already in his real 365 calendar is
      subtracted automatically, so clients only ever see genuinely free times.
    </div>

    <div class="vid-diary" id="vid-diary">
      <p class="vid-loading" id="vid-diary-loading">Loading diary…</p>
    </div>
    <button type="button" class="admin-btn admin-btn-primary vid-diary-save" id="vid-diary-save" hidden>Save diary</button>
  </section>

  <!-- ===================== DELIVER (uploads → client) ===================== -->
  <section class="vid-panel wrap" data-panel="deliver">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Deliver work</h2>
        <p class="vid-panel-sub">Upload the finished shoot, then send the client their gallery.</p>
      </div>
    </div>

    <div class="vid-conn-note is-pending" id="vid-deliver-config" hidden>
      <strong>Upload backend not connected yet.</strong>
      Deploy the Cloudflare Worker in <code>worker/</code> and set
      <code>PUBLIC_R2_WORKER_URL</code> in your env, then reload. See
      <code>worker/README.md</code>.
    </div>

    <div class="vid-deliver">
      <div class="vid-field vid-deliver-pick">
        <label>Deliver to booking</label>
        <select id="vid-deliver-booking">
          <option value="">— Select a client / shoot —</option>
        </select>
      </div>

      <div class="vid-dropzone" id="vid-dropzone">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
          <polyline points="17 8 12 3 7 8" />
          <line x1="12" y1="3" x2="12" y2="15" />
        </svg>
        <div class="vid-dropzone-title">Drag videos &amp; photos here</div>
        <div class="vid-dropzone-sub">Multi-GB, full-resolution — uploaded straight to Cloudflare R2 in 50&nbsp;MB parts, resumable per part</div>
        <button type="button" class="admin-btn admin-btn-ghost" id="vid-pick">Choose files</button>
        <input type="file" id="vid-file-input" multiple hidden />
      </div>

      <div class="vid-uploads" id="vid-uploads"></div>

      <div class="vid-files">
        <h3 class="vid-files-head">Uploaded for this booking</h3>
        <p class="vid-loading" id="vid-files-empty">Select a booking to see its delivered files.</p>
        <div class="vid-files-list" id="vid-files-list"></div>
      </div>

      <div class="vid-delivery" id="vid-delivery" hidden>
        <div class="vid-delivery-head">
          <h3 class="vid-files-head" style="margin:0">Client delivery</h3>
          <span class="enquiry-status-pill is-pending" id="vid-dlv-status">Draft</span>
        </div>
        <p class="vid-panel-sub" style="margin:0 0 18px">Set the price and how many photos are free, create the link, then send it to the client. They preview the teasers and pay to unlock the full set.</p>
        <div class="vid-dlv-grid">
          <div class="vid-field"><label>Free teaser images</label><input type="number" id="vid-dlv-teaser" min="0" value="3" /></div>
          <div class="vid-field"><label>Shoot price (£)</label><input type="number" id="vid-dlv-base" min="0" step="0.01" /></div>
        </div>
        <div class="vid-dlv-extras">
          <span class="vid-field-label">Extras (travel, additional edits…)</span>
          <div id="vid-dlv-extra-rows"></div>
          <button type="button" class="admin-btn admin-btn-ghost" id="vid-dlv-add-extra">+ Add extra</button>
        </div>
        <div class="vid-dlv-total">Total <strong id="vid-dlv-total">£0</strong></div>
        <div class="vid-dlv-actions">
          <button type="button" class="admin-btn admin-btn-primary" id="vid-dlv-save">Save &amp; create link</button>
          <button type="button" class="admin-btn admin-btn-ghost" id="vid-dlv-copy" hidden>Copy client link</button>
          <button type="button" class="admin-btn admin-btn-ghost" id="vid-dlv-sent" hidden>Mark sent</button>
          <button type="button" class="admin-btn admin-btn-ghost" id="vid-dlv-paid" hidden>Mark paid (manual)</button>
        </div>
        <p class="vid-dlv-link" id="vid-dlv-link" hidden></p>
      </div>
    </div>
  </section>

  <!-- ===================== CONNECTIONS (integrations) ===================== -->
  <section class="vid-panel wrap" data-panel="connections">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Connections</h2>
        <p class="vid-panel-sub">The accounts that power booking, storage, and payments.</p>
      </div>
    </div>

    <div class="vid-conn-grid">
      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>Microsoft 365 — Jack's calendar</h3>
          <span class="enquiry-status-pill is-pending" id="vid-365-pill">Checking…</span>
        </div>
        <p>Status only — nothing to click. This just confirms the booking system can reach Jack's calendar in the background, so new bookings write into his real diary automatically.</p>
        <p class="vid-conn-meta" id="vid-365-meta">Verifying connection…</p>
      </div>

      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>Cloudflare R2 — media storage</h3>
          <span class="enquiry-status-pill is-pending" id="vid-r2-pill">Not connected</span>
        </div>
        <p>Fast, high-resolution storage for shoots. Direct-to-edge uploads for Jack, zero-egress fast downloads for clients.</p>
        <p class="vid-conn-meta" id="vid-r2-meta">Deploy the Worker in <code>worker/</code> and set <code>PUBLIC_R2_WORKER_URL</code>.</p>
      </div>

      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>Stripe — payments</h3>
          <span class="enquiry-status-pill is-pending">Not connected</span>
        </div>
        <p>Paywalls the full gallery and collects payment. Teaser images free, full set on payment.</p>
        <button type="button" class="admin-btn admin-btn-ghost" disabled>Connect Stripe (Phase 5)</button>
      </div>

      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>QuickBooks — invoicing</h3>
          <span class="enquiry-status-pill is-pending">Not connected</span>
        </div>
        <p>Raises and reconciles the invoice once a shoot is paid for. Keeps the books in sync.</p>
        <button type="button" class="admin-btn admin-btn-ghost" disabled>Connect QuickBooks (Phase 5)</button>
      </div>
    </div>
  </section>

  <!-- ===================== Booking modal (add / edit) ===================== -->
  <div class="modal-backdrop" id="vid-modal" hidden>
    <div class="modal vid-modal" role="dialog" aria-modal="true" aria-labelledby="vid-modal-title">
      <header class="modal-head">
        <h2 id="vid-modal-title">New booking</h2>
        <button type="button" class="modal-close" id="vid-modal-close" aria-label="Close">&times;</button>
      </header>
      <div class="vid-form" id="vid-form">
        <div class="vid-field">
          <label>Client name *</label>
          <input type="text" data-f="client_name" />
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Email</label><input type="email" data-f="client_email" /></div>
          <div class="vid-field"><label>Phone</label><input type="tel" data-f="client_phone" /></div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Company</label><input type="text" data-f="client_company" /></div>
          <div class="vid-field">
            <label>Brand / price tier</label>
            <select data-f="brand">
              <option value="">— Select —</option>
              <option value="property-experts">The Property Experts</option>
              <option value="fine-and-country">Fine &amp; Country</option>
              <option value="other">Other / direct</option>
            </select>
          </div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Service</label><input type="text" data-f="service" placeholder="Property video, podcast…" /></div>
          <div class="vid-field"><label>Shoot date</label><input type="datetime-local" data-f="shoot_date" /></div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Location</label><input type="text" data-f="location" /></div>
          <div class="vid-field"><label>Quote (£)</label><input type="number" data-f="amount_gbp" min="0" step="0.01" /></div>
        </div>
        <div class="vid-field"><label>Notes</label><textarea data-f="notes" rows="3"></textarea></div>
      </div>
      <footer class="modal-foot">
        <button type="button" class="admin-btn admin-btn-danger" id="vid-delete" hidden>Delete</button>
        <div class="spacer"></div>
        <button type="button" class="admin-btn admin-btn-ghost" id="vid-cancel">Cancel</button>
        <button type="button" class="admin-btn admin-btn-primary" id="vid-save">Save booking</button>
      </footer>
    </div>
  </div>

  <style is:global>
    .admin-hero-pad { padding-top: 100px; }
    @media (max-width: 720px) { .admin-hero-pad { padding-top: 56px; } }

    .admin-bar {
      display: flex; justify-content: space-between; align-items: center;
      gap: 16px; max-width: 1360px; margin: 0 auto;
      padding: 12px 36px 24px; flex-wrap: wrap;
    }
    .admin-back {
      font-family: var(--sans); font-size: 12px; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--english-violet); font-weight: 700;
    }
    .admin-back:hover { color: var(--ink); }
    .admin-bar-actions { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
    .admin-search {
      padding: 8px 12px; border: 1px solid rgba(71, 66, 84, 0.3); border-radius: 2px;
      font-family: var(--sans); font-size: 13px; color: var(--ink);
      background: var(--paper); min-width: 220px;
    }
    .admin-search:focus { outline: none; border-color: var(--english-violet); }

    .vid-tabs { display: inline-flex; gap: 4px; flex-wrap: wrap; }
    .enquiry-chip {
      display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px;
      background: #fff; border: 1px solid rgba(71, 66, 84, 0.3);
      border-radius: 999px; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700;
      color: var(--english-violet); cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .enquiry-chip:hover { background: rgba(71, 66, 84, 0.06); }
    .enquiry-chip.is-active {
      background: var(--english-violet); color: var(--paper); border-color: var(--english-violet);
    }

    /* ---- Panels ---- */
    .vid-panel { max-width: 1360px; margin: 0 auto; padding: 0 36px 200px; display: none; }
    .vid-panel.is-active { display: block; }
    .vid-panel-head {
      display: flex; justify-content: space-between; align-items: flex-end;
      gap: 16px; flex-wrap: wrap; margin-bottom: 24px;
    }
    .vid-panel-title { font-family: var(--serif); font-size: 30px; font-weight: 500; color: var(--ink); margin: 0; }
    .vid-panel-sub { font-family: var(--sans); font-size: 14px; color: rgba(28, 29, 34, 0.6); margin: 4px 0 0; }
    .vid-loading { font-family: var(--sans); font-size: 14px; color: rgba(28, 29, 34, 0.55); padding: 40px 0; }

    /* ---- Pipeline — full-width stages stacked vertically ---- */
    .vid-board { display: flex; flex-direction: column; gap: 14px; padding-bottom: 8px; }
    .vid-col {
      background: rgba(71, 66, 84, 0.04); border: 1px solid rgba(71, 66, 84, 0.15);
      border-radius: 4px; display: flex; flex-direction: column;
    }
    .vid-col.is-drop { border-color: var(--english-violet); background: rgba(71, 66, 84, 0.1); }
    .vid-col-head {
      display: flex; justify-content: flex-start; align-items: center; gap: 10px;
      padding: 12px 18px; border-bottom: 1px solid rgba(71, 66, 84, 0.12);
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.18em;
      text-transform: uppercase; font-weight: 700; color: var(--english-violet);
    }
    .vid-col-count {
      min-width: 18px; text-align: center; padding: 1px 7px; border-radius: 999px;
      background: rgba(71, 66, 84, 0.12); font-size: 10px; color: rgba(28,29,34,0.7);
    }
    /* Cards flow left-to-right and wrap, so a busy stage fills the width */
    .vid-col-list { padding: 12px; display: flex; flex-wrap: wrap; gap: 10px; min-height: 56px; align-content: flex-start; }
    .vid-col-list:empty::after,
    .vid-col-list.is-empty::after { content: "Drop a job here"; font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.35); padding: 8px 6px; }
    .vid-card {
      flex: 0 0 clamp(220px, 24%, 280px); background: var(--paper);
      border: 1px solid rgba(71, 66, 84, 0.2); border-radius: 3px;
      padding: 12px 13px; cursor: grab; box-shadow: 0 1px 2px rgba(20, 18, 26, 0.04);
      transition: box-shadow 0.15s, transform 0.15s, border-color 0.15s;
    }
    @media (max-width: 640px) { .vid-card { flex-basis: 100%; } }
    .vid-card:hover { border-color: var(--english-violet); box-shadow: 0 4px 14px rgba(20, 18, 26, 0.1); }
    .vid-card.is-dragging { opacity: 0.5; }
    .vid-card-name { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); }
    .vid-card-meta { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.6); margin-top: 3px; }
    .vid-card-foot {
      display: flex; justify-content: space-between; align-items: center; margin-top: 10px;
      font-family: var(--sans); font-size: 11px; color: rgba(28, 29, 34, 0.55);
    }
    .vid-card-brand {
      font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700;
      padding: 2px 7px; border-radius: 999px; background: rgba(71, 66, 84, 0.1); color: var(--english-violet);
    }
    .vid-card-amount { font-family: var(--serif); font-size: 15px; font-weight: 500; color: var(--ink); }

    /* ---- Bookings table (reuses enquiry-table look) ---- */
    .enquiry-table {
      display: grid; gap: 1px; background: rgba(71, 66, 84, 0.18);
      border: 1px solid rgba(71, 66, 84, 0.18); border-radius: 2px; overflow: hidden;
    }
    .vid-brow {
      display: grid; grid-template-columns: 1.4fr 1.2fr 1fr 1fr 110px 24px;
      gap: 16px; padding: 16px 20px; background: var(--paper);
      align-items: center; cursor: pointer; transition: background 0.15s;
    }
    .vid-brow.is-header {
      cursor: default; background: rgba(71, 66, 84, 0.04); font-family: var(--sans);
      font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
      font-weight: 700; color: rgba(28, 29, 34, 0.55);
    }
    .vid-brow:not(.is-header):hover { background: rgba(71, 66, 84, 0.04); }
    .vid-bname { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); }
    .vid-bmeta { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.55); margin-top: 2px; }

    /* ---- Diary (per-day hour blocks) ---- */
    .vid-diary { display: flex; flex-direction: column; gap: 8px; max-width: 760px; }
    .vid-day { background: var(--paper); border: 1px solid rgba(71, 66, 84, 0.18); border-radius: 4px; overflow: hidden; }
    .vid-day-head {
      display: flex; align-items: center; gap: 14px; width: 100%; text-align: left;
      padding: 14px 18px; background: transparent; border: none; cursor: pointer;
      font-family: var(--sans);
    }
    .vid-day-head:hover { background: rgba(71,66,84,0.04); }
    .vid-day-name { font-size: 14px; font-weight: 700; color: var(--ink); min-width: 110px; }
    .vid-day-summary { font-size: 13px; color: rgba(28,29,34,0.6); flex: 1; }
    .vid-day-summary.is-off { color: rgba(28,29,34,0.4); }
    .vid-day-chev { font-family: var(--serif); color: var(--english-violet); transition: transform 0.2s; }
    .vid-day.is-open .vid-day-chev { transform: rotate(90deg); }
    .vid-day-hours { display: none; flex-wrap: wrap; gap: 6px; padding: 4px 18px 18px; }
    .vid-day.is-open .vid-day-hours { display: flex; }
    .vid-hour {
      padding: 7px 0; width: 64px; text-align: center; border: 1px solid rgba(71,66,84,0.25);
      border-radius: 999px; background: transparent; font-family: var(--sans); font-size: 12px;
      color: rgba(28,29,34,0.65); cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .vid-hour:hover { border-color: var(--english-violet); }
    .vid-hour.is-on { background: var(--english-violet); color: var(--paper); border-color: var(--english-violet); }
    .vid-diary-save { margin-top: 14px; }

    /* ---- Deliver ---- */
    .vid-deliver-pick { max-width: 440px; margin-bottom: 20px; }
    .vid-dropzone {
      border: 2px dashed rgba(71, 66, 84, 0.3); border-radius: 6px;
      padding: 48px 24px; text-align: center; color: rgba(28, 29, 34, 0.55);
      display: flex; flex-direction: column; align-items: center; gap: 10px;
      background: rgba(71, 66, 84, 0.02); transition: border-color 0.2s, background 0.2s;
    }
    .vid-dropzone.is-drag { border-color: var(--english-violet); background: rgba(71, 66, 84, 0.06); }
    .vid-dropzone.is-disabled { opacity: 0.55; }
    .vid-dropzone-title { font-family: var(--serif); font-size: 22px; color: var(--ink); }
    .vid-dropzone-sub { font-family: var(--sans); font-size: 13px; max-width: 460px; }

    .vid-uploads { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
    .vid-up {
      border: 1px solid rgba(71, 66, 84, 0.18); border-radius: 4px;
      padding: 14px 16px; background: var(--paper);
    }
    .vid-up-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .vid-up-name { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); word-break: break-all; }
    .vid-up-stat { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.6); white-space: nowrap; }
    .vid-up-stat.is-done { color: #2c7a4b; }
    .vid-up-stat.is-error { color: #a05a3c; }
    .vid-up-bar { height: 6px; border-radius: 999px; background: rgba(71,66,84,0.12); margin-top: 10px; overflow: hidden; }
    .vid-up-fill { height: 100%; width: 0; background: var(--english-violet); border-radius: 999px; transition: width 0.2s ease; }
    .vid-up-fill.is-done { background: #2c7a4b; }
    .vid-up-fill.is-error { background: #a05a3c; }

    .vid-files { margin-top: 36px; }
    .vid-files-head { font-family: var(--sans); font-weight: 700; font-size: 13px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.6); margin: 0 0 14px; }
    .vid-files-list { display: flex; flex-direction: column; gap: 1px; background: rgba(71,66,84,0.18); border: 1px solid rgba(71,66,84,0.18); border-radius: 3px; overflow: hidden; }
    .vid-frow { display: grid; grid-template-columns: 1fr 90px 120px 80px; gap: 14px; align-items: center; padding: 12px 16px; background: var(--paper); font-family: var(--sans); font-size: 13px; }
    .vid-frow-name { color: var(--ink); font-weight: 600; word-break: break-all; }
    .vid-frow-meta { color: rgba(28,29,34,0.55); font-size: 12px; }
    .vid-frow-act { text-align: right; }
    .vid-frow-link { color: var(--english-violet); font-weight: 700; cursor: pointer; background: none; border: none; font-family: var(--sans); font-size: 12px; }
    .vid-frow-del { color: #a05a3c; cursor: pointer; background: none; border: none; font-family: var(--sans); font-size: 12px; font-weight: 700; }
    .vid-delivery { margin-top: 36px; border-top: 1px solid rgba(71,66,84,0.18); padding-top: 28px; max-width: 640px; }
    .vid-delivery-head { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
    .vid-dlv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .vid-dlv-extras { margin-top: 18px; }
    .vid-field-label { display: block; font-family: var(--sans); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.6); margin-bottom: 8px; }
    .vid-dlv-extra { display: grid; grid-template-columns: 1fr 130px 34px; gap: 8px; margin-bottom: 8px; }
    .vid-dlv-extra input { padding: 8px 10px; border: 1px solid rgba(71,66,84,0.3); border-radius: 2px; font-family: var(--sans); font-size: 14px; color: var(--ink); background: var(--paper); }
    .vid-dlv-extra input:focus { outline: none; border-color: var(--english-violet); }
    .vid-dlv-extra-del { border: none; background: none; color: #a05a3c; cursor: pointer; font-size: 20px; line-height: 1; }
    .vid-dlv-total { margin-top: 20px; font-family: var(--sans); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.6); }
    .vid-dlv-total strong { font-family: var(--serif); font-size: 26px; font-weight: 500; color: var(--ink); margin-left: 10px; }
    .vid-dlv-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
    .vid-dlv-link { margin-top: 14px; font-family: var(--sans); font-size: 13px; color: var(--english-violet); word-break: break-all; }
    @media (max-width: 720px) { .vid-dlv-grid { grid-template-columns: 1fr; } .vid-dlv-extra { grid-template-columns: 1fr 100px 30px; } }
    .vid-conn-meta { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); margin: 0; }
    .vid-conn-meta code, .vid-conn-note code { background: rgba(71,66,84,0.1); padding: 1px 5px; border-radius: 3px; font-size: 11px; }
    @media (max-width: 720px) { .vid-frow { grid-template-columns: 1fr auto; } .vid-frow-meta { display: none; } }

    /* ---- Connections ---- */
    .vid-conn-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .vid-conn-card {
      padding: 22px 24px; border: 1px solid rgba(71, 66, 84, 0.2);
      border-radius: 4px; background: var(--paper);
    }
    .vid-conn-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px; }
    .vid-conn-card h3 { font-family: var(--serif); font-size: 20px; font-weight: 500; color: var(--ink); margin: 0; }
    .vid-conn-card p { font-family: var(--sans); font-size: 13px; line-height: 1.55; color: rgba(28, 29, 34, 0.6); margin: 0 0 16px; }
    .vid-conn-note {
      padding: 14px 18px; border-left: 3px solid var(--english-violet);
      background: rgba(71, 66, 84, 0.05); border-radius: 2px; margin-bottom: 20px;
      font-family: var(--sans); font-size: 13px; line-height: 1.55; color: rgba(28, 29, 34, 0.75);
    }
    .vid-conn-note.is-pending { border-left-color: #b78a2e; background: rgba(183, 138, 46, 0.08); }
    .vid-conn-note strong { color: var(--ink); }

    .enquiry-status-pill {
      display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px;
      border-radius: 999px; font-family: var(--sans); font-size: 10px;
      letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700;
    }
    .enquiry-status-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .enquiry-status-pill.is-pending { color: #b78a2e; background: rgba(183, 138, 46, 0.12); }
    .enquiry-status-pill.is-paid { color: #2c7a4b; background: rgba(44, 122, 75, 0.1); }

    /* ---- Modal ---- */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 200; background: rgba(20, 18, 26, 0.55);
      display: flex; align-items: center; justify-content: center; padding: 24px;
    }
    .modal-backdrop[hidden] { display: none; }
    .modal.vid-modal {
      background: var(--paper); max-width: 640px; width: 100%; max-height: 88vh;
      display: flex; flex-direction: column; border-radius: 4px; overflow: hidden;
      box-shadow: 0 30px 80px rgba(20, 18, 26, 0.35);
    }
    .modal-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 20px 28px; border-bottom: 1px solid rgba(71, 66, 84, 0.12);
    }
    .modal-head h2 { font-family: var(--serif); font-size: 22px; font-weight: 500; margin: 0; color: var(--ink); }
    .modal-close { background: transparent; border: none; font-size: 28px; line-height: 1; color: var(--english-violet); cursor: pointer; padding: 0 4px; }
    .vid-form { padding: 24px 28px; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 14px; }
    .vid-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .vid-field { display: flex; flex-direction: column; gap: 5px; }
    .vid-field label {
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.14em;
      text-transform: uppercase; font-weight: 700; color: rgba(28, 29, 34, 0.6);
    }
    .vid-field input, .vid-field select, .vid-field textarea {
      padding: 9px 12px; border: 1px solid rgba(71, 66, 84, 0.3); border-radius: 2px;
      font-family: var(--sans); font-size: 14px; color: var(--ink); background: var(--paper);
      resize: vertical;
    }
    .vid-field input:focus, .vid-field select:focus, .vid-field textarea:focus { outline: none; border-color: var(--english-violet); }
    .modal-foot {
      display: flex; gap: 8px; align-items: center; padding: 16px 28px;
      border-top: 1px solid rgba(71, 66, 84, 0.12); flex-wrap: wrap;
    }
    .modal-foot .spacer { flex: 1; }
    .admin-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px;
      border-radius: 2px; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700;
      cursor: pointer; border: 1px solid transparent;
      transition: background 0.2s, color 0.2s, border-color 0.2s; text-decoration: none;
    }
    .admin-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .admin-btn-primary { background: var(--english-violet); color: var(--paper); }
    .admin-btn-primary:hover { background: var(--ink); color: var(--paper); }
    .admin-btn-ghost { background: transparent; border-color: rgba(71, 66, 84, 0.4); color: var(--english-violet); }
    .admin-btn-ghost:hover { background: rgba(71, 66, 84, 0.06); }
    .admin-btn-danger { background: transparent; border-color: #a05a3c; color: #a05a3c; }
    .admin-btn-danger:hover { background: #a05a3c; color: var(--paper); }

    @media (max-width: 980px) {
      .vid-conn-grid { grid-template-columns: 1fr; }
      .vid-deliver-steps { grid-template-columns: 1fr; }
      .vid-day { grid-template-columns: 1fr 1fr; }
      .vid-brow { grid-template-columns: 1fr; gap: 6px; }
      .vid-brow.is-header { display: none; }
    }
  </style>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { supabase, gbpFromPence } from "../../lib/supabase.js";

    // Deployed Cloudflare Worker URL (worker/). Set PUBLIC_R2_WORKER_URL in env.
    const WORKER_URL = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const PART_SIZE = 50 * 1024 * 1024; // 50 MB parts

    const STAGES = [
      { key: "booked",      label: "Booked" },
      { key: "shoot_day",   label: "Shoot day" },
      { key: "editing",     label: "Editing" },
      { key: "final_draft", label: "Final draft" },
      { key: "invoice_out", label: "Invoice out" },
      { key: "complete",    label: "Complete" },
    ];
    const DAYS = [
      { d: 1, name: "Monday" }, { d: 2, name: "Tuesday" }, { d: 3, name: "Wednesday" },
      { d: 4, name: "Thursday" }, { d: 5, name: "Friday" }, { d: 6, name: "Saturday" },
      { d: 0, name: "Sunday" },
    ];

    function escapeHtml(s) {
      return String(s ?? "")
        .replace(/&/g, "&amp;").replace(/</g, "&lt;")
        .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }
    function fmtWhen(iso) {
      if (!iso) return "—";
      const d = new Date(iso);
      return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
    }
    const BRAND_LABEL = {
      "property-experts": "Property Experts",
      "fine-and-country": "Fine & Country",
      "other": "Direct",
    };

    let bookings = [];

    /* ---------- Tabs ---------- */
    function initTabs() {
      const tabs = document.getElementById("vid-tabs");
      tabs?.addEventListener("click", (e) => {
        const btn = e.target.closest(".enquiry-chip");
        if (!btn) return;
        const tab = btn.getAttribute("data-tab");
        tabs.querySelectorAll(".enquiry-chip").forEach((c) => c.classList.remove("is-active"));
        btn.classList.add("is-active");
        document.querySelectorAll(".vid-panel").forEach((p) => {
          p.classList.toggle("is-active", p.getAttribute("data-panel") === tab);
        });
      });
    }

    /* ---------- Pipeline (kanban) ---------- */
    function renderBoard() {
      const board = document.getElementById("vid-board");
      const loading = document.getElementById("vid-board-loading");
      if (!board) return;
      if (loading) loading.hidden = true;
      board.hidden = false;

      board.innerHTML = STAGES.map((s) => {
        const cards = bookings
          .filter((b) => b.stage === s.key)
          .sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));
        return `
          <div class="vid-col" data-stage="${s.key}">
            <div class="vid-col-head">
              <span>${s.label}</span>
              <span class="vid-col-count">${cards.length}</span>
            </div>
            <div class="vid-col-list" data-stage="${s.key}">
              ${cards.map(cardHtml).join("")}
            </div>
          </div>`;
      }).join("");

      board.querySelectorAll(".vid-card").forEach((el) => {
        el.addEventListener("dragstart", onDragStart);
        el.addEventListener("dragend", onDragEnd);
        el.addEventListener("click", () => openModal(el.getAttribute("data-id")));
      });
      board.querySelectorAll(".vid-col-list").forEach((col) => {
        col.addEventListener("dragover", onDragOver);
        col.addEventListener("dragleave", onDragLeave);
        col.addEventListener("drop", onDrop);
      });
    }

    function cardHtml(b) {
      const brand = b.brand ? `<span class="vid-card-brand">${escapeHtml(BRAND_LABEL[b.brand] || b.brand)}</span>` : "<span></span>";
      const amount = b.amount_pence != null ? `<span class="vid-card-amount">${gbpFromPence(b.amount_pence)}</span>` : "";
      return `
        <div class="vid-card" draggable="true" data-id="${b.id}">
          <div class="vid-card-name">${escapeHtml(b.client_name)}</div>
          <div class="vid-card-meta">${escapeHtml(b.service || b.client_company || "—")}</div>
          <div class="vid-card-meta">${b.shoot_date ? "📅 " + fmtWhen(b.shoot_date) : ""}</div>
          <div class="vid-card-foot">${brand}${amount}</div>
        </div>`;
    }

    let dragId = null;
    function onDragStart(e) { dragId = e.currentTarget.getAttribute("data-id"); e.currentTarget.classList.add("is-dragging"); e.dataTransfer.effectAllowed = "move"; }
    function onDragEnd(e) { e.currentTarget.classList.remove("is-dragging"); }
    function onDragOver(e) { e.preventDefault(); e.currentTarget.closest(".vid-col")?.classList.add("is-drop"); }
    function onDragLeave(e) { e.currentTarget.closest(".vid-col")?.classList.remove("is-drop"); }
    async function onDrop(e) {
      e.preventDefault();
      const col = e.currentTarget.closest(".vid-col");
      col?.classList.remove("is-drop");
      const newStage = e.currentTarget.getAttribute("data-stage");
      if (!dragId || !newStage) return;
      const b = bookings.find((x) => x.id === dragId);
      if (!b || b.stage === newStage) return;
      const prev = b.stage;
      b.stage = newStage;        // optimistic
      renderBoard();
      const { error } = await supabase.from("videography_bookings").update({ stage: newStage }).eq("id", dragId);
      if (error) { b.stage = prev; renderBoard(); alert("Couldn't move card: " + error.message); }
    }

    /* ---------- Bookings list ---------- */
    function renderBookings(filter = "") {
      const table = document.getElementById("vid-bookings-table");
      const empty = document.getElementById("vid-bookings-empty");
      if (!table) return;
      const q = filter.trim().toLowerCase();
      const rows = bookings.filter((b) =>
        !q || [b.client_name, b.client_company, b.brand, b.service, b.client_email]
          .filter(Boolean).some((v) => String(v).toLowerCase().includes(q)));
      if (!rows.length) { table.innerHTML = ""; if (empty) empty.hidden = false; return; }
      if (empty) empty.hidden = true;
      const stageLabel = (k) => (STAGES.find((s) => s.key === k) || {}).label || k;
      table.innerHTML =
        `<div class="vid-brow is-header"><div>Client</div><div>Service</div><div>Brand</div><div>Stage</div><div>Quote</div><div></div></div>` +
        rows.map((b) => `
          <div class="vid-brow" data-id="${b.id}">
            <div><div class="vid-bname">${escapeHtml(b.client_name)}</div><div class="vid-bmeta">${escapeHtml(b.client_company || b.client_email || "—")}</div></div>
            <div class="vid-bmeta">${escapeHtml(b.service || "—")}</div>
            <div class="vid-bmeta">${escapeHtml(BRAND_LABEL[b.brand] || b.brand || "—")}</div>
            <div class="vid-bmeta">${escapeHtml(stageLabel(b.stage))}</div>
            <div class="vid-bname">${b.amount_pence != null ? gbpFromPence(b.amount_pence) : "—"}</div>
            <div style="text-align:right;color:var(--english-violet)">&rarr;</div>
          </div>`).join("");
      table.querySelectorAll("[data-id]").forEach((el) =>
        el.addEventListener("click", () => openModal(el.getAttribute("data-id"))));
    }

    /* ---------- Diary (per-day hour blocks) ---------- */
    let availability = [];
    const DIARY_HOURS = []; for (let h = 6; h <= 21; h++) DIARY_HOURS.push(h); // 06:00–22:00 blocks
    let diaryState = {};   // weekday -> Set(hours)
    let diaryOpen = null;  // currently expanded weekday
    let diaryInit = false;

    function hoursForRow(a) {
      if (a && Array.isArray(a.hours) && a.hours.length) return a.hours.map(Number);
      if (a && a.is_available !== false && a.start_time && a.end_time) {
        const sh = parseInt(a.start_time.split(":")[0], 10);
        const [eh, em] = a.end_time.split(":").map(Number);
        const end = em > 0 ? eh + 1 : eh;
        const out = []; for (let h = sh; h < end; h++) out.push(h); return out;
      }
      return [];
    }
    function fmtHours(set) {
      const hrs = [...set].sort((a, b) => a - b);
      if (!hrs.length) return "Closed";
      const ranges = []; let start = hrs[0], prev = hrs[0];
      for (let i = 1; i < hrs.length; i++) {
        if (hrs[i] === prev + 1) prev = hrs[i];
        else { ranges.push([start, prev + 1]); start = prev = hrs[i]; }
      }
      ranges.push([start, prev + 1]);
      return ranges.map(([a, b]) => `${String(a).padStart(2, "0")}:00–${String(b).padStart(2, "0")}:00`).join(", ");
    }
    function renderDiary() {
      const wrap = document.getElementById("vid-diary");
      if (!wrap) return;
      if (!diaryInit) {
        const byDay = new Map(availability.map((a) => [a.weekday, a]));
        DAYS.forEach(({ d }) => { diaryState[d] = new Set(hoursForRow(byDay.get(d))); });
        diaryInit = true;
      }
      wrap.innerHTML = DAYS.map(({ d, name }) => {
        const set = diaryState[d] || new Set();
        const open = diaryOpen === d;
        return `
          <div class="vid-day ${open ? "is-open" : ""}" data-day="${d}">
            <button type="button" class="vid-day-head" data-day-head="${d}">
              <span class="vid-day-name">${name}</span>
              <span class="vid-day-summary ${set.size ? "" : "is-off"}">${fmtHours(set)}</span>
              <span class="vid-day-chev">›</span>
            </button>
            <div class="vid-day-hours">
              ${DIARY_HOURS.map((h) => `<button type="button" class="vid-hour ${set.has(h) ? "is-on" : ""}" data-day="${d}" data-hour="${h}">${String(h).padStart(2, "0")}:00</button>`).join("")}
            </div>
          </div>`;
      }).join("");
      wrap.querySelectorAll("[data-day-head]").forEach((b) => b.addEventListener("click", () => {
        const d = Number(b.getAttribute("data-day-head"));
        diaryOpen = diaryOpen === d ? null : d;
        renderDiary();
      }));
      wrap.querySelectorAll(".vid-hour").forEach((b) => b.addEventListener("click", () => {
        const d = Number(b.getAttribute("data-day")), h = Number(b.getAttribute("data-hour"));
        const set = diaryState[d] || (diaryState[d] = new Set());
        if (set.has(h)) set.delete(h); else set.add(h);
        renderDiary();
      }));
      const saveBtn = document.getElementById("vid-diary-save");
      if (saveBtn) saveBtn.hidden = false;
    }
    async function saveDiary() {
      const rows = DAYS.map(({ d }) => {
        const hrs = [...(diaryState[d] || new Set())].sort((a, b) => a - b);
        return {
          weekday: d,
          hours: hrs,
          is_available: hrs.length > 0,
          start_time: hrs.length ? `${String(hrs[0]).padStart(2, "0")}:00` : "09:00",
          end_time: hrs.length ? `${String(hrs[hrs.length - 1] + 1).padStart(2, "0")}:00` : "17:00",
        };
      });
      const btn = document.getElementById("vid-diary-save");
      if (btn) { btn.textContent = "Saving…"; btn.disabled = true; }
      const { error } = await supabase.from("videography_availability").upsert(rows, { onConflict: "weekday" });
      if (btn) { btn.disabled = false; btn.textContent = error ? "Error — run the hours migration?" : "Saved ✓"; }
      if (!error) availability = rows.map((r) => ({ ...r }));
      setTimeout(() => { if (btn) btn.textContent = "Save diary"; }, 2200);
    }

    /* ---------- Modal (add / edit booking) ---------- */
    let editingId = null;
    function openModal(id) {
      editingId = id || null;
      const b = id ? bookings.find((x) => x.id === id) : null;
      const set = (f, v) => { const el = document.querySelector(`[data-f="${f}"]`); if (el) el.value = v ?? ""; };
      set("client_name", b?.client_name);
      set("client_email", b?.client_email);
      set("client_phone", b?.client_phone);
      set("client_company", b?.client_company);
      set("brand", b?.brand);
      set("service", b?.service);
      set("shoot_date", b?.shoot_date ? new Date(b.shoot_date).toISOString().slice(0, 16) : "");
      set("location", b?.location);
      set("amount_gbp", b?.amount_pence != null ? (b.amount_pence / 100).toString() : "");
      set("notes", b?.notes);
      document.getElementById("vid-modal-title").textContent = b ? "Edit booking" : "New booking";
      document.getElementById("vid-delete").hidden = !b;
      document.getElementById("vid-modal").hidden = false;
    }
    function closeModal() { document.getElementById("vid-modal").hidden = true; editingId = null; }

    async function saveBooking() {
      const get = (f) => { const el = document.querySelector(`[data-f="${f}"]`); return el ? el.value.trim() : ""; };
      const name = get("client_name");
      if (!name) { alert("Client name is required."); return; }
      const gbp = get("amount_gbp");
      const payload = {
        client_name: name,
        client_email: get("client_email") || null,
        client_phone: get("client_phone") || null,
        client_company: get("client_company") || null,
        brand: get("brand") || null,
        service: get("service") || null,
        shoot_date: get("shoot_date") ? new Date(get("shoot_date")).toISOString() : null,
        location: get("location") || null,
        amount_pence: gbp ? Math.round(parseFloat(gbp) * 100) : null,
        notes: get("notes") || null,
      };
      const btn = document.getElementById("vid-save");
      if (btn) btn.textContent = "Saving…";
      if (editingId) {
        const { error } = await supabase.from("videography_bookings").update(payload).eq("id", editingId);
        if (error) { alert("Save failed: " + error.message); if (btn) btn.textContent = "Save booking"; return; }
        Object.assign(bookings.find((x) => x.id === editingId), payload);
      } else {
        payload.stage = "booked";
        const { data, error } = await supabase.from("videography_bookings").insert(payload).select().single();
        if (error) { alert("Save failed: " + error.message); if (btn) btn.textContent = "Save booking"; return; }
        bookings.unshift(data);
      }
      if (btn) btn.textContent = "Save booking";
      closeModal();
      renderBoard(); renderBookings(document.getElementById("vid-booking-search")?.value || "");
      populateDeliverBookings();
    }

    async function deleteBooking() {
      if (!editingId) return;
      if (!confirm("Delete this booking? This can't be undone.")) return;
      const { error } = await supabase.from("videography_bookings").delete().eq("id", editingId);
      if (error) { alert("Delete failed: " + error.message); return; }
      bookings = bookings.filter((x) => x.id !== editingId);
      closeModal();
      renderBoard(); renderBookings(document.getElementById("vid-booking-search")?.value || "");
      populateDeliverBookings();
    }

    /* ---------- Deliver (R2 uploads attached to a booking) ---------- */
    function fmtBytes(n) {
      if (n == null) return "—";
      const u = ["B", "KB", "MB", "GB", "TB"]; let i = 0; let v = Number(n);
      while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }
      return v.toFixed(v >= 10 || i === 0 ? 0 : 1) + " " + u[i];
    }
    function kindFromType(t) {
      if (!t) return "other";
      if (t.startsWith("video/")) return "video";
      if (t.startsWith("image/")) return "image";
      return "other";
    }
    async function authToken() {
      const { data } = await supabase.auth.getSession();
      return data.session ? data.session.access_token : "";
    }
    function deliverBooking() {
      const sel = document.getElementById("vid-deliver-booking");
      return sel ? sel.value : "";
    }
    function populateDeliverBookings() {
      const sel = document.getElementById("vid-deliver-booking");
      if (!sel) return;
      const keep = sel.value;
      const stageLabel = (k) => (STAGES.find((s) => s.key === k) || {}).label || k;
      sel.innerHTML = '<option value="">— Select a client / shoot —</option>' +
        bookings.map((b) => `<option value="${b.id}">${escapeHtml(b.client_name)}${b.client_company ? " · " + escapeHtml(b.client_company) : ""} — ${escapeHtml(stageLabel(b.stage))}</option>`).join("");
      if (keep) sel.value = keep;
    }

    function initDeliver() {
      const dz = document.getElementById("vid-dropzone");
      const input = document.getElementById("vid-file-input");
      const pick = document.getElementById("vid-pick");
      const sel = document.getElementById("vid-deliver-booking");
      if (!dz) return;

      const connected = Boolean(WORKER_URL);
      const configNote = document.getElementById("vid-deliver-config");
      const r2pill = document.getElementById("vid-r2-pill");
      const r2meta = document.getElementById("vid-r2-meta");
      if (configNote) configNote.hidden = connected;
      if (!connected) dz.classList.add("is-disabled");
      if (connected && r2pill) { r2pill.textContent = "Connected"; r2pill.classList.remove("is-pending"); r2pill.classList.add("is-paid"); }
      if (connected && r2meta) r2meta.textContent = "Worker connected.";

      populateDeliverBookings();

      function guard() {
        if (!connected) { alert("Upload backend isn't connected yet — deploy the Worker and set PUBLIC_R2_WORKER_URL."); return false; }
        if (!deliverBooking()) { alert("Pick a booking to deliver to first."); return false; }
        return true;
      }

      pick?.addEventListener("click", () => { if (guard()) input?.click(); });
      input?.addEventListener("change", () => { handleFiles(input.files); input.value = ""; });
      sel?.addEventListener("change", () => { loadDeliverFiles(); loadDelivery(deliverBooking()); });

      ["dragenter", "dragover"].forEach((ev) => dz.addEventListener(ev, (e) => { e.preventDefault(); dz.classList.add("is-drag"); }));
      ["dragleave", "drop"].forEach((ev) => dz.addEventListener(ev, (e) => { e.preventDefault(); dz.classList.remove("is-drag"); }));
      dz.addEventListener("drop", (e) => { if (guard()) handleFiles(e.dataTransfer.files); });

      // Client-delivery panel
      document.getElementById("vid-dlv-base")?.addEventListener("input", recomputeDlvTotal);
      document.getElementById("vid-dlv-add-extra")?.addEventListener("click", () => addExtraRow("", null));
      document.getElementById("vid-dlv-save")?.addEventListener("click", saveDelivery);
      document.getElementById("vid-dlv-copy")?.addEventListener("click", copyDeliveryLink);
      document.getElementById("vid-dlv-sent")?.addEventListener("click", () => setDeliveryStatus("sent"));
      document.getElementById("vid-dlv-paid")?.addEventListener("click", () => setDeliveryStatus("paid"));
    }

    function handleFiles(fileList) {
      const bookingId = deliverBooking();
      if (!WORKER_URL || !bookingId) return;
      Array.from(fileList || []).forEach((file) => uploadFile(file, bookingId));
    }

    function uploadRowUI(file) {
      const wrap = document.getElementById("vid-uploads");
      const row = document.createElement("div");
      row.className = "vid-up";
      row.innerHTML =
        `<div class="vid-up-top"><span class="vid-up-name"></span><span class="vid-up-stat">Starting…</span></div>` +
        `<div class="vid-up-bar"><div class="vid-up-fill"></div></div>`;
      row.querySelector(".vid-up-name").textContent = file.name;
      wrap.prepend(row);
      return {
        setStat: (t, cls) => { const s = row.querySelector(".vid-up-stat"); s.textContent = t; s.className = "vid-up-stat" + (cls ? " " + cls : ""); },
        setPct: (p) => { row.querySelector(".vid-up-fill").style.width = Math.round(p) + "%"; },
        done: () => row.querySelector(".vid-up-fill").classList.add("is-done"),
        error: () => row.querySelector(".vid-up-fill").classList.add("is-error"),
        remove: () => row.remove(),
      };
    }

    function putPart(token, key, uploadId, partNumber, blob, onProgress) {
      return new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        const u = `${WORKER_URL}/part?key=${encodeURIComponent(key)}&uploadId=${encodeURIComponent(uploadId)}&partNumber=${partNumber}`;
        xhr.open("PUT", u);
        xhr.setRequestHeader("Authorization", "Bearer " + token);
        xhr.upload.onprogress = (e) => { if (e.lengthComputable) onProgress(e.loaded); };
        xhr.onload = () => {
          if (xhr.status >= 200 && xhr.status < 300) {
            try { resolve(JSON.parse(xhr.responseText)); } catch (_) { reject(new Error("Bad part response")); }
          } else reject(new Error("Part " + partNumber + " failed (" + xhr.status + ")"));
        };
        xhr.onerror = () => reject(new Error("Network error on part " + partNumber));
        xhr.send(blob);
      });
    }

    async function uploadFile(file, bookingId) {
      const ui = uploadRowUI(file);
      try {
        const token = await authToken();
        if (!token) throw new Error("Not signed in");
        ui.setStat("Preparing…");
        const cRes = await fetch(`${WORKER_URL}/create`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify({ bookingId, fileName: file.name, contentType: file.type || "application/octet-stream" }),
        });
        if (!cRes.ok) throw new Error("Create failed (" + cRes.status + ")");
        const { key, uploadId } = await cRes.json();

        const total = file.size;
        const partCount = Math.max(1, Math.ceil(total / PART_SIZE));
        const parts = [];
        let baseLoaded = 0;
        for (let i = 0; i < partCount; i++) {
          const start = i * PART_SIZE;
          const blob = file.slice(start, Math.min(start + PART_SIZE, total));
          const partNumber = i + 1;
          let attempt = 0;
          for (;;) {
            try {
              const res = await putPart(token, key, uploadId, partNumber, blob, (loaded) => {
                const pct = total ? ((baseLoaded + loaded) / total) * 100 : 0;
                ui.setPct(pct);
                ui.setStat("Uploading " + Math.round(pct) + "% · part " + partNumber + "/" + partCount);
              });
              parts.push({ partNumber, etag: res.etag });
              baseLoaded += blob.size;
              ui.setPct((baseLoaded / total) * 100);
              break;
            } catch (err) {
              if (++attempt >= 3) throw err;
              ui.setStat("Retrying part " + partNumber + " (" + attempt + ")…");
              await new Promise((r) => setTimeout(r, 800 * attempt));
            }
          }
        }

        ui.setStat("Finalising…");
        const fRes = await fetch(`${WORKER_URL}/complete`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify({ key, uploadId, parts }),
        });
        if (!fRes.ok) throw new Error("Complete failed (" + fRes.status + ")");

        await supabase.from("videography_deliverables").insert({
          booking_id: bookingId, file_name: file.name, r2_key: key,
          size_bytes: file.size, content_type: file.type || null, kind: kindFromType(file.type),
        });

        ui.setPct(100); ui.done(); ui.setStat(fmtBytes(file.size) + " · done", "is-done");
        setTimeout(() => ui.remove(), 2500);
        if (deliverBooking() === bookingId) loadDeliverFiles();
      } catch (err) {
        ui.error(); ui.setStat((err && err.message) || "Upload failed", "is-error");
      }
    }

    async function loadDeliverFiles() {
      const listEl = document.getElementById("vid-files-list");
      const emptyEl = document.getElementById("vid-files-empty");
      const bookingId = deliverBooking();
      if (!listEl) return;
      if (!bookingId) { listEl.innerHTML = ""; if (emptyEl) { emptyEl.hidden = false; emptyEl.textContent = "Select a booking to see its delivered files."; } return; }
      if (emptyEl) { emptyEl.hidden = false; emptyEl.textContent = "Loading…"; }
      const { data, error } = await supabase
        .from("videography_deliverables").select("*")
        .eq("booking_id", bookingId).order("created_at", { ascending: false });
      if (error) { if (emptyEl) emptyEl.textContent = "Couldn't load files: " + error.message; listEl.innerHTML = ""; return; }
      if (!data || !data.length) { if (emptyEl) { emptyEl.hidden = false; emptyEl.textContent = "No files delivered for this booking yet."; } listEl.innerHTML = ""; return; }
      if (emptyEl) emptyEl.hidden = true;
      listEl.innerHTML = data.map((f) => `
        <div class="vid-frow" data-id="${f.id}" data-key="${escapeHtml(f.r2_key)}">
          <div class="vid-frow-name">${escapeHtml(f.file_name)}</div>
          <div class="vid-frow-meta">${escapeHtml(f.kind || "file")}</div>
          <div class="vid-frow-meta">${fmtBytes(f.size_bytes)}</div>
          <div class="vid-frow-act"><button class="vid-frow-del" data-del>Delete</button></div>
        </div>`).join("");
      listEl.querySelectorAll("[data-del]").forEach((btn) => btn.addEventListener("click", () => deleteDeliverable(btn.closest(".vid-frow"))));
    }

    async function deleteDeliverable(row) {
      if (!row) return;
      const id = row.getAttribute("data-id");
      const key = row.getAttribute("data-key");
      if (!confirm("Delete this file? It will be removed from storage.")) return;
      const token = await authToken();
      try {
        await fetch(`${WORKER_URL}/object?key=${encodeURIComponent(key)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } });
      } catch (_) { /* still remove the record */ }
      await supabase.from("videography_deliverables").delete().eq("id", id);
      loadDeliverFiles();
    }

    /* ---------- Client delivery (gallery link + paywall) ---------- */
    let currentDelivery = null;

    function genToken() {
      try { return crypto.randomUUID().replace(/-/g, ""); }
      catch (_) { return "d" + Date.now().toString(36) + Math.floor(Math.random() * 1e9).toString(36); }
    }
    function dlvExtrasFromDOM() {
      return Array.from(document.querySelectorAll("#vid-dlv-extra-rows .vid-dlv-extra")).map((row) => ({
        label: row.querySelector("[data-x-label]").value.trim(),
        amount_pence: Math.round((parseFloat(row.querySelector("[data-x-amt]").value) || 0) * 100),
      })).filter((e) => e.label || e.amount_pence);
    }
    function addExtraRow(label, pence) {
      const wrap = document.getElementById("vid-dlv-extra-rows");
      const row = document.createElement("div");
      row.className = "vid-dlv-extra";
      row.innerHTML = `<input type="text" data-x-label placeholder="e.g. Travel" /><input type="number" data-x-amt min="0" step="0.01" placeholder="£" /><button type="button" class="vid-dlv-extra-del" aria-label="Remove">&times;</button>`;
      row.querySelector("[data-x-label]").value = label || "";
      if (pence != null) row.querySelector("[data-x-amt]").value = (pence / 100).toString();
      row.querySelector("[data-x-amt]").addEventListener("input", recomputeDlvTotal);
      row.querySelector(".vid-dlv-extra-del").addEventListener("click", () => { row.remove(); recomputeDlvTotal(); });
      wrap.appendChild(row);
    }
    function recomputeDlvTotal() {
      const base = Math.round((parseFloat(document.getElementById("vid-dlv-base").value) || 0) * 100);
      const extras = dlvExtrasFromDOM().reduce((s, e) => s + e.amount_pence, 0);
      document.getElementById("vid-dlv-total").textContent = gbpFromPence(base + extras);
    }
    function setDeliveryStatusUI(status, token) {
      const pill = document.getElementById("vid-dlv-status");
      const copy = document.getElementById("vid-dlv-copy");
      const sent = document.getElementById("vid-dlv-sent");
      const paid = document.getElementById("vid-dlv-paid");
      const linkEl = document.getElementById("vid-dlv-link");
      pill.textContent = { draft: "Draft", sent: "Sent", paid: "Paid" }[status] || "Not created";
      pill.className = "enquiry-status-pill " + (status === "paid" ? "is-paid" : "is-pending");
      const hasLink = Boolean(token);
      copy.hidden = !hasLink; sent.hidden = !hasLink; paid.hidden = !hasLink;
      if (hasLink) {
        linkEl.textContent = `${location.origin}/deliver?d=${token}`;
        linkEl.hidden = false;
        sent.textContent = status === "sent" ? "Re-mark sent" : "Mark sent";
        paid.textContent = status === "paid" ? "Paid ✓" : "Mark paid (manual)";
      } else linkEl.hidden = true;
    }
    async function loadDelivery(bookingId) {
      const card = document.getElementById("vid-delivery");
      if (!card) return;
      if (!bookingId) { card.hidden = true; currentDelivery = null; return; }
      const booking = bookings.find((b) => b.id === bookingId);
      const { data } = await supabase.from("videography_deliveries").select("*").eq("booking_id", bookingId).maybeSingle();
      currentDelivery = data || null;
      document.getElementById("vid-dlv-teaser").value = data ? data.teaser_count : 3;
      const basePence = data ? data.base_pence : (booking && booking.amount_pence) || 0;
      document.getElementById("vid-dlv-base").value = basePence ? (basePence / 100).toString() : "";
      const rows = document.getElementById("vid-dlv-extra-rows");
      rows.innerHTML = "";
      (data && Array.isArray(data.extras) ? data.extras : []).forEach((e) => addExtraRow(e.label, e.amount_pence));
      recomputeDlvTotal();
      setDeliveryStatusUI(data ? data.status : null, data ? data.token : null);
      card.hidden = false;
    }
    async function saveDelivery() {
      const bookingId = deliverBooking();
      if (!bookingId) { alert("Pick a booking first."); return; }
      const booking = bookings.find((b) => b.id === bookingId);
      const base = Math.round((parseFloat(document.getElementById("vid-dlv-base").value) || 0) * 100);
      const extras = dlvExtrasFromDOM();
      const total = base + extras.reduce((s, e) => s + e.amount_pence, 0);
      const payload = {
        booking_id: bookingId,
        token: (currentDelivery && currentDelivery.token) || genToken(),
        client_name: booking ? booking.client_name : null,
        client_email: booking ? booking.client_email : null,
        teaser_count: parseInt(document.getElementById("vid-dlv-teaser").value, 10) || 0,
        base_pence: base, extras, total_pence: total,
        status: (currentDelivery && currentDelivery.status) || "draft",
      };
      const btn = document.getElementById("vid-dlv-save");
      btn.textContent = "Saving…";
      const { data, error } = await supabase.from("videography_deliveries").upsert(payload, { onConflict: "booking_id" }).select().single();
      btn.textContent = "Save & create link";
      if (error) { alert("Couldn't save delivery: " + error.message); return; }
      currentDelivery = data;
      setDeliveryStatusUI(data.status, data.token);
    }
    async function setDeliveryStatus(status) {
      if (!currentDelivery) return;
      const patch = { status };
      if (status === "sent") patch.sent_at = new Date().toISOString();
      if (status === "paid") patch.paid_at = new Date().toISOString();
      const { data, error } = await supabase.from("videography_deliveries").update(patch).eq("id", currentDelivery.id).select().single();
      if (error) { alert("Couldn't update: " + error.message); return; }
      currentDelivery = data;
      setDeliveryStatusUI(data.status, data.token);
    }
    function copyDeliveryLink() {
      if (!currentDelivery || !navigator.clipboard) return;
      navigator.clipboard.writeText(`${location.origin}/deliver?d=${currentDelivery.token}`).then(() => {
        const b = document.getElementById("vid-dlv-copy"); const t = b.textContent;
        b.textContent = "Copied ✓"; setTimeout(() => (b.textContent = t), 1500);
      });
    }

    async function init365Status() {
      const pill = document.getElementById("vid-365-pill");
      const meta = document.getElementById("vid-365-meta");
      if (!pill) return;
      if (!WORKER_URL) { pill.textContent = "Not connected"; if (meta) meta.textContent = "Set PUBLIC_R2_WORKER_URL + deploy the Worker."; return; }
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/ms/status`, { headers: { Authorization: "Bearer " + token } });
        const d = await res.json();
        if (d && d.connected) {
          pill.textContent = "Connected"; pill.classList.remove("is-pending"); pill.classList.add("is-paid");
          if (meta) meta.textContent = `Linked to ${d.name || d.upn || "Jack's calendar"}.`;
        } else {
          pill.textContent = "Not connected";
          if (meta) meta.textContent = (d && d.error) ? ("Graph error: " + d.error) : "Check the Worker's MS_* secrets + Exchange policy.";
        }
      } catch (e) {
        pill.textContent = "Not connected";
        if (meta) meta.textContent = "Couldn't reach the Worker.";
      }
    }

    /* ---------- Boot ---------- */
    (async () => {
      const session = await requireAdmin();
      if (!session) return;
      initTabs();

      const [bRes, aRes] = await Promise.all([
        supabase.from("videography_bookings").select("*").order("created_at", { ascending: false }),
        supabase.from("videography_availability").select("*"),
      ]);

      bookings = bRes.error ? [] : (bRes.data || []);
      availability = aRes.error ? [] : (aRes.data || []);

      if (bRes.error) {
        const l = document.getElementById("vid-board-loading");
        if (l) l.textContent = "Could not load pipeline: " + bRes.error.message + " — have you run supabase/videography.sql?";
      } else {
        renderBoard();
      }
      const dl = document.getElementById("vid-diary-loading");
      if (dl) dl.remove();
      renderDiary();
      renderBookings();
      initDeliver();
      init365Status();

      document.getElementById("vid-new-booking")?.addEventListener("click", () => openModal(null));
      document.getElementById("vid-save")?.addEventListener("click", saveBooking);
      document.getElementById("vid-delete")?.addEventListener("click", deleteBooking);
      document.getElementById("vid-cancel")?.addEventListener("click", closeModal);
      document.getElementById("vid-modal-close")?.addEventListener("click", closeModal);
      document.getElementById("vid-modal")?.addEventListener("click", (e) => {
        if (e.target instanceof HTMLElement && e.target.id === "vid-modal") closeModal();
      });
      document.getElementById("vid-booking-search")?.addEventListener("input", (e) => renderBookings(e.target.value || ""));
      document.getElementById("vid-diary-save")?.addEventListener("click", saveDiary);
    })();
  </script>
</BaseLayout>
