---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";

---

<AdminShell active="videography" title="Videography" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Videography</div>
          <div class="page-header-sub">Bookings, the diary, and delivery — start to finish.</div>
        </div>
      </div>
    </div>
  </div>
  <div class="ash-panel ash-page">
  <section class="admin-bar">
    <div class="admin-bar-actions">
      <button type="button" class="admin-btn admin-btn-primary" id="vid-new-booking">+ New booking</button>
          <button type="button" class="admin-btn admin-btn-ghost" id="vid-viewtoggle">Calendar view</button>
      <div class="vid-cog-wrap">
        <button type="button" class="vid-cog" id="vid-cog" aria-label="Studio settings" aria-expanded="false">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
          <span>Settings</span>
        </button>
        <div class="vid-cog-menu" id="vid-cog-menu" hidden>
          <button type="button" data-go="clients">Clients</button>
          <button type="button" data-go="diary">Diary &amp; availability</button>
          <button type="button" data-go="deliver">Deliver work</button>
          <button type="button" data-go="settings">Pricing &amp; travel settings</button>
          <button type="button" data-go="connections">Connections</button>
          <a href="/admin/videography-promos" class="vid-cog-link">Promo codes</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ===================== CLIENTS (prioritised list) ===================== -->
  <section class="vid-panel wrap is-active" data-panel="clients">
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Clients</h2>
        <p class="vid-panel-sub">Everyone Jack's working with, by production stage. Drag a card to move it along; click to open the client's file.</p>
      </div>
      <input type="search" id="vid-client-search" class="admin-search" placeholder="Search client, company…" />
    </div>
    <div class="vid-chips" id="vid-chips" role="tablist">
      <button type="button" class="vid-chip is-active" data-stagefilter="all">All</button>
      <button type="button" class="vid-chip" data-stagefilter="booked">Booked</button>
      <button type="button" class="vid-chip" data-stagefilter="invoiced">Invoiced</button>
      <button type="button" class="vid-chip" data-stagefilter="shoot_day">Shoot day</button>
      <button type="button" class="vid-chip" data-stagefilter="editing">Editing</button>
      <button type="button" class="vid-chip" data-stagefilter="gallery_ready">Gallery ready</button>
      <button type="button" class="vid-chip" data-stagefilter="sent">Sent</button>
      <button type="button" class="vid-chip" data-stagefilter="delivered">Delivered</button>
    </div>
    <div class="vid-scrolltop" id="vid-scrolltop" hidden><div id="vid-scrolltop-inner"></div></div>
    <p class="vid-loading" id="vid-clients-loading">Loading clients…</p>
    <div class="vid-clients" id="vid-clients" hidden></div>
    <div class="vid-cal" id="vid-cal" hidden>
      <div class="vid-cal-head">
        <button type="button" class="admin-btn admin-btn-ghost" id="vid-cal-prev">&larr;</button>
        <span class="vid-cal-month" id="vid-cal-month"></span>
        <button type="button" class="admin-btn admin-btn-ghost" id="vid-cal-next">&rarr;</button>
      </div>
      <div class="vid-cal-grid" id="vid-cal-grid"></div>
    </div>
    <p class="vid-loading" id="vid-clients-empty" hidden>No clients yet — add a booking to get started.</p>
  </section>

  <!-- ===================== CANDIDATE FILE (CRM one-pager) ===================== -->
  <section class="vid-panel wrap" data-panel="candidate">
    <button type="button" class="vid-cand-back" id="vid-cand-back">&larr; All clients</button>
    <div class="vid-cand" id="vid-cand"></div>
  </section>

  <!-- ===================== DIARY (weekly availability) ===================== -->
  <section class="vid-panel wrap" data-panel="diary">
    <button type="button" class="vid-cand-back" data-backto="clients" data-smart-back>&larr; Back</button>
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Diary &amp; availability</h2>
        <p class="vid-panel-sub">Set the hours Jack is bookable each weekday. This drives the public booking page.</p>
      </div>
    </div>

    <div class="vid-conn-note">
      <strong>These are the hours Jack is bookable.</strong>
      Click a day, then tap the hours he's available — you can pick more than one
      block (e.g. 9–1 and 3–6). Anything already in his real 365 calendar is
      subtracted automatically, so clients only ever see genuinely free times.
    </div>

    <div class="vid-diary" id="vid-diary">
      <p class="vid-loading" id="vid-diary-loading">Loading diary…</p>
    </div>
    <button type="button" class="admin-btn admin-btn-primary vid-diary-save" id="vid-diary-save" hidden>Save diary</button>
  </section>

  <!-- ===================== DELIVER (uploads → client) ===================== -->
  <section class="vid-panel wrap" data-panel="deliver">
    <button type="button" class="vid-cand-back" data-backto="clients" data-smart-back>&larr; Back</button>
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Deliver work</h2>
        <p class="vid-panel-sub">Upload the finished shoot, then send the client their gallery.</p>
      </div>
    </div>

    <div class="vid-conn-note is-pending" id="vid-deliver-config" hidden>
      <strong>Upload backend not connected yet.</strong>
      Deploy the Cloudflare Worker in <code>worker/</code> and set
      <code>PUBLIC_R2_WORKER_URL</code> in your env, then reload. See
      <code>worker/README.md</code>.
    </div>

    <div class="vid-deliver">
      <div class="vid-field vid-deliver-pick">
        <label>Deliver to booking</label>
        <select id="vid-deliver-booking">
          <option value="">— Select a client / shoot —</option>
        </select>
      </div>

      <!-- The internal copy. Uploads are keyed by booking id, which is stable but
           unreadable in storage, so this generates a human folder name and keeps
           a link straight to it. Admin only - the client's route is Pixieset. -->
      <div class="vid-archive" id="vid-archive" hidden>
        <div class="vid-archive-h">Where this shoot is stored internally</div>
        <div class="vid-field">
          <label>Folder name <span class="vid-lbl-note">shoot type · client · date · location</span></label>
          <div class="vid-archive-row">
            <input type="text" id="vid-arch-folder" />
            <button type="button" class="admin-btn admin-btn-ghost" id="vid-arch-copy">Copy</button>
          </div>
        </div>
        <div class="vid-cand-actions">
          <button type="button" class="admin-btn admin-btn-primary" id="vid-arch-save">Create these folders</button>
          <a class="admin-btn admin-btn-ghost" id="vid-arch-open" href="#" target="_blank" rel="noopener" hidden>Open in Cloudflare</a>
        </div>
        <p class="vid-hint" id="vid-arch-path"></p>
        <p class="vid-hint" id="vid-arch-msg"></p>
      </div>

      <p class="vid-catgrid-intro" id="vid-catgrid-intro">Drag photos &amp; videos into a category — or hit <em>Add</em>. Files go straight to Cloudflare R2 (50&nbsp;MB parts, resumable). The category is how the client's gallery is grouped.</p>
      <div class="vid-catgrid" id="vid-catgrid"></div>

      <div class="vid-uploads" id="vid-uploads"></div>

      <div class="vid-files">
        <h3 class="vid-files-head">Uploaded for this booking</h3>
        <p class="vid-loading" id="vid-files-empty">Select a booking to see its delivered files.</p>
        <div class="vid-files-list" id="vid-files-list"></div>
      </div>

    </div>
  </section>

  <!-- ===================== SETTINGS (pricing & travel) ===================== -->
  <section class="vid-panel wrap" data-panel="settings">
    <button type="button" class="vid-cand-back" data-backto="clients" data-smart-back>&larr; Back</button>
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Pricing &amp; travel settings</h2>
        <p class="vid-panel-sub">Jack's base postcode and the travel surcharge that drives the booking quotes.</p>
      </div>
    </div>
    <div class="vid-conn-note">
      <strong>Jack's base postcode must be set before travel charges go live.</strong>
      Distance is measured from here to the shoot postcode; shoots within the free
      radius carry no surcharge, and every mile beyond it is charged at the rate below.
    </div>
    <div class="vid-settings">
      <div class="vid-field">
        <label>Jack's base postcode</label>
        <input type="text" id="vid-set-postcode" placeholder="NN14 1AA" />
      </div>
      <div class="vid-field-row">
        <div class="vid-field"><label>Free radius (miles)</label><input type="number" id="vid-set-radius" min="0" /></div>
        <div class="vid-field"><label>Surcharge per extra mile (pence)</label><input type="number" id="vid-set-rate" min="0" /></div>
        <div class="vid-field"><label>VAT rate (%)</label><input type="number" id="vid-set-vat" min="0" step="0.1" /></div>
      </div>
      <button type="button" class="admin-btn admin-btn-primary" id="vid-set-save">Save settings</button>
      <span class="vid-set-status" id="vid-set-status"></span>
    </div>

    <!-- Everything bookable, in one place. Built from the same config the
         booking flow uses, so it cannot drift from what a client is quoted. -->
    <h3 class="ash-section-h" style="margin-top:40px">Everything we sell</h3>
        <p class="vid-rate-caption">
          Member prices come from the same config the booking flow charges from, so they cannot
          drift. External prices are the 2026 rate card and are quoted by hand — non-members
          cannot self-book. All prices exclude VAT.
        </p>
        <div class="vid-rate-wrap"><table class="vid-rate" id="vid-rate-table"></table></div>
        <p class="vid-rate-foot" id="vid-rate-foot"></p>
  </section>

  <!-- ===================== CONNECTIONS (integrations) ===================== -->
  <section class="vid-panel wrap" data-panel="connections">
    <button type="button" class="vid-cand-back" data-backto="clients" data-smart-back>&larr; Back</button>
    <div class="vid-panel-head">
      <div>
        <h2 class="vid-panel-title">Connections</h2>
        <p class="vid-panel-sub">The accounts that power booking, storage, and payments.</p>
      </div>
    </div>

    <div class="vid-conn-grid">
      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>Microsoft 365 — Jack's calendar</h3>
          <span class="enquiry-status-pill is-pending" id="vid-365-pill">Checking…</span>
        </div>
        <p>Status only — nothing to click. This just confirms the booking system can reach Jack's calendar in the background, so new bookings write into his real diary automatically.</p>
        <p class="vid-conn-meta" id="vid-365-meta">Verifying connection…</p>
      </div>

      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>Cloudflare R2 — media storage</h3>
          <span class="enquiry-status-pill is-pending" id="vid-r2-pill">Not connected</span>
        </div>
        <p>Fast, high-resolution storage for shoots. Direct-to-edge uploads for Jack, zero-egress fast downloads for clients.</p>
        <p class="vid-conn-meta" id="vid-r2-meta">Deploy the Worker in <code>worker/</code> and set <code>PUBLIC_R2_WORKER_URL</code>.</p>
      </div>

      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>Stripe — payments</h3>
          <span class="enquiry-status-pill is-pending">Not connected</span>
        </div>
        <p>Paywalls the full gallery and collects payment. Teaser images free, full set on payment.</p>
        <button type="button" class="admin-btn admin-btn-ghost" disabled>Connect Stripe (Phase 5)</button>
      </div>

      <div class="vid-conn-card">
        <div class="vid-conn-row">
          <h3>QuickBooks — invoicing</h3>
          <span class="enquiry-status-pill is-pending">Not connected</span>
        </div>
        <p>Raises and reconciles the invoice once a shoot is paid for. Keeps the books in sync.</p>
        <button type="button" class="admin-btn admin-btn-ghost" disabled>Connect QuickBooks (Phase 5)</button>
      </div>
    </div>
  </section>
  </div>

  <!-- ===================== Booking modal (add / edit) ===================== -->
  <div class="modal-backdrop" id="vid-modal" hidden>
    <div class="modal vid-modal" role="dialog" aria-modal="true" aria-labelledby="vid-modal-title">
      <header class="modal-head">
        <h2 id="vid-modal-title">New booking</h2>
        <button type="button" class="modal-close" id="vid-modal-close" aria-label="Close">&times;</button>
      </header>
      <div class="vid-form" id="vid-form">
        <div class="vid-field">
          <label>Client name *</label>
          <input type="text" data-f="client_name" />
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Email</label><input type="email" data-f="client_email" /></div>
          <div class="vid-field"><label>Phone</label><input type="tel" data-f="client_phone" /></div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Company</label><input type="text" data-f="client_company" /></div>
          <div class="vid-field">
            <label>Brand / price tier</label>
            <select data-f="brand">
              <option value="">— Select —</option>
              <option value="property-experts">The Property Experts</option>
              <option value="fine-and-country">Fine &amp; Country</option>
              <option value="other">Other / direct</option>
            </select>
          </div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Service</label><input type="text" data-f="service" placeholder="Property video, podcast…" /></div>
          <div class="vid-field"><label>Shoot date</label><input type="datetime-local" data-f="shoot_date" step="900" /></div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field">
            <label>Shoot location</label>
            <input type="text" data-f="location" placeholder="Where Jack is going — this is what his calendar says" />
          </div>
          <div class="vid-field"><label>Quote (£)</label><input type="number" data-f="amount_gbp" min="0" step="0.01" /></div>
        </div>
        <div class="vid-field">
          <label>Property address <span class="vid-lbl-note">shown on a Fine &amp; Country invoice</span></label>
          <textarea data-f="property_address" rows="2" placeholder="Full address including postcode"></textarea>
        </div>
        <div class="vid-field"><label>Notes</label><textarea data-f="notes" rows="3"></textarea></div>

        <!-- Who settles this booking. The data model has carried this since the
             Fine & Country work; nothing surfaced it until now. -->
        <div class="vid-deliver-head">
          <h3>Payment</h3>
          <span>Who settles this booking</span>
        </div>
        <div class="vid-field">
          <label>Route</label>
          <select data-f="payment_route" id="vid-route">
            <option value="agent_card">Customer pays by card</option>
            <option value="brand_invoice">Invoice the brand (F&amp;C)</option>
            <option value="brand_invoice_teg">Invoice the brand (TEG)</option>
            <option value="smm_package">Social Media Marketing</option>
          </select>
        </div>

        <!-- Only for brand-invoiced jobs. Jack must confirm with Fine & Country
             that the office named at booking is actually holding the seller's
             marketing fee, before we invoice against it. -->
        <div id="vid-brand-block" hidden>
          <div class="vid-field-row">
            <div class="vid-field">
              <label>Office holding the fee</label>
              <select data-f="fc_office" id="vid-fc-office"><option value="">— Select —</option></select>
            </div>
            <div class="vid-field">
              <label>Agent said a fee was charged</label>
              <select data-f="marketing_fee_claimed">
                <option value="">Not asked</option>
                <option value="yes">Yes</option>
                <option value="no">No</option>
              </select>
            </div>
          </div>
          <label class="vid-check">
            <input type="checkbox" id="vid-fee-confirmed" />
            <span>Confirmed with Fine &amp; Country that the fee is held</span>
          </label>
          <p class="vid-hint" id="vid-fee-meta"></p>
          <p class="vid-warn" id="vid-fee-warn" hidden></p>
        </div>

        <!-- TEG-invoiced jobs and package-covered jobs share this block: both
             need a brand and a reason, neither has a fee to confirm. The reason
             list differs by route — see reasonsForRoute(). -->
        <div id="vid-teg-block" hidden>
          <div class="vid-field-row">
            <div class="vid-field">
              <label>Brand</label>
              <select data-f="teg_brand" id="vid-teg-brand"><option value="">— Select —</option></select>
            </div>
          </div>
          <div class="vid-field-row">
            <div class="vid-field">
              <label>Reason</label>
              <select data-f="teg_reason" id="vid-teg-reason"><option value="">— Select —</option></select>
            </div>
            <div class="vid-field" id="vid-teg-reason-other-wrap" hidden>
              <label>What's the reason?</label>
              <input type="text" data-f="teg_reason_other" id="vid-teg-reason-other" placeholder="For the invoice notes" />
            </div>
          </div>
          <p class="vid-hint" id="vid-teg-hint">Goes to Paula at Newman for every TEG brand — billed to the brand name selected above, not to Paula.</p>
          <p class="vid-hint" id="vid-smm-hint" hidden>Covered by their social media package — nothing is invoiced, and the client's gallery, tour and PIN open as soon as the booking is saved.</p>
        </div>

        <div id="vid-card-block">
          <p class="vid-hint" id="vid-pay-status"></p>
        </div>
        <div id="vid-paid-block">
          <label class="vid-check">
            <input type="checkbox" id="vid-paid" />
            <span>Payment received</span>
          </label>
          <p class="vid-hint">The PIN is released on this. Nothing goes to the client until it is ticked.</p>
        </div>

        <!-- Delivery. Filled in after the shoot, once the Pixieset gallery
             exists and the archive copy is up. Hidden while creating a booking:
             none of it can be known yet, and it buries the fields that can. -->
        <div id="vid-delivery-block">
        <div class="vid-deliver-head">
          <h3>Delivery</h3>
          <span>Fill in once the gallery is live</span>
        </div>
        <div class="vid-field">
          <label>Gallery link</label>
          <input type="url" data-f="gallery_url" placeholder="https://gallery.tmke.co.uk/…" />
        </div>
        <div class="vid-field-row">
          <div class="vid-field">
            <label>Gallery email <span class="vid-lbl-note">what the client types to download</span></label>
            <input type="email" data-f="gallery_email" />
            <p class="vid-warn" id="vid-email-warn" hidden></p>
          </div>
          <div class="vid-field">
            <label>PIN <span class="vid-lbl-note">never shown to the client until paid</span></label>
            <input type="text" data-f="gallery_pin" autocomplete="off" />
          </div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field"><label>Store link</label><input type="url" data-f="store_url" placeholder="Buying extra downloads" /></div>
          <div class="vid-field"><label>360 Tour <span class="vid-lbl-note">withheld until paid, like the PIN</span></label><input type="url" data-f="tour_360_url" placeholder="Pixieset can't hold these" /></div>
        </div>
        <div class="vid-field-row">
          <div class="vid-field">
            <label>Download cap <span class="vid-lbl-note">blank = uncapped</span></label>
            <input type="number" data-f="download_cap" min="0" step="1" />
          </div>
          <div class="vid-field">
            <label>Gallery expires <span class="vid-lbl-note">Pixieset holds ~3 months</span></label>
            <input type="date" data-f="gallery_expires_on" />
          </div>
        </div>
        <label class="vid-check">
          <input type="checkbox" id="vid-archived" />
          <span>Archive copy uploaded to our own storage</span>
        </label>
        <p class="vid-hint">Pixieset only keeps a gallery for about three months. The archive is what the team uses afterwards.</p>
        </div>
      </div>
      <footer class="modal-foot">
        <button type="button" class="admin-btn admin-btn-danger" id="vid-delete" hidden>Delete</button>
        <div class="spacer"></div>
        <button type="button" class="admin-btn admin-btn-ghost" id="vid-cancel">Cancel</button>
        <button type="button" class="admin-btn admin-btn-primary" id="vid-save">Save booking</button>
      </footer>
    </div>
  </div>

  <style is:global>
    /* .ash-content insets the page by 26px at the top; the banner leaves the
       same gap underneath it, so the top of the page reads as one rhythm rather
       than two. (.hub-skin's own 28px is close but not the same number.) */
    .hub-skin .page-header { margin-bottom: 26px; }
    /* A primary button has no border where a ghost button has one, so a row
       mixing the two came out 2px uneven. A transparent border costs nothing
       and makes every button on the page the same height. */
    .hub-skin .admin-btn-primary { border: 1px solid transparent; }

    .admin-hero-pad { padding-top: 100px; }
    @media (max-width: 720px) { .admin-hero-pad { padding-top: 56px; } }

    /* The vertical rhythm at the top of the page is one number: the gap above
       the banner (.ash-content's own top padding) is the gap below it too, and
       the toolbar carries no padding of its own on top. What is left underneath
       is just enough to separate the toolbar from the back link. */
    .admin-bar {
      display: flex; justify-content: space-between; align-items: center;
      gap: 16px; max-width: 1360px; margin: 0 auto;
      padding: 0 36px 12px; flex-wrap: wrap;
    }
    .admin-back {
      font-family: var(--sans); font-size: 12px; letter-spacing: 0.22em;
      text-transform: uppercase; color: var(--english-violet); font-weight: 700;
    }
    .admin-back:hover { color: var(--ink); }
    /* .hub-skin sets this to 20px for the hub as a whole; three buttons that
       belong together read better closer than that. Needs the extra class to
       out-specify it. */
    .admin-bar-actions,
    .hub-skin .admin-bar .admin-bar-actions { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .admin-search {
      padding: 8px 12px; border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 2px;
      font-family: var(--sans); font-size: 13px; color: var(--ink);
      background: var(--paper); min-width: 220px;
    }
    .admin-search:focus { outline: none; border-color: var(--english-violet); }

    .enquiry-chip {
      display: inline-flex; align-items: center; gap: 6px; padding: 7px 14px;
      background: #fff; border: 1px solid rgba(var(--violet-rgb), 0.3);
      border-radius: 999px; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700;
      color: var(--english-violet); cursor: pointer;
      transition: background 0.2s, color 0.2s, border-color 0.2s;
    }
    .enquiry-chip:hover { background: rgba(var(--violet-rgb), 0.06); }
    .enquiry-chip.is-active {
      background: var(--english-violet); color: var(--paper); border-color: var(--english-violet);
    }

    /* ---- Panels ---- */
    .vid-panel { max-width: 1360px; margin: 0 auto; padding: 0 36px 200px; display: none; }
    .vid-panel.is-active { display: block; }
    .vid-panel-head {
      display: flex; justify-content: space-between; align-items: flex-end;
      gap: 16px; flex-wrap: wrap; margin-bottom: 24px;
    }
    .vid-panel-title { font-family: var(--serif); font-size: 30px; font-weight: 500; color: var(--ink); margin: 0; }
    .vid-panel-sub { font-family: var(--sans); font-size: 14px; color: rgba(28, 29, 34, 0.6); margin: 4px 0 0; }
    .vid-loading { font-family: var(--sans); font-size: 14px; color: rgba(28, 29, 34, 0.55); padding: 40px 0; }

    /* The internal archive box in Deliver work. */
    .vid-archive {
      margin: 0 0 18px; padding: 16px 18px; border-radius: 5px;
      background: rgba(var(--violet-rgb), 0.045); border: 1px solid rgba(var(--violet-rgb), 0.16);
    }
    .vid-archive-h {
      font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--english-violet); margin-bottom: 12px;
    }
    .vid-archive-row { display: flex; gap: 8px; align-items: center; }
    .vid-archive-row input { flex: 1; }

    /* ---- Delivery block in the booking modal ---- */
    .vid-deliver-head {
      display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap;
      margin: 26px 0 2px; padding-top: 18px;
      border-top: 1px solid rgba(var(--violet-rgb), 0.16);
    }
    .vid-deliver-head h3 {
      margin: 0; font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet);
    }
    .vid-deliver-head span { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.45); }
    .vid-lbl-note { font-weight: 400; text-transform: none; letter-spacing: 0; color: rgba(28,29,34,0.45); font-size: 11px; }
    .vid-warn {
      margin: 6px 0 0; font-family: var(--sans); font-size: 11.5px; line-height: 1.45;
      color: #8a5a2b; background: rgba(184, 124, 60, 0.1);
      padding: 7px 10px; border-radius: 6px;
    }
    .vid-check { display: flex; align-items: center; gap: 9px; margin-top: 14px; font-family: var(--sans); font-size: 13px; color: var(--ink); cursor: pointer; }
    .vid-check input { width: 16px; height: 16px; accent-color: var(--english-violet); cursor: pointer; }
    .vid-hint { margin: 6px 0 0; font-family: var(--sans); font-size: 11.5px; line-height: 1.5; color: rgba(28,29,34,0.5); }

    /* ---- Settings cog ---- */
    /* global.css sets `main, section { position: relative; z-index: 2 }`, so the
       toolbar and every .vid-panel are sibling stacking contexts at the same
       level. The panels come later in the DOM, so they paint OVER the whole
       toolbar subtree - and a z-index inside the toolbar cannot escape its own
       context, however high. Lift the toolbar while the menu is open. This is
       the companion to the menu's position:fixed below: fixed escapes the
       shell's overflow clipping, this escapes the sibling stacking order.
       Both are needed, which is what the contacts tag filter does. */
    .admin-bar:has(#vid-cog-menu:not([hidden])) { z-index: 30; }
    .vid-cog-wrap { position: relative; }
    /* Same metrics as .admin-btn-ghost beside it - it used to be a taller,
       rounder pill with a 20px icon, which made it the odd one out in a row of
       three buttons. The icon is sized to the cap height of the label. */
    .vid-cog {
      display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px;
      background: var(--surface, #fff); border: 1px solid var(--border, #eae5e1); border-radius: 4px;
      font-family: var(--sans); font-size: 12px; line-height: 1; letter-spacing: 0.04em;
      text-transform: uppercase; font-weight: 700; color: var(--muted, rgba(28,29,34,0.55));
      cursor: pointer; transition: all 0.18s;
    }
    /* Negative margins so the icon can be legible at 14px without making this
       button taller than the 12px-line-height ones beside it. */
    .vid-cog svg { width: 14px; height: 14px; flex: none; margin: -1px 0; }
    .vid-cog:hover {
      border-color: var(--primary, var(--english-violet));
      color: var(--primary, var(--english-violet));
      background: var(--primary-light, rgba(var(--violet-rgb), 0.06));
    }
    /* Fixed, not absolute. The shell clips: `.ash` is overflow:hidden and
       `.ash-content` is overflow-y:auto, so an absolutely positioned menu gets
       cut off at the container edge — which reads as the card being
       see-through or sitting behind the page. No z-index can escape a clip,
       which is why raising it changed nothing. Same fix as the contacts tag
       filter. top/left/max-height come from the button's rect in JS. */
    .vid-cog-menu {
      position: fixed; z-index: 400;
      background: #fff; border: 1px solid rgba(var(--violet-rgb), 0.2); border-radius: 8px;
      box-shadow: 0 18px 50px rgba(20, 18, 26, 0.22); padding: 6px; width: 240px;
      display: flex; flex-direction: column; overflow-y: auto;
    }
    .vid-cog-menu[hidden] { display: none; }
    .vid-cog-menu button, .vid-cog-menu .vid-cog-link {
      text-align: left; background: none; border: none; cursor: pointer; border-radius: 6px;
      font-family: var(--sans); font-size: 13px; color: var(--ink); padding: 11px 12px;
      text-decoration: none; display: block;
    }
    .vid-cog-menu button:hover, .vid-cog-menu .vid-cog-link:hover { background: rgba(var(--violet-rgb), 0.07); color: var(--english-violet); }
    .vid-cog-menu .vid-cog-link { border-top: 1px solid rgba(var(--violet-rgb), 0.12); margin-top: 2px; }

    /* ---- Clients list ---- */
    .vid-clients { display: flex; flex-direction: column; gap: 10px; }
    .vid-client {
      display: grid; grid-template-columns: 1.4fr 1fr auto; gap: 18px; align-items: center;
      background: var(--paper); border: 1px solid rgba(var(--violet-rgb), 0.18); border-radius: 8px;
      padding: 18px 22px; cursor: pointer; transition: border-color 0.15s, box-shadow 0.15s, transform 0.15s;
    }
    .vid-client:hover { border-color: var(--english-violet); box-shadow: 0 6px 20px rgba(20, 18, 26, 0.08); transform: translateY(-1px); }
    .vid-client.is-complete { opacity: 0.6; }
    .vid-client-name { font-family: var(--serif); font-size: 20px; font-weight: 500; color: var(--ink); }
    .vid-client-co { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.55); margin-top: 2px; }
    .vid-client-next { font-family: var(--sans); font-size: 13px; color: rgba(28, 29, 34, 0.7); }
    .vid-client-stage {
      justify-self: end; display: inline-flex; align-items: center; gap: 8px;
      font-family: var(--sans); font-size: 10px; letter-spacing: 0.18em; text-transform: uppercase;
      font-weight: 700; color: var(--english-violet);
      background: rgba(var(--violet-rgb), 0.08); padding: 5px 12px; border-radius: 999px; white-space: nowrap;
    }
    .vid-client-when { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.5); margin-top: 4px; }
    @media (max-width: 720px) { .vid-client { grid-template-columns: 1fr; gap: 8px; } .vid-client-stage { justify-self: start; } }

    /* ---- Candidate file (CRM one-pager) ---- */
    .vid-cand-back {
      background: none; border: none; cursor: pointer; font-family: var(--sans);
      font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700;
      color: var(--english-violet); padding: 0; margin: 0 0 14px;
    }
    .vid-cand-back:hover { color: var(--ink); }
    /* Three cards rather than one. Documents and messages used to sit inside
       the booking card, which buried the stage - the thing you came here to
       act on. Tighter padding too; the old spacing was doing no work. */
    /* Full width, starting where the banner and the toolbar start. It used to
       be capped at 820px and centred, so it was the one thing on the page that
       did not line up with the left edge - and the narrower it was, the more
       cramped the meta row and the timeline read inside it. */
    .vid-cand { margin: 0; text-align: left; display: flex; flex-direction: column; gap: 18px; }
    .vid-cand-card {
      background: var(--paper); border: 1px solid rgba(var(--violet-rgb), 0.16); border-radius: 14px;
      /* Side padding caps at 28px - the banner's own - so everything inside the
         card starts on the same line as the banner's title above it. */
      padding: clamp(22px, 2.6vw, 32px) clamp(20px, 2.6vw, 28px);
    }
    /* The stage's own action, inside the stage card. Set apart by a rule rather
       than a border so it reads as part of the card, not a card within a card. */
    .vid-pixieset {
      margin-top: 18px; padding: 16px 18px; border-radius: var(--radius, 5px);
      background: var(--surface-2, #faf8f7); border: 1px solid var(--border, #eae5e1);
    }
    .vid-pixieset.is-done { background: rgba(var(--violet-rgb), 0.05); border-color: rgba(var(--violet-rgb), 0.2); }

    .vid-cand-action { margin-top: 24px; padding-top: 22px; border-top: 1px solid var(--border, #eae5e1); }
    .vid-cand-action[hidden] { display: none; }
    .vid-cand-action > h4:first-child { margin-top: 0; }
    .vid-cand-card h4 {
      margin: 0 0 14px; font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet);
    }

    /* Invoice card on the booking. */
    .vid-inv-row { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 14px; }
    /* The booking modal's inputs are sized for a modal. In this card they came
       out larger than the card heading, which read as a mistake. */
    #vid-cand-invoice input,
    #vid-cand-invoice textarea,
    #vid-cand-invoice select { font-size: 13px; padding: 9px 11px; }
    #vid-cand-invoice .vid-field > span { font-size: 11px; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .vid-inv-toggle { display: inline-flex; gap: 4px; padding: 3px; background: rgba(28,29,34,0.05); border-radius: 8px; }
    .vid-inv-toggle button {
      appearance: none; border: 0; background: none; cursor: pointer; border-radius: 6px; padding: 6px 14px;
      font-family: var(--sans); font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.55);
    }
    .vid-inv-toggle button.is-active { background: var(--english-violet); color: #fff; }
    .vid-inv-item { display: grid; grid-template-columns: 1fr 120px 32px; gap: 8px; margin-bottom: 8px; }
    .vid-inv-item input {
      padding: 8px 10px; border-radius: 7px; border: 1px solid rgba(var(--violet-rgb), 0.25);
      font-family: var(--sans); font-size: 13px; background: var(--paper); color: var(--ink);
    }
    .vid-inv-x { appearance: none; border: 0; background: none; cursor: pointer; color: rgba(28,29,34,0.4); font-size: 18px; border-radius: 6px; }
    .vid-inv-x:hover { background: rgba(28,29,34,0.06); color: #8a3b2f; }
    .vid-inv-totals { display: flex; gap: 18px; flex-wrap: wrap; justify-content: flex-end; margin: 10px 0 4px; font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); }
    .vid-inv-totals strong { color: var(--english-violet); font-size: 14px; }
    .vid-inv-list-h {
      margin: 22px 0 10px; padding-top: 16px; border-top: 1px solid rgba(var(--violet-rgb), 0.14);
      font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: rgba(28,29,34,0.45);
    }
    .vid-inv-row-item { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; padding: 9px 0; border-bottom: 1px solid rgba(28,29,34,0.06); font-family: var(--sans); font-size: 13px; }
    /* Status and actions sit right, so the eye runs number → amount → what to do. */
    .vid-inv-actions { margin-left: auto; display: inline-flex; align-items: center; gap: 8px; flex-wrap: wrap; }
    .vid-inv-actions .admin-btn { padding: 5px 11px; font-size: 11px; }
    .vid-inv-num { font-weight: 700; color: var(--english-violet); min-width: 92px; }
    .vid-inv-status { font-size: 11px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 3px 8px; border-radius: 4px; background: rgba(28,29,34,0.07); color: rgba(28,29,34,0.55); }
    .vid-inv-status.is-paid { background: rgba(var(--violet-rgb), 0.12); color: var(--english-violet); }
    .vid-chaselog { margin-top: 16px; padding-top: 14px; border-top: 1px solid var(--border, #eae5e1); }
    .vid-chaselog-h { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted, rgba(28,29,34,0.5)); margin-bottom: 8px; }
    .vid-chaselog-row { display: flex; gap: 10px; align-items: baseline; font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.7); padding: 4px 0; }
    .vid-chaselog-when { min-width: 92px; color: var(--muted, rgba(28,29,34,0.5)); }
    .vid-inv-status.is-void { background: rgba(28,29,34,0.06); color: rgba(28,29,34,0.4); text-decoration: line-through; }

    /* Notes: internal record + audit trail. */
    .vid-notes { display: flex; flex-direction: column; gap: 10px; margin-bottom: 16px; }
    .vid-note { padding: 11px 13px; border-radius: 9px; background: rgba(28,29,34,0.035); border: 1px solid rgba(28,29,34,0.07); }
    .vid-note.is-audit { background: rgba(var(--violet-rgb), 0.06); border-color: rgba(var(--violet-rgb), 0.18); }
    .vid-note-meta { display: flex; justify-content: space-between; gap: 10px; flex-wrap: wrap; font-family: var(--sans); font-size: 11px; color: rgba(28,29,34,0.5); margin-bottom: 5px; }
    .vid-note-meta strong { color: var(--english-violet); font-weight: 700; }
    .vid-note-body { font-family: var(--sans); font-size: 13px; line-height: 1.55; color: var(--ink); }
    .vid-mention { color: var(--english-violet); font-weight: 700; }
    .vid-note-compose { position: relative; display: flex; flex-direction: column; gap: 9px; align-items: flex-start; }
    .vid-note-compose textarea {
      width: 100%; padding: 10px 12px; border-radius: 8px; font-family: var(--sans); font-size: 13px;
      border: 1px solid rgba(var(--violet-rgb), 0.25); background: var(--paper); color: var(--ink); resize: vertical;
    }
    .vid-mention-menu {
      position: absolute; top: 100%; left: 0; z-index: 40; min-width: 240px; margin-top: 4px;
      background: #fff; border: 1px solid rgba(var(--violet-rgb), 0.2); border-radius: 8px;
      box-shadow: 0 14px 36px rgba(20,18,26,0.16); padding: 5px; display: flex; flex-direction: column;
    }
    .vid-mention-menu[hidden] { display: none; }
    .vid-mention-menu button {
      appearance: none; border: 0; background: none; text-align: left; cursor: pointer;
      font-family: var(--sans); font-size: 12.5px; color: var(--ink); padding: 8px 10px; border-radius: 6px;
    }
    .vid-mention-menu button:hover { background: rgba(var(--violet-rgb), 0.08); color: var(--english-violet); }

    /* The Fine & Country check, shown only on brand-invoiced bookings at Booked. */
    .vid-gate {
      margin-top: 22px; padding: 16px 18px; border-radius: 10px;
      background: rgba(184, 124, 60, 0.08); border: 1px solid rgba(184, 124, 60, 0.28);
    }
    .vid-gate.is-done { background: rgba(var(--violet-rgb), 0.06); border-color: rgba(var(--violet-rgb), 0.22); }
    .vid-gate-h {
      font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: #8a5a2b; margin-bottom: 12px;
    }
    .vid-gate.is-done .vid-gate-h { color: var(--english-violet); }
    .vid-gate-list { margin: 0 0 12px; display: grid; gap: 7px; }
    .vid-gate-list > div { display: flex; gap: 10px; flex-wrap: wrap; align-items: baseline; }
    .vid-gate-list dt { font-family: var(--sans); font-size: 11.5px; color: rgba(28,29,34,0.55); min-width: 190px; }
    .vid-gate-list dd { margin: 0; font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--ink); }
    /* Client, brand, stage - one line, reading left to right. It used to run
       down four stacked lines, two of which said the same thing. */
    .vid-cand-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
    .vid-cand-name {
      font-family: var(--serif); font-weight: 500; color: var(--ink);
      font-size: clamp(26px, 3.2vw, 38px); line-height: 1.1; letter-spacing: -0.01em;
      margin: 0;
    }
    .vid-cand-co { font-family: var(--sans); font-size: 14px; color: rgba(28, 29, 34, 0.55); }
    /* Pushed to the end of the line so the stage sits clear of the name, and
       drops beneath it rather than squashing it when the name runs long. */
    .vid-cand-stage {
      margin-left: auto; flex: none; align-self: center;
      font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--english-violet);
      background: rgba(var(--violet-rgb), 0.09); border: 1px solid rgba(var(--violet-rgb), 0.22);
      border-radius: 999px; padding: 5px 12px; white-space: nowrap;
    }
    @media (max-width: 560px) { .vid-cand-stage { margin-left: 0; } }

    /* Tabs on the booking card. Drawn as actual tabs - a white face, a hairline
       round the top, sitting on the rule that runs under the row - rather than
       bare words, which gave nothing to tell you they could be clicked. The
       active one erases its own bottom edge so it joins the pane below it.

       Boxed, so the row starts flush with the card's other content: the first
       tab's edge lines up with the name, the meta row and the buttons above,
       the same way a button's edge does. */
    .vid-tabs {
      display: flex; flex-wrap: wrap; gap: 4px; margin-top: 26px;
      border-bottom: 1px solid rgba(var(--violet-rgb), 0.18);
    }
    .vid-tab {
      appearance: none; cursor: pointer; position: relative;
      background: var(--surface, #fff);
      border: 1px solid rgba(var(--violet-rgb), 0.18); border-bottom-color: transparent;
      border-radius: 6px 6px 0 0; margin-bottom: -1px; padding: 9px 16px;
      font-family: var(--sans); font-size: 11.5px; font-weight: 700;
      letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28, 29, 34, 0.5);
      transition: color 0.15s, border-color 0.15s;
    }
    .vid-tab:hover { color: var(--ink); }
    .vid-tab.is-active { color: var(--english-violet); border-bottom-color: var(--surface, #fff); }
    /* The 2px cap on the active tab is what carries at a glance - the joined
       bottom edge alone is a one-pixel difference. */
    .vid-tab.is-active::before {
      content: ""; position: absolute; left: -1px; right: -1px; top: -1px; height: 2px;
      background: var(--english-violet); border-radius: 6px 6px 0 0;
    }
    .vid-tabpane { display: none; padding-top: 24px; }
    /* .vid-loading is the page's full-height loading/empty state, with 40px of
       padding above and below its one line. Inside a tab pane - where most of
       these read "no notes yet" - that is just a hole. */
    .vid-tabpane .vid-loading { padding: 6px 0 14px; }
    .vid-tabpane.is-active { display: block; }
    /* The tab already names the section, so the card's own heading would say it
       twice. The stage tab keeps its headings - they name the work, not the tab. */
    .vid-tabpane:not([data-tab="stage"]) > div > h4:first-child { display: none; }
    /* The timeline opens the stage tab, so it has the tab bar above it already. */
    .vid-tabpane[data-tab="stage"] > .vid-timeline:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
    .vid-cand-next {
      font-family: var(--sans); font-size: 14.5px; line-height: 1.6; color: rgba(28, 29, 34, 0.72);
      max-width: 62ch; margin: 10px 0 0;
    }
    .vid-cand-meta {
      display: flex; flex-wrap: wrap; justify-content: flex-start; gap: 10px 26px;
      font-family: var(--sans); font-size: 13px; color: rgba(28, 29, 34, 0.6);
      margin: 22px 0 4px; padding-top: 22px; border-top: 1px solid rgba(var(--violet-rgb), 0.12);
    }
    .vid-cand-meta strong { color: var(--ink); font-weight: 700; }
    .vid-cand-actions { display: flex; flex-wrap: wrap; align-items: center; justify-content: flex-start; gap: 10px; margin-top: 22px; }
    /* Progress timeline — runs edge-to-edge (same width as the meta above),
       evenly split, first step at the start, last at the end. */
    .vid-timeline { position: relative; margin-top: 26px; padding-top: 22px; border-top: 1px solid rgba(var(--violet-rgb), 0.12); height: 62px; }
    .vid-timeline.is-cancelled { opacity: 0.5; }
    .vid-tl-track { position: absolute; top: 29px; left: 7px; right: 7px; height: 2px; background: rgba(28, 29, 34, 0.15); }
    .vid-tl-track-fill { position: absolute; left: 0; top: 0; height: 100%; background: var(--english-violet); transition: width 0.3s ease; }
    .vid-tl-step { position: absolute; top: 22px; display: flex; flex-direction: column; align-items: center; gap: 9px; transform: translateX(-50%); }
    .vid-tl-step--first { transform: translateX(0); align-items: flex-start; }
    .vid-tl-step--last { transform: translateX(-100%); align-items: flex-end; }
    .vid-tl-dot { width: 14px; height: 14px; border-radius: 50%; background: #fff; border: 2px solid rgba(28, 29, 34, 0.22); position: relative; z-index: 1; transition: background 0.2s, border-color 0.2s, box-shadow 0.2s; }
    .vid-tl-step.is-done .vid-tl-dot { background: var(--english-violet); border-color: var(--english-violet); }
    .vid-tl-step.is-current .vid-tl-dot { box-shadow: 0 0 0 4px rgba(var(--violet-rgb), 0.18); }
    .vid-tl-label { font-family: var(--sans); font-size: 11.5px; color: rgba(28, 29, 34, 0.5); text-align: center; white-space: nowrap; }
    .vid-tl-step--first .vid-tl-label { text-align: left; }
    .vid-tl-step--last .vid-tl-label { text-align: right; }
    .vid-tl-step.is-done .vid-tl-label, .vid-tl-step.is-current .vid-tl-label { color: var(--ink); font-weight: 600; }
    .vid-cand-drawer {
      margin-top: 22px; padding-top: 22px; border-top: 1px solid rgba(var(--violet-rgb), 0.12);
      text-align: left; display: none;
    }
    .vid-cand-drawer.is-open { display: block; }
    .vid-cand-drawer h4 { font-family: var(--sans); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.55); margin: 0 0 12px; }
    .vid-add-opts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    @media (max-width: 640px) { .vid-add-opts { grid-template-columns: 1fr; } }
    .vid-add-opt {
      text-align: left; background: rgba(var(--violet-rgb), 0.04); border: 1px solid rgba(var(--violet-rgb), 0.16);
      border-radius: 8px; padding: 14px 16px; cursor: pointer; font-family: var(--sans);
      transition: border-color 0.15s, background 0.15s;
    }
    .vid-add-opt:hover { border-color: var(--english-violet); background: rgba(var(--violet-rgb), 0.07); }
    .vid-add-opt strong { display: block; font-size: 14px; color: var(--ink); margin-bottom: 3px; }
    .vid-add-opt span { font-size: 12px; color: rgba(28,29,34,0.6); }
    /* Contact matches: one row per person, with what matched and what you can
       do about it. The reason sits next to the name because a suggestion you
       cannot see the basis for is not one you can act on. */
    .vid-contact-block { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(var(--violet-rgb), 0.12); }
    /* Only the block that opens the drawer loses its rule. Keyed off the
       heading rather than :first-of-type, which picked the wrong block whenever
       the first thing under the heading was a gate or a line of prose. */
    .vid-cand-drawer > h4 + .vid-contact-block { margin-top: 0; padding-top: 0; border-top: 0; }
    .vid-contact-row {
      display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
      padding: 9px 0; border-bottom: 1px solid rgba(28, 29, 34, 0.07);
    }
    /* Grows to fill the row, so the reason chip lands beside the button at the
       same place on every row instead of trailing the name's length. */
    .vid-contact-who { display: flex; flex-direction: column; gap: 2px; flex: 1 1 220px; min-width: 180px; }
    .vid-contact-who strong { font-family: var(--sans); font-size: 13.5px; color: var(--ink); font-weight: 700; }
    .vid-contact-who span { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.55); }
    .vid-contact-why {
      font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em;
      text-transform: uppercase; color: var(--english-violet);
      background: rgba(var(--violet-rgb), 0.09); border-radius: 999px; padding: 3px 9px;
    }
    .vid-contact-row .admin-btn { margin-left: auto; }
    .vid-contact-block .vid-gate-h { color: rgba(28, 29, 34, 0.55); }

    .vid-cand-form { display: flex; flex-wrap: wrap; gap: 10px; align-items: flex-end; margin-top: 14px; }
    .vid-cand-form .vid-field { flex: 1; min-width: 160px; }
    .vid-cand-form .vid-field input { width: 100%; }
    /* ---- Client correspondence + documents ---- */
    .vid-cand-thread { margin-top: 26px; border-top: 1px solid rgba(28,29,34,0.1); padding-top: 20px; text-align: left; }
    .vid-cand-thread h4 { font-family: var(--sans); font-size: 11px; letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.55); margin: 0 0 12px; }
    .vid-msg-sec { margin-top: 24px; padding-top: 22px; border-top: 1px solid rgba(var(--violet-rgb), 0.14); }
    .vid-thread { display: flex; flex-direction: column; gap: 10px; margin-bottom: 14px; }
    .vid-msg { border: 1px solid rgba(28,29,34,0.1); border-left: 3px solid var(--english-violet); border-radius: 8px; padding: 10px 12px; background: #fff; }
    .vid-msg.is-auto { border-left-color: rgba(28,29,34,0.3); }
    .vid-msg-meta { display: flex; justify-content: space-between; gap: 12px; font-size: 11px; color: rgba(28,29,34,0.5); margin-bottom: 4px; }
    .vid-msg-meta strong { color: rgba(28,29,34,0.7); }
    .vid-msg-subj { font-size: 13.5px; font-weight: 700; color: var(--ink); margin-bottom: 2px; }
    .vid-msg-body { font-size: 13px; line-height: 1.5; color: rgba(28,29,34,0.78); }
    .vid-compose { display: flex; flex-direction: column; gap: 8px; max-width: 520px; }
    .vid-compose input[type="text"], .vid-compose textarea { width: 100%; font-family: var(--sans); font-size: 14px; padding: 9px 11px; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; background: #fff; }
    .vid-compose-notify { font-size: 12.5px; color: rgba(28,29,34,0.6); display: flex; align-items: center; gap: 7px; }
    .vid-compose-file { font-size: 12.5px; color: rgba(28,29,34,0.6); display: flex; flex-direction: column; gap: 5px; }
    .vid-compose-file span { font-weight: 700; letter-spacing: 0.02em; }
    .vid-compose-file input[type="file"] { font-family: var(--sans); font-size: 12.5px; }
    .vid-compose .admin-btn { align-self: flex-start; }
    .vid-docs { display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; }
    .vid-doc { display: flex; align-items: center; gap: 10px; border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; padding: 8px 11px; background: #fff; }
    .vid-doc-name { font-size: 13.5px; color: var(--ink); flex: 1; }
    .vid-doc-cat { font-size: 11px; color: rgba(28,29,34,0.5); }
    .vid-doc-x { appearance: none; border: 0; background: none; font-size: 18px; color: rgba(28,29,34,0.4); cursor: pointer; line-height: 1; }
    .vid-doc-x:hover { color: #8a3b2f; }
    .vid-doc-upload { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }
    .vid-doc-upload select { font-family: var(--sans); font-size: 13px; padding: 8px 10px; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; background: #fff; }
    /* Push the primary "Attach document" button to the end of the row. */
    .vid-doc-upload .admin-btn { margin-left: auto; }
    /* Native file inputs styled to match the outline (ghost) admin button. */
    .vid-file { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.6); }
    .vid-file::file-selector-button { font-family: var(--sans); font-size: 11px; letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700; padding: 10px 16px; margin-right: 12px; border-radius: 2px; border: 1px solid rgba(var(--violet-rgb), 0.4); background: transparent; color: var(--english-violet); cursor: pointer; transition: background 0.2s, border-color 0.2s; }
    .vid-file::file-selector-button:hover { background: rgba(var(--violet-rgb), 0.06); }
    .vid-thread-status { font-size: 12.5px; margin-top: 10px; }

    /* ---- Settings ---- */
    /* The rate card. Scrolls horizontally on its own rather than pushing the
       page sideways — there are seven columns and one of them is long prose. */
    .vid-rate-wrap { overflow-x: auto; border: 1px solid rgba(var(--violet-rgb), 0.14); border-radius: 10px; background: #fff; }
    .vid-rate { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: 13px; min-width: 900px; }
    .vid-rate th {
      text-align: left; font-size: 10px; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: rgba(28,29,34,0.45);
      padding: 12px 14px; border-bottom: 1px solid rgba(var(--violet-rgb), 0.16); white-space: nowrap;
    }
    .vid-rate td { padding: 11px 14px; border-bottom: 1px solid rgba(28,29,34,0.06); vertical-align: top; }
    .vid-rate tr.is-group td { border-top: 1px solid rgba(var(--violet-rgb), 0.16); }
    .vid-rate tr:last-child td { border-bottom: 0; }
    .vid-rate th span { display: block; font-weight: 400; letter-spacing: 0.06em; text-transform: none; color: rgba(28,29,34,0.38); font-size: 9.5px; margin-top: 2px; }
    /* Service and Package get room now that Travel is a footnote instead of a
       column of near-identical text. */
    .vid-rate-svc { width: 190px; min-width: 190px; vertical-align: top; background: rgba(var(--violet-rgb), 0.03); }
    .vid-rate-pkg { width: 210px; min-width: 210px; }
    .vid-rate tr.is-group td { border-top: 1px solid rgba(var(--violet-rgb), 0.22); }
    .vid-rate-tag {
      display: inline-block; margin-right: 7px; padding: 2px 7px; border-radius: 4px;
      font-size: 9.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase;
      background: rgba(var(--violet-rgb), 0.1); color: var(--english-violet); vertical-align: 1px;
    }
    .vid-rate-foot { font-family: var(--sans); font-size: 12.5px; line-height: 1.6; color: rgba(28,29,34,0.6); max-width: 820px; margin: 12px 0 0; }
    .vid-rate-price { white-space: nowrap; font-weight: 700; color: var(--english-violet); }
    .vid-rate-na { font-weight: 400; color: rgba(28,29,34,0.35); font-style: italic; }
    .vid-rate-note { display: block; margin-top: 5px; font-size: 11px; line-height: 1.45; font-weight: 400; color: rgba(28,29,34,0.5); }
    .vid-rate-caption { font-family: var(--sans); font-size: 12.5px; line-height: 1.6; color: rgba(28,29,34,0.6); max-width: 760px; margin: 0 0 14px; }
    .vid-rate-inc { min-width: 320px; color: rgba(28,29,34,0.72); line-height: 1.5; }
    .vid-settings { max-width: 640px; display: flex; flex-direction: column; gap: 16px; }
    .vid-settings .vid-field input { width: 100%; }
    .vid-set-status { font-family: var(--sans); font-size: 13px; color: #2c7a4b; margin-left: 12px; }

    /* ---- Pipeline board — stage columns (mirrors the SMM board) ---- */
    /* Synced scrollbar ABOVE the board (like SMM) so you don't have to reach the
       bottom of a laptop screen to pan across the stages. */
    .vid-scrolltop { margin: 14px 0 6px; overflow-x: auto; overflow-y: hidden; }
    .vid-scrolltop[hidden] { display: none; }
    #vid-scrolltop-inner { height: 1px; }
    /* macOS hides overlay scrollbars until you scroll, so on a trackpad Mac the
       board looked like it had no more columns. Forced visible. */
    /* `hidden` sets display:none in the UA sheet, which ANY author class beats -
       so .vid-board's display:grid quietly kept the board visible behind the
       calendar. Needed on every element that both carries a display and gets
       hidden. */
    .vid-board[hidden], .vid-cal[hidden], .vid-chips[hidden] { display: none !important; }
    /* Rows, not columns: one row per stage, cards run left-to-right within a
       row and that row scrolls on its own once it's past ~3 cards — never a
       board-wide horizontal scroll across every stage. */
    .vid-board { display: flex; flex-direction: column; gap: 22px; padding: 6px 0 60px; }
    .vid-row-cards {
      display: flex; gap: 12px; align-items: stretch; overflow-x: auto; padding: 2px 2px 10px;
      scrollbar-width: thin; scrollbar-color: rgba(28,29,34,0.28) transparent;
    }
    .vid-row-cards::-webkit-scrollbar { height: 8px; -webkit-appearance: none; }
    .vid-row-cards::-webkit-scrollbar-track { background: rgba(28,29,34,0.05); border-radius: 999px; }
    .vid-row-cards::-webkit-scrollbar-thumb { background: rgba(28,29,34,0.28); border-radius: 999px; border: 2px solid transparent; background-clip: padding-box; }
    .vid-row-cards::-webkit-scrollbar-thumb:hover { background: rgba(28,29,34,0.42); background-clip: padding-box; }
    /* Card width targets ~3 comfortable columns before a row needs to scroll
       (three 300px cards + two 12px gaps ≈ 924px, well inside a laptop's
       content width; narrower viewports just see fewer per row). */
    .vid-row-cards .vid-card { flex: 0 0 300px; }

    /* Stage filter pills, matching the social media page. */
    .vid-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 18px; }
    .vid-chip {
      height: 32px; box-sizing: border-box; display: inline-flex; align-items: center; padding: 0 14px;
      background: #fff; border: 1px solid var(--border, rgba(28,29,34,0.14)); border-radius: 999px;
      font-family: var(--sans); font-size: 12px; font-weight: 600; color: rgba(28,29,34,0.7);
      cursor: pointer; transition: background .15s, border-color .15s, color .15s;
    }
    .vid-chip:hover { border-color: rgba(var(--violet-rgb),0.4); }
    .vid-chip.is-active { background: var(--english-violet); border-color: var(--english-violet); color: #fff; }

    /* Calendar view of the diary. */
    .vid-cal-head { display: flex; align-items: center; gap: 12px; margin-bottom: 14px; }
    .vid-cal-month { font-family: var(--serif); font-size: 20px; color: var(--ink); }
    .vid-cal-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; }
    .vid-cal-dow { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.45); padding: 0 2px 4px; }
    .vid-cal-day {
      min-height: 92px; background: #fff; border: 1px solid var(--border, rgba(28,29,34,0.1));
      border-radius: 5px; padding: 7px 8px; display: flex; flex-direction: column; gap: 5px;
    }
    .vid-cal-day.is-out { background: transparent; border-style: dashed; opacity: 0.5; }
    .vid-cal-day.is-today { border-color: var(--english-violet); box-shadow: 0 0 0 1px var(--english-violet); }
    .vid-cal-num { font-family: var(--sans); font-size: 11.5px; font-weight: 700; color: rgba(28,29,34,0.5); }
    .vid-cal-ev {
      font-family: var(--sans); font-size: 11px; line-height: 1.35; text-align: left;
      background: rgba(var(--violet-rgb), 0.09); color: var(--english-violet);
      border: 0; border-radius: 3px; padding: 4px 6px; cursor: pointer; width: 100%;
    }
    .vid-cal-ev:hover { background: rgba(var(--violet-rgb), 0.18); }
    .vid-cal-ev strong { display: block; font-weight: 700; }
    .vid-col { background: transparent; border-left: 0; border-right: 0; border-bottom: 0; min-width: 0; display: flex; flex-direction: column; }
    .vid-col-head {
      display: flex; align-items: baseline; gap: 8px; padding: 10px 4px 12px; border: 0;
      font-family: var(--sans); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; color: var(--english-violet);
    }
    /* Just the number. The pill was heavier than the label it sat beside, and
       it was what forced the heading up against the top of the column. */
    .vid-col-count { font-size: 11.5px; font-weight: 700; color: rgba(28,29,34,0.38); }
    .vid-col-list { display: flex; flex-direction: column; gap: 10px; min-height: 120px; padding: 4px; border-radius: 12px; transition: background 0.15s, box-shadow 0.15s; }
    .vid-col.is-drop .vid-col-list { background: rgba(var(--violet-rgb), 0.07); box-shadow: inset 0 0 0 2px rgba(var(--violet-rgb), 0.35); }
    /* One row per stage, a wine hairline between rows (skip before the first). */
    .vid-row { min-width: 0; padding-top: 18px; border-top: 1px solid var(--accent-light, #c9bcb7); }
    .vid-row:first-child { padding-top: 0; border-top: 0; }
    .vid-row.is-drop .vid-row-cards { background: rgba(var(--violet-rgb), 0.07); box-shadow: inset 0 0 0 2px rgba(var(--violet-rgb), 0.35); border-radius: 12px; }
    .vid-row-cards:empty::after { content: "Drop a job here"; display: block; font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.3); padding: 14px 6px; flex: none; }
    .vid-col-list:empty::after { content: "Drop a job here"; display: block; font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.3); padding: 14px 6px; }
    .vid-card {
      background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 10px;
      padding: 15px 16px; cursor: pointer; box-shadow: 0 1px 2px rgba(20, 18, 26, 0.04);
      transition: box-shadow 0.16s, transform 0.16s, border-color 0.16s;
    }
    .vid-card:hover { border-color: rgba(var(--violet-rgb), 0.45); box-shadow: 0 10px 24px -18px rgba(28, 29, 34, 0.4); transform: translateY(-1px); }
    .vid-card.is-dragging { opacity: 0.5; }
    .vid-card-name { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); }
    .vid-card-meta { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.6); margin-top: 3px; }
    .vid-card-foot {
      display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-top: 10px;
      font-family: var(--sans); font-size: 11px; color: rgba(28, 29, 34, 0.55);
    }
    .vid-card-brand {
      font-size: 9px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700;
      padding: 2px 7px; border-radius: 999px; background: rgba(var(--violet-rgb), 0.1); color: var(--english-violet);
    }
    .vid-card-amount { font-family: var(--serif); font-size: 15px; font-weight: 500; color: var(--ink); }

    /* ---- Bookings table (reuses enquiry-table look) ---- */
    .enquiry-table {
      display: grid; gap: 1px; background: rgba(var(--violet-rgb), 0.18);
      border: 1px solid rgba(var(--violet-rgb), 0.18); border-radius: 2px; overflow: hidden;
    }
    .vid-brow {
      display: grid; grid-template-columns: 1.4fr 1.2fr 1fr 1fr 110px 24px;
      gap: 16px; padding: 16px 20px; background: var(--paper);
      align-items: center; cursor: pointer; transition: background 0.15s;
    }
    .vid-brow.is-header {
      cursor: default; background: rgba(var(--violet-rgb), 0.04); font-family: var(--sans);
      font-size: 10px; letter-spacing: 0.22em; text-transform: uppercase;
      font-weight: 700; color: rgba(28, 29, 34, 0.55);
    }
    .vid-brow:not(.is-header):hover { background: rgba(var(--violet-rgb), 0.04); }
    .vid-bname { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); }
    .vid-bmeta { font-family: var(--sans); font-size: 12px; color: rgba(28, 29, 34, 0.55); margin-top: 2px; }

    /* ---- Diary (per-day hour blocks) ---- */
    .vid-diary { display: flex; flex-direction: column; gap: 8px; max-width: 760px; }
    .vid-day { background: var(--paper); border: 1px solid rgba(var(--violet-rgb), 0.18); border-radius: 4px; overflow: hidden; }
    .vid-day-head {
      display: flex; align-items: center; gap: 14px; width: 100%; text-align: left;
      padding: 14px 18px; background: transparent; border: none; cursor: pointer;
      font-family: var(--sans);
    }
    .vid-day-head:hover { background: rgba(var(--violet-rgb),0.04); }
    .vid-day-name { font-size: 14px; font-weight: 700; color: var(--ink); min-width: 110px; }
    .vid-day-summary { font-size: 13px; color: rgba(28,29,34,0.6); flex: 1; }
    .vid-day-summary.is-off { color: rgba(28,29,34,0.4); }
    .vid-day-chev { font-family: var(--serif); color: var(--english-violet); transition: transform 0.2s; }
    .vid-day.is-open .vid-day-chev { transform: rotate(90deg); }
    .vid-day-hours { display: none; flex-wrap: wrap; gap: 6px; padding: 4px 18px 18px; }
    .vid-day.is-open .vid-day-hours { display: flex; }
    .vid-hour {
      padding: 7px 0; width: 64px; text-align: center; border: 1px solid rgba(var(--violet-rgb),0.25);
      border-radius: 999px; background: transparent; font-family: var(--sans); font-size: 12px;
      color: rgba(28,29,34,0.65); cursor: pointer; transition: background 0.15s, color 0.15s, border-color 0.15s;
    }
    .vid-hour:hover { border-color: var(--english-violet); }
    .vid-hour.is-on { background: var(--english-violet); color: var(--paper); border-color: var(--english-violet); }
    .vid-diary-save { margin-top: 14px; }

    /* ---- Deliver ---- */
    .vid-deliver-pick { max-width: 440px; margin-bottom: 20px; }
    /* ---- Category drop-boxes ---- */
    .vid-catgrid-intro { font-family: var(--sans); font-size: 13px; line-height: 1.55; color: rgba(28,29,34,0.6); max-width: 640px; margin: 0 0 16px; }
    .vid-catgrid-intro em { font-style: normal; font-weight: 700; color: var(--english-violet); }
    /* Rebuilt in the Hub's language: hairline borders rather than dashes, 5px
       corners, small-caps headings, and room to breathe. The dashed outline and
       18px serif headings were shouting at each other on a screen that is
       mostly boxes. */
    .vid-catgrid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 16px;
    }
    .vid-catbox {
      display: flex; flex-direction: column; gap: 14px;
      border: 1px solid var(--border, #eae5e1); border-radius: var(--radius, 5px);
      padding: 18px;
      background: var(--surface, #fff);
      box-shadow: var(--shadow-xs, 0 1px 2px rgba(43,34,38,.05));
      transition: border-color 0.18s, background 0.18s, box-shadow 0.18s;
    }
    .vid-catbox.is-drag {
      border-color: var(--primary, #371e28);
      background: var(--primary-light, #f3eeef);
      box-shadow: var(--shadow-sm, 0 1px 4px rgba(43,34,38,.06));
    }
    .vid-catgrid.is-disabled { opacity: 0.5; pointer-events: none; }
    .vid-catbox-top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    /* Normal size, bold - the Hub's card-title treatment. */
    .vid-catbox-name {
      font-family: var(--sans); font-size: 13px; font-weight: 700;
      letter-spacing: 0.01em; color: var(--hub-text, var(--ink)); line-height: 1.35;
    }
    .vid-catbox-count {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      min-width: 20px; text-align: center; padding: 2px 7px; border-radius: var(--radius-sm, 3px);
      background: var(--primary-light, #f3eeef); color: var(--primary, #371e28);
    }
    .vid-catbox-drop {
      display: flex; align-items: center; justify-content: center; gap: 8px;
      padding: 18px 0; color: var(--muted, rgba(28,29,34,0.45));
      font-family: var(--sans); font-size: 12px;
      border: 1px solid var(--border-subtle, #f0edeb); border-radius: 4px;
      background: var(--surface-2, #faf8f7);
    }
    .vid-catbox-pick {
      appearance: none; cursor: pointer;
      font-family: var(--sans); font-size: 11.5px; font-weight: 700;
      letter-spacing: 0.04em; text-transform: uppercase;
      color: var(--muted, rgba(28,29,34,0.55));
      background: none; border: 1px solid var(--border, #eae5e1);
      border-radius: 4px; padding: 8px 12px; transition: all 0.18s;
    }
    .vid-catbox-pick:hover {
      border-color: var(--primary, #371e28); color: var(--primary, #371e28);
      background: var(--primary-light, #f3eeef);
    }

    .vid-uploads { display: flex; flex-direction: column; gap: 10px; margin-top: 28px; }
    .vid-up {
      border: 1px solid rgba(var(--violet-rgb), 0.18); border-radius: 4px;
      padding: 14px 16px; background: var(--paper);
    }
    .vid-up-top { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
    .vid-up-name { font-family: var(--sans); font-size: 14px; font-weight: 700; color: var(--ink); word-break: break-all; }
    .vid-up-stat { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.6); white-space: nowrap; }
    .vid-up-stat.is-done { color: #2c7a4b; }
    .vid-up-stat.is-error { color: #a05a3c; }
    .vid-up-bar { height: 6px; border-radius: 999px; background: rgba(var(--violet-rgb),0.12); margin-top: 10px; overflow: hidden; }
    .vid-up-fill { height: 100%; width: 0; background: var(--english-violet); border-radius: 999px; transition: width 0.2s ease; }
    .vid-up-fill.is-done { background: #2c7a4b; }
    .vid-up-fill.is-error { background: #a05a3c; }

    /* A clear break between dropping files and the list of what has landed -
       they are two different jobs and were running into each other. */
    .vid-files { margin-top: 44px; padding-top: 32px; border-top: 1px solid var(--border, #eae5e1); }
    .vid-files-head { font-family: var(--sans); font-weight: 700; font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--muted, rgba(28,29,34,0.6)); margin: 0 0 16px; }
    .vid-files-list { display: flex; flex-direction: column; gap: 1px; background: rgba(var(--violet-rgb),0.18); border: 1px solid rgba(var(--violet-rgb),0.18); border-radius: 3px; overflow: hidden; }
    .vid-fgroup {
      display: flex; align-items: center; gap: 8px;
      padding: 10px 16px; background: rgba(var(--violet-rgb), 0.07);
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.12em; text-transform: uppercase; color: var(--english-violet);
    }
    .vid-fgroup-count { color: rgba(28,29,34,0.45); font-weight: 600; letter-spacing: 0.04em; }
    .vid-frow { display: grid; grid-template-columns: 1fr 130px 80px 100px 70px; gap: 14px; align-items: center; padding: 12px 16px; background: var(--paper); font-family: var(--sans); font-size: 13px; }
    .vid-frow-name { color: var(--ink); font-weight: 600; word-break: break-all; }
    .vid-frow-meta { color: rgba(28,29,34,0.55); font-size: 12px; }
    .vid-frow-cat select {
      width: 100%; font-family: var(--sans); font-size: 12px;
      padding: 6px 8px; border: 1px solid rgba(var(--violet-rgb),0.22); border-radius: 6px;
      background: #fff; color: var(--ink); cursor: pointer;
    }
    .vid-frow-cat select:focus { outline: none; border-color: var(--english-violet); }
    .vid-frow-act { text-align: right; }
    .vid-frow-link { color: var(--english-violet); font-weight: 700; cursor: pointer; background: none; border: none; font-family: var(--sans); font-size: 12px; }
    .vid-frow-del { color: #a05a3c; cursor: pointer; background: none; border: none; font-family: var(--sans); font-size: 12px; font-weight: 700; }
    .vid-delivery { margin-top: 36px; border-top: 1px solid rgba(var(--violet-rgb),0.18); padding-top: 28px; max-width: 640px; }
    .vid-delivery-head { display: flex; align-items: center; gap: 14px; margin-bottom: 10px; }
    .vid-dlv-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .vid-dlv-extras { margin-top: 18px; }
    .vid-field-label { display: block; font-family: var(--sans); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.6); margin-bottom: 8px; }
    .vid-dlv-extra { display: grid; grid-template-columns: 1fr 130px 34px; gap: 8px; margin-bottom: 8px; }
    .vid-dlv-extra input { padding: 8px 10px; border: 1px solid rgba(var(--violet-rgb),0.3); border-radius: 2px; font-family: var(--sans); font-size: 14px; color: var(--ink); background: var(--paper); }
    .vid-dlv-extra input:focus { outline: none; border-color: var(--english-violet); }
    .vid-dlv-extra-del { border: none; background: none; color: #a05a3c; cursor: pointer; font-size: 20px; line-height: 1; }
    .vid-dlv-total { margin-top: 20px; font-family: var(--sans); font-size: 12px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; color: rgba(28,29,34,0.6); }
    .vid-dlv-total strong { font-family: var(--serif); font-size: 26px; font-weight: 500; color: var(--ink); margin-left: 10px; }
    .vid-dlv-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 20px; }
    .vid-dlv-link { margin-top: 14px; font-family: var(--sans); font-size: 13px; color: var(--english-violet); word-break: break-all; }
    @media (max-width: 720px) { .vid-dlv-grid { grid-template-columns: 1fr; } .vid-dlv-extra { grid-template-columns: 1fr 100px 30px; } }
    .vid-conn-meta { font-family: var(--sans); font-size: 12px; color: rgba(28,29,34,0.55); margin: 0; }
    .vid-conn-meta code, .vid-conn-note code { background: rgba(var(--violet-rgb),0.1); padding: 1px 5px; border-radius: 3px; font-size: 11px; }
    @media (max-width: 720px) { .vid-frow { grid-template-columns: 1fr auto; } .vid-frow-meta { display: none; } }

    /* ---- Connections ---- */
    .vid-conn-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
    .vid-conn-card {
      padding: 22px 24px; border: 1px solid rgba(var(--violet-rgb), 0.2);
      border-radius: 4px; background: var(--paper);
    }
    .vid-conn-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 10px; }
    .vid-conn-card h3 { font-family: var(--serif); font-size: 20px; font-weight: 500; color: var(--ink); margin: 0; }
    .vid-conn-card p { font-family: var(--sans); font-size: 13px; line-height: 1.55; color: rgba(28, 29, 34, 0.6); margin: 0 0 16px; }
    .vid-conn-note {
      padding: 14px 18px; border-left: 3px solid var(--english-violet);
      background: rgba(var(--violet-rgb), 0.05); border-radius: 2px; margin-bottom: 20px;
      font-family: var(--sans); font-size: 13px; line-height: 1.55; color: rgba(28, 29, 34, 0.75);
    }
    .vid-conn-note.is-pending { border-left-color: #b78a2e; background: rgba(183, 138, 46, 0.08); }
    .vid-conn-note strong { color: var(--ink); }

    .enquiry-status-pill {
      display: inline-flex; align-items: center; gap: 6px; padding: 4px 10px;
      border-radius: 999px; font-family: var(--sans); font-size: 10px;
      letter-spacing: 0.2em; text-transform: uppercase; font-weight: 700;
    }
    .enquiry-status-pill::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
    .enquiry-status-pill.is-pending { color: #b78a2e; background: rgba(183, 138, 46, 0.12); }
    .enquiry-status-pill.is-paid { color: #2c7a4b; background: rgba(44, 122, 75, 0.1); }

    /* ---- Modal ---- */
    .modal-backdrop {
      position: fixed; inset: 0; z-index: 200; background: rgba(20, 18, 26, 0.55);
      display: flex; align-items: center; justify-content: center; padding: 24px;
    }
    .modal-backdrop[hidden] { display: none; }
    .modal.vid-modal {
      background: var(--paper); max-width: 640px; width: 100%; max-height: 88vh;
      display: flex; flex-direction: column; border-radius: 4px; overflow: hidden;
      box-shadow: 0 30px 80px rgba(20, 18, 26, 0.35);
    }
    .modal-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 20px 28px; border-bottom: 1px solid rgba(var(--violet-rgb), 0.12);
    }
    .modal-head h2 { font-family: var(--serif); font-size: 22px; font-weight: 500; margin: 0; color: var(--ink); }
    .modal-close { background: transparent; border: none; font-size: 28px; line-height: 1; color: var(--english-violet); cursor: pointer; padding: 0 4px; }
    .vid-form { padding: 24px 28px; overflow-y: auto; flex: 1; display: flex; flex-direction: column; gap: 14px; }
    .vid-field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .vid-field { display: flex; flex-direction: column; gap: 5px; }
    /* .vid-field sets its own `display`, which otherwise wins over the
       browser's default [hidden] rule at equal specificity - so a hidden
       .vid-field would still render. Toggling a field's own visibility (the
       TEG "other" box, and anything else that does this later) needs this. */
    .vid-field[hidden] { display: none; }
    /* Two stacked .vid-field-row blocks (e.g. the TEG brand/reason panel)
       otherwise sit flush against each other - .vid-form's own gap only
       reaches its direct children, not rows nested a level down inside a
       block like #vid-teg-block. */
    #vid-teg-block { display: flex; flex-direction: column; gap: 14px; }
    .vid-field label {
      font-family: var(--sans); font-size: 11px; letter-spacing: 0.14em;
      text-transform: uppercase; font-weight: 700; color: rgba(28, 29, 34, 0.6);
    }
    .vid-field input, .vid-field select, .vid-field textarea {
      padding: 9px 12px; border: 1px solid rgba(var(--violet-rgb), 0.3); border-radius: 2px;
      font-family: var(--sans); font-size: 14px; color: var(--ink); background: var(--paper);
      resize: vertical;
    }
    .vid-field input:focus, .vid-field select:focus, .vid-field textarea:focus { outline: none; border-color: var(--english-violet); }
    .modal-foot {
      display: flex; gap: 8px; align-items: center; padding: 16px 28px;
      border-top: 1px solid rgba(var(--violet-rgb), 0.12); flex-wrap: wrap;
    }
    .modal-foot .spacer { flex: 1; }
    .admin-btn {
      display: inline-flex; align-items: center; gap: 8px; padding: 10px 16px;
      border-radius: 2px; font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700;
      cursor: pointer; border: 1px solid transparent;
      transition: background 0.2s, color 0.2s, border-color 0.2s; text-decoration: none;
    }
    /* Same issue as .vid-field: .admin-btn's own `display` otherwise wins over
       the browser's default [hidden] rule at equal specificity, so a button
       toggled hidden (e.g. #vid-arch-open before a real archive link exists)
       stayed visible with a stale href="#" - which is what "Open in
       Cloudflare" was actually doing when it looked broken. */
    .admin-btn[hidden] { display: none; }
    .admin-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    .admin-btn-primary { background: var(--english-violet); color: var(--paper); }
    .admin-btn-primary:hover { background: var(--ink); color: var(--paper); }
    .admin-btn-ghost { background: transparent; border-color: rgba(var(--violet-rgb), 0.4); color: var(--english-violet); }
    .admin-btn-ghost:hover { background: rgba(var(--violet-rgb), 0.06); }
    .admin-btn-danger { background: transparent; border-color: #a05a3c; color: #a05a3c; }
    .admin-btn-danger:hover { background: #a05a3c; color: var(--paper); }

    @media (max-width: 980px) {
      .vid-conn-grid { grid-template-columns: 1fr; }
      .vid-deliver-steps { grid-template-columns: 1fr; }
      .vid-day { grid-template-columns: 1fr 1fr; }
      .vid-brow { grid-template-columns: 1fr; gap: 6px; }
      .vid-brow.is-header { display: none; }
    }
  </style>

  <script>
    import { requireAdmin } from "../../lib/admin-gate.js";
    import { renderInvoiceHtml } from "../../lib/invoice-render.js";
    import { supabase, gbpFromPence } from "../../lib/supabase.js";
    import { bookingLocation, SERVICES, SURCHARGE_DEFAULTS, VAT_RATE, RATE_CARD, FC_OFFICES, TEG_BRANDS, TEG_REASONS, SMM_REASON, reasonsForRoute, isPackageCovered, TEG_ACCOUNTS_EMAIL, tegBrandLabel, tegBrandAddress, tegReasonLabel, STUDIO_LOCATION, archiveFoldersFor } from "../../lib/videography-config.js";

    // Deployed Cloudflare Worker URL (worker/). Set PUBLIC_R2_WORKER_URL in env.
    const WORKER_URL = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
    const PART_SIZE = 50 * 1024 * 1024; // 50 MB parts

    /* Invoicing happens two days BEFORE the shoot, so `invoiced` sits early.
       Payment is not a stage - it arrives at different points depending on the
       route - so it stays a flag on the booking. See
       supabase/videography_stages_v2.sql. */
    const STAGES = [
      { key: "booked",        label: "Booked" },
      { key: "invoiced",      label: "Invoiced" },
      { key: "shoot_day",     label: "Shoot day" },
      { key: "editing",       label: "Editing" },
      { key: "gallery_ready", label: "Gallery ready" },
      { key: "sent",          label: "Sent" },
      { key: "delivered",     label: "Delivered" },
    ];
    const DAYS = [
      { d: 1, name: "Monday" }, { d: 2, name: "Tuesday" }, { d: 3, name: "Wednesday" },
      { d: 4, name: "Thursday" }, { d: 5, name: "Friday" }, { d: 6, name: "Saturday" },
      { d: 0, name: "Sunday" },
    ];

    function escapeHtml(s) {
      return String(s ?? "")
        .replace(/&/g, "&amp;").replace(/</g, "&lt;")
        .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }
    function fmtWhen(iso) {
      if (!iso) return "—";
      const d = new Date(iso);
      return d.toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" });
    }
    const BRAND_LABEL = {
      "property-experts": "Property Experts",
      "fine-and-country": "Fine & Country",
      "other": "Direct",
    };

    let bookings = [];
    let vidSettings = { base_postcode: "NN14 1AA", free_radius_miles: 40, surcharge_pence_per_mile: 55, vat_rate: 0.20 };
    let baseCoords = null;

    /* ---------- Panel switching + settings cog ---------- */
    function showPanel(name) {
      document.querySelectorAll(".vid-panel").forEach((p) => {
        p.classList.toggle("is-active", p.getAttribute("data-panel") === name);
      });
      try { window.scrollTo({ top: 0, behavior: "instant" }); } catch (_) { window.scrollTo(0, 0); }
    }
    function initNav() {
      const cog = document.getElementById("vid-cog");
      const menu = document.getElementById("vid-cog-menu");
      // Anchor the fixed menu under the button, right-aligned to it, and cap
      // its height to the viewport so it always fits and scrolls inside itself.
      function positionCogMenu() {
        const r = cog.getBoundingClientRect();
        const vh = window.innerHeight || document.documentElement.clientHeight || 800;
        const vw = window.innerWidth || document.documentElement.clientWidth || 1280;
        // Right-aligned to the button, but never off the left or right edge —
        // the bar wraps on narrow screens and the button can end up far left.
        const w = menu.offsetWidth || 240;
        menu.style.left = Math.round(Math.min(Math.max(8, r.right - w), vw - w - 8)) + "px";
        menu.style.top = Math.round(r.bottom + 8) + "px";
        menu.style.maxHeight = Math.min(420, Math.max(180, vh - r.bottom - 24)) + "px";
      }
      cog?.addEventListener("click", (e) => {
        e.stopPropagation();
        const willOpen = menu.hidden;
        menu.hidden = !willOpen;
        if (willOpen) positionCogMenu();
        cog.setAttribute("aria-expanded", String(willOpen));
      });
      document.addEventListener("click", () => {
        if (menu && !menu.hidden) { menu.hidden = true; cog?.setAttribute("aria-expanded", "false"); }
      });
      const repositionCog = () => { if (menu && !menu.hidden) positionCogMenu(); };
      window.addEventListener("resize", repositionCog);
      document.querySelector(".ash-content")?.addEventListener("scroll", repositionCog, { passive: true });
      menu?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-go]");
        if (!btn) return;
        e.stopPropagation();
        menu.hidden = true;
        const go = btn.getAttribute("data-go");
        showPanel(go);
        if (go === "deliver") populateDeliverBookings();
        if (go === "clients") renderClients(document.getElementById("vid-client-search")?.value || "");
      });
      document.querySelectorAll("[data-backto]").forEach((btn) =>
        btn.addEventListener("click", () => {
          // If you opened this from a client's file, go back to that file -
          // "all clients" is only the right answer when that is where you came
          // from.
          if (btn.hasAttribute("data-smart-back") && panelFrom.candId) {
            candId = panelFrom.candId;
            panelFrom.candId = null;
            showPanel("candidate");
            renderCandidate();
            return;
          }
          showPanel(btn.getAttribute("data-backto"));
        }));
      document.getElementById("vid-cand-back")?.addEventListener("click", () => {
        showPanel("clients");
        renderClients(document.getElementById("vid-client-search")?.value || "");
      });
      document.getElementById("vid-client-search")?.addEventListener("input", (e) => renderClients(e.target.value || ""));
      // Keep the top scrollbar and the board panning in step.
      const vst = document.getElementById("vid-scrolltop");
      const vbd = document.getElementById("vid-clients");
      if (vst && vbd) {
        let lock = false;
        vst.addEventListener("scroll", () => { if (lock) return; lock = true; vbd.scrollLeft = vst.scrollLeft; lock = false; });
        vbd.addEventListener("scroll", () => { if (lock) return; lock = true; vst.scrollLeft = vbd.scrollLeft; lock = false; });
      }
      window.addEventListener("resize", syncVidTopScroll);
    }

    /* ---------- Pipeline (kanban) ---------- */
    function renderBoard() {
      const board = document.getElementById("vid-board");
      const loading = document.getElementById("vid-board-loading");
      if (!board) return;
      if (loading) loading.hidden = true;
      board.hidden = false;

      board.innerHTML = STAGES.map((s) => {
        const cards = bookings
          .filter((b) => b.stage === s.key)
          .sort((a, b) => (a.sort_order || 0) - (b.sort_order || 0));
        return `
          <div class="vid-col" data-stage="${s.key}">
            <div class="vid-col-head">
              <span>${s.label}</span>
              <span class="vid-col-count">${cards.length}</span>
            </div>
            <div class="vid-col-list" data-stage="${s.key}">
              ${cards.map(cardHtml).join("")}
            </div>
          </div>`;
      }).join("");

      board.querySelectorAll(".vid-card").forEach((el) => {
        el.addEventListener("dragstart", onDragStart);
        el.addEventListener("dragend", onDragEnd);
        el.addEventListener("click", () => openModal(el.getAttribute("data-id")));
      });
      board.querySelectorAll(".vid-col-list").forEach((col) => {
        col.addEventListener("dragover", onDragOver);
        col.addEventListener("dragleave", onDragLeave);
        col.addEventListener("drop", onDrop);
      });
    }

    function cardHtml(b) {
      const brand = b.brand ? `<span class="vid-card-brand">${escapeHtml(BRAND_LABEL[b.brand] || b.brand)}</span>` : "<span></span>";
      const amount = b.amount_pence != null ? `<span class="vid-card-amount">${gbpFromPence(b.amount_pence)}</span>` : "";
      return `
        <div class="vid-card" draggable="true" data-id="${b.id}">
          <div class="vid-card-name">${escapeHtml(b.client_name)}</div>
          <div class="vid-card-meta">${escapeHtml(b.service || b.client_company || "—")}</div>
          <div class="vid-card-meta">${b.shoot_date ? "📅 " + fmtWhen(b.shoot_date) : ""}</div>
          <div class="vid-card-foot">${brand}${amount}</div>
        </div>`;
    }

    let dragId = null;
    function onDragStart(e) { dragId = e.currentTarget.getAttribute("data-id"); e.currentTarget.classList.add("is-dragging"); e.dataTransfer.effectAllowed = "move"; }
    function onDragEnd(e) { e.currentTarget.classList.remove("is-dragging"); }
    function onDragOver(e) { e.preventDefault(); e.currentTarget.closest(".vid-col")?.classList.add("is-drop"); }
    function onDragLeave(e) { e.currentTarget.closest(".vid-col")?.classList.remove("is-drop"); }
    async function onDrop(e) {
      e.preventDefault();
      const col = e.currentTarget.closest(".vid-col");
      col?.classList.remove("is-drop");
      const newStage = e.currentTarget.getAttribute("data-stage");
      if (!dragId || !newStage) return;
      const b = bookings.find((x) => x.id === dragId);
      if (!b || b.stage === newStage) return;
      const prev = b.stage;
      b.stage = newStage;        // optimistic
      const refresh = () => renderClients(document.getElementById("vid-client-search")?.value || "");
      refresh();
      const { error } = await supabase.from("videography_bookings").update({ stage: newStage }).eq("id", dragId);
      if (error) { b.stage = prev; refresh(); alert("Couldn't move card: " + error.message); }
    }

    /* ---------- Bookings list ---------- */
    function renderBookings(filter = "") {
      const table = document.getElementById("vid-bookings-table");
      const empty = document.getElementById("vid-bookings-empty");
      if (!table) return;
      const q = filter.trim().toLowerCase();
      const rows = bookings.filter((b) =>
        !q || [b.client_name, b.client_company, b.brand, b.service, b.client_email]
          .filter(Boolean).some((v) => String(v).toLowerCase().includes(q)));
      if (!rows.length) { table.innerHTML = ""; if (empty) empty.hidden = false; return; }
      if (empty) empty.hidden = true;
      const stageLabel = (k) => (STAGES.find((s) => s.key === k) || {}).label || k;
      table.innerHTML =
        `<div class="vid-brow is-header"><div>Client</div><div>Service</div><div>Brand</div><div>Stage</div><div>Quote</div><div></div></div>` +
        rows.map((b) => `
          <div class="vid-brow" data-id="${b.id}">
            <div><div class="vid-bname">${escapeHtml(b.client_name)}</div><div class="vid-bmeta">${escapeHtml(b.client_company || b.client_email || "—")}</div></div>
            <div class="vid-bmeta">${escapeHtml(b.service || "—")}</div>
            <div class="vid-bmeta">${escapeHtml(BRAND_LABEL[b.brand] || b.brand || "—")}</div>
            <div class="vid-bmeta">${escapeHtml(stageLabel(b.stage))}</div>
            <div class="vid-bname">${b.amount_pence != null ? gbpFromPence(b.amount_pence) : "—"}</div>
            <div style="text-align:right;color:var(--english-violet)">&rarr;</div>
          </div>`).join("");
      table.querySelectorAll("[data-id]").forEach((el) =>
        el.addEventListener("click", () => openModal(el.getAttribute("data-id"))));
    }

    /* ---------- Stage filter + calendar view ---------- */
    let stageFilter = "all";
    let calMonth = null;   // first of the month being shown

    // Shared by the stage pills and any "See all" card (a column that's over
    // the per-column cap on the "All" view) — both just narrow to one stage.
    function goToStage(key) {
      stageFilter = key;
      document.querySelectorAll("#vid-chips .vid-chip").forEach((b) => b.classList.toggle("is-active", b.getAttribute("data-stagefilter") === key));
      renderClients(document.getElementById("vid-client-search")?.value || "");
    }

    function wireBoardViews() {
      document.getElementById("vid-chips")?.addEventListener("click", (e) => {
        const btn = e.target.closest("[data-stagefilter]");
        if (!btn) return;
        goToStage(btn.getAttribute("data-stagefilter"));
      });

      document.getElementById("vid-viewtoggle")?.addEventListener("click", () => {
        const cal = document.getElementById("vid-cal");
        const board = document.getElementById("vid-clients");
        const chips = document.getElementById("vid-chips");
        const showCal = cal.hidden;
        cal.hidden = !showCal;
        board.hidden = showCal;
        if (chips) chips.hidden = showCal;   // stage pills mean nothing on a calendar
        document.getElementById("vid-viewtoggle").textContent = showCal ? "Board view" : "Calendar view";
        if (showCal) { calMonth = calMonth || startOfMonth(new Date()); renderCalendar(); }
      });

      document.getElementById("vid-cal-prev")?.addEventListener("click", () => { calMonth.setMonth(calMonth.getMonth() - 1); renderCalendar(); });
      document.getElementById("vid-cal-next")?.addEventListener("click", () => { calMonth.setMonth(calMonth.getMonth() + 1); renderCalendar(); });

      // Deep link from the Dashboard's "Videography calendar" link (?view=calendar).
      if (new URLSearchParams(location.search).get("view") === "calendar") {
        document.getElementById("vid-viewtoggle")?.click();
      }
    }

    const startOfMonth = (d) => new Date(d.getFullYear(), d.getMonth(), 1);
    const sameDay = (a, b) => a.getFullYear() === b.getFullYear() && a.getMonth() === b.getMonth() && a.getDate() === b.getDate();

    function renderCalendar() {
      const grid = document.getElementById("vid-cal-grid");
      const label = document.getElementById("vid-cal-month");
      if (!grid || !calMonth) return;
      label.textContent = calMonth.toLocaleDateString("en-GB", { month: "long", year: "numeric" });

      // Monday-first, and always six rows so the grid doesn't jump height
      // between months.
      const first = startOfMonth(calMonth);
      const offset = (first.getDay() + 6) % 7;
      const start = new Date(first); start.setDate(first.getDate() - offset);
      const today = new Date();

      const dows = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
      let html = dows.map((d) => `<div class="vid-cal-dow">${d}</div>`).join("");

      for (let i = 0; i < 42; i++) {
        const day = new Date(start); day.setDate(start.getDate() + i);
        const out = day.getMonth() !== calMonth.getMonth();
        const events = bookings.filter((b) => b.shoot_date && sameDay(new Date(b.shoot_date), day) && b.stage !== "cancelled");
        html += `<div class="vid-cal-day${out ? " is-out" : ""}${sameDay(day, today) ? " is-today" : ""}">
          <span class="vid-cal-num">${day.getDate()}</span>
          ${events.map((b) => `<button type="button" class="vid-cal-ev" data-calopen="${escapeHtml(b.id)}">
            <strong>${escapeHtml(new Date(b.shoot_date).toLocaleTimeString("en-GB", { hour: "2-digit", minute: "2-digit" }))}</strong>
            ${escapeHtml(b.client_name || "Booking")}
          </button>`).join("")}
        </div>`;
      }
      grid.innerHTML = html;
      grid.querySelectorAll("[data-calopen]").forEach((btn) =>
        btn.addEventListener("click", () => openCandidate(btn.getAttribute("data-calopen"))));
    }

    /* ---------- Clients list + candidate file (CRM) ---------- */
    let adminEmail = null;   // who is signed in, for stamping confirmations
    const panelFrom = { candId: null };   // which client file a panel was opened from
    /* One line per stage: what the stage is called, and what you do next.
       There used to be a `big` here too - a headline restating the stage
       ("Editing" over "In editing") or the shoot date the meta row already
       carries. Both said the same thing twice, so the card now leads with the
       client and wears the stage as a badge. */
    const STAGE_FLOW = {
      booked:        { sub: "Booked in",     next: "Confirm the details, then raise the invoice two days before the shoot.", advance: { to: "invoiced",      label: "Raise invoice" } },
      invoiced:      { sub: "Invoiced",      next: "Invoice is out. This moves to Shoot day on its own when the day arrives.", advance: { to: "shoot_day",     label: "Start shoot day" } },
      shoot_day:     { sub: "Shoot day",     next: "Shoot the job, then move it into editing.",                              advance: { to: "editing",       label: "Shot — move to editing" } },
      editing:       { sub: "In editing",    next: "Edit the footage, then build the gallery and upload the archive copy.",   advance: { to: "gallery_ready", label: "Gallery built" } },
      gallery_ready: { sub: "Gallery ready", next: "Add the gallery link, expiry date and PIN, then send it to the client.",  advance: null },
      sent:          { sub: "Sent",          next: "They have their content. Waiting on payment and any edits.",              advance: { to: "delivered",     label: "Close this job" } },
      delivered:     { sub: "Delivered",     next: "Paid, edits settled, nothing left to do.",                                advance: null },
    };
    function fmtBig(iso) {
      return new Date(iso).toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long" });
    }
    // Progress timeline. DB stages in order; each display step maps to the stage
    // index it is "reached" at. Content Studio has a Prepped step (prompt pack);
    // Property / Agent don't (no prep element).
    const STAGE_ORDER = ["booked", "invoiced", "shoot_day", "editing", "gallery_ready", "sent", "delivered"];
    function renderTimeline(b) {
      const isStudio = /content|studio/i.test((b.service_type || "") + " " + (b.service || ""));
      // Numbers are indices into STAGE_ORDER, so they had to move when the
      // stages were reordered - 'Shoot day' is no longer index 1.
      const steps = isStudio
        ? [["Booked", 0], ["Prepped", 0.5], ["Invoiced", 1], ["Shoot day", 2], ["Edited", 3], ["Gallery ready", 4], ["Sent", 5], ["Delivered", 6]]
        : [["Booked", 0], ["Invoiced", 1], ["Shoot day", 2], ["Edited", 3], ["Gallery ready", 4], ["Sent", 5], ["Delivered", 6]];
      const cancelled = b.stage === "cancelled";
      const cur = STAGE_ORDER.indexOf(b.stage);
      const curIdx = cur < 0 ? 0 : cur;
      const n = steps.length;
      let lastReached = 0;
      steps.forEach(([, t], i) => { if (curIdx >= t) lastReached = i; });
      const fillPct = cancelled || n <= 1 ? 0 : (lastReached / (n - 1)) * 100;
      return `<div class="vid-timeline${cancelled ? " is-cancelled" : ""}">
        <div class="vid-tl-track"><div class="vid-tl-track-fill" style="width:${fillPct}%"></div></div>
        ${steps.map(([label, t], i) => {
          const pct = n <= 1 ? 0 : (i / (n - 1)) * 100;
          const done = !cancelled && curIdx >= t;
          const isCur = !cancelled && i === lastReached;
          return `<div class="vid-tl-step${i === 0 ? " vid-tl-step--first" : ""}${i === n - 1 ? " vid-tl-step--last" : ""}${done ? " is-done" : ""}${isCur ? " is-current" : ""}" style="left:${pct}%"><span class="vid-tl-dot"></span><span class="vid-tl-label">${escapeHtml(label)}</span></div>`;
        }).join("")}
      </div>`;
    }
    function nextActionHint(b) {
      if (b.stage === "booked" && b.shoot_date) return "Shoot " + fmtBig(b.shoot_date);
      return (STAGE_FLOW[b.stage] || {}).sub || b.stage;
    }
    function clientSort(a, b) {
      const order = STAGES.map((s) => s.key);
      const ac = a.stage === "delivered", bc = b.stage === "delivered";
      if (ac !== bc) return ac ? 1 : -1;
      const ad = a.shoot_date ? new Date(a.shoot_date).getTime() : Infinity;
      const bd = b.shoot_date ? new Date(b.shoot_date).getTime() : Infinity;
      if (ad !== bd) return ad - bd;
      return order.indexOf(a.stage) - order.indexOf(b.stage);
    }
    // The Clients home is a stage-column board (mirrors the SMM pipeline): each
    // booking sits in its production stage, drag between columns to move it, and
    // clicking a card opens that client's file. Search filters across columns.
    function renderClients(filter = "") {
      const wrap = document.getElementById("vid-clients");
      const loading = document.getElementById("vid-clients-loading");
      const empty = document.getElementById("vid-clients-empty");
      if (!wrap) return;
      if (loading) loading.hidden = true;
      if (!bookings.length) { wrap.hidden = true; if (empty) empty.hidden = false; return; }
      if (empty) empty.hidden = true;
      wrap.hidden = false;
      wrap.className = "vid-board";
      const q = filter.trim().toLowerCase();
      const rows = bookings.filter((b) => !q || [b.client_name, b.client_company, b.service, b.client_email].filter(Boolean).some((v) => String(v).toLowerCase().includes(q)));
      const stageKey = (b) => (STAGES.some((s) => s.key === b.stage) ? b.stage : STAGES[0].key);
      // A pill narrows the board to one stage — same "all rows" vs "one row" split.
      const shown = stageFilter === "all" ? STAGES : STAGES.filter((s) => s.key === stageFilter);
      // One row per stage; cards run left-to-right and that row scrolls on
      // its own past ~3 cards (.vid-row-cards, flex + overflow-x). No board-
      // wide horizontal scroll, and no cap/"see all" — the row just scrolls.
      wrap.innerHTML = shown.map((s) => {
        const cards = rows.filter((b) => stageKey(b) === s.key).sort(clientSort);
        return `
          <div class="vid-col vid-row" data-stage="${s.key}">
            <div class="vid-col-head"><span>${s.label}</span><span class="vid-col-count">${cards.length}</span></div>
            <div class="vid-row-cards" data-stage="${s.key}">${cards.map(cardHtml).join("")}</div>
          </div>`;
      }).join("");
      wrap.querySelectorAll(".vid-card").forEach((el) => {
        el.addEventListener("click", () => openCandidate(el.getAttribute("data-id")));
        el.addEventListener("dragstart", onDragStart);
        el.addEventListener("dragend", onDragEnd);
      });
      wrap.querySelectorAll(".vid-row-cards").forEach((col) => {
        col.addEventListener("dragover", onDragOver);
        col.addEventListener("dragleave", onDragLeave);
        col.addEventListener("drop", onDrop);
      });
      syncVidTopScroll();
    }

    // Size + show the synced scrollbar above the board (mirrors SMM's syncTopScroll).
    function syncVidTopScroll() {
      const board = document.getElementById("vid-clients");
      const top = document.getElementById("vid-scrolltop");
      const inner = document.getElementById("vid-scrolltop-inner");
      if (!board || !top || !inner) return;
      const over = board.scrollWidth > board.clientWidth + 1;
      top.hidden = !over;
      if (over) inner.style.width = board.scrollWidth + "px";
    }

    let candId = null;
    function openCandidate(id) { candId = id; showPanel("candidate"); renderCandidate(); }
    function renderCandidate() {
      const b = bookings.find((x) => x.id === candId);
      const el = document.getElementById("vid-cand");
      if (!b || !el) return;
      const f = STAGE_FLOW[b.stage] || STAGE_FLOW.booked;
      const amount = b.amount_pence != null ? gbpFromPence(b.amount_pence) : "—";
      const isStudio = /content|studio/i.test((b.service_type || "") + " " + (b.service || ""));
      const whenStr = b.shoot_date ? new Date(b.shoot_date).toLocaleString("en-GB", { weekday: "short", day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" }) : "";
      const loc = bookingLocation({ service_type: b.service_type, source: "videography", postcode: b.location || b.postcode });
      el.innerHTML = `
        <div class="vid-cand-card">
        <!-- Who, for whom, and where it has got to - one line, in that order.
             The stage is a badge rather than a headline: it is a label on the
             job, not the name of it. -->
        <div class="vid-cand-head">
          <h2 class="vid-cand-name">${escapeHtml(b.client_name)}</h2>
          ${b.client_company ? `<span class="vid-cand-co">${escapeHtml(b.client_company)}</span>` : ""}
          <span class="vid-cand-stage">${escapeHtml(f.sub)}</span>
        </div>
        <p class="vid-cand-next">${escapeHtml(f.next)}</p>
        <div class="vid-cand-meta">
          ${b.service ? `<span>Service&nbsp; <strong>${escapeHtml(b.service)}</strong></span>` : ""}
          <span>When&nbsp; <strong>${whenStr ? escapeHtml(whenStr) : "Awaiting a date"}</strong></span>
          <span>Quote&nbsp; <strong>${amount}</strong></span>
          ${loc ? `<span>Shoot location&nbsp; <strong>${escapeHtml(loc)}</strong></span>` : ""}
          ${!isStudio ? `<span data-distance>Distance&nbsp; <strong>…</strong></span>` : ""}
          <span data-contact>Contact&nbsp; <strong>…</strong></span>
        </div>
        <div class="vid-cand-actions">
          ${f.advance ? `<button type="button" class="admin-btn admin-btn-primary" data-advance>${escapeHtml(f.advance.label)} &rarr;</button>` : ""}
          <button type="button" class="admin-btn admin-btn-ghost" data-act="reschedule">Reschedule</button>
          <button type="button" class="admin-btn admin-btn-ghost" data-act="edit">Edit</button>
          <button type="button" class="admin-btn admin-btn-ghost" data-act="add">Add</button>
          <button type="button" class="admin-btn admin-btn-ghost" data-act="contact">${b.contact_id ? "Contact" : "Link contact"}</button>
          ${b.stage !== "booked" ? `<button type="button" class="admin-btn admin-btn-ghost" data-act="back">Move back a step</button>` : ""}
        </div>
        <!-- One card, tabbed. Invoice, notes, documents and messages used to be
             four full-height cards stacked underneath, so the page scrolled a
             long way past sections that are usually empty. -->
        ${renderCandTabs(b)}
        <div class="vid-tabpanes">
          <div class="vid-tabpane is-active" data-tab="stage">
            ${renderTimeline(b)}
            ${renderBrandGate(b)}
            <div id="vid-cand-edits-gate"></div>
            ${renderCloseGate(b)}
            <div class="vid-cand-drawer" id="vid-cand-drawer"></div>
            <!-- Whatever this stage asks you to do sits here, beside the
                 progress bar, so the action and the stage read as one thing.
                 Once the shoot moves past it, it drops back out into its own
                 tab alongside the rest. -->
            <div class="vid-cand-action" id="vid-cand-action"></div>
          </div>
          <div class="vid-tabpane" data-tab="delivery"><div id="vid-cand-delivery" hidden></div></div>
          <div class="vid-tabpane" data-tab="invoice"><div id="vid-cand-invoice"></div></div>
          <div class="vid-tabpane" data-tab="notes"><div id="vid-cand-notes"></div></div>
          <div class="vid-tabpane" data-tab="docs"><div id="vid-cand-docs"></div></div>
          <div class="vid-tabpane" data-tab="thread"><div id="vid-cand-thread"></div></div>
        </div>
        </div>`;
      el.querySelectorAll(".vid-tab").forEach((btn) =>
        btn.addEventListener("click", () => showCandTab(btn.getAttribute("data-tab"))));
      el.querySelector("#vid-gate-confirm")?.addEventListener("change", (e) => saveBrandConfirm(b, e.target.checked));
      el.querySelector("#vid-fc-send")?.addEventListener("click", () => sendFcConfirm(b));
      el.querySelector("#vid-edits-done")?.addEventListener("change", (e) => saveEditsSettled(b, e.target.checked));
      if (f.advance) el.querySelector("[data-advance]")?.addEventListener("click", async () => {
        // Editing -> Gallery ready assumes both uploads are done. Neither is
        // recoverable later without redoing work, so it asks.
        if (f.advance.to === "gallery_ready") {
          const missing = [];
          if (!b.archived_at) missing.push("• the archive copy in our own storage");
          if (!b.pixieset_uploaded_at) missing.push("• the Pixieset gallery");
          if (missing.length && !confirm(`These haven't been ticked yet:\n\n${missing.join("\n")}\n\nMove on anyway?`)) return;
        }
        // From Booked the button means "go and raise it", not "pretend it is
        // raised" - the stage moves when the invoice actually sends.
        if (f.advance.to === "invoiced") {
          // Agent shoots are filmed wherever the client wants - their office, a
          // studio, a coffee shop - and that gets agreed after booking. This is
          // the last checkpoint before the shoot, so it is the moment to ask.
          if (b.service_type === "agent") {
            const where = (b.location || "").trim();
            const ok = confirm(where
              ? `Shoot location is recorded as:\n\n${where}\n\nIs that where Jack is going? It's what his calendar will say.`
              : "No shoot location recorded yet.\n\nAgent shoots aren't always at the client's office. Add the agreed location to the booking so it reaches Jack's calendar.\n\nCarry on anyway?");
            if (!ok) { openModal(b.id); return; }
          }
          if (isBrandInvoiced(b) && !b.brand_fee_confirmed) {
            alert("Before you raise an invoice:\n\nFine & Country haven't confirmed the marketing fee is held. Tick the confirmation above once the office has confirmed it.");
            return;
          }
          // An invoice may already exist - someone raised one earlier, or the
          // booking was moved back a step. Raising a second one should be a
          // deliberate choice, not the only way past this stage.
          const raised = (await fetchInvoicesFor(b)).filter((iv) => iv.status !== "void");
          if (raised.length) {
            const list = raised.map((iv) => `${iv.number} (${iv.status})`).join(", ");
            const another = confirm(
              `An invoice has already been raised for this shoot:\n\n${list}\n\n` +
              `Do you need to raise another one?\n\n` +
              `OK — raise another invoice\nCancel — move on to Invoiced`);
            if (!another) { advanceStage("invoiced"); return; }
            vivForceOpen = true;
            await renderInvoiceCard(b);
          }
          scrollToInvoice(b);
          document.getElementById("viv-name")?.focus({ preventScroll: true });
          return;
        }
        advanceStage(f.advance.to);
      });
      el.querySelectorAll("[data-act]").forEach((btn) => btn.addEventListener("click", () => candAction(btn.getAttribute("data-act"))));
      if (!isStudio) showDistance(b);
      showLinkedContact(b);
      const slot = document.getElementById("vid-cand-action");
      if (slot) { slot.innerHTML = ""; slot.hidden = !stageAction(b.stage); }
      renderDeliveryCard(b);
      renderInvoiceCard(b);
      renderEditsCard(b);
      loadThread(b);
    }

    /* The tabs on the booking card. The first one is always the stage itself -
       progress bar, whatever gate applies, and the work this stage is asking
       for. The rest are the standing sections.

       A tab only appears if its card has somewhere to render: while a shoot is
       at Booked or Invoiced the invoice builder lives in the stage tab (see
       actionHost), and the same goes for delivery from Editing to Sent. Showing
       a tab as well would open onto an empty pane. */
    const CAND_TABS = [
      ["stage",    "Progress"],
      ["delivery", "Delivery"],
      ["invoice",  "Invoice"],
      ["notes",    "Notes"],
      ["docs",     "Documents"],
      ["thread",   "Messages"],
    ];
    function candTabShown(b, key) {
      if (key === "delivery") {
        return ["editing", "gallery_ready", "sent", "delivered"].includes(b.stage)
          && stageAction(b.stage) !== "vid-cand-delivery";
      }
      if (key === "invoice") return stageAction(b.stage) !== "vid-cand-invoice";
      return true;
    }
    function renderCandTabs(b) {
      return `<div class="vid-tabs" role="tablist">${CAND_TABS
        .filter(([key]) => candTabShown(b, key))
        .map(([key, label], i) => `<button type="button" role="tab" class="vid-tab${i === 0 ? " is-active" : ""}" data-tab="${key}">${escapeHtml(label)}</button>`)
        .join("")}</div>`;
    }
    function showCandTab(key) {
      const el = document.getElementById("vid-cand");
      if (!el) return;
      el.querySelectorAll(".vid-tab").forEach((btn) => btn.classList.toggle("is-active", btn.getAttribute("data-tab") === key));
      el.querySelectorAll(".vid-tabpane").forEach((pane) => pane.classList.toggle("is-active", pane.getAttribute("data-tab") === key));
    }
    /* The invoice builder is in two places depending on the stage, and both the
       "Raise invoice" button and reissuing want to put you in front of it. */
    function scrollToInvoice(b) {
      const inSlot = stageAction(b && b.stage) === "vid-cand-invoice";
      if (!inSlot) showCandTab("invoice");
      document.getElementById(inSlot ? "vid-cand-action" : "vid-cand-invoice")
        ?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    /* Fine & Country bookings get an extra step before the invoice goes out:
       the office named at booking has to be confirmed as actually holding the
       seller's marketing fee. Everyone else never sees this. */
    function isBrandInvoiced(b) { return b && b.payment_route === "brand_invoice"; }
    // TEG invoicing is deliberately kept separate from isBrandInvoiced() rather
    // than folded in - there is no fee to confirm with anyone, so the F&C gate
    // below must never fire for a TEG booking.
    function isTegInvoiced(b) { return b && b.payment_route === "brand_invoice_teg"; }
    /* Covered by their SMM package: no invoice, and nothing to chase. */
    function isSmmCovered(b) { return b && b.payment_route === "smm_package"; }

    function renderBrandGate(b) {
      if (!isBrandInvoiced(b) || b.stage !== "booked") return "";
      const officeName = (FC_OFFICES.find((o) => o.key === b.fc_office) || {}).label || "";
      const done = !!b.brand_fee_confirmed;
      const claimed = b.marketing_fee_claimed == null ? "not asked" : (b.marketing_fee_claimed ? "yes" : "no");
      return `<div class="vid-gate ${done ? "is-done" : ""}">
        <div class="vid-gate-h">Before the invoice goes out</div>
        <dl class="vid-gate-list">
          <div><dt>Invoiced to</dt><dd>${escapeHtml(officeName || "No office selected — set it on the booking")}</dd></div>
          <div><dt>Agent said a fee was charged</dt><dd>${escapeHtml(claimed)}</dd></div>
        </dl>
        <div class="vid-field" style="margin-top:12px">
          <label>Ask the office <span class="vid-lbl-note">their accounts address, not the agent's</span></label>
          <div class="vid-archive-row">
            <input type="email" id="vid-fc-to" value="${escapeHtml(b.fc_confirm_email || "")}" placeholder="accounts@fineandcountry..." ${officeName ? "" : "disabled"} />
            <button type="button" class="admin-btn admin-btn-ghost" id="vid-fc-send" ${officeName ? "" : "disabled"}>
              ${b.fc_confirm_sent_at ? "Ask again" : "Send request"}
            </button>
          </div>
        </div>
        ${b.fc_confirm_sent_at
          ? `<p class="vid-hint">Asked ${escapeHtml(new Date(b.fc_confirm_sent_at).toLocaleDateString("en-GB"))}${b.fc_confirm_email ? " — " + escapeHtml(b.fc_confirm_email) : ""}.${done ? "" : " Waiting on their reply."}</p>`
          : `<p class="vid-hint">Send this once you've checked the booking details. Tick below only when they've actually replied.</p>`}
        <label class="vid-check">
          <input type="checkbox" id="vid-gate-confirm" ${done ? "checked" : ""} ${officeName ? "" : "disabled"} />
          <span>The office has confirmed the marketing fee has been received</span>
        </label>
        ${done && b.brand_fee_confirmed_at
          ? `<p class="vid-hint">Confirmed ${escapeHtml(new Date(b.brand_fee_confirmed_at).toLocaleDateString("en-GB"))}${b.brand_fee_confirmed_by ? " by " + escapeHtml(b.brand_fee_confirmed_by) : ""}.</p>`
          : `<p class="vid-hint">We don't invoice against a fee nobody has verified is held.</p>`}
      </div>`;
    }

    /* What has to be true before a job closes. Shown from the point it starts
       to matter, so neither condition is a surprise at the last step. */
    /* Two different questions at two different moments, which were previously
       one panel asking both too early.

       At gallery_ready the only question is "can this client have the PIN?" -
       edits have not happened yet, so asking about them there is premature.
       At sent, the shoot is with the client and the question becomes "is this
       job finished?" */
    function renderCloseGate(b) {
      const paid = !!b.paid_at;

      if (b.stage === "gallery_ready") {
        return `<div class="vid-gate ${paid ? "is-done" : ""}">
          <div class="vid-gate-h">Before you send</div>
          <dl class="vid-gate-list">
            <div><dt>Invoice paid</dt><dd>${paid
              ? escapeHtml("Yes — " + new Date(b.paid_at).toLocaleDateString("en-GB"))
              : "Not yet"}</dd></div>
          </dl>
          <p class="vid-hint">${paid
            ? "Paid, so the email will include the PIN and they can download straight away."
            : "Not paid, so the PIN will be withheld. They'll see the gallery watermarked, and the PIN sends itself the moment the invoice is marked paid. Worth checking with accounts first in case payment has landed and we haven't recorded it."}</p>
        </div>`;
      }

      if (b.stage === "sent" || b.stage === "delivered") {
        const edits = !!b.edits_settled_at;
        const done = paid && edits;
        return `<div class="vid-gate ${done ? "is-done" : ""}">
          <div class="vid-gate-h">Before this can be delivered</div>
          <dl class="vid-gate-list">
            <div><dt>Invoice paid</dt><dd>${paid
              ? escapeHtml(new Date(b.paid_at).toLocaleDateString("en-GB"))
              : "Not yet"}</dd></div>
            <div><dt>PIN released</dt><dd>${b.pin_released_at
              ? escapeHtml(new Date(b.pin_released_at).toLocaleDateString("en-GB"))
              : (paid ? "Sent with the gallery" : "Held — not paid")}</dd></div>
          </dl>
          <label class="vid-check">
            <input type="checkbox" id="vid-edits-done" ${edits ? "checked" : ""} />
            <span>The client's round of edits has been settled</span>
          </label>
          ${edits && b.edits_settled_at
            ? `<p class="vid-hint">Settled ${escapeHtml(new Date(b.edits_settled_at).toLocaleDateString("en-GB"))}${b.edits_settled_by ? " by " + escapeHtml(b.edits_settled_by) : ""}.</p>`
            : `<p class="vid-hint">Their agreement includes a round of edits. Tick this once they are done, or once the client has confirmed they don't want any.</p>`}
        </div>`;
      }

      return "";
    }

    async function saveEditsSettled(b, checked) {
      const wasSettled = !!b.edits_settled_at;
      const patch = {
        edits_settled_at: checked ? (b.edits_settled_at || new Date().toISOString()) : null,
        edits_settled_by: checked ? (b.edits_settled_by || adminEmail || null) : null,
      };
      Object.assign(b, patch);
      const { error } = await supabase.from("videography_bookings").update(patch).eq("id", b.id);
      if (error) { alert("Couldn't save that: " + error.message); return; }
      await addNote(b, checked ? "Edits settled." : "Edits reopened.", "audit");

      // The close-out email fires here, on the tick itself, rather than
      // automatically elsewhere - Jack settles with the client on his own
      // channels first, then this is what closes it off from our side. Only
      // on a fresh tick (not already settled), and it's self-guarding on the
      // Worker via edits_complete_email_sent_at, so this can never double-send.
      if (checked && !wasSettled && WORKER_URL && !b.edits_complete_email_sent_at) {
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/videography/edits-complete-email`, {
            method: "POST",
            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
            body: JSON.stringify({ booking_id: b.id }),
          });
          if (res.ok) b.edits_complete_email_sent_at = new Date().toISOString();
        } catch (_) { /* best-effort - the tick itself has already saved */ }
      }

      renderCandidate();
    }

    async function sendFcConfirm(b) {
      const to = (document.getElementById("vid-fc-to")?.value || "").trim();
      if (!to) { alert("Who should we ask? Add the office's accounts address."); return; }
      if (!confirm(`Ask ${to} to confirm they're holding the marketing fee for this shoot?`)) return;
      const btn = document.getElementById("vid-fc-send");
      const label = btn.textContent; btn.disabled = true; btn.textContent = "Sending…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/videography/fc-confirm`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ booking_id: b.id, to }),
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) { alert(d.error || "Couldn't send that."); return; }
        b.fc_confirm_email = to;
        b.fc_confirm_sent_at = new Date().toISOString();
        await addNote(b, `Asked ${to} to confirm the marketing fee is held.`, "audit");
        renderCandidate();
      } catch (err) { alert("Couldn't send that: " + err.message); }
      finally { btn.disabled = false; btn.textContent = label; }
    }

    async function saveBrandConfirm(b, checked) {
      const patch = {
        brand_fee_confirmed: checked,
        brand_fee_confirmed_at: checked ? (b.brand_fee_confirmed_at || new Date().toISOString()) : null,
        brand_fee_confirmed_by: checked ? (b.brand_fee_confirmed_by || adminEmail || null) : null,
      };
      Object.assign(b, patch);
      const { error } = await supabase.from("videography_bookings").update(patch).eq("id", b.id);
      if (error) { alert("Couldn't save that confirmation: " + error.message); return; }
      // The audit trail. Ticking a box is a claim about a conversation with
      // Fine & Country, so it belongs in the record with a name against it.
      const officeName = (FC_OFFICES.find((o) => o.key === b.fc_office) || {}).label || "the office";
      await addNote(b, checked
        ? `F&C office confirmed — ${officeName} has confirmed the seller's marketing fee has been received.`
        : `F&C office confirmation withdrawn — ${officeName}.`, "audit");
      renderCandidate();
    }

    // ---- Client correspondence + documents (booking_messages / booking_documents) ----
    const BK_CATS = [["prep", "Prep document"], ["agreement", "Agreement"], ["invoice", "Invoice"], ["delivery", "Delivered files"], ["other", "Other"]];
    async function loadThread(b) {
      const host = document.getElementById("vid-cand-thread");
      if (!host || !b) return;
      if (!WORKER_URL) { host.innerHTML = `<h4>Messages</h4><p class="vid-loading">Connect the Worker (PUBLIC_R2_WORKER_URL) to manage correspondence.</p>`; return; }
      host.innerHTML = `<h4>Messages</h4><p class="vid-loading">Loading…</p>`;
      let data = { messages: [], documents: [] };
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/booking/thread?booking_id=${encodeURIComponent(b.id)}`, { headers: { Authorization: "Bearer " + token } });
        if (res.ok) data = await res.json();
      } catch (_) {}
      renderThread(b, data);
    }
    function renderThread(b, data) {
      const host = document.getElementById("vid-cand-thread");
      if (!host) return;
      // channel tells us who a line was for: 'email' went to the client, 'note'
      // and 'system' never leave the building.
      const isNote = (m) => m.channel === "note" || m.channel === "system";
      renderNotes(b, (data.messages || []).filter(isNote));
      const msgs = (data.messages || []).filter((m) => !isNote(m)).map((m) => {
        const who = m.is_automated ? "Automated" : (m.created_by && m.created_by !== "system" ? m.created_by : "You");
        return `<div class="vid-msg ${m.is_automated ? "is-auto" : ""}"><div class="vid-msg-meta"><strong>${escapeHtml(who)}</strong><span>${escapeHtml(fmtWhen(m.created_at) || "")}</span></div>${m.subject ? `<div class="vid-msg-subj">${escapeHtml(m.subject)}</div>` : ""}<div class="vid-msg-body">${escapeHtml(m.body || "").replace(/\n/g, "<br>")}</div></div>`;
      }).join("") || `<p class="vid-loading">No messages yet.</p>`;
      const docs = (data.documents || []).map((d) => `<div class="vid-doc"><span class="vid-doc-name">${escapeHtml(d.title || d.file_name)}</span><span class="vid-doc-cat">${escapeHtml((BK_CATS.find((c) => c[0] === d.category) || [, "Other"])[1])}</span><button type="button" class="vid-doc-x" data-doc-del="${escapeHtml(d.id)}" title="Remove">&times;</button></div>`).join("") || `<p class="vid-loading">No documents attached.</p>`;
      // Two separate cards. They used to sit inside the booking card, which
      // buried the stage - the thing you actually came here to act on.
      const docsHost = document.getElementById("vid-cand-docs");
      if (docsHost) {
        docsHost.innerHTML = `
          <h4>Documents</h4>
          <p class="vid-hint" style="margin-bottom:12px">Shared with the client — guidance, agreements and paperwork.</p>
          <div class="vid-docs">${docs}</div>
          <div class="vid-doc-upload">
            <select id="vid-doc-cat">${BK_CATS.map((c) => `<option value="${c[0]}">${c[1]}</option>`).join("")}</select>
            <input type="file" id="vid-doc-file" class="vid-file" />
            <button type="button" class="admin-btn admin-btn-primary" id="vid-doc-up">Attach document</button>
          </div>`;
      }
      host.innerHTML = `
        <h4>Messages</h4>
        <div class="vid-thread">${msgs}</div>
        <div class="vid-compose">
          <input type="text" id="vid-msg-subj" placeholder="Subject (optional)" />
          <textarea id="vid-msg-body" rows="3" placeholder="Write a message to the client…"></textarea>
          <label class="vid-compose-file"><span>Attach a file (optional)</span><input type="file" id="vid-msg-file" class="vid-file" /></label>
          <label class="vid-compose-notify"><input type="checkbox" id="vid-msg-notify" checked /> Email the client too (any attachment rides along)</label>
          <button type="button" class="admin-btn admin-btn-primary" id="vid-msg-send">Send message</button>
        </div>
        <p class="vid-thread-status" id="vid-thread-status" hidden></p>`;
      document.getElementById("vid-msg-send")?.addEventListener("click", () => sendMsg(b));
      document.getElementById("vid-doc-up")?.addEventListener("click", () => uploadDoc(b));
      document.getElementById("vid-cand-docs")?.querySelectorAll("[data-doc-del]").forEach((btn) => btn.addEventListener("click", () => deleteDoc(b, btn.getAttribute("data-doc-del"))));
    }
    /* The folder a booking's files belong in. Uses the saved name if there is
       one, so a folder that already exists in storage keeps its name even if
       the booking is edited afterwards. */
    function archiveFolderFor(bookingId) {
      const b = bookings.find((x) => x.id === bookingId);
      if (!b) return "";
      return (b.archive_folder || archiveFolderName(b) || "").trim();
    }

    /* ---- The internal archive folder ----
       Built from what identifies a shoot at a glance, in the order you'd look
       for it: type, who, when, where. Slashes and colons are stripped because
       a slash in a name becomes a folder boundary in object storage. */
    function archiveFolderName(b) {
      if (!b) return "";
      const clean = (v) => String(v || "").replace(/[\\/:*?"<>|]+/g, " ").replace(/\s+/g, " ").trim();
      const when = b.shoot_date ? new Date(b.shoot_date).toISOString().slice(0, 10) : "";
      const where = clean(b.property_address || b.location || b.postcode).split(",")[0];
      // The person, not the brand: on a Fine & Country shoot the agent is who
      // you'd look for, and every F&C folder would otherwise open the same way.
      return [clean(b.service || b.service_type), clean(b.client_name || b.client_company), when, where]
        .filter(Boolean).join(" - ");
    }

    let deliverGuard = () => true;

    function wireCatBoxes() {
      document.querySelectorAll("#vid-catgrid .vid-catbox").forEach((box) => {
        const category = box.getAttribute("data-category");
        const input = box.querySelector(".vid-catbox-input");
        const pick = box.querySelector(".vid-catbox-pick");
        pick?.addEventListener("click", () => { if (deliverGuard()) input?.click(); });
        input?.addEventListener("change", () => { handleFiles(input.files, category); input.value = ""; });
        ["dragenter", "dragover"].forEach((ev) => box.addEventListener(ev, (e) => { e.preventDefault(); box.classList.add("is-drag"); }));
        ["dragleave", "drop"].forEach((ev) => box.addEventListener(ev, (e) => { e.preventDefault(); box.classList.remove("is-drag"); }));
        box.addEventListener("drop", (e) => { if (deliverGuard()) handleFiles(e.dataTransfer.files, category); });
      });
    }

    // The drop boxes follow the shoot: a studio session has no drone footage,
    // an agent shoot has no interiors. Rendered from the same list that names
    // the folders, so a box and its folder can never disagree.
    function renderCatBoxes(b) {
      const grid = document.getElementById("vid-catgrid");
      if (!grid) return;
      if (!b) { grid.innerHTML = `<p class="vid-loading">Pick a booking to see where files go.</p>`; return; }
      const cats = archiveFoldersFor(b.service_type, b.service);
      grid.innerHTML = cats.map((cat) => `
        <div class="vid-catbox" data-category="${escapeHtml(cat)}">
          <div class="vid-catbox-top">
            <span class="vid-catbox-name">${escapeHtml(cat)}</span>
            <span class="vid-catbox-count" data-cat-count>0</span>
          </div>
          <div class="vid-catbox-drop">
            <input type="file" class="vid-catbox-input" multiple hidden />
            <button type="button" class="vid-catbox-pick">+ Add files</button>
          </div>
        </div>`).join("");
      wireCatBoxes();
    }

    function renderArchiveBox(b) {
      const box = document.getElementById("vid-archive");
      if (!box) return;
      box.hidden = !b;
      if (!b) return;
      const folder = document.getElementById("vid-arch-folder");
      // Generated only when empty - a name that has been used to create real
      // folders must not silently change because a booking detail was edited.
      folder.value = b.archive_folder || archiveFolderName(b);
      const open = document.getElementById("vid-arch-open");
      if (open) { open.hidden = !b.archive_url; open.href = b.archive_url || "#"; }
      document.getElementById("vid-arch-msg").textContent = "";
      showArchivePath(b);
      renderCatBoxes(b);
    }

    // Say where files will land, so nobody has to guess what we did with them.
    function showArchivePath(b) {
      const el = document.getElementById("vid-arch-path");
      if (!el) return;
      const folder = (document.getElementById("vid-arch-folder")?.value || "").trim();
      el.textContent = folder
        ? `Files upload to  deliverables / ${folder} / <category> /`
        : "Give this shoot a folder name and uploads will go there.";
    }

    async function saveArchive(b) {
      const note = document.getElementById("vid-arch-msg");
      const folder = (document.getElementById("vid-arch-folder")?.value || "").trim();
      if (!folder) { note.textContent = "Give the folder a name first."; return; }
      const folders = archiveFoldersFor(b.service_type, b.service);
      const btn = document.getElementById("vid-arch-save");
      const label = btn.textContent; btn.disabled = true; btn.textContent = "Creating…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/videography/archive-create`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ booking_id: b.id, folder, folders }),
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) { note.textContent = d.error || "Couldn't create the folders."; return; }
        b.archive_folder = folder;
        b.archive_url = d.url || null;
        const open = document.getElementById("vid-arch-open");
        if (open) { open.hidden = !b.archive_url; open.href = b.archive_url || "#"; }
        note.textContent = `Created ${d.created.length} folders. Files dropped below will go straight into them.`
          + (d.url ? "" : " (Set CF_ACCOUNT_ID on the Worker for an Open in Cloudflare link.)");
      } catch (err) { note.textContent = "Couldn't reach the Worker: " + err.message; }
      finally { btn.disabled = false; btn.textContent = label; }
    }

    /* ---- Delivery, on the booking ----
       Follows the stage rather than showing everything at once: in editing the
       job is Jack's own uploads, and only once the gallery exists is there
       anything for the client. Fields that mean nothing yet are not shown,
       because a form full of blanks reads as work outstanding. */
    // The action for the current stage renders into the stage card; everything
    // else keeps its own card underneath.
    function actionHost(b, mine) {
      const slot = document.getElementById("vid-cand-action");
      const own = document.getElementById(mine);
      const isCurrent = stageAction(b.stage) === mine;
      if (own) own.hidden = isCurrent;
      if (isCurrent && slot) { slot.hidden = false; return slot; }
      return own;
    }

    function stageAction(stage) {
      if (stage === "booked" || stage === "invoiced") return "vid-cand-invoice";
      if (["editing", "gallery_ready", "sent"].includes(stage)) return "vid-cand-delivery";
      return null;
    }

    async function renderDeliveryCard(b) {
      const host = actionHost(b, "vid-cand-delivery");
      if (!host) return;
      if (!["editing", "gallery_ready", "sent", "delivered"].includes(b.stage)) {
        const own = document.getElementById("vid-cand-delivery");
        if (own) own.hidden = true;
        return;
      }
      host.hidden = false;

      if (b.stage === "editing") {
        host.innerHTML = `
          <h4>Deliver work</h4>
          <p class="vid-hint" style="margin-bottom:14px">
            Two uploads, and the second isn't optional: Pixieset for the client, and our own
            storage as the archive. Pixieset only holds a gallery for about three months.
          </p>
          <label class="vid-check">
            <input type="checkbox" id="vd-archived" ${b.archived_at ? "checked" : ""} />
            <span>Archive copy uploaded to our own storage</span>
          </label>
          ${b.archived_at ? `<p class="vid-hint">Uploaded ${escapeHtml(new Date(b.archived_at).toLocaleDateString("en-GB"))}.</p>` : ""}
          <div class="vid-cand-actions" style="margin-top:14px">
            <button type="button" class="admin-btn admin-btn-ghost" id="vd-goupload">Open Deliver work</button>
          </div>

          <!-- The second upload. Deliberately its own step with its own tick:
               the archive and the client gallery are different places, and a
               single tick would hide which had been done. -->
          <div class="vid-pixieset ${b.pixieset_uploaded_at ? "is-done" : ""}">
            <div class="vid-gate-h">Then build the client gallery</div>
            <p class="vid-hint" style="margin-bottom:10px">
              Create the collection in Pixieset using the TMKE preset, confirm Watermark 3,
              and name it to the agreed convention. Photography and videography go up as
              separate sets.
            </p>
            <p style="margin:0 0 12px">
              <a class="admin-btn admin-btn-ghost" href="/guides/TMKE-Guide-to-Pixieset.pdf" target="_blank" rel="noopener">Read the Pixieset guide</a>
            </p>
            <label class="vid-check">
              <input type="checkbox" id="vd-pixieset" ${b.pixieset_uploaded_at ? "checked" : ""} />
              <span>Content uploaded to the Pixieset gallery</span>
            </label>
            ${b.pixieset_uploaded_at
              ? `<p class="vid-hint">Uploaded ${escapeHtml(new Date(b.pixieset_uploaded_at).toLocaleDateString("en-GB"))}. Move to Gallery ready to add the links.</p>`
              : `<p class="vid-hint">Tick this once the collection is live, then move the shoot to Gallery ready.</p>`}
          </div>`;
        document.getElementById("vd-archived").addEventListener("change", (e) => saveBookingPatch(b, { archived_at: e.target.checked ? (b.archived_at || new Date().toISOString()) : null }));
        document.getElementById("vd-pixieset")?.addEventListener("change", (e) =>
          saveBookingPatch(b, { pixieset_uploaded_at: e.target.checked ? (b.pixieset_uploaded_at || new Date().toISOString()) : null }));
        document.getElementById("vd-goupload").addEventListener("click", () => {
        panelFrom.candId = b.id;
        const sel = document.getElementById("vid-deliver-booking");
        if (sel) { sel.value = b.id; sel.dispatchEvent(new Event("change")); }
        showPanel("deliver");
      });
        return;
      }

      // gallery_ready / delivered: what the client actually needs.
      const pin = await getGalleryPin(b);
      const tourUrl = await getTourLink(b);
      host.innerHTML = `
        <h4>The client's gallery</h4>
        <p class="vid-hint" style="margin-bottom:14px">
          What the client gets sent. They download from Pixieset with their email address
          <em>and</em> the PIN, so the email below has to match the gallery.
        </p>
        <div class="vid-field"><span>Gallery link</span>
          <input type="url" id="vd-gallery" value="${escapeHtml(b.gallery_url || "")}" placeholder="https://gallery.tmke.co.uk/…" /></div>
        <div class="vid-inv-row">
          <div class="vid-field"><span>Gallery email</span>
            <input type="email" id="vd-email" value="${escapeHtml(b.gallery_email || b.client_email || "")}" /></div>
          <div class="vid-field"><span>PIN</span>
            <input type="text" id="vd-pin" autocomplete="off" value="${escapeHtml(pin)}" /></div>
        </div>
        <div class="vid-field"><span>360 Tour <em style="text-transform:none;font-weight:400">— withheld until paid, like the PIN</em></span>
          <input type="url" id="vd-tour360" value="${escapeHtml(tourUrl)}" placeholder="Pixieset can't hold these" /></div>
        <div class="vid-inv-row">
          <div class="vid-field"><span>Anything else — label</span>
            <input type="text" id="vd-extra-label" value="${escapeHtml(b.extra_link_label || "")}" placeholder="e.g. drone stills" /></div>
          <div class="vid-field"><span>Anything else — link</span>
            <input type="url" id="vd-extra-url" value="${escapeHtml(b.extra_link_url || "")}" /></div>
        </div>
        <label class="vid-check">
          <input type="checkbox" id="vd-archived" ${b.archived_at ? "checked" : ""} />
          <span>Archive copy uploaded to our own storage</span>
        </label>
        <p class="vid-warn" id="vd-msg" hidden></p>
        <div class="vid-cand-actions" style="margin-top:14px">
          <button type="button" class="admin-btn admin-btn-primary" id="vd-save">Save</button>
          <button type="button" class="admin-btn admin-btn-ghost" id="vd-send" ${b.gallery_sent_at ? "" : ""}>
            ${b.gallery_sent_at ? "Send gallery email again" : "Send gallery email"}
          </button>
        </div>
        ${b.gallery_sent_at ? `<p class="vid-hint">Sent ${escapeHtml(new Date(b.gallery_sent_at).toLocaleString("en-GB"))}.</p>` : ""}
        <p class="vid-hint">${b.pin_released_at
          ? `PIN released ${escapeHtml(new Date(b.pin_released_at).toLocaleDateString("en-GB"))}.`
          : b.paid_at
            ? "Paid, so the email will include the PIN."
            : "Not paid, so the email will withhold the PIN and ask for payment. They'll see the watermarked gallery — the PIN follows automatically when payment lands."}</p>
        ${b.gallery_sent_at && b.paid_at && !b.pin_released_at
          ? `<div class="vid-cand-actions"><button type="button" class="admin-btn admin-btn-primary" id="vd-releasepin">Send the PIN now</button></div>`
          : ""}`;

      document.getElementById("vd-save").addEventListener("click", () => saveGalleryFields(b));
      document.getElementById("vd-send").addEventListener("click", () => sendGalleryEmail(b));
      document.getElementById("vd-releasepin")?.addEventListener("click", async () => {
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/videography/release-pin`, {
            method: "POST",
            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
            body: JSON.stringify({ booking_id: b.id }),
          });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) { vdMsg(d.error || "Couldn't send the PIN.", true); return; }
          b.pin_released_at = new Date().toISOString();
          await addNote(b, `PIN released to ${d.sent_to}.`, "audit");
          renderCandidate();
        } catch (err) { vdMsg("Couldn't send the PIN: " + err.message, true); }
      });
      document.getElementById("vd-archived").addEventListener("change", (e) =>
        saveBookingPatch(b, { archived_at: e.target.checked ? (b.archived_at || new Date().toISOString()) : null }));
    }

    async function getGalleryPin(b) {
      const { data } = await supabase.from("videography_gallery_pins").select("pin").eq("booking_id", b.id).maybeSingle();
      return (data && data.pin) || "";
    }

    async function getTourLink(b) {
      const { data } = await supabase.from("videography_tour_links").select("url").eq("booking_id", b.id).maybeSingle();
      return (data && data.url) || "";
    }

    async function saveBookingPatch(b, patch) {
      Object.assign(b, patch);
      const { error } = await supabase.from("videography_bookings").update(patch).eq("id", b.id);
      if (error) alert("Couldn't save that: " + error.message);
      else renderCandidate();
    }

    function vdMsg(text, bad) {
      const el = document.getElementById("vd-msg");
      if (!el) return;
      el.hidden = !text; el.textContent = text || "";
      el.style.color = bad ? "#8a5a2b" : "var(--english-violet)";
    }

    async function sendGalleryEmail(b) {
      // Save first. Otherwise an unsaved link or PIN in the boxes is not what
      // the Worker reads, and the client gets last-saved rather than on-screen.
      await saveGalleryFields(b);
      const paid = !!b.paid_at;
      const to = (document.getElementById("vd-email")?.value || "").trim();
      if (!confirm(`Send the gallery email to ${to}?\n\n${paid
        ? "They've paid, so this includes the PIN and they can download."
        : "They haven't paid, so this withholds the PIN, asks for payment and attaches the invoice."}`)) return;
      const btn = document.getElementById("vd-send");
      const label = btn.textContent; btn.disabled = true; btn.textContent = "Sending…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/videography/gallery-email`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ booking_id: b.id }),
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) { vdMsg(d.error || "Couldn't send.", true); return; }
        b.gallery_sent_at = new Date().toISOString();
        // The stage follows the email actually going, rather than waiting for
        // someone to remember to move it.
        if (b.stage === "gallery_ready") await advanceStage("sent");
        await addNote(b, d.included_pin
          ? `Gallery email sent to ${d.sent_to} with the PIN.`
          : `Gallery email sent to ${d.sent_to}. PIN withheld - not yet paid.`, "audit");
        renderCandidate();
      } catch (err) { vdMsg("Couldn't send: " + err.message, true); }
      finally { btn.disabled = false; btn.textContent = label; }
    }

    async function saveGalleryFields(b) {
      const val = (id) => (document.getElementById(id)?.value || "").trim();
      const patch = {
        gallery_url: val("vd-gallery") || null,
        gallery_email: val("vd-email") || null,
        extra_link_label: val("vd-extra-label") || null,
        extra_link_url: val("vd-extra-url") || null,
      };
      const { error } = await supabase.from("videography_bookings").update(patch).eq("id", b.id);
      if (error) { vdMsg("Couldn't save: " + error.message, true); return; }
      Object.assign(b, patch);
      await saveGalleryPin(b.id, val("vd-pin"));
      await saveTourLink(b.id, val("vd-tour360"));
      vdMsg("Saved.");
    }

    /* ---- Invoicing, on the booking ----
       Same Worker endpoints as the standalone Invoicing page and the SMM client
       card. Raising it here rather than there matters for one reason beyond
       convenience: it sets booking_id, so the invoice and the shoot are linked.
       Without that, payment lands on the invoice and the booking never hears
       about it. */
    let invSettings = null;
    let vivItems = [];
    let vivPayByCard = true;   // set per booking in renderInvoiceCard
    let vivDraft = null;       // the created invoice awaiting send
    let vivReissueOf = null;   // { id, number } when reissuing a sent invoice
    let vivForceOpen = false;  // "Raise another invoice" on a shoot past invoicing

    async function ensureInvSettings() {
      if (invSettings || !WORKER_URL) return invSettings;
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/invoicing/settings`, { headers: { Authorization: "Bearer " + token } });
        if (res.ok) invSettings = (await res.json()).settings || {};
      } catch (_) { invSettings = {}; }
      return invSettings || (invSettings = {});
    }

    const vivMoney = (p) => "£" + ((p || 0) / 100).toFixed(2);

    // Seed the invoice from what was actually booked, travel included as its
    // own line so the client can see what they are paying for.
    function vivSeedItems(b) {
      const items = [];
      const base = (b.total_pence != null ? b.total_pence : b.amount_pence) || 0;
      const surcharge = b.surcharge_pence || 0;
      // A brand invoice is billed to the office (or, for TEG, to the brand),
      // not the agent, so the line has to say who the shoot was actually for
      // or the recipient cannot place it.
      const forWhom = (isBrandInvoiced(b) || isTegInvoiced(b)) && b.client_name ? ` — ${b.client_name}` : "";
      const label = [b.service || "Videography", b.package ? `(${b.package})` : ""].filter(Boolean).join(" ") + forWhom;
      items.push({ description: label, amount: base > surcharge ? ((base - surcharge) / 100).toFixed(2) : (base / 100).toFixed(2) });
      if (surcharge) items.push({ description: `Travel — ${b.distance_miles ? Math.round(b.distance_miles) + " miles" : "mileage"}`, amount: (surcharge / 100).toFixed(2) });
      return items;
    }

    function vivTotals() {
      const rate = invSettings && invSettings.vat_rate != null ? Number(invSettings.vat_rate) : 20;
      const subtotal = vivItems.reduce((sum, it) => sum + Math.round((parseFloat(it.amount) || 0) * 100), 0);
      const vat = Math.round(subtotal * rate / 100);
      return { subtotal, vat, total: subtotal + vat, rate };
    }

    function vivBuildInvoice(b) {
      const t = vivTotals();
      return {
        number: (invSettings.invoice_prefix || "TMKE") + (invSettings.next_number || 1001),
        issued_date: document.getElementById("viv-issued")?.value || null,
        due_date: document.getElementById("viv-due")?.value || null,
        bill_to_name: document.getElementById("viv-name")?.value.trim() || "",
        bill_to_email: document.getElementById("viv-email")?.value.trim() || "",
        bill_to_address: document.getElementById("viv-address")?.value.trim() || "",
        notes: document.getElementById("viv-notes")?.value.trim() || null,
        line_items: vivItems.map((it) => ({ description: it.description, qty: 1, unit_pence: Math.round((parseFloat(it.amount) || 0) * 100) })),
        subtotal_pence: t.subtotal, vat_pence: t.vat, total_pence: t.total,
        pay_by_card: vivPayByCard,
        release_on_payment: true,   // always a shoot here
        terms_days: Number(document.getElementById("viv-terms")?.value) || 10,
      };
    }

    /* What a client has asked for via the public edit-request page - notes,
       any twilight images, any extra-images purchase. Read straight from
       Supabase like the rest of the admin centre; the public page never
       touches this table directly, only the Worker does.

       Sits inline in the stage card, directly above "Before this can be
       delivered" (#vid-cand-edits-gate, set in the template right before
       renderCloseGate(b)) - so the gate that blocks delivery on edits being
       settled always has, right above it, the answer to "have we even asked
       them yet, and what did they say". Nothing renders until the edits link
       has actually gone out - there's nothing to be "awaiting" before that. */
    async function renderEditsCard(b) {
      const host = document.getElementById("vid-cand-edits-gate");
      if (!host) return;

      // The edits link rides on whichever paid-path email actually fired:
      // gallery_sent_at if already paid when the gallery went out, or
      // pin_released_at if payment landed after. Never on the not-yet-paid
      // send, so no date here means nothing's gone out yet.
      const editsSentAt = b.pin_released_at || (b.paid_at && b.gallery_sent_at ? b.gallery_sent_at : null);
      if (!editsSentAt) { host.innerHTML = ""; return; }

      // Their own link, so it can be handed over again by hand - a lost
      // email, a different contact who needs it, whatever the reason. Same
      // token every time (minted once, on first send), so this never goes
      // stale even if they've already submitted a request through it.
      const editsLink = b.edits_token ? `${location.origin}/edits?token=${encodeURIComponent(b.edits_token)}` : "";
      const linkRow = editsLink
        ? `<div class="vid-archive-row" style="margin-bottom:12px">
             <input type="text" readonly value="${escapeHtml(editsLink)}" id="vid-edits-link" />
             <button type="button" class="admin-btn admin-btn-ghost" id="vid-edits-link-copy">Copy</button>
           </div>`
        : "";

      const { data, error } = await supabase
        .from("videography_edit_requests")
        .select("*")
        .eq("booking_id", b.id)
        .order("created_at", { ascending: false });
      const requests = error ? [] : (data || []);

      if (!requests.length) {
        const sentNice = new Date(editsSentAt).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" });
        host.innerHTML = `<div class="vid-gate">
          <div class="vid-gate-h">Edit</div>
          ${linkRow}
          <p class="vid-hint">Awaiting edits from the client. Sent ${escapeHtml(sentNice)}.</p>
        </div>`;
        wireEditsLinkCopy();
        return;
      }

      const statusLabel = (r) => {
        if (r.status === "notified") return "Sent to Jack";
        if (r.status === "paid") return "Paid — notifying Jack";
        return "Pending";
      };
      const rowsHtml = requests.map((r, i) => {
        const twilight = Array.isArray(r.twilight_items) ? r.twilight_items : [];
        const when = new Date(r.created_at).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
        return `<div${i < requests.length - 1 ? ' style="margin-bottom:12px;padding-bottom:12px;border-bottom:1px solid rgba(28,29,34,0.08)"' : ""}>
          <p class="vid-hint"><strong>${escapeHtml(when)} — ${escapeHtml(statusLabel(r))}</strong></p>
          ${r.notes ? `<p class="vid-hint" style="white-space:pre-wrap">${escapeHtml(r.notes)}</p>` : ""}
          ${twilight.length ? `<p class="vid-hint"><strong>Twilight</strong> — ${twilight.length} image${twilight.length === 1 ? "" : "s"}: ${twilight.map((it) => escapeHtml(it.filename || "")).join(", ")}</p>` : ""}
          ${r.extra_images_qty ? `<p class="vid-hint"><strong>Extra images</strong> — ${r.extra_images_qty} bought (${gbpFromPence(r.extra_images_price_pence || 0)}). Bump their download cap above once you've actioned it.</p>` : ""}
        </div>`;
      }).join("");

      host.innerHTML = `<div class="vid-gate is-done">
        <div class="vid-gate-h">Edit</div>
        ${linkRow}
        ${rowsHtml}
      </div>`;
      wireEditsLinkCopy();
    }

    function wireEditsLinkCopy() {
      const btn = document.getElementById("vid-edits-link-copy");
      const input = document.getElementById("vid-edits-link");
      if (!btn || !input) return;
      btn.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(input.value); btn.textContent = "Copied"; }
        catch (_) { input.select(); btn.textContent = "Selected"; }
        setTimeout(() => { btn.textContent = "Copy"; }, 1500);
      });
    }

    async function renderInvoiceCard(b) {
      const host = actionHost(b, "vid-cand-invoice");
      if (!host) return;
      if (!WORKER_URL) { host.innerHTML = `<h4>Invoice</h4><p class="vid-loading">Connect the Worker to raise invoices.</p>`; return; }
      await ensureInvSettings();

      // Once the shoot has moved past invoicing there is nothing left to raise,
      // so the builder folds away and only the raised invoices remain - with
      // Edit, Resend and Mark paid, which are the things still worth doing.
      const raisingDone = !["booked", "invoiced"].includes(b.stage) && !vivForceOpen;
      if (raisingDone) {
        host.innerHTML = `<h4>Invoice</h4>
          <div class="vid-inv-list-h" style="margin-top:0;padding-top:0;border:0">Raised for this shoot</div>
          <div id="viv-list"><p class="vid-loading">Loading…</p></div>
          <p class="vid-warn" id="viv-msg" hidden></p>
          <button type="button" class="admin-btn admin-btn-ghost" id="viv-reopen" style="margin-top:12px">Raise another invoice</button>`;
        document.getElementById("viv-reopen").addEventListener("click", () => { vivForceOpen = true; renderInvoiceCard(b); });
        loadInvoices(b);
        return;
      }
      vivItems = vivSeedItems(b);
      vivDraft = null;
      vivReissueOf = null;
      vivForceOpen = false;
      const today = new Date().toISOString().slice(0, 10);
      const due = new Date(); due.setDate(due.getDate() + 10);
      const brand = isBrandInvoiced(b);
      const teg = isTegInvoiced(b);
      // The client pays by card; a brand settling out of a marketing fee (or a
      // TEG brand settling from its own budget) pays its own way. Offering a
      // card button to an accounts office is noise, and leaving it off for a
      // client is a slower payment - so it follows the route rather than
      // defaulting the same for both.
      vivPayByCard = !brand && !teg;
      // Billed to the office that holds the marketing fee, not to the agent -
      // or, for TEG, to the specific brand rather than to Paula who reads it.
      const officeName = (FC_OFFICES.find((o) => o.key === b.fc_office) || {}).label || "";
      const tegBrandName = tegBrandLabel(b.teg_brand);
      const billTo = brand ? (officeName || b.client_company || b.client_name || "")
        : teg ? (tegBrandName || b.client_company || b.client_name || "")
        : (b.client_company || b.client_name || "");
      const billAddress = teg ? tegBrandAddress(b.teg_brand) : "";
      const shootDate = b.shoot_date
        ? new Date(b.shoot_date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" })
        : "";
      // The office/brand needs to know which job this is: whose shoot, which
      // property, which day. Editable - this is a starting point, not a fixed
      // string. TEG's wording varies by reason rather than by property, since
      // most TEG shoots (inductions especially) aren't property jobs.
      const tegReasonName = b.teg_reason === "other" ? (b.teg_reason_other || "the reason given") : tegReasonLabel(b.teg_reason);
      const tegNotesByReason = {
        induction: `Invoice raised for ${b.client_name || "the new starter"}'s induction shoot, as part of the induction package.`,
        event: `Invoice raised for brand event coverage${b.client_name ? ` — ${b.client_name}` : ""}${shootDate ? `, ${shootDate}` : ""}.`,
        marketing: `Invoice raised for brand marketing content${b.client_name ? ` — ${b.client_name}` : ""}.`,
      };
      const defaultNotes = brand
        ? [`Invoice raised for ${b.client_name || "the agent"}.`,
           b.property_address || b.location || "",
           shootDate ? `Shoot date: ${shootDate}` : ""].filter(Boolean).join("\n")
        : teg
        ? (tegNotesByReason[b.teg_reason] || `Invoice raised for ${tegReasonName}${b.client_name ? ` — ${b.client_name}` : ""}.`)
        : "Thank you for your business - TMKE";

      host.innerHTML = `
        <h4>Invoice</h4>
        <p class="vid-hint" style="margin-bottom:14px">
          ${brand ? "Billed to the brand out of the seller's marketing fee."
            : teg ? `Billed to ${tegBrandName || "the brand"} — not to the client.`
            : "Billed to the client."}
          Ten days to pay, and the content terms are included automatically.
        </p>
        <div class="vid-inv-row">
          <label class="vid-field"><span>Bill to</span><input id="viv-name" value="${escapeHtml(billTo)}" /></label>
          <label class="vid-field"><span>Email</span><input id="viv-email" type="email" value="${escapeHtml(brand ? "" : teg ? TEG_ACCOUNTS_EMAIL : (b.client_email || ""))}" placeholder="${brand ? "The office's accounts address" : ""}" /></label>
        </div>
        <label class="vid-field"><span>CC</span><input id="viv-cc" value="${escapeHtml((invSettings && invSettings.accounts_cc_email) || "hello@tmke.co.uk")}" placeholder="Comma-separated" /></label>
        <div class="vid-inv-row">
          <label class="vid-field"><span>Issued</span><input id="viv-issued" type="date" value="${today}" /></label>
          <label class="vid-field"><span>Due</span><input id="viv-due" type="date" value="${due.toISOString().slice(0, 10)}" /></label>
          <label class="vid-field"><span>Terms (days)</span><input id="viv-terms" type="number" min="0" value="10" /></label>
        </div>
        <label class="vid-field"><span>Billing address</span><textarea id="viv-address" rows="2" placeholder="Optional">${escapeHtml(billAddress)}</textarea></label>
        <div class="vid-field"><span>Card payment</span>
          <div class="vid-inv-toggle" id="viv-pay">
            <button type="button" data-pay="no">Off</button><button type="button" data-pay="yes">On</button>
          </div>
          <p class="vid-hint">${brand
            ? "Off by default — the brand is settling this, not the client. Turn it on if they'd rather pay by card."
            : teg
            ? "Off by default — the brand is settling this, not the client. Turn it on if they'd rather pay by card."
            : "On by default — the client is paying, so the invoice carries a Pay by card button and payment marks the shoot paid on its own."}</p>
        </div>
        <div class="vid-field"><span>Line items</span><div id="viv-items"></div>
          <button type="button" class="admin-btn admin-btn-ghost" id="viv-add">Add line</button></div>
        <div class="vid-inv-totals" id="viv-totals"></div>
        <label class="vid-field"><span>Notes (optional)</span><textarea id="viv-notes" rows="${brand ? 3 : 2}">${escapeHtml(defaultNotes)}</textarea></label>
        <p class="vid-warn" id="viv-msg" hidden></p>
        <div class="vid-cand-actions">
          <button type="button" class="admin-btn admin-btn-ghost" id="viv-preview">Preview</button>
          <button type="button" class="admin-btn admin-btn-ghost" id="viv-draft">Save draft</button>
          <button type="button" class="admin-btn admin-btn-primary" id="viv-send">Create &amp; send</button>
        </div>
        <div class="vid-inv-list-h">Raised for this shoot</div>
        <div id="viv-list"><p class="vid-loading">Loading…</p></div>`;

      vivRenderItems();
      document.getElementById("viv-add").addEventListener("click", () => { vivItems.push({ description: "", amount: "" }); vivRenderItems(); });
      document.getElementById("viv-pay").addEventListener("click", (e) => {
        const btn = e.target.closest("[data-pay]"); if (!btn) return;
        vivPayByCard = btn.getAttribute("data-pay") === "yes"; vivSyncPay();
      });
      vivSyncPay();
      document.getElementById("viv-preview").addEventListener("click", () => {
        const w = window.open("", "_blank"); if (!w) return;
        w.document.open(); w.document.write(renderInvoiceHtml({ settings: { ...invSettings }, invoice: vivBuildInvoice(b) })); w.document.close();
      });
      document.getElementById("viv-terms").addEventListener("input", ciApplyVivTerms);
      document.getElementById("viv-draft").addEventListener("click", () => createInvoice(b, false));
      document.getElementById("viv-send").addEventListener("click", () => createInvoice(b, true));
      loadInvoices(b);
    }

    function vivSyncPay() {
      document.querySelectorAll("#viv-pay [data-pay]").forEach((btn) =>
        btn.classList.toggle("is-active", (btn.getAttribute("data-pay") === "yes") === vivPayByCard));
    }

    function vivRenderItems() {
      const host = document.getElementById("viv-items");
      if (!host) return;
      host.innerHTML = vivItems.map((it, i) => `
        <div class="vid-inv-item">
          <input type="text" data-vi="${i}" data-k="description" value="${escapeHtml(it.description)}" placeholder="Description" />
          <input type="number" step="0.01" data-vi="${i}" data-k="amount" value="${escapeHtml(it.amount)}" placeholder="0.00" />
          <button type="button" class="vid-inv-x" data-vrm="${i}" title="Remove">&times;</button>
        </div>`).join("");
      host.querySelectorAll("[data-vi]").forEach((el) => el.addEventListener("input", () => {
        vivItems[Number(el.getAttribute("data-vi"))][el.getAttribute("data-k")] = el.value;
        vivRenderTotals();
      }));
      host.querySelectorAll("[data-vrm]").forEach((btn) => btn.addEventListener("click", () => {
        vivItems.splice(Number(btn.getAttribute("data-vrm")), 1); vivRenderItems();
      }));
      vivRenderTotals();
    }

    function vivRenderTotals() {
      const el = document.getElementById("viv-totals");
      if (!el) return;
      const t = vivTotals();
      el.innerHTML = `<span>Subtotal ${vivMoney(t.subtotal)}</span><span>VAT (${t.rate}%) ${vivMoney(t.vat)}</span><strong>Total ${vivMoney(t.total)}</strong>`;
    }

    function vivStatus(msg, bad) {
      const el = document.getElementById("viv-msg");
      if (!el) return;
      el.hidden = !msg; el.textContent = msg || "";
      el.style.color = bad ? "#8a5a2b" : "var(--english-violet)";
    }

    async function createInvoice(b, send) {
      const inv = vivBuildInvoice(b);
      if (!inv.bill_to_name) { vivStatus("Who is this billed to?", true); return; }
      if (send && !inv.bill_to_email) { vivStatus("An email address is needed to send it.", true); return; }
      if (!inv.line_items.length) { vivStatus("Add at least one line.", true); return; }
      const btn = document.getElementById(send ? "viv-send" : "viv-draft");
      const label = btn.textContent; btn.disabled = true; btn.textContent = send ? "Sending…" : "Saving…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/invoicing/invoices`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({
            // The link that was missing: this invoice belongs to this shoot.
            booking_id: b.id, booking_source: "videography",
            bill_to_name: inv.bill_to_name, bill_to_email: inv.bill_to_email || null,
            bill_to_address: inv.bill_to_address || null,
            issued_date: inv.issued_date, due_date: inv.due_date, notes: inv.notes,
            cc_email: (document.getElementById("viv-cc")?.value || "").trim() || null,
            pay_by_card: inv.pay_by_card, release_on_payment: true, terms_days: inv.terms_days,
            line_items: inv.line_items,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) { vivStatus(data.error || "Couldn't save the invoice.", true); return; }
        vivDraft = data.invoice;
        // Only void the original once its replacement is safely saved. The
        // other order risks voiding an invoice and having nothing to show for it.
        let voided = "";
        if (vivReissueOf) {
          await fetch(`${WORKER_URL}/invoicing/invoices`, {
            method: "PATCH",
            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
            body: JSON.stringify({ id: vivReissueOf.id, status: "void" }),
          });
          voided = ` ${vivReissueOf.number} voided.`;
          vivReissueOf = null;
        }
        if (!send) { vivStatus(`Invoice ${data.invoice.number} saved as a draft.${voided}`); loadInvoices(b); return; }

        const sres = await fetch(`${WORKER_URL}/invoicing/invoices/send`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ id: data.invoice.id }),
        });
        const sdata = await sres.json().catch(() => ({}));
        if (!sres.ok) { vivStatus(sdata.error || "Saved, but the email didn't send.", true); loadInvoices(b); return; }
        vivStatus(`Invoice ${data.invoice.number} sent to ${inv.bill_to_email}.${voided}`);
        // The stage follows the invoice actually going out.
        if (b.stage === "booked") await advanceStage("invoiced");
        loadInvoices(b);
      } catch (err) {
        vivStatus("Couldn't reach the Worker: " + err.message, true);
      } finally { btn.disabled = false; btn.textContent = label; }
    }

    async function fetchInvoicesFor(b) {
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/invoicing/invoices?booking_id=${encodeURIComponent(b.id)}`, { headers: { Authorization: "Bearer " + token } });
        if (res.ok) return (await res.json()).invoices || [];
      } catch (_) {}
      return [];
    }

    async function loadInvoices(b) {
      const host = document.getElementById("viv-list");
      if (!host) return;
      const list = await fetchInvoicesFor(b);
      b._invoices = list;
      if (!list.length) { host.innerHTML = `<p class="vid-loading">Nothing raised yet.</p>`; return; }
      host.innerHTML = list.map((iv) => `
        <div class="vid-inv-row-item">
          <span class="vid-inv-num">${escapeHtml(iv.number || "—")}</span>
          <span>${escapeHtml(gbpFromPence(iv.total_pence))}</span>
          <span class="vid-inv-actions">
            <span class="vid-inv-status is-${escapeHtml(iv.status)}">${escapeHtml(iv.status)}</span>
            ${iv.status !== "void" ? `<button type="button" class="admin-btn admin-btn-ghost" data-vedit="${escapeHtml(iv.id)}">Edit</button>` : ""}
            ${iv.status === "sent" || iv.status === "paid" ? `<button type="button" class="admin-btn admin-btn-ghost" data-vresend="${escapeHtml(iv.id)}">Resend</button>` : ""}
            ${iv.status !== "paid" && iv.status !== "void" ? `<button type="button" class="admin-btn admin-btn-ghost" data-vpaid="${escapeHtml(iv.id)}">Paid</button>` : ""}
          </span>
        </div>`).join("");
      host.querySelectorAll("[data-vpaid]").forEach((btn) => btn.addEventListener("click", () => markInvoicePaid(b, btn.getAttribute("data-vpaid"))));
      host.querySelectorAll("[data-vresend]").forEach((btn) => btn.addEventListener("click", () => resendInvoice(b, btn.getAttribute("data-vresend"), btn)));
      host.querySelectorAll("[data-vedit]").forEach((btn) => btn.addEventListener("click", () => editInvoice(b, btn.getAttribute("data-vedit"))));
      renderChaseLog(b);
    }

    async function resendInvoice(b, id, btn) {
      if (!confirm("Send this invoice again to the same address?")) return;
      const label = btn.textContent; btn.disabled = true; btn.textContent = "Sending…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/invoicing/invoices/send`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ id }),
        });
        const d = await res.json().catch(() => ({}));
        vivStatus(res.ok ? `Sent again to ${d.sent_to || "the client"}.` : (d.error || "Couldn't resend."), !res.ok);
      } catch (err) { vivStatus("Couldn't resend: " + err.message, true); }
      finally { btn.disabled = false; btn.textContent = label; loadInvoices(b); }
    }

    /* A sent invoice is not edited in place - it has gone to the client and it
       has a number. Editing loads it back into the builder and reissues it as a
       new invoice, voiding the original. That is what "we need to change it"
       actually means once something has left the building. */
    async function editInvoice(b, id) {
      const { data, error } = await supabase.from("invoices").select("*").eq("id", id).maybeSingle();
      if (error || !data) { vivStatus("Couldn't load that invoice.", true); return; }
      const set = (elId, v) => { const el = document.getElementById(elId); if (el) el.value = v ?? ""; };
      set("viv-name", data.bill_to_name);
      set("viv-email", data.bill_to_email);
      set("viv-address", data.bill_to_address);
      set("viv-cc", data.cc_email);
      set("viv-issued", new Date().toISOString().slice(0, 10));
      set("viv-terms", data.terms_days ?? 10);
      set("viv-notes", data.notes);
      vivPayByCard = !!data.pay_by_card; vivSyncPay();
      vivItems = (data.line_items || []).map((it) => ({
        description: it.description || "",
        amount: (((it.unit_pence || 0) * (it.qty || 1)) / 100).toFixed(2),
      }));
      vivRenderItems();
      ciApplyVivTerms();
      vivReissueOf = { id: data.id, number: data.number };
      const sendBtn = document.getElementById("viv-send");
      if (sendBtn) sendBtn.textContent = "Reissue & send";
      const draftBtn = document.getElementById("viv-draft");
      if (draftBtn) draftBtn.textContent = "Reissue as draft";
      vivStatus(`Editing ${data.number}. Saving raises a new invoice and voids ${data.number}.`);
      scrollToInvoice(b);
    }

    // Keep the due date honest when terms change.
    function ciApplyVivTerms() {
      const n = Number(document.getElementById("viv-terms")?.value);
      const issued = document.getElementById("viv-issued")?.value;
      const dueEl = document.getElementById("viv-due");
      if (!dueEl || !n || isNaN(n)) return;
      const from = issued ? new Date(issued) : new Date();
      if (isNaN(from)) return;
      from.setDate(from.getDate() + n);
      dueEl.value = from.toISOString().slice(0, 10);
    }

    /* What we've sent chasing this invoice, under the invoices themselves. An
       automatic email nobody can see having been sent is indistinguishable from
       one that never went - and "did we actually chase them?" is the first
       question anyone asks about an unpaid invoice. */
    async function renderChaseLog(b) {
      const host = document.getElementById("viv-list");
      if (!host || !WORKER_URL) return;
      let msgs = [];
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/booking/thread?booking_id=${encodeURIComponent(b.id)}`, { headers: { Authorization: "Bearer " + token } });
        if (res.ok) msgs = (await res.json()).messages || [];
      } catch (_) { return; }
      const chases = msgs.filter((m) => ["invoice_chase", "invoice_overdue_alert", "payment_reminder"].includes(m.kind));
      if (!chases.length) return;
      const when = (d) => { try { return new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); } catch (_) { return ""; } };
      host.insertAdjacentHTML("beforeend", `
        <div class="vid-chaselog">
          <div class="vid-chaselog-h">Chasers sent</div>
          ${chases.map((m) => `<div class="vid-chaselog-row">
            <span class="vid-chaselog-when">${escapeHtml(when(m.created_at))}</span>
            <span>${escapeHtml(m.subject || "-")}</span>
            ${m.kind === "invoice_overdue_alert" ? `<span class="vid-inv-status">internal</span>` : ""}
          </div>`).join("")}
        </div>`);
    }

    async function markInvoicePaid(b, id) {
      try {
        const token = await authToken();
        await fetch(`${WORKER_URL}/invoicing/invoices`, {
          method: "PATCH",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ id, status: "paid" }),
        });
        // Marking the invoice paid is what "paid" means for the shoot too, so
        // the booking follows rather than needing a second tick somewhere else.
        if (!b.paid_at) {
          b.paid_at = new Date().toISOString();
          await supabase.from("videography_bookings").update({ paid_at: b.paid_at }).eq("id", b.id);
          await addNote(b, "Payment received — invoice marked paid.", "audit");
          // If they already have the gallery without the PIN, send it now. The
          // Worker decides whether it applies, so this is safe to always call.
          try {
            const token = await authToken();
            const res = await fetch(`${WORKER_URL}/videography/release-pin`, {
              method: "POST",
              headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
              body: JSON.stringify({ booking_id: b.id }),
            });
            if (res.ok) {
              const d = await res.json();
              b.pin_released_at = new Date().toISOString();
              await addNote(b, `PIN released to ${d.sent_to} — payment received.`, "audit");
            }
          } catch (_) { /* the payment is recorded either way */ }
        }
        loadInvoices(b);
      } catch (err) { vivStatus("Couldn't mark it paid: " + err.message, true); }
    }

    /* ---- Notes: the internal record, and the audit trail ----
       Notes live in booking_messages on channel 'note' (typed by a person) or
       'system' (written by an action, e.g. confirming the F&C fee). Neither
       ever reaches the client - see supabase/booking_notes_private.sql. */
    let adminList = [];
    async function loadAdmins() {
      if (adminList.length || !WORKER_URL) return adminList;
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/admins/list`, { headers: { Authorization: "Bearer " + token } });
        if (res.ok) adminList = (await res.json()).admins || [];
      } catch (_) {}
      return adminList;
    }

    function renderNotes(b, notes) {
      const host = document.getElementById("vid-cand-notes");
      if (!host) return;
      const rows = notes.map((n) => {
        const audit = n.kind === "audit" || n.channel === "system";
        const who = n.created_by && n.created_by !== "system" ? n.created_by : "System";
        return `<div class="vid-note ${audit ? "is-audit" : ""}">
          <div class="vid-note-meta"><strong>${escapeHtml(who)}</strong><span>${escapeHtml(fmtWhen(n.created_at) || "")}</span></div>
          <div class="vid-note-body">${highlightMentions(n.body || "")}</div>
        </div>`;
      }).join("") || `<p class="vid-loading">No notes yet.</p>`;

      host.innerHTML = `
        <h4>Notes</h4>
        <p class="vid-hint" style="margin-bottom:12px">Internal only — the client never sees these. Type @ to tag a colleague.</p>
        <div class="vid-notes">${rows}</div>
        <div class="vid-note-compose">
          <textarea id="vid-note-body" rows="3" placeholder="Add a note…"></textarea>
          <div class="vid-mention-menu" id="vid-mention-menu" hidden></div>
          <button type="button" class="admin-btn admin-btn-primary" id="vid-note-add">Add note</button>
        </div>`;
      document.getElementById("vid-note-add")?.addEventListener("click", () => addNote(b));
      wireMentions(document.getElementById("vid-note-body"));
      loadAdmins();
    }

    function highlightMentions(text) {
      return escapeHtml(text).replace(/(^|\s)(@[\w.+-]+@[\w.-]+)/g, '$1<span class="vid-mention">$2</span>').replace(/\n/g, "<br>");
    }

    /* Type @ and pick a colleague. Deliberately matches on the whole email:
       two admins can share a first name, and a tag that goes to the wrong
       person is worse than one that is slightly long. */
    function wireMentions(ta) {
      const menu = document.getElementById("vid-mention-menu");
      if (!ta || !menu) return;
      const close = () => { menu.hidden = true; };
      ta.addEventListener("input", async () => {
        const upto = ta.value.slice(0, ta.selectionStart);
        const m = upto.match(/@([\w.+-]*)$/);
        if (!m) return close();
        const list = (await loadAdmins()).filter((e) => e.toLowerCase().includes(m[1].toLowerCase()));
        if (!list.length) return close();
        menu.innerHTML = list.slice(0, 6).map((e) => `<button type="button" data-mention="${escapeHtml(e)}">${escapeHtml(e)}</button>`).join("");
        menu.hidden = false;
        menu.querySelectorAll("[data-mention]").forEach((btn) => btn.addEventListener("click", () => {
          const email = btn.getAttribute("data-mention");
          ta.value = ta.value.slice(0, ta.selectionStart - m[0].length) + "@" + email + " " + ta.value.slice(ta.selectionStart);
          close(); ta.focus();
        }));
      });
      ta.addEventListener("blur", () => setTimeout(close, 150));
    }

    async function addNote(b, bodyOverride, kind) {
      const ta = document.getElementById("vid-note-body");
      const body = bodyOverride != null ? bodyOverride : (ta?.value || "").trim();
      if (!body) return;
      if (!WORKER_URL) { alert("Connect the Worker to add notes."); return; }
      const mentions = [...body.matchAll(/@([\w.+-]+@[\w.-]+)/g)].map((m) => m[1]);
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/booking/message`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ booking_id: b.id, source: "videography", body, notify: false, kind: kind || "manual", mentions }),
        });
        if (!res.ok) { const d = await res.json().catch(() => ({})); alert("Couldn't save that note: " + (d.error || res.status)); return; }
      } catch (err) { alert("Couldn't save that note: " + err.message); return; }
      if (ta) ta.value = "";
      loadThread(b);
    }

    function threadStatus(msg, ok) {
      const el = document.getElementById("vid-thread-status"); if (!el) return;
      el.hidden = false; el.textContent = msg; el.style.color = ok === false ? "#8a3b2f" : "var(--english-violet)";
    }
    async function sendMsg(b) {
      const body = document.getElementById("vid-msg-body")?.value.trim();
      const subject = document.getElementById("vid-msg-subj")?.value.trim();
      const notify = document.getElementById("vid-msg-notify")?.checked;
      const fileInput = document.getElementById("vid-msg-file");
      const file = fileInput && fileInput.files && fileInput.files[0];
      if (!body && !file) return;
      const btn = document.getElementById("vid-msg-send"); btn.disabled = true; btn.textContent = "Sending…";
      try {
        const token = await authToken();
        // If a file is attached, store it as a booking document first so it both
        // appears under the booking AND can be attached to the notification email.
        let documentId = null;
        if (file) {
          const qs = new URLSearchParams({ booking_id: b.id, source: "videography", category: "other", file_name: file.name, content_type: file.type || "application/octet-stream" });
          const up = await fetch(`${WORKER_URL}/booking/document?${qs.toString()}`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": file.type || "application/octet-stream" }, body: file });
          if (!up.ok) throw new Error(((await up.json().catch(() => ({}))).error) || "Attachment upload failed");
          const upd = await up.json().catch(() => ({}));
          documentId = upd && upd.document ? upd.document.id : null;
        }
        const finalBody = body || `I've attached a document for you: ${file.name}`;
        const res = await fetch(`${WORKER_URL}/booking/message`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: b.id, source: "videography", subject, body: finalBody, notify, document_id: documentId }) });
        if (!res.ok) throw new Error(((await res.json().catch(() => ({}))).error) || "Failed to send");
        loadThread(b);
      } catch (e) { threadStatus(e.message || "Couldn't send", false); btn.disabled = false; btn.textContent = "Send message"; }
    }
    async function uploadDoc(b) {
      const fileInput = document.getElementById("vid-doc-file");
      const cat = document.getElementById("vid-doc-cat")?.value || "other";
      const file = fileInput && fileInput.files && fileInput.files[0];
      if (!file) { threadStatus("Choose a file first.", false); return; }
      const btn = document.getElementById("vid-doc-up"); btn.disabled = true; btn.textContent = "Uploading…";
      try {
        const token = await authToken();
        const qs = new URLSearchParams({ booking_id: b.id, source: "videography", category: cat, file_name: file.name, content_type: file.type || "application/octet-stream" });
        const res = await fetch(`${WORKER_URL}/booking/document?${qs.toString()}`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": file.type || "application/octet-stream" }, body: file });
        if (!res.ok) throw new Error(((await res.json().catch(() => ({}))).error) || "Upload failed");
        loadThread(b);
      } catch (e) { threadStatus(e.message || "Couldn't upload", false); btn.disabled = false; btn.textContent = "Attach document"; }
    }
    async function deleteDoc(b, id) {
      if (!confirm("Remove this document?")) return;
      try {
        const token = await authToken();
        await fetch(`${WORKER_URL}/booking/document?id=${encodeURIComponent(id)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } });
        loadThread(b);
      } catch (_) {}
    }
    function prevStageOf(k) { const i = STAGES.findIndex((s) => s.key === k); return i > 0 ? STAGES[i - 1].key : k; }
    async function advanceStage(to) {
      const b = bookings.find((x) => x.id === candId);
      if (!b) return;
      // The one hard stop in the pipeline. Raising an invoice against an
      // unverified marketing fee is the mistake this whole step exists for, so
      // here it blocks rather than warns.
      // Delivered means finished, not "we sent it". A job with an unpaid
      // invoice or an outstanding amend is neither, so it cannot close.
      if (to === "delivered") {
        const missing = [];
        if (!b.paid_at) missing.push("• The invoice hasn't been marked paid.");
        if (!b.edits_settled_at) missing.push("• The client's round of edits hasn't been settled.");
        if (missing.length) {
          alert("This shoot can't be closed yet:\n\n" + missing.join("\n") +
            "\n\nTick both on the client file, then mark it delivered.");
          return;
        }
      }
      if (to === "invoiced" && isBrandInvoiced(b) && !b.brand_fee_confirmed) {
        alert("Before you raise an invoice:\n\nFine & Country haven't confirmed the marketing fee is held. Tick the confirmation above once the office has confirmed it.");
        return;
      }
      const prev = b.stage; b.stage = to; renderCandidate();
      const { error } = await supabase.from("videography_bookings").update({ stage: to }).eq("id", b.id);
      if (error) { b.stage = prev; renderCandidate(); alert("Couldn't update stage: " + error.message); return; }
      renderClients(document.getElementById("vid-client-search")?.value || "");
    }
    function candAction(act) {
      const b = bookings.find((x) => x.id === candId);
      if (!b) return;
      if (act === "edit") { openModal(b.id); return; }
      if (act === "back") { advanceStage(prevStageOf(b.stage)); return; }
      const drawer = document.getElementById("vid-cand-drawer");
      if (!drawer) return;
      showCandTab("stage");   // the drawer lives in the stage tab; open it there
      drawer.classList.add("is-open");
      if (act === "contact") { renderContactDrawer(b); return; }
      if (act === "reschedule") {
        drawer.innerHTML = `<h4>Reschedule shoot</h4>
          <div class="vid-cand-form">
            <div class="vid-field"><label>New date &amp; time</label><input type="datetime-local" id="vid-resch" value="${b.shoot_date ? new Date(b.shoot_date).toISOString().slice(0, 16) : ""}" /></div>
            <button type="button" class="admin-btn admin-btn-primary" id="vid-resch-save">Save date</button>
          </div>`;
        document.getElementById("vid-resch-save").addEventListener("click", async () => {
          const v = document.getElementById("vid-resch").value;
          const iso = v ? new Date(v).toISOString() : null;
          const { error } = await supabase.from("videography_bookings").update({ shoot_date: iso }).eq("id", b.id);
          if (error) { alert("Couldn't save: " + error.message); return; }
          b.shoot_date = iso; renderCandidate();
          renderClients(document.getElementById("vid-client-search")?.value || "");
        });
        return;
      }
      if (act === "add") {
        drawer.innerHTML = `<h4>Add to this job — one thing at a time</h4>
          <div class="vid-add-opts">
            <button type="button" class="vid-add-opt" data-add="service"><strong>Additional service</strong><span>Add another service to the shoot.</span></button>
            <button type="button" class="vid-add-opt" data-add="cost"><strong>Extra cost</strong><span>Add a charge to the quote.</span></button>
            <button type="button" class="vid-add-opt" data-add="file"><strong>Edit the file</strong><span>Open the full details to edit.</span></button>
          </div>
          <div id="vid-add-form"></div>`;
        drawer.querySelectorAll("[data-add]").forEach((btn) => btn.addEventListener("click", () => addThing(btn.getAttribute("data-add"))));
      }
    }
    function addThing(kind) {
      const b = bookings.find((x) => x.id === candId);
      if (!b) return;
      if (kind === "file") { openModal(b.id); return; }
      const form = document.getElementById("vid-add-form");
      if (!form) return;
      if (kind === "service") {
        form.innerHTML = `<div class="vid-cand-form"><div class="vid-field"><label>Service to add</label><input type="text" id="vid-add-svc" placeholder="e.g. Drone footage" /></div><button type="button" class="admin-btn admin-btn-primary" id="vid-add-svc-save">Add service</button></div>`;
        document.getElementById("vid-add-svc-save").addEventListener("click", async () => {
          const v = document.getElementById("vid-add-svc").value.trim(); if (!v) return;
          const svc = b.service ? b.service + ", " + v : v;
          const { error } = await supabase.from("videography_bookings").update({ service: svc }).eq("id", b.id);
          if (error) { alert(error.message); return; }
          b.service = svc; renderCandidate(); renderClients(document.getElementById("vid-client-search")?.value || "");
        });
      }
      if (kind === "cost") {
        form.innerHTML = `<div class="vid-cand-form"><div class="vid-field"><label>What for</label><input type="text" id="vid-add-cl" placeholder="e.g. Travel" /></div><div class="vid-field"><label>Amount (£)</label><input type="number" id="vid-add-ca" min="0" step="0.01" /></div><button type="button" class="admin-btn admin-btn-primary" id="vid-add-c-save">Add cost</button></div>`;
        document.getElementById("vid-add-c-save").addEventListener("click", async () => {
          const label = document.getElementById("vid-add-cl").value.trim();
          const amt = parseFloat(document.getElementById("vid-add-ca").value) || 0;
          if (!amt) return;
          const pence = (b.amount_pence || 0) + Math.round(amt * 100);
          const note = (b.notes ? b.notes + "\n" : "") + ("+ £" + amt.toFixed(2) + (label ? " " + label : "")).trim();
          const { error } = await supabase.from("videography_bookings").update({ amount_pence: pence, notes: note }).eq("id", b.id);
          if (error) { alert(error.message); return; }
          b.amount_pence = pence; b.notes = note; renderCandidate(); renderClients(document.getElementById("vid-client-search")?.value || "");
        });
      }
    }

    /* Distance from a central Kettering postcode (Jack's base) via postcodes.io. */
    function haversineMiles(la1, lo1, la2, lo2) {
      const R = 3958.8, t = (x) => (x * Math.PI) / 180;
      const dLa = t(la2 - la1), dLo = t(lo2 - lo1);
      const a = Math.sin(dLa / 2) ** 2 + Math.cos(t(la1)) * Math.cos(t(la2)) * Math.sin(dLo / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(a));
    }
    async function showDistance(b) {
      const span = document.querySelector("#vid-cand [data-distance] strong");
      if (!span) return;
      const m = ((b.location || b.postcode) || "").match(/[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}/i);
      if (!m) { span.textContent = "add a postcode"; return; }
      try {
        const base = await getBaseCoords();
        const r = await fetch("https://api.postcodes.io/postcodes/" + encodeURIComponent(m[0].replace(/\s+/g, "")));
        const d = await r.json();
        if (!d.result) { span.textContent = "postcode not found"; return; }
        const miles = haversineMiles(base.lat, base.lon, d.result.latitude, d.result.longitude);
        span.textContent = Math.round(miles) + " mi from base";
      } catch (_) { span.textContent = "unknown"; }
    }

    /* ---- The booking's CRM contact ----
       Bookings taken through the public form arrive with an email, so the
       Worker can join them to a contact on the way in. The ones Jack adds by
       hand often cannot be joined automatically - a phone call, a name and a
       date - so this is the manual route: look for a match, pick one yourself,
       or make the contact from what the booking already knows.

       Deliberately three separate answers rather than one clever one. A guess
       good enough to show as a suggestion is not good enough to act on by
       itself, so nothing here links anything without being asked to. */
    const contactCache = new Map();   // id -> contact row, so re-renders don't re-fetch

    function contactName(c) {
      const n = [c.first_name, c.last_name].filter(Boolean).join(" ").trim();
      return n || c.email || "Unnamed contact";
    }
    // Last six digits, which survives every way a UK number gets typed
    // ("07123 456789", "+447123456789", "07123456789").
    function phoneTail(v) {
      const digits = (v || "").replace(/\D/g, "");
      return digits.length >= 6 ? digits.slice(-6) : "";
    }

    async function getContact(id) {
      if (!id) return null;
      if (contactCache.has(id)) return contactCache.get(id);
      const { data } = await supabase.from("contacts").select("id,email,first_name,last_name,phone,company,lifecycle,user_id").eq("id", id).maybeSingle();
      if (data) contactCache.set(id, data);
      return data || null;
    }

    async function showLinkedContact(b) {
      const span = document.querySelector("#vid-cand [data-contact] strong");
      if (!span) return;
      if (!b.contact_id) { span.textContent = "not linked"; return; }
      const c = await getContact(b.contact_id);
      span.textContent = c ? contactName(c) : "not linked";
    }

    /* What this booking looks like it belongs to. Each query is separate rather
       than one .or() string - the search text is the client's own name and
       email, and PostgREST's or() takes commas and brackets as syntax. */
    async function suggestContacts(b) {
      const found = new Map();   // id -> { contact, why }
      const add = (rows, why) => (rows || []).forEach((c) => { if (!found.has(c.id)) found.set(c.id, { c, why }); });
      const cols = "id,email,first_name,last_name,phone,company,lifecycle,user_id";
      const email = (b.client_email || "").trim();
      const name = (b.client_name || "").trim();
      const tail = phoneTail(b.client_phone);

      if (email) {
        const { data } = await supabase.from("contacts").select(cols).ilike("email", email).limit(5);
        add(data, "same email");
      }
      if (tail) {
        const { data } = await supabase.from("contacts").select(cols).ilike("phone", "%" + tail).limit(5);
        add(data, "same phone number");
      }
      if (name) {
        const first = name.split(/\s+/)[0];
        const last = name.split(/\s+/).slice(1).join(" ");
        if (last) {
          const { data } = await supabase.from("contacts").select(cols).ilike("first_name", first).ilike("last_name", last).limit(5);
          add(data, "same name");
        }
        const { data } = await supabase.from("contacts").select(cols).ilike("last_name", last || first).limit(5);
        add(data, "same surname");
      }
      return [...found.values()];
    }

    async function searchContacts(q) {
      const term = (q || "").trim();
      if (term.length < 2) return [];
      const cols = "id,email,first_name,last_name,phone,company,lifecycle,user_id";
      const found = new Map();
      // One query per column for the same reason as above: the term is free text.
      for (const col of ["email", "first_name", "last_name", "company"]) {
        const { data } = await supabase.from("contacts").select(cols).ilike(col, "%" + term + "%").limit(8);
        (data || []).forEach((c) => found.set(c.id, c));
      }
      return [...found.values()].slice(0, 12);
    }

    function contactRow(c, why, action) {
      return `<div class="vid-contact-row">
        <div class="vid-contact-who">
          <strong>${escapeHtml(contactName(c))}</strong>
          <span>${escapeHtml([c.email, c.company].filter(Boolean).join(" · ") || "no email on file")}</span>
        </div>
        ${why ? `<span class="vid-contact-why">${escapeHtml(why)}</span>` : ""}
        ${action}
      </div>`;
    }

    async function renderContactDrawer(b) {
      const drawer = document.getElementById("vid-cand-drawer");
      if (!drawer) return;
      drawer.innerHTML = `<h4>Contact</h4><p class="vid-loading">Looking for a match…</p>`;

      const linked = await getContact(b.contact_id);
      const suggestions = linked ? [] : await suggestContacts(b);

      // Three states, and the difference matters: on their account, linkable to
      // an account, or nobody to link to.
      const onAccount = linked && linked.user_id && b.account_user_id === linked.user_id;
      const canAttach = linked && linked.user_id && !onAccount;
      const accountLine = !linked ? ""
        : onAccount
          ? `<p class="vid-hint">They can see this shoot in their own account under My bookings.</p>`
          : canAttach
            ? `<p class="vid-hint">${escapeHtml(contactName(linked))} has a TMKE account, but this shoot is not attached to it yet — so it will not appear under their My bookings.</p>
               <div class="vid-cand-actions" style="margin-top:10px"><button type="button" class="admin-btn admin-btn-primary" data-contact-attach>Show it in their account</button></div>`
            : `<p class="vid-hint">${escapeHtml(contactName(linked))} has no TMKE account, so there is no My bookings for this to appear in. The link is admin-side only until they sign up with ${escapeHtml(linked.email || "that address")}.</p>`;

      const linkedBlock = linked
        ? `<div class="vid-gate is-done">
             <div class="vid-gate-h">Linked to</div>
             ${contactRow(linked, "", `<button type="button" class="admin-btn admin-btn-ghost" data-contact-unlink>Unlink</button>`)}
             ${accountLine}
             <p class="vid-hint">Unlinking leaves the contact alone — it only removes the join to this shoot.</p>
           </div>`
        : suggestions.length
          ? `<div class="vid-contact-block">
               <div class="vid-gate-h">Looks like it might be</div>
               <p class="vid-hint" style="margin-bottom:10px">Matched on what the booking already knows. Check it is the right person before linking — nothing here links itself.</p>
               ${suggestions.map((s) => contactRow(s.c, s.why, `<button type="button" class="admin-btn admin-btn-primary" data-contact-link="${escapeHtml(s.c.id)}">Link</button>`)).join("")}
             </div>`
          : `<div class="vid-contact-block"><p class="vid-hint">Nothing in the CRM matches this booking's name, email or phone number. Search for them below, or make the contact from what the booking already has.</p></div>`;

      const company = b.client_company || b.company || "";
      drawer.innerHTML = `
        <h4>Contact</h4>
        ${linkedBlock}
        <div class="vid-contact-block">
          <div class="vid-gate-h">${linked ? "Link to somebody else" : "Search for them"}</div>
          <div class="vid-archive-row">
            <input type="text" id="vid-contact-q" placeholder="Name, email or company…" />
            <button type="button" class="admin-btn admin-btn-ghost" id="vid-contact-search">Search</button>
          </div>
          <div id="vid-contact-results"></div>
        </div>
        <div class="vid-contact-block">
          <div class="vid-gate-h">Or make a new contact</div>
          <p class="vid-hint" style="margin-bottom:10px">Pre-filled from the booking. An email address is how the CRM tells people apart, so it is the one thing this needs.</p>
          <div class="vid-cand-form">
            <div class="vid-field"><label>Name</label><input type="text" id="vid-nc-name" value="${escapeHtml(b.client_name || "")}" /></div>
            <div class="vid-field"><label>Email</label><input type="email" id="vid-nc-email" value="${escapeHtml(b.client_email || "")}" /></div>
            <div class="vid-field"><label>Phone</label><input type="text" id="vid-nc-phone" value="${escapeHtml(b.client_phone || "")}" /></div>
            <div class="vid-field"><label>Company</label><input type="text" id="vid-nc-company" value="${escapeHtml(company)}" /></div>
            <button type="button" class="admin-btn admin-btn-primary" id="vid-nc-save">Create &amp; link</button>
          </div>
        </div>
        <p class="vid-warn" id="vid-contact-msg" hidden></p>`;

      wireContactDrawer(b);
    }

    function contactMsg(text, bad) {
      const el = document.getElementById("vid-contact-msg");
      if (!el) return;
      el.hidden = !text;
      el.textContent = text || "";
      el.style.color = bad ? "#8a3b2f" : "var(--english-violet)";
    }

    function wireContactDrawer(b) {
      const drawer = document.getElementById("vid-cand-drawer");
      if (!drawer) return;
      drawer.querySelectorAll("[data-contact-link]").forEach((btn) =>
        btn.addEventListener("click", () => linkContact(b, btn.getAttribute("data-contact-link"))));
      drawer.querySelector("[data-contact-unlink]")?.addEventListener("click", () => linkContact(b, null));
      // Re-running the link is the whole repair: it is what stamps the account.
      drawer.querySelector("[data-contact-attach]")?.addEventListener("click", () =>
        linkContact(b, b.contact_id, "Attached — it will show under their My bookings."));
      document.getElementById("vid-nc-save")?.addEventListener("click", () => createContactFor(b));

      const q = document.getElementById("vid-contact-q");
      const run = async () => {
        const host = document.getElementById("vid-contact-results");
        if (!host) return;
        const term = q ? q.value : "";
        if (term.trim().length < 2) { host.innerHTML = `<p class="vid-hint">Type at least two characters.</p>`; return; }
        host.innerHTML = `<p class="vid-loading">Searching…</p>`;
        const rows = await searchContacts(term);
        host.innerHTML = rows.length
          ? rows.map((c) => contactRow(c, "", `<button type="button" class="admin-btn admin-btn-ghost" data-contact-link="${escapeHtml(c.id)}">Link</button>`)).join("")
          : `<p class="vid-hint">Nobody in the CRM matches that. Make the contact below instead.</p>`;
        host.querySelectorAll("[data-contact-link]").forEach((btn) =>
          btn.addEventListener("click", () => linkContact(b, btn.getAttribute("data-contact-link"))));
      };
      document.getElementById("vid-contact-search")?.addEventListener("click", run);
      q?.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); run(); } });
    }

    /* Linking is two joins, not one, because the client's own account finds a
       shoot a different way than the CRM does. /account/bookings looks for
       account_user_id (or a client_email matching the account's own address),
       and the row-level policy on the table gates reads the same way - so a
       contact_id on its own is an admin-side note the client cannot see.

       If the contact has a TMKE account, linking attaches the shoot to it too.
       If they have not got one, there is nothing to attach to and the drawer
       says so rather than leaving you to wonder why nothing happened. */
    async function linkContact(b, contactId, note) {
      const patch = { contact_id: contactId };
      if (contactId) {
        const c = await getContact(contactId);
        if (c && c.user_id) patch.account_user_id = c.user_id;
      } else {
        // Unlinking gives back what linking took, and no more: an
        // account_user_id the booking flow set for itself belongs to the
        // booking, not to this link, so it is left alone.
        const prev = await getContact(b.contact_id);
        if (prev && prev.user_id && b.account_user_id === prev.user_id) patch.account_user_id = null;
      }
      const { error } = await supabase.from("videography_bookings").update(patch).eq("id", b.id);
      if (error) { contactMsg("Couldn't save that link: " + error.message, true); return; }
      b.contact_id = contactId;
      if ("account_user_id" in patch) b.account_user_id = patch.account_user_id;
      // The whole card re-renders (the button's label and the meta row both
      // change), which takes the drawer with it - so it is reopened here rather
      // than through candAction, whose own render is not awaited and would drop
      // the message below on the floor.
      renderCandidate();
      showCandTab("stage");
      document.getElementById("vid-cand-drawer")?.classList.add("is-open");
      await renderContactDrawer(b);
      contactMsg(note || (contactId ? "Linked." : "Unlinked."));
    }

    /* Made from the booking, tagged the way the CRM backfill tags a videography
       client so this contact sorts with the rest of them. Marketing consent is
       not something a booking can speak for, so it is left off. */
    async function createContactFor(b) {
      const name = (document.getElementById("vid-nc-name")?.value || "").trim();
      const email = (document.getElementById("vid-nc-email")?.value || "").trim().toLowerCase();
      const phone = (document.getElementById("vid-nc-phone")?.value || "").trim();
      const company = (document.getElementById("vid-nc-company")?.value || "").trim();
      if (!email) { contactMsg("A contact needs an email address — it is how the CRM tells people apart.", true); return; }

      const first = name.split(/\s+/)[0] || null;
      const last = name.split(/\s+/).slice(1).join(" ") || null;
      const product = { content: "Content-Studio", "content-studio": "Content-Studio", property: "Property-Videography", agent: "Agent-Videography" }[b.service_type];
      const network = /experts\.co\.uk$/.test(email) ? "Network: TEG"
        : /@fineandcountry\.com$/.test(email) ? "Network: Fine-and-Country"
        : "Network: External";
      const tags = ["Videography-Client", "Marketing-Not-Opted-In", network];
      if (product) tags.push("Videography-Product: " + product);

      const { data, error } = await supabase.from("contacts").insert({
        email, first_name: first, last_name: last, phone: phone || null, company: company || null,
        source: "videography", lifecycle: "customer", marketing_opt_in: false, tags,
      }).select("id,email,first_name,last_name,phone,company,lifecycle,user_id").maybeSingle();

      // Email is the CRM's unique key, so "already exists" is a link, not an
      // error - the person you were about to create is already on file.
      if (error) {
        if (!/duplicate|unique/i.test(error.message || "")) { contactMsg("Couldn't create that contact: " + error.message, true); return; }
        // .eq, not .ilike: `_` is a wildcard in ilike and a legal character in
        // an email, so a pattern match here could return somebody else and link
        // the shoot to the wrong person. The insert just failed on the unique
        // index over this exact value, so an exact match is what finds it.
        const { data: existing } = await supabase.from("contacts").select("id").eq("email", email).maybeSingle();
        if (!existing) { contactMsg("Couldn't create that contact: " + error.message, true); return; }
        await linkContact(b, existing.id, `${email} was already in the CRM — linked to them instead.`);
        return;
      }
      if (data) contactCache.set(data.id, data);
      await linkContact(b, data.id, "Contact created and linked.");
    }

    /* Auto-advance: a booked job becomes "Shoot day" once its day arrives. */
    function startOfDay(d) { const x = new Date(d); x.setHours(0, 0, 0, 0); return x.getTime(); }
    async function autoAdvance() {
      const today = startOfDay(Date.now());
      // On the day: whatever it was, it is now a shoot day.
      const due = bookings.filter((b) => (b.stage === "booked" || b.stage === "invoiced") && b.shoot_date && startOfDay(b.shoot_date) <= today);
      for (const b of due) {
        b.stage = "shoot_day";
        await supabase.from("videography_bookings").update({ stage: "shoot_day" }).eq("id", b.id);
      }
      // The day after: the shoot has happened, so it is being edited. Nobody
      // needs to drag a card to say the day ended.
      const shot = bookings.filter((b) => b.stage === "shoot_day" && b.shoot_date && startOfDay(b.shoot_date) < today);
      for (const b of shot) {
        b.stage = "editing";
        await supabase.from("videography_bookings").update({ stage: "editing" }).eq("id", b.id);
      }
    }

    /* ---------- Diary (per-day hour blocks) ---------- */
    let availability = [];
    const DIARY_HOURS = []; for (let h = 6; h <= 21; h++) DIARY_HOURS.push(h); // 06:00–22:00 blocks
    let diaryState = {};   // weekday -> Set(hours)
    let diaryOpen = null;  // currently expanded weekday
    let diaryInit = false;

    function hoursForRow(a) {
      if (a && Array.isArray(a.hours) && a.hours.length) return a.hours.map(Number);
      if (a && a.is_available !== false && a.start_time && a.end_time) {
        const sh = parseInt(a.start_time.split(":")[0], 10);
        const [eh, em] = a.end_time.split(":").map(Number);
        const end = em > 0 ? eh + 1 : eh;
        const out = []; for (let h = sh; h < end; h++) out.push(h); return out;
      }
      return [];
    }
    function fmtHours(set) {
      const hrs = [...set].sort((a, b) => a - b);
      if (!hrs.length) return "Closed";
      const ranges = []; let start = hrs[0], prev = hrs[0];
      for (let i = 1; i < hrs.length; i++) {
        if (hrs[i] === prev + 1) prev = hrs[i];
        else { ranges.push([start, prev + 1]); start = prev = hrs[i]; }
      }
      ranges.push([start, prev + 1]);
      return ranges.map(([a, b]) => `${String(a).padStart(2, "0")}:00–${String(b).padStart(2, "0")}:00`).join(", ");
    }
    function renderDiary() {
      const wrap = document.getElementById("vid-diary");
      if (!wrap) return;
      if (!diaryInit) {
        const byDay = new Map(availability.map((a) => [a.weekday, a]));
        DAYS.forEach(({ d }) => { diaryState[d] = new Set(hoursForRow(byDay.get(d))); });
        diaryInit = true;
      }
      wrap.innerHTML = DAYS.map(({ d, name }) => {
        const set = diaryState[d] || new Set();
        const open = diaryOpen === d;
        return `
          <div class="vid-day ${open ? "is-open" : ""}" data-day="${d}">
            <button type="button" class="vid-day-head" data-day-head="${d}">
              <span class="vid-day-name">${name}</span>
              <span class="vid-day-summary ${set.size ? "" : "is-off"}">${fmtHours(set)}</span>
              <span class="vid-day-chev">›</span>
            </button>
            <div class="vid-day-hours">
              ${DIARY_HOURS.map((h) => `<button type="button" class="vid-hour ${set.has(h) ? "is-on" : ""}" data-day="${d}" data-hour="${h}">${String(h).padStart(2, "0")}:00</button>`).join("")}
            </div>
          </div>`;
      }).join("");
      wrap.querySelectorAll("[data-day-head]").forEach((b) => b.addEventListener("click", () => {
        const d = Number(b.getAttribute("data-day-head"));
        diaryOpen = diaryOpen === d ? null : d;
        renderDiary();
      }));
      wrap.querySelectorAll(".vid-hour").forEach((b) => b.addEventListener("click", () => {
        const d = Number(b.getAttribute("data-day")), h = Number(b.getAttribute("data-hour"));
        const set = diaryState[d] || (diaryState[d] = new Set());
        if (set.has(h)) set.delete(h); else set.add(h);
        renderDiary();
      }));
      const saveBtn = document.getElementById("vid-diary-save");
      if (saveBtn) saveBtn.hidden = false;
    }
    async function saveDiary() {
      const rows = DAYS.map(({ d }) => {
        const hrs = [...(diaryState[d] || new Set())].sort((a, b) => a - b);
        return {
          weekday: d,
          hours: hrs,
          is_available: hrs.length > 0,
          start_time: hrs.length ? `${String(hrs[0]).padStart(2, "0")}:00` : "09:00",
          end_time: hrs.length ? `${String(hrs[hrs.length - 1] + 1).padStart(2, "0")}:00` : "17:00",
        };
      });
      const btn = document.getElementById("vid-diary-save");
      if (btn) { btn.textContent = "Saving…"; btn.disabled = true; }
      const { error } = await supabase.from("videography_availability").upsert(rows, { onConflict: "weekday" });
      if (btn) { btn.disabled = false; btn.textContent = error ? "Error — run the hours migration?" : "Saved ✓"; }
      if (!error) availability = rows.map((r) => ({ ...r }));
      setTimeout(() => { if (btn) btn.textContent = "Save diary"; }, 2200);
    }

    /* ---------- Modal (add / edit booking) ---------- */
    let editingId = null;
    function openModal(id) {
      editingId = id || null;
      const b = id ? bookings.find((x) => x.id === id) : null;
      const set = (f, v) => { const el = document.querySelector(`[data-f="${f}"]`); if (el) el.value = v ?? ""; };
      set("client_name", b?.client_name);
      set("client_email", b?.client_email);
      set("client_phone", b?.client_phone);
      set("client_company", b?.client_company);
      set("brand", b?.brand);
      set("service", b?.service);
      set("shoot_date", b?.shoot_date ? new Date(b.shoot_date).toISOString().slice(0, 16) : "");
      set("location", b?.location);
      set("amount_gbp", b?.amount_pence != null ? (b.amount_pence / 100).toString() : "");
      set("notes", b?.notes);
      set("property_address", b?.property_address);
      set("gallery_url", b?.gallery_url);
      set("gallery_email", b?.gallery_email);
      set("gallery_pin", b?._pin || "");
      loadGalleryPin(b);
      set("store_url", b?.store_url);
      set("tour_360_url", "");
      loadTourLink(b);
      set("download_cap", b?.download_cap != null ? String(b.download_cap) : "");
      set("gallery_expires_on", b?.gallery_expires_on ? String(b.gallery_expires_on).slice(0, 10) : "");
      const arch = document.getElementById("vid-archived");
      if (arch) arch.checked = !!b?.archived_at;

      const office = document.getElementById("vid-fc-office");
      if (office && office.options.length <= 1) {
        FC_OFFICES.forEach((o) => office.add(new Option(o.label, o.key)));
      }
      const tegBrand = document.getElementById("vid-teg-brand");
      if (tegBrand && tegBrand.options.length <= 1) {
        TEG_BRANDS.forEach((o) => tegBrand.add(new Option(o.label, o.key)));
      }
      // Built for this booking's route before the value is set, so a saved
      // reason lands on an option that actually exists.
      syncReasonOptions(b?.payment_route || "agent_card");
      set("payment_route", b?.payment_route || "agent_card");
      set("fc_office", b?.fc_office);
      // "Not asked" is right for a booking added by hand - nobody put the
      // question to the agent - but it has to be settable when they have said.
      set("marketing_fee_claimed", b?.marketing_fee_claimed == null ? "" : (b.marketing_fee_claimed ? "yes" : "no"));
      const conf = document.getElementById("vid-fee-confirmed");
      if (conf) conf.checked = !!b?.brand_fee_confirmed;
      const meta = document.getElementById("vid-fee-meta");
      if (meta) {
        meta.textContent = b?.brand_fee_confirmed && b?.brand_fee_confirmed_at
          ? `Confirmed ${new Date(b.brand_fee_confirmed_at).toLocaleDateString("en-GB")}${b.brand_fee_confirmed_by ? " by " + b.brand_fee_confirmed_by : ""}.`
          : "";
      }
      set("teg_brand", b?.teg_brand);
      set("teg_reason", b?.teg_reason);
      set("teg_reason_other", b?.teg_reason_other);
      const tegReasonOtherWrap = document.getElementById("vid-teg-reason-other-wrap");
      if (tegReasonOtherWrap) tegReasonOtherWrap.hidden = (b?.teg_reason || "") !== "other";
      const paid = document.getElementById("vid-paid");
      if (paid) paid.checked = !!b?.paid_at;
      const payStatus = document.getElementById("vid-pay-status");
      if (payStatus) {
        payStatus.textContent = b?.paid_at
          ? `Paid ${new Date(b.paid_at).toLocaleDateString("en-GB")}.`
          : "Not paid yet. Raise the invoice from Invoicing with card payment switched on, so the client gets a pay link.";
      }
      syncPaymentRoute();
      checkGalleryEmail();
      prefillStudioLocation();
      // Nobody knows the gallery or the payment state at the point of booking.
      const creating = !b;
      const payBlock = document.getElementById("vid-paid-block");
      const delBlock = document.getElementById("vid-delivery-block");
      if (payBlock) payBlock.hidden = creating;
      if (delBlock) delBlock.hidden = creating;
      document.getElementById("vid-modal-title").textContent = b ? "Edit booking" : "New booking";
      document.getElementById("vid-delete").hidden = !b;
      document.getElementById("vid-modal").hidden = false;
    }
    function closeModal() { document.getElementById("vid-modal").hidden = true; editingId = null; }

    /* The client downloads from Pixieset with their email address and the PIN,
       so the gallery email has to be the one they will actually type. If we mail
       the PIN somewhere else they simply cannot download, and we would never
       find out - the failure happens inside Pixieset, not here. A mismatch is
       sometimes deliberate, so this warns rather than blocks. */
    /* A Content Studio shoot is at our studio, every time. Fill it in rather
       than leaving Jack to type the same address - but only when the field is
       empty, so a deliberate change is never overwritten. */
    function prefillStudioLocation() {
      const locEl = document.querySelector('[data-f="location"]');
      const svcEl = document.querySelector('[data-f="service"]');
      if (!locEl || !svcEl || locEl.value.trim()) return;
      if (/content|studio/i.test(svcEl.value)) locEl.value = STUDIO_LOCATION;
    }

    /* The PIN lives in videography_gallery_pins, not on the booking. RLS is
       row-level, so a member reading their own booking row would have been able
       to read their own PIN before paying - which is the one thing the whole
       delivery design rests on. A separate admin-only table is the only way to
       say "your row, but not that field". See supabase/videography_rls.sql. */
    async function loadGalleryPin(b) {
      const el = document.querySelector('[data-f="gallery_pin"]');
      if (!el || !b) return;
      const { data } = await supabase.from("videography_gallery_pins").select("pin").eq("booking_id", b.id).maybeSingle();
      el.value = (data && data.pin) || "";
      b._pin = el.value;
    }

    async function saveGalleryPin(bookingId, pin) {
      if (!bookingId) return;
      const value = (pin || "").trim();
      const { error } = value
        ? await supabase.from("videography_gallery_pins").upsert({ booking_id: bookingId, pin: value, updated_at: new Date().toISOString() })
        : await supabase.from("videography_gallery_pins").delete().eq("booking_id", bookingId);
      if (error) alert("The booking saved, but the PIN didn't: " + error.message);
      const b = bookings.find((x) => x.id === bookingId);
      if (b) b._pin = value;
    }

    /* The 360 tour link, same reasoning as the PIN just above: it lives in
       videography_tour_links, not on the booking, so it cannot be read by
       the client's own row-level access before they've paid. */
    async function loadTourLink(b) {
      const el = document.querySelector('[data-f="tour_360_url"]');
      if (!el || !b) return;
      const { data } = await supabase.from("videography_tour_links").select("url").eq("booking_id", b.id).maybeSingle();
      el.value = (data && data.url) || "";
      b._tour_url = el.value;
    }

    async function saveTourLink(bookingId, tourUrl) {
      if (!bookingId) return;
      const value = (tourUrl || "").trim();
      const { error } = value
        ? await supabase.from("videography_tour_links").upsert({ booking_id: bookingId, url: value, updated_at: new Date().toISOString() })
        : await supabase.from("videography_tour_links").delete().eq("booking_id", bookingId);
      if (error) alert("The booking saved, but the 360 tour link didn't: " + error.message);
      const b = bookings.find((x) => x.id === bookingId);
      if (b) b._tour_url = value;
    }

    function checkGalleryEmail() {
      const warn = document.getElementById("vid-email-warn");
      if (!warn) return;
      const g = (document.querySelector('[data-f="gallery_email"]')?.value || "").trim().toLowerCase();
      const c = (document.querySelector('[data-f="client_email"]')?.value || "").trim().toLowerCase();
      const clash = g && c && g !== c;
      warn.hidden = !clash;
      if (clash) warn.textContent = `Different to the booking email (${c}). The PIN goes to this address, so make sure it's the one the gallery was set up with.`;
    }

    /* Pixieset holds a gallery about three months. Defaulting the date means one
       less thing to remember; a wrong one means the expiry warning either never
       fires or fires too early. Jack can still overwrite it. */
    function defaultGalleryExpiry() {
      const el = document.querySelector('[data-f="gallery_expires_on"]');
      const url = (document.querySelector('[data-f="gallery_url"]')?.value || "").trim();
      if (!el || el.value || !url) return;
      const shoot = document.querySelector('[data-f="shoot_date"]')?.value;
      const from = shoot ? new Date(shoot) : new Date();
      if (isNaN(from)) return;
      from.setMonth(from.getMonth() + 3);
      el.value = from.toISOString().slice(0, 10);
    }

    /* Brand-invoiced jobs need the Fine & Country office confirmed before we
       invoice against a fee we have not verified is being held. It gates the
       money, not the shoot - so this warns rather than blocks. */
    function syncPaymentRoute() {
      const route = document.querySelector('[data-f="payment_route"]')?.value || "agent_card";
      const brand = route === "brand_invoice";
      const teg = route === "brand_invoice_teg";
      const smm = route === "smm_package";
      const bBlock = document.getElementById("vid-brand-block");
      const tBlock = document.getElementById("vid-teg-block");
      const cBlock = document.getElementById("vid-card-block");
      if (bBlock) bBlock.hidden = !brand;
      if (tBlock) tBlock.hidden = !(teg || smm);
      if (cBlock) cBlock.hidden = brand || teg || smm;
      // Same brand list, different reason list. Rebuilt on every switch so a
      // reason picked under one route cannot survive into the other.
      const tHint = document.getElementById("vid-teg-hint");
      const sHint = document.getElementById("vid-smm-hint");
      if (tHint) tHint.hidden = !teg;
      if (sHint) sHint.hidden = !smm;
      if (teg || smm) syncReasonOptions(route);
      const warn = document.getElementById("vid-fee-warn");
      if (warn) {
        const office = document.querySelector('[data-f="fc_office"]')?.value;
        const confirmed = document.getElementById("vid-fee-confirmed")?.checked;
        const missing = brand && (!office || !confirmed);
        warn.hidden = !missing;
        if (missing) {
          warn.textContent = !office
            ? "Name the office holding the fee before invoicing."
            : "Not yet confirmed with Fine & Country. Invoicing against an unverified fee is the thing this check exists to stop.";
        }
      }
      const reasonOtherWrap = document.getElementById("vid-teg-reason-other-wrap");
      if (reasonOtherWrap) {
        reasonOtherWrap.hidden = smm || document.querySelector('[data-f="teg_reason"]')?.value !== "other";
      }
    }

    /* The reason list belongs to the route: "Included in the SMM package" must
       never be offered on a TEG invoice, and the TEG reasons must never be
       offered on a package shoot. Keeps the current value if it is still on
       the menu, so reopening a saved booking does not silently blank it. */
    function syncReasonOptions(route) {
      const sel = document.getElementById("vid-teg-reason");
      if (!sel) return;
      const want = reasonsForRoute(route);
      const same = sel.options.length === want.length + 1
        && want.every((o, i) => sel.options[i + 1]?.value === o.key);
      if (same) return;
      const had = sel.value;
      sel.innerHTML = "";
      sel.add(new Option("— Select —", ""));
      want.forEach((o) => sel.add(new Option(o.label, o.key)));
      sel.value = want.some((o) => o.key === had) ? had
        : (route === "smm_package" ? SMM_REASON.key : "");
    }

    async function saveBooking() {
      const get = (f) => { const el = document.querySelector(`[data-f="${f}"]`); return el ? el.value.trim() : ""; };
      const name = get("client_name");
      if (!name) { alert("Client name is required."); return; }
      const gbp = get("amount_gbp");
      const payload = {
        client_name: name,
        client_email: get("client_email") || null,
        client_phone: get("client_phone") || null,
        client_company: get("client_company") || null,
        brand: get("brand") || null,
        service: get("service") || null,
        shoot_date: get("shoot_date") ? new Date(get("shoot_date")).toISOString() : null,
        location: get("location") || null,
        amount_pence: gbp ? Math.round(parseFloat(gbp) * 100) : null,
        notes: get("notes") || null,
        property_address: get("property_address") || null,
        payment_route: get("payment_route") || "agent_card",
        fc_office: get("fc_office") || null,
        marketing_fee_claimed: get("marketing_fee_claimed") === "" ? null : get("marketing_fee_claimed") === "yes",
        brand_fee_confirmed: !!document.getElementById("vid-fee-confirmed")?.checked,
        // Stamp who confirmed and when, the first time it is ticked.
        brand_fee_confirmed_at: document.getElementById("vid-fee-confirmed")?.checked
          ? (bookings.find((x) => x.id === editingId)?.brand_fee_confirmed_at || new Date().toISOString())
          : null,
        brand_fee_confirmed_by: document.getElementById("vid-fee-confirmed")?.checked
          ? (bookings.find((x) => x.id === editingId)?.brand_fee_confirmed_by || adminEmail || null)
          : null,
        teg_brand: get("teg_brand") || null,
        teg_reason: get("teg_reason") || null,
        teg_reason_other: get("teg_reason") === "other" ? (get("teg_reason_other") || null) : null,
        paid_at: document.getElementById("vid-paid")?.checked
          ? (bookings.find((x) => x.id === editingId)?.paid_at || new Date().toISOString())
          : null,
        gallery_url: get("gallery_url") || null,
        gallery_email: get("gallery_email") || null,

        store_url: get("store_url") || null,
        download_cap: get("download_cap") === "" ? null : Math.max(0, Math.round(Number(get("download_cap")))),
        gallery_expires_on: get("gallery_expires_on") || null,
        // A tick records WHEN the archive went up; unticking clears it again.
        archived_at: document.getElementById("vid-archived")?.checked
          ? (bookings.find((x) => x.id === editingId)?.archived_at || new Date().toISOString())
          : null,
      };
      const pinValue = get("gallery_pin");
      const tourUrlValue = get("tour_360_url");
      let savedId = editingId;
      const btn = document.getElementById("vid-save");
      if (btn) btn.textContent = "Saving…";
      if (editingId) {
        const before = bookings.find((x) => x.id === editingId) || {};
        const movedLocation = (before.location || "") !== (payload.location || "")
          || (before.property_address || "") !== (payload.property_address || "");
        const { error } = await supabase.from("videography_bookings").update(payload).eq("id", editingId);
        if (error) { alert("Save failed: " + error.message); if (btn) btn.textContent = "Save booking"; return; }
        Object.assign(bookings.find((x) => x.id === editingId), payload);
        // A location Jack can't see on the day is no use to him.
        if (movedLocation && WORKER_URL) {
          try {
            const token = await authToken();
            await fetch(`${WORKER_URL}/booking/location`, {
              method: "POST",
              headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
              body: JSON.stringify({ booking_id: editingId }),
            });
          } catch (_) { /* the booking saved; the diary can be nudged again */ }
        }
      } else {
        payload.stage = "booked";
        const { data, error } = await supabase.from("videography_bookings").insert(payload).select().single();
        if (error) { alert("Save failed: " + error.message); if (btn) btn.textContent = "Save booking"; return; }
        bookings.unshift(data);
        savedId = data && data.id;
      }
      // Only ever the booking we just saved. Falling back to "the first one in
      // the list" could have deleted a different booking's PIN.
      if (savedId) await saveGalleryPin(savedId, pinValue);
      if (savedId) await saveTourLink(savedId, tourUrlValue);
      // The public booking flow has always written the client into the CRM; a
      // booking added by hand never did. Same endpoint, same tag rules, and
      // upsert_contact merges rather than duplicating an existing card.
      if (savedId && payload.client_email && WORKER_URL) {
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/booking/contact`, {
            method: "POST",
            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
            body: JSON.stringify({ booking_id: savedId }),
          });
          if (!res.ok) {
            const d = await res.json().catch(() => ({}));
            alert("The booking saved, but the contact card didn't sync: " + (d.error || res.status));
          }
        } catch (err) {
          alert("The booking saved, but the contact card didn't sync: " + err.message);
        }
      }
      if (btn) btn.textContent = "Save booking";
      closeModal();
      renderClients(document.getElementById("vid-client-search")?.value || "");
      if (candId) renderCandidate();
      populateDeliverBookings();
    }

    async function deleteBooking() {
      if (!editingId) return;
      if (!confirm("Delete this booking? This can't be undone.")) return;
      const deletedId = editingId;
      const { error } = await supabase.from("videography_bookings").delete().eq("id", deletedId);
      if (error) { alert("Delete failed: " + error.message); return; }
      bookings = bookings.filter((x) => x.id !== deletedId);
      closeModal();
      if (candId === deletedId) { candId = null; showPanel("clients"); }
      renderClients(document.getElementById("vid-client-search")?.value || "");
      populateDeliverBookings();
    }

    /* ---------- Deliver (R2 uploads attached to a booking) ---------- */
    function fmtBytes(n) {
      if (n == null) return "—";
      const u = ["B", "KB", "MB", "GB", "TB"]; let i = 0; let v = Number(n);
      while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }
      return v.toFixed(v >= 10 || i === 0 ? 0 : 1) + " " + u[i];
    }
    function kindFromType(t) {
      if (!t) return "other";
      if (t.startsWith("video/")) return "video";
      if (t.startsWith("image/")) return "image";
      return "other";
    }
    async function authToken() {
      const { data } = await supabase.auth.getSession();
      return data.session ? data.session.access_token : "";
    }
    function deliverBooking() {
      const sel = document.getElementById("vid-deliver-booking");
      return sel ? sel.value : "";
    }
    function populateDeliverBookings() {
      const sel = document.getElementById("vid-deliver-booking");
      if (!sel) return;
      const keep = sel.value;
      const stageLabel = (k) => (STAGES.find((s) => s.key === k) || {}).label || k;
      sel.innerHTML = '<option value="">— Select a client / shoot —</option>' +
        bookings.map((b) => `<option value="${b.id}">${escapeHtml(b.client_name)}${b.client_company ? " · " + escapeHtml(b.client_company) : ""} — ${escapeHtml(stageLabel(b.stage))}</option>`).join("");
      if (keep) sel.value = keep;
    }

    // The set of category drop-boxes (also used to build the recategorise
    // dropdowns and to know which file-list groups to show).
    // The categories for the booking currently open in Deliver work. Read at
    // the moment it is needed - it used to be captured once at page load from
    // the category boxes, which are now rendered per booking, so by then there
    // were none and every dropdown came out empty.
    function deliverCats() {
      const b = bookings.find((x) => x.id === deliverBooking());
      return b ? archiveFoldersFor(b.service_type, b.service) : [];
    }

    function initDeliver() {
      const grid = document.getElementById("vid-catgrid");
      const sel = document.getElementById("vid-deliver-booking");
      if (!grid) return;

      const connected = Boolean(WORKER_URL);
      const configNote = document.getElementById("vid-deliver-config");
      const r2pill = document.getElementById("vid-r2-pill");
      const r2meta = document.getElementById("vid-r2-meta");
      if (configNote) configNote.hidden = connected;
      if (!connected) grid.classList.add("is-disabled");
      if (connected && r2pill) { r2pill.textContent = "Connected"; r2pill.classList.remove("is-pending"); r2pill.classList.add("is-paid"); }
      if (connected && r2meta) r2meta.textContent = "Worker connected.";

      populateDeliverBookings();

      // The archive box follows the booking picker.
      const syncArchive = () => renderArchiveBox(bookings.find((x) => x.id === deliverBooking()) || null);
      sel?.addEventListener("change", syncArchive);
      syncArchive();

      document.getElementById("vid-arch-save")?.addEventListener("click", () => {
        const b = bookings.find((x) => x.id === deliverBooking());
        if (b) saveArchive(b);
      });
      document.getElementById("vid-arch-folder")?.addEventListener("input", () => {
        const b = bookings.find((x) => x.id === deliverBooking());
        if (b) showArchivePath(b);
      });
      document.getElementById("vid-arch-copy")?.addEventListener("click", async () => {
        const input = document.getElementById("vid-arch-folder");
        try { await navigator.clipboard.writeText(input.value); document.getElementById("vid-arch-msg").textContent = "Folder name copied."; }
        catch (_) { input.select(); document.getElementById("vid-arch-msg").textContent = "Selected — press Cmd/Ctrl+C to copy."; }
      });

      function guard() {
        if (!connected) { alert("Upload backend isn't connected yet — deploy the Worker and set PUBLIC_R2_WORKER_URL."); return false; }
        if (!deliverBooking()) { alert("Pick a booking to deliver to first."); return false; }
        return true;
      }

      // Boxes are rebuilt whenever the booking changes, so their wiring lives in
      // its own function rather than running once at init.
      deliverGuard = guard;
      wireCatBoxes();

      sel?.addEventListener("change", () => {
        const b = bookings.find((x) => x.id === deliverBooking()) || null;
        renderCatBoxes(b);
        loadDeliverFiles();
      });

      // Client-delivery panel
      document.getElementById("vid-dlv-base")?.addEventListener("input", recomputeDlvTotal);
      document.getElementById("vid-dlv-add-extra")?.addEventListener("click", () => addExtraRow("", null));
      document.getElementById("vid-dlv-save")?.addEventListener("click", saveDelivery);
      document.getElementById("vid-dlv-copy")?.addEventListener("click", copyDeliveryLink);
      document.getElementById("vid-dlv-sent")?.addEventListener("click", () => setDeliveryStatus("sent"));
      document.getElementById("vid-dlv-paid")?.addEventListener("click", () => setDeliveryStatus("paid"));
    }

    function handleFiles(fileList, category) {
      const bookingId = deliverBooking();
      if (!WORKER_URL || !bookingId) return;
      Array.from(fileList || []).forEach((file) => uploadFile(file, bookingId, category || null));
    }

    function uploadRowUI(file, category) {
      const wrap = document.getElementById("vid-uploads");
      // This runs before uploadFile's try block, so a missing container threw
      // where nothing was catching it - the click did nothing at all, with no
      // row, no error and no clue. Fail loudly instead.
      if (!wrap) { alert("The uploads area is missing from this page — reload, and tell Claude if it persists."); throw new Error("vid-uploads missing"); }
      const row = document.createElement("div");
      row.className = "vid-up";
      row.innerHTML =
        `<div class="vid-up-top"><span class="vid-up-name"></span><span class="vid-up-stat">Starting…</span></div>` +
        `<div class="vid-up-bar"><div class="vid-up-fill"></div></div>`;
      row.querySelector(".vid-up-name").textContent = (category ? category + " · " : "") + file.name;
      wrap.prepend(row);
      return {
        setStat: (t, cls) => { const s = row.querySelector(".vid-up-stat"); s.textContent = t; s.className = "vid-up-stat" + (cls ? " " + cls : ""); },
        setPct: (p) => { row.querySelector(".vid-up-fill").style.width = Math.round(p) + "%"; },
        done: () => row.querySelector(".vid-up-fill").classList.add("is-done"),
        error: () => row.querySelector(".vid-up-fill").classList.add("is-error"),
        remove: () => row.remove(),
      };
    }

    function putPart(token, key, uploadId, partNumber, blob, onProgress) {
      return new Promise((resolve, reject) => {
        const xhr = new XMLHttpRequest();
        const u = `${WORKER_URL}/part?key=${encodeURIComponent(key)}&uploadId=${encodeURIComponent(uploadId)}&partNumber=${partNumber}`;
        xhr.open("PUT", u);
        xhr.setRequestHeader("Authorization", "Bearer " + token);
        xhr.upload.onprogress = (e) => { if (e.lengthComputable) onProgress(e.loaded); };
        xhr.onload = () => {
          if (xhr.status >= 200 && xhr.status < 300) {
            try { resolve(JSON.parse(xhr.responseText)); } catch (_) { reject(new Error("Bad part response")); }
          } else reject(new Error("Part " + partNumber + " failed (" + xhr.status + ")"));
        };
        xhr.onerror = () => reject(new Error("Network error on part " + partNumber));
        xhr.send(blob);
      });
    }

    async function uploadFile(file, bookingId, category) {
      const ui = uploadRowUI(file, category);
      try {
        const token = await authToken();
        if (!token) throw new Error("Not signed in");
        ui.setStat("Preparing…");
        const cRes = await fetch(`${WORKER_URL}/create`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          // Send the folder so the file lands somewhere a person can find,
          // rather than under a booking id nobody can read.
          body: JSON.stringify({
            bookingId, fileName: file.name,
            contentType: file.type || "application/octet-stream",
            folder: archiveFolderFor(bookingId), category,
          }),
        });
        if (!cRes.ok) throw new Error("Create failed (" + cRes.status + ")");
        const { key, uploadId } = await cRes.json();

        const total = file.size;
        const partCount = Math.max(1, Math.ceil(total / PART_SIZE));
        const parts = [];
        let baseLoaded = 0;
        for (let i = 0; i < partCount; i++) {
          const start = i * PART_SIZE;
          const blob = file.slice(start, Math.min(start + PART_SIZE, total));
          const partNumber = i + 1;
          let attempt = 0;
          for (;;) {
            try {
              const res = await putPart(token, key, uploadId, partNumber, blob, (loaded) => {
                const pct = total ? ((baseLoaded + loaded) / total) * 100 : 0;
                ui.setPct(pct);
                ui.setStat("Uploading " + Math.round(pct) + "% · part " + partNumber + "/" + partCount);
              });
              parts.push({ partNumber, etag: res.etag });
              baseLoaded += blob.size;
              ui.setPct((baseLoaded / total) * 100);
              break;
            } catch (err) {
              if (++attempt >= 3) throw err;
              ui.setStat("Retrying part " + partNumber + " (" + attempt + ")…");
              await new Promise((r) => setTimeout(r, 800 * attempt));
            }
          }
        }

        ui.setStat("Finalising…");
        const fRes = await fetch(`${WORKER_URL}/complete`, {
          method: "POST",
          headers: { "Content-Type": "application/json", Authorization: "Bearer " + token },
          body: JSON.stringify({ key, uploadId, parts }),
        });
        if (!fRes.ok) throw new Error("Complete failed (" + fRes.status + ")");

        // The file is in R2 by this point; this row is what makes it findable.
        // The error was previously discarded, so a rejected row - RLS, a missing
        // column, anything - still reported "done" and then simply never
        // appeared. An upload that isn't recorded is a lost file, so it says so.
        const { error: rowErr } = await supabase.from("videography_deliverables").insert({
          booking_id: bookingId, file_name: file.name, r2_key: key,
          size_bytes: file.size, content_type: file.type || null, kind: kindFromType(file.type),
          category: category || null,
        });
        if (rowErr) throw new Error("Uploaded, but not recorded: " + rowErr.message);

        ui.setPct(100); ui.done(); ui.setStat(fmtBytes(file.size) + " · done", "is-done");
        setTimeout(() => ui.remove(), 2500);
        if (deliverBooking() === bookingId) loadDeliverFiles();
      } catch (err) {
        ui.error(); ui.setStat((err && err.message) || "Upload failed", "is-error");
      }
    }

    // Reset the per-box counts on the category drop-boxes.
    function setCatCounts(counts) {
      document.querySelectorAll(".vid-catbox").forEach((box) => {
        const cat = box.getAttribute("data-category");
        const el = box.querySelector("[data-cat-count]");
        if (el) el.textContent = String(counts[cat] || 0);
      });
    }

    function catOptions(selected) {
      return deliverCats().map((c) =>
        `<option value="${escapeHtml(c)}"${c === selected ? " selected" : ""}>${escapeHtml(c)}</option>`
      ).join("");
    }

    // Distinguishes "nothing uploaded" from "not allowed to see it".
    let adminReadOk = null;
    async function canReadDeliverables() {
      if (adminReadOk !== null) return adminReadOk;
      const { data } = await supabase.rpc("is_admin");
      adminReadOk = data === true;
      return adminReadOk;
    }

    async function loadDeliverFiles() {
      const listEl = document.getElementById("vid-files-list");
      const emptyEl = document.getElementById("vid-files-empty");
      const bookingId = deliverBooking();
      if (!listEl) return;
      if (!bookingId) { listEl.innerHTML = ""; setCatCounts({}); if (emptyEl) { emptyEl.hidden = false; emptyEl.textContent = "Select a booking to see its delivered files."; } return; }
      if (emptyEl) { emptyEl.hidden = false; emptyEl.textContent = "Loading…"; }
      const { data, error } = await supabase
        .from("videography_deliverables").select("*")
        .eq("booking_id", bookingId).order("created_at", { ascending: false });
      if (error) { if (emptyEl) emptyEl.textContent = "Couldn't load files: " + error.message; listEl.innerHTML = ""; return; }
      // RLS returns an empty list rather than an error when you're not allowed,
      // so "none" and "not permitted" look identical. Check which it is.
      if ((!data || !data.length) && !(await canReadDeliverables())) {
        setCatCounts({});
        if (emptyEl) { emptyEl.hidden = false; emptyEl.textContent = "You don't have permission to read delivered files — your account needs a row in public.admins."; }
        listEl.innerHTML = "";
        return;
      }
      if (!data || !data.length) { setCatCounts({}); if (emptyEl) { emptyEl.hidden = false; emptyEl.textContent = "No files delivered for this booking yet."; } listEl.innerHTML = ""; return; }
      if (emptyEl) emptyEl.hidden = true;

      // Group by category, in the drop-box order, with anything unknown last.
      const counts = {};
      data.forEach((f) => { const c = f.category || "Other"; counts[c] = (counts[c] || 0) + 1; });
      setCatCounts(counts);
      const order = deliverCats().slice();
      Object.keys(counts).forEach((c) => { if (!order.includes(c)) order.push(c); });

      let html = "";
      order.forEach((cat) => {
        const rows = data.filter((f) => (f.category || "Other") === cat);
        if (!rows.length) return;
        html += `<div class="vid-fgroup">${escapeHtml(cat)} <span class="vid-fgroup-count">· ${rows.length}</span></div>`;
        html += rows.map((f) => `
          <div class="vid-frow" data-id="${f.id}" data-key="${escapeHtml(f.r2_key)}">
            <div class="vid-frow-name">${escapeHtml(f.file_name)}</div>
            <div class="vid-frow-cat"><select data-recat>${catOptions(f.category || "Other")}</select></div>
            <div class="vid-frow-meta">${escapeHtml(f.kind || "file")}</div>
            <div class="vid-frow-meta">${fmtBytes(f.size_bytes)}</div>
            <div class="vid-frow-act"><button class="vid-frow-del" data-del>Delete</button></div>
          </div>`).join("");
      });
      listEl.innerHTML = html;
      listEl.querySelectorAll("[data-del]").forEach((btn) => btn.addEventListener("click", () => deleteDeliverable(btn.closest(".vid-frow"))));
      listEl.querySelectorAll("[data-recat]").forEach((seln) => seln.addEventListener("change", () => {
        const row = seln.closest(".vid-frow");
        recategorise(row && row.getAttribute("data-id"), seln.value);
      }));
    }

    async function recategorise(id, category) {
      if (!id) return;
      // Errors were discarded here too, so a refused update reloaded the list
      // and quietly showed the old value back - which reads as "the dropdown
      // does nothing".
      const { error } = await supabase.from("videography_deliverables")
        .update({ category: category || null }).eq("id", id);
      if (error) { alert("Couldn't move that file: " + error.message); return; }
      loadDeliverFiles();
    }

    async function deleteDeliverable(row) {
      if (!row) return;
      const id = row.getAttribute("data-id");
      const key = row.getAttribute("data-key");
      if (!confirm("Delete this file? It will be removed from storage.")) return;
      const token = await authToken();
      try {
        await fetch(`${WORKER_URL}/object?key=${encodeURIComponent(key)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } });
      } catch (_) { /* still remove the record */ }
      await supabase.from("videography_deliverables").delete().eq("id", id);
      loadDeliverFiles();
    }

    /* ---------- Client delivery (gallery link + paywall) ---------- */
    let currentDelivery = null;

    function genToken() {
      try { return crypto.randomUUID().replace(/-/g, ""); }
      catch (_) { return "d" + Date.now().toString(36) + Math.floor(Math.random() * 1e9).toString(36); }
    }
    function dlvExtrasFromDOM() {
      return Array.from(document.querySelectorAll("#vid-dlv-extra-rows .vid-dlv-extra")).map((row) => ({
        label: row.querySelector("[data-x-label]").value.trim(),
        amount_pence: Math.round((parseFloat(row.querySelector("[data-x-amt]").value) || 0) * 100),
      })).filter((e) => e.label || e.amount_pence);
    }
    function addExtraRow(label, pence) {
      const wrap = document.getElementById("vid-dlv-extra-rows");
      const row = document.createElement("div");
      row.className = "vid-dlv-extra";
      row.innerHTML = `<input type="text" data-x-label placeholder="e.g. Travel" /><input type="number" data-x-amt min="0" step="0.01" placeholder="£" /><button type="button" class="vid-dlv-extra-del" aria-label="Remove">&times;</button>`;
      row.querySelector("[data-x-label]").value = label || "";
      if (pence != null) row.querySelector("[data-x-amt]").value = (pence / 100).toString();
      row.querySelector("[data-x-amt]").addEventListener("input", recomputeDlvTotal);
      row.querySelector(".vid-dlv-extra-del").addEventListener("click", () => { row.remove(); recomputeDlvTotal(); });
      wrap.appendChild(row);
    }
    function recomputeDlvTotal() {
      const base = Math.round((parseFloat(document.getElementById("vid-dlv-base").value) || 0) * 100);
      const extras = dlvExtrasFromDOM().reduce((s, e) => s + e.amount_pence, 0);
      document.getElementById("vid-dlv-total").textContent = gbpFromPence(base + extras);
    }
    function setDeliveryStatusUI(status, token) {
      const pill = document.getElementById("vid-dlv-status");
      const copy = document.getElementById("vid-dlv-copy");
      const sent = document.getElementById("vid-dlv-sent");
      const paid = document.getElementById("vid-dlv-paid");
      const linkEl = document.getElementById("vid-dlv-link");
      pill.textContent = { draft: "Draft", sent: "Sent", paid: "Paid" }[status] || "Not created";
      pill.className = "enquiry-status-pill " + (status === "paid" ? "is-paid" : "is-pending");
      const hasLink = Boolean(token);
      copy.hidden = !hasLink; sent.hidden = !hasLink; paid.hidden = !hasLink;
      if (hasLink) {
        linkEl.textContent = `${location.origin}/deliver?d=${token}`;
        linkEl.hidden = false;
        sent.textContent = status === "sent" ? "Re-mark sent" : "Mark sent";
        paid.textContent = status === "paid" ? "Paid ✓" : "Mark paid (manual)";
      } else linkEl.hidden = true;
    }
    async function loadDelivery(bookingId) {
      const card = document.getElementById("vid-delivery");
      if (!card) return;
      if (!bookingId) { card.hidden = true; currentDelivery = null; return; }
      const booking = bookings.find((b) => b.id === bookingId);
      const { data } = await supabase.from("videography_deliveries").select("*").eq("booking_id", bookingId).maybeSingle();
      currentDelivery = data || null;
      document.getElementById("vid-dlv-teaser").value = data ? data.teaser_count : 3;
      const basePence = data ? data.base_pence : (booking && booking.amount_pence) || 0;
      document.getElementById("vid-dlv-base").value = basePence ? (basePence / 100).toString() : "";
      const rows = document.getElementById("vid-dlv-extra-rows");
      rows.innerHTML = "";
      (data && Array.isArray(data.extras) ? data.extras : []).forEach((e) => addExtraRow(e.label, e.amount_pence));
      recomputeDlvTotal();
      setDeliveryStatusUI(data ? data.status : null, data ? data.token : null);
      card.hidden = false;
    }
    async function saveDelivery() {
      const bookingId = deliverBooking();
      if (!bookingId) { alert("Pick a booking first."); return; }
      const booking = bookings.find((b) => b.id === bookingId);
      const base = Math.round((parseFloat(document.getElementById("vid-dlv-base").value) || 0) * 100);
      const extras = dlvExtrasFromDOM();
      const total = base + extras.reduce((s, e) => s + e.amount_pence, 0);
      const payload = {
        booking_id: bookingId,
        token: (currentDelivery && currentDelivery.token) || genToken(),
        client_name: booking ? booking.client_name : null,
        client_email: booking ? booking.client_email : null,
        teaser_count: parseInt(document.getElementById("vid-dlv-teaser").value, 10) || 0,
        base_pence: base, extras, total_pence: total,
        status: (currentDelivery && currentDelivery.status) || "draft",
      };
      const btn = document.getElementById("vid-dlv-save");
      btn.textContent = "Saving…";
      const { data, error } = await supabase.from("videography_deliveries").upsert(payload, { onConflict: "booking_id" }).select().single();
      btn.textContent = "Save & create link";
      if (error) { alert("Couldn't save delivery: " + error.message); return; }
      currentDelivery = data;
      setDeliveryStatusUI(data.status, data.token);
    }
    async function setDeliveryStatus(status) {
      if (!currentDelivery) return;
      const patch = { status };
      if (status === "sent") patch.sent_at = new Date().toISOString();
      if (status === "paid") patch.paid_at = new Date().toISOString();
      const { data, error } = await supabase.from("videography_deliveries").update(patch).eq("id", currentDelivery.id).select().single();
      if (error) { alert("Couldn't update: " + error.message); return; }
      currentDelivery = data;
      setDeliveryStatusUI(data.status, data.token);
      // Paid → the job completes itself.
      if (status === "paid") {
        const b = bookings.find((x) => x.id === currentDelivery.booking_id);
        if (b && b.stage !== "delivered") {
          b.stage = "delivered";
          await supabase.from("videography_bookings").update({ stage: "delivered" }).eq("id", b.id);
          renderClients(document.getElementById("vid-client-search")?.value || "");
          if (candId === b.id) renderCandidate();
        }
      }
    }
    function copyDeliveryLink() {
      if (!currentDelivery || !navigator.clipboard) return;
      navigator.clipboard.writeText(`${location.origin}/deliver?d=${currentDelivery.token}`).then(() => {
        const b = document.getElementById("vid-dlv-copy"); const t = b.textContent;
        b.textContent = "Copied ✓"; setTimeout(() => (b.textContent = t), 1500);
      });
    }

    async function init365Status() {
      const pill = document.getElementById("vid-365-pill");
      const meta = document.getElementById("vid-365-meta");
      if (!pill) return;
      if (!WORKER_URL) { pill.textContent = "Not connected"; if (meta) meta.textContent = "Set PUBLIC_R2_WORKER_URL + deploy the Worker."; return; }
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/ms/status`, { headers: { Authorization: "Bearer " + token } });
        const d = await res.json();
        if (d && d.connected) {
          pill.textContent = "Connected"; pill.classList.remove("is-pending"); pill.classList.add("is-paid");
          if (meta) meta.textContent = `Linked to ${d.name || d.upn || "Jack's calendar"}.`;
        } else {
          pill.textContent = "Not connected";
          if (meta) meta.textContent = (d && d.error) ? ("Graph error: " + d.error) : "Check the Worker's MS_* secrets + Exchange policy.";
        }
      } catch (e) {
        pill.textContent = "Not connected";
        if (meta) meta.textContent = "Couldn't reach the Worker.";
      }
    }

    /* ---------- The rate card ----------
       One table: everything sellable, with the member price and both external
       tiers side by side. Member prices come from SERVICES (the same config the
       booking flow charges from) and external prices from RATE_CARD, so neither
       can drift from its source. */
    const RATE_SLOT = { single: 90, half: 180, full: 480, property: 480, agent: 240, discovery: 30 };
    const mins = (m) => (m >= 60 ? `${m / 60} hr${m === 60 ? "" : "s"}` : `${m} min`);
    const money = (pence) => (pence == null ? '<span class="vid-rate-na">Not set</span>' : escapeHtml(gbpFromPence(pence)));
    const labour = (r) => {
      if (!r) return "";
      const bits = [];
      if (r.film) bits.push(`${r.film} filming`);
      if (r.edit) bits.push(`${r.edit} editing`);
      if (r.brief) bits.push(`${r.brief} brief`);
      if (r.amends) bits.push(`${r.amends} amends`);
      if (r.design) bits.push(`${r.design} design`);
      return bits.join(" · ");
    };

    function renderRateCard() {
      const t = document.getElementById("vid-rate-table");
      if (!t) return;

      // Grouped, so the service name spans its rows rather than repeating.
      const groups = [];

      const cs = SERVICES["content-studio"];
      groups.push({
        name: cs.name,
        note: "Members book online. Non-members are routed to Register Interest, so the external prices are quoted by hand.",
        rows: cs.sessions.map((x) => {
          const r = RATE_CARD["content-studio"][x.key] || {};
          return {
            item: x.name,
            sub: r.studio_hire_pence != null ? `Studio hire ${gbpFromPence(r.studio_hire_pence)} · max ${r.max_per_day}/day` : "",
            includes: `${x.output} — ${x.desc}`,
            member: x.price_pence, std: r.ext_standard_pence, scl: r.ext_scaleable_pence,
            slot: mins(RATE_SLOT[x.key]), labour: labour(r),
          };
        }),
      });

      // Property carries the add-ons, since that is what they attach to.
      const pr = SERVICES.property;
      const propRows = Object.values(pr.packagesByTier).map((pk) => {
        const r = RATE_CARD.property[pk.key] || {};
        return {
          item: pk.name, sub: pk.key === "platinum" ? "Fine & Country" : "All other TEG brands",
          includes: pk.inclusions.join(" · "),
          member: pk.from_pence, std: r.ext_standard_pence, scl: r.ext_scaleable_pence,
          slot: mins(RATE_SLOT.property), labour: labour(r),
        };
      });
      pr.addOns.forEach((a) => propRows.push({
        item: a.name, tag: "Add-on", includes: a.note,
        same: gbpFromPence(a.price_pence) + (a.perImage ? " per image" : ""),
        slot: "Within the shoot", labour: "",
      }));
      groups.push({ name: pr.name, note: "Members book online. Non-members go to the enquiry form. Add-ons are the same price for everyone.", rows: propRows });

      const ag = SERVICES.agent;
      groups.push({
        name: ag.name,
        note: "Members may combine packages. Non-members go to the enquiry form.",
        rows: ag.packages.map((pk) => {
          const r = RATE_CARD.agent[pk.key] || {};
          return {
            item: pk.name, includes: pk.desc,
            member: pk.price_pence, std: r.ext_standard_pence, scl: r.ext_scaleable_pence,
            slot: mins(RATE_SLOT.agent), labour: labour(r),
          };
        }),
      });

      groups.push({
        name: SERVICES.discovery.name, note: "Open to anyone.",
        rows: [{ item: "Discovery call", includes: "A chat about which service fits. No obligation.",
                 same: "Free", slot: mins(RATE_SLOT.discovery), labour: "" }],
      });

      const body = groups.map((g) => g.rows.map((r, n) => {
        const first = n === 0
          ? `<td class="vid-rate-svc" rowspan="${g.rows.length}"><strong>${escapeHtml(g.name)}</strong>${g.note ? `<span class="vid-rate-note">${escapeHtml(g.note)}</span>` : ""}</td>`
          : "";
        const prices = r.same
          ? `<td class="vid-rate-price" colspan="3">${escapeHtml(r.same)}<span class="vid-rate-note">Same for everyone</span></td>`
          : `<td class="vid-rate-price">${money(r.member)}</td>
             <td class="vid-rate-price">${money(r.std)}</td>
             <td class="vid-rate-price">${money(r.scl)}</td>`;
        return `<tr${n === 0 ? ' class="is-group"' : ""}>${first}
          <td class="vid-rate-pkg">${r.tag ? `<span class="vid-rate-tag">${escapeHtml(r.tag)}</span>` : ""}${escapeHtml(r.item)}${r.sub ? `<span class="vid-rate-note">${escapeHtml(r.sub)}</span>` : ""}</td>
          <td class="vid-rate-inc">${escapeHtml(r.includes)}</td>
          ${prices}
          <td>${escapeHtml(r.slot)}</td><td>${escapeHtml(r.labour)}</td>
        </tr>`;
      }).join("")).join("");

      t.innerHTML = `<thead><tr>
          <th>Service</th><th>Package</th><th>What's included</th>
          <th>TEG brand<br><span>member</span></th>
          <th>External<br><span>standard agency</span></th>
          <th>External<br><span>scaleable agency</span></th>
          <th>Diary slot</th><th>Labour hours</th>
        </tr></thead><tbody>${body}</tbody>`;

      // Travel was a column of near-identical text. It reads better as one line.
      const foot = document.getElementById("vid-rate-foot");
      if (foot) {
        const radius = vidSettings.free_radius_miles ?? SURCHARGE_DEFAULTS.free_radius_miles;
        const rate = vidSettings.surcharge_pence_per_mile ?? SURCHARGE_DEFAULTS.pence_per_mile;
        const pc = vidSettings.base_postcode || SURCHARGE_DEFAULTS.base_postcode;
        foot.textContent = `Travel: on-location shoots (property and agent) are free within ${radius} miles of ${pc}, then ${rate}p per mile. Content Studio sessions and discovery calls carry no travel charge — the studio is ours and calls are over Teams.`;
      }
    }

    /* ---------- Settings (Jack's base postcode + travel surcharge) ---------- */
    async function initSettings() {
      // The rate card is static reference data, so draw it before touching the
      // network. It used to render after this fetch, which meant a slow or
      // failing settings query left the tables silently blank.
      try {
        const { data } = await supabase.from("videography_settings").select("*").eq("id", 1).maybeSingle();
        if (data) vidSettings = data;
      } catch (err) {
        console.error("videography settings failed to load", err);
      }
      const set = (id, v) => { const el = document.getElementById(id); if (el) el.value = v; };
      set("vid-set-postcode", vidSettings.base_postcode || "");
      set("vid-set-radius", vidSettings.free_radius_miles ?? 40);
      set("vid-set-rate", vidSettings.surcharge_pence_per_mile ?? 55);
      set("vid-set-vat", Math.round((vidSettings.vat_rate ?? 0.2) * 100));
      document.getElementById("vid-set-save")?.addEventListener("click", saveSettings);
      renderRateCard();   // again, now the travel column can show the saved figures
    }
    async function saveSettings() {
      const num = (id, d) => { const v = parseFloat(document.getElementById(id)?.value); return isNaN(v) ? d : v; };
      const payload = {
        id: 1,
        base_postcode: (document.getElementById("vid-set-postcode")?.value || "").trim().toUpperCase(),
        free_radius_miles: Math.round(num("vid-set-radius", 40)),
        surcharge_pence_per_mile: Math.round(num("vid-set-rate", 55)),
        vat_rate: num("vid-set-vat", 20) / 100,
        updated_at: new Date().toISOString(),
      };
      const status = document.getElementById("vid-set-status");
      const btn = document.getElementById("vid-set-save");
      if (btn) { btn.disabled = true; btn.textContent = "Saving…"; }
      const { error } = await supabase.from("videography_settings").upsert(payload, { onConflict: "id" });
      if (btn) { btn.disabled = false; btn.textContent = "Save settings"; }
      if (error) { if (status) { status.style.color = "#a05a3c"; status.textContent = "Couldn't save: " + error.message + " — run supabase/videography_booking_flow.sql?"; } return; }
      vidSettings = { ...vidSettings, ...payload };
      baseCoords = null; // re-geocode on next distance lookup
      if (status) { status.style.color = "#2c7a4b"; status.textContent = "Saved ✓"; setTimeout(() => (status.textContent = ""), 2200); }
    }
    async function getBaseCoords() {
      if (baseCoords) return baseCoords;
      const pc = (vidSettings.base_postcode || "NN14 1AA").replace(/\s+/g, "");
      try {
        const r = await fetch("https://api.postcodes.io/postcodes/" + encodeURIComponent(pc));
        const d = await r.json();
        if (d.result) baseCoords = { lat: d.result.latitude, lon: d.result.longitude };
      } catch (_) { /* fall through */ }
      return baseCoords || { lat: 52.3936, lon: -0.7281 };
    }

    /* ---------- Boot ---------- */
    (async () => {
      // In local dev the admin area is previewable without a login (matches the
      // other admin pages); production stays gated by requireAdmin.
      if (!import.meta.env.DEV) {
        const session = await requireAdmin();
        if (!session) return;
        // Recorded against the Fine & Country fee confirmation, so there is a
        // name attached to "yes, I checked".
        adminEmail = session.user?.email || null;
      }
      initNav();
      wireBoardViews();
      // The promo codes page is a separate route, so its cog links back here
      // with ?panel=... Honour it so returning lands where you clicked.
      const wanted = new URLSearchParams(location.search).get("panel");
      if (wanted && document.querySelector(`[data-panel="${wanted}"]`)) showPanel(wanted);
      // Draw the rate card straight away. It comes entirely from static config,
      // so it has no business sitting behind the bookings fetch below - if that
      // call is slow or fails, the tables would just stay blank with no error.
      renderRateCard();

      const [bRes, aRes] = await Promise.all([
        supabase.from("videography_bookings").select("*").order("created_at", { ascending: false }),
        supabase.from("videography_availability").select("*"),
      ]);

      bookings = bRes.error ? [] : (bRes.data || []);
      availability = aRes.error ? [] : (aRes.data || []);

      if (bRes.error) {
        const l = document.getElementById("vid-clients-loading");
        if (l) l.textContent = "Could not load clients: " + bRes.error.message + " — have you run supabase/videography.sql?";
      } else {
        await autoAdvance();
        renderClients();
        // A "link back to the booking" in an email (e.g. an edit-request
        // notification) lands here — jump straight to that candidate.
        const wantedBooking = new URLSearchParams(location.search).get("booking");
        if (wantedBooking && bookings.some((b) => b.id === wantedBooking)) openCandidate(wantedBooking);
      }
      const dl = document.getElementById("vid-diary-loading");
      if (dl) dl.remove();
      renderDiary();
      initDeliver();
      init365Status();
      initSettings();

      document.getElementById("vid-new-booking")?.addEventListener("click", () => openModal(null));
      document.getElementById("vid-save")?.addEventListener("click", saveBooking);
      document.querySelector('[data-f="gallery_email"]')?.addEventListener("input", checkGalleryEmail);
      document.querySelector('[data-f="client_email"]')?.addEventListener("input", checkGalleryEmail);
      document.querySelector('[data-f="gallery_url"]')?.addEventListener("blur", defaultGalleryExpiry);
      document.querySelector('[data-f="service"]')?.addEventListener("blur", prefillStudioLocation);
      document.getElementById("vid-route")?.addEventListener("change", syncPaymentRoute);
      document.getElementById("vid-fc-office")?.addEventListener("change", syncPaymentRoute);
      document.getElementById("vid-fee-confirmed")?.addEventListener("change", syncPaymentRoute);
      document.getElementById("vid-teg-brand")?.addEventListener("change", syncPaymentRoute);
      document.getElementById("vid-teg-reason")?.addEventListener("change", syncPaymentRoute);
      document.getElementById("vid-delete")?.addEventListener("click", deleteBooking);
      document.getElementById("vid-cancel")?.addEventListener("click", closeModal);
      document.getElementById("vid-modal-close")?.addEventListener("click", closeModal);
      document.getElementById("vid-modal")?.addEventListener("click", (e) => {
        if (e.target instanceof HTMLElement && e.target.id === "vid-modal") closeModal();
      });
      document.getElementById("vid-booking-search")?.addEventListener("input", (e) => renderBookings(e.target.value || ""));
      document.getElementById("vid-diary-save")?.addEventListener("click", saveDiary);
    })();
  </script>
</AdminShell>
