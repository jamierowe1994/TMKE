              body: JSON.stringify({ booking_id: b.id, on }),
            });
            const d = await res.json().catch(() => ({}));
            if (!res.ok) { btn.disabled = false; vdMsg(d.error || "Couldn't save that.", true); return; }
            b.released_unpaid_at = d.released_unpaid_at; b.released_unpaid_by = d.released_unpaid_by;
            renderCandidate();
          } catch (err) { btn.disabled = false; vdMsg("Couldn't save that: " + err.message, true); }
        });
        vdFoot(b);
        return;
      }

      // A package shoot: no gallery, no PIN, nothing to pay. The handover is
      // telling whoever runs that account it's in the Library.
      if (isSmmCovered(b)) {
        const folder = archiveFolderFor(b.id) || archiveFolderName(b);
        host.innerHTML = `
          <p class="vc-hint" style="margin:10px 0 6px">The client never sees this footage: it's what their content gets made from. Marking the shoot Content ready emails whoever runs their social media, with a link straight to this folder in the Library. Any edits come back to Jack directly.</p>
          <dl class="vc-pdl">
            ${vcPR("In the Library", `<a href="/admin/content?folder=${encodeURIComponent(folder)}">${escapeHtml(folder)}</a>`)}
            ${vcPR("Told", b.gallery_sent_at ? escapeHtml(new Date(b.gallery_sent_at).toLocaleString("en-GB", { day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" })) : "Nobody has been told yet.")}
            ${vcPR("Their portal", '<div class="cpt-shoot" id="vd-portal"></div>')}
          </dl>
          <div class="vc-inline-acts"><button type="button" class="vc-hb vc-hb--primary" id="vd-telagain">${b.gallery_sent_at ? "Tell them again" : "Tell them it's ready"}</button></div>`;
        renderShootPortal(document.getElementById("vd-portal"), b, folderFor(b), portalDeps());
        document.getElementById("vd-telagain").addEventListener("click", async (e) => {
          const btn = e.currentTarget, was = btn.textContent;
          btn.disabled = true; btn.textContent = "Telling them…";
          await tellSmmManager(b);
          btn.disabled = false; btn.textContent = was;
          renderDeliveryCard(b);
        });
        return;
      }

      const pin = await getGalleryPin(b);
      const tourUrl = await getTourLink(b);
      if (b.id !== candId) return;
      vcCache.pin = !!pin;
      const files = vcCache.files || 0;
      const stored = !!(files || b.archived_at);
      const reminder = stored
        ? `<div class="vd-store is-done"><span>Our storage has ${files ? `all ${files} files` : "the files"} too, so the team keeps them after Pixieset deletes the gallery.</span></div>`
        : `<div class="vd-store"><span><b>Pixieset is only half of it.</b> It's the client's copy, and Pixieset deletes it after three months. Put the same files in our storage too, or the team loses them.</span><button type="button" class="vc-hb" data-vd-store>Upload to our storage</button></div>`;
      const intro = `<p class="vc-hint" style="margin:10px 0 6px">What the client sees and downloads. Build the collection in Pixieset with the TMKE preset and Watermark 3, then put its details here. <a href="/guides/TMKE-Guide-to-Pixieset.pdf" target="_blank" rel="noopener">Read the Pixieset guide</a></p>`;
      const exp = vcExpires(Object.assign({}, b, { gallery_url: b.gallery_url || "x" }));
      if (vdEdit) {
        host.innerHTML = intro + `<dl class="vc-pdl is-form">
            ${vcPF("Gallery link", `<input class="vc-in" type="text" inputmode="url" spellcheck="false" id="vd-gallery" value="${escapeHtml(b.gallery_url || "")}" placeholder="Paste the Pixieset link" />`)}
            ${vcPF("Gallery email", `<input class="vc-in" type="email" id="vd-email" value="${escapeHtml(b.gallery_email || b.client_email || "")}" />`, "What the client types to download. The PIN goes to this address, so it must be the one the gallery was set up with.")}
            ${vcPF("PIN", `<input class="vc-in" type="text" id="vd-pin" autocomplete="off" value="${escapeHtml(pin)}" placeholder="From Pixieset" />`, "Only goes out in the gallery email, once the invoice is paid. Never shown on the card.")}
            ${vcPF("Gallery expires", `<input class="vc-in" type="date" id="vd-expires" value="${escapeHtml(exp)}" />`, "Pixieset keeps a gallery about three months. Filled in from the shoot date.")}
            ${vcPF("360 tour", `<input class="vc-in" type="text" inputmode="url" spellcheck="false" id="vd-tour360" value="${escapeHtml(tourUrl)}" placeholder="Pixieset can't hold these" />`, "Held back until paid, like the PIN.")}
            ${vcPF("Anything else", `<div class="vc-pair"><input class="vc-in" type="text" id="vd-extra-label" value="${escapeHtml(b.extra_link_label || "")}" placeholder="What it is, e.g. drone stills" /><input class="vc-in" type="text" inputmode="url" spellcheck="false" id="vd-extra-url" value="${escapeHtml(b.extra_link_url || "")}" placeholder="Link" /></div>`)}
          </dl>
          <p class="vid-warn" id="vd-msg" hidden></p>
          <div class="vc-inline-acts"><button type="button" class="vc-hb" data-vd="cancel">Cancel</button><button type="button" class="vc-hb vc-hb--primary" data-vd="save">Save gallery</button></div>` + reminder;
      } else {
        const pinLine = pin
          ? (b.pin_released_at ? "Released " + escapeHtml(vcDay(b.pin_released_at)) + " in the gallery email." : b.paid_at ? "Added. It goes with the gallery email." : "Added. Held until the invoice is paid.")
          : '<span class="vc-missing">Not added</span>';
        host.innerHTML = intro + `<dl class="vc-pdl">
            ${vcPR("Gallery link", b.gallery_url ? `<a href="${escapeHtml(b.gallery_url)}" target="_blank" rel="noopener">${escapeHtml(String(b.gallery_url).replace(/^https?:\/\//, ""))}</a>` : '<span class="vc-missing">Not added</span>')}
            ${vcPR("Gallery email", escapeHtml(b.gallery_email || b.client_email || ""))}
            ${vcPR("PIN", pinLine)}
            ${vcPR("Gallery expires", b.gallery_url ? escapeHtml(vcDayYear(vcExpires(b))) : "")}
            ${tourUrl ? vcPR("360 tour", `<a href="${escapeHtml(tourUrl)}" target="_blank" rel="noopener">${escapeHtml(tourUrl.replace(/^https?:\/\//, ""))}</a>`) : ""}
            ${b.extra_link_url ? vcPR(b.extra_link_label || "Anything else", `<a href="${escapeHtml(b.extra_link_url)}" target="_blank" rel="noopener">${escapeHtml(String(b.extra_link_url).replace(/^https?:\/\//, ""))}</a>`) : ""}
          </dl>
          <p class="vid-warn" id="vd-msg" hidden></p>
          <div class="vc-inline-acts"><button type="button" class="vc-hb${b.gallery_url ? "" : " vc-hb--primary"}" data-vd="edit">${b.gallery_url ? "Edit gallery" : "Add gallery"}</button></div>` + reminder;
      }
      host.querySelector("[data-vd-store]")?.addEventListener("click", () => vcOpen("content"));
      host.querySelectorAll("[data-vd]").forEach((x) => x.addEventListener("click", () => {
        const k = x.getAttribute("data-vd");
        if (k === "edit") { vdEdit = true; renderDeliveryCard(b); }
        else if (k === "cancel") { vdEdit = false; renderDeliveryCard(b); }
        else if (k === "save") vdSaveGallery(b, x);
      }));
      if (vdEdit) setTimeout(() => document.getElementById("vd-gallery")?.focus(), 0);
      vdFoot(b);
    }
    // The foot of the Delivery pop-out: sending the gallery, and the PIN.
    function vdFoot(b) {
      if (vcPane !== "delivery") return;
      const foot = document.getElementById("vc-panel-f");
      if (!foot) return;
      if (isSmmCovered(b)) { foot.innerHTML = vcFootBtn("data-vc-close", "Close", true); foot.querySelector("[data-vc-close]").addEventListener("click", vcClose); return; }
      if (isPortalDelivery(b)) { foot.innerHTML = `<span class="vc-say">Nothing goes to Pixieset, and no gallery email goes out.</span>` + vcFootBtn("data-vc-close", "Close", true); foot.querySelector("[data-vc-close]").addEventListener("click", vcClose); return; }
      const canSend = ["gallery_ready", "sent", "delivered"].includes(b.stage) && !!b.gallery_url;
      const say = !["editing", "gallery_ready", "sent", "delivered"].includes(b.stage) ? "Nothing to send until the shoot is in editing."
        : b.stage === "editing" ? "Saving the gallery with its link and PIN moves this shoot to Gallery ready."
        : !b.gallery_url ? "Add the gallery link first."
        : b.paid_at ? "Paid, so the email includes the PIN and they can download."
        : "Not paid yet, so the email holds back the PIN and asks for payment. The PIN follows by itself once it's paid.";
      const pinNow = b.gallery_sent_at && b.paid_at && !b.pin_released_at;
      foot.innerHTML = `<span class="vc-say">${escapeHtml(say)}</span>`
        + (pinNow ? vcFootBtn('id="vd-releasepin"', "Send the PIN now") : "")
        + vcFootBtn(`id="vd-send"${canSend ? "" : " disabled"}`, b.gallery_sent_at ? "Send the gallery email again" : "Send the gallery email", true);
      document.getElementById("vd-send")?.addEventListener("click", () => sendGalleryEmail(b));
      document.getElementById("vd-releasepin")?.addEventListener("click", async () => {
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/videography/release-pin`, {
            method: "POST",
            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
            body: JSON.stringify({ booking_id: b.id }),
          });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) { vdMsg(d.error || "Couldn't send the PIN.", true); return; }
          b.pin_released_at = new Date().toISOString();
          await addNote(b, `PIN released to ${d.sent_to}.`, "audit");
          renderCandidate();
        } catch (err) { vdMsg("Couldn't send the PIN: " + err.message, true); }
      });
    }
    async function vdSaveGallery(b, btn) {
      const val = (id) => (document.getElementById(id)?.value || "").trim();
      const link = val("vd-gallery"), pin = val("vd-pin");
      const patch = {
        gallery_url: link || null,
        gallery_email: val("vd-email") || null,
        extra_link_label: val("vd-extra-label") || null,
        extra_link_url: val("vd-extra-url") || null,
        gallery_expires_on: link ? (val("vd-expires") || null) : null,
      };
      if (link && !b.pixieset_uploaded_at) patch.pixieset_uploaded_at = new Date().toISOString();
      btn.disabled = true; btn.textContent = "Saving…";
      const { error } = await supabase.from("videography_bookings").update(patch).eq("id", b.id);
      if (error) { vdMsg("Couldn't save: " + error.message, true); btn.disabled = false; btn.textContent = "Save gallery"; return; }
      Object.assign(b, patch);
      await saveGalleryPin(b.id, pin);
      await saveTourLink(b.id, val("vd-tour360"));
      vdEdit = false;
      vcCache.pin = !!pin;
      // The gallery is built: the shoot moves on by itself (Dani, 4 Nov).
      if (b.stage === "editing" && link && pin) { await advanceStage("gallery_ready"); await addNote(b, "Pixieset gallery added. Moved to Gallery ready.", "audit"); }
      else renderCandidate();
    }

    async function getGalleryPin(b) {
      const { data } = await supabase.from("videography_gallery_pins").select("pin").eq("booking_id", b.id).maybeSingle();
      return (data && data.pin) || "";
    }

    async function getTourLink(b) {
      const { data } = await supabase.from("videography_tour_links").select("url").eq("booking_id", b.id).maybeSingle();
      return (data && data.url) || "";
    }

    async function saveBookingPatch(b, patch) {
      Object.assign(b, patch);
      const { error } = await supabase.from("videography_bookings").update(patch).eq("id", b.id);
      if (error) alert("Couldn't save that: " + error.message);
      else renderCandidate();
    }

    function vdMsg(text, bad) {
      const el = document.getElementById("vd-msg");
      if (!el) { if (text && bad) alert(text); return; }
      el.hidden = !text; el.textContent = text || "";
      el.style.color = bad ? "#8a3f3f" : "var(--vc-wine)";
    }

    async function sendGalleryEmail(b) {
      if (!b.gallery_url) { vdMsg("Add the gallery link first.", true); return; }
      const paid = !!b.paid_at;
      const to = b.gallery_email || b.client_email || "";
      if (!confirm(`Send the gallery email to ${to}?\n\n${paid
        ? "They've paid, so this includes the PIN and they can download."
        : "They haven't paid, so this withholds the PIN, asks for payment and attaches the invoice."}`)) return;
      const btn = document.getElementById("vd-send");
      const label = btn ? btn.textContent : "";
      if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/videography/gallery-email`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ booking_id: b.id }),
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) { vdMsg(d.error || "Couldn't send.", true); return; }
        b.gallery_sent_at = new Date().toISOString();
        // The stage follows the email actually going, rather than waiting for
        // someone to remember to move it.
        if (b.stage === "gallery_ready") await advanceStage("sent");
        await addNote(b, d.included_pin
          ? `Gallery email sent to ${d.sent_to} with the PIN.`
          : `Gallery email sent to ${d.sent_to}. PIN withheld - not yet paid.`, "audit");
        renderCandidate();
      } catch (err) { vdMsg("Couldn't send: " + err.message, true); }
      finally { if (btn && btn.isConnected) { btn.disabled = false; btn.textContent = label; } }
    }

    /* ---- Invoicing, on the booking ----
       Same Worker endpoints as the standalone Invoicing page and the SMM client
       card. Raising it here rather than there matters for one reason beyond
       convenience: it sets booking_id, so the invoice and the shoot are linked.
       Without that, payment lands on the invoice and the booking never hears
       about it. */
    let invSettings = null;
    let vivItems = [];
    let vivPayByCard = true;   // set per booking in renderInvoiceCard
    let vivDraft = null;       // the created invoice awaiting send
    let vivReissueOf = null;   // { id, number } when reissuing a sent invoice

    async function ensureInvSettings() {
      if (invSettings || !WORKER_URL) return invSettings;
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/invoicing/settings`, { headers: { Authorization: "Bearer " + token } });
        if (res.ok) invSettings = (await res.json()).settings || {};
      } catch (_) { invSettings = {}; }
      return invSettings || (invSettings = {});
    }

    const vivMoney = (p) => "£" + ((p || 0) / 100).toFixed(2);

    // Seed the invoice from what was actually booked, travel included as its
    // own line so the client can see what they are paying for.
    function vivSeedItems(b) {
      const items = [];
      // A booking made online has a total with travel in it; one made here
      // has the quote, with travel kept beside it (Danielle, 21 Oct 2026).
      const online = b.total_pence != null;
      const base = (online ? b.total_pence : b.amount_pence) || 0;
      const surcharge = b.surcharge_pence || 0;
      // A brand invoice is billed to the office (or, for TEG, to the brand),
      // not the agent, so the line has to say who the shoot was actually for
      // or the recipient cannot place it.
      // "Service - client - first line of the address" (Danielle, 4 Nov 2026),
      // so whoever reads it can place the shoot. Same as bookingInvoiceDraft.
      const label = invoiceItemLabel(b);
      items.push({ description: label, amount: online && base > surcharge ? ((base - surcharge) / 100).toFixed(2) : (base / 100).toFixed(2) });
      // "Travel: 100 miles each way (200 miles there and back), less the free
      // 40 miles each way: 120 miles at 55p a mile". An older booking charged
      // one way keeps a plain line, so the words match its amount.
      if (surcharge) {
        const t = b.distance_miles ? travelCharge(Number(b.distance_miles), vidSettings) : null;
        items.push({ description: t && t.pence === surcharge ? travelInvoiceLine(Number(b.distance_miles), vidSettings) : `Travel charge${b.distance_miles ? ` (${Math.round(b.distance_miles)} miles each way)` : ""}`, amount: (surcharge / 100).toFixed(2) });
      }
      return items;
    }

    function vivTotals() {
      const rate = invSettings && invSettings.vat_rate != null ? Number(invSettings.vat_rate) : 20;
      const subtotal = vivItems.reduce((sum, it) => sum + Math.round((parseFloat(it.amount) || 0) * 100), 0);
      const vat = Math.round(subtotal * rate / 100);
      return { subtotal, vat, total: subtotal + vat, rate };
    }

    function vivBuildInvoice(b) {
      const t = vivTotals();
      return {
        number: (invSettings.invoice_prefix || "TMKE") + (invSettings.next_number || 1001),
        issued_date: document.getElementById("viv-issued")?.value || null,
        due_date: document.getElementById("viv-due")?.value || null,
        bill_to_name: document.getElementById("viv-name")?.value.trim() || "",
        bill_to_email: document.getElementById("viv-email")?.value.trim() || "",
        bill_to_address: document.getElementById("viv-address")?.value.trim() || "",
        client_name: document.getElementById("viv-client")?.value.trim() || "",
        notes: document.getElementById("viv-notes")?.value.trim() || null,
        line_items: vivItems.map((it) => ({ description: it.description, qty: 1, unit_pence: Math.round((parseFloat(it.amount) || 0) * 100) })),
        subtotal_pence: t.subtotal, vat_pence: t.vat, total_pence: t.total,
        pay_by_card: vivPayByCard,
        release_on_payment: true,   // always a shoot here
        terms_days: Number(document.getElementById("viv-terms")?.value) || 10,
      };
    }

    /* What a client has asked for via the public edit-request page - notes,
       any twilight images, any extra-images purchase - and their own link, so
       it can be handed over again by hand. Nothing shows until the edits
       link has actually gone out. */
    async function renderEditsCard(b) {
      const linkHost = document.getElementById("vd-edit-link");
      const reqHost = document.getElementById("vd-edit-reqs");
      if (!linkHost && !reqHost) return;
      // The edits link rides on whichever paid-path email actually fired:
      // gallery_sent_at if already paid when the gallery went out, or
      // pin_released_at if payment landed after.
      const editsSentAt = b.pin_released_at || (b.paid_at && b.gallery_sent_at ? b.gallery_sent_at : null);
      if (linkHost && editsSentAt && b.edits_token) {
        const editsLink = `${location.origin}/edits?token=${encodeURIComponent(b.edits_token)}`;
        linkHost.outerHTML = vcPF("Their edit link", `<div class="vc-pair"><input class="vc-in" type="text" readonly value="${escapeHtml(editsLink)}" id="vid-edits-link" /><button type="button" class="vc-hb" id="vid-edits-link-copy">Copy</button></div>`, `Sent ${escapeHtml(vcDayYear(editsSentAt))}.`);
        wireEditsLinkCopy();
      }
      if (!reqHost || !b.gallery_sent_at) return;
      const { data, error } = await supabase.from("videography_edit_requests").select("*").eq("booking_id", b.id).order("created_at", { ascending: false });
      const requests = error ? [] : (data || []);
      const host = document.getElementById("vd-edit-reqs");
      if (!host) return;
      if (!requests.length) { host.textContent = editsSentAt ? "None yet. Waiting to hear from them." : "None yet."; return; }
      const statusLabel = (r) => r.status === "notified" ? "Sent to Jack" : r.status === "paid" ? "Paid, telling Jack" : "Waiting";
      host.innerHTML = requests.map((r) => {
        const twilight = Array.isArray(r.twilight_items) ? r.twilight_items : [];
        return `<div class="vd-req"><span>${escapeHtml(vcDayYear(r.created_at))}, ${escapeHtml(statusLabel(r))}</span>
          ${r.notes ? `<span>${escapeHtml(r.notes)}</span>` : ""}
          ${twilight.length ? `<span>Twilight: ${twilight.length} image${twilight.length === 1 ? "" : "s"} (${gbpFromPence(twilight.reduce((t, it) => t + (it.price_pence || 0), 0))} + VAT): ${twilight.map((it) => escapeHtml(it.filename || "")).join(", ")}</span>` : ""}
          ${r.extra_images_qty ? `<span>Extra images: ${r.extra_images_qty} bought (${gbpFromPence(r.extra_images_price_pence || 0)} + VAT). Raise their download limit once it's done.</span>` : ""}</div>`;
      }).join("");
    }

    function wireEditsLinkCopy() {
      const btn = document.getElementById("vid-edits-link-copy");
      const input = document.getElementById("vid-edits-link");
      if (!btn || !input) return;
      btn.addEventListener("click", async () => {
        try { await navigator.clipboard.writeText(input.value); btn.textContent = "Copied"; }
        catch (_) { input.select(); btn.textContent = "Selected"; }
        setTimeout(() => { btn.textContent = "Copy"; }, 1500);
      });
    }

    /* Only management raise, change, void or mark invoices paid. Everyone
       else (Jack) sees the shoot's invoices, opens them and resends a sent one
       with its usual email (Danielle, 28 Oct 2026); the Worker holds the same line. */
    let CAN_MONEY_P = null;
    function canMoney() {
      if (!CAN_MONEY_P) CAN_MONEY_P = import.meta.env.DEV ? Promise.resolve(true)
        : supabase.auth.getSession().then(({ data }) => isManagementUser(data && data.session && data.session.user)).catch(() => false);
      return CAN_MONEY_P;
    }

    /* ---- Invoicing, in its pop-out (Dani, 4 Nov 2026, agreed on the mock-up) ----
       Three tabs. This invoice: the newest one, read as the client gets it,
       or the builder when nothing's raised yet. Raise new: a fresh one for
       this shoot. All invoices: every one, with View and Resend. The builder
       runs in the order Danielle uses (who it's for, dates, what it's for,
       notes), and Preview invoice and Preview email show exactly what will
       go before it goes to Jack to approve. */
    var vivTab = "this";
    var vivPreview = null;     // { kind: "invoice" | "email", inv, snap } while a preview shows
    var vivSource = null;      // the invoice being edited (saving reissues it), or null
    var vivFlash = "";         // a message to show after the next redraw
    function vivFoot(html) { if (vcPane !== "invoice") return; const f = document.getElementById("vc-panel-f"); if (f) f.innerHTML = html; }
    function vivChip(iv) {
      const s = iv.status;
      const late = s === "sent" && iv.due_date && new Date(iv.due_date + "T23:59:59") < new Date();
      if (s === "paid") return vcChip("is-good", "Paid" + (iv.paid_date ? " " + vcDay(iv.paid_date) : ""));
      if (s === "draft") return vcChip("is-plain", "Draft");
      if (s === "void") return vcChip("is-plain", "Void");
      if (s === "sent") return vcChip(late ? "is-bad" : "is-info", (late ? "Overdue, due " : "Sent, due ") + vcDay(iv.due_date));
      return vcChip("is-plain", s || "");
    }
    // What's typed in the builder, so a preview can come back to it.
    const VIV_FIELDS = ["viv-client", "viv-name", "viv-email", "viv-cc", "viv-address", "viv-issued", "viv-terms", "viv-due", "viv-notes"];
    function vivSnap() { const f = {}; VIV_FIELDS.forEach((id) => { const el = document.getElementById(id); if (el) f[id] = el.value; }); return { f, items: vivItems.map((x) => ({ ...x })), pay: vivPayByCard }; }
    function vivRestore(snap) { if (!snap) return; Object.entries(snap.f).forEach(([id, v]) => { const el = document.getElementById(id); if (el) el.value = v; }); vivItems = snap.items; vivPayByCard = snap.pay; vivSyncPay(); vivRenderItems(); }

    // The invoice is laid out at A4 width; shrink it to the pop-out so nothing is cut off.
    function vivFitPaper(fr) {
      try {
        const doc = fr.contentDocument.documentElement;
        const w = Math.max(doc.scrollWidth, fr.contentDocument.body ? fr.contentDocument.body.scrollWidth : 0);
        const z = w > fr.clientWidth ? fr.clientWidth / w : 1;
        doc.style.zoom = String(z);
        doc.style.overflowX = "hidden";
        fr.style.height = Math.ceil(doc.scrollHeight * z + 4) + "px";
      } catch (_) {}
    }
    async function renderInvoiceCard(b) {
      const host = document.getElementById("vid-cand-invoice");
      const tabsEl = document.getElementById("vc-panel-tabs");
      if (!host || vcPane !== "invoice") return;
      if (!WORKER_URL) { host.innerHTML = `<p class="vc-hint">Connect the Worker to raise invoices.</p>`; return; }
      await ensureInvSettings();
      const money = await canMoney();
      const list = await fetchInvoicesFor(b);
      if (b.id !== candId || vcPane !== "invoice") return;
      b._invoices = list;
      const live = list.filter((iv) => iv.status !== "void");
      const current = live[0] || null;
      if (!money && (vivTab === "new" || (vivTab === "this" && !current))) vivTab = "all";
      const tabs = [
        ...(money || current ? [["this", current ? "This invoice" : "Raise this invoice"]] : []),
        ...(money ? [["new", "Raise new"]] : []),
        ["all", `All invoices (${live.length})`],
      ];
      if (tabsEl) {
        tabsEl.innerHTML = tabs.map(([k, t]) => `<button type="button" data-viv-tab="${k}" aria-selected="${vivTab === k}">${escapeHtml(t)}</button>`).join("");
        tabsEl.querySelectorAll("[data-viv-tab]").forEach((x) => x.addEventListener("click", () => { vivTab = x.getAttribute("data-viv-tab"); vivPreview = null; vivSource = null; vivReissueOf = null; renderInvoiceCard(b); }));
      }
      const msg = `<p class="vid-warn" id="viv-msg" hidden></p>`;
      const flash = () => { if (vivFlash) { vivStatus(vivFlash); vivFlash = ""; } };
      const title = document.getElementById("vc-panel-t");

      // A preview of what the builder holds: the invoice, or its email.
      if (vivPreview) {
        const inv = vivPreview.inv;
        if (title) title.textContent = vivPreview.kind === "invoice" ? "Preview: the invoice" : "Preview: the email";
        if (vivPreview.kind === "invoice") {
          host.innerHTML = msg + `<p class="vc-hint" style="margin:10px 0 8px">As the PDF will read. ${vivSource ? "" : "The number is given when it's saved."}</p><iframe class="viv-paper" title="Invoice preview"></iframe>`;
          const fr = host.querySelector("iframe");
          fr.srcdoc = renderInvoiceHtml({ settings: { ...invSettings }, invoice: inv });
          fr.addEventListener("load", () => vivFitPaper(fr));
        } else {
          const e = invoiceEmail(inv, invSettings || {}, { booking: b });
          host.innerHTML = msg + `<p class="vc-hint" style="margin:10px 0 8px">The email that goes with it once it's approved. The invoice PDF and the footer image are added automatically.</p>
            <dl class="vc-pdl">${vcPR("To", escapeHtml(inv.bill_to_email || ""))}${vcPR("Copy to", escapeHtml(inv.cc_email || ""))}${vcPR("Subject", escapeHtml(e.subject))}${vcPR("Attached", escapeHtml((inv.number || "The invoice") + ".pdf"))}${vcPR("Payment", escapeHtml(payLine(inv)))}</dl>
            <div class="viv-mail">${escapeHtml(e.body)}</div>`;
        }
        vivFoot(vcFootBtn('data-viv="back"', "Back to the invoice") + (vivPreview.kind === "invoice" ? vcFootBtn('data-viv="pv-email"', "Preview email") : vcFootBtn('data-viv="pv-invoice"', "Preview invoice")));
        vivWireFoot(b);
        return;
      }
      if (title) title.textContent = vivTab === "all" ? "Invoices for this shoot" : vivTab === "new" ? "Raise a new invoice" : vivSource ? "Edit " + (vivSource.number || "the invoice") : current ? (current.number || "Draft invoice") : "Raise this invoice";

      if (vivTab === "all") {
        host.innerHTML = msg + `<div id="viv-list"><p class="vc-hint">Loading…</p></div>`;
        flash();
        loadInvoices(b);
        vivFoot(money ? vcFootBtn('data-viv-go="new"', "Raise new", true) : "");
        document.querySelector('#vc-panel-f [data-viv-go="new"]')?.addEventListener("click", () => { vivTab = "new"; renderInvoiceCard(b); });
        return;
      }
      if (vivTab === "new" || vivSource || !current) {
        vivBuilder(b, host, msg, vivSource ? "edit" : vivTab === "new" ? "new" : "first");
        flash();
        return;
      }

      // This invoice, as the client gets it.
      const { data: full } = await supabase.from("invoices").select("*").eq("id", current.id).maybeSingle();
      if (b.id !== candId || vcPane !== "invoice") return;
      const inv = full || current;
      const fc = isBrandInvoiced(b);
      const fee = fc ? (b.brand_fee_confirmed ? `Held. Confirmed ${b.brand_fee_confirmed_at ? vcDay(b.brand_fee_confirmed_at) : ""}${b.brand_fee_confirmed_by ? " by " + b.brand_fee_confirmed_by : ""}.` : "Not confirmed yet.") : "";
      const hist = [
        inv.created_at ? [vcDay(inv.created_at), "Raised"] : null,
        inv.sent_at ? [vcDay(inv.sent_at), `Sent to ${inv.sent_to || inv.bill_to_email || "the client"}`] : null,
        inv.paid_date ? [vcDay(inv.paid_date), "Paid" + (inv.payment_method ? ", " + inv.payment_method : "")] : null,
        inv.status === "sent" && inv.due_date ? [vcDay(inv.due_date), "Due. A reminder goes if it's still unpaid."] : null,
      ].filter(Boolean);
      host.innerHTML = msg + `<iframe class="viv-paper" title="${escapeHtml(inv.number || "Invoice")}"></iframe>` +
        vcSec("Who it goes to", `<dl class="vc-pdl">${vcPR("Invoice email", escapeHtml(inv.bill_to_email || ""))}${vcPR("Copy to", escapeHtml(inv.cc_email || ""))}${fc ? vcPR("Fee check", escapeHtml(fee)) : ""}${vcPR("Card payment", inv.pay_by_card ? "On: the email has a Pay by card button" : "Off: bank transfer")}</dl>`) +
        vcSec("What's happened", `<dl class="vc-pdl">${hist.map(([w, t]) => vcPR(w, escapeHtml(t))).join("") || vcPR("So far", "Nothing yet")}</dl><div id="viv-list" hidden></div>`);
      const fr = host.querySelector("iframe");
      fr.srcdoc = renderInvoiceHtml({ settings: { ...invSettings }, invoice: inv });
      fr.addEventListener("load", () => vivFitPaper(fr));
      const chip = document.getElementById("vc-panel-chip");
      if (chip) chip.innerHTML = vivChip(inv);
      flash();
      let foot = vcFootBtn(`data-vview="${escapeHtml(inv.id)}"`, "View PDF");
      if (money && inv.status === "draft") foot = vcFootBtn(`data-vdel="${escapeHtml(inv.id)}"`, "Delete") + foot + vcFootBtn(`data-vedit="${escapeHtml(inv.id)}"`, "Edit") + vcFootBtn(`data-vjack="${escapeHtml(inv.id)}"`, "Send for approval", true);
      else if (money && inv.status === "sent") foot += vcFootBtn(`data-vedit="${escapeHtml(inv.id)}"`, "Edit") + vcFootBtn(`data-vpaid="${escapeHtml(inv.id)}"`, "Mark paid") + vcFootBtn(`data-vresend="${escapeHtml(inv.id)}"`, "Resend", true);
      else if ((inv.status === "sent" || inv.status === "paid") && inv.bill_to_email) foot += vcFootBtn(`data-vresend="${escapeHtml(inv.id)}"`, "Resend", true);
      vivFoot((inv.status === "paid" ? `<span class="vc-say">Paid, so it can't be changed.</span>` : "") + foot);
      vivWireRows(b, document.getElementById("vc-panel-f"), [inv]);
    }

    // The builder. "first": the shoot's own invoice, filled in from the booking.
    // "new": another one for this shoot. "edit": an invoice loaded back in to reissue.
    function vivBuilder(b, host, msg, mode) {
      const brand = isBrandInvoiced(b), teg = isTegInvoiced(b);
      const officeName = (FC_OFFICES.find((o) => o.key === b.fc_office) || {}).label || "";
      const tegBrandName = tegBrandLabel(b.teg_brand);
      const auto = bookingInvoiceDraft(b, { accountsCc: invSettings && invSettings.accounts_cc_email, settings: vidSettings }) || {};
      const src = mode === "edit" ? vivSource : null;
      const billTo = src ? src.bill_to_name : brand ? (officeName || b.client_company || b.client_name || "")
        : teg ? (tegBrandName || b.client_company || b.client_name || "") : (b.client_company || b.client_name || "");
      const email = src ? src.bill_to_email : (auto.bill_to_email || (teg ? TEG_ACCOUNTS_EMAIL : (b.client_email || "")));
      const cc = src ? src.cc_email : (auto.cc_email || (invSettings && invSettings.accounts_cc_email) || "hello@tmke.co.uk");
      const address = src ? src.bill_to_address : (teg ? tegBrandAddress(b.teg_brand) : "");
      const client = src ? (src.client_name || "") : [b.client_name, b.client_company].filter(Boolean).join(", ");
      const shootDate = b.shoot_date ? new Date(b.shoot_date).toLocaleDateString("en-GB", { day: "numeric", month: "long", year: "numeric" }) : "";
      const tegReasonName = b.teg_reason === "other" ? (b.teg_reason_other || "the reason given") : tegReasonLabel(b.teg_reason);
      const notes = src ? (src.notes || "") : mode === "new" ? "Thank you for your business - TMKE"
        : auto.notes ? auto.notes : teg ? `Invoice raised for ${tegReasonName}${b.client_name ? ` — ${b.client_name}` : ""}.` : "Thank you for your business - TMKE";
      if (mode === "edit") {
        vivItems = (src.line_items || []).map((it) => ({ description: it.description || "", amount: (((it.unit_pence || 0) * (it.qty || 1)) / 100).toFixed(2) }));
        vivPayByCard = !!src.pay_by_card;
        vivReissueOf = { id: src.id, number: src.number };
      } else {
        vivItems = mode === "new" ? [{ description: "", amount: "" }] : vivSeedItems(b);
        vivPayByCard = !brand && !teg;
        vivReissueOf = null;
      }
      vivDraft = null;
      const today = new Date().toISOString().slice(0, 10);
      const terms = src ? (src.terms_days ?? 10) : 10;
      const due = new Date(); due.setDate(due.getDate() + Number(terms));
      const lock = mode === "first" && brand && !b.brand_fee_confirmed
        ? `<div class="viv-lock"><b>Fee check first.</b> ${escapeHtml(officeName || "The Fine & Country office")} haven't confirmed they hold the seller's marketing fee, which pays for this shoot. You can get the invoice approved now; ask the office above.</div>` : "";
      const reissue = mode === "edit" ? `<div class="viv-lock">Saving raises a new invoice and voids ${escapeHtml(src.number || "this one")}.</div>` : "";
      host.innerHTML = msg + lock + reissue +
        vcSec("Who it's for", `<dl class="vc-pdl">
          ${vcPF("Client", `<input class="vc-in" id="viv-client" value="${escapeHtml(client)}" placeholder="Who the shoot was for" />`, brand || teg ? "Names the shoot for the accounts team, who pay for several agents at once." : "")}
          ${vcPF("Bill to", `<input class="vc-in" id="viv-name" value="${escapeHtml(billTo || "")}" />`)}
          ${vcPF("Invoice email", `<input class="vc-in" id="viv-email" type="email" value="${escapeHtml(email || "")}" />`)}
          ${vcPF("Copy to", `<input class="vc-in" id="viv-cc" value="${escapeHtml(cc || "")}" placeholder="Comma-separated" />`)}
          ${vcPF("Billing address", `<textarea class="vc-in" id="viv-address" rows="2" placeholder="Optional">${escapeHtml(address || "")}</textarea>`)}
          ${vcPF("Card payment", `<div class="vid-inv-toggle" id="viv-pay"><button type="button" data-pay="no">Off</button><button type="button" data-pay="yes">On</button></div>`, brand || teg ? "Off: the brand settles this, not the client." : "On: the client pays, so the email has a Pay by card button.")}
        </dl>`) +
        vcSec("Dates", `<dl class="vc-pdl">
          ${vcPF("Issued", `<input class="vc-in" id="viv-issued" type="date" value="${today}" />`)}
          ${vcPF("Days to pay", `<input class="vc-in" id="viv-terms" type="number" min="0" value="${escapeHtml(String(terms))}" />`)}
          ${vcPF("Due date", `<input class="vc-in" id="viv-due" type="date" value="${due.toISOString().slice(0, 10)}" />`)}
        </dl>`) +
        vcSec("What it's for", `<div id="viv-items"></div><div class="vc-inline-acts" style="justify-content:flex-start;padding-top:4px"><button type="button" class="vc-act" id="viv-add">Add a line</button></div><div class="vid-inv-totals" id="viv-totals"></div>`) +
        vcSec("Notes on the invoice", `<textarea class="vc-in" id="viv-notes" rows="3" style="margin:8px 0 4px">${escapeHtml(notes)}</textarea>`);
      vivRenderItems();
      vivSyncPay();
      document.getElementById("viv-add").addEventListener("click", () => { vivItems.push({ description: "", amount: "" }); vivRenderItems(); });
      document.getElementById("viv-pay").addEventListener("click", (e) => {
        const btn = e.target.closest("[data-pay]"); if (!btn) return;
        vivPayByCard = btn.getAttribute("data-pay") === "yes"; vivSyncPay();
      });
      document.getElementById("viv-terms").addEventListener("input", ciApplyVivTerms);
      document.getElementById("viv-issued").addEventListener("input", ciApplyVivTerms);
      const say = mode === "edit" ? "" : `<span class="vc-say">Jack approves it, then it goes.</span>`;
      vivFoot(mode === "edit"
        ? vcFootBtn('data-viv="cancel"', "Cancel") + vcFootBtn('data-viv="pv-invoice"', "Preview invoice") + vcFootBtn('data-viv="pv-email"', "Preview email") + vcFootBtn('id="viv-draft"', "Reissue as draft") + vcFootBtn('id="viv-send"', "Reissue and send", true)
        : say + vcFootBtn('data-viv="pv-invoice"', "Preview invoice") + vcFootBtn('data-viv="pv-email"', "Preview email") + vcFootBtn('id="viv-draft"', "Save draft") + vcFootBtn('id="viv-approve"', "Send for approval", true));
      vivWireFoot(b);
    }
    // The builder's invoice, as the preview and the email read it.
    function vivPreviewInvoice(b) {
      const inv = vivBuildInvoice(b);
      inv.cc_email = (document.getElementById("viv-cc")?.value || "").trim();
      if (vivSource && vivSource.number) inv.number = vivSource.number;
      inv.status = "draft";
      return inv;
    }
    function vivWireFoot(b) {
      const f = document.getElementById("vc-panel-f");
      if (!f) return;
      f.querySelectorAll("[data-viv]").forEach((x) => x.addEventListener("click", () => {
        const k = x.getAttribute("data-viv");
        if (k === "back") { const snap = vivPreview && vivPreview.snap; vivPreview = null; renderInvoiceCard(b).then(() => vivRestore(snap)); return; }
        if (k === "cancel") { vivSource = null; vivReissueOf = null; renderInvoiceCard(b); return; }
        if (k === "pv-invoice" || k === "pv-email") {
          const kind = k === "pv-invoice" ? "invoice" : "email";
          if (vivPreview) { vivPreview.kind = kind; renderInvoiceCard(b); return; }
          vivPreview = { kind, inv: vivPreviewInvoice(b), snap: vivSnap() };
          renderInvoiceCard(b);
          document.querySelector("#vc-panel .vc-panel-b").scrollTop = 0;
        }
      }));
      document.getElementById("viv-draft")?.addEventListener("click", async () => {
        const reissue = !!vivSource;
        await createInvoice(b, false);
        if (vivDraft) { vivFlash = `${vivDraft.number || "The invoice"} saved as a draft.${reissue ? " The old one is voided." : ""}`; vivTab = "this"; vivSource = null; renderInvoiceCard(b); vcFillMoney(b); }
      });
      document.getElementById("viv-send")?.addEventListener("click", async () => {
        await createInvoice(b, true);
        vivSource = null;
      });
      document.getElementById("viv-approve")?.addEventListener("click", async (e) => {
        const btn = e.currentTarget;
        await createInvoice(b, false);
        if (!vivDraft) return;
        btn.disabled = true; btn.textContent = "Sending…";
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/invoicing/approval/request`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ invoice_id: vivDraft.id }) });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(d.error || res.status);
          vivFlash = d.test ? `${vivDraft.number} sent for approval. Test mode: the email came to you, not Jack.` : `${vivDraft.number} sent to Jack to approve. Once he does, it goes.`;
        } catch (err) { vivFlash = `${vivDraft.number} saved as a draft, but it couldn't go to Jack: ${err.message}`; }
        vivTab = "this"; vivSource = null;
        renderInvoiceCard(b); vcFillMoney(b);
      });
    }

    function vivSyncPay() {
      document.querySelectorAll("#viv-pay [data-pay]").forEach((btn) =>
        btn.classList.toggle("is-active", (btn.getAttribute("data-pay") === "yes") === vivPayByCard));
    }

    function vivRenderItems() {
      const host = document.getElementById("viv-items");
      if (!host) return;
      host.innerHTML = vivItems.map((it, i) => `
        <div class="vid-inv-item">
          <input type="text" data-vi="${i}" data-k="description" value="${escapeHtml(it.description)}" placeholder="Description" />
          <input type="number" step="0.01" data-vi="${i}" data-k="amount" value="${escapeHtml(it.amount)}" placeholder="0.00" />
          <button type="button" class="vid-inv-x" data-vrm="${i}" title="Remove">&times;</button>
        </div>`).join("");
      host.querySelectorAll("[data-vi]").forEach((el) => el.addEventListener("input", () => {
        vivItems[Number(el.getAttribute("data-vi"))][el.getAttribute("data-k")] = el.value;
        vivRenderTotals();
      }));
      host.querySelectorAll("[data-vrm]").forEach((btn) => btn.addEventListener("click", () => {
        vivItems.splice(Number(btn.getAttribute("data-vrm")), 1); vivRenderItems();
      }));
      vivRenderTotals();
    }

    function vivRenderTotals() {
      const el = document.getElementById("viv-totals");
      if (!el) return;
      const t = vivTotals();
      el.innerHTML = `<span>Subtotal ${vivMoney(t.subtotal)}</span><span>VAT (${t.rate}%) ${vivMoney(t.vat)}</span><strong>Total ${vivMoney(t.total)}</strong>`;
    }

    function vivStatus(msg, bad) {
      const el = document.getElementById("viv-msg");
      if (!el) return;
      el.hidden = !msg; el.textContent = msg || "";
      el.style.color = bad ? "#8a5a2b" : "var(--english-violet)";
    }

    async function createInvoice(b, send) {
      const inv = vivBuildInvoice(b);
      if (!inv.bill_to_name) { vivStatus("Who is this billed to?", true); return; }
      if (send && !inv.bill_to_email) { vivStatus("An email address is needed to send it.", true); return; }
      if (!inv.line_items.length) { vivStatus("Add at least one line.", true); return; }
      const btn = document.getElementById(send ? "viv-send" : "viv-draft");
      const label = btn.textContent; btn.disabled = true; btn.textContent = send ? "Sending…" : "Saving…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/invoicing/invoices`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({
            // The link that was missing: this invoice belongs to this shoot.
            booking_id: b.id, booking_source: "videography",
            bill_to_name: inv.bill_to_name, bill_to_email: inv.bill_to_email || null,
            bill_to_address: inv.bill_to_address || null,
            client_name: (document.getElementById("viv-client")?.value || "").trim() || null,
            issued_date: inv.issued_date, due_date: inv.due_date, notes: inv.notes,
            cc_email: (document.getElementById("viv-cc")?.value || "").trim() || null,
            pay_by_card: inv.pay_by_card, release_on_payment: true, terms_days: inv.terms_days,
            line_items: inv.line_items,
          }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) { vivStatus(data.error || "Couldn't save the invoice.", true); return; }
        vivDraft = data.invoice;
        // Only void the original once its replacement is safely saved. The
        // other order risks voiding an invoice and having nothing to show for it.
        let voided = "";
        if (vivReissueOf) {
          await fetch(`${WORKER_URL}/invoicing/invoices`, {
            method: "PATCH",
            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
            body: JSON.stringify({ id: vivReissueOf.id, status: "void" }),
          });
          voided = ` ${vivReissueOf.number} voided.`;
          vivReissueOf = null;
        }
        if (!send) { vivStatus(`Invoice ${data.invoice.number} saved as a draft.${voided}`); loadInvoices(b); return; }

        /* Review the covering email before it goes. It used to send silently
           with the Worker's default wording, which was fine for a plain bill
           and no use at all when the invoice needed explaining. */
        await ensureInvSettings();
        openInvoiceEmail(data.invoice, async (email) => {
          const sres = await fetch(`${WORKER_URL}/invoicing/invoices/send`, {
            method: "POST",
            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
            body: JSON.stringify(Object.assign({ id: data.invoice.id }, email)),
          });
          const sdata = await sres.json().catch(() => ({}));
          if (!sres.ok) { vivStatus(sdata.error || "Saved, but the email didn't send.", true); return; }
          vivFlash = `Invoice ${data.invoice.number} sent to ${data.invoice.bill_to_email || inv.bill_to_email}.${voided}`;
          vivTab = "this"; vivSource = null;
          // The stage follows the invoice actually going out.
          if (b.stage === "booked") await advanceStage("invoiced");
          vivRefresh(b);
        });
      } catch (err) {
        vivStatus("Couldn't reach the Worker: " + err.message, true);
      } finally { btn.disabled = false; btn.textContent = label; }
    }

    /* The send dialog. Whoever opens it says what happens on Send, so the
       same review step serves a first send and a resend. */
    let vimSend = null;
    async function openInvoiceEmail(inv, onSend) {
      vimSend = onSend;
      // The team resend as it was: the Worker ignores any change from them.
      const money = await canMoney();
      ["vim-cc", "vim-subject", "vim-body"].forEach((id) => { document.getElementById(id).readOnly = !money; });
      document.getElementById("vim-send").textContent = money ? "Send invoice" : "Resend invoice";
      document.querySelector("#vid-email-modal .vim-sub").textContent = money
        ? "Review the email \u2014 edit anything before it goes. The invoice PDF and your footer image are added automatically."
        : "This sends the invoice again with its usual email. To change the invoice or the email, ask Danielle.";
      document.getElementById("vim-num").textContent = inv.number || "";
      document.getElementById("vim-to").value = inv.bill_to_email || "";
      document.getElementById("vim-cc").value = inv.cc_email || "";
      const pay = document.getElementById("vim-pay");
      pay.textContent = payLine(inv);
      pay.className = "vim-pay" + (inv.pay_by_card ? " is-on" : "");
      const subjEl = document.getElementById("vim-subject"), bodyEl = document.getElementById("vim-body");
      subjEl.value = defaultEmailSubject(inv, invSettings || {});
      bodyEl.value = defaultEmailBody(inv, invSettings || {});
      document.getElementById("vim-msg").hidden = true;
      document.getElementById("vid-email-modal").hidden = false;
      // The shoot's own email (card client, TEG or Fine & Country), the same
      // words the automatic invoicing sends. Only if nobody's typed yet.
      const s0 = subjEl.value, b0 = bodyEl.value;
      if (inv.id) authToken().then((token) => fetch(`${WORKER_URL}/invoicing/email-draft?id=${encodeURIComponent(inv.id)}`, { headers: { Authorization: "Bearer " + token } }))
        .then((r) => r.ok ? r.json() : null).then((d) => {
          if (!d) return;
          if (subjEl.value === s0 && d.subject) subjEl.value = d.subject;
          if (bodyEl.value === b0 && d.body) bodyEl.value = d.body;
        }).catch(() => {});
    }
    function closeInvoiceEmail() {
      document.getElementById("vid-email-modal").hidden = true;
      vimSend = null;
    }
    document.getElementById("vim-cancel")?.addEventListener("click", closeInvoiceEmail);
    document.getElementById("vid-email-modal")?.addEventListener("click", (e) => {
      if (e.target === document.getElementById("vid-email-modal")) closeInvoiceEmail();
    });
    document.getElementById("vim-send")?.addEventListener("click", async () => {
      if (typeof vimSend !== "function") return;
      const btn = document.getElementById("vim-send");
      const label = btn.textContent;
      btn.disabled = true; btn.textContent = "Sending…";
      try {
        await vimSend({
          email_subject: document.getElementById("vim-subject").value.trim(),
          email_body: document.getElementById("vim-body").value,
          cc: document.getElementById("vim-cc").value.trim(),
        });
        closeInvoiceEmail();
      } finally { btn.disabled = false; btn.textContent = label; }
    });

    async function fetchInvoicesFor(b) {
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/invoicing/invoices?booking_id=${encodeURIComponent(b.id)}`, { headers: { Authorization: "Bearer " + token } });
        if (res.ok) return (await res.json()).invoices || [];
      } catch (_) {}
      return [];
    }

    async function loadInvoices(b) {
      const host = document.getElementById("viv-list");
      if (!host || host.hidden) return;
      const list = await fetchInvoicesFor(b);
      const money = await canMoney();
      b._invoices = list;
      const rows = money ? list : list.filter((iv) => iv.status !== "void");
      if (!rows.length) { host.innerHTML = vcSec("Invoices for this shoot", `<p class="vc-hint" style="margin:10px 0">Nothing raised yet.</p>`); return; }
      // An invoice marked paid somewhere that didn't mark the shoot paid (the
      // Invoicing page, before 30 Sep 2026): offer to finish the job.
      const paidInv = money && list.find((iv) => iv.status === "paid");
      const heal = paidInv && !b.paid_at ? `<div class="viv-lock">Invoice ${escapeHtml(paidInv.number || "")} is paid, but the shoot isn't marked paid, so the PIN is still locked. <button type="button" class="vc-act" data-vheal="${escapeHtml(paidInv.id)}">Mark the shoot paid and release the PIN</button></div>` : "";
      host.innerHTML = heal + vcSec("Invoices for this shoot", `<div class="viv-rows">${rows.map((iv) => {
        const what = (iv.line_items && iv.line_items[0] && iv.line_items[0].description) || iv.bill_to_name || "";
        const acts = [
          `<button type="button" class="vc-act" data-vview="${escapeHtml(iv.id)}">View</button>`,
          (iv.status === "sent" || iv.status === "paid") && iv.bill_to_email ? `<button type="button" class="vc-act" data-vresend="${escapeHtml(iv.id)}">Resend</button>` : "",
          money && iv.status !== "void" ? `<button type="button" class="vc-act" data-vedit="${escapeHtml(iv.id)}">Edit</button>` : "",
          money && iv.status !== "paid" && iv.status !== "void" ? `<button type="button" class="vc-act" data-vpaid="${escapeHtml(iv.id)}">Mark paid</button>` : "",
          money && iv.status === "draft" ? `<button type="button" class="vc-act" data-vjack="${escapeHtml(iv.id)}">Send for approval</button>` : "",
          money && iv.status === "draft" ? `<button type="button" class="vc-act" data-vdel="${escapeHtml(iv.id)}">Delete</button>` : "",
          money && iv.status !== "draft" && iv.status !== "paid" && iv.status !== "void" ? `<button type="button" class="vc-act" data-vvoid="${escapeHtml(iv.id)}">Void</button>` : "",
        ].join("");
        return `<div class="viv-row"><span>${escapeHtml(iv.number || "Draft")}</span><span class="viv-what" title="${escapeHtml(what)}">${escapeHtml(what)}</span><span class="viv-amt">${escapeHtml(gbpFromPence(iv.total_pence))}</span><span>${vivChip(iv)}</span><span class="viv-acts">${acts}</span></div>`;
      }).join("")}</div>`);
      vivWireRows(b, host, list);
      renderChaseLog(b);
    }
    function vivRefresh(b) { if (vcPane === "invoice") renderInvoiceCard(b); vcFillMoney(b); }
    // The buttons on an invoice, wherever it's shown: its row, or the foot of This invoice.
    function vivWireRows(b, host, list) {
      if (!host) return;
      const find = (id) => list.find((x) => x.id === id) || { id };
      host.querySelectorAll("[data-vview]").forEach((btn) => btn.addEventListener("click", async () => {
        const tab = window.open("", "_blank");   // opened on the click, or the browser blocks it
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/invoicing/invoice-pdf?id=${encodeURIComponent(btn.getAttribute("data-vview"))}`, { headers: { Authorization: "Bearer " + token } });
          const j = await res.json().catch(() => ({}));
          if (!res.ok || !j.url) throw new Error(j.error || "Couldn't open it.");
          if (tab) tab.location = j.url; else window.location = j.url;
        } catch (err) { if (tab) tab.close(); vivStatus("Couldn't open the invoice: " + err.message, true); }
      }));
      host.querySelectorAll("[data-vresend]").forEach((btn) => btn.addEventListener("click", () => resendInvoice(b, btn.getAttribute("data-vresend"), btn)));
      host.querySelectorAll("[data-vedit]").forEach((btn) => btn.addEventListener("click", () => editInvoice(b, btn.getAttribute("data-vedit"))));
      host.querySelectorAll("[data-vpaid]").forEach((btn) => btn.addEventListener("click", () => { btn.disabled = true; markInvoicePaid(b, btn.getAttribute("data-vpaid")); }));
      host.querySelectorAll("[data-vheal]").forEach((btn) => btn.addEventListener("click", () => { btn.disabled = true; const iv = find(btn.getAttribute("data-vheal")); markInvoicePaid(b, iv.id, iv.paid_date); }));
      host.querySelectorAll("[data-vdel]").forEach((btn) => btn.addEventListener("click", async () => {
        const iv = find(btn.getAttribute("data-vdel"));
        if (!confirm(`Delete draft ${iv.number || "invoice"}? It hasn't been sent, so the client never sees it.`)) return;
        btn.disabled = true;
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/invoicing/invoices?id=${encodeURIComponent(iv.id)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } });
          if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || res.status); }
          vivFlash = `Draft ${iv.number || ""} deleted.`;
          vivRefresh(b);
        } catch (err) { vivStatus("Couldn't delete it: " + err.message, true); btn.disabled = false; }
      }));
      /* Void a sent invoice (Danielle, 20 Oct 2026): the same as Void on the
         Invoicing page -- accounts and you are emailed with the reason, and
         the invoice and its PDF are removed. A paid one isn't voided: that's
         a refund. A draft is simply deleted. */
      host.querySelectorAll("[data-vvoid]").forEach((btn) => btn.addEventListener("click", async () => {
        const iv = find(btn.getAttribute("data-vvoid"));
        const num = iv.number || "this invoice";
        const reason = prompt(`Void ${num}? It'll be removed, and accounts and you will be emailed to say so. The client isn't emailed, so tell them yourself if they need to disregard it.\n\nReason for voiding:`);
        if (reason === null) return;
        btn.disabled = true;
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/invoicing/invoices/void`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ id: iv.id, reason }) });
          if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || res.status); }
          vivFlash = `${num} voided. Accounts have been emailed.`;
          vivRefresh(b);
        } catch (err) { vivStatus("Couldn't void it: " + err.message, true); btn.disabled = false; }
      }));
      /* A draft to Jack to approve (Danielle, 21 Oct 2026): the same email the
         morning run sends two days before a shoot. Approve sends it to the
         client; Reject comes back to Danielle with his notes. */
      host.querySelectorAll("[data-vjack]").forEach((btn) => btn.addEventListener("click", async () => {
        btn.disabled = true; btn.textContent = "Sending…";
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/invoicing/approval/request`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ invoice_id: btn.getAttribute("data-vjack") }) });
          const d = await res.json().catch(() => ({}));
          if (!res.ok) throw new Error(d.error || res.status);
          vivFlash = d.test ? "Sent for approval. Test mode: the email came to you, not Jack." : "Sent to Jack to approve. Once he does, it goes.";
          vivRefresh(b);
        } catch (err) { vivStatus("Couldn't send it to Jack: " + err.message, true); btn.disabled = false; btn.textContent = "Send for approval"; }
      }));
    }

    /* Resending is where the wording matters most: it is the second attempt,
       and the reason for it usually needs saying. */
    async function resendInvoice(b, id, btn) {
      const label = btn.textContent; btn.disabled = true; btn.textContent = "Opening…";
      try {
        const token = await authToken();
        await ensureInvSettings();
        const { data: inv } = await supabase.from("invoices").select("*").eq("id", id).maybeSingle();
        if (!inv) { vivStatus("Couldn't find that invoice.", true); return; }
        openInvoiceEmail(inv, async (email) => {
          const res = await fetch(`${WORKER_URL}/invoicing/invoices/send`, {
            method: "POST",
            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
            body: JSON.stringify(Object.assign({ id }, email)),
          });
          const d = await res.json().catch(() => ({}));
          if (res.ok) { vivFlash = `Sent again to ${d.sent_to || "the client"}.`; vivRefresh(b); }
          else vivStatus(d.error || "Couldn't resend.", true);
        });
      } catch (err) { vivStatus("Couldn't resend: " + err.message, true); }
      finally { btn.disabled = false; btn.textContent = label; }
    }

    /* A sent invoice is not edited in place - it has gone to the client and it
       has a number. Editing loads it back into the builder and reissues it as a
       new invoice, voiding the original. */
    async function editInvoice(b, id) {
      const { data, error } = await supabase.from("invoices").select("*").eq("id", id).maybeSingle();
      if (error || !data) { vivStatus("Couldn't load that invoice.", true); return; }
      vivSource = data; vivTab = "this"; vivPreview = null;
      if (vcPane !== "invoice") vcOpen("invoice", true); else renderInvoiceCard(b);
    }

    // Keep the due date honest when terms change.
    function ciApplyVivTerms() {
      const n = Number(document.getElementById("viv-terms")?.value);
      const issued = document.getElementById("viv-issued")?.value;
      const dueEl = document.getElementById("viv-due");
      if (!dueEl || !n || isNaN(n)) return;
      const from = issued ? new Date(issued) : new Date();
      if (isNaN(from)) return;
      from.setDate(from.getDate() + n);
      dueEl.value = from.toISOString().slice(0, 10);
    }

    /* What we've sent chasing this invoice, under the invoices themselves. An
       automatic email nobody can see having been sent is indistinguishable from
       one that never went - and "did we actually chase them?" is the first
       question anyone asks about an unpaid invoice. */
    async function renderChaseLog(b) {
      const host = document.getElementById("viv-list");
      if (!host || !WORKER_URL) return;
      let msgs = [];
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/booking/thread?booking_id=${encodeURIComponent(b.id)}`, { headers: { Authorization: "Bearer " + token } });
        if (res.ok) msgs = (await res.json()).messages || [];
      } catch (_) { return; }
      const chases = msgs.filter((m) => ["invoice_chase", "invoice_overdue_alert", "payment_reminder"].includes(m.kind));
      if (!chases.length) return;
      const when = (d) => { try { return new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" }); } catch (_) { return ""; } };
      host.insertAdjacentHTML("beforeend", `
        <div class="vid-chaselog">
          <div class="vid-chaselog-h">Chasers sent</div>
          ${chases.map((m) => `<div class="vid-chaselog-row">
            <span class="vid-chaselog-when">${escapeHtml(when(m.created_at))}</span>
            <span>${escapeHtml(m.subject || "-")}</span>
            ${m.kind === "invoice_overdue_alert" ? `<span class="vid-inv-status">internal</span>` : ""}
          </div>`).join("")}
        </div>`);
    }

    // Marking the invoice paid marks the shoot paid and, if they already have
    // the gallery, sends the PIN. The Worker does both (and writes the notes),
    // so it's the same whichever page the button is on.
    async function markInvoicePaid(b, id, paidDate) {
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/invoicing/invoices`, {
          method: "PATCH",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify(paidDate ? { id, status: "paid", paid_date: paidDate } : { id, status: "paid" }),
        });
        if (!res.ok) { const d = await res.json().catch(() => ({})); throw new Error(d.error || res.status); }
        const { data } = await supabase.from("videography_bookings").select("paid_at, pin_released_at").eq("id", b.id).maybeSingle();
        if (data) { b.paid_at = data.paid_at; b.pin_released_at = data.pin_released_at; }
        vivFlash = "Marked paid.";
        vivRefresh(b);
        if (typeof loadThread === "function") { try { loadThread(b); } catch (_) {} }
      } catch (err) { vivStatus("Couldn't mark it paid: " + err.message, true); }
    }

    /* ---- Notes: the internal record, and the audit trail ----
       Notes live in booking_messages on channel 'note' (typed by a person) or
       'system' (written by an action, e.g. confirming the F&C fee). Neither
       ever reaches the client - see supabase/booking_notes_private.sql. */
    let adminList = [];
    async function loadAdmins() {
      if (adminList.length || !WORKER_URL) return adminList;
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/admins/list`, { headers: { Authorization: "Bearer " + token } });
        if (res.ok) adminList = (await res.json()).admins || [];
      } catch (_) {}
      return adminList;
    }

    /* A social media client's notes for the shoots (Danielle, 27 Oct): kept on
       the client, written in their file's Videography tab, and shown here on
       every shoot booked for them until someone marks them done. */
    async function renderClientVideoNotes(b) {
      const host = document.getElementById("vid-clientnotes");
      if (!host) return;
      const { notes, error } = await listVideoNotes(supabase, b.smm_lead_id, { openOnly: true });
      if (error || !notes.length) { host.hidden = true; return; }
      host.hidden = false;
      host.innerHTML = `
        <h4>From the social media client file</h4>
        <p class="vid-hint" style="margin-bottom:12px">Notes about this client's shoots. They show on every shoot booked for them until marked done.</p>
        <div class="vid-notes">${notes.map((n) => `
          <div class="vid-note is-client">
            <div class="vid-note-meta"><strong>${escapeHtml(noteAuthor(n.created_by))}</strong><span>${escapeHtml(fmtWhen(n.created_at) || "")}</span></div>
            <div class="vid-note-body">${escapeHtml(n.body || "")}</div>
            <button type="button" class="vid-note-done" data-cndone="${escapeHtml(n.id)}">Mark done</button>
          </div>`).join("")}</div>`;
      host.querySelectorAll("[data-cndone]").forEach((btn) => btn.addEventListener("click", async () => {
        btn.disabled = true;
        const by = (await supabase.auth.getSession()).data.session?.user?.email || null;
        const e = await setVideoNoteDone(supabase, btn.getAttribute("data-cndone"), true, by);
        if (e) { btn.disabled = false; btn.textContent = "Couldn't save"; return; }
        renderClientVideoNotes(b);
      }));
    }

    function renderNotes(b, notes) {
      const host = document.getElementById("vid-cand-notes");
      if (!host) return;
      const rows = notes.map((n) => {
        const audit = n.kind === "audit" || n.channel === "system";
        const who = n.created_by && n.created_by !== "system" ? n.created_by : "System";
        return `<div class="vid-note ${audit ? "is-audit" : ""}">
          <div class="vid-note-meta"><strong>${escapeHtml(who)}</strong><span>${escapeHtml(fmtWhen(n.created_at) || "")}</span></div>
          <div class="vid-note-body">${highlightMentions(n.body || "")}</div>
        </div>`;
      }).join("") || `<p class="vid-loading">No notes yet.</p>`;

      host.innerHTML = `
        ${b.smm_lead_id ? `<div class="vid-clientnotes" id="vid-clientnotes" hidden></div>` : ""}
        <h4>Notes</h4>
        <p class="vid-hint" style="margin-bottom:12px">Internal only — the client never sees these. Type @ to tag a colleague.</p>
        <div class="vid-notes">${rows}</div>
        <div class="vid-note-compose">
          <textarea id="vid-note-body" rows="3" placeholder="Add a note…"></textarea>
          <div class="vid-mention-menu" id="vid-mention-menu" hidden></div>
          <button type="button" class="admin-btn admin-btn-primary" id="vid-note-add">Add note</button>
        </div>`;
      document.getElementById("vid-note-add")?.addEventListener("click", () => addNote(b));
      if (b.smm_lead_id) renderClientVideoNotes(b);
      wireMentions(document.getElementById("vid-note-body"));
      loadAdmins();
    }

    function highlightMentions(text) {
      return escapeHtml(text).replace(/(^|\s)(@[\w.+-]+@[\w.-]+)/g, '$1<span class="vid-mention">$2</span>').replace(/\n/g, "<br>");
    }

    /* Type @ and pick a colleague. Deliberately matches on the whole email:
       two admins can share a first name, and a tag that goes to the wrong
       person is worse than one that is slightly long. */
    function wireMentions(ta) {
      const menu = document.getElementById("vid-mention-menu");
      if (!ta || !menu) return;
      const close = () => { menu.hidden = true; };
      ta.addEventListener("input", async () => {
        const upto = ta.value.slice(0, ta.selectionStart);
        const m = upto.match(/@([\w.+-]*)$/);
        if (!m) return close();
        const list = (await loadAdmins()).filter((e) => e.toLowerCase().includes(m[1].toLowerCase()));
        if (!list.length) return close();
        menu.innerHTML = list.slice(0, 6).map((e) => `<button type="button" data-mention="${escapeHtml(e)}">${escapeHtml(e)}</button>`).join("");
        menu.hidden = false;
        menu.querySelectorAll("[data-mention]").forEach((btn) => btn.addEventListener("click", () => {
          const email = btn.getAttribute("data-mention");
          ta.value = ta.value.slice(0, ta.selectionStart - m[0].length) + "@" + email + " " + ta.value.slice(ta.selectionStart);
          close(); ta.focus();
        }));
      });
      ta.addEventListener("blur", () => setTimeout(close, 150));
    }

    async function addNote(b, bodyOverride, kind) {
      const ta = document.getElementById("vid-note-body");
      const body = bodyOverride != null ? bodyOverride : (ta?.value || "").trim();
      if (!body) return;
      if (!WORKER_URL) { alert("Connect the Worker to add notes."); return; }
      const mentions = [...body.matchAll(/@([\w.+-]+@[\w.-]+)/g)].map((m) => m[1]);
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/booking/message`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ booking_id: b.id, source: "videography", body, notify: false, kind: kind || "manual", mentions }),
        });
        if (!res.ok) { const d = await res.json().catch(() => ({})); alert("Couldn't save that note: " + (d.error || res.status)); return; }
      } catch (err) { alert("Couldn't save that note: " + err.message); return; }
      if (ta) ta.value = "";
      loadThread(b);
    }

    function threadStatus(msg, ok) {
      const el = document.getElementById("vid-thread-status"); if (!el) return;
      el.hidden = false; el.textContent = msg; el.style.color = ok === false ? "#8a3b2f" : "var(--english-violet)";
    }
    async function sendMsg(b) {
      const body = document.getElementById("vid-msg-body")?.value.trim();
      const subject = document.getElementById("vid-msg-subj")?.value.trim();
      const notify = document.getElementById("vid-msg-notify")?.checked;
      const fileInput = document.getElementById("vid-msg-file");
      const file = fileInput && fileInput.files && fileInput.files[0];
      if (!body && !file) return;
      const btn = document.getElementById("vid-msg-send"); btn.disabled = true; btn.textContent = "Sending…";
      try {
        const token = await authToken();
        // If a file is attached, store it as a booking document first so it both
        // appears under the booking AND can be attached to the notification email.
        let documentId = null;
        if (file) {
          const qs = new URLSearchParams({ booking_id: b.id, source: "videography", category: "other", file_name: file.name, content_type: file.type || "application/octet-stream" });
          const up = await fetch(`${WORKER_URL}/booking/document?${qs.toString()}`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": file.type || "application/octet-stream" }, body: file });
          if (!up.ok) throw new Error(((await up.json().catch(() => ({}))).error) || "Attachment upload failed");
          const upd = await up.json().catch(() => ({}));
          documentId = upd && upd.document ? upd.document.id : null;
        }
        const finalBody = body || `I've attached a document for you: ${file.name}`;
        const res = await fetch(`${WORKER_URL}/booking/message`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" }, body: JSON.stringify({ booking_id: b.id, source: "videography", subject, body: finalBody, notify, document_id: documentId }) });
        if (!res.ok) throw new Error(((await res.json().catch(() => ({}))).error) || "Failed to send");
        loadThread(b);
      } catch (e) { threadStatus(e.message || "Couldn't send", false); btn.disabled = false; btn.textContent = "Send message"; }
    }
    async function uploadDoc(b) {
      const fileInput = document.getElementById("vid-doc-file");
      const cat = document.getElementById("vid-doc-cat")?.value || "other";
      const file = fileInput && fileInput.files && fileInput.files[0];
      if (!file) { threadStatus("Choose a file first.", false); return; }
      const btn = document.getElementById("vid-doc-up"); btn.disabled = true; btn.textContent = "Uploading…";
      try {
        const token = await authToken();
        const qs = new URLSearchParams({ booking_id: b.id, source: "videography", category: cat, file_name: file.name, content_type: file.type || "application/octet-stream" });
        const res = await fetch(`${WORKER_URL}/booking/document?${qs.toString()}`, { method: "POST", headers: { Authorization: "Bearer " + token, "Content-Type": file.type || "application/octet-stream" }, body: file });
        if (!res.ok) throw new Error(((await res.json().catch(() => ({}))).error) || "Upload failed");
        loadThread(b);
      } catch (e) { threadStatus(e.message || "Couldn't upload", false); btn.disabled = false; btn.textContent = "Attach document"; }
    }
    async function deleteDoc(b, id) {
      if (!confirm("Remove this document?")) return;
      try {
        const token = await authToken();
        await fetch(`${WORKER_URL}/booking/document?id=${encodeURIComponent(id)}`, { method: "DELETE", headers: { Authorization: "Bearer " + token } });
        loadThread(b);
      } catch (_) {}
    }
    /* Delivered means finished, not "we sent it": a shoot with an unpaid
       invoice or an outstanding round of edits can't be marked delivered, by
       the button or by dragging its card onto the Delivered column (Danielle,
       20 Oct 2026: the drag used to skip this). Says why, and returns false. */
    function canDeliver(b) {
      if (isSmmCovered(b)) return true;
      const missing = [];
      if (!b.paid_at) missing.push("• Payment hasn't been received: the invoice isn't marked paid.");
      if (!b.edits_settled_at) missing.push("• The client's round of edits hasn't been settled.");
      if (!missing.length) return true;
      alert("This shoot can't be marked delivered yet:\n\n" + missing.join("\n") +
        "\n\nOnce " + (missing.length > 1 ? "both are" : "that's") + " ticked on the client file, mark it delivered.");
      return false;
    }
    function prevStageOf(k) { const i = STAGES.findIndex((s) => s.key === k); return i > 0 ? STAGES[i - 1].key : k; }
    async function advanceStage(to) {
      const b = bookings.find((x) => x.id === candId);
      if (!b) return;
      // The one hard stop in the pipeline. Raising an invoice against an
      // unverified marketing fee is the mistake this whole step exists for, so
      // here it blocks rather than warns.
      // Delivered means finished, not "we sent it". A job with an unpaid
      // invoice or an outstanding amend is neither, so it cannot close.
      // A package shoot has no invoice to chase and no client edits to settle:
      // the team sorts edits between themselves and Jack closes it.
      if (to === "delivered" && !canDeliver(b)) return;
      if (to === "invoiced" && isBrandInvoiced(b) && !b.brand_fee_confirmed) {
        alert("Before you raise an invoice:\n\nFine & Country haven't confirmed the marketing fee is held. Tick the confirmation above once the office has confirmed it.");
        return;
      }
      const prev = b.stage; b.stage = to; renderCandidate();
      const { error } = await supabase.from("videography_bookings").update({ stage: to }).eq("id", b.id);
      if (error) { b.stage = prev; renderCandidate(); alert("Couldn't update stage: " + error.message); return; }
      renderClients(document.getElementById("vid-client-search")?.value || "");
      // A social media shoot has no client gallery: the delivery is telling
      // whoever runs that account that the content is in the Library.
      if (to === "gallery_ready" && b.smm_lead_id) await tellSmmManager(b);
    }
    async function tellSmmManager(b) {
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/videography/smm-ready`, {
          method: "POST",
          headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
          body: JSON.stringify({ booking_id: b.id }),
        });
        const d = await res.json().catch(() => ({}));
        if (!res.ok) { alert("The stage is saved, but nobody was told: " + (d.error || res.status)); return; }
        if (d.to) {
          // The same field the client gallery uses for "they have it", because
          // for a package shoot this IS the delivery.
          await saveBookingPatch(b, { gallery_sent_at: new Date().toISOString() });
          alert(`${d.to} has been told the content is ready, with a link to the Library.`);
        }
      } catch (err) {
        alert("The stage is saved, but nobody was told: " + err.message);
      }
    }

    function candAction(act) {
      const b = bookings.find((x) => x.id === candId);
      if (!b) return;
      if (act === "edit") { openModal(b.id); return; }
      if (act === "back") { advanceStage(prevStageOf(b.stage)); return; }
      const drawer = document.getElementById("vid-cand-drawer");
      if (!drawer) return;
      openActModal({ reschedule: "Reschedule shoot", add: "Add to this job", contact: "Contact" }[act] || "Booking");
      if (act === "contact") { renderContactDrawer(b); return; }
      if (act === "reschedule") {
        drawer.innerHTML = `<h4>Reschedule shoot</h4>
          <div class="vid-cand-form">
            <div class="vid-field"><label>New date &amp; time</label><input type="datetime-local" id="vid-resch" value="${b.shoot_date ? new Date(b.shoot_date).toISOString().slice(0, 16) : ""}" /></div>
            <button type="button" class="admin-btn admin-btn-primary" id="vid-resch-save">Save date</button>
          </div>`;
        document.getElementById("vid-resch-save").addEventListener("click", async () => {
          const v = document.getElementById("vid-resch").value;
          const iso = v ? new Date(v).toISOString() : null;
          const { error } = await supabase.from("videography_bookings").update({ shoot_date: iso }).eq("id", b.id);
          if (error) { alert("Couldn't save: " + error.message); return; }
          b.shoot_date = iso; renderCandidate();
          renderClients(document.getElementById("vid-client-search")?.value || "");
        });
        return;
      }
      if (act === "add") {
        drawer.innerHTML = `<h4>Add to this job — one thing at a time</h4>
          <div class="vid-add-opts">
            <button type="button" class="vid-add-opt" data-add="service"><strong>Additional service</strong><span>Add another service to the shoot.</span></button>
            <button type="button" class="vid-add-opt" data-add="cost"><strong>Extra cost</strong><span>Add a charge to the quote.</span></button>
            <button type="button" class="vid-add-opt" data-add="file"><strong>Edit the file</strong><span>Open the full details to edit.</span></button>
          </div>
          <div id="vid-add-form"></div>`;
        drawer.querySelectorAll("[data-add]").forEach((btn) => btn.addEventListener("click", () => addThing(btn.getAttribute("data-add"))));
      }
    }
    function addThing(kind) {
      const b = bookings.find((x) => x.id === candId);
      if (!b) return;
      // Hand over to the booking form rather than stacking one modal on another.
      if (kind === "file") { closeActModal(); openModal(b.id); return; }
      const form = document.getElementById("vid-add-form");
      if (!form) return;
      if (kind === "service") {
        form.innerHTML = `<div class="vid-cand-form"><div class="vid-field"><label>Service to add</label><input type="text" id="vid-add-svc" placeholder="e.g. Drone footage" /></div><button type="button" class="admin-btn admin-btn-primary" id="vid-add-svc-save">Add service</button></div>`;
        document.getElementById("vid-add-svc-save").addEventListener("click", async () => {
          const v = document.getElementById("vid-add-svc").value.trim(); if (!v) return;
          const svc = b.service ? b.service + ", " + v : v;
          const { error } = await supabase.from("videography_bookings").update({ service: svc }).eq("id", b.id);
          if (error) { alert(error.message); return; }
          b.service = svc; renderCandidate(); renderClients(document.getElementById("vid-client-search")?.value || "");
        });
      }
      if (kind === "cost") {
        form.innerHTML = `<div class="vid-cand-form"><div class="vid-field"><label>What for</label><input type="text" id="vid-add-cl" placeholder="e.g. Travel" /></div><div class="vid-field"><label>Amount (£)</label><input type="number" id="vid-add-ca" min="0" step="0.01" /></div><button type="button" class="admin-btn admin-btn-primary" id="vid-add-c-save">Add cost</button></div>`;
        document.getElementById("vid-add-c-save").addEventListener("click", async () => {
          const label = document.getElementById("vid-add-cl").value.trim();
          const amt = parseFloat(document.getElementById("vid-add-ca").value) || 0;
          if (!amt) return;
          const pence = (b.amount_pence || 0) + Math.round(amt * 100);
          const note = (b.notes ? b.notes + "\n" : "") + ("+ £" + amt.toFixed(2) + (label ? " " + label : "")).trim();
          const { error } = await supabase.from("videography_bookings").update({ amount_pence: pence, notes: note }).eq("id", b.id);
          if (error) { alert(error.message); return; }
          b.amount_pence = pence; b.notes = note; renderCandidate(); renderClients(document.getElementById("vid-client-search")?.value || "");
        });
      }
    }

    /* Distance from a central Kettering postcode (Jack's base) via postcodes.io. */
    function haversineMiles(la1, lo1, la2, lo2) {
      const R = 3958.8, t = (x) => (x * Math.PI) / 180;
      const dLa = t(la2 - la1), dLo = t(lo2 - lo1);
      const a = Math.sin(dLa / 2) ** 2 + Math.cos(t(la1)) * Math.cos(t(la2)) * Math.sin(dLo / 2) ** 2;
      return 2 * R * Math.asin(Math.sqrt(a));
    }
    async function showDistance(b) {
      const span = document.querySelector("#vid-cand [data-distance] strong");
      if (!span) return;
      const m = ((b.location || b.postcode) || "").match(/[A-Z]{1,2}\d[A-Z\d]?\s*\d[A-Z]{2}/i);
      if (!m) { span.textContent = "add a postcode"; return; }
      try {
        const base = await getBaseCoords();
        const r = await fetch("https://api.postcodes.io/postcodes/" + encodeURIComponent(m[0].replace(/\s+/g, "")));
        const d = await r.json();
        if (!d.result) { span.textContent = "postcode not found"; return; }
        const miles = haversineMiles(base.lat, base.lon, d.result.latitude, d.result.longitude);
        span.textContent = Math.round(miles) + " mi from base";
      } catch (_) { span.textContent = "unknown"; }
    }

    /* ---- The booking's CRM contact ----
       Bookings taken through the public form arrive with an email, so the
       Worker can join them to a contact on the way in. The ones Jack adds by
       hand often cannot be joined automatically - a phone call, a name and a
       date - so this is the manual route: look for a match, pick one yourself,
       or make the contact from what the booking already knows.

       Deliberately three separate answers rather than one clever one. A guess
       good enough to show as a suggestion is not good enough to act on by
       itself, so nothing here links anything without being asked to. */
    const contactCache = new Map();   // id -> contact row, so re-renders don't re-fetch

    function contactName(c) {
      const n = [c.first_name, c.last_name].filter(Boolean).join(" ").trim();
      return n || c.email || "Unnamed contact";
    }
    // Last six digits, which survives every way a UK number gets typed
    // ("07123 456789", "+447123456789", "07123456789").
    function phoneTail(v) {
      const digits = (v || "").replace(/\D/g, "");
      return digits.length >= 6 ? digits.slice(-6) : "";
    }

    async function getContact(id) {
      if (!id) return null;
      if (contactCache.has(id)) return contactCache.get(id);
      const { data } = await supabase.from("contacts").select("id,email,first_name,last_name,phone,company,lifecycle,user_id").eq("id", id).maybeSingle();
      if (data) contactCache.set(id, data);
      return data || null;
    }

    async function showLinkedContact(b) {
      if (!document.querySelector("#vid-cand [data-contact]")) return;
      const c = b.contact_id ? await getContact(b.contact_id) : null;
      if (b.id !== candId) return;
      vcCache.contact = c ? contactName(c) : "Not linked";
      const span = document.querySelector("#vid-cand [data-contact]");
      if (span) span.textContent = vcCache.contact;
    }

    /* What this booking looks like it belongs to. Each query is separate rather
       than one .or() string - the search text is the client's own name and
       email, and PostgREST's or() takes commas and brackets as syntax. */
    async function suggestContacts(b) {
      const found = new Map();   // id -> { contact, why }
      const add = (rows, why) => (rows || []).forEach((c) => { if (!found.has(c.id)) found.set(c.id, { c, why }); });
      const cols = "id,email,first_name,last_name,phone,company,lifecycle,user_id";
      const email = (b.client_email || "").trim();
      const name = (b.client_name || "").trim();
      const tail = phoneTail(b.client_phone);

      if (email) {
        const { data } = await supabase.from("contacts").select(cols).ilike("email", email).limit(5);
        add(data, "same email");
      }
      if (tail) {
        const { data } = await supabase.from("contacts").select(cols).ilike("phone", "%" + tail).limit(5);
        add(data, "same phone number");
      }
      if (name) {
        const first = name.split(/\s+/)[0];
        const last = name.split(/\s+/).slice(1).join(" ");
        if (last) {
          const { data } = await supabase.from("contacts").select(cols).ilike("first_name", first).ilike("last_name", last).limit(5);
          add(data, "same name");
        }
        const { data } = await supabase.from("contacts").select(cols).ilike("last_name", last || first).limit(5);
        add(data, "same surname");
      }
      return [...found.values()];
    }

    async function searchContacts(q) {
      const term = (q || "").trim();
      if (term.length < 2) return [];
      const cols = "id,email,first_name,last_name,phone,company,lifecycle,user_id";
      const found = new Map();
      // One query per column for the same reason as above: the term is free text.
      for (const col of ["email", "first_name", "last_name", "company"]) {
        const { data } = await supabase.from("contacts").select(cols).ilike(col, "%" + term + "%").limit(8);
        (data || []).forEach((c) => found.set(c.id, c));
      }
      return [...found.values()].slice(0, 12);
    }

    function contactRow(c, why, action) {
      return `<div class="vid-contact-row">
        <div class="vid-contact-who">
          <strong>${escapeHtml(contactName(c))}</strong>
          <span>${escapeHtml([c.email, c.company].filter(Boolean).join(" · ") || "no email on file")}</span>
        </div>
        ${why ? `<span class="vid-contact-why">${escapeHtml(why)}</span>` : ""}
        ${action}
      </div>`;
    }

    async function renderContactDrawer(b) {
      const drawer = document.getElementById("vid-cand-drawer");
      if (!drawer) return;
      drawer.innerHTML = `<h4>Contact</h4><p class="vid-loading">Looking for a match…</p>`;

      const linked = await getContact(b.contact_id);
      const suggestions = linked ? [] : await suggestContacts(b);

      // Three states, and the difference matters: on their account, linkable to
      // an account, or nobody to link to.
      const onAccount = linked && linked.user_id && b.account_user_id === linked.user_id;
      const canAttach = linked && linked.user_id && !onAccount;
      const accountLine = !linked ? ""
        : onAccount
          ? `<p class="vid-hint">They can see this shoot in their own account under My bookings.</p>`
          : canAttach
            ? `<p class="vid-hint">${escapeHtml(contactName(linked))} has a TMKE account, but this shoot is not attached to it yet — so it will not appear under their My bookings.</p>
               <div class="vid-cand-actions" style="margin-top:10px"><button type="button" class="admin-btn admin-btn-primary" data-contact-attach>Show it in their account</button></div>`
            : `<p class="vid-hint">${escapeHtml(contactName(linked))} has no TMKE account, so there is no My bookings for this to appear in. The link is admin-side only until they sign up with ${escapeHtml(linked.email || "that address")}.</p>`;

      const linkedBlock = linked
        ? `<div class="vid-gate is-done">
             <div class="vid-gate-h">Linked to</div>
             ${contactRow(linked, "", `<button type="button" class="admin-btn admin-btn-ghost" data-contact-unlink>Unlink</button>`)}
             ${accountLine}
             <p class="vid-hint">Unlinking leaves the contact alone — it only removes the join to this shoot.</p>
           </div>`
        : suggestions.length
          ? `<div class="vid-contact-block">
               <div class="vid-gate-h">Looks like it might be</div>
               <p class="vid-hint" style="margin-bottom:10px">Matched on what the booking already knows. Check it is the right person before linking — nothing here links itself.</p>
               ${suggestions.map((s) => contactRow(s.c, s.why, `<button type="button" class="admin-btn admin-btn-primary" data-contact-link="${escapeHtml(s.c.id)}">Link</button>`)).join("")}
             </div>`
          : `<div class="vid-contact-block"><p class="vid-hint">Nothing in the CRM matches this booking's name, email or phone number. Search for them below, or make the contact from what the booking already has.</p></div>`;

      const company = b.client_company || b.company || "";
      drawer.innerHTML = `
        <h4>Contact</h4>
        ${linkedBlock}
        <div class="vid-contact-block">
          <div class="vid-gate-h">${linked ? "Link to somebody else" : "Search for them"}</div>
          <div class="vid-archive-row">
            <input type="text" id="vid-contact-q" placeholder="Name, email or company…" />
            <button type="button" class="admin-btn admin-btn-ghost" id="vid-contact-search">Search</button>
          </div>
          <div id="vid-contact-results"></div>
        </div>
        <div class="vid-contact-block">
          <div class="vid-gate-h">Or make a new contact</div>
          <p class="vid-hint" style="margin-bottom:10px">Pre-filled from the booking. An email address is how the CRM tells people apart, so it is the one thing this needs.</p>
          <div class="vid-cand-form">
            <div class="vid-field"><label>Name</label><input type="text" id="vid-nc-name" value="${escapeHtml(b.client_name || "")}" /></div>
            <div class="vid-field"><label>Email</label><input type="email" id="vid-nc-email" value="${escapeHtml(b.client_email || "")}" /></div>
            <div class="vid-field"><label>Phone</label><input type="text" id="vid-nc-phone" value="${escapeHtml(b.client_phone || "")}" /></div>
            <div class="vid-field"><label>Company</label><input type="text" id="vid-nc-company" value="${escapeHtml(company)}" /></div>
            <button type="button" class="admin-btn admin-btn-primary" id="vid-nc-save">Create &amp; link</button>
          </div>
        </div>
        <p class="vid-warn" id="vid-contact-msg" hidden></p>`;

      wireContactDrawer(b);
    }

    function contactMsg(text, bad) {
      const el = document.getElementById("vid-contact-msg");
      if (!el) return;
      el.hidden = !text;
      el.textContent = text || "";
      el.style.color = bad ? "#8a3b2f" : "var(--english-violet)";
    }

    function wireContactDrawer(b) {
      const drawer = document.getElementById("vid-cand-drawer");
      if (!drawer) return;
      drawer.querySelectorAll("[data-contact-link]").forEach((btn) =>
        btn.addEventListener("click", () => linkContact(b, btn.getAttribute("data-contact-link"))));
      drawer.querySelector("[data-contact-unlink]")?.addEventListener("click", () => linkContact(b, null));
      // Re-running the link is the whole repair: it is what stamps the account.
      drawer.querySelector("[data-contact-attach]")?.addEventListener("click", () =>
        linkContact(b, b.contact_id, "Attached — it will show under their My bookings."));
      document.getElementById("vid-nc-save")?.addEventListener("click", () => createContactFor(b));

      const q = document.getElementById("vid-contact-q");
      const run = async () => {
        const host = document.getElementById("vid-contact-results");
        if (!host) return;
        const term = q ? q.value : "";
        if (term.trim().length < 2) { host.innerHTML = `<p class="vid-hint">Type at least two characters.</p>`; return; }
        host.innerHTML = `<p class="vid-loading">Searching…</p>`;
        const rows = await searchContacts(term);
        host.innerHTML = rows.length
          ? rows.map((c) => contactRow(c, "", `<button type="button" class="admin-btn admin-btn-ghost" data-contact-link="${escapeHtml(c.id)}">Link</button>`)).join("")
          : `<p class="vid-hint">Nobody in the CRM matches that. Make the contact below instead.</p>`;
        host.querySelectorAll("[data-contact-link]").forEach((btn) =>
          btn.addEventListener("click", () => linkContact(b, btn.getAttribute("data-contact-link"))));
      };
      document.getElementById("vid-contact-search")?.addEventListener("click", run);
      q?.addEventListener("keydown", (e) => { if (e.key === "Enter") { e.preventDefault(); run(); } });
    }

    /* Linking is two joins, not one, because the client's own account finds a
       shoot a different way than the CRM does. /account/bookings looks for
       account_user_id (or a client_email matching the account's own address),
       and the row-level policy on the table gates reads the same way - so a
       contact_id on its own is an admin-side note the client cannot see.

       If the contact has a TMKE account, linking attaches the shoot to it too.
       If they have not got one, there is nothing to attach to and the drawer
       says so rather than leaving you to wonder why nothing happened. */
    async function linkContact(b, contactId, note) {
      const patch = { contact_id: contactId };
      if (contactId) {
        const c = await getContact(contactId);
        if (c && c.user_id) patch.account_user_id = c.user_id;
      } else {
        // Unlinking gives back what linking took, and no more: an
        // account_user_id the booking flow set for itself belongs to the
        // booking, not to this link, so it is left alone.
        const prev = await getContact(b.contact_id);
        if (prev && prev.user_id && b.account_user_id === prev.user_id) patch.account_user_id = null;
      }
      const { error } = await supabase.from("videography_bookings").update(patch).eq("id", b.id);
      if (error) { contactMsg("Couldn't save that link: " + error.message, true); return; }
      b.contact_id = contactId;
      if ("account_user_id" in patch) b.account_user_id = patch.account_user_id;
      // The card re-renders underneath - the button's label and the meta row
      // both change - and the modal is outside it, so it simply stays put.
      renderCandidate();
      await renderContactDrawer(b);
      contactMsg(note || (contactId ? "Linked." : "Unlinked."));
    }

    /* Made from the booking, tagged the way the CRM backfill tags a videography
       client so this contact sorts with the rest of them. Marketing consent is
       not something a booking can speak for, so it is left off. */
    async function createContactFor(b) {
      const name = (document.getElementById("vid-nc-name")?.value || "").trim();
      const email = (document.getElementById("vid-nc-email")?.value || "").trim().toLowerCase();
      const phone = (document.getElementById("vid-nc-phone")?.value || "").trim();
      const company = (document.getElementById("vid-nc-company")?.value || "").trim();
      if (!email) { contactMsg("A contact needs an email address — it is how the CRM tells people apart.", true); return; }

      const first = name.split(/\s+/)[0] || null;
      const last = name.split(/\s+/).slice(1).join(" ") || null;
      const product = { content: "Content-Studio", "content-studio": "Content-Studio", property: "Property-Videography", agent: "Agent-Videography" }[b.service_type];
      const network = /(experts\.co\.uk|@theauctioncompany\.co\.uk|@tmke\.co\.uk)$/.test(email) ? "Network: TEG"
        : /@fineandcountry\.(com|co\.uk)$/.test(email) ? "Network: Fine-and-Country"
        : "Network: External";
      const tags = ["Videography-Client", "Marketing-Not-Opted-In", network];
      if (product) tags.push("Videography-Product: " + product);

      const { data, error } = await supabase.from("contacts").insert({
        email, first_name: first, last_name: last, phone: phone || null, company: company || null,
        source: "videography", lifecycle: "customer", marketing_opt_in: false, tags,
      }).select("id,email,first_name,last_name,phone,company,lifecycle,user_id").maybeSingle();

      // Email is the CRM's unique key, so "already exists" is a link, not an
      // error - the person you were about to create is already on file.
      if (error) {
        if (!/duplicate|unique/i.test(error.message || "")) { contactMsg("Couldn't create that contact: " + error.message, true); return; }
        // .eq, not .ilike: `_` is a wildcard in ilike and a legal character in
        // an email, so a pattern match here could return somebody else and link
        // the shoot to the wrong person. The insert just failed on the unique
        // index over this exact value, so an exact match is what finds it.
        const { data: existing } = await supabase.from("contacts").select("id").eq("email", String(email || "").trim().toLowerCase()).maybeSingle();
        if (!existing) { contactMsg("Couldn't create that contact: " + error.message, true); return; }
        await linkContact(b, existing.id, `${email} was already in the CRM — linked to them instead.`);
        return;
      }
      if (data) contactCache.set(data.id, data);
      await linkContact(b, data.id, "Contact created and linked.");
    }

    /* Auto-advance: a booked job becomes "Shoot day" once its day arrives. */
    function startOfDay(d) { const x = new Date(d); x.setHours(0, 0, 0, 0); return x.getTime(); }
    async function autoAdvance() {
      const today = startOfDay(Date.now());
      // On the day: whatever it was, it is now a shoot day.
      const due = bookings.filter((b) => (b.stage === "booked" || b.stage === "invoiced") && b.shoot_date && startOfDay(b.shoot_date) <= today);
      for (const b of due) {
        b.stage = "shoot_day";
        await supabase.from("videography_bookings").update({ stage: "shoot_day" }).eq("id", b.id);
      }
      // The day after: the shoot has happened, so it is being edited. Nobody
      // needs to drag a card to say the day ended.
      const shot = bookings.filter((b) => b.stage === "shoot_day" && b.shoot_date && startOfDay(b.shoot_date) < today);
      for (const b of shot) {
        b.stage = "editing";
        await supabase.from("videography_bookings").update({ stage: "editing" }).eq("id", b.id);
      }
    }

    /* ---------- Diary (per-day hour blocks) ---------- */
    let availability = [];
    const DIARY_HOURS = []; for (let h = 6; h <= 21; h++) DIARY_HOURS.push(h); // 06:00–22:00 blocks
    let diaryState = {};   // weekday -> Set(hours)
    let diaryOpen = null;  // currently expanded weekday
    let diaryInit = false;

    function hoursForRow(a) {
      if (a && Array.isArray(a.hours) && a.hours.length) return a.hours.map(Number);
      if (a && a.is_available !== false && a.start_time && a.end_time) {
        const sh = parseInt(a.start_time.split(":")[0], 10);
        const [eh, em] = a.end_time.split(":").map(Number);
        const end = em > 0 ? eh + 1 : eh;
        const out = []; for (let h = sh; h < end; h++) out.push(h); return out;
      }
      return [];
    }
    function fmtHours(set) {
      const hrs = [...set].sort((a, b) => a - b);
      if (!hrs.length) return "Closed";
      const ranges = []; let start = hrs[0], prev = hrs[0];
      for (let i = 1; i < hrs.length; i++) {
        if (hrs[i] === prev + 1) prev = hrs[i];
        else { ranges.push([start, prev + 1]); start = prev = hrs[i]; }
      }
      ranges.push([start, prev + 1]);
      return ranges.map(([a, b]) => `${String(a).padStart(2, "0")}:00–${String(b).padStart(2, "0")}:00`).join(", ");
    }
    function renderDiary() {
      const wrap = document.getElementById("vid-diary");
      if (!wrap) return;
      if (!diaryInit) {
        const byDay = new Map(availability.map((a) => [a.weekday, a]));
        DAYS.forEach(({ d }) => { diaryState[d] = new Set(hoursForRow(byDay.get(d))); });
        diaryInit = true;
      }
      wrap.innerHTML = DAYS.map(({ d, name }) => {
        const set = diaryState[d] || new Set();
        const open = diaryOpen === d;
        return `
          <div class="vid-day ${open ? "is-open" : ""}" data-day="${d}">
            <button type="button" class="vid-day-head" data-day-head="${d}">
              <span class="vid-day-name">${name}</span>
              <span class="vid-day-summary ${set.size ? "" : "is-off"}">${fmtHours(set)}</span>
              <span class="vid-day-chev">›</span>
            </button>
            <div class="vid-day-hours">
              ${DIARY_HOURS.map((h) => `<button type="button" class="vid-hour ${set.has(h) ? "is-on" : ""}" data-day="${d}" data-hour="${h}">${String(h).padStart(2, "0")}:00</button>`).join("")}
            </div>
          </div>`;
      }).join("");
      wrap.querySelectorAll("[data-day-head]").forEach((b) => b.addEventListener("click", () => {
        const d = Number(b.getAttribute("data-day-head"));
        diaryOpen = diaryOpen === d ? null : d;
        renderDiary();
      }));
      wrap.querySelectorAll(".vid-hour").forEach((b) => b.addEventListener("click", () => {
        const d = Number(b.getAttribute("data-day")), h = Number(b.getAttribute("data-hour"));
        const set = diaryState[d] || (diaryState[d] = new Set());
        if (set.has(h)) set.delete(h); else set.add(h);
        renderDiary();
      }));
      const saveBtn = document.getElementById("vid-diary-save");
      if (saveBtn) saveBtn.hidden = false;
    }
    async function saveDiary() {
      const rows = DAYS.map(({ d }) => {
        const hrs = [...(diaryState[d] || new Set())].sort((a, b) => a - b);
        return {
          weekday: d,
          hours: hrs,
          is_available: hrs.length > 0,
          start_time: hrs.length ? `${String(hrs[0]).padStart(2, "0")}:00` : "09:00",
          end_time: hrs.length ? `${String(hrs[hrs.length - 1] + 1).padStart(2, "0")}:00` : "17:00",
        };
      });
      const btn = document.getElementById("vid-diary-save");
      if (btn) { btn.textContent = "Saving…"; btn.disabled = true; }
      const { error } = await supabase.from("videography_availability").upsert(rows, { onConflict: "weekday" });
      if (btn) { btn.disabled = false; btn.textContent = error ? "Error — run the hours migration?" : "Saved ✓"; }
      if (!error) availability = rows.map((r) => ({ ...r }));
      setTimeout(() => { if (btn) btn.textContent = "Save diary"; }, 2200);
    }

    /* ---------- Travel on a booking made in the admin ----------
       Postcode from the field, or else from the property address; distance
       from the Worker (driving miles, the same as the booking page), and the
       charge from travelCharge: 40 miles free each way, the rest charged
       there and back (Danielle, 21 Oct 2026). */
    const UK_PC = /\b([A-Z]{1,2}\d[A-Z\d]?)\s*(\d[A-Z]{2})\b/i;
    function showTravel(note) {
      const out = document.getElementById("vid-travel-result"); if (!out) return;
      const fv = (f) => document.querySelector(`[data-f="${f}"]`)?.value || "";
      const miles = parseFloat(fv("distance_miles")), pence = fv("surcharge_pence") === "" ? null : Number(fv("surcharge_pence"));
      const clear = document.getElementById("vid-travel-clear");
      if (note) { out.textContent = note; out.className = "vid-travel-result is-err"; return; }
      out.className = "vid-travel-result";
      if (isNaN(miles)) { out.textContent = pence === 0 ? "No travel charge on this booking." : "Not worked out yet. Add the postcode and click Work out travel."; if (clear) clear.hidden = pence === 0; return; }
      const t = travelCharge(miles, vidSettings);
      if (clear) clear.hidden = !pence;
      out.innerHTML = pence
        ? `<strong>${Math.round(t.oneWay)} miles each way</strong> (${Math.round(t.returnMiles)} there and back). Less the free ${t.radius} miles each way, that's ${t.chargeable} miles at ${t.rate}p: <strong>${gbpFromPence(pence)} + VAT</strong>, which goes on the invoice as its own line.`
        : `<strong>${Math.round(t.oneWay)} miles each way</strong>: within the free ${t.radius} miles, so no travel charge.`;
    }
    async function calcTravel() {
      const btn = document.getElementById("vid-travel-calc");
      const pcEl = document.getElementById("vid-travel-pc");
      let pc = (pcEl?.value || "").trim();
      if (!pc) { const m = (document.querySelector('[data-f="property_address"]')?.value || "").match(UK_PC); if (m) { pc = `${m[1]} ${m[2]}`.toUpperCase(); if (pcEl) pcEl.value = pc; } }
      if (!pc) { showTravel("Add the shoot postcode first, or put it in the property address."); return; }
      if (btn) { btn.disabled = true; btn.textContent = "Working it out…"; }
      try {
        const res = await fetch(`${WORKER_URL}/videography/distance?to=${encodeURIComponent(pc)}`);
        const d = await res.json().catch(() => ({}));
        if (!res.ok || typeof d.miles !== "number") throw new Error(d.error || "Couldn't work out the distance for that postcode.");
        const t = travelCharge(d.miles, { free_radius_miles: d.free_radius_miles ?? vidSettings.free_radius_miles, pence_per_mile: d.pence_per_mile ?? vidSettings.surcharge_pence_per_mile });
        document.querySelector('[data-f="distance_miles"]').value = String(d.miles);
        document.querySelector('[data-f="surcharge_pence"]').value = String(t.pence);
        showTravel();
        if (d.source === "estimate") document.getElementById("vid-travel-result").insertAdjacentHTML("beforeend", " <em>Straight-line estimate: the driving distance wasn't available.</em>");
      } catch (e) { showTravel(e.message); }
      finally { if (btn) { btn.disabled = false; btn.textContent = "Work out travel"; } }
    }
    document.getElementById("vid-travel-calc")?.addEventListener("click", calcTravel);
    document.getElementById("vid-travel-clear")?.addEventListener("click", () => {
      document.querySelector('[data-f="distance_miles"]').value = "";
      document.querySelector('[data-f="surcharge_pence"]').value = "0";
      showTravel();
    });
    // A new postcode means the old figure no longer applies.
    document.getElementById("vid-travel-pc")?.addEventListener("input", () => {
      document.querySelector('[data-f="distance_miles"]').value = "";
      document.querySelector('[data-f="surcharge_pence"]').value = "";
      showTravel();
    });

    /* Fine & Country office from the TEG Team Hub (Danielle, 21 Oct 2026):
       once a shoot is invoiced to Fine & Country and the agent says their
       client was charged a marketing fee, look up which office they sit
       under and fill it in, unless someone already has. */
    async function fillFcOffice() {
      const fv = (f) => document.querySelector(`[data-f="${f}"]`)?.value || "";
      const officeEl = document.getElementById("vid-fc-office");
      if (!officeEl || officeEl.value || fv("payment_route") !== "brand_invoice" || fv("marketing_fee_claimed") !== "yes") return;
      const email = fv("client_email").trim(); if (!email) return;
      const note = document.getElementById("vid-fc-office-note");
      if (note) note.textContent = "Checking the Team Hub…";
      try {
        const token = await authToken();
        const res = await fetch(`${WORKER_URL}/videography/fc-office?email=${encodeURIComponent(email)}`, { headers: { Authorization: "Bearer " + token } });
        const d = await res.json().catch(() => ({}));
        if (d.key && !officeEl.value) { officeEl.value = d.key; officeEl.dispatchEvent(new Event("change", { bubbles: true })); }
        if (note) note.textContent = d.key ? `Filled in from the Team Hub (${[d.location, d.company].filter(Boolean).join(", ")}).`
          : (d.location || d.company) ? `The Team Hub has them at ${[d.location, d.company].filter(Boolean).join(", ")}: choose the office.` : "Not found on the Team Hub: choose the office.";
      } catch (_) { if (note) note.textContent = ""; }
    }
    document.querySelector('[data-f="marketing_fee_claimed"]')?.addEventListener("change", fillFcOffice);
    document.getElementById("vid-route")?.addEventListener("change", fillFcOffice);

    /* ---------- Modal (add / edit booking) ---------- */
    let editingId = null;
    function openModal(id) {
      editingId = id || null;
      const b = id ? bookings.find((x) => x.id === id) : null;
      const set = (f, v) => { const el = document.querySelector(`[data-f="${f}"]`); if (el) el.value = v ?? ""; };
      set("client_name", b?.client_name);
      set("client_email", b?.client_email);
      set("client_phone", b?.client_phone);
      set("client_company", b?.client_company);
      set("brand", b?.brand);
      set("service", b?.service);
      showServicePick(b?.service || "");
      set("shoot_date", b?.shoot_date ? new Date(b.shoot_date).toISOString().slice(0, 16) : "");
      set("location", b?.location);
      set("amount_gbp", b?.amount_pence != null ? (b.amount_pence / 100).toString() : "");
      set("notes", b?.notes);
      set("property_address", b?.property_address);
      set("postcode", b?.postcode);
      set("distance_miles", b?.distance_miles != null ? String(b.distance_miles) : "");
      set("surcharge_pence", b?.surcharge_pence != null ? String(b.surcharge_pence) : "");
      showTravel();
      set("gallery_url", b?.gallery_url);
      set("gallery_email", b?.gallery_email);
      set("gallery_pin", b?._pin || "");
      loadGalleryPin(b);
      set("store_url", b?.store_url);
      set("tour_360_url", "");
      loadTourLink(b);
      set("download_cap", b?.download_cap != null ? String(b.download_cap) : "");
      set("gallery_expires_on", b?.gallery_expires_on ? String(b.gallery_expires_on).slice(0, 10) : "");
      const arch = document.getElementById("vid-archived");
      if (arch) arch.checked = !!b?.archived_at;
      // Which client portal this shoot is in (Danielle, 2 Nov 2026). Only once
      // the booking exists: a new one has no folder yet.
      renderShootPortal(document.getElementById("vid-portal-slot"), b && b.id ? b : null, b && b.id ? folderFor(b) : "", portalDeps());

      const office = document.getElementById("vid-fc-office");
      if (office && office.options.length <= 1) {
        FC_OFFICES.forEach((o) => office.add(new Option(o.label, o.key)));
      }
      const tegBrand = document.getElementById("vid-teg-brand");
      if (tegBrand && tegBrand.options.length <= 1) {
        TEG_BRANDS.forEach((o) => tegBrand.add(new Option(o.label, o.key)));
      }
      // Not awaited: openModal is synchronous, and fillSmmClients sets the
      // value itself once the list lands, so the select self-corrects.
      fillSmmClients(b?.smm_lead_id || "");
      // Built for this booking's route before the value is set, so a saved
      // reason lands on an option that actually exists.
      syncReasonOptions(b?.payment_route || "agent_card");
      set("payment_route", b?.payment_route || "agent_card");
      set("fc_office", b?.fc_office);
      // "Not asked" is right for a booking added by hand - nobody put the
      // question to the agent - but it has to be settable when they have said.
      set("marketing_fee_claimed", b?.marketing_fee_claimed == null ? "" : (b.marketing_fee_claimed ? "yes" : "no"));
      const conf = document.getElementById("vid-fee-confirmed");
      if (conf) conf.checked = !!b?.brand_fee_confirmed;
      const meta = document.getElementById("vid-fee-meta");
      if (meta) {
        meta.textContent = b?.brand_fee_confirmed && b?.brand_fee_confirmed_at
          ? `Confirmed ${new Date(b.brand_fee_confirmed_at).toLocaleDateString("en-GB")}${b.brand_fee_confirmed_by ? " by " + b.brand_fee_confirmed_by : ""}.`
          : "";
      }
      set("teg_brand", b?.teg_brand);
      set("teg_reason", b?.teg_reason);
      set("teg_reason_other", b?.teg_reason_other);
      const tegReasonOtherWrap = document.getElementById("vid-teg-reason-other-wrap");
      if (tegReasonOtherWrap) tegReasonOtherWrap.hidden = (b?.teg_reason || "") !== "other";
      const paid = document.getElementById("vid-paid");
      if (paid) paid.checked = !!b?.paid_at;
      const payStatus = document.getElementById("vid-pay-status");
      if (payStatus) {
        payStatus.textContent = b?.paid_at
          ? `Paid ${new Date(b.paid_at).toLocaleDateString("en-GB")}.`
          : "Not paid yet. Raise the invoice from Invoicing with card payment switched on, so the client gets a pay link.";
      }
      syncPaymentRoute();
      checkGalleryEmail();
      prefillStudioLocation();
      // Nobody knows the gallery or the payment state at the point of booking.
      const creating = !b;
      const payBlock = document.getElementById("vid-paid-block");
      const delBlock = document.getElementById("vid-delivery-block");
      if (payBlock) payBlock.hidden = creating;
      if (delBlock) delBlock.hidden = creating;
      document.getElementById("vid-modal-title").textContent = b ? "Edit booking" : "New booking";
      document.getElementById("vid-delete").hidden = !b;
      document.getElementById("vid-modal").hidden = false;
    }
    function closeModal() { document.getElementById("vid-modal").hidden = true; editingId = null; }

    /* The card's side actions. Closing empties it rather than just hiding it:
       these forms hold a client's details and a half-typed search, and neither
       should still be sitting there the next time it opens. */
    function openActModal(title) {
      const el = document.getElementById("vid-act-modal");
      if (!el) return;
      document.getElementById("vid-act-title").textContent = title;
      el.hidden = false;
    }
    function closeActModal() {
      const el = document.getElementById("vid-act-modal");
      if (!el) return;
      el.hidden = true;
      const body = document.getElementById("vid-cand-drawer");
      if (body) body.innerHTML = "";
    }

    /* The client downloads from Pixieset with their email address and the PIN,
       so the gallery email has to be the one they will actually type. If we mail
       the PIN somewhere else they simply cannot download, and we would never
       find out - the failure happens inside Pixieset, not here. A mismatch is
       sometimes deliberate, so this warns rather than blocks. */
    /* A Content Studio shoot is at our studio, every time. Fill it in rather
       than leaving Jack to type the same address - but only when the field is
       empty, so a deliberate change is never overwritten. */
    /* The service picker (Dani, 4 Nov 2026). A booking whose saved service
       is one of the list shows it chosen; an older typed one shows the best
       guess, or Other with its words, until it's saved. */
    function showServicePick(saved) {
      const pick = document.getElementById("vid-svc-pick");
      const other = document.getElementById("vid-svc-other");
      if (!pick || !other) return;
      const sv = serviceByLabel(saved) || guessService(saved);
      if (sv) { pick.value = sv.key; other.hidden = true; other.value = ""; }
      else if (saved) { pick.value = "other"; other.hidden = false; other.value = saved; }
      else { pick.value = ""; other.hidden = true; other.value = ""; }
      servicePicked(false);
    }
    /* `byHand`: the person just chose it, so its rules apply: a new starter
       or event coverage is invoiced to the brand, not the client (Dani,
       4 Nov), and a studio shoot is at the studio. */
    function servicePicked(byHand) {
      const pick = document.getElementById("vid-svc-pick");
      const other = document.getElementById("vid-svc-other");
      const field = document.querySelector('[data-f="service"]');
      if (!pick || !other || !field) return;
      const sv = VIDEO_SERVICES.find((x) => x.key === pick.value) || null;
      other.hidden = pick.value !== "other";
      field.value = sv ? sv.label : (pick.value === "other" ? other.value.trim() : "");
      if (!byHand) return;
      if (pick.value === "other") other.focus();
      prefillStudioLocation();
      if (sv && sv.pays === "brand") {
        const route = document.getElementById("vid-route");
        if (route) {
          const brand = document.querySelector('[data-f="brand"]')?.value || "";
          const want = sv.reason === "event" && brand === "fine-and-country" ? "brand_invoice" : "brand_invoice_teg";
          if (route.value !== want && !(sv.reason === "event" && route.value === "brand_invoice")) {
            route.value = want;
            route.dispatchEvent(new Event("change", { bubbles: true }));
          }
          const reason = document.getElementById("vid-teg-reason");
          if (reason && [...reason.options].some((o) => o.value === sv.reason)) {
            reason.value = sv.reason;
            reason.dispatchEvent(new Event("change", { bubbles: true }));
          }
        }
      }
    }
    function prefillStudioLocation() {
      const locEl = document.querySelector('[data-f="location"]');
      const svcEl = document.querySelector('[data-f="service"]');
      if (!locEl || !svcEl || locEl.value.trim()) return;
      if (/content|studio/i.test(svcEl.value)) locEl.value = STUDIO_LOCATION;
    }

    /* The PIN lives in videography_gallery_pins, not on the booking. RLS is
       row-level, so a member reading their own booking row would have been able
       to read their own PIN before paying - which is the one thing the whole
       delivery design rests on. A separate admin-only table is the only way to
       say "your row, but not that field". See supabase/videography_rls.sql. */
    async function loadGalleryPin(b) {
      const el = document.querySelector('[data-f="gallery_pin"]');
      if (!el || !b) return;
      const { data } = await supabase.from("videography_gallery_pins").select("pin").eq("booking_id", b.id).maybeSingle();
      el.value = (data && data.pin) || "";
      b._pin = el.value;
    }

    async function saveGalleryPin(bookingId, pin) {
      if (!bookingId) return;
      const value = (pin || "").trim();
      const { error } = value
        ? await supabase.from("videography_gallery_pins").upsert({ booking_id: bookingId, pin: value, updated_at: new Date().toISOString() })
        : await supabase.from("videography_gallery_pins").delete().eq("booking_id", bookingId);
      if (error) alert("The booking saved, but the PIN didn't: " + error.message);
      const b = bookings.find((x) => x.id === bookingId);
      if (b) b._pin = value;
    }

    /* The 360 tour link, same reasoning as the PIN just above: it lives in
       videography_tour_links, not on the booking, so it cannot be read by
       the client's own row-level access before they've paid. */
    async function loadTourLink(b) {
      const el = document.querySelector('[data-f="tour_360_url"]');
      if (!el || !b) return;
      const { data } = await supabase.from("videography_tour_links").select("url").eq("booking_id", b.id).maybeSingle();
      el.value = (data && data.url) || "";
      b._tour_url = el.value;
    }

    async function saveTourLink(bookingId, tourUrl) {
      if (!bookingId) return;
      const value = (tourUrl || "").trim();
      const { error } = value
        ? await supabase.from("videography_tour_links").upsert({ booking_id: bookingId, url: value, updated_at: new Date().toISOString() })
        : await supabase.from("videography_tour_links").delete().eq("booking_id", bookingId);
      if (error) alert("The booking saved, but the 360 tour link didn't: " + error.message);
      const b = bookings.find((x) => x.id === bookingId);
      if (b) b._tour_url = value;
    }

    function checkGalleryEmail() {
      const warn = document.getElementById("vid-email-warn");
      if (!warn) return;
      const g = (document.querySelector('[data-f="gallery_email"]')?.value || "").trim().toLowerCase();
      const c = (document.querySelector('[data-f="client_email"]')?.value || "").trim().toLowerCase();
      const clash = g && c && g !== c;
      warn.hidden = !clash;
      if (clash) warn.textContent = `Different to the booking email (${c}). The PIN goes to this address, so make sure it's the one the gallery was set up with.`;
    }

    /* Pixieset holds a gallery about three months. Defaulting the date means one
       less thing to remember; a wrong one means the expiry warning either never
       fires or fires too early. Jack can still overwrite it. */
    function defaultGalleryExpiry() {
      const el = document.querySelector('[data-f="gallery_expires_on"]');
      const url = (document.querySelector('[data-f="gallery_url"]')?.value || "").trim();
      if (!el || el.value || !url) return;
      const shoot = document.querySelector('[data-f="shoot_date"]')?.value;
      const from = shoot ? new Date(shoot) : new Date();
      if (isNaN(from)) return;
      from.setMonth(from.getMonth() + 3);
      el.value = from.toISOString().slice(0, 10);
    }

    /* Brand-invoiced jobs need the Fine & Country office confirmed before we
       invoice against a fee we have not verified is being held. It gates the
       money, not the shoot - so this warns rather than blocks. */
    function syncPaymentRoute() {
      const route = document.querySelector('[data-f="payment_route"]')?.value || "agent_card";
      const brand = route === "brand_invoice";
      const teg = route === "brand_invoice_teg";
      const smm = route === "smm_package";
      const bBlock = document.getElementById("vid-brand-block");
      const tBlock = document.getElementById("vid-teg-block");
      const cBlock = document.getElementById("vid-card-block");
      if (bBlock) bBlock.hidden = !brand;
      if (tBlock) tBlock.hidden = !(teg || smm);
      if (cBlock) cBlock.hidden = brand || teg || smm;
      // Same brand list, different reason list. Rebuilt on every switch so a
      // reason picked under one route cannot survive into the other.
      const tHint = document.getElementById("vid-teg-hint");
      const sHint = document.getElementById("vid-smm-hint");
      if (tHint) tHint.hidden = !teg;
      if (sHint) sHint.hidden = !smm;
      const smmClientRow = document.getElementById("vid-smm-client-row");
      if (smmClientRow) smmClientRow.hidden = !smm;
      if (teg || smm) syncReasonOptions(route);
      const warn = document.getElementById("vid-fee-warn");
      if (warn) {
        const office = document.querySelector('[data-f="fc_office"]')?.value;
        const confirmed = document.getElementById("vid-fee-confirmed")?.checked;
        const missing = brand && (!office || !confirmed);
        warn.hidden = !missing;
        if (missing) {
          warn.textContent = !office
            ? "Name the office holding the fee before invoicing."
            : "Not yet confirmed with Fine & Country. Invoicing against an unverified fee is the thing this check exists to stop.";
        }
      }
      const reasonOtherWrap = document.getElementById("vid-teg-reason-other-wrap");
      if (reasonOtherWrap) {
        reasonOtherWrap.hidden = smm || document.querySelector('[data-f="teg_reason"]')?.value !== "other";
      }
    }

    /* The reason list belongs to the route: "Included in the SMM package" must
       never be offered on a TEG invoice, and the TEG reasons must never be
       offered on a package shoot. Keeps the current value if it is still on
       the menu, so reopening a saved booking does not silently blank it. */
    function syncReasonOptions(route) {
      const sel = document.getElementById("vid-teg-reason");
      if (!sel) return;
      const want = reasonsForRoute(route);
      const same = sel.options.length === want.length + 1
        && want.every((o, i) => sel.options[i + 1]?.value === o.key);
      if (same) return;
      const had = sel.value;
      sel.innerHTML = "";
      sel.add(new Option("— Select —", ""));
      want.forEach((o) => sel.add(new Option(o.label, o.key)));
      sel.value = want.some((o) => o.key === had) ? had
        : (route === "smm_package" ? SMM_REASON.key : "");
    }


    /* The social media clients a shoot can be linked to.
       Active only, matching the test social.astro uses to decide a lead has
       become a client — otherwise this list and that page would disagree.
       Cached: the picker is opened repeatedly while working through a board. */
    let smmClientsCache = null;
    async function fillSmmClients(selected) {
      const sel = document.getElementById("vid-smm-client");
      if (!sel) return;
      let failed = false;
      if (!smmClientsCache) {
        // The stage lives in pipeline_stage — smm_leads has no "stage" column,
        // so asking for one failed and left the menu looking simply empty.
        const { data, error } = await supabase
          .from("smm_leads")
          .select("id, business, full_name, first_name, last_name, email")
          .eq("pipeline_stage", "active_client")
          .order("business", { ascending: true, nullsFirst: false });
        // Not cached on failure: an empty menu you can reopen is recoverable,
        // one cached for the life of the page is not.
        if (error) { failed = true; console.error("Couldn't load social media clients:", error.message); }
        else smmClientsCache = data || [];
      }
      const clients = smmClientsCache || [];
      const label = (r) => r.business
        || [r.first_name, r.last_name].filter(Boolean).join(" ").trim()
        || r.full_name || r.email || "Client";
      // Rebuilt rather than appended: this runs on every booking opened.
      sel.innerHTML = "";
      sel.add(new Option("— Not linked —", ""));
      clients.forEach((r) => sel.add(new Option(label(r), r.id)));
      // An empty menu reads as "there are no clients", which is a different
      // problem from the list not loading. Say which one it is.
      const msg = failed ? "Couldn't load clients — reopen to retry" : (!clients.length ? "No active clients yet" : "");
      if (msg) { const o = new Option(msg, ""); o.disabled = true; sel.add(o); }
      // A link to a client who is no longer active would otherwise vanish from
      // the menu and read as "not linked" — keep it visible and say why.
      if (selected && !clients.some((r) => r.id === selected)) {
        sel.add(new Option("Linked client (no longer active)", selected));
      }
      sel.value = selected || "";
    }

    async function saveBooking() {
      const get = (f) => { const el = document.querySelector(`[data-f="${f}"]`); return el ? el.value.trim() : ""; };
      const name = get("client_name");
      if (!name) { alert("Client name is required."); return; }
      const gbp = get("amount_gbp");
      const payload = {
        client_name: name,
        client_email: get("client_email") || null,
        client_phone: get("client_phone") || null,
        client_company: get("client_company") || null,
        brand: get("brand") || null,
        service: get("service") || null,
        ...((() => { const sv = serviceByLabel(get("service")); return sv && sv.type ? { service_type: sv.type } : {}; })()),
        shoot_date: get("shoot_date") ? new Date(get("shoot_date")).toISOString() : null,
        location: get("location") || null,
        amount_pence: gbp ? Math.round(parseFloat(gbp) * 100) : null,
        notes: get("notes") || null,
        property_address: get("property_address") || null,
        postcode: get("postcode") ? get("postcode").toUpperCase() : null,
        distance_miles: get("distance_miles") === "" ? null : Number(get("distance_miles")),
        surcharge_pence: get("surcharge_pence") === "" ? null : Math.round(Number(get("surcharge_pence"))),
        payment_route: get("payment_route") || "agent_card",
        fc_office: get("fc_office") || null,
        marketing_fee_claimed: get("marketing_fee_claimed") === "" ? null : get("marketing_fee_claimed") === "yes",
        brand_fee_confirmed: !!document.getElementById("vid-fee-confirmed")?.checked,
        // Stamp who confirmed and when, the first time it is ticked.
        brand_fee_confirmed_at: document.getElementById("vid-fee-confirmed")?.checked
          ? (bookings.find((x) => x.id === editingId)?.brand_fee_confirmed_at || new Date().toISOString())
          : null,
        brand_fee_confirmed_by: document.getElementById("vid-fee-confirmed")?.checked
          ? (bookings.find((x) => x.id === editingId)?.brand_fee_confirmed_by || adminEmail || null)
          : null,
        smm_lead_id: get("payment_route") === "smm_package" ? (get("smm_lead_id") || null) : null,
        teg_brand: get("teg_brand") || null,
        teg_reason: get("teg_reason") || null,
        teg_reason_other: get("teg_reason") === "other" ? (get("teg_reason_other") || null) : null,
        paid_at: document.getElementById("vid-paid")?.checked
          ? (bookings.find((x) => x.id === editingId)?.paid_at || new Date().toISOString())
          : null,
        gallery_url: get("gallery_url") || null,
        gallery_email: get("gallery_email") || null,

        store_url: get("store_url") || null,
        download_cap: get("download_cap") === "" ? null : Math.max(0, Math.round(Number(get("download_cap")))),
        gallery_expires_on: get("gallery_expires_on") || null,
        // A tick records WHEN the archive went up; unticking clears it again.
        archived_at: document.getElementById("vid-archived")?.checked
          ? (bookings.find((x) => x.id === editingId)?.archived_at || new Date().toISOString())
          : null,
      };
      // Travel re-worked on a booking made online: its total had the old
      // travel in it, so it moves by the difference.
      {
        const was = bookings.find((x) => x.id === editingId);
        if (was && was.total_pence != null && payload.surcharge_pence != null && payload.surcharge_pence !== (was.surcharge_pence || 0)) {
          payload.total_pence = was.total_pence - (was.surcharge_pence || 0) + payload.surcharge_pence;
        }
      }
      const pinValue = get("gallery_pin");
      const tourUrlValue = get("tour_360_url");
      let savedId = editingId;
      const btn = document.getElementById("vid-save");
      if (btn) btn.textContent = "Saving…";
      if (editingId) {
        const before = bookings.find((x) => x.id === editingId) || {};
        const movedLocation = (before.location || "") !== (payload.location || "")
          || (before.property_address || "") !== (payload.property_address || "");
        // The Library folder's name is fixed on the booking the first time it
        // is saved (Dani, 4 Nov): the name its files already went under, so a
        // later change to the service, client, date or place can't point the
        // booking at an empty folder (what happened to Raj Chinger).
        if (!before.archive_folder) { const nm = archiveFolderName(before); if (nm) payload.archive_folder = nm; }
        const { error } = await supabase.from("videography_bookings").update(payload).eq("id", editingId);
        if (error) { alert("Save failed: " + error.message); if (btn) btn.textContent = "Save booking"; return; }
        Object.assign(bookings.find((x) => x.id === editingId), payload);
        // A location Jack can't see on the day is no use to him.
        if (movedLocation && WORKER_URL) {
          try {
            const token = await authToken();
            await fetch(`${WORKER_URL}/booking/location`, {
              method: "POST",
              headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
              body: JSON.stringify({ booking_id: editingId }),
            });
          } catch (_) { /* the booking saved; the diary can be nudged again */ }
        }
      } else {
        payload.stage = "booked";
        { const nm = archiveFolderName(payload); if (nm) payload.archive_folder = nm; }
        const { data, error } = await supabase.from("videography_bookings").insert(payload).select().single();
        if (error) { alert("Save failed: " + error.message); if (btn) btn.textContent = "Save booking"; return; }
        bookings.unshift(data);
        savedId = data && data.id;
      }
      // Only ever the booking we just saved. Falling back to "the first one in
      // the list" could have deleted a different booking's PIN.
      if (savedId) await saveGalleryPin(savedId, pinValue);
      if (savedId) await saveTourLink(savedId, tourUrlValue);
      // The public booking flow has always written the client into the CRM; a
      // booking added by hand never did. Same endpoint, same tag rules, and
      // upsert_contact merges rather than duplicating an existing card.
      if (savedId && payload.client_email && WORKER_URL) {
        try {
          const token = await authToken();
          const res = await fetch(`${WORKER_URL}/booking/contact`, {
            method: "POST",
            headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
            body: JSON.stringify({ booking_id: savedId }),
          });
          if (!res.ok) {
            const d = await res.json().catch(() => ({}));
            alert("The booking saved, but the contact card didn't sync: " + (d.error || res.status));
          }
        } catch (err) {
          alert("The booking saved, but the contact card didn't sync: " + err.message);
        }
      }
      if (btn) btn.textContent = "Save booking";
      closeModal();
      renderClients(document.getElementById("vid-client-search")?.value || "");
      if (candId) renderCandidate();
      populateDeliverBookings();
    }

    async function deleteBooking() {
      if (!editingId) return;
      if (!confirm("Delete this booking? This can't be undone.")) return;
      const deletedId = editingId;
      const { error } = await supabase.from("videography_bookings").delete().eq("id", deletedId);
      if (error) { alert("Delete failed: " + error.message); return; }
      bookings = bookings.filter((x) => x.id !== deletedId);
      closeModal();
      if (candId === deletedId) { candId = null; showPanel("clients"); }
      renderClients(document.getElementById("vid-client-search")?.value || "");
      populateDeliverBookings();
    }

    /* ---------- Deliver (R2 uploads attached to a booking) ---------- */
    function fmtBytes(n) {
      if (n == null) return "—";
      const u = ["B", "KB", "MB", "GB", "TB"]; let i = 0; let v = Number(n);
      while (v >= 1024 && i < u.length - 1) { v /= 1024; i++; }
      return v.toFixed(v >= 10 || i === 0 ? 0 : 1) + " " + u[i];
    }
    function kindFromType(t) {
      if (!t) return "other";
      if (t.startsWith("video/")) return "video";
      if (t.startsWith("image/")) return "image";
      return "other";
    }
    // What the client portal admin needs from this page.
    function portalDeps() {
      return { supabase, authToken, worker: WORKER_URL, me: async () => adminEmail || (await supabase.auth.getSession()).data.session?.user?.email || "" };
    }
    async function authToken() {
      const { data } = await supabase.auth.getSession();
      return data.session ? data.session.access_token : "";
    }
    function deliverBooking() {
      const sel = document.getElementById("vid-deliver-booking");
      return sel ? sel.value : "";
    }
    function populateDeliverBookings() {
      const sel = document.getElementById("vid-deliver-booking");
      if (!sel) return;
      const keep = sel.value;
      const stageLabel = (k) => (STAGES.find((s) => s.key === k) || {}).label || k;
      sel.innerHTML = '<option value="">— Select a client / shoot —</option>' +
        bookings.map((b) => `<option value="${b.id}">${escapeHtml(b.client_name)}${b.client_company ? " · " + escapeHtml(b.client_company) : ""} — ${escapeHtml(stageLabel(b.stage))}</option>`).join("");
      if (keep) sel.value = keep;
    }

    // The set of category drop-boxes (also used to build the recategorise
    // dropdowns and to know which file-list groups to show).
    // The categories for the booking currently open in Deliver work. Read at
    // the moment it is needed - it used to be captured once at page load from
    // the category boxes, which are now rendered per booking, so by then there
    // were none and every dropdown came out empty.
    function deliverCats() {
      const b = bookings.find((x) => x.id === deliverBooking());
      return b ? archiveFoldersFor(b.service_type, b.service) : [];
    }

    function initDeliver() {
      const grid = document.getElementById("vid-catgrid");
      const sel = document.getElementById("vid-deliver-booking");
      if (!grid) return;

      const connected = Boolean(WORKER_URL);
      const configNote = document.getElementById("vid-deliver-config");
      const r2pill = document.getElementById("vid-r2-pill");
