    function renderArchiveBox(b) {
      const box = document.getElementById("vid-archive");
      if (!box) return;
      box.hidden = !b;
      if (!b) return;
      const folder = document.getElementById("vid-arch-folder");
      // Generated only when empty - a name that has been used to create real
