    // Say where files will land, so nobody has to guess what we did with them.
    function showArchivePath(b) {
      const el = document.getElementById("vid-arch-path");
      const open = document.getElementById("vid-open-content");
      const folderNow = (document.getElementById("vid-arch-folder")?.value || "").trim() || archiveFolderName(b);
      if (open) {
        open.hidden = !folderNow;
        open.href = `/admin/content?folder=${encodeURIComponent(folderNow)}`;
      }
      if (!el) return;
      const folder = (document.getElementById("vid-arch-folder")?.value || "").trim();
      el.textContent = folder
        ? `Files upload to  deliverables / ${folder} / <category> /`
