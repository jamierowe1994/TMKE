---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
---

<AdminShell active="teg" title="TEG sync" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">TEG sync</div>
          <div class="page-header-sub">The Experts Group's own team database — who works for which brand, under what title, on whose patch, and who has left. We read it; we never write to it.</div>
        </div>
      </div>
    </div>
  </div>

  <div class="ash-panel ash-page">
    <div class="teg-acts">
      <button type="button" class="admin-btn admin-btn-primary" id="teg-ping">Test the connection</button>
      <button type="button" class="admin-btn" id="teg-photos">What does photoApi hold?</button>
      <button type="button" class="admin-btn" id="teg-heads">Check the headshots</button>
      <button type="button" class="admin-btn" id="teg-heads-all">Check everyone</button>
      <button type="button" class="admin-btn" id="teg-imp-prev">Preview headshot import</button>
      <button type="button" class="admin-btn" id="teg-missing">Our agents without a brand photo</button>
      <button type="button" class="admin-btn" id="teg-dry">Dry run — show me what a sync would do</button>
      <span class="teg-status" id="teg-status"></span>
    </div>

    <!-- Nothing is written by either button. The dry run reads their roster
         and ours and reports the difference; that is all it can do. -->
    <p class="teg-note">Neither button changes anything, on our side or theirs. The dry run reads both rosters and reports the difference.</p>

    <div id="teg-out"></div>
  </div>

  <style is:global>
    .teg-acts { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .teg-status { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); }
    .teg-status.is-ok { color: #2b6b44; }
    .teg-status.is-err { color: #9a2a2a; }
    .teg-note { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); margin: 10px 0 0; }
    .teg-sum { display: flex; gap: 10px; flex-wrap: wrap; margin: 20px 0 14px; }
    .teg-stat { border: 1px solid var(--border, rgba(28,29,34,0.12)); border-radius: 8px; padding: 12px 16px; min-width: 120px; }
    .teg-stat b { display: block; font-family: var(--serif); font-size: 24px; font-weight: 500; color: var(--ink); line-height: 1.1; }
    .teg-stat span { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .teg-tablewrap { overflow-x: auto; }
    .teg-table { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: 12.5px; }
    .teg-table th { text-align: left; font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.5); padding: 8px 10px; border-bottom: 1px solid var(--border, rgba(28,29,34,0.12)); white-space: nowrap; }
    .teg-table td { padding: 8px 10px; border-bottom: 1px solid rgba(28,29,34,0.06); vertical-align: top; }
    .teg-new { color: #a05a3c; font-weight: 700; }
    .teg-pill { display: inline-block; font-size: 10.5px; padding: 2px 7px; border-radius: 999px; background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); margin: 0 3px 3px 0; }
    .teg-pill.is-add { background: rgba(63,148,104,0.14); color: #2b6b44; }
    /* Headshots on a checkerboard, so a background-free cut-out shows as one. */
    .teg-heads { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; margin-top: 16px; }
    .teg-head { border: 1px solid rgba(28,29,34,0.12); border-radius: 10px; padding: 10px; font-family: var(--sans); font-size: 12px; }
    .teg-head b { display: block; font-size: 13px; color: var(--ink); margin-bottom: 2px; }
    .teg-head small { color: rgba(28,29,34,0.55); display: block; margin-bottom: 8px; word-break: break-all; }
    .teg-shot { margin-top: 8px; }
    .teg-shot .img { height: 170px; border-radius: 6px; background-color: #fff; background-image: linear-gradient(45deg, #e6e3e3 25%, transparent 25%), linear-gradient(-45deg, #e6e3e3 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #e6e3e3 75%), linear-gradient(-45deg, transparent 75%, #e6e3e3 75%); background-size: 16px 16px; background-position: 0 0, 0 8px, 8px -8px, -8px 0; display: flex; align-items: flex-end; justify-content: center; overflow: hidden; }
    .teg-shot img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .teg-shot .meta { display: flex; justify-content: space-between; gap: 6px; margin-top: 5px; color: rgba(28,29,34,0.6); }
    .teg-yes { color: #2b6b44; font-weight: 700; } .teg-no { color: #9a2a2a; font-weight: 700; }
    .ash-panel .teg-fc { display: inline-flex; align-items: center; gap: 7px; font-family: var(--sans); font-size: 13px; color: var(--ink); margin: 16px 0 0; cursor: pointer; text-transform: none; letter-spacing: 0; font-weight: 500; }
    .ash-panel .teg-q { display: block; width: min(420px, 100%); height: 40px; box-sizing: border-box; padding: 0 12px; margin: 14px 0 0; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; font: 13px var(--sans); }
    .teg-pick { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 10px 0 6px; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); }
    .teg-pick button[data-pick] { appearance: none; background: none; border: 0; padding: 0; font: 700 13px var(--sans); color: var(--english-violet); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
    .teg-pick .admin-btn { margin-left: 12px; }
    .teg-thumb { display: block; width: 40px; height: 52px; border-radius: 4px; background-size: contain; background-repeat: no-repeat; background-position: center bottom; background-color: #f1eeee; }
    .teg-raw { font-family: ui-monospace, monospace; font-size: 12px; white-space: pre-wrap; word-break: break-word; background: #faf9f8; border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; padding: 12px; margin-top: 14px; }
  </style>

  <script>
    import { requireAdmin } from '../../lib/admin-gate.js';
    import { supabase } from '../../lib/supabase.js';

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');
    const out = document.getElementById('teg-out');
    const statusEl = document.getElementById('teg-status');
    const esc = (v) => String(v == null ? '' : v).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const say = (m, cls) => { statusEl.textContent = m || ''; statusEl.className = 'teg-status' + (cls ? ' ' + cls : ''); };

    async function call(pathname) {
      const { data } = await supabase.auth.getSession();
      const token = data?.session?.access_token;
      const res = await fetch(WORKER + pathname, { headers: { Authorization: 'Bearer ' + token } });
      return { status: res.status, body: await res.json().catch(() => null) };
    }

    document.getElementById('teg-ping').addEventListener('click', async () => {
      out.innerHTML = '';
      say('Knocking…');
      const { body } = await call('/teg/ping');
      if (!body) { say("No answer from our own Worker.", 'is-err'); return; }
      const db = body.dbApi || {};
      say(db.ok ? 'Connected — their database answered.' : 'Not connected yet.', db.ok ? 'is-ok' : 'is-err');
      out.innerHTML = '<div class="teg-raw">' + esc(JSON.stringify(body, null, 2)) + '</div>';
    });

    /* photoApi is undocumented, so this reports its shape rather than
       pretending we know it: every field name, the ones that look like an
       image, and one whole record to read. */
    // Headshots: 20 people, each picture opened to see if it is background-free.
    document.getElementById('teg-heads').addEventListener('click', async () => {
      out.innerHTML = '';
      say('Opening twenty headshots…');
      const { body } = await call('/teg/photos?limit=20&check=1');
      if (!body || body.error) { say((body && body.error) || 'No answer.', 'is-err'); return; }
      const people = body.people || [];
      const shots = people.flatMap((p) => p.images.map((i) => ({ ...i, who: p.label })));
      const byField = {};
      shots.forEach((i) => { const f = byField[i.field] || (byField[i.field] = { total: 0, clear: 0 }); f.total++; if (i.transparent) f.clear++; });
      say(`${body.count ?? '?'} records in photoApi; ${people.length} checked.`, 'is-ok');
      out.innerHTML = `
        <div class="teg-sum">
          ${Object.entries(byField).map(([f, n]) => `<div class="teg-stat"><b>${n.clear} of ${n.total}</b><span>${esc(f)}: background-free</span></div>`).join('') || '<p class="teg-note">None of these records has a picture link.</p>'}
        </div>
        <p class="teg-note">Every picture field TEG returns: <strong>${esc((body.looks_like_an_image || []).join(', ') || 'none')}</strong>. The checkerboard shows through anything background-free.</p>
        <div class="teg-heads">${people.map((p) => `<div class="teg-head"><b>${esc(p.label)}</b><small>${esc(p.email || '')}</small>
          ${p.images.length ? p.images.map((i) => `<div class="teg-shot"><div class="img"><img src="${esc(i.url)}" alt="" loading="lazy"></div>
            <div class="meta"><span>${esc(i.field)} · ${esc(i.format || '?')}${i.width ? ` · ${i.width}×${i.height}` : ''}</span>
            <span class="${i.transparent ? 'teg-yes' : 'teg-no'}">${i.transparent ? 'Background-free' : i.transparent === false ? 'Has background' : (i.error ? esc(i.error) : 'Unknown')}</span></div></div>`).join('') : '<small>No picture</small>'}
        </div>`).join('')}</div>
        <p class="teg-note" style="margin:16px 0 6px"><strong>One whole record</strong></p>
        <div class="teg-raw">${esc(JSON.stringify(body.sample, null, 2))}</div>`;
    });

    /* Everyone, twenty at a time (one request each, so the Worker stays well
       inside its limits): who has a background-free headshot and who still
       has a background, to chase TEG with. */
    document.getElementById('teg-heads-all').addEventListener('click', async () => {
      const btn = document.getElementById('teg-heads-all');
      out.innerHTML = ''; btn.disabled = true;
      const people = [], seen = new Set(); let fields = [], note = '';
      try {
        // TEG's count is the page's, not the whole list's, and has_more can't
        // be relied on either (30 Sep 2026: it stopped at 20), so this keeps
        // asking until a page comes back short, or brings nobody new.
        for (let skip = 0; skip < 5000; skip += 20) {
          say(`Checking headshots… ${people.length} so far`);
          const { body } = await call(`/teg/photos?limit=20&skip=${skip}&check=1`);
          if (!body || body.error) throw new Error((body && body.error) || 'No answer.');
          fields = [...new Set([...fields, ...(body.looks_like_an_image || [])])];
          const page = body.people || [];
          const fresh = page.filter((p) => { const k = (p.email || p.label || '').toLowerCase(); if (seen.has(k)) return false; seen.add(k); return true; });
          people.push(...fresh);
          if (page.length && !fresh.length) { note = "TEG sent the same people again, so it may not support paging past this point."; break; }
          if (page.length < 20) break;
        }
      } catch (err) { say(err.message, 'is-err'); btn.disabled = false; return; }
      btn.disabled = false;
      // Best picture per person: a background-free one if any field has it.
      const all = people.map((p) => {
        const clear = p.images.find((i) => i.transparent);
        const any = p.images[0] || null;
        return { name: p.label, email: p.email || '', brand: brandOf(p.email), state: clear ? 'clear' : any ? (any.transparent === false ? 'background' : 'unknown') : 'none', field: (clear || any || {}).field || '', url: (clear || any || {}).url || '' };
      });
      HEADS = { all, fields, note };
      drawHeads();
    });
    // Brand from the email domain: the same list as the Worker's
    // (TEG_DOMAIN_BRANDS in worker/src/index.js).
    const DOMAIN_BRANDS = [
      [/(^|\.)thepropertyexperts\.co\.uk$/i, 'The Property Experts'], [/(^|\.)prestigepropertyexperts\.co\.uk$/i, 'Prestige Property Experts'],
      [/(^|\.)thelettings?experts\.co\.uk$/i, 'The Letting Experts'], [/(^|\.)themarketingexperts\.co\.uk$/i, 'The Marketing Experts'],
      [/(^|\.)therecruitmentexperts\.co\.uk$/i, 'The Recruitment Experts'], [/(^|\.)themortgageexperts\.co\.uk$/i, 'The Mortgage Experts'],
      [/(^|\.)fineandcountry\.com$/i, 'Fine & Country'],
    ];
    const brandOf = (email) => { const d = String(email || '').toLowerCase().split('@')[1] || ''; const hit = DOMAIN_BRANDS.find(([re]) => re.test(d)); return hit ? hit[1] : (d ? 'Other' : '—'); };
    /* TEG's own brands first: Fine & Country won't use the print suite yet
       (Danielle, 30 Sep 2026), so they're left out unless asked for. */
    let HEADS = null, withFC = false;
    function drawHeads() {
      if (!HEADS) return;
      const { all, fields } = HEADS;
      const rows = all.filter((r) => withFC || r.brand !== 'Fine & Country');
      const groups = { clear: 'Background-free', background: 'Still has a background', none: 'No picture', unknown: "Couldn't tell" };
      const n = (k) => rows.filter((r) => r.state === k).length;
      const fc = all.length - all.filter((r) => r.brand !== 'Fine & Country').length;
      say(`${all.length} people checked${fc && !withFC ? `; ${fc} at Fine & Country left out` : ''}.${HEADS.note ? ' ' + HEADS.note : ''}`, HEADS.note ? 'is-err' : 'is-ok');
      const brands = [...new Set(rows.map((r) => r.brand))].sort();
      const csv = 'Name,Email,Brand,Headshot,Field,Link\n' + rows.map((r) => [r.name, r.email, r.brand, groups[r.state], r.field, r.url].map((v) => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
      out.innerHTML = `
        <label class="teg-fc"><input type="checkbox" id="teg-fc" ${withFC ? 'checked' : ''}> Include Fine &amp; Country</label>
        <div class="teg-sum">${Object.keys(groups).filter((k) => n(k)).map((k) => `<div class="teg-stat"><b>${n(k)}</b><span>${groups[k]}</span></div>`).join('')}</div>
        <p class="teg-note">By brand: ${brands.map((b) => { const br = rows.filter((r) => r.brand === b); return `<strong>${esc(b)}</strong> ${br.filter((r) => r.state === 'clear').length} of ${br.length} background-free`; }).join(' · ')}</p>
        <p class="teg-note">Picture fields seen: <strong>${esc(fields.join(', ') || 'none')}</strong>. A person counts as background-free if any of their pictures is.
          <a href="data:text/csv;charset=utf-8,${encodeURIComponent(csv)}" download="TEG headshots.csv">Download the list</a></p>
        ${['background', 'none', 'unknown', 'clear'].filter((k) => n(k)).map((k) => `<details ${k === 'background' ? 'open' : ''} style="margin-top:14px"><summary class="teg-note" style="cursor:pointer"><strong>${groups[k]} · ${n(k)}</strong></summary>
          <div class="teg-tablewrap"><table class="teg-table"><thead><tr><th>Name</th><th>Brand</th><th>Email</th><th>Field</th></tr></thead><tbody>${rows.filter((r) => r.state === k).map((r) => `<tr><td>${esc(r.name)}</td><td>${esc(r.brand)}</td><td>${esc(r.email)}</td><td>${esc(r.field)}</td></tr>`).join('')}</tbody></table></div></details>`).join('')}`;
      document.getElementById('teg-fc').addEventListener('change', (e) => { withFC = e.target.checked; drawHeads(); });
    }

    /* Headshot import. Preview first: every TEG person and what would happen
       to them, with the reason when nothing would. Then the import, one
       person at a time, so progress shows and one failure stops nothing. */
    let LAST_PREVIEW = null;
    // Who in our CRM still has no brand photo, with TEG's side if the
    // preview has been run this visit.
    document.getElementById('teg-missing').addEventListener('click', async () => {
      out.innerHTML = '';
      say('Finding agents without a brand photo…');
      const { body } = await call('/teg/missing-photos');
      if (!body || body.error) { say((body && body.error) || 'No answer.', 'is-err'); return; }
      const teg = new Map((LAST_PREVIEW || []).map((r) => [String(r.email || '').toLowerCase(), r]));
      const tegSide = (email) => { if (!LAST_PREVIEW) return 'Run the preview to see'; const t = teg.get(email); return !t ? 'Not found at TEG' : t.action !== 'skip' ? 'Ready to import' : t.why; };
      const rows = body.rows || [];
      const brands = [...new Set(rows.map((r) => r.brand))];
      say(`${rows.length} current agent profile${rows.length === 1 ? '' : 's'} without a brand photo.`, 'is-ok');
      const csv = 'Name,Email,Brand,Job title,At TEG\n' + rows.map((r) => [r.name, r.email, r.brand, r.job_title, tegSide(r.email)].map((v) => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
      out.innerHTML = `
        <div class="teg-sum">${brands.map((b) => `<div class="teg-stat"><b>${rows.filter((r) => r.brand === b).length}</b><span>${esc(b)}</span></div>`).join('')}</div>
        <p class="teg-note">Fine &amp; Country left out for now. <a href="data:text/csv;charset=utf-8,${encodeURIComponent(csv)}" download="Agents without a brand photo.csv">Download the list</a></p>
        ${brands.map((b) => `<details ${b === 'The Property Experts' ? 'open' : ''} style="margin-top:14px"><summary class="teg-note" style="cursor:pointer"><strong>${esc(b)} · ${rows.filter((r) => r.brand === b).length}</strong></summary>
          <div class="teg-tablewrap"><table class="teg-table"><thead><tr><th>Name</th><th>Email</th><th>Job title</th><th>At TEG</th></tr></thead><tbody>${rows.filter((r) => r.brand === b).map((r) => `<tr><td>${esc(r.name)}</td><td>${esc(r.email)}</td><td>${esc(r.job_title)}</td><td>${esc(tegSide(r.email))}</td></tr>`).join('')}</tbody></table></div></details>`).join('')}`;
    });
    const IMPORT_WHY = { import: 'New brand photo', update: 'Already imported: replaces the TEG photo we hold' };
    document.getElementById('teg-imp-prev').addEventListener('click', async () => {
      const btn = document.getElementById('teg-imp-prev');
      out.innerHTML = ''; btn.disabled = true;
      const rows = [], seen = new Set();
      try {
        for (let skip = 0; skip < 5000; skip += 20) {
          say(`Previewing the import… ${rows.length} so far`);
          const { body } = await call(`/teg/headshots/preview?skip=${skip}`);
          if (!body || body.error) throw new Error((body && body.error) || 'No answer.');
          const fresh = (body.rows || []).filter((r) => { const k = r.email || r.name; if (seen.has(k)) return false; seen.add(k); return true; });
          rows.push(...fresh);
          if (!fresh.length || (body.page || 0) < 20) break;
        }
      } catch (err) { say(err.message, 'is-err'); btn.disabled = false; return; }
      btn.disabled = false;
      LAST_PREVIEW = rows;
      const go = rows.filter((r) => r.action !== 'skip');
      const skipped = rows.filter((r) => r.action === 'skip');
      const reasons = {}; skipped.forEach((r) => { reasons[r.why] = (reasons[r.why] || 0) + 1; });
      const fresh = go.filter((r) => r.action === 'import');
      say(`${rows.length} TEG people looked at: ${go.length} ready, of whom ${fresh.length} new.`, 'is-ok');
      /* Choose who to import: New (not already holding a TEG photo) is
         picked to start, so a re-run only brings in what's changed; All, or
         any one person whose photo has changed (Danielle, 1 Oct 2026). */
      const picked = new Set(fresh.map((r) => r.email));
      let q = '';
      out.innerHTML = `
        <div class="teg-sum"><div class="teg-stat"><b>${go.length}</b><span>Ready to import</span></div><div class="teg-stat"><b>${fresh.length}</b><span>Of those, new</span></div>${Object.entries(reasons).sort((a, b) => b[1] - a[1]).map(([w, n]) => `<div class="teg-stat"><b>${n}</b><span>${esc(w)}</span></div>`).join('')}</div>
        <p class="teg-note">Only background-free pictures, for people in our CRM with a profile for that brand. A photo someone at TMKE set by hand is never replaced. Each one is copied into our own storage.</p>
        <input type="search" class="teg-q" id="teg-imp-q" placeholder="Find someone in either list, e.g. McMahon">
        <div id="teg-imp-lists"></div>`;
      const thumb = (r) => r.photo ? `<span class="teg-thumb" style="background-image:url('${esc(r.photo)}')"></span>` : '';
      const what = (r) => IMPORT_WHY[r.action] + ((r.also || []).length ? `, and on their ${r.also.join(' and ')} profile` : '') + (r.matched_by ? ` (matched by ${r.matched_by})` : '');
      const draw = () => {
        const m = (r) => !q || (r.name + ' ' + r.email).toLowerCase().includes(q);
        const g = go.filter(m), sk = skipped.filter(m);
        document.getElementById('teg-imp-lists').innerHTML = `
          ${go.length ? `<details open style="margin-top:14px"><summary class="teg-note" style="cursor:pointer"><strong>Ready to import · ${go.length}</strong></summary>
            <div class="teg-pick">Select: <button type="button" data-pick="all">All</button> · <button type="button" data-pick="new">New</button> · <button type="button" data-pick="none">None</button>
              <button type="button" class="admin-btn admin-btn-primary" id="teg-imp-go" ${picked.size ? '' : 'disabled'}>Import ${picked.size} selected</button> <span class="teg-status" id="teg-imp-st"></span></div>
            <div class="teg-tablewrap"><table class="teg-table"><thead><tr><th></th><th></th><th>Name</th><th>Brand</th><th>Email</th><th>What happens</th></tr></thead><tbody>${g.map((r) => `<tr><td><input type="checkbox" data-tick="${esc(r.email)}" ${picked.has(r.email) ? 'checked' : ''} aria-label="Import ${esc(r.name)}"></td><td>${thumb(r)}</td><td>${esc(r.name)}</td><td>${esc(r.brand)}</td><td>${esc(r.email)}</td><td>${esc(what(r))}</td></tr>`).join('') || '<tr><td colspan="6">Nobody matches.</td></tr>'}</tbody></table></div></details>` : ''}
          ${skipped.length ? `<details ${q ? 'open' : ''} style="margin-top:14px"><summary class="teg-note" style="cursor:pointer"><strong>Not imported · ${skipped.length}</strong></summary>
            <div class="teg-tablewrap"><table class="teg-table"><thead><tr><th></th><th>Name</th><th>Brand</th><th>Email</th><th>Why</th></tr></thead><tbody>${sk.map((r) => `<tr><td>${thumb(r)}</td><td>${esc(r.name)}</td><td>${esc(r.brand)}</td><td>${esc(r.email)}</td><td>${esc(r.why)}</td></tr>`).join('') || '<tr><td colspan="5">Nobody matches.</td></tr>'}</tbody></table></div></details>` : ''}`;
        const host = document.getElementById('teg-imp-lists');
        host.querySelectorAll('[data-tick]').forEach((c) => c.addEventListener('change', () => { c.checked ? picked.add(c.dataset.tick) : picked.delete(c.dataset.tick); draw(); }));
        host.querySelectorAll('[data-pick]').forEach((b) => b.addEventListener('click', () => {
          picked.clear();
          if (b.dataset.pick === 'all') go.forEach((r) => picked.add(r.email));
          if (b.dataset.pick === 'new') fresh.forEach((r) => picked.add(r.email));
          draw();
        }));
        document.getElementById('teg-imp-go')?.addEventListener('click', runImport);
      };
      const runImport = async (e) => {
        const list = go.filter((r) => picked.has(r.email));
        if (!list.length || !confirm(`Import ${list.length} headshot${list.length === 1 ? '' : 's'} as brand photos? Nothing at TEG changes.`)) return;
        const b = e.target, st = document.getElementById('teg-imp-st'); b.disabled = true;
        let done = 0, skippedN = 0; const failed = [];
        for (const r of list) {
          st.textContent = `Importing ${done + skippedN + failed.length + 1} of ${list.length}…`;
          try {
            const { data } = await supabase.auth.getSession();
            const res = await fetch(WORKER + '/teg/headshots/import', { method: 'POST', headers: { Authorization: 'Bearer ' + data?.session?.access_token, 'Content-Type': 'application/json' }, body: JSON.stringify({ email: r.email }) });
            const j = await res.json().catch(() => ({}));
            if (res.ok && j.ok) done++; else if (res.ok && j.skipped) skippedN++; else failed.push(`${r.name}: ${j.error || res.status}`);
          } catch (err) { failed.push(`${r.name}: ${err.message}`); }
        }
        st.textContent = `Done: ${done} imported${skippedN ? `, ${skippedN} skipped` : ''}${failed.length ? `, ${failed.length} failed` : ''}. Run the preview again to refresh the lists.`;
        st.className = 'teg-status ' + (failed.length ? 'is-err' : 'is-ok');
        if (failed.length) out.insertAdjacentHTML('beforeend', `<div class="teg-raw">${esc(failed.join('\n'))}</div>`);
      };
      document.getElementById('teg-imp-q').addEventListener('input', (e) => { q = e.target.value.trim().toLowerCase(); draw(); });
      draw();
    });

    document.getElementById('teg-photos').addEventListener('click', async () => {
      out.innerHTML = '';
      say('Asking photoApi what it holds…');
      const { body } = await call('/teg/photos?limit=5');
      if (!body || body.error) { say((body && body.error) || "No answer.", 'is-err'); return; }
      say(`${body.count} records there${body.has_more ? ', and more after these' : ''}.`, 'is-ok');
      const list = (arr) => (arr || []).map((f) => `<span class="teg-pill">${esc(f)}</span>`).join('') || '—';
      out.innerHTML = `
        <div class="teg-sum">
          <div class="teg-stat"><b>${esc(body.count)}</b><span>Records</span></div>
          <div class="teg-stat"><b>${(body.fields || []).length}</b><span>Fields each</span></div>
          <div class="teg-stat"><b>${(body.looks_like_an_image || []).length}</b><span>Image-ish fields</span></div>
        </div>
        <p class="teg-note" style="margin-bottom:6px"><strong>Fields that look like a picture</strong></p>
        <div>${list(body.looks_like_an_image)}</div>
        <p class="teg-note" style="margin:16px 0 6px"><strong>Every field</strong></p>
        <div>${list(body.fields)}</div>
        <p class="teg-note" style="margin:16px 0 6px"><strong>One whole record</strong></p>
        <div class="teg-raw">${esc(JSON.stringify(body.sample, null, 2))}</div>`;
    });

    document.getElementById('teg-dry').addEventListener('click', async () => {
      out.innerHTML = '';
      say('Reading both rosters…');
      const { body } = await call('/teg/preview?limit=500');
      if (!body || !body.ok) {
        say((body && body.error) || "That didn't run.", 'is-err');
        if (body) out.innerHTML = '<div class="teg-raw">' + esc(JSON.stringify(body, null, 2)) + '</div>';
        return;
      }
      say(`Read ${body.counted} of their people. Nothing was changed.`, 'is-ok');
      const stat = (n, label) => `<div class="teg-stat"><b>${n}</b><span>${label}</span></div>`;
      const rows = (body.preview || []).map((p) => `
        <tr>
          <td>${esc(p.name)}<br><span style="color:rgba(28,29,34,0.5)">${esc(p.email)}</span></td>
          <td>${p.match === 'in our CRM' ? 'In our CRM' : '<span class="teg-new">New — no contact</span>'}</td>
          <td>${(p.brands_theirs || []).map((b) => `<span class="teg-pill">${esc(b)}</span>`).join('') || '—'}</td>
          <td>${(p.brands_to_add || []).map((b) => `<span class="teg-pill is-add">+ ${esc(b)}</span>`).join('') || '—'}</td>
          <td>${esc(p.job_title) || '—'}</td>
          <td>${(p.postcodes || []).join(', ') || '—'}</td>
          <td>${p.leaver ? 'Left' : esc(p.status) || '—'}</td>
          <td>${p.photo_provided ? 'Yes' : '—'}</td>
        </tr>`).join('');
      out.innerHTML = `
        <div class="teg-sum">
          ${stat(body.counted, 'Their people')}
          ${stat(body.new_people, 'Not in our CRM')}
          ${stat(body.brand_rows_to_add, 'Brand rows to add')}
          ${stat(body.leavers, 'Marked as left')}
          ${stat(body.with_photo_flag, 'Photo on file')}
        </div>
        <div class="teg-tablewrap"><table class="teg-table">
          <thead><tr><th>Person</th><th>Match</th><th>Their brands</th><th>We would add</th><th>Job title</th><th>Postcodes</th><th>Status</th><th>Photo</th></tr></thead>
          <tbody>${rows}</tbody>
        </table></div>`;
    });

    (async () => {
      if (!import.meta.env.DEV) { const s = await requireAdmin(); if (!s) return; }
      if (!WORKER) say('The Worker URL is not set in this build.', 'is-err');
    })();
  </script>
</AdminShell>
