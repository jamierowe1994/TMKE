---
import AdminShell from "../../components/admin/AdminShell.astro";
import "../../styles/admin.css";
---

<AdminShell active="teg" title="TEG sync" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">TEG sync</div>
          <div class="page-header-sub">The Experts Group's own team database — who works for which brand, under what title, on whose patch, and who has left. We read it; we never write to it.</div>
        </div>
      </div>
    </div>
  </div>

  <!-- The monthly Team Hub check (Danielle, 19 Oct 2026): the Team Hub read
       live against our CRM. New joiners to add, leavers to remove, and what
       has changed since the last check. It runs itself on the 1st. -->
  <section class="ash-panel rc" id="rc">
    <h2 class="rc-title">Team Hub check</h2>
    <p class="rc-intro">Reads the Team Hub and our CRM side by side, and lists new joiners, leavers and anything that has changed, such as a status. It runs by itself on the 1st of each month, and you can run it at any time. Nothing changes, here or on the Team Hub, until you choose to.</p>
    <p class="rc-last" id="rc-last"></p>
    <!-- Starts on the panel's left edge, as the tools' buttons below do. -->
    <div class="teg-acts rc-run-row">
      <button type="button" class="admin-btn admin-btn-primary" id="rc-run">Run the check</button>
      <button type="button" class="rc-link" id="teg-roster">Or compare a Team Hub export</button>
      <input type="file" id="teg-roster-file" accept=".csv,text/csv" hidden>
    </div>
    <p class="teg-status" id="rc-status"></p>
    <div id="rc-out"></div>
  </section>

  <!-- Add a new joiner to the CRM: what the Team Hub has, filled in. -->
  <div class="rc-modal" id="rc-add" hidden>
    <div class="rc-modal-back" data-rc-close></div>
    <form class="rc-modal-card" id="rc-add-form" role="dialog" aria-modal="true" aria-labelledby="rc-add-title" novalidate>
      <button type="button" class="rc-x" data-rc-close aria-label="Close">&times;</button>
      <p class="rc-eyebrow">New joiner</p>
      <h2 class="rc-modal-title" id="rc-add-title">Add to the CRM</h2>
      <p class="rc-modal-sub">Filled in from the Team Hub. Add anything else you have, then save.</p>
      <div class="rc-grid">
        <label class="rc-f"><span>First name</span><input type="text" id="rc-a-first" autocomplete="off"></label>
        <label class="rc-f"><span>Last name</span><input type="text" id="rc-a-last" autocomplete="off"></label>
        <label class="rc-f rc-f-wide"><span>Work email</span><input type="email" id="rc-a-email" autocomplete="off" required></label>
        <label class="rc-f"><span>Work mobile</span><input type="tel" id="rc-a-phone" autocomplete="off"></label>
        <label class="rc-f"><span>Job title</span><input type="text" id="rc-a-job" autocomplete="off"></label>
        <label class="rc-f"><span>Area</span><input type="text" id="rc-a-area" autocomplete="off"></label>
        <label class="rc-f"><span>Postcode</span><input type="text" id="rc-a-pc" autocomplete="off"></label>
        <label class="rc-f"><span>Joined</span><input type="date" id="rc-a-joined"></label>
        <fieldset class="rc-f rc-f-wide rc-brands"><span>Brands</span><div id="rc-a-brands"></div></fieldset>
      </div>
      <p class="teg-status is-err" id="rc-a-err" hidden></p>
      <div class="rc-modal-acts">
        <button type="button" class="admin-btn admin-btn-ghost" data-rc-close>Cancel</button>
        <button type="submit" class="admin-btn admin-btn-primary" id="rc-a-save">Add to CRM</button>
      </div>
    </form>
  </div>

  <!-- A contact card, popped out: the Contacts page's own card. -->
  <div class="rc-modal rc-card" id="rc-card" hidden>
    <div class="rc-modal-back" data-rc-close></div>
    <div class="rc-card-frame">
      <button type="button" class="rc-x rc-card-x" data-rc-close aria-label="Close">&times;</button>
      <p class="rc-card-wait" id="rc-card-wait">Opening the contact card…</p>
      <iframe id="rc-card-if" title="Contact card" hidden></iframe>
    </div>
  </div>

  <div class="ash-panel ash-page">
    <p class="rc-tools-h">Other TEG tools</p>
    <div class="teg-acts">
      <button type="button" class="admin-btn admin-btn-primary" id="teg-ping">Test the connection</button>
      <button type="button" class="admin-btn" id="teg-photos">What does photoApi hold?</button>
      <button type="button" class="admin-btn" id="teg-heads">Check the headshots</button>
      <button type="button" class="admin-btn" id="teg-heads-all">Check everyone</button>
      <button type="button" class="admin-btn" id="teg-imp-prev">Preview headshot import</button>
      <button type="button" class="admin-btn" id="teg-missing">Our agents without a brand photo</button>
      <button type="button" class="admin-btn" id="teg-dry">Dry run — show me what a sync would do</button>
      <span class="teg-status" id="teg-status"></span>
    </div>

    <!-- Nothing is written by either button. The dry run reads their roster
         and ours and reports the difference; that is all it can do. -->
    <p class="teg-note">Neither button changes anything, on our side or theirs. The dry run reads both rosters and reports the difference.</p>

    <div id="teg-out"></div>
  </div>

  <style is:global>
    .teg-acts { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .teg-status { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); }
    .teg-status.is-ok { color: #2b6b44; }
    .teg-status.is-err { color: #9a2a2a; }
    .teg-note { font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); margin: 10px 0 0; }
    .teg-sum { display: flex; gap: 10px; flex-wrap: wrap; margin: 20px 0 14px; }
    .teg-stat { border: 1px solid var(--border, rgba(28,29,34,0.12)); border-radius: 8px; padding: 12px 16px; min-width: 120px; }
    .teg-stat b { display: block; font-family: var(--serif); font-size: 24px; font-weight: 500; color: var(--ink); line-height: 1.1; }
    .teg-stat span { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .teg-tablewrap { overflow-x: auto; }
    .teg-table { width: 100%; border-collapse: collapse; font-family: var(--sans); font-size: 12.5px; }
    .teg-table th { text-align: left; font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: rgba(28,29,34,0.5); padding: 8px 10px; border-bottom: 1px solid var(--border, rgba(28,29,34,0.12)); white-space: nowrap; }
    .teg-table td { padding: 8px 10px; border-bottom: 1px solid rgba(28,29,34,0.06); vertical-align: top; }
    .teg-new { color: #a05a3c; font-weight: 700; }
    .teg-pill { display: inline-block; font-size: 10.5px; padding: 2px 7px; border-radius: 999px; background: rgba(var(--violet-rgb),0.1); color: var(--english-violet); margin: 0 3px 3px 0; }
    .teg-pill.is-add { background: rgba(63,148,104,0.14); color: #2b6b44; }
    /* Headshots on a checkerboard, so a background-free cut-out shows as one. */
    .teg-heads { display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: 14px; margin-top: 16px; }
    .teg-head { border: 1px solid rgba(28,29,34,0.12); border-radius: 10px; padding: 10px; font-family: var(--sans); font-size: 12px; }
    .teg-head b { display: block; font-size: 13px; color: var(--ink); margin-bottom: 2px; }
    .teg-head small { color: rgba(28,29,34,0.55); display: block; margin-bottom: 8px; word-break: break-all; }
    .teg-shot { margin-top: 8px; }
    .teg-shot .img { height: 170px; border-radius: 6px; background-color: #fff; background-image: linear-gradient(45deg, #e6e3e3 25%, transparent 25%), linear-gradient(-45deg, #e6e3e3 25%, transparent 25%), linear-gradient(45deg, transparent 75%, #e6e3e3 75%), linear-gradient(-45deg, transparent 75%, #e6e3e3 75%); background-size: 16px 16px; background-position: 0 0, 0 8px, 8px -8px, -8px 0; display: flex; align-items: flex-end; justify-content: center; overflow: hidden; }
    .teg-shot img { max-width: 100%; max-height: 100%; object-fit: contain; }
    .teg-shot .meta { display: flex; justify-content: space-between; gap: 6px; margin-top: 5px; color: rgba(28,29,34,0.6); }
    .teg-yes { color: #2b6b44; font-weight: 700; } .teg-no { color: #9a2a2a; font-weight: 700; }
    .ash-panel .teg-fc { display: inline-flex; align-items: center; gap: 7px; font-family: var(--sans); font-size: 13px; color: var(--ink); margin: 16px 0 0; cursor: pointer; text-transform: none; letter-spacing: 0; font-weight: 500; }
    .ash-panel .teg-q { display: block; width: min(420px, 100%); height: 40px; box-sizing: border-box; padding: 0 12px; margin: 14px 0 0; border: 1px solid rgba(28,29,34,0.18); border-radius: 8px; font: 13px var(--sans); }
    .teg-pick { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin: 10px 0 6px; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); }
    .teg-pick button[data-pick] { appearance: none; background: none; border: 0; padding: 0; font: 700 13px var(--sans); color: var(--english-violet); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
    .teg-pick .admin-btn { margin-left: 12px; }
    .teg-thumb { display: block; width: 40px; height: 52px; border-radius: 4px; background-size: contain; background-repeat: no-repeat; background-position: center bottom; background-color: #f1eeee; }
    .teg-h { font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--ink); margin: 26px 0 4px; }
    .teg-flag { color: #7a5405; }
    .teg-fill { display: block; color: rgba(28,29,34,0.7); }
    .teg-fill b { font-weight: 700; color: var(--ink); }
    /* ---- Team Hub check ---- */
    .rc { margin-bottom: 16px; }
    .rc-title { margin: 0; font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 20px; font-weight: 600; color: var(--ink); }
    .rc-intro { margin: 6px 0 0; max-width: 75%; font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: rgba(28,29,34,0.6); }
    .rc-last { margin: 8px 0 0; font-family: var(--sans); font-size: 12.5px; color: rgba(28,29,34,0.5); }
    .rc-run-row { margin-top: 16px; gap: 16px; }
    .rc-link { appearance: none; border: 0; background: none; padding: 0; font: 600 12px var(--sans); color: var(--english-violet); text-decoration: underline; text-underline-offset: 3px; cursor: pointer; }
    .rc-tools-h { margin: 0 0 12px; font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .rc-sec { margin-top: 26px; }
    .rc-sec-h { display: flex; align-items: baseline; gap: 10px; flex-wrap: wrap; margin: 0 0 4px; }
    .rc-sec-h h3 { margin: 0; font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 16px; font-weight: 600; color: var(--ink); }
    .rc-sec-h .rc-n { font-family: var(--sans); font-size: 12px; font-weight: 700; color: rgba(28,29,34,0.45); }
    .rc-sec-h .rc-link { margin-left: auto; }
    .rc-sec > .teg-note { margin: 2px 0 10px; max-width: 75%; }
    .rc-empty { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.5); margin: 6px 0 0; }
    .rc .teg-table { border-top: 1px solid rgba(28,29,34,0.12); border-bottom: 1px solid rgba(28,29,34,0.12); }
    .rc-acts { display: flex; gap: 6px; flex-wrap: wrap; justify-content: flex-end; }
    .hub-skin .rc-acts .admin-btn { padding: 6px 10px; font-size: 11px; white-space: nowrap; }
    /* The summary boxes as tabs. */
    .rc-tab { appearance: none; background: #fff; text-align: left; cursor: pointer; font: inherit; transition: border-color 0.15s, background 0.15s; }
    .rc-tab:hover { border-color: var(--english-violet); }
    .rc-tab.is-on { background: var(--english-violet); border-color: var(--english-violet); }
    .rc-tab.is-on b, .rc-tab.is-on span { color: #fff; }
    .rc-tab:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
    .rc-sec[hidden] { display: none; }
    .rc-acts-l { justify-content: flex-start; gap: 12px; margin-top: 4px; }
    .rc-progs { display: grid; gap: 3px; }
    .rc-prog { font-family: var(--sans); font-size: 12px; white-space: nowrap; padding-left: 14px; position: relative; }
    .rc-prog::before { content: ""; position: absolute; left: 0; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; }
    .rc-prog.is-yes { color: var(--ink); }
    .rc-prog.is-yes::before { background: #3f9468; }
    .rc-prog.is-no { color: rgba(28,29,34,0.5); }
    .rc-prog.is-no::before { background: transparent; box-shadow: inset 0 0 0 1.5px rgba(28,29,34,0.3); }
    .rc-done { font-family: var(--sans); font-size: 12px; font-weight: 700; color: #2b6b44; white-space: nowrap; }
    .rc-change { font-family: var(--sans); font-size: 13px; color: var(--ink); }
    .rc-change b { font-weight: 700; }
    .rc-change s { color: rgba(28,29,34,0.5); text-decoration-color: rgba(28,29,34,0.35); }
    .rc-arrow { color: rgba(28,29,34,0.4); margin: 0 4px; }
    .rc-status { display: inline-block; font-size: 10.5px; font-weight: 700; letter-spacing: 0.04em; padding: 2px 7px; border-radius: 999px; background: rgba(28,29,34,0.07); color: rgba(28,29,34,0.65); white-space: nowrap; }
    .rc-status.is-live { background: rgba(63,148,104,0.14); color: #2b6b44; }
    .rc-status.is-gone { background: rgba(165,53,47,0.12); color: #a5352f; }
    .rc-status.is-wait { background: rgba(196,140,40,0.15); color: #8a5a10; }
    .rc-namebtn { appearance: none; border: 0; background: none; padding: 0; font: 600 12.5px var(--sans); color: var(--ink); text-align: left; cursor: pointer; text-decoration: underline; text-decoration-color: rgba(28,29,34,0.25); text-underline-offset: 3px; }
    .rc-namebtn:hover { color: var(--english-violet); text-decoration-color: currentColor; }
    /* Pop-outs */
    .rc-modal { position: fixed; inset: 0; z-index: 200; display: grid; place-items: center; padding: 24px 16px; }
    .rc-modal[hidden] { display: none; }
    .rc-modal-back { position: absolute; inset: 0; background: rgba(20,18,26,0.42); }
    .rc-modal-card { position: relative; width: min(620px, 100%); max-height: 90vh; overflow-y: auto; background: #fff; border-radius: 12px; padding: 26px 28px 22px; box-shadow: 0 40px 90px -30px rgba(20,18,26,0.6); }
    .rc-x { position: absolute; top: 12px; right: 14px; border: 0; background: none; font-size: 26px; line-height: 1; color: rgba(28,29,34,0.5); cursor: pointer; }
    .rc-eyebrow { margin: 0; font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .rc-modal-title { margin: 4px 0 0; font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif; font-size: 22px; font-weight: 600; color: var(--ink); }
    .rc-modal-sub { margin: 6px 0 18px; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); }
    .rc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px 14px; }
    @media (max-width: 560px) { .rc-grid { grid-template-columns: 1fr; } }
    .hub-skin .rc-f { display: flex; flex-direction: column; gap: 5px; margin: 0; min-width: 0; border: 0; padding: 0; }
    .rc-f-wide { grid-column: 1 / -1; }
    .rc-f > span { font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: rgba(28,29,34,0.55); }
    .hub-skin .rc-f input { width: 100%; box-sizing: border-box; }
    .rc-brands > div { display: flex; flex-wrap: wrap; gap: 8px 16px; }
    .hub-skin .rc-brands label { display: inline-flex; align-items: center; gap: 7px; margin: 0; font-size: 13px; font-weight: 500; text-transform: none; letter-spacing: 0; color: var(--ink); cursor: pointer; }
    .rc-modal-acts { display: flex; justify-content: flex-end; gap: 8px; margin-top: 18px; }
    .rc-card-frame { position: relative; width: min(1000px, 100%); height: min(88vh, 900px); background: #fff; border-radius: 12px; overflow: hidden; box-shadow: 0 40px 90px -30px rgba(20,18,26,0.6); }
    .rc-card-frame iframe { width: 100%; height: 100%; border: 0; display: block; }
    .rc-card-frame iframe[hidden] { display: none; }
    .rc-card-x { z-index: 2; background: #fff; border-radius: 50%; width: 34px; height: 34px; top: 10px; right: 10px; }
    .rc-card-wait { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.55); }
    .teg-raw { font-family: ui-monospace, monospace; font-size: 12px; white-space: pre-wrap; word-break: break-word; background: #faf9f8; border: 1px solid rgba(28,29,34,0.1); border-radius: 8px; padding: 12px; margin-top: 14px; }
  </style>

  <script>
    import { requireAdmin } from '../../lib/admin-gate.js';
    import { supabase } from '../../lib/supabase.js';

    const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');
    const out = document.getElementById('teg-out');
    const statusEl = document.getElementById('teg-status');
    const esc = (v) => String(v == null ? '' : v).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]));
    const say = (m, cls) => { statusEl.textContent = m || ''; statusEl.className = 'teg-status' + (cls ? ' ' + cls : ''); };

    async function call(pathname) {
      const { data } = await supabase.auth.getSession();
      const token = data?.session?.access_token;
      const res = await fetch(WORKER + pathname, { headers: { Authorization: 'Bearer ' + token } });
      return { status: res.status, body: await res.json().catch(() => null) };
    }

    document.getElementById('teg-ping').addEventListener('click', async () => {
      out.innerHTML = '';
      say('Knocking…');
      const { body } = await call('/teg/ping');
      if (!body) { say("No answer from our own Worker.", 'is-err'); return; }
      const db = body.dbApi || {};
      say(db.ok ? 'Connected — their database answered.' : 'Not connected yet.', db.ok ? 'is-ok' : 'is-err');
      out.innerHTML = '<div class="teg-raw">' + esc(JSON.stringify(body, null, 2)) + '</div>';
    });

    /* photoApi is undocumented, so this reports its shape rather than
       pretending we know it: every field name, the ones that look like an
       image, and one whole record to read. */
    // Headshots: 20 people, each picture opened to see if it is background-free.
    document.getElementById('teg-heads').addEventListener('click', async () => {
      out.innerHTML = '';
      say('Opening twenty headshots…');
      const { body } = await call('/teg/photos?limit=20&check=1');
      if (!body || body.error) { say((body && body.error) || 'No answer.', 'is-err'); return; }
      const people = body.people || [];
      const shots = people.flatMap((p) => p.images.map((i) => ({ ...i, who: p.label })));
      const byField = {};
      shots.forEach((i) => { const f = byField[i.field] || (byField[i.field] = { total: 0, clear: 0 }); f.total++; if (i.transparent) f.clear++; });
      say(`${body.count ?? '?'} records in photoApi; ${people.length} checked.`, 'is-ok');
      out.innerHTML = `
        <div class="teg-sum">
          ${Object.entries(byField).map(([f, n]) => `<div class="teg-stat"><b>${n.clear} of ${n.total}</b><span>${esc(f)}: background-free</span></div>`).join('') || '<p class="teg-note">None of these records has a picture link.</p>'}
        </div>
        <p class="teg-note">Every picture field TEG returns: <strong>${esc((body.looks_like_an_image || []).join(', ') || 'none')}</strong>. The checkerboard shows through anything background-free.</p>
        <div class="teg-heads">${people.map((p) => `<div class="teg-head"><b>${esc(p.label)}</b><small>${esc(p.email || '')}</small>
          ${p.images.length ? p.images.map((i) => `<div class="teg-shot"><div class="img"><img src="${esc(i.url)}" alt="" loading="lazy"></div>
            <div class="meta"><span>${esc(i.field)} · ${esc(i.format || '?')}${i.width ? ` · ${i.width}×${i.height}` : ''}</span>
            <span class="${i.transparent ? 'teg-yes' : 'teg-no'}">${i.transparent ? 'Background-free' : i.transparent === false ? 'Has background' : (i.error ? esc(i.error) : 'Unknown')}</span></div></div>`).join('') : '<small>No picture</small>'}
        </div>`).join('')}</div>
        <p class="teg-note" style="margin:16px 0 6px"><strong>One whole record</strong></p>
        <div class="teg-raw">${esc(JSON.stringify(body.sample, null, 2))}</div>`;
    });

    /* Everyone, twenty at a time (one request each, so the Worker stays well
       inside its limits): who has a background-free headshot and who still
       has a background, to chase TEG with. */
    document.getElementById('teg-heads-all').addEventListener('click', async () => {
      const btn = document.getElementById('teg-heads-all');
      out.innerHTML = ''; btn.disabled = true;
      const people = [], seen = new Set(); let fields = [], note = '';
      try {
        // TEG's count is the page's, not the whole list's, and has_more can't
        // be relied on either (30 Sep 2026: it stopped at 20), so this keeps
        // asking until a page comes back short, or brings nobody new.
        for (let skip = 0; skip < 5000; skip += 20) {
          say(`Checking headshots… ${people.length} so far`);
          const { body } = await call(`/teg/photos?limit=20&skip=${skip}&check=1`);
          if (!body || body.error) throw new Error((body && body.error) || 'No answer.');
          fields = [...new Set([...fields, ...(body.looks_like_an_image || [])])];
          const page = body.people || [];
          const fresh = page.filter((p) => { const k = (p.email || p.label || '').toLowerCase(); if (seen.has(k)) return false; seen.add(k); return true; });
          people.push(...fresh);
          if (page.length && !fresh.length) { note = "TEG sent the same people again, so it may not support paging past this point."; break; }
          if (page.length < 20) break;
        }
      } catch (err) { say(err.message, 'is-err'); btn.disabled = false; return; }
      btn.disabled = false;
      // Best picture per person: a background-free one if any field has it.
      const all = people.map((p) => {
        const clear = p.images.find((i) => i.transparent);
        const any = p.images[0] || null;
        return { name: p.label, email: p.email || '', brand: brandOf(p.email), state: clear ? 'clear' : any ? (any.transparent === false ? 'background' : 'unknown') : 'none', field: (clear || any || {}).field || '', url: (clear || any || {}).url || '' };
      });
      HEADS = { all, fields, note };
      drawHeads();
    });
    // Brand from the email domain: the same list as the Worker's
    // (TEG_DOMAIN_BRANDS in worker/src/index.js).
    const DOMAIN_BRANDS = [
      [/(^|\.)thepropertyexperts\.co\.uk$/i, 'The Property Experts'], [/(^|\.)prestigepropertyexperts\.co\.uk$/i, 'Prestige Property Experts'],
      [/(^|\.)thelettings?experts\.co\.uk$/i, 'The Letting Experts'], [/(^|\.)themarketingexperts\.co\.uk$/i, 'The Marketing Experts'],
      [/(^|\.)therecruitmentexperts\.co\.uk$/i, 'The Recruitment Experts'], [/(^|\.)themortgageexperts\.co\.uk$/i, 'The Mortgage Experts'],
      [/(^|\.)fineandcountry\.com$/i, 'Fine & Country'],
    ];
    const brandOf = (email) => { const d = String(email || '').toLowerCase().split('@')[1] || ''; const hit = DOMAIN_BRANDS.find(([re]) => re.test(d)); return hit ? hit[1] : (d ? 'Other' : '—'); };
    /* TEG's own brands first: Fine & Country won't use the print suite yet
       (Danielle, 30 Sep 2026), so they're left out unless asked for. */
    let HEADS = null, withFC = false;
    function drawHeads() {
      if (!HEADS) return;
      const { all, fields } = HEADS;
      const rows = all.filter((r) => withFC || r.brand !== 'Fine & Country');
      const groups = { clear: 'Background-free', background: 'Still has a background', none: 'No picture', unknown: "Couldn't tell" };
      const n = (k) => rows.filter((r) => r.state === k).length;
      const fc = all.length - all.filter((r) => r.brand !== 'Fine & Country').length;
      say(`${all.length} people checked${fc && !withFC ? `; ${fc} at Fine & Country left out` : ''}.${HEADS.note ? ' ' + HEADS.note : ''}`, HEADS.note ? 'is-err' : 'is-ok');
      const brands = [...new Set(rows.map((r) => r.brand))].sort();
      const csv = 'Name,Email,Brand,Headshot,Field,Link\n' + rows.map((r) => [r.name, r.email, r.brand, groups[r.state], r.field, r.url].map((v) => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
      out.innerHTML = `
        <label class="teg-fc"><input type="checkbox" id="teg-fc" ${withFC ? 'checked' : ''}> Include Fine &amp; Country</label>
        <div class="teg-sum">${Object.keys(groups).filter((k) => n(k)).map((k) => `<div class="teg-stat"><b>${n(k)}</b><span>${groups[k]}</span></div>`).join('')}</div>
        <p class="teg-note">By brand: ${brands.map((b) => { const br = rows.filter((r) => r.brand === b); return `<strong>${esc(b)}</strong> ${br.filter((r) => r.state === 'clear').length} of ${br.length} background-free`; }).join(' · ')}</p>
        <p class="teg-note">Picture fields seen: <strong>${esc(fields.join(', ') || 'none')}</strong>. A person counts as background-free if any of their pictures is.
          <a href="data:text/csv;charset=utf-8,${encodeURIComponent(csv)}" download="TEG headshots.csv">Download the list</a></p>
        ${['background', 'none', 'unknown', 'clear'].filter((k) => n(k)).map((k) => `<details ${k === 'background' ? 'open' : ''} style="margin-top:14px"><summary class="teg-note" style="cursor:pointer"><strong>${groups[k]} · ${n(k)}</strong></summary>
          <div class="teg-tablewrap"><table class="teg-table"><thead><tr><th>Name</th><th>Brand</th><th>Email</th><th>Field</th></tr></thead><tbody>${rows.filter((r) => r.state === k).map((r) => `<tr><td>${esc(r.name)}</td><td>${esc(r.brand)}</td><td>${esc(r.email)}</td><td>${esc(r.field)}</td></tr>`).join('')}</tbody></table></div></details>`).join('')}`;
      document.getElementById('teg-fc').addEventListener('change', (e) => { withFC = e.target.checked; drawHeads(); });
    }

    /* Headshot import. Preview first: every TEG person and what would happen
       to them, with the reason when nothing would. Then the import, one
       person at a time, so progress shows and one failure stops nothing. */
    let LAST_PREVIEW = null;
    // Who in our CRM still has no brand photo, with TEG's side if the
    // preview has been run this visit.
    document.getElementById('teg-missing').addEventListener('click', async () => {
      out.innerHTML = '';
      say('Finding agents without a brand photo…');
      const { body } = await call('/teg/missing-photos');
      if (!body || body.error) { say((body && body.error) || 'No answer.', 'is-err'); return; }
      const teg = new Map((LAST_PREVIEW || []).map((r) => [String(r.email || '').toLowerCase(), r]));
      const tegSide = (email) => { if (!LAST_PREVIEW) return '–'; const t = teg.get(email); return !t ? 'Not found at TEG' : t.action !== 'skip' ? 'Ready to import' : t.why; };
      const rows = body.rows || [];
      const brands = [...new Set(rows.map((r) => r.brand))];
      say(`${rows.length} current agent profile${rows.length === 1 ? '' : 's'} without a brand photo.`, 'is-ok');
      const csv = 'Name,Email,Brand,Job title,At TEG\n' + rows.map((r) => [r.name, r.email, r.brand, r.job_title, tegSide(r.email)].map((v) => `"${String(v).replace(/"/g, '""')}"`).join(',')).join('\n');
      out.innerHTML = `
        <div class="teg-sum">${brands.map((b) => `<div class="teg-stat"><b>${rows.filter((r) => r.brand === b).length}</b><span>${esc(b)}</span></div>`).join('')}</div>
        <p class="teg-note">Fine &amp; Country left out for now. <a href="data:text/csv;charset=utf-8,${encodeURIComponent(csv)}" download="Agents without a brand photo.csv">Download the list</a></p>
        ${LAST_PREVIEW ? '' : `<p class="teg-note" style="color:#7a5405">To see why each person hasn't come through, run <strong>Preview headshot import</strong> first, then this list again: the At TEG column fills in with the reason.</p>`}
        ${brands.map((b) => `<details ${b === 'The Property Experts' ? 'open' : ''} style="margin-top:14px"><summary class="teg-note" style="cursor:pointer"><strong>${esc(b)} · ${rows.filter((r) => r.brand === b).length}</strong></summary>
          <div class="teg-tablewrap"><table class="teg-table"><thead><tr><th>Name</th><th>Email</th><th>Job title</th><th>At TEG</th></tr></thead><tbody>${rows.filter((r) => r.brand === b).map((r) => `<tr><td>${esc(r.name)}</td><td>${esc(r.email)}</td><td>${esc(r.job_title)}</td><td>${esc(tegSide(r.email))}</td></tr>`).join('')}</tbody></table></div></details>`).join('')}`;
    });
    const IMPORT_WHY = { import: 'New brand photo', update: 'Already imported: replaces the TEG photo we hold' };
    document.getElementById('teg-imp-prev').addEventListener('click', async () => {
      const btn = document.getElementById('teg-imp-prev');
      out.innerHTML = ''; btn.disabled = true;
      const rows = [], seen = new Set();
      try {
        for (let skip = 0; skip < 5000; skip += 20) {
          say(`Previewing the import… ${rows.length} so far`);
          const { body } = await call(`/teg/headshots/preview?skip=${skip}`);
          if (!body || body.error) throw new Error((body && body.error) || 'No answer.');
          const fresh = (body.rows || []).filter((r) => { const k = r.email || r.name; if (seen.has(k)) return false; seen.add(k); return true; });
          rows.push(...fresh);
          if (!fresh.length || (body.page || 0) < 20) break;
        }
      } catch (err) { say(err.message, 'is-err'); btn.disabled = false; return; }
      btn.disabled = false;
      LAST_PREVIEW = rows;
      const go = rows.filter((r) => r.action !== 'skip');
      const skipped = rows.filter((r) => r.action === 'skip');
      const reasons = {}; skipped.forEach((r) => { reasons[r.why] = (reasons[r.why] || 0) + 1; });
      const fresh = go.filter((r) => r.action === 'import');
      say(`${rows.length} TEG people looked at: ${go.length} ready, of whom ${fresh.length} new.`, 'is-ok');
      /* Choose who to import: New (not already holding a TEG photo) is
         picked to start, so a re-run only brings in what's changed; All, or
         any one person whose photo has changed (Danielle, 1 Oct 2026). */
      const picked = new Set(fresh.map((r) => r.email));
      let q = '';
      out.innerHTML = `
        <div class="teg-sum"><div class="teg-stat"><b>${go.length}</b><span>Ready to import</span></div><div class="teg-stat"><b>${fresh.length}</b><span>Of those, new</span></div>${Object.entries(reasons).sort((a, b) => b[1] - a[1]).map(([w, n]) => `<div class="teg-stat"><b>${n}</b><span>${esc(w)}</span></div>`).join('')}</div>
        <p class="teg-note">Only background-free pictures, for people in our CRM with a profile for that brand. A photo someone at TMKE set by hand is never replaced. Each one is copied into our own storage.</p>
        <input type="search" class="teg-q" id="teg-imp-q" placeholder="Find someone in either list, e.g. McMahon">
        <div id="teg-imp-lists"></div>`;
      const thumb = (r) => r.photo ? `<span class="teg-thumb" style="background-image:url('${esc(r.photo)}')"></span>` : '';
      const what = (r) => IMPORT_WHY[r.action] + ((r.also || []).length ? `, and on their ${r.also.join(' and ')} profile` : '') + (r.matched_by ? ` (matched by ${r.matched_by})` : '');
      const draw = () => {
        const m = (r) => !q || (r.name + ' ' + r.email).toLowerCase().includes(q);
        const g = go.filter(m), sk = skipped.filter(m);
        document.getElementById('teg-imp-lists').innerHTML = `
          ${go.length ? `<details open style="margin-top:14px"><summary class="teg-note" style="cursor:pointer"><strong>Ready to import · ${go.length}</strong></summary>
            <div class="teg-pick">Select: <button type="button" data-pick="all">All</button> · <button type="button" data-pick="new">New</button> · <button type="button" data-pick="none">None</button>
              <button type="button" class="admin-btn admin-btn-primary" id="teg-imp-go" ${picked.size ? '' : 'disabled'}>Import ${picked.size} selected</button> <span class="teg-status" id="teg-imp-st"></span></div>
            <div class="teg-tablewrap"><table class="teg-table"><thead><tr><th></th><th></th><th>Name</th><th>Brand</th><th>Email</th><th>What happens</th></tr></thead><tbody>${g.map((r) => `<tr><td><input type="checkbox" data-tick="${esc(r.email)}" ${picked.has(r.email) ? 'checked' : ''} aria-label="Import ${esc(r.name)}"></td><td>${thumb(r)}</td><td>${esc(r.name)}</td><td>${esc(r.brand)}</td><td>${esc(r.email)}</td><td>${esc(what(r))}</td></tr>`).join('') || '<tr><td colspan="6">Nobody matches.</td></tr>'}</tbody></table></div></details>` : ''}
          ${skipped.length ? `<details ${q ? 'open' : ''} style="margin-top:14px"><summary class="teg-note" style="cursor:pointer"><strong>Not imported · ${skipped.length}</strong></summary>
            <div class="teg-tablewrap"><table class="teg-table"><thead><tr><th></th><th>Name</th><th>Brand</th><th>Email</th><th>Why</th></tr></thead><tbody>${sk.map((r) => `<tr><td>${thumb(r)}</td><td>${esc(r.name)}</td><td>${esc(r.brand)}</td><td>${esc(r.email)}</td><td>${esc(r.why)}</td></tr>`).join('') || '<tr><td colspan="5">Nobody matches.</td></tr>'}</tbody></table></div></details>` : ''}`;
        const host = document.getElementById('teg-imp-lists');
        host.querySelectorAll('[data-tick]').forEach((c) => c.addEventListener('change', () => { c.checked ? picked.add(c.dataset.tick) : picked.delete(c.dataset.tick); draw(); }));
        host.querySelectorAll('[data-pick]').forEach((b) => b.addEventListener('click', () => {
          picked.clear();
          if (b.dataset.pick === 'all') go.forEach((r) => picked.add(r.email));
          if (b.dataset.pick === 'new') fresh.forEach((r) => picked.add(r.email));
          draw();
        }));
        document.getElementById('teg-imp-go')?.addEventListener('click', runImport);
      };
      const runImport = async (e) => {
        const list = go.filter((r) => picked.has(r.email));
        if (!list.length || !confirm(`Import ${list.length} headshot${list.length === 1 ? '' : 's'} as brand photos? Nothing at TEG changes.`)) return;
        const b = e.target, st = document.getElementById('teg-imp-st'); b.disabled = true;
        let done = 0, skippedN = 0; const failed = [];
        for (const r of list) {
          st.textContent = `Importing ${done + skippedN + failed.length + 1} of ${list.length}…`;
          try {
            const { data } = await supabase.auth.getSession();
            const res = await fetch(WORKER + '/teg/headshots/import', { method: 'POST', headers: { Authorization: 'Bearer ' + data?.session?.access_token, 'Content-Type': 'application/json' }, body: JSON.stringify({ email: r.email }) });
            const j = await res.json().catch(() => ({}));
            if (res.ok && j.ok) done++; else if (res.ok && j.skipped) skippedN++; else failed.push(`${r.name}: ${j.error || res.status}`);
          } catch (err) { failed.push(`${r.name}: ${err.message}`); }
        }
        st.textContent = `Done: ${done} imported${skippedN ? `, ${skippedN} skipped` : ''}${failed.length ? `, ${failed.length} failed` : ''}. Run the preview again to refresh the lists.`;
        st.className = 'teg-status ' + (failed.length ? 'is-err' : 'is-ok');
        if (failed.length) out.insertAdjacentHTML('beforeend', `<div class="teg-raw">${esc(failed.join('\n'))}</div>`);
      };
      document.getElementById('teg-imp-q').addEventListener('input', (e) => { q = e.target.value.trim().toLowerCase(); draw(); });
      draw();
    });

    /* ---- Team Hub export → our CRM (Danielle, 1 Oct 2026) ------------------
       She exports the Team Hub as CSV and picks it here. The file is read in
       the browser and only the columns below are sent on: no home address,
       personal email or personal phone ever leaves this page. The Worker
       compares it with our contacts; nothing changes until Apply. */
    const ROSTER_FOCUS = ['The Property Experts', 'Prestige Property Experts', 'The Letting Experts'];
    const ROSTER_COLS = {
      'First Name': 'first_name', 'Last Name': 'last_name', 'Email': 'email', 'Person Type': 'person_type', 'Status': 'status',
      'Job Title': 'job_title', 'Primary Brand': 'primary_brand', 'Sub Brands': 'sub_brands', 'Location': 'location',
      'TRE Location': 'tre_location', 'Business Mobile': 'mobile',
      'Date Compliant': 'date_compliant', 'Date Launched': 'date_launched', 'Leave Date': 'leave_date',
    };
    function parseCsv(text) {
      const rows = []; let row = [], cell = '', q = false;
      text = text.replace(/^﻿/, '');
      for (let i = 0; i < text.length; i++) {
        const ch = text[i];
        if (q) { if (ch === '"') { if (text[i + 1] === '"') { cell += '"'; i++; } else q = false; } else cell += ch; continue; }
        if (ch === '"') q = true;
        else if (ch === ',') { row.push(cell); cell = ''; }
        else if (ch === '\n' || ch === '\r') { if (ch === '\r' && text[i + 1] === '\n') i++; row.push(cell); rows.push(row); row = []; cell = ''; }
        else cell += ch;
      }
      if (cell || row.length) { row.push(cell); rows.push(row); }
      const head = (rows.shift() || []).map((h) => h.trim());
      return rows.filter((r) => r.some((c) => c.trim())).map((r) => {
        const o = {};
        head.forEach((h, i) => { if (ROSTER_COLS[h]) o[ROSTER_COLS[h]] = String(r[i] || '').trim(); });
        // From the home address, the postcode only; the rest never leaves this page.
        const hi = head.indexOf('Home Address');
        const pc = hi >= 0 && String(r[hi] || '').toUpperCase().match(/\b([A-Z]{1,2}\d[A-Z\d]?)\s*(\d[A-Z]{2})\b/);
        if (pc) o.home_postcode = pc[1] + ' ' + pc[2];
        return o;
      });
    }
    const rosterBrands = (t) => [t.primary_brand, ...String(t.sub_brands || '').split(/[;,]/)].map((x) => String(x || '').trim()).filter((b) => ROSTER_FOCUS.includes(b));
    async function post(pathname, payload) {
      const { data } = await supabase.auth.getSession();
      const res = await fetch(WORKER + pathname, { method: 'POST', headers: { Authorization: 'Bearer ' + data?.session?.access_token, 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      return { status: res.status, body: await res.json().catch(() => null) };
    }
    const FIELD_NAMES = { job_title: 'Job title', date_joined: 'Joined', postcode: 'Postcode', area: 'Area', email: 'Brand email', phone: 'Work mobile' };
    const fillList = (f, keys) => (keys || Object.keys(f || {})).filter((k) => f[k]).map((k) => `<span class="teg-fill"><b>${FIELD_NAMES[k] || k}:</b> ${esc(f[k])}</span>`).join('');

    /* ---- The Team Hub check --------------------------------------------- */
    const rc = document.getElementById('rc-out');
    const rcSay = (m, cls) => { const el = document.getElementById('rc-status'); el.textContent = m || ''; el.className = 'teg-status' + (cls ? ' ' + cls : ''); };
    const when = (iso) => new Date(iso).toLocaleString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
    const day = (iso) => iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';
    const brandPills = (bs) => (bs || []).filter(Boolean).map((b) => `<span class="teg-pill">${esc(b)}</span>`).join('');
    // Their statuses, by what they mean for us.
    const statusPill = (st) => {
      const v = String(st || '').trim();
      if (!v) return '<span class="rc-status">No status</span>';
      const tone = /^(trading|active|onboarded)$/i.test(v) ? 'is-live' : /^(departed|removed from the team hub|\(removed from the team hub\))$/i.test(v) ? 'is-gone' : /^(pre compliant|onboarding|on hold|on leave)$/i.test(v) ? 'is-wait' : '';
      return `<span class="rc-status ${tone}">${esc(v.replace(/^\(|\)$/g, ''))}</span>`;
    };

    async function lastRun() {
      try {
        const { data, error } = await supabase.from('teg_roster_runs').select('run_at, run_by, counts').order('run_at', { ascending: false }).limit(1);
        const el = document.getElementById('rc-last');
        if (error) { el.textContent = 'Run supabase/teg_roster_check.sql once so the check can remember what it saw and spot changes.'; return; }
        const r = data && data[0];
        el.textContent = r ? `Last checked ${when(r.run_at)}${r.run_by === 'monthly check' ? ' (the monthly check)' : r.run_by ? ` by ${r.run_by}` : ''}.` : 'Not run yet.';
      } catch (_) {}
    }

    /* Where a new joiner is in their onboarding, from the Team Hub's own
       fields: signed, compliant, training, and the start date (to come, or
       gone by). A blank on the Team Hub shows as not yet. */
    function progressCell(p) {
      if (!p) return '—';
      const today = new Date().toISOString().slice(0, 10);
      const line = (ok, text) => `<span class="rc-prog ${ok ? 'is-yes' : 'is-no'}">${esc(text)}</span>`;
      return `<div class="rc-progs">
        ${line(!!p.signed, p.signed ? `Signed ${day(p.signed)}` : 'Not signed yet')}
        ${line(!!(p.compliant || p.compliance_ok), p.compliant ? `Compliant ${day(p.compliant)}` : p.compliance_ok ? 'Compliance checked' : 'Not compliant yet')}
        ${line(p.training === true, p.training === true ? 'Training done' : 'Training not done')}
        ${line(!!p.start && p.start <= today, p.start ? (p.start <= today ? `Started ${day(p.start)}` : `Starts ${day(p.start)}`) : 'No start date')}
      </div>`;
    }

    let CHECK = null;          // the last result, redrawn as things are done
    const DONE = new Map();    // row key -> what was done to it ("Added", "Removed", …)

    async function runCheck() {
      const b = document.getElementById('rc-run'); b.disabled = true;
      rc.innerHTML = '';
      rcSay('Reading the Team Hub and our CRM…');
      const { body } = await post('/teg/roster/live', {});
      b.disabled = false;
      if (!body || body.error) { rcSay((body && body.error) || 'No answer from our Worker.', 'is-err'); return; }
      CHECK = body; DONE.clear(); drawCheck.pick = null;
      rcSay(`Checked ${when(body.checked_at)}: ${body.total_on_team_hub} people on the Team Hub, ${body.counted} live at The Property Experts, Prestige and The Letting Experts.`, 'is-ok');
      lastRun();
      drawCheck();
    }
    document.getElementById('rc-run').addEventListener('click', runCheck);

    function drawCheck() {
      const d = CHECK; if (!d) return;
      const starters = d.starters || [], updates = d.updates || [], changes = d.changes || [];
      const left = (d.leavers || []).filter((l) => l.kind === 'left'), missing = (d.leavers || []).filter((l) => l.kind !== 'left');
      // The boxes are tabs: one section at a time, the report being long.
      const TAB = drawCheck.tab || (drawCheck.tab = 'joiners');
      const stat = (key, n, label) => `<button type="button" class="teg-stat rc-tab${TAB === key ? ' is-on' : ''}" data-tab="${key}" aria-pressed="${TAB === key}"><b>${n}</b><span>${label}</span></button>`;
      const table = (heads, body) => `<div class="teg-tablewrap"><table class="teg-table"><thead><tr>${heads.map((h) => `<th>${h}</th>`).join('')}</tr></thead><tbody>${body}</tbody></table></div>`;
      const sec = (key, title, n, note, inner, extra = '') => `<section class="rc-sec" data-sec="${key}"${TAB === key ? '' : ' hidden'}><div class="rc-sec-h"><h3>${title}</h3><span class="rc-n">${n}</span>${extra}</div>${note ? `<p class="teg-note">${note}</p>` : ''}${n ? inner : '<p class="rc-empty">None.</p>'}</section>`;
      const nameCell = (name, cid, email) => `${cid ? `<button type="button" class="rc-namebtn" data-card="${esc(cid)}">${esc(name)}</button>` : esc(name)}${email ? `<br><span style="color:rgba(28,29,34,0.5)">${esc(email)}</span>` : ''}`;
      const doneOr = (key, html) => DONE.has(key) ? `<span class="rc-done">${esc(DONE.get(key))}</span>` : html;
      const cardBtn = (cid) => cid ? `<button type="button" class="admin-btn admin-btn-ghost" data-card="${esc(cid)}">Contact card</button>` : '';
      const leaverActs = (l) => doneOr(l.key, `<div class="rc-acts">${cardBtn(l.contact_id)}<button type="button" class="admin-btn admin-btn-ghost" data-left="${esc(l.key)}">Mark as left</button><button type="button" class="admin-btn admin-btn-danger" data-remove="${esc(l.key)}">Remove from CRM</button></div>`);
      const fmtChange = (c) => c.field === 'Status' || c.field === 'Team Hub record'
        ? `<span class="rc-change"><b>${esc(c.field)}:</b> ${statusPill(c.old_value)}<span class="rc-arrow">&rarr;</span>${statusPill(c.new_value)}</span>`
        : `<span class="rc-change"><b>${esc(c.field)}:</b> <s>${esc(c.old_value || 'none')}</s><span class="rc-arrow">&rarr;</span>${esc(c.new_value || 'none')}</span>`;
      const openChanges = changes.filter((c) => !DONE.has('c:' + c.id));
      const pick = drawCheck.pick || (drawCheck.pick = new Set(updates.map((u) => 'u:' + u.key)));

      rc.innerHTML = `
        <div class="teg-sum" role="tablist" aria-label="Team Hub check">
          ${stat('joiners', starters.length, 'New joiners')}${stat('leavers', left.length, 'Leavers')}${stat('changes', openChanges.length, 'Changes')}${stat('missing', missing.length, 'Not on the Team Hub')}${stat('details', updates.length, 'Details to fill')}${stat('conflicts', (d.conflicts || []).length, "Doesn't agree")}${(d.returners || []).length ? stat('returners', d.returners.length, 'Left here, live there') : ''}${(d.mismatched || []).length ? stat('mismatched', d.mismatched.length, 'Different email') : ''}${(d.support || []).length ? stat('support', d.support.length, 'Support staff') : ''}
        </div>
        ${d.sql_needed ? `<p class="teg-note teg-flag">Changes can't be tracked yet: run supabase/teg_roster_check.sql in Supabase, then run the check again.</p>` : ''}

        ${sec('joiners', 'New joiners', starters.length, 'Partners at our three brands on the Team Hub who aren\'t in our CRM under their Team Hub email. Where they are comes from the Team Hub: its status doesn\'t record compliance or training, so those are shown on their own. If someone is already here under another email, It\'s them links the two so the next check matches them.',
          table(['Name', 'Brand', 'Team Hub status', 'Where they are', 'Check first', ''], starters.map((r) => `<tr>
            <td>${nameCell(r.name, DONE.has('s:' + r.key) ? DONE.get('s:' + r.key + ':id') : null, r.email)}${r.job_title ? `<br><span style="color:rgba(28,29,34,0.5)">${esc(r.job_title)}</span>` : ''}</td><td>${brandPills(r.brands)}</td><td>${statusPill(r.status)}</td>
            <td>${progressCell(r.progress)}</td>
            <td class="teg-flag">${esc(r.maybe)}${r.twin_id ? `<div class="rc-acts rc-acts-l"><button type="button" class="rc-link" data-card="${esc(r.twin_id)}">Open theirs</button>${DONE.has('s:' + r.key) ? '' : `<button type="button" class="rc-link" data-link="${esc(r.key)}">It's them</button>`}</div>` : ''}</td>
            <td>${doneOr('s:' + r.key, `<div class="rc-acts"><button type="button" class="admin-btn admin-btn-primary" data-add="${esc(r.key)}">Add to CRM</button></div>`)}</td></tr>`).join('')))}

        ${sec('leavers', 'Leavers', left.length, 'In our CRM at these brands, and the Team Hub says they\'ve left. Remove takes them out of the CRM altogether; Mark as left keeps their card and marks them as left at that brand.',
          table(['Name', 'Brand', 'Job title', 'Team Hub status', 'Leave date', ''], left.map((l) => `<tr><td>${nameCell(l.name, l.contact_id, l.email)}</td><td>${brandPills([l.brand])}</td><td>${esc(l.job_title || '—')}</td><td>${statusPill(l.teg_status)}</td><td>${l.left_at ? esc(day(l.left_at)) : '<span style="color:rgba(28,29,34,0.5)">Not set on the Team Hub</span>'}</td><td>${leaverActs(l)}</td></tr>`).join('')))}

        ${sec('changes', 'Changes since the last check', openChanges.length,
          d.baseline ? 'This was the first check, so there was nothing to compare with. Today\'s statuses are saved, and changes will show from the next check.' : 'Status, brand, job title or person type, as the Team Hub has them now. Each stays here until you mark it done.',
          table(['Name', 'Brand', 'What changed', 'Spotted', ''], openChanges.map((c) => `<tr><td>${nameCell(c.name || c.email, c.contact_id, c.contact_id ? '' : 'Not in our CRM')}</td><td>${brandPills(String(c.brand || '').split(', '))}</td><td>${fmtChange(c)}</td><td>${esc(day(c.detected_at))}</td>
            <td><div class="rc-acts">${cardBtn(c.contact_id)}<button type="button" class="admin-btn admin-btn-ghost" data-cdone="${esc(c.id)}">Done</button></div></td></tr>`).join('')),
          openChanges.length > 1 ? `<button type="button" class="rc-link" id="rc-cdone-all">Mark all done</button>` : '')}

        ${sec('missing', 'In our CRM, not on the Team Hub', missing.length, 'Not found on the Team Hub at all. That can be a leaver, or just a different email or name there, so check before removing anyone. Anyone who looks to be there under another name is noted.',
          table(['Name', 'Brand', 'Job title', 'Still live?', ''], missing.map((l) => `<tr><td>${nameCell(l.name, l.contact_id, l.email)}</td><td>${brandPills([l.brand])}</td><td>${esc(l.job_title || '—')}</td><td class="teg-flag">${esc(l.live || '')}</td><td>${leaverActs(l)}</td></tr>`).join('')))}

        ${sec('details', 'Details to fill for people we have', updates.length, 'Blanks on their brand profile the Team Hub can fill. Only blanks: where we already hold something different, it\'s under Doesn\'t agree and left alone.',
          `<div class="teg-pick"><button type="button" class="admin-btn admin-btn-primary" id="teg-ro-go" ${pick.size ? '' : 'disabled'}>Fill ${pick.size} selected</button> <span class="teg-status" id="teg-ro-st"></span></div>`
          + table(['', 'Name', 'Brand', 'What fills in'], updates.map((u) => `<tr><td>${DONE.has('u:' + u.key) ? '<span class="rc-done">Filled</span>' : `<input type="checkbox" data-rk="u:${esc(u.key)}" ${pick.has('u:' + u.key) ? 'checked' : ''} aria-label="Fill ${esc(u.name)}">`}</td><td>${nameCell(u.name, u.contact_id)}</td><td>${brandPills([u.brand])}${u.kind === 'add_profile' ? '<span class="teg-pill is-add">+ new brand profile</span>' : ''}</td><td>${fillList(u.fields, u.changes)}</td></tr>`).join('')))}

        ${sec('conflicts', "Doesn't agree", (d.conflicts || []).length, 'Where the Team Hub and our records say different things, or the Team Hub contradicts itself. Flagged only: nothing changes.',
          table(['Name', 'Brand', 'What', 'Ours', 'Team Hub', ''], (d.conflicts || []).map((r) => `<tr><td>${nameCell(r.name, r.contact_id)}</td><td>${r.brand ? brandPills(r.brand.split(', ')) : ''}</td><td>${esc(r.what)}</td><td>${esc(r.ours || '—')}</td><td>${esc(r.theirs)}</td><td class="teg-flag">${esc(r.why)}</td></tr>`).join('')))}

        ${(d.returners || []).length ? sec('returners', 'Marked as left here, but live on the Team Hub', d.returners.length, '', table(['Name', 'Brand', 'We marked them left'], d.returners.map((r) => `<tr><td>${nameCell(r.name, r.contact_id, r.email)}</td><td>${brandPills([r.brand])}</td><td>${esc(r.left_at)}</td></tr>`).join(''))) : ''}
        ${(d.mismatched || []).length ? sec('mismatched', 'Matched under a different email', d.mismatched.length, 'Found by name, or by the same address at another brand.', table(['Name', 'Team Hub email', 'Our email', 'Matched by'], d.mismatched.map((r) => `<tr><td>${nameCell(r.name, r.contact_id)}</td><td>${esc(r.teg_email)}</td><td>${esc(r.our_email)}</td><td>${esc(r.by)}</td></tr>`).join(''))) : ''}
        ${(d.support || []).length ? sec('support', 'Support staff not in our CRM', d.support.length, 'Listed only.', table(['Name', 'Brand', 'Email', 'Job title'], d.support.map((r) => `<tr><td>${esc(r.name)}</td><td>${brandPills(r.brands)}</td><td>${esc(r.email)}</td><td>${esc(r.job_title)}</td></tr>`).join(''))) : ''}`;

      rc.querySelectorAll('[data-rk]').forEach((c) => c.addEventListener('change', () => { c.checked ? pick.add(c.dataset.rk) : pick.delete(c.dataset.rk); const b = document.getElementById('teg-ro-go'); b.textContent = `Fill ${pick.size} selected`; b.disabled = !pick.size; }));
      document.getElementById('teg-ro-go')?.addEventListener('click', fillSelected);
      document.getElementById('rc-cdone-all')?.addEventListener('click', () => changesDone(openChanges.map((c) => c.id)));
    }

    // One listener for every button the check draws.
    rc.addEventListener('click', async (e) => {
      const t = e.target.closest('button'); if (!t || !CHECK) return;
      if (t.dataset.tab) { drawCheck.tab = t.dataset.tab; drawCheck(); return; }
      if (t.dataset.card) { openCard(t.dataset.card); return; }
      if (t.dataset.add) { openAdd((CHECK.starters || []).find((r) => r.key === t.dataset.add)); return; }
      if (t.dataset.cdone) { changesDone([t.dataset.cdone]); return; }
      if (t.dataset.link) {
        const r = (CHECK.starters || []).find((x) => x.key === t.dataset.link);
        if (!r || !r.twin_id) return;
        if (!confirm(`Link ${r.name} on the Team Hub to the contact already in our CRM?\n\nTheir Team Hub email (${r.email}) goes on that contact, and any brand they don't have yet is added, so the next check matches them. Nothing on the Team Hub changes.`)) return;
        t.disabled = true;
        const key = 's:' + r.key;
        const { body } = await post('/teg/roster/apply', { actions: [{ kind: 'link', key, contact_id: r.twin_id, email: r.email, brands: r.brands, fields: r.fields }] });
        if (!body || !(body.done || []).includes(key)) { t.disabled = false; alert("Couldn't link them: " + ((body && body.failed && body.failed[0] && body.failed[0].error) || (body && body.error) || 'no answer')); return; }
        DONE.set(key, 'Linked'); DONE.set(key + ':id', r.twin_id); drawCheck();
        return;
      }
      const l = (CHECK.leavers || []).find((x) => x.key === (t.dataset.left || t.dataset.remove));
      if (!l) return;
      if (t.dataset.left) {
        if (!confirm(`Mark ${l.name} as left at ${l.brand}${l.left_at ? ` on ${l.left_at}` : ' today'}? Their contact card stays.`)) return;
        t.disabled = true;
        const { body } = await post('/teg/roster/apply', { actions: [{ kind: 'left', key: l.key, contact_id: l.contact_id, brand: l.brand, left_at: l.left_at }] });
        if (!body || (body.failed || []).length || !(body.done || []).length) { t.disabled = false; alert("Couldn't save that: " + ((body && body.failed && body.failed[0] && body.failed[0].error) || (body && body.error) || 'no answer')); return; }
        DONE.set(l.key, 'Marked as left'); drawCheck();
      } else {
        if (!confirm(`Remove ${l.name} from the CRM?\n\nThis deletes their contact card, brand profiles, notes, tasks and automation enrolments. Their bookings, orders and email history stay. It can't be undone.`)) return;
        t.disabled = true;
        const { error } = await supabase.from('contacts').delete().eq('id', l.contact_id);
        if (error) { t.disabled = false; alert("Couldn't remove them: " + error.message); return; }
        // Every row for the same person goes with them.
        (CHECK.leavers || []).filter((x) => x.contact_id === l.contact_id).forEach((x) => DONE.set(x.key, 'Removed'));
        drawCheck();
      }
    });

    async function changesDone(ids) {
      if (!ids.length) return;
      const { body } = await post('/teg/roster/changes/done', { ids });
      if (!body || !body.ok) { alert("Couldn't mark that done: " + ((body && body.error) || 'no answer')); return; }
      ids.forEach((id) => DONE.set('c:' + id, 'Done'));
      drawCheck();
    }

    async function fillSelected(e) {
      const pick = drawCheck.pick;
      const actions = (CHECK.updates || []).filter((u) => pick.has('u:' + u.key) && !DONE.has('u:' + u.key)).map((u) => ({ ...u, key: 'u:' + u.key }));
      if (!actions.length || !confirm(`Fill in details on ${actions.length} brand profile${actions.length === 1 ? '' : 's'}? Only blanks are filled. Nothing on the Team Hub changes.`)) return;
      const b = e.target, st = document.getElementById('teg-ro-st'); b.disabled = true;
      const failed = [];
      for (let i = 0; i < actions.length; i += 10) {
        st.textContent = `Saving ${Math.min(i + 10, actions.length)} of ${actions.length}…`;
        const { body } = await post('/teg/roster/apply', { actions: actions.slice(i, i + 10) });
        if (!body || body.error) { failed.push(...actions.slice(i, i + 10).map((a) => `${a.name}: ${(body && body.error) || 'no answer'}`)); continue; }
        (body.done || []).forEach((k) => { DONE.set(k, 'Filled'); pick.delete(k); });
        (body.failed || []).forEach((f) => { const a = actions.find((x) => x.key === f.key); failed.push(`${a ? a.name : f.key}: ${f.error}`); });
      }
      drawCheck();
      if (failed.length) rc.insertAdjacentHTML('beforeend', `<div class="teg-raw">${esc(failed.join('\n'))}</div>`);
    }

    // ---- Add a new joiner: their Team Hub details in a form, to check first.
    const addBox = document.getElementById('rc-add');
    let adding = null;
    const $v = (id) => document.getElementById(id);
    function openAdd(r) {
      if (!r) return;
      adding = r;
      const f = r.fields || {};
      $v('rc-a-first').value = r.first_name || r.name.split(' ')[0] || '';
      $v('rc-a-last').value = r.last_name || r.name.split(' ').slice(1).join(' ') || '';
      $v('rc-a-email').value = r.email || '';
      $v('rc-a-phone').value = f.phone || '';
      $v('rc-a-job').value = f.job_title || r.job_title || '';
      $v('rc-a-area').value = f.area || '';
      $v('rc-a-pc').value = f.postcode || '';
      $v('rc-a-joined').value = f.date_joined || '';
      $v('rc-a-brands').innerHTML = ROSTER_FOCUS.map((b) => `<label><input type="checkbox" value="${esc(b)}" ${(r.brands || []).includes(b) ? 'checked' : ''}> ${esc(b)}</label>`).join('');
      $v('rc-a-err').hidden = true;
      addBox.hidden = false;
      setTimeout(() => $v('rc-a-first').focus(), 30);
    }
    addBox.addEventListener('click', (e) => { if (e.target.closest('[data-rc-close]')) addBox.hidden = true; });
    $v('rc-add-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      const err = (m) => { $v('rc-a-err').textContent = m; $v('rc-a-err').hidden = !m; };
      const email = $v('rc-a-email').value.trim().toLowerCase();
      const brands = [...$v('rc-a-brands').querySelectorAll('input:checked')].map((i) => i.value);
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { err('Add their work email.'); return; }
      if (!brands.length) { err('Tick at least one brand.'); return; }
      const key = 's:' + adding.key;
      const btn = $v('rc-a-save'); btn.disabled = true; btn.textContent = 'Adding…';
      const { body } = await post('/teg/roster/apply', { actions: [{
        kind: 'add', key, return_id: true, email, brands,
        first_name: $v('rc-a-first').value.trim(), last_name: $v('rc-a-last').value.trim(), name: `${$v('rc-a-first').value.trim()} ${$v('rc-a-last').value.trim()}`.trim(),
        fields: { phone: $v('rc-a-phone').value.trim() || null, job_title: $v('rc-a-job').value.trim() || null, area: $v('rc-a-area').value.trim() || null, postcode: $v('rc-a-pc').value.trim().toUpperCase() || null, date_joined: $v('rc-a-joined').value || null },
      }] });
      btn.disabled = false; btn.textContent = 'Add to CRM';
      if (!body || !(body.done || []).includes(key)) { err("Couldn't add them: " + ((body && body.failed && body.failed[0] && body.failed[0].error) || (body && body.error) || 'no answer')); return; }
      addBox.hidden = true;
      DONE.set(key, 'Added');
      if (body.created && body.created[key]) DONE.set(key + ':id', body.created[key]);
      drawCheck();
    });

    // ---- A contact card, popped out (the Contacts page's own, ?embed=1).
    const cardBox = document.getElementById('rc-card'), cardIf = document.getElementById('rc-card-if'), cardWait = document.getElementById('rc-card-wait');
    function openCard(id) {
      cardWait.textContent = 'Opening the contact card…'; cardWait.hidden = false;
      cardIf.hidden = true; cardBox.querySelector('.rc-card-x').hidden = false;
      cardIf.src = `/admin/contacts?contact=${encodeURIComponent(id)}&embed=1`;
      cardBox.hidden = false;
    }
    function closeCard() { cardBox.hidden = true; cardIf.removeAttribute('src'); }
    cardBox.addEventListener('click', (e) => { if (e.target.closest('[data-rc-close]')) closeCard(); });
    window.addEventListener('message', (e) => {
      if (e.origin !== location.origin || !e.data || cardBox.hidden) return;
      if (e.data.type === 'tmke-contact-ready') { cardWait.hidden = true; cardIf.hidden = false; cardBox.querySelector('.rc-card-x').hidden = true; }
      else if (e.data.type === 'tmke-contact-closed') closeCard();
      else if (e.data.type === 'tmke-contact-missing') cardWait.textContent = "That contact isn't in the CRM any more.";
    });
    document.addEventListener('keydown', (e) => { if (e.key !== 'Escape') return; if (!cardBox.hidden) closeCard(); else if (!addBox.hidden) addBox.hidden = true; });

    // The export, as a fallback when the Team Hub can't be reached: the same
    // comparison, without the changes (an export has no record ids to track).
    const rosterFile = document.getElementById('teg-roster-file');
    document.getElementById('teg-roster').addEventListener('click', () => { rosterFile.value = ''; rosterFile.click(); });
    rosterFile.addEventListener('change', async () => {
      const file = rosterFile.files && rosterFile.files[0];
      if (!file) return;
      rc.innerHTML = '';
      rcSay('Reading the export…');
      let rows;
      try { rows = parseCsv(await file.text()); } catch (err) { rcSay("Couldn't read that file as a CSV.", 'is-err'); return; }
      if (!rows.length || !('email' in rows[0]) || !('primary_brand' in rows[0])) { rcSay("That doesn't look like a Team Hub export: no Email or Primary Brand column.", 'is-err'); return; }
      const focus = rows.filter((t) => rosterBrands(t).length);
      rcSay(`Comparing ${focus.length} Team Hub people with our CRM…`);
      const { body } = await post('/teg/roster/preview', { rows: focus });
      if (!body || body.error) { rcSay((body && body.error) || 'No answer from our Worker.', 'is-err'); return; }
      CHECK = { ...body, changes: [], baseline: false, from_file: true }; DONE.clear(); drawCheck.pick = null;
      rcSay(`${body.counted} people live at our three brands in ${file.name}. Changes since the last check only show when the check reads the Team Hub itself.`, 'is-ok');
      drawCheck();
    });

    document.getElementById('teg-photos').addEventListener('click', async () => {
      out.innerHTML = '';
      say('Asking photoApi what it holds…');
      const { body } = await call('/teg/photos?limit=5');
      if (!body || body.error) { say((body && body.error) || "No answer.", 'is-err'); return; }
      say(`${body.count} records there${body.has_more ? ', and more after these' : ''}.`, 'is-ok');
      const list = (arr) => (arr || []).map((f) => `<span class="teg-pill">${esc(f)}</span>`).join('') || '—';
      out.innerHTML = `
        <div class="teg-sum">
          <div class="teg-stat"><b>${esc(body.count)}</b><span>Records</span></div>
          <div class="teg-stat"><b>${(body.fields || []).length}</b><span>Fields each</span></div>
          <div class="teg-stat"><b>${(body.looks_like_an_image || []).length}</b><span>Image-ish fields</span></div>
        </div>
        <p class="teg-note" style="margin-bottom:6px"><strong>Fields that look like a picture</strong></p>
        <div>${list(body.looks_like_an_image)}</div>
        <p class="teg-note" style="margin:16px 0 6px"><strong>Every field</strong></p>
        <div>${list(body.fields)}</div>
        <p class="teg-note" style="margin:16px 0 6px"><strong>One whole record</strong></p>
        <div class="teg-raw">${esc(JSON.stringify(body.sample, null, 2))}</div>`;
    });

    document.getElementById('teg-dry').addEventListener('click', async () => {
      out.innerHTML = '';
      say('Reading both rosters…');
      const { body } = await call('/teg/preview?limit=500');
      if (!body || !body.ok) {
        say((body && body.error) || "That didn't run.", 'is-err');
        if (body) out.innerHTML = '<div class="teg-raw">' + esc(JSON.stringify(body, null, 2)) + '</div>';
        return;
      }
      say(`Read ${body.counted} of their people. Nothing was changed.`, 'is-ok');
      const stat = (n, label) => `<div class="teg-stat"><b>${n}</b><span>${label}</span></div>`;
      const rows = (body.preview || []).map((p) => `
        <tr>
          <td>${esc(p.name)}<br><span style="color:rgba(28,29,34,0.5)">${esc(p.email)}</span></td>
          <td>${p.match === 'in our CRM' ? 'In our CRM' : '<span class="teg-new">New — no contact</span>'}</td>
          <td>${(p.brands_theirs || []).map((b) => `<span class="teg-pill">${esc(b)}</span>`).join('') || '—'}</td>
          <td>${(p.brands_to_add || []).map((b) => `<span class="teg-pill is-add">+ ${esc(b)}</span>`).join('') || '—'}</td>
          <td>${esc(p.job_title) || '—'}</td>
          <td>${(p.postcodes || []).join(', ') || '—'}</td>
          <td>${p.leaver ? 'Left' : esc(p.status) || '—'}</td>
          <td>${p.photo_provided ? 'Yes' : '—'}</td>
        </tr>`).join('');
      out.innerHTML = `
        <div class="teg-sum">
          ${stat(body.counted, 'Their people')}
          ${stat(body.new_people, 'Not in our CRM')}
          ${stat(body.brand_rows_to_add, 'Brand rows to add')}
          ${stat(body.leavers, 'Marked as left')}
          ${stat(body.with_photo_flag, 'Photo on file')}
        </div>
        <div class="teg-tablewrap"><table class="teg-table">
          <thead><tr><th>Person</th><th>Match</th><th>Their brands</th><th>We would add</th><th>Job title</th><th>Postcodes</th><th>Status</th><th>Photo</th></tr></thead>
          <tbody>${rows}</tbody>
        </table></div>`;
    });

    (async () => {
      if (!import.meta.env.DEV) { const s = await requireAdmin(); if (!s) return; }
      if (!WORKER) say('The Worker URL is not set in this build.', 'is-err');
      lastRun();
      // From the monthly notification: run it straight away.
      if (new URLSearchParams(location.search).get('check') === '1') runCheck();
    })();
  </script>
</AdminShell>
