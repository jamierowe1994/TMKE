---
// Our services in one place (Danielle, 29 Oct 2026): for TEG members and
// external clients alike, so nothing on it names TEG. Not in the menu: a link
// the team sends, so people see everything we do without moving through each
// section of the site.
//
// In order, as Danielle laid it out:
//   1. Four slides, one per shoot. A picture fills the screen with another
//      in a rectangle at its centre, the name at the rectangle's bottom left.
//      Scrolling lifts the background and drops the rectangle at the same
//      time, revealing the next slide underneath.
//   2. Every service as a plain numbered list on white, a row opening to its
//      summary and links.
//   3. A field of our work, small pictures rising into place as they come up
//      the screen, with 4. the services brochure in its first screen.
//   5. Get in touch in a rounded picture box, the form in a pop-out.
//
// Headings are the site's own, Fraunces Light at -5% (Danielle, 29 Oct).
// Prices are the site's standard "from" rates; each person's own rate is worked
// out when they book. Pictures are stand-ins from the site until she chooses.
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import VideographyBooking from "../components/VideographyBooking.astro";
import SMMForms from "../components/SMMForms.astro";
import ContactForm from "../components/ContactForm.astro";
import { getProduct, tierPrice } from "../data/videography.js";
import { PHOTOGRAPHY } from "../lib/videography-config.js";
import { SOCIAL_SERVICES, SOCIAL_EXTRAS } from "../lib/smm-config.js";
import { gbpFromPence } from "../lib/supabase.js";

const pic = async (src, width, height) =>
  (await getImage({ src, width, height, quality: 76, format: "webp" })).src;
const A = (path) => `https://assets.tmke.co.uk/${path}`;
const from = (pence, unit) => `From ${gbpFromPence(pence)} +VAT${unit ? ` /${unit}` : ""}`;

const studio = getProduct("studio");
const property = getProduct("property");
const agent = getProduct("agent");

// 1. The slides: a background and a rectangle picture for each shoot.
const SLIDES = [
  { name: "Content Studio", line: "Weeks of short-form content from one studio session.", bg: A("Jack%20-%20headshots/Content%20Studio/2.png"), card: A("Jack%20-%20headshots/Content%20Studio/1.png") },
  { name: "Property Photography", line: "Portal-ready photography, including drone.", bg: A("Jack%20-%20headshots/Property/FC2-9%20(1).jpg"), card: A("Jack%20-%20headshots/Property/FC2-13%20(1).jpg") },
  { name: "Property Videography", line: "Presenter-led tours, drone, 360 and reels.", bg: A("Jack%20-%20headshots/Property/CV311WHCompressed21%20(1).jpg"), card: A("Jack%20-%20headshots/Property/CV311WHCompressed8.jpg") },
  { name: "Agent Media", line: "Video and photography built around you.", bg: A("Jack%20-%20headshots/Agent/EMay-61.jpg"), card: A("Jack%20-%20headshots/Agent/DonnaPlumb-19.jpg") },
];
for (const s of SLIDES) {
  s.bg = await pic(s.bg, 1920, 1200);
  s.card = await pic(s.card, 760, 1013);
}

// 2. Every service, as the brochure names and describes them. A shoot opens
// the booking pop-out at itself; the rest go to their page or to the form.
const SERVICES = [
  { group: "Videography", name: "Content Studio", body: "Batch-create weeks of short-form content in one professionally filmed studio session.", price: from(tierPrice(studio.priceTiers[0], "direct")), list: studio.included, book: "content-studio", bookLabel: "Book a session", more: "/videography#studio" },
  { group: "Videography", name: "Property Photography", body: "Professional property photography, naturally edited and ready to use across portals, socials and your wider marketing.", price: from(PHOTOGRAPHY.packages[0].member_pence), list: PHOTOGRAPHY.packages.map((pk) => `${pk.name}, ${from(pk.member_pence).replace("From ", "from ")}`), book: "photography", bookLabel: "Book a shoot", more: "/videography" },
  { group: "Videography", name: "Property Videography", body: "Professionally filmed property tours, promotional videos and photography to help listings stand out.", price: from(tierPrice(property.priceTiers[0], "direct")), list: property.included.slice(0, 5), book: "property", bookLabel: "Book a shoot", more: "/videography#property" },
  { group: "Videography", name: "Agent Media", body: "On-location filming focused on creating engaging social media content.", price: from(tierPrice(agent.priceTiers[0], "direct")), list: agent.included, book: "agent", bookLabel: "Book a shoot", more: "/videography#agent" },
  // Not listed here: Profile Optimisation and Creative Design (Danielle, 29 Oct).
  ...[...SOCIAL_SERVICES, ...SOCIAL_EXTRAS].filter((s) => s.key !== "profile-optimisation").map((s) => ({
    group: "Social Media", name: s.name, body: s.summary, price: from(s.from_pence, s.unit),
    more: "/services",
  })),
  { group: "Creative", name: "Social Media Templates", body: "Professionally designed, editable social media template packs created exclusively for estate agents.", price: "£24 +VAT /pack", more: "/edit", moreLabel: "Shop the Edit" },
  { group: "Creative", name: "Website Development", body: "Beautiful, high-performing websites designed to showcase your brand and generate more enquiries.", price: "Price on request", ask: true },
  { group: "Creative", name: "Email Marketing", body: "Professional newsletters, campaigns and automations to keep your audience engaged and informed.", price: "Price on request", ask: true },
];

// 3. A field of our work between the services and the contact box, small
// pictures with room round them, each rising into place as it comes up the
// screen: a screen and a half with the brochure in its bottom right (A), then
// one more row (C).
// Each picture: left % of the width, width in vw, shape, and its top in vh
// from its band's top; `b` anchors to the band's foot instead.
const H = "Jack%20-%20headshots";
// Sizes and shapes vary, as Kettal's do, and a few run off the page's edge
// like the hero (Danielle, 30 Oct): x is % of the full width, so negative or
// past 100 bleeds.
const BAND_A = [
  { src: `${H}/Agent/EMay-61.jpg`, x: -3, y: 6, w: 13, r: "4/5" },
  { src: `${H}/Property/FC2-9%20(1).jpg`, x: 24, y: 14, w: 10, r: "13/10" },
  { src: `${H}/Content%20Studio/3.png`, x: 47, y: 2, w: 15, r: "4/5" },
  { src: "living-1.webp", x: 89, y: 10, w: 14, r: "3/4" },
  { src: `${H}/Agent/12-June-6.jpg`, x: 12, y: 46, w: 11, r: "1/1" },
  { src: "kitchen-1.webp", x: 36, y: 50, w: 16, r: "4/3" },
  { src: `${H}/Property/CV311WHCompressed21%20(1).jpg`, x: 70, y: 42, w: 12, r: "4/5" },
  { src: `${H}/Content%20Studio/4.png`, x: 58, y: 78, w: 9, r: "4/5" },
  { src: `${H}/Agent/AM-40.jpg`, x: -2, y: 86, w: 12, r: "3/4" },
  { src: `${H}/Property/LeahMusana-14.jpg`, x: 22, y: 100, w: 10, r: "4/5" },
  // Level with the foot of the brochure button (Danielle, 29 Oct).
  { src: "white-1.webp", x: 46, b: 15, w: 12, r: "13/10" },
];
// Band C carries Get in touch in its bottom left, so the pictures keep clear.
const BAND_C = [
  { src: "living-2.webp", x: 10, y: 4, w: 14, r: "4/3" },
  { src: `${H}/Content%20Studio/2.png`, x: 40, y: 12, w: 11, r: "4/5" },
  { src: `${H}/Agent/DonnaPlumb-19.jpg`, x: 66, y: 0, w: 13, r: "3/4" },
  { src: "orange-1.webp", x: 90, y: 34, w: 13, r: "1/1" },
  { src: `${H}/Property/CV311WHCompressed8.jpg`, x: 57, y: 52, w: 14, r: "13/10" },
  { src: "white-2.webp", x: 81, y: 70, w: 10, r: "4/5" },
];
for (const w of [...BAND_A, ...BAND_C]) {
  const [a, b] = w.r.split("/").map(Number);
  w.img = await pic(A(w.src), 640, Math.round((640 * b) / a));
}
const place = (w, unit) =>
  `left:${w.x}%;${w.b != null ? `bottom:${w.b}${unit}` : `top:${w.y}${unit}`};--w:${w.w};aspect-ratio:${w.r}`;


---

<BaseLayout
  title="Our Services — TMKE"
  description="Videography, photography, social media and creative from TMKE, with what each includes, what it costs and how to book."
  noindex
>

  <main class="os">
    <!-- 1. The slides. The first sits on top; each lifts and drops away in turn. -->
    <section class="os-slides" style={`--n:${SLIDES.length}`} aria-label="Our services">
      <div class="os-stage">
        {SLIDES.map((s, i) => (
          <div class="os-slide" style={`z-index:${SLIDES.length - i}`} data-slide={i}>
            <div class="os-slide-bg" style={`background-image:url('${s.bg}')`}></div>
            <figure class="os-slide-card">
              <img src={s.card} alt="" width="760" height="1013" loading={i === 0 ? "eager" : "lazy"} />
              <figcaption class="os-slide-cap">
                <span class="os-slide-num">{String(i + 1).padStart(2, "0")} / {String(SLIDES.length).padStart(2, "0")}</span>
                {i === 0 ? <h1 class="os-slide-name">{s.name}</h1> : <h2 class="os-slide-name">{s.name}</h2>}
                <span class="os-slide-line">{s.line}</span>
              </figcaption>
            </figure>
          </div>
        ))}
        <p class="os-slides-hint" aria-hidden="true">Scroll</p>
      </div>
    </section>

    <!-- 2. Every service, second, as a plain list on white (Danielle, 30 Oct).
         A row opens to its summary and links. -->
    <section class="os-list" id="services" aria-labelledby="os-list-h">
      <h2 class="os-list-label" id="os-list-h">Our services</h2>
      <p class="os-statement">Film, photography and content for estate agents, in one place.</p>
      <ol class="os-rows">
        {SERVICES.map((s, i) => (
          <li class="os-item">
            <button type="button" class="os-item-head" aria-expanded="false" aria-controls={`os-item-${i}`}>
              <span class="os-item-name">{s.name}<span class="os-item-num">({String(i + 1).padStart(2, "0")})</span></span>
              <span class="os-item-group">{s.group}</span>
              <span class="os-item-sign" aria-hidden="true"></span>
            </button>
            <div class="os-item-body" id={`os-item-${i}`}><div class="os-item-inner">
              <p class="os-item-text">{s.body}</p>
              {s.list && <p class="os-item-price">{s.price}</p>}
              {s.list && <ul class="os-item-list">{s.list.map((x) => <li>{x}</li>)}</ul>}
              <div class="os-item-links">
                {!s.list && <p class="os-item-price">{s.price}</p>}
                {s.book && <button type="button" class="os-btn" data-vbook={s.book}>{s.bookLabel} <span aria-hidden="true">&rarr;</span></button>}
                {s.more && <a class="os-link" href={s.more}>{s.moreLabel || "Discover more"} <span aria-hidden="true">&rsaquo;</span></a>}
                {s.ask && <button type="button" class="os-link" data-os-contact>Ask about this <span aria-hidden="true">&rsaquo;</span></button>}
              </div>
            </div></div>
          </li>
        ))}
      </ol>
      <p class="os-list-foot">For shoots on location, Jack covers a 40-mile radius of NN14 (Kettering). If you&rsquo;re further away, travel is added to your quote automatically.</p>
    </section>

    <!-- 3 + 4. A field of our work, the brochure in its first screen. -->
    <div class="os-field">
      <div class="os-band os-band--a" aria-label="Our work">
        {BAND_A.map((w) => <figure class="os-work-pic" style={place(w, "vh")}><img src={w.img} alt="" loading="lazy" /></figure>)}
        <div class="os-bro">
          <p class="os-bro-text">Our services brochure sets out everything we do in full, with what&rsquo;s included and what each service costs. Pop your details in and we&rsquo;ll email it straight over.</p>
          <button type="button" class="os-bro-btn" data-smm-form="brochure">Download the brochure</button>
        </div>
      </div>


      <div class="os-band os-band--c">
        {BAND_C.map((w) => <figure class="os-work-pic" style={place(w, "vh")}><img src={w.img} alt="" loading="lazy" /></figure>)}
        <!-- 5. Get in touch, worked into the field's last screen rather than a
             section of its own under a line (Danielle, 30 Oct). The form is a
             pop-out. -->
        <section class="os-touch" id="get-in-touch">
          <h2 class="os-list-label">Get in touch</h2>
          <p class="os-statement">Talk to us before you book.</p>
          <p class="os-touch-text">If you&rsquo;re not sure which service suits you, or you have a question about anything on this page, send us a message and it&rsquo;ll go straight to our team.</p>
          <div class="os-touch-links">
            <button type="button" class="os-bro-btn os-touch-btn" data-os-contact>Send us a message</button>
            <button type="button" class="os-link" data-vbook="discovery">Book a call with Jack <span aria-hidden="true">&rsaquo;</span></button>
          </div>
        </section>
      </div>
    </div>
  </main>

  <!-- The contact pop-out: the Contact page's form. -->
  <div class="os-pop" id="os-pop" hidden>
    <div class="os-pop-scrim" data-os-close></div>
    <div class="os-pop-card" role="dialog" aria-modal="true" aria-labelledby="os-pop-h" data-lenis-prevent>
      <button type="button" class="os-pop-x" data-os-close aria-label="Close">&times;</button>
      <p class="os-label">Get in touch</p>
      <h2 class="os-h" id="os-pop-h">Send Us a Message.</h2>
      <ContactForm source="videography_services_page" trackAs="services_page">
        <p class="os-jack">
          Prefer to speak to Jack directly? Email him at <a href="mailto:jack@tmke.co.uk">jack@tmke.co.uk</a> or
          <button type="button" class="os-jack-call" data-vbook="discovery">book a short call with him <span aria-hidden="true">&rsaquo;</span></button>
        </p>
      </ContactForm>
    </div>
  </div>

  <VideographyBooking />
  <SMMForms brochureLead="Everything we do, in one place. Download our services brochure for a full breakdown of what's included, how it works, and what it costs." />
</BaseLayout>

<script>
  const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const clamp = (v: number) => Math.max(0, Math.min(1, v));
  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);

  // 1. The slides: each one's scroll is a short hold, then the lift and drop.
  const slidesEl = document.querySelector<HTMLElement>(".os-slides");
  const slides = [...document.querySelectorAll<HTMLElement>(".os-slide")];
  const hint = document.querySelector<HTMLElement>(".os-slides-hint");
  function drawSlides() {
    if (!slidesEl) return;
    const vh = window.innerHeight;
    const per = (slidesEl.offsetHeight - vh) / Math.max(1, slides.length - 1);
    const y = -slidesEl.getBoundingClientRect().top;
    slides.forEach((s, i) => {
      if (i === slides.length - 1) return;
      const t = ease(clamp(((y - i * per) / per - 0.15) / 0.85));
      const bg = s.querySelector<HTMLElement>(".os-slide-bg");
      const card = s.querySelector<HTMLElement>(".os-slide-card");
      if (bg) bg.style.transform = `translate3d(0, ${-t * 100}%, 0)`;
      if (card) card.style.transform = `translate3d(-50%, calc(-50% + ${t * 100}vh), 0)`;
      s.style.visibility = t >= 1 ? "hidden" : "";
    });
    if (hint) hint.style.opacity = y > 40 ? "0" : "";
  }

  // 3. Our work: a picture rises into its frame as it comes up from the foot
  // of the screen, and is fully in by the time it is halfway up.
  const work = document.querySelector<HTMLElement>(".os-field");
  const pics = [...document.querySelectorAll<HTMLElement>(".os-work-pic")];
  function drawWork() {
    if (!work) return;
    const vh = window.innerHeight;
    const wr = work.getBoundingClientRect();
    if (wr.bottom < 0 || wr.top > vh) return;
    pics.forEach((el) => {
      const r = el.getBoundingClientRect();
      if (r.bottom < -vh || r.top > vh * 2) return;
      const q = ease(clamp((vh - r.top) / (vh * 0.5)));
      const img = el.firstElementChild as HTMLElement | null;
      if (img) img.style.transform = `translate3d(0, ${(1 - q) * 100}%, 0)`;
    });
  }

  // The nav: paper over a dark background, ink over a light one. Read from
  // whatever is painted under its middle, so new sections need no tagging.
  const nav = document.getElementById("nav");
  function drawNav() {
    if (!nav) return;
    const r = nav.getBoundingClientRect();
    const y = r.top + r.height / 2;
    let dark = false;
    for (const el of document.elementsFromPoint(window.innerWidth / 2, y)) {
      if (nav.contains(el)) continue;
      const bg = getComputedStyle(el).backgroundColor;
      const m = bg.match(/rgba?\(([\d.]+),\s*([\d.]+),\s*([\d.]+)(?:,\s*([\d.]+))?/);
      const img = getComputedStyle(el).backgroundImage;
      if (m && (m[4] === undefined || Number(m[4]) > 0.5)) {
        dark = 0.2126 * +m[1] + 0.7152 * +m[2] + 0.0722 * +m[3] < 140;
        break;
      }
      if (img && img !== "none") { dark = true; break; }
    }
    document.documentElement.classList.toggle("os-nav-paper", dark);
    // Past the hero the header goes, and only the menu stays (Danielle, 29-30 Oct).
    document.documentElement.style.setProperty("--os-nav-h", `${Math.round(r.height)}px`);
    const hero = document.querySelector(".os-slides");
    document.documentElement.classList.toggle("os-past-hero", !!hero && hero.getBoundingClientRect().bottom <= r.bottom + 1);
  }
  {
    let navQueued = false;
    const askNav = () => { if (!navQueued) { navQueued = true; requestAnimationFrame(() => { navQueued = false; drawNav(); }); } };
    window.addEventListener("scroll", askNav, { passive: true });
    window.addEventListener("resize", askNav);
    // A page opened part-way down (a reload, the back button) checks again
    // once it has its scroll position back.
    window.addEventListener("load", askNav);
    window.addEventListener("pageshow", askNav);
    drawNav();
  }

  if (!still) {
    document.documentElement.classList.add("os-moving");
    let queued = false;
    const frame = () => { queued = false; drawSlides(); drawWork(); };
    const ask = () => { if (!queued) { queued = true; requestAnimationFrame(frame); } };
    window.addEventListener("scroll", ask, { passive: true });
    window.addEventListener("resize", ask);
    frame();
  }

  // 2. The list: one row open at a time.
  const items = [...document.querySelectorAll<HTMLElement>(".os-item")];
  items.forEach((it) => {
    const head = it.querySelector<HTMLElement>(".os-item-head");
    head?.addEventListener("click", () => {
      const on = !it.classList.contains("is-open");
      items.forEach((o) => { o.classList.remove("is-open"); o.querySelector(".os-item-head")?.setAttribute("aria-expanded", "false"); });
      if (on) { it.classList.add("is-open"); head.setAttribute("aria-expanded", "true"); }
    });
  });

  // 5. The contact pop-out.
  const pop = document.getElementById("os-pop");
  let opener: HTMLElement | null = null;
  const openPop = (from: HTMLElement) => {
    if (!pop) return;
    opener = from;
    pop.hidden = false;
    requestAnimationFrame(() => pop.classList.add("is-open"));
    document.documentElement.style.overflow = "hidden";
    pop.querySelector<HTMLElement>("input")?.focus({ preventScroll: true });
  };
  const closePop = () => {
    if (!pop || pop.hidden) return;
    pop.classList.remove("is-open");
    document.documentElement.style.overflow = "";
    setTimeout(() => { pop.hidden = true; }, 300);
    opener?.focus({ preventScroll: true });
  };
  document.querySelectorAll<HTMLElement>("[data-os-contact]").forEach((b) => b.addEventListener("click", () => openPop(b)));
  pop?.querySelectorAll("[data-os-close]").forEach((b) => b.addEventListener("click", closePop));
  // A call booked from inside the pop-out: the booking slides in over it.
  pop?.querySelectorAll("[data-vbook]").forEach((b) => b.addEventListener("click", closePop));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closePop(); });
</script>

<style is:global>
  /* Over the hero a white header, as Kettal has, which also frames the
     slides smaller (Danielle, 30 Oct); past the hero it goes, leaving the
     menu, which turns paper over anything dark. */
  body:has(.os) .nav, body:has(.os) .nav.scrolled {
    background: transparent; backdrop-filter: none; -webkit-backdrop-filter: none;
    border-bottom-color: transparent; color: var(--ink);
    transition: background 0.3s ease, color 0.3s ease;
  }
  html:not(.os-past-hero) body:has(.os) .nav, html:not(.os-past-hero) body:has(.os) .nav.scrolled { background: #fff; color: var(--ink); }
  html:not(.os-past-hero) body:has(.os) .nav .nav-cta { color: var(--ink); border-color: currentColor; }
  html.os-past-hero.os-nav-paper body:has(.os) .nav { color: var(--paper); }
  body:has(.os) .nav .nav-logo, body:has(.os) .nav .nav-cta, body:has(.os) .nav .nav-links { transition: opacity 0.3s ease, visibility 0.3s ease; }
  html.os-past-hero body:has(.os) .nav .nav-logo,
  html.os-past-hero body:has(.os) .nav .nav-cta,
  html.os-past-hero body:has(.os) .nav .nav-links { opacity: 0; visibility: hidden; }

  /* Sizes from the site's shared scale in global.css: --fs-title for section
     titles, --fs-quote for the slide names, 11px labels; the list's names
     match the videography page's service names. Body copy matches the
     seasonal page's (.sn-feature-stand), as Danielle asked. */
  .os {
    --os-body: clamp(12.5px, 0.95vw, 13.5px);
    --hairline: rgba(28, 29, 34, 0.14);
    /* The site's heading face, Fraunces Light, at -5% (Danielle, 29 Oct). */
    --os-h: "TMKE Serif", Georgia, serif;
    --os-hw: 300;
    --os-track: -0.05em;
    background: var(--paper); color: var(--ink); font-family: var(--sans);
  }
  .os-label {
    margin: 0; font-family: var(--sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--english-violet);
  }
  .os-label--paper { color: rgba(244, 242, 241, 0.72); }
  .os-h {
    margin: 14px 0 16px; font-family: var(--os-h); font-weight: var(--os-hw);
    font-size: var(--fs-title); line-height: var(--lh-title); letter-spacing: var(--os-track); color: var(--english-violet);
  }

  /* ---- 1. The slides ---- */
  /* Still (reduced motion, or before the script runs): one slide after another. */
  .os-slides { position: relative; padding-top: var(--os-nav-h, 80px); background: #fff; }
  .os-slide { position: relative; height: calc(100svh - var(--os-nav-h, 80px)); overflow: hidden; }
  .os-slides-hint { display: none; }
  /* Moving: one screen held in place, the slides stacked in it. */
  .os-moving .os-slides { height: calc((var(--n) - 1) * 110vh + 100vh); }
  .os-moving .os-slides { padding-top: 0; }
  .os-moving .os-stage { position: sticky; top: var(--os-nav-h, 80px); height: calc(100svh - var(--os-nav-h, 80px)); overflow: hidden; }
  .os-moving .os-slide { position: absolute; inset: 0; height: auto; overflow: visible; }
  .os-moving .os-slides-hint { display: block; }
  .os-slide-bg {
    position: absolute; inset: 0; background-size: cover; background-position: center;
    background-color: #2a2228; will-change: transform;
  }
  .os-slide-bg::after { content: ""; position: absolute; inset: 0; background: rgba(20, 18, 22, 0.18); }
