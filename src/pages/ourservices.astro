---
// Our services in one place (Danielle, 29 Oct 2026): for TEG members and
// external clients alike, so nothing on it names TEG. Not in the menu: a link
// the team sends, so people see everything we do without moving through each
// section of the site.
//
// The opening is a split screen: words on the left, the four shoots as
// pictures on the right; choosing one swaps the left panel to it. Below, the
// brochure's Our Services page: Videography, Social Media, Creative, a line
// and a "from" price each. The four shoots keep what's included folded away and
// open the booking pop-out at that service; the rest go to their own page or
// to the form. Then the services brochure, then the form.
//
// Prices are the site's standard "from" rates; each person's own rate is worked
// out when they book. Pictures are stand-ins from the site until Danielle
// chooses.
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import VideographyBooking from "../components/VideographyBooking.astro";
import SMMForms from "../components/SMMForms.astro";
import ContactForm from "../components/ContactForm.astro";
import { getProduct, tierPrice } from "../data/videography.js";
import { PHOTOGRAPHY, photoInclusions } from "../lib/videography-config.js";
import { SOCIAL_SERVICES, SOCIAL_EXTRAS } from "../lib/smm-config.js";
import { gbpFromPence } from "../lib/supabase.js";

const pic = async (src, width, height) =>
  (await getImage({ src, width, height, quality: 76, format: "webp" })).src;
const A = (path) => `https://assets.tmke.co.uk/${path}`;

const studio = getProduct("studio");
const property = getProduct("property");
const agent = getProduct("agent");
const from = (pence, unit) => `From ${gbpFromPence(pence)} +VAT${unit ? ` /${unit}` : ""}`;

// The shoots: named, ordered and described as in the brochure. `book` is the
// booking pop-out's service; `more` the full page (the videography page opens a
// product from its hash; photography is reached from that page's opening).
const SHOOTS = [
  {
    key: "studio", name: "Content Studio", price: from(tierPrice(studio.priceTiers[0], "direct")),
    body: "Batch-create weeks of short-form content in one professionally filmed studio session.",
    lead: "Every session includes:",
    list: studio.included,
    rows: studio.priceTiers.map((t) => ({ name: t.label, note: t.sub, price: from(tierPrice(t, "direct")) })),
    book: "content-studio", bookLabel: "Book a session", more: "/videography#studio",
  },
  {
    key: "agent", name: "Agent Videography", price: from(tierPrice(agent.priceTiers[0], "direct")),
    body: "On-location filming focused on creating engaging social media content.",
    lead: "The Agent Edit includes:",
    list: agent.included,
    book: "agent", bookLabel: "Book a shoot", more: "/videography#agent",
  },
  {
    key: "property", name: "Property Videography", price: from(tierPrice(property.priceTiers[0], "direct")),
    body: "Professionally filmed property tours, promotional videos and photography to help listings stand out.",
    lead: "The Gold package includes:",
    list: property.included,
    book: "property", bookLabel: "Book a shoot", more: "/videography#property",
  },
  {
    key: "photography", name: "Property Photography", price: from(PHOTOGRAPHY.packages[0].member_pence),
    body: "Professional property photography, naturally edited and ready to use across portals, socials and your wider marketing.",
    lead: "Choose from three packages, with 25, 40 or 60 photos:",
    rows: PHOTOGRAPHY.packages.map((pk) => ({ name: pk.name, note: photoInclusions(pk), price: from(pk.member_pence) })),
    book: "photography", bookLabel: "Book a shoot", more: "/videography",
  },
];

// Social media, from the same data as /services.
const SOCIAL = [...SOCIAL_SERVICES, ...SOCIAL_EXTRAS].map((s) => ({
  key: s.key, name: s.name, body: s.summary, price: from(s.from_pence, s.unit),
  full: s.openToNewClients === false,
}));

// Creative, as the brochure lists it.
const CREATIVE = [
  { key: "templates", name: "Social Media Templates", body: "Professionally designed, editable social media template packs created exclusively for estate agents.", price: "£24 +VAT /pack", link: { href: "/edit", label: "Shop the Edit" } },
  { key: "design", name: "Creative Design", body: "Branding, brochures, print and digital marketing assets designed to strengthen your brand.", price: "Price on request" },
  { key: "websites", name: "Website Development", body: "Beautiful, high-performing websites designed to showcase your brand and generate more enquiries.", price: "Price on request" },
  { key: "email", name: "Email Marketing", body: "Professional newsletters, campaigns and automations to keep your audience engaged and informed.", price: "Price on request" },
];

// The opening's pictures, one per shoot, in Danielle's order; choosing one
// fills the left panel with that shoot. Sized for the staggered grid.
const PICS = {
  studio: await pic(A("Jack%20-%20headshots/Content%20Studio/1.png"), 640, 800),
  photography: await pic(A("Jack%20-%20headshots/Property/FC2-9%20(1).jpg"), 640, 800),
  property: await pic(A("Jack%20-%20headshots/Property/CV311WHCompressed8.jpg"), 640, 800),
  agent: await pic(A("Jack%20-%20headshots/Agent/DonnaPlumb-19.jpg"), 640, 800),
};
const PICKS = [
  { key: "studio", label: "Content Studio" },
  { key: "photography", label: "Property Photography" },
  { key: "property", label: "Property Videography" },
  { key: "agent", label: "Agent Shoots" },
].map((t, i) => ({ ...t, num: String(i + 1).padStart(2, "0"), img: PICS[t.key], shoot: SHOOTS.find((x) => x.key === t.key) }));
const BROCHURE_IMG = await pic(A("orange-1.webp"), 900, 700);
---

<BaseLayout
  title="Our Services — TMKE"
  description="Videography, photography, social media and creative from TMKE, with what each includes, what it costs and how to book."
  noindex
>
  <main class="os">
    <!-- The opening: words on the left, the four shoots as pictures on the
         right. Choosing a picture swaps the left panel to that shoot. -->
    <section class="os-split" aria-label="Our services">
      <div class="os-left" aria-live="polite">
        <div class="os-pane is-on" data-pane="all">
          <p class="os-label">Finding a fit for your business</p>
          <h1 class="os-big">Film, photography and content for estate agents, in one place.</h1>
          <p class="os-pane-text">From a day in our studio to a full property shoot, choose a picture to see what each one includes and book straight in.</p>
          <a class="os-link" href="#videography" data-os-to="videography">See everything we do <span aria-hidden="true">&darr;</span></a>
        </div>
        {PICKS.map((t) => (
          <div class="os-pane" data-pane={t.key} id={`os-pane-${t.key}`} aria-hidden="true">
            <p class="os-label">{t.num} &middot; {t.shoot.name}</p>
            <h2 class="os-big">{t.label}.</h2>
            <p class="os-pane-text">{t.shoot.body}</p>
            <p class="os-pane-price">{t.shoot.price}</p>
            {t.shoot.list && <ul class="os-pane-list">{t.shoot.list.slice(0, 4).map((x) => <li>{x}</li>)}</ul>}
            {!t.shoot.list && t.shoot.rows && <ul class="os-pane-list">{t.shoot.rows.map((r) => <li>{r.name}, {r.price.replace("From ", "from ")}</li>)}</ul>}
            <div class="os-row-actions">
              <button type="button" class="os-btn" data-vbook={t.shoot.book} tabindex="-1">{t.shoot.bookLabel} <span aria-hidden="true">&rarr;</span></button>
              <a class="os-link" href={t.shoot.more} tabindex="-1">Discover more <span aria-hidden="true">&rsaquo;</span></a>
              <button type="button" class="os-back" data-os-pick="all" tabindex="-1">All services</button>
            </div>
          </div>
        ))}
        <p class="os-left-foot">Videography &middot; Photography &middot; Social media &middot; Creative</p>
      </div>
      <div class="os-right">
        <div class="os-pics">
          {PICKS.map((t, i) => (
            <button type="button" class={`os-pic os-pic--${i + 1}`} data-os-pick={t.key} aria-pressed="false" aria-controls={`os-pane-${t.key}`}>
              <span class="os-pic-img" style={`background-image:url('${t.img}')`}></span>
              <span class="os-pic-cap"><span class="os-pic-num">{t.num}</span><span class="os-pic-name">{t.label}</span></span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <!-- Videography: the four shoots, each bookable. -->
    <section class="os-group" id="videography" aria-labelledby="os-h-video">
      <div class="os-group-head">
        <h2 class="os-group-title" id="os-h-video">Videography</h2>
        <a class="os-link" href="/videography">Discover videography <span aria-hidden="true">&rsaquo;</span></a>
      </div>
      {SHOOTS.map((s) => (
        <article class="os-row os-row--shoot" id={s.key}>
          <h3 class="os-row-name">{s.name}</h3>
          <p class="os-row-body">{s.body}</p>
          <p class="os-row-price">{s.price}</p>
          <div class="os-row-more">
            <div class="os-row-actions">
              <button type="button" class="os-fold-head" aria-expanded="false" aria-controls={`os-fold-${s.key}`}>
                What&rsquo;s included <span class="os-fold-sign" aria-hidden="true"></span>
              </button>
              <button type="button" class="os-btn" data-vbook={s.book}>{s.bookLabel} <span aria-hidden="true">&rarr;</span></button>
              <a class="os-link" href={s.more}>Discover more <span aria-hidden="true">&rsaquo;</span></a>
            </div>
            <div class="os-fold" id={`os-fold-${s.key}`}><div class="os-fold-inner">
              <p class="os-fold-lead">{s.lead}</p>
              {s.list && <ul class="os-fold-list">{s.list.map((x) => <li>{x}</li>)}</ul>}
              {s.rows && (
                <dl class="os-fold-rows">
                  {s.rows.map((r) => (
                    <div class="os-fold-row"><dt>{r.name}</dt><dd class="os-fold-note">{r.note}</dd><dd class="os-fold-price">{r.price}</dd></div>
                  ))}
                </dl>
              )}
            </div></div>
          </div>
        </article>
      ))}
      <p class="os-note">For shoots on location, Jack covers a 40-mile radius of NN14 (Kettering). If you&rsquo;re further away, travel is added to your quote automatically.</p>
    </section>

    <!-- Social media: a line and a price each; the detail lives on /services. -->
    <section class="os-group" id="social" aria-labelledby="os-h-social">
      <div class="os-group-head">
        <h2 class="os-group-title" id="os-h-social">Social Media</h2>
        <a class="os-link" href="/services">Discover social media <span aria-hidden="true">&rsaquo;</span></a>
      </div>
      {SOCIAL.map((s) => (
        <article class="os-row">
          <h3 class="os-row-name">{s.name}{s.full && <span class="os-tag">Waiting list</span>}</h3>
          <p class="os-row-body">{s.body}</p>
          <p class="os-row-price">{s.price}</p>
        </article>
      ))}
    </section>

    <!-- Creative: templates go to the Edit; the rest are quoted, so to the form. -->
    <section class="os-group" id="creative" aria-labelledby="os-h-creative">
      <div class="os-group-head">
        <h2 class="os-group-title" id="os-h-creative">Creative</h2>
        <a class="os-link" href="#get-in-touch" data-os-to="get-in-touch">Ask about a project <span aria-hidden="true">&rsaquo;</span></a>
      </div>
      {CREATIVE.map((s) => (
        <article class="os-row">
          <h3 class="os-row-name">{s.name}</h3>
          <p class="os-row-body">{s.body}{s.link && <> <a class="os-inline" href={s.link.href}>{s.link.label} <span aria-hidden="true">&rsaquo;</span></a></>}</p>
          <p class="os-row-price">{s.price}</p>
        </article>
      ))}
    </section>

    <!-- The services brochure: the social media page's form, which emails it. -->
    <section class="os-bro">
      <figure class="os-bro-pic"><img src={BROCHURE_IMG} alt="" width="900" height="700" loading="lazy" /></figure>
      <div class="os-bro-copy">
        <p class="os-label os-label--paper">Brochure</p>
        <h2 class="os-h">The Full Picture, in One Brochure.</h2>
        <p class="os-bro-text">Our services brochure sets out everything we do in full, with what&rsquo;s included and what each service costs. Enter your name and email, and we&rsquo;ll send it to you.</p>
        <button type="button" class="os-btn os-btn--paper" data-smm-form="brochure">Download the brochure <span aria-hidden="true">&rarr;</span></button>
      </div>
    </section>

    <!-- Get in touch: the Contact page's form, with Jack's details under it. -->
    <section class="os-touch" id="get-in-touch">
      <div class="os-touch-copy">
        <p class="os-label">Get in touch</p>
        <h2 class="os-h">Talk to Us Before You Book.</h2>
        <p class="os-touch-text">If you&rsquo;re not sure which service suits you, or you have a question about anything on this page, send us a message and it&rsquo;ll go straight to our team.</p>
      </div>
      <ContactForm source="videography_services_page" trackAs="services_page">
        <p class="os-jack">
          Prefer to speak to Jack directly? Email him at <a href="mailto:jack@tmke.co.uk">jack@tmke.co.uk</a> or
          <button type="button" class="os-jack-call" data-vbook="discovery">book a short call with him <span aria-hidden="true">&rsaquo;</span></button>
        </p>
      </ContactForm>
    </section>
  </main>

  <VideographyBooking />
  <SMMForms brochureLead="Everything we do, in one place. Download our services brochure for a full breakdown of what's included, how it works, and what it costs." />
</BaseLayout>

<script>
  // What's included: folded until asked for.
  document.querySelectorAll(".os-row--shoot").forEach((row) => {
    const head = row.querySelector(".os-fold-head");
    head?.addEventListener("click", () => {
      const on = !row.classList.contains("is-open");
      row.classList.toggle("is-open", on);
      head.setAttribute("aria-expanded", on ? "true" : "false");
    });
  });
  // The opening: a picture swaps the left panel to its shoot; All services,
  // or the same picture again, puts the overview back.
  (function picker() {
    const panes = [...document.querySelectorAll<HTMLElement>(".os-pane")];
    const pics = [...document.querySelectorAll<HTMLElement>(".os-pic")];
    const split = document.querySelector(".os-split");
    let current = "all";
    const show = (key: string) => {
      current = key;
      split?.classList.toggle("has-pick", key !== "all");
      panes.forEach((p) => {
        const on = p.dataset.pane === key;
        p.classList.toggle("is-on", on);
        p.setAttribute("aria-hidden", on ? "false" : "true");
        p.querySelectorAll<HTMLElement>("a, button").forEach((c) => c.tabIndex = on ? 0 : -1);
      });
      pics.forEach((b) => {
        const on = b.dataset.osPick === key;
        b.classList.toggle("is-on", on);
        b.setAttribute("aria-pressed", on ? "true" : "false");
      });
    };
    document.querySelectorAll<HTMLElement>("[data-os-pick]").forEach((b) => b.addEventListener("click", () => {
      const key = b.dataset.osPick || "all";
      show(key === current ? "all" : key);
      // On a phone the panel sits above the pictures: bring it into view.
      if (window.matchMedia("(max-width: 900px)").matches && key !== "all") {
        const left = document.querySelector(".os-left");
        const lenis = (window as any).__lenis;
        if (left) lenis ? lenis.scrollTo(left, { offset: -90, duration: 0.9 }) : left.scrollIntoView({ behavior: "smooth" });
      }
    }));
  })();
  // The picture row and in-page links land clear of the nav. Caught before the
  // site's own anchor scroll, which stops at the very top of the target.
  document.addEventListener("click", (e) => {
    const a = (e.target as Element).closest?.("[data-os-to]");
    if (!a) return;
    const target = document.getElementById(a.getAttribute("data-os-to") || "");
    if (!target) return;
    e.preventDefault(); e.stopImmediatePropagation();
    const lenis = (window as any).__lenis;
    if (lenis) lenis.scrollTo(target, { offset: -110, duration: 1.2 });
    else window.scrollTo({ top: target.getBoundingClientRect().top + scrollY - 110, behavior: "smooth" });
  }, true);
</script>

<style is:global>
  /* The nav sits on paper here, as on any PageHero page. */
  body:has(.os) .nav { background: var(--paper); color: var(--ink); }

  /* Headings on this page are in the copy face, as the Edit's tiles are, not
     the site's heading face (Danielle, 29 Oct). */
  .os { --hairline: rgba(28, 29, 34, 0.14); background: var(--paper); color: var(--ink); font-family: var(--sans); }
  .os-label {
    margin: 0; font-family: var(--sans); font-size: 11px; font-weight: 700;
    letter-spacing: 0.22em; text-transform: uppercase; color: var(--english-violet);
  }
  .os-label--paper { color: rgba(244, 242, 241, 0.72); }
  .os-h {
    margin: 14px 0 14px; font-family: var(--sans); font-weight: 600;
    font-size: clamp(28px, 2.6vw, 38px); line-height: 1.08; letter-spacing: -0.01em; color: var(--english-violet);
  }

  /* ---- The opening: a split screen, words left, pictures right ---- */
  .os-split {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: max(640px, 100vh); min-height: max(640px, 100svh);
  }
  .os-left {
    position: relative; display: grid; grid-template-rows: 1fr auto;
    padding: clamp(120px, 16vh, 160px) var(--page-gutter) clamp(28px, 4vh, 44px);
    background: var(--paper);
  }
  /* Every pane in the same cell, so the panel never changes height. */
  .os-pane {
    grid-row: 1; grid-column: 1; align-self: start;
    display: flex; flex-direction: column; align-items: flex-start;
    opacity: 0; visibility: hidden; transform: translateY(10px);
    transition: opacity 0.35s ease, transform 0.45s cubic-bezier(.2,.8,.2,1), visibility 0s 0.35s;
  }
  .os-pane.is-on { opacity: 1; visibility: visible; transform: none; transition: opacity 0.45s ease 0.08s, transform 0.55s cubic-bezier(.2,.8,.2,1) 0.08s; }
  .os-big {
    margin: 18px 0 22px; max-width: 13em; font-family: var(--sans); font-weight: 700;
    font-size: clamp(40px, 4.6vw, 76px); line-height: 0.98; letter-spacing: -0.03em; color: var(--english-violet);
  }
  .os-pane-text { margin: 0 0 18px; max-width: 34em; font-size: clamp(16px, 1.25vw, 19px); line-height: 1.55; color: rgba(28, 29, 34, 0.72); }
  .os-pane-price { margin: 0 0 16px; font-size: 13px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--english-violet); }
  .os-pane-list { margin: 0 0 26px; padding-left: 18px; max-width: 34em; font-size: 16px; line-height: 1.65; color: rgba(28, 29, 34, 0.78); }
  .os-pane .os-link { margin-top: 6px; }
  .os-back {
    background: none; border: 0; padding: 0; cursor: pointer;
    font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
    color: rgba(28, 29, 34, 0.5);
  }
  .os-back:hover { color: var(--ink); }
  .os-left-foot { grid-row: 2; margin: 24px 0 0; font-size: 16px; color: rgba(28, 29, 34, 0.6); }

  .os-right { position: relative; overflow: hidden; background: var(--paper-shadow); display: flex; align-items: center; }
  /* A staggered three-column grid: two up top, two stepped down and right. */
  .os-pics {
    --tile: clamp(160px, 15.5vw, 290px);
    display: grid; grid-template-columns: repeat(3, var(--tile)); gap: 6px;
    padding: clamp(110px, 14vh, 140px) 0 clamp(40px, 6vh, 70px) clamp(36px, 5vw, 76px);
  }
  /* The Insights page's picture tile, as the Edit uses it: 3:4, the photo
     shown, the name over a soft fade at its foot. */
  .os-pic {
    position: relative; display: block; width: var(--tile); aspect-ratio: 3 / 4; padding: 0; margin: 0; border: 0;
    -webkit-appearance: none; appearance: none; text-align: left;
    overflow: hidden; border-radius: 2px; cursor: pointer; background-color: rgba(28, 29, 34, 0.06);
    transition: opacity 0.35s ease;
  }
  .os-pic::after {
    content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgba(20,18,22,0) 42%, rgba(20,18,22,0.74) 100%);
  }
  .os-pic--1 { grid-column: 1; grid-row: 1; }
  .os-pic--2 { grid-column: 2; grid-row: 1; }
  .os-pic--3 { grid-column: 2; grid-row: 2; }
  .os-pic--4 { grid-column: 3; grid-row: 2; }
  .os-pic-img { position: absolute; inset: 0; background-size: cover; background-position: center; transition: transform 0.6s cubic-bezier(.2,.8,.2,1); }
  .os-pic:hover .os-pic-img { transform: scale(1.04); }
  .os-pic-cap { position: absolute; left: 14px; right: 14px; bottom: 14px; z-index: 2; display: flex; flex-direction: column; gap: 4px; }
  .os-pic-num { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(244, 242, 240, 0.8); }
  .os-pic-name { font-family: var(--sans); font-weight: 400; font-size: 16px; line-height: 1.12; letter-spacing: -0.005em; color: var(--paper); }
  /* Once one is chosen, it stays bright and the rest step back. */
  .os-split.has-pick .os-pic:not(.is-on) { opacity: 0.45; }
  .os-pic.is-on { outline: 2px solid var(--english-violet); outline-offset: 3px; }
  .os-pic:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 3px; }


  .os-group { padding: clamp(36px, 5vh, 60px) var(--page-gutter) 0; }
  .os-group-head {
    display: flex; align-items: baseline; justify-content: space-between; gap: 18px;
    padding-bottom: 12px; border-bottom: 1px solid rgba(28, 29, 34, 0.3);
  }
  .os-group-title {
    margin: 0; font-family: var(--sans); font-size: 13px; font-weight: 700;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--english-violet);
  }
  .os-row {
    display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 2fr) minmax(0, 0.8fr);
    column-gap: clamp(20px, 3vw, 48px); align-items: baseline;
    padding: 16px 0; border-bottom: 1px solid var(--hairline);
  }
  /* h3, so named outright: h3 is The Seasons by default on this site. */
  .os-row-name {
    margin: 0; font-family: var(--sans); font-weight: 600; font-size: 17px;
    line-height: 1.3; letter-spacing: 0; color: var(--ink);
  }
  .os-tag {
    display: inline-block; margin-left: 10px; padding: 3px 7px; vertical-align: 2px;
    border: 1px solid rgba(55, 30, 40, 0.35); border-radius: 2px;
    font-size: 10px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--english-violet);
  }
  .os-row-body { margin: 0; font-size: 15.5px; line-height: 1.55; color: rgba(28, 29, 34, 0.72); }
  .os-row-price { margin: 0; text-align: right; font-size: 15px; font-weight: 600; color: var(--english-violet); white-space: nowrap; }
  .os-inline { white-space: nowrap; font-weight: 700; color: var(--english-violet); text-decoration: none; }
