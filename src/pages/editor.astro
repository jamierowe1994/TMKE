  { f: "Yellowtail", c: "handwriting" }, { f: "Berkshire Swash", c: "handwriting" },
  { f: "Patrick Hand", c: "handwriting" }, { f: "Indie Flower", c: "handwriting" },
  { f: "Amatic SC", c: "handwriting" }, { f: "Architects Daughter", c: "handwriting" },
  { f: "Homemade Apple", c: "handwriting" }, { f: "Reenie Beanie", c: "handwriting" },
  { f: "Gloria Hallelujah", c: "handwriting" }, { f: "Kalam", c: "handwriting" },
  { f: "Just Another Hand", c: "handwriting" }, { f: "Shadows Into Light", c: "handwriting" },
  { f: "Permanent Marker", c: "handwriting" }, { f: "Marck Script", c: "handwriting" },
  { f: "Playball", c: "handwriting" },
  // Display / decorative
  { f: "Lobster", c: "display" }, { f: "Bungee", c: "display" },
  { f: "Press Start 2P", c: "display" }, { f: "Bowlby One", c: "display" },
  { f: "Black Ops One", c: "display" }, { f: "Faster One", c: "display" },
  { f: "Monoton", c: "display" }, { f: "Audiowide", c: "display" },
  { f: "Russo One", c: "display" }, { f: "Rock Salt", c: "handwriting" },
  // Mono
  { f: "JetBrains Mono", c: "mono" }, { f: "Fira Code", c: "mono" },
  { f: "Source Code Pro", c: "mono" }, { f: "Inconsolata", c: "mono" },
  { f: "Roboto Mono", c: "mono" }, { f: "Space Mono", c: "mono" },
  { f: "IBM Plex Mono", c: "mono" }, { f: "Courier Prime", c: "mono" },
  { f: "Cousine", c: "mono" }, { f: "Cutive Mono", c: "mono" },
  // TMKE house picks (already loaded globally via BaseLayout)
  { f: "Darker Grotesque", c: "sans" },
];
---

<BaseLayout
  title="Editor — TMKE"
  description="Edit your purchased templates in the TMKE design studio."
  hideNav={true}
  hideFooter={true}
>
  <div class="editor" id="editor">
    <!-- =================== TOP BAR =================== -->
    <header class="ed-topbar">
      <div class="ed-topbar-left">
        <a href="/account" class="ed-back" title="Back to library">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </a>
        <a href="/" class="ed-logo">TMKE <em>Studio</em></a>
        <span class="ed-divider"></span>
        <input id="ed-filename" class="ed-filename" value="Untitled design" />
      </div>

      <div class="ed-topbar-mid">
        <button class="ed-icon-btn" id="ed-undo" title="Undo (Ctrl+Z)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v6h6"/><path d="M3.51 13a9 9 0 1 0 2.13-9.36L3 6"/></svg>
        </button>
        <button class="ed-icon-btn" id="ed-redo" title="Redo (Ctrl+Shift+Z)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 7v6h-6"/><path d="M20.49 13A9 9 0 1 1 18.36 3.64L21 6"/></svg>
        </button>
        <span class="ed-divider"></span>
        <button class="ed-icon-btn" id="ed-zoom-out" title="Zoom out (-)">−</button>
        <button class="ed-zoom-display" id="ed-zoom-display">100%</button>
        <button class="ed-icon-btn" id="ed-zoom-in" title="Zoom in (+)">+</button>
        <button class="ed-icon-btn ed-fit" id="ed-zoom-fit" title="Fit to screen (0)">Fit</button>
      </div>

      <div class="ed-topbar-right">
        <button class="ed-btn-ghost" id="ed-save">Save</button>
        <div class="ed-download" id="ed-download">
          <button class="ed-btn-solid" id="ed-download-trigger" aria-haspopup="menu" aria-expanded="false">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download
            <span class="ed-download-caret" aria-hidden="true">▾</span>
          </button>
          <div class="ed-download-menu" id="ed-download-menu" role="menu" hidden>
            <button class="ed-download-item" data-export="png-transparent" role="menuitem">
              <strong>PNG · transparent</strong>
              <span>Cut-outs &amp; overlays. No background.</span>
            </button>
            <button class="ed-download-item" data-export="png" role="menuitem">
              <strong>PNG</strong>
              <span>Highest quality. With background.</span>
            </button>
            <button class="ed-download-item" data-export="jpg" role="menuitem">
              <strong>JPG</strong>
              <span>Smaller file. With background.</span>
            </button>
            <button class="ed-download-item" data-export="pdf" role="menuitem">
              <strong>PDF</strong>
              <span>Print-ready, single page.</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- =================== LEFT TOOL RAIL =================== -->
    <aside class="ed-rail" role="tablist">
      <button class="ed-rail-btn is-active" data-tool="templates" title="Templates">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        <span>Designs</span>
      </button>
      <button class="ed-rail-btn" data-tool="brand" title="Your brand kit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"/></svg>
        <span>Brand</span>
      </button>
      <button class="ed-rail-btn" data-tool="elements" title="Elements">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="8" cy="8" r="5"/><rect x="13" y="13" width="8" height="8" rx="1"/><path d="M3 21l5-8 5 8z"/></svg>
        <span>Elements</span>
      </button>
      <button class="ed-rail-btn" data-tool="text" title="Text">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6V4h16v2"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
        <span>Text</span>
      </button>
      <button class="ed-rail-btn" data-tool="photos" title="Photos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        <span>Photos</span>
      </button>
      <button class="ed-rail-btn" data-tool="uploads" title="Uploads">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <span>Uploads</span>
      </button>
      <button class="ed-rail-btn" data-tool="background" title="Background">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 16l5-5 4 4 5-5 4 4"/></svg>
        <span>Background</span>
      </button>
      <button class="ed-rail-btn" data-tool="layers" title="Layers">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l10 6-10 6L2 8z"/><path d="M2 12l10 6 10-6"/><path d="M2 16l10 6 10-6"/></svg>
        <span>Layers</span>
      </button>
      <div class="ed-rail-spacer"></div>
      <button class="ed-rail-btn" data-tool="resize" title="Resize">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 3h-7M21 3v7M3 21h7M3 21v-7"/><path d="M3 3l7 7M21 21l-7-7"/></svg>
        <span>Resize</span>
      </button>
    </aside>

    <!-- =================== TOOL FLYOUT PANEL =================== -->
    <aside class="ed-panel" id="ed-panel">
      <!-- Templates -->
      <section class="ed-panel-pane is-active" data-pane="templates">
        <div class="ed-pane-header">
          <h3>Designs from your pack</h3>
          <p>Tap a design to load it onto the canvas.</p>
        </div>
        <div class="ed-template-grid" id="ed-template-grid"></div>
      </section>

      <!-- Brand kit -->
      <section class="ed-panel-pane" data-pane="brand">
        <div class="ed-pane-header">
          <h3 id="brand-company">Your brand kit</h3>
          <p>Colours, fonts and logos saved in your profile. <a href="/profile" id="brand-edit-link">Edit&nbsp;&rarr;</a></p>
        </div>

        <div class="ed-brand-empty" id="brand-empty" hidden>
          <p>You haven't set up your brand kit yet.</p>
          <a href="/profile?next=/editor" class="ed-btn-solid">Set up brand kit</a>
        </div>

        <div id="brand-loaded">
          <div class="ed-section-title">Brand colours</div>
          <p class="ed-brand-hint">Select an element first, then click a colour. Or click any swatch on its own to recolour the canvas background.</p>
          <div class="ed-swatches" id="brand-colour-grid"></div>

          <div class="ed-section-title">Brand fonts</div>
          <div id="brand-font-list"></div>

          <div class="ed-section-title">Logos</div>
          <p class="ed-brand-hint">Click a logo to drop it onto the canvas.</p>
          <div class="ed-photo-grid" id="brand-logo-grid"></div>
        </div>
      </section>

      <!-- Elements -->
      <section class="ed-panel-pane" data-pane="elements">
        <div class="ed-pane-header"><h3>Elements</h3><p>Drop shapes, lines and frames onto the canvas.</p></div>
        <div class="ed-section-title">Shapes</div>
        <div class="ed-shape-grid">
          <button class="ed-shape" data-shape="rect"><div class="sh sh-rect"></div><span>Rectangle</span></button>
          <button class="ed-shape" data-shape="ellipse"><div class="sh sh-circle"></div><span>Circle</span></button>
          <button class="ed-shape" data-shape="triangle"><div class="sh sh-tri"></div><span>Triangle</span></button>
          <button class="ed-shape" data-shape="line"><div class="sh sh-line"></div><span>Line</span></button>
          <button class="ed-shape" data-shape="rounded"><div class="sh sh-round"></div><span>Pill</span></button>
          <button class="ed-shape" data-shape="star"><div class="sh sh-star">★</div><span>Star</span></button>
        </div>
        <div class="ed-section-title">Lines &amp; rules</div>
        <div class="ed-shape-grid ed-shape-grid--lines">
          <button class="ed-shape" data-shape="hr-thin"><div class="sh sh-hr"></div><span>Thin rule</span></button>
          <button class="ed-shape" data-shape="hr-thick"><div class="sh sh-hr sh-hr-thick"></div><span>Thick rule</span></button>
        </div>
      </section>

      <!-- Text -->
      <section class="ed-panel-pane" data-pane="text">
        <div class="ed-pane-header"><h3>Text</h3><p>Click to add a text block to your design.</p></div>
        <button class="ed-text-add" data-text="heading">
          <div class="ed-text-preview ed-text-h">Add a heading</div>
        </button>
        <button class="ed-text-add" data-text="subheading">
          <div class="ed-text-preview ed-text-sh">Add a subheading</div>
        </button>
        <button class="ed-text-add" data-text="body">
          <div class="ed-text-preview ed-text-b">Add body text</div>
        </button>
        <div class="ed-section-title">Brand kit</div>
        <button class="ed-text-add" data-text="brand-eyebrow">
          <div class="ed-text-preview ed-text-eyebrow">CHAPTER MARKER</div>
        </button>
        <button class="ed-text-add" data-text="brand-quote">
          <div class="ed-text-preview ed-text-quote">"A pulled quote — italic Cormorant."</div>
        </button>
      </section>

      <!-- Photos — Pexels + Unsplash search -->
      <section class="ed-panel-pane" data-pane="photos">
        <div class="ed-pane-header">
          <h3>Photos</h3>
          <p>Search royalty-free imagery from Pexels &amp; Unsplash.</p>
        </div>
        <div class="ed-stock-search">
          <input type="search" id="ed-stock-input" placeholder='Try "kitchen", "garden", "interior"…' autocomplete="off" />
          <div class="ed-stock-sources">
            <label><input type="checkbox" data-stock-src="pexels" checked /> Pexels</label>
            <label><input type="checkbox" data-stock-src="unsplash" checked /> Unsplash</label>
          </div>
        </div>
        <p class="ed-stock-status" id="ed-stock-status">Type to search — results from both sources appear here.</p>
        <div class="ed-photo-grid" id="ed-photo-grid"></div>
        <p class="ed-stock-credit">Photos via <a href="https://www.pexels.com" target="_blank" rel="noopener">Pexels</a> &amp; <a href="https://unsplash.com" target="_blank" rel="noopener">Unsplash</a>. Hover an image to credit the photographer.</p>
      </section>

      <!-- Uploads -->
      <section class="ed-panel-pane" data-pane="uploads">
        <div class="ed-pane-header"><h3>Uploads</h3><p>Drop in your own logos and imagery.</p></div>
        <label class="ed-upload-drop">
          <input type="file" id="ed-upload-input" accept="image/*" multiple hidden />
          <strong>Click to upload</strong>
          <span>or drag images here</span>
        </label>
        <div class="ed-photo-grid" id="ed-upload-grid"></div>
      </section>

      <!-- Background -->
      <section class="ed-panel-pane" data-pane="background">
        <div class="ed-pane-header"><h3>Background</h3><p>A solid colour, a brand swatch or a gradient.</p></div>
        <div class="ed-section-title">Brand</div>
        <div class="ed-swatches" data-swatch-target="canvas">
          <button class="ed-sw" data-color="#1c1d22" style="background:#1c1d22"></button>
          <button class="ed-sw" data-color="#474254" style="background:#474254"></button>
          <button class="ed-sw" data-color="#333747" style="background:#333747"></button>
          <button class="ed-sw" data-color="#B9826A" style="background:#B9826A"></button>
          <button class="ed-sw" data-color="#BCB3B9" style="background:#BCB3B9"></button>
          <button class="ed-sw" data-color="#DFDCDE" style="background:#DFDCDE"></button>
          <button class="ed-sw" data-color="#F0EEEB" style="background:#F0EEEB"></button>
          <button class="ed-sw" data-color="#F2EFE9" style="background:#F2EFE9"></button>
          <button class="ed-sw" data-color="#FFFFFF" style="background:#FFFFFF; border:1px solid rgba(0,0,0,0.1)"></button>
        </div>
        <div class="ed-section-title">Custom</div>
        <input type="color" id="ed-bg-color" value="#F2EFE9" class="ed-color-input" />
        <div class="ed-section-title">Gradients</div>
        <div class="ed-grad-grid">
          <button class="ed-grad" data-grad="linear-gradient(135deg, #474254, #B9826A)" style="background:linear-gradient(135deg, #474254, #B9826A)"></button>
          <button class="ed-grad" data-grad="linear-gradient(135deg, #1c1d22, #474254)" style="background:linear-gradient(135deg, #1c1d22, #474254)"></button>
          <button class="ed-grad" data-grad="linear-gradient(180deg, #F2EFE9, #DFDCDE)" style="background:linear-gradient(180deg, #F2EFE9, #DFDCDE)"></button>
          <button class="ed-grad" data-grad="linear-gradient(135deg, #B9826A, #F2EFE9)" style="background:linear-gradient(135deg, #B9826A, #F2EFE9)"></button>
          <button class="ed-grad" data-grad="radial-gradient(circle at 30% 30%, #BCB3B9, #474254)" style="background:radial-gradient(circle at 30% 30%, #BCB3B9, #474254)"></button>
          <button class="ed-grad" data-grad="linear-gradient(180deg, #333747, #BCB3B9)" style="background:linear-gradient(180deg, #333747, #BCB3B9)"></button>
        </div>
      </section>

      <!-- Layers -->
      <section class="ed-panel-pane" data-pane="layers">
        <div class="ed-pane-header"><h3>Layers</h3><p>Drag to reorder. Top of list = top of canvas.</p></div>
        <ul class="ed-layers" id="ed-layers"></ul>
      </section>

      <!-- Resize -->
      <section class="ed-panel-pane" data-pane="resize">
        <div class="ed-pane-header"><h3>Resize design</h3><p>Switch the canvas to another format.</p></div>
        <div class="ed-resize-grid">
          <button class="ed-resize-card" data-size="1080,1350">
            <div class="ed-resize-vis" style="aspect-ratio:4/5"></div>
            <strong>Instagram Portrait</strong><span>1080 × 1350</span>
          </button>
          <button class="ed-resize-card" data-size="1080,1080">
            <div class="ed-resize-vis" style="aspect-ratio:1/1"></div>
            <strong>Instagram Square</strong><span>1080 × 1080</span>
          </button>
          <button class="ed-resize-card" data-size="1080,1920">
            <div class="ed-resize-vis" style="aspect-ratio:9/16"></div>
