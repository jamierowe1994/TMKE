---
import BaseLayout from "../layouts/BaseLayout.astro";
import { templates, packages } from "../data/library.js";

const photoLibrary = templates.map((t) => {
  const photo = t.elements.find((e) => e.id === "bg-photo");
  return { id: t.id, name: t.name, src: photo ? photo.src : t.thumb };
});

const templateData = templates.map((t) => ({
  id: t.id,
  name: t.name,
  category: t.category,
  thumb: t.thumb,
  canvas: t.canvas,
  elements: t.elements,
}));

// Stock photo API keys read at SSG/build time, then injected into the inline
// stock-search script via Astro's `define:vars` directive — Astro/Vite only
// substitute `import.meta.env.*` references inside scripts that have at least
// one `import` statement, and our search script doesn't need any.
const PEXELS_KEY = import.meta.env.PUBLIC_PEXELS_API_KEY ?? "";
const UNSPLASH_KEY = import.meta.env.PUBLIC_UNSPLASH_ACCESS_KEY ?? "";

// Curated Google Fonts catalogue (~150 popular families). Each entry's CSS
// gets loaded on-demand when a user picks the font in the editor's font
// picker, so the page doesn't blow its budget at startup.
//   c = category (sans | serif | display | mono | handwriting)
const googleFonts = [
  // Sans-serif staples
  { f: "Inter", c: "sans" }, { f: "Roboto", c: "sans" }, { f: "Open Sans", c: "sans" },
  { f: "Lato", c: "sans" }, { f: "Montserrat", c: "sans" }, { f: "Poppins", c: "sans" },
  { f: "Raleway", c: "sans" }, { f: "Nunito", c: "sans" }, { f: "Nunito Sans", c: "sans" },
  { f: "Source Sans 3", c: "sans" }, { f: "PT Sans", c: "sans" }, { f: "Oswald", c: "sans" },
  { f: "Bebas Neue", c: "display" }, { f: "Anton", c: "display" },
  { f: "Work Sans", c: "sans" }, { f: "Rubik", c: "sans" }, { f: "Quicksand", c: "sans" },
  { f: "Karla", c: "sans" }, { f: "Mulish", c: "sans" }, { f: "Heebo", c: "sans" },
  { f: "Hind", c: "sans" }, { f: "Asap", c: "sans" }, { f: "Cabin", c: "sans" },
  { f: "Barlow", c: "sans" }, { f: "Saira", c: "sans" }, { f: "Manrope", c: "sans" },
  { f: "DM Sans", c: "sans" }, { f: "Outfit", c: "sans" }, { f: "Plus Jakarta Sans", c: "sans" },
  { f: "Sora", c: "sans" }, { f: "Figtree", c: "sans" }, { f: "Space Grotesk", c: "sans" },
  { f: "Lexend", c: "sans" }, { f: "Albert Sans", c: "sans" }, { f: "Onest", c: "sans" },
  { f: "Public Sans", c: "sans" }, { f: "IBM Plex Sans", c: "sans" },
  { f: "Hanken Grotesk", c: "sans" }, { f: "Fira Sans", c: "sans" },
  { f: "Josefin Sans", c: "sans" }, { f: "Kanit", c: "sans" }, { f: "Prompt", c: "sans" },
  { f: "Roboto Condensed", c: "sans" }, { f: "Roboto Flex", c: "sans" },
  { f: "Maven Pro", c: "sans" }, { f: "Be Vietnam Pro", c: "sans" },
  { f: "Archivo", c: "sans" }, { f: "Archivo Black", c: "display" },
  { f: "Archivo Narrow", c: "sans" }, { f: "Mukta", c: "sans" },
  { f: "Catamaran", c: "sans" }, { f: "Noto Sans", c: "sans" },
  { f: "Encode Sans", c: "sans" }, { f: "Tajawal", c: "sans" },
  { f: "Ubuntu", c: "sans" }, { f: "Yantramanav", c: "sans" }, { f: "Mali", c: "handwriting" },
  // Serif staples
  { f: "Cormorant Garamond", c: "serif" }, { f: "Cormorant", c: "serif" },
  { f: "Cormorant Infant", c: "serif" }, { f: "Playfair Display", c: "serif" },
  { f: "Merriweather", c: "serif" }, { f: "Lora", c: "serif" }, { f: "PT Serif", c: "serif" },
  { f: "Roboto Slab", c: "serif" }, { f: "Slabo 27px", c: "serif" },
  { f: "Source Serif 4", c: "serif" }, { f: "Crimson Pro", c: "serif" },
  { f: "Crimson Text", c: "serif" }, { f: "EB Garamond", c: "serif" },
  { f: "Libre Baskerville", c: "serif" }, { f: "Bitter", c: "serif" },
  { f: "DM Serif Display", c: "serif" }, { f: "DM Serif Text", c: "serif" },
  { f: "Spectral", c: "serif" }, { f: "Newsreader", c: "serif" },
  { f: "Frank Ruhl Libre", c: "serif" }, { f: "Cardo", c: "serif" },
  { f: "Vollkorn", c: "serif" }, { f: "Yeseva One", c: "display" },
  { f: "Cinzel", c: "serif" }, { f: "Italiana", c: "serif" }, { f: "Tinos", c: "serif" },
  { f: "Volkhov", c: "serif" }, { f: "Bree Serif", c: "serif" }, { f: "Arvo", c: "serif" },
  { f: "Domine", c: "serif" }, { f: "Alice", c: "serif" }, { f: "Gelasio", c: "serif" },
  { f: "Literata", c: "serif" }, { f: "Tenor Sans", c: "sans" },
