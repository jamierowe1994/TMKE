          <button class="ed-shape" data-frame="square"   title="Square frame"><div class="fr fr-square"></div><span>Square</span></button>
          <button class="ed-shape" data-frame="portrait" title="Portrait frame"><div class="fr fr-portrait"></div><span>Portrait</span></button>
          <button class="ed-shape" data-frame="landscape" title="Landscape frame"><div class="fr fr-landscape"></div><span>Landscape</span></button>
          <button class="ed-shape" data-frame="wide"     title="Wide / banner frame"><div class="fr fr-wide"></div><span>Wide</span></button>
          <button class="ed-shape" data-frame="circle"   title="Circle frame"><div class="fr fr-circle"></div><span>Circle</span></button>
