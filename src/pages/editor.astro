---

<BaseLayout
  title="Editor — TMKE"
  description="Edit your purchased templates in the TMKE design studio."
  hideNav={true}
  hideFooter={true}
>
  <!-- =================== ONBOARDING OVERLAY =================== -->
  <div class="ed-onboard" id="ed-onboard">
    <a href="/account" class="ed-onboard-back" id="ed-onboard-back" aria-label="Back to your workspace">
      <span aria-hidden="true">&larr;</span> Back
    </a>
    <div class="ed-onboard-inner">
      <div class="ed-onboard-eyebrow">Welcome to the Studio</div>
      <h1 class="ed-onboard-title">Pick a pack <em>to open.</em></h1>
      <p class="ed-onboard-sub">Choose one of your design packs to load into the editor — you can switch any time from the left rail. Prefer to start clean? Skip below.</p>

      <div class="ed-onboard-loading" id="ed-onboard-loading">Loading your packs…</div>
      <div class="ed-onboard-grid" id="ed-onboard-grid" hidden></div>
      <div class="ed-onboard-error" id="ed-onboard-error" hidden></div>

      <button type="button" class="ed-onboard-skip" id="ed-onboard-skip">
        Start with a blank canvas <em>&rarr;</em>
      </button>
    </div>
  </div>

  <div class="editor is-onboarding" id="editor" data-stage="0">
    <!-- =================== TOP BAR =================== -->
    <header class="ed-topbar">
      <div class="ed-topbar-left">
        <a href="/account" class="ed-back" title="Back to library">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
        </a>
        <a href="/" class="ed-logo">TMKE <em>Studio</em></a>
        <span class="ed-divider"></span>
        <input id="ed-filename" class="ed-filename" value="Untitled design" />
      </div>

      <div class="ed-topbar-mid">
        <button class="ed-icon-btn" id="ed-undo" title="Undo (Ctrl+Z)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7v6h6"/><path d="M3.51 13a9 9 0 1 0 2.13-9.36L3 6"/></svg>
        </button>
        <button class="ed-icon-btn" id="ed-redo" title="Redo (Ctrl+Shift+Z)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 7v6h-6"/><path d="M20.49 13A9 9 0 1 1 18.36 3.64L21 6"/></svg>
        </button>
        <span class="ed-divider"></span>
        <button class="ed-icon-btn" id="ed-crop" title="Crop image">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2v14a2 2 0 0 0 2 2h14"/><path d="M18 22V8a2 2 0 0 0-2-2H2"/></svg>
        </button>
        <button class="ed-icon-btn" id="ed-flip" title="Flip horizontal">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="17 1 21 5 17 9"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><polyline points="7 23 3 19 7 15"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
        </button>
        <span class="ed-divider"></span>
        <button class="ed-icon-btn" id="ed-zoom-out" title="Zoom out (-)">−</button>
        <button class="ed-zoom-display" id="ed-zoom-display">100%</button>
        <button class="ed-icon-btn" id="ed-zoom-in" title="Zoom in (+)">+</button>
        <button class="ed-icon-btn ed-fit" id="ed-zoom-fit" title="Fit to screen (0)">Fit</button>
      </div>

      <div class="ed-topbar-right">
        <button class="ed-btn-ghost" id="ed-save">Save</button>
        <button class="ed-btn-ghost" id="ed-schedule" title="Schedule this post on your content calendar">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          Schedule
        </button>
        <button class="ed-btn-ghost" id="ed-share" title="Share to your socials">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="18" cy="5" r="3"/>
            <circle cx="6" cy="12" r="3"/>
            <circle cx="18" cy="19" r="3"/>
            <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
            <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
          </svg>
          Share
        </button>
        <div class="ed-download" id="ed-download">
          <button class="ed-btn-solid" id="ed-download-trigger" aria-haspopup="menu" aria-expanded="false">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
            Download
            <span class="ed-download-caret" aria-hidden="true">▾</span>
          </button>
          <div class="ed-download-menu" id="ed-download-menu" role="menu" hidden>
            <button class="ed-download-item" data-export="png-transparent" role="menuitem">
              <strong>PNG · transparent</strong>
              <span>Cut-outs &amp; overlays. No background.</span>
            </button>
            <button class="ed-download-item" data-export="png" role="menuitem">
              <strong>PNG</strong>
              <span>Highest quality. With background.</span>
            </button>
            <button class="ed-download-item" data-export="jpg" role="menuitem">
              <strong>JPG</strong>
              <span>Smaller file. With background.</span>
            </button>
            <button class="ed-download-item" data-export="pdf" role="menuitem">
              <strong>PDF</strong>
              <span>Print-ready, single page.</span>
            </button>
          </div>
        </div>
      </div>
    </header>

    <!-- =================== LEFT TOOL RAIL =================== -->
    <aside class="ed-rail" role="tablist">
      <!-- "Designs" tab removed — users rarely jump between templates
           mid-session, and dropping it gives the rail more breathing room. -->
      <button class="ed-rail-btn is-active" data-tool="brand" title="Your brand kit">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l3 7h7l-5.5 4.5L18 21l-6-4-6 4 1.5-7.5L2 9h7z"/></svg>
        <span>Brand</span>
      </button>
      <button class="ed-rail-btn" data-tool="elements" title="Elements">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="8" cy="8" r="5"/><rect x="13" y="13" width="8" height="8" rx="1"/><path d="M3 21l5-8 5 8z"/></svg>
        <span>Elements</span>
      </button>
      <button class="ed-rail-btn" data-tool="text" title="Text">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 6V4h16v2"/><path d="M9 20h6"/><path d="M12 4v16"/></svg>
        <span>Text</span>
      </button>
      <button class="ed-rail-btn" data-tool="photos" title="Photos">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="M21 15l-5-5L5 21"/></svg>
        <span>Photos</span>
      </button>
      <button class="ed-rail-btn" data-tool="uploads" title="Uploads">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
        <span>Uploads</span>
      </button>
      <button class="ed-rail-btn" data-tool="background" title="Background">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 16l5-5 4 4 5-5 4 4"/></svg>
        <span>Background</span>
      </button>
      <button class="ed-rail-btn" data-tool="layers" title="Layers">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 2l10 6-10 6L2 8z"/><path d="M2 12l10 6 10-6"/><path d="M2 16l10 6 10-6"/></svg>
        <span>Layers</span>
      </button>
      <div class="ed-rail-spacer"></div>
      <button class="ed-rail-btn" data-tool="resize" title="Resize">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 3h-7M21 3v7M3 21h7M3 21v-7"/><path d="M3 3l7 7M21 21l-7-7"/></svg>
        <span>Resize</span>
      </button>
    </aside>

    <!-- =================== TOOL FLYOUT PANEL =================== -->
    <aside class="ed-panel" id="ed-panel">
      <!-- Selection — auto-opens when an element is selected, replacing
           the right-hand properties panel that used to live in this layout. -->
      <section class="ed-panel-pane" data-pane="selection">
        <div class="ed-pane-header">
          <h3>Selection</h3>
          <p>Edit the element you're currently working on.</p>
        </div>
        <div class="ed-selection-body" id="ed-selection-body"></div>
      </section>

      <!-- Templates pane kept in the DOM (the admin /admin/templates page
           still navigates here with ?template=...) but the rail tab that
           opened it has been removed. -->
      <section class="ed-panel-pane" data-pane="templates">
        <div class="ed-pane-header">
          <h3>Designs from your pack</h3>
          <p>Tap a design to load it onto the canvas.</p>
        </div>
        <div class="ed-template-grid" id="ed-template-grid"></div>
      </section>

      <!-- Brand kit -->
      <section class="ed-panel-pane is-active" data-pane="brand">
        <div class="ed-pane-header">
          <h3 id="brand-company">Your brand kit</h3>
          <p>Colours, fonts and logos saved in your profile. <a href="/profile" id="brand-edit-link">Edit&nbsp;&rarr;</a></p>
        </div>

        <div class="ed-brand-empty" id="brand-empty" hidden>
          <p>You haven't set up your brand kit yet.</p>
          <a href="/profile?next=/editor" class="ed-btn-solid">Set up brand kit</a>
        </div>

        <div id="brand-loaded">
          <div class="ed-section-title">Brand colours</div>
          <p class="ed-brand-hint">Select an element first, then click a colour. Or click any swatch on its own to recolour the canvas background.</p>
          <div class="ed-swatches" id="brand-colour-grid"></div>

          <div class="ed-section-title">Brand fonts</div>
          <div id="brand-font-list"></div>

          <div class="ed-section-title">Logos</div>
          <p class="ed-brand-hint">Click a logo to drop it onto the canvas.</p>
          <div class="ed-photo-grid" id="brand-logo-grid"></div>
        </div>
      </section>

      <!-- Elements -->
      <section class="ed-panel-pane" data-pane="elements">
        <div class="ed-pane-header"><h3>Elements</h3><p>Drop shapes, lines, icons and frames onto the canvas.</p></div>
        <div class="ed-section-title">Shapes</div>
        <div class="ed-shape-grid">
          <button class="ed-shape" data-shape="rect"><div class="sh sh-rect"></div><span>Rectangle</span></button>
          <button class="ed-shape" data-shape="ellipse"><div class="sh sh-circle"></div><span>Circle</span></button>
          <button class="ed-shape" data-shape="triangle"><div class="sh sh-tri"></div><span>Triangle</span></button>
          <button class="ed-shape" data-shape="line"><div class="sh sh-line"></div><span>Line</span></button>
          <button class="ed-shape" data-shape="rounded"><div class="sh sh-round"></div><span>Pill</span></button>
          <button class="ed-shape" data-shape="star"><div class="sh sh-star">★</div><span>Star</span></button>
        </div>
        <div class="ed-section-title">More shapes</div>
        <div class="ed-shape-grid">
          <button class="ed-shape" data-svg="heart"><div class="sh sh-svg"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 21s-7-4.5-9.5-9C1 8.5 3 4 7 4c2 0 3.5 1 5 3 1.5-2 3-3 5-3 4 0 6 4.5 4.5 8-2.5 4.5-9.5 9-9.5 9z"/></svg></div><span>Heart</span></button>
          <button class="ed-shape" data-svg="cloud"><div class="sh sh-svg"><svg viewBox="0 0 24 16" fill="currentColor"><path d="M18 14H6a4 4 0 0 1-1-7.9 5 5 0 0 1 9.7-1.4 4 4 0 0 1 4.3 4.3A4 4 0 0 1 18 14z"/></svg></div><span>Cloud</span></button>
          <button class="ed-shape" data-svg="hexagon"><div class="sh sh-svg"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12,2 21.66,7.5 21.66,16.5 12,22 2.34,16.5 2.34,7.5"/></svg></div><span>Hexagon</span></button>
          <button class="ed-shape" data-svg="pentagon"><div class="sh sh-svg"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12,2 22.5,9.5 18.5,22 5.5,22 1.5,9.5"/></svg></div><span>Pentagon</span></button>
          <button class="ed-shape" data-svg="octagon"><div class="sh sh-svg"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="8.5,2 15.5,2 22,8.5 22,15.5 15.5,22 8.5,22 2,15.5 2,8.5"/></svg></div><span>Octagon</span></button>
          <button class="ed-shape" data-svg="diamond"><div class="sh sh-svg"><svg viewBox="0 0 24 24" fill="currentColor"><polygon points="12,2 22,12 12,22 2,12"/></svg></div><span>Diamond</span></button>
          <button class="ed-shape" data-svg="arrow-r"><div class="sh sh-svg"><svg viewBox="0 0 32 24" fill="currentColor"><polygon points="2,9 18,9 18,3 30,12 18,21 18,15 2,15"/></svg></div><span>Arrow right</span></button>
          <button class="ed-shape" data-svg="arrow-l"><div class="sh sh-svg"><svg viewBox="0 0 32 24" fill="currentColor"><polygon points="30,9 14,9 14,3 2,12 14,21 14,15 30,15"/></svg></div><span>Arrow left</span></button>
          <button class="ed-shape" data-svg="speech"><div class="sh sh-svg"><svg viewBox="0 0 24 20" fill="currentColor"><path d="M3 2h18a1 1 0 0 1 1 1v11a1 1 0 0 1-1 1h-8l-5 4v-4H3a1 1 0 0 1-1-1V3a1 1 0 0 1 1-1z"/></svg></div><span>Speech</span></button>
          <button class="ed-shape" data-svg="lightning"><div class="sh sh-svg"><svg viewBox="0 0 18 24" fill="currentColor"><polygon points="11,2 2,13 8,13 6,22 16,11 10,11 12,2"/></svg></div><span>Lightning</span></button>
          <button class="ed-shape" data-svg="banner"><div class="sh sh-svg"><svg viewBox="0 0 32 16" fill="currentColor"><polygon points="2,2 28,2 30,8 28,14 2,14 4,8"/></svg></div><span>Banner</span></button>
