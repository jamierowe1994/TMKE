  </style>

  <!--
    Admin-mode bootstrap. If the URL says ?mode=admin AND the user is signed in
    as an admin, we:
      • fetch templates from Supabase (overriding the baked-in mock library)
      • install a save hook that writes back to the templates table
    The top-level `await` here blocks the next module script (editor.js) until
    bootstrap is done, so when the editor reads its templates JSON it sees the
    Supabase data instead of the seed.
  -->
  <script type="module">
    import { supabase } from '../lib/supabase.js';

    const params = new URLSearchParams(location.search);
    const wantAdmin = params.get('mode') === 'admin';

    if (wantAdmin) {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        // Not signed in — bounce to admin login, preserve where we wanted to go.
        const next = encodeURIComponent(location.pathname + location.search);
        location.replace(`/admin/login?next=${next}`);
      } else {
        // Pull all admin-visible templates and replace the static JSON blob.
        const { data: rows, error } = await supabase
          .from('templates')
          .select('id, name, category, thumb_url, canvas, elements, status, sort_order')
          .order('status', { ascending: true })
          .order('sort_order', { ascending: true });

        if (!error && rows) {
          const shaped = rows.map((r) => ({
            id: r.id,
            name: r.name,
            category: r.category,
            thumb: r.thumb_url,
            canvas: r.canvas || { width: 1080, height: 1350, background: '#F2EFE9' },
            elements: r.elements || [],
          }));
          const tag = document.getElementById('ed-templates-data');
          if (tag) tag.textContent = JSON.stringify(shaped);
        }

        // If a specific template id is requested, make sure it loads first by
        // ensuring it's at index 0 (the editor falls back to TEMPLATES[0]).
        const requestedId = params.get('id');
        if (requestedId) {
          const tag = document.getElementById('ed-templates-data');
          if (tag) {
            try {
              const arr = JSON.parse(tag.textContent || '[]');
              const idx = arr.findIndex((t) => t.id === requestedId);
              if (idx > 0) {
                const [hit] = arr.splice(idx, 1);
                arr.unshift(hit);
                tag.textContent = JSON.stringify(arr);
              }
            } catch (_) {}
          }
        }

        // Install the save hook the editor will pick up. Editor.js passes
        // its current `state.templateId` in `payload.templateId`, which is
        // also the Supabase row id (we keep ids stable end-to-end).
        window.__TMKE_ADMIN_SAVE__ = async (payload) => {
          if (!payload?.templateId) return false;
          const { error: saveErr } = await supabase
            .from('templates')
            .update({
              name: payload.filename,
              canvas: payload.canvas,
              elements: payload.elements,
            })
            .eq('id', payload.templateId);
          return !saveErr;
        };
      }
    }

    // Custom brand fonts — fetched for BOTH admin and customer modes so the
    // canvas renders templates that reference them correctly. Each row is
    // registered with the document via Font Face API; editor.js picks them
    // up via `window.__TMKE_BRAND_FONTS__` and adds to the picker.
    try {
      const { data: bf, error: bfErr } = await supabase
        .from('brand_fonts')
        .select('id, family, display_name, file_url, weight, style')
        .order('family', { ascending: true });

      if (!bfErr && bf && bf.length) {
        const registered = new Set();
        for (const f of bf) {
          if (registered.has(f.family + '|' + f.weight + '|' + f.style)) continue;
          registered.add(f.family + '|' + f.weight + '|' + f.style);
          try {
            const face = new FontFace(f.family, `url("${f.file_url}")`, {
              weight: String(f.weight || 400),
              style: f.style || 'normal',
              display: 'swap',
            });
            face.load().then((l) => document.fonts.add(l)).catch(() => {});
          } catch (_) { /* ignore individual font failures */ }
        }
        // Editor.js reads this on init to populate the font picker.
        window.__TMKE_BRAND_FONTS__ = bf;
      }
    } catch (_) { /* fonts are optional — keep editor usable if fetch fails */ }
  </script>

  <!--
    Stock photo search — Pexels + Unsplash.
    Runs before editor.js so it can flag the bundled Photos grid as
    superseded. Actual API calls fire on user input; clicking a result
    calls `window.__TMKE_ADD_PHOTO__` (exposed by editor.js).
  -->
  <script type="module" define:vars={{ PEXELS_KEY, UNSPLASH_KEY }}>
    // PEXELS_KEY / UNSPLASH_KEY are injected by Astro via define:vars above.
    // Tell editor.js to skip its bundled library — this panel drives the grid.
    window.__TMKE_STOCK_SEARCH_ACTIVE__ = true;

    const inputEl = document.getElementById('ed-stock-input');
    const statusEl = document.getElementById('ed-stock-status');
    const gridEl = document.getElementById('ed-photo-grid');
    const srcCheckboxes = document.querySelectorAll('[data-stock-src]');

    if (!inputEl) {
      // Page didn't render the Photos pane (shouldn't happen). Bail quietly.
    } else {
      function activeSources() {
        return Array.from(srcCheckboxes)
          .filter((c) => c.checked)
          .map((c) => c.getAttribute('data-stock-src'));
      }

      function setStatus(msg, isError = false) {
        if (!statusEl) return;
        statusEl.textContent = msg;
        statusEl.classList.toggle('is-error', !!isError);
      }

      async function searchPexels(query) {
        if (!PEXELS_KEY) return [];
        try {
          const res = await fetch(
            `https://api.pexels.com/v1/search?query=${encodeURIComponent(query)}&per_page=24&orientation=portrait`,
            { headers: { Authorization: PEXELS_KEY } }
          );
          if (!res.ok) throw new Error(`Pexels ${res.status}`);
          const json = await res.json();
          return (json.photos || []).map((p) => ({
            source: 'pexels',
            id: String(p.id),
            thumb: p.src.medium,
            full: p.src.large2x || p.src.large || p.src.original,
            credit: `${p.photographer} on Pexels`,
            creditUrl: p.url,
          }));
        } catch (e) {
          console.warn('Pexels search failed', e);
          return [];
        }
      }

      async function searchUnsplash(query) {
        if (!UNSPLASH_KEY) return [];
        try {
          const res = await fetch(
            `https://api.unsplash.com/search/photos?query=${encodeURIComponent(query)}&per_page=24&orientation=portrait`,
            { headers: { Authorization: `Client-ID ${UNSPLASH_KEY}` } }
          );
          if (!res.ok) throw new Error(`Unsplash ${res.status}`);
          const json = await res.json();
          return (json.results || []).map((r) => ({
            source: 'unsplash',
            id: r.id,
            thumb: r.urls.small,
            full: r.urls.regular,
            credit: `${r.user.name} on Unsplash`,
            creditUrl: r.links.html,
            // Unsplash asks integrators to ping this URL when a photo is "used".
            downloadLocation: r.links.download_location,
          }));
        } catch (e) {
          console.warn('Unsplash search failed', e);
          return [];
        }
      }

      // Interleave two arrays so results from both sources are mixed.
      function interleave(a, b) {
        const out = [];
        const len = Math.max(a.length, b.length);
        for (let i = 0; i < len; i++) {
          if (a[i]) out.push(a[i]);
          if (b[i]) out.push(b[i]);
        }
        return out;
      }

      function renderResults(results) {
        gridEl.innerHTML = '';
        results.forEach((r) => {
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.title = `Photo by ${r.credit}`;
          btn.setAttribute('data-stock-source', r.source);
          const img = document.createElement('img');
          img.src = r.thumb;
          img.alt = r.credit;
          img.loading = 'lazy';
          btn.appendChild(img);
          btn.addEventListener('click', () => addPhoto(r));
          // Make the card draggable so users can drop it directly onto a
          // frame on the canvas to fill it. We expose the full-resolution
          // URL so the frame doesn't render the thumbnail.
          btn.draggable = true;
          btn.addEventListener('dragstart', (e) => {
            if (!e.dataTransfer) return;
            e.dataTransfer.setData('text/uri-list', r.full);
            e.dataTransfer.setData('text/plain', r.full);
            e.dataTransfer.effectAllowed = 'copy';
          });
          gridEl.appendChild(btn);
        });
      }

      async function addPhoto(r) {
        // Fire and forget — Unsplash wants this hit when a photo gets used.
        if (r.source === 'unsplash' && r.downloadLocation && UNSPLASH_KEY) {
          fetch(r.downloadLocation, {
            headers: { Authorization: `Client-ID ${UNSPLASH_KEY}` },
          }).catch(() => {});
        }
        if (typeof window.__TMKE_ADD_PHOTO__ === 'function') {
          window.__TMKE_ADD_PHOTO__(r.full);
        } else {
          console.warn('Editor not ready — __TMKE_ADD_PHOTO__ missing');
        }
      }

      let lastQuery = '';
      let debounceTimer = null;

      async function runSearch() {
        const q = inputEl.value.trim();
        if (q.length < 2) {
          gridEl.innerHTML = '';
          setStatus('Type to search — results from both sources appear here.');
          return;
        }
        if (q === lastQuery) return;
        lastQuery = q;

        const sources = activeSources();
        if (sources.length === 0) {
          setStatus('Pick at least one source (Pexels / Unsplash).', true);
          return;
        }

        setStatus(`Searching for "${q}"…`);
        const calls = [];
        if (sources.includes('pexels')) calls.push(searchPexels(q));
        if (sources.includes('unsplash')) calls.push(searchUnsplash(q));

        const [a = [], b = []] = await Promise.all(calls);
        const merged = sources.length === 2 ? interleave(a, b) : [...a, ...b];

        if (merged.length === 0) {
          gridEl.innerHTML = '';
          setStatus(`No results for "${q}". Try a different word.`, true);
          return;
        }

        renderResults(merged);
        setStatus(`${merged.length} result${merged.length === 1 ? '' : 's'} for "${q}".`);
      }

      inputEl.addEventListener('input', () => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(runSearch, 350);
      });

      inputEl.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          clearTimeout(debounceTimer);
          runSearch();
        }
      });

      srcCheckboxes.forEach((c) =>
        c.addEventListener('change', () => {
          // Force re-run when toggling sources.
          lastQuery = '';
          runSearch();
        })
      );

      if (!PEXELS_KEY && !UNSPLASH_KEY) {
        setStatus('No stock photo API keys configured. Set PUBLIC_PEXELS_API_KEY / PUBLIC_UNSPLASH_ACCESS_KEY.', true);
        inputEl.disabled = true;
      }
    }
  </script>

  <script src="/scripts/editor.js" is:inline type="module"></script>

  <!--
    Schedule-to-calendar wiring.
    Opens the Schedule modal, validates the form, rasterizes the canvas via
    the editor.js hook (window.__TMKE_RENDER_PNG_BLOB__), uploads the PNG
    to the `calendar-assets` Storage bucket, and inserts a calendar_items
    row. The deep-link param ?schedule=YYYY-MM-DD pre-fills the date when
    the user clicks "Schedule a post for this day" from /account/schedule.
  -->
  <script>
    import { supabase, isConfigured } from "../lib/supabase.js";

    const $btn      = document.getElementById("ed-schedule");
    const $modal    = document.getElementById("ed-schedule-modal");
    const $close    = document.getElementById("ed-schedule-close");
    const $cancel   = document.getElementById("ed-schedule-cancel");
    const $form     = document.getElementById("ed-schedule-form");
    const $title    = document.getElementById("ed-sched-title");
    const $date     = document.getElementById("ed-sched-date");
    const $time     = document.getElementById("ed-sched-time");
    const $caption  = document.getElementById("ed-sched-caption");
    const $submit   = document.getElementById("ed-schedule-submit");
    const $error    = document.getElementById("ed-schedule-error");

    // Bail quietly if the editor doesn't include the modal (e.g. an admin
    // build that strips it). Wrap the rest in an IIFE so we can short-
    // circuit without a top-level `return` (which is a SyntaxError in
    // ES modules).
    if ($btn && $modal && $form) wireSchedule();

    function wireSchedule() {

    // ----- helpers -----
    function ymd(d) {
      const y = d.getFullYear();
      const m = String(d.getMonth() + 1).padStart(2, "0");
      const da = String(d.getDate()).padStart(2, "0");
      return `${y}-${m}-${da}`;
    }
    function showError(msg) {
      $error.textContent = msg;
      $error.hidden = false;
    }
    function clearError() {
      $error.hidden = true;
      $error.textContent = "";
    }

    function defaultDate() {
      // Allow ?schedule=YYYY-MM-DD deep-link from the calendar's day drawer.
      const params = new URLSearchParams(location.search);
      const pre = params.get("schedule");
      if (pre && /^\d{4}-\d{2}-\d{2}$/.test(pre)) return pre;
      // Fall back to tomorrow — scheduling for today by default feels
      // panicked, and the reminder time defaults to 09:00 anyway.
      const d = new Date();
      d.setDate(d.getDate() + 1);
      return ymd(d);
    }

    function openModal() {
      clearError();
      // Pull current editor state for sensible defaults.
      const summary = (typeof window.__TMKE_EDITOR_SUMMARY__ === "function")
        ? window.__TMKE_EDITOR_SUMMARY__()
        : { filename: "design", templateId: null };
      $title.value = summary.filename || "Design";
      $date.value = defaultDate();
      // Don't clobber a time the user may have set on a previous open.
      if (!$time.value) $time.value = "09:00";

      const today = new Date();
      const todayYmd = ymd(today);
      $date.min = todayYmd; // can't schedule in the past

      $modal.hidden = false;
      // Stash templateId for the submit handler to pick up.
      $form.dataset.designRef = summary.templateId || "";
      setTimeout(() => $title.focus(), 50);
    }
    function closeModal() {
      $modal.hidden = true;
      $submit.disabled = false;
      $submit.textContent = "Schedule post";
    }

    // ----- open / close wiring -----
    $btn.addEventListener("click", openModal);
    $close.addEventListener("click", closeModal);
    $cancel.addEventListener("click", closeModal);
    $modal.addEventListener("click", (e) => { if (e.target === $modal) closeModal(); });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !$modal.hidden) closeModal();
    });

    // Auto-open the modal if we landed here via ?schedule=YYYY-MM-DD.
    // Wait a beat so the editor has a chance to render its current state
    // (so the title pre-fill picks up the right filename).
    const params = new URLSearchParams(location.search);
    if (params.get("schedule")) {
      // Only auto-open after the user has dismissed the pack-picker
      // onboarding — otherwise we'd cover it.
      const tryOpen = () => {
        const overlay = document.getElementById("ed-onboard");
        if (!overlay || overlay.classList.contains("is-gone") || overlay.hidden) {
          openModal();
        } else {
          setTimeout(tryOpen, 300);
        }
      };
      setTimeout(tryOpen, 500);
    }

    // ----- submit -----
    $form.addEventListener("submit", async (ev) => {
      ev.preventDefault();
      clearError();

      const title    = ($title.value || "").trim();
      const dateStr  = $date.value;
      const timeStr  = $time.value || "09:00";
      const caption  = ($caption.value || "").trim();
      const platform = $form.querySelector('input[name="ed-sched-platform"]:checked')?.value || "instagram";
      const designRef = $form.dataset.designRef || null;

      if (!title)   return showError("Give the post a short title — it shows on your calendar.");
      if (!dateStr) return showError("Pick a date for the post.");
      if (!isConfigured) {
        return showError("Supabase isn't configured in this environment — set PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY to enable scheduling.");
      }

      // Auth check before we spend cycles rasterizing.
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        return showError("You're signed out. Sign in again, then re-open Schedule.");
      }

      $submit.disabled = true;
      $submit.textContent = "Scheduling…";

      try {
        // 1. Rasterize the current design via the editor's hook.
        if (typeof window.__TMKE_RENDER_PNG_BLOB__ !== "function") {
          throw new Error("Editor isn't ready yet. Give it a second and try again.");
        }
        const blob = await window.__TMKE_RENDER_PNG_BLOB__();
        if (!blob || blob.size === 0) throw new Error("Couldn't render the canvas. Try again.");

        // 2. Upload to Storage. Path layout: <user_id>/<random>.png so RLS
        //    can scope by the leading path segment if we tighten later.
        const id = crypto.randomUUID();
        const path = `${session.user.id}/${id}.png`;
        const { error: upErr } = await supabase.storage
          .from("calendar-assets")
          .upload(path, blob, { contentType: "image/png", upsert: false });
        if (upErr) {
          // The bucket may not exist yet. Give a precise hint.
          if (/Bucket not found|404/i.test(upErr.message)) {
            throw new Error('Storage bucket "calendar-assets" not found. Create it in Supabase (Storage → New bucket → public), then run supabase/calendar_storage.sql.');
          }
          throw new Error(upErr.message || "Upload failed.");
        }
        const { data: pub } = supabase.storage.from("calendar-assets").getPublicUrl(path);
        const assetUrl = pub?.publicUrl || "";

        // 3. Insert the calendar row.
        const { error: insErr } = await supabase.from("calendar_items").insert({
          user_id: session.user.id,
          scheduled_date: dateStr,
          scheduled_time: timeStr,
          title,
          caption: caption || null,
          asset_url: assetUrl,
          thumbnail_url: assetUrl, // same image until we generate a real thumb
          design_ref: designRef,
          platform_hint: platform,
          status: "scheduled",
        });
        if (insErr) {
          if (/relation .* does not exist/i.test(insErr.message)) {
            throw new Error("calendar_items table is missing. Run supabase/calendar.sql in the SQL editor.");
          }
          throw new Error(insErr.message || "Couldn't save to your calendar.");
        }

        // 4. Done — close modal and bounce to the calendar so the user
        //    sees their new entry in context.
        closeModal();
        location.href = `/account/schedule?scheduled=${encodeURIComponent(dateStr)}`;
      } catch (err) {
        console.error("[schedule]", err);
        showError(err.message || "Something went wrong scheduling that post.");
        $submit.disabled = false;
        $submit.textContent = "Schedule post";
      }
    });

    // Toggle the active style on the platform radio so the visible "card"
    // matches the underlying selection (for when we light up the other
    // platforms later).
    $form.querySelectorAll('input[name="ed-sched-platform"]').forEach((r) => {
      r.addEventListener("change", () => {
        $form.querySelectorAll(".ed-sched-platform-opt").forEach((opt) => opt.classList.remove("is-active"));
        r.closest(".ed-sched-platform-opt")?.classList.add("is-active");
      });
    });

    } // end wireSchedule
  </script>

  <!-- Studio onboarding: pick a pack, then play the build-in sequence -->
  <script>
    import { supabase } from "../lib/supabase.js";

    const overlay = document.getElementById("ed-onboard");
    const grid = document.getElementById("ed-onboard-grid");
    const loading = document.getElementById("ed-onboard-loading");
    const error = document.getElementById("ed-onboard-error");
    const skipBtn = document.getElementById("ed-onboard-skip");
    const editor = document.getElementById("editor");

    function escapeHtml(s) {
      return String(s ?? "").replace(/[&<>"']/g, (c) => ({
        "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;",
      }[c]));
    }

    // Sequence: rail → top bar → canvas → panel → props. Total ~1.7s.
    function playBuildIn() {
      requestAnimationFrame(() => {
        setTimeout(() => editor.classList.add("show-rail"),  120);
        setTimeout(() => editor.classList.add("show-top"),   520);
        setTimeout(() => editor.classList.add("show-stage"), 920);
        setTimeout(() => editor.classList.add("show-panel"), 1320);
        setTimeout(() => {
          editor.classList.add("show-props");
          editor.classList.remove("is-onboarding");
        }, 1720);
      });
    }

    function closeOverlayAndBuild(selectedPack) {
      if (selectedPack) {
        try { sessionStorage.setItem("tmke.studio.pack", JSON.stringify(selectedPack)); }
        catch (_) { /* ignore */ }
      }
      overlay.classList.add("is-leaving");
      // Wait for fade, then hide entirely and start the sequence.
      setTimeout(() => {
        overlay.classList.add("is-gone");
        playBuildIn();
      }, 420);
    }

    skipBtn.addEventListener("click", () => closeOverlayAndBuild(null));

    function packCard(p) {
      return `
        <button type="button" class="ed-onboard-card" data-pack-id="${p.id}">
          <div class="ed-onboard-card-cover"${p.cover_image_url ? ` style="background-image:url('${escapeHtml(p.cover_image_url)}')"` : ""}></div>
          <div class="ed-onboard-card-body">
            ${p.category ? `<span class="ed-onboard-card-cat">${escapeHtml(p.category)}</span>` : ""}
            <h3 class="ed-onboard-card-title">${escapeHtml(p.title)}</h3>
          </div>
        </button>`;
    }

    // "Need more packs?" footer cell — previews a couple of packs the user
    // doesn't own yet and links through to the shop to buy them.
    function renderMoreCell(unowned) {
      if (!unowned.length) return;
      const previews = unowned.slice(0, 2).map((p) => `
        <a class="ed-onboard-more-pack" href="#" data-shop data-shop-slug="${escapeHtml(p.slug)}" title="${escapeHtml(p.title)}">
          <span class="ed-onboard-more-cover"${p.cover_image_url ? ` style="background-image:url('${escapeHtml(p.cover_image_url)}')"` : ""}></span>
          <span class="ed-onboard-more-name">${escapeHtml(p.title)}</span>
        </a>`).join("");
      const cell = document.createElement("div");
      cell.className = "ed-onboard-more";
      cell.innerHTML = `
        <div class="ed-onboard-more-head">
          <strong>Need more packs?</strong>
          <span>Download and buy more in The Edit.</span>
        </div>
        <div class="ed-onboard-more-list">${previews}</div>
        <a class="ed-onboard-more-cta" href="#" data-shop>Browse The Edit &rarr;</a>`;
      grid.insertAdjacentElement("afterend", cell);
    }

    (async () => {
      // Who's signed in — drives which packs they already own.
      const { data: { session } } = await supabase.auth.getSession();
      const email = session?.user?.email || "";

      // All active packs + the user's paid orders, in parallel.
      const [packsRes, ordersRes] = await Promise.all([
        supabase
          .from("packs")
          .select("id, slug, title, category, cover_image_url")
          .eq("status", "active")
          .order("sort_order", { ascending: true }),
        session
          ? supabase
              .from("orders")
              .select("pack_id, status")
              .or(`user_id.eq.${session.user.id},buyer_email.eq.${email}`)
          : Promise.resolve({ data: [], error: null }),
      ]);

      loading.hidden = true;

      if (packsRes.error) {
        error.textContent = "Couldn't load your packs — start blank or refresh to retry.";
        error.hidden = false;
        return;
      }

      const allPacks = packsRes.data ?? [];
      const ownedIds = new Set(
        (ordersRes.data ?? [])
          .filter((o) => o.status === "paid" && o.pack_id)
          .map((o) => o.pack_id)
      );

      const owned = allPacks.filter((p) => ownedIds.has(p.id));
      const unowned = allPacks.filter((p) => !ownedIds.has(p.id));

      if (owned.length === 0) {
        // Nothing purchased yet — nudge toward the shop, but the blank-canvas
        // skip button below still lets them explore the studio.
        error.innerHTML = "You haven't added any packs yet — start with a blank canvas below, or pick some up in <a href=\"#\" data-shop>The Edit</a>.";
        error.hidden = false;
        renderMoreCell(unowned);
        return;
      }

      grid.innerHTML = owned.map(packCard).join("");
      grid.hidden = false;
      renderMoreCell(unowned);

      grid.addEventListener("click", (e) => {
        const btn = e.target instanceof Element ? e.target.closest("[data-pack-id]") : null;
        if (!btn) return;
        const id = btn.getAttribute("data-pack-id");
        const pack = owned.find((p) => p.id === id);
        closeOverlayAndBuild(pack);
      });
    })();
  </script>

