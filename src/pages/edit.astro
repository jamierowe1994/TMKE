    .sad-stage.is-static [data-el="cal"],
    .sad-stage.is-static [data-el="fly"],
    .sad-stage.is-static [data-el="toast"],
    .sad-stage.is-static [data-el="marq"] { opacity: 0; }
    .sad-stage.is-static [data-tool="text"] { background: rgba(255,255,255,0.12); color: #fff; }
    .sad-stage.is-static .sad-progress { display: none; }
  </style>

  <script>
    import { supabase, gbpFromPence } from '../lib/supabase.js';

    const grid = document.getElementById('edit-grid');
    const loading = document.getElementById('edit-loading');
    const empty = document.getElementById('edit-empty');
    const wrap = document.getElementById('edit-catalogue');

    const modal = document.getElementById('checkout');
    const modalClose = document.getElementById('checkout-close');
    const stepPanes = modal.querySelectorAll('.checkout-pane');
    const stepPips = modal.querySelectorAll('.checkout-step');
    const coverEl = document.getElementById('checkout-cover');
    const pkgTitleEl = document.getElementById('checkout-pack-title');
    const pkgDescEl = document.getElementById('checkout-pack-desc');
    const pkgListEl = document.getElementById('checkout-pack-contents');
    const pkgPriceEl = document.getElementById('checkout-pack-price');

    const contactForm = document.getElementById('checkout-contact');
    const paymentForm = document.getElementById('checkout-payment');
    const contactErr = document.getElementById('ck-contact-error');
    const paymentErr = document.getElementById('ck-payment-error');
    const walletBtn = document.getElementById('ck-wallet-btn');
    const cardSubmit = document.getElementById('ck-card-submit');
    const backBtn = document.getElementById('ck-back-to-contact');
    const doneH = document.getElementById('ck-done-h');
    const doneSub = document.getElementById('ck-done-sub');

    const state = {
      pack: null,
      contact: null,
      payMethod: 'apple_pay',
    };

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    function renderShowcase(p, i) {
      const cover = (typeof p.cover_image_url === 'string' && p.cover_image_url) ? p.cover_image_url : '';
      const previews = (p.preview_images ?? []).filter((u) => typeof u === 'string' && u.length > 0);
      // The collage shows the pack's previews; hovering one flickers it into the
      // framed hero. Fall back to the cover if a pack has no separate previews.
      const collageUrls = (previews.length ? previews : (cover ? [cover] : [])).slice(0, 6);
      const thumbs = collageUrls
        .map((url) => `<button type="button" class="show-thumb" data-src="${escapeHtml(url)}" style="background-image:url('${escapeHtml(url)}')" aria-label="Preview"></button>`)
        .join('');

      const isFree = (p.price_pence ?? 0) === 0;
      const priceLabel = isFree ? 'Free' : gbpFromPence(p.price_pence);
      const num = String(i + 1).padStart(2, '0');
      const contentsCount = (p.contents ?? []).length;
      const previewItems = (p.contents ?? []).slice(0, 4);
      const insideList = previewItems.length
        ? `<ul class="show-inside">${previewItems.map((it) => `<li>${escapeHtml(it)}</li>`).join('')}</ul>`
        : '';
      const capBits = [`№ ${num}`];
      if (p.category) capBits.push(escapeHtml(p.category));
      const eyebrow = `${p.category ? escapeHtml(p.category) : 'The Edit'}${contentsCount ? ` · ${contentsCount} posts` : ''}`;

      return `
        <section class="show" data-id="${p.id}" data-slug="${escapeHtml(p.slug)}">
          <div class="show-inner">
            <div class="show-hero">
              <span class="show-ghost" data-par="30" aria-hidden="true">${num}</span>
              <a class="show-stage" href="/edit/${encodeURIComponent(p.slug)}" aria-label="See inside ${escapeHtml(p.title)}">
                <figure class="show-frame">
                  <div class="show-mount">
                    <div class="show-heroimg" data-cover="${escapeHtml(cover)}" style="background-image:url('${escapeHtml(cover)}')"></div>
                  </div>
                  <figcaption class="show-frame-cap">${capBits.join(' · ')}</figcaption>
                </figure>
              </a>
            </div>
            <div class="show-copy">
              <p class="show-eyebrow">${eyebrow}</p>
              <h2 class="show-title">${escapeHtml(p.title)}</h2>
              ${p.description ? `<p class="show-desc">${escapeHtml(p.description)}</p>` : ''}
              ${insideList}
            </div>
            <div class="show-shop">
              <div class="show-collage">${thumbs}</div>
              <div class="show-shopfoot">
                <span class="show-price">${priceLabel}</span>
                <div class="show-ctas">
                  <a class="show-see" href="/edit/${encodeURIComponent(p.slug)}">See inside</a>
                  <button type="button" class="show-buy" data-buy="${p.id}">Buy pack <em>&rarr;</em></button>
                </div>
              </div>
            </div>
          </div>
        </section>
      `;
    }

    // Hovering a collage thumbnail flickers it into the framed hero, and the
    // rest of the collage dims back (CSS). Leaving the collage restores the cover.
    function wireCollage(root) {
      root.querySelectorAll('.show').forEach((sec) => {
        const hero = sec.querySelector('.show-heroimg');
        const collage = sec.querySelector('.show-collage');
        const thumbs = [...sec.querySelectorAll('.show-thumb')];
        if (!hero || !collage || !thumbs.length) return;
        const cover = hero.dataset.cover || '';
        let raf = 0;
        const swap = (url) => {
          if (!url) return;
          hero.style.opacity = '0.18';   // flicker out…
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => setTimeout(() => {
            hero.style.backgroundImage = `url('${url}')`;
            hero.style.opacity = '1';    // …and back in on the new shot
          }, 80));
        };
        thumbs.forEach((t) => {
          const show = () => {
            thumbs.forEach((x) => x.classList.toggle('is-active', x === t));
            swap(t.dataset.src);
          };
          t.addEventListener('mouseenter', show);
          t.addEventListener('focus', show);
        });
        collage.addEventListener('mouseleave', () => {
          thumbs.forEach((x) => x.classList.remove('is-active'));
          swap(cover);
        });
      });
    }

    // Reveal each band on scroll, and gently parallax the big ghost numbers.
    function wireMotion(root) {
      const shows = [...root.querySelectorAll('.show')];
      if (!('IntersectionObserver' in window)) {
        shows.forEach((s) => s.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
        shows.forEach((s) => io.observe(s));
      }

      const parEls = [...root.querySelectorAll('[data-par]')];
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (parEls.length && !reduce) {
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight || 1;
          parEls.forEach((el) => {
            const r = el.getBoundingClientRect();
            const d = ((r.top + r.height / 2) - vh / 2) / vh;   // -0.5..0.5 across the viewport
            const amp = parseFloat(el.dataset.par) || 0;
            el.style.setProperty('--par', (-d * amp).toFixed(1) + 'px');
          });
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      }
    }

    // ===== Hero "film" =====================================================
    // Auto-plays a ~15s title sequence: template stills flip into a 4×4 grid in
    // a random order, keep firing through, settle on a full grid, then the whole
    // grid fades to empty — and loops. Pool = every image across the packs.
    function initHeroFilm(pool) {
      const grid = document.getElementById('eh-grid');
      if (!grid) return;
      pool = [...new Set((pool || []).filter((u) => typeof u === 'string' && u.length))];
      if (!pool.length) return;

      let tiles = [...grid.querySelectorAll('.eh-tile')];
      if (!tiles.length) {
        grid.innerHTML = Array.from({ length: 16 }, () => '<div class="eh-tile"><div class="eh-tile-img"></div></div>').join('');
        tiles = [...grid.querySelectorAll('.eh-tile')];
      }

      const shuffle = (a) => { a = a.slice(); for (let i = a.length - 1; i > 0; i--) { const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; };
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (reduce) {
        const imgs = shuffle(pool);
        tiles.forEach((t, i) => { t.classList.add('is-on'); t.querySelector('.eh-tile-img').style.backgroundImage = `url('${imgs[i % imgs.length]}')`; });
        return;
      }

      // Preload so flips don't show empty cells on first pass.
      pool.forEach((u) => { const im = new Image(); im.src = u; });

      let timers = [];
      let bag = [];
      const nextImg = () => { if (!bag.length) bag = shuffle(pool); return bag.pop(); };
      const setTile = (t, url) => {
        const img = t.querySelector('.eh-tile-img');
        img.style.backgroundImage = `url('${url}')`;
        t.classList.add('is-on');
        t.classList.remove('is-pop'); void t.offsetWidth; t.classList.add('is-pop');
      };

      const FILL_START = 500, FILL_END = 10000, FADE_AT = 13000, LOOP_AT = 15400;

      function run() {
        timers.forEach(clearTimeout); timers = [];
        grid.classList.remove('is-fading');
        tiles.forEach((t) => { t.classList.remove('is-on', 'is-pop'); t.querySelector('.eh-tile-img').style.backgroundImage = ''; });
        bag = [];

        // 1) reveal each cell once, in a random order, accelerating to the end.
        const order = shuffle(tiles.map((_, i) => i));
        order.forEach((cellIdx, n) => {
          const frac = order.length > 1 ? n / (order.length - 1) : 0;
          const at = n === 0 ? FILL_START : FILL_START + 600 + Math.pow(frac, 1.5) * (FILL_END - FILL_START - 600);
          timers.push(setTimeout(() => setTile(tiles[cellIdx], nextImg()), at));
        });

        // 2) "fire through" — keep re-flipping already-revealed cells to new stills.
        for (let at = 2400; at < FILL_END; at += 140 + Math.random() * 170) {
          const when = at;
          timers.push(setTimeout(() => {
            const on = tiles.filter((t) => t.classList.contains('is-on'));
            if (on.length) setTile(on[Math.floor(Math.random() * on.length)], nextImg());
          }, when));
        }

        // 3) hold the full grid → fade to empty → loop.
        timers.push(setTimeout(() => grid.classList.add('is-fading'), FADE_AT));
        timers.push(setTimeout(run, LOOP_AT));
      }

      // Kick off once the hero is on screen (it's at the top, so ~immediately).
      if ('IntersectionObserver' in window) {
        let started = false;
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => { if (e.isIntersecting && !started) { started = true; run(); io.disconnect(); } });
        }, { threshold: 0.2 });
        io.observe(grid);
      } else { run(); }
    }

    let packsById = new Map();

    // Dev/preview-only sample packs so the showcase is visible before any packs
    // exist in Supabase. Never shown in production (real packs or the empty
    // state). Images are local placeholders from /public/assets.
    const SAMPLE_PACKS = [
      {
        id: 'sample-new-instruction', slug: 'new-instruction', category: 'Listings',
        title: 'New Instruction', price_pence: 29900,
        description: 'The full launch moment for a fresh listing — coming-soon teasers, a just-listed carousel and matching story covers that make every new instruction feel like an event.',
        cover_image_url: '/assets/home%20kitchen.jpg',
        preview_images: ['/assets/cosy%20home.jpg', '/assets/sitting%20chair.jpg', '/assets/home%20chair.jpg', '/assets/home%20window.jpg', '/assets/Doors.jpg', '/assets/outside.jpg'],
        contents: ['9 feed posts', '6 story covers', 'Just-listed carousel', 'Coming-soon teaser'],
      },
      {
        id: 'sample-just-sold', slug: 'just-sold', category: 'Social Proof',
        title: 'Just Sold', price_pence: 24900,
        description: 'Turn every completion into content. A celebratory “sold” set with testimonial frames and before/after layouts that keep your pipeline warm.',
        cover_image_url: '/assets/Home-window.jpg',
        preview_images: ['/assets/home%20chair.jpg', '/assets/Doors.jpg', '/assets/doors-open.png', '/assets/home%20forest.jpg', '/assets/cosy%20home.jpg', '/assets/sitting%20chair.jpg'],
        contents: ['8 feed posts', 'Testimonial frames', 'Before / after layout', 'Sold-board story'],
      },
      {
        id: 'sample-market-update', slug: 'market-update', category: 'Authority',
        title: 'Market Update', price_pence: 19900,
        description: 'Position yourself as the local expert — clean, data-led templates for monthly market notes, tips and “ask the agent” prompts.',
        cover_image_url: '/assets/outside.jpg',
        preview_images: ['/assets/home%20forest.jpg', '/assets/tea.jpg', '/assets/home%20deer.jpg', '/assets/home%20ginger.jpg', '/assets/vibes.jpg', '/assets/cosy%20home.jpg'],
        contents: ['6 feed posts', 'Stat / chart frames', 'Tip-of-the-week set', 'Q&A story template'],
      },
      {
        id: 'sample-meet-the-team', slug: 'meet-the-team', category: 'Brand',
        title: 'Meet the Team', price_pence: 17900,
        description: 'Put faces to the name. A warm personal-brand set for team intros, day-in-the-life stories and the human side of your agency.',
        cover_image_url: '/assets/social%20media.jpg',
        preview_images: ['/assets/Danni.png', '/assets/Abbie.png', '/assets/June1.png', '/assets/abbie%202.png', '/assets/Danni%202.png', '/assets/vibes.jpg'],
        contents: ['7 feed posts', 'Team intro frames', 'Day-in-the-life story', 'Quote cards'],
      },
    ];

    (async () => {
      const { data, error } = await supabase
        .from('packs')
        .select('id, slug, title, description, price_pence, cover_image_url, preview_images, contents, category, sort_order')
        .eq('status', 'active')
        .order('sort_order', { ascending: true })
        .order('created_at', { ascending: false })
        .limit(8);

      loading.hidden = true;
      wrap.setAttribute('aria-busy', 'false');

      let packs = (!error && data) ? data : [];
      // Show the sample showcase locally when there's no live data yet.
      if (packs.length === 0 && import.meta.env.DEV) packs = SAMPLE_PACKS;

      if (error && !import.meta.env.DEV) {
        empty.hidden = false;
        empty.innerHTML = `<p>Could not load the catalogue right now — please try again shortly.</p>`;
        return;
      }
      if (packs.length === 0) { empty.hidden = false; return; }

      packsById = new Map(packs.map((p) => [p.id, p]));
      grid.innerHTML = packs.map((p, i) => renderShowcase(p, i)).join('');
      wireCollage(grid);
      wireMotion(grid);
      maybeOpenFromQuery();

      // Feed the hero "film" every image across the packs.
      initHeroFilm(packs.flatMap((p) => [p.cover_image_url, ...(p.preview_images ?? [])]));
    })();

    // ============== Modal helpers ==============
    function showStep(step) {
      stepPanes.forEach((p) => p.classList.toggle('is-active', p.dataset.step === step));
      const order = ['contact', 'payment', 'done'];
      const idx = order.indexOf(step);
      stepPips.forEach((pip) => {
        const i = order.indexOf(pip.dataset.stepPip);
        pip.classList.toggle('is-active', i === idx);
        pip.classList.toggle('is-done', i < idx);
      });
    }

    function openCheckout(pack) {
      state.pack = pack;
      state.contact = null;
      state.payMethod = 'apple_pay';

      pkgTitleEl.textContent = pack.title;
      pkgDescEl.textContent = pack.description ?? '';
      pkgListEl.innerHTML = (pack.contents ?? []).slice(0, 4).map((c) => `<li>${escapeHtml(c)}</li>`).join('');
      pkgPriceEl.textContent = gbpFromPence(pack.price_pence);
      coverEl.style.backgroundImage = pack.cover_image_url ? `url('${pack.cover_image_url}')` : '';

      // Update £ amount on payment step in two places
      modal.querySelectorAll('[data-bind="amount"]').forEach((el) => {
        el.textContent = gbpFromPence(pack.price_pence);
      });

      // Reset form state
      contactForm.reset();
      paymentForm.reset();
      contactErr.hidden = true; paymentErr.hidden = true;
      selectPayMethod('apple_pay');

      showStep('contact');
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => contactForm.elements.name.focus(), 60);
    }

    function closeCheckout() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }

    grid.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      // Only the explicit Buy button opens checkout. Clicking elsewhere on
      // the card follows the wrapping <a> to the pack-detail page.
      const buyEl = target.closest('[data-buy]');
      if (!buyEl) return;
      e.preventDefault();
      const id = buyEl.getAttribute('data-buy');
      if (!id) return;
      const pack = packsById.get(id);
      if (pack) openCheckout(pack);
    });

    // ?buy=<id> deep-link: pack-detail page sends users back here to
    // trigger the checkout modal for a specific pack.
    function maybeOpenFromQuery() {
      const want = new URLSearchParams(location.search).get('buy');
      if (!want) return;
      const pack = packsById.get(want);
      if (pack) {
        openCheckout(pack);
        // Clean the URL so refreshes don't re-open the modal
        const u = new URL(location.href);
        u.searchParams.delete('buy');
        history.replaceState({}, '', u.toString());
      }
    }

    modalClose.addEventListener('click', closeCheckout);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeCheckout(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeCheckout();
    });

    // ============== Step 1: contact ==============
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      contactErr.hidden = true;
      const fd = new FormData(contactForm);
      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      const phone = String(fd.get('phone') || '').trim();
      const company = String(fd.get('company') || '').trim();
      if (!name || !email || !phone || !company) {
        contactErr.textContent = 'Please complete every field so we can email your library link.';
        contactErr.hidden = false;
        return;
      }
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        contactErr.textContent = 'That email doesn’t look quite right — double-check it?';
        contactErr.hidden = false;
        return;
      }
      state.contact = { name, email, phone, company };
      showStep('payment');
    });

    // ============== Step 2: payment ==============
    function selectPayMethod(method) {
      state.payMethod = method;
      modal.querySelectorAll('.ck-paytab').forEach((tab) => {
        const active = tab.dataset.pay === method;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      const wallet = modal.querySelector('[data-paypane="wallet"]');
      const card = modal.querySelector('[data-paypane="card"]');
      const isWallet = method !== 'card';
      wallet.hidden = !isWallet;
      card.hidden = isWallet;
      if (isWallet) {
        const label = walletBtn.querySelector('.ck-wallet-btn-label');
        label.innerHTML = method === 'apple_pay'
          ? 'Pay with <strong> Pay</strong>'
          : 'Pay with <strong>G Pay</strong>';
        walletBtn.dataset.wallet = method;
      }
    }

    modal.querySelectorAll('.ck-paytab').forEach((tab) => {
      tab.addEventListener('click', () => selectPayMethod(tab.dataset.pay));
    });

    backBtn.addEventListener('click', () => showStep('contact'));

    walletBtn.addEventListener('click', () => processPayment());

    paymentForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (state.payMethod !== 'card') { processPayment(); return; }
      paymentErr.hidden = true;
      const fd = new FormData(paymentForm);
      const num = String(fd.get('card_number') || '').replace(/\s+/g, '');
      const exp = String(fd.get('card_exp') || '').trim();
      const cvc = String(fd.get('card_cvc') || '').trim();
      const postcode = String(fd.get('card_postcode') || '').trim();
      if (num.length < 12 || exp.length < 4 || cvc.length < 3 || !postcode) {
        paymentErr.textContent = 'Please complete your card details before paying.';
        paymentErr.hidden = false;
        return;
      }
      processPayment();
    });

    // ============== Step 3: processing → redirect ==============
    async function processPayment() {
      showStep('done');
      doneH.textContent = state.payMethod === 'card' ? 'Charging your card…' : 'Authenticating with your wallet…';
      doneSub.textContent = "This usually takes a few seconds. Please don't refresh.";

      // STUB: simulate the network round-trip. Real Stripe wiring lives behind
      // a Supabase edge function that exchanges this for a PaymentIntent.
      await new Promise((r) => setTimeout(r, 1400));

      const { pack, contact, payMethod } = state;
      const payment_ref = 'stub_' + Math.random().toString(36).slice(2, 12);

      const { data, error } = await supabase
        .from('orders')
        .insert({
          pack_id: pack.id,
          pack_slug: pack.slug,
          pack_title: pack.title,
          amount_pence: pack.price_pence,
          buyer_name: contact.name,
          buyer_email: contact.email,
          buyer_phone: contact.phone,
          buyer_company: contact.company,
          payment_method: payMethod,
          payment_ref,
          status: 'paid',
        })
        .select('id, invoice_number')
        .single();

      if (error || !data) {
        doneH.textContent = 'Something went wrong';
        doneSub.textContent = error?.message || 'Could not record the order. Please try again.';
        return;
      }

      // Stash a temporary handle so /edit/thanks can show the receipt while
      // also being reachable via the email link (?order=ID).
      try {
        sessionStorage.setItem('tmke.lastOrder', JSON.stringify({
          id: data.id,
          invoice_number: data.invoice_number,
          email: contact.email,
        }));
      } catch (_) { /* ignore */ }

      window.location.href = `/edit/thanks?order=${encodeURIComponent(data.id)}`;
    }

  </script>

  <script>
    // Studio demo: only run the loop while it's on screen (perf), and fall
    // back to a composed still for visitors who prefer reduced motion.
    (() => {
      const fig = document.querySelector('[data-studio-demo]');
      if (!fig) return;
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        fig.classList.add('is-static');
        return;
      }
      if (!('IntersectionObserver' in window)) { fig.classList.add('is-live'); return; }
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => fig.classList.toggle('is-live', e.isIntersecting));
      }, { threshold: 0.2 });
      io.observe(fig);
    })();
  </script>
</BaseLayout>
