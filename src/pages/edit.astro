    /* work area: rail · canvas · panel */
    .sad-work { position: absolute; top: 9%; left: 0; right: 0; bottom: 0; display: flex; }
    .sad-rail {
      flex: 0 0 var(--rail); display: flex; flex-direction: column; align-items: center;
