    .sad-sw-row, .sad-bg-row, .sad-size-row { display: flex; gap: clamp(4px, 0.5vw, 8px); }
    .sad-sw { flex: 1; aspect-ratio: 1; border-radius: 50%; }
    .sad-bg { flex: 1; aspect-ratio: 1; border-radius: 6px; }
    .sad-size { flex: 1; aspect-ratio: 1; border-radius: 5px; background: rgba(255,255,255,0.07); }
    .sad-size--more { display: flex; align-items: center; justify-content: center; color: rgba(255,255,255,0.5); font-size: 12px; letter-spacing: 1px; }

    /* mini calendar that rises in for the schedule beat */
    .sad-cal {
