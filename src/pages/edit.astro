    .sad-check { width: 1.15em; height: 1.15em; border-radius: 50%; background: #4caf72; position: relative; flex: 0 0 auto; }
    .sad-check::after { content: ""; position: absolute; left: 35%; top: 18%; width: 26%; height: 50%; border: solid #fff; border-width: 0 2px 2px 0; transform: rotate(45deg); }

    /* the cursor */
    .sad-cursor { position: absolute; left: 40%; top: 54%; width: clamp(16px, 1.6vw, 26px); z-index: 7; filter: drop-shadow(0 2px 3px rgba(0,0,0,0.5)); pointer-events: none; }
    .sad-cursor svg { width: 100%; height: auto; display: block; fill: #fff; stroke: #1c1d22; stroke-width: 1.1; }

    /* loop progress hairline */
    .sad-progress { position: absolute; left: 0; right: 0; bottom: 0; height: 3px; background: rgba(28,29,34,0.08); border-radius: 999px; overflow: hidden; }
    .sad-progress i { display: block; height: 100%; width: 0; background: var(--english-violet); }

    /* ---------- the 20s timeline (every element shares it) ---------- */
    .sad-anim { animation-duration: 20s; animation-iteration-count: infinite; animation-timing-function: linear; }
    [data-el="cursor"] { animation-name: sadCursor; animation-timing-function: cubic-bezier(.5,.1,.4,1); }
    [data-el="t1"] { animation-name: sadT1; }
    [data-el="t2"] { animation-name: sadT2; }
    [data-el="t3"] { animation-name: sadT3; }
    [data-el="logo"] { animation-name: sadLogo; }
    [data-el="accent"] { animation-name: sadAccent; }
    [data-el="marq"] { animation-name: sadMarq; }
    [data-el="sched"] { animation-name: sadSched; }
    [data-el="sw"] { animation-name: sadSw; }
    [data-tool="templates"] { animation-name: sadTpl; }
    [data-tool="text"] { animation-name: sadText; }
    [data-tool="brand"] { animation-name: sadBrand; }
    [data-el="cal"] { animation-name: sadCal; animation-timing-function: cubic-bezier(.4,1.2,.4,1); }
    [data-el="cell"] { animation-name: sadCell; }
    [data-el="fly"] { animation-name: sadFly; animation-timing-function: cubic-bezier(.5,.1,.4,1); }
    [data-el="toast"] { animation-name: sadToast; animation-timing-function: cubic-bezier(.3,1.3,.5,1); }
    .sad-progress i { animation-name: sadProg; }

    @keyframes sadCursor {
      0%   { left: 40%; top: 54%; }
      7%   { left: 40%; top: 54%; }
      11%  { left: 4.2%; top: 24%; }
      14%  { left: 4.2%; top: 24%; }
      18%  { left: 26%; top: 40%; }
      30%  { left: 33%; top: 52%; }
      40%  { left: 32%; top: 50%; }
      44%  { left: 4.2%; top: 55%; }
      47%  { left: 4.2%; top: 55%; }
      51%  { left: 84%; top: 36%; }
      56%  { left: 84%; top: 36%; }
      60%  { left: 90%; top: 5%; }
      64%  { left: 90%; top: 5%; }
      69%  { left: 36%; top: 48%; }
      74%  { left: 37%; top: 64%; }
