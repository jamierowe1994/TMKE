    .sad-pane-h { font-size: clamp(8px, 0.78vw, 11px); font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(255,255,255,0.42); margin-top: clamp(4px, 0.8vh, 10px); }
    .sad-aa {
      width: 100%; height: clamp(22px, 4vh, 40px); border-radius: 6px;
