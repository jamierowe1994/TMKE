---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="The Edit — Template Shop · TMKE"
  description="A curated shop of social media templates designed specifically for the UK property sector. On-brand, easy to customise, ready to post."
>
  <!-- Hero — a fixed brand backdrop with the featured pack's copy inset on the
       left and the pack covers as a clickable reel on the right. No autoplay;
       click a cover (or a dot) to feature it. JS fills every slot (setupHero). -->
  <script is:inline>document.body.classList.add("edit-page");</script>
  <style is:global>
    /* Keep the fixed nav legible where it floats over the dark hero (top only —
       once scrolled it takes its usual light bar back). */
    body.edit-page .nav:not(.scrolled) { color: var(--paper); }
    body.edit-page .nav:not(.scrolled) .nav-menu-btn-glyph span { background: var(--paper); }
  </style>
  <header class="eh2" id="edit-hero2" aria-label="The Edit — featured packs">
    <div class="eh2-inner">
      <!-- Dictionary-lede structure (mirrors the About hero). The title band —
           category + pack name — sits ABOVE the images. Below a gap, the body
           block drops to the base of the covers so the button's bottom lines up
           with the images' bottom. -->
      <div class="eh2-head" id="eh2-head">
        <h1 class="eh2-cat" id="eh2-cat">The Edit</h1>
        <p class="eh2-name"><span class="eh2-name-full" id="eh2-name">The Edit</span></p>
      </div>

      <div class="eh2-lower">
        <div class="eh2-copy" id="eh2-copy">
          <p class="eh2-bio" id="eh2-bio"></p>
          <a class="eh2-more" id="eh2-more" href="#edit-catalogue">See more <span aria-hidden="true">&rarr;</span></a>
        </div>

        <div class="eh2-reel" id="eh2-reel" role="tablist" aria-label="Choose a pack"></div>
      </div>
    </div>

    <div class="eh2-controls">
      <div class="eh2-dots" id="eh2-dots" aria-label="Choose a pack"></div>
    </div>
  </header>

  <section class="edit-wrap" id="edit-catalogue" aria-busy="true">
    <div class="edit-loading" id="edit-loading">Loading the catalogue…</div>
    <div class="edit-empty" id="edit-empty" hidden>
      <p>The shop is opening soon — packs will appear here as they're added to The Edit.</p>
    </div>
    <div class="edit-shows" id="edit-grid"></div>
  </section>

  <!-- =========================================================
       Checkout modal — three steps: contact → payment → processing
       ========================================================= -->
  <div class="checkout-backdrop" id="checkout" hidden>
    <div class="checkout" role="dialog" aria-modal="true" aria-labelledby="checkout-title">
      <button type="button" class="checkout-close" id="checkout-close" aria-label="Close">&times;</button>

      <aside class="checkout-aside">
        <div class="checkout-aside-cover" id="checkout-cover"></div>
        <div class="checkout-aside-body">
          <div class="checkout-aside-eyebrow">You're buying</div>
          <h3 class="checkout-aside-title" id="checkout-pack-title">Pack title</h3>
          <p class="checkout-aside-desc" id="checkout-pack-desc"></p>
          <ul class="checkout-aside-list" id="checkout-pack-contents"></ul>
          <div class="checkout-aside-foot">
            <span class="checkout-aside-label">Total today</span>
            <span class="checkout-aside-total" id="checkout-pack-price">£299</span>
          </div>
        </div>
      </aside>

      <section class="checkout-main">
        <header class="checkout-steps">
          <span class="checkout-step is-active" data-step-pip="contact">
            <em>01</em> Your details
          </span>
          <span class="checkout-step" data-step-pip="payment">
            <em>02</em> Payment
          </span>
          <span class="checkout-step" data-step-pip="done">
            <em>03</em> Confirmation
          </span>
        </header>

        <!-- Step 1: contact details -->
        <form class="checkout-pane is-active" id="checkout-contact" data-step="contact" novalidate>
          <h2 id="checkout-title" class="checkout-h">Tell us where to send it.</h2>
          <p class="checkout-sub">Your library link and invoice will be emailed to the address below.</p>

          <label class="ck-field">
            <span>Full name</span>
            <input name="name" type="text" required autocomplete="name" />
          </label>
          <label class="ck-field">
            <span>Email</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>
          <div class="ck-row">
            <label class="ck-field">
              <span>Phone</span>
              <input name="phone" type="tel" required autocomplete="tel" />
            </label>
            <label class="ck-field">
              <span>Company / Brand</span>
              <input name="company" type="text" required autocomplete="organization" />
            </label>
          </div>

          <p class="ck-error" id="ck-contact-error" hidden></p>
          <button type="submit" class="ck-cta">Continue to payment <em>&rarr;</em></button>
          <p class="ck-mini">By continuing you agree to our terms. Card details are entered securely on the next step.</p>
        </form>

        <!-- Step 2: payment -->
        <form class="checkout-pane" id="checkout-payment" data-step="payment" novalidate>
          <h2 class="checkout-h">How would you like to pay?</h2>
          <p class="checkout-sub">All transactions are in GBP. You can pay using Apple Pay, Google Pay, or a card.</p>

          <div class="ck-paytabs" role="tablist" aria-label="Payment method">
            <button type="button" class="ck-paytab is-active" data-pay="apple_pay" role="tab" aria-selected="true">
              <span class="ck-paytab-logo" aria-hidden="true"></span>
              <span>Apple Pay</span>
            </button>
            <button type="button" class="ck-paytab" data-pay="google_pay" role="tab" aria-selected="false">
              <span class="ck-paytab-logo ck-paytab-logo--g" aria-hidden="true"></span>
              <span>Google Pay</span>
            </button>
            <button type="button" class="ck-paytab" data-pay="card" role="tab" aria-selected="false">
              <span class="ck-paytab-logo ck-paytab-logo--card" aria-hidden="true"></span>
              <span>Card</span>
            </button>
          </div>

          <!-- Apple / Google Pay panel -->
          <div class="ck-wallet" data-paypane="wallet">
            <div class="ck-wallet-frame">
              <div class="ck-wallet-row">
                <span>Pay TMKE</span>
                <span class="ck-wallet-amount" data-bind="amount">£299</span>
              </div>
              <button type="button" class="ck-wallet-btn" id="ck-wallet-btn">
                <span class="ck-wallet-btn-glyph" aria-hidden="true"></span>
                <span class="ck-wallet-btn-label">Pay with <strong>Apple Pay</strong></span>
              </button>
              <p class="ck-wallet-note">Authentication will appear on your device.</p>
            </div>
          </div>

          <!-- Card panel -->
          <div class="ck-card" data-paypane="card" hidden>
            <label class="ck-field">
              <span>Card number</span>
              <input name="card_number" inputmode="numeric" autocomplete="cc-number" placeholder="1234 1234 1234 1234" maxlength="23" />
            </label>
            <div class="ck-row">
              <label class="ck-field">
                <span>Expiry</span>
                <input name="card_exp" autocomplete="cc-exp" placeholder="MM / YY" maxlength="7" />
              </label>
              <label class="ck-field">
                <span>CVC</span>
                <input name="card_cvc" inputmode="numeric" autocomplete="cc-csc" placeholder="123" maxlength="4" />
              </label>
              <label class="ck-field">
                <span>Postcode</span>
                <input name="card_postcode" autocomplete="postal-code" placeholder="SW1A 1AA" maxlength="8" />
              </label>
            </div>
            <button type="submit" class="ck-cta" id="ck-card-submit">
              Pay <span data-bind="amount">£299</span> <em>&rarr;</em>
            </button>
          </div>

          <p class="ck-error" id="ck-payment-error" hidden></p>
          <button type="button" class="ck-back" id="ck-back-to-contact">&larr; Back to your details</button>
        </form>

        <!-- Step 3: processing / done -->
        <div class="checkout-pane" data-step="done">
          <div class="ck-done">
            <div class="ck-done-spinner" id="ck-done-spinner">
              <span class="ck-done-ring"></span>
              <span class="ck-done-ring"></span>
              <span class="ck-done-ring"></span>
            </div>
            <h2 class="checkout-h" id="ck-done-h">Processing payment…</h2>
            <p class="checkout-sub" id="ck-done-sub">Authenticating with your wallet. Please don't refresh.</p>
          </div>
        </div>
      </section>
    </div>
  </div>

  <style is:global>
    /* The Edit's hero sits further down the page than the default —
       gives the headline more breathing room beneath the nav.
       (Scoped to this page only — Astro emits the style on /edit alone.) */
    /* Two classes needed (.page-hero.wrap) so we win the cascade over
       the global .wrap rule, which uses the shorthand `padding: 0 36px`
       and would otherwise reset padding-top to 0. */
    .page-hero.wrap { padding-top: 200px; }

    /* ===== The Edit — featured-pack hero =====
       A fixed brand backdrop; the featured pack's copy is inset on the left and
       the pack covers sit as a clickable reel on the right. ===== */

    .eh2 {
      position: relative; z-index: 1;
      margin: 0;
      height: 100svh; min-height: 560px;
      overflow: hidden; isolation: isolate;
      /* Full-bleed fixed brand backdrop (a darker, editorial scene). */
      background: #17151b url("https://assets.tmke.co.uk/Untitled%20design%20-%202026-07-05T133629.509.png") center / cover no-repeat;
      color: var(--paper);
      font-family: var(--sans);
    }
    /* A dark fade rising from the bottom for drama (+ a light-copy lift on the
       left so the headline always reads over the scene). */
    .eh2::after {
      content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
      background:
        linear-gradient(0deg, rgba(15,13,18,0.78) 0%, rgba(15,13,18,0.28) 20%, rgba(15,13,18,0) 40%),
        linear-gradient(90deg, rgba(15,13,18,0.72) 0%, rgba(15,13,18,0.4) 28%, rgba(15,13,18,0.05) 52%, rgba(15,13,18,0) 62%);
    }

    /* Inner content is held in the SAME centred container as the pack catalogue
       below (max-width 1360, 76px gutters) so the copy's left edge lines up with
       card one and the reel's right edge lines up with card three. The block is a
       column — title band on top, then a gap, then the body + covers row — and is
       vertically centred for equal top/bottom margins. */
    .eh2-inner {
      position: absolute; inset: 0; z-index: 2;
      max-width: 1360px; margin: 0 auto; box-sizing: border-box;
      display: flex; flex-direction: column; justify-content: center;
      gap: clamp(30px, 5.5vh, 68px);
      /* Equal top/bottom padding so the centred block has equal margins. */
      padding: clamp(96px, 12vh, 124px) 76px;
    }

    /* ---- Title band (top) — the About-page "dictionary" lede: the category is
       the big one-word title, the pack name sits in the pronunciation slot. It
       sits above the line where the covers start. ---- */
    .eh2-head {
      transition: opacity 0.4s ease, transform 0.55s cubic-bezier(.2,.8,.2,1);
    }
    .eh2-head.is-swap { opacity: 0; transform: translateY(14px); }
    .eh2-cat {
      margin: 0; font-family: var(--serif); font-weight: 500;
      font-size: clamp(38px, 4.6vw, 68px); line-height: 0.94; letter-spacing: 0.02em;
      color: var(--paper); text-shadow: 0 2px 30px rgba(0,0,0,0.5);
    }
    .eh2-name {
      display: flex; align-items: baseline; flex-wrap: wrap; gap: 10px;
      margin: 14px 0 0;
    }
    .eh2-name-full {
      font-family: var(--serif); font-size: clamp(15px, 1.3vw, 20px);
      letter-spacing: 0.02em; color: rgba(244,242,241,0.82);
      text-shadow: 0 1px 16px rgba(0,0,0,0.5);
    }

    /* ---- Lower row — body (left) + covers (right). The body block drops to the
       base of the covers so the button's bottom lines up with the images'
       bottom, opening a gap under the title band. ---- */
    .eh2-lower {
      display: flex; align-items: flex-end; gap: clamp(30px, 4.5vw, 72px);
    }
    .eh2-copy {
      flex: 0 0 clamp(300px, 38%, 452px); box-sizing: border-box;
      transition: opacity 0.4s ease, transform 0.55s cubic-bezier(.2,.8,.2,1);
    }
    .eh2-copy.is-swap { opacity: 0; transform: translateY(14px); }
    .eh2-bio {
      margin: 0; max-width: 44ch;
      font-family: var(--sans);
      font-size: clamp(14px, 1.05vw, 16px); line-height: 1.66;
      color: rgba(244,242,241,0.82); text-shadow: 0 1px 18px rgba(0,0,0,0.5);
      /* Clamp every body to a uniform five lines so they all match. */
      display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 5;
      overflow: hidden; min-height: calc(1.66em * 5);
    }
    .eh2-more {
      display: inline-flex; align-items: center; gap: 10px; margin-top: 22px;
      font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--paper); background: var(--english-violet); text-decoration: none;
      padding: 14px 26px; border-radius: 3px;
      transition: background 0.25s, transform 0.4s cubic-bezier(.2,.7,.2,1);
    }
    .eh2-more span { transition: transform 0.3s; }
    .eh2-more:hover { background: #4a2836; transform: translateY(-1px); }
    .eh2-more:hover span { transform: translateX(4px); }

    /* ---- Cover reel (right) — covers share the remaining width equally and are
       right-aligned, so the last cover's right edge lands on the container edge
       (= the third pack card's right edge below). Uniform size keeps them aligned
       at rest; the active one scales in place (a slight overhang when selected). */
    .eh2-reel {
      flex: 1 1 auto; min-width: 0;
      display: flex; align-items: flex-start; justify-content: flex-end;
      gap: clamp(12px, 1.3vw, 18px);
    }
    .eh2-tile {
      position: relative; flex: 1 1 0; min-width: 0; aspect-ratio: 3 / 4;
      border: 0; padding: 0; cursor: pointer;
      border-radius: 8px; overflow: hidden;
      background-size: cover; background-position: center; background-color: #241f2a;
      opacity: 0.58; filter: saturate(0.92);
      box-shadow: 0 12px 30px rgba(0,0,0,0.4);
      transition: transform 0.45s cubic-bezier(.2,.8,.2,1), opacity 0.4s ease, box-shadow 0.4s ease, outline-color 0.3s ease;
      outline: 1px solid transparent; outline-offset: 3px;
    }
    .eh2-tile:hover { opacity: 0.85; }
    .eh2-tile.is-active {
      opacity: 1; filter: none; z-index: 2; transform: scale(1.06);
      outline-color: var(--paper);
      box-shadow: 0 26px 60px rgba(0,0,0,0.55);
    }

    /* ---- Controls (bottom): dots only — click a dot (or a cover) to switch ---- */
    .eh2-controls {
      position: absolute; z-index: 3; left: 0; right: 0;
      bottom: clamp(22px, 3.6vh, 38px);
      display: flex; justify-content: center;
    }
    .eh2-dots { display: flex; align-items: center; gap: 11px; }
    .eh2-dot {
      width: 9px; height: 9px; border-radius: 50%; padding: 0; cursor: pointer;
      border: 1px solid rgba(244,242,241,0.6); background: transparent;
      transition: background 0.3s, border-color 0.3s, transform 0.3s;
    }
    .eh2-dot:hover { background: rgba(244,242,241,0.4); }
    .eh2-dot.is-active { background: var(--paper); border-color: var(--paper); transform: scale(1.2); }

    /* Keep the copy's left edge and the reel's right edge on the site gutters
       (36px / 22px) at the container's breakpoints, matching the catalogue. */
    @media (max-width: 980px) {
      .eh2-inner { padding-left: 36px; padding-right: 36px; }
    }

    /* ---- Mobile: title band, then body, then the reel — all stacked ---- */
    @media (max-width: 880px) {
      .eh2 { height: auto; min-height: 100svh; }
      .eh2-inner {
        position: relative; justify-content: center; gap: 22px;
        padding: clamp(104px, 15vh, 150px) 22px 116px;
      }
      .eh2-lower { flex-direction: column; align-items: stretch; gap: 24px; }
      .eh2-copy { flex: 0 0 auto; }
      .eh2-reel { justify-content: flex-start; margin: 0 -22px; padding: 4px 22px; overflow-x: auto; }
      .eh2-tile { flex: 0 0 auto; width: clamp(128px, 34vw, 180px); }
    }
    @media (prefers-reduced-motion: reduce) {
      .eh2-tile, .eh2-feature { transition: opacity 0.2s ease; }
    }
    /* ====== STRIPPED — studio demo moved to the homepage Chapter 5 ====== */

    /* Global so the JS-injected catalogue cards inherit the styles —
       Astro scopes by data-attribute which dynamic innerHTML never gets. */
    /* Full-width catalogue — fills the viewport (same side padding as the hero)
       and the 12-col mosaic scales fluidly with the screen size. */
    /* Centred on the page with the site-standard content width + gutters (same
       as .wrap), so the packs sit with equal margins left and right. */
    .edit-wrap {
      position: relative;
      z-index: 1;
      max-width: 1360px;
      margin: 0 auto;
      padding: 0 76px 180px;
    }
    @media (max-width: 980px) { .edit-wrap { padding: 0 36px 130px; } }
    @media (max-width: 560px) { .edit-wrap { padding: 0 22px 110px; } }
    .edit-loading,
    .edit-empty {
      font-family: var(--sans);
      font-size: 14px;
      color: rgba(28,29,34,0.55);
      padding: 32px 0;
    }
    .edit-empty p { max-width: 520px; line-height: 1.6; }

    /* ============ Showcase — alternating feature bands ============
       Each pack is its own editorial "feature": a matted, framed hero print with
       supporting photos clustered around it on one side, and the pack's story +
       price + CTA on the other. Rows alternate (image left / right) and reveal as
       they scroll into view. */
    .edit-shows {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: clamp(30px, 3.2vw, 64px);
      max-width: none;              /* fills the centred .edit-wrap → equal margins */
      margin: 0;
      padding-top: clamp(16px, 4vh, 48px);
    }
    @media (max-width: 900px) { .edit-shows { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .edit-shows { grid-template-columns: 1fr; } }

    /* Simple shop card — cover, name, type, Pack Size + Discover (mirrors the hero). */
    .pcard { display: flex; flex-direction: column; opacity: 0; transform: translateY(28px);
      transition: opacity 0.9s cubic-bezier(.2,.7,.2,1), transform 0.9s cubic-bezier(.2,.7,.2,1); }
    .pcard.is-in { opacity: 1; transform: none; }
    .pcard-media { position: relative; overflow: hidden; border-radius: 2px; }
    .pcard-frames {
      display: block; position: relative; aspect-ratio: 3 / 4; border-radius: 2px;
      background-color: var(--platinum); overflow: hidden;
      transition: transform 0.7s cubic-bezier(.2,.7,.2,1);
    }
    .pcard-media:hover .pcard-frames { transform: scale(1.03); }
    .pcard-frame {
      position: absolute; inset: 0; background-size: cover; background-position: center;
      opacity: 0; transition: opacity 0.5s ease;
    }
    .pcard-frame.is-active { opacity: 1; }
    /* Faint bottom vignette so the dots read on any template. */
    .pcard-media::after {
      content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 68px;
      background: linear-gradient(0deg, rgba(15,13,18,0.32), rgba(15,13,18,0));
      pointer-events: none; z-index: 1;
    }
    .pcard-dots {
      position: absolute; left: 0; right: 0; bottom: 12px; z-index: 2;
      display: flex; justify-content: center; align-items: center; gap: 7px;
    }
    .pcard-dot {
      width: 7px; height: 7px; border-radius: 50%; padding: 0; cursor: pointer;
      border: 1px solid rgba(244,242,241,0.9); background: rgba(28,29,34,0.28);
      box-shadow: 0 1px 4px rgba(0,0,0,0.4);
      transition: background 0.3s, transform 0.3s, border-color 0.3s;
    }
    .pcard-dot:hover { background: rgba(244,242,241,0.55); }
    .pcard-dot.is-active { background: var(--paper); border-color: var(--paper); transform: scale(1.28); }
    .pcard-title {
      font-family: var(--sans); font-weight: 700; font-size: clamp(16px, 1.25vw, 21px);
      line-height: 1.15; letter-spacing: -0.01em; color: var(--ink); margin: 20px 0 0;
    }
    .pcard-type { font-family: var(--sans); font-size: 13px; line-height: 1.4; color: rgba(28,29,34,0.55); margin: 6px 0 0; }
    .pcard-actions { display: flex; align-items: center; gap: 14px; margin-top: 18px; flex-wrap: wrap; }
    .pcard-size {
      font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--ink);
      padding: 10px 16px; border: 1px solid rgba(28,29,34,0.4); border-radius: 2px;
    }
    .pcard-cta {
      font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.2em;
      text-transform: uppercase; color: var(--paper); background: var(--ink);
      padding: 11px 24px; border-radius: 2px; text-decoration: none;
      transition: background 0.25s, transform 0.4s cubic-bezier(.2,.7,.2,1);
    }
    .pcard-cta:hover { background: var(--english-violet); transform: translateY(-1px); }
    @media (prefers-reduced-motion: reduce) { .pcard { opacity: 1; transform: none; } }

    .show { position: relative; }
    .show-inner {
      display: flex;
      align-items: center;
      gap: clamp(28px, 4vw, 76px);
      min-height: min(78vh, 740px);
    }
    /* Three zones across the band: framed hero photo · description (middle) ·
       hoverable preview collage. They alternate sides band to band. */
    .show-hero { flex: 1 1 38%; min-width: 0; order: 1; }
    .show-copy { flex: 1 1 23%; min-width: 0; order: 2; }
    .show-shop { flex: 1 1 39%; min-width: 0; order: 3; }
    .show:nth-child(even) .show-hero { order: 3; }
    .show:nth-child(even) .show-shop { order: 1; }
    @media (max-width: 980px) {
      .show-inner { flex-wrap: wrap; gap: 36px clamp(28px, 4vw, 56px); }
      .show-hero { flex: 1 1 46%; order: 1 !important; }
      .show-copy { flex: 1 1 46%; order: 2 !important; }
      .show-shop { flex: 1 1 100%; order: 3 !important; }
    }
    @media (max-width: 680px) {
      .show-inner { flex-direction: column; min-height: 0; }
      .show-hero, .show-copy, .show-shop { flex: none; width: 100%; }
    }

    /* ---- Framed hero photo ---- */
    .show-hero { position: relative; display: flex; justify-content: center; }
    .show-ghost {
      position: absolute;
      top: -15%; left: -8%;
      font-family: var(--serif); font-weight: 500;
      font-size: clamp(120px, 15vw, 230px); line-height: 1;
      color: rgba(55, 30, 40, 0.06);
      z-index: 0; pointer-events: none; user-select: none;
      translate: 0 var(--par, 0px);
    }
    .show:nth-child(even) .show-ghost { left: auto; right: -8%; }

    .show-stage {
      position: relative; display: block;
      width: min(400px, 94%);
      aspect-ratio: 3 / 4;
      z-index: 1; text-decoration: none;
    }
    /* Gallery-mounted print: paper mount, hairline bevel, layered shadow.
       (Built in CSS — swap for a PNG frame later if you prefer a literal one.) */
    .show-frame {
      position: relative; margin: 0; width: 100%; height: 100%;
      background: var(--paper);
      padding: clamp(12px, 1.5vw, 20px);
      border: 1px solid rgba(28, 29, 34, 0.10);
      box-shadow: 0 40px 70px -30px rgba(28,29,34,0.5), 0 8px 20px -10px rgba(28,29,34,0.28);
      transition: transform 0.7s cubic-bezier(.2,.7,.2,1), box-shadow 0.7s;
    }
    .show-stage:hover .show-frame {
      transform: translateY(-6px);
      box-shadow: 0 54px 92px -34px rgba(28,29,34,0.55), 0 10px 26px -10px rgba(28,29,34,0.3);
    }
    .show-frame::after {
      content: ""; position: absolute; inset: clamp(7px, 1vw, 13px);
      border: 1px solid rgba(28, 29, 34, 0.16); pointer-events: none; z-index: 4;
    }
    .show-mount { position: relative; width: 100%; height: 100%; overflow: hidden; background: var(--platinum); }
    .show-heroimg {
      position: absolute; inset: 0;
      background-size: cover; background-position: center;
      transition: opacity 0.28s ease;
    }
    .show-frame-cap {
      position: absolute; left: 2px; bottom: -28px;
      font-family: var(--sans); font-size: 10px;
      letter-spacing: 0.26em; text-transform: uppercase;
      font-weight: 700; color: rgba(28, 29, 34, 0.45);
    }

    /* ---- Description (middle) ---- */
    .show-copy { position: relative; }
    .show-eyebrow {
      display: flex; align-items: center; gap: 12px;
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--english-violet); margin: 0 0 18px;
    }
    .show-eyebrow::before { content: ""; width: 30px; height: 1px; background: var(--english-violet); opacity: 0.5; }
    .show-title {
      font-family: var(--serif); font-weight: 500;
      font-size: clamp(32px, 3.6vw, 52px);
      line-height: 1.02; letter-spacing: -0.02em;
      margin: 0; color: var(--ink);
    }
    .show-desc {
      font-family: var(--sans); font-size: clamp(15px, 1.15vw, 16.5px);
      line-height: 1.62; color: rgba(28, 29, 34, 0.66); margin: 18px 0 0;
    }
    .show-inside {
      list-style: none; padding: 0; margin: 22px 0 0;
      display: flex; flex-direction: column; gap: 8px;
    }
    .show-inside li {
      font-family: var(--sans); font-size: 13px; line-height: 1.4;
      color: rgba(28, 29, 34, 0.62); padding-left: 19px; position: relative;
    }
    .show-inside li::before { content: "\2192"; position: absolute; left: 0; color: var(--english-violet); }

    /* ---- Preview collage + shop foot ---- */
    .show-shop { position: relative; display: flex; flex-direction: column; }
    .show-collage { display: grid; grid-template-columns: repeat(3, 1fr); gap: 9px; }
    .show-thumb {
      appearance: none; padding: 0; cursor: pointer;
      position: relative; aspect-ratio: 3 / 4;
      background-size: cover; background-position: center;
      background-color: var(--platinum);
      border: 4px solid var(--paper);
      box-shadow: 0 12px 26px -14px rgba(28, 29, 34, 0.45);
      transition: transform 0.45s cubic-bezier(.2,.7,.2,1), box-shadow 0.45s, opacity 0.45s, rotate 0.45s;
    }
    .show-thumb:nth-child(3n+1) { rotate: -2.5deg; }
    .show-thumb:nth-child(3n+2) { rotate: 1.5deg; }
    .show-thumb:nth-child(3n)   { rotate: -1deg; }
    /* Hover one → it pops forward; the rest flicker back. */
    .show-collage:hover .show-thumb { opacity: 0.5; }
    .show-collage .show-thumb:hover,
    .show-collage .show-thumb.is-active {
      opacity: 1; rotate: 0deg;
      transform: translateY(-5px) scale(1.06);
      box-shadow: 0 20px 38px -16px rgba(28, 29, 34, 0.55); z-index: 2;
    }
    .show-shopfoot {
      margin-top: clamp(22px, 2.4vw, 32px);
      display: flex; align-items: center; justify-content: space-between;
      gap: 16px; flex-wrap: wrap;
    }
    .show-price { font-family: var(--serif); font-size: 30px; font-weight: 500; color: var(--ink); }
    .show-price small { font-size: 13px; color: rgba(28, 29, 34, 0.5); }
    .show-ctas { display: flex; align-items: center; gap: 16px; }
    .show-see {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink);
      text-decoration: none; border-bottom: 1px solid rgba(28, 29, 34, 0.3); padding-bottom: 3px;
      transition: color 0.25s, border-color 0.25s;
    }
    .show-see:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .show-buy {
      appearance: none; background: var(--ink); color: var(--paper);
      border: 0; padding: 13px 22px; border-radius: 2px;
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.24em; text-transform: uppercase; cursor: pointer;
      transition: background 0.3s, transform 0.4s cubic-bezier(.2,.7,.2,1);
    }
    .show-buy:hover { background: var(--english-violet); transform: translateX(2px); }
    .show-buy em { font-family: var(--serif); font-style: italic; font-size: 15px; letter-spacing: 0; text-transform: none; margin-left: 8px; }

    /* ---- Scroll-in reveal ---- */
    .show-hero, .show-copy, .show-shop {
      opacity: 0; transform: translateY(34px);
      transition: opacity 1s cubic-bezier(.2,.7,.2,1), transform 1s cubic-bezier(.2,.7,.2,1);
    }
    .show.is-in .show-hero { opacity: 1; transform: none; transition-delay: 0.04s; }
    .show.is-in .show-copy { opacity: 1; transform: none; transition-delay: 0.14s; }
    .show.is-in .show-shop { opacity: 1; transform: none; transition-delay: 0.22s; }
    @media (prefers-reduced-motion: reduce) {
      .show-hero, .show-copy, .show-shop { opacity: 1 !important; transform: none !important; }
      .show-frame, .show-thumb, .show-heroimg { transition: none; }
    }

    /* ============ Checkout modal ============ */
    .checkout-backdrop[hidden] { display: none !important; }
    .checkout-backdrop {
      position: fixed; inset: 0;
      background: rgba(28, 29, 34, 0.65);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      overflow-y: auto;
    }
    .checkout {
      position: relative;
      width: min(1080px, 100%);
      max-height: calc(100vh - 48px);
      display: grid;
      grid-template-columns: 360px 1fr;
      background: var(--paper);
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 40px 100px rgba(0,0,0,0.35);
    }
    @media (max-width: 860px) {
      .checkout { grid-template-columns: 1fr; max-height: calc(100vh - 48px); overflow-y: auto; }
    }
    .checkout-close {
      position: absolute;
      top: 14px; right: 16px;
      background: rgba(244, 242, 241,0.85);
      border: 1px solid rgba(var(--violet-rgb),0.2);
      border-radius: 999px;
      width: 36px; height: 36px;
      font-size: 22px;
      color: var(--ink);
      cursor: pointer;
      z-index: 5;
      line-height: 1;
    }
    .checkout-close:hover { background: var(--paper); }

    .checkout-aside {
      background: linear-gradient(180deg, var(--english-violet), #2f2b39);
      color: var(--paper);
      display: flex;
      flex-direction: column;
    }
    .checkout-aside-cover {
      aspect-ratio: 4 / 3;
      background-size: cover;
      background-position: center;
      background-color: var(--platinum);
    }
    .checkout-aside-body { padding: 28px 28px 32px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
    .checkout-aside-eyebrow {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(244, 242, 241,0.6);
    }
    .checkout-aside-title {
      font-family: var(--serif);
      font-size: 30px;
      font-weight: 500;
      line-height: 1.05;
      letter-spacing: -0.015em;
      color: var(--paper);
      margin: 0;
    }
    .checkout-aside-desc {
      font-size: 14px;
      line-height: 1.55;
      color: rgba(244, 242, 241,0.7);
      margin: 6px 0 4px;
    }
    .checkout-aside-list {
      list-style: none; padding: 0; margin: 12px 0 0;
      display: flex; flex-direction: column; gap: 6px;
      font-size: 13px;
      color: rgba(244, 242, 241,0.75);
    }
    .checkout-aside-list li { padding-left: 18px; position: relative; }
    .checkout-aside-list li::before {
      content: "—";
      position: absolute; left: 0; color: rgba(244, 242, 241,0.45);
    }
    .checkout-aside-foot {
      margin-top: auto;
      padding-top: 22px;
      border-top: 1px solid rgba(244, 242, 241,0.18);
      display: flex; justify-content: space-between; align-items: baseline;
    }
    .checkout-aside-label {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(244, 242, 241,0.6);
    }
    .checkout-aside-total {
      font-family: var(--serif);
      font-size: 36px;
      font-weight: 500;
      color: var(--paper);
    }

    .checkout-main {
      padding: 40px 44px 44px;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }
    @media (max-width: 860px) { .checkout-main { padding: 32px 24px 32px; } }

    .checkout-steps {
      display: flex;
      gap: 22px;
      margin-bottom: 26px;
      padding-bottom: 18px;
      border-bottom: 1px solid rgba(28,29,34,0.1);
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28,29,34,0.4);
    }
    .checkout-step { display: inline-flex; align-items: center; gap: 8px; }
    .checkout-step em {
      font-family: var(--serif);
      font-style: italic;
      font-size: 16px;
      letter-spacing: 0;
      color: rgba(28,29,34,0.3);
    }
    .checkout-step.is-active { color: var(--english-violet); }
    .checkout-step.is-active em { color: var(--english-violet); }
    .checkout-step.is-done { color: var(--ink); }

    .checkout-pane { display: none; flex-direction: column; gap: 16px; }
    .checkout-pane.is-active { display: flex; }
    .checkout-h {
      font-family: var(--serif);
      font-size: clamp(28px, 3vw, 38px);
      font-weight: 500;
      letter-spacing: -0.015em;
      line-height: 1.1;
      margin: 0;
    }
    .checkout-sub {
      font-size: 14px;
      line-height: 1.55;
      color: rgba(28,29,34,0.65);
      margin: -6px 0 12px;
    }

    .ck-field { display: flex; flex-direction: column; gap: 6px; }
    .ck-field > span {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--english-violet);
    }
    .ck-field input {
      font-family: var(--sans);
      font-size: 15px;
      padding: 12px 14px;
      border: 1px solid rgba(var(--violet-rgb),0.28);
      border-radius: 2px;
      background: #fff;
      color: var(--ink);
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .ck-field input:focus {
      outline: none;
      border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(var(--violet-rgb),0.12);
    }
    .ck-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .ck-row:has(> :nth-child(2):last-child) { grid-template-columns: 1fr 1fr; }
    @media (max-width: 640px) { .ck-row { grid-template-columns: 1fr; } }

    .ck-cta {
      appearance: none;
      background: var(--ink);
      color: var(--paper);
      border: 0;
      padding: 16px 22px;
      border-radius: 2px;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      cursor: pointer;
      margin-top: 10px;
      transition: background 0.25s;
    }
    .ck-cta:hover { background: var(--english-violet); }
    .ck-cta em {
      font-family: var(--serif);
      font-style: italic;
      font-size: 16px;
      letter-spacing: 0;
      text-transform: none;
      margin-left: 8px;
    }
    .ck-cta[disabled] { opacity: 0.55; cursor: progress; }

    .ck-back {
      background: transparent;
      border: 0;
      color: rgba(28,29,34,0.55);
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 700;
      padding: 6px 0;
      margin-top: 6px;
      cursor: pointer;
      align-self: flex-start;
    }
    .ck-back:hover { color: var(--english-violet); }
    .ck-mini { font-size: 11px; color: rgba(28,29,34,0.45); margin: 6px 0 0; line-height: 1.5; }
    .ck-error {
      margin: 0;
      padding: 10px 12px;
      background: rgba(160,90,60,0.1);
      border-left: 3px solid #a05a3c;
      color: #a05a3c;
      font-size: 13px;
      font-family: var(--sans);
    }

    /* Payment tabs */
    .ck-paytabs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin: 4px 0 12px;
    }
    @media (max-width: 520px) { .ck-paytabs { grid-template-columns: 1fr; } }
    .ck-paytab {
      appearance: none;
      background: #fff;
      border: 1px solid rgba(var(--violet-rgb),0.25);
      border-radius: 2px;
      padding: 14px 14px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--ink);
      cursor: pointer;
      transition: border-color 0.25s, background 0.25s;
    }
    .ck-paytab:hover { border-color: var(--english-violet); }
    .ck-paytab.is-active {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--paper);
    }
    .ck-paytab-logo {
      width: 22px; height: 22px;
      background: #000;
      mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M16.4 12.6c0-2.7 2.2-3.9 2.3-4-1.2-1.8-3.2-2-3.9-2-1.6-.2-3.2 1-4.1 1-.9 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.4 1.4 11.1.9 1.3 2 2.8 3.4 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.3 3.3-2.7 1-1.5 1.5-3 1.5-3 0-.1-2.9-1.1-2.9-4z M14.1 4.4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.2 0 2.4-.6 3-1.4z'/></svg>");
      -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M16.4 12.6c0-2.7 2.2-3.9 2.3-4-1.2-1.8-3.2-2-3.9-2-1.6-.2-3.2 1-4.1 1-.9 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.4 1.4 11.1.9 1.3 2 2.8 3.4 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.3 3.3-2.7 1-1.5 1.5-3 1.5-3 0-.1-2.9-1.1-2.9-4z M14.1 4.4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.2 0 2.4-.6 3-1.4z'/></svg>");
      mask-size: contain; -webkit-mask-size: contain;
      mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat;
    }
    .ck-paytab.is-active .ck-paytab-logo { background: var(--paper); }
    .ck-paytab-logo--g {
      /* Letter G in the same monochrome treatment */
      mask: none; -webkit-mask: none;
      background: transparent;
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--sans); font-weight: 800; font-size: 16px;
      color: inherit;
    }
    .ck-paytab-logo--g::before { content: "G"; }
    .ck-paytab-logo--card {
      mask: none; -webkit-mask: none;
      background: transparent;
      border: 1.6px solid currentColor;
      border-radius: 3px;
      position: relative;
    }
    .ck-paytab-logo--card::after {
      content: ""; position: absolute; left: 1px; right: 1px; top: 6px;
      height: 3px; background: currentColor;
    }

    /* Wallet pane */
    .ck-wallet { margin: 6px 0 14px; }
    .ck-wallet-frame {
      border: 1px solid rgba(var(--violet-rgb),0.2);
      border-radius: 4px;
      padding: 22px;
      background: #fff;
      display: flex; flex-direction: column; gap: 16px;
    }
    .ck-wallet-row {
      display: flex; justify-content: space-between; align-items: baseline;
      font-family: var(--sans);
      font-size: 13px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      color: rgba(28,29,34,0.55);
    }
    .ck-wallet-amount {
      font-family: var(--serif);
      font-size: 28px;
      font-weight: 500;
      letter-spacing: 0;
      text-transform: none;
      color: var(--ink);
    }
    .ck-wallet-btn {
      appearance: none;
      background: #000;
      color: #fff;
      border: 0;
      border-radius: 6px;
      padding: 16px 22px;
      font-family: -apple-system, "Helvetica Neue", var(--sans);
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 0.01em;
      cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      transition: background 0.25s, transform 0.25s;
    }
    .ck-wallet-btn:hover { background: #1a1a1a; transform: translateY(-1px); }
    .ck-wallet-btn-glyph {
      width: 18px; height: 22px;
      background: #fff;
      mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M16.4 12.6c0-2.7 2.2-3.9 2.3-4-1.2-1.8-3.2-2-3.9-2-1.6-.2-3.2 1-4.1 1-.9 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.4 1.4 11.1.9 1.3 2 2.8 3.4 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.3 3.3-2.7 1-1.5 1.5-3 1.5-3 0-.1-2.9-1.1-2.9-4z M14.1 4.4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.2 0 2.4-.6 3-1.4z'/></svg>");
      -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M16.4 12.6c0-2.7 2.2-3.9 2.3-4-1.2-1.8-3.2-2-3.9-2-1.6-.2-3.2 1-4.1 1-.9 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.4 1.4 11.1.9 1.3 2 2.8 3.4 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.3 3.3-2.7 1-1.5 1.5-3 1.5-3 0-.1-2.9-1.1-2.9-4z M14.1 4.4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.2 0 2.4-.6 3-1.4z'/></svg>");
      mask-size: contain; -webkit-mask-size: contain;
      mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat;
    }
    .ck-wallet-btn[data-wallet="google_pay"] {
      background: #fff;
      color: #3c4043;
      border: 1px solid #dadce0;
    }
    .ck-wallet-btn[data-wallet="google_pay"] .ck-wallet-btn-glyph {
      mask: none; -webkit-mask: none; background: transparent;
      display: inline-flex; align-items: center; justify-content: center;
      width: auto; height: auto;
      font-weight: 700; font-size: 18px;
    }
    .ck-wallet-btn[data-wallet="google_pay"] .ck-wallet-btn-glyph::before {
      content: "G"; color: #4285F4;
    }
    .ck-wallet-note { font-size: 12px; color: rgba(28,29,34,0.5); margin: 0; text-align: center; }

    .ck-card { display: flex; flex-direction: column; gap: 14px; }
    .ck-card[hidden],
    .ck-wallet[hidden] { display: none !important; }

    /* Done pane */
    .ck-done {
      padding: 40px 0;
      display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px;
    }
    .ck-done-spinner {
      position: relative; width: 70px; height: 70px; margin-bottom: 8px;
    }
    .ck-done-ring {
      position: absolute; inset: 0;
      border: 2px solid transparent;
      border-top-color: var(--english-violet);
      border-radius: 50%;
      animation: ck-spin 1.4s cubic-bezier(.5,.1,.5,.9) infinite;
    }
    .ck-done-ring:nth-child(2) { inset: 10px; border-top-color: rgba(var(--violet-rgb),0.4); animation-duration: 1.7s; animation-direction: reverse; }
    .ck-done-ring:nth-child(3) { inset: 20px; border-top-color: rgba(var(--violet-rgb),0.2); animation-duration: 2.1s; }
    @keyframes ck-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
  </style>

  <script>
    import { supabase, gbpFromPence } from '../lib/supabase.js';

    const grid = document.getElementById('edit-grid');
    const loading = document.getElementById('edit-loading');
    const empty = document.getElementById('edit-empty');
    const wrap = document.getElementById('edit-catalogue');

    const modal = document.getElementById('checkout');
    const modalClose = document.getElementById('checkout-close');
    const stepPanes = modal.querySelectorAll('.checkout-pane');
    const stepPips = modal.querySelectorAll('.checkout-step');
    const coverEl = document.getElementById('checkout-cover');
    const pkgTitleEl = document.getElementById('checkout-pack-title');
    const pkgDescEl = document.getElementById('checkout-pack-desc');
    const pkgListEl = document.getElementById('checkout-pack-contents');
    const pkgPriceEl = document.getElementById('checkout-pack-price');

    const contactForm = document.getElementById('checkout-contact');
    const paymentForm = document.getElementById('checkout-payment');
    const contactErr = document.getElementById('ck-contact-error');
    const paymentErr = document.getElementById('ck-payment-error');
    const walletBtn = document.getElementById('ck-wallet-btn');
    const cardSubmit = document.getElementById('ck-card-submit');
    const backBtn = document.getElementById('ck-back-to-contact');
    const doneH = document.getElementById('ck-done-h');
    const doneSub = document.getElementById('ck-done-sub');

    const state = {
      pack: null,
      contact: null,
      payMethod: 'apple_pay',
    };

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    function renderShowcase(p, i) {
      // Shop card: name, type, Pack Size, Discover — with the media area flicking
      // through the pack's flagged preview templates (click the dots to change; no
      // autoplay). The full detail opens on click of the image.
      // Flick frames = the pack's flagged preview gallery (preview_images). These
      // are the full-resolution uploads — the SAME high-quality source the single
      // cover used. Fall back to the high-res cover on its own, and only to the
      // low-res template thumbnails if a pack has neither, so a pack with real
      // artwork is never downgraded to pixelated thumbs.
      const coverHi = (typeof p.cover_image_url === 'string' && p.cover_image_url.trim()) ? p.cover_image_url.trim() : '';
      const gallery = (Array.isArray(p.preview_images) ? p.preview_images : []).filter((u) => typeof u === 'string' && u.trim());
      const tpl = (Array.isArray(p.templates) ? p.templates : []).filter(Boolean);
      // Lead the flick-through with the HIGH-RES cover, then the pack's templates
      // (which prefer the full-res render_url — see loader). The flagged
      // preview_images are frequently low-res thumbnails, so they're only a
      // last-resort fallback — that's what had made the cards look soft.
      let previews = [];
      const pushU = (u) => { if (u && !previews.includes(u)) previews.push(u); };
      pushU(coverHi);
      tpl.forEach(pushU);
      if (previews.length < 2) gallery.forEach(pushU);   // pad only if we've got almost nothing crisp
      if (!previews.length) previews = gallery.slice(0, 6);
      previews = previews.slice(0, 6);
      const n = (p.packSize != null) ? p.packSize
        : (p.templateCount != null ? p.templateCount
        : ((p.templates && p.templates.length) || (p.contents && p.contents.length) || 0));
      const type = p.category ? `${escapeHtml(p.category)} Template Pack` : 'Template Pack';
      const href = `/edit/${encodeURIComponent(p.slug)}`;
      const frames = previews.map((src, k) =>
        `<span class="pcard-frame${k === 0 ? ' is-active' : ''}" style="background-image:url('${escapeHtml(src)}')"></span>`
      ).join('');
      const dots = previews.length > 1
        ? `<div class="pcard-dots">${previews.map((_, k) =>
            `<button type="button" class="pcard-dot${k === 0 ? ' is-active' : ''}" data-i="${k}" aria-label="Preview ${k + 1} of ${previews.length}"></button>`
          ).join('')}</div>`
        : '';
      return `
        <article class="pcard" data-id="${p.id}" data-slug="${escapeHtml(p.slug)}">
          <div class="pcard-media">
            <a class="pcard-frames" href="${href}" aria-label="Discover ${escapeHtml(p.title)}">${frames}</a>
            ${dots}
          </div>
          <h3 class="pcard-title">${escapeHtml(p.title)}</h3>
          <p class="pcard-type">${type}</p>
          <div class="pcard-actions">
            <span class="pcard-size">Pack Size: ${n}</span>
            <a class="pcard-cta" href="${href}">Discover</a>
          </div>
        </article>
      `;
    }

    // Wire the preview dots: click a dot to swap the active frame (no autoplay).
    function wirePreviews(root) {
      root.querySelectorAll('.pcard-media').forEach((media) => {
        const frames = [...media.querySelectorAll('.pcard-frame')];
        const dots = [...media.querySelectorAll('.pcard-dot')];
        if (dots.length < 2) return;
        const show = (k) => {
          frames.forEach((f, n) => f.classList.toggle('is-active', n === k));
          dots.forEach((d, n) => d.classList.toggle('is-active', n === k));
        };
        dots.forEach((d) => d.addEventListener('click', (e) => {
          e.preventDefault(); e.stopPropagation();
          show(+d.dataset.i);
        }));
      });
    }

    // Hovering a collage thumbnail flickers it into the framed hero, and the
    // rest of the collage dims back (CSS). Leaving the collage restores the cover.
    function wireCollage(root) {
      root.querySelectorAll('.show').forEach((sec) => {
        const hero = sec.querySelector('.show-heroimg');
        const collage = sec.querySelector('.show-collage');
        const thumbs = [...sec.querySelectorAll('.show-thumb')];
        if (!hero || !collage || !thumbs.length) return;
        const cover = hero.dataset.cover || '';
        let raf = 0;
        const swap = (url) => {
          if (!url) return;
          hero.style.opacity = '0.18';   // flicker out…
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => setTimeout(() => {
            hero.style.backgroundImage = `url('${url}')`;
            hero.style.opacity = '1';    // …and back in on the new shot
          }, 80));
        };
        thumbs.forEach((t) => {
          const show = () => {
            thumbs.forEach((x) => x.classList.toggle('is-active', x === t));
            swap(t.dataset.src);
          };
          t.addEventListener('mouseenter', show);
          t.addEventListener('focus', show);
        });
        collage.addEventListener('mouseleave', () => {
          thumbs.forEach((x) => x.classList.remove('is-active'));
          swap(cover);
        });
      });
    }

    // Reveal each card on scroll.
    function wireMotion(root) {
      const shows = [...root.querySelectorAll('.pcard')];
      if (!('IntersectionObserver' in window)) {
        shows.forEach((s) => s.classList.add('is-in'));
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.18, rootMargin: '0px 0px -8% 0px' });
        shows.forEach((s) => io.observe(s));
      }

      const parEls = [...root.querySelectorAll('[data-par]')];
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (parEls.length && !reduce) {
        let ticking = false;
        const update = () => {
          const vh = window.innerHeight || 1;
          parEls.forEach((el) => {
            const r = el.getBoundingClientRect();
            const d = ((r.top + r.height / 2) - vh / 2) / vh;   // -0.5..0.5 across the viewport
            const amp = parseFloat(el.dataset.par) || 0;
            el.style.setProperty('--par', (-d * amp).toFixed(1) + 'px');
          });
          ticking = false;
        };
        window.addEventListener('scroll', () => {
          if (!ticking) { ticking = true; requestAnimationFrame(update); }
        }, { passive: true });
        update();
      }
    }

    // ===== Hero — fixed backdrop, click a cover/dot to feature a pack ========
    // No autoplay: the featured copy (left) reflects whichever cover is active
    // in the reel (right). Clicking a cover or a dot switches the feature.
    function setupHero(packs) {
      const hero = document.getElementById('edit-hero2');
      if (!hero) return;
      const cover = (p) => p.cover_image_url || (p.preview_images && p.preview_images[0]) || (p.templates && p.templates[0]) || '';
      const list = (packs || []).filter((p) => p && cover(p));
      if (!list.length) { hero.style.display = 'none'; return; }

      const reelEl = document.getElementById('eh2-reel');
      const dotsEl = document.getElementById('eh2-dots');
      const headEl = document.getElementById('eh2-head');
      const copyEl = document.getElementById('eh2-copy');
      const catEl = document.getElementById('eh2-cat');
      const nameEl = document.getElementById('eh2-name');
      const bioEl = document.getElementById('eh2-bio');
      const moreEl = document.getElementById('eh2-more');

      // One reel tile + one dot per pack. (The pack name now lives in the feature
      // copy, so the covers carry no caption.)
      reelEl.innerHTML = list.map((p, i) =>
        `<button type="button" class="eh2-tile${i === 0 ? ' is-active' : ''}" role="tab" aria-selected="${i === 0}" data-i="${i}" aria-label="${escapeHtml(p.title || '')}" style="background-image:url('${cover(p)}')"></button>`
      ).join('');
      const tiles = [...reelEl.children];
      dotsEl.innerHTML = list.map((_, i) => `<button type="button" class="eh2-dot${i === 0 ? ' is-active' : ''}" data-i="${i}" aria-label="Pack ${i + 1}"></button>`).join('');
      const dots = [...dotsEl.children];
      list.forEach((p) => { const im = new Image(); im.src = cover(p); });   // preload

      // The big title is the single-word category; the pack name goes in the
      // pronunciation slot. No splitting/auto-fit needed.
      const fillCopy = (p) => {
        catEl.textContent = p.category || 'The Edit';
        nameEl.textContent = p.title || '';
        bioEl.textContent = p.description || '';
      };

      let idx = 0;
      function go(i) {
        i = ((i % list.length) + list.length) % list.length;
        idx = i;
        const p = list[i];
        headEl.classList.add('is-swap'); copyEl.classList.add('is-swap');
        setTimeout(() => {
          fillCopy(p);
          if (p.slug) moreEl.href = `/edit/${encodeURIComponent(p.slug)}`;
          headEl.classList.remove('is-swap'); copyEl.classList.remove('is-swap');
        }, 220);
        tiles.forEach((t, n) => { t.classList.toggle('is-active', n === i); t.setAttribute('aria-selected', n === i); });
        dots.forEach((d, n) => d.classList.toggle('is-active', n === i));
        // On mobile the reel scrolls; keep the active cover in view (no-op on desktop).
        const t = tiles[i];
        if (t && t.scrollIntoView) t.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' });
      }

      // Click a cover or a dot to feature it.
      reelEl.addEventListener('click', (e) => { const b = e.target.closest('.eh2-tile'); if (b) go(+b.dataset.i); });
      dotsEl.addEventListener('click', (e) => { const b = e.target.closest('.eh2-dot'); if (b) go(+b.dataset.i); });

      // Init — fill the feature from the first pack (no fade on load).
      fillCopy(list[0]);
      if (list[0].slug) moreEl.href = `/edit/${encodeURIComponent(list[0].slug)}`;

      if (list.length <= 1) { const controls = hero.querySelector('.eh2-controls'); if (controls) controls.style.display = 'none'; }

      // Lock the title band + body to their tallest so the covers' top line and the
      // overall block never shift as you click through (the body is already clamped
      // to five lines; this covers a pack name that wraps to two).
      function relayout() {
        headEl.style.minHeight = ''; copyEl.style.minHeight = '';
        const cur = idx;
        let headH = 0, copyH = 0;
        list.forEach((p) => { fillCopy(p); headH = Math.max(headH, headEl.offsetHeight); copyH = Math.max(copyH, copyEl.offsetHeight); });
        fillCopy(list[cur]);
        headEl.style.minHeight = headH + 'px';
        copyEl.style.minHeight = copyH + 'px';
      }
      relayout();
      let lockT = 0;
      window.addEventListener('resize', () => { clearTimeout(lockT); lockT = setTimeout(relayout, 180); });
    }

    let packsById = new Map();

    // Dev/preview-only sample packs so the showcase is visible before any packs
    // exist in Supabase. Never shown in production (real packs or the empty
    // state). Images are local placeholders from /public/assets.
    // Template thumbnails live on R2 (the Greenfield design set). In production a
    // pack's templates come from the Supabase `templates` table (by pack_id); these
    // sample packs let the page show the draft's three packs locally with no DB.
    const TPL = (n) => `https://assets.tmke.co.uk/TMKE%20Home%20Page/Templates/${n}.png`;
    const TPL_ALL = Array.from({ length: 13 }, (_, i) => TPL(i + 1));
    const rot = (a, n) => a.slice(n).concat(a.slice(0, n));   // vary the order per pack
    const SAMPLE_PACKS = [
      {
        id: 'sample-proof', slug: 'the-proof-is-in-the-posts', category: 'Service and Standards',
        title: 'The Proof Is in the Posts', price_pence: 0, packSize: 30,
        description: "Being a great agent means nothing if the people looking for one can't see it. This pack gives you the content to change that. Client testimonials, results, milestones, and service-led posts that build trust, communicate your value, and position you as the agent worth choosing. No guesswork, no generic captions. Just proof.",
        cover_image_url: TPL(8), preview_images: [TPL(1), TPL(2), TPL(3), TPL(4), TPL(5), TPL(6)],
        contents: [], templates: TPL_ALL,
      },
      {
        id: 'sample-portfolio', slug: 'property-portfolio', category: 'On the Market',
        title: 'Property Portfolio', price_pence: 0, packSize: 25,
        description: 'Show the homes, not just the headlines. A polished set of listing layouts — new instructions, open houses, price changes and just-sold — that make every property on your books look the part across the feed.',
        cover_image_url: TPL(13), preview_images: [TPL(13), TPL(1), TPL(5), TPL(8), TPL(2), TPL(10)],
        contents: [], templates: rot(TPL_ALL, 5),
      },
      {
        id: 'sample-become', slug: 'become-the-name', category: 'Local Life',
        title: 'Become the Name They Already Know', price_pence: 0, packSize: 25,
        description: 'Be the agent your area already trusts. Local-favourite features, recommendations and community-led posts that put you at the heart of the neighbourhood long before anyone is ready to move.',
        cover_image_url: TPL(10), preview_images: [TPL(10), TPL(6), TPL(3), TPL(12), TPL(7), TPL(9)],
        contents: [], templates: rot(TPL_ALL, 9),
      },
    ];

    (async () => {
      const { data, error } = await supabase
        .from('packs')
        .select('id, slug, title, description, price_pence, cover_image_url, preview_images, contents, category, sort_order')
        .eq('status', 'active')
        .order('sort_order', { ascending: true })
        .order('created_at', { ascending: false })
        .limit(8);

      loading.hidden = true;
      wrap.setAttribute('aria-busy', 'false');

      let packs = (!error && data) ? data : [];
      // Show the sample showcase locally when there's no live data yet.
      if (packs.length === 0 && import.meta.env.DEV) packs = SAMPLE_PACKS;

      if (error && !import.meta.env.DEV) {
        empty.hidden = false;
        empty.innerHTML = `<p>Could not load the catalogue right now — please try again shortly.</p>`;
        return;
      }
      if (packs.length === 0) { empty.hidden = false; return; }

      packsById = new Map(packs.map((p) => [p.id, p]));

      // Attach each pack's templates (the editor designs linked by pack_id) AND
      // its true template COUNT, BEFORE rendering — so "Pack Size" and the hero
      // grid reflect the real pack (the count is every active template, even ones
      // without a thumbnail; the grid just uses the ones that have a thumbnail).
      const needTpl = packs.filter((p) => !p.templates);
      if (needTpl.length) {
        const { data: tdata } = await supabase
          .from('templates')
          .select('thumb_url, render_url, pack_id, sort_order')
          .in('pack_id', needTpl.map((p) => p.id))
          .eq('status', 'active')
          .order('sort_order', { ascending: true });
        const thumbs = new Map(), count = new Map();
        (tdata || []).forEach((t) => {
          count.set(t.pack_id, (count.get(t.pack_id) || 0) + 1);
          // Prefer the full-resolution render; fall back to the lighter thumb.
          const img = t.render_url || t.thumb_url;
          if (img) {
            if (!thumbs.has(t.pack_id)) thumbs.set(t.pack_id, []);
            thumbs.get(t.pack_id).push(img);
          }
        });
        packs.forEach((p) => {
          if (!p.templates) { p.templates = thumbs.get(p.id) || []; p.templateCount = count.get(p.id) || 0; }
        });
      }

      grid.innerHTML = packs.map((p, i) => renderShowcase(p, i)).join('');
      wireMotion(grid);
      wirePreviews(grid);
      maybeOpenFromQuery();

      // Rotate the hero one pack at a time (copy + that pack's flashing grid).
      setupHero(packs);
    })();

    // ============== Modal helpers ==============
    function showStep(step) {
      stepPanes.forEach((p) => p.classList.toggle('is-active', p.dataset.step === step));
      const order = ['contact', 'payment', 'done'];
      const idx = order.indexOf(step);
      stepPips.forEach((pip) => {
        const i = order.indexOf(pip.dataset.stepPip);
        pip.classList.toggle('is-active', i === idx);
        pip.classList.toggle('is-done', i < idx);
      });
    }

    function openCheckout(pack) {
      state.pack = pack;
      state.contact = null;
      state.payMethod = 'apple_pay';

      pkgTitleEl.textContent = pack.title;
      pkgDescEl.textContent = pack.description ?? '';
      pkgListEl.innerHTML = (pack.contents ?? []).slice(0, 4).map((c) => `<li>${escapeHtml(c)}</li>`).join('');
      pkgPriceEl.textContent = gbpFromPence(pack.price_pence) + ' +VAT';
      coverEl.style.backgroundImage = pack.cover_image_url ? `url('${pack.cover_image_url}')` : '';

      // Update £ amount on payment step in two places
      modal.querySelectorAll('[data-bind="amount"]').forEach((el) => {
        el.textContent = gbpFromPence(pack.price_pence);
      });

      // Reset form state
      contactForm.reset();
      paymentForm.reset();
      contactErr.hidden = true; paymentErr.hidden = true;
      selectPayMethod('apple_pay');

      showStep('contact');
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => contactForm.elements.name.focus(), 60);
    }

    function closeCheckout() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }

    grid.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      // Only the explicit Buy button opens checkout. Clicking elsewhere on
      // the card follows the wrapping <a> to the pack-detail page.
      const buyEl = target.closest('[data-buy]');
      if (!buyEl) return;
      e.preventDefault();
      const id = buyEl.getAttribute('data-buy');
      if (!id) return;
      const pack = packsById.get(id);
      if (pack) openCheckout(pack);
    });

    // ?buy=<id> deep-link: pack-detail page sends users back here to
    // trigger the checkout modal for a specific pack.
    function maybeOpenFromQuery() {
      const want = new URLSearchParams(location.search).get('buy');
      if (!want) return;
      const pack = packsById.get(want);
      if (pack) {
        openCheckout(pack);
        // Clean the URL so refreshes don't re-open the modal
        const u = new URL(location.href);
        u.searchParams.delete('buy');
        history.replaceState({}, '', u.toString());
      }
    }

    modalClose.addEventListener('click', closeCheckout);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeCheckout(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeCheckout();
    });

    // ============== Step 1: contact ==============
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      contactErr.hidden = true;
      const fd = new FormData(contactForm);
      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      const phone = String(fd.get('phone') || '').trim();
      const company = String(fd.get('company') || '').trim();
      if (!name || !email || !phone || !company) {
        contactErr.textContent = 'Please complete every field so we can email your library link.';
        contactErr.hidden = false;
        return;
      }
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        contactErr.textContent = 'That email doesn’t look quite right — double-check it?';
        contactErr.hidden = false;
        return;
      }
      state.contact = { name, email, phone, company };
      startCheckout();
    });

    // ============== Step 2: payment ==============
    function selectPayMethod(method) {
      state.payMethod = method;
      modal.querySelectorAll('.ck-paytab').forEach((tab) => {
        const active = tab.dataset.pay === method;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      const wallet = modal.querySelector('[data-paypane="wallet"]');
      const card = modal.querySelector('[data-paypane="card"]');
      const isWallet = method !== 'card';
      wallet.hidden = !isWallet;
      card.hidden = isWallet;
      if (isWallet) {
        const label = walletBtn.querySelector('.ck-wallet-btn-label');
        label.innerHTML = method === 'apple_pay'
          ? 'Pay with <strong> Pay</strong>'
          : 'Pay with <strong>G Pay</strong>';
        walletBtn.dataset.wallet = method;
      }
    }

    modal.querySelectorAll('.ck-paytab').forEach((tab) => {
      tab.addEventListener('click', () => selectPayMethod(tab.dataset.pay));
    });

    backBtn.addEventListener('click', () => showStep('contact'));

    walletBtn.addEventListener('click', () => processPayment());

    paymentForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (state.payMethod !== 'card') { processPayment(); return; }
      paymentErr.hidden = true;
      const fd = new FormData(paymentForm);
      const num = String(fd.get('card_number') || '').replace(/\s+/g, '');
      const exp = String(fd.get('card_exp') || '').trim();
      const cvc = String(fd.get('card_cvc') || '').trim();
      const postcode = String(fd.get('card_postcode') || '').trim();
      if (num.length < 12 || exp.length < 4 || cvc.length < 3 || !postcode) {
        paymentErr.textContent = 'Please complete your card details before paying.';
        paymentErr.hidden = false;
        return;
      }
      processPayment();
    });

    // ============== Stripe: hosted Checkout ==============
    // Ask the Worker to create a Stripe Checkout Session, then redirect to
    // Stripe's secure page. The order is recorded server-side and confirmed by
    // the Stripe webhook — the client never sees the secret key or card details.
    const WORKER_URL = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');
    async function startCheckout() {
      showStep('done');
      doneH.textContent = 'Taking you to secure checkout…';
      doneSub.textContent = 'You’ll complete payment on Stripe’s secure page.';

      if (WORKER_URL) {
        try {
          const res = await fetch(`${WORKER_URL}/stripe/checkout`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ pack_id: state.pack.id, ...state.contact }),
          });
          const out = await res.json().catch(() => ({}));
          if (res.ok && out.url) { window.location.href = out.url; return; }
          // 503 = payments not configured on the Worker yet → fall back to the
          // local stub so the flow still works in dev. Any other error is real.
          if (res.status !== 503) throw new Error(out.error || 'Could not start checkout.');
        } catch (e) {
          if (!import.meta.env.DEV) {
            doneH.textContent = 'Something went wrong';
            doneSub.textContent = (e && e.message) || 'Please try again in a moment.';
            return;
          }
          /* DEV: fall through to the stub below */
        }
      }
      // Fallback for local dev / payments-not-configured: the original stub.
      await processPayment();
    }

    // ============== Step 3 (stub fallback): processing → redirect ==============
    async function processPayment() {
      showStep('done');
      doneH.textContent = state.payMethod === 'card' ? 'Charging your card…' : 'Authenticating with your wallet…';
      doneSub.textContent = "This usually takes a few seconds. Please don't refresh.";

      // STUB: simulate the network round-trip. Real Stripe wiring lives behind
      // a Supabase edge function that exchanges this for a PaymentIntent.
      await new Promise((r) => setTimeout(r, 1400));

      const { pack, contact, payMethod } = state;
      const payment_ref = 'stub_' + Math.random().toString(36).slice(2, 12);

      const { data, error } = await supabase
        .from('orders')
        .insert({
          pack_id: pack.id,
          pack_slug: pack.slug,
          pack_title: pack.title,
          amount_pence: pack.price_pence,
          buyer_name: contact.name,
          buyer_email: contact.email,
          buyer_phone: contact.phone,
          buyer_company: contact.company,
          payment_method: payMethod,
          payment_ref,
          status: 'paid',
        })
        .select('id, invoice_number')
        .single();

      if (error || !data) {
        doneH.textContent = 'Something went wrong';
        doneSub.textContent = error?.message || 'Could not record the order. Please try again.';
        return;
      }

      // Stash a temporary handle so /edit/thanks can show the receipt while
      // also being reachable via the email link (?order=ID).
      try {
        sessionStorage.setItem('tmke.lastOrder', JSON.stringify({
          id: data.id,
          invoice_number: data.invoice_number,
          email: contact.email,
        }));
      } catch (_) { /* ignore */ }

      window.location.href = `/edit/thanks?order=${encodeURIComponent(data.id)}`;
    }

  </script>
</BaseLayout>
