---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="The Edit — Template Shop · TMKE"
  description="A curated shop of social media templates designed specifically for the UK property sector. On-brand, easy to customise, ready to post."
>
  <!-- Mark the body so the nav adopts its paper-friendly style (this was
       handled by PageHero, which we've replaced here with a custom split hero). -->
  <script is:inline>document.body.classList.add("has-page-hero");</script>

  <!-- ===================== Edit hero — split screen ===================== -->
  <section class="edit-hero wrap">
    <div class="edit-hero-grid">
      <div class="edit-hero-left">
        <div class="chapter">Shop — The Edit</div>
        <h1 class="edit-hero-title">A curated shop, <em>built for property.</em></h1>
        <p class="edit-hero-sub">Ten signature packs of ready-to-edit social templates for estate agents and property brands. £299 each. Open it, brand it, schedule it.</p>
        <ul class="edit-hero-list">
          <li><strong>Open in your browser</strong> — no Canva account required.</li>
          <li><strong>Type once</strong>, your brand kit applies everywhere.</li>
          <li><strong>Schedule straight</strong> to Instagram, LinkedIn or Facebook.</li>
        </ul>
        <a href="#edit-catalogue" class="edit-hero-cta">
          Browse the packs <em>&darr;</em>
        </a>
      </div>

      <!-- ===================== Animated studio demo ===================== -->
      <div class="edit-hero-right" aria-hidden="true">
        <div class="ed-demo" id="ed-demo" data-step="rest">
          <header class="ed-demo-bar">
            <span class="ed-demo-dots"><i></i><i></i><i></i></span>
            <span class="ed-demo-title">TMKE Studio</span>
            <span class="ed-demo-action">Save</span>
          </header>

          <div class="ed-demo-body">
            <aside class="ed-demo-rail">
              <span class="ed-demo-tool is-active" title="Brand">●</span>
              <span class="ed-demo-tool" title="Text">A</span>
              <span class="ed-demo-tool" title="Photo">▢</span>
              <span class="ed-demo-tool" title="Layers">≡</span>
            </aside>

            <div class="ed-demo-stage">
              <article class="ed-demo-template" id="ed-demo-template">
                <span class="ed-demo-tag">Just Listed</span>
                <h3 class="ed-demo-name" id="ed-demo-name">Your Brand</h3>
                <div class="ed-demo-meta">12 Park Crescent · SW1 · £1,250,000</div>
                <div class="ed-demo-pill">3 bed · 2 bath · garden</div>
                <div class="ed-demo-photo"></div>
              </article>
            </div>

            <aside class="ed-demo-inspector">
              <div class="ed-demo-field">
                <span>Brand name</span>
                <div class="ed-demo-input"><span id="ed-demo-input-text">Your Brand</span><i class="ed-demo-caret">|</i></div>
              </div>
              <div class="ed-demo-label">Brand colour</div>
              <div class="ed-demo-swatches" id="ed-demo-swatches">
                <button class="is-active" data-c="#1c1d22" style="background:#1c1d22"></button>
                <button data-c="#474254" style="background:#474254"></button>
                <button data-c="#7a4933" style="background:#7a4933"></button>
                <button data-c="#3a5b46" style="background:#3a5b46"></button>
              </div>
              <div class="ed-demo-label">Format</div>
              <div class="ed-demo-formats">
                <span class="is-active">Post</span>
                <span>Story</span>
                <span>Reel</span>
              </div>
            </aside>
          </div>

          <footer class="ed-demo-foot">
            <button type="button" class="ed-demo-push" id="ed-demo-push">
              Push to Social Media <em>&rarr;</em>
            </button>
          </footer>

          <!-- Floating cursor -->
          <span class="ed-demo-cursor" id="ed-demo-cursor"></span>

          <!-- Platform picker popover -->
          <div class="ed-demo-pop ed-demo-pop--platform" id="ed-demo-platforms">
            <div class="ed-demo-pop-h">Send to…</div>
            <div class="ed-demo-platforms">
              <button class="ed-demo-platform" data-p="instagram"><i>IG</i> Instagram</button>
              <button class="ed-demo-platform" data-p="linkedin"><i>in</i> LinkedIn</button>
              <button class="ed-demo-platform" data-p="facebook"><i>f</i> Facebook</button>
            </div>
          </div>

          <!-- Day picker popover -->
          <div class="ed-demo-pop ed-demo-pop--day" id="ed-demo-days">
            <div class="ed-demo-pop-h">Schedule for LinkedIn</div>
            <div class="ed-demo-days">
              <button>Mon</button>
              <button>Tue</button>
              <button>Wed</button>
              <button data-d="thu">Thu</button>
              <button>Fri</button>
            </div>
            <div class="ed-demo-pop-sub">Posts at 09:00 GMT</div>
          </div>

          <!-- Success overlay -->
          <div class="ed-demo-success" id="ed-demo-success">
            <div class="ed-demo-success-mark">&check;</div>
            <div>
              <h4>Scheduled.</h4>
              <p>Going live Thursday, 09:00 on LinkedIn.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="edit-wrap wrap" id="edit-catalogue" aria-busy="true">
    <div class="edit-loading" id="edit-loading">Loading the catalogue…</div>
    <div class="edit-empty" id="edit-empty" hidden>
      <p>The shop is opening soon — packs will appear here as they're added to The Edit.</p>
    </div>
    <div class="edit-mosaic" id="edit-grid"></div>
  </section>

  <!-- =========================================================
       Checkout modal — three steps: contact → payment → processing
       ========================================================= -->
  <div class="checkout-backdrop" id="checkout" hidden>
    <div class="checkout" role="dialog" aria-modal="true" aria-labelledby="checkout-title">
      <button type="button" class="checkout-close" id="checkout-close" aria-label="Close">&times;</button>

      <aside class="checkout-aside">
        <div class="checkout-aside-cover" id="checkout-cover"></div>
        <div class="checkout-aside-body">
          <div class="checkout-aside-eyebrow">You're buying</div>
          <h3 class="checkout-aside-title" id="checkout-pack-title">Pack title</h3>
          <p class="checkout-aside-desc" id="checkout-pack-desc"></p>
          <ul class="checkout-aside-list" id="checkout-pack-contents"></ul>
          <div class="checkout-aside-foot">
            <span class="checkout-aside-label">Total today</span>
            <span class="checkout-aside-total" id="checkout-pack-price">£299</span>
          </div>
        </div>
      </aside>

      <section class="checkout-main">
        <header class="checkout-steps">
          <span class="checkout-step is-active" data-step-pip="contact">
            <em>01</em> Your details
          </span>
          <span class="checkout-step" data-step-pip="payment">
            <em>02</em> Payment
          </span>
          <span class="checkout-step" data-step-pip="done">
            <em>03</em> Confirmation
          </span>
        </header>

        <!-- Step 1: contact details -->
        <form class="checkout-pane is-active" id="checkout-contact" data-step="contact" novalidate>
          <h2 id="checkout-title" class="checkout-h">Tell us where to send it.</h2>
          <p class="checkout-sub">Your library link and invoice will be emailed to the address below.</p>

          <label class="ck-field">
            <span>Full name</span>
            <input name="name" type="text" required autocomplete="name" />
          </label>
          <label class="ck-field">
            <span>Email</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>
          <div class="ck-row">
            <label class="ck-field">
              <span>Phone</span>
              <input name="phone" type="tel" required autocomplete="tel" />
            </label>
            <label class="ck-field">
              <span>Company / Brand</span>
              <input name="company" type="text" required autocomplete="organization" />
            </label>
          </div>

          <p class="ck-error" id="ck-contact-error" hidden></p>
          <button type="submit" class="ck-cta">Continue to payment <em>&rarr;</em></button>
          <p class="ck-mini">By continuing you agree to our terms. Card details are entered securely on the next step.</p>
        </form>

        <!-- Step 2: payment -->
        <form class="checkout-pane" id="checkout-payment" data-step="payment" novalidate>
          <h2 class="checkout-h">How would you like to pay?</h2>
          <p class="checkout-sub">All transactions are in GBP. You can pay using Apple Pay, Google Pay, or a card.</p>

          <div class="ck-paytabs" role="tablist" aria-label="Payment method">
            <button type="button" class="ck-paytab is-active" data-pay="apple_pay" role="tab" aria-selected="true">
              <span class="ck-paytab-logo" aria-hidden="true"></span>
              <span>Apple Pay</span>
            </button>
            <button type="button" class="ck-paytab" data-pay="google_pay" role="tab" aria-selected="false">
              <span class="ck-paytab-logo ck-paytab-logo--g" aria-hidden="true"></span>
              <span>Google Pay</span>
            </button>
            <button type="button" class="ck-paytab" data-pay="card" role="tab" aria-selected="false">
              <span class="ck-paytab-logo ck-paytab-logo--card" aria-hidden="true"></span>
              <span>Card</span>
            </button>
          </div>

          <!-- Apple / Google Pay panel -->
          <div class="ck-wallet" data-paypane="wallet">
            <div class="ck-wallet-frame">
              <div class="ck-wallet-row">
                <span>Pay TMKE</span>
                <span class="ck-wallet-amount" data-bind="amount">£299</span>
              </div>
              <button type="button" class="ck-wallet-btn" id="ck-wallet-btn">
                <span class="ck-wallet-btn-glyph" aria-hidden="true"></span>
                <span class="ck-wallet-btn-label">Pay with <strong>Apple Pay</strong></span>
              </button>
              <p class="ck-wallet-note">Authentication will appear on your device.</p>
            </div>
          </div>

          <!-- Card panel -->
          <div class="ck-card" data-paypane="card" hidden>
            <label class="ck-field">
              <span>Card number</span>
              <input name="card_number" inputmode="numeric" autocomplete="cc-number" placeholder="1234 1234 1234 1234" maxlength="23" />
            </label>
            <div class="ck-row">
              <label class="ck-field">
                <span>Expiry</span>
                <input name="card_exp" autocomplete="cc-exp" placeholder="MM / YY" maxlength="7" />
              </label>
              <label class="ck-field">
                <span>CVC</span>
                <input name="card_cvc" inputmode="numeric" autocomplete="cc-csc" placeholder="123" maxlength="4" />
              </label>
              <label class="ck-field">
                <span>Postcode</span>
                <input name="card_postcode" autocomplete="postal-code" placeholder="SW1A 1AA" maxlength="8" />
              </label>
            </div>
            <button type="submit" class="ck-cta" id="ck-card-submit">
              Pay <span data-bind="amount">£299</span> <em>&rarr;</em>
            </button>
          </div>

          <p class="ck-error" id="ck-payment-error" hidden></p>
          <button type="button" class="ck-back" id="ck-back-to-contact">&larr; Back to your details</button>
        </form>

        <!-- Step 3: processing / done -->
        <div class="checkout-pane" data-step="done">
          <div class="ck-done">
            <div class="ck-done-spinner" id="ck-done-spinner">
              <span class="ck-done-ring"></span>
              <span class="ck-done-ring"></span>
              <span class="ck-done-ring"></span>
            </div>
            <h2 class="checkout-h" id="ck-done-h">Processing payment…</h2>
            <p class="checkout-sub" id="ck-done-sub">Authenticating with your wallet. Please don't refresh.</p>
          </div>
        </div>
      </section>
    </div>
  </div>

  <style is:global>
    /* ===================== Edit hero — split layout ===================== */
    .edit-hero {
      max-width: 1360px;
      margin: 0 auto;
      padding: 200px 36px 100px;
    }
    .edit-hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: center;
    }
    @media (max-width: 980px) {
      .edit-hero { padding: 160px 24px 60px; }
      .edit-hero-grid { grid-template-columns: 1fr; gap: 56px; }
    }
    .edit-hero-left .chapter { margin-bottom: 56px; }
    .edit-hero-title {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(40px, 4.8vw, 76px);
      line-height: 1.05;
      letter-spacing: -0.018em;
      color: var(--ink);
      margin: 0 0 28px;
      max-width: 16ch;
    }
    .edit-hero-title em { font-style: italic; color: var(--english-violet); }
    .edit-hero-sub {
      font-family: var(--serif);
      font-style: italic;
      font-size: clamp(18px, 1.4vw, 22px);
      line-height: 1.5;
      color: rgba(28, 29, 34, 0.65);
      max-width: 540px;
      margin: 0 0 28px;
    }
    .edit-hero-list {
      list-style: none; padding: 0; margin: 0 0 36px;
      display: flex; flex-direction: column; gap: 10px;
      font-family: var(--sans); font-size: 14px;
      color: rgba(28, 29, 34, 0.75);
    }
    .edit-hero-list li { position: relative; padding-left: 22px; }
    .edit-hero-list li::before {
      content: "—"; position: absolute; left: 0; top: 0; color: var(--english-violet);
    }
    .edit-hero-list strong { font-weight: 700; color: var(--ink); }
    .edit-hero-cta {
      display: inline-flex; align-items: center; gap: 10px;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.24em; text-transform: uppercase;
      color: var(--english-violet);
      border-bottom: 1px solid currentColor;
      padding-bottom: 4px;
    }
    .edit-hero-cta em {
      font-family: var(--serif); font-style: italic;
      font-size: 18px; letter-spacing: 0; text-transform: none; margin-left: 4px;
    }

    /* ===================== Animated studio demo ===================== */
    .edit-hero-right { perspective: 1400px; }
    .ed-demo {
      position: relative;
      background: #faf8f3;
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 8px;
      box-shadow: 0 50px 80px -40px rgba(28,29,34,0.35), 0 12px 22px -10px rgba(28,29,34,0.18);
      overflow: hidden;
      transform: rotate(0.4deg);
      isolation: isolate;
      animation: edDemoIdle 8s ease-in-out infinite;
    }
    @keyframes edDemoIdle {
      0%, 100% { transform: rotate(0.4deg) translateY(0); }
      50%      { transform: rotate(-0.2deg) translateY(-4px); }
    }
    .ed-demo-bar {
      display: grid;
      grid-template-columns: 60px 1fr 60px;
      align-items: center;
      padding: 12px 16px;
      background: rgba(28,29,34,0.06);
      border-bottom: 1px solid rgba(28,29,34,0.08);
    }
    .ed-demo-dots { display: inline-flex; gap: 6px; }
    .ed-demo-dots i { width: 9px; height: 9px; border-radius: 50%; }
    .ed-demo-dots i:nth-child(1) { background: #e9a3a3; }
    .ed-demo-dots i:nth-child(2) { background: #f0d28e; }
    .ed-demo-dots i:nth-child(3) { background: #a8d8a8; }
    .ed-demo-title {
      font-family: var(--serif); font-size: 13px; font-style: italic;
      color: rgba(28,29,34,0.55); text-align: center;
    }
    .ed-demo-action {
      font-family: var(--sans); font-size: 10px;
      letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700;
      color: var(--english-violet); text-align: right;
    }
    .ed-demo-body {
      display: grid;
      grid-template-columns: 44px 1fr 160px;
      min-height: 380px;
    }
    .ed-demo-rail {
      display: flex; flex-direction: column; gap: 6px;
      padding: 14px 4px; align-items: center;
      background: rgba(28,29,34,0.04);
      border-right: 1px solid rgba(28,29,34,0.05);
    }
    .ed-demo-tool {
      width: 30px; height: 30px;
      display: inline-flex; align-items: center; justify-content: center;
      border-radius: 4px;
      font-family: var(--sans); font-size: 13px; font-weight: 700;
      color: rgba(28,29,34,0.5);
      transition: background 0.3s, color 0.3s;
    }
    .ed-demo-tool.is-active { background: var(--ink); color: var(--paper); }
    .ed-demo-stage {
      padding: 22px;
      display: flex; align-items: center; justify-content: center;
      background:
        repeating-linear-gradient(45deg, rgba(28,29,34,0.025) 0 1px, transparent 1px 14px),
        #f7f5f0;
    }
    .ed-demo-template {
      width: 100%; max-width: 280px;
      aspect-ratio: 4 / 5;
      background: var(--demo-brand, #1c1d22);
      color: var(--paper);
      border-radius: 4px;
      padding: 24px;
      display: flex; flex-direction: column; gap: 12px;
      box-shadow: 0 18px 30px -18px rgba(28,29,34,0.4);
      transition: background 0.7s cubic-bezier(.2,.7,.2,1);
      position: relative; overflow: hidden;
    }
    .ed-demo-tag {
      font-family: var(--sans); font-size: 9px;
      letter-spacing: 0.32em; text-transform: uppercase; font-weight: 700;
      color: rgba(242,239,233,0.55);
    }
    .ed-demo-name {
      font-family: var(--serif); font-weight: 500;
      font-size: 28px; letter-spacing: -0.012em; line-height: 1.05;
      margin: 4px 0 0; color: var(--paper);
      min-height: 1.1em;
    }
    .ed-demo-meta {
      font-family: var(--sans); font-size: 11px;
      letter-spacing: 0.06em; color: rgba(242,239,233,0.72);
    }
    .ed-demo-pill {
      align-self: flex-start;
      padding: 4px 9px;
      background: rgba(242,239,233,0.12);
      border-radius: 999px;
      font-family: var(--sans); font-size: 10px;
      letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700;
      color: rgba(242,239,233,0.85);
    }
    .ed-demo-photo {
      margin-top: auto; height: 120px;
      border-radius: 3px;
      background:
        linear-gradient(180deg, rgba(28,29,34,0) 30%, rgba(28,29,34,0.35) 100%),
        url("https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&w=900&q=80") center/cover;
    }

    /* Inspector */
    .ed-demo-inspector {
      padding: 18px 14px;
      background: #fcfbf7;
      border-left: 1px solid rgba(28,29,34,0.06);
      display: flex; flex-direction: column; gap: 14px;
    }
    .ed-demo-field { display: flex; flex-direction: column; gap: 6px; }
    .ed-demo-field > span,
    .ed-demo-label {
      font-family: var(--sans); font-size: 9px;
      letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700;
      color: var(--english-violet);
    }
    .ed-demo-input {
      padding: 9px 10px;
      border: 1px solid rgba(71,66,84,0.25);
      border-radius: 3px;
      background: #fff;
      font-family: var(--sans); font-size: 12px;
      color: var(--ink); min-height: 32px;
      position: relative;
      transition: border-color 0.3s, box-shadow 0.3s;
    }
    .ed-demo[data-step="typing"] .ed-demo-input {
      border-color: var(--english-violet);
      box-shadow: 0 0 0 2px rgba(71,66,84,0.15);
    }
    .ed-demo-caret { display: inline-block; opacity: 0; font-weight: 500; color: var(--english-violet); }
    .ed-demo[data-step="typing"] .ed-demo-caret { opacity: 0.85; animation: edBlink 0.9s steps(2) infinite; }
    @keyframes edBlink { 0%,50% { opacity: 0.85; } 51%,100% { opacity: 0; } }

    .ed-demo-swatches { display: grid; grid-template-columns: repeat(4, 1fr); gap: 6px; }
    .ed-demo-swatches button {
      appearance: none; border: 0;
      aspect-ratio: 1; border-radius: 50%;
      cursor: pointer; position: relative;
      transition: transform 0.3s;
    }
    .ed-demo-swatches button.is-active::after {
      content: ""; position: absolute; inset: -3px;
      border: 1.5px solid var(--english-violet);
      border-radius: 50%;
    }
    .ed-demo-formats { display: flex; gap: 4px; }
    .ed-demo-formats span {
      padding: 5px 8px;
      border: 1px solid rgba(71,66,84,0.2);
      border-radius: 2px;
      font-family: var(--sans); font-size: 9px;
      letter-spacing: 0.18em; text-transform: uppercase; font-weight: 700;
      color: rgba(28,29,34,0.55);
    }
    .ed-demo-formats .is-active { background: var(--ink); border-color: var(--ink); color: var(--paper); }

    /* Footer push button */
    .ed-demo-foot {
      padding: 14px 18px;
      border-top: 1px solid rgba(28,29,34,0.06);
      background: rgba(28,29,34,0.025);
      display: flex; justify-content: flex-end;
    }
    .ed-demo-push {
      appearance: none;
      background: var(--ink); color: var(--paper); border: 0;
      padding: 10px 16px; border-radius: 2px;
      font-family: var(--sans); font-size: 10px;
      font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase;
      cursor: pointer;
      transition: background 0.25s, transform 0.25s;
    }
    .ed-demo[data-step="push"] .ed-demo-push {
      background: var(--english-violet); transform: scale(0.97);
    }
    .ed-demo-push em {
      font-family: var(--serif); font-style: italic;
      font-size: 13px; letter-spacing: 0; text-transform: none; margin-left: 6px;
    }

    /* Animated cursor */
    .ed-demo-cursor {
      position: absolute;
      top: 50%; left: 50%;
      width: 18px; height: 18px;
      background: var(--english-violet);
      border: 2px solid var(--paper);
      border-radius: 50%;
      box-shadow: 0 2px 6px rgba(28,29,34,0.35);
      transform: translate(-50%, -50%);
      pointer-events: none; opacity: 0;
      z-index: 6;
      transition: top 0.85s cubic-bezier(.5,.1,.2,1),
                  left 0.85s cubic-bezier(.5,.1,.2,1),
                  right 0.85s cubic-bezier(.5,.1,.2,1),
                  bottom 0.85s cubic-bezier(.5,.1,.2,1),
                  opacity 0.3s;
    }
    .ed-demo:not([data-step="rest"]):not([data-step="success"]) .ed-demo-cursor { opacity: 1; }
    .ed-demo[data-step="typing"]    .ed-demo-cursor { top: 105px; right: 80px; left: auto; }
    .ed-demo[data-step="recolor"]   .ed-demo-cursor { top: 168px; right: 50px; left: auto; }
    .ed-demo[data-step="push"]      .ed-demo-cursor { bottom: 28px; right: 40px; top: auto; left: auto; }
    .ed-demo[data-step="platforms"] .ed-demo-cursor { bottom: 96px; right: 130px; top: auto; left: auto; }
    .ed-demo[data-step="days"]      .ed-demo-cursor { bottom: 110px; right: 60px; top: auto; left: auto; }

    /* Popovers */
    .ed-demo-pop {
      position: absolute;
      background: var(--ink); color: var(--paper);
      border-radius: 4px;
      padding: 14px 14px 12px;
      box-shadow: 0 20px 40px -10px rgba(0,0,0,0.45);
      opacity: 0; pointer-events: none;
      transform: translateY(8px);
      transition: opacity 0.4s, transform 0.5s cubic-bezier(.2,.7,.2,1);
      z-index: 5;
      min-width: 180px;
    }
    .ed-demo-pop-h {
      font-family: var(--sans); font-size: 9px;
      letter-spacing: 0.24em; text-transform: uppercase; font-weight: 700;
      color: rgba(242,239,233,0.55);
      margin-bottom: 8px;
    }
    .ed-demo-pop--platform { right: 18px; bottom: 70px; }
    .ed-demo-pop--day      { right: 18px; bottom: 70px; min-width: 220px; }
    .ed-demo[data-step="platforms"] .ed-demo-pop--platform,
    .ed-demo[data-step="days"]      .ed-demo-pop--day {
      opacity: 1; pointer-events: auto; transform: translateY(0);
    }
    .ed-demo-platforms { display: flex; flex-direction: column; gap: 4px; }
    .ed-demo-platform {
      appearance: none; background: transparent; border: 0;
      color: var(--paper);
      font-family: var(--sans); font-size: 12px; font-weight: 600;
      padding: 8px;
      text-align: left; border-radius: 3px;
      cursor: pointer;
      display: inline-flex; align-items: center; gap: 10px;
      transition: background 0.25s;
    }
    .ed-demo-platform i {
      width: 22px; height: 22px;
      border-radius: 4px;
      background: rgba(242,239,233,0.12);
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--serif); font-style: italic;
      font-size: 11px; font-weight: 700;
    }
    .ed-demo[data-step="platforms"] .ed-demo-platform[data-p="linkedin"] {
      background: rgba(242,239,233,0.12);
    }
    .ed-demo[data-step="platforms"] .ed-demo-platform[data-p="linkedin"] i {
      background: #0a66c2; color: var(--paper);
    }

    .ed-demo-days {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 4px;
      margin-bottom: 8px;
    }
    .ed-demo-days button {
      appearance: none;
      background: transparent;
      border: 1px solid rgba(242,239,233,0.18);
      color: var(--paper);
      font-family: var(--sans); font-size: 10px;
      font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      padding: 8px 0;
      border-radius: 2px;
      cursor: pointer;
      transition: background 0.25s, border-color 0.25s;
    }
    .ed-demo[data-step="days"] .ed-demo-days button[data-d="thu"] {
      background: var(--paper); color: var(--ink); border-color: var(--paper);
    }
    .ed-demo-pop-sub {
      font-family: var(--serif); font-style: italic;
      font-size: 11px; color: rgba(242,239,233,0.6); margin: 0;
    }

    /* Success overlay */
    .ed-demo-success {
      position: absolute;
      left: 16px; right: 16px; bottom: 16px;
      background: linear-gradient(120deg, #2e6a4a, #1f4a35);
      color: var(--paper);
      border-radius: 4px;
      padding: 14px 16px;
      display: flex; align-items: center; gap: 14px;
      box-shadow: 0 20px 40px -12px rgba(46,106,74,0.5);
      opacity: 0; transform: translateY(10px);
      pointer-events: none;
      transition: opacity 0.45s, transform 0.55s cubic-bezier(.2,.7,.2,1);
      z-index: 7;
    }
    .ed-demo[data-step="success"] .ed-demo-success {
      opacity: 1; transform: translateY(0);
    }
    .ed-demo-success-mark {
      width: 32px; height: 32px;
      border-radius: 50%;
      background: rgba(242,239,233,0.18);
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 18px; font-weight: 700;
    }
    .ed-demo-success h4 {
      font-family: var(--serif); font-weight: 500;
      font-size: 18px; margin: 0 0 2px; color: var(--paper);
    }
    .ed-demo-success p {
      font-family: var(--sans); font-size: 11px;
      color: rgba(242,239,233,0.78); margin: 0;
    }

    /* Global so the JS-injected catalogue cards inherit the styles —
       Astro scopes by data-attribute which dynamic innerHTML never gets. */
    .edit-wrap {
      max-width: 1480px;
      margin: 0 auto;
      padding: 0 36px 180px;
    }
    @media (max-width: 720px) {
      .edit-wrap { padding: 0 24px 120px; }
    }
    .edit-loading,
    .edit-empty {
      font-family: var(--sans);
      font-size: 14px;
      color: rgba(28,29,34,0.55);
      padding: 32px 0;
    }
    .edit-empty p { max-width: 520px; line-height: 1.6; }

    /* ============ Editorial mosaic ============
       12-column grid with a bespoke layout for the 10 packs — column widths
       AND aspect ratios both vary so two cards in the same row never feel
       like a pair. Big cards intentionally jump sides (right → left → right)
       and a few small squares break up the rhythm. The last card finishes
       full-width as a finale.

         Row 1:  [#1  span 5,  4:5]  [#2  span 7,  5:4]     big-right
         Row 2:  [#3  span 8,  5:4]  [#4  span 4,  1:1]     big-left
         Row 3:  [#5  span 3,  1:1]  [#6  span 6,  5:4]  [#7  span 3, 4:5]
         Row 4:  [#8  span 5,  1:1]  [#9  span 7,  4:5]     big-right (tall)
         Row 5:  [#10 span 12, 21:8 finale]                                  */
    .edit-mosaic {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      gap: 36px 28px;
    }

    .edit-card {
      position: relative;
      grid-column: span 6;
      display: flex;
      flex-direction: column;
      background: transparent;
      color: var(--ink);
      isolation: isolate;
    }
    /* Wrap the cover + body in a real <a> so the whole top of the card
       routes to the detail page. The Buy button below sits outside it
       and is the only click that opens checkout. */
    .edit-card-link {
      display: flex;
      flex-direction: column;
      color: inherit;
      text-decoration: none;
      cursor: pointer;
    }

    .edit-card:nth-child(1)  { grid-column: span 5; }
    .edit-card:nth-child(2)  { grid-column: span 7; }
    .edit-card:nth-child(3)  { grid-column: span 8; }
    .edit-card:nth-child(4)  { grid-column: span 4; }
    .edit-card:nth-child(5)  { grid-column: span 3; }
    .edit-card:nth-child(6)  { grid-column: span 6; }
    .edit-card:nth-child(7)  { grid-column: span 3; }
    .edit-card:nth-child(8)  { grid-column: span 5; }
    .edit-card:nth-child(9)  { grid-column: span 7; }
    .edit-card:nth-child(10) { grid-column: span 12; }

    @media (max-width: 1080px) {
      .edit-mosaic { grid-template-columns: repeat(6, 1fr); gap: 32px 22px; }
      .edit-card,
      .edit-card:nth-child(n) { grid-column: span 3; }
      .edit-card:nth-child(3),
      .edit-card:nth-child(8),
      .edit-card:nth-child(10) { grid-column: span 6; }
      .edit-card:nth-child(5),
      .edit-card:nth-child(7) { grid-column: span 2; }
      .edit-card:nth-child(6) { grid-column: span 4; }
    }
    @media (max-width: 720px) {
      .edit-mosaic { grid-template-columns: 1fr; gap: 28px 0; }
      .edit-card,
      .edit-card:nth-child(n) { grid-column: span 1; }
    }

    .edit-card-cover {
      position: relative;
      width: 100%;
      aspect-ratio: 4 / 5;
      background: var(--platinum);
      overflow: hidden;
      transition: transform 0.7s cubic-bezier(.2,.7,.2,1);
    }
    /* Bespoke aspect ratio per card — square / portrait / landscape / hero */
    .edit-card:nth-child(2)  .edit-card-cover { aspect-ratio: 5 / 4; }   /* landscape */
    .edit-card:nth-child(3)  .edit-card-cover { aspect-ratio: 5 / 4; }   /* wide landscape */
    .edit-card:nth-child(4)  .edit-card-cover { aspect-ratio: 1 / 1; }   /* square */
    .edit-card:nth-child(5)  .edit-card-cover { aspect-ratio: 1 / 1; }   /* small square */
    .edit-card:nth-child(6)  .edit-card-cover { aspect-ratio: 5 / 4; }   /* landscape */
    .edit-card:nth-child(8)  .edit-card-cover { aspect-ratio: 1 / 1; }   /* square */
    .edit-card:nth-child(10) .edit-card-cover { aspect-ratio: 21 / 8; }  /* full-width finale */
    @media (max-width: 720px) {
      .edit-card .edit-card-cover,
      .edit-card:nth-child(n) .edit-card-cover { aspect-ratio: 4 / 5; }
      .edit-card:nth-child(10) .edit-card-cover { aspect-ratio: 4 / 5; }
    }
    .edit-card-cover::after {
      content: "";
      position: absolute; inset: 0;
      background: linear-gradient(180deg, rgba(28,29,34,0) 55%, rgba(28,29,34,0.55) 100%);
      opacity: 0;
      transition: opacity 0.6s;
      z-index: 3;
      pointer-events: none;
    }
    .edit-card:hover .edit-card-cover::after { opacity: 1; }
    .edit-card:hover .edit-card-cover { transform: scale(1.012); }

    /* Stacked preview slides — first is visible at rest, hover cycles the rest in */
    .edit-card-slide {
      position: absolute;
      inset: 0;
      background-size: cover;
      background-position: center;
      opacity: 0;
      transition: opacity 0.55s ease-out;
    }
    .edit-card-slide.is-active { opacity: 1; }

    /* Slide indicator pips, sit above the gradient overlay */
    .edit-card-pips {
      position: absolute;
      bottom: 14px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 6px;
      z-index: 4;
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }
    .edit-card:hover .edit-card-pips { opacity: 1; }
    .edit-card-pip {
      width: 18px;
      height: 2px;
      background: rgba(255, 255, 255, 0.45);
      transition: background 0.3s, width 0.3s;
    }
    .edit-card-pip.is-active {
      background: var(--paper);
      width: 26px;
    }

    .edit-card-num {
      position: absolute;
      top: 16px; left: 16px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.32em;
      font-weight: 700;
      color: var(--paper);
      mix-blend-mode: difference;
      z-index: 2;
    }
    .edit-card-cat {
      position: absolute;
      top: 16px; right: 16px;
      padding: 5px 11px;
      background: rgba(242, 239, 233, 0.86);
      backdrop-filter: blur(6px);
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--english-violet);
      border-radius: 2px;
      z-index: 2;
    }

    .edit-card-body {
      padding: 22px 4px 0;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 8px 24px;
      align-items: end;
    }
    .edit-card-title {
      font-family: var(--serif);
      font-size: clamp(26px, 2.2vw, 34px);
      font-weight: 500;
      letter-spacing: -0.015em;
      line-height: 1.05;
      margin: 0;
      grid-column: 1;
    }
    .edit-card-price {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: start;
      padding-top: 4px;
      font-family: var(--serif);
      font-size: 24px;
      font-weight: 500;
      color: var(--english-violet);
      letter-spacing: 0;
      white-space: nowrap;
    }
    .edit-card-desc {
      grid-column: 1;
      font-size: 14px;
      line-height: 1.55;
      color: rgba(28,29,34,0.65);
      margin: 0;
    }
    .edit-card-foot {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid rgba(28, 29, 34, 0.18);
    }
    .edit-card-meta {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 600;
      color: rgba(28,29,34,0.55);
    }
    .edit-card-buy {
      appearance: none;
      background: var(--ink);
      color: var(--paper);
      border: 0;
      padding: 11px 18px;
      border-radius: 2px;
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      cursor: pointer;
      transition: background 0.3s, transform 0.4s cubic-bezier(.2,.7,.2,1);
    }
    .edit-card-buy:hover { background: var(--english-violet); transform: translateX(2px); }
    .edit-card-buy em {
      font-family: var(--serif);
      font-style: italic;
      font-size: 15px;
      letter-spacing: 0;
      text-transform: none;
      margin-left: 8px;
    }

    /* Finale card — give the wide one room to breathe with bigger type. */
    .edit-card:nth-child(10) .edit-card-title { font-size: clamp(34px, 3vw, 48px); }
    .edit-card:nth-child(10) .edit-card-price { font-size: 30px; }
    .edit-card:nth-child(10) .edit-card-body { padding-top: 26px; }

    /* ============ Checkout modal ============ */
    .checkout-backdrop[hidden] { display: none !important; }
    .checkout-backdrop {
      position: fixed; inset: 0;
      background: rgba(28, 29, 34, 0.65);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      overflow-y: auto;
    }
    .checkout {
      position: relative;
      width: min(1080px, 100%);
      max-height: calc(100vh - 48px);
      display: grid;
      grid-template-columns: 360px 1fr;
      background: var(--paper);
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 40px 100px rgba(0,0,0,0.35);
    }
    @media (max-width: 860px) {
      .checkout { grid-template-columns: 1fr; max-height: calc(100vh - 48px); overflow-y: auto; }
    }
    .checkout-close {
      position: absolute;
      top: 14px; right: 16px;
      background: rgba(242,239,233,0.85);
      border: 1px solid rgba(71,66,84,0.2);
      border-radius: 999px;
      width: 36px; height: 36px;
      font-size: 22px;
      color: var(--ink);
      cursor: pointer;
      z-index: 5;
      line-height: 1;
    }
    .checkout-close:hover { background: var(--paper); }

    .checkout-aside {
      background: linear-gradient(180deg, var(--english-violet), #2f2b39);
      color: var(--paper);
      display: flex;
      flex-direction: column;
    }
    .checkout-aside-cover {
      aspect-ratio: 4 / 3;
      background-size: cover;
      background-position: center;
      background-color: var(--platinum);
    }
    .checkout-aside-body { padding: 28px 28px 32px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
    .checkout-aside-eyebrow {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(242,239,233,0.6);
    }
    .checkout-aside-title {
      font-family: var(--serif);
      font-size: 30px;
      font-weight: 500;
      line-height: 1.05;
      letter-spacing: -0.015em;
      color: var(--paper);
      margin: 0;
    }
    .checkout-aside-desc {
      font-size: 14px;
      line-height: 1.55;
      color: rgba(242,239,233,0.7);
      margin: 6px 0 4px;
    }
    .checkout-aside-list {
      list-style: none; padding: 0; margin: 12px 0 0;
      display: flex; flex-direction: column; gap: 6px;
      font-size: 13px;
      color: rgba(242,239,233,0.75);
    }
    .checkout-aside-list li { padding-left: 18px; position: relative; }
    .checkout-aside-list li::before {
      content: "—";
      position: absolute; left: 0; color: rgba(242,239,233,0.45);
    }
    .checkout-aside-foot {
      margin-top: auto;
      padding-top: 22px;
      border-top: 1px solid rgba(242,239,233,0.18);
      display: flex; justify-content: space-between; align-items: baseline;
    }
    .checkout-aside-label {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(242,239,233,0.6);
    }
    .checkout-aside-total {
      font-family: var(--serif);
      font-size: 36px;
      font-weight: 500;
      color: var(--paper);
    }

    .checkout-main {
      padding: 40px 44px 44px;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }
    @media (max-width: 860px) { .checkout-main { padding: 32px 24px 32px; } }

    .checkout-steps {
      display: flex;
      gap: 22px;
      margin-bottom: 26px;
      padding-bottom: 18px;
      border-bottom: 1px solid rgba(28,29,34,0.1);
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28,29,34,0.4);
    }
    .checkout-step { display: inline-flex; align-items: center; gap: 8px; }
    .checkout-step em {
      font-family: var(--serif);
      font-style: italic;
      font-size: 16px;
      letter-spacing: 0;
      color: rgba(28,29,34,0.3);
    }
    .checkout-step.is-active { color: var(--english-violet); }
    .checkout-step.is-active em { color: var(--english-violet); }
    .checkout-step.is-done { color: var(--ink); }

    .checkout-pane { display: none; flex-direction: column; gap: 16px; }
    .checkout-pane.is-active { display: flex; }
    .checkout-h {
      font-family: var(--serif);
      font-size: clamp(28px, 3vw, 38px);
      font-weight: 500;
      letter-spacing: -0.015em;
      line-height: 1.1;
      margin: 0;
    }
    .checkout-sub {
      font-size: 14px;
      line-height: 1.55;
      color: rgba(28,29,34,0.65);
      margin: -6px 0 12px;
    }

    .ck-field { display: flex; flex-direction: column; gap: 6px; }
    .ck-field > span {
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--english-violet);
    }
    .ck-field input {
      font-family: var(--sans);
      font-size: 15px;
      padding: 12px 14px;
      border: 1px solid rgba(71,66,84,0.28);
      border-radius: 2px;
      background: #fff;
      color: var(--ink);
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .ck-field input:focus {
      outline: none;
      border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(71,66,84,0.12);
    }
    .ck-row {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 14px;
    }
    .ck-row:has(> :nth-child(2):last-child) { grid-template-columns: 1fr 1fr; }
    @media (max-width: 640px) { .ck-row { grid-template-columns: 1fr; } }

    .ck-cta {
      appearance: none;
      background: var(--ink);
      color: var(--paper);
      border: 0;
      padding: 16px 22px;
      border-radius: 2px;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      cursor: pointer;
      margin-top: 10px;
      transition: background 0.25s;
    }
    .ck-cta:hover { background: var(--english-violet); }
    .ck-cta em {
      font-family: var(--serif);
      font-style: italic;
      font-size: 16px;
      letter-spacing: 0;
      text-transform: none;
      margin-left: 8px;
    }
    .ck-cta[disabled] { opacity: 0.55; cursor: progress; }

    .ck-back {
      background: transparent;
      border: 0;
      color: rgba(28,29,34,0.55);
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      font-weight: 700;
      padding: 6px 0;
      margin-top: 6px;
      cursor: pointer;
      align-self: flex-start;
    }
    .ck-back:hover { color: var(--english-violet); }
    .ck-mini { font-size: 11px; color: rgba(28,29,34,0.45); margin: 6px 0 0; line-height: 1.5; }
    .ck-error {
      margin: 0;
      padding: 10px 12px;
      background: rgba(160,90,60,0.1);
      border-left: 3px solid #a05a3c;
      color: #a05a3c;
      font-size: 13px;
      font-family: var(--sans);
    }

    /* Payment tabs */
    .ck-paytabs {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin: 4px 0 12px;
    }
    @media (max-width: 520px) { .ck-paytabs { grid-template-columns: 1fr; } }
    .ck-paytab {
      appearance: none;
      background: #fff;
      border: 1px solid rgba(71,66,84,0.25);
      border-radius: 2px;
      padding: 14px 14px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: var(--ink);
      cursor: pointer;
      transition: border-color 0.25s, background 0.25s;
    }
    .ck-paytab:hover { border-color: var(--english-violet); }
    .ck-paytab.is-active {
      border-color: var(--ink);
      background: var(--ink);
      color: var(--paper);
    }
    .ck-paytab-logo {
      width: 22px; height: 22px;
      background: #000;
      mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M16.4 12.6c0-2.7 2.2-3.9 2.3-4-1.2-1.8-3.2-2-3.9-2-1.6-.2-3.2 1-4.1 1-.9 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.4 1.4 11.1.9 1.3 2 2.8 3.4 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.3 3.3-2.7 1-1.5 1.5-3 1.5-3 0-.1-2.9-1.1-2.9-4z M14.1 4.4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.2 0 2.4-.6 3-1.4z'/></svg>");
      -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M16.4 12.6c0-2.7 2.2-3.9 2.3-4-1.2-1.8-3.2-2-3.9-2-1.6-.2-3.2 1-4.1 1-.9 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.4 1.4 11.1.9 1.3 2 2.8 3.4 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.3 3.3-2.7 1-1.5 1.5-3 1.5-3 0-.1-2.9-1.1-2.9-4z M14.1 4.4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.2 0 2.4-.6 3-1.4z'/></svg>");
      mask-size: contain; -webkit-mask-size: contain;
      mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat;
    }
    .ck-paytab.is-active .ck-paytab-logo { background: var(--paper); }
    .ck-paytab-logo--g {
      /* Letter G in the same monochrome treatment */
      mask: none; -webkit-mask: none;
      background: transparent;
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--sans); font-weight: 800; font-size: 16px;
      color: inherit;
    }
    .ck-paytab-logo--g::before { content: "G"; }
    .ck-paytab-logo--card {
      mask: none; -webkit-mask: none;
      background: transparent;
      border: 1.6px solid currentColor;
      border-radius: 3px;
      position: relative;
    }
    .ck-paytab-logo--card::after {
      content: ""; position: absolute; left: 1px; right: 1px; top: 6px;
      height: 3px; background: currentColor;
    }

    /* Wallet pane */
    .ck-wallet { margin: 6px 0 14px; }
    .ck-wallet-frame {
      border: 1px solid rgba(71,66,84,0.2);
      border-radius: 4px;
      padding: 22px;
      background: #fff;
      display: flex; flex-direction: column; gap: 16px;
    }
    .ck-wallet-row {
      display: flex; justify-content: space-between; align-items: baseline;
      font-family: var(--sans);
      font-size: 13px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      font-weight: 600;
      color: rgba(28,29,34,0.55);
    }
    .ck-wallet-amount {
      font-family: var(--serif);
      font-size: 28px;
      font-weight: 500;
      letter-spacing: 0;
      text-transform: none;
      color: var(--ink);
    }
    .ck-wallet-btn {
      appearance: none;
      background: #000;
      color: #fff;
      border: 0;
      border-radius: 6px;
      padding: 16px 22px;
      font-family: -apple-system, "Helvetica Neue", var(--sans);
      font-size: 16px;
      font-weight: 600;
      letter-spacing: 0.01em;
      cursor: pointer;
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      transition: background 0.25s, transform 0.25s;
    }
    .ck-wallet-btn:hover { background: #1a1a1a; transform: translateY(-1px); }
    .ck-wallet-btn-glyph {
      width: 18px; height: 22px;
      background: #fff;
      mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M16.4 12.6c0-2.7 2.2-3.9 2.3-4-1.2-1.8-3.2-2-3.9-2-1.6-.2-3.2 1-4.1 1-.9 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.4 1.4 11.1.9 1.3 2 2.8 3.4 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.3 3.3-2.7 1-1.5 1.5-3 1.5-3 0-.1-2.9-1.1-2.9-4z M14.1 4.4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.2 0 2.4-.6 3-1.4z'/></svg>");
      -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M16.4 12.6c0-2.7 2.2-3.9 2.3-4-1.2-1.8-3.2-2-3.9-2-1.6-.2-3.2 1-4.1 1-.9 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.4 1.4 11.1.9 1.3 2 2.8 3.4 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.3 3.3-2.7 1-1.5 1.5-3 1.5-3 0-.1-2.9-1.1-2.9-4z M14.1 4.4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.2 0 2.4-.6 3-1.4z'/></svg>");
      mask-size: contain; -webkit-mask-size: contain;
      mask-repeat: no-repeat; -webkit-mask-repeat: no-repeat;
    }
    .ck-wallet-btn[data-wallet="google_pay"] {
      background: #fff;
      color: #3c4043;
      border: 1px solid #dadce0;
    }
    .ck-wallet-btn[data-wallet="google_pay"] .ck-wallet-btn-glyph {
      mask: none; -webkit-mask: none; background: transparent;
      display: inline-flex; align-items: center; justify-content: center;
      width: auto; height: auto;
      font-weight: 700; font-size: 18px;
    }
    .ck-wallet-btn[data-wallet="google_pay"] .ck-wallet-btn-glyph::before {
      content: "G"; color: #4285F4;
    }
    .ck-wallet-note { font-size: 12px; color: rgba(28,29,34,0.5); margin: 0; text-align: center; }

    .ck-card { display: flex; flex-direction: column; gap: 14px; }
    .ck-card[hidden],
    .ck-wallet[hidden] { display: none !important; }

    /* Done pane */
    .ck-done {
      padding: 40px 0;
      display: flex; flex-direction: column; align-items: center; text-align: center; gap: 18px;
    }
    .ck-done-spinner {
      position: relative; width: 70px; height: 70px; margin-bottom: 8px;
    }
    .ck-done-ring {
      position: absolute; inset: 0;
      border: 2px solid transparent;
      border-top-color: var(--english-violet);
      border-radius: 50%;
      animation: ck-spin 1.4s cubic-bezier(.5,.1,.5,.9) infinite;
    }
    .ck-done-ring:nth-child(2) { inset: 10px; border-top-color: rgba(71,66,84,0.4); animation-duration: 1.7s; animation-direction: reverse; }
    .ck-done-ring:nth-child(3) { inset: 20px; border-top-color: rgba(71,66,84,0.2); animation-duration: 2.1s; }
    @keyframes ck-spin { from { transform: rotate(0); } to { transform: rotate(360deg); } }
  </style>

  <script>
    import { supabase, gbpFromPence } from '../lib/supabase.js';

    const grid = document.getElementById('edit-grid');
    const loading = document.getElementById('edit-loading');
    const empty = document.getElementById('edit-empty');
    const wrap = document.getElementById('edit-catalogue');

    const modal = document.getElementById('checkout');
    const modalClose = document.getElementById('checkout-close');
    const stepPanes = modal.querySelectorAll('.checkout-pane');
    const stepPips = modal.querySelectorAll('.checkout-step');
    const coverEl = document.getElementById('checkout-cover');
    const pkgTitleEl = document.getElementById('checkout-pack-title');
    const pkgDescEl = document.getElementById('checkout-pack-desc');
    const pkgListEl = document.getElementById('checkout-pack-contents');
    const pkgPriceEl = document.getElementById('checkout-pack-price');

    const contactForm = document.getElementById('checkout-contact');
    const paymentForm = document.getElementById('checkout-payment');
    const contactErr = document.getElementById('ck-contact-error');
    const paymentErr = document.getElementById('ck-payment-error');
    const walletBtn = document.getElementById('ck-wallet-btn');
    const cardSubmit = document.getElementById('ck-card-submit');
    const backBtn = document.getElementById('ck-back-to-contact');
    const doneH = document.getElementById('ck-done-h');
    const doneSub = document.getElementById('ck-done-sub');

    const state = {
      pack: null,
      contact: null,
      payMethod: 'apple_pay',
    };

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }

    function renderCard(p, i) {
      // Build the slide list: main cover first, then preview_images. Filter
      // out empties so we never render a blank slide.
      const slideUrls = [p.cover_image_url, ...(p.preview_images ?? [])]
        .filter((u) => typeof u === 'string' && u.length > 0);
      const slides = slideUrls
        .map((url, idx) => `
          <div class="edit-card-slide${idx === 0 ? ' is-active' : ''}"
               style="background-image:url('${escapeHtml(url)}')"></div>
        `)
        .join('');
      const pips = slideUrls.length > 1
        ? `<div class="edit-card-pips">${
            slideUrls.map((_, idx) => `<span class="edit-card-pip${idx === 0 ? ' is-active' : ''}"></span>`).join('')
          }</div>`
        : '';

      const isFree = (p.price_pence ?? 0) === 0;
      const priceLabel = isFree ? 'Free' : gbpFromPence(p.price_pence);
      const num = String(i + 1).padStart(2, '0');
      const contentsCount = (p.contents ?? []).length;
      const tag = contentsCount ? `${contentsCount} items inside` : '';

      return `
        <article class="edit-card" data-id="${p.id}" data-slug="${escapeHtml(p.slug)}" data-slides="${slideUrls.length}">
          <a class="edit-card-link" href="/edit/${encodeURIComponent(p.slug)}" aria-label="See inside ${escapeHtml(p.title)}">
            <div class="edit-card-cover">
              ${slides}
              ${pips}
              <span class="edit-card-num">№ ${num}</span>
              ${p.category ? `<span class="edit-card-cat">${escapeHtml(p.category)}</span>` : ''}
            </div>
            <div class="edit-card-body">
              <h3 class="edit-card-title">${escapeHtml(p.title)}</h3>
              <span class="edit-card-price">${priceLabel}</span>
              ${p.description ? `<p class="edit-card-desc">${escapeHtml(p.description)}</p>` : '<p class="edit-card-desc"></p>'}
            </div>
          </a>
          <div class="edit-card-foot">
            <span class="edit-card-meta">${escapeHtml(tag)}</span>
            <button type="button" class="edit-card-buy" data-buy="${p.id}">
              Buy pack <em>&rarr;</em>
            </button>
          </div>
        </article>
      `;
    }

    // Cycle the preview slides while a card is being hovered. We start at index 0
    // (the main cover), advance every 900ms, and reset on mouseleave so the card
    // always returns to its hero shot.
    const HOVER_INTERVAL = 900;
    function wireHoverGallery(root) {
      root.querySelectorAll('.edit-card').forEach((card) => {
        const slides = card.querySelectorAll('.edit-card-slide');
        const pips = card.querySelectorAll('.edit-card-pip');
        if (slides.length <= 1) return;
        let timer = null;
        let i = 0;
        const setActive = (idx) => {
          slides.forEach((s, n) => s.classList.toggle('is-active', n === idx));
          pips.forEach((p, n) => p.classList.toggle('is-active', n === idx));
        };
        card.addEventListener('mouseenter', () => {
          if (timer) return;
          timer = setInterval(() => {
            i = (i + 1) % slides.length;
            setActive(i);
          }, HOVER_INTERVAL);
        });
        card.addEventListener('mouseleave', () => {
          if (timer) { clearInterval(timer); timer = null; }
          i = 0;
          setActive(0);
        });
      });
    }

    let packsById = new Map();

    (async () => {
      const { data, error } = await supabase
        .from('packs')
        .select('id, slug, title, description, price_pence, cover_image_url, preview_images, contents, category, sort_order')
        .eq('status', 'active')
        .order('sort_order', { ascending: true })
        .order('created_at', { ascending: false });

      loading.hidden = true;
      wrap.setAttribute('aria-busy', 'false');

      if (error) {
        empty.hidden = false;
        empty.innerHTML = `<p>Could not load the catalogue right now — please try again shortly.</p>`;
        return;
      }
      const packs = data ?? [];
      if (packs.length === 0) { empty.hidden = false; return; }

      packsById = new Map(packs.map((p) => [p.id, p]));
      grid.innerHTML = packs.map((p, i) => renderCard(p, i)).join('');
      wireHoverGallery(grid);
      maybeOpenFromQuery();
    })();

    // ============== Modal helpers ==============
    function showStep(step) {
      stepPanes.forEach((p) => p.classList.toggle('is-active', p.dataset.step === step));
      const order = ['contact', 'payment', 'done'];
      const idx = order.indexOf(step);
      stepPips.forEach((pip) => {
        const i = order.indexOf(pip.dataset.stepPip);
        pip.classList.toggle('is-active', i === idx);
        pip.classList.toggle('is-done', i < idx);
      });
    }

    function openCheckout(pack) {
      state.pack = pack;
      state.contact = null;
      state.payMethod = 'apple_pay';

      pkgTitleEl.textContent = pack.title;
      pkgDescEl.textContent = pack.description ?? '';
      pkgListEl.innerHTML = (pack.contents ?? []).slice(0, 4).map((c) => `<li>${escapeHtml(c)}</li>`).join('');
      pkgPriceEl.textContent = gbpFromPence(pack.price_pence);
      coverEl.style.backgroundImage = pack.cover_image_url ? `url('${pack.cover_image_url}')` : '';

      // Update £ amount on payment step in two places
      modal.querySelectorAll('[data-bind="amount"]').forEach((el) => {
        el.textContent = gbpFromPence(pack.price_pence);
      });

      // Reset form state
      contactForm.reset();
      paymentForm.reset();
      contactErr.hidden = true; paymentErr.hidden = true;
      selectPayMethod('apple_pay');

      showStep('contact');
      modal.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => contactForm.elements.name.focus(), 60);
    }

    function closeCheckout() {
      modal.hidden = true;
      document.body.style.overflow = '';
    }

    grid.addEventListener('click', (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      // Only the explicit Buy button opens checkout. Clicking elsewhere on
      // the card follows the wrapping <a> to the pack-detail page.
      const buyEl = target.closest('[data-buy]');
      if (!buyEl) return;
      e.preventDefault();
      const id = buyEl.getAttribute('data-buy');
      if (!id) return;
      const pack = packsById.get(id);
      if (pack) openCheckout(pack);
    });

    // ?buy=<id> deep-link: pack-detail page sends users back here to
    // trigger the checkout modal for a specific pack.
    function maybeOpenFromQuery() {
      const want = new URLSearchParams(location.search).get('buy');
      if (!want) return;
      const pack = packsById.get(want);
      if (pack) {
        openCheckout(pack);
        // Clean the URL so refreshes don't re-open the modal
        const u = new URL(location.href);
        u.searchParams.delete('buy');
        history.replaceState({}, '', u.toString());
      }
    }

    modalClose.addEventListener('click', closeCheckout);
    modal.addEventListener('click', (e) => { if (e.target === modal) closeCheckout(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeCheckout();
    });

    // ============== Step 1: contact ==============
    contactForm.addEventListener('submit', (e) => {
      e.preventDefault();
      contactErr.hidden = true;
      const fd = new FormData(contactForm);
      const name = String(fd.get('name') || '').trim();
      const email = String(fd.get('email') || '').trim();
      const phone = String(fd.get('phone') || '').trim();
      const company = String(fd.get('company') || '').trim();
      if (!name || !email || !phone || !company) {
        contactErr.textContent = 'Please complete every field so we can email your library link.';
        contactErr.hidden = false;
        return;
      }
      if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
        contactErr.textContent = 'That email doesn’t look quite right — double-check it?';
        contactErr.hidden = false;
        return;
      }
      state.contact = { name, email, phone, company };
      showStep('payment');
    });

    // ============== Step 2: payment ==============
    function selectPayMethod(method) {
      state.payMethod = method;
      modal.querySelectorAll('.ck-paytab').forEach((tab) => {
        const active = tab.dataset.pay === method;
        tab.classList.toggle('is-active', active);
        tab.setAttribute('aria-selected', String(active));
      });
      const wallet = modal.querySelector('[data-paypane="wallet"]');
      const card = modal.querySelector('[data-paypane="card"]');
      const isWallet = method !== 'card';
      wallet.hidden = !isWallet;
      card.hidden = isWallet;
      if (isWallet) {
        const label = walletBtn.querySelector('.ck-wallet-btn-label');
        label.innerHTML = method === 'apple_pay'
          ? 'Pay with <strong> Pay</strong>'
          : 'Pay with <strong>G Pay</strong>';
        walletBtn.dataset.wallet = method;
      }
    }

    modal.querySelectorAll('.ck-paytab').forEach((tab) => {
      tab.addEventListener('click', () => selectPayMethod(tab.dataset.pay));
    });

    backBtn.addEventListener('click', () => showStep('contact'));

    walletBtn.addEventListener('click', () => processPayment());

    paymentForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (state.payMethod !== 'card') { processPayment(); return; }
      paymentErr.hidden = true;
      const fd = new FormData(paymentForm);
      const num = String(fd.get('card_number') || '').replace(/\s+/g, '');
      const exp = String(fd.get('card_exp') || '').trim();
      const cvc = String(fd.get('card_cvc') || '').trim();
      const postcode = String(fd.get('card_postcode') || '').trim();
      if (num.length < 12 || exp.length < 4 || cvc.length < 3 || !postcode) {
        paymentErr.textContent = 'Please complete your card details before paying.';
        paymentErr.hidden = false;
        return;
      }
      processPayment();
    });

    // ============== Step 3: processing → redirect ==============
    async function processPayment() {
      showStep('done');
      doneH.textContent = state.payMethod === 'card' ? 'Charging your card…' : 'Authenticating with your wallet…';
      doneSub.textContent = "This usually takes a few seconds. Please don't refresh.";

      // STUB: simulate the network round-trip. Real Stripe wiring lives behind
      // a Supabase edge function that exchanges this for a PaymentIntent.
      await new Promise((r) => setTimeout(r, 1400));

      const { pack, contact, payMethod } = state;
      const payment_ref = 'stub_' + Math.random().toString(36).slice(2, 12);

      const { data, error } = await supabase
        .from('orders')
        .insert({
          pack_id: pack.id,
          pack_slug: pack.slug,
          pack_title: pack.title,
          amount_pence: pack.price_pence,
          buyer_name: contact.name,
          buyer_email: contact.email,
          buyer_phone: contact.phone,
          buyer_company: contact.company,
          payment_method: payMethod,
          payment_ref,
          status: 'paid',
        })
        .select('id, invoice_number')
        .single();

      if (error || !data) {
        doneH.textContent = 'Something went wrong';
        doneSub.textContent = error?.message || 'Could not record the order. Please try again.';
        return;
      }

      // Stash a temporary handle so /edit/thanks can show the receipt while
      // also being reachable via the email link (?order=ID).
      try {
        sessionStorage.setItem('tmke.lastOrder', JSON.stringify({
          id: data.id,
          invoice_number: data.invoice_number,
          email: contact.email,
        }));
      } catch (_) { /* ignore */ }

      window.location.href = `/edit/thanks?order=${encodeURIComponent(data.id)}`;
    }

    // ============== Studio demo — looping choreography ==============
    // States: rest -> typing -> recolor -> push -> platforms -> days -> success -> rest
    // Each step's duration is the "hold" before advancing. Total loop ~14s.
    (function () {
      const demo = document.getElementById('ed-demo');
      if (!demo) return;
      const nameEl = document.getElementById('ed-demo-name');
      const inputEl = document.getElementById('ed-demo-input-text');
      const swatchesEl = document.getElementById('ed-demo-swatches');

      const FINAL_NAME = 'Crescent Lettings';
      const BRAND_COLOUR = '#7a4933';
      const RESET_COLOUR = '#1c1d22';
      const RESET_NAME = 'Your Brand';

      // typeWriter — types each character of `text` into both the inspector
      // input and the template name in quick succession.
      function typeWriter(text, perChar = 70) {
        return new Promise((resolve) => {
          let i = 0;
          inputEl.textContent = '';
          nameEl.firstChild && (nameEl.textContent = '');
          const tick = () => {
            i += 1;
            const slice = text.slice(0, i);
            inputEl.textContent = slice;
            nameEl.textContent = slice;
            if (i < text.length) setTimeout(tick, perChar);
            else resolve();
          };
          setTimeout(tick, perChar);
        });
      }

      function setStep(s) { demo.setAttribute('data-step', s); }
      function wait(ms) { return new Promise((r) => setTimeout(r, ms)); }

      function setActiveSwatch(hex) {
        swatchesEl.querySelectorAll('button').forEach((b) => {
          b.classList.toggle('is-active', b.dataset.c === hex);
        });
        demo.style.setProperty('--demo-brand', hex);
      }

      function reset() {
        setStep('rest');
        inputEl.textContent = RESET_NAME;
        nameEl.textContent = RESET_NAME;
        setActiveSwatch(RESET_COLOUR);
      }

      async function play() {
        while (true) {
          reset();
          await wait(1400);

          setStep('typing');
          await wait(450);
          await typeWriter(FINAL_NAME, 65);
          await wait(900);

          setStep('recolor');
          await wait(700);
          setActiveSwatch(BRAND_COLOUR);
          await wait(1400);

          setStep('push');
          await wait(900);

          setStep('platforms');
          await wait(2000);

          setStep('days');
          await wait(2000);

          setStep('success');
          await wait(2600);
        }
      }

      // Only run while the demo is on screen — saves cycles when scrolled past.
      let started = false;
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && !started) {
            started = true;
            play();
          }
        });
      }, { threshold: 0.25 });
      io.observe(demo);

      // Respect reduced-motion — show the success state once, no looping.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        io.disconnect();
        started = true;
        inputEl.textContent = FINAL_NAME;
        nameEl.textContent = FINAL_NAME;
        setActiveSwatch(BRAND_COLOUR);
        setStep('success');
      }
    })();
  </script>
</BaseLayout>
