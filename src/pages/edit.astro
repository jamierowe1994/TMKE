---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="The Edit — Template Shop · TMKE"
  description="A curated shop of social media templates designed specifically for the UK property sector. On-brand, easy to customise, ready to post."
>
  <!-- simple hero — small, left-aligned "The Edit" + sub at the top-left -->
  <header class="edit-hero">
    <h1 class="edit-hero-title">The Edit</h1>
    <p class="edit-hero-sub">Ready-to-post template packs, built for property — on-brand and yours to customise.</p>
  </header>

  <section class="edit-wrap" id="edit-catalogue" aria-busy="true">
    <div class="edit-loading" id="edit-loading">Loading the catalogue…</div>
    <div class="edit-empty" id="edit-empty" hidden>
      <p>The shop is opening soon — packs will appear here as they're added to The Edit.</p>
    </div>
    <div class="edit-shows" id="edit-grid"></div>
  </section>

  <!-- =========================================================
       Checkout modal — three steps: contact → payment → processing
       ========================================================= -->
  <div class="checkout-backdrop" id="checkout" hidden>
    <div class="checkout" role="dialog" aria-modal="true" aria-labelledby="checkout-title">
      <button type="button" class="checkout-close" id="checkout-close" aria-label="Close">&times;</button>

      <aside class="checkout-aside">
        <div class="checkout-aside-cover" id="checkout-cover"></div>
        <div class="checkout-aside-body">
          <div class="checkout-aside-eyebrow">You're buying</div>
          <h3 class="checkout-aside-title" id="checkout-pack-title">Pack title</h3>
          <p class="checkout-aside-desc" id="checkout-pack-desc"></p>
          <ul class="checkout-aside-list" id="checkout-pack-contents"></ul>
          <div class="checkout-aside-foot">
            <span class="checkout-aside-label">Total today</span>
            <span class="checkout-aside-total" id="checkout-pack-price">£299</span>
          </div>
        </div>
      </aside>

      <section class="checkout-main">
        <header class="checkout-steps">
          <span class="checkout-step is-active" data-step-pip="contact">
            <em>01</em> Your details
          </span>
          <span class="checkout-step" data-step-pip="payment">
            <em>02</em> Payment
          </span>
          <span class="checkout-step" data-step-pip="done">
            <em>03</em> Confirmation
          </span>
        </header>

        <!-- Step 1: contact details -->
        <form class="checkout-pane is-active" id="checkout-contact" data-step="contact" novalidate>
          <h2 id="checkout-title" class="checkout-h">Tell us where to send it.</h2>
          <p class="checkout-sub">Your library link and invoice will be emailed to the address below.</p>

          <label class="ck-field">
            <span>Full name</span>
            <input name="name" type="text" required autocomplete="name" />
          </label>
          <label class="ck-field">
            <span>Email</span>
            <input name="email" type="email" required autocomplete="email" />
          </label>
          <div class="ck-row">
            <label class="ck-field">
              <span>Phone</span>
              <input name="phone" type="tel" required autocomplete="tel" />
            </label>
            <label class="ck-field">
              <span>Company / Brand</span>
              <input name="company" type="text" required autocomplete="organization" />
            </label>
          </div>

          <p class="ck-error" id="ck-contact-error" hidden></p>
          <button type="submit" class="ck-cta">Continue to payment <em>&rarr;</em></button>
          <p class="ck-mini">By continuing you agree to our terms. Card details are entered securely on the next step.</p>
        </form>

        <!-- Step 2: payment -->
        <form class="checkout-pane" id="checkout-payment" data-step="payment" novalidate>
          <h2 class="checkout-h">How would you like to pay?</h2>
          <p class="checkout-sub">All transactions are in GBP. You can pay using Apple Pay, Google Pay, or a card.</p>

          <div class="ck-paytabs" role="tablist" aria-label="Payment method">
            <button type="button" class="ck-paytab is-active" data-pay="apple_pay" role="tab" aria-selected="true">
              <span class="ck-paytab-logo" aria-hidden="true"></span>
              <span>Apple Pay</span>
            </button>
            <button type="button" class="ck-paytab" data-pay="google_pay" role="tab" aria-selected="false">
              <span class="ck-paytab-logo ck-paytab-logo--g" aria-hidden="true"></span>
              <span>Google Pay</span>
            </button>
            <button type="button" class="ck-paytab" data-pay="card" role="tab" aria-selected="false">
              <span class="ck-paytab-logo ck-paytab-logo--card" aria-hidden="true"></span>
              <span>Card</span>
            </button>
          </div>

          <!-- Apple / Google Pay panel -->
          <div class="ck-wallet" data-paypane="wallet">
            <div class="ck-wallet-frame">
              <div class="ck-wallet-row">
                <span>Pay TMKE</span>
                <span class="ck-wallet-amount" data-bind="amount">£299</span>
              </div>
              <button type="button" class="ck-wallet-btn" id="ck-wallet-btn">
                <span class="ck-wallet-btn-glyph" aria-hidden="true"></span>
                <span class="ck-wallet-btn-label">Pay with <strong>Apple Pay</strong></span>
              </button>
              <p class="ck-wallet-note">Authentication will appear on your device.</p>
            </div>
          </div>

          <!-- Card panel -->
          <div class="ck-card" data-paypane="card" hidden>
            <label class="ck-field">
              <span>Card number</span>
              <input name="card_number" inputmode="numeric" autocomplete="cc-number" placeholder="1234 1234 1234 1234" maxlength="23" />
            </label>
            <div class="ck-row">
              <label class="ck-field">
                <span>Expiry</span>
                <input name="card_exp" autocomplete="cc-exp" placeholder="MM / YY" maxlength="7" />
              </label>
              <label class="ck-field">
                <span>CVC</span>
                <input name="card_cvc" inputmode="numeric" autocomplete="cc-csc" placeholder="123" maxlength="4" />
              </label>
              <label class="ck-field">
                <span>Postcode</span>
                <input name="card_postcode" autocomplete="postal-code" placeholder="SW1A 1AA" maxlength="8" />
              </label>
            </div>
            <button type="submit" class="ck-cta" id="ck-card-submit">
              Pay <span data-bind="amount">£299</span> <em>&rarr;</em>
            </button>
          </div>

          <p class="ck-error" id="ck-payment-error" hidden></p>
          <button type="button" class="ck-back" id="ck-back-to-contact">&larr; Back to your details</button>
        </form>

        <!-- Step 3: processing / done -->
        <div class="checkout-pane" data-step="done">
          <div class="ck-done">
            <div class="ck-done-spinner" id="ck-done-spinner">
              <span class="ck-done-ring"></span>
              <span class="ck-done-ring"></span>
              <span class="ck-done-ring"></span>
            </div>
            <h2 class="checkout-h" id="ck-done-h">Processing payment…</h2>
            <p class="checkout-sub" id="ck-done-sub">Authenticating with your wallet. Please don't refresh.</p>
          </div>
        </div>
      </section>
    </div>
  </div>

  <style is:global>
    /* The Edit's hero sits further down the page than the default —
       gives the headline more breathing room beneath the nav.
       (Scoped to this page only — Astro emits the style on /edit alone.) */
    /* Two classes needed (.page-hero.wrap) so we win the cascade over
       the global .wrap rule, which uses the shorthand `padding: 0 36px`
       and would otherwise reset padding-top to 0. */
    .page-hero.wrap { padding-top: 200px; }

    /* ===== Hero — small, left-aligned "The Edit" + sub, aligned to the
       catalogue's left edge (same horizontal padding as .edit-wrap). ===== */
    .edit-hero {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      text-align: left;
      padding: clamp(130px, 16vh, 180px) clamp(24px, 4vw, 64px) clamp(28px, 4vh, 48px);
    }
    .edit-hero-title {
      margin: 0;
      font-family: var(--serif);
      font-weight: 500;
      font-size: clamp(30px, 4vw, 52px);   /* much smaller than before */
      line-height: 1;
      letter-spacing: -0.02em;
      color: var(--ink);
    }
    .edit-hero-sub {
      margin: 14px 0 0;
      max-width: 560px;
      font-family: var(--sans);
      font-size: clamp(14px, 1.25vw, 18px);   /* unchanged — same text size */
      line-height: 1.55;
      letter-spacing: 0.01em;
      color: rgba(28, 29, 34, 0.6);
    }
    /* ====== STRIPPED — studio demo moved to the homepage Chapter 5 ====== */

    /* Global so the JS-injected catalogue cards inherit the styles —
       Astro scopes by data-attribute which dynamic innerHTML never gets. */
    /* Full-width catalogue — fills the viewport (same side padding as the hero)
       and the 12-col mosaic scales fluidly with the screen size. */
    .edit-wrap {
      position: relative;
      z-index: 1;
      max-width: none;
      margin: 0;
      padding: 0 clamp(24px, 4vw, 64px) 180px;
    }
    @media (max-width: 720px) {
      .edit-wrap { padding: 0 24px 120px; }
    }
    .edit-loading,
    .edit-empty {
      font-family: var(--sans);
      font-size: 14px;
      color: rgba(28,29,34,0.55);
      padding: 32px 0;
    }
    .edit-empty p { max-width: 520px; line-height: 1.6; }

    /* ============ Showcase — alternating feature bands ============
       Each pack is its own editorial "feature": a matted, framed hero print with
       supporting photos clustered around it on one side, and the pack's story +
       price + CTA on the other. Rows alternate (image left / right) and reveal as
       they scroll into view. */
    .edit-shows {
      display: flex;
      flex-direction: column;
      gap: clamp(64px, 9vh, 150px);
      max-width: 1280px;
      margin: 0 auto;
      padding-top: clamp(16px, 4vh, 48px);
    }

    .show { position: relative; }
    .show-inner {
      display: flex;
      align-items: center;
      gap: clamp(36px, 5.5vw, 104px);
      min-height: min(80vh, 760px);
    }
    .show-media { flex: 1 1 54%; min-width: 0; }
    .show-copy  { flex: 1 1 40%; min-width: 0; }
    /* Flip every other band so the page zig-zags down the screen. */
    .show:nth-child(even) .show-inner { flex-direction: row-reverse; }
    @media (max-width: 900px) {
      .show-inner,
      .show:nth-child(even) .show-inner { flex-direction: column; gap: 38px; min-height: 0; }
      .show-media, .show-copy { flex: none; width: 100%; }
    }

    /* ---- Photo cluster (the built frame + supporting prints) ---- */
    .show-media {
      position: relative;
      display: flex;
      justify-content: center;
      padding: clamp(30px, 4vw, 72px);   /* room for the accents to peek out */
    }
    .show-ghost {
      position: absolute;
      top: -8%; left: 0;
      font-family: var(--serif);
      font-weight: 500;
      font-size: clamp(130px, 17vw, 250px);
      line-height: 1;
      color: rgba(55, 30, 40, 0.06);
      z-index: 0;
      pointer-events: none;
      user-select: none;
      translate: 0 var(--par, 0px);
    }
    .show:nth-child(even) .show-ghost { left: auto; right: 0; }

    .show-stage {
      position: relative;
      display: block;
      width: min(390px, 78%);
      aspect-ratio: 3 / 4;
      z-index: 3;
      text-decoration: none;
    }

    /* The frame itself — a gallery-mounted print: paper mount, hairline bevel,
       layered drop shadow. (Built in CSS, not an image — swap for a PNG frame
       later if you prefer a more literal one.) */
    .show-frame {
      position: relative;
      margin: 0;
      width: 100%;
      height: 100%;
      background: var(--paper);
      padding: clamp(12px, 1.5vw, 20px);
      border: 1px solid rgba(28, 29, 34, 0.10);
      box-shadow:
        0 40px 70px -30px rgba(28, 29, 34, 0.5),
        0 8px 20px -10px rgba(28, 29, 34, 0.28);
      transition: transform 0.85s cubic-bezier(.2,.7,.2,1), box-shadow 0.85s;
    }
    .show-frame::after {
      content: "";
      position: absolute;
      inset: clamp(7px, 1vw, 13px);
      border: 1px solid rgba(28, 29, 34, 0.16);
      pointer-events: none;
      z-index: 4;
    }
    .show-mount {
      position: relative;
      width: 100%; height: 100%;
      overflow: hidden;
      background: var(--platinum);
    }
    .show-slide {
      position: absolute; inset: 0;
      background-size: cover; background-position: center;
      opacity: 0;
      transition: opacity 0.7s ease;
    }
    .show-slide.is-active { opacity: 1; }
    .show-frame-cap {
      position: absolute;
      left: 2px; bottom: -28px;
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.26em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28, 29, 34, 0.45);
    }

    /* Supporting prints peeking out behind the frame. */
    .show-accent {
      position: absolute;
      width: 47%;
      aspect-ratio: 3 / 4;
      background-size: cover; background-position: center;
      background-color: var(--platinum);
      border: 6px solid var(--paper);
      box-shadow: 0 24px 44px -20px rgba(28, 29, 34, 0.45);
      z-index: 2;
      transition: transform 0.9s cubic-bezier(.2,.7,.2,1);
    }
    .show-accent--top { top: -13%; right: -9%; transform: rotate(5deg); }
    .show-accent--bot { bottom: -13%; left: -9%; width: 41%; transform: rotate(-6deg); }
    .show:nth-child(even) .show-accent--top { right: auto; left: -9%; transform: rotate(-5deg); }
    .show:nth-child(even) .show-accent--bot { left: auto; right: -9%; transform: rotate(6deg); }

    /* Hover: the whole cluster comes alive — frame lifts, prints fan out. */
    .show-media:hover .show-frame {
      transform: translateY(-8px) rotate(-0.6deg);
      box-shadow:
        0 56px 96px -34px rgba(28, 29, 34, 0.55),
        0 10px 26px -10px rgba(28, 29, 34, 0.3);
    }
    .show-media:hover .show-accent--top { transform: translate(10%, -7%) rotate(8deg); }
    .show-media:hover .show-accent--bot { transform: translate(-10%, 7%) rotate(-9deg); }
    .show:nth-child(even) .show-media:hover .show-accent--top { transform: translate(-10%, -7%) rotate(-8deg); }
    .show:nth-child(even) .show-media:hover .show-accent--bot { transform: translate(10%, 7%) rotate(9deg); }

    @media (max-width: 560px) {
      .show-stage { width: min(300px, 86%); }
      .show-accent--top { right: -7%; } .show-accent--bot { left: -7%; }
      .show:nth-child(even) .show-accent--top { left: -7%; }
      .show:nth-child(even) .show-accent--bot { right: -7%; }
    }

    /* ---- Copy side ---- */
    .show-copy { position: relative; max-width: 540px; }
    .show:nth-child(even) .show-copy { margin-left: auto; }
    .show-eyebrow {
      display: flex; align-items: center; gap: 12px;
      font-family: var(--sans);
      font-size: 11px; font-weight: 700;
      letter-spacing: 0.28em; text-transform: uppercase;
      color: var(--english-violet);
      margin: 0 0 18px;
    }
    .show-eyebrow::before {
      content: ""; width: 36px; height: 1px;
      background: var(--english-violet); opacity: 0.5;
    }
    .show-title {
      font-family: var(--serif); font-weight: 500;
      font-size: clamp(36px, 4.4vw, 62px);
      line-height: 1.0; letter-spacing: -0.02em;
      margin: 0; color: var(--ink);
    }
    .show-desc {
      font-family: var(--sans);
      font-size: clamp(15px, 1.2vw, 17px);
      line-height: 1.62; color: rgba(28, 29, 34, 0.66);
      margin: 20px 0 0; max-width: 46ch;
    }
    .show-inside {
      list-style: none; padding: 0; margin: 24px 0 0;
      display: grid; grid-template-columns: 1fr 1fr; gap: 9px 20px;
    }
    @media (max-width: 460px) { .show-inside { grid-template-columns: 1fr; } }
    .show-inside li {
      font-family: var(--sans); font-size: 13px; line-height: 1.4;
      color: rgba(28, 29, 34, 0.62); padding-left: 19px; position: relative;
    }
    .show-inside li::before {
      content: "\2192"; position: absolute; left: 0; color: var(--english-violet);
    }
    .show-foot {
      margin-top: clamp(28px, 3.4vw, 42px);
      display: flex; align-items: center; gap: clamp(18px, 2.4vw, 32px);
      flex-wrap: wrap;
    }
    .show-price {
      font-family: var(--serif); font-size: 32px; font-weight: 500;
      color: var(--ink); letter-spacing: 0;
    }
    .show-price small { font-size: 13px; color: rgba(28, 29, 34, 0.5); }
    .show-ctas { display: flex; align-items: center; gap: 16px; }
    .show-see {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: var(--ink); text-decoration: none;
      border-bottom: 1px solid rgba(28, 29, 34, 0.3); padding-bottom: 3px;
      transition: color 0.25s, border-color 0.25s;
    }
    .show-see:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .show-buy {
      appearance: none;
      background: var(--ink); color: var(--paper);
      border: 0; padding: 13px 22px; border-radius: 2px;
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.24em; text-transform: uppercase;
      cursor: pointer;
      transition: background 0.3s, transform 0.4s cubic-bezier(.2,.7,.2,1);
    }
    .show-buy:hover { background: var(--english-violet); transform: translateX(2px); }
    .show-buy em {
      font-family: var(--serif); font-style: italic; font-size: 15px;
      letter-spacing: 0; text-transform: none; margin-left: 8px;
    }

    /* ---- Scroll-in reveal ---- */
    .show-media, .show-copy {
      opacity: 0; transform: translateY(36px);
      transition: opacity 1s cubic-bezier(.2,.7,.2,1), transform 1s cubic-bezier(.2,.7,.2,1);
    }
    .show.is-in .show-media { opacity: 1; transform: none; transition-delay: 0.05s; }
    .show.is-in .show-copy  { opacity: 1; transform: none; transition-delay: 0.16s; }
    @media (prefers-reduced-motion: reduce) {
      .show-media, .show-copy { opacity: 1 !important; transform: none !important; }
      .show-frame, .show-accent { transition: none; }
    }

    /* ============ Checkout modal ============ */
    .checkout-backdrop[hidden] { display: none !important; }
    .checkout-backdrop {
      position: fixed; inset: 0;
      background: rgba(28, 29, 34, 0.65);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      overflow-y: auto;
    }
    .checkout {
      position: relative;
      width: min(1080px, 100%);
      max-height: calc(100vh - 48px);
      display: grid;
      grid-template-columns: 360px 1fr;
      background: var(--paper);
      border-radius: 4px;
      overflow: hidden;
      box-shadow: 0 40px 100px rgba(0,0,0,0.35);
    }
    @media (max-width: 860px) {
      .checkout { grid-template-columns: 1fr; max-height: calc(100vh - 48px); overflow-y: auto; }
    }
    .checkout-close {
      position: absolute;
      top: 14px; right: 16px;
      background: rgba(244, 242, 241,0.85);
      border: 1px solid rgba(var(--violet-rgb),0.2);
      border-radius: 999px;
      width: 36px; height: 36px;
      font-size: 22px;
      color: var(--ink);
      cursor: pointer;
      z-index: 5;
      line-height: 1;
    }
    .checkout-close:hover { background: var(--paper); }

    .checkout-aside {
      background: linear-gradient(180deg, var(--english-violet), #2f2b39);
      color: var(--paper);
      display: flex;
      flex-direction: column;
    }
    .checkout-aside-cover {
      aspect-ratio: 4 / 3;
      background-size: cover;
      background-position: center;
      background-color: var(--platinum);
    }
    .checkout-aside-body { padding: 28px 28px 32px; display: flex; flex-direction: column; gap: 10px; flex: 1; }
    .checkout-aside-eyebrow {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(244, 242, 241,0.6);
    }
    .checkout-aside-title {
      font-family: var(--serif);
      font-size: 30px;
      font-weight: 500;
      line-height: 1.05;
      letter-spacing: -0.015em;
      color: var(--paper);
      margin: 0;
    }
    .checkout-aside-desc {
      font-size: 14px;
      line-height: 1.55;
      color: rgba(244, 242, 241,0.7);
      margin: 6px 0 4px;
    }
    .checkout-aside-list {
      list-style: none; padding: 0; margin: 12px 0 0;
      display: flex; flex-direction: column; gap: 6px;
      font-size: 13px;
      color: rgba(244, 242, 241,0.75);
    }
    .checkout-aside-list li { padding-left: 18px; position: relative; }
    .checkout-aside-list li::before {
      content: "—";
      position: absolute; left: 0; color: rgba(244, 242, 241,0.45);
    }
    .checkout-aside-foot {
      margin-top: auto;
      padding-top: 22px;
      border-top: 1px solid rgba(244, 242, 241,0.18);
      display: flex; justify-content: space-between; align-items: baseline;
    }
    .checkout-aside-label {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(244, 242, 241,0.6);
    }
    .checkout-aside-total {
      font-family: var(--serif);
      font-size: 36px;
      font-weight: 500;
      color: var(--paper);
    }

    .checkout-main {
      padding: 40px 44px 44px;
      display: flex;
      flex-direction: column;
      overflow-y: auto;
    }
    @media (max-width: 860px) { .checkout-main { padding: 32px 24px 32px; } }

    .checkout-steps {
      display: flex;
      gap: 22px;
      margin-bottom: 26px;
      padding-bottom: 18px;
      border-bottom: 1px solid rgba(28,29,34,0.1);
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28,29,34,0.4);
    }
    .checkout-step { display: inline-flex; align-items: center; gap: 8px; }
    .checkout-step em {
      font-family: var(--serif);
      font-style: italic;
      font-size: 16px;
      letter-spacing: 0;
      color: rgba(28,29,34,0.3);
    }
    .checkout-step.is-active { color: var(--english-violet); }
    .checkout-step.is-active em { color: var(--english-violet); }
    .checkout-step.is-done { color: var(--ink); }

    .checkout-pane { display: none; flex-direction: column; gap: 16px; }
    .checkout-pane.is-active { display: flex; }
    .checkout-h {
      font-family: var(--serif);
