    .ck-paytab-logo {
      width: 22px; height: 22px;
      background: #000;
      mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M16.4 12.6c0-2.7 2.2-3.9 2.3-4-1.2-1.8-3.2-2-3.9-2-1.6-.2-3.2 1-4.1 1-.9 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.4 1.4 11.1.9 1.3 2 2.8 3.4 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.3 3.3-2.7 1-1.5 1.5-3 1.5-3 0-.1-2.9-1.1-2.9-4z M14.1 4.4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.2 0 2.4-.6 3-1.4z'/></svg>");
      -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'><path d='M16.4 12.6c0-2.7 2.2-3.9 2.3-4-1.2-1.8-3.2-2-3.9-2-1.6-.2-3.2 1-4.1 1-.9 0-2.2-1-3.6-1-1.9 0-3.6 1.1-4.6 2.8-2 3.4-.5 8.4 1.4 11.1.9 1.3 2 2.8 3.4 2.8 1.4-.1 1.9-.9 3.6-.9 1.7 0 2.1.9 3.6.9 1.5 0 2.4-1.3 3.3-2.7 1-1.5 1.5-3 1.5-3 0-.1-2.9-1.1-2.9-4z M14.1 4.4c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.5-.7.8-1.3 2-1.1 3.2 1.2 0 2.4-.6 3-1.4z'/></svg>");
