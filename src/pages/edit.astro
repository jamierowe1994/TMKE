    .sad-tool svg { width: 56%; height: 56%; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }

    /* canvas — the design being made */
    .sad-canvas { position: relative; flex: 1 1 auto; overflow: hidden; background: #0c0910; }
