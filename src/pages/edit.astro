    @keyframes sadCell {
      0%,79%   { background: rgba(28,29,34,0.06); box-shadow: inset 0 0 0 1.5px rgba(28,29,34,0.12); }
      82%,90%  { background: color-mix(in srgb, var(--english-violet) 16%, #fff); box-shadow: inset 0 0 0 1.5px var(--english-violet); }
      93%,100% { background: rgba(28,29,34,0.06); box-shadow: inset 0 0 0 1.5px rgba(28,29,34,0.12); }
