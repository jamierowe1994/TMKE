      0%,67%   { opacity: 0; left: 30%; top: 40%; width: 16%; }
      69%      { opacity: 1; left: 30%; top: 40%; width: 16%; }
      79%      { opacity: 1; left: 37%; top: 82%; width: 7%; }
      82%,100% { opacity: 0; left: 37%; top: 82%; width: 7%; }
    }
    @keyframes sadToast {
      0%,80%   { opacity: 0; transform: translateX(-50%) translateY(10px); }
      84%,92%  { opacity: 1; transform: translateX(-50%) translateY(0); }
      96%,100% { opacity: 0; transform: translateX(-50%) translateY(10px); }
    }
    @keyframes sadProg { 0% { width: 0; } 100% { width: 100%; } }

    /* Gate playback to on-screen (set by JS); paused until then. */
    .sad-anim { animation-play-state: paused; }
    .sad-stage.is-live .sad-anim { animation-play-state: running; }

    /* Reduced motion / no-JS fallback: a composed still, no movement. */
    .sad-stage.is-static .sad-anim { animation: none !important; }
    .sad-stage.is-static [data-el="t1"],
    .sad-stage.is-static [data-el="t2"],
    .sad-stage.is-static [data-el="t3"],
