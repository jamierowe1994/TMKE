---
import BaseLayout from "../layouts/BaseLayout.astro";
import DiscoveryPanel from "../components/DiscoveryPanel.astro";

// Horizontal slide deck (videography-style). Placeholder portfolio imagery on R2.
const R2 = (n) => `https://assets.tmke.co.uk/${n}.webp`;
// SMM dictionary-hero backdrop — the client's "Smm hero" still on R2.
const SMM_HERO_IMG = "https://assets.tmke.co.uk/Smm%20hero.jpg";
// Slide 2 (Intro & Why) side image — the client's "Social Media Marketing" still.
const LIVING_TEXTURE = "https://assets.tmke.co.uk/TMKE%20SMM/Slide%202%20-%20Social%20Media%20Marketing.png";
const BRANDS = [
  { name: "Crescent Lettings", meta: "Lettings · Manchester", blurb: "Always-on content and monthly reels for a fast-growing lettings brand.", images: [R2("white-1"), R2("living-1"), R2("kitchen-1")] },
  { name: "Harbour & Co", meta: "Premium sales · Poole", blurb: "Full management for a premium coastal agency — strategy through to delivery.", images: [R2("orange-1"), R2("table"), R2("white-2")] },
  { name: "Bush & Co", meta: "Independent · London", blurb: "Brand refresh and a consistent social presence for an independent agent.", images: [R2("kitchen-2"), R2("living-2"), R2("orange-2")] },
];
const navLinks = [
  { label: "About", href: "/about" },
  { label: "Social Media", href: "/services", current: true },
  { label: "Videography", href: "/videography" },
  { label: "The Edit", href: "/edit" },
  { label: "Insights", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
const total = 4;
---

<BaseLayout
  title="Social Media Management — TMKE"
  description="Full-service social media management for property agents — strategy to execution, delivered to a standard that reflects your business."
  hideNav
  hideFooter
>
  <div class="pf">
    <!-- Top nav -->
    <header class="pf-top" id="pf-top">
      <a href="/" class="pf-top-logo">TMKE</a>
      <nav class="pf-top-links" aria-label="Primary">
        {navLinks.map((l) => (<a href={l.href} class:list={[l.current && "is-current"]}>{l.label}</a>))}
        <a href="/login" class="pf-top-login">Login</a>
      </nav>
      <button type="button" class="pf-top-menu" id="pf-top-menu" aria-label="Show menu">Menu</button>
    </header>

    <div class="pf-deck" id="pf-deck">
      <!-- Slide 1 — full-screen dictionary hero (matches /videography) -->
      <section class="pf-panel sm-hero">
        <div class="sm-hero-bg" style={`background-image:url('${SMM_HERO_IMG}')`}></div>
        <div class="sm-hero-overlay"></div>
        <div class="sm-hero-inner">
          <h1 class="sm-word">Social Media Management</h1>
          <div class="sm-pron"><span class="sm-abbr">SMM</span> <span class="sm-phon">/&thinsp;es em &#712;em&thinsp;/</span> <em>noun</em></div>
          <p class="sm-lead">Full-service social media management for agents who want a consistent, professional presence. Everything from strategy to execution, delivered to a standard that reflects your business.</p>
          <span class="pf-scroll-hint" aria-hidden="true">Scroll <em>&rarr;</em></span>
        </div>
      </section>

      <!-- Slide 2 — Intro & Why (text left, image right; slides in like /videography) -->
      <section class="pf-panel pf-panel--slide sm-why">
        <div class="sm-why-text">
          <div class="sm-stack">
            <div class="sm-col">
              <h3 class="sm-col-h">For property professionals who want it done properly</h3>
              <p>Social media management is for those who know their online presence matters, but don't have the time or headspace to manage it properly themselves.</p>
              <p>It suits busy independents, growing businesses, and premium agents who want their brand to look consistent, credible, and aligned &mdash; without creating content day-to-day.</p>
              <p>If how your business shows up matters to you, and you want it handled properly, this is where it fits.</p>
            </div>
            <div class="sm-col">
              <span class="sm-kicker">Managed for Estate Agents</span>
              <p>We plan, create, and manage your social media so it's consistent, considered, and aligned with your business.</p>
              <p>Everything is built around your brand, your audience, and your local market &mdash; so you stay visible, relevant, and recognisable, without having to think about what to post or how it should look.</p>
            </div>
          </div>
        </div>
        <div class="sm-why-img" style={`background-image:url('${LIVING_TEXTURE}')`}></div>
      </section>

      <!-- Slide 3 — How It Works -->
      <section class="pf-panel sm-how">
        <div class="sm-how-inner">
          <span class="sm-kicker">How It Works</span>
          <p class="sm-how-lead">We don't rely on automation to run your social media.</p>
          <p>Every account we manage is handled by a person &mdash; from strategy and planning through to content creation and day-to-day management. Because understanding people &mdash; your audience, your market, your business &mdash; is what actually makes marketing work.</p>
          <p>Everything we create is tailored to your brand and your customers, not pulled from generic ideas or recycled content. And where needed, we support it with in-house videography, so your content feels complete, consistent, and fully taken care of.</p>
          <button type="button" class="pf-cta" data-portfolio>See portfolio <em>&rarr;</em></button>
        </div>
      </section>

      <!-- Slide 4 — Let's talk (centred) + slide-in "Book a call" reveal.
           At the last slide, scrolling a touch more (or clicking the tab) slides
           "Book a call" in from the right while "Let's talk" eases left and stays
           on screen (never leaves the page). -->
      <section class="pf-panel sm-contact sm-final" id="sm-final">
        <div class="sm-contact-inner">
          <div class="sm-contact-content">
            <p class="sm-eyebrow"><span>&mdash;</span> Let's talk</p>
            <h2 class="sm-contact-h">Let's make it <em>consistent.</em></h2>
            <p class="sm-lead">Tell us about your brand and where you want it to go &mdash; we'll put a plan together.</p>
            <div class="sm-actions">
              <a href="/assets/tmke-services.pdf" class="sm-brochure" download>Download services brochure <span aria-hidden="true">&darr;</span></a>
            </div>
          </div>
        </div>
        <aside class="sm-book-panel" id="sm-book-panel" aria-label="Book a call">
          <div class="sm-book-intro">
            <h2 class="sm-book-title">Book a<br />call</h2>
            <p class="sm-book-desc">Prefer to talk it through? Grab a time that suits you and we'll get to know your brand and where you want it to go.</p>
            <button type="button" data-discovery-call data-dc-inline="#sm-book-mount" data-dc-service="A call with TMKE" class="sm-book-cta">Pick a time <span class="btn-arrow">&rarr;</span></button>
          </div>
          <!-- The booking wizard mounts in here (in-place), instead of popping out. -->
          <div class="sm-book-mount" id="sm-book-mount"></div>
        </aside>
        <button type="button" class="sm-reveal-tab" id="sm-reveal-tab" aria-label="Reveal book a call">
          <span class="sm-reveal-arrow" aria-hidden="true">&rarr;</span>
        </button>
      </section>
    </div>

    <div class="pf-counter"><span id="pf-cur">01</span> <span class="pf-counter-sep">/</span> {String(total).padStart(2, "0")}</div>
  </div>

  <!-- Portfolio pop-out -->
  <div class="sm-scrim" id="sm-scrim" hidden></div>
  <button type="button" class="sm-close" id="sm-close" aria-label="Close" hidden>&times;</button>
  <section class="sm-portfolio" id="sm-portfolio" aria-label="Portfolio" hidden>
    <div class="sm-portfolio-scroll">
      <header class="sm-portfolio-head">
        <div class="sm-kicker">Portfolio</div>
        <h2>Brands we work with</h2>
      </header>
      <div class="sm-portfolio-grid">
        {BRANDS.map((b) => (
          <article class="sm-brand">
            <div class="sm-brand-imgs">
              {b.images.map((src) => <div class="sm-brand-img" style={`background-image:url('${src}')`}></div>)}
            </div>
            <div class="sm-brand-foot">
              <h3 class="sm-brand-name">{b.name}</h3>
              <span class="sm-brand-meta">{b.meta}</span>
              <p class="sm-brand-blurb">{b.blurb}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <DiscoveryPanel />

  <style>
    .pf { position: fixed; inset: 0; background: var(--paper); color: var(--ink); overflow: hidden; }
    .pf-deck { display: flex; height: 100vh; width: 100%; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; scrollbar-width: none; }
    .pf-deck::-webkit-scrollbar { display: none; }
    .pf-panel { flex: 0 0 100vw; width: 100vw; height: 100vh; scroll-snap-align: start; scroll-snap-stop: always; display: flex; align-items: center; padding: 96px clamp(28px, 8vw, 140px) 80px; }

    .sm-eyebrow { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--english-violet); margin: 0 0 22px; }
    .sm-eyebrow span { opacity: 0.6; }
    .pf-scroll-hint { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .pf-scroll-hint em { font-style: normal; margin-left: 8px; }

    /* Slide 1 — full-screen dictionary hero (matches /videography .vh) */
    .sm-hero { position: relative; overflow: hidden; padding: 0; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-end; }
    .sm-hero-bg { position: absolute; inset: 0; background-size: cover; background-position: center; background-color: #2a2733; }
    .sm-hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,18,26,0.55) 0%, rgba(20,18,26,0.4) 45%, rgba(20,18,26,0.68) 100%); }
    .sm-hero-inner { position: relative; z-index: 2; max-width: 860px; margin: 0; padding: 0 clamp(28px, 6vw, 120px) clamp(64px, 11vh, 120px); color: var(--paper); }
    .sm-hero .sm-eyebrow { color: rgba(240,238,235,0.85); }
    .sm-hero .sm-eyebrow span { opacity: 0.55; }
    .sm-hero .sm-word { color: var(--paper); }
    .sm-hero .sm-abbr { color: var(--paper); }
    .sm-hero .sm-phon { color: var(--paper); }
    .sm-hero .sm-pron em { color: rgba(240,238,235,0.7); }
    .sm-hero .sm-lead { color: rgba(240,238,235,0.92); }
    .sm-hero .pf-scroll-hint { color: rgba(240,238,235,0.7); }

    /* First-slide entrance — image settles, then the wording rises (as /videography) */
    #pf-deck .pf-panel:first-child .sm-hero-bg { animation: smImgIn 2.4s cubic-bezier(.16,1,.3,1) 0.2s both; }
    #pf-deck .pf-panel:first-child .sm-hero-inner { animation: smTextIn 1.6s cubic-bezier(.16,1,.3,1) 0.9s both; }
    @keyframes smImgIn { from { opacity: 0; transform: scale(1.08); } to { opacity: 1; transform: none; } }
    @keyframes smTextIn { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
      #pf-deck .pf-panel:first-child .sm-hero-bg,
      #pf-deck .pf-panel:first-child .sm-hero-inner { animation-duration: 0.01ms; }
    }
    /* The full term is the headline; the abbreviation + pronunciation sit small
       beneath it on one line (dictionary style). */
    .sm-word { font-family: var(--serif); font-weight: 500; font-size: clamp(32px, 5.6vw, 81px); line-height: 0.98; letter-spacing: -0.025em; margin: 0; color: var(--ink); max-width: 13ch; }
    .sm-pron { display: flex; align-items: baseline; flex-wrap: wrap; gap: 14px; margin: 18px 0 38px; }
    .sm-abbr { font-family: var(--serif); font-weight: 600; font-size: 20px; letter-spacing: 0.02em; color: rgba(28,29,34,0.85); }
    .sm-phon { font-family: var(--serif); font-style: italic; font-size: 18px; color: rgba(28,29,34,0.6); }
    .sm-pron em { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--english-violet); font-style: normal; }
    .sm-lead { font-family: var(--sans); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.65; color: rgba(28,29,34,0.72); max-width: 54ch; margin: 0 0 36px; }

    /* Slide 2 — Intro & Why: text left, full-bleed image right (matches /videography) */
    .sm-why { padding: 0; align-items: stretch; }
    .sm-why-text {
      width: 50%; min-width: 340px;
      display: flex; flex-direction: column; justify-content: center;
      padding: 96px clamp(28px, 4vw, 72px) 80px clamp(28px, 8vw, 140px);
    }
    .sm-why-img { flex: 1; align-self: stretch; background-size: cover; background-position: center; background-color: #e9e4da; }
    /* Slide-in entrance — image from the right, wording from the left, replayed
       each time you land on the slide (driven by .is-in from the deck script). */
    .sm-why-text { opacity: 0; transform: translateX(-46px); transition: opacity 0.9s cubic-bezier(.16,1,.3,1) 0.12s, transform 0.9s cubic-bezier(.16,1,.3,1) 0.12s; }
    .sm-why-img { opacity: 0; transform: translateX(64px) scale(1.04); transition: opacity 1.1s cubic-bezier(.16,1,.3,1), transform 1.1s cubic-bezier(.16,1,.3,1); }
    .sm-why.is-in .sm-why-text, .sm-why.is-in .sm-why-img { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      .sm-why-text, .sm-why-img { transition: none; opacity: 1; transform: none; }
    }
    .sm-stack { display: flex; flex-direction: column; gap: clamp(22px, 3vw, 40px); max-width: 56ch; }
    .sm-col { max-width: 54ch; }
    .sm-kicker { display: block; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--english-violet); margin-bottom: 22px; }
    .sm-col-h { font-family: var(--serif); font-weight: 400; font-size: clamp(23px, 2vw, 31px); line-height: 1.18; letter-spacing: -0.015em; color: var(--ink); margin: 0 0 16px; }
    .sm-col p, .sm-how p { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.7; color: rgba(28,29,34,0.72); margin: 0 0 16px; }

    /* Slide 3 — how it works */
    .sm-how-inner { max-width: 660px; }
    .sm-how-lead { font-family: var(--serif) !important; font-style: italic; font-size: clamp(22px, 2.4vw, 34px) !important; line-height: 1.3 !important; color: var(--ink) !important; margin: 0 0 22px !important; }
    .pf-cta { align-self: flex-start; background: none; border: none; cursor: pointer; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink); padding: 12px 0; margin-top: 12px; border-bottom: 1px solid rgba(28,29,34,0.25); transition: color 0.25s, border-color 0.25s; }
    .pf-cta em { font-style: normal; margin-left: 10px; display: inline-block; transition: margin 0.25s; }
    .pf-cta:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .pf-cta:hover em { margin-left: 16px; }

    /* Slide 4 — Let's talk + slide-in "Book a call" reveal. The book panel slides
       in from the right; "Let's talk" eases left (transform) and never leaves the
       screen. --bookw is the book panel's width. */
    .sm-final { position: relative; overflow: hidden; padding: 0; --bookw: min(46vw, 560px); }
    .sm-contact-inner {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      padding: 96px clamp(28px, 8vw, 140px) 80px;
    }
    /* The text block is centred at rest, then slides left into the space left of
       the book panel when revealed (stays fully on screen). */
    .sm-contact-content {
      max-width: 640px; text-align: center;
      display: flex; flex-direction: column; align-items: center;
      transition: transform 0.7s cubic-bezier(.16,1,.3,1);
    }
    .sm-contact-content .sm-lead { max-width: 52ch; }
    .sm-final.is-revealed .sm-contact-content { transform: translateX(calc(var(--bookw) / -2)); }
    /* "Book a call" panel — off-screen right until revealed, then slides in. */
    .sm-book-panel {
      position: absolute; top: 0; right: 0; z-index: 4;
      width: var(--bookw); height: 100%;
      background: var(--english-violet); color: var(--paper);
      display: flex; flex-direction: column; justify-content: center; gap: 24px;
      padding: 96px clamp(40px, 4vw, 80px) 80px;
      transform: translateX(100%);
      transition: transform 0.7s cubic-bezier(.16,1,.3,1);
    }
    .sm-final.is-revealed .sm-book-panel { transform: translateX(0); }
    .sm-book-intro { display: flex; flex-direction: column; gap: 24px; }
    /* When booking, the wizard mounts in-place: hide the intro, fill the panel. */
    .sm-book-mount { display: none; }
    .sm-book-panel.is-booking { padding: 0; }
    .sm-book-panel.is-booking .sm-book-intro { display: none; }
    .sm-book-panel.is-booking .sm-book-mount { display: block; position: absolute; inset: 0; }
    .sm-book-title { font-family: var(--serif); font-weight: 400; font-size: clamp(40px, 4vw, 72px); line-height: 0.98; letter-spacing: -0.025em; margin: 0; }
    .sm-book-desc { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(240,238,235,0.8); max-width: 38ch; margin: 0; }
    .sm-book-cta { align-self: flex-start; background: var(--paper); color: var(--ink); border: none; cursor: pointer; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; padding: 15px 28px; transition: opacity .25s; }
    .sm-book-cta:hover { opacity: 0.85; }
    .sm-book-cta .btn-arrow { margin-left: 10px; display: inline-block; transition: margin .25s; }
    .sm-book-cta:hover .btn-arrow { margin-left: 16px; }
    /* Reveal handle on the right edge — rides in to the panel's left edge. */
    .sm-reveal-tab {
      position: absolute; top: 50%; right: 0; transform: translateY(-50%);
      z-index: 6; width: 40px; height: 104px; border: none; cursor: pointer;
      background: var(--english-violet); color: var(--paper);
      border-radius: 10px 0 0 10px; display: flex; align-items: center; justify-content: center;
      transition: right 0.7s cubic-bezier(.16,1,.3,1), background .25s;
    }
    .sm-reveal-tab:hover { background: var(--ink); }
    .sm-reveal-arrow { font-size: 18px; transition: transform .5s cubic-bezier(.16,1,.3,1); }
    .sm-final.is-revealed .sm-reveal-tab { right: var(--bookw); }
    .sm-final.is-revealed .sm-reveal-arrow { transform: rotate(180deg); }
    @media (max-width: 760px) {
      .sm-final { --bookw: 86vw; }
      .sm-final.is-revealed .sm-contact-content { transform: translateX(-12vw); }
    }
    .sm-contact-h { font-family: var(--serif); font-weight: 400; font-size: clamp(44px, 6vw, 96px); line-height: 0.98; letter-spacing: -0.025em; color: var(--ink); margin: 0 0 22px; }
    .sm-contact-h em { font-style: italic; color: var(--english-violet); }
    .sm-actions { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 8px; }
    .sm-brochure { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink); text-decoration: none; border-bottom: 1px solid rgba(28,29,34,0.3); padding-bottom: 4px; transition: color 0.25s, border-color 0.25s; }
    .sm-brochure span { margin-left: 8px; }
    .sm-brochure:hover { color: var(--english-violet); border-color: var(--english-violet); }

    /* Top nav (logo left, Menu right; hover the strip to reveal links) */
    .pf-top { position: fixed; top: 0; left: 0; right: 0; z-index: 60; display: flex; align-items: flex-start; justify-content: space-between; padding: 22px 40px; min-height: 78px; transition: background 0.35s ease, backdrop-filter 0.35s ease, border-color 0.35s ease; border-bottom: 1px solid transparent; }
    .pf-top:hover, .pf-top.is-open { background: rgba(244, 242, 241,0.92); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom-color: rgba(28,29,34,0.08); }
    /* Slide 1 is a dark full-screen image — flip the logo + Menu to white so
       they're legible. Reverts to dark when the nav strip is opened (it gets a
       light backdrop) and on every later, light slide. */
    .pf-top.nav-on-dark .pf-top-logo, .pf-top.nav-on-dark .pf-top-menu { color: var(--paper); }
    .pf-top.nav-on-dark:hover .pf-top-logo, .pf-top.nav-on-dark.is-open .pf-top-logo,
    .pf-top.nav-on-dark:hover .pf-top-menu, .pf-top.nav-on-dark.is-open .pf-top-menu { color: var(--ink); }
    body.pf-modal-open .pf-top { pointer-events: none; }
    .pf-top-logo { font-family: var(--serif); font-size: 22px; letter-spacing: 0.08em; color: var(--ink); line-height: 1; position: relative; z-index: 2; }
    .pf-top-menu { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--ink); background: none; border: none; cursor: pointer; padding: 4px 0; line-height: 1; position: relative; z-index: 2; transition: opacity 0.25s; }
    .pf-top:hover .pf-top-menu, .pf-top.is-open .pf-top-menu { opacity: 0; }
    .pf-top-links { position: absolute; left: 50%; top: 0; transform: translateX(-50%); min-height: 78px; display: flex; align-items: center; gap: 30px; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; }
    .pf-top:hover .pf-top-links, .pf-top.is-open .pf-top-links { opacity: 1; pointer-events: auto; }
    body.pf-modal-open .pf-top-links { opacity: 0 !important; pointer-events: none !important; }
    .pf-top-links a { font-family: var(--sans); font-size: 14px; font-weight: 500; color: var(--ink); white-space: nowrap; }
    .pf-top-links a:hover { color: var(--english-violet); }
    .pf-top-links a.is-current { color: var(--english-violet); font-weight: 700; }
    .pf-top-login { font-weight: 700 !important; letter-spacing: 0.14em; text-transform: uppercase; font-size: 12px !important; }

    .pf-counter { position: fixed; right: 36px; bottom: 30px; z-index: 55; font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.18em; color: rgba(28,29,34,0.6); }
    .pf-counter-sep { margin: 0 6px; opacity: 0.5; }

    /* Portfolio pop-out (slides up from the bottom) */
    .sm-scrim { position: fixed; inset: 0; z-index: 290; background: rgba(16,14,22,0.62); backdrop-filter: blur(3px); -webkit-backdrop-filter: blur(3px); opacity: 0; transition: opacity 0.5s ease; }
    .sm-scrim[hidden] { display: none; }
    .sm-scrim.is-open { opacity: 1; }
    .sm-portfolio { position: fixed; top: 40px; left: 0; right: 0; bottom: 0; z-index: 300; background: var(--paper); border-radius: 18px 18px 0 0; overflow: hidden; box-shadow: 0 -24px 90px rgba(16,14,22,0.42); transform: translateY(100%); transition: transform 0.8s cubic-bezier(.16,1,.3,1); }
    .sm-portfolio[hidden] { display: none; }
    .sm-portfolio.is-open { transform: translateY(0); }
    .sm-portfolio-scroll { height: 100%; overflow-y: auto; scrollbar-width: none; padding: clamp(36px, 5vw, 72px); }
    .sm-portfolio-scroll::-webkit-scrollbar { display: none; }
    .sm-portfolio-head { margin-bottom: 36px; }
    .sm-portfolio-head h2 { font-family: var(--serif); font-weight: 400; font-size: clamp(34px, 4vw, 56px); letter-spacing: -0.02em; color: var(--ink); margin: 8px 0 0; }
    .sm-portfolio-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(20px, 2.4vw, 40px); }
    @media (max-width: 900px) { .sm-portfolio-grid { grid-template-columns: 1fr; } }
    .sm-brand-imgs { display: grid; grid-template-columns: 1fr 1fr; grid-auto-rows: 110px; gap: 8px; }
    .sm-brand-imgs .sm-brand-img:first-child { grid-column: 1 / -1; height: 200px; }
    .sm-brand-img { background-size: cover; background-position: center; background-color: #e9e4da; border-radius: 4px; }
    .sm-brand-foot { padding-top: 16px; }
    .sm-brand-name { font-family: var(--serif); font-weight: 500; font-size: 24px; color: var(--ink); margin: 0; }
    .sm-brand-meta { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet); }
    .sm-brand-blurb { font-family: var(--sans); font-size: 14px; line-height: 1.6; color: rgba(28,29,34,0.7); margin: 10px 0 0; }
    .sm-close { position: fixed; top: 56px; right: 40px; z-index: 320; width: 48px; height: 48px; border-radius: 50%; border: 1px solid rgba(240,238,235,0.55); background: rgba(16,14,22,0.35); color: var(--paper); font-size: 30px; line-height: 1; cursor: pointer; backdrop-filter: blur(4px); transition: background 0.25s, transform 0.4s; }
    .sm-close[hidden] { display: none; }
    .sm-close:hover { background: var(--english-violet); border-color: var(--english-violet); transform: rotate(90deg); }

    @media (max-width: 760px) {
      .pf-panel { padding: 96px 28px 80px; }
      .sm-hero { padding: 0; }
      .sm-hero-inner { max-width: none; padding: 0 24px clamp(56px, 12vh, 90px); }
      .sm-why { flex-direction: column; padding: 0; }
      .sm-why-text { width: 100%; min-width: 0; padding: 88px 28px 30px; }
      .sm-why-img { flex: 0 0 auto; min-height: 36vh; }
      .pf-top-links { display: none; }
    }
  </style>

  <script>
    if (window.__lenis && typeof window.__lenis.destroy === "function") { try { window.__lenis.destroy(); } catch (e) {} }

    // Portfolio pop-out
    const scrim = document.getElementById("sm-scrim");
    const portfolio = document.getElementById("sm-portfolio");
    const closeBtn = document.getElementById("sm-close");
    let portfolioOpen = false, closeTimer = null;
    function openPortfolio() {
      if (closeTimer) { clearTimeout(closeTimer); closeTimer = null; }
      portfolioOpen = true; scrim.hidden = false; portfolio.hidden = false; closeBtn.hidden = false;
      portfolio.querySelector(".sm-portfolio-scroll").scrollTop = 0;
      document.documentElement.style.overflow = "hidden"; document.body.classList.add("pf-modal-open");
      requestAnimationFrame(() => requestAnimationFrame(() => { scrim.classList.add("is-open"); portfolio.classList.add("is-open"); }));
    }
    function closePortfolio() {
      if (!portfolioOpen) return;
      portfolioOpen = false; scrim.classList.remove("is-open"); portfolio.classList.remove("is-open"); closeBtn.hidden = true;
      document.documentElement.style.overflow = ""; document.body.classList.remove("pf-modal-open");
      closeTimer = setTimeout(() => { scrim.hidden = true; portfolio.hidden = true; }, 820);
    }
    document.querySelectorAll("[data-portfolio]").forEach((b) => b.addEventListener("click", (e) => { e.stopPropagation(); openPortfolio(); }));
    scrim.addEventListener("click", closePortfolio);
    closeBtn.addEventListener("click", closePortfolio);
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && portfolioOpen) closePortfolio(); });

    // Horizontal deck — one panel per wheel gesture
    (function deck() {
      const deck = document.getElementById("pf-deck");
      if (!deck) return;
      const panels = deck.querySelectorAll(".pf-panel");
      const curEl = document.getElementById("pf-cur");
      const pad = (n) => String(n + 1).padStart(2, "0");
      let idx = 0, cooling = false, settle;
      const topBarEl = document.getElementById("pf-top");
      // Replay each slide's entrance whenever it becomes the active panel, and
      // flip the nav to white while the dark first slide is showing.
      const reveal = () => {
        panels.forEach((p, i) => p.classList.toggle("is-in", i === idx));
        if (topBarEl) topBarEl.classList.toggle("nav-on-dark", idx === 0);
      };
      const last = panels.length - 1;
      // "Book a call" reveal on the final slide — slides the track to bring the
      // book panel in from the right (mirrors the videography newsletter reveal).
      const finalPanel = document.getElementById("sm-final");
      const revealTab = document.getElementById("sm-reveal-tab");
      let bookRevealed = false;
      const setBookReveal = (on) => {
        if (!finalPanel) return;
        bookRevealed = on;
        finalPanel.classList.toggle("is-revealed", on);   // CSS slides the panel + shifts "Let's talk"
      };
      const go = (i) => { idx = Math.max(0, Math.min(last, i)); if (idx !== last && bookRevealed) setBookReveal(false); deck.scrollTo({ left: idx * deck.clientWidth, behavior: "smooth" }); if (curEl) curEl.textContent = pad(idx); reveal(); };
      reveal();
      if (revealTab) revealTab.addEventListener("click", (ev) => { ev.stopPropagation(); setBookReveal(!bookRevealed); });
      deck.addEventListener("wheel", (e) => {
        if (portfolioOpen) return;
        e.preventDefault();
        if (cooling) return;
        const d = Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        if (Math.abs(d) < 6) return;
        cooling = true; setTimeout(() => { cooling = false; }, 620);
        if (d > 0) { if (idx === last) { if (!bookRevealed) setBookReveal(true); } else go(idx + 1); }
        else { if (idx === last && bookRevealed) setBookReveal(false); else go(idx - 1); }
      }, { passive: false });
      window.addEventListener("keydown", (e) => {
        if (portfolioOpen) return;
        if (e.key === "ArrowRight" || e.key === "PageDown") { e.preventDefault(); if (idx === last) { if (!bookRevealed) setBookReveal(true); } else go(idx + 1); }
        else if (e.key === "ArrowLeft" || e.key === "PageUp") { e.preventDefault(); if (idx === last && bookRevealed) setBookReveal(false); else go(idx - 1); }
      });
      window.addEventListener("resize", () => { deck.scrollTo({ left: idx * deck.clientWidth }); if (bookRevealed) setBookReveal(true); });
      deck.addEventListener("scroll", () => { clearTimeout(settle); settle = setTimeout(() => { const i = Math.round(deck.scrollLeft / deck.clientWidth); if (i !== idx) { idx = i; if (curEl) curEl.textContent = pad(idx); reveal(); } }, 120); }, { passive: true });
    })();

    // "Book a call" -> the booking wizard mounts inside the panel (in-place),
    // not as a pop-out. Hide the intro while booking; restore it when closed.
    (function inlineBooking() {
      const panel = document.getElementById("sm-book-panel");
      if (!panel) return;
      const pickBtn = panel.querySelector(".sm-book-cta");
      if (pickBtn) pickBtn.addEventListener("click", () => panel.classList.add("is-booking"));
      window.addEventListener("dc:close", () => panel.classList.remove("is-booking"));
    })();

    // Top nav menu toggle (touch)
    const topBar = document.getElementById("pf-top");
    const topMenu = document.getElementById("pf-top-menu");
    if (topBar && topMenu) {
      topMenu.addEventListener("click", (e) => { e.stopPropagation(); if (portfolioOpen) return; topBar.classList.toggle("is-open"); });
      document.addEventListener("click", (e) => { if (!topBar.contains(e.target)) topBar.classList.remove("is-open"); });
    }
  </script>
</BaseLayout>
