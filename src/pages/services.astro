---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import DiscoveryPanel from "../components/DiscoveryPanel.astro";
---

<BaseLayout
  title="Social Media Management — TMKE"
  description="A fully managed social media service for estate agents and property brands ready to outsource. Strategy, content, and consistent execution."
>
  <PageHero
    chapter="Services — Social Media Management"
    title="A fully managed channel, <em>built for property.</em>"
    sub="For agencies who know their marketing matters but don't want to manage it day to day."
  />

  <section class="svc-pillars wrap">
    <article>
      <div class="eyebrow">01 · Strategy</div>
      <h3>A plan that fits your market</h3>
      <p>Quarterly content strategy, calibrated to the listings, locations and audience you actually trade with — not a generic property feed.</p>
    </article>
    <article>
      <div class="eyebrow">02 · Content</div>
      <h3>Editorial, not estate-agent stock</h3>
      <p>On-brand designs, copy, photography direction and reels. Every post written and laid out by the TMKE studio — never automated.</p>
    </article>
    <article>
      <div class="eyebrow">03 · Execution</div>
      <h3>Consistent posting, weekly reporting</h3>
      <p>We plan, schedule, post and respond. Each month you get a short report on what worked, what moved, and what's coming next.</p>
    </article>
  </section>

  <section class="svc-cta wrap">
    <div class="svc-cta-body">
      <div class="eyebrow">Next step</div>
      <h2>Start with a discovery call.</h2>
      <p>Thirty minutes to talk through where your channels are, where they could go, and whether TMKE is the right partner for that journey.</p>
    </div>
    <div class="svc-cta-actions">
      <button type="button" class="btn btn--solid" data-discovery-call>
        Book a discovery call <span class="btn-arrow">&rarr;</span>
      </button>
      <a href="/edit" class="svc-cta-secondary">Or browse The Edit instead</a>
    </div>
  </section>

  <DiscoveryPanel />

  <style>
    .svc-pillars {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 36px;
      max-width: 1360px;
      margin: 0 auto;
      padding: 0 36px 100px;
    }
    @media (max-width: 980px) { .svc-pillars { grid-template-columns: 1fr; } }
    .svc-pillars article {
      padding: 32px;
      background: rgba(255, 255, 255, 0.5);
      border: 1px solid rgba(71, 66, 84, 0.18);
      border-radius: 3px;
    }
    .svc-pillars .eyebrow { margin-bottom: 18px; }
    .svc-pillars h3 {
      font-family: var(--serif);
      font-size: 28px;
      font-weight: 500;
      letter-spacing: -0.015em;
      margin: 0 0 14px;
      color: var(--ink);
    }
    .svc-pillars p {
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.6;
      color: rgba(28, 29, 34, 0.7);
      margin: 0;
    }

    .svc-cta {
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 48px;
      align-items: center;
      max-width: 1360px;
      margin: 0 auto;
      padding: 80px 36px 200px;
      border-top: 1px solid rgba(28, 29, 34, 0.1);
    }
    @media (max-width: 980px) { .svc-cta { grid-template-columns: 1fr; gap: 32px; } }
    .svc-cta-body .eyebrow { margin-bottom: 14px; }
    .svc-cta-body h2 {
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(36px, 4vw, 56px);
      letter-spacing: -0.015em;
      line-height: 1.05;
      margin: 0 0 18px;
      color: var(--ink);
    }
    .svc-cta-body p {
      font-family: var(--serif);
      font-style: italic;
      font-size: 20px;
      line-height: 1.5;
      color: rgba(28, 29, 34, 0.65);
      margin: 0;
    }
    .svc-cta-actions {
      display: flex;
      flex-direction: column;
      gap: 14px;
      align-items: flex-start;
    }
    .svc-cta-actions .btn { cursor: pointer; }
    .svc-cta-secondary {
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--english-violet);
      border-bottom: 1px solid currentColor;
    }
  </style>
</BaseLayout>
