---
import BaseLayout from "../layouts/BaseLayout.astro";
import DiscoveryPanel from "../components/DiscoveryPanel.astro";
import SMMForms from "../components/SMMForms.astro";
import { COPY, SERVICE_TIERS, SHOW_TIER_PRICES } from "../lib/smm-config.js";
import { gbpFromPence } from "../lib/supabase.js";

// Horizontal slide deck (videography-style). Placeholder portfolio imagery on R2.
const R2 = (n) => `https://assets.tmke.co.uk/${n}.webp`;
// SMM dictionary-hero backdrop — the client's "Smm hero" still on R2.
const SMM_HERO_IMG = "https://assets.tmke.co.uk/Smm%20hero.jpg";
// Full-bleed feature-slide images (slides 2–4, floema-style). Placeholders —
// swap freely; the layout is image-agnostic.
const FEATURE2_IMG = "https://assets.tmke.co.uk/TMKE%20SMM/Slide%202%20-%20Social%20Media%20Marketing.png";
const FEATURE3_IMG = R2("living-1");
const FEATURE4_IMG = R2("orange-1");
const BRANDS = [
  { name: "Crescent Lettings", meta: "Lettings · Manchester", blurb: "Always-on content and monthly reels for a fast-growing lettings brand.", images: [R2("white-1"), R2("living-1"), R2("kitchen-1")] },
  { name: "Harbour & Co", meta: "Premium sales · Poole", blurb: "Full management for a premium coastal agency — strategy through to delivery.", images: [R2("orange-1"), R2("table"), R2("white-2")] },
  { name: "Bush & Co", meta: "Independent · London", blurb: "Brand refresh and a consistent social presence for an independent agent.", images: [R2("kitchen-2"), R2("living-2"), R2("orange-2")] },
];
const navLinks = [
  { label: "About", href: "/about" },
  { label: "Social Media", href: "/services", current: true },
  { label: "Videography", href: "/videography" },
  { label: "The Edit", href: "/edit" },
  { label: "Insights", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
const total = 7;
---

<BaseLayout
  title="Social Media Management — TMKE"
  description="Full-service social media management for property agents — strategy to execution, delivered to a standard that reflects your business."
  hideNav
  hideFooter
>
  <div class="pf">
    <!-- Top nav -->
    <header class="pf-top" id="pf-top">
      <a href="/" class="pf-top-logo">TMKE</a>
      <nav class="pf-top-links" aria-label="Primary">
        {navLinks.map((l) => (<a href={l.href} class:list={[l.current && "is-current"]}>{l.label}</a>))}
        <a href="/login" class="pf-top-login">Login</a>
      </nav>
      <button type="button" class="pf-top-menu" id="pf-top-menu" aria-label="Menu" aria-expanded="false"><span></span><span></span><span></span></button>
    </header>

    <div class="pf-stage" id="pf-deck">
      <div class="pf-plane" id="pf-plane">
        <!-- Slide 1 (col 0,row 0) — full-screen dictionary hero -->
        <section class="pf-panel sm-hero" style="--col:0;--row:0">
          <div class="sm-hero-bg" style={`background-image:url('${SMM_HERO_IMG}')`}></div>
          <div class="sm-hero-overlay"></div>
          <div class="sm-hero-inner">
            <h1 class="sm-word">Social Media Management</h1>
            <div class="sm-pron"><span class="sm-abbr">SMM</span> <span class="sm-phon">/&thinsp;es em &#712;em&thinsp;/</span> <em>noun</em></div>
            <p class="sm-lead">Full-service social media management for agents who want a consistent, professional presence. Everything from strategy to execution, delivered to a standard that reflects your business.</p>
            <span class="pf-scroll-hint" aria-hidden="true">Scroll <em>&rarr;</em></span>
          </div>
        </section>

        <!-- Slide 2 (col 1,row 0) — full-image: don't go viral. Scroll DOWN. -->
        <section class="pf-panel sm-feature" style="--col:1;--row:0;--step:1">
          <div class="sm-feature-bg" style={`background-image:url('${FEATURE2_IMG}')`}></div>
          <div class="sm-feature-overlay"></div>
          <div class="sm-line" aria-hidden="true"><span class="sm-line-fill"></span></div>
          <span class="sm-line-num" aria-hidden="true">01</span>
          <div class="sm-feature-inner">
            <h2 class="sm-feature-h">{COPY.positioning.headline}</h2>
            {COPY.positioning.body.split("\n\n").map((para) => (
              <p class={para === "That's what we build." ? "sm-feature-build" : "sm-feature-body"}>{para}</p>
            ))}
          </div>
        </section>

        <!-- Slide 3 (col 1,row 1) — full-image: property first. Scroll DOWN. -->
        <section class="pf-panel sm-feature" style="--col:1;--row:0;--step:2">
          <div class="sm-feature-bg" style={`background-image:url('${FEATURE3_IMG}')`}></div>
          <div class="sm-feature-overlay"></div>
          <div class="sm-line" aria-hidden="true"><span class="sm-line-fill"></span></div>
          <span class="sm-line-num" aria-hidden="true">02</span>
          <div class="sm-feature-inner">
            <h2 class="sm-feature-h">{COPY.positioning.pillars[0].title}</h2>
            <p class="sm-feature-body">{COPY.positioning.pillars[0].body}</p>
          </div>
        </section>

        <!-- Slide 4 (col 1,row 2) — full-image: one account manager. Scroll ACROSS. -->
        <section class="pf-panel sm-feature" style="--col:1;--row:0;--step:3">
          <div class="sm-feature-bg" style={`background-image:url('${FEATURE4_IMG}')`}></div>
          <div class="sm-feature-overlay"></div>
          <div class="sm-line" aria-hidden="true"><span class="sm-line-fill"></span></div>
          <span class="sm-line-num" aria-hidden="true">03</span>
          <div class="sm-feature-inner">
            <h2 class="sm-feature-h">{COPY.positioning.pillars[1].title}</h2>
            <p class="sm-feature-body">{COPY.positioning.pillars[1].body}</p>
          </div>
        </section>

        <!-- Slide 5 (col 2,row 2) — what we do + service-tier scroll box -->
        <section class="pf-panel sm-services" style="--col:2;--row:0">
          <div class="sm-services-inner">
            <div class="sm-services-head">
              <h2 class="sm-services-h">{COPY.whatWeDo.headline}</h2>
              <p class="sm-services-lead">{COPY.whatWeDo.body}</p>
              <p class="sm-services-choose">{COPY.whatWeDo.chooseLine}</p>
            </div>

            <div class="sm-tiers" role="list">
              {SERVICE_TIERS.map((t) => (
                <article class="sm-tier" role="listitem">
                  <div class="sm-tier-head">
                    <h3 class="sm-tier-name">{t.name}</h3>
                    <span class="sm-tier-sub">{t.subtitle}</span>
                    {SHOW_TIER_PRICES && t.price_pence != null && (
                      <span class="sm-tier-price">from {gbpFromPence(t.price_pence)} +VAT</span>
                    )}
                  </div>
                  <p class="sm-tier-blurb">{t.blurb}</p>
                </article>
              ))}
            </div>
          </div>
        </section>

        <!-- Slide 6 (col 3,row 2) — what good looks like -->
        <section class="pf-panel sm-goodslide" style="--col:3;--row:0">
          <div class="sm-good-inner">
            <span class="sm-kicker">Portfolio</span>
            <h2 class="sm-good-h">{COPY.whatGoodLooksLike.headline}</h2>
            <p class="sm-good-p">{COPY.whatGoodLooksLike.body}</p>
            <button type="button" class="pf-cta" data-portfolio>{COPY.whatGoodLooksLike.cta} <em>&rarr;</em></button>
          </div>
        </section>

        <!-- Slide 7 (col 4,row 2) — three CTA cards (unchanged) -->
        <section class="pf-panel sm-ctas" style="--col:4;--row:0">
          <div class="sm-cta-row">
            <article class="sm-cta-card">
              <div class="sm-cta-img" style={`background-image:url('${R2("living-1")}')`}></div>
              <h2 class="sm-cta-title">{COPY.ctas.brochure.title}</h2>
              <p class="sm-cta-desc">{COPY.ctas.brochure.body}</p>
              <button type="button" class="sm-cta-btn" data-smm-form="brochure">Download a brochure <span class="btn-arrow">&rarr;</span></button>
            </article>

            <article class="sm-cta-card">
              <div class="sm-cta-img" style={`background-image:url('${R2("table")}')`}></div>
              <h2 class="sm-cta-title">{COPY.ctas.call.title}</h2>
              <p class="sm-cta-desc">{COPY.ctas.call.body}</p>
              <button type="button" class="sm-cta-btn" data-smm-form="discovery">Book a call <span class="btn-arrow">&rarr;</span></button>
            </article>

            <article class="sm-cta-card">
              <div class="sm-cta-img" style={`background-image:url('${R2("white-1")}')`}></div>
              <h2 class="sm-cta-title">{COPY.ctas.contact.title}</h2>
              <p class="sm-cta-desc">{COPY.ctas.contact.body}</p>
              <button type="button" class="sm-cta-btn" data-smm-form="contact">Get in touch <span class="btn-arrow">&rarr;</span></button>
            </article>
          </div>
        </section>
      </div>
    </div>

    <div class="pf-counter"><span id="pf-cur">01</span> <span class="pf-counter-sep">/</span> {String(total).padStart(2, "0")}</div>
  </div>

  <!-- Portfolio pop-out -->
  <div class="sm-scrim" id="sm-scrim" hidden></div>
  <button type="button" class="sm-close" id="sm-close" aria-label="Close" hidden>&times;</button>
  <section class="sm-portfolio" id="sm-portfolio" aria-label="Portfolio" hidden>
    <div class="sm-portfolio-scroll">
      <header class="sm-portfolio-head">
        <div class="sm-kicker">Portfolio</div>
        <h2>Brands we work with</h2>
      </header>
      <div class="sm-portfolio-grid">
        {BRANDS.map((b) => (
          <article class="sm-brand">
            <div class="sm-brand-imgs">
              {b.images.map((src) => <div class="sm-brand-img" style={`background-image:url('${src}')`}></div>)}
            </div>
            <div class="sm-brand-foot">
              <h3 class="sm-brand-name">{b.name}</h3>
              <span class="sm-brand-meta">{b.meta}</span>
              <p class="sm-brand-blurb">{b.blurb}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <DiscoveryPanel />
  <SMMForms />

  <style>
    .pf { position: fixed; inset: 0; background: var(--paper); color: var(--ink); overflow: hidden; }
    /* 2D deck — panels sit on a plane that translates in X *and* Y, so the path
       mixes sliding across with sliding down. */
    .pf-stage { position: absolute; inset: 0; overflow: hidden; }
    .pf-plane { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; transition: transform 0.85s cubic-bezier(.16,1,.3,1); will-change: transform; }
    .pf-panel { position: absolute; width: 100vw; height: 100vh; left: calc(var(--col, 0) * 100vw); top: calc(var(--row, 0) * 100vh); display: flex; align-items: center; padding: 96px clamp(28px, 8vw, 140px) 80px; }

    /* full-bleed feature slides (2–4), floema-style. They STACK at the same cell:
       the incoming slide pushes up from the bottom and slides OVER the previous
       one (which drifts up a touch). The whole panel — image, text and line —
       rides up together. JS sets the per-panel translateY. */
    .sm-feature { padding: 0; overflow: hidden; --steps: 3; transform: translateY(100%); transition: transform 0.85s cubic-bezier(.16,1,.3,1); will-change: transform; }
    .sm-feature-bg { position: absolute; inset: 0; background-size: cover; background-position: center; background-color: #2a2733; }
    .sm-feature-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,18,26,0.28) 0%, rgba(20,18,26,0.4) 44%, rgba(20,18,26,0.66) 100%); }

    /* progress line across the screen + step number above its left end */
    .sm-line { position: absolute; left: 0; right: 0; top: 44%; height: 1px; background: rgba(240,238,235,0.3); z-index: 2; }
    .sm-line-fill { position: absolute; left: 0; top: 0; height: 1px; background: var(--paper); width: calc((var(--step) - 1) / var(--steps) * 100%); transition: width 1.1s cubic-bezier(.16,1,.3,1) 0.15s; }
    .sm-feature.is-in .sm-line-fill { width: calc(var(--step) / var(--steps) * 100%); }
    .sm-line-num { position: absolute; top: 44%; left: clamp(28px, 8vw, 140px); transform: translateY(-165%); z-index: 3; font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.22em; color: var(--paper); text-shadow: 0 1px 12px rgba(0,0,0,0.4); }

    /* title + body, below the line, set in from the left (left-of-centre) */
    .sm-feature-inner { position: absolute; top: 49%; left: clamp(28px, 18vw, 360px); right: clamp(28px, 8vw, 140px); max-width: 820px; z-index: 2; color: var(--paper); text-shadow: 0 2px 22px rgba(0,0,0,0.42); }
    .sm-feature-h { font-family: var(--serif); font-weight: 500; font-size: clamp(30px, 4.4vw, 66px); line-height: 1.04; letter-spacing: -0.025em; color: var(--paper); margin: 0 0 20px; max-width: 18ch; }
    .sm-feature-body { font-family: var(--sans); font-size: clamp(15px, 1.25vw, 18px); line-height: 1.7; color: rgba(240,238,235,0.92); max-width: 60ch; margin: 0 0 14px; }
    .sm-feature-build { font-family: var(--serif); font-style: italic; font-size: clamp(19px, 1.9vw, 28px); color: var(--paper); margin: 8px 0 14px; }
    @media (prefers-reduced-motion: reduce) {
      .sm-feature, .sm-line-fill { transition: none; }
    }
    @media (max-width: 760px) {
      .sm-line, .sm-line-num { top: 38%; }
      .sm-feature-inner { top: 43%; left: 28px; right: 28px; }
    }

    /* slide 6 — what good looks like (centred) */
    .sm-goodslide { align-items: center; }
    .sm-good-inner { max-width: 760px; margin: 0 auto; }
    .sm-good-h { font-family: var(--serif); font-weight: 400; font-size: clamp(34px, 4.6vw, 68px); line-height: 1.02; letter-spacing: -0.025em; color: var(--ink); margin: 10px 0 18px; }
    .sm-good-p { font-family: var(--sans); font-size: clamp(15px, 1.3vw, 19px); line-height: 1.65; color: rgba(28,29,34,0.72); max-width: 52ch; margin: 0 0 26px; }

    .sm-eyebrow { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--english-violet); margin: 0 0 22px; }
    .sm-eyebrow span { opacity: 0.6; }
    .pf-scroll-hint { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .pf-scroll-hint em { font-style: normal; margin-left: 8px; }

    /* Slide 1 — full-screen dictionary hero (matches /videography .vh) */
    .sm-hero { position: relative; overflow: hidden; padding: 0; display: flex; flex-direction: column; align-items: stretch; justify-content: flex-end; }
    .sm-hero-bg { position: absolute; inset: 0; background-size: cover; background-position: center; background-color: #2a2733; }
    .sm-hero-overlay { position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20,18,26,0.55) 0%, rgba(20,18,26,0.4) 45%, rgba(20,18,26,0.68) 100%); }
    .sm-hero-inner { position: relative; z-index: 2; max-width: 860px; margin: 0; padding: 0 clamp(28px, 6vw, 120px) clamp(64px, 11vh, 120px); color: var(--paper); }
    .sm-hero .sm-eyebrow { color: rgba(240,238,235,0.85); }
    .sm-hero .sm-eyebrow span { opacity: 0.55; }
    .sm-hero .sm-word { color: var(--paper); }
    .sm-hero .sm-abbr { color: var(--paper); }
    .sm-hero .sm-phon { color: var(--paper); }
    .sm-hero .sm-pron em { color: rgba(240,238,235,0.7); }
    .sm-hero .sm-lead { color: rgba(240,238,235,0.92); }
    .sm-hero .pf-scroll-hint { color: rgba(240,238,235,0.7); }

    /* First-slide entrance — image settles, then the wording rises (as /videography) */
    #pf-deck .pf-panel:first-child .sm-hero-bg { animation: smImgIn 2.4s cubic-bezier(.16,1,.3,1) 0.2s both; }
    #pf-deck .pf-panel:first-child .sm-hero-inner { animation: smTextIn 1.6s cubic-bezier(.16,1,.3,1) 0.9s both; }
    @keyframes smImgIn { from { opacity: 0; transform: scale(1.08); } to { opacity: 1; transform: none; } }
    @keyframes smTextIn { from { opacity: 0; transform: translateY(28px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
      #pf-deck .pf-panel:first-child .sm-hero-bg,
      #pf-deck .pf-panel:first-child .sm-hero-inner { animation-duration: 0.01ms; }
    }
    /* The full term is the headline; the abbreviation + pronunciation sit small
       beneath it on one line (dictionary style). */
    .sm-word { font-family: var(--serif); font-weight: 500; font-size: clamp(32px, 5.6vw, 81px); line-height: 0.98; letter-spacing: -0.025em; margin: 0; color: var(--ink); max-width: 13ch; }
    .sm-pron { display: flex; align-items: baseline; flex-wrap: wrap; gap: 14px; margin: 18px 0 38px; }
    .sm-abbr { font-family: var(--serif); font-weight: 600; font-size: 20px; letter-spacing: 0.02em; color: rgba(28,29,34,0.85); }
    .sm-phon { font-family: var(--serif); font-style: italic; font-size: 18px; color: rgba(28,29,34,0.6); }
    .sm-pron em { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--english-violet); font-style: normal; }
    .sm-lead { font-family: var(--sans); font-size: clamp(16px, 1.4vw, 19px); line-height: 1.65; color: rgba(28,29,34,0.72); max-width: 54ch; margin: 0 0 36px; }

    /* Slide 2 — Intro & Why: text left, full-bleed image right (matches /videography) */
    .sm-why { padding: 0; align-items: stretch; }
    .sm-why-text {
      width: 50%; min-width: 340px;
      display: flex; flex-direction: column; justify-content: center;
      padding: 96px clamp(28px, 4vw, 72px) 80px clamp(28px, 8vw, 140px);
    }
    .sm-why-img { flex: 1; align-self: stretch; background-size: cover; background-position: center; background-color: #e9e4da; }
    /* Slide-in entrance — image from the right, wording from the left, replayed
       each time you land on the slide (driven by .is-in from the deck script). */
    .sm-why-text { opacity: 0; transform: translateX(-46px); transition: opacity 0.9s cubic-bezier(.16,1,.3,1) 0.12s, transform 0.9s cubic-bezier(.16,1,.3,1) 0.12s; }
    .sm-why-img { opacity: 0; transform: translateX(64px) scale(1.04); transition: opacity 1.1s cubic-bezier(.16,1,.3,1), transform 1.1s cubic-bezier(.16,1,.3,1); }
    .sm-why.is-in .sm-why-text, .sm-why.is-in .sm-why-img { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      .sm-why-text, .sm-why-img { transition: none; opacity: 1; transform: none; }
    }
    .sm-stack { display: flex; flex-direction: column; gap: clamp(22px, 3vw, 40px); max-width: 56ch; }
    .sm-col { max-width: 54ch; }
    .sm-kicker { display: block; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--english-violet); margin-bottom: 22px; }
    .sm-col-h { font-family: var(--serif); font-weight: 400; font-size: clamp(23px, 2vw, 31px); line-height: 1.18; letter-spacing: -0.015em; color: var(--ink); margin: 0 0 16px; }
    .sm-col p, .sm-how p { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.7; color: rgba(28,29,34,0.72); margin: 0 0 16px; }

    /* Slide 3 — how it works */
    .sm-how-inner { max-width: 660px; }
    .sm-how-lead { font-family: var(--serif) !important; font-style: italic; font-size: clamp(22px, 2.4vw, 34px) !important; line-height: 1.3 !important; color: var(--ink) !important; margin: 0 0 22px !important; }
    .pf-cta { align-self: flex-start; background: none; border: none; cursor: pointer; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink); padding: 12px 0; margin-top: 12px; border-bottom: 1px solid rgba(28,29,34,0.25); transition: color 0.25s, border-color 0.25s; }
    .pf-cta em { font-style: normal; margin-left: 10px; display: inline-block; transition: margin 0.25s; }
    .pf-cta:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .pf-cta:hover em { margin-left: 16px; }

    /* ---- Slide 2: positioning headline + two pillars ---- */
    .sm-why-head { font-family: var(--serif); font-weight: 400; font-size: clamp(25px, 2.8vw, 42px); line-height: 1.08; letter-spacing: -0.02em; color: var(--ink); margin: 0; max-width: 20ch; }
    .sm-why-lead { font-family: var(--sans); font-size: clamp(14px, 1.05vw, 16px); line-height: 1.65; color: rgba(28,29,34,0.72); margin: 0; }
    .sm-why-build { font-family: var(--serif); font-style: italic; font-size: clamp(18px, 1.6vw, 23px); color: var(--english-violet); margin: 0; }
    .sm-pillars { display: flex; flex-direction: column; gap: clamp(16px, 2vw, 24px); }
    .sm-pillars .sm-col-h { font-size: clamp(18px, 1.5vw, 22px); margin: 0 0 8px; }
    .sm-pillars .sm-col p { font-size: clamp(14px, 1.05vw, 15px); line-height: 1.6; margin: 0; }

    /* ---- Slide 3: what we do + service-tier scroll box + what good looks like ---- */
    .sm-services { align-items: center; }
    .sm-services-inner {
      width: 100%; max-width: 1040px; margin: 0 auto;
      max-height: calc(100vh - 184px);
      display: flex; flex-direction: column; gap: clamp(18px, 2.2vw, 30px);
    }
    .sm-services-head { flex: 0 0 auto; }
    .sm-services-h { font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 3.2vw, 48px); line-height: 1.04; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 14px; }
    .sm-services-lead { font-family: var(--sans); font-size: clamp(14px, 1.05vw, 16px); line-height: 1.6; color: rgba(28,29,34,0.72); max-width: 76ch; margin: 0 0 12px; }
    .sm-services-choose { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--english-violet); margin: 0; }
    .sm-tiers {
      flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
      display: flex; flex-direction: column;
      border: 1px solid rgba(28,29,34,0.16); border-radius: 12px;
      scrollbar-width: thin;
    }
    .sm-tier { padding: clamp(14px, 1.6vw, 20px) clamp(16px, 1.8vw, 24px); border-bottom: 1px solid rgba(28,29,34,0.1); }
    .sm-tier:last-child { border-bottom: none; }
    .sm-tier-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
    .sm-tier-name { font-family: var(--serif); font-weight: 500; font-size: clamp(18px, 1.6vw, 22px); color: var(--ink); margin: 0; }
    .sm-tier-sub { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet); }
    .sm-tier-price { margin-left: auto; font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--ink); white-space: nowrap; }
    .sm-tier-blurb { font-family: var(--sans); font-size: clamp(13px, 1vw, 15px); line-height: 1.6; color: rgba(28,29,34,0.72); margin: 0; }
    .sm-good { flex: 0 0 auto; display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .sm-good-text { max-width: 64ch; }
    .sm-good-text .sm-kicker { margin-bottom: 8px; }
    .sm-good-text p { font-family: var(--sans); font-size: clamp(13px, 1vw, 15px); line-height: 1.6; color: rgba(28,29,34,0.72); margin: 0; }
    .sm-good .pf-cta { margin-top: 0; }

    /* ---- Slide 4: three CTA cards (mirrors the videography final panel) ---- */
    .sm-ctas { padding: 0; align-items: stretch; }
    .sm-cta-row { width: 100%; height: 100%; display: flex; }
    .sm-cta-card {
      flex: 1 1 0; min-width: 0;
      display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start;
      gap: 18px; padding: clamp(96px, 12vh, 150px) clamp(28px, 3vw, 48px) 80px;
      border-right: 1px solid rgba(28,29,34,0.08);
    }
    .sm-cta-card:last-child { border-right: none; }
    .sm-cta-img { flex: 0 0 auto; width: 100%; max-width: 360px; height: clamp(150px, 24vh, 280px); background-size: cover; background-position: center; background-color: #e9e4da; }
    .sm-cta-title { font-family: var(--serif); font-weight: 400; font-size: clamp(24px, 2.1vw, 36px); letter-spacing: -0.02em; margin: 0; }
    .sm-cta-desc { font-family: var(--sans); font-size: clamp(14px, 1vw, 15px); line-height: 1.6; color: rgba(28,29,34,0.7); max-width: 42ch; margin: 0; }
    .sm-cta-btn {
      align-self: flex-start; background: none; border: none; cursor: pointer; text-decoration: none;
      font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--ink); padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.25);
