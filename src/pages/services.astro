            // from slide 2 sets a dwell, and the photo does not begin to come
            // down until it has passed. Once shrinking, no gate.
            if (heroP >= 1 && performance.now() < lockUntil) return;
            heroP = Math.max(0, Math.min(1, heroP + d * HEROSENS)); return;
          }
          // Forward on a photo that is already full: slide 2 is already showing,
          // so step onto it now rather than spending half a scroll on nothing —
          // which is what "it gets stuck" was.
          if (d > 0 && heroP >= 1) { ev.preventDefault(); anchor = 1; acc = 1; lockUntil = performance.now() + PAUSE; return; }
        }
        // Scrolling back off slide 2 lands on the full photo with the words still
        // on it; the next scroll up then shrinks the photo (the branch above).
        // `acc < anchor + STEP`: a part-scroll forward that never committed to
        // slide 3 must not stop the way back.
        if (!isPhone() && d < 0 && Math.round(anchor) === 1 && acc < anchor + STEP && heroP >= 1) {
          ev.preventDefault(); anchor = 0; acc = 0; lockUntil = performance.now() + PAUSE; return;
        }
        if (edgeBlocked(ev, d)) return;
        ev.preventDefault();
        acc = clamp(acc + d * SENS);
      }, { passive: false });

      window.addEventListener("keydown", (ev) => {
        if (portfolioOpen) return;
        if (["ArrowRight", "ArrowDown", "PageDown"].includes(ev.key)) { ev.preventDefault(); acc = clamp(Math.round(acc) + 1); }
        else if (["ArrowLeft", "ArrowUp", "PageUp"].includes(ev.key)) { ev.preventDefault(); acc = clamp(Math.round(acc) - 1); }
      });

      // Slide-1 "Discover" button advances the deck to the next slide.
      stage.querySelectorAll("[data-deck-next]").forEach((b) =>
        b.addEventListener("click", () => {
          // From the hero, Discover means "show me": fill the photo and the first
          // words come with it, the same as scrolling would.
          if (!isPhone() && Math.round(anchor) === 0) heroP = 1;
          acc = clamp(Math.round(anchor) + 1);
        }));

      // touch — drag continuously (up/left advances); ignored inside the tiers box
      let tx = 0, ty = 0, tp = 0, thp = 0, tScroll = false;
      stage.addEventListener("touchstart", (ev) => {
        const t = ev.touches[0]; tx = t.clientX; ty = t.clientY; tp = acc; thp = heroP;
        tScroll = !!(ev.target.closest && ev.target.closest(".sm-tiers"));
      }, { passive: true });
      stage.addEventListener("touchmove", (ev) => {
        if (portfolioOpen || tScroll) return;
        const t = ev.touches[0]; const dx = t.clientX - tx, dy = t.clientY - ty;
        const dom = Math.abs(dx) > Math.abs(dy) ? dx : dy;
        // Slide 1: a drag raises the long image to full-page first (then advance).
        // Skipped on phones — one swipe advances straight to slide 2.
        if (!isPhone() && Math.round(anchor) === 0) {
          const np = Math.max(0, Math.min(1, thp - dom * 0.0024));
          heroP = np;
          if (np >= 1 && dom < 0) acc = clamp(Math.round(anchor) + 1);
          return;
        }
        acc = clamp(tp - dom * 0.004);
      }, { passive: true });
    })();

    // Slide 5 — tier list drives the reactive image: hover/focus/click a tier to
    // open its blurb and crossfade in its image.
    (function tiers() {
      const list = document.getElementById("sm-tierlist");
      const media = document.getElementById("sm-services-media");
      if (!list || !media) return;
      const items = [...list.querySelectorAll(".sm-tieritem")];
      const imgs = [...media.querySelectorAll(".sm-tierimg")];
      // openTier=false shows a tier's image without expanding its blurb — used
      // for the default state so every tier starts collapsed (expandable).
      const setActive = (i, openTier = true) => {
        items.forEach((it, n) => it.classList.toggle("is-active", openTier && n === i));
        imgs.forEach((im, n) => im.classList.toggle("is-active", n === i));
      };
      const collapse = () => setActive(0, false);   // default: image only, no blurb open
      // Open ONLY on a real pointer move over a tier. A mouseenter fires when the
      // slide transitions in under a stationary cursor — that's what popped a box
      // open on arrival; mousemove never fires without genuine movement, so the
      // slide always lands fully collapsed and a box opens only once the user
      // actively moves onto it. Leaving the list closes everything back down.
      let cur = -1;
      const openItem = (i) => { if (i !== cur) { cur = i; setActive(i); } };
      items.forEach((it, i) => {
        it.addEventListener("mousemove", () => openItem(i));
        it.addEventListener("focus", () => openItem(i));          // keyboard = deliberate
        it.addEventListener("click", () => openItem(i));
      });
      list.addEventListener("mouseleave", () => { cur = -1; collapse(); });

      collapse();
      // Re-collapse whenever the slide (re)enters view, so it always lands closed.
      const panel = list.closest(".pf-panel");
      if (panel) {
        const sync = () => { if (panel.classList.contains("is-in")) { cur = -1; collapse(); } };
        new MutationObserver(sync).observe(panel, { attributes: true, attributeFilter: ["class"] });
        sync();
      }
    })();

    // "Book a call" -> the booking wizard mounts inside the panel (in-place),
    // not as a pop-out. Hide the intro while booking; restore it when closed.
    (function inlineBooking() {
      const panel = document.getElementById("sm-book-panel");
      if (!panel) return;
      const pickBtn = panel.querySelector(".sm-book-cta");
      if (pickBtn) pickBtn.addEventListener("click", () => panel.classList.add("is-booking"));
      window.addEventListener("dc:close", () => panel.classList.remove("is-booking"));
    })();

    // Burger opens the shared off-canvas side menu (NavDrawer) — wiring lives
    // in that component, keyed off [data-nav-drawer-open]. No top-menu toggle.
  </script>
</BaseLayout>
