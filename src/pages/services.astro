---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";
import DiscoveryPanel from "../components/DiscoveryPanel.astro";
import SMMForms from "../components/SMMForms.astro";
import NavDrawer from "../components/NavDrawer.astro";
import { COPY, SERVICE_TIERS, SHOW_TIER_PRICES } from "../lib/smm-config.js";
import { gbpFromPence } from "../lib/supabase.js";

// Horizontal slide deck (videography-style). Placeholder portfolio imagery on R2.
const R2 = (n) => `https://assets.tmke.co.uk/${n}.webp`;
// SMM dictionary-hero backdrop — the client's "Smm hero" still on R2 (reused on
// the slide-6 work-samples field; the hero itself is now a portrait video).
const SMM_HERO_IMG = "https://assets.tmke.co.uk/Smm%20hero.jpg";
// The video slide is gone (5 Sep): the hero's long image grows to fill the
// screen on scroll and the three "ethos" texts now play over THAT, so there is
// no separate scene to slide across to. See the sm-feature panels below.
// Slide-1 "long image" — sits in a band below the About-style header and scrolls
// up on wheel. Full-width → keep it near native res (source is 2560×1440) at high
// quality so it stays crisp on large/retina screens.
const SMM_HERO_BG = (await getImage({
  src: "https://assets.tmke.co.uk/TMKE%20SMM/SMM%20Background%202.png",
  width: 2560, height: 1440, quality: 86, format: "webp",
})).src;
// Slide-5 half-screen image (kept at half-screen res).
const SMM_MKTG_IMG = (await getImage({
  src: "https://assets.tmke.co.uk/TMKE%20SMM/Slide%202%20-%20Social%20Media%20Marketing.png",
  inferSize: true, width: 1600, quality: 72, format: "webp",
})).src;
// Slide 5 — one image per service tier (swaps on hover). Default (index 0) is the
// Social Media Marketing image (replaces the old kitchen placeholder).
const TIER_IMAGES = [SMM_MKTG_IMG, R2("white-2"), R2("table"), R2("living-2")];

// Slide 6 — floating "work samples" field. Mix of images, brand swatches and
// logo tiles; all render as consistent 3:4 boxes. Placeholders — swap freely.
// 24 tiles scattered to fill the screen, drifting fast toward the viewer.
const GIMG = [
  R2("white-1"), R2("living-1"), R2("kitchen-1"), R2("orange-1"), R2("table"), R2("white-2"),
  R2("kitchen-2"), R2("living-2"), R2("orange-2"), R2("vibes"), SMM_HERO_IMG, SMM_MKTG_IMG,
];
const GSW = ["var(--english-violet)", "var(--ink)", "#c9a88e", "#8a9a8e", "#d8c4b0"];
// Concentric-ring depth field: tiles emerge from the BACK (far, faint, small),
// fly toward the viewer growing via 3D perspective, and spiral gently as they
// come (circular flow), then pass off the screen. 3 rings × 7 tiles; each ring
// sits at a staggered depth so several concentric rings are always in flight.
const GRINGS = 3, GPER = 7;
const GOOD_TILES = [];
for (let ring = 0; ring < GRINGS; ring++) {
  for (let k = 0; k < GPER; k++) {
    const i = ring * GPER + k;
    const ang = +((k * (360 / GPER)) + ring * 17).toFixed(1);  // even per ring + per-ring offset
    const r = 22 + ring * 4;                                    // base ring radius (vmin)
    const d = 6;
    const l = +(-(ring / GRINGS) * d).toFixed(2);              // rings staggered in depth
    const base = { ang, r, d, l };
    if (i % 7 === 3) GOOD_TILES.push({ ...base, logo: true });
    else if (i % 3 === 1) GOOD_TILES.push({ ...base, sw: GSW[i % GSW.length] });
    else GOOD_TILES.push({ ...base, img: GIMG[i % GIMG.length] });
  }
}
const BRANDS = [
  { name: "Crescent Lettings", meta: "Lettings · Manchester", blurb: "Always-on content and monthly reels for a fast-growing lettings brand.", images: [R2("white-1"), R2("living-1"), R2("kitchen-1")] },
  { name: "Harbour & Co", meta: "Premium sales · Poole", blurb: "Full management for a premium coastal agency — strategy through to delivery.", images: [R2("orange-1"), R2("table"), R2("white-2")] },
  { name: "Bush & Co", meta: "Independent · London", blurb: "Brand refresh and a consistent social presence for an independent agent.", images: [R2("kitchen-2"), R2("living-2"), R2("orange-2")] },
];
const navLinks = [
  { label: "About", href: "/about" },
  { label: "Social Media", href: "/services", current: true },
  { label: "Videography", href: "/videography" },
  { label: "The Edit", href: "/edit" },
  { label: "Insights", href: "/blog" },
  { label: "Contact", href: "/contact" },
];
const total = 7;
---

<BaseLayout
  title="Social Media Management — TMKE"
  description="Full-service social media management for property agents — strategy to execution, delivered to a standard that reflects your business."
  hideNav
  hideFooter
  pageTransition
>
  <div class="pf">
    <!-- Top nav -->
    <header class="pf-top" id="pf-top">
      <a href="/" class="pf-top-logo">TMKE</a>
      <nav class="pf-top-links" aria-label="Primary">
        {navLinks.map((l) => (<a href={l.href} class:list={[l.current && "is-current"]}>{l.label}</a>))}
        <a href="/login" class="pf-top-login js-nav-login">Login</a>
      </nav>
      <button type="button" class="pf-top-menu" id="pf-top-menu" aria-label="Menu" aria-expanded="false" data-nav-drawer-open><span></span><span></span><span></span></button>
    </header>

    <div class="pf-stage" id="pf-deck" style={`--sm-hero-bg:url('${SMM_HERO_BG}')`}>
      <div class="pf-plane" id="pf-plane">
        <!-- Slide 1 (col 0,row 0) — uses the About lede layout EXACTLY (term +
             pronunciation top, mini brief + Discover button bottom, image right),
             anchored to the BOTTOM of the slide. The blank space above is left
             for a hero image the client will add. -->
        <section class="pf-panel sm-hero" style="--col:0;--row:0">
          <!-- About-style dictionary header, pinned to the top (light, ink on paper) -->
          <div class="sm-hero-header">
            <div class="sm-hero-wrap">
              <div class="sm-lede-grid">
                <div class="sm-lede-copy">
                  <div class="sm-lede-top">
                    <h1 class="sm-lede-mark">SMM</h1>
                    <p class="sm-lede-pron">
                      <span class="sm-lede-phon">Social Media Management</span>
                      <span class="sm-lede-pos"><em>noun</em></span>
                    </p>
                  </div>
                  <div class="sm-lede-bottom">
                    <p class="sm-lede-text">Full-service social media management for agents who want a consistent, professional presence. Everything from strategy to execution, delivered to a standard that reflects your business.</p>
                    <button type="button" class="sm-lede-btn" data-deck-next>Discover <span aria-hidden="true">&rarr;</span></button>
                  </div>
                </div>
                <figure class="sm-lede-media">
                  <img src={SMM_HERO_IMG} alt="Social media management by TMKE" />
                </figure>
              </div>
            </div>
          </div>
          <!-- One long image, inset like the About photos. On scroll it rises up
               OVER the header to a full-page image (JS drives the inset), then the
               deck advances across to slide 2. -->
          <figure class="sm-hero-pic">
            <img class="sm-hero-long" src={SMM_HERO_BG} alt="" />
            <!-- Darkens as the first text slide arrives, so the words read
                 against the photo. Opacity is driven per frame by the deck. -->
            <div class="sm-hero-shade" id="sm-hero-shade" aria-hidden="true"></div>
          </figure>
        </section>

        <!-- Slides 2-4 — the three ethos texts. None carries a backdrop: the
             hero's long image has just grown to fill the screen, and these slide
             in from the right over it. One scene, three thoughts. -->
        <section class="pf-panel sm-feature sm-feature--over sm-feature--first" style="--col:1;--row:0;--step:1">
          <div class="sm-feature-inner">
            <h2 class="sm-feature-h">{COPY.positioning.headline}</h2>
            {COPY.positioning.body.split("\n\n").filter((para) => para !== "That's what we build.").map((para) => (
              <p class="sm-feature-body">{para}</p>
            ))}
          </div>
        </section>

        <!-- Slide 3 — property first. No backdrop of its own: it slides in from
             the right over slide 2's, so the scene holds and only the words move. -->
        <section class="pf-panel sm-feature sm-feature--over" style="--col:1;--row:0;--step:2">
          <div class="sm-feature-inner">
            <h2 class="sm-feature-h">{COPY.positioning.pillars[0].title}</h2>
            <p class="sm-feature-body">{COPY.positioning.pillars[0].body}</p>
          </div>
        </section>

        <!-- Slide 4 — one account manager. Same again: words only. -->
        <section class="pf-panel sm-feature sm-feature--over" style="--col:1;--row:0;--step:3">
          <div class="sm-feature-inner">
            <h2 class="sm-feature-h">{COPY.positioning.pillars[1].title}</h2>
            <p class="sm-feature-body">{COPY.positioning.pillars[1].body}</p>
          </div>
        </section>

        <!-- Shared HUD for slides 2-4. The line, the number and the pill live
             here rather than inside each panel, because they occupy the same
             spot on all three: riding along with a sliding panel made them
             travel across the screen only to land where they started. Out here
             they hold still and cross-fade, and the line is genuinely one line
             rather than three stacked. -->
        <div class="sm-hud" id="sm-hud" aria-hidden="true" hidden>
          <div class="sm-line"><span class="sm-line-fill" id="sm-hud-fill"></span></div>
          <span class="sm-line-num" id="sm-hud-num">01</span>
          <span class="sm-tag" id="sm-hud-tag"><span class="sm-tag-text" id="sm-hud-tag-text">Ethos</span></span>
        </div>

        <!-- Slide 5 (col 2) — what we do: tier list (left) + reactive image (right) -->
        <section class="pf-panel sm-services" style="--col:2;--row:0">
          <div class="sm-services-text">
            <div class="sm-services-head">
              <p class="sm-rule-eyebrow">Services</p>
              <h2 class="sm-services-h">{COPY.whatWeDo.headline}</h2>
              <p class="sm-services-lead">{COPY.whatWeDo.body}</p>
              <p class="sm-services-choose">{COPY.whatWeDo.chooseLine}</p>
            </div>
            <div class="sm-tierlist" id="sm-tierlist">
              {SERVICE_TIERS.map((t, i) => (
                <button type="button" class="sm-tieritem" data-tier={i}>
                  <span class="sm-tieritem-num">{String(i + 1).padStart(2, "0")}</span>
                  <span class="sm-tieritem-body">
                    <span class="sm-tieritem-name">{t.name}</span>
                    <span class="sm-tieritem-sub">{t.subtitle}{SHOW_TIER_PRICES && t.price_pence != null ? ` · from ${gbpFromPence(t.price_pence)} +VAT` : ""}</span>
                    <span class="sm-tieritem-blurb">{t.blurb}</span>
                  </span>
                </button>
              ))}
            </div>
            <button type="button" class="pf-cta sm-services-cta" data-smm-form="brochure">Download a brochure <em>&rarr;</em></button>
          </div>
          <div class="sm-services-media" id="sm-services-media">
            {SERVICE_TIERS.map((t, i) => (
              <div class="sm-tierimg" data-img={i} style={`background-image:url('${TIER_IMAGES[i % TIER_IMAGES.length]}')`}></div>
            ))}
          </div>
        </section>

        <!-- Slide 6 (col 3,row 2) — Shot and Scheduled: what social media marketing is, and how it differs from management -->
        <section class="pf-panel sm-goodslide" style="--col:3;--row:0">
          <div class="sm-good-field" aria-hidden="true">
            {GOOD_TILES.map((t) => (
              <div
                class:list={["sm-good-tile", t.logo && "sm-good-tile--logo", t.sw && "sm-good-tile--sw"]}
                style={`--ang:${t.ang}deg;--r:${t.r}vmin;--dur:${t.d}s;--delay:${t.l}s;${t.img ? `background-image:url('${t.img}')` : t.sw ? `background:${t.sw}` : ""}`}
              >{t.logo ? <span>TMKE</span> : null}</div>
            ))}
          </div>
          <div class="sm-good-inner">
            <p class="sm-rule-eyebrow">Shot and Scheduled</p>
            <h2 class="sm-good-h">{COPY.whatGoodLooksLike.headline}</h2>
            <p class="sm-good-p">{COPY.whatGoodLooksLike.body}</p>
            <button type="button" class="pf-cta" data-portfolio>{COPY.whatGoodLooksLike.cta} <em>&rarr;</em></button>
          </div>
        </section>

        <!-- Slide 7 (col 4,row 2) — three CTA cards (unchanged) -->
        <section class="pf-panel sm-ctas" style="--col:4;--row:0">
          <div class="sm-cta-row">
            <article class="sm-cta-card">
              <div class="sm-cta-img" style={`background-image:url('${R2("living-1")}')`}></div>
              <h2 class="sm-cta-title">{COPY.ctas.brochure.title}</h2>
              <p class="sm-cta-desc">{COPY.ctas.brochure.body}</p>
              <button type="button" class="sm-cta-btn" data-smm-form="brochure">Download a brochure <span class="btn-arrow">&rarr;</span></button>
            </article>

            <article class="sm-cta-card">
              <div class="sm-cta-img" style={`background-image:url('${R2("table")}')`}></div>
              <h2 class="sm-cta-title">{COPY.ctas.call.title}</h2>
              <p class="sm-cta-desc">{COPY.ctas.call.body}</p>
              <button type="button" class="sm-cta-btn" data-smm-form="discovery">Book a call <span class="btn-arrow">&rarr;</span></button>
            </article>

            <article class="sm-cta-card">
              <div class="sm-cta-img" style={`background-image:url('${R2("white-1")}')`}></div>
              <h2 class="sm-cta-title">{COPY.ctas.contact.title}</h2>
              <p class="sm-cta-desc">{COPY.ctas.contact.body}</p>
              <button type="button" class="sm-cta-btn" data-smm-form="contact">Get in touch <span class="btn-arrow">&rarr;</span></button>
            </article>
          </div>
        </section>
      </div>
    </div>

    <div class="pf-counter"><span id="pf-cur">01</span> <span class="pf-counter-sep">/</span> {String(total).padStart(2, "0")}</div>
  </div>

  <!-- Portfolio pop-out -->
  <div class="sm-scrim" id="sm-scrim" hidden></div>
  <button type="button" class="sm-close" id="sm-close" aria-label="Close" hidden>&times;</button>
  <section class="sm-portfolio" id="sm-portfolio" aria-label="Portfolio" hidden>
    <div class="sm-portfolio-scroll">
      <header class="sm-portfolio-head">
        <div class="sm-kicker">Portfolio</div>
        <h2>Brands we work with</h2>
      </header>
      <div class="sm-portfolio-grid">
        {BRANDS.map((b) => (
          <article class="sm-brand">
            <div class="sm-brand-imgs">
              {b.images.map((src) => <div class="sm-brand-img" style={`background-image:url('${src}')`}></div>)}
            </div>
            <div class="sm-brand-foot">
              <h3 class="sm-brand-name">{b.name}</h3>
              <span class="sm-brand-meta">{b.meta}</span>
              <p class="sm-brand-blurb">{b.blurb}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <DiscoveryPanel />
  <SMMForms />
  <NavDrawer />

  <style>
    .pf { position: fixed; inset: 0; background: var(--paper); color: var(--ink); overflow: hidden; }
    /* 2D deck — panels sit on a plane that translates in X *and* Y, so the path
       mixes sliding across with sliding down. */
    .pf-stage { position: absolute; inset: 0; overflow: hidden; }
    /* panels are stacked; the deck script drives each one's transform so the next
       slides OVER the previous (sticky cover), free-scroll and floaty. */
    .pf-plane { position: absolute; inset: 0; }
    .pf-panel { position: absolute; inset: 0; background: var(--paper); display: flex; align-items: center; padding: 96px clamp(28px, 8vw, 140px) 80px; will-change: transform; backface-visibility: hidden; transform: translateX(100%); }
    /* Pre-park before the deck JS runs (and behind the transition cover): slide 1
       shows, the rest sit off-screen, so a direct load/refresh never flashes the
       top (last) panel. The controller overrides these inline on the first frame. */
    .pf-panel:first-child { transform: translateX(0); }
    /* words settle in with a short fade + small bounce when a panel arrives */
    /* A fade and nothing else. It used to drop the words 16px, overshoot 5px up
       and settle, which read as a hop on every slide — and a hop arriving in the
       middle of a sideways glide fights the glide. */
    @keyframes wordIn { from { opacity: 0; } to { opacity: 1; } }
    /* Not the three ethos slides. wordIn drops the words 16px, overshoots 5px
       up and settles — a bounce — and it fires every time a panel becomes
       current, which on those slides is both the fade-in on the photo and the
       moment the next one starts sliding across. They glide flat: the deck
       moves them sideways and nothing else moves them at all. */
    .pf-panel.is-in .sm-services-h, .pf-panel.is-in .sm-services-lead, .pf-panel.is-in .sm-services-choose,
    .pf-panel.is-in .sm-tierlist, .pf-panel.is-in .sm-services-cta,
    .pf-panel.is-in .sm-good-inner, .pf-panel.is-in .sm-cta-card {
      animation: wordIn 0.5s cubic-bezier(.2,.85,.3,1.05) both;
    }
    @media (prefers-reduced-motion: reduce) { .pf-panel.is-in * { animation: none !important; } }

    /* full-bleed feature slides (2–4), floema-style. They STACK at the same cell:
       the incoming slide pushes up from the bottom and slides OVER the previous
       one (which drifts up a touch). The whole panel — image, text and line —
       rides up together. JS sets the per-panel translateY. */
    .sm-feature { padding: 0; overflow: hidden; --steps: 3; }
    /* Slides 3 and 4 are text over slide 2's picture, so the panel itself must
       not paint — .pf-panel's --paper would hide the very thing they sit on. */
    .sm-feature--over { background: transparent; }
    /* Only the slide you are on shows its words — the panel beneath reads
       straight through the transparent one above it otherwise, and you get two
       titles at once. The line, number and pill are not in here any more; they
       live in .sm-hud below. */
    .sm-feature:not(.is-in) .sm-feature-inner { opacity: 0; transition: opacity 0.25s ease; }
    .sm-feature.is-in .sm-feature-inner { opacity: 1; transition: opacity 0.45s ease 0.1s; }
    /* The first ethos slide does not arrive — it is already on the photo,
       fading in as the photo grows (the deck writes its opacity inline from the
       grow progress, so the transition is off while that is happening). It sits
       over the hero from the start, so it must never catch the hero's clicks. */
    .sm-feature--first { pointer-events: none; }
    .sm-feature--first.is-growing .sm-feature-inner { transition: none; }
    /* The shade over the hero photo. The deck drives its opacity per frame in
       step with the first text slide coming in, so the picture darkens as the
       words arrive rather than snapping dark on a slide boundary. */
    .sm-hero-shade { position: absolute; inset: 0; opacity: 0; background: linear-gradient(180deg, rgba(20,18,26,0.28) 0%, rgba(20,18,26,0.4) 44%, rgba(20,18,26,0.66) 100%); pointer-events: none; }

    /* The shared HUD: one line, one number, one pill, held still across all
       three slides. Shown only while a feature slide is up (the deck toggles
       [hidden]). */
    .sm-hud { position: absolute; inset: 0; z-index: 4; pointer-events: none; }
    .sm-hud[hidden] { display: none; }
    .sm-line { position: absolute; left: 0; right: 0; top: 44%; height: 1px; background: rgba(240,238,235,0.3); }
    .sm-line-fill { position: absolute; left: 0; top: 0; height: 1px; background: var(--paper); width: 0; transition: width 1.1s cubic-bezier(.16,1,.3,1); }
    /* Number and pill sit ON the line and cross-fade in place. Both are bottom-
       anchored to it, so the pill's underside and the number's baseline sit on
       the same rule — before, each was pushed up by a share of its own height,
       and the pill being taller left it floating above the number. */
    .sm-line-num, .sm-tag { position: absolute; bottom: 56%; z-index: 3; }
    /* The pill itself never fades — only the word inside it does, and the
       number beside it. So the pill is one fixed size for all three (the deck
       measures the widest label at start and sets it) with the word centred. */
    .sm-line-num, .sm-tag-text { transition: opacity 0.3s ease; }
    .sm-tag { display: inline-flex; justify-content: center; text-align: center; }
    .sm-hud { transition: opacity 0.35s ease; }
    /* 3px against the pill's 6px, not the same number: "01" has no descenders,
       so its glyphs stop about 3px above its box. Matching the boxes would sit
       the pill visibly low against a number that looks higher than it measures. */
    .sm-line-num { left: clamp(28px, 8vw, 140px); margin-bottom: 3px; font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.22em; color: var(--paper); text-shadow: 0 1px 12px rgba(0,0,0,0.4); }
    .sm-tag { left: clamp(28px, 18vw, 360px); margin-bottom: 6px; padding: 6px 16px; border-radius: 999px; background: var(--english-violet); color: var(--paper); font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; white-space: nowrap; box-shadow: 0 6px 20px rgba(20,18,26,0.28); }
    .sm-hud.is-swapping .sm-line-num, .sm-hud.is-swapping .sm-tag-text { opacity: 0; }

    /* title + body, below the line, set in from the left (left-of-centre) */
    /* Right edge pulled out (was 5vw/96px, capped at 1100px) so the first
       slide's paragraph sits on three lines rather than four. */
    .sm-feature-inner { position: absolute; top: 49%; left: clamp(28px, 18vw, 360px); right: clamp(28px, 3vw, 60px); max-width: none; z-index: 2; color: var(--paper); text-shadow: 0 2px 22px rgba(0,0,0,0.42); }
    /* Mirrors the videography intro's type — italic serif heading at 32px, body
       at 17px on a 1.5 line. The heading was 46px against that page's 32, and
       the body 19px against 17, which is why this section read louder than the
       rest of the site.

       The 30ch cap is gone with it: at 46px it was what forced "The social
       media agency that doesn't want you to go viral." onto two lines, and no
       size would have fixed that while the cap was there. */
    .sm-feature-h { font-family: var(--serif); font-weight: 500; font-size: clamp(22px, 2.4vw, 32px); line-height: 1.32; letter-spacing: -0.01em; color: var(--paper); margin: 0 0 20px; max-width: none; }
    /* 100ch puts the first slide's paragraph on three lines. Measured at 1440:
       anything from 81ch to 119ch gives three, 76ch (the old cap) gave four, and
       uncapped it collapsed to two — a 150-character line nobody wants to read.
       The middle of that band, so a different screen does not tip it either way. */
    .sm-feature-body { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.5; color: rgba(240,238,235,0.92); max-width: 100ch; margin: 0 0 14px; }
    .sm-feature-build { font-family: var(--serif); font-style: normal; font-size: clamp(19px, 1.9vw, 28px); color: var(--paper); margin: 8px 0 14px; }
    @media (prefers-reduced-motion: reduce) {
      .sm-feature, .sm-line-fill { transition: none; }
    }
    @media (max-width: 760px) {
      .sm-line { top: 38%; }
      .sm-line-num, .sm-tag { bottom: 62%; }
      .sm-feature-inner { top: 43%; left: 28px; right: 28px; }
      .sm-tag { left: 28px; }
    }

    /* slide 6 — Shot and Scheduled (centred) */
    .sm-goodslide { align-items: center; overflow: hidden; }
    /* floating depth-field of work samples drifting toward the screen */
    .sm-good-field { position: absolute; inset: 0; z-index: 0; perspective: 1100px; perspective-origin: 50% 50%; transform-style: preserve-3d; pointer-events: none; }
    .sm-good-tile {
      position: absolute; left: 50%; top: 50%;
      width: clamp(64px, 6.6vw, 98px); aspect-ratio: 3 / 4;
      background-size: cover; background-position: center; background-color: #e9e4da;
      border-radius: 6px; box-shadow: 0 16px 36px rgba(20,18,26,0.16);
      opacity: 0;
      transform: translate(-50%, -50%) rotate(var(--ang)) translateX(var(--r)) translateZ(-1500px) rotate(calc(-1 * var(--ang)));
      animation: goodRise var(--dur, 6s) linear var(--delay, 0s) infinite;
      will-change: transform, opacity;
    }
    .sm-good-tile--logo { display: flex; align-items: center; justify-content: center; background: var(--paper); border: 1px solid rgba(28,29,34,0.12); }
    .sm-good-tile--logo span { font-family: var(--serif); font-size: clamp(16px, 1.6vw, 24px); letter-spacing: 0.08em; color: var(--english-violet); }
    /* emerge from the back (far, faint), grow toward the viewer via perspective
       while spiralling +26°, then pass off the front and fade */
    @keyframes goodRise {
      0%   { opacity: 0; transform: translate(-50%, -50%) rotate(var(--ang)) translateX(var(--r)) translateZ(-1500px) rotate(calc(-1 * var(--ang))); }
      16%  { opacity: 1; }
      74%  { opacity: 1; }
      100% { opacity: 0; transform: translate(-50%, -50%) rotate(calc(var(--ang) + 26deg)) translateX(var(--r)) translateZ(540px) rotate(calc(-1 * (var(--ang) + 26deg))); }
    }
    @media (prefers-reduced-motion: reduce) {
      .sm-good-tile { animation: none; opacity: 0.5; transform: translate(-50%, -50%) rotate(var(--ang)) translateX(var(--r)) rotate(calc(-1 * var(--ang))); }
    }
    .sm-good-inner { position: relative; z-index: 2; max-width: 760px; margin: 0 auto; padding: 36px 44px; }
    .sm-good-inner::before {
      content: ""; position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
      width: 150%; height: 215%; z-index: -1; pointer-events: none;
      background: radial-gradient(ellipse at center, rgba(244,242,241,0.96) 28%, rgba(244,242,241,0.55) 52%, rgba(244,242,241,0) 74%);
      filter: blur(28px);
    }
    .sm-good-h { font-family: var(--serif); font-weight: 400; font-size: clamp(34px, 4.6vw, 68px); line-height: 1.02; letter-spacing: -0.025em; color: var(--ink); margin: 10px 0 18px; }
    /* The same type as the three ethos paragraphs (.sm-feature-body): size,
       line-height and weight are theirs; only the colour changes, because this
       one sits on paper rather than the photo. .sm-services-lead matches too. */
    .sm-good-p { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.5; color: rgba(28,29,34,0.72); max-width: none; margin: 0 0 26px; }

    .sm-eyebrow { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--english-violet); margin: 0 0 22px; }
    .sm-eyebrow span { opacity: 0.6; }
    .pf-scroll-hint { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: rgba(28,29,34,0.5); }
    .pf-scroll-hint em { font-style: normal; margin-left: 8px; }

    /* Slide 1 — the About lede layout EXACTLY, anchored to the bottom of the
       slide: copy column left (term + pronunciation at the top, mini brief +
       Discover button at its base), contained image held right. The space above
       is left blank for a hero image the client will add. */
    .sm-hero { display: block; overflow: hidden; padding: 0; background: var(--paper); color: var(--ink); }
    /* Header pinned at the top — copied from the About lede EXACTLY: same
       top/side/bottom padding, same 1360 wrap, copy left + photo right. */
    .sm-hero-header { position: relative; z-index: 1; padding: clamp(84px, 10vh, 106px) 76px clamp(40px, 5vh, 56px); }
    .sm-hero-wrap { max-width: 1360px; margin: 0 auto; }
    .sm-lede-grid { display: grid; grid-template-columns: 1fr auto; gap: clamp(32px, 5vw, 80px); align-items: stretch; }
    .sm-lede-copy { max-width: 480px; display: flex; flex-direction: column; justify-content: space-between; }
    .sm-lede-mark { font-family: var(--serif); font-weight: 500; font-size: clamp(40px, 4.6vw, 66px); line-height: 0.94; letter-spacing: 0.02em; margin: 0; color: var(--ink); }
    .sm-lede-pron { display: flex; align-items: baseline; gap: 12px; margin: 12px 0 0; }
    .sm-lede-phon { font-family: var(--serif); font-size: clamp(14px, 1.1vw, 17px); letter-spacing: 0.06em; color: rgba(28,29,34,0.6); }
    .sm-lede-pos { font-family: var(--serif); font-style: normal; font-size: clamp(13px, 1vw, 15px); color: rgba(28,29,34,0.5); }
    .sm-lede-text { font-family: var(--sans); font-size: clamp(13px, 1vw, 15px); font-weight: 400; line-height: 1.6; color: rgba(28,29,34,0.78); margin: 0; max-width: 44ch; }
    .sm-lede-btn { display: inline-flex; align-items: center; gap: 10px; margin-top: 20px; padding: 8px 24px; border: 1px solid var(--ink); background: none; cursor: pointer; color: var(--ink); font-family: var(--sans); font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; transition: background 0.3s, color 0.3s; }
    .sm-lede-btn:hover { background: var(--ink); color: var(--paper); }
    .sm-lede-btn span { transition: transform 0.3s; }
    .sm-lede-btn:hover span { transform: translateX(4px); }
    .sm-lede-media { margin: 0; justify-self: end; }
    .sm-lede-media img { display: block; height: clamp(300px, 36vh, 372px); width: auto; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 2px; }
    /* The one long image — inset like the About photos at rest (left/right/bottom
       indents); the deck JS grows its inset to full-bleed as you scroll, so it
       rises up over the header into a full-page image, then advances across.
       (top/left/right/bottom + radius are set by JS; these are the rest fallback.) */
    .sm-hero-pic { position: absolute; z-index: 2; margin: 0; overflow: hidden; top: 52%; left: 76px; right: 76px; bottom: 0; border-radius: 2px; }
    .sm-hero-pic img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center 0%; }

    /* First-slide entrance — image settles, then the copy rises */
    #pf-deck .pf-panel:first-child .sm-lede-media img { animation: smImgIn 2.4s cubic-bezier(.16,1,.3,1) 0.2s both; }
    #pf-deck .pf-panel:first-child .sm-lede-copy { animation: smTextIn 1.6s cubic-bezier(.16,1,.3,1) 0.5s both; }
    @keyframes smImgIn { from { opacity: 0; transform: scale(1.06); } to { opacity: 1; transform: none; } }
    @keyframes smTextIn { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
    @media (prefers-reduced-motion: reduce) {
      #pf-deck .pf-panel:first-child .sm-lede-media img,
      #pf-deck .pf-panel:first-child .sm-lede-copy { animation-duration: 0.01ms; }
    }

    /* Slide 2 — Intro & Why: text left, full-bleed image right (matches /videography) */
    .sm-why { padding: 0; align-items: stretch; }
    .sm-why-text {
      width: 50%; min-width: 340px;
      display: flex; flex-direction: column; justify-content: center;
      padding: 96px clamp(28px, 4vw, 72px) 80px clamp(28px, 8vw, 140px);
    }
    .sm-why-img { flex: 1; align-self: stretch; background-size: cover; background-position: center; background-color: #e9e4da; }
    /* Slide-in entrance — image from the right, wording from the left, replayed
       each time you land on the slide (driven by .is-in from the deck script). */
    .sm-why-text { opacity: 0; transform: translateX(-46px); transition: opacity 0.9s cubic-bezier(.16,1,.3,1) 0.12s, transform 0.9s cubic-bezier(.16,1,.3,1) 0.12s; }
    .sm-why-img { opacity: 0; transform: translateX(64px) scale(1.04); transition: opacity 1.1s cubic-bezier(.16,1,.3,1), transform 1.1s cubic-bezier(.16,1,.3,1); }
    .sm-why.is-in .sm-why-text, .sm-why.is-in .sm-why-img { opacity: 1; transform: none; }
    @media (prefers-reduced-motion: reduce) {
      .sm-why-text, .sm-why-img { transition: none; opacity: 1; transform: none; }
    }
    .sm-stack { display: flex; flex-direction: column; gap: clamp(22px, 3vw, 40px); max-width: 56ch; }
    .sm-col { max-width: 54ch; }
    .sm-kicker { display: block; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.22em; text-transform: uppercase; color: var(--english-violet); margin-bottom: 22px; }
    .sm-col-h { font-family: var(--serif); font-weight: 400; font-size: clamp(23px, 2vw, 31px); line-height: 1.18; letter-spacing: -0.015em; color: var(--ink); margin: 0 0 16px; }
    .sm-col p, .sm-how p { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.7; color: rgba(28,29,34,0.72); margin: 0 0 16px; }

    /* Slide 3 — how it works */
    .sm-how-inner { max-width: 660px; }
    .sm-how-lead { font-family: var(--serif) !important; font-style: normal; font-size: clamp(22px, 2.4vw, 34px) !important; line-height: 1.3 !important; color: var(--ink) !important; margin: 0 0 22px !important; }
    .pf-cta { align-self: flex-start; background: none; border: none; cursor: pointer; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink); padding: 12px 0; margin-top: 12px; border-bottom: 1px solid rgba(28,29,34,0.25); transition: color 0.25s, border-color 0.25s; }
    .pf-cta em { font-style: normal; margin-left: 10px; display: inline-block; transition: margin 0.25s; }
    .pf-cta:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .pf-cta:hover em { margin-left: 16px; }

    /* ---- Slide 2: positioning headline + two pillars ---- */
    .sm-why-head { font-family: var(--serif); font-weight: 400; font-size: clamp(25px, 2.8vw, 42px); line-height: 1.08; letter-spacing: -0.02em; color: var(--ink); margin: 0; max-width: 20ch; }
    .sm-why-lead { font-family: var(--sans); font-size: clamp(14px, 1.05vw, 16px); line-height: 1.65; color: rgba(28,29,34,0.72); margin: 0; }
    .sm-why-build { font-family: var(--serif); font-style: normal; font-size: clamp(18px, 1.6vw, 23px); color: var(--english-violet); margin: 0; }
    .sm-pillars { display: flex; flex-direction: column; gap: clamp(16px, 2vw, 24px); }
    .sm-pillars .sm-col-h { font-size: clamp(18px, 1.5vw, 22px); margin: 0 0 8px; }
    .sm-pillars .sm-col p { font-size: clamp(14px, 1.05vw, 15px); line-height: 1.6; margin: 0; }

    /* ---- Slide 3: what we do + service-tier scroll box + what good looks like ---- */
    /* Slide 5 — tier list (left) with a full-bleed image (right) that swaps as
       you hover/select a tier. */
    .sm-services { padding: 0; align-items: stretch; }
    .sm-services-text {
      width: 66.6%; min-width: 360px;
      display: flex; flex-direction: column; justify-content: flex-end; gap: clamp(14px, 2vh, 24px);
      padding: clamp(40px, 5vh, 64px) clamp(28px, 4vw, 64px) 80px clamp(28px, 8vw, 140px);
    }
    .sm-services-media { position: relative; flex: 1; align-self: stretch; overflow: hidden; background: #e9e4da; }
    .sm-tierimg { position: absolute; inset: 0; background-size: cover; background-position: center; opacity: 0; transform: scale(1.05); transition: opacity 0.7s cubic-bezier(.16,1,.3,1), transform 1.5s cubic-bezier(.16,1,.3,1); }
    .sm-tierimg.is-active { opacity: 1; transform: scale(1); }

    /* ---- Borrowed from The Edit (5 Sep) ----------------------------------
       What makes that page feel premium is discipline rather than any one
       device: one hairline weight for every divider, an 11px wine eyebrow with
       a short rule before it, and a number-over-name caption on every tile. The
       two light slides here take those three things and nothing else — the
       deck, the animation and the layout are untouched. */
    /* .sm-rule-eyebrow, not .sm-eyebrow — that name was already taken further
       down this file by a different eyebrow (12px, with a dimmed span), and the
       two were fighting over it. */
    .sm-rule-eyebrow {
      display: flex; align-items: center; gap: 12px; margin: 0 0 18px;
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.28em; text-transform: uppercase; color: var(--english-violet);
    }
    .sm-rule-eyebrow::before { content: ""; width: 30px; height: 1px; background: var(--english-violet); opacity: 0.5; }

    /* The tier list is as it was — number beside the name, serif name — after a
       pass that stacked the number over the name made every row 76px where it
       had been 48, and four of those threw the whole slide's proportions. The
       one thing kept from that pass is a single hairline weight (The Edit's
       rgba(28,29,34,0.16)) for the top rule and the rows, where it had two. */
    .sm-tierlist { display: flex; flex-direction: column; border-top: 1px solid rgba(28,29,34,0.16); }
    .sm-tieritem { display: flex; gap: 14px; align-items: flex-start; width: 100%; text-align: left; background: none; border: 0; border-bottom: 1px solid rgba(28,29,34,0.16); border-left: 2px solid transparent; padding: 13px 0; cursor: pointer; transition: border-color 0.3s ease, padding 0.3s ease; -webkit-tap-highlight-color: transparent; }
    .sm-tieritem-num { font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.1em; color: var(--english-violet); padding-top: 5px; flex: 0 0 auto; }
    .sm-tieritem-body { display: flex; flex-direction: column; min-width: 0; }
    .sm-tieritem-name { font-family: var(--serif); font-weight: 500; font-size: clamp(15px, 1.4vw, 20px); line-height: 1.1; letter-spacing: -0.01em; color: rgba(28,29,34,0.5); transition: color 0.3s ease; }
    .sm-tieritem-sub { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet); margin-top: 6px; opacity: 0; max-height: 0; overflow: hidden; transition: opacity 0.35s ease, max-height 0.35s ease, margin 0.35s ease; }
    .sm-tieritem-blurb { font-family: var(--sans); font-size: clamp(14px, 1.05vw, 16px); line-height: 1.55; color: rgba(28,29,34,0.66); margin-top: 0; max-width: 66ch; opacity: 0; max-height: 0; overflow: hidden; transition: opacity 0.4s ease, max-height 0.5s ease, margin 0.4s ease; }
    .sm-tieritem.is-active { border-left-color: var(--english-violet); padding-left: 16px; }
    .sm-tieritem.is-active .sm-tieritem-name { color: var(--ink); }
    .sm-tieritem.is-active .sm-tieritem-sub { opacity: 1; max-height: 2em; }
    .sm-tieritem.is-active .sm-tieritem-blurb { opacity: 1; max-height: 9em; margin-top: 9px; }
    .sm-services-cta { margin-top: clamp(16px, 3vh, 30px); align-self: flex-start; }
    @media (max-width: 760px) {
      .sm-services { flex-direction: column; }
      .sm-services-text { width: 100%; min-width: 0; padding: 88px 28px 22px; gap: 16px; }
      .sm-services-media { width: 100%; min-height: 32vh; }
    }

    .sm-services-head { flex: 0 0 auto; }
    .sm-services-h { font-family: var(--serif); font-weight: 400; font-size: clamp(28px, 3.2vw, 48px); line-height: 1.04; letter-spacing: -0.02em; color: var(--ink); margin: 0 0 14px; }
    .sm-services-lead { font-family: var(--sans); font-size: clamp(15px, 1.15vw, 17px); line-height: 1.5; color: rgba(28,29,34,0.72); max-width: 76ch; margin: 0 0 12px; }
    .sm-services-choose { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--english-violet); margin: clamp(20px, 4vh, 44px) 0 0; }
    .sm-tiers {
      flex: 1 1 auto; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
      display: flex; flex-direction: column;
      border: 1px solid rgba(28,29,34,0.16); border-radius: 12px;
      scrollbar-width: thin;
    }
    .sm-tier { padding: clamp(14px, 1.6vw, 20px) clamp(16px, 1.8vw, 24px); border-bottom: 1px solid rgba(28,29,34,0.1); }
    .sm-tier:last-child { border-bottom: none; }
    .sm-tier-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 6px; }
    .sm-tier-name { font-family: var(--serif); font-weight: 500; font-size: clamp(18px, 1.6vw, 22px); color: var(--ink); margin: 0; }
    .sm-tier-sub { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--english-violet); }
    .sm-tier-price { margin-left: auto; font-family: var(--sans); font-size: 13px; font-weight: 700; color: var(--ink); white-space: nowrap; }
    .sm-tier-blurb { font-family: var(--sans); font-size: clamp(13px, 1vw, 15px); line-height: 1.6; color: rgba(28,29,34,0.72); margin: 0; }
    .sm-good { flex: 0 0 auto; display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
    .sm-good-text { max-width: 64ch; }
    .sm-good-text .sm-kicker { margin-bottom: 8px; }
    .sm-good-text p { font-family: var(--sans); font-size: clamp(13px, 1vw, 15px); line-height: 1.6; color: rgba(28,29,34,0.72); margin: 0; }
    .sm-good .pf-cta { margin-top: 0; }

    /* ---- Slide 4: three CTA cards (mirrors the videography final panel) ---- */
    .sm-ctas { padding: 0; align-items: stretch; }
    .sm-cta-row { width: 100%; height: 100%; display: flex; }
    .sm-cta-card {
      flex: 1 1 0; min-width: 0;
      display: flex; flex-direction: column; justify-content: flex-end; align-items: flex-start;
      gap: 18px; padding: clamp(96px, 12vh, 150px) clamp(28px, 3vw, 48px) 80px;
      border-right: 1px solid rgba(28,29,34,0.08);
    }
    .sm-cta-card:last-child { border-right: none; }
    .sm-cta-img { flex: 0 0 auto; width: 100%; max-width: 360px; height: clamp(150px, 24vh, 280px); background-size: cover; background-position: center; background-color: #e9e4da; }
    .sm-cta-title { font-family: var(--serif); font-weight: 400; font-size: clamp(24px, 2.1vw, 36px); letter-spacing: -0.02em; margin: 0; }
    .sm-cta-desc { font-family: var(--sans); font-size: clamp(14px, 1.05vw, 16px); line-height: 1.45; color: rgba(28,29,34,0.7); max-width: 42ch; margin: 0; }
    .sm-cta-btn {
      align-self: flex-start; background: none; border: none; cursor: pointer; text-decoration: none;
      font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--ink); padding: 12px 0; border-bottom: 1px solid rgba(28,29,34,0.25);
      transition: color .25s, border-color .25s;
    }
    .sm-cta-btn:hover { color: var(--english-violet); border-color: var(--english-violet); }
    .sm-cta-btn .btn-arrow { margin-left: 10px; display: inline-block; transition: margin .25s; }
    .sm-cta-btn:hover .btn-arrow { margin-left: 16px; }
    @media (max-width: 860px) {
      .sm-ctas { overflow-y: auto; }
      .sm-cta-row { flex-direction: column; height: auto; }
      .sm-cta-card { border-right: none; border-bottom: 1px solid rgba(28,29,34,0.08); padding: 48px 28px; }
      .sm-cta-img { max-width: none; height: 30vh; }
    }

    /* Slide 4 — Let's talk + slide-in "Book a call" reveal. The book panel slides
       in from the right; "Let's talk" eases left (transform) and never leaves the
       screen. --bookw is the book panel's width. */
    .sm-final { position: relative; overflow: hidden; padding: 0; --bookw: min(46vw, 560px); }
    .sm-contact-inner {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      padding: 96px clamp(28px, 8vw, 140px) 80px;
    }
    /* The text block is centred at rest, then slides left into the space left of
       the book panel when revealed (stays fully on screen). */
    .sm-contact-content {
      max-width: 640px; text-align: center;
      display: flex; flex-direction: column; align-items: center;
      transition: transform 0.7s cubic-bezier(.16,1,.3,1);
    }
    .sm-contact-content .sm-lead { max-width: 52ch; }
    .sm-final.is-revealed .sm-contact-content { transform: translateX(calc(var(--bookw) / -2)); }
    /* "Book a call" panel — off-screen right until revealed, then slides in. */
    .sm-book-panel {
      position: absolute; top: 0; right: 0; z-index: 4;
      width: var(--bookw); height: 100%;
      background: var(--english-violet); color: var(--paper);
      display: flex; flex-direction: column; justify-content: center; gap: 24px;
      padding: 96px clamp(40px, 4vw, 80px) 80px;
      transform: translateX(100%);
      transition: transform 0.7s cubic-bezier(.16,1,.3,1);
    }
    .sm-final.is-revealed .sm-book-panel { transform: translateX(0); }
    .sm-book-intro { display: flex; flex-direction: column; gap: 24px; }
    /* When booking, the wizard mounts in-place: hide the intro, fill the panel. */
    .sm-book-mount { display: none; }
    .sm-book-panel.is-booking { padding: 0; }
    .sm-book-panel.is-booking .sm-book-intro { display: none; }
    .sm-book-panel.is-booking .sm-book-mount { display: block; position: absolute; inset: 0; }
    .sm-book-title { font-family: var(--serif); font-weight: 400; font-size: clamp(40px, 4vw, 72px); line-height: 0.98; letter-spacing: -0.025em; margin: 0; }
    .sm-book-desc { font-family: var(--sans); font-size: 15px; line-height: 1.6; color: rgba(240,238,235,0.8); max-width: 38ch; margin: 0; }
    .sm-book-cta { align-self: flex-start; background: var(--paper); color: var(--ink); border: none; cursor: pointer; font-family: var(--sans); font-size: 12px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; padding: 15px 28px; transition: opacity .25s; }
    .sm-book-cta:hover { opacity: 0.85; }
    .sm-book-cta .btn-arrow { margin-left: 10px; display: inline-block; transition: margin .25s; }
    .sm-book-cta:hover .btn-arrow { margin-left: 16px; }
    /* Reveal handle on the right edge — rides in to the panel's left edge. */
    .sm-reveal-tab {
      position: absolute; top: 50%; right: 0; transform: translateY(-50%);
      z-index: 6; width: 40px; height: 104px; border: none; cursor: pointer;
      background: var(--english-violet); color: var(--paper);
      border-radius: 10px 0 0 10px; display: flex; align-items: center; justify-content: center;
