---
import BaseLayout from "../layouts/BaseLayout.astro";

// The fallback only. The real set is Jack's own work, read from R2 at load
// (see the grid script) so images can be added or swapped in the bucket
// without touching this file. These nine are what shows if that fetch fails.
const GRID_IMAGES = Array.from({ length: 9 }, (_, i) => `/assets/signup/${i + 1}.webp`);
const WORKER_URL = (import.meta.env.PUBLIC_R2_WORKER_URL || "").replace(/\/+$/, "");
---

<BaseLayout
  title="Leave a review — TMKE"
  description="Had a great experience with TMKE? Let us know — it means a lot, and helps other people find us."
>
  <!-- Same "pop up, hold, then move" technique as the homepage's TMKE/Edit
       hero (.hero-intro) — one phrase instead of a splitting pair, and it
       flies UP and out rather than parting left/right, crossing paths with
       the review card flying in to take its place. Behind it all, a grid of
       images "flashes" (2-4 cells swap at a time) for ~30s, then freezes on
       whatever's showing. Reduced-motion / no-JS skip straight to the
       settled state, same as the homepage. -->
  <section class="lrv-hero" id="lrv-hero" aria-label="Leave a review">
    <div class="lrv-grid-bg" id="lrv-grid-bg" aria-hidden="true"></div>
    <div class="lrv-hero-tint" aria-hidden="true"></div>

    <span class="lrv-word" id="lrv-word">How did we do?</span>

    <div class="lrv-card-wrap" id="lrv-card-wrap">
      <form class="lrv-form" id="tmke-review-form" novalidate>
        <div class="lrv-card" id="lrv-card">
          <p class="lrv-eyebrow">/ Leave a review /</p>
          <div class="lrv-grid-fields">
            <div class="lrv-field">
              <label for="rv-name">Your name <span>*</span></label>
              <input id="rv-name" name="name" type="text" placeholder="Your name" autocomplete="name" required />
            </div>
            <div class="lrv-field">
              <label for="rv-service">What did we help with? <span>*</span></label>
              <input id="rv-service" name="service" type="text" placeholder="e.g. Property videography, Social media" required />
            </div>
            <div class="lrv-field lrv-field--full">
              <label for="rv-review">Your review <span>*</span></label>
              <textarea id="rv-review" name="review_text" rows="4" placeholder="How did it go?" required></textarea>
            </div>
          </div>

          <div class="lrv-submit-row">
            <button type="submit" class="lrv-submit" id="lrv-submit">
              <span class="lrv-submit-label">Submit Review</span>
              <span class="lrv-submit-spinner" aria-hidden="true"></span>
            </button>
          </div>
          <p class="lrv-error" id="lrv-error" role="alert" hidden></p>

          <!-- Success state — collapses into the middle of the card. -->
          <div class="lrv-success" id="lrv-success" aria-hidden="true">
            <div class="lrv-success-tick" aria-hidden="true">
              <svg viewBox="0 0 52 52">
                <circle class="lrv-tick-circle" cx="26" cy="26" r="24" />
                <path class="lrv-tick-check" d="M15 27 l7.5 7.5 L37 18" />
              </svg>
            </div>
            <p class="lrv-success-h">Thank you.</p>
            <p class="lrv-success-p">We really appreciate you taking the time.</p>
          </div>
        </div>
      </form>
    </div>
  </section>

  <style is:global>
    .lrv-hero {
      position: relative; min-height: 100vh; display: flex; align-items: center; justify-content: center;
      background: var(--violet-deep); overflow: hidden; padding: clamp(90px, 12vh, 140px) clamp(20px, 5vw, 60px) clamp(40px, 6vh, 70px);
    }

    /* ---- Flashing image grid, behind everything ---- */
    .lrv-grid-bg { position: absolute; inset: 0; z-index: 0; display: grid; grid-template-columns: repeat(4, 1fr); grid-template-rows: repeat(3, 1fr); }
    /* The nav's resting colour is ink, which is right on cream and invisible
       on this page - the hero fills the viewport and is dark the whole way
       down, so the bar stays light rather than switching on scroll. */
    body:has(.lrv-hero) .nav,
    body:has(.lrv-hero) .nav.scrolled { color: var(--paper); border-bottom-color: rgba(255,255,255,0.14); }
    body:has(.lrv-hero) .nav.scrolled { background: rgba(20,19,16,0.45); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); }
    body:has(.lrv-hero) .nav-cta { border-color: rgba(255,255,255,0.5); color: var(--paper); }

    /* Two stacked layers per cell. The old version faded the cell itself to
       zero, swapped the image and faded it back - which meant every change
       blinked through to the dark background behind, and at 150ms that reads
       as a glitch rather than a decision. The new photo now fades in over the
       one it replaces, so the cell is never empty. */
    .lrv-grid-cell { position: relative; overflow: hidden; opacity: 0.5; }
    .lrv-grid-cell span {
      position: absolute; inset: 0;
      background-size: cover;
      /* Slightly above centre. A square photo in a wider cell is cropped top
         and bottom, and dead centre on a standing person takes the crop
         through their chin. 42% keeps faces in. */
      background-position: center 42%;
      transition: opacity 1.1s ease;
    }
    .lrv-hero-tint { position: absolute; inset: 0; z-index: 1; background: rgba(20,19,16,0.55); pointer-events: none; }
    @media (max-width: 900px) { .lrv-grid-bg { grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(4, 1fr); } }
    @media (max-width: 560px) { .lrv-grid-bg { grid-template-columns: repeat(2, 1fr); grid-template-rows: repeat(6, 1fr); } }

    /* ---- "How did we do?" — pops up centred, holds, flies up + out ---- */
    .lrv-word {
      position: absolute; top: 50%; left: 50%; z-index: 2;
      transform: translate(-50%, calc(-50% + 48px)) scale(0.94); opacity: 0;
      /* Matches the homepage hero's "TMKE Edit" exactly: same family (which is
         --sans, not a serif - the wordmark only looks like one), same weight,
         tracking and size ramp, so the two pages open the same way. Caps to
         match it too. */
      font-family: var(--sans), "Helvetica Neue", Arial, sans-serif; font-weight: 400;
      font-size: clamp(35px, 5.6vw, 93px); line-height: 1;
      letter-spacing: -0.01em; text-transform: uppercase;
      color: var(--paper); text-align: center; white-space: nowrap;
      text-shadow: 0 2px 34px rgba(0,0,0,0.38); will-change: transform, opacity;
    }
    @keyframes lrvWordPlay {
      0%    { opacity: 0; transform: translate(-50%, calc(-50% + 48px)) scale(0.94); }
      16.7% { opacity: 1; transform: translate(-50%, -50%) scale(1); }        /* popped up */
      72.2% { opacity: 1; transform: translate(-50%, -50%) scale(1); }        /* hold, to read */
      100%  { opacity: 0; transform: translate(-50%, -170%) scale(0.96); }    /* flies up and out */
    }
    .lrv-hero.is-playing .lrv-word { animation: lrvWordPlay 3.6s cubic-bezier(.22, 1, .36, 1) both; }
    .lrv-hero.is-settled .lrv-word { display: none; }

    /* ---- Review card — flies in as the words leave, timed to cross ---- */
    .lrv-card-wrap { position: relative; z-index: 2; width: 100%; max-width: 620px; opacity: 0; transform: translateY(70px); }
    .lrv-hero.is-playing .lrv-card-wrap { animation: lrvCardIn 1.1s cubic-bezier(.22, 1, .36, 1) 2.6s both; }
    .lrv-hero.no-anim .lrv-card-wrap, .lrv-hero.is-settled .lrv-card-wrap { opacity: 1; transform: none; animation: none; }
    @keyframes lrvCardIn { 0% { opacity: 0; transform: translateY(70px); } 100% { opacity: 1; transform: translateY(0); } }
    .lrv-hero.no-anim .lrv-word { display: none; }

    /* ---- Card ---- */
    .lrv-card {
      /* 4px, the radius every other surface in the brand uses - 14px read as a
         different system to the buttons and fields sitting inside it. */
      position: relative; border: 1px solid rgba(255,255,255,0.14); border-radius: 4px;
      padding: clamp(26px, 3vw, 42px); background: #fff;
      box-shadow: 0 40px 90px -30px rgba(0,0,0,0.5);
    }
    .lrv-eyebrow { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.26em; text-transform: uppercase; color: var(--english-violet); margin: 0 0 18px; }
    .lrv-grid-fields { display: grid; grid-template-columns: 1fr 1fr; column-gap: 28px; row-gap: 20px; transition: opacity 0.4s ease; }
    .lrv-field { display: flex; flex-direction: column; gap: 7px; }
    .lrv-field--full { grid-column: 1 / -1; }
    .lrv-field label { font-family: var(--sans); font-size: 12.5px; font-weight: 600; letter-spacing: 0.02em; color: rgba(28, 29, 34, 0.7); }
    .lrv-field label span { color: var(--english-violet); margin-left: 2px; }
    .lrv-field input, .lrv-field textarea {
      font-family: var(--sans); font-size: 15px; color: var(--ink); background: transparent; border: none;
      border-bottom: 1px solid rgba(51, 55, 71, 0.32); padding: 8px 0 9px; width: 100%; outline: none;
      border-radius: 0; transition: border-color 0.25s; box-sizing: border-box;
    }
    .lrv-field input::placeholder, .lrv-field textarea::placeholder { color: rgba(51, 55, 71, 0.32); }
    .lrv-field input:focus, .lrv-field textarea:focus { border-bottom-color: var(--english-violet); }
    .lrv-field textarea { resize: vertical; min-height: 78px; line-height: 1.5; }

    .lrv-submit-row { display: flex; justify-content: center; margin-top: 22px; transition: opacity 0.4s ease; }
    .lrv-submit {
      /* Square-ish and plum, like every other primary button on the site. The
         pill shape was the odd one out. */
      position: relative; width: 100%; max-width: 100%; height: 54px; border: none; border-radius: 4px;
      background: var(--english-violet); color: var(--paper); cursor: pointer; overflow: hidden; font-family: var(--sans);
      transition: width 0.55s cubic-bezier(.7,0,.2,1), border-radius 0.55s cubic-bezier(.7,0,.2,1), opacity 0.4s ease, transform 0.4s ease;
    }
    .lrv-submit:hover { background: var(--ink); }
    .lrv-submit-label {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      font-size: 13px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; white-space: nowrap; transition: opacity 0.2s ease;
    }
    .lrv-submit-spinner {
      position: absolute; top: 50%; left: 50%; width: 22px; height: 22px; margin: -11px 0 0 -11px;
      border: 2.5px solid rgba(244, 242, 241, 0.4); border-top-color: var(--paper); border-radius: 50%;
      opacity: 0; transition: opacity 0.25s ease 0.3s;
    }
    .lrv-submit.is-sending { width: 54px; border-radius: 50%; cursor: default; }
    .lrv-submit.is-sending .lrv-submit-label { opacity: 0; }
    .lrv-submit.is-sending .lrv-submit-spinner { opacity: 1; animation: lrv-spin 0.7s linear infinite; }
    .lrv-submit.is-done { opacity: 0; transform: scale(0.7); pointer-events: none; }
    @keyframes lrv-spin { to { transform: rotate(360deg); } }

    .lrv-error { font-family: var(--sans); font-size: 13.5px; color: #b03a2e; text-align: center; margin: 14px 0 0; }
    .lrv-error[hidden] { display: none; }

    .lrv-card.is-done .lrv-grid-fields, .lrv-card.is-done .lrv-submit-row { opacity: 0; pointer-events: none; }
    .lrv-success {
      position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
      text-align: center; padding: 32px; background: #fff; border-radius: 4px; opacity: 0; pointer-events: none; transition: opacity 0.5s ease;
    }
    .lrv-success.is-visible { opacity: 1; }
    .lrv-success-tick { width: 80px; height: 80px; margin-bottom: 20px; }
    .lrv-success-tick svg { width: 100%; height: 100%; overflow: visible; }
    /* Plum, not the generic success green — this is a thank-you in our own
       colours, not a system confirmation. */
    .lrv-tick-circle { fill: var(--english-violet); transform: scale(0); transform-box: fill-box; transform-origin: center; }
    .lrv-tick-check { fill: none; stroke: #fff; stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 44; stroke-dashoffset: 44; }
    .lrv-success.is-visible .lrv-tick-circle { animation: lrv-pop 0.45s cubic-bezier(.2,1.4,.4,1) forwards; }
    .lrv-success.is-visible .lrv-tick-check { animation: lrv-draw 0.4s ease 0.32s forwards; }
    @keyframes lrv-pop { to { transform: scale(1); } }
    @keyframes lrv-draw { to { stroke-dashoffset: 0; } }
    /* Darker Grotesque, matching the headline this card flew in to replace -
       it was Helios, which is a different face from the rest of the page. */
    .lrv-success-h { font-family: var(--sans); font-weight: 400; font-size: clamp(28px, 3vw, 40px); line-height: 1.04; letter-spacing: -0.01em; color: var(--english-violet); margin: 0 0 10px; }
    .lrv-success-p { font-family: var(--sans); font-size: clamp(14px, 1.1vw, 16px); line-height: 1.55; color: rgba(28, 29, 34, 0.66); margin: 0; max-width: 36ch; }

    @media (prefers-reduced-motion: reduce) {
      .lrv-tick-circle { transform: scale(1); }
      .lrv-tick-check { stroke-dashoffset: 0; }
      .lrv-submit { transition: opacity 0.3s ease; }
    }
    @media (max-width: 560px) {
      .lrv-grid-fields { grid-template-columns: 1fr; column-gap: 0; row-gap: 16px; }
    }
  </style>

  <!-- Trigger the intro on load, same deferred-frame pattern as the homepage
       hero so the transforms are measured correctly. Reduced-motion / no-JS
       skip straight to the settled state (card visible, no word). -->
  <script>
    (function () {
      const hero = document.querySelector(".lrv-hero");
      if (!hero) return;
      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        hero.classList.add("no-anim");
        return;
      }
      requestAnimationFrame(() => requestAnimationFrame(() => hero.classList.add("is-playing")));
      setTimeout(() => hero.classList.add("is-settled"), 3700);
    })();
  </script>
  <noscript>
    <style>
      .lrv-word { display: none !important; }
      .lrv-card-wrap { opacity: 1 !important; transform: none !important; }
    </style>
  </noscript>

  <!-- Background grid: flashes 2-4 cells at a time (a quick fade-out,
       image swap, fade back in) every ~1.4s for 30s, then stops - whatever
       is showing at that point just stays. -->
  <script define:vars={{ GRID_IMAGES, WORKER_URL }}>
    (function () {
      const host = document.getElementById("lrv-grid-bg");
      if (!host || !GRID_IMAGES.length) return;

      /* Swap in the real photos as soon as the bucket answers. The grid starts
         on the fallback rather than waiting, so the page is never blank, and
         the library grows underneath it - which is exactly what the no-repeat
         rule needs, since twelve cells cannot be filled uniquely from nine. */
      let LIBRARY = GRID_IMAGES.slice();
      if (WORKER_URL) {
        fetch(WORKER_URL + "/assets/review-grid")
          .then((r) => (r.ok ? r.json() : null))
          .then((d) => {
            if (d && Array.isArray(d.images) && d.images.length >= 4) {
              LIBRARY = d.images;
              // Warm the cache so the first dissolves are not waiting on a download.
              d.images.slice(0, 16).forEach((src) => { const i = new Image(); i.src = src; });
            }
          })
          .catch(() => { /* the fallback is already on screen */ });
      }

      const CELL_COUNT = 12;
      const cells = [];
      for (let i = 0; i < CELL_COUNT; i++) {
        const cell = document.createElement("div");
        cell.className = "lrv-grid-cell";
        const img = GRID_IMAGES[i % GRID_IMAGES.length];
        // Two layers: the one you can see, and the one the next photo arrives on.
        const a = document.createElement("span");
        const b = document.createElement("span");
        a.style.backgroundImage = `url('${img}')`;
        a.style.opacity = "1";
        b.style.opacity = "0";
        cell.append(a, b);
        cell._layers = [a, b];
        cell._top = 0;
        cell.dataset.img = img;
        host.appendChild(cell);
        cells.push(cell);
      }

      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

      /* A swap used to pick any image that was not the one already in THAT cell,
         which says nothing about the other eleven - so the same photo regularly
         appeared twice on screen. It now picks from the images that are not
         showing anywhere.

         That needs more images than cells to work at all: with twelve cells and
         nine images, three duplicates are a certainty however the swap is
         written. When the library is too small it falls back to the old rule,
         so the grid still animates rather than freezing. */
      const showing = () => new Set(cells.map((c) => c.dataset.img));

      /* One cell at a time. Two to four at once, over twelve cells, meant a
         third of the grid moving on every tick - which is what made it read as
         a fault rather than a slow drift. */
      let last = -1;
      function flashOnce() {
        let idx = Math.floor(Math.random() * cells.length);
        // Not the same cell twice running: it looks stuck.
        if (cells.length > 1 && idx === last) idx = (idx + 1) % cells.length;
        last = idx;

        const cell = cells[idx];
        const onScreen = showing();
        const spare = LIBRARY.filter((src) => !onScreen.has(src));
        let next = cell.dataset.img;
        if (spare.length) {
          next = spare[Math.floor(Math.random() * spare.length)];
        } else if (LIBRARY.length > 1) {
          while (next === cell.dataset.img) next = LIBRARY[Math.floor(Math.random() * LIBRARY.length)];
        }
        if (next === cell.dataset.img) return;   // nothing else to show

        const incoming = cell._layers[1 - cell._top];
        const outgoing = cell._layers[cell._top];
        // Decode before the fade starts, or the first frame of the dissolve is
        // a blank layer — which is the flicker all over again.
        const pre = new Image();
        pre.onload = pre.onerror = () => {
          incoming.style.backgroundImage = `url('${next}')`;
          requestAnimationFrame(() => {
            incoming.style.opacity = "1";
            outgoing.style.opacity = "0";
          });
          cell._top = 1 - cell._top;
          cell.dataset.img = next;
        };
        pre.src = next;
      }

      // Slow enough to be a drift rather than a flicker: a 1.1s dissolve with
      // a gap after it, so at most one cell is moving at any moment.
      const interval = setInterval(flashOnce, 2600);
      setTimeout(() => clearInterval(interval), 45000); // then it settles on whatever is showing
    })();
  </script>

  <script>
    import { supabase } from "../lib/supabase.js";

    const form = document.getElementById("tmke-review-form");
    if (form) {
      const card = document.getElementById("lrv-card");
      const submit = document.getElementById("lrv-submit");
      /* Prefilled when the member came from their bookings page: they have
         already told us their name and which shoot it was, and asking again is
         asking them to look it up. Everything stays editable - the fields are
         a starting point, not a lock. */
      const rvParams = new URLSearchParams(location.search);
      const rvBookingId = (rvParams.get("booking") || "").trim() || null;
      (function prefill() {
        const set = (id, v) => { const el = document.getElementById(id); if (el && v && !el.value) el.value = v; };
        set("rv-name", (rvParams.get("name") || "").trim());
        set("rv-service", (rvParams.get("service") || "").trim());
      })();

      const success = document.getElementById("lrv-success");
      const errorEl = document.getElementById("lrv-error");
      const delay = (ms) => new Promise((r) => setTimeout(r, ms));

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (!form.checkValidity()) { form.reportValidity(); return; }
        if (errorEl) errorEl.hidden = true;

        submit.setAttribute("disabled", "true");
        submit.classList.add("is-sending");

        const fd = new FormData(form);
        const payload = {
          name: String(fd.get("name") || "").trim(),
          service: String(fd.get("service") || "").trim(),
          review_text: String(fd.get("review_text") || "").trim(),
        };
        // Arrived from a member's own bookings page: remember which shoot this
        // is about, so the invitation to review it can stop appearing.
        if (rvBookingId) payload.booking_id = rvBookingId;

        const [result] = await Promise.all([
          supabase.from("client_reviews").insert(payload),
          delay(1400),
        ]);

        if (result && result.error) {
          console.error("[TMKE] review insert failed", result.error);
          submit.classList.remove("is-sending");
          submit.removeAttribute("disabled");
          if (errorEl) {
            errorEl.textContent = "Sorry — we couldn't send that. Please try again, or email hello@tmke.co.uk.";
            errorEl.hidden = false;
          }
          return;
        }

        submit.classList.add("is-done");
        await delay(420);
        if (card) card.classList.add("is-done");
        if (success) {
          success.classList.add("is-visible");
          success.setAttribute("aria-hidden", "false");
        }
        form.reset();
      });
    }
  </script>
</BaseLayout>
