---
// The Letting Experts — blog page (concept).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PreviewFrame from "../../../components/estate-agency/PreviewFrame.astro";
import TLEBlog from "../../../components/estate-agency/templates/TLEBlog.astro";
import { getTemplate } from "../../../data/estate-agency-templates.js";

const template = getTemplate("tle");
---

<BaseLayout
  title="The Letting Experts — Blog — TMKE"
  description="Guidance, market insight and practical tips for landlords and tenants."
  noindex
  hideNav
  hideFooter
>
  <PreviewFrame
    templateName="The Letting Experts — Blog"
    tagline={template.tagline}
    accent={template.accent}
  >
    <TLEBlog />
  </PreviewFrame>
</BaseLayout>
