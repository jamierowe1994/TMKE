---
// The Letting Experts — dedicated property-search page (concept).
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PreviewFrame from "../../../components/estate-agency/PreviewFrame.astro";
import TLESearch from "../../../components/estate-agency/templates/TLESearch.astro";
import { getTemplate } from "../../../data/estate-agency-templates.js";

const template = getTemplate("tle");
---

<BaseLayout
  title="The Letting Experts — Property Search — TMKE"
  description="Concept property-search layout for The Letting Experts."
  noindex
  hideNav
  hideFooter
>
  <PreviewFrame
    templateName="The Letting Experts — Search"
    tagline={template.tagline}
    accent={template.accent}
  >
    <TLESearch />
  </PreviewFrame>
</BaseLayout>
