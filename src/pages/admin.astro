---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Admin — TMKE"
  description="Internal admin dashboard for managing The Edit catalogue, orders, subscribers, and blog content."
>
  <PageHero
    chapter="Backstage — Admin"
    title="Admin <em>dashboard.</em>"
    sub="Behind-the-scenes controls for managing the catalogue, orders, members, and content. Login will be added before launch."
  />

  <section class="admin-grid wrap">
    <a href="#" class="admin-card">
      <div class="admin-card-num">01</div>
      <h3 class="admin-card-title">Catalogue</h3>
      <p>Manage Edit packs — add, edit, archive. Set pricing, preview images, pack contents.</p>
      <div class="admin-card-meta"><span>0 packs</span><span class="admin-card-arrow">&rarr;</span></div>
    </a>
    <a href="#" class="admin-card">
      <div class="admin-card-num">02</div>
      <h3 class="admin-card-title">Orders</h3>
      <p>View Stripe transactions, refund, resend download links, segment by pack type.</p>
      <div class="admin-card-meta"><span>0 orders</span><span class="admin-card-arrow">&rarr;</span></div>
    </a>
    <a href="#" class="admin-card">
      <div class="admin-card-num">03</div>
      <h3 class="admin-card-title">Members</h3>
      <p>Account list, library access, manual entitlement grants.</p>
      <div class="admin-card-meta"><span>0 members</span><span class="admin-card-arrow">&rarr;</span></div>
    </a>
    <a href="#" class="admin-card">
      <div class="admin-card-num">04</div>
      <h3 class="admin-card-title">Subscribers</h3>
      <p>Mailerlite list overview, tags, recent signups, Five &amp; Live downloads.</p>
      <div class="admin-card-meta"><span>0 subscribers</span><span class="admin-card-arrow">&rarr;</span></div>
    </a>
    <a href="#" class="admin-card">
      <div class="admin-card-num">05</div>
      <h3 class="admin-card-title">Insights (Blog)</h3>
      <p>Posts in <code>src/content/blog/*.md</code>. Add, edit, publish drafts, categorise.</p>
      <div class="admin-card-meta"><span>0 published</span><span class="admin-card-arrow">&rarr;</span></div>
    </a>
    <a href="#" class="admin-card">
      <div class="admin-card-num">06</div>
      <h3 class="admin-card-title">Enquiries</h3>
      <p>Contact form submissions, Find Your Fit results, Discovery Call bookings.</p>
      <div class="admin-card-meta"><span>0 new</span><span class="admin-card-arrow">&rarr;</span></div>
    </a>
  </section>

  <section class="admin-warning wrap">
    <div class="admin-warning-tag">
      <span class="admin-warning-dot"></span>
      Open access &middot; auth pending
    </div>
    <p>
      This page is currently <strong>unauthenticated</strong>. A login wall will be added before launch.
      Do not share the URL publicly.
    </p>
  </section>

  <style>
    .admin-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      max-width: 1360px;
      margin: 0 auto;
      padding: 40px 36px 60px;
    }
    .admin-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 32px 28px 24px;
      background: transparent;
      border: 1px solid rgba(71, 66, 84, 0.4);
      border-radius: 2px;
      color: var(--ink);
      transition: background 0.4s cubic-bezier(.2,.7,.2,1), border-color 0.4s, transform 0.4s cubic-bezier(.2,.7,.2,1);
      min-height: 220px;
    }
    .admin-card:hover {
      background: rgba(71, 66, 84, 0.04);
      transform: translateY(-2px);
    }
    .admin-card-num {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.32em;
      font-weight: 700;
      color: var(--english-violet);
    }
    .admin-card-title {
      font-family: var(--serif);
      font-size: 28px;
      font-weight: 500;
      letter-spacing: -0.01em;
      margin: 6px 0 8px;
      color: var(--ink);
    }
    .admin-card p {
      font-size: 14px;
      line-height: 1.55;
      color: rgba(28, 29, 34, 0.65);
      margin: 0;
      flex: 1;
    }
    .admin-card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid rgba(71, 66, 84, 0.2);
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 600;
      color: rgba(28, 29, 34, 0.6);
    }
    .admin-card-arrow {
      font-family: var(--serif);
      font-style: italic;
      font-size: 18px;
      color: var(--english-violet);
      letter-spacing: 0;
      text-transform: none;
      transition: transform 0.5s cubic-bezier(.2,.7,.2,1);
    }
    .admin-card:hover .admin-card-arrow {
      transform: translateX(6px);
    }

    .admin-warning {
      max-width: 1360px;
      margin: 0 auto;
      padding: 0 36px 200px;
    }
    .admin-warning-tag {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: #a05a3c;
      margin-bottom: 10px;
    }
    .admin-warning-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #a05a3c;
      box-shadow: 0 0 0 4px rgba(160, 90, 60, 0.18);
    }
    .admin-warning p {
      font-size: 14px;
      color: rgba(28, 29, 34, 0.6);
      max-width: 720px;
      line-height: 1.55;
      margin: 0;
    }
    .admin-warning strong { color: var(--ink); }

    @media (max-width: 980px) {
      .admin-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
