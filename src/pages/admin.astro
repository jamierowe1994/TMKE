---
import AdminShell from "../components/admin/AdminShell.astro";
---

<AdminShell active="dashboard" title="Dashboard" skin="hub">
  <div class="page-header">
    <div class="page-header-top">
      <div class="page-header-left">
        <div>
          <div class="page-header-title">Dashboard</div>
          <div class="page-header-sub" id="dash-date"></div>
        </div>
      </div>
    </div>
  </div>

  <div class="card mb20 dash-mgmt-only" data-mgmt hidden>
    <div class="card-head">
      <div class="card-title">Revenue</div>
    </div>
    <div class="dash-rev-top">
      <div>
        <div class="dash-rev-label">This month</div>
        <div class="dash-rev-num" data-stat="rev-month">£0</div>
      </div>
      <div>
        <div class="dash-rev-label">Year to date</div>
        <div class="dash-rev-num" data-stat="rev-ytd">£0</div>
      </div>
    </div>
    <div class="dash-rev-graph" id="dash-rev-graph"></div>
  </div>

  <div class="g2 mb20">
    <button type="button" class="card dash-clickable" id="dash-crm-card">
      <div class="card-head">
        <div class="card-title" data-slide-title data-base="CRM" data-alt="CRM — growth by month">CRM</div>
        <span class="icon-btn" data-slide-hint data-base="Growth by month &rarr;" data-alt="&larr; Back">Growth by month &rarr;</span>
      </div>
      <ul class="dash-glance" data-slide="1">
        <li><span>Contacts</span><b data-stat="crm-contacts">0</b></li>
        <li><span>Members</span><b data-stat="crm-members">0</b></li>
        <li><span>Clients</span><b data-stat="crm-clients">0</b></li>
      </ul>
      <div data-slide="2" hidden>
        <div id="dash-crm-chart" class="dash-rev-graph"></div>
        <div class="dash-legend-row">
          <span><span class="dash-pkg-legend-dot" style="background:var(--series-1)"></span>Contacts</span>
          <span><span class="dash-pkg-legend-dot" style="background:var(--series-2)"></span>Members</span>
          <span><span class="dash-pkg-legend-dot" style="background:var(--series-3)"></span>Clients</span>
        </div>
      </div>
    </button>

    <button type="button" class="card dash-clickable" id="dash-inv-open">
      <div class="card-head">
        <div class="card-title">Invoicing — this month</div>
        <span class="icon-btn">View list</span>
      </div>
      <ul class="dash-glance">
        <li><span>Invoices raised</span><b data-stat="inv-count">0</b></li>
        <li><span>Outstanding</span><b data-stat="inv-outstanding">0</b></li>
      </ul>
      <div class="dash-mgmt-only" data-mgmt hidden>
        <div class="divider"></div>
        <div class="dash-revenue-row">
          <span>Total invoiced this month</span>
          <b data-stat="inv-total">£0</b>
        </div>
      </div>
    </button>
  </div>

  <div class="g2 mb20">
    <button type="button" class="card dash-clickable" id="dash-edit-card">
      <div class="card-head">
        <div class="card-title" data-slide-title data-base="Edit" data-alt="Edit — monthly purchases">Edit</div>
        <span class="icon-btn" data-slide-hint data-base="Monthly purchases &rarr;" data-alt="&larr; Back">Monthly purchases &rarr;</span>
      </div>
      <ul class="dash-glance" data-slide="1">
        <li><span>Template packs</span><b data-stat="edit-packs">0</b></li>
        <li><span>Individual templates</span><b data-stat="edit-templates">0</b></li>
        <li><span>Purchases this month</span><b data-stat="edit-purchases-month">0</b></li>
        <li><span>Purchases all time</span><b data-stat="edit-purchases-total">0</b></li>
      </ul>
      <div data-slide="2" hidden>
        <div id="dash-edit-chart" class="dash-rev-graph"></div>
        <div class="dash-legend-row">
          <span><span class="dash-pkg-legend-dot" style="background:var(--series-1)"></span>Sale</span>
          <span><span class="dash-pkg-legend-dot" style="background:var(--series-other)"></span>Gift</span>
        </div>
      </div>
    </button>

    <div class="card">
      <div class="card-head">
        <div class="card-title">Emails — active campaigns</div>
        <a href="/admin/email/automated" class="icon-btn">View all</a>
      </div>
      <div id="dash-email-list"><div class="empty"><div class="empty-text">Loading…</div></div></div>
    </div>
  </div>

  <div class="g2 mb20">
    <button type="button" class="card dash-clickable" id="dash-vid-card">
      <div class="card-head">
        <div class="card-title" data-slide-title data-base="Videography — this month" data-alt="Videography — bookings per month">Videography — this month</div>
        <span class="icon-btn" data-slide-hint data-base="Bookings per month &rarr;" data-alt="&larr; Back">Bookings per month &rarr;</span>
      </div>
      <ul class="dash-glance" data-slide="1">
        <li><span>Clients this month</span><b data-stat="vid-clients">0</b></li>
        <li><span>In progress</span><b data-stat="vid-progress">0</b></li>
        <li><span>Complete</span><b data-stat="vid-complete">0</b></li>
        <li><span>Filming hours booked</span><b data-stat="vid-hours">0</b></li>
      </ul>
      <div data-slide="2" hidden>
        <div id="dash-vid-chart" class="dash-rev-graph"></div>
      </div>
    </button>

    <button type="button" class="card dash-clickable" id="dash-social-card">
      <div class="card-head">
        <div class="card-title" data-slide-title data-base="Social media management" data-alt="Social media — package mix">Social media management</div>
        <span class="icon-btn" data-slide-hint data-base="Package mix &rarr;" data-alt="&larr; Back">Package mix &rarr;</span>
      </div>
      <ul class="dash-glance" data-slide="1">
        <li><span>Active clients</span><b data-stat="social-clients">0</b></li>
        <li><span>Contracted hours this month</span><b data-stat="social-hours">0</b></li>
      </ul>
      <div data-slide="2" hidden>
        <div id="dash-social-breakdown" class="dash-donut-wrap-outer"><div class="empty"><div class="empty-text">Loading…</div></div></div>
      </div>
    </button>
  </div>

  <div class="g3 mb20">
    <button type="button" class="card dash-clickable" id="dash-blog-card">
      <div class="card-head">
        <div class="card-title" data-slide-title data-base="Blog" data-alt="Blog — top 5 this month, by views">Blog</div>
        <span class="icon-btn" data-slide-hint data-base="Top 5 by views &rarr;" data-alt="&larr; Back">Top 5 by views &rarr;</span>
      </div>
      <div class="dash-solo-stat" data-slide="1">
        <div class="stat-num" data-stat="blog-pub">0</div>
        <div class="stat-label">Published articles</div>
      </div>
      <div data-slide="2" hidden>
        <div id="dash-blog-top5"><div class="empty"><div class="empty-text">Loading…</div></div></div>
      </div>
    </button>

    <div class="card">
      <div class="card-head">
        <div class="card-title">Inquiries — this month</div>
        <a href="/admin/enquiries" class="icon-btn">View all</a>
      </div>
      <div id="dash-inq-breakdown"><div class="empty"><div class="empty-text">Loading…</div></div></div>
    </div>

    <button type="button" class="card dash-clickable" id="dash-website-card">
      <div class="card-head">
        <div class="card-title" data-slide-title data-base="Website" data-alt="Website — daily views this month">Website</div>
        <span class="icon-btn" data-slide-hint data-base="Daily views &rarr;" data-alt="&larr; Back">Daily views &rarr;</span>
      </div>
      <ul class="dash-glance" data-slide="1">
        <li><span>Views this month</span><b data-stat="site-views-month">0</b></li>
        <li><span>Visitors this month</span><b data-stat="site-visitors-month">0</b></li>
        <li><span>Views all time</span><b data-stat="site-views-total">0</b></li>
      </ul>
      <div data-slide="2" hidden>
        <div id="dash-website-chart" class="dash-rev-graph"></div>
      </div>
    </button>
  </div>

  <div class="dash-modal-overlay" id="dash-inv-overlay">
    <div class="dash-modal">
      <div class="dash-modal-title-row">
        <div class="dash-modal-title">Invoices — this month</div>
        <button type="button" class="dash-modal-close" id="dash-inv-close" aria-label="Close">&times;</button>
      </div>
      <div id="dash-inv-modal-list"></div>
    </div>
  </div>

  <style is:global>
    /* Chart categorical palette — same hue families as the brand tokens
       (plum/blue/green/amber/red), pushed to a lightness+chroma band that
       actually passes the accessibility check (dataviz skill:
       node scripts/validate_palette.js) — the raw brand hex values are too
       dark/muted to tell apart even with full-color vision. Only 5 slots:
       a 6th brand-derived hue (rose, sitting between red and amber) couldn't
       be separated from its neighbours at any lightness/chroma tried, so a
       6th category folds into "Other" one slot earlier than the general
       8-hue default. */
    .card { --series-1: #97355c; --series-2: #3c60aa; --series-3: #268254; --series-4: #b48b2d; --series-5: #a83c38; --series-other: #898781; }

    .dash-glance { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px 28px; }
    .dash-glance[hidden] { display: none; }
    .dash-glance li { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 11px 0; border-bottom: 1px solid var(--border-subtle); }
    .dash-glance span { font-size: 13px; color: var(--muted); }
    .dash-glance b { font-family: var(--serif); font-size: 22px; color: var(--hub-text); font-weight: 500; }
    @media (max-width: 560px) { .dash-glance { grid-template-columns: 1fr; } }

    .dash-solo-stat { padding: 8px 0; }
    .dash-solo-stat .stat-num { font-size: 44px; }

    .dash-revenue-row { display: flex; align-items: center; justify-content: space-between; }
    .dash-revenue-row span { font-size: 12px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; font-weight: 700; }
    .dash-revenue-row b { font-family: var(--serif); font-size: 24px; color: var(--hub-text); font-weight: 500; }

    .dash-clickable { text-align: left; background: var(--surface); cursor: pointer; font: inherit; width: 100%; display: flex; flex-direction: column; }
    .dash-clickable:hover { border-color: var(--primary); box-shadow: var(--shadow-sm); }

    .dash-rev-top { display: flex; gap: 40px; margin-bottom: 18px; }
    .dash-rev-label { font-size: 11px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .08em; margin-bottom: 6px; }
    .dash-rev-num { font-family: var(--serif); font-size: 34px; color: var(--hub-text); font-weight: 500; }
    .dash-rev-graph { display: flex; align-items: flex-end; gap: 8px; height: 90px; }
    .dash-rev-graph[hidden] { display: none; }
    .dash-rev-bar-wrap { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6px; height: 100%; justify-content: flex-end; }
    .dash-rev-bar { width: 100%; background: var(--primary-light); border-radius: 3px 3px 0 0; min-height: 3px; transition: height 0.3s; }
    .dash-rev-bar.is-current { background: var(--primary); }
    .dash-rev-bar-label { font-size: 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }

    .dash-email-row, .dash-inq-row, .dash-social-row {
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
      padding: 9px 0; border-bottom: 1px solid var(--border-subtle); font-size: 13px;
    }
    .dash-email-row:last-child, .dash-inq-row:last-child, .dash-social-row:last-child { border-bottom: none; }
    .dash-email-name { font-weight: 600; color: var(--hub-text); }
    .dash-inq-row span:first-child, .dash-social-row span:first-child { color: var(--muted); }
    .dash-inq-row b, .dash-social-row b { font-family: var(--serif); font-size: 17px; color: var(--hub-text); font-weight: 500; }

    .dash-inv-row { display: flex; align-items: center; gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--border-subtle); }
    .dash-inv-row:last-child { border-bottom: none; }
    .dash-inv-num { font-size: 12px; font-weight: 700; color: var(--muted); width: 100px; flex-shrink: 0; }
    .dash-inv-name { flex: 1; font-size: 13px; font-weight: 600; color: var(--hub-text); }
    .dash-inv-dates { font-size: 11.5px; color: var(--muted); width: 190px; flex-shrink: 0; }
    .dash-inv-amount { font-size: 13px; font-weight: 700; color: var(--hub-text); width: 80px; text-align: right; flex-shrink: 0; }

    .dash-donut-title { font-size: 10.5px; font-weight: 700; color: var(--muted); text-transform: uppercase; letter-spacing: .1em; margin-bottom: 12px; }
    /* Chart fixed-width left, legend grid fills the rest — stays side-by-side
       even in a half-width dashboard card instead of wrapping to stacked. */
    .dash-donut-wrap-outer { display: flex; align-items: center; gap: 18px; }
    .dash-pkg-donut { width: 88px; height: 88px; flex: none; }
    .dash-pkg-donut circle { transition: stroke-dasharray 0.4s cubic-bezier(.2,.7,.2,1); }
    .dash-pkg-legend {
      list-style: none; margin: 0; padding: 0; flex: 1; min-width: 0;
      display: grid; grid-template-columns: 1fr 1fr; gap: 8px 14px;
    }
    .dash-pkg-legend li { display: flex; align-items: center; gap: 6px; font-size: 12.5px; color: var(--hub-text); min-width: 0; }
    .dash-pkg-legend-dot { width: 9px; height: 9px; border-radius: 50%; flex: none; }
    .dash-pkg-legend-label { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .dash-pkg-legend b { font-weight: 700; color: var(--hub-text); margin-left: 6px; flex: none; }
    @media (max-width: 480px) { .dash-pkg-legend { grid-template-columns: 1fr; } }

    /* Website card's expanded daily-views chart reuses .dash-rev-bar-wrap/
       .dash-rev-bar (defined below) so both bar charts look like one system. */
    #dash-website-chart.dash-rev-graph { height: 120px; gap: 3px; }
    .dash-legend-row { display: flex; gap: 18px; margin-top: 10px; flex-wrap: wrap; }
    .dash-legend-row span { display: flex; align-items: center; gap: 6px; font-size: 12px; color: var(--muted); }
    /* Stacked bars: each segment is a flush-stacked div inside one bar-wrap. */
    .dash-rev-bar-stack { width: 100%; display: flex; flex-direction: column-reverse; border-radius: 3px 3px 0 0; overflow: hidden; min-height: 3px; }
    .dash-rev-bar-seg { width: 100%; }
    .dash-blog-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid var(--border-subtle); font-size: 12.5px; }
    .dash-blog-row:last-child { border-bottom: none; }
    .dash-blog-rank { font-family: var(--serif); font-size: 15px; color: var(--muted); width: 16px; flex: none; }
    .dash-blog-title { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--hub-text); font-weight: 600; }
    .dash-blog-views { font-weight: 700; color: var(--hub-text); flex: none; }
    #dash-website-chart .dash-rev-bar-label { font-size: 8.5px; }

    /* Dashboard-local modal (deliberately not sharing .modal/.overlay with
       videography.astro's own page-scoped modal, to avoid two different admin
       pages fighting over the same class names via the shared hub-tokens.css). */
    .dash-modal-overlay {
      display: none; position: fixed; inset: 0; background: rgba(43, 34, 38, 0.35);
      backdrop-filter: blur(2px); z-index: 500; align-items: center; justify-content: center; padding: 24px;
    }
    .dash-modal-overlay.open { display: flex; }
    .dash-modal {
      background: var(--surface); border-radius: var(--radius); padding: 28px;
      width: 100%; max-width: 720px; max-height: 85vh; overflow-y: auto;
      border: 1px solid var(--border); box-shadow: var(--shadow-lg);
    }
    .dash-modal-title-row { display: flex; align-items: flex-start; justify-content: space-between; gap: 12px; margin-bottom: 20px; }
    .dash-modal-title { font-family: var(--serif); font-size: 22px; font-weight: 400; color: var(--hub-text); }
    .dash-modal-close { background: none; border: none; cursor: pointer; color: var(--muted); font-size: 20px; line-height: 1; padding: 2px 4px; flex-shrink: 0; }
    .dash-modal-close:hover { color: var(--primary); }
  </style>

  <script>
    import { supabase, gbpFromPence } from "../lib/supabase.js";

    function setStat(key, value) { document.querySelectorAll(`[data-stat="${key}"]`).forEach((el) => { el.textContent = value; }); }
    function esc(s) { return String(s ?? "").replace(/[<>&]/g, (c) => ({ "<": "&lt;", ">": "&gt;", "&": "&amp;" }[c])); }
    function fmtDate(d) { if (!d) return "—"; try { return new Date(d).toLocaleDateString("en-GB", { day: "numeric", month: "short" }); } catch (_) { return "—"; } }
    // Fallback hex baked into each var() call — if a custom-property lookup
    // ever came back empty this is why colors would vanish, so don't rely on
    // the property resolving.
    const PALETTE = [
      "var(--series-1, #97355c)", "var(--series-2, #3c60aa)", "var(--series-3, #268254)",
      "var(--series-4, #b48b2d)", "var(--series-5, #a83c38)",
    ];
    const OTHER_COLOR = "var(--series-other, #898781)";

    // Same marketing/system derivation as /admin/automations (src/pages/admin/automations/index.astro) —
    // duplicated rather than imported to keep this page's data layer self-contained.
    function automationKind(a) {
      const meta = a.graph && a.graph.meta;
      if (meta && meta.kind === "marketing") return "marketing";
      const nodes = (a.graph && a.graph.nodes) || [];
      return nodes.some((n) => n.type === "send_email" && n.config && n.config.send_kind === "marketing") ? "marketing" : "system";
    }

    function renderBreakdown(el, rows, emptyText) {
      if (!el) return;
      if (rows.length === 0) { el.innerHTML = `<div class="empty"><div class="empty-text">${emptyText}</div></div>`; return; }
      const total = rows.reduce((s, r) => s + r.count, 0) || 1;
      const bar = rows.map((r, i) => `<div style="width:${(r.count / total) * 100}%;background:${PALETTE[i % PALETTE.length]}"></div>`).join("");
      const legend = rows.map((r, i) => `<span><span class="tb-legend-dot" style="background:${PALETTE[i % PALETTE.length]}"></span>${esc(r.label)} · ${r.count}</span>`).join("");
      el.innerHTML = `<div class="tb-bar">${bar}</div><div class="tb-legend">${legend}</div>`;
    }

    // Part-to-whole, ≤5 categories, at-a-glance only (not for comparing close
    // values — see the dataviz skill's anti-patterns). Past 5 slots (this
    // palette's real limit — see the .card rule above), the tail folds into
    // "Other" rather than generating another hue.
    function renderDonut(el, rows, emptyText) {
      if (!el) return;
      if (rows.length === 0) { el.innerHTML = `<div class="empty"><div class="empty-text">${emptyText}</div></div>`; return; }
      const CAP = PALETTE.length;
      let slices = rows;
      if (rows.length > CAP) {
        const head = rows.slice(0, CAP - 1);
        const otherCount = rows.slice(CAP - 1).reduce((s, r) => s + r.count, 0);
        slices = [...head, { label: "Other", count: otherCount, isOther: true }];
      }
      const total = slices.reduce((s, r) => s + r.count, 0) || 1;
      const R = 40, CIRC = 2 * Math.PI * R, GAP = 3; // px gap between segments
      let offset = 0;
      const arcs = slices.map((r, i) => {
        const color = r.isOther ? OTHER_COLOR : PALETTE[i % PALETTE.length];
        const raw = (r.count / total) * CIRC;
        const len = Math.max(0, raw - GAP);
        const circle = `<circle cx="52" cy="52" r="${R}" fill="none" stroke="${color}" stroke-width="15" stroke-dasharray="${len} ${CIRC - len}" stroke-dashoffset="${-offset}" transform="rotate(-90 52 52)" />`;
        offset += raw;
        return circle;
      }).join("");
      el.innerHTML = `
        <svg class="dash-pkg-donut" viewBox="0 0 104 104" role="img" aria-label="Package mix">${arcs}</svg>
        <ul class="dash-pkg-legend">${slices.map((r, i) => `
          <li>
            <span class="dash-pkg-legend-dot" style="background:${r.isOther ? OTHER_COLOR : PALETTE[i % PALETTE.length]}"></span>
            <span class="dash-pkg-legend-label">${esc(r.label)}</span>
            <b>${r.count}</b>
          </li>
        `).join("")}</ul>
      `;
    }

    // Last n calendar months (oldest first), for any monthly bar chart.
    function monthBuckets(n, refDate) {
      const buckets = [];
      for (let i = n - 1; i >= 0; i--) {
        const d = new Date(refDate.getFullYear(), refDate.getMonth() - i, 1);
        buckets.push({ label: d.toLocaleDateString("en-GB", { month: "short" }), year: d.getFullYear(), month: d.getMonth() });
      }
      return buckets;
    }

    // Single-series month bars — same visual language as the Revenue graph.
    function renderMonthBars(el, buckets, values, emptyText) {
      if (!el) return;
      if (values.every((v) => v === 0)) { el.innerHTML = `<span style="font-size:11px;color:var(--muted)">${emptyText}</span>`; return; }
      const max = Math.max(1, ...values);
      el.innerHTML = buckets.map((b, i) => `
        <div class="dash-rev-bar-wrap">
          <div class="dash-rev-bar${i === buckets.length - 1 ? " is-current" : ""}" style="height:${Math.max(3, (values[i] / max) * 100)}%" title="${b.label}: ${values[i]}"></div>
          <div class="dash-rev-bar-label">${b.label}</div>
        </div>
      `).join("");
    }

    // Multi-series stacked month bars (Edit's gift/sale, CRM's contacts/
    // members/clients) — each series is { values, color }, same order as
    // rendered bottom-to-top so the legend row matches the stack visually.
    function renderStackedMonthBars(el, buckets, series, emptyText) {
      if (!el) return;
      const totals = buckets.map((_, i) => series.reduce((s, ser) => s + ser.values[i], 0));
      if (totals.every((v) => v === 0)) { el.innerHTML = `<span style="font-size:11px;color:var(--muted)">${emptyText}</span>`; return; }
      const max = Math.max(1, ...totals);
      el.innerHTML = buckets.map((b, i) => {
        const segs = series.map((ser) => {
          const v = ser.values[i];
          const pct = totals[i] ? (v / totals[i]) * 100 : 0;
          return `<div class="dash-rev-bar-seg" style="height:${pct}%;background:${ser.color}" title="${b.label}: ${v}"></div>`;
        }).join("");
        const totalPct = Math.max(3, (totals[i] / max) * 100);
        return `
          <div class="dash-rev-bar-wrap">
            <div class="dash-rev-bar-stack" style="height:${totalPct}%">${segs}</div>
            <div class="dash-rev-bar-label">${b.label}</div>
          </div>
        `;
      }).join("");
    }

    // One bar per day-so-far this month — same visual language as the
    // Revenue graph, shown full-size only once the Website card is expanded
    // (a 31-point version of this was illegible at sparkline size).
    function renderDayBars(el, values) {
      if (!el) return;
      if (values.every((v) => v === 0)) { el.innerHTML = `<span style="font-size:11px;color:var(--muted)">No views yet this month.</span>`; return; }
      const max = Math.max(1, ...values);
      const today = values.length;
      el.innerHTML = values.map((v, i) => `
        <div class="dash-rev-bar-wrap">
          <div class="dash-rev-bar${i + 1 === today ? " is-current" : ""}" style="height:${Math.max(3, (v / max) * 100)}%" title="${i + 1}: ${v} view${v === 1 ? "" : "s"}"></div>
          <div class="dash-rev-bar-label">${i + 1}</div>
        </div>
      `).join("");
    }

    const dateEl = document.getElementById("dash-date");
    if (dateEl) dateEl.textContent = new Date().toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" });

    // Invoice modal open/close (populated once the data lands, see below).
    const invOverlay = document.getElementById("dash-inv-overlay");
    document.getElementById("dash-inv-open")?.addEventListener("click", () => invOverlay?.classList.add("open"));
    document.getElementById("dash-inv-close")?.addEventListener("click", () => invOverlay?.classList.remove("open"));
    invOverlay?.addEventListener("click", (e) => { if (e.target === invOverlay) invOverlay.classList.remove("open"); });

    // Click-to-slide cards: [data-slide="1"] (stats) <-> [data-slide="2"]
    // (chart), filling the same card either way. Same trigger both
    // directions — no separate close button, click again to go back.
    function wireSlideCard(cardId) {
      const card = document.getElementById(cardId);
      if (!card) return;
      card.addEventListener("click", () => {
        const s1 = card.querySelector('[data-slide="1"]');
        const s2 = card.querySelector('[data-slide="2"]');
        const title = card.querySelector("[data-slide-title]");
        const hint = card.querySelector("[data-slide-hint]");
        const showingSlide2 = !s2.hidden;
        s1.hidden = !showingSlide2;
        s2.hidden = showingSlide2;
        if (title) title.textContent = showingSlide2 ? title.dataset.base : title.dataset.alt;
        if (hint) hint.textContent = showingSlide2 ? hint.dataset.base : hint.dataset.alt;
      });
    }
    ["dash-website-card", "dash-crm-card", "dash-edit-card", "dash-vid-card", "dash-social-card", "dash-blog-card"].forEach(wireSlideCard);

    document.addEventListener("ash:ready", async (e) => {
      const isManagement = !!(e.detail && e.detail.isManagement);
      if (isManagement) document.querySelectorAll("[data-mgmt]").forEach((el) => { el.hidden = false; });

      const now = new Date();
      const monthStart = new Date(now.getFullYear(), now.getMonth(), 1);
      const monthStartISO = monthStart.toISOString();
      const monthStartDate = monthStartISO.slice(0, 10);
      const yearStart = new Date(now.getFullYear(), 0, 1).toISOString();
      const sixMonthsAgoISO = new Date(now.getFullYear(), now.getMonth() - 5, 1).toISOString();

      const [
        contactsTotal, contactsMembers,
        smmActiveRows, vidClientRows,
        invoicesThisMonth,
        packs, templates, purchasesMonth, purchasesTotal,
        automationsActive,
        vidBookingsThisMonth,
        blogPub,
        enquiriesThisMonth, smmLeadsThisMonth,
        pageviewsMonth, pageviewsTotal, visitorsMonth, pageviewsDaily,
        revenueYTD,
        contactsForGrowth, smmForGrowth,
        ordersForEdit, vidBookingsForChart,
        blogViewsThisMonth, blogPosts,
      ] = await Promise.all([
        supabase.from("contacts").select("*", { count: "exact", head: true }),
        supabase.from("contacts").select("*", { count: "exact", head: true }).eq("lifecycle", "member"),
        supabase.from("smm_leads").select("package_name, contracted_hours_per_month").eq("pipeline_stage", "active_client"),
        supabase.from("videography_bookings").select("client_email, created_at").neq("stage", "cancelled"),
        supabase.from("invoices").select("number, bill_to_name, status, total_pence, issued_date, due_date").gte("issued_date", monthStartDate).order("issued_date", { ascending: false }),
        supabase.from("packs").select("*", { count: "exact", head: true }).eq("status", "active"),
        supabase.from("templates").select("*", { count: "exact", head: true }).eq("status", "active"),
        supabase.from("orders").select("*", { count: "exact", head: true }).eq("status", "paid").gte("created_at", monthStartISO),
        supabase.from("orders").select("*", { count: "exact", head: true }).eq("status", "paid"),
        supabase.from("automations").select("id, name, graph").eq("status", "active"),
        supabase.from("videography_bookings").select("stage, duration_min, client_email").gte("shoot_date", monthStartISO).lt("shoot_date", new Date(now.getFullYear(), now.getMonth() + 1, 1).toISOString()),
        supabase.from("blog_posts").select("*", { count: "exact", head: true }).eq("status", "published"),
        supabase.from("enquiries").select("*", { count: "exact", head: true }).gte("created_at", monthStartISO),
        supabase.from("smm_leads").select("kind").gte("created_at", monthStartISO),
        supabase.from("site_events").select("*", { count: "exact", head: true }).eq("name", "pageview").gte("created_at", monthStartISO),
        supabase.from("site_events").select("*", { count: "exact", head: true }).eq("name", "pageview"),
        supabase.from("site_events").select("session_id").eq("name", "pageview").gte("created_at", monthStartISO),
        supabase.from("site_events").select("created_at").eq("name", "pageview").gte("created_at", monthStartISO),
        supabase.from("orders").select("amount_pence, created_at").eq("status", "paid").gte("created_at", yearStart),
        // Cumulative-growth series (CRM slide 2) needs full history, not just
        // the last 6 months — someone created 2 years ago still counts
        // toward every month's running total in the window.
        supabase.from("contacts").select("created_at, lifecycle"),
        supabase.from("smm_leads").select("created_at").eq("pipeline_stage", "active_client"),
        supabase.from("orders").select("created_at, payment_method").eq("status", "paid").gte("created_at", sixMonthsAgoISO),
        supabase.from("videography_bookings").select("created_at").neq("stage", "cancelled").gte("created_at", sixMonthsAgoISO),
        supabase.from("site_events").select("path").eq("name", "pageview").gte("created_at", monthStartISO).ilike("path", "/blog/%"),
        supabase.from("blog_posts").select("slug, title"),
      ]);

      // ---- CRM ----
      if (!contactsTotal.error) setStat("crm-contacts", String(contactsTotal.count ?? 0));
      if (!contactsMembers.error) setStat("crm-members", String(contactsMembers.count ?? 0));
      const smmClientCount = (!smmActiveRows.error && smmActiveRows.data) ? smmActiveRows.data.length : 0;
      const vidClientCount = (!vidClientRows.error && vidClientRows.data)
        ? new Set(vidClientRows.data.map((r) => (r.client_email || "").toLowerCase()).filter(Boolean)).size
        : 0;
      setStat("crm-clients", String(smmClientCount + vidClientCount));
      setStat("social-clients", String(smmClientCount));
      if (!smmActiveRows.error) {
        const totalHours = (smmActiveRows.data || []).reduce((s, r) => s + (Number(r.contracted_hours_per_month) || 0), 0);
        setStat("social-hours", totalHours ? String(totalHours) : "0");
      }

      // ---- CRM growth by month (cumulative — "growth", not new-per-month) ----
      {
        const buckets = monthBuckets(6, now);
        const cutoffOf = (b) => new Date(b.year, b.month + 1, 1);
        const contactsSeries = buckets.map(() => 0);
        const membersSeries = buckets.map(() => 0);
        const clientsSeries = buckets.map(() => 0);
        if (!contactsForGrowth.error) {
          for (const r of contactsForGrowth.data || []) {
            const d = new Date(r.created_at);
            buckets.forEach((b, i) => {
              if (d < cutoffOf(b)) { contactsSeries[i]++; if (r.lifecycle === "member") membersSeries[i]++; }
            });
          }
        }
        if (!smmForGrowth.error) {
          for (const r of smmForGrowth.data || []) {
            const d = new Date(r.created_at);
            buckets.forEach((b, i) => { if (d < cutoffOf(b)) clientsSeries[i]++; });
          }
        }
        if (!vidClientRows.error) {
          buckets.forEach((b, i) => {
            const cutoff = cutoffOf(b);
            const emails = new Set((vidClientRows.data || [])
              .filter((r) => new Date(r.created_at) < cutoff)
              .map((r) => (r.client_email || "").toLowerCase()).filter(Boolean));
            clientsSeries[i] += emails.size;
          });
        }
        renderStackedMonthBars(document.getElementById("dash-crm-chart"), buckets, [
          { values: contactsSeries, color: "var(--series-1)" },
          { values: membersSeries, color: "var(--series-2)" },
          { values: clientsSeries, color: "var(--series-3)" },
        ], "No data yet.");
      }

      // ---- Social media package breakdown ----
      if (!smmActiveRows.error) {
        const counts = new Map();
        for (const r of smmActiveRows.data || []) {
          const label = r.package_name || "No package set";
          counts.set(label, (counts.get(label) || 0) + 1);
        }
        const rows = [...counts.entries()].map(([label, count]) => ({ label, count })).sort((a, b) => b.count - a.count);
        renderDonut(document.getElementById("dash-social-breakdown"), rows, "No active clients yet.");
      }

      // ---- Invoicing ----
      if (!invoicesThisMonth.error && Array.isArray(invoicesThisMonth.data)) {
        const rows = invoicesThisMonth.data;
        setStat("inv-count", String(rows.length));
        setStat("inv-outstanding", String(rows.filter((r) => r.status === "sent").length));
        const total = rows.reduce((s, r) => s + (r.total_pence || 0), 0);
        setStat("inv-total", gbpFromPence(total) || "£0");

        const modalListEl = document.getElementById("dash-inv-modal-list");
        if (modalListEl) {
          if (rows.length === 0) {
            modalListEl.innerHTML = `<div class="empty"><div class="empty-text">No invoices raised yet this month.</div></div>`;
          } else {
            const badge = { draft: "b-gray", sent: "b-amber", paid: "b-green", void: "b-red" };
            modalListEl.innerHTML = rows.map((r) => `
              <div class="dash-inv-row">
                <span class="dash-inv-num">${esc(r.number || "—")}</span>
                <span class="dash-inv-name">${esc(r.bill_to_name || "—")}</span>
                <span class="dash-inv-dates">Issued ${fmtDate(r.issued_date)} · Due ${fmtDate(r.due_date)}</span>
                <span class="dash-inv-amount">${gbpFromPence(r.total_pence || 0)}</span>
                <span class="badge ${badge[r.status] || "b-gray"}">${esc(r.status)}</span>
              </div>
            `).join("");
          }
        }
      }

      // ---- Edit (packs / templates / purchases) ----
      if (!packs.error) setStat("edit-packs", String(packs.count ?? 0));
      if (!templates.error) setStat("edit-templates", String(templates.count ?? 0));
      if (!purchasesMonth.error) setStat("edit-purchases-month", String(purchasesMonth.count ?? 0));
      if (!purchasesTotal.error) setStat("edit-purchases-total", String(purchasesTotal.count ?? 0));

      // ---- Edit: purchases per month, sale vs gift ----
      {
        const buckets = monthBuckets(6, now);
        const saleSeries = buckets.map(() => 0);
        const giftSeries = buckets.map(() => 0);
        if (!ordersForEdit.error) {
          for (const r of ordersForEdit.data || []) {
            const d = new Date(r.created_at);
            const idx = buckets.findIndex((b) => d.getFullYear() === b.year && d.getMonth() === b.month);
            if (idx === -1) continue;
            if (r.payment_method === "gift") giftSeries[idx]++; else saleSeries[idx]++;
          }
        }
        renderStackedMonthBars(document.getElementById("dash-edit-chart"), buckets, [
          { values: saleSeries, color: "var(--series-1)" },
          { values: giftSeries, color: "var(--series-other)" },
        ], "No purchases yet.");
      }

      // ---- Emails: active marketing automations ----
      if (!automationsActive.error) {
        const marketing = (automationsActive.data || []).filter((a) => automationKind(a) === "marketing");
        const listEl = document.getElementById("dash-email-list");
        if (listEl) {
          if (marketing.length === 0) {
            listEl.innerHTML = `<div class="empty"><div class="empty-text">No active marketing campaigns.</div></div>`;
          } else {
            listEl.innerHTML = marketing.map((a) => `
              <div class="dash-email-row">
                <span class="dash-email-name">${esc(a.name)}</span>
                <a href="/admin/automations/edit?id=${esc(a.id)}" class="icon-btn">Open</a>
              </div>
            `).join("");
          }
        }
      }

      // ---- Videography this month ----
      if (!vidBookingsThisMonth.error) {
        const rows = vidBookingsThisMonth.data || [];
        const active = rows.filter((r) => r.stage !== "delivered" && r.stage !== "cancelled");
        const done = rows.filter((r) => r.stage === "delivered");
        setStat("vid-progress", String(active.length));
        setStat("vid-complete", String(done.length));
        // Clients this month: anyone with a shoot dated anywhere in this month —
        // already happened (1st–today) or still booked in (today–month end).
        const clientsThisMonth = new Set(rows.filter((r) => r.stage !== "cancelled").map((r) => (r.client_email || "").toLowerCase()).filter(Boolean)).size;
        setStat("vid-clients", String(clientsThisMonth));
        const minutes = rows.filter((r) => r.stage !== "cancelled").reduce((s, r) => s + (r.duration_min || 0), 0);
        setStat("vid-hours", (minutes / 60).toFixed(1).replace(/\.0$/, ""));
      }

      // ---- Videography: bookings per month ----
      {
        const buckets = monthBuckets(6, now);
        const values = buckets.map(() => 0);
        if (!vidBookingsForChart.error) {
          for (const r of vidBookingsForChart.data || []) {
            const d = new Date(r.created_at);
            const idx = buckets.findIndex((b) => d.getFullYear() === b.year && d.getMonth() === b.month);
            if (idx !== -1) values[idx]++;
          }
        }
        renderMonthBars(document.getElementById("dash-vid-chart"), buckets, values, "No bookings yet.");
      }

      // ---- Blog ----
      if (!blogPub.error) setStat("blog-pub", String(blogPub.count ?? 0));

      // ---- Blog: top 5 this month by views ----
      if (!blogViewsThisMonth.error && !blogPosts.error) {
        const counts = new Map();
        for (const r of blogViewsThisMonth.data || []) {
          const slug = (r.path || "").replace(/^\/blog\//, "").replace(/\/$/, "");
          if (!slug) continue;
          counts.set(slug, (counts.get(slug) || 0) + 1);
        }
        const titleBySlug = new Map((blogPosts.data || []).map((p) => [p.slug, p.title]));
        const top5 = [...counts.entries()]
          .map(([slug, count]) => ({ title: titleBySlug.get(slug) || slug, count }))
          .sort((a, b) => b.count - a.count)
          .slice(0, 5);
        const top5El = document.getElementById("dash-blog-top5");
        if (top5El) {
          if (top5.length === 0) {
            top5El.innerHTML = `<div class="empty"><div class="empty-text">No views yet this month.</div></div>`;
          } else {
            top5El.innerHTML = top5.map((r, i) => `
              <div class="dash-blog-row">
                <span class="dash-blog-rank">${i + 1}</span>
                <span class="dash-blog-title">${esc(r.title)}</span>
                <span class="dash-blog-views">${r.count}</span>
              </div>
            `).join("");
          }
        }
      }

      // ---- Inquiries breakdown (contact form + SMM leads by kind) ----
      const inqRows = [];
      if (!enquiriesThisMonth.error) inqRows.push({ label: "Messages", count: enquiriesThisMonth.count ?? 0 });
      if (!smmLeadsThisMonth.error) {
        const KIND_LABEL = { brochure: "Downloads", discovery: "Discovery calls", enquiry: "General enquiries" };
        const counts = new Map();
        for (const r of smmLeadsThisMonth.data || []) {
          const label = KIND_LABEL[r.kind] || r.kind || "Other";
          counts.set(label, (counts.get(label) || 0) + 1);
        }
        for (const [label, count] of counts.entries()) inqRows.push({ label, count });
      }
      renderBreakdown(document.getElementById("dash-inq-breakdown"), inqRows.filter((r) => r.count > 0), "No inquiries yet this month.");

      // ---- Website ----
      if (!pageviewsMonth.error) setStat("site-views-month", String(pageviewsMonth.count ?? 0));
      if (!pageviewsTotal.error) setStat("site-views-total", String(pageviewsTotal.count ?? 0));
      if (!visitorsMonth.error && Array.isArray(visitorsMonth.data)) {
        setStat("site-visitors-month", String(new Set(visitorsMonth.data.map((r) => r.session_id).filter(Boolean)).size));
      }
      if (!pageviewsDaily.error && Array.isArray(pageviewsDaily.data)) {
        const daysSoFar = now.getDate();
        const byDay = new Array(daysSoFar).fill(0);
        for (const r of pageviewsDaily.data) {
          const d = new Date(r.created_at).getDate();
          if (d >= 1 && d <= daysSoFar) byDay[d - 1]++;
        }
        renderDayBars(document.getElementById("dash-website-chart"), byDay);
      }

      // ---- Revenue (management only — queried regardless, just not rendered) ----
      if (isManagement && !revenueYTD.error && Array.isArray(revenueYTD.data)) {
        const rows = revenueYTD.data;
        const ytdTotal = rows.reduce((s, r) => s + (r.amount_pence || 0), 0);
        setStat("rev-ytd", gbpFromPence(ytdTotal) || "£0");

        const monthTotals = new Array(now.getMonth() + 1).fill(0);
        for (const r of rows) {
          const m = new Date(r.created_at).getMonth();
          if (m <= now.getMonth()) monthTotals[m] += r.amount_pence || 0;
        }
        setStat("rev-month", gbpFromPence(monthTotals[now.getMonth()]) || "£0");

        const max = Math.max(1, ...monthTotals);
        const MONTH_LABELS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
        const graphEl = document.getElementById("dash-rev-graph");
        if (graphEl) {
          graphEl.innerHTML = monthTotals.map((total, i) => `
            <div class="dash-rev-bar-wrap">
              <div class="dash-rev-bar${i === now.getMonth() ? " is-current" : ""}" style="height:${Math.max(3, (total / max) * 100)}%" title="${MONTH_LABELS[i]}: ${gbpFromPence(total)}"></div>
              <div class="dash-rev-bar-label">${MONTH_LABELS[i]}</div>
            </div>
          `).join("");
        }
      }
    });
  </script>
</AdminShell>
