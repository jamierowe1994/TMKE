---
import AdminShell from "../components/admin/AdminShell.astro";

const ICO = {
  revenue: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>',
  orders: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>',
  subs: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>',
  enquiries: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>',
};
---

<AdminShell active="dashboard" title="Dashboard">
  <header class="adash-head">
    <span class="adash-avatar" id="adash-avatar" aria-hidden="true"></span>
    <div class="adash-head-text">
      <p class="adash-eyebrow">Dashboard</p>
      <h1 class="adash-greeting" id="adash-greeting">Welcome back.</h1>
      <p class="adash-sub">Your studio at a glance.</p>
    </div>
  </header>

  <div class="ash-stats">
    <div class="ash-card ash-stat">
      <div class="ash-stat-top"><div class="ash-stat-label">Revenue</div><span class="ash-stat-ico"><Fragment set:html={ICO.revenue} /></span></div>
      <div class="ash-stat-value" data-stat="rev">£0</div>
      <div class="ash-stat-sub"><strong data-stat="orders-count">0</strong> paid orders</div>
    </div>
    <div class="ash-card ash-stat">
      <div class="ash-stat-top"><div class="ash-stat-label">Bookings</div><span class="ash-stat-ico"><Fragment set:html={ICO.orders} /></span></div>
      <div class="ash-stat-value" data-stat="vid-active">0</div>
      <div class="ash-stat-sub"><strong data-stat="vid-total">0</strong> total in the pipeline</div>
    </div>
    <div class="ash-card ash-stat">
      <div class="ash-stat-top"><div class="ash-stat-label">Subscribers</div><span class="ash-stat-ico"><Fragment set:html={ICO.subs} /></span></div>
      <div class="ash-stat-value" data-stat="subs">0</div>
      <div class="ash-stat-sub">active in the last 60 days</div>
    </div>
    <div class="ash-card ash-stat">
      <div class="ash-stat-top"><div class="ash-stat-label">Enquiries</div><span class="ash-stat-ico"><Fragment set:html={ICO.enquiries} /></span></div>
      <div class="ash-stat-value" data-stat="enq-new">0</div>
      <div class="ash-stat-sub"><strong data-stat="enq-total">0</strong> total received</div>
    </div>
  </div>

  <div class="ash-row">
    <div class="ash-card">
      <div class="ash-card-head"><div class="ash-card-title">At a glance</div></div>
      <div class="ash-card-body">
        <ul class="dash-glance">
          <li><span>Active packs</span><b data-stat="packs">0</b></li>
          <li><span>Active templates</span><b data-stat="templates">0</b></li>
          <li><span>Published articles</span><b data-stat="blog-pub">0</b></li>
          <li><span>Draft articles</span><b data-stat="blog-draft">0</b></li>
          <li><span>Email templates</span><b data-stat="email">0</b></li>
          <li><span>Videography total</span><b data-stat="vid-total-2">0</b></li>
          <li><span>New enquiries</span><b data-stat="enq-new-2">0</b></li>
        </ul>
        <div class="dash-links">
          <a href="/admin/orders">Orders &rarr;</a>
          <a href="/admin/videography">Videography &rarr;</a>
          <a href="/admin/subscribers">Subscribers &rarr;</a>
          <a href="/admin/settings">Your settings &rarr;</a>
        </div>
      </div>
    </div>

    <div class="ash-card">
      <div class="ash-card-head"><div class="ash-card-title">Videography pipeline</div></div>
      <div class="ash-card-body dash-donut-wrap">
        <svg class="dash-donut" viewBox="0 0 42 42" aria-hidden="true">
          <circle class="dash-donut-track" cx="21" cy="21" r="15.915" fill="none" stroke-width="5"></circle>
          <circle class="dash-donut-seg" id="dash-donut-seg" cx="21" cy="21" r="15.915" fill="none" stroke-width="5" stroke-dasharray="0 100" stroke-dashoffset="25" stroke-linecap="round"></circle>
        </svg>
        <div class="dash-donut-legend">
          <div><span class="dot dot--active"></span> In progress <b data-stat="vid-active-3">0</b></div>
          <div><span class="dot dot--done"></span> Complete <b data-stat="vid-done">0</b></div>
        </div>
      </div>
    </div>
  </div>

  <style>
    .adash-head { display: flex; align-items: center; gap: 22px; margin: 0 0 26px; }
    .adash-avatar {
      width: 88px; height: 88px; flex: none; border-radius: 50%;
      background: linear-gradient(140deg, color-mix(in srgb, var(--english-violet) 72%, #fff), var(--english-violet) 68%);
      background-size: cover; background-position: center;
      display: inline-flex; align-items: center; justify-content: center;
      font-family: var(--serif); font-size: 34px; font-weight: 600; color: #fff; text-transform: uppercase;
      box-shadow: 0 12px 28px -12px rgba(55,30,40,0.5), inset 0 0 0 2px rgba(255,255,255,0.5);
    }
    .adash-head-text { min-width: 0; }
    .adash-eyebrow { font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.24em; text-transform: uppercase; color: var(--english-violet); margin: 0 0 6px; }
    .adash-greeting { font-family: var(--serif); font-weight: 500; font-size: clamp(34px, 4.2vw, 54px); line-height: 1.02; letter-spacing: -0.025em; color: var(--ink); margin: 0; }
    .adash-greeting em { font-style: italic; color: var(--english-violet); }
    .adash-sub { font-family: var(--sans); font-size: 14px; color: rgba(28,29,34,0.6); margin: 8px 0 0; }
    @media (max-width: 560px) { .adash-avatar { width: 64px; height: 64px; font-size: 26px; } }
    .dash-glance { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 2px 28px; }
    .dash-glance li { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; padding: 11px 0; border-bottom: 1px solid rgba(28,29,34,0.08); font-family: var(--sans); }
    .dash-glance span { font-size: 14px; color: rgba(28,29,34,0.6); }
    .dash-glance b { font-family: var(--serif); font-size: 22px; color: var(--ink); font-weight: 500; }
    @media (max-width: 560px) { .dash-glance { grid-template-columns: 1fr; } }
    .dash-links { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 18px; }
    .dash-links a { font-family: var(--sans); font-size: 13px; font-weight: 700; letter-spacing: 0.04em; color: var(--english-violet); text-decoration: none; }
    .dash-links a:hover { color: var(--ink); }

    .dash-donut-wrap { display: flex; align-items: center; gap: 22px; }
    .dash-donut { width: 140px; height: 140px; flex: none; transform: rotate(-90deg); }
    .dash-donut-track { stroke: rgba(28,29,34,0.1); }
    .dash-donut-seg { stroke: var(--english-violet); transition: stroke-dasharray 0.8s cubic-bezier(.2,.7,.2,1); }
    .dash-donut-legend { font-family: var(--sans); display: flex; flex-direction: column; gap: 14px; }
    .dash-donut-legend div { display: flex; align-items: center; gap: 10px; font-size: 14px; color: rgba(28,29,34,0.7); }
    .dash-donut-legend b { font-family: var(--serif); font-size: 20px; color: var(--ink); margin-left: 4px; }
    .dash-donut-legend .dot { width: 11px; height: 11px; border-radius: 50%; flex: none; }
    .dot--active { background: var(--english-violet); }
    .dot--done { background: rgba(28,29,34,0.2); }
  </style>

  <script>
    import { supabase, gbpFromPence } from "../lib/supabase.js";

    function setStat(key, value) { document.querySelectorAll(`[data-stat="${key}"]`).forEach((el) => { el.textContent = value; }); }

    document.addEventListener("ash:ready", async (e) => {
      const session = e.detail && e.detail.session;
      const profile = e.detail && e.detail.profile;
      const fullName = (profile && profile.full_name) || (session?.user?.email || "").split("@")[0] || "";
      const first = (fullName.split(" ")[0] || fullName).replace(/[<>&]/g, "");
      const hr = new Date().getHours();
      const tod = hr < 12 ? "Good morning" : hr < 18 ? "Good afternoon" : "Good evening";
      const greet = document.getElementById("adash-greeting");
      if (greet) greet.innerHTML = first ? `${tod}, <em>${first}.</em>` : `${tod}.`;
      const av = document.getElementById("adash-avatar");
      if (av) {
        if (profile && profile.avatar_url) { av.style.backgroundImage = `url('${profile.avatar_url}')`; av.textContent = ""; }
        else { av.textContent = (first[0] || "A").toUpperCase(); }
      }

      const SIXTY = new Date(Date.now() - 60 * 864e5).toISOString();
      const [packs, templates, enqNew, enqTotal, paid, subs, blogPub, blogDraft, vidTotal, vidActive, emailActive] = await Promise.all([
        supabase.from("packs").select("*", { count: "exact", head: true }).eq("status", "active"),
        supabase.from("templates").select("*", { count: "exact", head: true }).eq("status", "active"),
        supabase.from("enquiries").select("*", { count: "exact", head: true }).eq("status", "new"),
        supabase.from("enquiries").select("*", { count: "exact", head: true }),
        supabase.from("orders").select("amount_pence", { count: "exact" }).eq("status", "paid"),
        supabase.from("orders").select("buyer_email").eq("status", "paid").gte("created_at", SIXTY),
        supabase.from("blog_posts").select("*", { count: "exact", head: true }).eq("status", "published"),
        supabase.from("blog_posts").select("*", { count: "exact", head: true }).eq("status", "draft"),
        supabase.from("videography_bookings").select("*", { count: "exact", head: true }),
        supabase.from("videography_bookings").select("*", { count: "exact", head: true }).neq("stage", "complete"),
        supabase.from("email_templates").select("*", { count: "exact", head: true }).eq("status", "active"),
      ]);

      if (!packs.error) setStat("packs", String(packs.count ?? 0));
      if (!templates.error) setStat("templates", String(templates.count ?? 0));
      if (!enqNew.error) { setStat("enq-new", String(enqNew.count ?? 0)); setStat("enq-new-2", String(enqNew.count ?? 0)); }
      if (!enqTotal.error) setStat("enq-total", String(enqTotal.count ?? 0));
      if (!paid.error && Array.isArray(paid.data)) {
        const rev = paid.data.reduce((s, r) => s + (r.amount_pence || 0), 0);
        setStat("rev", gbpFromPence(rev) || "£0");
        setStat("orders-count", String(paid.count ?? paid.data.length));
      }
      if (!subs.error && Array.isArray(subs.data)) setStat("subs", String(new Set(subs.data.map((r) => (r.buyer_email || "").toLowerCase()).filter(Boolean)).size));
      if (!blogPub.error) setStat("blog-pub", String(blogPub.count ?? 0));
      if (!blogDraft.error) setStat("blog-draft", String(blogDraft.count ?? 0));
      if (!emailActive.error) setStat("email", String(emailActive.count ?? 0));

      const total = (!vidTotal.error && vidTotal.count) || 0;
      const active = (!vidActive.error && vidActive.count) || 0;
      const done = Math.max(0, total - active);
      setStat("vid-active", String(active)); setStat("vid-active-3", String(active));
      setStat("vid-total", String(total)); setStat("vid-total-2", String(total));
      setStat("vid-done", String(done));
      const seg = document.getElementById("dash-donut-seg");
      if (seg) { const pct = total ? Math.round((active / total) * 100) : 0; seg.setAttribute("stroke-dasharray", `${pct} ${100 - pct}`); }
    });
  </script>
</AdminShell>
