---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Admin — TMKE"
  description="Internal admin dashboard for managing The Edit catalogue, orders, subscribers, and blog content."
  hideNav
  hideFooter
>
  <div class="admin-hero-pad">
    <PageHero
      chapter="Backstage — Admin"
      title="Admin <em>dashboard.</em>"
      sub="Behind-the-scenes controls for the catalogue, orders, members, and content."
    />
  </div>

  <section class="admin-bar wrap">
    <div class="admin-bar-user">
      Signed in as <strong id="admin-email">…</strong>
    </div>
    <button type="button" id="admin-signout" class="admin-signout">Sign out</button>
  </section>

  <section class="admin-grid wrap">
    <a href="/admin/packs" class="admin-card">
      <div class="admin-card-num">01</div>
      <h3 class="admin-card-title">Catalogue</h3>
      <p>Manage Edit packs — add, edit, archive. Set pricing, preview images, pack contents.</p>
      <div class="admin-card-meta">
        <span><span data-stat="packs">0</span> active packs</span>
        <span class="admin-card-arrow">&rarr;</span>
      </div>
    </a>
    <a href="/admin/orders" class="admin-card">
      <div class="admin-card-num">02</div>
      <h3 class="admin-card-title">Orders</h3>
      <p>Every Edit pack purchase, payment status, and invoice. Mark refunded, search by buyer or pack.</p>
      <div class="admin-card-meta">
        <span><span data-stat="orders">0</span> orders &middot; <span data-stat="orders-rev">£0</span></span>
        <span class="admin-card-arrow">&rarr;</span>
      </div>
    </a>
    <a href="#" class="admin-card is-disabled" aria-disabled="true">
      <div class="admin-card-num">03</div>
      <h3 class="admin-card-title">Members</h3>
      <p>Account list, library access, manual entitlement grants.</p>
      <div class="admin-card-meta"><span>Coming soon</span><span class="admin-card-arrow">&rarr;</span></div>
    </a>
    <a href="/admin/subscribers" class="admin-card">
      <div class="admin-card-num">04</div>
      <h3 class="admin-card-title">Subscribers</h3>
      <p>Active Edit customers — anyone with a paid order in the last 60 days. Total spend and recency.</p>
      <div class="admin-card-meta">
        <span><span data-stat="subs">0</span> active</span>
        <span class="admin-card-arrow">&rarr;</span>
      </div>
    </a>
    <a href="/admin/templates" class="admin-card">
      <div class="admin-card-num">05</div>
      <h3 class="admin-card-title">Design studio</h3>
      <p>Edit the template library that powers the customer-facing studio. Built in-house, fully ours.</p>
      <div class="admin-card-meta">
        <span><span data-stat="templates">0</span> active templates</span>
        <span class="admin-card-arrow">&rarr;</span>
      </div>
    </a>
    <a href="/admin/enquiries" class="admin-card">
      <div class="admin-card-num">06</div>
      <h3 class="admin-card-title">Enquiries</h3>
      <p>Contact form submissions. Reply via email, mark replied or closed, take internal notes.</p>
      <div class="admin-card-meta">
        <span><span data-stat="enquiries-new">0</span> new &middot; <span data-stat="enquiries-total">0</span> total</span>
        <span class="admin-card-arrow">&rarr;</span>
      </div>
    </a>
    <a href="/admin/blog" class="admin-card">
      <div class="admin-card-num">07</div>
      <h3 class="admin-card-title">Insights (Blog)</h3>
      <p>Write, edit, and publish articles. SEO fields, hero images, and live Google preview built in.</p>
      <div class="admin-card-meta">
        <span><span data-stat="blog-published">0</span> published &middot; <span data-stat="blog-drafts">0</span> drafts</span>
        <span class="admin-card-arrow">&rarr;</span>
      </div>
    </a>
    <a href="/?edit=1" class="admin-card admin-card--editor">
      <div class="admin-card-num">08</div>
      <h3 class="admin-card-title">Website Editor</h3>
      <p>Edit the live website visually — wording, type, spacing, colours, backgrounds, images, icons, animations and layout — then Preview &amp; Publish. Opens the editor on the home page.</p>
      <div class="admin-card-meta">
        <span>Launch editor</span>
        <span class="admin-card-arrow">&rarr;</span>
      </div>
    </a>
  </section>

  <style>
    .admin-hero-pad { padding-top: 100px; }
    @media (max-width: 720px) { .admin-hero-pad { padding-top: 56px; } }

    .admin-bar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 16px;
      max-width: 1360px;
      margin: 0 auto;
      padding: 12px 36px 0;
      font-family: var(--sans);
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.65);
    }
    .admin-bar-user strong { color: var(--ink); font-weight: 700; }
    .admin-signout {
      background: transparent;
      border: 1px solid rgba(71, 66, 84, 0.4);
      border-radius: 2px;
      padding: 8px 14px;
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--english-violet);
      cursor: pointer;
      transition: background 0.25s, color 0.25s;
    }
    .admin-signout:hover { background: var(--english-violet); color: var(--paper); }

    .admin-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
      max-width: 1360px;
      margin: 0 auto;
      padding: 24px 36px 200px;
    }
    .admin-card {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 32px 28px 24px;
      background: transparent;
      border: 1px solid rgba(71, 66, 84, 0.4);
      border-radius: 2px;
      color: var(--ink);
      transition: background 0.4s cubic-bezier(.2,.7,.2,1), border-color 0.4s, transform 0.4s cubic-bezier(.2,.7,.2,1);
      min-height: 220px;
      text-decoration: none;
    }
    .admin-card:hover { background: rgba(71, 66, 84, 0.04); transform: translateY(-2px); }
    .admin-card.is-disabled { opacity: 0.45; pointer-events: none; }
    .admin-card-num {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.32em;
      font-weight: 700;
      color: var(--english-violet);
    }
    .admin-card-title {
      font-family: var(--serif);
      font-size: 28px;
      font-weight: 500;
      letter-spacing: -0.01em;
      margin: 6px 0 8px;
      color: var(--ink);
    }
    .admin-card p {
      font-size: 14px;
      line-height: 1.55;
      color: rgba(28, 29, 34, 0.65);
      margin: 0;
      flex: 1;
    }
    .admin-card-meta {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid rgba(71, 66, 84, 0.2);
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 600;
      color: rgba(28, 29, 34, 0.6);
    }
    .admin-card-arrow {
      font-family: var(--serif);
      font-style: italic;
      font-size: 18px;
      color: var(--english-violet);
      letter-spacing: 0;
      text-transform: none;
      transition: transform 0.5s cubic-bezier(.2,.7,.2,1);
    }
    .admin-card:hover .admin-card-arrow { transform: translateX(6px); }

    /* Website Editor — filled so it reads as the headline tool. */
    .admin-card--editor { background: var(--english-violet); border-color: var(--english-violet); }
    .admin-card--editor:hover { background: #5b4b7a; }
    .admin-card--editor .admin-card-title { color: var(--paper); }
    .admin-card--editor .admin-card-num,
    .admin-card--editor .admin-card-arrow { color: var(--paper); }
    .admin-card--editor p { color: rgba(242, 239, 233, 0.82); }
    .admin-card--editor .admin-card-meta { color: rgba(242, 239, 233, 0.82); border-color: rgba(242, 239, 233, 0.25); }

    @media (max-width: 980px) {
      .admin-grid { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    import { requireAdmin, signOut } from '../lib/admin-gate.js';
    import { supabase, gbpFromPence } from '../lib/supabase.js';

    function setStat(key, value) {
      const el = document.querySelector(`[data-stat="${key}"]`);
      if (el) el.textContent = value;
    }

    (async () => {
      const session = await requireAdmin();
      if (!session) return;

      const emailEl = document.getElementById('admin-email');
      if (emailEl) emailEl.textContent = session.user.email ?? 'admin';

      document.getElementById('admin-signout')?.addEventListener('click', () => signOut());

      const SIXTY_DAYS_AGO = new Date(Date.now() - 60 * 24 * 60 * 60 * 1000).toISOString();

      const [packs, templates, enquiriesNew, enquiriesTotal, paidOrders, subOrders, blogPublished, blogDrafts] =
        await Promise.all([
          supabase.from('packs').select('*', { count: 'exact', head: true }).eq('status', 'active'),
          supabase.from('templates').select('*', { count: 'exact', head: true }).eq('status', 'active'),
          supabase.from('enquiries').select('*', { count: 'exact', head: true }).eq('status', 'new'),
          supabase.from('enquiries').select('*', { count: 'exact', head: true }),
          supabase.from('orders').select('amount_pence', { count: 'exact' }).eq('status', 'paid'),
          supabase
            .from('orders')
            .select('buyer_email')
            .eq('status', 'paid')
            .gte('created_at', SIXTY_DAYS_AGO),
          supabase.from('blog_posts').select('*', { count: 'exact', head: true }).eq('status', 'published'),
          supabase.from('blog_posts').select('*', { count: 'exact', head: true }).eq('status', 'draft'),
        ]);

      if (!packs.error && typeof packs.count === 'number') setStat('packs', String(packs.count));
      if (!templates.error && typeof templates.count === 'number') setStat('templates', String(templates.count));

      if (!enquiriesNew.error && typeof enquiriesNew.count === 'number')
        setStat('enquiries-new', String(enquiriesNew.count));
      if (!enquiriesTotal.error && typeof enquiriesTotal.count === 'number')
        setStat('enquiries-total', String(enquiriesTotal.count));

      if (!paidOrders.error && Array.isArray(paidOrders.data)) {
        const rev = paidOrders.data.reduce((s, r) => s + (r.amount_pence || 0), 0);
        setStat('orders', String(paidOrders.count ?? paidOrders.data.length));
        setStat('orders-rev', gbpFromPence(rev));
      }

      if (!subOrders.error && Array.isArray(subOrders.data)) {
        const unique = new Set(
          subOrders.data.map((r) => (r.buyer_email || '').toLowerCase()).filter(Boolean),
        );
        setStat('subs', String(unique.size));
      }

      if (!blogPublished.error && typeof blogPublished.count === 'number')
        setStat('blog-published', String(blogPublished.count));
      if (!blogDrafts.error && typeof blogDrafts.count === 'number')
        setStat('blog-drafts', String(blogDrafts.count));
    })();
  </script>
</BaseLayout>
