---
import BaseLayout from "../layouts/BaseLayout.astro";
import DashSidebar from "../components/account/DashSidebar.astro";
import ContactPanel from "../components/account/ContactPanel.astro";
import ServicesPanel from "../components/account/ServicesPanel.astro";
import GuidesPanel from "../components/account/GuidesPanel.astro";
import BlogPanel from "../components/account/BlogPanel.astro";
import "../styles/workspace.css";
import "../styles/account-sections.css";
---

<BaseLayout
  dashboard
  title="Your TMKE — workspace"
  description="Your purchased packs, designs in progress, and account details — all in one place."
  hideNav
  hideFooter
>
  <!-- /account uses a left sidebar instead of the shared top header.
       The same sidebar is reused on every signed-in workspace page so
       the chrome stays put and the right column behaves like a tab. -->
  <div class="dash-shell">
    <DashSidebar active="workspace" />

    <main class="app-main dash-main">
    <!-- Each dash-view is one "tab" in the right column. Only the
         active one is shown; sidebar links toggle which is visible.
         No page reload, no drawer overlay. -->
    <div class="dash-view is-active entrance" data-view="workspace">
    <!-- ============ Workspace header — three separate glass boxes ============
         Greeting · rotating photo · stats. Each is its own thin frosted card
         floating on the light-purple page, all matched to the photo's height.
         JS hooks (#welcome-h/#welcome-sub, #dash-views, #stat-*, #welcome-art*)
         are unchanged. -->
    <!-- Greeting sits OUTSIDE the boxes, as the page header, so it has room
         to breathe. The boxes drop in below it. -->
    <header class="dash-head" data-d="2">
      <div class="dash-avatar anim-pop" id="dash-avatar" aria-hidden="true"></div>
      <div class="dash-head-text">
        <p class="dash-eyebrow anim-pop">This month</p>
        <h1 class="welcome-h" id="welcome-h">Welcome back, <em>let's get to work.</em></h1>
        <p class="welcome-sub anim-pop" id="welcome-sub">Your designs, packs and account in one place.</p>
      </div>
    </header>

    <section class="dash-top" aria-label="Your workspace at a glance">
      <!-- LEFT half: reach over stats, each ~half the photo's height -->
      <div class="dash-left">
        <div class="dash-card dash-reach anim-left">
          <div class="dash-headline-num" id="dash-views">—</div>
          <p class="dash-headline-label">
            Est. profile reach <span class="dash-headline-sub">· Instagram</span>
            <span class="dash-info" title="An estimate based on the designs you've published this month. Connect Instagram for live figures.">&#9432;</span>
          </p>
        </div>

        <div class="dash-card dash-stats anim-left">
          <div class="dash-stat-grid">
            <div class="dash-stat">
              <span class="dash-stat-label">Active packs</span>
              <span class="dash-stat-val" id="stat-packs">—</span>
            </div>
            <div class="dash-stat">
              <span class="dash-stat-label">In progress</span>
              <span class="dash-stat-val" id="stat-designs">—</span>
            </div>
            <div class="dash-stat">
              <span class="dash-stat-label">Lifetime spend</span>
              <span class="dash-stat-val" id="stat-spend">£0</span>
              <span class="dash-stat-foot" id="stat-spend-foot"></span>
            </div>
          </div>
          <a class="dash-brandchip" href="/profile">
            <span>Brand kit · <strong id="stat-brand">—</strong></span>
            <em>Edit &rarr;</em>
          </a>
        </div>
      </div>

      <!-- RIGHT half: rotating "jump into a new design" photo -->
      <div class="dash-card dash-newdesign welcome-art anim-left" id="welcome-art" data-mode="loading">
        <img id="welcome-art-img" src="/assets/social-media.png" alt="" loading="eager" decoding="async" />
        <div class="welcome-art-overlay" id="welcome-art-overlay" hidden>
          <span class="welcome-art-eyebrow" id="welcome-art-eyebrow"></span>
          <span class="welcome-art-headline" id="welcome-art-headline"></span>
          <a class="welcome-art-pill" id="welcome-art-cta" href="#" hidden>
            <span id="welcome-art-cta-label">Jump into a new design</span>
            <em aria-hidden="true">&rarr;</em>
          </a>
        </div>
        <span class="dash-newdesign-tag" id="dash-newdesign-tag">Jump into a new design <em aria-hidden="true">&rarr;</em></span>
      </div>
    </section>

    <!-- Two-up row: Upcoming list on the left, members-blog feature
         on the right. Each half is a self-contained card. The week
         strip JS still targets #up-grid / #up-label / #up-prev etc.
         so the underlying calendar bootstrap is unchanged. -->
    <section class="dash-pair" aria-label="This week and what to read">
      <article id="upcoming" class="dash-pair-card upcoming-card anim-up" aria-labelledby="upcoming-h">
        <header class="dash-pair-head">
          <span class="dash-pair-eyebrow">This week</span>
          <h3 id="upcoming-h" class="dash-pair-title">What you've got going out</h3>
        </header>

        <nav class="upcoming-nav upcoming-nav--compact" aria-label="Week navigation">
          <div class="upcoming-nav-side">
            <button type="button" class="upcoming-nav-btn" id="up-prev" aria-label="Previous week">&larr;</button>
            <button type="button" class="upcoming-nav-today" id="up-today">This week</button>
          </div>
          <div class="upcoming-nav-label" id="up-label">&mdash;</div>
          <div class="upcoming-nav-side" style="justify-content:flex-end;">
            <button type="button" class="upcoming-nav-btn" id="up-next" aria-label="Next week">&rarr;</button>
          </div>
        </nav>

        <div id="up-grid" class="upcoming-grid"></div>
        <p id="up-state" class="lib-state" hidden></p>
      </article>

      <a class="dash-pair-card dash-blog-feature anim-up" href="/account/blog#instagram-algo-2026" data-view="blog">
        <div class="dash-blog-feature-art" style="background-image:url('/assets/social%20media.jpg')">
          <span class="dash-blog-feature-flag">Members only</span>
        </div>
        <div class="dash-blog-feature-body">
          <span class="dash-pair-eyebrow">Inside The Edit &middot; 6 min read</span>
          <h3 class="dash-pair-title">What just changed in the Instagram ranking signal &mdash; and what to do this week</h3>
          <p class="dash-blog-feature-desc">Instagram quietly bumped the weight of "shares to non-followers" in mid-May. For property accounts that's a bigger deal than it sounds.</p>
          <span class="dash-blog-feature-cta">Read the piece <em>&rarr;</em></span>
        </div>
      </a>
    </section>

    <!-- Library (75%) + consistency streak (25%).
         The section header spans full width above the two-column row so the
         consistency tile lines up with the FIRST pack, not the heading. -->
    <div class="dash-lib-block slide-up" data-d="6">
      <header class="section-head">
        <h2 id="library-h" class="section-h">Your library</h2>
        <p class="section-sub">Packs you've purchased from The Edit. <button type="button" class="inline-link" data-shop>Add another pack &rarr;</button></p>
      </header>

      <div class="dash-lib-row">
      <section id="library" class="library" aria-labelledby="library-h">
        <div id="library-loading" class="lib-state">Loading your library…</div>

        <div id="library-empty" class="lib-empty" hidden>
          <h3>Nothing here yet.</h3>
          <p>You haven't purchased a pack yet. <button type="button" class="lib-link" data-shop>Browse The Edit</button> to find one.</p>
        </div>

        <div id="library-grid" class="library-grid"></div>
      </section>

      <aside class="dash-streak" aria-label="Posting consistency">
        <div class="dash-streak-eyebrow">Consistency</div>
        <div class="dash-streak-num"><span id="streak-count">0</span><small>wk</small></div>
        <p class="dash-streak-label" id="streak-label">weeks posting in a row</p>
        <div class="dash-streak-dots" id="streak-dots" aria-hidden="true"></div>
        <p class="dash-streak-note" id="streak-note">Consistency compounds — keep showing up each week.</p>
      </aside>
      </div><!-- /dash-lib-row -->
    </div><!-- /dash-lib-block -->

    <!-- Drafts (from localStorage) -->
    <section id="drafts" class="drafts slide-up" data-d="7" aria-labelledby="drafts-h" hidden>
      <header class="section-head">
        <h2 id="drafts-h" class="section-h">Designs in progress</h2>
        <p class="section-sub">Drafts saved in this browser. Open one to keep going.</p>
      </header>
      <div id="drafts-grid" class="drafts-grid"></div>
    </section>
    </div><!-- /dash-view[data-view="workspace"] -->

    <!-- Sibling views — Contact / Services / Guides / Blog. Hidden
         until the matching sidebar link is clicked. The same panel
         components also render on the standalone /account/<section>
         pages, so deep links still work. -->
    <div class="dash-view" data-view="services" hidden><ServicesPanel /></div>
    <div class="dash-view" data-view="guides" hidden><GuidesPanel /></div>
    <div class="dash-view" data-view="blog" hidden><BlogPanel /></div>
    <div class="dash-view" data-view="contact" hidden><ContactPanel /></div>

    <!-- Account footer — kept lightweight; signed-in chip + sign-out
         now live in the sidebar; this row is just contact info. -->
    <footer class="app-foot dash-foot">
      <div class="app-foot-block">
        <div class="app-foot-tag">Help</div>
        <a href="/contact">hello@tmke.co.uk</a>
      </div>
      <div class="app-foot-block app-foot-block--right">
        <strong id="footer-email" class="dash-foot-email">&hellip;</strong>
      </div>
    </footer>
    </main>
  </div>

  <!-- Browse packs modal — triggered from the header. Stays inside the
       workspace so customers don't bounce out to the marketing storefront. -->
  <div class="shop-backdrop" id="shop-modal" hidden role="dialog" aria-modal="true" aria-labelledby="shop-h">
    <div class="shop">
      <header class="shop-head">
        <div>
          <p class="shop-eyebrow">Shop — The Edit</p>
          <h2 id="shop-h" class="shop-h">Browse <em>packs.</em></h2>
        </div>
        <button type="button" class="shop-close" id="shop-close" aria-label="Close">&times;</button>
      </header>

      <!-- Pack grid view -->
      <section class="shop-view" data-view="grid">
        <p class="shop-state" id="shop-loading">Loading packs…</p>
        <p class="shop-state" id="shop-empty" hidden>No packs available yet. Check back soon.</p>
        <div class="shop-grid" id="shop-grid"></div>
      </section>

      <!-- Pack detail view (single pack) -->
      <section class="shop-view" data-view="detail" hidden>
        <button type="button" class="shop-back" id="shop-back">&larr; All packs</button>
        <div class="shop-detail" id="shop-detail"></div>
      </section>
    </div>
  </div>

<!-- Left-edge "Calendar" tab. Persistent on workspace pages; click
       to open the month-view drawer below. -->
  <button type="button" class="cal-tab" id="cal-tab-trigger" aria-haspopup="dialog" aria-controls="cal-popup">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2"/>
      <line x1="16" y1="2" x2="16" y2="6"/>
      <line x1="8" y1="2" x2="8" y2="6"/>
      <line x1="3" y1="10" x2="21" y2="10"/>
    </svg>
    <span class="cal-tab-label">Calendar</span>
    <span class="cal-tab-count" id="cal-tab-count" hidden>0</span>
  </button>

  <!-- Month-view pop-out drawer. Slides in from the left when the
       Calendar tab is clicked. Shares chip styling with the upcoming-
       week strip so the two read as one feature. -->
  <div class="cal-popup-backdrop" id="cal-popup" hidden role="dialog" aria-modal="true" aria-labelledby="cal-popup-title">
    <aside class="cal-popup" aria-label="Content calendar">
      <header class="cal-popup-head">
        <h2 class="cal-popup-title" id="cal-popup-title">—</h2>
        <div class="cal-popup-controls">
          <button type="button" class="cal-popup-nav" id="cal-popup-prev" aria-label="Previous month">&larr;</button>
          <button type="button" class="cal-popup-today" id="cal-popup-today">Today</button>
          <button type="button" class="cal-popup-nav" id="cal-popup-next" aria-label="Next month">&rarr;</button>
        </div>
        <a href="/account/schedule" class="cal-popup-expand">Open full &rarr;</a>
        <button type="button" class="cal-popup-close" id="cal-popup-close" aria-label="Close">&times;</button>
      </header>
      <div class="cal-popup-weekhead" aria-hidden="true">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
      </div>
      <div id="cal-popup-grid" class="cal-popup-grid" role="grid" aria-labelledby="cal-popup-title"></div>
      <p id="cal-popup-state" class="cal-popup-state" hidden></p>
    </aside>
  </div>

  <style is:global>
    /* ---------- /account-specific styles ----------
       Shared workspace shell (header, footer, welcome, section heads,
       order rows, etc.) lives in src/styles/workspace.css. Only the
       account-landing-specific bits stay here. */

    /* Dashboard shell / sidebar CSS lives in account-sections.css
       so it's shared with every signed-in workspace page. */

    /* When welcome-art is showing an unowned pack it doubles as a
       "discover this pack" CTA — lift on hover so it reads clickable. */
    #welcome-art-img[data-pack-slug] {
      transition: transform 0.4s cubic-bezier(.2,.7,.2,1);
    }
    #welcome-art-img[data-pack-slug]:hover {
      transform: scale(1.03);
    }

    /* ---------- Welcome-art overlay ----------
       Sits over the bottom of the welcome-art photo and explains what
       the user is looking at. Three modes (set via [data-mode] on the
       wrapper):
         · pack      → "Our newest pack — just launched." + Browse pill
         · fresh     → "Start something new." + Jump-into-Studio pill
         · exported  → no overlay (user's own design speaks for itself)
       Tint colour shifts per mode so the two states feel distinct. */
    .welcome-art {
      /* Already position: relative from workspace.css; this is a no-op
         marker so anyone reading these styles sees it's an overlay
         anchor. */
      isolation: isolate;
    }
    .welcome-art-overlay {
      position: absolute;
      left: 0; right: 0; bottom: 0;
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding: 18px 20px 18px;
      color: var(--paper);
      background: linear-gradient(
        180deg,
        rgba(20, 16, 28, 0) 0%,
        rgba(20, 16, 28, 0.55) 55%,
        rgba(20, 16, 28, 0.86) 100%
      );
      transition: opacity 0.5s cubic-bezier(.2,.7,.2,1),
                  transform 0.5s cubic-bezier(.2,.7,.2,1);
    }
    .welcome-art-overlay > * { pointer-events: auto; }
    /* Starting state is set inline by JS so the fade-in is guaranteed
       to run after the image swap regardless of HMR cascade timing. */
    .welcome-art-eyebrow {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(240, 238, 235, 0.75);
    }
    .welcome-art[data-mode="pack"] .welcome-art-eyebrow {
      color: var(--violet-soft);
    }
    .welcome-art-headline {
      font-family: var(--serif);
      font-style: italic;
      font-weight: 400;
      font-size: clamp(15px, 1.4vw, 19px);
      line-height: 1.25;
      letter-spacing: -0.005em;
      color: var(--paper);
      max-width: 90%;
    }
    .welcome-art-pill {
      align-self: flex-start;
      margin-top: 8px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 9px 16px 9px 18px;
      background: var(--card-glass);
      color: var(--violet-deep);
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      border-radius: 14px;
      box-shadow: 0 8px 22px -10px rgba(0, 0, 0, 0.6);
      transition: transform 0.3s cubic-bezier(.2,.7,.2,1),
                  background 0.25s, color 0.25s, box-shadow 0.25s;
    }
    .welcome-art-pill:hover,
    .welcome-art-pill:focus-visible {
      transform: translateY(-1px);
      background: var(--english-violet, var(--violet-deep));
      color: var(--paper);
      box-shadow: 0 12px 28px -12px rgba(0, 0, 0, 0.7);
    }
    .welcome-art-pill em {
      font-family: var(--serif);
      font-style: italic;
      font-size: 14px;
      letter-spacing: 0;
      text-transform: none;
      line-height: 1;
    }
    @media (max-width: 880px) {
      .welcome-art-overlay { padding: 14px 16px; gap: 4px; }
      .welcome-art-headline { font-size: 14px; }
      .welcome-art-pill { font-size: 10px; padding: 8px 14px; letter-spacing: 0.16em; }
    }

    /* ---------- Dashboard "this week + members blog" pair ---------- */
    .dash-pair {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 18px;
      align-items: stretch;
    }
    @media (max-width: 980px) { .dash-pair { grid-template-columns: 1fr; } }

    .dash-pair-card {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 24px 26px 24px;
      /* Match the frosted-glass top boxes instead of solid white. */
      background: var(--card-glass);
      -webkit-backdrop-filter: blur(22px) saturate(1.3);
      backdrop-filter: blur(22px) saturate(1.3);
      border: 1px solid rgba(255, 255, 255, 0.7);
      border-radius: 18px;
      box-shadow: 0 22px 48px -26px rgba(55, 30, 40, 0.42), 0 5px 14px -6px rgba(55, 30, 40, 0.22);
      min-height: 340px;
      overflow: hidden;
    }
    .dash-pair-head { display: flex; flex-direction: column; gap: 4px; }
    .dash-pair-eyebrow {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--english-violet);
    }
    .dash-pair-title {
      margin: 0;
      font-family: var(--serif);
      font-weight: 500;
      font-size: 22px;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: var(--ink);
    }

    /* Compact upcoming nav inside the half-width card */
    .upcoming-card .upcoming-nav {
      margin: 0 0 4px;
      padding: 10px 14px;
      box-shadow: none;
      background: rgba(55, 30, 40, 0.06);
      border-color: rgba(55, 30, 40, 0.14);
    }
    .upcoming-card .upcoming-nav-label { font-size: 15px; }
    .upcoming-card .upcoming-nav-btn { width: 26px; height: 26px; font-size: 12px; }
    .upcoming-card .upcoming-nav-today { padding: 4px 10px; font-size: 9px; }
    /* Inside the half-width card the week renders as a stacked list
       of days, not a 7-column strip. Day cells flow vertically. */
    .upcoming-card .upcoming-grid {
      grid-template-columns: 1fr;
      gap: 6px;
      max-height: 360px;
      overflow-y: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      /* Breathing room so the top row's hover lift + outline isn't clipped by
         the scroll edge (it was seeping into the "This week" header). */
      padding: 6px 3px;
    }
    .upcoming-card .upcoming-grid::-webkit-scrollbar { width: 0; display: none; }
    .upcoming-card .upcoming-day {
      flex-direction: row;
      align-items: center;
      gap: 14px;
      min-height: 0;
      padding: 10px 14px;
    }
    /* The hovered row lifts above its neighbours rather than under them. */
    .upcoming-card .upcoming-day:hover { z-index: 2; }
    /* "+ Open" sits on the right, vertically centred — never over the date. */
    .upcoming-card .upcoming-day.is-empty:hover::after {
      left: auto; bottom: auto;
      right: 16px; top: 50%;
      transform: translateY(-50%);
    }

    /* Members-blog feature on the right of the pair */
    .dash-blog-feature {
      padding: 0;
      gap: 0;   /* art + plum body sit flush — no beige strip between them */
      text-decoration: none;
      color: var(--ink);
      /* Solid white instead of the frosted-glass tint. */
      background: var(--card-glass);
      transition: transform 0.3s cubic-bezier(.2,.7,.2,1), box-shadow 0.3s;
    }
    .dash-blog-feature:hover {
      transform: translateY(-3px);
      box-shadow:
        0 22px 44px -16px rgba(55, 30, 40, 0.40),
        0 8px 16px -8px rgba(28, 29, 34, 0.18);
    }
    .dash-blog-feature-art {
      position: relative;
      min-height: 200px;
      background-size: cover;
      background-position: center;
      background-color: var(--english-violet);
    }
    .dash-blog-feature-flag {
      position: absolute;
      top: 14px;
      left: 14px;
      padding: 5px 12px;
      /* Raw brand deep-purple, NOT var(--english-violet): inside .dash-shell the
         theme remaps that token to the accent, which would make the pill blend
         into the (accent) feature body. We want the pill a distinct deep purple. */
      background: #371e28;
      color: var(--paper);
      border-radius: 999px;
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }
    .dash-blog-feature-body {
      padding: 22px 26px 26px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1;
    }
    .dash-blog-feature-desc {
      margin: 0;
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.6;
      color: rgba(28, 29, 34, 0.66);
      flex: 1;
    }
    .dash-blog-feature-cta {
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--english-violet);
    }
    .dash-blog-feature-cta em { font-style: normal; display: inline-block; transition: transform 0.25s; }
    .dash-blog-feature:hover .dash-blog-feature-cta em { transform: translateX(4px); }

    /* ---------- Entry animation ----------
       Reads as the page being assembled in front of the user. Sidebar
       cascades in first, then the welcome hero drops in with a soft
       overshoot, then each content section rises up on its own beat.
       Triggered when body gets .is-loaded (set after the session check).
       Disabled for prefers-reduced-motion. */
    @keyframes slideInLeft {
      from { opacity: 0; transform: translateX(-60px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes slideDown {
      0%   { opacity: 0; transform: translateY(-80px) scale(0.97); }
      70%  { opacity: 1; }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(56px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .slide-in-left { opacity: 0; transform: translateX(-60px); }
    .slide-down    { opacity: 0; transform: translateY(-80px) scale(0.97); }
    .slide-up      { opacity: 0; transform: translateY(56px); }

    body.is-loaded .slide-in-left {
      animation: slideInLeft 1.2s cubic-bezier(.16,.78,.28,1) both;
    }
    body.is-loaded .slide-down {
      /* Slight overshoot easing so the hero "lands" rather than slides */
      animation: slideDown 1.5s cubic-bezier(.2,1.05,.35,1) both;
    }
    body.is-loaded .slide-up {
      animation: slideUp 1.3s cubic-bezier(.16,.78,.28,1) both;
    }

    /* Explicit per-element timing per animation type so different parts
       arrive at different rates (rather than a uniform 70ms march).

       Sidebar — cascades 0 -> 1.21s at 110ms per item:
         logo (0.00s) -> Workspace link -> ... -> Contact (1.10s)
         -> Signed-in chip + sign-out (1.21s)
       Welcome drops in mid-cascade (0.45s) so the chrome and the
       headline arrive together.
       Content sections then rise up one at a time after the welcome
       has settled. */
    body.is-loaded .slide-in-left[data-d="0"]  { animation-delay: 0.00s; }
    body.is-loaded .slide-in-left[data-d="1"]  { animation-delay: 0.14s; }
    body.is-loaded .slide-in-left[data-d="2"]  { animation-delay: 0.28s; }
    body.is-loaded .slide-in-left[data-d="3"]  { animation-delay: 0.42s; }
    body.is-loaded .slide-in-left[data-d="4"]  { animation-delay: 0.56s; }
    body.is-loaded .slide-in-left[data-d="5"]  { animation-delay: 0.70s; }
    body.is-loaded .slide-in-left[data-d="6"]  { animation-delay: 0.84s; }
    body.is-loaded .slide-in-left[data-d="7"]  { animation-delay: 0.98s; }
    body.is-loaded .slide-in-left[data-d="8"]  { animation-delay: 1.12s; }
    body.is-loaded .slide-in-left[data-d="9"]  { animation-delay: 1.26s; }
    body.is-loaded .slide-in-left[data-d="10"] { animation-delay: 1.40s; }
    body.is-loaded .slide-in-left[data-d="11"] { animation-delay: 1.54s; }
    body.is-loaded .slide-in-left[data-d="12"] { animation-delay: 1.68s; }

    body.is-loaded .slide-down { animation-delay: 0.55s; }

    body.is-loaded .slide-up[data-d="4"] { animation-delay: 1.70s; }
    body.is-loaded .slide-up[data-d="5"] { animation-delay: 2.10s; }
    body.is-loaded .slide-up[data-d="6"] { animation-delay: 2.50s; }
    body.is-loaded .slide-up[data-d="7"] { animation-delay: 2.90s; }

    @media (prefers-reduced-motion: reduce) {
      .slide-in-left, .slide-down, .slide-up {
        opacity: 1; transform: none; animation: none !important;
      }
    }

    /* ---------- Orchestrated login entrance (driven by playEntrance) ----------
       Elements start hidden ONLY while .dash-view.entrance is armed by JS;
       each gets .is-in on its own beat. Pop = scale-in (greeting eyebrow/sub,
       avatar); left = slide in from behind the sidebar (the boxes); up = rise
       from below (this-week / the-edit). The big greeting flies from centre to
       the corner via JS (FLIP). */
    .anim-pop, .anim-left, .anim-up {
      transition: opacity 0.55s ease, transform 0.85s cubic-bezier(.2,.85,.25,1);
      will-change: transform, opacity;
    }
    .dash-view.entrance .anim-pop:not(.is-in)  { opacity: 0; transform: scale(0.8); }
    .dash-view.entrance .anim-left:not(.is-in) { opacity: 0; transform: translateX(-110px); }
    .dash-view.entrance .anim-up:not(.is-in)   { opacity: 0; transform: translateY(80px); }
    /* The greeting is hidden until the JS FLIP places it in the centre. */
    .dash-view.entrance .welcome-h { opacity: 0; }
    /* Greeting floats above everything while it flies in. */
    .welcome-h.is-hero { z-index: 70; position: relative; }

    @media (prefers-reduced-motion: reduce) {
      .dash-view.entrance .anim-pop,
      .dash-view.entrance .anim-left,
      .dash-view.entrance .anim-up,
      .dash-view.entrance .welcome-h { opacity: 1 !important; transform: none !important; }
    }


    /* (Hub background lives in account-sections.css .dash-shell — shared across
       every workspace tab for consistency.) */

    /* ---------- Workspace header — 50/50: stacked text boxes | big photo ---------- */
    .dash-top {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 16px;
      align-items: stretch;   /* photo matches the left stack's height */
    }
    .dash-left { display: flex; flex-direction: column; gap: 16px; min-width: 0; }
    .dash-reach { min-height: 104px; }
    .dash-stats { min-height: 104px; }
    @media (max-width: 920px) { .dash-top { grid-template-columns: 1fr; } }
    /* Tighten the vertical spacing so "This week / The Edit" sits closer up. */
    .dash-view[data-view="workspace"] { gap: 54px; }

    /* Cards that didn't already have a blur get one too, so the new
       translucent beige reads as frosted glass on the wash (not flat tint). */
    .dash-blog-feature,
    .lib-empty,
    .pack-row,
    .draft-card,
    .shop-card {
      -webkit-backdrop-filter: var(--card-blur);
      backdrop-filter: var(--card-blur);
    }

    /* Thin frosted card floating on the purple page — lighter than before. */
    .dash-card {
      border-radius: 20px;
      background: var(--card-glass);
      -webkit-backdrop-filter: blur(22px) saturate(1.3);
      backdrop-filter: blur(22px) saturate(1.3);
      border: 1px solid rgba(255, 255, 255, 0.7);
      /* Two-stop shadow — a soft cast plus a tighter contact shadow for depth. */
      box-shadow: 0 22px 48px -26px rgba(55, 30, 40, 0.42), 0 5px 14px -6px rgba(55, 30, 40, 0.22);
    }

    /* Greeting header — sits ON the purple page, outside any box, with room
       above the boxes to breathe. */
    .dash-head {
      display: flex; align-items: center; gap: 22px;
      padding: 0 6px 0; margin-bottom: 22px;   /* sit at the top, aligned with the nav */
    }
    .dash-avatar {
      flex: 0 0 auto;
      width: 92px; height: 92px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--serif); font-size: 38px; font-weight: 600; color: #fff;
      background: linear-gradient(140deg, color-mix(in srgb, var(--dash-accent) 72%, #fff), var(--dash-accent) 68%);
      box-shadow: 0 12px 28px -10px rgba(var(--violet-rgb),0.55), inset 0 0 0 2px rgba(255,255,255,0.55);
    }
    .dash-head-text { min-width: 0; }
    /* The header sits on the light dashboard background, so its text is dark. */
    .dash-eyebrow {
      font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.24em;
      text-transform: uppercase; color: var(--english-violet); margin: 0 0 5px;
    }
    .dash-head .welcome-h {
      font-family: var(--serif); font-weight: 500; font-size: clamp(36px, 4.4vw, 58px);
      line-height: 1.02; letter-spacing: -0.025em; color: var(--dash-bg-ink); margin: 0;
    }
    .dash-head .welcome-h em { font-style: italic; color: var(--english-violet); }
    .dash-head .welcome-sub {
      font-family: var(--sans); font-size: 15px; line-height: 1.5;
      color: var(--dash-bg-ink-soft); margin: 8px 0 0;
    }

    /* 1 · This-month reach metric box */
    .dash-reach { padding: 18px 24px; display: flex; flex-direction: column; justify-content: center; gap: 2px; }
    .dash-headline-num {
      font-family: var(--serif); font-weight: 500; font-size: clamp(30px, 3.1vw, 44px);
      line-height: 1; letter-spacing: -0.02em; color: var(--ink);
    }
    .dash-headline-label {
      font-family: var(--sans); font-size: 11.5px; font-weight: 600; color: rgba(28,29,34,0.55);
      margin: 6px 0 0; display: flex; align-items: center; gap: 6px; flex-wrap: wrap;
    }
    .dash-headline-sub { color: rgba(28,29,34,0.4); font-weight: 500; }
    .dash-info { color: rgba(28,29,34,0.35); cursor: help; font-size: 13px; }

    /* 2 · Photo — spans both rows in the right half, so it's the bigger box.
       Explicit height (not min-height) so the image's natural size can't drive
       the grid rows. */
    .dash-newdesign {
      position: relative; overflow: hidden; padding: 0; min-height: 0;
      width: 100%; aspect-ratio: auto !important;   /* beat .welcome-art's 4/5 */
      border: 0;   /* edge-to-edge image — no frame around the photo */
    }
    /* !important so it beats the shared .welcome-art img rule — otherwise the
       image renders in-flow and its natural height blows the box up. */
    .dash-newdesign img {
      position: absolute !important; inset: 0 !important;
      width: 100% !important; height: 100% !important; object-fit: cover; display: block;
      transition: transform 6s cubic-bezier(.2,.7,.2,1), opacity 0.55s ease;
    }
    .dash-newdesign:hover img { transform: scale(1.05); }
    .dash-newdesign-tag {
      position: absolute; left: 14px; bottom: 14px; z-index: 2;
      display: inline-flex; align-items: center; gap: 8px;
      padding: 8px 14px; border-radius: 999px;
      background: var(--card-glass);
      font-family: var(--sans); font-size: 10.5px; font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase;
      color: var(--ink); pointer-events: none; transition: opacity 0.4s;
    }
    .dash-newdesign-tag em { font-style: normal; }
    .dash-newdesign[data-mode="pack"] .dash-newdesign-tag,
    .dash-newdesign[data-mode="design"] .dash-newdesign-tag { opacity: 0; }
    @media (max-width: 920px) { .dash-newdesign { min-height: 220px; } }

    /* 3 · Stats — laid across now the box is wide + short, with a brand chip. */
    .dash-stats { padding: 16px 22px; display: flex; flex-direction: column; justify-content: center; gap: 12px; }
    .dash-stat-grid { display: flex; gap: 18px; }
    .dash-stat { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
    .dash-stat-label {
      font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.08em;
      text-transform: uppercase; color: rgba(28,29,34,0.5); white-space: nowrap;
    }
    .dash-stat-val {
      font-family: var(--serif); font-size: 26px; line-height: 1; letter-spacing: -0.02em; color: var(--ink);
    }
    .dash-stat-foot { font-family: var(--sans); font-size: 10px; color: rgba(28,29,34,0.45); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .dash-brandchip {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
      padding: 9px 15px; border-radius: 999px;
      background: var(--card-glass); border: 1px solid rgba(28,29,34,0.08);
      font-family: var(--sans); font-size: 12.5px; font-weight: 500; color: rgba(28,29,34,0.7); text-decoration: none;
      transition: background 0.25s, box-shadow 0.25s;
    }
    /* Match the rest of the chip — not bold, not bigger. */
    .dash-brandchip strong { color: rgba(28,29,34,0.7); font-weight: 500; font-size: inherit; }
    .dash-brandchip em { font-style: normal; font-weight: 600; color: var(--violet-deep); }
    .dash-brandchip:hover { background: var(--card-glass); box-shadow: 0 4px 12px -6px rgba(55, 30, 40,0.28); }

    /* Direction A — the stat tiles stay clean white cards (matching the rest);
       the plum accent shows only on the figures, used sparingly. Everything else
       (labels, chip) keeps the default dark-on-light treatment. */
    .dash-reach .dash-headline-num,
    .dash-stats .dash-stat-val { color: var(--dash-accent); }

    /* ---------- Library + consistency streak (75 / 25) ---------- */
    /* Header spans full width; the 2-col row sits below it so the streak
       tile lines up with the first pack, not the "Your library" heading. */
    .dash-lib-block { display: flex; flex-direction: column; }
    .dash-lib-row {
      display: grid;
      grid-template-columns: 3fr 1fr;
      gap: 18px;
      align-items: start;   /* streak sizes to its content (≈ the first library card), not the whole library */
    }
    @media (max-width: 900px) { .dash-lib-row { grid-template-columns: 1fr; } }
    .dash-lib-row .library { min-width: 0; }

    .dash-streak {
      display: flex; flex-direction: column; gap: 8px;
      padding: 22px 22px 20px;
      border-radius: 18px;
      background: var(--card-glass);
      -webkit-backdrop-filter: blur(22px) saturate(1.3);
      backdrop-filter: blur(22px) saturate(1.3);
      border: 1px solid rgba(255, 255, 255, 0.7);
      box-shadow: 0 22px 48px -26px rgba(55, 30, 40, 0.42), 0 5px 14px -6px rgba(55, 30, 40, 0.22);
    }
    .dash-streak-eyebrow {
      font-family: var(--sans); font-size: 11px; font-weight: 700; letter-spacing: 0.24em;
      text-transform: uppercase; color: var(--violet-deep);
    }
    .dash-streak-num {
      display: flex; align-items: baseline; gap: 6px;
      font-family: var(--serif); font-weight: 500; font-size: clamp(44px, 4vw, 60px);
      line-height: 1; letter-spacing: -0.02em; color: var(--ink); margin-top: 2px;
    }
    .dash-streak-num small { font-family: var(--sans); font-size: 15px; font-weight: 700; color: rgba(28,29,34,0.4); }
    .dash-streak-label { font-family: var(--sans); font-size: 13px; line-height: 1.4; color: rgba(28,29,34,0.6); margin: 0; }
    .dash-streak-dots { display: flex; flex-wrap: wrap; gap: 5px; margin: 8px 0 0; }
    .dash-streak-dot { width: 15px; height: 15px; border-radius: 5px; background: rgba(55, 30, 40,0.13); transition: background 0.3s; }
    .dash-streak-dot.is-on { background: var(--violet-deep); }
    .dash-streak-dot.is-cur { box-shadow: 0 0 0 2px rgba(55, 30, 40,0.28); }
    .dash-streak-note { font-family: var(--sans); font-size: 12px; line-height: 1.45; color: rgba(28,29,34,0.5); margin: auto 0 0; }

    /* ---------- Library ---------- */
    .lib-empty {
      padding: 40px 36px;
      background: var(--card-glass);
      border: 1px dashed rgba(55, 30, 40, 0.35);
      border-radius: 14px;
      box-shadow:
        0 10px 24px -14px rgba(55, 30, 40, 0.18),
        0 2px 6px -3px rgba(28, 29, 34, 0.08);
    }
    .lib-empty h3 {
      font-family: var(--serif);
      font-size: 28px;
      font-weight: 500;
      margin: 0 0 8px;
    }
    .lib-empty p { color: rgba(28,29,34,0.65); font-size: 15px; line-height: 1.6; margin: 0; }

    .library-grid {
      display: grid;
      grid-template-columns: 1fr;   /* one pack per line — room to breathe */
      gap: 18px;
    }

    .pack-row {
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 22px;
      align-items: stretch;
      padding: 20px;
      background: var(--card-glass);
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 14px;
      box-shadow:
        0 10px 24px -14px rgba(55, 30, 40, 0.22),
        0 2px 6px -3px rgba(28, 29, 34, 0.10);
    }
    .pack-row-cover {
      position: relative;
      aspect-ratio: 4 / 5;
      background-size: cover;
      background-position: center;
      background-color: var(--platinum);
      border-radius: 14px;
    }
    .pack-row-cover-tag {
      position: absolute; top: 10px; left: 10px;
      padding: 4px 10px;
      background: var(--violet-deep);
      color: var(--paper);
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-radius: 999px;
    }
    .pack-row-body { display: flex; flex-direction: column; gap: 6px; }
    .pack-row-meta {
      display: flex; gap: 10px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 600;
      color: rgba(28, 29, 34, 0.5);
    }
    .pack-row-title {
      font-family: var(--serif);
      font-size: 26px;
      letter-spacing: -0.015em;
      margin: 0;
      color: var(--ink);
    }
    .pack-row-desc {
      font-family: var(--sans);
      font-size: 13px;
      color: rgba(28,29,34,0.6);
      line-height: 1.55;
      margin: 4px 0 10px;
      flex: 1;
    }
    .pack-row-actions {
      display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
      margin-top: 8px;
    }
    .lib-btn {
      appearance: none;
      background: var(--violet-deep);
      color: var(--paper);
      border: 0;
      padding: 11px 18px;
      border-radius: 14px;
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex; align-items: center; gap: 8px;
      box-shadow:
        0 8px 18px -8px rgba(55, 30, 40, 0.45),
        0 2px 4px -2px rgba(28, 29, 34, 0.18);
      transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
    }
    .lib-btn:hover {
      transform: translateY(-1px);
      background: var(--ink);
      box-shadow:
        0 14px 28px -10px rgba(55, 30, 40, 0.55),
        0 4px 8px -4px rgba(28, 29, 34, 0.25);
    }
    .lib-btn[disabled] {
      opacity: 0.55;
      cursor: not-allowed;
      background: rgba(28,29,34,0.4);
      box-shadow: none;
      transform: none;
    }
    .lib-btn-ghost {
      background: transparent;
      color: var(--violet-deep);
      border: 1px solid rgba(55, 30, 40, 0.45);
      box-shadow: none;
    }
    .lib-btn-ghost:hover {
      background: rgba(55, 30, 40, 0.06);
      color: var(--violet-deep);
      border-color: var(--violet-deep);
      box-shadow: none;
      transform: translateY(-1px);
    }
    .lib-soon-tag {
      display: inline-flex; align-items: center;
      padding: 4px 10px;
      background: rgba(184, 130, 106, 0.14);
      color: #8a4d33;
      border: 1px solid rgba(184, 130, 106, 0.35);
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-radius: 999px;
    }

    /* ---------- Drafts ---------- */
    .drafts-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    @media (max-width: 880px) { .drafts-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .drafts-grid { grid-template-columns: 1fr; } }
    .draft-card {
      display: flex; flex-direction: column; gap: 8px;
      padding: 18px 20px;
      background: var(--card-glass);
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 14px;
      text-decoration: none;
      color: var(--ink);
      box-shadow:
        0 10px 24px -14px rgba(55, 30, 40, 0.22),
        0 2px 6px -3px rgba(28, 29, 34, 0.10);
      transition: transform 0.3s, box-shadow 0.25s;
    }
    .draft-card-meta {
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--violet-deep);
    }
    .draft-card-title {
      font-family: var(--serif);
      font-size: 22px;
      letter-spacing: -0.015em;
      margin: 4px 0;
    }
    .draft-card-foot {
      font-family: var(--sans);
      font-size: 11px;
      color: rgba(28,29,34,0.5);
      letter-spacing: 0.04em;
    }

    /* ---------- Shop modal — slide-up drawer ----------
       The modal sits anchored to the bottom of the viewport (drawer style,
       like a mobile sheet). On open: backdrop fades in, panel slides up
       from off-screen with an elastic ease, then the pack cards inside
       stagger-pop. On close: cards fade quick, panel slides back down,
       backdrop fades out. Total open ~0.95s, total close ~0.55s.
       JS lifecycle: hidden -> remove [hidden] -> next frame add .is-open
       -> on close remove .is-open -> after transitionend re-add [hidden]. */
    .shop-backdrop {
      position: fixed; inset: 0;
      background: rgba(15, 12, 30, 0);          /* faded to 0.62 once .is-open */
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
      display: flex;
      align-items: flex-end;                    /* drawer anchored to bottom */
      justify-content: center;
      padding: 0;
      z-index: 100;
      overflow: hidden;                         /* the inner .shop handles scroll */
      pointer-events: none;
      transition:
        background 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
        backdrop-filter 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
        -webkit-backdrop-filter 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .shop-backdrop.is-open {
      background: rgba(15, 12, 30, 0.62);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      pointer-events: auto;
    }
    .shop-backdrop[hidden] { display: none; }

    .shop {
      width: 100%;
      max-width: 1280px;
      max-height: 90vh;
      /* Same light-purple iridescent wash as the rest of the hub (the cards
         inside stay white). */
      background:
        radial-gradient(70% 55% at 0% 0%, rgba(126, 103, 101, 0.18), transparent 50%),
        radial-gradient(75% 65% at 100% 0%, rgba(126, 103, 101, 0.26), transparent 55%),
        radial-gradient(85% 75% at 60% 115%, rgba(126, 103, 101, 0.15), transparent 55%),
        linear-gradient(150deg, #eee9f6 0%, #ebeef8 50%, #f4f2f1 100%);
      border: 1px solid rgba(28, 29, 34, 0.1);
      border-bottom: none;                /* drawer sits against viewport edge */
      border-radius: 18px 18px 0 0;       /* drawer-style top corners */
      box-shadow:
        0 -28px 80px -20px rgba(0, 0, 0, 0.5),
        0 -2px 6px -4px rgba(55, 30, 40, 0.25);
      overflow-y: auto;
      /* Scroll stays functional; just hide the visible scrollbar. */
      scrollbar-width: none;              /* Firefox */
      -ms-overflow-style: none;           /* legacy Edge / IE */
      transform: translateY(100%);        /* off-screen until .is-open */
      /* Slow elastic-ish ease — gives the "we spent time on this" feel */
      transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .shop::-webkit-scrollbar { width: 0; height: 0; display: none; } /* Chrome / Safari */
    .shop-backdrop.is-open .shop { transform: translateY(0); }

    /* Subtle drag-handle hint at the top of the drawer */
    .shop::before {
      content: "";
      display: block;
      width: 44px;
      height: 4px;
      margin: 10px auto 4px;
      background: rgba(55, 30, 40, 0.22);
      border-radius: 4px;
    }

    /* Above >=780px the drawer feels nicer if it's not edge-to-edge —
       inset it slightly and round all corners. Still slides up from
       the bottom. */
    @media (min-width: 780px) {
      .shop-backdrop { padding: 0 24px 24px; }
      .shop {
        border-radius: 14px;
        border-bottom: 1px solid rgba(28, 29, 34, 0.1);
        max-height: 88vh;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .shop-backdrop,
      .shop { transition: none; }
    }
    .shop-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 24px 32px;
      border-bottom: 1px solid rgba(28,29,34,0.1);
    }
