    }
    .shop-back:hover { color: var(--ink); transform: translateX(-3px); }
    .shop-detail {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 40px;
      align-items: start;
    }
    @media (max-width: 780px) {
      .shop-detail { grid-template-columns: 1fr; gap: 24px; }
    }
    .shop-detail-cover {
      aspect-ratio: 4 / 5;
      background-size: cover;
      background-position: center;
      background-color: var(--platinum);
      border-radius: 6px;
      box-shadow: 0 20px 50px -20px rgba(46, 31, 84, 0.35);
    }
    .shop-detail-body { display: flex; flex-direction: column; gap: 14px; }
    .shop-detail-cat {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--violet-deep);
    }
    .shop-detail-title {
      font-family: var(--serif);
      font-size: 40px;
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin: 0;
      font-weight: 500;
    }
    .shop-detail-desc {
