---
// /account is retired — the live customer workspace is now /dashboard.
// Every "Workspace" link, post-login redirect and back-link in the app points
// at /account, so this single redirect re-routes them all to the new dashboard.
// The previous workspace UI (sidebar layout) lives in git history if needed.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content="0; url=/dashboard" />
    <link rel="canonical" href="/dashboard" />
    <title>Redirecting to your workspace…</title>
    <script is:inline>location.replace('/dashboard' + (location.search || ''));</script>
  </head>
  <body></body>
</html>
