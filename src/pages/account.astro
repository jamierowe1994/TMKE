      letter-spacing: 0.04em;
    }

    /* ---------- Shop modal — slide-up drawer ----------
       The modal sits anchored to the bottom of the viewport (drawer style,
       like a mobile sheet). On open: backdrop fades in, panel slides up
       from off-screen with an elastic ease, then the pack cards inside
       stagger-pop. On close: cards fade quick, panel slides back down,
       backdrop fades out. Total open ~0.95s, total close ~0.55s.
       JS lifecycle: hidden -> remove [hidden] -> next frame add .is-open
       -> on close remove .is-open -> after transitionend re-add [hidden]. */
    .shop-backdrop {
      position: fixed; inset: 0;
      background: rgba(15, 12, 30, 0);          /* faded to 0.62 once .is-open */
      backdrop-filter: blur(0px);
      -webkit-backdrop-filter: blur(0px);
      display: flex;
      align-items: flex-end;                    /* drawer anchored to bottom */
      justify-content: center;
      padding: 0;
      z-index: 100;
      overflow: hidden;                         /* the inner .shop handles scroll */
      pointer-events: none;
      transition:
        background 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
        backdrop-filter 0.45s cubic-bezier(0.2, 0.7, 0.2, 1),
        -webkit-backdrop-filter 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .shop-backdrop.is-open {
      background: rgba(15, 12, 30, 0.62);
      backdrop-filter: blur(4px);
      -webkit-backdrop-filter: blur(4px);
      pointer-events: auto;
    }
    .shop-backdrop[hidden] { display: none; }

    .shop {
      width: 100%;
      max-width: 1100px;
      max-height: 90vh;
      background: var(--paper);
      border: 1px solid rgba(28, 29, 34, 0.1);
      border-bottom: none;                /* drawer sits against viewport edge */
      border-radius: 18px 18px 0 0;       /* drawer-style top corners */
      box-shadow:
        0 -28px 80px -20px rgba(0, 0, 0, 0.5),
        0 -2px 6px -4px rgba(46, 31, 84, 0.25);
      overflow-y: auto;
      /* Scroll stays functional; just hide the visible scrollbar. */
      scrollbar-width: none;              /* Firefox */
      -ms-overflow-style: none;           /* legacy Edge / IE */
      transform: translateY(100%);        /* off-screen until .is-open */
      /* Slow elastic-ish ease — gives the "we spent time on this" feel */
      transition: transform 0.72s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .shop::-webkit-scrollbar { width: 0; height: 0; display: none; } /* Chrome / Safari */
    .shop-backdrop.is-open .shop { transform: translateY(0); }

    /* Subtle drag-handle hint at the top of the drawer */
    .shop::before {
      content: "";
      display: block;
      width: 44px;
      height: 4px;
      margin: 10px auto 4px;
      background: rgba(46, 31, 84, 0.22);
      border-radius: 4px;
    }

    /* Above >=780px the drawer feels nicer if it's not edge-to-edge —
       inset it slightly and round all corners. Still slides up from
       the bottom. */
    @media (min-width: 780px) {
      .shop-backdrop { padding: 0 24px 24px; }
      .shop {
        border-radius: 14px;
        border-bottom: 1px solid rgba(28, 29, 34, 0.1);
        max-height: 88vh;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .shop-backdrop,
      .shop { transition: none; }
    }
    .shop-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 24px 32px;
      border-bottom: 1px solid rgba(28,29,34,0.1);
    }
    .shop-head h2 {
      font-family: var(--serif);
      font-size: 36px;
      font-weight: 500;
      letter-spacing: -0.015em;
      margin: 6px 0 0;
    }
    .shop-head h2 em { font-style: italic; color: var(--violet-deep); }
    .shop-eyebrow {
      margin: 0;
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--violet-deep);
    }
    .shop-close {
      background: transparent;
      border: 1px solid rgba(46, 31, 84, 0.3);
      border-radius: 999px;
      font-size: 22px;
      width: 38px; height: 38px;
      cursor: pointer;
      color: var(--violet-deep);
      line-height: 1;
      transition: background 0.25s, color 0.25s, border-color 0.25s;
    }
    .shop-close:hover { background: var(--violet-deep); color: var(--paper); border-color: var(--violet-deep); }
    .shop-view { padding: 32px; }
    .shop-state {
      font-family: var(--sans);
      font-size: 14px;
      color: rgba(28,29,34,0.55);
      padding: 24px 0;
      margin: 0;
    }
    .shop-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    @media (max-width: 880px) { .shop-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .shop-grid { grid-template-columns: 1fr; } }
    .shop-card {
      cursor: pointer;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 8px;
      overflow: hidden;
      transition:
        border-color 0.25s,
        transform 0.3s,
        box-shadow 0.3s;
      text-align: left;
      padding: 0;
      font: inherit;
      color: var(--ink);
      /* Initial state for the staggered pop-in. .shop-backdrop.is-open
         + the per-card animation-delay (set inline by renderGrid) drive
         the entrance. Cards start invisible & nudged down + scaled a hair. */
      opacity: 0;
      transform: translateY(22px) scale(0.97);
      box-shadow:
        0 10px 24px -14px rgba(46, 31, 84, 0.22),
        0 2px 6px -3px rgba(28, 29, 34, 0.10);
    }
    .shop-card:hover {
      border-color: rgba(46, 31, 84, 0.35);
      transform: translateY(-3px);
      box-shadow:
        0 18px 38px -14px rgba(46, 31, 84, 0.30),
        0 6px 14px -8px rgba(28, 29, 34, 0.18);
    }
    /* Slow, deliberate pop-in — runs only after the drawer finishes
       sliding up. The drawer's slide is 720ms; cards start at 700ms
       + per-card stagger (70ms each, set inline by renderGrid).
       Keyframes preserve the resting box-shadow so cards don't pop
       a shadow on top of the drawer. */
    @keyframes shopCardPop {
      0%   { opacity: 0; transform: translateY(22px) scale(0.97); }
      60%  { opacity: 1; }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    .shop-backdrop.is-open .shop-card {
      animation: shopCardPop 0.68s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    @media (prefers-reduced-motion: reduce) {
      .shop-backdrop.is-open .shop-card {
        animation: none;
        opacity: 1;
        transform: none;
      }
    }
    .shop-card-cover {
      aspect-ratio: 4 / 5;
      background-size: cover;
      background-position: center;
      background-color: var(--platinum);
    }
    .shop-card-body {
      padding: 16px 18px 18px;
      display: flex; flex-direction: column; gap: 4px;
    }
    .shop-card-cat {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--violet-deep);
    }
    .shop-card-title {
      font-family: var(--serif);
      font-size: 22px;
      letter-spacing: -0.015em;
      margin: 2px 0 4px;
    }
    .shop-card-price {
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--ink);
      margin-top: 2px;
