    }
    .shop-detail-foot {
      display: flex; align-items: center; gap: 18px;
      margin-top: 12px;
      padding-top: 18px;
      border-top: 1px solid rgba(28,29,34,0.1);
    }
    .shop-detail-price {
      font-family: var(--serif);
      font-size: 32px;
      letter-spacing: -0.015em;
    }
    .shop-buy {
      appearance: none;
      background: var(--violet-deep);
      color: var(--paper);
      border: 0;
      padding: 14px 24px;
      border-radius: 4px;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex; align-items: center; gap: 8px;
      box-shadow:
        0 12px 24px -10px rgba(46, 31, 84, 0.55),
        0 4px 8px -4px rgba(28, 29, 34, 0.22);
      transition: transform 0.25s, box-shadow 0.25s, background 0.25s;
    }
    .shop-buy:hover {
      transform: translateY(-2px);
      background: var(--ink);
      box-shadow:
        0 18px 32px -10px rgba(46, 31, 84, 0.65),
        0 6px 12px -6px rgba(28, 29, 34, 0.30);
    }
    .shop-already {
      display: inline-flex; align-items: center;
      padding: 4px 10px;
      background: rgba(121, 201, 168, 0.18);
      border: 1px solid rgba(121, 201, 168, 0.4);
      color: #1f6149;
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      border-radius: 999px;
    }

    @media (max-width: 720px) {
      .pack-row { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    import { supabase, gbpFromPence } from '../lib/supabase.js';
    import * as cal from '../lib/calendar.js';

    const $welcomeH = document.getElementById('welcome-h');
    const $welcomeSub = document.getElementById('welcome-sub');
    const $footerEmail = document.getElementById('footer-email');
    const $sidebarEmail = document.getElementById('sidebar-email');
    const $statPacks = document.getElementById('stat-packs');
    const $statDesigns = document.getElementById('stat-designs');
    const $statSpend = document.getElementById('stat-spend');
    const $statSpendFoot = document.getElementById('stat-spend-foot');
    const $statBrand = document.getElementById('stat-brand');
    const $loading = document.getElementById('library-loading');
    const $empty = document.getElementById('library-empty');
    const $grid = document.getElementById('library-grid');
    const $draftsSection = document.getElementById('drafts');
    const $draftsGrid = document.getElementById('drafts-grid');

    // Shop modal refs
    const $shopModal = document.getElementById('shop-modal');
    const $shopClose = document.getElementById('shop-close');
    const $shopGrid = document.getElementById('shop-grid');
    const $shopLoading = document.getElementById('shop-loading');
    const $shopEmpty = document.getElementById('shop-empty');
    const $shopDetail = document.getElementById('shop-detail');
    const $shopBack = document.getElementById('shop-back');
    const $shopOpen = document.getElementById('open-shop');

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }
    function titleCase(s) {
      return String(s || '').replace(/\b\w/g, (c) => c.toUpperCase());
    }

    async function signOut() {
      await supabase.auth.signOut();
      location.replace('/login');
    }
    document.getElementById('app-signout')?.addEventListener('click', signOut);
    document.getElementById('app-signout-foot')?.addEventListener('click', signOut);

    // ===== Right-side drawer (Contact / Services / Guides / Blog) =====
    // Sidebar links with [data-drawer="<name>"] open the matching panel
    // inside the drawer instead of navigating. Each link's href still
    // points to the standalone /account/<section> page so middle-click
    // / right-click "Open in new tab" still works as expected.
    (function setupDashDrawer() {
      const $backdrop = document.getElementById('dash-drawer');
      const $close    = document.getElementById('dash-drawer-close');
      const $label    = document.getElementById('dash-drawer-label');
      const $expand   = document.getElementById('dash-drawer-expand');
      const $panels   = $backdrop ? $backdrop.querySelectorAll('.dash-drawer-panel') : [];
      if (!$backdrop || !$panels.length) return;

      const LABELS = {
        contact: 'Contact',
        services: 'Managed socials',
        guides: 'Guides',
        blog: 'Members blog',
      };

      let openName = null;

      function openDrawer(name) {
        const panel = $backdrop.querySelector('.dash-drawer-panel[data-panel="' + name + '"]');
        if (!panel) return;
        $panels.forEach(function (p) { p.classList.toggle('is-active', p === panel); });
        if ($label) $label.textContent = LABELS[name] || name;
        if ($expand) $expand.setAttribute('href', '/account/' + name);
        $backdrop.hidden = false;
        // Two frames so the [hidden]-removed state has been painted
        // before the transition class fires (otherwise the slide is
        // lost in browsers that coalesce these into one frame).
        requestAnimationFrame(function () {
          requestAnimationFrame(function () { $backdrop.classList.add('is-open'); });
        });
        openName = name;
        document.documentElement.style.overflow = 'hidden';
      }

      function closeDrawer() {
        if (!openName) return;
        $backdrop.classList.remove('is-open');
        document.documentElement.style.overflow = '';
        setTimeout(function () {
          if (!$backdrop.classList.contains('is-open')) $backdrop.hidden = true;
        }, 600);
        openName = null;
      }

      document.querySelectorAll('[data-drawer]').forEach(function (el) {
        el.addEventListener('click', function (e) {
          // Let modifier-clicks open the standalone page in a new tab.
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.button === 1) return;
          e.preventDefault();
          openDrawer(el.getAttribute('data-drawer'));
        });
      });

      $close && $close.addEventListener('click', closeDrawer);
      $backdrop.addEventListener('click', function (e) {
        if (e.target === $backdrop) closeDrawer();
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && openName) closeDrawer();
      });
    })();

    // Local drafts — anything in localStorage under `tmke.editor.<id>`.
    function readLocalDrafts() {
      const drafts = [];
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (!key || !key.startsWith('tmke.editor.')) continue;
          const id = key.replace('tmke.editor.', '');
          try {
            const v = JSON.parse(localStorage.getItem(key) || 'null');
            if (!v) continue;
            drafts.push({ id, filename: v.filename || id, savedAt: v.savedAt || 0, thumb: v.thumb || null });
          } catch (_) {}
        }
      } catch (_) {}
      drafts.sort((a, b) => b.savedAt - a.savedAt);
      return drafts;
    }

    // Pick a "design" image — what the user has actually been working on.
    // Priority:
    //   1. Posts they've scheduled in /account/schedule (real rendered output)
    //   2. Drafts with thumbnails (work saved but not scheduled yet)
    //   3. null — caller falls back to the lifestyle photo
    function pickDesignUrl(scheduled, drafts) {
      const pool = [];
      (scheduled || []).forEach((s) => {
        const url = s.thumbnail_url || s.asset_url;
        if (url) pool.push(url);
      });
      if (!pool.length) (drafts || []).forEach((d) => { if (d.thumb) pool.push(d.thumb); });
      if (!pool.length) return null;
      return pool[Math.floor(Math.random() * pool.length)];
    }

    // Pick a pack the user does NOT already own. Returns { url, slug, id }
    // so the click handler can deep-link into the browse modal at the
    // matching pack detail view. Returns null if every available pack is
    // already owned (or none are loaded yet).
    function pickUnownedPack(allPacks, ownedIds) {
      const unowned = (allPacks || []).filter((p) => !ownedIds.has(p.id));
      if (!unowned.length) return null;
      const p = unowned[Math.floor(Math.random() * unowned.length)];
      const previews = Array.isArray(p.preview_images) ? p.preview_images.filter(Boolean) : [];
      const url = previews.length ? previews[Math.floor(Math.random() * previews.length)] : p.cover_image_url;
      if (!url) return null;
      return { url, slug: p.slug, id: p.id };
    }

    // Welcome-art rotation. Alternates each load between a "design"
    // image and an "unowned pack" image — tracked via localStorage so a
    // refresh on the same machine swaps to the other type. The pack
    // image is clickable: clicking it opens the Browse packs modal at
    // the matching pack detail view.
    function rotateWelcomeArt({ scheduled, drafts, allPacks, ownedIds }) {
      const $art = document.getElementById('welcome-art-img');
      if (!$art) return;
      let last = null;
      try { last = localStorage.getItem('tmke.welcome.last'); } catch (_) {}

      const designUrl = pickDesignUrl(scheduled, drafts);
      const packPick  = pickUnownedPack(allPacks, ownedIds || new Set());

      // If only one source is available we use it and skip the toggle.
      let mode;
      if (!designUrl && !packPick) return;
      else if (!designUrl) mode = 'pack';
      else if (!packPick)  mode = 'design';
      else                 mode = (last === 'design') ? 'pack' : 'design';

      const url = mode === 'pack' ? packPick.url : designUrl;
      const next = new Image();
      next.onload = () => {
        $art.src = url;
        // Toggle interactive treatment + data-attr so the click handler
        // installed in the bootstrap knows whether to open the shop.
        if (mode === 'pack') {
          $art.dataset.packSlug = packPick.slug;
          $art.dataset.packId   = packPick.id;
          $art.style.cursor     = 'pointer';
          $art.setAttribute('title', 'Browse this pack');
        } else {
          delete $art.dataset.packSlug;
          delete $art.dataset.packId;
          $art.style.cursor   = '';
          $art.removeAttribute('title');
        }
      };
      next.src = url;

      try { localStorage.setItem('tmke.welcome.last', mode); } catch (_) {}
    }

    function renderDrafts(drafts) {
      if (!drafts.length) {
        $draftsSection.hidden = true;
        $statDesigns.textContent = '0';
        return;
      }
      $draftsSection.hidden = false;
      $statDesigns.textContent = String(drafts.length);
      $draftsGrid.innerHTML = drafts.slice(0, 6).map((d) => `
        <a class="draft-card" href="/editor?template=${encodeURIComponent(d.id)}">
          <span class="draft-card-meta">Draft</span>
          <h3 class="draft-card-title">${escapeHtml(d.filename)}</h3>
          <span class="draft-card-foot">${d.savedAt ? 'Saved ' + new Date(d.savedAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Saved locally'}</span>
        </a>
      `).join('');
    }

    function renderBrandStat() {
      try {
        const brand = JSON.parse(localStorage.getItem('tmke.brand') || 'null');
        if (!brand) { $statBrand.textContent = 'Not set'; return; }
        const parts = [];
        const colourCount = (brand.colors || []).filter((c) => c && c.hex).length;
        const fontCount = brand.fonts ? [brand.fonts.heading, brand.fonts.body].filter(Boolean).length : 0;
        const logoCount = (brand.logos || []).length;
        if (colourCount) parts.push(colourCount + ' colour' + (colourCount === 1 ? '' : 's'));
        if (fontCount) parts.push(fontCount + ' font' + (fontCount === 1 ? '' : 's'));
        if (logoCount) parts.push(logoCount + ' logo' + (logoCount === 1 ? '' : 's'));
        $statBrand.textContent = parts.length ? parts.join(' · ') : 'Empty';
        $statBrand.style.fontSize = '20px';
      } catch (_) {
        $statBrand.textContent = 'Not set';
      }
    }

    // ====== Shop modal ======
    let cachedPacks = null;
    let ownedPackIds = new Set();

    function setView(name) {
      document.querySelectorAll('.shop-view').forEach((v) => {
        v.hidden = v.getAttribute('data-view') !== name;
      });
    }

    async function openShop() {
      // 2-step open: drop [hidden] so the modal is in the layout, then on
      // the NEXT frame add .is-open so the CSS transition fires (going
      // from "no transition target" to "with the class" is what kicks
      // the slide-up + backdrop fade off the start line).
      $shopModal.hidden = false;
      document.body.style.overflow = 'hidden';
      setView('grid');
      requestAnimationFrame(() => {
        requestAnimationFrame(() => $shopModal.classList.add('is-open'));
      });
      if (!cachedPacks) {
        $shopLoading.hidden = false;
        const { data, error } = await supabase
          .from('packs')
          .select('id, slug, title, description, price_pence, cover_image_url, contents, category, sort_order')
          .eq('status', 'active')
          .order('sort_order', { ascending: true });
        $shopLoading.hidden = true;
        if (error || !data || !data.length) {
          $shopEmpty.hidden = false;
          return;
        }
        cachedPacks = data;
      }
      renderGrid();
    }

    // Closing: drop .is-open so the slide-down + backdrop fade plays,
    // THEN re-set [hidden] once the transition ends. We listen on the
    // .shop transition (the longest of the two) to know when to hide.
    let closeTimer = null;
    function closeShop() {
      if (!$shopModal.classList.contains('is-open')) {
        $shopModal.hidden = true;
        document.body.style.overflow = '';
        return;
      }
      $shopModal.classList.remove('is-open');
      // Belt-and-braces: transitionend can be flaky if the element is
      // mid-transition; a max-duration timeout guarantees we clean up.
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        $shopModal.hidden = true;
        document.body.style.overflow = '';
      }, 760);
    }

    function renderGrid() {
      // Per-card stagger delay — fires AFTER the drawer finishes sliding
      // up (~720ms). 700ms head start, then 70ms between cards. Capped
      // so a huge catalogue doesn't keep the user waiting forever.
      const BASE_DELAY = 700;   // ms — drawer slide-up duration
      const STEP       = 70;    // ms between cards
      const MAX_STEPS  = 12;    // cap stagger after this many cards
      $shopGrid.innerHTML = cachedPacks.map((p, i) => {
        const cover = p.cover_image_url ? `background-image:url('${escapeHtml(p.cover_image_url)}')` : '';
        const delay = BASE_DELAY + (Math.min(i, MAX_STEPS) * STEP);
        return `
          <button type="button" class="shop-card" data-slug="${escapeHtml(p.slug)}" style="animation-delay:${delay}ms">
            <div class="shop-card-cover" style="${cover}"></div>
            <div class="shop-card-body">
              ${p.category ? `<span class="shop-card-cat">${escapeHtml(p.category)}</span>` : ''}
              <h3 class="shop-card-title">${escapeHtml(p.title)}</h3>
              <span class="shop-card-price">${gbpFromPence(p.price_pence)}${ownedPackIds.has(p.id) ? ' &middot; Owned' : ''}</span>
            </div>
          </button>
        `;
      }).join('');
    }

    function showDetail(slug) {
      const p = cachedPacks.find((x) => x.slug === slug);
      if (!p) return;
      const cover = p.cover_image_url ? `style="background-image:url('${escapeHtml(p.cover_image_url)}')"` : '';
      const owned = ownedPackIds.has(p.id);
      const contentsHtml = (p.contents || []).map((c) => `<li>${escapeHtml(c)}</li>`).join('');
      $shopDetail.innerHTML = `
        <div class="shop-detail-cover" ${cover}></div>
        <div class="shop-detail-body">
          ${p.category ? `<span class="shop-detail-cat">${escapeHtml(p.category)}</span>` : ''}
          <h2 class="shop-detail-title">${escapeHtml(p.title)}</h2>
          <p class="shop-detail-desc">${escapeHtml(p.description || '')}</p>
          ${contentsHtml ? `<ul>${contentsHtml}</ul>` : ''}
          <div class="shop-detail-foot">
            <span class="shop-detail-price">${gbpFromPence(p.price_pence)}</span>
            ${owned
              ? `<span class="shop-already">Already in your library</span>`
              : `<a class="shop-buy" href="/edit?buy=${encodeURIComponent(p.slug)}">Purchase &rarr;</a>`}
          </div>
        </div>
      `;
      setView('detail');
    }

    $shopOpen?.addEventListener('click', openShop);

    // Welcome-art click — when rotateWelcomeArt has stamped a pack slug
    // onto the img we use it as a quick "discover this pack" CTA: open
    // the Browse packs modal and jump to the matching detail view.
    document.getElementById('welcome-art-img')?.addEventListener('click', async (e) => {
      const $img = e.currentTarget;
      const slug = $img.dataset.packSlug;
      if (!slug) return;
      await openShop();
      // openShop loads cachedPacks lazily; wait a tick for the fetch
      // to settle before asking showDetail to find the pack by slug.
      const waitForCache = () => new Promise((r) => {
        let tries = 0;
        (function tick() {
          if (cachedPacks.some((p) => p.slug === slug) || tries > 20) return r();
          tries += 1;
          setTimeout(tick, 50);
        })();
      });
      await waitForCache();
      showDetail(slug);
    });
    $shopClose?.addEventListener('click', closeShop);
    $shopModal?.addEventListener('click', (e) => { if (e.target === $shopModal) closeShop(); });
    $shopBack?.addEventListener('click', () => setView('grid'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$shopModal.hidden) closeShop();
    });
    $shopGrid?.addEventListener('click', (e) => {
      const card = e.target.closest('.shop-card');
      if (!card) return;
      showDetail(card.getAttribute('data-slug'));
    });
    // "Add another pack" / "Browse The Edit" inline links open the same modal.
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (t instanceof HTMLElement && t.hasAttribute('data-shop')) {
        e.preventDefault();
        openShop();
      }
    });

    // ====== Bootstrap ======
    (async () => {
      // Dev-only preview escape hatch — visit /account?demo=1 under
      // `astro dev` to render the dashboard with a stub session (no
      // real Supabase data). import.meta.env.DEV is `false` in any
      // production build so this CANNOT leak into the live site.
      const isDemo = import.meta.env.DEV && location.search.includes('demo=1');
      const { data: { session: realSession } } = await supabase.auth.getSession();
      const session = realSession || (isDemo ? { user: { id: 'demo', email: 'demo@tmke.co.uk', user_metadata: { name: 'Danni' } } } : null);
      if (!session) {
        location.replace('/login?next=' + encodeURIComponent('/account'));
        return;
      }

      const email = session.user.email ?? '';
      const meta = session.user.user_metadata ?? {};
      const firstName = (meta.name || email.split('@')[0]).split(' ')[0].split('.')[0];

      // Time-of-day greeting feels warmer than the generic "Welcome back".
      const hour = new Date().getHours();
      let greeting = 'Welcome back';
      if (hour >= 5 && hour < 12)       greeting = 'Good morning';
      else if (hour >= 12 && hour < 17) greeting = 'Good afternoon';
      else if (hour >= 17 && hour < 22) greeting = 'Good evening';
      else                              greeting = 'Burning the midnight oil';

      $welcomeH.innerHTML = `${greeting}, <em>${escapeHtml(titleCase(firstName))}.</em>`;
      $welcomeSub.textContent = 'Your studio. Your library. Pick something up where you left off.';
      $footerEmail.textContent = email;
      if ($sidebarEmail) $sidebarEmail.textContent = email;

      // Kick off the entrance animation. Adding the class on the next
      // frame ensures the .fade-up elements have laid out before the
      // animation starts (so transforms read smoothly).
      requestAnimationFrame(() => document.body.classList.add('is-loaded'));

      const localDrafts = readLocalDrafts();
      renderDrafts(localDrafts);
      renderBrandStat();

      const { data: orders, error } = await supabase
        .from('orders')
        .select('id, pack_id, pack_slug, pack_title, amount_pence, invoice_number, status, payment_method, created_at, buyer_company')
        .or(`user_id.eq.${session.user.id},buyer_email.eq.${email}`)
        .order('created_at', { ascending: false });

      if (error) {
        $loading.textContent = `Couldn't load your library: ${error.message}`;
        return;
      }

      $loading.hidden = true;

      const uniquePacks = new Set();
      let totalSpend = 0;
      (orders || []).forEach((o) => {
        if (o.status === 'paid') {
          if (o.pack_id) {
            uniquePacks.add(o.pack_id);
            ownedPackIds.add(o.pack_id);
          }
          totalSpend += (o.amount_pence || 0);
        }
      });
      $statPacks.textContent = String(uniquePacks.size);
      $statSpend.textContent = gbpFromPence(totalSpend) || '£0';
      $statSpendFoot.innerHTML = orders && orders.length
        ? `Across ${orders.length} order${orders.length === 1 ? '' : 's'} &middot; <a href="/account/orders">View all</a>`
        : 'No orders yet';

      // Mirror the headline stats into the welcome hero pills. Hide the
      // pill strip entirely if everything is zero (no orders, no drafts) —
      // a row of "0 ... 0 ... £0" pills reads sadder than no pills at all.
      const pillsEl = document.getElementById('welcome-pills');
      const draftCount = parseInt($statDesigns.textContent, 10) || 0;
      const hasAny = uniquePacks.size > 0 || draftCount > 0 || totalSpend > 0;
      if (hasAny && pillsEl) {
        const pp = document.getElementById('pill-packs');
        const pd = document.getElementById('pill-designs');
        const ps = document.getElementById('pill-spend');
        if (pp) pp.textContent = String(uniquePacks.size);
        if (pd) pd.textContent = String(draftCount);
        if (ps) ps.textContent = gbpFromPence(totalSpend) || '£0';
        pillsEl.hidden = false;
      }

      if (!orders || orders.length === 0) {
        $empty.hidden = false;
        return;
      }

      const byPack = new Map();
      orders.forEach((o) => {
        if (!byPack.has(o.pack_id)) byPack.set(o.pack_id, { order: o, count: 1 });
        else byPack.get(o.pack_id).count += 1;
      });

      const packIds = [...byPack.keys()].filter(Boolean);
      const { data: packs } = await supabase
        .from('packs')
        .select('id, cover_image_url, preview_images, description, contents, category')
        .in('id', packIds);
      const packMap = new Map((packs ?? []).map((p) => [p.id, p]));

      // ===== Welcome-art rotation =====
      // Pull two independent data sources in parallel so we can pick
      // the right one (alternating each load) for the hero image.
      //   * scheduled  — calendar_items the user has rendered + booked
      //   * allPacks   — every published pack, so we can offer an
      //                  unowned one to discover
      // Both queries are soft-failed: if either errors we fall back to
      // whatever's available (draft thumbnails / lifestyle photo).
      Promise.all([
        supabase
          .from('calendar_items')
          .select('asset_url, thumbnail_url, scheduled_date')
          .eq('user_id', session.user.id)
          .in('status', ['scheduled', 'reminder_sent', 'done'])
          .order('scheduled_date', { ascending: false })
          .limit(20),
        supabase
          .from('packs')
          .select('id, slug, cover_image_url, preview_images')
          .order('sort_order', { ascending: true }),
      ]).then(([sRes, pRes]) => {
        rotateWelcomeArt({
          scheduled: (sRes && sRes.data) || [],
          drafts: localDrafts,
          allPacks: (pRes && pRes.data) || [],
          ownedIds: ownedPackIds,
        });
      }).catch(() => {
        // Last-ditch fallback — use drafts only.
        rotateWelcomeArt({ scheduled: [], drafts: localDrafts, allPacks: [], ownedIds: ownedPackIds });
      });

      $grid.innerHTML = [...byPack.values()].map(({ order, count }) => {
        const pack = packMap.get(order.pack_id);
        const cover = pack?.cover_image_url
          ? `style="background-image:url('${escapeHtml(pack.cover_image_url)}')"`
          : '';
        const desc = pack?.description ?? '';
        const itemCount = (pack?.contents ?? []).length;
        const tag = itemCount ? `${itemCount} items` : 'Purchased';
        const fmtDate = new Date(order.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        return `
          <article class="pack-row">
            <div class="pack-row-cover" ${cover}>
              <span class="pack-row-cover-tag">${escapeHtml(tag)}</span>
            </div>
            <div class="pack-row-body">
              <div class="pack-row-meta">
                <span>Purchased ${fmtDate}</span>
                ${count > 1 ? `<span>·</span><span>${count} copies</span>` : ''}
              </div>
              <h3 class="pack-row-title">${escapeHtml(order.pack_title)}</h3>
              <p class="pack-row-desc">${escapeHtml(desc)}</p>
              <div class="pack-row-actions">
                <button type="button" class="lib-btn" disabled>Download (.zip)</button>
                <span class="lib-soon-tag">Assets land soon</span>
                <a href="/edit/thanks?order=${encodeURIComponent(order.id)}" class="lib-btn lib-btn-ghost">View receipt</a>
              </div>
            </div>
          </article>
        `;
      }).join('');
    })();

    // ====== Content calendar — upcoming-week strip + month drawer ======
    // Separate IIFE so a calendar failure (missing table, RLS surprise)
    // never blocks the library/orders flow above. Runs after the main
    // bootstrap so the session is already established by then.
    (async function calendarBootstrap() {
      const $upGrid    = document.getElementById('up-grid');
      const $upLabel   = document.getElementById('up-label');
      const $upPrev    = document.getElementById('up-prev');
      const $upNext    = document.getElementById('up-next');
      const $upToday   = document.getElementById('up-today');
      const $upState   = document.getElementById('up-state');

      const $tab       = document.getElementById('cal-tab-trigger');
      const $tabCount  = document.getElementById('cal-tab-count');
      const $sideTrig  = document.getElementById('cal-side-trigger');
      const $sideCount = document.getElementById('cal-side-count');
      const $popup     = document.getElementById('cal-popup');
      const $popupClose= document.getElementById('cal-popup-close');
      const $popupPrev = document.getElementById('cal-popup-prev');
      const $popupNext = document.getElementById('cal-popup-next');
      const $popupToday= document.getElementById('cal-popup-today');
      const $popupTitle= document.getElementById('cal-popup-title');
      const $popupGrid = document.getElementById('cal-popup-grid');
      const $popupState= document.getElementById('cal-popup-state');

      if (!$upGrid || !$tab || !$popup) return;

      // Auth check — reuse the session the main bootstrap already validated.
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) return; // main bootstrap will have already redirected

      // ---------- State ----------
      let weekStart   = cal.defaultUpcomingWeekStart(new Date());
      let popupMonth  = cal.startOfMonth(new Date());
      let items       = [];
      let holidays    = [];
      let loadedRange = null; // { fromYmd, toYmd }

      // ---------- Data ----------
      // Pull a window wide enough to cover the upcoming-week strip AND
      // 2 months of drawer navigation either side. Re-fetches when the
      // user navigates outside this window.
      async function loadWindow() {
        const winStart = cal.addDays(weekStart, -45);
        const winEnd   = cal.addDays(weekStart, 90);
        const fromYmd  = cal.ymd(winStart);
        const toYmd    = cal.ymd(winEnd);

        const { items: ii, holidays: hh, itemsError } = await cal.fetchCalendarWindow(supabase, fromYmd, toYmd);
        items    = ii;
        holidays = hh;
        loadedRange = { fromYmd, toYmd };

        if (itemsError && /relation .* does not exist/i.test(itemsError)) {
          $upState.hidden = false;
          $upState.textContent = "Calendar table not found — run supabase/calendar.sql in the Supabase SQL editor.";
        } else {
          $upState.hidden = true;
        }
      }

      async function ensureLoaded() {
        if (!loadedRange) { await loadWindow(); return; }
        const refYmd = cal.ymd(weekStart);
        const popupYmd = cal.ymd(popupMonth);
        if (refYmd < loadedRange.fromYmd || refYmd > loadedRange.toYmd
            || popupYmd < loadedRange.fromYmd || popupYmd > loadedRange.toYmd) {
          await loadWindow();
        }
      }

      // ---------- Upcoming-week render ----------
      function renderWeek() {
        const itemsByDate    = cal.bucketBy(items,    (i) => i.scheduled_date);
        const holidaysByDate = cal.bucketBy(holidays, (h) => h.date);
        const today = new Date();
        const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());

        $upLabel.textContent = cal.fmtWeekRange(weekStart);

        const cells = [];
        for (let i = 0; i < 7; i++) {
          const d = cal.addDays(weekStart, i);
          const key = cal.ymd(d);
          const isToday   = cal.sameDay(d, todayStart);
          const isWeekend = d.getDay() === 0 || d.getDay() === 6;
          const isPast    = d < todayStart && !isToday;
          const dayItems  = itemsByDate.get(key) || [];
          const dayHols   = holidaysByDate.get(key) || [];
          const isEmpty   = dayItems.length === 0 && dayHols.length === 0;

          // Show up to 1 holiday + up to 2 posts, then "+N more". A day
          // with both a bank holiday and 3 scheduled posts shows the
          // holiday + 2 posts + "+1 more".
          const visibleHols  = dayHols.slice(0, 1);
          const visiblePosts = dayItems.slice(0, 2);
          const hiddenCount  = (dayHols.length - visibleHols.length) + (dayItems.length - visiblePosts.length);

          const cls = [
            'upcoming-day',
            isToday   ? 'is-today'   : '',
            isWeekend ? 'is-weekend' : '',
            isPast    ? 'is-past'    : '',
            isEmpty   ? 'is-empty'   : '',
          ].filter(Boolean).join(' ');

          const dowLabel = d.toLocaleDateString('en-GB', { weekday: 'short' });
          const holsHtml = visibleHols.map((h) =>
            `<span class="upcoming-chip upcoming-chip--${h.kind === 'bank' ? 'bank' : 'aware'}" title="${cal.escapeHtml(h.name)}">${cal.escapeHtml(h.name)}</span>`
          ).join('');
          const postsHtml = visiblePosts.map((p) => {
            const sClass = p.status === 'done' ? 'is-done'
              : p.status === 'reminder_sent' ? 'is-sent'
              : p.status === 'cancelled' ? 'is-cancelled' : '';
            return `<span class="upcoming-chip upcoming-chip--post ${sClass}" title="${cal.escapeHtml(p.title)} · ${cal.escapeHtml(cal.fmtTime(p.scheduled_time))}">${cal.escapeHtml(p.title)}</span>`;
          }).join('');
          const moreHtml = hiddenCount > 0 ? `<span class="upcoming-day-more">+${hiddenCount} more</span>` : '';

          cells.push(`
            <button type="button" class="${cls}" data-date="${key}" aria-label="${cal.escapeHtml(cal.fmtFullDate(d))}">
              <div class="upcoming-day-head">
                <span class="upcoming-day-dow">${cal.escapeHtml(dowLabel)}</span>
                <span class="upcoming-day-num">${d.getDate()}</span>
              </div>
              ${holsHtml}
              ${postsHtml}
              ${moreHtml}
            </button>
          `);
        }
        $upGrid.innerHTML = cells.join('');

        // Refresh the tab badge with the count of upcoming posts in the
        // current week (excludes done/cancelled/past — the count means
        // "things waiting on you").
        updateTabCount();
      }

      function updateTabCount() {
        const today = new Date();
        const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());
        const weekEnd = cal.addDays(weekStart, 7);
        const weekStartYmd = cal.ymd(weekStart);
        const weekEndYmd = cal.ymd(weekEnd);
        const upcoming = items.filter((p) => {
          if (p.status !== 'scheduled' && p.status !== 'reminder_sent') return false;
          if (p.scheduled_date < weekStartYmd || p.scheduled_date >= weekEndYmd) return false;
          // also exclude past-time today
          const pTs = new Date(`${p.scheduled_date}T${p.scheduled_time || '09:00'}`);
          return pTs >= todayStart;
        });
        if (upcoming.length === 0) {
          $tabCount.hidden = true;
          if ($sideCount) $sideCount.hidden = true;
        } else {
          $tabCount.hidden = false;
          $tabCount.textContent = String(upcoming.length);
          if ($sideCount) {
            $sideCount.hidden = false;
            $sideCount.textContent = String(upcoming.length);
          }
        }
      }

      // ---------- Month-drawer render ----------
      function renderDrawer() {
        $popupTitle.textContent = cal.fmtMonthYear(popupMonth);

        const first = cal.startOfMonth(popupMonth);
        const dow = (first.getDay() + 6) % 7;
        const start = new Date(first);
        start.setDate(first.getDate() - dow);

        const itemsByDate    = cal.bucketBy(items,    (i) => i.scheduled_date);
        const holidaysByDate = cal.bucketBy(holidays, (h) => h.date);

        const today = new Date();
        const todayStart = new Date(today.getFullYear(), today.getMonth(), today.getDate());

        const cells = [];
        for (let i = 0; i < 42; i++) {
          const d = new Date(start);
          d.setDate(start.getDate() + i);
          const key       = cal.ymd(d);
          const isOther   = d.getMonth() !== popupMonth.getMonth();
          const isToday   = cal.sameDay(d, todayStart);
          const dayItems  = itemsByDate.get(key) || [];
          const dayHols   = holidaysByDate.get(key) || [];

          const visibleHols  = dayHols.slice(0, 1);
          const visiblePosts = dayItems.slice(0, 2 - visibleHols.length);
          const hiddenCount  = (dayHols.length - visibleHols.length) + (dayItems.length - visiblePosts.length);

          const cls = [
            'cal-popup-day',
            isOther ? 'is-other-month' : '',
            isToday ? 'is-today' : '',
          ].filter(Boolean).join(' ');

          const holsHtml = visibleHols.map((h) =>
            `<span class="cal-popup-chip cal-popup-chip--${h.kind === 'bank' ? 'bank' : 'aware'}" title="${cal.escapeHtml(h.name)}">${cal.escapeHtml(h.name)}</span>`
          ).join('');
          const postsHtml = visiblePosts.map((p) => {
            const sClass = p.status === 'done' ? 'is-done'
              : p.status === 'reminder_sent' ? 'is-sent'
              : p.status === 'cancelled' ? 'is-cancelled' : '';
            return `<span class="cal-popup-chip cal-popup-chip--post ${sClass}" title="${cal.escapeHtml(p.title)}">${cal.escapeHtml(p.title)}</span>`;
          }).join('');
          const moreHtml = hiddenCount > 0 ? `<span class="cal-popup-day-more">+${hiddenCount}</span>` : '';

          cells.push(`
            <button type="button" class="${cls}" data-date="${key}" role="gridcell">
              <span class="cal-popup-day-num">${d.getDate()}</span>
              ${holsHtml}
              ${postsHtml}
              ${moreHtml}
            </button>
          `);
        }
        $popupGrid.innerHTML = cells.join('');
      }

      // ---------- Drawer open/close ----------
      let popupCloseTimer = null;
      function openPopup() {
        renderDrawer();
        $popup.hidden = false;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => {
          requestAnimationFrame(() => $popup.classList.add('is-open'));
        });
      }
      function closePopup() {
        if (!$popup.classList.contains('is-open')) {
          $popup.hidden = true;
          document.body.style.overflow = '';
          return;
        }
        $popup.classList.remove('is-open');
        clearTimeout(popupCloseTimer);
        popupCloseTimer = setTimeout(() => {
          $popup.hidden = true;
          document.body.style.overflow = '';
        }, 580);
      }

      // ---------- Event wiring ----------
      $upPrev?.addEventListener('click', async () => {
        weekStart = cal.addDays(weekStart, -7);
        await ensureLoaded();
        renderWeek();
      });
      $upNext?.addEventListener('click', async () => {
        weekStart = cal.addDays(weekStart, 7);
        await ensureLoaded();
        renderWeek();
      });
      $upToday?.addEventListener('click', async () => {
        weekStart = cal.defaultUpcomingWeekStart(new Date());
        await ensureLoaded();
        renderWeek();
      });
      // Clicking a day on the week strip opens the drawer at that day's
      // month — gives users a "see more" path without leaving /account.
      $upGrid?.addEventListener('click', (e) => {
        const cell = e.target.closest('.upcoming-day');
        if (!cell) return;
        const dateStr = cell.getAttribute('data-date');
        if (dateStr) {
          popupMonth = cal.startOfMonth(new Date(dateStr + 'T00:00:00'));
        }
        openPopup();
      });

      $tab?.addEventListener('click', openPopup);
      $sideTrig?.addEventListener('click', openPopup);
      $popupClose?.addEventListener('click', closePopup);
      $popup?.addEventListener('click', (e) => { if (e.target === $popup) closePopup(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !$popup.hidden) closePopup();
      });
      $popupPrev?.addEventListener('click', async () => {
        popupMonth = cal.addMonths(popupMonth, -1);
        await ensureLoaded();
        renderDrawer();
      });
      $popupNext?.addEventListener('click', async () => {
        popupMonth = cal.addMonths(popupMonth, 1);
        await ensureLoaded();
        renderDrawer();
      });
      $popupToday?.addEventListener('click', async () => {
        popupMonth = cal.startOfMonth(new Date());
        await ensureLoaded();
        renderDrawer();
      });
      // Clicking a day in the drawer deep-links to the full calendar
      // page focused on that day, where the existing day-detail drawer
      // can take over (edit/reschedule/cancel).
      $popupGrid?.addEventListener('click', (e) => {
        const cell = e.target.closest('.cal-popup-day');
        if (!cell) return;
        const dateStr = cell.getAttribute('data-date');
        if (dateStr) location.href = '/account/schedule?focus=' + encodeURIComponent(dateStr);
      });

      // Bootstrap
      try {
        await loadWindow();
        renderWeek();
      } catch (err) {
        console.warn('[calendar bootstrap]', err);
        $upState.hidden = false;
        $upState.textContent = "Couldn't load your calendar — refresh in a moment.";
      }
    })();
  </script>
</BaseLayout>
