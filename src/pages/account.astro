    .stat--brand .stat-label { color: rgba(240, 238, 235, 0.62); }
    .stat--brand .stat-value { color: var(--paper); }
    .stat--brand .stat-foot { color: rgba(240, 238, 235, 0.7); }
    .stat--brand .stat-foot a { color: var(--violet-soft); }
