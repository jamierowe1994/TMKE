---
import BaseLayout from "../layouts/BaseLayout.astro";
import "../styles/workspace.css";
---

<BaseLayout
  title="Your TMKE — workspace"
  description="Your purchased packs, designs in progress, and account details — all in one place."
  hideNav
  hideFooter
>
  <!-- Logged-in header. Replaces the global nav once a user has signed in
       so /account feels like an app surface, not a marketing page. -->
  <header class="app-header">
    <a href="/account" class="app-logo">TMKE</a>
    <nav class="app-header-nav" aria-label="Workspace">
      <a href="/account" class="app-header-link is-active">Workspace</a>
      <a href="/editor" class="app-header-link">Studio</a>
      <button type="button" class="app-header-link app-header-btn" id="open-shop" aria-haspopup="dialog">Browse packs</button>
      <a href="/account/orders" class="app-header-link">Orders</a>
      <div class="app-header-dd">
        <button type="button" class="app-header-link app-header-btn" aria-haspopup="menu" aria-expanded="false">
          Resources <span aria-hidden="true">▾</span>
        </button>
        <div class="app-dd-menu" role="menu">
          <a href="/services" role="menuitem">
            <strong>Managed Socials</strong>
            <span>Hand the channel over.</span>
          </a>
          <a href="/blog" role="menuitem">
            <strong>The Blog</strong>
            <span>Insights for property marketers.</span>
          </a>
          <a href="/contact" role="menuitem">
            <strong>Contact the team</strong>
            <span>Get a same-day reply.</span>
          </a>
        </div>
      </div>
      <a href="/profile" class="app-header-link">Brand kit</a>
    </nav>
    <button type="button" id="app-signout" class="app-signout">Sign out</button>
  </header>

  <main class="app-main">
    <!-- Welcome hero — 2-column with decorative photo on the right.
         The greeting line below is set client-side based on the
         current hour (Good morning / afternoon / evening). -->
    <section class="welcome welcome--hero fade-up" data-delay="1">
      <div class="welcome-content">
        <p class="welcome-eyebrow">Workspace</p>
        <h1 class="welcome-h" id="welcome-h">Welcome back, <em>let's get to work.</em></h1>
        <p class="welcome-sub" id="welcome-sub">Your designs, packs and account in one place.</p>
        <div class="welcome-pills" id="welcome-pills" hidden>
          <span class="welcome-pill"><strong id="pill-packs">0</strong> active packs</span>
          <span class="welcome-pill"><strong id="pill-designs">0</strong> designs in progress</span>
          <span class="welcome-pill"><strong id="pill-spend">£0</strong> lifetime spend</span>
        </div>
      </div>
      <div class="welcome-art" aria-hidden="true">
        <img src="/assets/social-media.png" alt="" loading="eager" decoding="async" />
      </div>
    </section>

    <!-- Stats row -->
    <section class="stats fade-up" data-delay="2" aria-label="Your TMKE at a glance">
      <article class="stat stat--violet">
        <div class="stat-label">Active packs</div>
        <div class="stat-value" id="stat-packs">—</div>
        <div class="stat-foot">From The Edit</div>
      </article>
      <article class="stat stat--coral">
        <div class="stat-label">Designs in progress</div>
        <div class="stat-value" id="stat-designs">—</div>
        <div class="stat-foot">Saved locally</div>
      </article>
      <article class="stat stat--gold">
        <div class="stat-label">Lifetime spend</div>
        <div class="stat-value" id="stat-spend">£0</div>
        <div class="stat-foot" id="stat-spend-foot">No orders yet</div>
      </article>
      <article class="stat stat--brand">
        <div class="stat-label">Brand kit</div>
        <div class="stat-value" id="stat-brand">—</div>
        <div class="stat-foot"><a href="/profile">Edit kit &rarr;</a></div>
      </article>
    </section>

    <!-- Library -->
    <section id="library" class="library fade-up" data-delay="3" aria-labelledby="library-h">
      <header class="section-head">
        <h2 id="library-h" class="section-h">Your library</h2>
        <p class="section-sub">Packs you've purchased from The Edit. <button type="button" class="inline-link" data-shop>Add another pack &rarr;</button></p>
      </header>

      <div id="library-loading" class="lib-state">Loading your library…</div>

      <div id="library-empty" class="lib-empty" hidden>
        <h3>Nothing here yet.</h3>
        <p>You haven't purchased a pack yet. <button type="button" class="lib-link" data-shop>Browse The Edit</button> to find one.</p>
      </div>

      <div id="library-grid" class="library-grid"></div>
    </section>

    <!-- Drafts (from localStorage) -->
    <section id="drafts" class="drafts fade-up" data-delay="4" aria-labelledby="drafts-h" hidden>
      <header class="section-head">
        <h2 id="drafts-h" class="section-h">Designs in progress</h2>
        <p class="section-sub">Drafts saved in this browser. Open one to keep going.</p>
      </header>
      <div id="drafts-grid" class="drafts-grid"></div>
    </section>

    <!-- Account footer -->
    <footer class="app-foot">
      <div class="app-foot-block">
        <div class="app-foot-tag">Signed in as</div>
        <strong id="footer-email">…</strong>
      </div>
      <div class="app-foot-block">
        <div class="app-foot-tag">Help</div>
        <a href="/contact">hello@tmke.co.uk</a>
      </div>
      <div class="app-foot-block app-foot-block--right">
        <button type="button" id="app-signout-foot" class="app-signout">Sign out</button>
      </div>
    </footer>
  </main>

  <!-- Browse packs modal — triggered from the header. Stays inside the
       workspace so customers don't bounce out to the marketing storefront. -->
  <div class="shop-backdrop" id="shop-modal" hidden role="dialog" aria-modal="true" aria-labelledby="shop-h">
    <div class="shop">
      <header class="shop-head">
        <div>
          <p class="shop-eyebrow">Shop — The Edit</p>
          <h2 id="shop-h" class="shop-h">Browse <em>packs.</em></h2>
        </div>
        <button type="button" class="shop-close" id="shop-close" aria-label="Close">&times;</button>
      </header>

      <!-- Pack grid view -->
      <section class="shop-view" data-view="grid">
        <p class="shop-state" id="shop-loading">Loading packs…</p>
        <p class="shop-state" id="shop-empty" hidden>No packs available yet. Check back soon.</p>
        <div class="shop-grid" id="shop-grid"></div>
      </section>

      <!-- Pack detail view (single pack) -->
      <section class="shop-view" data-view="detail" hidden>
        <button type="button" class="shop-back" id="shop-back">&larr; All packs</button>
        <div class="shop-detail" id="shop-detail"></div>
      </section>
    </div>
  </div>

  <style is:global>
    /* ---------- /account-specific styles ----------
       Shared workspace shell (header, footer, welcome, section heads,
       order rows, etc.) lives in src/styles/workspace.css. Only the
       account-landing-specific bits stay here. */

    /* ---------- Stats ---------- */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }
    @media (max-width: 980px) { .stats { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .stats { grid-template-columns: 1fr; } }
    .stat {
      position: relative;
      display: flex; flex-direction: column; gap: 6px;
      padding: 22px 24px 18px;
      background: rgba(255,255,255,0.72);
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 14px;
      min-height: 150px;
      overflow: hidden;
    }
    /* Per-stat colored accent — top stripe + corner glow.
       Adds tasteful colour without breaking the editorial calm. */
    .stat::before {
      content: "";
      position: absolute; inset: 0 0 auto 0;
      height: 3px;
      background: var(--stat-accent, var(--gradient-violet));
      opacity: 0.9;
    }
    .stat::after {
      content: "";
      position: absolute;
      top: -40%; right: -25%;
      width: 220px; height: 220px;
      border-radius: 999px;
      background: var(--stat-glow, radial-gradient(circle, rgba(123,91,207,0.22) 0%, rgba(123,91,207,0) 70%));
      pointer-events: none;
    }
    .stat > * { position: relative; z-index: 1; }
    .stat--violet  { --stat-accent: var(--gradient-violet); --stat-glow: radial-gradient(circle, rgba(123,91,207,0.28) 0%, rgba(123,91,207,0) 70%); }
    .stat--coral   { --stat-accent: linear-gradient(135deg, #E89B7B 0%, #D7754F 100%); --stat-glow: radial-gradient(circle, rgba(232,155,123,0.28) 0%, rgba(232,155,123,0) 70%); }
    .stat--gold    { --stat-accent: linear-gradient(135deg, #E0B96A 0%, #C99A3E 100%); --stat-glow: radial-gradient(circle, rgba(224,185,106,0.28) 0%, rgba(224,185,106,0) 70%); }
    .stat--brand   {
      --stat-accent: linear-gradient(135deg, #2E1F54 0%, #7B5BCF 100%);
      --stat-glow: radial-gradient(circle, rgba(46,31,84,0.22) 0%, rgba(46,31,84,0) 70%);
      background: linear-gradient(180deg, rgba(123, 91, 207, 0.07), rgba(123, 91, 207, 0.02));
      border-color: rgba(123,91,207,0.25);
    }
    .stat-label {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      color: rgba(28,29,34,0.55);
    }
    .stat-value {
      font-family: var(--serif);
      font-size: 48px;
      line-height: 1;
      letter-spacing: -0.02em;
      margin-top: 10px;
      color: var(--ink);
    }
    .stat-foot {
      margin-top: auto;
      font-family: var(--sans);
      font-size: 12px;
      color: rgba(28,29,34,0.6);
    }
    .stat-foot a {
      color: var(--violet);
      font-weight: 700;
      letter-spacing: 0.04em;
      text-decoration: none;
      transition: color 0.2s;
    }
    .stat-foot a:hover { color: var(--violet-deep); text-decoration: underline; }

    /* ---------- Library ---------- */
    .lib-empty {
      position: relative;
      padding: 40px 36px;
      background:
        radial-gradient(80% 100% at 100% 0%, rgba(123,91,207,0.12) 0%, rgba(123,91,207,0) 70%),
        rgba(255,255,255,0.75);
      border: 1px dashed rgba(123,91,207,0.45);
      border-radius: 14px;
      overflow: hidden;
    }
    .lib-empty::after {
      content: "";
      position: absolute;
      bottom: -60%; left: -10%;
      width: 320px; height: 320px;
      background: radial-gradient(circle, rgba(232,155,123,0.18) 0%, rgba(232,155,123,0) 70%);
      pointer-events: none;
    }
    .lib-empty > * { position: relative; }
    .lib-empty h3 {
      font-family: var(--serif);
      font-size: 28px;
      font-weight: 500;
      margin: 0 0 8px;
    }
    .lib-empty p { color: rgba(28,29,34,0.65); font-size: 15px; line-height: 1.6; margin: 0; }

    .library-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 22px;
    }
    @media (max-width: 980px) { .library-grid { grid-template-columns: 1fr; } }

    .pack-row {
      position: relative;
      display: grid;
      grid-template-columns: 160px 1fr;
      gap: 22px;
      align-items: stretch;
      padding: 20px;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 14px;
      overflow: hidden;
    }
    .pack-row::before {
      content: "";
      position: absolute; inset: 0 0 auto 0;
      height: 3px;
      background: var(--gradient-violet);
      opacity: 0;
      transition: opacity 0.3s;
    }
    .pack-row:hover::before { opacity: 1; }
    .pack-row-cover {
      position: relative;
      aspect-ratio: 4 / 5;
      background-size: cover;
      background-position: center;
      background-color: var(--platinum);
      border-radius: 10px;
      box-shadow: inset 0 0 0 1px rgba(123,91,207,0.10);
    }
    .pack-row-cover-tag {
      position: absolute; top: 10px; left: 10px;
      padding: 5px 11px;
      background: var(--gradient-violet);
      color: var(--paper);
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-radius: 999px;
      box-shadow: 0 6px 16px -6px rgba(123,91,207,0.55);
    }
    .pack-row-body { display: flex; flex-direction: column; gap: 6px; }
    .pack-row-meta {
      display: flex; gap: 10px;
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 600;
      color: rgba(28, 29, 34, 0.5);
    }
    .pack-row-title {
      font-family: var(--serif);
      font-size: 26px;
      letter-spacing: -0.015em;
      margin: 0;
      color: var(--ink);
    }
    .pack-row-desc {
      font-family: var(--sans);
      font-size: 13px;
      color: rgba(28,29,34,0.6);
      line-height: 1.55;
      margin: 4px 0 10px;
      flex: 1;
    }
    .pack-row-actions {
      display: flex; gap: 12px; align-items: center; flex-wrap: wrap;
      margin-top: 8px;
    }
    .lib-btn {
      appearance: none;
      background: var(--gradient-violet);
      color: var(--paper);
      border: 0;
      padding: 11px 18px;
      border-radius: 999px;
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex; align-items: center; gap: 8px;
      box-shadow: 0 10px 24px -10px rgba(123,91,207,0.55);
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .lib-btn:hover { transform: translateY(-1px); box-shadow: 0 16px 30px -12px rgba(123,91,207,0.7); }
    .lib-btn[disabled] {
      opacity: 0.55;
      cursor: not-allowed;
      background: rgba(28,29,34,0.45);
      box-shadow: none;
      transform: none;
    }
    .lib-btn-ghost {
      background: transparent;
      color: var(--violet);
      border: 1px solid rgba(123,91,207,0.4);
      box-shadow: none;
    }
    .lib-btn-ghost:hover {
      background: rgba(123,91,207,0.08);
      border-color: var(--violet);
      box-shadow: 0 8px 18px -10px rgba(123,91,207,0.45);
    }
    .lib-soon-tag {
      display: inline-flex; align-items: center;
      padding: 5px 11px;
      background: linear-gradient(135deg, rgba(232,155,123,0.22), rgba(232,155,123,0.10));
      color: #8a4d33;
      border: 1px solid rgba(232,155,123,0.35);
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      border-radius: 999px;
    }

    /* ---------- Drafts ---------- */
    .drafts-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
    @media (max-width: 880px) { .drafts-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .drafts-grid { grid-template-columns: 1fr; } }
    .draft-card {
      position: relative;
      display: flex; flex-direction: column; gap: 8px;
      padding: 18px 20px;
      background: #fff;
      border: 1px solid rgba(28,29,34,0.08);
      border-radius: 12px;
      text-decoration: none;
      color: var(--ink);
      overflow: hidden;
      transition: border-color 0.25s, transform 0.3s;
    }
    .draft-card::before {
      content: "";
      position: absolute; inset: 0 0 auto 0;
      height: 2px;
      background: var(--gradient-violet);
      opacity: 0.7;
    }
    .draft-card-meta {
      font-family: var(--sans);
      font-size: 10px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      font-weight: 700;
      background: var(--gradient-violet);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .draft-card-title {
      font-family: var(--serif);
      font-size: 22px;
      letter-spacing: -0.015em;
      margin: 4px 0;
    }
    .draft-card-foot {
      font-family: var(--sans);
      font-size: 11px;
      color: rgba(28,29,34,0.5);
      letter-spacing: 0.04em;
    }

    /* ---------- Shop modal ---------- */
    .shop-backdrop {
      position: fixed; inset: 0;
      background:
        radial-gradient(60% 50% at 20% 0%, rgba(123,91,207,0.32) 0%, rgba(123,91,207,0) 60%),
        radial-gradient(50% 50% at 80% 100%, rgba(232,155,123,0.28) 0%, rgba(232,155,123,0) 60%),
        rgba(15, 12, 30, 0.62);
      backdrop-filter: blur(8px);
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 5vh 20px;
      z-index: 100;
      overflow-y: auto;
    }
    .shop-backdrop[hidden] { display: none; }
    .shop {
      position: relative;
      width: 100%;
      max-width: 1100px;
      background: var(--paper);
      border-radius: 18px;
      border: 1px solid rgba(123,91,207,0.18);
      box-shadow: 0 50px 120px -30px rgba(46, 31, 84, 0.55);
      overflow: hidden;
    }
    .shop::before {
      content: "";
      position: absolute; inset: 0 0 auto 0;
      height: 4px;
      background: var(--gradient-brand);
    }
    .shop-head {
      display: flex; justify-content: space-between; align-items: center;
      padding: 26px 32px;
      border-bottom: 1px solid rgba(123,91,207,0.16);
      background: linear-gradient(180deg, rgba(123,91,207,0.06), rgba(123,91,207,0));
    }
    .shop-head h2 {
      font-family: var(--serif);
      font-size: 36px;
      font-weight: 500;
      letter-spacing: -0.015em;
      margin: 6px 0 0;
    }
    .shop-head h2 em {
      font-style: italic;
      background: var(--gradient-violet);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .shop-eyebrow {
      margin: 0;
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      background: var(--gradient-violet);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .shop-close {
      background: transparent;
      border: 1px solid rgba(123,91,207,0.3);
      border-radius: 999px;
      font-size: 22px;
      width: 38px; height: 38px;
      cursor: pointer;
      color: var(--violet);
      line-height: 1;
      transition: background 0.25s, color 0.25s, border-color 0.25s;
    }
    .shop-close:hover { background: var(--gradient-violet); color: var(--paper); border-color: transparent; }
    .shop-view { padding: 32px; }
    .shop-state {
      font-family: var(--sans);
      font-size: 14px;
      color: rgba(28,29,34,0.55);
      padding: 24px 0;
      margin: 0;
    }
    .shop-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }
    @media (max-width: 880px) { .shop-grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .shop-grid { grid-template-columns: 1fr; } }
    .shop-card {
      cursor: pointer;
      background: rgba(255,255,255,0.78);
      border: 1px solid rgba(123,91,207,0.16);
      border-radius: 14px;
      overflow: hidden;
      transition: border-color 0.25s, transform 0.3s, box-shadow 0.3s;
      text-align: left;
      padding: 0;
      font: inherit;
      color: var(--ink);
    }
    .shop-card:hover {
      border-color: rgba(123, 91, 207, 0.55);
      transform: translateY(-4px);
      box-shadow: 0 22px 40px -20px rgba(123, 91, 207, 0.45);
    }
    .shop-card-cover {
      aspect-ratio: 4 / 5;
      background-size: cover;
      background-position: center;
      background-color: var(--platinum);
    }
    .shop-card-body {
      padding: 16px 18px 18px;
      display: flex; flex-direction: column; gap: 4px;
    }
    .shop-card-cat {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      background: var(--gradient-violet);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .shop-card-title {
      font-family: var(--serif);
      font-size: 22px;
      letter-spacing: -0.015em;
      margin: 2px 0 4px;
    }
    .shop-card-price {
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.02em;
      color: var(--ink);
      margin-top: 2px;
    }

    .shop-back {
      background: transparent; border: none;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--violet);
      cursor: pointer;
      padding: 0 0 18px;
      transition: color 0.2s, transform 0.2s;
    }
    .shop-back:hover { color: var(--violet-deep); transform: translateX(-3px); }
    .shop-detail {
      display: grid;
      grid-template-columns: 360px 1fr;
      gap: 40px;
      align-items: start;
    }
    @media (max-width: 780px) {
      .shop-detail { grid-template-columns: 1fr; gap: 24px; }
    }
    .shop-detail-cover {
      aspect-ratio: 4 / 5;
      background-size: cover;
      background-position: center;
      background-color: var(--platinum);
      border-radius: 14px;
      box-shadow: 0 20px 50px -20px rgba(46,31,84,0.35);
    }
    .shop-detail-body { display: flex; flex-direction: column; gap: 14px; }
    .shop-detail-cat {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      background: var(--gradient-violet);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
    .shop-detail-title {
      font-family: var(--serif);
      font-size: 40px;
      line-height: 1.05;
      letter-spacing: -0.02em;
      margin: 0;
      font-weight: 500;
    }
    .shop-detail-desc {
      font-size: 16px;
      line-height: 1.6;
      color: rgba(28,29,34,0.7);
    }
    .shop-detail ul {
      margin: 0;
      padding: 0 0 0 18px;
      font-family: var(--sans);
      font-size: 14px;
      color: rgba(28,29,34,0.7);
      line-height: 1.7;
    }
    .shop-detail-foot {
      display: flex; align-items: center; gap: 18px;
      margin-top: 12px;
      padding-top: 18px;
      border-top: 1px solid rgba(28,29,34,0.1);
    }
    .shop-detail-price {
      font-family: var(--serif);
      font-size: 32px;
      letter-spacing: -0.015em;
    }
    .shop-buy {
      appearance: none;
      background: var(--gradient-violet);
      color: var(--paper);
      border: 0;
      padding: 14px 24px;
      border-radius: 999px;
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      cursor: pointer;
      text-decoration: none;
      display: inline-flex; align-items: center; gap: 8px;
      box-shadow: 0 14px 30px -12px rgba(123,91,207,0.6);
      transition: transform 0.25s, box-shadow 0.25s;
    }
    .shop-buy:hover {
      transform: translateY(-2px);
      box-shadow: 0 22px 40px -14px rgba(123,91,207,0.75);
    }
    .shop-already {
      display: inline-flex; align-items: center;
      padding: 5px 12px;
      background: linear-gradient(135deg, rgba(121,201,168,0.22), rgba(121,201,168,0.10));
      border: 1px solid rgba(121,201,168,0.4);
      color: #1f6149;
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      border-radius: 999px;
    }

    @media (max-width: 720px) {
      .pack-row { grid-template-columns: 1fr; }
    }
  </style>

  <script>
    import { supabase, gbpFromPence } from '../lib/supabase.js';

    const $welcomeH = document.getElementById('welcome-h');
    const $welcomeSub = document.getElementById('welcome-sub');
    const $footerEmail = document.getElementById('footer-email');
    const $statPacks = document.getElementById('stat-packs');
    const $statDesigns = document.getElementById('stat-designs');
    const $statSpend = document.getElementById('stat-spend');
    const $statSpendFoot = document.getElementById('stat-spend-foot');
    const $statBrand = document.getElementById('stat-brand');
    const $loading = document.getElementById('library-loading');
    const $empty = document.getElementById('library-empty');
    const $grid = document.getElementById('library-grid');
    const $draftsSection = document.getElementById('drafts');
    const $draftsGrid = document.getElementById('drafts-grid');

    // Shop modal refs
    const $shopModal = document.getElementById('shop-modal');
    const $shopClose = document.getElementById('shop-close');
    const $shopGrid = document.getElementById('shop-grid');
    const $shopLoading = document.getElementById('shop-loading');
    const $shopEmpty = document.getElementById('shop-empty');
    const $shopDetail = document.getElementById('shop-detail');
    const $shopBack = document.getElementById('shop-back');
    const $shopOpen = document.getElementById('open-shop');

    function escapeHtml(s) {
      return String(s ?? '').replace(/[&<>"']/g, (c) => ({
        '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
      }[c]));
    }
    function titleCase(s) {
      return String(s || '').replace(/\b\w/g, (c) => c.toUpperCase());
    }

    async function signOut() {
      await supabase.auth.signOut();
      location.replace('/login');
    }
    document.getElementById('app-signout')?.addEventListener('click', signOut);
    document.getElementById('app-signout-foot')?.addEventListener('click', signOut);

    // Local drafts — anything in localStorage under `tmke.editor.<id>`.
    function readLocalDrafts() {
      const drafts = [];
      try {
        for (let i = 0; i < localStorage.length; i++) {
          const key = localStorage.key(i);
          if (!key || !key.startsWith('tmke.editor.')) continue;
          const id = key.replace('tmke.editor.', '');
          try {
            const v = JSON.parse(localStorage.getItem(key) || 'null');
            if (!v) continue;
            drafts.push({ id, filename: v.filename || id, savedAt: v.savedAt || 0 });
          } catch (_) {}
        }
      } catch (_) {}
      drafts.sort((a, b) => b.savedAt - a.savedAt);
      return drafts;
    }

    function renderDrafts(drafts) {
      if (!drafts.length) {
        $draftsSection.hidden = true;
        $statDesigns.textContent = '0';
        return;
      }
      $draftsSection.hidden = false;
      $statDesigns.textContent = String(drafts.length);
      $draftsGrid.innerHTML = drafts.slice(0, 6).map((d) => `
        <a class="draft-card" href="/editor?template=${encodeURIComponent(d.id)}">
          <span class="draft-card-meta">Draft</span>
          <h3 class="draft-card-title">${escapeHtml(d.filename)}</h3>
          <span class="draft-card-foot">${d.savedAt ? 'Saved ' + new Date(d.savedAt).toLocaleString('en-GB', { day: '2-digit', month: 'short', hour: '2-digit', minute: '2-digit' }) : 'Saved locally'}</span>
        </a>
      `).join('');
    }

    function renderBrandStat() {
      try {
        const brand = JSON.parse(localStorage.getItem('tmke.brand') || 'null');
        if (!brand) { $statBrand.textContent = 'Not set'; return; }
        const parts = [];
        const colourCount = (brand.colors || []).filter((c) => c && c.hex).length;
        const fontCount = brand.fonts ? [brand.fonts.heading, brand.fonts.body].filter(Boolean).length : 0;
        const logoCount = (brand.logos || []).length;
        if (colourCount) parts.push(colourCount + ' colour' + (colourCount === 1 ? '' : 's'));
        if (fontCount) parts.push(fontCount + ' font' + (fontCount === 1 ? '' : 's'));
        if (logoCount) parts.push(logoCount + ' logo' + (logoCount === 1 ? '' : 's'));
        $statBrand.textContent = parts.length ? parts.join(' · ') : 'Empty';
        $statBrand.style.fontSize = '20px';
      } catch (_) {
        $statBrand.textContent = 'Not set';
      }
    }

    // ====== Shop modal ======
    let cachedPacks = null;
    let ownedPackIds = new Set();

    function setView(name) {
      document.querySelectorAll('.shop-view').forEach((v) => {
        v.hidden = v.getAttribute('data-view') !== name;
      });
    }

    async function openShop() {
      $shopModal.hidden = false;
      document.body.style.overflow = 'hidden';
      setView('grid');
      if (!cachedPacks) {
        $shopLoading.hidden = false;
        const { data, error } = await supabase
          .from('packs')
          .select('id, slug, title, description, price_pence, cover_image_url, contents, category, sort_order')
          .eq('status', 'active')
          .order('sort_order', { ascending: true });
        $shopLoading.hidden = true;
        if (error || !data || !data.length) {
          $shopEmpty.hidden = false;
          return;
        }
        cachedPacks = data;
      }
      renderGrid();
    }

    function closeShop() {
      $shopModal.hidden = true;
      document.body.style.overflow = '';
    }

    function renderGrid() {
      $shopGrid.innerHTML = cachedPacks.map((p) => {
        const cover = p.cover_image_url ? `style="background-image:url('${escapeHtml(p.cover_image_url)}')"` : '';
        return `
          <button type="button" class="shop-card" data-slug="${escapeHtml(p.slug)}">
            <div class="shop-card-cover" ${cover}></div>
            <div class="shop-card-body">
              ${p.category ? `<span class="shop-card-cat">${escapeHtml(p.category)}</span>` : ''}
              <h3 class="shop-card-title">${escapeHtml(p.title)}</h3>
              <span class="shop-card-price">${gbpFromPence(p.price_pence)}${ownedPackIds.has(p.id) ? ' &middot; Owned' : ''}</span>
            </div>
          </button>
        `;
      }).join('');
    }

    function showDetail(slug) {
      const p = cachedPacks.find((x) => x.slug === slug);
      if (!p) return;
      const cover = p.cover_image_url ? `style="background-image:url('${escapeHtml(p.cover_image_url)}')"` : '';
      const owned = ownedPackIds.has(p.id);
      const contentsHtml = (p.contents || []).map((c) => `<li>${escapeHtml(c)}</li>`).join('');
      $shopDetail.innerHTML = `
        <div class="shop-detail-cover" ${cover}></div>
        <div class="shop-detail-body">
          ${p.category ? `<span class="shop-detail-cat">${escapeHtml(p.category)}</span>` : ''}
          <h2 class="shop-detail-title">${escapeHtml(p.title)}</h2>
          <p class="shop-detail-desc">${escapeHtml(p.description || '')}</p>
          ${contentsHtml ? `<ul>${contentsHtml}</ul>` : ''}
          <div class="shop-detail-foot">
            <span class="shop-detail-price">${gbpFromPence(p.price_pence)}</span>
            ${owned
              ? `<span class="shop-already">Already in your library</span>`
              : `<a class="shop-buy" href="/edit?buy=${encodeURIComponent(p.slug)}">Purchase &rarr;</a>`}
          </div>
        </div>
      `;
      setView('detail');
    }

    $shopOpen?.addEventListener('click', openShop);
    $shopClose?.addEventListener('click', closeShop);
    $shopModal?.addEventListener('click', (e) => { if (e.target === $shopModal) closeShop(); });
    $shopBack?.addEventListener('click', () => setView('grid'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !$shopModal.hidden) closeShop();
    });
    $shopGrid?.addEventListener('click', (e) => {
      const card = e.target.closest('.shop-card');
      if (!card) return;
      showDetail(card.getAttribute('data-slug'));
    });
    // "Add another pack" / "Browse The Edit" inline links open the same modal.
    document.addEventListener('click', (e) => {
      const t = e.target;
      if (t instanceof HTMLElement && t.hasAttribute('data-shop')) {
        e.preventDefault();
        openShop();
      }
    });

    // ====== Bootstrap ======
    (async () => {
      const { data: { session } } = await supabase.auth.getSession();
      if (!session) {
        location.replace('/login?next=' + encodeURIComponent('/account'));
        return;
      }

      const email = session.user.email ?? '';
      const meta = session.user.user_metadata ?? {};
      const firstName = (meta.name || email.split('@')[0]).split(' ')[0].split('.')[0];

      // Time-of-day greeting feels warmer than the generic "Welcome back".
      const hour = new Date().getHours();
      let greeting = 'Welcome back';
      if (hour >= 5 && hour < 12)       greeting = 'Good morning';
      else if (hour >= 12 && hour < 17) greeting = 'Good afternoon';
      else if (hour >= 17 && hour < 22) greeting = 'Good evening';
      else                              greeting = 'Burning the midnight oil';

      $welcomeH.innerHTML = `${greeting}, <em>${escapeHtml(titleCase(firstName))}.</em>`;
      $welcomeSub.textContent = 'Your studio. Your library. Pick something up where you left off.';
      $footerEmail.textContent = email;

      // Kick off the entrance animation. Adding the class on the next
      // frame ensures the .fade-up elements have laid out before the
      // animation starts (so transforms read smoothly).
      requestAnimationFrame(() => document.body.classList.add('is-loaded'));

      renderDrafts(readLocalDrafts());
      renderBrandStat();

      const { data: orders, error } = await supabase
        .from('orders')
        .select('id, pack_id, pack_slug, pack_title, amount_pence, invoice_number, status, payment_method, created_at, buyer_company')
        .or(`user_id.eq.${session.user.id},buyer_email.eq.${email}`)
        .order('created_at', { ascending: false });

      if (error) {
        $loading.textContent = `Couldn't load your library: ${error.message}`;
        return;
      }

      $loading.hidden = true;

      const uniquePacks = new Set();
      let totalSpend = 0;
      (orders || []).forEach((o) => {
        if (o.status === 'paid') {
          if (o.pack_id) {
            uniquePacks.add(o.pack_id);
            ownedPackIds.add(o.pack_id);
          }
          totalSpend += (o.amount_pence || 0);
        }
      });
      $statPacks.textContent = String(uniquePacks.size);
      $statSpend.textContent = gbpFromPence(totalSpend) || '£0';
      $statSpendFoot.innerHTML = orders && orders.length
        ? `Across ${orders.length} order${orders.length === 1 ? '' : 's'} &middot; <a href="/account/orders">View all</a>`
        : 'No orders yet';

      // Mirror the headline stats into the welcome hero pills. Hide the
      // pill strip entirely if everything is zero (no orders, no drafts) —
      // a row of "0 ... 0 ... £0" pills reads sadder than no pills at all.
      const pillsEl = document.getElementById('welcome-pills');
      const draftCount = parseInt($statDesigns.textContent, 10) || 0;
      const hasAny = uniquePacks.size > 0 || draftCount > 0 || totalSpend > 0;
      if (hasAny && pillsEl) {
        const pp = document.getElementById('pill-packs');
        const pd = document.getElementById('pill-designs');
        const ps = document.getElementById('pill-spend');
        if (pp) pp.textContent = String(uniquePacks.size);
        if (pd) pd.textContent = String(draftCount);
        if (ps) ps.textContent = gbpFromPence(totalSpend) || '£0';
        pillsEl.hidden = false;
      }

      if (!orders || orders.length === 0) {
        $empty.hidden = false;
        return;
      }

      const byPack = new Map();
      orders.forEach((o) => {
        if (!byPack.has(o.pack_id)) byPack.set(o.pack_id, { order: o, count: 1 });
        else byPack.get(o.pack_id).count += 1;
      });

      const packIds = [...byPack.keys()].filter(Boolean);
      const { data: packs } = await supabase
        .from('packs')
        .select('id, cover_image_url, description, contents, category')
        .in('id', packIds);
      const packMap = new Map((packs ?? []).map((p) => [p.id, p]));

      $grid.innerHTML = [...byPack.values()].map(({ order, count }) => {
        const pack = packMap.get(order.pack_id);
        const cover = pack?.cover_image_url
          ? `style="background-image:url('${escapeHtml(pack.cover_image_url)}')"`
          : '';
        const desc = pack?.description ?? '';
        const itemCount = (pack?.contents ?? []).length;
        const tag = itemCount ? `${itemCount} items` : 'Purchased';
        const fmtDate = new Date(order.created_at).toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' });
        return `
          <article class="pack-row">
            <div class="pack-row-cover" ${cover}>
              <span class="pack-row-cover-tag">${escapeHtml(tag)}</span>
            </div>
            <div class="pack-row-body">
              <div class="pack-row-meta">
                <span>Purchased ${fmtDate}</span>
                ${count > 1 ? `<span>·</span><span>${count} copies</span>` : ''}
              </div>
              <h3 class="pack-row-title">${escapeHtml(order.pack_title)}</h3>
              <p class="pack-row-desc">${escapeHtml(desc)}</p>
              <div class="pack-row-actions">
                <button type="button" class="lib-btn" disabled>Download (.zip)</button>
                <span class="lib-soon-tag">Assets land soon</span>
                <a href="/edit/thanks?order=${encodeURIComponent(order.id)}" class="lib-btn lib-btn-ghost">View receipt</a>
              </div>
            </div>
          </article>
        `;
      }).join('');
    })();
  </script>
</BaseLayout>
