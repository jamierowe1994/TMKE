---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Your Library — TMKE"
  description="Access your purchased templates, downloads, and account details."
>
  <PageHero
    chapter="Members — Your Library"
    title="Welcome back, <em>let's get to work.</em>"
    sub="Your purchased packs, downloads, and account details — all in one place."
  />

  <section class="account-grid wrap">
    <aside class="account-side">
      <div class="account-tag">Signed in <em>(placeholder)</em></div>
      <h3 class="account-name">[Account Name]</h3>
      <div class="account-email">[email&#64;agency.co.uk]</div>

      <nav class="account-nav" aria-label="Account">
        <a href="#library" class="is-active">Library</a>
        <a href="#orders">Orders</a>
        <a href="#downloads">Downloads</a>
        <a href="#profile">Profile</a>
        <a href="#billing">Billing</a>
        <a href="#" class="account-signout">Sign out</a>
      </nav>
    </aside>

    <div class="account-main">
      <section id="library">
        <div class="eyebrow">Your Library</div>
        <h2 class="account-heading">Purchased packs</h2>

        <div class="account-empty">
          <p>You haven't purchased any packs yet.</p>
          <p class="account-empty-sub">When you check out from The Edit, your packs land here with one-click downloads.</p>
          <a href="/edit" class="btn btn--solid">Browse The Edit <span class="btn-arrow">&rarr;</span></a>
        </div>

        <!-- Placeholder grid: hidden until a real purchase model is wired up -->
        <div class="account-library hidden">
          <article class="library-card">
            <div class="library-card-img"></div>
            <div class="library-card-body">
              <h4>[Pack title]</h4>
              <div class="library-card-meta">Purchased [date] · v[version]</div>
              <a href="#" class="library-card-cta">Download &darr;</a>
            </div>
          </article>
        </div>
      </section>
    </div>
  </section>

  <style>
    .account-grid {
      display: grid;
      grid-template-columns: 280px 1fr;
      gap: 80px;
      max-width: 1360px;
      margin: 0 auto;
      padding: 40px 36px 200px;
      align-items: start;
    }
    .account-side {
      position: sticky;
      top: 100px;
      padding: 28px 0;
      border-top: 1px solid rgba(28, 29, 34, 0.12);
    }
    .account-tag {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--english-violet);
      margin-bottom: 12px;
    }
    .account-tag em {
      font-style: italic;
      font-weight: 400;
      letter-spacing: 0;
      text-transform: none;
      color: rgba(28, 29, 34, 0.45);
      margin-left: 6px;
    }
    .account-name {
      font-family: var(--serif);
      font-size: 28px;
      letter-spacing: -0.015em;
      margin: 0 0 4px;
      color: var(--ink);
    }
    .account-email {
      font-family: var(--sans);
      font-size: 14px;
      color: rgba(28, 29, 34, 0.55);
      margin-bottom: 32px;
    }
    .account-nav {
      display: flex;
      flex-direction: column;
      gap: 14px;
      padding-top: 24px;
      border-top: 1px solid rgba(28, 29, 34, 0.12);
    }
    .account-nav a {
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.04em;
      color: rgba(28, 29, 34, 0.65);
      transition: color 0.3s;
    }
    .account-nav a:hover,
    .account-nav a.is-active {
      color: var(--english-violet);
    }
    .account-nav .account-signout {
      margin-top: 18px;
      padding-top: 18px;
      border-top: 1px solid rgba(28, 29, 34, 0.12);
      color: rgba(28, 29, 34, 0.45);
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .account-main .eyebrow { margin-bottom: 16px; }
    .account-heading {
      font-family: var(--serif);
      font-size: clamp(36px, 4vw, 56px);
      line-height: 1.05;
      letter-spacing: -0.015em;
      color: var(--ink);
      margin: 0 0 40px;
    }

    .account-empty {
      max-width: 600px;
      padding: 64px;
      border: 1px dashed rgba(71, 66, 84, 0.35);
      border-radius: 4px;
      text-align: center;
    }
    .account-empty p {
      margin: 0 0 12px;
      color: rgba(28, 29, 34, 0.72);
      font-size: 17px;
      line-height: 1.55;
    }
    .account-empty p:first-child {
      font-family: var(--serif);
      font-size: 22px;
      font-style: italic;
      color: var(--ink);
      margin-bottom: 8px;
    }
    .account-empty-sub {
      font-size: 14px !important;
      margin-bottom: 32px !important;
    }

    .account-library { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 24px; }
    .account-library.hidden { display: none; }
    .library-card { background: var(--platinum); }
    .library-card-img {
      aspect-ratio: 4/5;
      background: rgba(71, 66, 84, 0.18);
    }
    .library-card-body { padding: 18px 18px 22px; }
    .library-card-body h4 { font-family: var(--serif); font-size: 22px; margin: 0 0 6px; }
    .library-card-meta {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.5);
      margin-bottom: 14px;
    }
    .library-card-cta {
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--english-violet);
    }

    @media (max-width: 980px) {
      .account-grid { grid-template-columns: 1fr; gap: 40px; }
      .account-side { position: static; }
    }
  </style>
</BaseLayout>
