---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactPanel from "../components/account/ContactPanel.astro";
import ServicesPanel from "../components/account/ServicesPanel.astro";
import GuidesPanel from "../components/account/GuidesPanel.astro";
import BlogPanel from "../components/account/BlogPanel.astro";
import "../styles/workspace.css";
import "../styles/account-sections.css";
---

<BaseLayout
  title="Your TMKE — workspace"
  description="Your purchased packs, designs in progress, and account details — all in one place."
  hideNav
  hideFooter
>
  <!-- /account uses a left sidebar instead of the shared top header.
       Other workspace pages still use .app-header from workspace.css. -->
  <div class="dash-shell">
    <aside class="dash-side" aria-label="Workspace">
      <a href="/account" class="app-logo dash-logo slide-in-left" data-d="0">TMKE</a>

      <nav class="dash-nav" aria-label="Sections">
        <a href="/account" class="dash-link is-active slide-in-left" data-d="1">Workspace</a>
        <a href="/editor" class="dash-link slide-in-left" data-d="2">Studio</a>
        <a href="/account/schedule" class="dash-link slide-in-left" data-d="3">Schedule</a>
        <button type="button" class="dash-link dash-link--btn slide-in-left" data-d="4" id="open-shop" aria-haspopup="dialog">Browse packs</button>
        <a href="/account/orders" class="dash-link slide-in-left" data-d="5">Orders</a>
        <a href="/profile" class="dash-link slide-in-left" data-d="6">Brand kit</a>

        <div class="dash-divider slide-in-left" data-d="7" aria-hidden="true"></div>

        <!-- These open as a right-side drawer on /account. Each href
             still points to the standalone /account/<section> page so
             middle-click / cmd-click / direct nav still works. -->
        <a href="/account/services" class="dash-link dash-link--sub slide-in-left" data-d="8" data-drawer="services">Managed socials</a>
        <a href="/account/guides" class="dash-link dash-link--sub slide-in-left" data-d="9" data-drawer="guides">Guides</a>
        <a href="/account/blog" class="dash-link dash-link--sub slide-in-left" data-d="10" data-drawer="blog">Blog</a>
        <a href="/account/contact" class="dash-link dash-link--sub slide-in-left" data-d="11" data-drawer="contact">Contact</a>
      </nav>

      <div class="dash-side-foot slide-in-left" data-d="12">
        <button type="button" id="cal-side-trigger" class="dash-cal-btn" aria-haspopup="dialog" aria-controls="cal-popup">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="4" width="18" height="18" rx="2"/>
            <line x1="16" y1="2" x2="16" y2="6"/>
            <line x1="8" y1="2" x2="8" y2="6"/>
            <line x1="3" y1="10" x2="21" y2="10"/>
          </svg>
          <span>Calendar</span>
          <span class="dash-cal-count" id="cal-side-count" hidden>0</span>
        </button>
        <div class="dash-side-meta">
          <span class="dash-side-tag">Signed in as</span>
          <strong id="sidebar-email">&hellip;</strong>
        </div>
        <button type="button" id="app-signout" class="app-signout">Sign out</button>
      </div>
    </aside>

    <main class="app-main dash-main">
    <!-- Welcome hero — 2-column with decorative photo on the right.
         The greeting line below is set client-side based on the
         current hour (Good morning / afternoon / evening). -->
    <section class="welcome welcome--hero slide-down" data-d="2">
      <div class="welcome-content">
        <p class="welcome-eyebrow">Workspace</p>
        <h1 class="welcome-h" id="welcome-h">Welcome back, <em>let's get to work.</em></h1>
        <p class="welcome-sub" id="welcome-sub">Your designs, packs and account in one place.</p>
        <div class="welcome-pills" id="welcome-pills" hidden>
          <span class="welcome-pill"><strong id="pill-packs">0</strong> active packs</span>
          <span class="welcome-pill"><strong id="pill-designs">0</strong> designs in progress</span>
          <span class="welcome-pill"><strong id="pill-spend">£0</strong> lifetime spend</span>
        </div>
      </div>
      <div class="welcome-art" aria-hidden="true">
        <img id="welcome-art-img" src="/assets/social-media.png" alt="" loading="eager" decoding="async" />
      </div>
    </section>

    <!-- Stats row -->
    <section class="stats slide-up" data-d="4" aria-label="Your TMKE at a glance">
      <article class="stat">
        <div class="stat-label">Active packs</div>
        <div class="stat-value" id="stat-packs">—</div>
        <div class="stat-foot">From The Edit</div>
      </article>
      <article class="stat">
        <div class="stat-label">Designs in progress</div>
        <div class="stat-value" id="stat-designs">—</div>
        <div class="stat-foot">Saved locally</div>
      </article>
      <article class="stat">
        <div class="stat-label">Lifetime spend</div>
        <div class="stat-value" id="stat-spend">£0</div>
        <div class="stat-foot" id="stat-spend-foot">No orders yet</div>
      </article>
      <article class="stat stat--brand">
        <div class="stat-label">Brand kit</div>
        <div class="stat-value" id="stat-brand">—</div>
        <div class="stat-foot"><a href="/profile">Edit kit &rarr;</a></div>
      </article>
    </section>

    <!-- Two-up row: Upcoming list on the left, members-blog feature
         on the right. Each half is a self-contained card. The week
         strip JS still targets #up-grid / #up-label / #up-prev etc.
         so the underlying calendar bootstrap is unchanged. -->
    <section class="dash-pair slide-up" data-d="5" aria-label="This week and what to read">
      <article id="upcoming" class="dash-pair-card upcoming-card" aria-labelledby="upcoming-h">
        <header class="dash-pair-head">
          <span class="dash-pair-eyebrow">This week</span>
          <h3 id="upcoming-h" class="dash-pair-title">What you've got going out</h3>
        </header>

        <nav class="upcoming-nav upcoming-nav--compact" aria-label="Week navigation">
          <div class="upcoming-nav-side">
            <button type="button" class="upcoming-nav-btn" id="up-prev" aria-label="Previous week">&larr;</button>
            <button type="button" class="upcoming-nav-today" id="up-today">This week</button>
          </div>
          <div class="upcoming-nav-label" id="up-label">&mdash;</div>
          <div class="upcoming-nav-side" style="justify-content:flex-end;">
            <button type="button" class="upcoming-nav-btn" id="up-next" aria-label="Next week">&rarr;</button>
          </div>
        </nav>

        <div id="up-grid" class="upcoming-grid"></div>
        <p id="up-state" class="lib-state" hidden></p>
      </article>

      <a class="dash-pair-card dash-blog-feature" href="/account/blog#instagram-algo-2026" data-drawer="blog">
        <div class="dash-blog-feature-art" style="background-image:url('/assets/social-media.png')">
          <span class="dash-blog-feature-flag">Members only</span>
        </div>
        <div class="dash-blog-feature-body">
          <span class="dash-pair-eyebrow">Inside The Edit &middot; 6 min read</span>
          <h3 class="dash-pair-title">What just changed in the Instagram ranking signal &mdash; and what to do this week</h3>
          <p class="dash-blog-feature-desc">Instagram quietly bumped the weight of "shares to non-followers" in mid-May. For property accounts that's a bigger deal than it sounds.</p>
          <span class="dash-blog-feature-cta">Read the piece <em>&rarr;</em></span>
        </div>
      </a>
    </section>

    <!-- Library -->
    <section id="library" class="library slide-up" data-d="6" aria-labelledby="library-h">
      <header class="section-head">
        <h2 id="library-h" class="section-h">Your library</h2>
        <p class="section-sub">Packs you've purchased from The Edit. <button type="button" class="inline-link" data-shop>Add another pack &rarr;</button></p>
      </header>

      <div id="library-loading" class="lib-state">Loading your library…</div>

      <div id="library-empty" class="lib-empty" hidden>
        <h3>Nothing here yet.</h3>
        <p>You haven't purchased a pack yet. <button type="button" class="lib-link" data-shop>Browse The Edit</button> to find one.</p>
      </div>

      <div id="library-grid" class="library-grid"></div>
    </section>

    <!-- Drafts (from localStorage) -->
    <section id="drafts" class="drafts slide-up" data-d="7" aria-labelledby="drafts-h" hidden>
      <header class="section-head">
        <h2 id="drafts-h" class="section-h">Designs in progress</h2>
        <p class="section-sub">Drafts saved in this browser. Open one to keep going.</p>
      </header>
      <div id="drafts-grid" class="drafts-grid"></div>
    </section>

    <!-- Account footer — kept lightweight; signed-in chip + sign-out
         now live in the sidebar; this row is just contact info. -->
    <footer class="app-foot dash-foot">
      <div class="app-foot-block">
        <div class="app-foot-tag">Help</div>
        <a href="/contact">hello@tmke.co.uk</a>
      </div>
      <div class="app-foot-block app-foot-block--right">
        <strong id="footer-email" class="dash-foot-email">&hellip;</strong>
      </div>
    </footer>
    </main>
  </div>

  <!-- Browse packs modal — triggered from the header. Stays inside the
       workspace so customers don't bounce out to the marketing storefront. -->
  <div class="shop-backdrop" id="shop-modal" hidden role="dialog" aria-modal="true" aria-labelledby="shop-h">
    <div class="shop">
      <header class="shop-head">
        <div>
          <p class="shop-eyebrow">Shop — The Edit</p>
          <h2 id="shop-h" class="shop-h">Browse <em>packs.</em></h2>
        </div>
        <button type="button" class="shop-close" id="shop-close" aria-label="Close">&times;</button>
      </header>

      <!-- Pack grid view -->
      <section class="shop-view" data-view="grid">
        <p class="shop-state" id="shop-loading">Loading packs…</p>
        <p class="shop-state" id="shop-empty" hidden>No packs available yet. Check back soon.</p>
        <div class="shop-grid" id="shop-grid"></div>
      </section>

      <!-- Pack detail view (single pack) -->
      <section class="shop-view" data-view="detail" hidden>
        <button type="button" class="shop-back" id="shop-back">&larr; All packs</button>
        <div class="shop-detail" id="shop-detail"></div>
      </section>
    </div>
  </div>

  <!-- ============================================================
       Right-side drawer: holds the Contact / Managed Socials /
       Guides / Blog panels. Sidebar links with [data-drawer="..."]
       open the matching panel here instead of navigating. Each
       panel is pre-rendered (cheap static markup) and only the
       active one is visible. The same components also render on
       the standalone /account/<section> pages.
       ============================================================ -->
  <div class="dash-drawer-backdrop" id="dash-drawer" hidden role="dialog" aria-modal="true" aria-labelledby="dash-drawer-label">
    <aside class="dash-drawer" aria-label="Section panel">
      <header class="dash-drawer-bar">
        <span class="dash-drawer-bar-label" id="dash-drawer-label">Panel</span>
        <div class="dash-drawer-bar-actions">
          <a href="/account/contact" class="dash-drawer-bar-expand" id="dash-drawer-expand">Open full &rarr;</a>
          <button type="button" class="dash-drawer-bar-close" id="dash-drawer-close" aria-label="Close">&times;</button>
        </div>
      </header>
      <div class="dash-drawer-body">
        <div class="dash-drawer-panel" data-panel="contact"><ContactPanel /></div>
        <div class="dash-drawer-panel" data-panel="services"><ServicesPanel /></div>
        <div class="dash-drawer-panel" data-panel="guides"><GuidesPanel /></div>
        <div class="dash-drawer-panel" data-panel="blog"><BlogPanel /></div>
      </div>
    </aside>
  </div>

  <!-- Left-edge "Calendar" tab. Persistent on workspace pages; click
       to open the month-view drawer below. -->
  <button type="button" class="cal-tab" id="cal-tab-trigger" aria-haspopup="dialog" aria-controls="cal-popup">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="4" width="18" height="18" rx="2"/>
      <line x1="16" y1="2" x2="16" y2="6"/>
      <line x1="8" y1="2" x2="8" y2="6"/>
      <line x1="3" y1="10" x2="21" y2="10"/>
    </svg>
    <span class="cal-tab-label">Calendar</span>
    <span class="cal-tab-count" id="cal-tab-count" hidden>0</span>
  </button>

  <!-- Month-view pop-out drawer. Slides in from the left when the
       Calendar tab is clicked. Shares chip styling with the upcoming-
       week strip so the two read as one feature. -->
  <div class="cal-popup-backdrop" id="cal-popup" hidden role="dialog" aria-modal="true" aria-labelledby="cal-popup-title">
    <aside class="cal-popup" aria-label="Content calendar">
      <header class="cal-popup-head">
        <h2 class="cal-popup-title" id="cal-popup-title">—</h2>
        <div class="cal-popup-controls">
          <button type="button" class="cal-popup-nav" id="cal-popup-prev" aria-label="Previous month">&larr;</button>
          <button type="button" class="cal-popup-today" id="cal-popup-today">Today</button>
          <button type="button" class="cal-popup-nav" id="cal-popup-next" aria-label="Next month">&rarr;</button>
        </div>
        <a href="/account/schedule" class="cal-popup-expand">Open full &rarr;</a>
        <button type="button" class="cal-popup-close" id="cal-popup-close" aria-label="Close">&times;</button>
      </header>
      <div class="cal-popup-weekhead" aria-hidden="true">
        <span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span><span>Sun</span>
      </div>
      <div id="cal-popup-grid" class="cal-popup-grid" role="grid" aria-labelledby="cal-popup-title"></div>
      <p id="cal-popup-state" class="cal-popup-state" hidden></p>
    </aside>
  </div>

  <style is:global>
    /* ---------- /account-specific styles ----------
       Shared workspace shell (header, footer, welcome, section heads,
       order rows, etc.) lives in src/styles/workspace.css. Only the
       account-landing-specific bits stay here. */

    /* ---------- Dashboard shell ----------
       /account uses a sidebar layout instead of the top header that
       other workspace pages still share. The shell fills the viewport,
       sidebar sticks at the left, main content scrolls on the right. */
    .dash-shell {
      display: grid;
      grid-template-columns: 264px minmax(0, 1fr);
      min-height: 100vh;
      background: var(--paper);
    }
    .dash-side {
      position: sticky;
      top: 0;
      height: 100vh;
      display: flex;
      flex-direction: column;
      padding: 36px 26px 32px;
      background: var(--paper);
      border-right: 1px solid rgba(28, 29, 34, 0.08);
      gap: 28px;
      overflow-y: auto;
    }
    .dash-logo {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: var(--ink);
      text-decoration: none;
      padding: 4px 12px;
    }
    .dash-nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
      flex: 1;
    }
    .dash-link {
      appearance: none;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 14px;
      font-family: var(--sans);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.01em;
      line-height: 1.4;
      color: rgba(28, 29, 34, 0.62);
      background: transparent;
      border: 0;
      border-radius: 4px;
      text-decoration: none;
      text-align: left;
      cursor: pointer;
      transition: color 0.25s, background 0.25s, transform 0.25s;
    }
    .dash-link:hover {
      color: var(--ink);
      background: rgba(71, 66, 84, 0.06);
    }
    .dash-link.is-active {
      color: var(--english-violet);
      background: rgba(71, 66, 84, 0.10);
      box-shadow: inset 3px 0 0 0 var(--english-violet);
    }
    .dash-link--sub {
      font-size: 13px;
      font-weight: 500;
      color: rgba(28, 29, 34, 0.5);
    }
    .dash-divider {
      height: 1px;
      background: rgba(28, 29, 34, 0.08);
      margin: 14px 14px 10px;
    }
    .dash-side-foot {
      padding: 16px 6px 0;
      border-top: 1px solid rgba(28, 29, 34, 0.08);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }
    /* Calendar quick-open button — pinned at the bottom of the sidebar
       just above the signed-in chip. Clicking it opens the same month
       drawer the floating .cal-tab uses on non-dashboard pages. */
    .dash-cal-btn {
      appearance: none;
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 11px 14px;
      font-family: var(--sans);
      font-size: 14px;
      font-weight: 600;
      letter-spacing: 0.01em;
      color: var(--english-violet);
      background: rgba(71, 66, 84, 0.06);
      border: 1px solid rgba(71, 66, 84, 0.18);
      border-radius: 4px;
      text-align: left;
      cursor: pointer;
      transition: background 0.25s, border-color 0.25s, color 0.25s;
    }
    .dash-cal-btn:hover {
      background: var(--english-violet);
      color: var(--paper);
      border-color: var(--english-violet);
    }
    .dash-cal-btn svg { width: 16px; height: 16px; flex-shrink: 0; }
    .dash-cal-btn > span:not(.dash-cal-count) { flex: 1; }
    .dash-cal-count {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 22px;
      height: 22px;
      padding: 0 7px;
      border-radius: 999px;
      background: var(--english-violet);
      color: var(--paper);
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.04em;
    }
    .dash-cal-btn:hover .dash-cal-count {
      background: var(--paper);
      color: var(--english-violet);
    }
    .dash-cal-count[hidden] { display: none; }
    .dash-side-meta {
      display: flex;
      flex-direction: column;
      gap: 2px;
      padding: 0 8px;
      min-width: 0;
    }
    .dash-side-tag {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.4);
    }
    .dash-side-meta strong {
      font-family: var(--sans);
      font-size: 13px;
      font-weight: 600;
      color: var(--ink);
      word-break: break-all;
    }

    /* Override .app-main when used inside the dash shell so the content
       takes the full right column rather than being centred at 1280. */
    .dash-main {
      max-width: none;
      margin: 0;
      padding: 64px 56px 80px;
    }

    .dash-foot {
      grid-template-columns: 1fr auto;
    }
    .dash-foot-email {
      font-family: var(--sans);
      font-size: 13px;
      color: rgba(28, 29, 34, 0.55);
    }

    /* Responsive — under 880px the sidebar collapses to a top strip
       so the layout still works on a tablet / mobile. */
    @media (max-width: 880px) {
      .dash-shell {
        grid-template-columns: 1fr;
      }
      .dash-side {
        position: static;
        height: auto;
        flex-direction: row;
        align-items: center;
        gap: 16px;
        padding: 14px 22px;
        overflow-x: auto;
        overflow-y: visible;
      }
      .dash-nav {
        flex-direction: row;
        flex: 0 1 auto;
        gap: 2px;
        overflow-x: auto;
      }
      .dash-divider,
      .dash-link--sub,
      .dash-side-foot {
        display: none;
      }
      .dash-link.is-active {
        box-shadow: inset 0 -2px 0 0 var(--english-violet);
      }
      .dash-main {
        padding: 36px 22px 60px;
      }
    }

    /* When welcome-art is showing an unowned pack it doubles as a
       "discover this pack" CTA — lift on hover so it reads clickable. */
    #welcome-art-img[data-pack-slug] {
      transition: transform 0.4s cubic-bezier(.2,.7,.2,1);
    }
    #welcome-art-img[data-pack-slug]:hover {
      transform: scale(1.03);
    }

    /* ---------- Dashboard "this week + members blog" pair ---------- */
    .dash-pair {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 18px;
      align-items: stretch;
    }
    @media (max-width: 980px) { .dash-pair { grid-template-columns: 1fr; } }

    .dash-pair-card {
      display: flex;
      flex-direction: column;
      gap: 16px;
      padding: 24px 26px 24px;
      background: #fff;
      border: 1px solid rgba(28, 29, 34, 0.08);
      border-radius: 10px;
      box-shadow:
        0 10px 24px -16px rgba(71, 66, 84, 0.22),
        0 2px 6px -3px rgba(28, 29, 34, 0.08);
      min-height: 340px;
      overflow: hidden;
    }
    .dash-pair-head { display: flex; flex-direction: column; gap: 4px; }
    .dash-pair-eyebrow {
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: var(--english-violet);
    }
    .dash-pair-title {
      margin: 0;
      font-family: var(--serif);
      font-weight: 500;
      font-size: 22px;
      line-height: 1.2;
      letter-spacing: -0.01em;
      color: var(--ink);
    }

    /* Compact upcoming nav inside the half-width card */
    .upcoming-card .upcoming-nav {
      margin: 0 0 4px;
      padding: 10px 14px;
      box-shadow: none;
      background: rgba(71, 66, 84, 0.06);
      border-color: rgba(71, 66, 84, 0.14);
    }
    .upcoming-card .upcoming-nav-label { font-size: 15px; }
    .upcoming-card .upcoming-nav-btn { width: 26px; height: 26px; font-size: 12px; }
    .upcoming-card .upcoming-nav-today { padding: 4px 10px; font-size: 9px; }
    /* Inside the half-width card the week renders as a stacked list
       of days, not a 7-column strip. Day cells flow vertically. */
    .upcoming-card .upcoming-grid {
      grid-template-columns: 1fr;
      gap: 6px;
      max-height: 360px;
      overflow-y: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }
    .upcoming-card .upcoming-grid::-webkit-scrollbar { width: 0; display: none; }
    .upcoming-card .upcoming-day {
      flex-direction: row;
      align-items: center;
      gap: 14px;
      min-height: 0;
      padding: 10px 14px;
    }

    /* Members-blog feature on the right of the pair */
    .dash-blog-feature {
      padding: 0;
      text-decoration: none;
      color: var(--ink);
      transition: transform 0.3s cubic-bezier(.2,.7,.2,1), box-shadow 0.3s;
    }
    .dash-blog-feature:hover {
      transform: translateY(-3px);
      box-shadow:
        0 22px 44px -16px rgba(71, 66, 84, 0.40),
        0 8px 16px -8px rgba(28, 29, 34, 0.18);
    }
    .dash-blog-feature-art {
      position: relative;
      min-height: 200px;
      background-size: cover;
      background-position: center;
      background-color: var(--english-violet);
    }
    .dash-blog-feature-flag {
      position: absolute;
      top: 14px;
      left: 14px;
      padding: 5px 12px;
      background: rgba(15, 12, 30, 0.7);
      backdrop-filter: blur(6px);
      -webkit-backdrop-filter: blur(6px);
      color: var(--paper);
      border-radius: 999px;
      font-family: var(--sans);
      font-size: 10px;
      font-weight: 800;
      letter-spacing: 0.22em;
      text-transform: uppercase;
    }
    .dash-blog-feature-body {
      padding: 22px 26px 26px;
      display: flex;
      flex-direction: column;
      gap: 10px;
      flex: 1;
    }
    .dash-blog-feature-desc {
      margin: 0;
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.6;
      color: rgba(28, 29, 34, 0.66);
      flex: 1;
    }
    .dash-blog-feature-cta {
      font-family: var(--sans);
      font-size: 12px;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: var(--english-violet);
    }
    .dash-blog-feature-cta em { font-style: normal; display: inline-block; transition: transform 0.25s; }
    .dash-blog-feature:hover .dash-blog-feature-cta em { transform: translateX(4px); }

    /* ---------- Entry animation ----------
       Reads as the page being assembled in front of the user. Sidebar
       cascades in first, then the welcome hero drops in with a soft
       overshoot, then each content section rises up on its own beat.
       Triggered when body gets .is-loaded (set after the session check).
       Disabled for prefers-reduced-motion. */
    @keyframes slideInLeft {
      from { opacity: 0; transform: translateX(-60px); }
      to   { opacity: 1; transform: translateX(0); }
    }
    @keyframes slideDown {
      0%   { opacity: 0; transform: translateY(-80px) scale(0.97); }
      70%  { opacity: 1; }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(56px); }
      to   { opacity: 1; transform: translateY(0); }
    }

    .slide-in-left { opacity: 0; transform: translateX(-60px); }
    .slide-down    { opacity: 0; transform: translateY(-80px) scale(0.97); }
    .slide-up      { opacity: 0; transform: translateY(56px); }

    body.is-loaded .slide-in-left {
      animation: slideInLeft 1.2s cubic-bezier(.16,.78,.28,1) both;
    }
    body.is-loaded .slide-down {
      /* Slight overshoot easing so the hero "lands" rather than slides */
      animation: slideDown 1.5s cubic-bezier(.2,1.05,.35,1) both;
    }
    body.is-loaded .slide-up {
      animation: slideUp 1.3s cubic-bezier(.16,.78,.28,1) both;
    }

    /* Explicit per-element timing per animation type so different parts
       arrive at different rates (rather than a uniform 70ms march).

       Sidebar — cascades 0 -> 1.21s at 110ms per item:
         logo (0.00s) -> Workspace link -> ... -> Contact (1.10s)
         -> Signed-in chip + sign-out (1.21s)
       Welcome drops in mid-cascade (0.45s) so the chrome and the
       headline arrive together.
       Content sections then rise up one at a time after the welcome
       has settled. */
    body.is-loaded .slide-in-left[data-d="0"]  { animation-delay: 0.00s; }
    body.is-loaded .slide-in-left[data-d="1"]  { animation-delay: 0.14s; }
    body.is-loaded .slide-in-left[data-d="2"]  { animation-delay: 0.28s; }
    body.is-loaded .slide-in-left[data-d="3"]  { animation-delay: 0.42s; }
    body.is-loaded .slide-in-left[data-d="4"]  { animation-delay: 0.56s; }
    body.is-loaded .slide-in-left[data-d="5"]  { animation-delay: 0.70s; }
    body.is-loaded .slide-in-left[data-d="6"]  { animation-delay: 0.84s; }
    body.is-loaded .slide-in-left[data-d="7"]  { animation-delay: 0.98s; }
    body.is-loaded .slide-in-left[data-d="8"]  { animation-delay: 1.12s; }
    body.is-loaded .slide-in-left[data-d="9"]  { animation-delay: 1.26s; }
    body.is-loaded .slide-in-left[data-d="10"] { animation-delay: 1.40s; }
    body.is-loaded .slide-in-left[data-d="11"] { animation-delay: 1.54s; }
    body.is-loaded .slide-in-left[data-d="12"] { animation-delay: 1.68s; }

    body.is-loaded .slide-down { animation-delay: 0.55s; }

    body.is-loaded .slide-up[data-d="4"] { animation-delay: 1.70s; }
    body.is-loaded .slide-up[data-d="5"] { animation-delay: 2.10s; }
    body.is-loaded .slide-up[data-d="6"] { animation-delay: 2.50s; }
    body.is-loaded .slide-up[data-d="7"] { animation-delay: 2.90s; }

    @media (prefers-reduced-motion: reduce) {
      .slide-in-left, .slide-down, .slide-up {
        opacity: 1; transform: none; animation: none !important;
      }
    }


    /* ---------- Stats ---------- */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 18px;
    }
    @media (max-width: 980px) { .stats { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .stats { grid-template-columns: 1fr; } }
    .stat {
      position: relative;
      display: flex; flex-direction: column; gap: 6px;
      padding: 24px 26px 20px;
      background: #fff;
