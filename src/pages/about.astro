---
import BaseLayout from "../layouts/BaseLayout.astro";

const team = [
  {
    name: "Danni Law",
    role: "Operations Manager",
    image: "/assets/Danni%202.png",
  },
  {
    name: "Samantha Thornicroft",
    role: "Managing Director",
    image:
      "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=1200&q=80",
  },
  {
    name: "Abigail Saunders",
    role: "Social Media Manager",
    image: "/assets/abbie%202.png",
  },
];

const sofaImage = "/assets/Doors.jpg";

const togetherImage = "/assets/jungle.png";
---

<BaseLayout
  title="About — TMKE"
  description="TMKE is a marketing agency built specifically for agents who are tired of inconsistent, rushed, and underwhelming social media."
>
  <section class="about-hero">
    <img
      class="about-hero-video"
      src="/assets/about%20us.png"
      alt=""
      aria-hidden="true"
    />
    <div class="about-hero-overlay"></div>
    <div class="about-hero-vignette"></div>

    <div class="about-hero-inner">
      <div class="about-hero-chapter">/ TMKE /</div>
      <div class="about-hero-pron">
        <span class="about-hero-phonetic">/tiː.ɛm.keɪˈiː./</span>
        <span class="about-hero-pos"><em>noun</em></span>
      </div>

      <p class="about-hero-text">
        A marketing agency built specifically for <strong>agents</strong><br />
        who are tired of <strong>inconsistent</strong>, <strong>rushed</strong>, and
        <strong>underwhelming</strong> social media<br />
        that doesn't reflect the standard of their business.
      </p>

      <a href="#about-intro" class="about-hero-btn">Discover</a>
    </div>
  </section>

  <section class="about-intro" id="about-intro">
    <div class="about-intro-wrap">
      <div class="about-intro-grid">
        <div class="about-intro-copy">
          <p>
            Marketing should reflect the standard of your business, not just fill
            your feed.
          </p>
          <p class="about-intro-copy-body">
            Too much of what's out there is reactive, inconsistent, and
            created just to keep things ticking over, when in reality, social
            media only works when it's built to engage, start conversations, and
            add value.
          </p>
          <p class="about-intro-copy-body">
            You don't need to go viral to win locally, you need to understand
            your audience and show up consistently for them, in a way that
            actually feels human.
          </p>
        </div>

        <aside class="about-intro-aside">
          <h3>The People Behind TMKE</h3>
          <p>
            Built after seeing too many good agents held back by poor marketing
            &mdash; not for lack of caring, but for lack of time, structure, and
            direction. TMKE exists to change that.
          </p>
          <p>
            Unfiltered and straight talking, the team behind the brand have a
            sharp eye for detail, low tolerance for poor marketing, and just
            enough sarcasm to keep things interesting.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="about-team">
    <div class="about-team-wrap">
      {team.map((member) => (
        <article
          class="about-team-card"
          style={`background-image: url('${member.image}')`}
        >
          <div class="about-team-overlay">
            <div class="about-team-name">{member.name}</div>
            <div class="about-team-role">{member.role}</div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="about-method">
    <div class="about-method-wrap">
      <div class="about-method-text">
        <h2 class="about-method-title">
          Marketing isn't something you squeeze in when you have time.
        </h2>

        <p>It needs structure, intent, and consistency to actually work.</p>

        <p>
          Everything we do for our clients is planned, considered, and built to
          last, from understanding your audience to creating content that
          connects.
        </p>
      </div>

      <div
        class="about-method-image"
        style={`background-image: url('${sofaImage}')`}
        role="img"
        aria-label="An editorial scene — a set of doors"
      >
      </div>
    </div>

    <div class="about-method-caption">
      <p>
        Social platforms don't stand still. Algorithms shift, trends change, and
        what worked last month doesn't always work now. It takes testing,
        reviewing, and constant adjustment to get right, and that's a full-time
        job. One we understand isn't estate agency, which is exactly why we're
        here to support it.
      </p>
    </div>
  </section>

  <section class="about-together">
    <div
      class="about-together-bg"
      style={`background-image: url('${togetherImage}')`}
    >
    </div>
    <div class="about-together-blur"></div>
    <div class="about-together-overlay"></div>

    <div class="about-together-inner">
      <h2 class="about-together-title">
        <span class="about-together-small">Working</span>
        <span class="about-together-big">Together</span>
      </h2>

      <p class="about-together-lede">
        <strong>
          TMKE is built for estate agents who want to take their marketing
          seriously,<br />
          whether that's finding a better way to stay consistent or<br />
          hand it over completely.
        </strong>
      </p>

      <p class="about-together-body">
        We've created different ways to work with us, so you can choose what
        fits<br />
        your time, budget, and how involved you want to be. Because<br />
        better marketing shouldn't be out of reach.
      </p>

      <a href="/services" class="about-together-btn">Explore Our Services</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ============ About — hero ============ */
  .about-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--paper);
    background: #0e0d12;
  }
  .about-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.06);
    animation: hero-cinematic-drift 22s ease-in-out infinite alternate;
    will-change: transform;
    filter: saturate(0.9) contrast(1.05);
    pointer-events: none;
  }
  .about-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(14, 13, 18, 0.68) 0%,
        rgba(14, 13, 18, 0.58) 45%,
        rgba(14, 13, 18, 0.82) 100%
      );
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }
  .about-hero-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at center,
        rgba(14, 13, 18, 0) 28%,
        rgba(14, 13, 18, 0.5) 80%,
        rgba(14, 13, 18, 0.9) 100%
      );
  }
  .about-hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 180px 28px 140px;
    max-width: 800px;          /* shared hero text-column width (matches Social) */
    text-shadow: 0 1px 30px rgba(14, 13, 18, 0.55);
  }
  .about-hero-chapter {
    font-family: var(--serif);
    font-style: normal;
    font-weight: 500;
    font-size: 30px;
    letter-spacing: 0.02em;
    color: var(--paper);
    margin-bottom: 6px;
    text-shadow: 0 2px 24px rgba(14, 13, 18, 0.6);
  }
  /* Phonetic + part-of-speech now share one line. */
  .about-hero-pron {
    display: flex;
    justify-content: center;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 40px;
  }
  .about-hero-phonetic {
    font-family: var(--serif);
    font-size: clamp(14px, 1.1vw, 16px);
    letter-spacing: 0.04em;
    color: rgba(244, 242, 241, 0.78);
  }
  .about-hero-pos {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(13px, 1vw, 15px);
    color: rgba(244, 242, 241, 0.72);
  }
  .about-hero-text {
    font-family: var(--sans);
    font-size: clamp(13px, 1.3vw, 16px);
    font-weight: 400;
    line-height: 1.55;
    color: rgba(244, 242, 241, 0.95);
    margin: 0 0 28px;
  }
  .about-hero-text strong {
    font-weight: 700;
    color: var(--paper);
  }
  .about-hero-text:last-of-type {
    margin-bottom: 44px;
  }
  .about-hero-btn {
    display: inline-block;
    padding: 9px 30px;
    border: 1px solid rgba(244, 242, 241, 0.9);
    background: rgba(14, 13, 18, 0.25);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
    text-shadow: none;
  }
  .about-hero-btn:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  @keyframes hero-cinematic-drift {
    0%   { transform: scale(1.06) translate3d(0, 0, 0); }
    100% { transform: scale(1.12) translate3d(-1.5%, -1%, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-hero-video { animation: none; transform: scale(1.04); }
  }

  /* ============ About — intro split ============ */
  /* Intro split — laid out to mirror the Social page's "Managed for Estate
     Agents" section exactly: same 1360 content width, same 76px gutters, the
     prose stacked on the left and the aside pushed to the bottom-right as an
     editorial follow-on (rather than a parallel column), with matching type
     sizes and spacing so the two pages read as one system. */
  .about-intro {
    background: var(--paper);
    padding: 100px 76px 100px;
  }
  .about-intro-wrap {
    max-width: 1360px;
    margin: 0 auto;
  }
  .about-intro-eyebrow {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    color: var(--gunmetal);
    margin-bottom: 100px;
  }
  .about-intro-grid {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .about-intro-copy p {
    font-family: var(--subhead);
    font-weight: 400;
    font-size: var(--fs-quote);
    line-height: var(--lh-quote);
    color: var(--gunmetal);
    margin: 0 0 28px;
    max-width: 50%;
    letter-spacing: -0.005em;
  }
  .about-intro-copy p:last-child {
    margin-bottom: 0;
  }
  /* Supporting body copy under the Seasons lead — matches the "People Behind
     TMKE" aside paragraphs (sans, smaller). */
  .about-intro-copy p.about-intro-copy-body {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.7;
    color: rgba(28, 29, 34, 0.72);
    letter-spacing: 0;
    max-width: 50%;
    margin: 0 0 16px;
  }
  .about-intro-aside {
    align-self: flex-end;
    max-width: 420px;
  }
  .about-intro-aside h3 {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--gunmetal);
    margin: 0 0 8px;
    letter-spacing: 0;
  }
  .about-intro-aside p {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.7;
    color: rgba(28, 29, 34, 0.72);
    margin: 0 0 16px;
  }
  .about-intro-aside p:last-child {
    margin-bottom: 0;
  }

  /* ============ About — team cards ============ */
  .about-team {
    background: var(--paper);
    padding: 0 76px 0;
  }
  .about-team-wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }
  .about-team-card {
    position: relative;
    aspect-ratio: 3 / 5;
    background-color: var(--platinum);
    background-size: cover;
    background-position: center;
    overflow: hidden;
    color: var(--paper);
    isolation: isolate;
  }
  .about-team-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 18, 26, 0) 40%,
      rgba(20, 18, 26, 0.6) 70%,
      rgba(20, 18, 26, 0.92) 100%
    );
  }
  .about-team-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 32px 28px 36px;
  }
  .about-team-name {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1;
    margin-bottom: 10px;
    color: var(--paper);
  }
  .about-team-role {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: rgba(244, 242, 241, 0.82);
  }

  /* ============ About — method split ============ */
  .about-method {
    background: var(--paper);
    padding: 100px 76px 100px;
  }
  .about-method-wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    /* Image widened to ~2/3 so it matches the width of two team cards. */
    grid-template-columns: 1fr 2fr;
    gap: clamp(40px, 6vw, 100px);
    /* Text column top-aligned so the heading starts level with the top of
       the image. */
    align-items: start;
  }
  .about-method-text {
    padding-top: 0;
  }
  .about-method-title {
    font-family: var(--subhead);
    font-weight: 500;
    font-size: clamp(28px, 2.6vw, 38px);
    line-height: 1.2;
    color: var(--gunmetal);
    margin: 0 0 40px;
    letter-spacing: -0.005em;
  }
  .about-method-text p {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.7;
    color: var(--gunmetal);
    margin: 0 0 20px;
    max-width: 380px;
  }
  .about-method-text p:last-child {
    margin-bottom: 0;
  }
  .about-method-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    background-size: cover;
    background-position: center;
    background-color: var(--platinum);
    border-radius: 2px;
  }
  .about-method-caption {
    max-width: 1360px;
    margin: 48px auto 0;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(40px, 6vw, 100px);
  }
  .about-method-caption p {
    grid-column: 2 / 3;
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.75;
    color: var(--gunmetal);
    margin: 0;
    text-align: justify;
  }

  /* ============ About — Working Together CTA ============ */
  .about-together {
    position: relative;
    min-height: 64vh;            /* was 88vh — too tall */
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--paper);
    /* Inset frame so it reads as its own block, broken away from the
       full-bleed footer below (matches the home page treatment). */
    margin: 0 40px 64px;
  }
  .about-together-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  /* Darkening + blur fade from the left (behind the copy) out to roughly
     three-quarters across, leaving the right end of the photo clean and
     untouched. The blur lives on its own masked layer so it can fade out
     independently of the gradient. */
  .about-together-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(20, 18, 26, 0.82) 0%,
      rgba(20, 18, 26, 0.62) 32%,
      rgba(20, 18, 26, 0.3) 58%,
      rgba(20, 18, 26, 0) 78%
    );
  }
  .about-together-blur {
    position: absolute;
    inset: 0;
    pointer-events: none;
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    -webkit-mask-image: linear-gradient(
      90deg,
      #000 0%,
      #000 42%,
      rgba(0, 0, 0, 0) 75%
    );
    mask-image: linear-gradient(
      90deg,
      #000 0%,
      #000 42%,
      rgba(0, 0, 0, 0) 75%
    );
  }
  .about-together-inner {
    position: relative;
    z-index: 2;
    max-width: 1360px;
    width: 100%;
    margin: 0 auto;
    padding: 120px 36px 100px;
    color: var(--paper);
  }
  .about-together-title {
    font-family: var(--serif);
    font-weight: 400;
    margin: 0 0 48px;
    line-height: 0.98;
    color: rgba(244, 242, 241, 0.92);
    display: block;
  }
  .about-together-small {
    display: block;
    font-size: clamp(20px, 2vw, 28px);
    font-weight: 400;
    margin-left: 0;
    margin-bottom: 2px;
    color: rgba(244, 242, 241, 0.7);
  }
  /* "Together" sits flush to the inner left edge — the lede and body below
     share that same edge, so the block stays aligned at any size. */
  .about-together-big {
    display: block;
    font-size: clamp(48px, 6.5vw, 104px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .about-together-lede {
    font-family: var(--sans);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.7;
    color: var(--paper);
    margin: 0 0 28px;
    max-width: 760px;
  }
  .about-together-lede strong {
    font-weight: 700;
  }
  .about-together-body {
    font-family: var(--sans);
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.75;
    color: rgba(244, 242, 241, 0.88);
    margin: 0 0 44px;
    max-width: 760px;
  }
  .about-together-btn {
    display: inline-block;
    padding: 11px 36px;
    border-radius: 6px;
    border: 1px solid rgba(244, 242, 241, 0.85);
    background: transparent;
    color: var(--paper);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .about-together-btn:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }

  /* ============ About — responsive ============ */
  @media (max-width: 900px) {
    .about-intro-grid {
      gap: 32px;
    }
    .about-intro-aside { align-self: stretch; max-width: none; }
    .about-method-wrap { grid-template-columns: 1fr; }
    .about-method-text { padding-top: 0; }
    .about-method-caption { grid-template-columns: 1fr; }
    .about-method-caption p { grid-column: 1 / -1; }
  }

  @media (max-width: 720px) {
    .about-hero { min-height: 92vh; }
    .about-hero-inner { padding: 140px 22px 100px; }
    .about-intro { padding: 80px 22px 60px; }
    .about-intro-eyebrow { margin-bottom: 60px; }
    .about-team { padding: 40px 22px 60px; }
    .about-team-wrap { grid-template-columns: 1fr; gap: 4px; }
    .about-team-card { aspect-ratio: 4 / 5; }
    .about-method { padding: 60px 22px 80px; }
    .about-together { min-height: 58vh; margin: 0 22px 44px; }
    .about-together-inner { padding: 100px 22px 80px; }
    .about-together-small { margin-left: 24px; }
  }
</style>
