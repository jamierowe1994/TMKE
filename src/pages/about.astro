---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getImage } from "astro:assets";

const team = [
  {
    name: "Samantha Thornicroft",
    role: "Managing Director",
    // rests as stone; the video brings her to life, then settles on the real photo
    image: "https://assets.tmke.co.uk/TMKE%20About%20Us/ChatGPT%20Image%20Jun%2017%2C%202026%2C%2010_35_32%20AM.png",
    realImage: "https://assets.tmke.co.uk/TMKE%20About%20Us/Samantha%20-%20About%20Us.png",
    video: "https://assets.tmke.co.uk/TMKE%20About%20Us/Sam%20Stone%20video.mp4",
    bio: "Samantha founded TMKE on a simple belief: estate agents deserve marketing as polished as the homes they sell. She sets the standard and steers the strategy, so every client feels like the only one on the books.",
  },
  {
    name: "Danni Law",
    role: "Operations Manager",
    // rests as stone; the video brings her to life, then settles on the real photo
    image: "https://assets.tmke.co.uk/ChatGPT%20Image%20Jun%2017%2C%202026%2C%2007_00_42%20AM.png",
    realImage: "https://assets.tmke.co.uk/TMKE%20About%20Us/Danni%20-%20About%20Us.png",
    video: "https://assets.tmke.co.uk/stone%20danielle.mp4",
    bio: "Danni keeps TMKE running like clockwork — part planner, part problem-solver, she turns ambitious ideas into work that actually ships, on time and on brand. Whatever you need, she's already three steps ahead.",
  },
  {
    name: "Abigail Saunders",
    role: "Social Media Manager",
    // rests as stone; the video brings her to life, then settles on the real photo
    image: "https://assets.tmke.co.uk/TMKE%20About%20Us/ChatGPT%20Image%20Jun%2017%2C%202026%2C%2012_48_18%20PM.png",
    realImage: "https://assets.tmke.co.uk/TMKE%20About%20Us/Abbie%20-%20About%20Us.png",
    video: "https://assets.tmke.co.uk/TMKE%20About%20Us/hf_20260617_115426_89a97f8e-b976-418c-8fa7-c342c7fcc3df.mp4",
    bio: "Abigail lives where the scroll happens — turning listings into content that actually stops the thumb. Reels, captions, the lot: if it's on your feed and it's working, chances are it's hers.",
  },
];

// The real photos are 21–31 MB PNGs — optimise them (downscale + WebP) so the
// team grid loads and hovers smoothly. Each member.photo is the optimised src.
// NB: inferSize + width alone kept the original height (→ a tall centre-strip
// crop showing only heads). Give an explicit 3:4 output so the full portrait
// shows; sharp cover-crops the 3:4 originals with no loss.
const teamPhotos = await Promise.all(
  team.map((m) => getImage({ src: m.realImage, width: 900, height: 1200, quality: 72, format: "webp" }).then((r) => r.src))
);
team.forEach((m, i) => { m.photo = teamPhotos[i]; });

const sofaImage = "https://assets.tmke.co.uk/TMKE%20About%20Us/About%20Us%20-%20Section%203.png";

const togetherImage = "https://assets.tmke.co.uk/TMKE%20About%20Us/Insta%20Phone.png";

// "What We Do" service cards (images are placeholders from existing assets —
// swap for bespoke service imagery later).
// Client's "What We Do" card images (R2 PNGs) — optimised to the 3:4 card.
const SERVICE_IMG = await Promise.all(
  [1, 2, 3, 4].map((n) =>
    getImage({
      src: `https://assets.tmke.co.uk/TMKE%20About%20Us/About%20-%20Services%20${n}.png`,
      width: 700, height: 933, quality: 72, format: "webp",
    }).then((r) => r.src)
  )
);
const services = [
  { label: "Social Media Management", href: "/services", img: SERVICE_IMG[0] },
  { label: "Photography & Videography", href: "/videography", img: SERVICE_IMG[1] },
  { label: "Graphic Design & Content Creation", href: "/edit", img: SERVICE_IMG[2] },
  { label: "Website Development", href: "/contact", img: SERVICE_IMG[3] },
];
---

<BaseLayout
  title="About — TMKE"
  description="TMKE is a marketing agency built specifically for agents who are tired of inconsistent, rushed, and underwhelming social media."
>
  <section class="about-lede">
    <div class="about-lede-wrap">
      <div class="about-lede-grid">
        <div class="about-lede-copy">
          <div class="about-lede-top">
            <h1 class="about-lede-mark">TMKE</h1>
            <p class="about-lede-pron">
              <span class="about-lede-phon">/tiː.ɛm.keɪˈiː./</span>
              <span class="about-lede-pos"><em>noun</em></span>
            </p>
          </div>
          <div class="about-lede-bottom">
            <p class="about-lede-text">
              A marketing agency built specifically for <strong>agents</strong> who are
              tired of <strong>inconsistent</strong>, <strong>rushed</strong>, and
              <strong>underwhelming</strong> social media that doesn&rsquo;t reflect the
              standard of their business.
            </p>
            <a href="#about-intro" class="about-lede-btn">Discover <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
        <figure class="about-lede-media">
          <img
            src="https://assets.tmke.co.uk/TMKE%20About%20Us/Background.png"
            alt="The TMKE studio"
            loading="eager"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="about-team">
    <div class="about-team-wrap">
      {team.map((member) => (
        <article class="about-team-card">
          <div class="about-team-biopanel">
            <p class="about-team-bio">{member.bio}</p>
          </div>
          <div class="about-team-media" style={`background-image: url('${member.photo}')`}>
            <div class="about-team-overlay">
              <div class="about-team-name">{member.name}</div>
              <div class="about-team-role">{member.role}</div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="about-intro" id="about-intro">
    <div class="about-intro-wrap">
      <div class="about-intro-grid">
        <aside class="about-intro-aside">
          <h3>The Women Behind TMKE</h3>
          <p>
            Built after seeing too many good agents held back by poor marketing.
            Not for lack of caring, but for lack of time, structure, and
            direction. TMKE exists to change that.
          </p>
          <p>
            Unfiltered and straight talking, the team behind the brand have a
            sharp eye for detail, low tolerance for poor marketing, and just
            enough sarcasm to keep things interesting.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- Marketing — left copy, right image (the image becomes a video / effect later) -->
  <section class="about-marketing">
    <div class="about-marketing-wrap">
      <div class="about-marketing-text">
        <h2 class="about-marketing-h">
          Marketing should reflect the standard of your business.&ensp;Not just
          fill your feed.
        </h2>
        <p>
          Too much of what&rsquo;s out there is reactive, inconsistent, and
          created simply to keep things ticking over. The best marketing isn&rsquo;t
          about doing more. It&rsquo;s about understanding your audience, creating
          content with purpose, and showing up consistently.
        </p>
        <p>
          Whether we&rsquo;re building a brand, managing social media, designing
          marketing materials or producing video content, everything we create is
          designed to engage, start conversations, and add value. You don&rsquo;t
          need to go viral to grow locally. You need marketing that genuinely
          reflects the quality of your business.
        </p>
      </div>
      <div
        class="about-marketing-media"
        style={`background-image: url('${sofaImage}')`}
        role="img"
        aria-label="An editorial interior scene"
      ></div>
    </div>
  </section>

  <!-- Full-width feature — placeholder for a video / motion piece -->
  <section class="about-feature">
    <div class="about-feature-wrap">
      <div
        class="about-feature-media"
        style={`background-image: url('${sofaImage}')`}
        role="img"
        aria-label="An editorial interior scene"
      ></div>
    </div>
  </section>

  <!-- What We Do — services -->
  <section class="about-services">
    <div class="about-services-wrap">
      <h2 class="about-services-h">What We Do</h2>
      <p class="about-services-intro">
        From social media management and content creation to branding, design and
        websites, we help estate agents build marketing that&rsquo;s considered,
        consistent and built around their business.
      </p>
      <p class="about-services-intro">
        The way we work is shaped around your business, but the standard never
        changes. Everything we create is thoughtful, consistent and designed to
        reflect the quality of what you do.
      </p>
      <div class="about-services-grid">
        {services.map((s) => (
          <a class="about-service" href={s.href} style={`background-image: url('${s.img}')`}>
            <span class="about-service-label">{s.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>

<style is:global>
  /* One consistent vertical rhythm: the gap is carried by each section's TOP
     padding only (bottoms are 0), so every gap equals exactly one --about-gap —
     matching the header->first-section gap, never doubling up. */
  body { --about-gap: clamp(40px, 5vh, 56px); }

  /* ============ About — hero ============ */
  /* Light, editorial lede — left-aligned wordmark + copy, a contained image
     held to the right page margin. (No full-bleed dark hero; the nav keeps its
     default ink-on-transparent state because this isn't .about-hero.) */
  /* Section carries the 76px page gutter (matching every other section), so the
     1360 wrap centres and the right image lands on the same margin as the rest. */
  .about-lede {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    padding: clamp(84px, 10vh, 106px) 76px var(--about-gap);
  }
  .about-lede-wrap {
    max-width: 1360px;
    margin: 0 auto;
  }
  .about-lede-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(32px, 5vw, 80px);
    align-items: stretch;
  }
  /* Copy column matches the image height; the top pair sits against the image
     top, the bottom pair against its base. */
  .about-lede-copy {
    max-width: 480px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .about-lede-mark {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(40px, 4.6vw, 66px);
    line-height: 0.94;
    letter-spacing: 0.02em;
    margin: 0;
    color: var(--ink);
  }
  /* Phonetic + part-of-speech — the "small abbreviation" beneath the wordmark. */
  .about-lede-pron {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 12px 0 0;
  }
  .about-lede-phon {
    font-family: var(--serif);
    font-size: clamp(14px, 1.1vw, 17px);
    letter-spacing: 0.06em;
    color: rgba(28, 29, 34, 0.6);
  }
  .about-lede-pos {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(13px, 1vw, 15px);
    color: rgba(28, 29, 34, 0.5);
  }
  .about-lede-text {
    font-family: var(--sans);
    font-size: clamp(13px, 1vw, 15px);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(28, 29, 34, 0.78);
    margin: 0;
    max-width: 44ch;
  }
  .about-lede-text strong { font-weight: 600; color: var(--ink); }
  .about-lede-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 8px 24px;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: background 0.3s, color 0.3s;
  }
  .about-lede-btn:hover { background: var(--ink); color: var(--paper); }
  .about-lede-btn span { transition: transform 0.3s; }
  .about-lede-btn:hover span { transform: translateX(4px); }
  .about-lede-media {
    margin: 0;
    justify-self: end;
  }
  .about-lede-media img {
    display: block;
    height: clamp(300px, 36vh, 372px);
    width: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 2px;
  }
  @media (max-width: 860px) {
    .about-lede-grid { grid-template-columns: 1fr; gap: 32px; align-items: start; }
    .about-lede-copy { display: block; }
    .about-lede-bottom { margin-top: 26px; }
    .about-lede-media { justify-self: stretch; }
    .about-lede-media img { width: 100%; height: auto; aspect-ratio: 16 / 10; }
  }

  /* ============ About — intro split ============ */
  /* Intro split — laid out to mirror the Social page's "Managed for Estate
     Agents" section exactly: same 1360 content width, same 76px gutters, the
     prose stacked on the left and the aside pushed to the bottom-right as an
     editorial follow-on (rather than a parallel column), with matching type
     sizes and spacing so the two pages read as one system. */
  .about-intro {
    background: var(--paper);
    padding: var(--about-gap) 76px 0;
  }
  .about-intro-wrap {
    max-width: 1360px;
    margin: 0 auto;
  }
  .about-intro-eyebrow {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    color: var(--gunmetal);
    margin-bottom: 100px;
  }
  .about-intro-grid {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .about-intro-copy p {
    font-family: var(--subhead);
    font-weight: 400;
    font-size: var(--fs-quote);
    line-height: var(--lh-quote);
    color: var(--gunmetal);
    margin: 0 0 28px;
    max-width: 50%;
    letter-spacing: -0.005em;
  }
  .about-intro-copy p:last-child {
    margin-bottom: 0;
  }
  /* Supporting body copy under the Seasons lead — matches the "People Behind
     TMKE" aside paragraphs (sans, smaller). */
  .about-intro-copy p.about-intro-copy-body {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.7;
    color: rgba(28, 29, 34, 0.72);
    letter-spacing: 0;
    max-width: 50%;
    margin: 0 0 16px;
  }
  .about-intro-aside {
    align-self: flex-start;
    width: 70%;
    max-width: 70%;
  }
  .about-intro-aside h3 {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--gunmetal);
    margin: 0 0 8px;
    letter-spacing: 0;
  }
  .about-intro-aside p {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.7;
    color: rgba(28, 29, 34, 0.72);
    margin: 0;
  }

  /* ============ About — team cards ============ */
  .about-team {
    background: var(--paper);
    padding: 0 76px 0;
  }
  /* Three equal portrait cards. */
  .about-team-wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 4px;
  }
  /* Portrait card that squeezes to a square on hover, revealing the bio beneath.
     The card is a fixed 3:4 box; the photo is 100% tall at rest and 75% on hover
     (75% of a 3:4 box = a square), so the bottom quarter uncovers the bio. */
  .about-team-card {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--violet-deep);   /* deep brand purple revealed behind the bio */
    color: var(--paper);
    isolation: isolate;
  }
  /* Bio sits at the bottom, behind the photo; the photo uncovers it on hover. */
  .about-team-biopanel {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: flex;
    align-items: flex-end;
    padding: 0 28px 30px;
  }
  .about-team-bio {
    max-width: 36ch;
    font-family: var(--sans);
    font-size: clamp(13.5px, 1vw, 15px);
    line-height: 1.5;
    color: rgba(244, 242, 241, 0.9);
    margin: 0;
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s ease 0.12s, transform 0.7s cubic-bezier(.45,0,.18,1) 0.12s;
  }
  .about-team-card:hover .about-team-bio,
  .about-team-card:focus-within .about-team-bio { opacity: 1; transform: none; }

  /* The photo — full height at rest, square (75% of the 3:4 card) on hover. */
  .about-team-media {
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 100%;
    z-index: 1;
    background-size: cover;
    background-position: center top;
    background-color: var(--platinum);
    transition: height 0.75s cubic-bezier(.45,0,.18,1);
  }
  .about-team-card:hover .about-team-media,
  .about-team-card:focus-within .about-team-media { height: 75%; }
  .about-team-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20,18,26,0) 46%, rgba(20,18,26,0.6) 74%, rgba(20,18,26,0.9) 100%);
  }
  /* name + role pinned to the photo's bottom, so they ride up as it squeezes */
  .about-team-overlay {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    z-index: 2;
    padding: 28px 28px 22px;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45);
  }
  .about-team-name {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(22px, 2vw, 30px);
    line-height: 1;
    margin-bottom: 8px;
    color: var(--paper);
  }
  .about-team-role {
    font-family: var(--sans);
    font-size: 13px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: rgba(244, 242, 241, 0.82);
  }

  /* ============ About — marketing (left copy, right image) ============ */
  .about-marketing {
    background: var(--paper);
    /* Double gap above this section (People behind TMKE → Marketing). */
    padding: calc(var(--about-gap) * 2) 76px 0;
  }
  .about-marketing-wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(40px, 5vw, 88px);
    align-items: center;
  }
  /* Bottom-align the copy to the image (text base sits where the image ends) and
     keep it narrower than the column so it doesn't run to the image edge. */
  .about-marketing-text { align-self: end; max-width: 680px; }
  .about-marketing-h {
    font-family: var(--subhead);
    font-weight: 400;
    font-size: clamp(26px, 2.7vw, 40px);
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: var(--gunmetal);
    margin: 0 0 26px;
  }
  .about-marketing-text > p {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.75;
    color: rgba(28, 29, 34, 0.72);
    margin: 0 0 18px;
    text-align: justify;
  }
  .about-marketing-text > p:last-child { margin-bottom: 0; }
  .about-marketing-media {
    align-self: stretch;
    min-height: clamp(320px, 42vh, 480px);
    background-size: cover;
    background-position: center;
    background-color: var(--platinum);
    border-radius: 2px;
  }

  /* ============ About — full-width feature (future video) ============ */
  .about-feature {
    background: var(--paper);
    padding: var(--about-gap) 76px 0;
  }
  .about-feature-wrap { max-width: 1360px; margin: 0 auto; }
  .about-feature-media {
    width: 100%;
    aspect-ratio: 2 / 1;
    background-size: cover;
    background-position: center;
    background-color: var(--platinum);
    border-radius: 2px;
  }

  /* ============ About — services (What We Do) — last section before footer ============ */
  .about-services {
    background: var(--paper);
    /* Double gap above this section (landscape image → What We Do). */
    padding: calc(var(--about-gap) * 2) 76px clamp(60px, 9vh, 104px);
  }
  .about-services-wrap { max-width: 1360px; margin: 0 auto; }
  .about-services-h {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--gunmetal);
    margin: 0 0 16px;
  }
  .about-services-intro {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.75;
    color: rgba(28, 29, 34, 0.72);
    max-width: 70%;
    margin: 0;
  }
  .about-services-intro:last-of-type {
    margin-bottom: clamp(28px, 4vh, 46px);
  }
  .about-services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .about-service {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-color: var(--platinum);
    text-decoration: none;
    display: block;
    isolation: isolate;
  }
  .about-service::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28, 25, 22, 0) 42%, rgba(28, 25, 22, 0.68));
    transition: background 0.4s;
  }
  .about-service:hover::after {
    background: linear-gradient(180deg, rgba(28, 25, 22, 0.12) 28%, rgba(28, 25, 22, 0.8));
  }
  .about-service-label {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 1;
    color: var(--paper);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.35;
    max-width: 82%;
  }

  /* ============ About — method split ============ */
  .about-method {
    background: var(--paper);
    padding: 100px 76px 100px;
  }
  .about-method-wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    /* Image widened to ~2/3 so it matches the width of two team cards. */
    grid-template-columns: 1fr 2fr;
    gap: clamp(40px, 6vw, 100px);
    /* Text column top-aligned so the heading starts level with the top of
       the image. */
    align-items: start;
  }
  .about-method-text {
    padding-top: 0;
  }
  .about-method-title {
    font-family: var(--subhead);
    font-weight: 500;
    font-size: clamp(28px, 2.6vw, 38px);
    line-height: 1.2;
    color: var(--gunmetal);
    margin: 0 0 40px;
    letter-spacing: -0.005em;
  }
  .about-method-text p {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.7;
    color: var(--gunmetal);
    margin: 0 0 20px;
    max-width: 380px;
  }
  .about-method-text p:last-child {
    margin-bottom: 0;
  }
  .about-method-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    background-size: cover;
    background-position: center;
    background-color: var(--platinum);
    border-radius: 2px;
  }
  .about-method-caption {
    max-width: 1360px;
    margin: 48px auto 0;
    display: grid;
    grid-template-columns: 1fr 2fr;
    gap: clamp(40px, 6vw, 100px);
  }
  .about-method-caption p {
    grid-column: 2 / 3;
    font-family: var(--sans);
    font-size: 15px;
