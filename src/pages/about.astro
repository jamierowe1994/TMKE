---
import BaseLayout from "../layouts/BaseLayout.astro";

const team = [
  {
    name: "Danni Law",
    role: "Operations Manager",
    image:
      "https://images.unsplash.com/photo-1581338834647-b0fb40704e21?auto=format&fit=crop&w=1200&q=80",
  },
  {
    name: "Samantha Thornicroft",
    role: "Managing Director",
    image:
      "https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=1200&q=80",
  },
  {
    name: "Abigail Saunders",
    role: "Social Media Manager",
    image:
      "https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1200&q=80",
  },
];

const sofaImage =
  "https://images.unsplash.com/photo-1555041469-a586c61ea9bc?auto=format&fit=crop&w=1800&q=80";

const togetherImage =
  "https://images.unsplash.com/photo-1556656793-08538906a9f8?auto=format&fit=crop&w=2000&q=80";
---

<BaseLayout
  title="About — TMKE"
  description="TMKE is a marketing agency built specifically for estate agents who are tired of inconsistent, rushed, and underwhelming social media."
>
  <section class="about-hero">
    <video
      class="about-hero-video"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      aria-hidden="true"
    >
      <source src="/assets/laptop.mp4" type="video/mp4" />
    </video>
    <div class="about-hero-overlay"></div>
    <div class="about-hero-vignette"></div>

    <div class="about-hero-inner">
      <div class="about-hero-chapter">/ TMKE /</div>
      <div class="about-hero-phonetic">/tiː.ɛm.keɪˈiː./</div>
      <div class="about-hero-pos"><em>noun</em></div>

      <p class="about-hero-text">
        A marketing agency built specifically for <strong>estate agents</strong><br />
        who are tired of <strong>inconsistent</strong>, <strong>rushed</strong>, and
        <strong>underwhelming</strong> social media<br />
        that doesn't reflect the standard of their business.
      </p>

      <p class="about-hero-text">
        Born from seeing good agents held back by poor marketing,<br />
        not because they didn't care, but because they didn't have the
        <strong>time</strong>, <strong>structure</strong>,<br />
        or <strong>direction</strong> to do it properly.
      </p>

      <a href="#about-intro" class="about-hero-btn">Discover</a>
    </div>
  </section>

  <section class="about-intro" id="about-intro">
    <div class="about-intro-wrap">
      <div class="about-intro-eyebrow">The Marketing Experts</div>

      <div class="about-intro-grid">
        <div class="about-intro-copy">
          <p>
            Marketing should reflect the standard of your business, not just fill
            your feed. Too much of what's out there is reactive, inconsistent, and
            created just to keep things ticking over, when in reality, social
            media only works when it's built to engage, start conversations, and
            add value.
          </p>
          <p>
            You don't need to go viral to win locally, you need to understand
            your audience and show up consistently for them, in a way that
            actually feels human.
          </p>
        </div>

        <aside class="about-intro-aside">
          <h3>Meet the Leadership Team</h3>
          <p>
            Unfiltered, straight talking, and not here to dress things up, this
            is the team behind TMKE. We're dedicated to doing things right the
            first time, with a sharp eye for detail, a low tolerance for poor
            marketing, and just enough sarcasm to keep it interesting.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <section class="about-team">
    <div class="about-team-wrap">
      {team.map((member) => (
        <article
          class="about-team-card"
          style={`background-image: url('${member.image}')`}
        >
          <div class="about-team-overlay">
            <div class="about-team-name">{member.name}</div>
            <div class="about-team-role">{member.role}</div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="about-method">
    <div class="about-method-wrap">
      <div class="about-method-text">
        <h2 class="about-method-title">
          Marketing's isn't something you<br />
          squeeze in when you have time.
        </h2>

        <p>It needs structure, intent, and consistency to actually work.</p>

        <p>
          Everything we do for our clients is planned, considered, and built to
          last, from understanding your audience to creating content that
          connects.
        </p>
      </div>

      <div
        class="about-method-image"
        style={`background-image: url('${sofaImage}')`}
        role="img"
        aria-label="An editorial scene — a laptop resting on a linen sofa"
      >
      </div>
    </div>

    <div class="about-method-caption">
      <p>
        Social platforms don't stand still. Algorithms shift, trends change, and
        what worked last month doesn't always work now. It takes testing,
        reviewing, and constant adjustment to get right, and that's a full-time
        job. One we understand isn't estate agency, which is exactly why we're
        here to support it.
      </p>
    </div>
  </section>

  <section class="about-together">
    <div
      class="about-together-bg"
      style={`background-image: url('${togetherImage}')`}
    >
    </div>
    <div class="about-together-overlay"></div>

    <div class="about-together-inner">
      <h2 class="about-together-title">
        <span class="about-together-small">Working</span>
        <span class="about-together-big">Together</span>
      </h2>

      <p class="about-together-lede">
        <strong>
          TMKE is built for estate agents who want to take their marketing
          seriously, whether that's finding a better way to stay consistent or
          handing it over completely.
        </strong>
      </p>

      <p class="about-together-body">
        We've created different ways to work with us, so you can choose what
        fits your time, budget, and how involved you want to be. Because better
        marketing shouldn't be out of reach.
      </p>

      <a href="/services" class="about-together-btn">Explore Our Services</a>
    </div>
  </section>
</BaseLayout>

<style is:global>
  /* ============ About — hero ============ */
  .about-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--paper);
    background: #0e0d12;
  }
  .about-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.06);
    animation: hero-cinematic-drift 22s ease-in-out infinite alternate;
    will-change: transform;
    filter: saturate(0.9) contrast(1.05);
    pointer-events: none;
  }
  .about-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(14, 13, 18, 0.55) 0%,
        rgba(14, 13, 18, 0.45) 45%,
        rgba(14, 13, 18, 0.7) 100%
      );
  }
  .about-hero-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at center,
        rgba(14, 13, 18, 0) 28%,
        rgba(14, 13, 18, 0.5) 80%,
        rgba(14, 13, 18, 0.9) 100%
      );
  }
  .about-hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 180px 28px 140px;
    max-width: 880px;
    text-shadow: 0 1px 30px rgba(14, 13, 18, 0.55);
  }
  .about-hero-chapter {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(34px, 4vw, 56px);
    letter-spacing: 0.02em;
    color: var(--paper);
    margin-bottom: 18px;
    text-shadow: 0 2px 24px rgba(14, 13, 18, 0.6);
  }
  .about-hero-phonetic {
    font-family: var(--serif);
    font-size: clamp(14px, 1.1vw, 16px);
    letter-spacing: 0.04em;
    color: rgba(242, 239, 233, 0.78);
    margin-bottom: 4px;
  }
  .about-hero-pos {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(13px, 1vw, 15px);
    color: rgba(242, 239, 233, 0.72);
    margin-bottom: 40px;
  }
  .about-hero-text {
    font-family: var(--sans);
    font-size: clamp(15px, 1.3vw, 18px);
    font-weight: 400;
    line-height: 1.85;
    color: rgba(242, 239, 233, 0.95);
    margin: 0 0 28px;
  }
  .about-hero-text strong {
    font-weight: 700;
    color: var(--paper);
  }
  .about-hero-text:last-of-type {
    margin-bottom: 44px;
  }
  .about-hero-btn {
    display: inline-block;
    padding: 14px 30px;
    border: 1px solid rgba(242, 239, 233, 0.9);
    background: rgba(14, 13, 18, 0.25);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
    text-shadow: none;
  }
  .about-hero-btn:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  @keyframes hero-cinematic-drift {
    0%   { transform: scale(1.06) translate3d(0, 0, 0); }
    100% { transform: scale(1.12) translate3d(-1.5%, -1%, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .about-hero-video { animation: none; transform: scale(1.04); }
  }

  /* ============ About — intro split ============ */
  .about-intro {
    background: var(--paper);
    padding: 120px 28px 80px;
  }
  .about-intro-wrap {
    max-width: 1360px;
    margin: 0 auto;
  }
  .about-intro-eyebrow {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    color: var(--gunmetal);
    margin-bottom: 100px;
  }
  .about-intro-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: clamp(48px, 6vw, 120px);
    align-items: end;
  }
  .about-intro-copy p {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(22px, 2.1vw, 30px);
    line-height: 1.4;
    color: var(--gunmetal);
    margin: 0 0 32px;
    letter-spacing: -0.005em;
  }
  .about-intro-copy p:last-child {
    margin-bottom: 0;
  }
  .about-intro-aside {
    max-width: 460px;
    justify-self: end;
  }
  .about-intro-aside h3 {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--gunmetal);
    margin: 0 0 20px;
    letter-spacing: 0;
  }
  .about-intro-aside p {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.7;
    color: var(--gunmetal);
    margin: 0;
    text-align: justify;
  }

  /* ============ About — team cards ============ */
  .about-team {
    background: var(--paper);
    padding: 60px 28px 100px;
  }
  .about-team-wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }
  .about-team-card {
    position: relative;
    aspect-ratio: 3 / 5;
    background-color: var(--platinum);
    background-size: cover;
    background-position: center;
    overflow: hidden;
    color: var(--paper);
    isolation: isolate;
  }
  .about-team-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 18, 26, 0) 40%,
      rgba(20, 18, 26, 0.6) 70%,
      rgba(20, 18, 26, 0.92) 100%
    );
  }
  .about-team-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 32px 28px 36px;
  }
  .about-team-name {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1;
    margin-bottom: 10px;
    color: var(--paper);
  }
  .about-team-role {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: rgba(242, 239, 233, 0.82);
  }

  /* ============ About — method split ============ */
  .about-method {
    background: var(--paper);
    padding: 80px 28px 120px;
  }
  .about-method-wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(40px, 6vw, 100px);
    align-items: start;
  }
  .about-method-text {
    padding-top: 24px;
  }
  .about-method-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 2.6vw, 38px);
    line-height: 1.2;
    color: var(--gunmetal);
    margin: 0 0 40px;
    letter-spacing: -0.005em;
  }
  .about-method-text p {
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.7;
    color: var(--gunmetal);
    margin: 0 0 20px;
    max-width: 380px;
  }
  .about-method-text p:last-child {
    margin-bottom: 0;
  }
  .about-method-image {
    width: 100%;
    aspect-ratio: 16 / 10;
    background-size: cover;
    background-position: center;
    background-color: var(--platinum);
    border-radius: 2px;
  }
  .about-method-caption {
    max-width: 1360px;
    margin: 48px auto 0;
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: clamp(40px, 6vw, 100px);
  }
  .about-method-caption p {
    grid-column: 2 / 3;
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.75;
    color: var(--gunmetal);
    margin: 0;
    text-align: justify;
  }

  /* ============ About — Working Together CTA ============ */
  .about-together {
    position: relative;
    min-height: 88vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: var(--paper);
  }
  .about-together-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }
  .about-together-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(20, 18, 26, 0.55) 0%,
      rgba(20, 18, 26, 0.35) 50%,
      rgba(20, 18, 26, 0.2) 100%
    );
  }
  .about-together-inner {
    position: relative;
    z-index: 2;
    max-width: 1360px;
    width: 100%;
    margin: 0 auto;
    padding: 120px 36px 100px;
    color: var(--paper);
  }
  .about-together-title {
    font-family: var(--serif);
    font-weight: 400;
    margin: 0 0 80px;
    line-height: 0.9;
    color: rgba(242, 239, 233, 0.6);
    display: block;
  }
  .about-together-small {
    display: block;
    font-size: clamp(28px, 3vw, 42px);
    font-weight: 400;
    margin-left: clamp(40px, 6vw, 100px);
    margin-bottom: -10px;
  }
  .about-together-big {
    display: block;
    font-size: clamp(80px, 14vw, 220px);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .about-together-lede {
    font-family: var(--sans);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.7;
    color: var(--paper);
    margin: 0 0 28px;
    max-width: 760px;
  }
  .about-together-lede strong {
    font-weight: 700;
  }
  .about-together-body {
    font-family: var(--sans);
    font-size: clamp(14px, 1.1vw, 16px);
    line-height: 1.75;
    color: rgba(242, 239, 233, 0.88);
    margin: 0 0 44px;
    max-width: 760px;
  }
  .about-together-btn {
    display: inline-block;
    padding: 16px 36px;
    border: 1px solid rgba(242, 239, 233, 0.85);
    background: transparent;
    color: var(--paper);
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
  }
  .about-together-btn:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }

  /* ============ About — responsive ============ */
  @media (max-width: 900px) {
    .about-intro-grid {
      grid-template-columns: 1fr;
      gap: 48px;
      align-items: start;
    }
    .about-intro-aside { justify-self: start; max-width: 100%; }
    .about-method-wrap { grid-template-columns: 1fr; }
    .about-method-text { padding-top: 0; }
    .about-method-caption { grid-template-columns: 1fr; }
    .about-method-caption p { grid-column: 1 / -1; }
  }

  @media (max-width: 720px) {
    .about-hero { min-height: 92vh; }
    .about-hero-inner { padding: 140px 22px 100px; }
    .about-intro { padding: 80px 22px 60px; }
    .about-intro-eyebrow { margin-bottom: 60px; }
    .about-team { padding: 40px 22px 60px; }
    .about-team-wrap { grid-template-columns: 1fr; gap: 4px; }
    .about-team-card { aspect-ratio: 4 / 5; }
    .about-method { padding: 60px 22px 80px; }
    .about-together { min-height: 80vh; }
    .about-together-inner { padding: 100px 22px 80px; }
    .about-together-small { margin-left: 24px; }
  }
</style>
