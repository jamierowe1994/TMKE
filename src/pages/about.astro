---
import BaseLayout from "../layouts/BaseLayout.astro";

const team = [
  {
    name: "Samantha Thornicroft",
    role: "Managing Director",
    // rests as stone; the video brings her to life, then settles on the real photo
    image: "https://assets.tmke.co.uk/TMKE%20About%20Us/ChatGPT%20Image%20Jun%2017%2C%202026%2C%2010_35_32%20AM.png",
    realImage: "https://assets.tmke.co.uk/TMKE%20About%20Us/Samantha%20-%20About%20Us.png",
    video: "https://assets.tmke.co.uk/TMKE%20About%20Us/Sam%20Stone%20video.mp4",
    bio: "Samantha founded TMKE on a simple belief: estate agents deserve marketing as polished as the homes they sell. She sets the standard and steers the strategy, so every client feels like the only one on the books.",
  },
  {
    name: "Danni Law",
    role: "Operations Manager",
    // rests as stone; the video brings her to life, then settles on the real photo
    image: "https://assets.tmke.co.uk/ChatGPT%20Image%20Jun%2017%2C%202026%2C%2007_00_42%20AM.png",
    realImage: "https://assets.tmke.co.uk/TMKE%20About%20Us/Danni%20-%20About%20Us.png",
    video: "https://assets.tmke.co.uk/stone%20danielle.mp4",
    bio: "Danni keeps TMKE running like clockwork — part planner, part problem-solver, she turns ambitious ideas into work that actually ships, on time and on brand. Whatever you need, she's already three steps ahead.",
  },
  {
    name: "Abigail Saunders",
    role: "Social Media Manager",
    // rests as stone; the video brings her to life, then settles on the real photo
    image: "https://assets.tmke.co.uk/TMKE%20About%20Us/ChatGPT%20Image%20Jun%2017%2C%202026%2C%2012_48_18%20PM.png",
    realImage: "https://assets.tmke.co.uk/TMKE%20About%20Us/Abbie%20-%20About%20Us.png",
    video: "https://assets.tmke.co.uk/TMKE%20About%20Us/hf_20260617_115426_89a97f8e-b976-418c-8fa7-c342c7fcc3df.mp4",
    bio: "Abigail lives where the scroll happens — turning listings into content that actually stops the thumb. Reels, captions, the lot: if it's on your feed and it's working, chances are it's hers.",
  },
];

const sofaImage = "https://assets.tmke.co.uk/TMKE%20About%20Us/About%20Us%20-%20Section%203.png";

const togetherImage = "https://assets.tmke.co.uk/TMKE%20About%20Us/Insta%20Phone.png";

// "What We Do" service cards (images are placeholders from existing assets —
// swap for bespoke service imagery later).
const services = [
  { label: "Social Media Management", href: "/services", img: "/assets/social%20media.jpg" },
  { label: "Photography & Videography", href: "/videography", img: "/assets/home%20video.jpg" },
  { label: "Graphic Design & Content Creation", href: "/edit", img: "/assets/vibes.jpg" },
  { label: "Website Development", href: "/contact", img: "/assets/podcast-studio.jpeg" },
];
---

<BaseLayout
  title="About — TMKE"
  description="TMKE is a marketing agency built specifically for agents who are tired of inconsistent, rushed, and underwhelming social media."
>
  <section class="about-lede">
    <div class="about-lede-wrap">
      <div class="about-lede-grid">
        <div class="about-lede-copy">
          <div class="about-lede-top">
            <h1 class="about-lede-mark">TMKE</h1>
            <p class="about-lede-pron">
              <span class="about-lede-phon">/tiː.ɛm.keɪˈiː./</span>
              <span class="about-lede-pos"><em>noun</em></span>
            </p>
          </div>
          <div class="about-lede-bottom">
            <p class="about-lede-text">
              A marketing agency built specifically for <strong>agents</strong> who are
              tired of <strong>inconsistent</strong>, <strong>rushed</strong>, and
              <strong>underwhelming</strong> social media that doesn&rsquo;t reflect the
              standard of their business.
            </p>
            <a href="#about-intro" class="about-lede-btn">Discover <span aria-hidden="true">&rarr;</span></a>
          </div>
        </div>
        <figure class="about-lede-media">
          <img
            src="https://assets.tmke.co.uk/TMKE%20About%20Us/Background.png"
            alt="The TMKE studio"
            loading="eager"
          />
        </figure>
      </div>
    </div>
  </section>

  <section class="about-team">
    <div class="about-team-wrap">
      {team.map((member, i) => (
        i === 0 ? (
          <article
            class={`about-team-card about-team-card--feature${member.video ? " has-video" : ""}`}
            style={`background-image: url('${member.image}')`}
          >
            {member.video && (
              <video
                class="about-team-video"
                src={member.video}
                poster={member.image}
                muted
                playsinline
                preload="none"
                aria-hidden="true"
              ></video>
            )}
            {member.realImage && (
              <img class="about-team-real" src={member.realImage} alt={member.name} />
            )}
            <div class="about-team-overlay">
              <div class="about-team-name">{member.name}</div>
              <div class="about-team-role">{member.role}</div>
              {member.bio && <p class="about-team-bio">{member.bio}</p>}
            </div>
          </article>
        ) : (
          <article
            class="about-team-card"
            style={`background-image: url('${member.realImage}')`}
          >
            <div class="about-team-overlay">
              <div class="about-team-name">{member.name}</div>
              <div class="about-team-role">{member.role}</div>
              {member.bio && <p class="about-team-bio">{member.bio}</p>}
            </div>
          </article>
        )
      ))}
    </div>
  </section>

  <section class="about-intro" id="about-intro">
    <div class="about-intro-wrap">
      <div class="about-intro-grid">
        <aside class="about-intro-aside">
          <h3>The People Behind TMKE</h3>
          <p>
            Built after seeing too many good agents held back by poor marketing.
            Not for lack of caring, but for lack of time, structure, and
            direction. TMKE exists to change that.
          </p>
          <p>
            Unfiltered and straight talking, the team behind the brand have a
            sharp eye for detail, low tolerance for poor marketing, and just
            enough sarcasm to keep things interesting.
          </p>
        </aside>
      </div>
    </div>
  </section>

  <!-- Marketing — left copy, right image (the image becomes a video / effect later) -->
  <section class="about-marketing">
    <div class="about-marketing-wrap">
      <div class="about-marketing-text">
        <h2 class="about-marketing-h">
          Marketing should reflect the standard of your business.&ensp;Not just
          fill your feed.
        </h2>
        <p>
          Too much of what&rsquo;s out there is reactive, inconsistent, and
          created simply to keep things ticking over. The best marketing isn&rsquo;t
          about doing more. It&rsquo;s about understanding your audience, creating
          content with purpose, and showing up consistently.
        </p>
        <p>
          Whether we&rsquo;re building a brand, managing social media, designing
          marketing materials or producing video content, everything we create is
          designed to engage, start conversations, and add value. You don&rsquo;t
          need to go viral to grow locally. You need marketing that genuinely
          reflects the quality of your business.
        </p>
      </div>
      <div
        class="about-marketing-media"
        style={`background-image: url('${sofaImage}')`}
        role="img"
        aria-label="An editorial interior scene"
      ></div>
    </div>
  </section>

  <!-- Full-width feature — placeholder for a video / motion piece -->
  <section class="about-feature">
    <div class="about-feature-wrap">
      <div
        class="about-feature-media"
        style={`background-image: url('${sofaImage}')`}
        role="img"
        aria-label="An editorial interior scene"
      ></div>
    </div>
  </section>

  <!-- What We Do — services -->
  <section class="about-services">
    <div class="about-services-wrap">
      <h2 class="about-services-h">What We Do</h2>
      <p class="about-services-intro">
        Every business is different, which is why our services are designed to
        work together or independently.<br />Whether you need ongoing social media
        management, a stronger brand, fresh content or a new website, we&rsquo;re
        here to help you market your business with confidence.
      </p>
      <div class="about-services-grid">
        {services.map((s) => (
          <a class="about-service" href={s.href} style={`background-image: url('${s.img}')`}>
            <span class="about-service-label">{s.label}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="about-together">
    <div
      class="about-together-bg"
      style={`background-image: url('${togetherImage}')`}
    >
    </div>
    <div class="about-together-blur"></div>
    <div class="about-together-overlay"></div>

    <div class="about-together-inner">
      <h2 class="about-together-title">
        <span class="about-together-small">Working</span>
        <span class="about-together-big">Together</span>
      </h2>

      <p class="about-together-lede">
        <strong>
          TMKE is built for estate agents who want to take their marketing
          seriously,<br />
          whether that's finding a better way to stay consistent or<br />
          hand it over completely.
        </strong>
      </p>

      <p class="about-together-body">
        We've created different ways to work with us, so you can choose what
        fits<br />
        your time, budget, and how involved you want to be. Because<br />
        better marketing shouldn't be out of reach.
      </p>

      <a href="/services" class="about-together-btn">Explore Our Services</a>
    </div>
  </section>

  <script>
    // "Bring her to life": stone at rest → hover plays the morph (fast, pauses at
    // the end) → seamlessly settles on the real photo + bio, and STAYS alive.
    const RATE = 2.2;
    document.querySelectorAll(".about-team-card.has-video").forEach((card) => {
      const v = card.querySelector(".about-team-video");
      const real = card.querySelector(".about-team-real");
      if (!v) return;
      // preload the real photo so the swap can't flicker
      if (real) { const im = new Image(); im.src = real.currentSrc || real.src; }

      let started = false, alive = false, bioOpen = false;
      // halfway through the morph (as she turns to colour) the name nudges up and
      // the bio opens beneath it, staying in the bottom of the photo
      v.addEventListener("timeupdate", () => {
        if (!bioOpen && v.duration && v.currentTime >= v.duration * 0.5) {
          bioOpen = true; card.classList.add("is-bio");
        }
      });
      v.addEventListener("ended", () => {
        // hold the last frame; reveal the matching photo over it
        card.classList.add("is-alive");
        alive = true;
      });
      card.addEventListener("mouseenter", () => {
        if (started || alive) return;   // one-way — the first hover commits
        started = true;
        card.classList.add("is-playing");
        v.playbackRate = RATE;
        try { v.currentTime = 0; } catch (_) {}
        const p = v.play();
        if (p && p.catch) p.catch(() => {});
        v.addEventListener("loadedmetadata", () => { v.playbackRate = RATE; }, { once: true });
      });
    });
  </script>
</BaseLayout>

<style is:global>
  /* One consistent vertical rhythm between the stacked paper sections: each
     section pads top + bottom by this, so every gap reads the same. */
  body { --about-gap: clamp(34px, 4.4vh, 44px); }

  /* ============ About — hero ============ */
  /* Light, editorial lede — left-aligned wordmark + copy, a contained image
     held to the right page margin. (No full-bleed dark hero; the nav keeps its
     default ink-on-transparent state because this isn't .about-hero.) */
  /* Section carries the 76px page gutter (matching every other section), so the
     1360 wrap centres and the right image lands on the same margin as the rest. */
  .about-lede {
    position: relative;
    background: var(--paper);
    color: var(--ink);
    padding: clamp(84px, 10vh, 106px) 76px clamp(40px, 5vh, 56px);
  }
  .about-lede-wrap {
    max-width: 1360px;
    margin: 0 auto;
  }
  .about-lede-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: clamp(32px, 5vw, 80px);
    align-items: stretch;
  }
  /* Copy column matches the image height; the top pair sits against the image
     top, the bottom pair against its base. */
  .about-lede-copy {
    max-width: 480px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }
  .about-lede-mark {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(40px, 4.6vw, 66px);
    line-height: 0.94;
    letter-spacing: 0.02em;
    margin: 0;
    color: var(--ink);
  }
  /* Phonetic + part-of-speech — the "small abbreviation" beneath the wordmark. */
  .about-lede-pron {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin: 12px 0 0;
  }
  .about-lede-phon {
    font-family: var(--serif);
    font-size: clamp(14px, 1.1vw, 17px);
    letter-spacing: 0.06em;
    color: rgba(28, 29, 34, 0.6);
  }
  .about-lede-pos {
    font-family: var(--serif);
    font-style: italic;
    font-size: clamp(13px, 1vw, 15px);
    color: rgba(28, 29, 34, 0.5);
  }
  .about-lede-text {
    font-family: var(--sans);
    font-size: clamp(13px, 1vw, 15px);
    font-weight: 400;
    line-height: 1.6;
    color: rgba(28, 29, 34, 0.78);
    margin: 0;
    max-width: 44ch;
  }
  .about-lede-text strong { font-weight: 600; color: var(--ink); }
  .about-lede-btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 20px;
    padding: 8px 24px;
    border: 1px solid var(--ink);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    transition: background 0.3s, color 0.3s;
  }
  .about-lede-btn:hover { background: var(--ink); color: var(--paper); }
  .about-lede-btn span { transition: transform 0.3s; }
  .about-lede-btn:hover span { transform: translateX(4px); }
  .about-lede-media {
    margin: 0;
    justify-self: end;
  }
  .about-lede-media img {
    display: block;
    height: clamp(300px, 36vh, 372px);
    width: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 2px;
  }
  @media (max-width: 860px) {
    .about-lede-grid { grid-template-columns: 1fr; gap: 32px; align-items: start; }
    .about-lede-copy { display: block; }
    .about-lede-bottom { margin-top: 26px; }
    .about-lede-media { justify-self: stretch; }
    .about-lede-media img { width: 100%; height: auto; aspect-ratio: 16 / 10; }
  }

  /* ============ About — intro split ============ */
  /* Intro split — laid out to mirror the Social page's "Managed for Estate
     Agents" section exactly: same 1360 content width, same 76px gutters, the
     prose stacked on the left and the aside pushed to the bottom-right as an
     editorial follow-on (rather than a parallel column), with matching type
     sizes and spacing so the two pages read as one system. */
  .about-intro {
    background: var(--paper);
    padding: var(--about-gap) 76px var(--about-gap);
  }
  .about-intro-wrap {
    max-width: 1360px;
    margin: 0 auto;
  }
  .about-intro-eyebrow {
    font-family: var(--serif);
    font-style: italic;
    font-size: 16px;
    color: var(--gunmetal);
    margin-bottom: 100px;
  }
  .about-intro-grid {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .about-intro-copy p {
    font-family: var(--subhead);
    font-weight: 400;
    font-size: var(--fs-quote);
    line-height: var(--lh-quote);
    color: var(--gunmetal);
    margin: 0 0 28px;
    max-width: 50%;
    letter-spacing: -0.005em;
  }
  .about-intro-copy p:last-child {
    margin-bottom: 0;
  }
  /* Supporting body copy under the Seasons lead — matches the "People Behind
     TMKE" aside paragraphs (sans, smaller). */
  .about-intro-copy p.about-intro-copy-body {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.7;
    color: rgba(28, 29, 34, 0.72);
    letter-spacing: 0;
    max-width: 50%;
    margin: 0 0 16px;
  }
  .about-intro-aside {
    align-self: flex-start;
    width: 70%;
    max-width: 70%;
  }
  .about-intro-aside h3 {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--gunmetal);
    margin: 0 0 8px;
    letter-spacing: 0;
  }
  .about-intro-aside p {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.7;
    color: rgba(28, 29, 34, 0.72);
    margin: 0;
  }

  /* ============ About — team cards ============ */
  .about-team {
    background: var(--paper);
    padding: 0 76px 0;
  }
  /* One half-width feature (video) on the left, two smaller image cards stacked
     on the right. */
  .about-team-wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 4px;
    height: clamp(440px, 58vh, 640px);
  }
  .about-team-card {
    position: relative;
    min-height: 0;
    background-color: var(--platinum);
    background-size: cover;
    background-position: center;
    overflow: hidden;
    color: var(--paper);
    isolation: isolate;
  }
  .about-team-card--feature { grid-column: 1; }
  /* Danni's card: stone (card bg) → video morph → settles on the real photo.
     Layers stack: video over the stone bg, real photo over the video. */
  .about-team-video,
  .about-team-real {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }
  .about-team-video { transition: opacity 0.3s ease; }
  .about-team-real { transition: opacity 0.45s ease; }
  /* video shows once it's playing and stays underneath after; the real photo
     fades in over the held last frame (they match → no flicker) and persists */
  .about-team-card.is-playing .about-team-video,
  .about-team-card.is-alive .about-team-video { opacity: 1; }
  .about-team-card.is-alive .about-team-real { opacity: 1; }
  .about-team-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 18, 26, 0) 40%,
      rgba(20, 18, 26, 0.6) 70%,
      rgba(20, 18, 26, 0.92) 100%
    );
  }
  .about-team-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 32px 28px 36px;
    text-shadow: 0 1px 14px rgba(0, 0, 0, 0.45);
  }
  .about-team-name {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(24px, 2.2vw, 32px);
    line-height: 1;
    margin-bottom: 10px;
    color: var(--paper);
  }
  .about-team-role {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.02em;
    color: rgba(244, 242, 241, 0.82);
  }
  /* bio sits just BELOW the name block (out of flow, so the name stays bottom-
     aligned with the other cards); it travels up with the name and is revealed */
  /* bio stays in flow but collapsed at rest (so name/role bottom-align with the
     other cards); opening it grows the bottom-anchored overlay UPWARD, nudging
     the name up just enough to make room — all kept in the bottom of the photo */
  .about-team-bio {
    overflow: hidden;
    max-height: 0;
    margin-top: 0;
    max-width: 40ch;
    font-family: var(--sans);
    font-size: 15.5px;
    line-height: 1.5;
    color: rgba(244, 242, 241, 0.92);
    opacity: 0;
    transition: max-height 0.55s ease, margin-top 0.55s ease, opacity 0.45s ease 0.15s;
  }
  .about-team-card.is-bio .about-team-bio { max-height: 8em; margin-top: 14px; opacity: 1; }

  /* ============ About — marketing (left copy, right image) ============ */
  .about-marketing {
    background: var(--paper);
    padding: var(--about-gap) 76px var(--about-gap);
  }
  .about-marketing-wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: clamp(40px, 5vw, 88px);
    align-items: center;
  }
  .about-marketing-h {
    font-family: var(--subhead);
    font-weight: 400;
    font-size: clamp(26px, 2.7vw, 40px);
    line-height: 1.16;
    letter-spacing: -0.01em;
    color: var(--gunmetal);
    margin: 0 0 26px;
  }
  .about-marketing-text > p {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.75;
    color: rgba(28, 29, 34, 0.72);
    margin: 0 0 18px;
  }
  .about-marketing-text > p:last-child { margin-bottom: 0; }
  .about-marketing-media {
    align-self: stretch;
    min-height: clamp(320px, 42vh, 480px);
    background-size: cover;
    background-position: center;
    background-color: var(--platinum);
    border-radius: 2px;
  }

  /* ============ About — full-width feature (future video) ============ */
  .about-feature {
    background: var(--paper);
    padding: var(--about-gap) 76px var(--about-gap);
  }
  .about-feature-wrap { max-width: 1360px; margin: 0 auto; }
  .about-feature-media {
    width: 100%;
    aspect-ratio: 2 / 1;
    background-size: cover;
    background-position: center;
    background-color: var(--platinum);
    border-radius: 2px;
  }

  /* ============ About — services (What We Do) ============ */
  .about-services {
    background: var(--paper);
    padding: var(--about-gap) 76px clamp(48px, 7vh, 80px);
  }
  .about-services-wrap { max-width: 1360px; margin: 0 auto; }
  .about-services-h {
    font-family: var(--sans);
    font-size: 16px;
    font-weight: 700;
    color: var(--gunmetal);
    margin: 0 0 16px;
  }
  .about-services-intro {
    font-family: var(--sans);
    font-size: 14px;
    line-height: 1.75;
    color: rgba(28, 29, 34, 0.72);
    text-align: justify;
    margin: 0 0 clamp(28px, 4vh, 46px);
  }
  .about-services-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 4px;
  }
  .about-service {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-color: var(--platinum);
    text-decoration: none;
    display: block;
    isolation: isolate;
  }
  .about-service::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(28, 25, 22, 0) 42%, rgba(28, 25, 22, 0.68));
    transition: background 0.4s;
  }
  .about-service:hover::after {
    background: linear-gradient(180deg, rgba(28, 25, 22, 0.12) 28%, rgba(28, 25, 22, 0.8));
  }
  .about-service-label {
    position: absolute;
    left: 18px;
    bottom: 18px;
    z-index: 1;
    color: var(--paper);
