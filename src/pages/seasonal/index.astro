---
// /seasonal goes to the current seasonal page (src/data/seasonal.js), so one
// link can be used season after season. With nothing current, /join.
import { currentSeasonal } from "../../data/seasonal.js";
const s = currentSeasonal();
const to = s ? `/seasonal/${s.slug}` : "/join";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <link rel="canonical" href={to} />
    <title>TMKE</title>
    <script is:inline define:vars={{ to }}>location.replace(to + location.search);</script>
  </head>
  <body></body>
</html>
