---
/**
 * A Clearer Way — the Member Hub, shown as a short film that plays itself.
 *
 * Two journeys, not a list of features: "I need something to post" and
 * "I want to get better at this". Each scene is a real screen from the hub
 * with one headline and one line. The film runs on its own with a progress
 * strip along the top; tap or arrow to move, hold or press space to pause.
 * Public and unlisted, meant to be linked from emails.
 *
 * Scenes are the SCENES array below. `img` is a JPEG in /public/hub-tour
 * (captured from the hub's demo views); `focus` is where the slow drift
 * settles (CSS object-position); `kind` "card" scenes carry no picture.
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import { EVERGREEN_PROMPTS, CONTENT_DAYS } from "../data/content-calendar.js";

// Part 01 follows Dani's Canva boards (10 Sep 2026): a mission card, the
// prompts as a wall of wine cards that flash in and dim behind the box, The
// Edit as a wall of templates that does the same, the assistant's box and a
// phone of the chat, then the Studio behind Make it yours and Get creative.
const labelOf = (brief, extra) => extra ? "Reel" : /carousel/i.test(brief || "") ? "Carousel" : "Post";
const PROMPT_CARDS = [
  ...EVERGREEN_PROMPTS.map((p) => ({ label: labelOf(p[1], p[2]), title: p[0] })),
  ...CONTENT_DAYS.filter((d) => ["Clocks Go Back", "World Mental Health Day"].includes(d.name)).map((d) => ({ label: labelOf(d.brief, d.video), title: d.angle })),
].slice(0, 18);
const T = (n) => `https://assets.tmke.co.uk/TMKE%20Home%20Page/Templates/${n}.png`;
// Eighteen slots: the thirteen template shots the homepage carries, then five
// of them again, kept apart, until there are more to use.
const EDIT_TILES = [T(1), T(5), T(9), T(4), T(12), T(2), T(8), T(6), T(7), T(10), T(13), T(3), T(11), T(1), T(4), T(9), T(2), T(6)];
// The prompt cards appear in a scattered order, not one after another.
const SCATTER = [7, 2, 13, 0, 10, 5, 16, 3, 11, 8, 1, 15, 6, 12, 4, 17, 9, 14];
const MISSION_PHOTOS = ["/assets/signup/1.webp", "/assets/signup/4.webp", "/assets/signup/8.webp"];
const MISSION_PHOTOS_2 = ["/assets/signup/5.webp", "/assets/signup/3.webp", "/assets/signup/6.webp"];
const C = (n) => `/hub-tour/course-${n}.jpg`;
const COURSES = [C("getting-started"), C("5-minutes"), C("before-you-post"), C("instagram"), C("reels"), C("certificate")];
// The mission-complete grid, in Dani's order. Three of her tiles (Maybe Next
// Year, the quote, Conversation) are not on the asset host yet; the homepage
// templates 6, 8 and 11 stand in for them.
const DONE_TILES = [C("getting-started"), C("5-minutes"), T(6), T(12), T(8), C("before-you-post"), T(11), C("instagram"), C("certificate")];

const SCENES = [
  { kind: "card", eyebrow: "The TMKE Member Hub", h: "It doesn’t give estate agents more marketing tools.", p: "It gives them a clearer way to actually do their marketing.", secs: 6.5 },

  { kind: "mission", n: "1 | 2", objective: "Create your next post", goals: ["Find the idea.", "Create the content.", "Make it yours."], photos: MISSION_PHOTOS, secs: 3 },
  // One scene: the wall of prompt cards flashes in and holds, fades out, then
  // the three screens and the box fade in together.
  { kind: "prompts", stills: ["still-planner", "still-planner-day", "still-studio"], h: "Not sure what to post?", p1: "Your planner is already full of ideas.", p2: "Property-specific prompts give you inspiration throughout the month, from educational and community content to timely opportunities.", secs: 9.5 },
  { kind: "edit", h: "A better place to start", p1: "Browse professionally designed content packs made specifically for property.", p2: "Purchase the ones that suit you, then make every template your own in the Studio.", secs: 5.5 },
  { kind: "associate", video: "associate", h: "Not sure what you need? Just ask.", p1: "It starts with a question, an idea or even half a thought.", p2: "Our Creative Assistant understands property, asks the right questions and helps you figure out what comes next.", secs: 10 },
  { kind: "studio", img: "editor-text", focus: "16% 30%", h: "Make it yours", p1: "Editing has been made easy.", p2: "Change the words, switch the imagery and apply your branding, without needing to be a designer.", secs: 9 },
  { kind: "studio", img: "editor", focus: "62% 55%", h: "Get creative", p1: "Our Studio provides the tools to build beyond the template,", p2: "giving you more freedom when you want to create something of your own.", secs: 9 },

  { kind: "mission", n: "2 | 2", objective: "Get better at marketing.", goals: ["Build your knowledge.", "Keep up with what’s working.", "Put it into practice."], photos: MISSION_PHOTOS_2, secs: 3 },
  // Part 02 follows Dani's boards (11 Sep 2026): the box top-left and the six
  // course covers along the foot; the box again with two hub screens and the
  // blog on a phone; then the mission-complete card with a grid of nine.
  { kind: "learn", h: "Learn what matters", p: "Practical marketing courses created specifically for property professionals, covering the skills and knowledge you need to market your business better.", covers: COURSES, secs: 8 },
  { kind: "know", h: "Stay in the know", p: "Stay on top of what’s changing, what’s trending and what you can use in your own property marketing with our latest insights and guides.", stills: ["learn-courses", "learn-month"], phone: "blog-phone", secs: 9 },
  { kind: "complete", objective: "Learn it. Then use it", p: "From finding your next idea to understanding what works, the Member Hub connects the tools and knowledge you need to market your property business.", tiles: DONE_TILES, secs: 8 },

  { kind: "close", eyebrow: "One connected route", h: "A clearer way to do your marketing.", steps: ["Learn what works", "Find an idea", "Plan it", "Start with a template", "Make it yours", "Get help when stuck", "Post"], secs: 12 },
];
---

<BaseLayout title="A Clearer Way — the TMKE Member Hub" description="A short film of the TMKE Member Hub: from 'I need something to post' to 'it's ready'." hideNav hideFooter noindex pageTransition={false}>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />
  <main class="film" id="film" data-scenes={SCENES.length}>
    <div class="film-progress" id="film-progress" aria-hidden="true">
      {SCENES.map(() => <span class="film-seg"><i></i></span>)}
    </div>

    {SCENES.map((s, i) => (
      <section class={`scene scene--${s.kind || "shot"}`} data-i={i} data-secs={s.secs} aria-hidden={i === 0 ? "false" : "true"}>
        {s.kind === "card" && (
          <div class="scene-card">
            {s.act && <p class="scene-act">Part {s.act}</p>}
            {s.eyebrow && <p class="scene-eyebrow">{s.eyebrow}</p>}
            <h2 class="scene-h scene-h--big">{s.h}</h2>
            {s.p && <p class="scene-p scene-p--big">{s.p}</p>}
          </div>
        )}
        {s.kind === "mission" && (
          <div class="mission">
            <span class="mission-conf">Confidential</span>
            <div class="mission-copy">
              <p class="mission-k">User objective</p>
              <p class="mission-v">{s.objective}</p>
              <p class="mission-k">Primary goals</p>
              <p class="mission-v" set:html={s.goals.join("<br />")}></p>
            </div>
            <span class="mission-brand">The Marketing Experts</span>
            <div class="mission-side">
              <p class="mission-k mission-k--big">Mission</p>
              <p class="mission-n">{s.n}</p>
              <div class="mission-strip">{s.photos.map((src) => <img src={src} alt="" loading="lazy" />)}</div>
            </div>
          </div>
        )}
        {(s.kind === "prompts" || s.kind === "edit") && (
          <div class="wall-scene">
            {s.kind === "prompts" ? (
              <>
                <div class="wall wall--prompts wall--out" aria-hidden="true">
                  {PROMPT_CARDS.map((c, k) => (
                    <div class="pcard" style={`--i:${SCATTER[k]}`}><span class="pcard-l">{c.label}</span><span class="pcard-t">{c.title}</span></div>
                  ))}
                </div>
                <div class="stills stills--after" aria-hidden="true">
                  {(s.stills || []).map((img, k) => <span class="still" style={`--i:${k}`}><img src={`/hub-tour/${img}.jpg`} alt="" loading="lazy" /></span>)}
                </div>
              </>
            ) : (
              <div class="wall wall--edit" aria-hidden="true">
                {EDIT_TILES.map((src, k) => (
                  <div class="tile" style={`--i:${SCATTER[k]}; background-image:url('${src}')`}></div>
                ))}
              </div>
            )}
            {s.h && (
              <div class={s.kind === "prompts" ? "box box--bl box--after" : "box box--late box--c"}>
                <h2 class="box-h">{s.h}</h2>
                <p class="box-p">{s.p1}</p>
                <p class="box-p">{s.p2}</p>
              </div>
            )}
          </div>
        )}
        {s.kind === "clip" && (
          <div class="wall-scene">
            <div class="stills" aria-hidden="true">
              {(s.stills || []).map((img, k) => <span class="still" style={`--i:${k}`}><img src={`/hub-tour/${img}.jpg`} alt="" loading="lazy" /></span>)}
            </div>
            <div class="box box--late box--bl box--stills">
              <h2 class="box-h">{s.h}</h2>
              <p class="box-p">{s.p1}</p>
              <p class="box-p">{s.p2}</p>
            </div>
            <div class="clip-left">
              <div class="box box--late">
                <h2 class="box-h">{s.h}</h2>
                <p class="box-p">{s.p1}</p>
                <p class="box-p">{s.p2}</p>
              </div>
            </div>
            <div class="clip-wrap">
              <div class="clip-shell"><video src={`/hub-tour/${s.video}.mp4`} muted playsinline loop preload="auto" data-clip></video></div>
              <div class="clip-foot" aria-hidden="true"></div>
            </div>
          </div>
        )}
        {s.kind === "associate" && (
          <div class="wall-scene">
            <div class="assoc-video">
              <video src={`/hub-tour/${s.video}.mp4`} muted playsinline preload="auto" data-clip data-once></video>
              <div class="assoc-tint" aria-hidden="true"></div>
              <div class="assoc-tab" aria-hidden="true">
                <div class="tchat">
                  <div class="tchat-head"><span>What to post · Creative Assistant</span></div>
                  <div class="tchat-log">
                    <div class="tmsg tmsg--me">I need help launching my new property on social media</div>
                    <div class="tmsg tmsg--dots"><i></i><i></i><i></i></div>
                    <div class="tmsg tmsg--ai"><b>Day 1 – Coming Soon.</b> Post the hero shot, keep the caption tight. <b>Day 2–3 –</b> the room buyers will remember, and why.</div>
                  </div>
                  <div class="tchat-in"><span>What should I post about…?</span><i>&#10148;</i></div>
                </div>
              </div>
            </div>
            <div class="box box--tl">
              <h2 class="box-h">{s.h}</h2>
              <p class="box-p">{s.p1}</p>
              <p class="box-p">{s.p2}</p>
            </div>
            <div class="assoc-meta">
              <p class="mission-k">Your TMKE associate</p>
              <p class="mission-v">Codename: Marketing Assistant</p>
              <p class="mission-k">Skills</p>
              <p class="mission-v">Content intelligence<br />Industry expertise<br />Studio navigation</p>
            </div>
          </div>
        )}
        {s.kind === "ask" && (
          <div class="wall-scene">
            <div class="box box--tl">
              <h2 class="box-h">{s.h}</h2>
              <p class="box-p">{s.p1}</p>
              <p class="box-p">{s.p2}</p>
            </div>
          </div>
        )}
        {s.kind === "phone" && (
          <div class="wall-scene">
            <div class="phone">
              <div class="phone-head"><span>What to post · Creative Assistant</span><b>Pop out</b></div>
              <div class="phone-log">
                <div class="pmsg pmsg--me">I need help launching my new property on social media</div>
                <div class="pmsg pmsg--ai">
                  <p>Here’s a simple launch sequence using what you’ve already got in the Studio:</p>
                  <p><b>Day 1 – Coming Soon / Just Listed template.</b> Post the hero shot, keep the caption tight, don’t give away every detail.</p>
                  <p><b>Day 2–3 – Feature post.</b> Pick the room buyers will remember and say why.</p>
                </div>
              </div>
              <div class="phone-in"><span>What should I post about…?</span><i aria-hidden="true">&#10148;</i></div>
              <p class="phone-foot">Powered by AI · it can’t see your listings, so fill in the blanks it leaves.</p>
            </div>
          </div>
        )}
        {s.kind === "studio" && (
          <div class="wall-scene">
            <img class="studio-bg" src={`/hub-tour/${s.img}.jpg`} alt="" style={`--focus:${s.focus}`} loading="lazy" />
            <div class="box box--late box--bl">
              <h2 class="box-h">{s.h}</h2>
              <p class="box-p">{s.p1}</p>
              <p class="box-p">{s.p2}</p>
            </div>
          </div>
        )}
        {s.kind === "chat" && (
          <div class="scene-shot">
            <div class="frame">
              <div class="chat">
                <div class="chat-head"><span class="chat-dot"></span>Creative Assistant</div>
                <div class="chat-msg chat-msg--me">Just listed a three-bed in Hartley Green, needs a caption, nothing cheesy.</div>
                <div class="chat-msg chat-msg--ai">
                  <p>Three bedrooms, a garden that gets the evening sun, and a five-minute walk to the station. Hartley Green does not stay on the market long.</p>
                  <p>Viewings from Saturday. Message us for the details.</p>
                </div>
                <div class="chat-msg chat-msg--me">Shorter. And make it sound like us.</div>
                <div class="chat-typing"><i></i><i></i><i></i></div>
              </div>
            </div>
            <div class="caption">
              <p class="scene-eyebrow">{s.eyebrow}</p>
              <h2 class="scene-h">{s.h}</h2>
              <p class="scene-p">{s.p}</p>
            </div>
          </div>
        )}
        {(s.kind === "learn" || s.kind === "know") && (
          <div class="wall-scene">
            <div class="box box--tl box--p2">
              <h2 class="box-h">{s.h}</h2>
              <p class="box-p">{s.p}</p>
            </div>
            {s.kind === "learn" ? (
              <div class="covers" aria-hidden="true">
                {s.covers.map((src, k) => <span class="cover" style={`--i:${k}`}><img src={src} alt="" loading="lazy" /></span>)}
              </div>
            ) : (
              <>
                <div class="know-stills" aria-hidden="true">
                  {s.stills.map((img, k) => <span class="still" style={`--i:${k}`}><img src={`/hub-tour/${img}.jpg`} alt="" loading="lazy" /></span>)}
                </div>
                <div class="bphone" aria-hidden="true">
                  <div class="bphone-screen"><img src={`/hub-tour/${s.phone}.jpg`} alt="" loading="lazy" /></div>
                </div>
              </>
            )}
          </div>
        )}
        {s.kind === "complete" && (
          <div class="mission mission--done">
            <span class="mission-conf">Confidential</span>
            <div class="mission-copy">
              <p class="mission-k">User objective</p>
              <p class="mission-v">{s.objective}</p>
              <p class="mission-p">{s.p}</p>
            </div>
            <div class="mission-foot">
              <p class="mission-k mission-k--big">Mission</p>
              <p class="mission-v">Complete</p>
            </div>
            <div class="mission-grid" aria-hidden="true">
              {s.tiles.map((src, k) => <img src={src} alt="" style={`--i:${k}`} loading="lazy" />)}
            </div>
          </div>
        )}
        {s.kind === "close" && (
          <div class="scene-card scene-card--close">
            <p class="scene-eyebrow">{s.eyebrow}</p>
            <h2 class="scene-h scene-h--big">{s.h}</h2>
            <ol class="route">
              {s.steps.map((t) => <li>{t}</li>)}
            </ol>
            <div class="close-actions">
              <a class="film-btn" href="/memberships">See the Member Hub <span aria-hidden="true">&rarr;</span></a>
              <button type="button" class="film-link" id="film-replay">Play again</button>
            </div>
          </div>
        )}
        {!s.kind && (
          <div class="scene-shot">
            <div class="frame">
              <img src={`/hub-tour/${s.img}.jpg`} alt="" style={`--focus:${s.focus}; --zoom:${s.zoom || 1.12}`} loading={i < 4 ? "eager" : "lazy"} />
            </div>
            <div class="caption">
              <p class="scene-eyebrow">{s.eyebrow}</p>
              <h2 class="scene-h">{s.h}</h2>
              <p class="scene-p">{s.p}</p>
            </div>
          </div>
        )}
      </section>
    ))}

    <button type="button" class="film-tap film-tap--prev" id="film-prev" aria-label="Previous"></button>
    <button type="button" class="film-tap film-tap--next" id="film-next" aria-label="Next"></button>
    <div class="film-hud" id="film-hud" aria-hidden="true"><span>Paused</span></div>
    <a class="film-mark" href="/">TMKE</a>
  </main>
</BaseLayout>

<style>
  .film {
    position: fixed; inset: 0; overflow: hidden;
    background: var(--english-violet); color: var(--paper); font-family: var(--sans);
    user-select: none; -webkit-user-select: none;
  }
  .film-mark { position: absolute; top: 22px; left: 28px; z-index: 5; font-family: var(--logo-serif, var(--serif)); font-size: 20px; letter-spacing: 0.06em; color: rgba(244,242,241,0.7); text-decoration: none; }
  /* Progress: one segment a scene, the current one filling over its seconds. */
  .film-progress { position: absolute; top: 12px; left: 28px; right: 28px; z-index: 5; display: flex; gap: 5px; }
  .film-seg { flex: 1; height: 2px; background: rgba(244,242,241,0.22); overflow: hidden; border-radius: 2px; }
  .film-seg i { display: block; height: 100%; width: 100%; background: var(--paper); transform: scaleX(0); transform-origin: left; }
  .film-seg.is-done i { transform: scaleX(1); }
  .film-seg.is-live i { transition: transform linear; transition-duration: var(--secs, 6s); transform: scaleX(1); }
  .film.is-paused .film-seg.is-live i { transition: none; transform: scaleX(var(--at, 0)); }

  /* One scene fades fully out before the next fades in, so nothing of the
     old scene lingers under the new. */
  .scene { position: absolute; inset: 0; display: grid; place-items: center; opacity: 0; visibility: hidden; transition: opacity 0.45s ease, visibility 0s linear 0.45s; }
  .scene.is-on { opacity: 1; visibility: visible; transition: opacity 0.6s ease 0.45s; }

  /* Cards: a line or two in the middle of the wine. */
  .scene-card { max-width: 900px; padding: 0 40px; text-align: center; }
  .scene-act { margin: 0 0 22px; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(244,242,241,0.6); }
  .scene-act::before { content: "\2014"; margin-right: 8px; }
  .scene-eyebrow { margin: 0 0 14px; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(244,242,241,0.62); }
  .scene-eyebrow::before { content: "\2014"; margin-right: 8px; }
  .scene-h { margin: 0; font-family: var(--sans); font-size: clamp(24px, 3vw, 38px); font-weight: 500; line-height: 1.15; letter-spacing: -0.015em; color: var(--paper); }
  .scene-h--big { font-family: var(--subhead); font-weight: 400; font-size: clamp(32px, 5vw, 64px); line-height: 1.1; letter-spacing: -0.01em; }
  .scene-p { margin: 12px 0 0; font-size: clamp(15px, 1.35vw, 19px); line-height: 1.5; color: rgba(244,242,241,0.78); max-width: 46ch; }
  .scene-p--big { margin: 20px auto 0; font-size: clamp(18px, 2vw, 26px); max-width: 32ch; color: rgba(244,242,241,0.85); }
  .scene.is-on .scene-h, .scene.is-on .scene-p, .scene.is-on .scene-eyebrow, .scene.is-on .scene-act { animation: rise 0.9s cubic-bezier(.2,.7,.2,1) both; }
  .scene.is-on .scene-p { animation-delay: 0.15s; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  /* Shots: the screen in a frame, the words beneath, on the gutter. */
  /* The frame is 16:10 and must fit beneath the strip with room for the
     words: its width is the smaller of the page's and what the height allows. */
  .scene-shot { width: min(1180px, 100vw - 80px, (100vh - 230px) * 1.6); display: grid; grid-template-rows: auto auto; gap: 24px; }
  .frame { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 10px; background: #2a1620; box-shadow: 0 30px 80px rgba(0,0,0,0.35), 0 0 0 1px rgba(244,242,241,0.12); }
  .frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--focus, 50% 50%); transform-origin: var(--focus, 50% 50%); transform: scale(1); }
  .scene.is-on .frame img { animation: drift var(--drift, 9s) linear both; }
  @keyframes drift { from { transform: scale(1.02); } to { transform: scale(var(--zoom, 1.12)); } }
  .scene.is-on .frame { animation: settleFrame 1s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes settleFrame { from { opacity: 0; transform: translateY(18px) scale(0.985); } to { opacity: 1; transform: none; } }
  .caption { display: grid; grid-template-columns: auto 1fr; gap: 6px 40px; align-items: baseline; }
  .caption .scene-eyebrow { grid-column: 1 / -1; margin: 0; }
  .caption .scene-h { grid-column: 1; }
  .caption .scene-p { grid-column: 2; margin: 0; max-width: 52ch; }

  /* The assistant, drawn rather than captured. */
  .chat { position: absolute; inset: 0; display: flex; flex-direction: column; justify-content: flex-end; gap: 14px; padding: 32px clamp(24px, 12%, 180px) 36px; background: var(--paper); color: var(--ink); }
  .chat-head { position: absolute; top: 0; left: 0; right: 0; padding: 16px 28px; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; color: var(--english-violet); border-bottom: 1px solid rgba(28,29,34,0.08); display: flex; align-items: center; gap: 10px; }
  .chat-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--english-violet); }
  .chat-msg { max-width: 62%; padding: 14px 18px; border-radius: 14px; font-size: clamp(14px, 1.3vw, 18px); line-height: 1.5; opacity: 0; transform: translateY(10px); }
  .chat-msg p { margin: 0 0 8px; } .chat-msg p:last-child { margin: 0; }
  .chat-msg--me { align-self: flex-end; background: var(--english-violet); color: var(--paper); border-bottom-right-radius: 4px; }
  .chat-msg--ai { align-self: flex-start; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-bottom-left-radius: 4px; }
  .scene.is-on .chat-msg { animation: rise 0.6s cubic-bezier(.2,.7,.2,1) both; }
  .scene.is-on .chat-msg:nth-child(2) { animation-delay: 0.6s; }
  .scene.is-on .chat-msg:nth-child(3) { animation-delay: 2.4s; }
  .scene.is-on .chat-msg:nth-child(4) { animation-delay: 5s; }
  .chat-typing { align-self: flex-start; display: flex; gap: 5px; padding: 12px 16px; background: #fff; border: 1px solid rgba(28,29,34,0.1); border-radius: 14px; opacity: 0; }
  .scene.is-on .chat-typing { animation: rise 0.4s 6.2s both; }
  .chat-typing i { width: 6px; height: 6px; border-radius: 50%; background: rgba(28,29,34,0.4); animation: blink 1s infinite; }
  .chat-typing i:nth-child(2) { animation-delay: 0.2s; } .chat-typing i:nth-child(3) { animation-delay: 0.4s; }
  @keyframes blink { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }

  /* The close: the route as one line of steps, then the button. */
  .scene-card--close { max-width: 1100px; }
  .route { list-style: none; margin: 34px 0 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 0; counter-reset: step; }
  .route li { font-size: clamp(13px, 1.2vw, 16px); letter-spacing: 0.06em; text-transform: uppercase; color: rgba(244,242,241,0.85); display: flex; align-items: center; opacity: 0; }
  .route li + li::before { content: "\2192"; margin: 0 14px; color: rgba(244,242,241,0.45); }
  .scene.is-on .route li { animation: rise 0.6s cubic-bezier(.2,.7,.2,1) both; }
  .scene.is-on .route li:nth-child(1) { animation-delay: 0.6s; } .scene.is-on .route li:nth-child(2) { animation-delay: 1.1s; }
  .scene.is-on .route li:nth-child(3) { animation-delay: 1.6s; } .scene.is-on .route li:nth-child(4) { animation-delay: 2.1s; }
  .scene.is-on .route li:nth-child(5) { animation-delay: 2.6s; } .scene.is-on .route li:nth-child(6) { animation-delay: 3.1s; }
  .scene.is-on .route li:nth-child(7) { animation-delay: 3.6s; }
  .close-actions { margin-top: 44px; display: flex; gap: 22px; align-items: center; justify-content: center; opacity: 0; }
  .scene.is-on .close-actions { animation: rise 0.7s 4.4s both; }
  .film-btn { display: inline-flex; align-items: center; gap: 10px; padding: 14px 22px; background: var(--paper); color: var(--english-violet); text-decoration: none; font-size: 12px; font-weight: 500; letter-spacing: 0.14em; text-transform: uppercase; border-radius: 2px; }
  .film-link { background: none; border: 0; padding: 0; color: rgba(244,242,241,0.7); font-family: var(--sans); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer; }

  /* Tap zones either side, and a small paused note. */
  .film-tap { position: absolute; top: 0; bottom: 0; width: 22%; background: none; border: 0; cursor: pointer; z-index: 4; }
  .film-tap--prev { left: 0; } .film-tap--next { right: 0; }
  .film-hud { position: absolute; bottom: 22px; right: 28px; z-index: 5; font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(244,242,241,0.6); opacity: 0; transition: opacity 0.3s; }
  .film.is-paused .film-hud { opacity: 1; }
  /* On the light scenes the strip, the mark and the paused note go dark. */
  .film.is-light .film-seg { background: rgba(28,29,34,0.16); }
  .film.is-light .film-seg i { background: var(--english-violet); }
  .film.is-light .film-mark, .film.is-light .film-hud { color: var(--english-violet); }
  .film.is-shot .film-mark { opacity: 0; }   /* the Studio's own mark is on screen */
  .film.is-paused .scene * { animation-play-state: paused !important; }
  :global(.cc-banner) { display: none !important; }

  /* ---- Part 01, from the Canva boards ---- */
  .scene--mission, .scene--prompts, .scene--edit, .scene--ask, .scene--phone, .scene--studio { display: block; }
  .wall-scene { position: absolute; inset: 0; background: #f2f0ee; overflow: hidden; }

  .mission { position: absolute; inset: 0; background: var(--english-violet); color: var(--paper); font-family: var(--sans); }
  .mission-conf { position: absolute; top: 9.5%; right: 5.6%; font-size: clamp(11px, 0.8vw, 15px); font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; }
  .mission-copy { position: absolute; top: 20%; left: 5.6%; }
  .mission-k { margin: 0 0 6px; font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace; font-size: clamp(12px, 1.1vw, 20px); font-weight: 600; text-transform: uppercase; letter-spacing: 0.02em; }
  .mission-v { margin: 0 0 34px; font-size: clamp(11px, 0.95vw, 17px); font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1.75; }
  .mission-brand { position: absolute; bottom: 9.5%; left: 5.6%; font-size: clamp(13px, 1.2vw, 22px); font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; }
  .mission-side { position: absolute; right: 5.6%; bottom: 10%; text-align: right; }
  .mission-k--big { font-size: clamp(13px, 1.2vw, 22px); }
  .mission-n { margin: 0 0 22px; font-family: "IBM Plex Mono", ui-monospace, Menlo, monospace; font-size: clamp(11px, 0.9vw, 16px); letter-spacing: 0.1em; }
  .mission-strip { display: flex; gap: 8px; }
  .mission-strip img { width: clamp(90px, 11vw, 214px); aspect-ratio: 210 / 240; object-fit: cover; display: block; }
  .scene.is-on .mission-copy, .scene.is-on .mission-side, .scene.is-on .mission-brand, .scene.is-on .mission-conf { animation: rise 0.9s cubic-bezier(.2,.7,.2,1) both; }
  .scene.is-on .mission-side { animation-delay: 0.3s; }

  /* The walls: cards flash in one after another, hold, then dim to half behind the box. */
  .wall { position: absolute; inset: -4% -3%; display: grid; gap: 3.2vw 2.1vw; align-content: center; justify-content: center; }
  .wall--prompts { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 2.2vw; padding: 0 2%; }
  .pcard { background: var(--english-violet); color: var(--paper); border-radius: 6px; padding: clamp(14px, 4vh, 44px) clamp(14px, 1.1vw, 22px) clamp(12px, 2vh, 22px); min-height: clamp(70px, 17vh, 190px); display: flex; flex-direction: column; justify-content: flex-end; gap: 6px; box-shadow: 0 12px 30px rgba(28,29,34,0.18); opacity: 0; font-family: var(--sans); }
  .pcard-l { font-size: clamp(9px, 0.75vw, 13px); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; }
  .pcard-t { font-size: clamp(11px, 0.95vw, 17px); font-weight: 500; line-height: 1.3; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .wall--edit { grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 3vw 2.1vw; padding: 0 2%; }
  .tile { aspect-ratio: 3 / 4; background-size: cover; background-position: center; background-color: #fff; border-radius: 4px; box-shadow: 0 10px 28px rgba(28,29,34,0.16); opacity: 0; }
  .tile--blank { background: linear-gradient(#cfe6f6, #eef6fb 45%); position: relative; overflow: hidden; }
  .tile--blank::before { content: ""; position: absolute; left: 22%; top: 24%; width: 46%; height: 24%; background: #fff; border-radius: 40%; box-shadow: 14% 8% 0 -2px #fff; }
  .tile--blank i { position: absolute; left: -10%; right: -10%; bottom: -8%; height: 40%; background: #9ccf3a; border-radius: 50% 50% 0 0 / 60% 60% 0 0; }
  .tile--blank i::before { content: ""; position: absolute; inset: 0; background: #c6e77c; border-radius: 50% 50% 0 0 / 60% 60% 0 0; transform: translate(-30%, 10%) scale(1.1, 0.8); }
  .scene.is-on .pcard, .scene.is-on .tile { animation: flash 0.45s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(0.3s + var(--i) * 0.09s); }
  @keyframes flash { from { opacity: 0; transform: scale(0.94); } to { opacity: 1; transform: none; } }
  .scene.is-on .wall--edit { animation: dim 0.9s ease both; animation-delay: var(--dim, 2.4s); }
  /* The prompt wall leaves before the screens arrive. */
  /* "Not sure what to post?", in order: every card flashes in (0.3-2.3s)
     and holds a second; the wall dims to half exactly as the Edit wall
     does (0.9s ease, 3.3s); the box pops in 0.3s later (3.6s) and holds a
     second; the wall fades right out the same way (0.9s ease, 4.7s); then
     the three screens pop up one at a time (5.8s, 6.4s, 7.0s). One keyframe
     run for the wall, eased on each move, so the two fades cannot fight. */
  .scene.is-on .wall--out { animation: wallSeq 5.6s linear both; }
  @keyframes wallSeq {
    0%, 58.9% { opacity: 1; animation-timing-function: ease; }      /* 3.3s: dim, as the Edit wall */
    75%, 83.9% { opacity: 0.45; animation-timing-function: ease; }  /* 4.2s-4.7s: hold at half behind the box */
    100% { opacity: 0; }                                           /* 5.6s: gone */
  }
  .scene.is-on .box.box--after { animation: pop 0.8s cubic-bezier(.2,.7,.2,1) 3.6s both; }   /* .box.box--after, so the plain .box rule below cannot cancel the delay */
  .scene.is-on .stills--after .still { animation: pop 0.7s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(5.8s + var(--i) * 0.6s); }
  @keyframes dim { from { opacity: 1; } to { opacity: 0.45; } }

  /* The wine box, three positions. */
  .box { position: absolute; width: min(36vw, 680px); background: var(--english-violet); color: var(--paper); border-radius: 6px; padding: clamp(20px, 2.8vw, 40px) clamp(20px, 2.2vw, 42px); box-shadow: 0 18px 50px rgba(28,29,34,0.28); font-family: var(--sans); }
  .box--bl { left: 5.6%; bottom: 7.4%; }
  .box--tl { left: 5.6%; top: 9.5%; }
  .box--c { left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(30vw, 560px); }
  /* The mission card's sizes: headline as its labels (16px on a laptop,
     20px on a big screen), copy as its lines (14px / 17px). */
  .box-h { margin: 0 0 clamp(12px, 2.4vh, 24px); font-family: var(--sans); font-size: clamp(15px, 1.25vw, 22px); font-weight: 700; line-height: 1.2; letter-spacing: 0.03em; text-transform: uppercase; }
  .box-p { margin: 0 0 clamp(8px, 1.6vh, 16px); font-size: clamp(12px, 0.95vw, 17px); font-weight: 500; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1.75; }
  .box-p:last-child { margin-bottom: 0; }
  .scene.is-on .box { animation: pop 0.8s cubic-bezier(.2,.7,.2,1) both; }
  .scene.is-on .box--c { animation-name: popc; }
  .scene.is-on .box--late { animation-delay: var(--box, 2.7s); }
  @keyframes pop { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes popc { from { opacity: 0; transform: translate(-50%, calc(-50% + 18px)); } to { opacity: 1; transform: translate(-50%, -50%); } }
  .scene--studio .box--late { --box: 1.6s; }

  /* The phone of the chat. */
  .phone { position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%); width: min(520px, 88vw); height: min(850px, 82vh); background: #e9e6e4; border-radius: 4px; display: flex; flex-direction: column; overflow: hidden; font-family: var(--sans); color: var(--ink); box-shadow: 0 30px 80px rgba(28,29,34,0.25); }
  .phone-head { display: flex; justify-content: space-between; align-items: center; padding: 22px 12px 18px; font-size: 12px; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.55); border-bottom: 1px solid rgba(28,29,34,0.1); }
  .phone-head b { font-weight: 600; letter-spacing: 0; text-transform: none; color: var(--ink); }
  .phone-log { flex: 1; display: flex; flex-direction: column; gap: 22px; padding: 22px 12px; overflow: hidden; }
  .pmsg { max-width: 80%; padding: 20px 24px; border-radius: 16px; font-size: clamp(14px, 1vw, 17px); line-height: 1.55; opacity: 0; }
  .pmsg p { margin: 0 0 14px; } .pmsg p:last-child { margin: 0; }
  .pmsg--me { align-self: flex-end; background: var(--english-violet); color: var(--paper); border-bottom-right-radius: 4px; }
  .pmsg--ai { align-self: flex-start; background: #dcd8d6; border-bottom-left-radius: 4px; }
  .scene.is-on .pmsg--me { animation: rise 0.6s cubic-bezier(.2,.7,.2,1) 0.5s both; }
  .scene.is-on .pmsg--ai { animation: rise 0.6s cubic-bezier(.2,.7,.2,1) 2.2s both; }
  .phone-in { margin: 0 12px; display: flex; align-items: center; gap: 12px; }
  .phone-in span { flex: 1; padding: 30px 20px 60px; background: #f7f6f5; border-radius: 12px; color: rgba(28,29,34,0.45); font-size: 16px; }
  .phone-in i { width: 70px; height: 70px; border-radius: 12px; background: var(--english-violet); color: var(--paper); display: grid; place-items: center; font-style: normal; font-size: 24px; align-self: flex-end; }
  .phone-foot { margin: 0; padding: 20px 12px 24px; text-align: center; font-size: 12px; color: rgba(28,29,34,0.45); }

  /* The associate: her video on the right, full height, blended into the
     paper; the box top-left; her card bottom-left; the chat on her tablet
     once she has stopped. The tablet's screen is a fixed fraction of the
     video frame (measured from the last frame), so the chat lands on it at
     any size. */
  .scene--associate { display: block; }
  .assoc-video { position: absolute; top: 4%; left: 30%; height: 92%; aspect-ratio: 16 / 9; overflow: hidden;
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 24%, #000 100%), linear-gradient(to bottom, transparent 0, #000 9%, #000 93%, transparent 100%);
    -webkit-mask-composite: source-in; mask-image: linear-gradient(to right, transparent 0, #000 24%, #000 100%), linear-gradient(to bottom, transparent 0, #000 9%, #000 93%, transparent 100%); mask-composite: intersect; }
  .assoc-video video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: brightness(1.04); }   /* lifts its off-white to white before the paper tint */
  .assoc-tint { position: absolute; inset: 0; background: #f2f0ee; mix-blend-mode: multiply; }   /* the video's white becomes our paper */
  .scene.is-on .assoc-video { animation: stillIn 0.9s ease both; }
  /* The tablet's screen as fractions of the video frame, measured from the
     last frame. Adjust these four when the video changes. */
  .assoc-video { --tab-l: 38.2%; --tab-t: 27%; --tab-w: 23.6%; --tab-h: 29.6%; }
  .assoc-tab { position: absolute; left: var(--tab-l); top: var(--tab-t); width: var(--tab-w); height: var(--tab-h); border-radius: 0.6vw; overflow: hidden; opacity: 0; transition: opacity 0.7s ease; }
  .scene.is-ended .assoc-tab { opacity: 1; }
  .assoc-meta { position: absolute; left: 5.6%; bottom: 9%; color: var(--ink); font-family: var(--sans); }
  .assoc-meta .mission-k { color: var(--ink); margin-top: 18px; }
  .assoc-meta .mission-k:first-child { margin-top: 0; }
  .assoc-meta .mission-v { margin: 0; color: rgba(28,29,34,0.75); }
  .scene.is-on .assoc-meta { animation: rise 0.9s cubic-bezier(.2,.7,.2,1) 0.3s both; }
  /* The chat on the tablet, landscape, tiny. */
  .tchat { position: absolute; inset: 0; background: #e9e6e4; color: var(--ink); font-family: var(--sans); display: flex; flex-direction: column; overflow: hidden; }
  .tchat-head { padding: 4% 5% 3%; font-size: clamp(6px, 0.5vw, 10px); letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.55); border-bottom: 1px solid rgba(28,29,34,0.1); }
  .tchat-log { flex: 1; display: flex; flex-direction: column; gap: 4%; padding: 4% 5%; }
  .tmsg { max-width: 78%; padding: 3% 4%; border-radius: 8px; font-size: clamp(7px, 0.62vw, 12px); line-height: 1.4; opacity: 0; }
  .tmsg--me { align-self: flex-end; background: var(--english-violet); color: var(--paper); border-bottom-right-radius: 2px; }
  .tmsg--ai { align-self: flex-start; background: #dcd8d6; border-bottom-left-radius: 2px; }
  .tmsg--dots { align-self: flex-start; background: #dcd8d6; display: flex; gap: 3px; padding: 3% 4%; }
  .tmsg--dots i { width: 4px; height: 4px; border-radius: 50%; background: rgba(28,29,34,0.4); animation: blink 1s infinite; }
  .tmsg--dots i:nth-child(2) { animation-delay: 0.2s; } .tmsg--dots i:nth-child(3) { animation-delay: 0.4s; }
  .scene.is-ended .tmsg--me { animation: rise 0.5s ease 0.6s both; }
  .scene.is-ended .tmsg--dots { animation: dotsIn 3s linear 1.6s both; }
  .scene.is-ended .tmsg--ai { animation: rise 0.5s ease 4.2s both; }
  @keyframes dotsIn { 0% { opacity: 0; } 10% { opacity: 1; } 85% { opacity: 1; } 100% { opacity: 0; display: none; } }
  .tchat-in { margin: 0 5% 4%; display: flex; align-items: center; gap: 4%; }
  .tchat-in span { flex: 1; padding: 3% 4%; background: #f7f6f5; border-radius: 6px; color: rgba(28,29,34,0.45); font-size: clamp(6px, 0.55vw, 11px); }
  .tchat-in i { width: 8%; aspect-ratio: 1; border-radius: 5px; background: var(--english-violet); color: var(--paper); display: grid; place-items: center; font-style: normal; font-size: clamp(6px, 0.55vw, 11px); }

  /* A screen recording in a laptop, on the right; the box on the left. */
  .scene--clip { display: block; }
  /* The stills treatment (default): screenshots step behind the box every
     few seconds. The laptop treatment shows with ?frame=1. */
  /* Three framed screens placed as on Dani's board: the planner top-left,
     the open day beside it, the Studio lower right; the box bottom-left. */
  .stills { position: absolute; inset: 0; }
  .still { position: absolute; width: 28.6%; aspect-ratio: 16 / 9; border-radius: 6px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px rgba(28,29,34,0.12), 0 24px 50px -20px rgba(28,29,34,0.35); opacity: 0; }
  .still img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .still:nth-child(1) { left: 5.6%; top: 10%; }
  .still:nth-child(2) { left: 35.4%; top: 10%; }
  .still:nth-child(3) { left: 65.6%; top: 39.5%; }
  /* Everything on the stills scene fades in together. */
  .scene.is-on .still { animation: stillIn 1.8s ease both; animation-delay: 0.3s; }
  @keyframes stillIn { from { opacity: 0; } to { opacity: 1; } }
  .scene.is-on .box--stills { animation: stillIn 1.8s ease both; animation-delay: 0.3s; }
  .scene--clip .box--stills { position: absolute; left: 5.6%; bottom: 7.4%; width: min(36vw, 680px); }
  .film[data-variant="laptop"] .stills, .film[data-variant="laptop"] .box--stills { display: none; }
  .film:not([data-variant="laptop"]) .clip-left, .film:not([data-variant="laptop"]) .clip-wrap { display: none; }
  .clip-left { position: absolute; left: 5.6%; top: 50%; transform: translateY(-50%); width: min(30vw, 520px); }
  .clip-left .box { position: relative; left: auto; bottom: auto; width: 100%; }
  .scene--clip .box--late { --box: 1.4s; }
  .clip-wrap { position: absolute; right: 5.6%; top: 50%; transform: translateY(-50%); width: min(56vw, 1040px); }
  .clip-shell { position: relative; background: #1c1d22; border-radius: 16px; padding: 12px 12px 10px; box-shadow: 0 30px 80px rgba(28,29,34,0.28); }
  .clip-shell video { display: block; width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: 6px; background: #000; }
  .clip-foot { height: 12px; margin: 0 -3%; background: linear-gradient(#dedad7, #bdb8b4); border-radius: 0 0 14px 14px; }
  .scene.is-on .clip-wrap { animation: settle 1s cubic-bezier(.2,.7,.2,1) both; }
  @keyframes settle { from { opacity: 0; transform: translateY(calc(-50% + 18px)) scale(0.985); } to { opacity: 1; transform: translateY(-50%); } }

  /* The Studio behind the last two boxes. */
  .studio-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: var(--focus, 50% 50%); }

  /* ---- Part 02, from the Canva boards ---- */
  .scene--learn, .scene--know, .scene--complete { display: block; }
  .scene.is-on .box.box--p2 { animation-delay: 0.3s; }
  /* Learn what matters: the six covers along the foot, one after another. */
  .covers { position: absolute; left: 5.6%; right: 5.6%; bottom: 10.2%; display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: 1.1vw; }
  .cover { display: block; aspect-ratio: 3 / 4; border-radius: 4px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px rgba(28,29,34,0.08), 0 18px 40px -18px rgba(28,29,34,0.35); opacity: 0; }
  .cover img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .scene.is-on .cover { animation: pop 0.7s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(1.4s + var(--i) * 0.35s); }
  /* Stay in the know: two screens along the foot, the blog on a phone at the right. */
  .know-stills { position: absolute; inset: 0; }
  .know-stills .still { top: auto; bottom: 10%; }
  .know-stills .still:nth-child(1) { left: 5.6%; }
  .know-stills .still:nth-child(2) { left: 35.4%; }
  .scene.is-on .know-stills .still { animation: pop 0.8s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(1.4s + var(--i) * 0.5s); }
  .bphone { position: absolute; left: 71.6%; top: 25%; width: 21.6%; aspect-ratio: 1 / 2.05; background: #141416; border-radius: 12% / 5.8%; padding: 2.6%; box-shadow: 0 30px 80px rgba(28,29,34,0.3), inset 0 0 0 2px #3b3b3f; opacity: 0; }
  .bphone-screen { position: relative; width: 100%; height: 100%; border-radius: 9.5% / 4.6%; overflow: hidden; background: #f4f2f1; }
  .bphone-screen::before { content: ""; position: absolute; left: 50%; top: 2.2%; width: 34%; height: 3.2%; transform: translateX(-50%); background: #141416; border-radius: 999px; z-index: 2; }
  .bphone-screen img { position: absolute; left: 0; top: 8%; width: 100%; height: 92%; object-fit: cover; object-position: 50% 0; }
  .scene.is-on .bphone { animation: pop 0.9s cubic-bezier(.2,.7,.2,1) 2.5s both; }
  /* Mission complete: the objective and a line, "Mission / Complete" at the
     foot, the nine tiles on the right popping in one by one. */
  .mission-p { margin: 0; max-width: 26vw; font-size: clamp(13px, 1.2vw, 22px); font-weight: 500; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.5; }
  .mission-foot { position: absolute; left: 5.6%; bottom: 9.5%; }
  .mission-foot .mission-v { margin: 0; font-size: clamp(13px, 1.2vw, 22px); }
  .mission-grid { position: absolute; right: 5.6%; top: 21.5%; width: 34%; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.55vw; }
  .mission-grid img { display: block; width: 100%; aspect-ratio: 210 / 240; object-fit: cover; opacity: 0; }
  .scene.is-on .mission-foot { animation: rise 0.9s cubic-bezier(.2,.7,.2,1) 0.3s both; }
  .scene.is-on .mission-grid img { animation: flash 0.5s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(0.6s + var(--i) * 0.14s); }

  @media (max-width: 760px) {
    .film-mark { top: 18px; left: 22px; }
    .mission-copy { top: 16%; } .mission-v { margin-bottom: 26px; }
    .mission-side { bottom: 16%; } .mission-strip img { width: 26vw; }
    .wall--prompts { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding: 0 6%; }
    .pcard { min-height: 84px; padding: 22px 12px 12px; }
    .wall--edit { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; padding: 0 6%; }
    .box { width: calc(100% - 44px); left: 22px !important; right: 22px; padding: 26px 22px; }
    .box--c { top: auto; bottom: 7%; transform: none; }
    .scene.is-on .box--c { animation-name: pop; }
    .box--c { width: calc(100% - 44px); }
    .box-h { font-size: 22px; } .box-p { font-size: 11px; line-height: 1.7; }
    .phone { width: calc(100vw - 44px); height: 78vh; }
    .still { width: 44%; }
    .still:nth-child(1) { left: 22px; top: 76px; }
    .still:nth-child(2) { left: auto; right: 22px; top: 76px; }
    .still:nth-child(3) { left: 22px; top: calc(76px + 30vw); }
    .assoc-video { left: auto; right: -30%; height: 62%; top: 30%; bottom: auto; }
    .box--tl { top: 76px; }
    .covers { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 12px; left: 22px; right: 22px; bottom: 6%; }
    .know-stills .still { width: 44%; bottom: 6%; }
    .know-stills .still:nth-child(1) { left: 22px; } .know-stills .still:nth-child(2) { left: auto; right: 22px; }
    .bphone { display: none; }
    .mission-p { max-width: none; }
    .mission-grid { left: 22px; right: 22px; width: auto; top: auto; bottom: 20%; gap: 6px; }
    .assoc-meta { display: none; }
    .clip-wrap { left: 22px; right: 22px; width: auto; top: 76px; transform: none; }
    .scene.is-on .clip-wrap { animation: settleFrame 1s cubic-bezier(.2,.7,.2,1) both; }
    .clip-left { left: 22px; right: 22px; width: auto; top: auto; bottom: 6%; transform: none; }
    .phone-in span { padding: 22px 16px 40px; } .phone-in i { width: 56px; height: 56px; }
    .film-progress { left: 22px; right: 22px; }
    .scene-shot { width: calc(100vw - 44px); gap: 20px; }
    .scene { align-content: start; padding-top: 72px; }
    .frame { aspect-ratio: 4 / 3; }
    .caption { grid-template-columns: 1fr; gap: 6px; }
    .caption .scene-h, .caption .scene-p { grid-column: 1; }
    .scene-h { font-size: 22px; }
    .chat-msg { max-width: 82%; }
    .route { flex-direction: column; align-items: center; gap: 6px; }
    .route li + li::before { display: none; }
    .close-actions { flex-direction: column; gap: 16px; }
    .film-tap { width: 30%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scene.is-on * { animation-duration: 0.01s !important; animation-delay: 0s !important; }
  }
</style>

<script>
  (function () {
    const film = document.getElementById("film");
    if (!film) return;
    // ?frame=1 shows the clip in a laptop instead of the stills.
    if (new URLSearchParams(location.search).has("frame")) film.dataset.variant = "laptop";
    const scenes = Array.from(film.querySelectorAll(".scene"));
    const segs = Array.from(film.querySelectorAll(".film-seg"));
    const hud = document.getElementById("film-hud");
    let i = -1, timer = 0, startedAt = 0, remaining = 0, paused = false;

    function secsOf(n) { return Number(scenes[n].dataset.secs || 6) * 1000; }
    function show(n) {
      if (n < 0 || n >= scenes.length) return;
      clearTimeout(timer);
      i = n;
      scenes.forEach((s, k) => { s.classList.toggle("is-on", k === n); s.setAttribute("aria-hidden", k === n ? "false" : "true"); });
      film.classList.toggle("is-light", /scene--(prompts|edit|ask|associate|phone|studio|clip|learn|know)\b/.test(scenes[n].className));
      film.classList.toggle("is-shot", /scene--(studio|clip)\b/.test(scenes[n].className));
      segs.forEach((g, k) => {
        g.classList.toggle("is-done", k < n);
        g.classList.remove("is-live");
        g.style.removeProperty("--at");
        if (k === n) { g.style.setProperty("--secs", secsOf(n) + "ms"); void g.offsetWidth; g.classList.add("is-live"); }
      });
      scenes[n].style.setProperty("--drift", secsOf(n) + "ms");
      scenes.forEach((s, k) => s.querySelectorAll("video[data-clip]").forEach((v) => { if (k === n) { s.classList.remove("is-ended"); try { v.currentTime = 0; v.play().catch(() => {}); } catch (_) {} } else { v.pause(); } }));
      remaining = secsOf(n); startedAt = Date.now();
      if (!paused) arm();
    }
    function arm() {
      clearTimeout(timer);
      if (i >= scenes.length - 1) return;                // the close holds
      timer = setTimeout(() => show(i + 1), remaining);
    }
    function pause() {
      if (paused) return;
      paused = true; clearTimeout(timer);
      remaining = Math.max(0, remaining - (Date.now() - startedAt));
      const g = segs[i]; if (g) g.style.setProperty("--at", String(1 - remaining / secsOf(i)));
      film.classList.add("is-paused");
    }
    function resume() {
      if (!paused) return;
      paused = false; startedAt = Date.now();
      film.classList.remove("is-paused");
      const g = segs[i];
      if (g) { g.classList.remove("is-live"); g.style.removeProperty("--at"); g.style.setProperty("--secs", remaining + "ms"); void g.offsetWidth; g.classList.add("is-live"); }
      arm();
    }
    function toggle() { paused ? resume() : pause(); }

    document.getElementById("film-next").addEventListener("click", () => { if (paused) resume(); show(Math.min(scenes.length - 1, i + 1)); });
    document.getElementById("film-prev").addEventListener("click", () => { if (paused) resume(); show(Math.max(0, i - 1)); });
    const replay = document.getElementById("film-replay");
    if (replay) replay.addEventListener("click", () => { paused = false; film.classList.remove("is-paused"); show(0); });
    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { if (paused) resume(); show(Math.min(scenes.length - 1, i + 1)); }
      else if (e.key === "ArrowLeft") { if (paused) resume(); show(Math.max(0, i - 1)); }
      else if (e.key === " ") { e.preventDefault(); toggle(); }
    });
    // Hold to pause on a touch screen; the tap zones still step.
    let holdT = 0, held = false;
    film.addEventListener("touchstart", () => { held = false; holdT = setTimeout(() => { held = true; pause(); }, 350); }, { passive: true });
    film.addEventListener("touchend", () => { clearTimeout(holdT); if (held) resume(); }, { passive: true });
    film.querySelectorAll(".film-tap").forEach((b) => b.addEventListener("click", (e) => { if (held) e.stopImmediatePropagation(); }, true));
    document.addEventListener("visibilitychange", () => { if (document.hidden) pause(); else resume(); });

    // A one-shot clip (the associate walking in) holds its last frame and
    // tells its scene it has ended, which brings the chat up on her tablet.
    scenes.forEach((s) => s.querySelectorAll("video[data-once]").forEach((v) => v.addEventListener("ended", () => s.classList.add("is-ended"))));
    // A clip's scene lasts as long as the clip.
    scenes.forEach((s) => s.querySelectorAll("video[data-clip]").forEach((v) => {
      // A short clip loops under the box for the scene's own length; a longer
      // one sets the length itself.
      v.addEventListener("loadedmetadata", () => { if (isFinite(v.duration) && v.duration > Number(s.dataset.secs || 0)) s.dataset.secs = String(Math.round(v.duration * 10) / 10); });
    }));
    show(0);
  })();
</script>
