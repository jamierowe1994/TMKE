<script>
  (function () {
    const film = document.getElementById("film");
    if (!film) return;
    // ?frame=1 shows the clip in a laptop instead of the stills.
    if (new URLSearchParams(location.search).has("frame")) film.dataset.variant = "laptop";
    const scenes = Array.from(film.querySelectorAll(".scene"));
    const segs = Array.from(film.querySelectorAll(".film-seg"));
    const hud = document.getElementById("film-hud");
    let i = -1, timer = 0, startedAt = 0, remaining = 0, paused = false;

    function secsOf(n) { return Number(scenes[n].dataset.secs || 6) * 1000; }
    // A scene change. Fade: the old scene fades out whole, then the new one
    // comes in (its pieces start arriving only then). Push: both move at once.
    let transTimer = 0;
    // Clear a scene's transition classes with transitions off, so it cannot
    // flash back to full before it is hidden. off: take is-on away too.
    function settle(s, off) { s.style.transition = "none"; s.classList.remove("is-out", "is-push-out", "is-push-in"); if (off) s.classList.remove("is-on"); void s.offsetWidth; s.style.transition = ""; }
    function show(n) {
      if (n < 0 || n >= scenes.length) return;
      clearTimeout(timer); clearTimeout(transTimer);
      const prev = i; i = n;
      scenes.forEach((s, k) => { if (k !== prev && k !== n) settle(s, true); s.setAttribute("aria-hidden", k === n ? "false" : "true"); });
      let wait = 0;
      const next = scenes[n];
      if (prev >= 0 && prev !== n) {
        // The old scene keeps is-on while it leaves, so its pieces leave with it.
        const old = scenes[prev];
        settle(old); settle(next);
        if (next.dataset.enter === "push") {
          old.classList.add("is-push-out");
          next.classList.add("is-push-in", "is-on");
          transTimer = setTimeout(() => settle(old, true), 1050);
        } else {
          old.classList.add("is-out");
          wait = 700;
          transTimer = setTimeout(() => { settle(old, true); next.classList.add("is-on"); }, wait);
        }
      } else if (prev !== n) {
        next.classList.add("is-on");
      }
      film.classList.toggle("is-light", /scene--(prompts|edit|ask|associate|phone|studio|clip|learn|tablet)\b/.test(scenes[n].className));
      film.classList.toggle("is-shot", /scene--(studio|clip)\b/.test(scenes[n].className));
      segs.forEach((g, k) => {
        g.classList.toggle("is-done", k < n);
        g.classList.remove("is-live");
        g.style.removeProperty("--at");
        if (k === n) { g.style.setProperty("--secs", secsOf(n) + "ms"); void g.offsetWidth; g.classList.add("is-live"); }
      });
      scenes[n].style.setProperty("--drift", secsOf(n) + "ms");
      scenes.forEach((s, k) => s.querySelectorAll("video[data-clip]").forEach((v) => { if (k === n) { s.classList.remove("is-ended"); try { v.currentTime = 0; v.playbackRate = Number(v.dataset.rate || 1); v.play().catch(() => {}); } catch (_) {} } else { v.pause(); } }));
      stillsStart(); typeStart();
      remaining = secsOf(n) + wait; startedAt = Date.now();
      if (!paused) arm();
    }
    function arm() {
      clearTimeout(timer);
      if (i >= scenes.length - 1) return;                // the close holds
      timer = setTimeout(() => show(i + 1), remaining);
    }
    function pause() {
      if (paused) return;
      paused = true; clearTimeout(timer);
      remaining = Math.max(0, remaining - (Date.now() - startedAt));
      const g = segs[i]; if (g) g.style.setProperty("--at", String(1 - remaining / secsOf(i)));
      film.classList.add("is-paused");
    }
    function resume() {
      if (!paused) return;
      paused = false; startedAt = Date.now();
      film.classList.remove("is-paused");
      const g = segs[i];
      if (g) { g.classList.remove("is-live"); g.style.removeProperty("--at"); g.style.setProperty("--secs", remaining + "ms"); void g.offsetWidth; g.classList.add("is-live"); }
      arm();
    }
    function toggle() { paused ? resume() : pause(); }

    document.getElementById("film-next").addEventListener("click", () => { if (paused) resume(); show(Math.min(scenes.length - 1, i + 1)); });
    document.getElementById("film-prev").addEventListener("click", () => { if (paused) resume(); show(Math.max(0, i - 1)); });
    const replay = document.getElementById("film-replay");
    if (replay) replay.addEventListener("click", () => { paused = false; film.classList.remove("is-paused"); show(0); });
    document.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") { if (paused) resume(); show(Math.min(scenes.length - 1, i + 1)); }
      else if (e.key === "ArrowLeft") { if (paused) resume(); show(Math.max(0, i - 1)); }
      else if (e.key === " ") { e.preventDefault(); toggle(); }
    });
    // A click on the screen pauses; a second one plays. The edge zones, the
    // buttons and the links keep their own jobs.
    film.addEventListener("click", (e) => {
      if (e.target.closest(".film-tap, a, button")) return;
      toggle();
    });
    // Hold to pause on a touch screen; the tap zones still step.
    let holdT = 0, held = false;
    film.addEventListener("touchstart", () => { held = false; holdT = setTimeout(() => { held = true; pause(); }, 350); }, { passive: true });
    film.addEventListener("touchend", () => { clearTimeout(holdT); if (held) resume(); }, { passive: true });
    film.querySelectorAll(".film-tap").forEach((b) => b.addEventListener("click", (e) => { if (held) e.stopImmediatePropagation(); }, true));
    document.addEventListener("visibilitychange", () => { if (document.hidden) pause(); else resume(); });

    // A one-shot clip (the associate walking in) holds its last frame and
    // tells its scene it has ended, which brings the chat up on her tablet.
    scenes.forEach((s) => s.querySelectorAll("video[data-once]").forEach((v) => v.addEventListener("ended", () => s.classList.add("is-ended"))));
    // A clip that carries the scene: when it has played once, the film moves on.
    scenes.forEach((s, k) => s.querySelectorAll("video[data-advance]").forEach((v) => v.addEventListener("ended", () => { if (i === k && !paused) show(k + 1); })));
    // Typed lines: each [data-type] in the scene starts empty and is typed
    // out from its data-at second, a character every 28ms, on a clock that
    // stops while the film is paused.
    let typeRaf = 0;
    function typeStart() {
      cancelAnimationFrame(typeRaf);
      const els = Array.from(scenes[i].querySelectorAll("[data-type]"));
      if (!els.length) return;
      els.forEach((e) => { e.textContent = ""; e.classList.remove("is-typing"); });
      let clock = 0, last = performance.now();
      const scene = scenes[i];
      const tick = (now) => {
        if (!scene.classList.contains("is-on")) return;
        if (!paused) clock += (now - last) / 1000;
        last = now;
        let done = true;
        els.forEach((e) => {
          const full = e.dataset.type, at = Number(e.dataset.at || 0);
          const n = Math.max(0, Math.min(full.length, Math.floor((clock - at) / 0.028)));
          if (e.textContent.length !== n) e.textContent = full.slice(0, n);
          const typing = clock >= at && n < full.length;
          e.classList.toggle("is-typing", typing);
          if (n < full.length) done = false;
        });
        if (!done) typeRaf = requestAnimationFrame(tick);
      };
      typeRaf = requestAnimationFrame(tick);
    }
    // The Studio stills: a clock that stops while the film is paused shows
    // each still for its seconds and types the word on the typing screens;
    // the film moves on 0.7s before the last still ends, so the fade runs
    // over it.
    let stillsStart = () => {};
    const stillsEl = film.querySelector(".tablet--stills");
    if (stillsEl) {
      const list = JSON.parse(stillsEl.dataset.stills), imgs = stillsEl.querySelectorAll(".tstill"), typ = stillsEl.querySelector(".ttype");
      const k = scenes.indexOf(stillsEl.closest(".scene"));
      const total = list.reduce((a, e) => a + e.secs, 0);
      let clock = 0, last = 0, running = false, raf = 0;
      function render(t) {
        let acc = 0, cur = list.length - 1, into = 0;
        for (let n = 0; n < list.length; n++) { if (t < acc + list[n].secs) { cur = n; into = t - acc; break; } acc += list[n].secs; }
        imgs.forEach((im, n) => im.classList.toggle("is-cur", n === cur));
        const e = list[cur];
        if (e.type) { typ.textContent = e.type.slice(0, Math.min(e.type.length, Math.floor(into / 0.07))); typ.hidden = false; } else typ.hidden = true;   /* typed in under half a second, then held */
      }
      function tick(now) {
        if (!running) return;
        if (!paused) clock += (now - last) / 1000;
        last = now;
        render(clock);
        if (clock >= total - 0.7 && i === k && !paused) { running = false; show(k + 1); return; }
        raf = requestAnimationFrame(tick);
      }
      // Decoded up front, and again before each run: a picture that decodes
      // mid-sequence shows as a flash where the screen should be.
      const warm = () => Promise.all(Array.from(imgs).map((im) => (im.decode ? im.decode().catch(() => {}) : Promise.resolve())));
      warm();
      stillsStart = () => {
        cancelAnimationFrame(raf);
        if (i !== k) { running = false; return; }
        render(0);
        warm().then(() => {
          if (i !== k) return;
          clock = 0; last = performance.now(); running = true;
          raf = requestAnimationFrame(tick);
        });
      };
    }
    // A clip's scene lasts as long as the clip.
    scenes.forEach((s) => s.querySelectorAll("video[data-clip]").forEach((v) => {
      // A short clip loops under the box for the scene's own length; a longer
      // one sets the length itself.
      v.addEventListener("loadedmetadata", () => { if (isFinite(v.duration) && v.duration > Number(s.dataset.secs || 0)) s.dataset.secs = String(Math.round(v.duration * 10) / 10); });
    }));
    show(0);
  })();
</script>
