---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Set a new password — TMKE"
  description="Choose a new password for your TMKE library."
  hideFooter={true}
>
  <main class="login-shell">
    <div class="login-art" aria-hidden="true">
      <div class="login-art-overlay"></div>
      <div class="login-art-quote">
        <div class="chapter chapter--light">Members &middot; Reset</div>
        <p class="login-art-line">
          One last step,<br />
          <em>and you're back in.</em>
        </p>
      </div>
    </div>

    <section class="login-panel">
      <a href="/" class="login-mark">TMKE</a>

      <div class="login-card">
        <div class="eyebrow">Set new password</div>
        <h1 class="login-title">Choose a new password.</h1>
        <p class="login-sub">
          Eight characters minimum. We'll log you in once you save it.
        </p>

        <!-- Loading state — verifying the recovery token in the URL -->
        <div id="reset-loading" class="login-hint" style="margin-bottom:24px">
          Verifying your link…
        </div>

        <!-- Invalid / expired link -->
        <div id="reset-invalid" class="login-error" hidden>
          <p>This reset link is invalid or has expired.</p>
          <p style="margin-top:8px">
            <a href="/forgot-password" class="login-inline-anchor">Send a new one</a>.
          </p>
        </div>

        <!-- Form -->
        <form id="reset-form" class="login-form" novalidate hidden>
          <label class="login-field">
            <span>New password</span>
            <input type="password" name="password" autocomplete="new-password" required minlength="8" placeholder="At least 8 characters" />
          </label>
          <label class="login-field">
            <span>Confirm password</span>
            <input type="password" name="confirm" autocomplete="new-password" required minlength="8" placeholder="Re-enter" />
          </label>

          <button type="submit" class="btn btn--solid login-submit">
            <span data-label>Update password</span> <span class="btn-arrow">&rarr;</span>
          </button>

          <p id="reset-error" class="login-error" hidden></p>
        </form>
      </div>

      <p class="login-meta">© 2026 TMKE — The Marketing Experts</p>
    </section>
  </main>

  <style>
    main.login-shell {
      display: grid; grid-template-columns: 1.05fr 1fr;
      min-height: 100vh; background: var(--paper);
    }
    .login-art {
      position: relative; overflow: hidden;
      background:
        linear-gradient(180deg, rgba(28,29,34,0.2), rgba(28,29,34,0.7)),
        url("/assets/door-closed.png") center/cover no-repeat;
      color: var(--paper);
    }
    .login-art-overlay {
      position: absolute; inset: 0;
      background: radial-gradient(80% 60% at 50% 40%, rgba(0,0,0,0) 30%, rgba(0,0,0,0.35) 100%);
      pointer-events: none;
    }
    .login-art-quote { position: absolute; inset: auto 0 0 0; padding: 0 56px 80px; }
    .login-art-quote .chapter { margin-bottom: 48px; }
    .login-art-line {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(40px, 4.4vw, 68px);
      line-height: 1.05; letter-spacing: -0.015em;
      margin: 0; color: var(--paper); max-width: 14ch;
    }
    .login-art-line em { font-style: italic; color: var(--french-grey); }
    .login-panel {
      position: relative; display: flex; flex-direction: column;
      align-items: center; justify-content: center; padding: 48px 36px;
    }
    .login-mark {
      position: absolute; top: 32px; left: 36px;
      font-family: var(--serif); font-size: 24px;
      letter-spacing: 0.06em; color: var(--ink);
    }
    .login-card { width: 100%; max-width: 440px; }
    .login-card .eyebrow { margin-bottom: 14px; }
    .login-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(36px, 3.6vw, 52px);
      line-height: 1.05; letter-spacing: -0.015em;
      color: var(--ink); margin: 0 0 18px;
    }
    .login-sub { font-size: 15px; color: rgba(28, 29, 34, 0.62); margin: 0 0 36px; }
    .login-form { display: flex; flex-direction: column; gap: 18px; }
    .login-field { display: flex; flex-direction: column; gap: 8px; }
    .login-field > span {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(28, 29, 34, 0.55);
    }
    .login-field input {
      font-family: var(--sans); font-size: 16px;
      padding: 14px 16px;
      border: 1px solid rgba(28, 29, 34, 0.18);
      border-radius: 2px; background: #fff; color: var(--ink);
      transition: border-color 0.25s, box-shadow 0.25s;
    }
    .login-field input:focus {
      outline: none; border-color: var(--english-violet);
      box-shadow: 0 0 0 3px rgba(71, 66, 84, 0.12);
    }
    .login-submit { width: 100%; justify-content: center; padding: 16px; margin-top: 8px; }
    .login-error {
      font-size: 13px; color: #a05a3c;
      background: rgba(160, 90, 60, 0.08);
      padding: 10px 14px; border-radius: 2px; margin: 0;
    }
    .login-inline-anchor {
      color: var(--english-violet);
      border-bottom: 1px solid currentColor; font-weight: 600;
    }
    .login-hint { font-size: 12px; color: rgba(28, 29, 34, 0.5); line-height: 1.5; }
    .login-meta {
      position: absolute; bottom: 32px;
      font-size: 11px; letter-spacing: 0.2em;
      text-transform: uppercase; color: rgba(28, 29, 34, 0.35);
    }
    @media (max-width: 900px) {
      main.login-shell { grid-template-columns: 1fr; }
      .login-art { display: none; }
    }
  </style>

  <script>
    import { supabase } from "../lib/supabase.js";

    const $loading = document.getElementById("reset-loading");
    const $invalid = document.getElementById("reset-invalid");
    const $form = document.getElementById("reset-form");
    const $error = document.getElementById("reset-error");

    function showError(msg) { $error.textContent = msg; $error.hidden = false; }

    // Supabase puts the recovery token in the URL fragment when the user
    // clicks the email link. The supabase-js client picks it up automatically
    // and emits a PASSWORD_RECOVERY auth event. We just need to wait for it.
    let recoveryReady = false;
    const sub = supabase.auth.onAuthStateChange(async (event, session) => {
      if (event === "PASSWORD_RECOVERY" || (event === "SIGNED_IN" && session)) {
        recoveryReady = true;
        $loading.hidden = true;
        $form.hidden = false;
      }
    });

    // Fallback — if neither a recovery event nor a session shows up within
    // a couple of seconds, the link's bad.
    setTimeout(async () => {
      if (recoveryReady) return;
      const { data: { session } } = await supabase.auth.getSession();
      if (session) {
        // Already a valid session — let them set a new password directly.
        $loading.hidden = true;
        $form.hidden = false;
      } else {
        $loading.hidden = true;
        $invalid.hidden = false;
      }
    }, 2500);

    $form.addEventListener("submit", async (e) => {
      e.preventDefault();
      $error.hidden = true;
      const data = new FormData($form);
      const password = String(data.get("password") || "");
      const confirm = String(data.get("confirm") || "");
      if (password.length < 8) { showError("Choose at least 8 characters."); return; }
      if (password !== confirm) { showError("Passwords don't match."); return; }

      const btn = $form.querySelector('button[type="submit"]');
      const label = btn.querySelector("[data-label]");
      btn.setAttribute("disabled", "true");
      const orig = label.textContent;
      label.textContent = "Saving…";

      const { error } = await supabase.auth.updateUser({ password });
      if (error) {
        btn.removeAttribute("disabled");
        label.textContent = orig;
        showError(error.message);
        return;
      }

      // Password updated — they're now signed in. Bounce to the splash.
      if (typeof window.tmkeSplash === "function") {
        window.tmkeSplash("/account");
      } else {
        location.href = "/account";
      }
    });
  </script>
</BaseLayout>
