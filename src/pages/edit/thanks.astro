---
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/ws-system.css";
---

<!--
  Post-checkout confirmation. Public: the buyer may not have an account yet,
  which is what the password step is for — so this keeps the site's own nav
  rather than the member header.

  Everything else follows the hub: the same eyebrow / heading / subheading the
  dashboard uses, the same 37px buttons, the same hairline square cards. Seasons
  appears once, on the greeting, exactly as it does in /account.
-->
<BaseLayout
  dashboard
  title="Thank you — your TMKE order · The Edit"
  description="Your TMKE pack purchase is confirmed. Set a password to access your library and download your invoice."
  hideFooter={true}
>
  <div class="ws">
  <main class="thanks-shell">

    <!-- Eyebrow / heading / subheading — the dashboard's hero, minus the photo. -->
    <section class="thanks-hero">
      <p class="ws-hero-date">Order #<span id="thanks-invoice">&hellip;</span></p>
      <h1 class="ws-greeting"><span class="ws-greet-line">Thank you,</span> <span class="ws-greet-name" id="thanks-name">friend</span>.</h1>
      <p class="ws-hero-sub">
        Your purchase is confirmed &mdash; a receipt has been emailed to
        <strong id="thanks-email">you</strong>.
      </p>
    </section>

    <section class="thanks-grid">
      <!-- Left: receipt -->
      <article class="thanks-receipt">
        <header class="thanks-receipt-head">
          <div>
            <div class="thanks-receipt-eyebrow">Invoice</div>
            <div class="thanks-receipt-no" id="thanks-invoice-2">&mdash;</div>
          </div>
          <div class="thanks-receipt-meta">
            <span>TMKE &mdash; The Marketing Experts</span>
            <span id="thanks-date">&mdash;</span>
          </div>
        </header>

        <div class="thanks-receipt-row">
          <div class="thanks-receipt-thumb" id="thanks-cover"></div>
          <div class="thanks-receipt-info">
            <h3 id="thanks-pack-title">&hellip;</h3>
            <p id="thanks-pack-desc"></p>
          </div>
          <div class="thanks-receipt-amount" id="thanks-amount">&mdash;</div>
        </div>

        <dl class="thanks-receipt-list">
          <div><dt>Billed to</dt><dd id="thanks-billto">&mdash;</dd></div>
          <div><dt>Company</dt><dd id="thanks-company">&mdash;</dd></div>
          <div><dt>Email</dt><dd id="thanks-email-2">&mdash;</dd></div>
          <div><dt>Phone</dt><dd id="thanks-phone">&mdash;</dd></div>
          <div><dt>Payment</dt><dd id="thanks-method">&mdash;</dd></div>
          <div><dt>Status</dt><dd><span class="pill" id="thanks-status">&mdash;</span></dd></div>
        </dl>

        <footer class="thanks-receipt-foot">
          <div>
            <div class="thanks-receipt-eyebrow">Total paid</div>
            <div class="thanks-receipt-total" id="thanks-total">&mdash;</div>
          </div>
          <button type="button" class="ws-btn ws-btn--ghost" id="download-invoice">
            Download invoice
            <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M8 2v8m0 0L5 7m3 3 3-3M3 13h10" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </footer>
      </article>

      <!-- Right: account setup. Bottom-aligned so its last line sits on the
           receipt's bottom edge rather than floating halfway up. -->
      <article class="thanks-setup">
        <div class="thanks-setup-inner">
          <p class="thanks-setup-eyebrow">Last step</p>
          <h2 class="thanks-setup-h">Set a password to access your library.</h2>
          <p class="thanks-setup-sub">
            We&rsquo;ve created your account with the email above. Choose a password and
            you&rsquo;ll go straight to your library where your new pack is waiting.
          </p>

          <form id="password-form" class="thanks-form" novalidate>
            <label class="ck-field">
              <span>Password</span>
              <input type="password" name="password" autocomplete="new-password" minlength="8" required placeholder="At least 8 characters" />
            </label>
            <label class="ck-field">
              <span>Confirm password</span>
              <input type="password" name="confirm" autocomplete="new-password" minlength="8" required />
            </label>
            <p class="ck-error" id="password-error" hidden></p>
            <button type="submit" class="ws-btn ws-btn--primary" id="password-submit">
              Create my library
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </button>
          </form>

          <div class="thanks-success" id="password-success" hidden>
            <div class="thanks-success-mark">&#10003;</div>
            <h3>Password saved.</h3>
            <p id="thanks-success-msg">Your library is unlocked &mdash; jump straight in.</p>
            <a href="/account" class="ws-btn ws-btn--primary">
              Open your library
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </div>

          <p class="thanks-setup-foot">
            Already have an account?
            <a href="/login" class="thanks-link">Sign in instead</a>.
          </p>
        </div>
      </article>
    </section>
  </main>
  </div>

  <style is:global>
    body:has(.thanks-shell) { background: #ffffff; }
  </style>

  <style is:global>
    /* .nav is position:fixed and 57px tall, so it is out of flow entirely and
       the page has to clear it itself — at 40px of padding the eyebrow was
       running under the logo. 57 + breathing room, not a magic number. */
    .thanks-shell { max-width: 1200px; margin: 0 auto; padding: calc(57px + clamp(24px, 3vh, 44px)) clamp(22px, 2.6vw, 56px) 100px; }

    /* Hero: the dashboard's three-part heading, nothing else. Seasons lands on
       .ws-greeting only — every other line here is Helios or Darker Grotesque. */
    .thanks-hero { margin-bottom: clamp(28px, 3.4vh, 48px); max-width: 660px; }
    /* 46ch wrapped the greeting after "Thank you," — the dashboard fits its
       greeting on one line and this should match. A pixel cap sized to the
       greeting, not a character cap sized to the subtitle. */

    /* Receipt left, account setup right, both the same height so the setup
       column can sit its last line on the receipt's bottom edge. */
    .thanks-grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: clamp(20px, 2.4vw, 36px); align-items: stretch; }
    @media (max-width: 900px) { .thanks-grid { grid-template-columns: 1fr; } }

    /* ---- Receipt. Hairline outline, square corners, no fill — house rules. ---- */
    .thanks-receipt { background: #fff; border: 1px solid var(--ws-line); border-radius: var(--ws-r); overflow: hidden; align-self: start; }
    .thanks-receipt-eyebrow { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 0; }
    .thanks-receipt-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 20px; padding: 22px 24px; border-bottom: 1px solid var(--ws-line); }
    .thanks-receipt-no { font-family: var(--serif); font-size: 22px; font-weight: 600; letter-spacing: -0.01em; margin-top: 6px; font-variant-numeric: tabular-nums; }
    .thanks-receipt-meta { display: flex; flex-direction: column; gap: 3px; text-align: right; font-family: var(--sans); font-size: 12.5px; color: var(--ws-tx); }

    /* 3:4 portrait, matching what the Studio actually outputs. Aligned to the
       top with the title and the price, so the three read as one line. */
    .thanks-receipt-row { display: grid; grid-template-columns: 96px minmax(0, 1fr) auto; gap: 20px; align-items: start; padding: 22px 24px; border-bottom: 1px solid var(--ws-line); }
    .thanks-receipt-thumb { width: 96px; aspect-ratio: 3 / 4; border-radius: var(--ws-r); background: #e9e6e2 center/cover no-repeat; }
    .thanks-receipt-info h3 { font-family: var(--serif); font-size: 17px; font-weight: 600; letter-spacing: -0.01em; margin: 0 0 5px; }
    .thanks-receipt-info p { font-family: var(--sans); font-size: 12.5px; line-height: 1.5; color: var(--ws-tx); margin: 0; }
    .thanks-receipt-amount { font-family: var(--serif); font-size: 20px; font-weight: 600; font-variant-numeric: tabular-nums; }

    .thanks-receipt-list { display: grid; grid-template-columns: 1fr 1fr; gap: 16px 32px; padding: 22px 24px; margin: 0; border-bottom: 1px solid var(--ws-line); }
    @media (max-width: 620px) { .thanks-receipt-list { grid-template-columns: 1fr; } }
    .thanks-receipt-list > div { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    .thanks-receipt-list dt { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 0; }
    .thanks-receipt-list dd { font-family: var(--sans); font-size: 14px; margin: 0; word-break: break-word; }

    .pill { display: inline-block; font-family: var(--sans); font-size: 9.5px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; padding: 4px 9px; border-radius: 999px; background: rgba(63,148,104,0.12); color: #2f6f4d; border: 1px solid rgba(63,148,104,0.3); }
    .pill[data-status="pending"] { background: rgba(201,122,58,0.12); color: #8a4d1f; border-color: rgba(201,122,58,0.32); }
    .pill[data-status="failed"], .pill[data-status="refunded"] { background: rgba(28,29,34,0.05); color: var(--ws-tx); border-color: var(--ws-line); }

    .thanks-receipt-foot { display: flex; align-items: center; justify-content: space-between; gap: 20px; flex-wrap: wrap; padding: 22px 24px; }
    .thanks-receipt-total { font-family: var(--serif); font-size: clamp(26px, 2.6vw, 32px); font-weight: 600; letter-spacing: -0.015em; margin-top: 6px; font-variant-numeric: tabular-nums; }

    /* ---- Account setup ---- */
    .thanks-setup { display: flex; }
    /* Pushed to the bottom so "Already have an account?" lands on the receipt's
       bottom edge, with the breathing room above rather than below. */
    .thanks-setup-inner { display: flex; flex-direction: column; margin-top: auto; width: 100%; }
    @media (max-width: 900px) { .thanks-setup-inner { margin-top: 0; } }
    .thanks-setup-eyebrow { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); margin: 0 0 10px; }
    .thanks-setup-h { font-family: var(--serif); font-size: clamp(20px, 2vw, 25px); font-weight: 600; line-height: 1.2; letter-spacing: -0.01em; margin: 0; }
    .thanks-setup-sub { font-family: var(--sans); font-size: 13.5px; line-height: 1.55; color: var(--ws-tx); margin: 10px 0 0; }

    .thanks-form { display: flex; flex-direction: column; gap: 12px; margin-top: 20px; }
    .ck-field { display: flex; flex-direction: column; gap: 5px; }
    .ck-field span { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: var(--ws-faint); }
    .ck-field input { font-family: var(--sans); font-size: 14px; padding: 10px 12px; border: 1px solid var(--ws-line); border-radius: var(--ws-r); background: #fff; color: var(--ws-ink); }
    .ck-field input:focus { outline: none; border-color: var(--ws-accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--ws-accent) 12%, transparent); }
    .ck-error { font-family: var(--sans); font-size: 12.5px; color: #8a2f2f; margin: 0; }
    .thanks-form .ws-btn { align-self: flex-start; margin-top: 4px; }

    .thanks-success { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; margin-top: 20px; padding: 20px; border: 1px solid var(--ws-line); border-radius: var(--ws-r); }
    .thanks-success-mark { width: 30px; height: 30px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; background: rgba(63,148,104,0.12); color: #2f6f4d; font-size: 14px; }
    .thanks-success h3 { font-family: var(--serif); font-size: 17px; font-weight: 600; margin: 0; }
    .thanks-success p { font-family: var(--sans); font-size: 13px; line-height: 1.5; color: var(--ws-tx); margin: 0; }
    .thanks-success .ws-btn { margin-top: 6px; }

    .thanks-setup-foot { font-family: var(--sans); font-size: 12.5px; color: var(--ws-tx); margin: 18px 0 0; }
    .thanks-link { color: var(--ws-accent); font-weight: 600; text-decoration: none; }
    .thanks-link:hover { text-decoration: underline; }

    /* The [hidden] attribute must win over the flex/grid rules above. */
    .thanks-grid[hidden], .thanks-form[hidden], .thanks-success[hidden] { display: none !important; }
  </style>

  <script>
    import { supabase, gbpFromPence } from '../../lib/supabase.js';

    const params = new URLSearchParams(window.location.search);
    const orderId = params.get('order');

    const elInvoice = document.getElementById('thanks-invoice');
    const elInvoice2 = document.getElementById('thanks-invoice-2');
    const elName = document.getElementById('thanks-name');
    const elEmail = document.getElementById('thanks-email');
    const elEmail2 = document.getElementById('thanks-email-2');
    const elBillTo = document.getElementById('thanks-billto');
    const elCompany = document.getElementById('thanks-company');
    const elPhone = document.getElementById('thanks-phone');
    const elMethod = document.getElementById('thanks-method');
    const elAmount = document.getElementById('thanks-amount');
    const elTotal = document.getElementById('thanks-total');
    const elDate = document.getElementById('thanks-date');
    const elCover = document.getElementById('thanks-cover');
    const elPackTitle = document.getElementById('thanks-pack-title');
    const elPackDesc = document.getElementById('thanks-pack-desc');
    const form = document.getElementById('password-form');
    const formError = document.getElementById('password-error');
    const submitBtn = document.getElementById('password-submit');
    const successEl = document.getElementById('password-success');
    const successMsg = document.getElementById('thanks-success-msg');
    const dlBtn = document.getElementById('download-invoice');

    function formatMethod(m) {
      return { apple_pay: 'Apple Pay', google_pay: 'Google Pay', card: 'Card' }[m] || m;
    }
    function formatDate(iso) {
      try {
        return new Date(iso).toLocaleDateString('en-GB', { day: '2-digit', month: 'long', year: 'numeric' });
      } catch (_) { return ''; }
    }

    let orderRow = null;
    let packRow = null;

    async function loadOrder() {
      if (!orderId) {
        document.querySelector('.thanks-hero').innerHTML =
          `<h1 class="thanks-h1">Order not found</h1>
           <p class="thanks-sub">We couldn't find that order. <a class="thanks-link" href="/edit">Return to The Edit</a>.</p>`;
        document.querySelector('.thanks-grid').hidden = true;
        return;
      }

      const { data, error } = await supabase
        .from('orders')
        .select('*')
        .eq('id', orderId)
        .single();

      if (error || !data) {
        document.querySelector('.thanks-hero').innerHTML =
          `<h1 class="thanks-h1">Order not found</h1>
           <p class="thanks-sub">We couldn't load that order. <a class="thanks-link" href="/edit">Return to The Edit</a>.</p>`;
        document.querySelector('.thanks-grid').hidden = true;
        return;
      }

      orderRow = data;

      // Hydrate
      elInvoice.textContent = data.invoice_number ?? '—';
      elInvoice2.textContent = data.invoice_number ?? '—';
      elName.textContent = (data.buyer_name || 'friend').split(' ')[0];
      elEmail.textContent = data.buyer_email;
      elEmail2.textContent = data.buyer_email;
      elBillTo.textContent = data.buyer_name;
      elCompany.textContent = data.buyer_company || '—';
      elPhone.textContent = data.buyer_phone || '—';
      elMethod.textContent = formatMethod(data.payment_method);
      elAmount.textContent = gbpFromPence(data.amount_pence);
      elTotal.textContent = gbpFromPence(data.amount_pence);
      elDate.textContent = formatDate(data.created_at);
      elPackTitle.textContent = data.pack_title;

      // Status pill. With Stripe, the webhook flips the order to 'paid' a moment
      // after the redirect lands here — so if it's still 'pending', poll briefly.
      const statusEl = document.getElementById('thanks-status');
      const paintStatus = (st) => {
        if (!statusEl) return;
        statusEl.textContent = ({ paid: 'Paid', pending: 'Processing…', failed: 'Failed', refunded: 'Refunded' })[st] || st;
        statusEl.dataset.status = st;
      };
      paintStatus(data.status);
      if (data.status === 'pending') {
        let tries = 0;
        const iv = setInterval(async () => {
          tries += 1;
          const { data: fresh } = await supabase.from('orders').select('status, payment_method').eq('id', orderId).single();
          if (fresh && fresh.status && fresh.status !== 'pending') {
            paintStatus(fresh.status);
            if (fresh.payment_method) elMethod.textContent = formatMethod(fresh.payment_method);
            clearInterval(iv);
          } else if (tries >= 8) {
            clearInterval(iv);
          }
        }, 1500);
      }

      // Pull description + cover from the pack record so the receipt shows context.
      if (data.pack_id) {
        const { data: pack } = await supabase
          .from('packs')
          .select('description, cover_image_url')
          .eq('id', data.pack_id)
          .single();
        if (pack) {
          packRow = pack;
          elPackDesc.textContent = pack.description || '';
          if (pack.cover_image_url) elCover.style.backgroundImage = `url('${pack.cover_image_url}')`;
        }
      }

      // Pre-fill the form email is implicit (already shown above).
      form.elements.password.focus();
    }

    // ============== Password setup ==============
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      formError.hidden = true;
      if (!orderRow) return;

      const password = String(form.elements.password.value || '');
      const confirm = String(form.elements.confirm.value || '');
      if (password.length < 8) {
        formError.textContent = 'Use at least 8 characters.';
        formError.hidden = false;
        return;
      }
      if (password !== confirm) {
        formError.textContent = "Passwords don't match.";
        formError.hidden = false;
        return;
      }

      submitBtn.setAttribute('disabled', 'true');
      submitBtn.textContent = 'Creating account…';

      // Create the auth account against the email captured at checkout.
      const { data, error } = await supabase.auth.signUp({
        email: orderRow.buyer_email,
        password,
        options: {
          data: {
            name: orderRow.buyer_name,
            company: orderRow.buyer_company,
            phone: orderRow.buyer_phone,
          },
        },
      });

      submitBtn.removeAttribute('disabled');
      submitBtn.innerHTML = 'Create my library <em>&rarr;</em>';

      if (error) {
        // Most common: account already exists. Offer sign-in route.
        formError.innerHTML = error.message
          + ' &nbsp; <a class="thanks-link" href="/login">Sign in instead</a>.';
        formError.hidden = false;
        return;
      }

      // If a session was returned, link the order to the new user id.
      if (data?.user?.id) {
        await supabase
          .from('orders')
          .update({ user_id: data.user.id })
          .eq('id', orderRow.id);
      }

      // Fire the "account created" marketing automation (welcome series).
      // Best-effort + fire-and-forget; needs a session to authorise the call.
      try {
        const WORKER = (import.meta.env.PUBLIC_R2_WORKER_URL || '').replace(/\/+$/, '');
        const token = data?.session?.access_token;
        if (WORKER && token) {
          const parts = String(orderRow.buyer_name || '').trim().split(/\s+/);
          fetch(`${WORKER}/automations/fire`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Authorization: `Bearer ${token}` },
            body: JSON.stringify({
              trigger: 'account_created', email: orderRow.buyer_email,
              first_name: parts.shift() || null, last_name: parts.join(' ') || null,
              company: orderRow.buyer_company || null, phone: orderRow.buyer_phone || null,
              source: 'pack_signup', lifecycle: 'customer', user_id: data.user.id,
            }),
          }).catch(() => {});
        }
      } catch (_) {}

      // Show the success card. If we have a session, send them to /account.
      form.hidden = true;
      successEl.hidden = false;
      if (data?.session) {
        successMsg.textContent = "You're signed in — your library is unlocked. Jump straight in.";
      } else {
        successMsg.textContent =
          'Check your inbox to verify your email, then sign in to open your library.';
      }
    });

    // Browser-side invoice "download" — opens print dialog scoped to the
    // receipt block; users can save to PDF. Real email-sent PDF lands when
    // we wire up Resend/SendGrid behind an edge function.
    // The invoice download uses the real TMKE invoice template — the same
    // renderer the admin centre uses for videography and social invoices — so a
    // pack receipt looks like every other invoice the business sends, rather
    // than like a screenshot of this page.
    //
    // invoice_settings is admin-policy-only, so a member's fetch returns
    // nothing; the renderer's own defaults cover that. show_bank is forced off
    // regardless: this is already paid, so payment instructions are noise, and
    // it keeps bank details out of a member-facing document.
    dlBtn.addEventListener('click', async () => {
      if (!orderRow) return;
      const [{ renderInvoiceHtml }, { supabase: sb }] = await Promise.all([
        import('../../lib/invoice-render.js'),
        import('../../lib/supabase.js'),
      ]);

      let settings = {};
      try {
        const { data } = await sb.from('invoice_settings').select('*').limit(1).maybeSingle();
        if (data) settings = data;
      } catch (_) { /* defaults */ }

      const ymd = (iso) => { try { return new Date(iso).toISOString().slice(0, 10); } catch (_) { return ''; } };
      const issued = ymd(orderRow.created_at);
      const paid = orderRow.status === 'paid' ? issued : null;

      const html = renderInvoiceHtml({
        settings: { ...settings, show_bank: false },
        invoice: {
          number: orderRow.invoice_number || '',
          issued_date: issued,
          paid_date: paid,
          status: orderRow.status,
          payment_method: orderRow.payment_method,
          bill_to_name: orderRow.buyer_name || '',
          bill_to_email: orderRow.buyer_email || '',
          bill_to_address: orderRow.buyer_company || '',
          line_items: [{ description: orderRow.pack_title || 'TMKE pack', qty: 1, unit_pence: orderRow.amount_pence || 0 }],
          subtotal_pence: orderRow.amount_pence || 0,
          vat_pence: 0,
          total_pence: orderRow.amount_pence || 0,
        },
      });

      const w = window.open('', '_blank', 'width=880,height=1000');
      if (!w) return;
      w.document.write(html);
      w.document.close();
      w.focus();
      setTimeout(() => w.print(), 400);
    });

    loadOrder();
  </script>
</BaseLayout>
