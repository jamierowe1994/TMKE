---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase, isConfigured } from "../../lib/supabase.js";

// Build-time enumeration of every active pack. New packs need a rebuild
// to land on production; the catalogue at /edit also hydrates from
// Supabase client-side so freshly-created packs still appear there.
export async function getStaticPaths() {
  // DEV-only sample so the detail page renders locally when the dev database has
  // no live packs (mirrors the SAMPLE_PACKS fallback in edit.astro). Never used
  // in production — import.meta.env.DEV is false in the build. Defined inside
  // getStaticPaths because Astro runs it in an isolated scope.
  const devSamplePaths = () => {
    const TPL = (n) => `https://assets.tmke.co.uk/TMKE%20Home%20Page/Templates/${n}.png`;
    const templates = Array.from({ length: 15 }, (_, i) => ({
      id: `s${i}`, name: `Template ${i + 1}`, category: "On the Market",
      thumb_url: TPL((i % 13) + 1), render_url: TPL((i % 13) + 1), pack_id: "sample", sort_order: i,
    }));
    const pack = {
      id: "sample", slug: "property-portfolio", status: "active", category: "On the Market",
      title: "Property Portfolio", price_pence: 29900, preview_reveal_count: 6,
      description: "Show the homes, not just the headlines. A polished set of listing layouts that make every property on your books look the part across the feed.",
      contents: ["New instruction & coming-soon layouts", "Open-house and viewing announcements", "Price change & just-sold posts"],
      cover_image_url: TPL(13), preview_images: [TPL(13), TPL(1), TPL(5), TPL(8), TPL(2)],
    };
    return [{ params: { slug: pack.slug }, props: { pack, templates } }];
  };

  if (!isConfigured) return import.meta.env.DEV ? devSamplePaths() : [];

  const { data: packs, error } = await supabase
    .from("packs")
    .select("*")
    .in("status", ["active", "draft"]);
  if (error || !packs) return import.meta.env.DEV ? devSamplePaths() : [];
  if (!packs.length && import.meta.env.DEV) return devSamplePaths();

  // Fetch templates per-pack in a single round-trip.
  const packIds = packs.map((p) => p.id);
  const { data: templates } = await supabase
    .from("templates")
    .select("id, name, category, thumb_url, render_url, pack_id, sort_order")
    .in("pack_id", packIds)
    .eq("status", "active")
    .order("sort_order", { ascending: true });

  const tplByPack = new Map();
  (templates || []).forEach((t) => {
    const list = tplByPack.get(t.pack_id) || [];
    list.push(t);
    tplByPack.set(t.pack_id, list);
  });

  return packs.map((pack) => ({
    params: { slug: pack.slug },
    props: {
      pack,
      templates: tplByPack.get(pack.id) || [],
    },
  }));
}

const { pack, templates } = Astro.props;
// Open previews, then locked teasers, then the unlock CTA.
// NB the six is only a DEFAULT: a pack with its own preview_reveal_count set in
// admin still wins. If a live pack shows three, that's its setting, not this line.
const reveal = Math.max(0, Math.min(24, pack.preview_reveal_count ?? 6));
const previewTpls = templates.slice(0, reveal);
const lockedAll = templates.slice(reveal);
// SIX locked teasers on desktop (one full row of the 6-across grid); a phone shows
// only the first TWO, because three-across turns six into two rows of blurred tiles
// you have to scroll past to reach the CTA. The page is static, so all six render
// and CSS drops the extras below 720px — the count hint still reports the TRUE
// number that unlock on purchase either way.
const lockedTpls = lockedAll.slice(0, 6);
const LOCKED_ON_MOBILE = 2;
const lockedCount = lockedAll.length;
const contents = Array.isArray(pack.contents) ? pack.contents : [];
// The big cover: an explicit cover image if set, otherwise fall back to the
// first template's (high-res) thumbnail so the hero is never a stale low-res
// pick. Clearing a pack's cover therefore shows the crisp first preview.
const coverSrc = pack.cover_image_url || (templates[0] && (templates[0].render_url || templates[0].thumb_url)) || null;
// The hero gallery: when an admin has uploaded a hover gallery (preview_images),
// those images ARE the pack's imagery — the first is the big hero and the rest
// sit underneath as a scroll-through strip. Older packs with no gallery fall
// back to the single cover image.
const galleryImgs = (Array.isArray(pack.preview_images) ? pack.preview_images : [])
  .filter((u) => typeof u === "string" && u.trim());
const heroImages = galleryImgs.length ? galleryImgs : (coverSrc ? [coverSrc] : []);
const heroMain = heroImages[0] || null;

function gbp(pence) {
  if (pence == null) return "";
  return new Intl.NumberFormat("en-GB", {
    style: "currency", currency: "GBP",
    minimumFractionDigits: pence % 100 === 0 ? 0 : 2,
  }).format(pence / 100);
}
---

<BaseLayout
  title={`${pack.title} — The Edit · TMKE`}
  description={pack.description || `${pack.title} — a curated TMKE pack of editable templates for UK property professionals.`}
  ogImage={pack.cover_image_url || undefined}
>
  <article class="pack-detail">
    <!-- ============================== HERO -->
    <header class="pack-hero wrap">
      <a href="/edit" class="pack-back">&larr; The Edit</a>

      <div class="pack-hero-grid">
        <div class="pack-cover">
          <div class="pack-cover-frame">
            {heroMain ? (
              <img class="pack-cover-img" id="pack-hero-img" src={heroMain} alt={pack.title} />
            ) : (
              <div class="pack-cover-empty">No cover image yet.</div>
            )}
          </div>
          {heroImages.length > 1 && (
            <div class="pack-hero-thumbs" aria-label="Pack images">
              {heroImages.map((src, i) => (
                <button
                  type="button"
                  class={`pack-hero-thumb${i === 0 ? " is-active" : ""}`}
                  data-hero-src={src}
                  aria-label={`Show image ${i + 1} of ${heroImages.length}`}
                >
                  <img src={src} alt="" loading={i < 4 ? "eager" : "lazy"} />
                </button>
              ))}
            </div>
          )}
        </div>

        <div class="pack-info">
          {pack.category && <div class="pack-cat">{pack.category}</div>}
          <h1 class="pack-title">{pack.title}</h1>
          {pack.description && <p class="pack-stand">{pack.description}</p>}

          <div class="pack-pricerow">
            <span class="pack-price">{gbp(pack.price_pence)}</span>
            <span class="pack-vat">+VAT · one-time payment</span>
          </div>

          <button type="button" class="btn btn--solid pack-buy" data-buy={pack.id}>
            Buy this pack <span class="btn-arrow">&rarr;</span>
          </button>

          {contents.length > 0 && (
            <div class="pack-contents">
              <div class="eyebrow">What's inside</div>
              <ul>
                {contents.map((line) => <li>{line}</li>)}
              </ul>
            </div>
          )}
        </div>
      </div>
    </header>

    <!-- ============================== PREVIEWS -->
    <section class="pack-previews wrap" id="pack-previews">
      <header class="pack-previews-head">
        <div>
          <div class="eyebrow">Inside this pack</div>
          <h2>{templates.length} editable templates</h2>
        </div>
        <p class="pack-previews-hint">
          {lockedCount > 0
            ? `Showing ${previewTpls.length} previews · ${lockedCount} more unlock when you buy.`
            : `All ${templates.length} templates included.`}
        </p>
      </header>

      <div class="pack-tpl-grid">
        {previewTpls.map((t, i) => (
          <figure
            class="pack-tpl pack-tpl--open"
            data-zoom={(t.render_url || t.thumb_url) ? "" : undefined}
            data-full={t.render_url || t.thumb_url || undefined}
            data-name={t.name}
            tabindex={(t.render_url || t.thumb_url) ? "0" : undefined}
            role={(t.render_url || t.thumb_url) ? "button" : undefined}
            aria-label={(t.render_url || t.thumb_url) ? `Enlarge ${t.name}` : undefined}
          >
            {(t.thumb_url || t.render_url)
              ? <img src={t.thumb_url || t.render_url} alt={t.name} loading={i < 4 ? "eager" : "lazy"} />
              : <div class="pack-tpl-empty"></div>}
            <figcaption>
              {t.category && <span class="pack-tpl-cat">{t.category}</span>}
              <span class="pack-tpl-name">{t.name}</span>
            </figcaption>
          </figure>
        ))}

        {lockedTpls.map((t, i) => (
          <figure
            class:list={["pack-tpl", "pack-tpl--locked", i >= LOCKED_ON_MOBILE && "pack-tpl--locked-xtra"]}
            aria-label="Locked — buy the pack to unlock"
          >
            {(t.thumb_url || t.render_url)
              ? <img src={t.thumb_url || t.render_url} alt="" loading="lazy" />
              : <div class="pack-tpl-empty"></div>}
            <div class="pack-tpl-lock-overlay">
              <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="11" width="18" height="11" rx="2"/>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
              </svg>
            </div>
            <figcaption>
              {t.category && <span class="pack-tpl-cat">{t.category}</span>}
              <span class="pack-tpl-name">Locked</span>
            </figcaption>
          </figure>
        ))}
      </div>

      {lockedCount > 0 && (
        <div class="pack-unlock-cta">
          <div>
            <h3>Unlock the full pack.</h3>
            <p>Pay once. Edit everything inside the TMKE studio. Yours forever.</p>
          </div>
          <button type="button" class="btn btn--solid" data-buy={pack.id}>
            Buy {pack.title} — {gbp(pack.price_pence)} +VAT <span class="btn-arrow">&rarr;</span>
          </button>
        </div>
      )}
    </section>
  </article>

  <!-- Lightbox — click any preview to bring it up large, then flip through the
       rest with the arrows (or ← →). -->
  <div class="pack-lightbox" id="pack-lightbox" hidden>
    <button type="button" class="pack-lightbox-close" aria-label="Close">&times;</button>
    <button type="button" class="pack-lightbox-nav pack-lightbox-prev" id="pack-lightbox-prev" aria-label="Previous">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <figure class="pack-lightbox-fig">
      <img id="pack-lightbox-img" src="" alt="" />
      <figcaption id="pack-lightbox-cap"></figcaption>
      <span class="pack-lightbox-count" id="pack-lightbox-count"></span>
    </figure>
    <button type="button" class="pack-lightbox-nav pack-lightbox-next" id="pack-lightbox-next" aria-label="Next">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>

  <style>
    .pack-detail { color: var(--ink); }

    .wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 36px;
    }

    /* 140px cleared the nav twice over and pushed the cover + thumbs off the first
       screen. 92px clears it once, with air — so the images land whole and the copy
       is what you scroll to. */
    .pack-hero { padding-top: 92px; padding-bottom: 48px; }
    .pack-back {
      display: inline-block;
      font-family: var(--sans); font-size: 12px;
      font-weight: 700; letter-spacing: 0.22em;
      text-transform: uppercase;
      color: rgba(28,29,34,0.55);
      margin-bottom: 56px;
      transition: color 0.25s;
    }
    .pack-back:hover { color: var(--english-violet); }

    .pack-hero-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 52px;
      align-items: start;
    }
    @media (max-width: 980px) {
      .pack-hero-grid { grid-template-columns: 1fr; gap: 28px; }
    }

    .pack-cover { max-width: 100%; }
    .pack-cover-frame {
      aspect-ratio: 4 / 5;
      background: rgba(var(--violet-rgb), 0.08);
      overflow: hidden;
      border-radius: 2px;
      border: 1px solid #fff;
      box-shadow: 0 2px 14px -6px rgba(28,29,34,0.22);
    }
    .pack-cover-img { width: 100%; height: 100%; object-fit: cover; display: block; }
    /* Scroll-through strip — spans the full width of the main image, thumbs
       stretched evenly so they line up edge-to-edge with the hero. */
    .pack-hero-thumbs {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 1fr;
      gap: 12px;
      margin-top: 22px;
    }
    .pack-hero-thumb {
      aspect-ratio: 4 / 5; padding: 0;
      border: 1px solid #fff; border-radius: 2px;
      box-shadow: 0 1px 8px -4px rgba(28,29,34,0.2);
      overflow: hidden; background: none; cursor: pointer;
      opacity: 0.66; transition: opacity 0.2s, box-shadow 0.2s;
    }
    .pack-hero-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pack-hero-thumb:hover { opacity: 1; }
    .pack-hero-thumb.is-active {
      opacity: 1;
      box-shadow: 0 0 0 2px var(--english-violet), 0 1px 8px -4px rgba(28,29,34,0.2);
    }
    .pack-cover-empty {
      width: 100%; height: 100%;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--sans); font-size: 12px;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(28,29,34,0.4);
    }

    .pack-info { display: flex; flex-direction: column; gap: 12px; padding-top: 8px; }
    .pack-cat {
      font-family: var(--sans); font-size: 11px;
      font-weight: 700; letter-spacing: 0.24em;
      text-transform: uppercase;
      color: var(--english-violet);
    }
    .pack-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(30px, 3.4vw, 44px);
      line-height: 1.06; letter-spacing: -0.02em;
      color: var(--ink); margin: 0;
    }
    .pack-stand {
      font-family: var(--sans); font-style: normal;
      font-size: 15px;
      line-height: 1.6;
      color: rgba(28,29,34,0.65);
      margin: 4px 0 10px; max-width: 52ch;
    }

    .pack-pricerow {
      display: flex; align-items: baseline; gap: 12px;
      padding: 16px 0;
      border-top: 1px solid rgba(28,29,34,0.12);
      border-bottom: 1px solid rgba(28,29,34,0.12);
      margin: 10px 0;
    }
    .pack-price {
      font-family: var(--serif); font-weight: 500;
      font-size: 30px;
      color: var(--ink);
    }
    .pack-vat {
      font-family: var(--sans); font-size: 11px;
      font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase;
      color: rgba(28,29,34,0.5);
    }
    .pack-buy {
      align-self: flex-start;
      padding: 15px 26px;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
    }

    .pack-contents {
      margin-top: 24px;
      padding-top: 24px;
      border-top: 1px solid rgba(28,29,34,0.12);
    }
    .pack-contents .eyebrow { margin-bottom: 12px; }
    .pack-contents ul {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column; gap: 8px;
    }
    .pack-contents li {
      font-family: var(--sans); font-size: 13.5px;
      line-height: 1.55;
      color: rgba(28,29,34,0.78);
      padding-left: 22px;
      position: relative;
    }
    .pack-contents li::before {
      content: "→";
      font-family: var(--sans); font-style: normal;
      color: var(--english-violet);
      position: absolute; left: 0;
    }

    /* PREVIEWS */
    /* 200px of dead space sat under the templates before the footer. */
    .pack-previews { padding: 40px 36px 72px; }
    .pack-previews-head {
      display: flex; justify-content: space-between; align-items: end;
      gap: 24px; flex-wrap: wrap;
      padding-top: 24px;
      border-top: 1px solid rgba(28,29,34,0.1);
      margin-bottom: 36px;
    }
    .pack-previews-head .eyebrow { margin-bottom: 8px; }
    .pack-previews-head h2 {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(22px, 2.4vw, 30px);
      letter-spacing: -0.018em;
      margin: 0; color: var(--ink);
    }
    .pack-previews-hint {
      font-family: var(--sans); font-style: normal;
      font-size: 13px; line-height: 1.5; color: rgba(28,29,34,0.6);
      margin: 0; white-space: nowrap; text-align: right;
    }
    @media (max-width: 720px) {
      .pack-previews-hint { white-space: normal; text-align: left; }
    }

    .pack-tpl-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 14px;
    }
    @media (max-width: 1100px) { .pack-tpl-grid { grid-template-columns: repeat(4, 1fr); } }
    @media (max-width: 720px)  {
      .pack-tpl-grid { grid-template-columns: repeat(3, 1fr); }
      /* Six locked teasers is one tidy row at 6-across, but two rows of blurred tiles
         at 3-across — so a phone keeps only the first two and goes to the CTA. */
      .pack-tpl--locked-xtra { display: none; }
    }
    @media (max-width: 460px)  { .pack-tpl-grid { grid-template-columns: repeat(2, 1fr); } }
    .pack-tpl {
      position: relative;
      margin: 0;
      background: rgba(var(--violet-rgb),0.06);
      border-radius: 2px;
      border: 1px solid #fff;
      box-shadow: 0 1px 8px -5px rgba(28,29,34,0.2);
      overflow: hidden;
      transition: transform 0.35s cubic-bezier(.2,.7,.2,1);
    }
    .pack-tpl--open { cursor: zoom-in; }
    .pack-tpl--open:hover { transform: translateY(-3px); box-shadow: 0 26px 50px -28px rgba(28,29,34,0.5); }
    /* Hover hint — a small "enlarge" glyph appears top-left on the previews. */
    .pack-tpl--open::after {
      content: "⤢";
      position: absolute; top: 12px; left: 12px; z-index: 2;
      width: 30px; height: 30px; border-radius: 50%;
      display: grid; place-items: center;
      background: rgba(28,29,34,0.62); color: var(--paper); font-size: 14px;
      opacity: 0; transform: scale(0.8); transition: opacity 0.25s, transform 0.25s;
      pointer-events: none;
    }
    .pack-tpl--open:hover::after, .pack-tpl--open:focus-visible::after { opacity: 1; transform: scale(1); }

    /* Lightbox */
    .pack-lightbox {
      position: fixed; inset: 0; z-index: 300;
      display: flex; align-items: center; justify-content: center;
      padding: clamp(20px, 5vh, 60px);
      background: rgba(16,15,13,0.92); backdrop-filter: blur(6px);
    }
    .pack-lightbox[hidden] { display: none; }
    .pack-lightbox-fig { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 16px; max-height: 100%; }
    .pack-lightbox-fig img {
      max-width: min(92vw, 760px); max-height: 82vh; width: auto; height: auto;
      object-fit: contain; border-radius: 3px; box-shadow: 0 40px 90px -30px rgba(0,0,0,0.7);
    }
    .pack-lightbox-fig figcaption {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.2em; text-transform: uppercase; color: rgba(240,238,235,0.8);
    }
    .pack-lightbox-close {
      position: absolute; top: 22px; right: 26px;
      width: 46px; height: 46px; border-radius: 50%; border: 0; cursor: pointer;
      background: rgba(240,238,235,0.12); color: var(--paper); font-size: 26px; line-height: 1;
      display: grid; place-items: center; transition: background 0.2s;
    }
    .pack-lightbox-close:hover { background: rgba(240,238,235,0.24); }
    .pack-lightbox-count {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; color: rgba(240,238,235,0.55);
    }
    .pack-lightbox-nav {
      position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
      width: 52px; height: 52px; border-radius: 50%; border: 0; cursor: pointer;
      background: rgba(240,238,235,0.12); color: var(--paper);
      display: grid; place-items: center; transition: background 0.2s;
    }
    .pack-lightbox-nav:hover { background: rgba(240,238,235,0.26); }
    .pack-lightbox-nav[hidden] { display: none; }
    .pack-lightbox-prev { left: clamp(12px, 3vw, 40px); }
    .pack-lightbox-next { right: clamp(12px, 3vw, 40px); }
    @media (max-width: 640px) {
      .pack-lightbox-nav { width: 44px; height: 44px; }
      .pack-lightbox-prev { left: 8px; }
      .pack-lightbox-next { right: 8px; }
    }
    .pack-tpl img {
      width: 100%; aspect-ratio: 3/4;
      object-fit: cover; display: block;
    }
    .pack-tpl-empty { width: 100%; aspect-ratio: 3/4; background: rgba(28,29,34,0.06); }
    .pack-tpl figcaption {
      padding: 8px 10px 10px;
      background: var(--paper);
      display: flex; flex-direction: column; gap: 2px;
    }
    .pack-tpl-cat {
      font-family: var(--sans); font-size: 9.5px;
      font-weight: 700; letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--english-violet);
    }
    /* Standard-copy title in Darker Grotesque, bold — keeps the caption compact
       so the template thumbnail is the star (was an oversized serif). */
    .pack-tpl-name {
      font-family: var(--sans); font-weight: 700; font-size: 13px;
      line-height: 1.3; color: var(--ink);
    }

    .pack-tpl--locked img { filter: blur(14px) saturate(0.7); transform: scale(1.08); }
    .pack-tpl--locked .pack-tpl-empty { filter: none; }
    .pack-tpl--locked::before {
      content: "";
      position: absolute; left: 0; right: 0; top: 0;
      aspect-ratio: 3/4;
      background: rgba(28,29,34,0.5);
      pointer-events: none;
    }
    .pack-tpl-lock-overlay {
      position: absolute;
      top: 14px; right: 14px;
      z-index: 2;
      display: inline-flex; align-items: center; justify-content: center;
      width: 38px; height: 38px;
      border-radius: 50%;
      background: rgba(28,29,34,0.78);
      color: var(--paper);
      backdrop-filter: blur(8px);
    }
    .pack-tpl--locked .pack-tpl-name {
      color: rgba(28,29,34,0.5);
      font-style: normal;
    }

    .pack-unlock-cta {
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: end;
      gap: 32px;
      margin-top: 48px;
      padding: 26px 40px;
      background: var(--ink);
      color: var(--paper);
      border-radius: 3px;
    }
    @media (max-width: 720px) {
      .pack-unlock-cta { grid-template-columns: 1fr; align-items: start; padding: 24px; }
    }
    /* Was italic The Seasons for both lines, which read as a different site. Brand
       type: Helios for the heading, upright Darker Grotesque for the copy.
       Helios spelled out rather than var(--serif): global.css rebinds --serif to
       --subhead ON h3/h4, so var(--serif) inside an h3 quietly resolves back to
       The Seasons — the exact thing we're moving away from. */
    .pack-unlock-cta h3 {
      font-family: "Helios", "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-style: normal; font-weight: 400;
      font-size: clamp(24px, 2.6vw, 32px);
      letter-spacing: -0.018em;
      color: var(--paper); margin: 0 0 6px;
    }
    .pack-unlock-cta p {
      font-family: var(--sans); font-style: normal;
      font-size: 15px; line-height: 1.5; color: rgba(240,238,235,0.72);
      margin: 0;
    }
    .pack-unlock-cta .btn {
      background: var(--paper); color: var(--ink);
      border-color: var(--paper);
    }
    .pack-unlock-cta .btn:hover {
      background: #c9bcb7; color: var(--ink);
      border-color: #c9bcb7;
    }
  </style>

  <script is:inline>
    // Re-use the catalogue's checkout modal: clicking any [data-buy] sends
    // the user back to /edit?buy=<id> which opens the modal for that pack.
    document.querySelectorAll('[data-buy]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-buy');
        if (id) window.location.href = '/edit?buy=' + encodeURIComponent(id);
      });
    });

    // Hero gallery — click a thumbnail to swap it into the big frame above.
    (function () {
      var main = document.getElementById('pack-hero-img');
      var thumbs = document.querySelectorAll('.pack-hero-thumb');
      if (!main || !thumbs.length) return;
      thumbs.forEach(function (btn) {
        btn.addEventListener('click', function () {
          var src = btn.getAttribute('data-hero-src');
          if (!src) return;
          main.src = src;
          thumbs.forEach(function (b) { b.classList.remove('is-active'); });
          btn.classList.add('is-active');
        });
      });
    })();

    // Click a preview to open it large, then flip through the rest with the
    // arrows (or ← →) — no need to close and re-open each one.
    (function () {
      var lb = document.getElementById('pack-lightbox');
      var img = document.getElementById('pack-lightbox-img');
      var cap = document.getElementById('pack-lightbox-cap');
      var count = document.getElementById('pack-lightbox-count');
      var prevBtn = document.getElementById('pack-lightbox-prev');
      var nextBtn = document.getElementById('pack-lightbox-next');
      if (!lb || !img) return;

      // The ordered set of previews you can flip between.
      var items = Array.prototype.slice.call(document.querySelectorAll('[data-zoom]')).map(function (el) {
        return { full: el.getAttribute('data-full'), name: el.getAttribute('data-name') || '' };
      });
      var idx = 0;
      var multiple = items.length > 1;

      function render() {
        var it = items[idx];
        if (!it) return;
        img.src = it.full; img.alt = it.name; cap.textContent = it.name;
        if (count) count.textContent = multiple ? (idx + 1) + ' / ' + items.length : '';
      }
      function open(i) {
        idx = (i + items.length) % items.length;
        render();
        lb.hidden = false; document.documentElement.style.overflow = 'hidden';
      }
      function close() { lb.hidden = true; img.removeAttribute('src'); document.documentElement.style.overflow = ''; }
      function go(d) { idx = (idx + d + items.length) % items.length; render(); }

      if (prevBtn) prevBtn.hidden = !multiple;
      if (nextBtn) nextBtn.hidden = !multiple;

      document.querySelectorAll('[data-zoom]').forEach(function (el, i) {
        el.addEventListener('click', function () { open(i); });
        el.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(i); }
        });
      });
      if (prevBtn) prevBtn.addEventListener('click', function (e) { e.stopPropagation(); go(-1); });
      if (nextBtn) nextBtn.addEventListener('click', function (e) { e.stopPropagation(); go(1); });
      lb.addEventListener('click', function (e) { if (e.target === lb || e.target.closest('.pack-lightbox-close')) close(); });
      document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft' && multiple) go(-1);
        else if (e.key === 'ArrowRight' && multiple) go(1);
      });
    })();
  </script>
</BaseLayout>
