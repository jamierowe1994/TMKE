---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { supabase, isConfigured } from "../../lib/supabase.js";

// Build-time enumeration of every active pack. New packs need a rebuild
// to land on production; the catalogue at /edit also hydrates from
// Supabase client-side so freshly-created packs still appear there.
export async function getStaticPaths() {
  // DEV-only sample so the detail page renders locally when the dev database has
  // no live packs (mirrors the SAMPLE_PACKS fallback in edit.astro). Never used
  // in production — import.meta.env.DEV is false in the build. Defined inside
  // getStaticPaths because Astro runs it in an isolated scope.
  const devSamplePaths = () => {
    const TPL = (n) => `https://assets.tmke.co.uk/TMKE%20Home%20Page/Templates/${n}.png`;
    const templates = Array.from({ length: 15 }, (_, i) => ({
      id: `s${i}`, name: `Template ${i + 1}`, category: "On the Market",
      thumb_url: TPL((i % 13) + 1), render_url: TPL((i % 13) + 1), pack_id: "sample", sort_order: i,
    }));
    const pack = {
      id: "sample", slug: "property-portfolio", status: "active", category: "On the Market",
      title: "Property Portfolio", price_pence: 29900, preview_reveal_count: 6,
      description: "Show the homes, not just the headlines. A polished set of listing layouts that make every property on your books look the part across the feed.",
      contents: ["New instruction & coming-soon layouts", "Open-house and viewing announcements", "Price change & just-sold posts"],
      cover_image_url: TPL(13), preview_images: [TPL(13), TPL(1), TPL(5), TPL(8), TPL(2)],
    };
    return [{ params: { slug: pack.slug }, props: { pack, templates, cards: [] } }];
  };

  if (!isConfigured) return import.meta.env.DEV ? devSamplePaths() : [];

  const { data: packs, error } = await supabase
    .from("packs")
    .select("*")
    .in("status", ["active", "draft"]);
  if (error || !packs) return import.meta.env.DEV ? devSamplePaths() : [];
  // The demo pack has no page of its own, and nor does a pack nobody buys: a
  // free-to-members pack (Halloween, say) is for the Studio, never the website.
  const forSale = packs.filter((p) => p.demo !== true && (p.access || "buy") === "buy");
  packs.length = 0; forSale.forEach((p) => packs.push(p));
  if (!packs.length && import.meta.env.DEV) return devSamplePaths();

  // Fetch templates per-pack in a single round-trip.
  const packIds = packs.map((p) => p.id);
  const { data: templates } = await supabase
    .from("templates")
    .select("id, name, category, thumb_url, render_url, pack_id, sort_order, canvas")
    .in("pack_id", packIds)
    .eq("status", "active")
    .order("sort_order", { ascending: true });

  const tplByPack = new Map();
  (templates || []).forEach((t) => {
    const list = tplByPack.get(t.pack_id) || [];
    list.push(t);
    tplByPack.set(t.pack_id, list);
  });

  // Every pack for sale as a small card, for "You might also like" and
  // "Recently viewed" at the foot of each page.
  const cards = packs.filter((p) => p.status === "active").map((p) => {
    const tpls = tplByPack.get(p.id) || [];
    const imgs = Array.isArray(p.preview_images) ? p.preview_images.filter(Boolean) : [];
    return {
      slug: p.slug, title: p.title, price_pence: p.price_pence, category: p.category || "", kind: p.kind || "social",
      cover: p.cover_image_url || imgs[0] || (tpls[0] && (tpls[0].render_url || tpls[0].thumb_url)) || null,
      count: tpls.length,
    };
  });

  return packs.map((pack) => ({
    params: { slug: pack.slug },
    props: {
      pack,
      templates: tplByPack.get(pack.id) || [],
      cards,
    },
  }));
}

const { pack, templates, cards = [] } = Astro.props;
// Open previews, then locked teasers, then the unlock CTA.
// NB the six is only a DEFAULT: a pack with its own preview_reveal_count set in
// admin still wins. If a live pack shows three, that's its setting, not this line.
const reveal = Math.max(0, Math.min(24, pack.preview_reveal_count ?? 6));
const previewTpls = templates.slice(0, reveal);
const lockedAll = templates.slice(reveal);
// SIX locked teasers on desktop (one full row of the 6-across grid); a phone shows
// only the first TWO, because three-across turns six into two rows of blurred tiles
// you have to scroll past to reach the CTA. The page is static, so all six render
// and CSS drops the extras below 720px — the count hint still reports the TRUE
// number that unlock on purchase either way.
const lockedTpls = lockedAll.slice(0, 6);
const LOCKED_ON_MOBILE = 2;
const lockedCount = lockedAll.length;
const contents = Array.isArray(pack.contents) ? pack.contents : [];
// The big cover: an explicit cover image if set, otherwise fall back to the
// first template's (high-res) thumbnail so the hero is never a stale low-res
// pick. Clearing a pack's cover therefore shows the crisp first preview.
const coverSrc = pack.cover_image_url || (templates[0] && (templates[0].render_url || templates[0].thumb_url)) || null;
// The hero gallery: when an admin has uploaded a hover gallery (preview_images),
// those images ARE the pack's imagery — the first is the big hero and the rest
// sit underneath as a scroll-through strip. Older packs with no gallery fall
// back to the single cover image.
const galleryImgs = (Array.isArray(pack.preview_images) ? pack.preview_images : [])
  .filter((u) => typeof u === "string" && u.trim());
const heroImages = galleryImgs.length ? galleryImgs : (coverSrc ? [coverSrc] : []);
const heroMain = heroImages[0] || null;

// The sliding strip at the top (Danielle, 24 Oct 2026, after Moyo Studio):
// the open previews, so nothing locked is shown, topped up with the pack's
// mockups when a pack opens fewer than five. Each one opens its preview.
const reelItems = [
  ...previewTpls.filter((t) => t.thumb_url || t.render_url).map((t, i) => ({ src: t.thumb_url || t.render_url, name: t.name, zoom: `tpl:${i}` })),
  ...(previewTpls.length < 5 ? galleryImgs.map((src, i) => ({ src, name: pack.title, zoom: `mock:${i}` })) : []),
];
// Mockups: the pack's own imagery, four at most.
const mockups = galleryImgs.slice(0, 4);

// The sizes the templates come in, from their canvases ("1080 × 1440 px").
const sizes = [...new Set(templates.map((t) => t.canvas && t.canvas.width && t.canvas.height ? `${t.canvas.width} × ${t.canvas.height} px` : null).filter(Boolean))];

// Related packs: the same kind first, then the same category, then the rest.
const related = cards.filter((c) => c.slug !== pack.slug)
  .map((c) => ({ c, score: (c.kind === (pack.kind || "social") ? 2 : 0) + (c.category && c.category === pack.category ? 1 : 0) }))
  .sort((a, b) => b.score - a.score).slice(0, 4).map((x) => x.c);
const pad2 = (n) => String(n).padStart(2, "0");
// "Coming Soon - Property - Static" -> "Coming Soon": the caption names the
// design; the category and format are the Studio's filing.
const shortName = (n) => String(n || "").split(" - ")[0].trim() || n;

// Pack images are uploaded full size (previews up to 21 MB PNGs), so the page
// never loads them as they are: Supabase resizes on the fly to the width the
// page shows, as WebP where the browser takes it (21.6 MB -> 173 KB at 1200).
// resize=contain keeps each image's own shape. Anything not in Supabase storage
// is left alone.
function sized(src, width) {
  const s = String(src || "");
  const marker = "/storage/v1/object/public/";
  const at = s.indexOf(marker);
  if (!s || at === -1) return s || null;
  const [path] = s.slice(at + marker.length).split("?");
  return s.slice(0, at) + "/storage/v1/render/image/public/" + path + "?width=" + width + "&resize=contain&quality=72";
}

function gbp(pence) {
  if (pence == null) return "";
  return new Intl.NumberFormat("en-GB", {
    style: "currency", currency: "GBP",
    minimumFractionDigits: pence % 100 === 0 ? 0 : 2,
  }).format(pence / 100);
}
---

<BaseLayout
  title={`${pack.title} — The Edit · TMKE`}
  description={pack.description || `${pack.title} — a curated TMKE pack of editable templates for UK property professionals.`}
  ogImage={pack.cover_image_url || undefined}
>
  <article class="pack-detail">
    <!-- ============================== HERO
         A strip of the pack's templates sliding past on the left (after Moyo
         Studio), and a small, quiet buying panel on the right (after Studio
         Blanche). Danielle, 24 Oct 2026. -->
    <section class="pd-hero">
      <div class="pd-left">
      <div class="pd-reel" aria-label={`Templates from ${pack.title}`}>
        {reelItems.length > 0 ? (
          <div class="pd-reel-track" data-count={reelItems.length}>
            {[...reelItems, ...reelItems, ...reelItems].map((it, i) => (
              <button
                type="button"
                class="pd-reel-item"
                data-zoomto={it.zoom}
                aria-label={i < reelItems.length ? `Enlarge ${it.name}` : undefined}
                aria-hidden={i >= reelItems.length ? "true" : undefined}
                data-copy={i >= reelItems.length ? "" : undefined}
                tabindex={i >= reelItems.length ? "-1" : undefined}
              >
                <img src={sized(it.src, 640)} alt="" loading={i < 6 ? "eager" : "lazy"} />
              </button>
            ))}
          </div>
        ) : heroMain ? (
          <img class="pd-reel-single" src={sized(heroMain, 1400)} alt={pack.title} />
        ) : null}
      </div>

      {(pack.story_heading || pack.story_body) && (
        <div class="pd-story">
          {pack.story_heading && <h2 class="pd-story-h">{pack.story_heading}</h2>}
          {pack.story_body && String(pack.story_body).split(/\n\s*\n/).map((para) => <p>{para.trim()}</p>)}
        </div>
      )}

      {mockups.length > 0 && (
        <div class="pd-mocks" aria-label="The pack in use">
          <div class={`pd-mocks-grid n${mockups.length}`}>
            {mockups.map((src, i) => (
              <figure class="pd-mock" data-zoom data-set="mock" data-full={sized(src, 1600)} data-name={pack.title} tabindex="0" role="button" aria-label={`Enlarge image ${i + 1}`}>
                <img src={sized(src, 1100)} alt="" loading="lazy" />
              </figure>
            ))}
          </div>
        </div>
      )}
      </div>

      <aside class="pd-panel"><div class="pd-panel-in">
        <a href="/edit" class="pd-back">&larr; The Edit</a>
        {pack.category && <div class="pd-cat">{pack.category}</div>}
        <h1 class="pd-title">{pack.title}</h1>
        <div class="pd-price">{gbp(pack.price_pence)} <span>+VAT · one-time payment</span></div>
        {pack.description && <p class="pd-desc">{pack.description}</p>}

        <button type="button" class="pd-buy" data-buy={pack.id}>Buy this pack · {gbp(pack.price_pence)}</button>
        <a href="#pack-previews" class="pd-see">See inside the pack &darr;</a>

        <div class="pd-acc">
          {contents.length > 0 && (
            <details>
              <summary>What's inside</summary>
              <ul class="pd-list">{contents.map((line) => <li>{line}</li>)}</ul>
            </details>
          )}
          <details>
            <summary>Details</summary>
            <dl class="pd-spec">
              <div><dt>Templates</dt><dd>{templates.length} editable</dd></div>
              {sizes.length > 0 && <div><dt>Size</dt><dd>{sizes.join(" / ")}</dd></div>}
              <div><dt>Edited in</dt><dd>The TMKE Studio, in your browser</dd></div>
              <div><dt>Payment</dt><dd>Once, {gbp(pack.price_pence)} + VAT</dd></div>
            </dl>
          </details>
        </div>

        <!-- Open, not folded: the left column runs long with the mockups, so
             the panel has room, and these are the same on every pack. -->
        <div class="pd-section">
          <div class="pd-section-h">How it works</div>
          <p class="pd-note">You pay once, plus VAT, with no subscription, and the pack is yours to keep. Once you've paid, the pack is unlocked in your TMKE Studio, inside your TMKE account. There you can change the photos, words and colours to suit your business, then download the finished design ready to post. Each template comes at a set size{sizes[0] ? `, such as ${sizes[0]}` : ""}, and you can resize it in the Studio for other formats, like a story.</p>
        </div>
        <div class="pd-section">
          <div class="pd-section-h">The TMKE Studio</div>
          <p class="pd-note">The TMKE Studio is our design studio. It runs in your web browser, so there's nothing to install. It's where every pack you buy lives. You add your brand once, with your logo, colours and fonts, and use it across your designs. It's built for property marketing, so the templates are made for the posts agents actually need.</p>
        </div>
      </div></aside>
    </section>

    <!-- ============================== PREVIEWS -->
    <section class="pack-previews" id="pack-previews">
      <div class="pp-wrap">
        <header class="pack-previews-head">
          <h2 class="pp-h">Inside this pack</h2>
          <span class="pp-count">{pad2(1)}–{pad2(previewTpls.length)} of {templates.length}{sizes[0] ? ` · ${sizes[0].replace(" px", "")}` : ""}</span>
          <button type="button" class="pp-btn" data-buy={pack.id}>{lockedCount > 0 ? `Unlock all ${templates.length}` : "Buy this pack"}</button>
        </header>

        <div class="pack-tpl-grid">
          {previewTpls.map((t, i) => (
            <figure
              class="pack-tpl pack-tpl--open"
              data-zoom={(t.render_url || t.thumb_url) ? "" : undefined}
              data-set="tpl"
              data-full={sized(t.render_url || t.thumb_url, 1600) || undefined}
              data-name={t.name}
              tabindex={(t.render_url || t.thumb_url) ? "0" : undefined}
              role={(t.render_url || t.thumb_url) ? "button" : undefined}
              aria-label={(t.render_url || t.thumb_url) ? `Enlarge ${t.name}` : undefined}
            >
              {(t.thumb_url || t.render_url)
                ? <img src={sized(t.thumb_url || t.render_url, 700)} alt={t.name} loading={i < 4 ? "eager" : "lazy"} />
                : <div class="pack-tpl-empty"></div>}
              <figcaption><span class="pack-tpl-num">{pad2(i + 1)}</span><span class="pack-tpl-name">{shortName(t.name)}</span></figcaption>
            </figure>
          ))}

          {lockedTpls.map((t, i) => (
            <figure
              class:list={["pack-tpl", "pack-tpl--locked", i >= LOCKED_ON_MOBILE && "pack-tpl--locked-xtra"]}
              aria-label="Locked: buy the pack to unlock"
            >
              {(t.thumb_url || t.render_url)
                ? <img src={sized(t.thumb_url || t.render_url, 500)} alt="" loading="lazy" />
                : <div class="pack-tpl-empty"></div>}
              <div class="pack-tpl-lock-overlay">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="11" width="18" height="11" rx="2"/>
                  <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
              </div>
              <figcaption><span class="pack-tpl-num">{pad2(previewTpls.length + i + 1)}</span><span class="pack-tpl-name">Locked</span></figcaption>
            </figure>
          ))}
        </div>

      </div>
    </section>

    <!-- ============================== MORE PACKS
         Related packs, and the packs you've looked at recently (kept in this
         browser only), after Studio Blanche. -->
    {cards.length > 1 && (
      <section class="pd-more" id="pd-more">
        <div class="pd-tabs" role="tablist">
          <button type="button" class="pd-tab is-on" role="tab" aria-selected="true" data-tab="related">You might also like</button>
          <button type="button" class="pd-tab" role="tab" aria-selected="false" data-tab="recent" hidden>Recently viewed</button>
        </div>
        <div class="pd-cards" data-panel="related" style={`--n:${Math.max(1, related.length)}`}>
          {related.map((c) => (
            <a class="pd-card" href={`/edit/${c.slug}`}>
              <span class="pd-card-img">{c.cover && <img src={sized(c.cover, 600)} alt="" loading="lazy" />}</span>
              <span class="pd-card-text"><span class="pd-card-title">{c.title}</span><span class="pd-card-price">{gbp(c.price_pence)} +VAT</span></span>
            </a>
          ))}
        </div>
        <div class="pd-cards" data-panel="recent" hidden></div>
        <script type="application/json" id="pd-cards-data" set:html={JSON.stringify(cards.map((c) => ({ ...c, cover: c.cover ? sized(c.cover, 600) : null, price: gbp(c.price_pence) })))}></script>
        <span id="pd-current" data-slug={pack.slug} hidden></span>
      </section>
    )}
  </article>

  <!-- Lightbox — click any preview to bring it up large, then flip through the
       rest with the arrows (or ← →). -->
  <div class="pack-lightbox" id="pack-lightbox" hidden>
    <button type="button" class="pack-lightbox-close" aria-label="Close">&times;</button>
    <button type="button" class="pack-lightbox-nav pack-lightbox-prev" id="pack-lightbox-prev" aria-label="Previous">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <figure class="pack-lightbox-fig">
      <img id="pack-lightbox-img" src="" alt="" />
      <figcaption id="pack-lightbox-cap"></figcaption>
      <span class="pack-lightbox-count" id="pack-lightbox-count"></span>
    </figure>
    <button type="button" class="pack-lightbox-nav pack-lightbox-next" id="pack-lightbox-next" aria-label="Next">
      <svg viewBox="0 0 24 24" width="26" height="26" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
  </div>

  <style>
    /* Padding, not a margin on the hero: a margin collapsed through the
       article and let the wine page colour show behind the nav. */
    .pack-detail { color: var(--ink); padding-top: 78px; background: var(--paper); }

    .wrap {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 36px;
    }
    @media (max-width: 720px) { .wrap { padding: 0 16px; } }

    /* The page's bottom is the wine footer. On a touch screen the rubber-band
       past it revealed white; paint the root the same wine and stop the
       overscroll where the browser lets us. */
    html { background: var(--english-violet); overscroll-behavior-y: none; }

    /* ---- HERO: sliding strip and mockups | buying panel ----
       The panel runs the full height of this part, down to Inside this
       pack, with its content held in view as you scroll (Studio Blanche). */
    .pd-hero {
      display: grid;
      grid-template-columns: minmax(0, 1fr) clamp(420px, 34vw, 540px);
      border-top: 1px solid rgba(28,29,34,0.08);
    }
    .pd-left { min-width: 0; }
    /* Just over three templates in view on a dark band (Moyo Studio). The
       item width comes from the band's own width, so it holds at any size. */
    /* No band behind them (Danielle, 24 Oct): the templates start at the top
       and run off the edge, a little under three in view. */
    .pd-reel {
      position: relative; overflow: hidden;
      container-type: inline-size;
    }
    .pd-reel-track { display: flex; gap: 14px; width: max-content; will-change: transform; }
    .pd-reel-item {
      width: calc((100cqw - 2 * 14px) / 2.75); aspect-ratio: 3 / 4; flex: none;
      padding: 0; border: 0; background: #fff; cursor: zoom-in;
    }
    .pd-reel-item:focus-visible { outline: 2px solid var(--english-violet); outline-offset: -2px; }
    .pd-reel-item img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .pd-reel-single { display: block; width: 100%; max-height: 520px; object-fit: cover; }
    @media (prefers-reduced-motion: reduce) { .pd-reel { overflow-x: auto; } }

    .pd-panel { background: var(--paper); border-left: 1px solid rgba(28,29,34,0.1); }
    .pd-panel-in {
      position: sticky; top: 78px;
      padding: 28px max(36px, calc((100vw - 1280px) / 2 + 36px)) 36px 44px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .pd-back {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase;
      color: rgba(28,29,34,0.5); margin-bottom: 18px; transition: color 0.25s;
      align-self: flex-start;
    }
    .pd-back:hover { color: var(--english-violet); }
    .pd-cat, .pd-eyebrow {
      font-family: var(--sans); font-size: 10.5px; font-weight: 700;
      letter-spacing: 0.24em; text-transform: uppercase; color: var(--english-violet);
    }
    .pd-title {
      font-family: var(--serif); font-weight: 400;
      font-size: clamp(26px, 2.2vw, 32px); line-height: 1.08; letter-spacing: -0.02em;
      margin: 0; color: var(--ink); text-wrap: balance;
    }
    .pd-price {
      font-family: var(--serif); font-size: 18px; color: var(--ink);
      display: flex; align-items: baseline; gap: 10px;
    }
    .pd-price span {
      font-family: var(--sans); font-size: 10px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: rgba(28,29,34,0.5);
    }
    .pd-desc {
      font-family: var(--sans); font-size: 14px; line-height: 1.6;
      color: rgba(28,29,34,0.68); margin: 4px 0 6px;
    }
    .pd-buy {
      width: 100%; padding: 14px 18px; margin-top: 6px;
      border: 1px solid var(--english-violet); background: var(--english-violet); color: var(--paper);
      font-family: var(--sans); font-size: 11.5px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase; cursor: pointer;
      transition: background 0.25s, border-color 0.25s;
    }
    .pd-buy:hover { background: #4d2b39; border-color: #4d2b39; }
    .pd-buy--light { width: auto; padding: 14px 24px; margin: 0; background: var(--paper); color: var(--english-violet); border-color: var(--paper); }
    .pd-buy--light:hover { background: #e7dcd8; border-color: #e7dcd8; }
    .pd-see {
      align-self: center; font-family: var(--sans); font-size: 12.5px; font-weight: 600;
      color: rgba(28,29,34,0.6); text-decoration: underline; text-underline-offset: 3px;
      margin: 2px 0 8px;
    }
    .pd-see:hover { color: var(--english-violet); }

    /* Accordions: small and ruled, like the reference. */
    .pd-acc { border-top: 1px solid rgba(28,29,34,0.12); }
    .pd-acc details { border-bottom: 1px solid rgba(28,29,34,0.12); }
    .pd-acc summary {
      list-style: none; cursor: pointer; padding: 13px 0;
      display: flex; justify-content: space-between; align-items: center;
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink);
    }
    .pd-acc summary::-webkit-details-marker { display: none; }
    .pd-acc summary::after { content: "+"; font-size: 15px; font-weight: 400; letter-spacing: 0; color: rgba(28,29,34,0.5); }
    .pd-acc details[open] summary::after { content: "\2212"; }
    .pd-acc summary:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 2px; }
    .pd-list { list-style: none; padding: 0 0 14px; margin: 0; display: flex; flex-direction: column; gap: 6px; }
    .pd-list li {
      position: relative; padding-left: 18px;
      font-family: var(--sans); font-size: 13.5px; line-height: 1.5; color: rgba(28,29,34,0.75);
    }
    .pd-list li::before { content: "\2192"; position: absolute; left: 0; color: var(--english-violet); }
    .pd-spec { margin: 0; padding: 0 0 12px; }
    .pd-spec div { display: grid; grid-template-columns: 96px minmax(0, 1fr); gap: 12px; padding: 7px 0; border-top: 1px solid rgba(28,29,34,0.06); }
    .pd-spec div:first-child { border-top: 0; }
    .pd-spec dt { font-family: var(--sans); font-size: 10px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(28,29,34,0.5); padding-top: 2px; }
    .pd-spec dd { margin: 0; font-family: var(--sans); font-size: 13.5px; color: var(--ink); font-variant-numeric: tabular-nums; }
    .pd-note { font-family: var(--sans); font-size: 13.5px; line-height: 1.6; color: rgba(28,29,34,0.72); margin: 0; }
    .pd-section { padding: 22px 0 4px; }
    .pd-section-h {
      font-family: var(--sans); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase; color: var(--ink); margin-bottom: 8px;
    }

    /* The pack's story, centred in the left column (not the screen), at the
       size of the Buy button's text (Danielle, 24 Oct). */
    .pd-story { max-width: 540px; margin: 0 auto; padding: 64px 32px 60px; text-align: center; }
    .pd-story-h {
      font-family: var(--serif); font-weight: 400; font-size: 19px; line-height: 1.35;
      letter-spacing: -0.01em; color: var(--ink); margin: 0 0 16px; text-wrap: balance;
    }
    .pd-story p {
      font-family: var(--serif); font-size: 11.5px; line-height: 1.9; letter-spacing: 0.02em;
      color: rgba(28,29,34,0.72); margin: 0 0 12px; text-wrap: pretty;
    }
    .pd-story p:last-child { margin-bottom: 0; }

    /* The mockups: two by two, large, edge to edge (Studio Blanche). */
    .pd-mocks { padding: 0 0 14px 0; }
    .pd-mocks-grid { display: grid; gap: 14px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pd-mocks-grid.n1 { grid-template-columns: minmax(0, 1fr); }
    .pd-mock { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; background: #e7e0dc; cursor: zoom-in; }
    .pd-mock img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.6s cubic-bezier(.2,.7,.2,1); }
    .pd-mock:hover img { transform: scale(1.03); }
    .pd-mock:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 3px; }

    /* Stacked: the strip, the panel, then the mockups. */
    @media (max-width: 960px) {
      .pd-hero { grid-template-columns: 1fr; }
      .pd-left { display: contents; }
      .pd-reel { order: 1; }
      .pd-reel-item { width: calc((100cqw - 14px) / 1.5); }
      .pd-panel { order: 2; border-left: 0; }
      .pd-panel-in { position: static; padding: 22px 16px 10px; }
      .pd-story { order: 3; padding: 36px 20px 32px; }
      .pd-mocks { order: 4; padding: 0 0 28px; }
      .pd-mocks-grid { gap: 8px; }
    }

    /* The whole pack on the wine (Danielle, 24 Oct), headed the way Moyo
       Studio heads its collection: a small label, the count, one button. */
    .pack-previews { background: var(--english-violet); color: var(--paper); padding: 64px 0 80px; }
    .pp-wrap { max-width: 1560px; margin: 0 auto; padding: 0 36px; }
    @media (max-width: 720px) { .pp-wrap { padding: 0 16px; } }
    .pack-previews-head {
      display: flex; align-items: center; gap: 18px 56px; flex-wrap: wrap;
      padding-bottom: 26px; margin-bottom: 36px;
      border-bottom: 1px solid rgba(240,238,235,0.18);
    }
    .pp-h {
      font-family: var(--sans); font-size: 13px; font-weight: 600;
      letter-spacing: 0.24em; text-transform: uppercase; color: var(--paper); margin: 0;
    }
    .pp-count {
      font-family: var(--serif); font-size: 13px; letter-spacing: 0.04em;
      color: rgba(240,238,235,0.55); font-variant-numeric: tabular-nums;
    }
    .pp-btn {
      margin-left: auto; background: transparent; color: var(--paper);
      border: 1px solid rgba(240,238,235,0.75); padding: 13px 26px; cursor: pointer;
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.22em; text-transform: uppercase; transition: background 0.25s, color 0.25s;
    }
    .pp-btn:hover { background: var(--paper); color: var(--english-violet); }
    @media (max-width: 720px) { .pp-btn { margin-left: 0; width: 100%; } }

    .pack-tpl-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 36px 20px;
    }
    /* Five across between laptop and phone: four made each tile a quarter of
       the screen, which read as big rather than as a grid of previews. */
    @media (max-width: 1100px) { .pack-tpl-grid { grid-template-columns: repeat(5, 1fr); gap: 12px; } }
    @media (max-width: 720px)  {
      .pack-tpl-grid { grid-template-columns: repeat(3, 1fr); }
      /* Six locked teasers is one tidy row at 6-across, but two rows of blurred tiles
         at 3-across — so a phone keeps only the first two and goes to the CTA. */
      .pack-tpl--locked-xtra { display: none; }
    }
    @media (max-width: 460px)  { .pack-tpl-grid { grid-template-columns: repeat(2, 1fr); } }
    .pack-tpl {
      position: relative;
      margin: 0;
      background: transparent;
      overflow: hidden;
      transition: transform 0.35s cubic-bezier(.2,.7,.2,1);
    }
    .pack-tpl--open { cursor: zoom-in; }
    .pack-tpl--open:hover { transform: translateY(-3px); box-shadow: 0 26px 50px -28px rgba(28,29,34,0.5); }
    /* Hover hint — a small "enlarge" glyph appears top-left on the previews. */
    .pack-tpl--open::after {
      content: "⤢";
      position: absolute; top: 12px; left: 12px; z-index: 2;
      width: 30px; height: 30px; border-radius: 50%;
      display: grid; place-items: center;
      background: rgba(28,29,34,0.62); color: var(--paper); font-size: 14px;
      opacity: 0; transform: scale(0.8); transition: opacity 0.25s, transform 0.25s;
      pointer-events: none;
    }
    .pack-tpl--open:hover::after, .pack-tpl--open:focus-visible::after { opacity: 1; transform: scale(1); }

    /* Lightbox */
    .pack-lightbox {
      position: fixed; inset: 0; z-index: 300;
      display: flex; align-items: center; justify-content: center;
      padding: clamp(20px, 5vh, 60px);
      background: rgba(16,15,13,0.92); backdrop-filter: blur(6px);
    }
    .pack-lightbox[hidden] { display: none; }
    .pack-lightbox-fig { margin: 0; display: flex; flex-direction: column; align-items: center; gap: 16px; max-height: 100%; }
    .pack-lightbox-fig img {
      max-width: min(92vw, 760px); max-height: 82vh; width: auto; height: auto;
      object-fit: contain; border-radius: 3px; box-shadow: 0 40px 90px -30px rgba(0,0,0,0.7);
    }
    .pack-lightbox-fig figcaption {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.2em; text-transform: uppercase; color: rgba(240,238,235,0.8);
    }
    .pack-lightbox-close {
      position: absolute; top: 22px; right: 26px;
      width: 46px; height: 46px; border-radius: 50%; border: 0; cursor: pointer;
      background: rgba(240,238,235,0.12); color: var(--paper); font-size: 26px; line-height: 1;
      display: grid; place-items: center; transition: background 0.2s;
    }
    .pack-lightbox-close:hover { background: rgba(240,238,235,0.24); }
    .pack-lightbox-count {
      font-family: var(--sans); font-size: 12px; font-weight: 700;
      letter-spacing: 0.18em; color: rgba(240,238,235,0.55);
    }
    .pack-lightbox-nav {
      position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
      width: 52px; height: 52px; border-radius: 50%; border: 0; cursor: pointer;
      background: rgba(240,238,235,0.12); color: var(--paper);
      display: grid; place-items: center; transition: background 0.2s;
    }
    .pack-lightbox-nav:hover { background: rgba(240,238,235,0.26); }
    .pack-lightbox-nav[hidden] { display: none; }
    .pack-lightbox-prev { left: clamp(12px, 3vw, 40px); }
    .pack-lightbox-next { right: clamp(12px, 3vw, 40px); }
    @media (max-width: 640px) {
      .pack-lightbox-nav { width: 44px; height: 44px; }
      .pack-lightbox-prev { left: 8px; }
      .pack-lightbox-next { right: 8px; }
    }
    .pack-tpl img {
      width: 100%; aspect-ratio: 3/4;
      object-fit: cover; display: block;
    }
    .pack-tpl-empty { width: 100%; aspect-ratio: 3/4; background: rgba(28,29,34,0.06); }
    /* Numbered, under each one: "01  Pumpkin picking season". */
    .pack-tpl figcaption {
      padding: 14px 0 0;
      display: flex; gap: 10px; align-items: baseline;
    }
    .pack-tpl-num {
      flex: none; font-family: var(--serif); font-size: 12px;
      letter-spacing: 0.06em; color: rgba(240,238,235,0.5); font-variant-numeric: tabular-nums;
    }
    .pack-tpl-cat {
      font-family: var(--sans); font-size: 9.5px;
      font-weight: 700; letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--english-violet);
    }
    /* Standard-copy title in Darker Grotesque, bold — keeps the caption compact
       so the template thumbnail is the star (was an oversized serif). */
    .pack-tpl-name {
      font-family: var(--serif); font-weight: 400; font-size: 12px;
      letter-spacing: 0.08em; text-transform: uppercase;
      line-height: 1.35; color: rgba(240,238,235,0.75);
    }

    .pack-tpl--locked img { filter: blur(14px) saturate(0.7); transform: scale(1.08); }
    .pack-tpl--locked .pack-tpl-empty { filter: none; }
    .pack-tpl--locked::before {
      content: "";
      position: absolute; left: 0; right: 0; top: 0;
      aspect-ratio: 3/4;
      background: rgba(28,29,34,0.5);
      pointer-events: none;
    }
    .pack-tpl-lock-overlay {
      position: absolute;
      top: 14px; right: 14px;
      z-index: 2;
      display: inline-flex; align-items: center; justify-content: center;
      width: 38px; height: 38px;
      border-radius: 50%;
      background: rgba(28,29,34,0.78);
      color: var(--paper);
      backdrop-filter: blur(8px);
    }
    .pack-tpl--locked .pack-tpl-name {
      color: rgba(240,238,235,0.45);
      font-style: normal;
    }

    /* ---- MORE PACKS: related and recently viewed ----
       Studio Blanche's way: two centred tabs, then the packs' images edge to
       edge, a quiet line of text under each. Fewer than four sit centred at
       the same size rather than stretching. */
    .pd-more { padding: 64px 0 0; }
    .pd-tabs { display: flex; justify-content: center; gap: 40px; margin-bottom: 36px; }
    .pd-tab {
      background: none; border: 0; padding: 0 0 6px; cursor: pointer;
      border-bottom: 1px solid transparent;
      font-family: var(--serif); font-size: 15px; font-weight: 400; letter-spacing: 0.06em;
      text-transform: uppercase; color: rgba(28,29,34,0.5);
    }
    .pd-tab[hidden] { display: none; }
    .pd-tab.is-on { color: var(--ink); border-bottom-color: var(--ink); }
    .pd-tab:focus-visible { outline: 2px solid var(--english-violet); outline-offset: 3px; }
    .pd-cards {
      display: grid; gap: 6px;
      grid-template-columns: repeat(var(--n, 4), minmax(0, 1fr));
      width: calc(100% * min(var(--n, 4), 4) / 4); margin: 0 auto;
    }
    .pd-cards[hidden] { display: none; }
    @media (max-width: 860px) { .pd-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); width: 100%; } }
    .pd-card { display: block; color: var(--ink); }
    .pd-card-img { display: block; aspect-ratio: 3 / 4; overflow: hidden; background: #e7e0dc; }
    .pd-card-img img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.8s cubic-bezier(.2,.7,.2,1); }
    .pd-card:hover .pd-card-img img { transform: scale(1.025); }
    .pd-card-text { display: flex; justify-content: space-between; gap: 12px; padding: 14px 16px 30px; }
    .pd-card-title { font-family: var(--serif); font-size: 13px; letter-spacing: 0.06em; text-transform: uppercase; }
    .pd-card-price { font-family: var(--sans); font-size: 13px; color: rgba(28,29,34,0.6); white-space: nowrap; }
  </style>

  <script is:inline>
    // Re-use the catalogue's checkout modal: clicking any [data-buy] sends
    // the user back to /edit?buy=<id> which opens the modal for that pack.
    document.querySelectorAll('[data-buy]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        const id = btn.getAttribute('data-buy');
        if (id) window.location.href = '/edit?buy=' + encodeURIComponent(id);
      });
    });

    // Click a preview to open it large, then flip through the rest with the
    // arrows (or ← →) — no need to close and re-open each one.
    (function () {
      var lb = document.getElementById('pack-lightbox');
      var img = document.getElementById('pack-lightbox-img');
      var cap = document.getElementById('pack-lightbox-cap');
      var count = document.getElementById('pack-lightbox-count');
      var prevBtn = document.getElementById('pack-lightbox-prev');
      var nextBtn = document.getElementById('pack-lightbox-next');
      if (!lb || !img) return;

      // Two sets you can flip through: the templates, and the mockups. The
      // sliding strip opens whichever one it shows ("tpl:2", "mock:0").
      var sets = { tpl: [], mock: [] };
      document.querySelectorAll('[data-zoom]').forEach(function (el) {
        var set = sets[el.getAttribute('data-set')] || sets.tpl;
        el.setAttribute('data-zoom-i', String(set.length));
        set.push({ full: el.getAttribute('data-full'), name: el.getAttribute('data-name') || '' });
      });
      var items = [];
      var idx = 0;
      var multiple = false;

      function render() {
        var it = items[idx];
        if (!it) return;
        img.src = it.full; img.alt = it.name; cap.textContent = it.name;
        if (count) count.textContent = multiple ? (idx + 1) + ' / ' + items.length : '';
      }
      function open(i, setName) {
        items = sets[setName] || sets.tpl;
        if (!items.length) return;
        multiple = items.length > 1;
        if (prevBtn) prevBtn.hidden = !multiple;
        if (nextBtn) nextBtn.hidden = !multiple;
        idx = (i + items.length) % items.length;
        render();
        lb.hidden = false; document.documentElement.style.overflow = 'hidden';
      }
      function close() { lb.hidden = true; img.removeAttribute('src'); document.documentElement.style.overflow = ''; }
      function go(d) { idx = (idx + d + items.length) % items.length; render(); }

      document.querySelectorAll('[data-zoom]').forEach(function (el) {
        var i = Number(el.getAttribute('data-zoom-i')), set = el.getAttribute('data-set') || 'tpl';
        el.addEventListener('click', function () { open(i, set); });
        el.addEventListener('keydown', function (e) {
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(i, set); }
        });
      });
      document.querySelectorAll('[data-zoomto]').forEach(function (el) {
        el.addEventListener('click', function () {
          var parts = String(el.getAttribute('data-zoomto')).split(':');
          open(Number(parts[1]) || 0, parts[0]);
        });
      });
      if (prevBtn) prevBtn.addEventListener('click', function (e) { e.stopPropagation(); go(-1); });
      if (nextBtn) nextBtn.addEventListener('click', function (e) { e.stopPropagation(); go(1); });
      lb.addEventListener('click', function (e) { if (e.target === lb || e.target.closest('.pack-lightbox-close')) close(); });
      document.addEventListener('keydown', function (e) {
        if (lb.hidden) return;
        if (e.key === 'Escape') close();
        else if (e.key === 'ArrowLeft' && multiple) go(-1);
        else if (e.key === 'ArrowRight' && multiple) go(1);
      });
    })();

    // The strip moves one template along, waits two seconds, and moves again
    // (as Moyo Studio's does), rather than drifting. Three copies of the set
    // sit in the track, so after a full set it jumps back unseen.
    // It only waits while the pointer is actually over it (asked fresh at each
    // step, so scrolling away can't leave it stuck), and it doesn't step while
    // it's off screen. Still for reduced motion. (Danielle, 24 Oct: it stopped
    // after scrolling down and didn't start again.)
    (function () {
      var reel = document.querySelector('.pd-reel');
      var track = reel && reel.querySelector('.pd-reel-track');
      if (!track) return;
      var n = Number(track.getAttribute('data-count')) || 0;
      if (n < 2 || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      var i = 0, onScreen = true, SLIDE = 900, WAIT = 2000;
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (es) { onScreen = es[0].isIntersecting; }).observe(reel);
      }
      function stepWidth() {
        var a = track.children[0], b = track.children[1];
        return b.getBoundingClientRect().left - a.getBoundingClientRect().left;
      }
      function place(animate) {
        track.style.transition = animate ? 'transform ' + SLIDE + 'ms cubic-bezier(.65,0,.35,1)' : 'none';
        track.style.transform = 'translateX(' + (-i * stepWidth()) + 'px)';
      }
      function tick() {
        var held = document.hidden || !onScreen || reel.matches(':hover');
        if (!held) {
          i += 1;
          place(true);
          if (i >= n) setTimeout(function () { i = 0; place(false); }, SLIDE + 30);
        }
        setTimeout(tick, held ? 500 : SLIDE + WAIT);
      }
      setTimeout(tick, SLIDE + WAIT);
      window.addEventListener('resize', function () { place(false); });
    })();

    // The panel stays in view while you scroll the left column. When it's
    // taller than the window it settles with its foot at the bottom instead,
    // so the end of it can still be read.
    (function () {
      var el = document.querySelector('.pd-panel-in');
      if (!el) return;
      function fit() { el.style.top = Math.min(78, window.innerHeight - el.offsetHeight - 16) + 'px'; }
      fit();
      window.addEventListener('resize', fit);
      document.querySelectorAll('.pd-acc details').forEach(function (d) { d.addEventListener('toggle', fit); });
    })();

    // "You might also like" / "Recently viewed": this browser remembers the
    // packs it has opened (nothing leaves the device), newest first.
    (function () {
      var cur = document.getElementById('pd-current');
      var dataEl = document.getElementById('pd-cards-data');
      if (!cur || !dataEl) return;
      var slug = cur.getAttribute('data-slug');
      var KEY = 'tmke-recent-packs';
      var seen = [];
      try { seen = JSON.parse(localStorage.getItem(KEY) || '[]'); if (!Array.isArray(seen)) seen = []; } catch (e) { seen = []; }
      try { localStorage.setItem(KEY, JSON.stringify([slug].concat(seen.filter(function (s) { return s !== slug; })).slice(0, 8))); } catch (e) {}
      var cards = [];
      try { cards = JSON.parse(dataEl.textContent || '[]'); } catch (e) {}
      var bySlug = {}; cards.forEach(function (c) { bySlug[c.slug] = c; });
      var recent = seen.filter(function (s) { return s !== slug && bySlug[s]; }).slice(0, 4).map(function (s) { return bySlug[s]; });
      if (!recent.length) return;
      var esc = function (t) { return String(t == null ? '' : t).replace(/[&<>"]/g, function (ch) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[ch]; }); };
      var panel = document.querySelector('[data-panel="recent"]');
      panel.style.setProperty('--n', String(recent.length));
      panel.innerHTML = recent.map(function (c) {
        return '<a class="pd-card" href="/edit/' + encodeURIComponent(c.slug) + '">' +
          '<span class="pd-card-img">' + (c.cover ? '<img src="' + esc(c.cover) + '" alt="" loading="lazy" />' : '') + '</span>' +
          '<span class="pd-card-text"><span class="pd-card-title">' + esc(c.title) + '</span><span class="pd-card-price">' + esc(c.price) + ' +VAT</span></span></a>';
      }).join('');
      var tabs = document.querySelectorAll('.pd-tab');
      document.querySelector('.pd-tab[data-tab="recent"]').hidden = false;
      tabs.forEach(function (t) {
        t.addEventListener('click', function () {
          tabs.forEach(function (x) { var on = x === t; x.classList.toggle('is-on', on); x.setAttribute('aria-selected', on ? 'true' : 'false'); });
          document.querySelectorAll('.pd-cards[data-panel]').forEach(function (p) { p.hidden = p.getAttribute('data-panel') !== t.getAttribute('data-tab'); });
        });
      });
    })();
  </script>
</BaseLayout>
