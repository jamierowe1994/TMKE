---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Debossed wordmark — TMKE"
  description="A pure-CSS debossed (letterpress) TMKE wordmark experiment."
  noindex
>
  <section class="db-hero">
    <div class="db-stage">
      <h1 class="db-word">TMKE</h1>
    </div>

    <p class="db-cap">Pure CSS &middot; no image &middot; debossed / letterpress</p>
  </section>

  <style>
    .db-hero {
      position: relative;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 28px;
      /* Soft paper field — a gentle vignette gives the surface some form
         so the carved letters have something to sit in. */
      background:
        radial-gradient(130% 130% at 50% 38%, #f6f3ec 0%, var(--paper) 62%, #ebe6da 100%);
      overflow: hidden;
      padding: 120px 24px;
    }

    /* Very faint fractal-noise grain, multiplied over the paper so the
       deboss highlights/shadows have texture to catch. */
    /* Leather-like grain: a fine fractal grain layered over a coarser mottle
       so the surface reads as hide, not paper. Multiplied over the field. */
    .db-stage { position: relative; z-index: 1; }

    /* ---------- The debossed wordmark ----------
       1. The face is filled with a top-dark → bottom-light gradient via
          background-clip, so the letter surface itself looks recessed.
       2. text-shadow adds the carved edges:
            · dark shadow ABOVE  (the top inner wall, away from light)
            · light highlight BELOW (the bottom lip catching the light)
       Flip those two and it becomes embossed (raised) instead. */
    .db-word {
      margin: 0;
      font-family: var(--sans);
      font-weight: 800;
      font-size: clamp(84px, 19vw, 320px);
      letter-spacing: 0.02em;
      line-height: 1;

      /* Recessed face: a grain texture blended over a top-dark gradient so
         the pressed letters show the same hide as the surface. */
      /* Face = the paper colour a couple of shades darker. Subtle, but
         enough to read; the depth comes entirely from the edge shadows. */
      color: #e6e0d2;

      /* Layered carve — stacked dark shadows climb the top inner wall, then
         a crisp light lip + a pool of light spilling into the bottom of the
         recess. Reads as a deep press, not a flat engrave. */
      text-shadow:
        0 -1px 1px rgba(36, 30, 18, 0.24),    /* top inner wall, in shadow */
        0 -2px 4px rgba(36, 30, 18, 0.12),    /* soft depth up the wall     */
        0 1px 1px rgba(255, 255, 255, 0.95),  /* crisp lit bottom lip       */
        0 2px 5px rgba(255, 255, 255, 0.55);  /* light pooling below        */
    }

    .db-cap {
      position: relative;
      z-index: 1;
      margin: 0;
      font-family: var(--sans);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      color: rgba(28, 29, 34, 0.4);
    }

    @media (prefers-reduced-motion: reduce) { .db-grain { display: none; } }
  </style>
</BaseLayout>
