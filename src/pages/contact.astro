---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
---

<BaseLayout
  title="Get in Touch — TMKE"
  description="Looking for templates or full social media management? Tell us what you need and we'll point you in the right direction."
>
  <PageHero
    chapter="Get in Touch"
    title="<em>Let's chat.</em>"
    sub="Whether you're after a single template pack or a fully managed channel — start the conversation."
  />

  <section class="page-placeholder">
    <span class="placeholder-tag">Work in progress</span>
    <p>This page will host the enquiry experience. To be built next:</p>
    <ul class="placeholder-list">
      <li>Short intro — confident, not desperate</li>
      <li><em>Find Your Fit</em> quiz — short, guided, routes to The Edit / SMM / Discovery Call</li>
      <li>Structured contact form (Name, Business, Email, Phone, Enquiry type, Message)</li>
      <li>Direct contact info: Email · LinkedIn · Instagram</li>
      <li>Service direction cards — Browse The Edit · Book a Discovery Call</li>
      <li>Live Instagram preview rail</li>
    </ul>
  </section>
</BaseLayout>
