---
import BaseLayout from "../layouts/BaseLayout.astro";

const industries = [
  "Estate Agency",
  "Lettings",
  "Property Developer",
  "Property Investor",
  "Mortgage Adviser",
  "Other Property Services",
  "Other",
];

---

<BaseLayout
  title="Contact — TMKE"
  description="Not sure what you need or where to start? Send us a message and we'll help you figure out the right next step."
>
  <section class="contact-hero">
    <video
      class="contact-hero-video"
      data-hero-video
      muted
      loop
      playsinline
      preload="metadata"
      poster="/assets/hero-poster-dark.svg"
      aria-hidden="true"
    >
      <source data-src="/assets/phone.mp4" type="video/mp4" />
    </video>
    <div class="contact-hero-overlay"></div>
    <div class="contact-hero-vignette"></div>
    <div class="contact-hero-inner">
      <div class="contact-hero-chapter">/ Contact /</div>
      <p class="contact-hero-text">
        Not sure what you <strong>need</strong> or where to <strong>start</strong>?<br />
        Send us a <strong>message</strong> and we'll help you figure out<br />
        the right <strong>next step</strong>.
      </p>
      <a href="#contact-form" class="contact-hero-btn">Say Hello</a>
    </div>
  </section>

  <section class="contact-form-section" id="contact-form">
    <div class="contact-form-wrap">
      <h2 class="contact-form-title">Get In Touch.</h2>

      <p class="contact-form-intro">
        Whether you've got a question, want to learn more, or just need pointing in
        the right direction, we're here to help.
      </p>

      <form class="contact-form" id="tmke-contact-form" novalidate>
        <div class="contact-form-card">
          <div class="contact-field">
            <label for="cf-first">First Name <span>*</span></label>
            <input id="cf-first" name="first_name" type="text" placeholder="First Name" required />
          </div>

          <div class="contact-field">
            <label for="cf-last">Last Name <span>*</span></label>
            <input id="cf-last" name="last_name" type="text" placeholder="Last Name" required />
          </div>

          <div class="contact-field">
            <label for="cf-phone">Phone <span>*</span></label>
            <input id="cf-phone" name="phone" type="tel" placeholder="Phone" required />
          </div>

          <div class="contact-field">
            <label for="cf-email">Email <span>*</span></label>
            <div class="contact-input-with-icon">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="M3 7l9 6 9-6" />
              </svg>
              <input id="cf-email" name="email" type="email" placeholder="Email" required />
            </div>
          </div>

          <div class="contact-field">
            <label for="cf-business">Business Name <span>*</span></label>
            <input id="cf-business" name="business_name" type="text" placeholder="Business Name" required />
          </div>

          <div class="contact-field">
            <label for="cf-industry">Industry <span>*</span></label>
            <select id="cf-industry" name="industry" required>
              <option value="" disabled selected>Please Select One</option>
              {industries.map((i) => <option value={i}>{i}</option>)}
            </select>
          </div>

          <div class="contact-field contact-field--full">
            <label for="cf-message">How Can We Help?</label>
            <textarea
              id="cf-message"
              name="message"
              rows="5"
              placeholder="Tell Us A Bit About What You're Looking For"
            ></textarea>
          </div>

          <div class="contact-field contact-field--full contact-submit-row">
            <button type="submit" class="btn btn--solid contact-submit">
              Send Message
            </button>
            <p class="contact-form-thanks" hidden>
              Thanks — your message is on its way. We'll be in touch shortly.
            </p>
            <p class="contact-form-error" role="alert" hidden></p>
          </div>
        </div>
      </form>
    </div>
  </section>

  <section class="contact-channels">
    <div class="contact-channels-wrap">
      <a
        class="contact-channel"
        href="mailto:info@themarketingexperts.co.uk"
        style="background-image: url('https://images.unsplash.com/photo-1581338834647-b0fb40704e21?auto=format&fit=crop&w=1200&q=80')"
      >
        <div class="contact-channel-overlay">
          <div class="contact-channel-label">Email</div>
          <div class="contact-channel-value">info@themarketingexperts.co.uk</div>
        </div>
      </a>

      <a
        class="contact-channel"
        href="#"
        style="background-image: url('https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=1200&q=80')"
      >
        <div class="contact-channel-overlay">
          <div class="contact-channel-label">LinkedIn</div>
          <div class="contact-channel-value">info@themarketingexperts.co.uk</div>
        </div>
      </a>

      <a
        class="contact-channel"
        href="https://instagram.com/tmke_propertymarketing"
        target="_blank"
        rel="noopener noreferrer"
        style="background-image: url('https://images.unsplash.com/photo-1539109136881-3be0616acf4b?auto=format&fit=crop&w=1200&q=80')"
      >
        <div class="contact-channel-overlay">
          <div class="contact-channel-label">Instagram</div>
          <div class="contact-channel-value">@tmke_propertymarketing</div>
        </div>
      </a>
    </div>
  </section>

  <section class="contact-insta">
    <div class="contact-insta-wrap">
      <h2 class="contact-insta-title">Take a Look</h2>

      <div class="contact-insta-intro">
        <div class="contact-insta-copy">
          <p>
            If you want to get a feel for how we work, check out our Instagram —
            everything you see reflects the standard we help our clients achieve
            online. We also share content designed to help property professionals
            get better at their marketing, from simple ideas to practical ways to
            stay consistent.
          </p>
          <p>
            Explore our page to see the content we create and what showing up
            consistently and professionally looks like in practice.<br />
            Don't forget to follow along to keep up with what we're working on.
          </p>
        </div>
        <a href="#" class="btn btn--solid contact-insta-follow" aria-label="Follow TMKE on Instagram">
          Follow
        </a>
      </div>
    </div>

    <div class="contact-insta-embed">
      <iframe
        onload="iFrameSetup(this)"
        src="https://app.mirror-app.com/feed-instagram/f9155035-02f1-4d8e-ac66-872645986785/preview"
        style="width:100%;border:none;overflow:hidden;"
        scrolling="no"
        title="TMKE on Instagram"
      ></iframe>
      <script
        src="https://cdn.jsdelivr.net/npm/@mirrorapp/iframe-bridge@latest/dist/index.umd.js"
        is:inline></script>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    const video = document.querySelector("[data-hero-video]");
    if (video) {
      const source = video.querySelector("source[data-src]");
      let armed = false;
      const arm = function () {
        if (armed || !source) return;
        armed = true;
        source.setAttribute("src", source.getAttribute("data-src"));
        video.load();
        const playPromise = video.play();
        if (playPromise && playPromise.catch) playPromise.catch(function () {});
      };
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(function (entries) {
          for (const e of entries) {
            if (e.isIntersecting) { arm(); io.disconnect(); break; }
          }
        }, { rootMargin: "200px" });
        io.observe(video);
      } else {
        arm();
      }
    }
  })();
</script>

<script>
  import { supabase } from "../lib/supabase.js";

  const form = document.getElementById("tmke-contact-form");
  if (form) {
    const card = form.querySelector(".contact-form-card");
    const thanks = form.querySelector(".contact-form-thanks");
    const error = form.querySelector(".contact-form-error");
    const btn = form.querySelector(".contact-submit");

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      if (error) error.hidden = true;
      if (btn) {
        btn.setAttribute("disabled", "true");
        btn.textContent = "Sending…";
      }

      const fd = new FormData(form);
      const payload = {
        first_name: String(fd.get("first_name") || "").trim(),
        last_name: String(fd.get("last_name") || "").trim(),
        phone: String(fd.get("phone") || "").trim() || null,
        email: String(fd.get("email") || "").trim(),
        business_name: String(fd.get("business_name") || "").trim() || null,
        industry: String(fd.get("industry") || "").trim() || null,
        message: String(fd.get("message") || "").trim() || null,
        source: "contact_form",
      };

      const { error: insertError } = await supabase
        .from("enquiries")
        .insert(payload);

      if (insertError) {
        console.error("[TMKE] enquiry insert failed", insertError);
        if (btn) {
          btn.removeAttribute("disabled");
          btn.textContent = "Send Message";
        }
        if (error) {
          error.textContent =
            "Sorry — we couldn't send that. Please try again, or email hello@tmke.co.uk.";
          error.hidden = false;
        }
        return;
      }

      if (thanks) thanks.hidden = false;
      if (card) card.classList.add("is-sent");
      form.reset();
    });
  }
</script>

<style is:global>
  /* ============ Contact — hero ============ */
  .contact-hero {
    position: relative;
    min-height: 92vh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    color: var(--paper);
    background: #0e0d12;
  }
  .contact-hero-video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.06);
    animation: hero-cinematic-drift 22s ease-in-out infinite alternate;
    will-change: transform;
    filter: saturate(0.92) contrast(1.04);
    pointer-events: none;
  }
  .contact-hero-overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
        180deg,
        rgba(14, 13, 18, 0.55) 0%,
        rgba(14, 13, 18, 0.45) 45%,
        rgba(14, 13, 18, 0.65) 100%
      );
  }
  .contact-hero-vignette {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        ellipse at center,
        rgba(14, 13, 18, 0) 30%,
        rgba(14, 13, 18, 0.45) 80%,
        rgba(14, 13, 18, 0.85) 100%
      );
  }
  .contact-hero-inner {
    position: relative;
    z-index: 2;
    text-align: center;
    padding: 160px 28px 120px;
    max-width: 760px;
    text-shadow: 0 1px 30px rgba(14, 13, 18, 0.55);
  }
  .contact-hero-chapter {
    font-family: var(--serif);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(32px, 3.6vw, 52px);
    letter-spacing: 0.02em;
    margin-bottom: 36px;
    color: var(--paper);
    text-shadow: 0 2px 24px rgba(14, 13, 18, 0.6);
  }
  .contact-hero-text {
    font-family: var(--sans);
    font-size: clamp(16px, 1.4vw, 19px);
    font-weight: 400;
    line-height: 1.75;
    color: rgba(242, 239, 233, 0.95);
    margin: 0 0 44px;
  }
  .contact-hero-text strong {
    font-weight: 700;
    color: var(--paper);
  }
  .contact-hero-btn {
    display: inline-block;
    padding: 14px 30px;
    border: 1px solid rgba(242, 239, 233, 0.9);
    background: rgba(14, 13, 18, 0.25);
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    color: var(--paper);
    font-family: var(--sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    transition: background 0.3s, color 0.3s, border-color 0.3s;
    text-shadow: none;
  }
  .contact-hero-btn:hover {
    background: var(--paper);
    color: var(--ink);
    border-color: var(--paper);
  }
  @keyframes hero-cinematic-drift {
    0%   { transform: scale(1.06) translate3d(0, 0, 0); }
    100% { transform: scale(1.12) translate3d(-1.5%, -1%, 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-hero-video { animation: none; transform: scale(1.04); }
  }

  /* ============ Contact — form ============ */
  .contact-form-section {
    background: var(--paper);
    padding: 120px 28px 100px;
  }
  .contact-form-wrap {
    max-width: 1360px;
    margin: 0 auto;
  }
  .contact-form-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(56px, 8vw, 128px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--gunmetal);
    margin: 0 0 80px;
  }
  .contact-form-intro {
    font-family: var(--sans);
    font-size: clamp(15px, 1.2vw, 17px);
    line-height: 1.6;
    color: var(--gunmetal);
    max-width: 720px;
    margin: 0 0 40px;
  }
  .contact-form {
    margin: 0;
  }
  .contact-form-card {
    border: 1px solid rgba(51, 55, 71, 0.55);
    border-radius: 6px;
    padding: 64px clamp(32px, 8vw, 140px);
    background: transparent;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 56px;
    row-gap: 32px;
    width: 100%;
    margin: 0;
  }
  .contact-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .contact-field label {
    font-family: var(--sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--gunmetal);
    letter-spacing: 0;
  }
  .contact-field label span {
    color: var(--gunmetal);
    margin-left: 2px;
  }
  .contact-field input,
  .contact-field select,
  .contact-field textarea {
    font-family: var(--sans);
    font-size: 15px;
    color: var(--gunmetal);
    background: transparent;
    border: none;
    border-bottom: 1px solid rgba(51, 55, 71, 0.45);
    padding: 10px 0 12px;
    width: 100%;
    outline: none;
    transition: border-color 0.25s;
    border-radius: 0;
  }
  .contact-field input::placeholder,
  .contact-field textarea::placeholder {
    color: rgba(51, 55, 71, 0.35);
    font-family: var(--sans);
  }
  .contact-field input:focus,
  .contact-field select:focus,
  .contact-field textarea:focus {
    border-bottom-color: var(--gunmetal);
  }
  .contact-field select {
    appearance: none;
    -webkit-appearance: none;
    -moz-appearance: none;
    background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8' viewBox='0 0 12 8' fill='none' stroke='%23333747' stroke-width='1.5'><path d='M1 1l5 5 5-5'/></svg>");
    background-repeat: no-repeat;
    background-position: right 4px center;
    padding-right: 28px;
  }
  .contact-field select:invalid {
    color: rgba(51, 55, 71, 0.35);
  }
  .contact-field textarea {
    resize: vertical;
    min-height: 96px;
    line-height: 1.5;
  }
  .contact-input-with-icon {
    position: relative;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(51, 55, 71, 0.45);
    transition: border-color 0.25s;
  }
  .contact-input-with-icon:focus-within {
    border-bottom-color: var(--gunmetal);
  }
  .contact-input-with-icon svg {
    color: rgba(51, 55, 71, 0.55);
    margin-right: 10px;
    flex: 0 0 auto;
  }
  .contact-input-with-icon input {
    border-bottom: none;
    padding: 10px 0 12px;
  }
  .contact-field--full {
    grid-column: 1 / -1;
  }
  .contact-submit-row {
    margin-top: 16px;
    align-items: flex-start;
    gap: 16px;
  }
  .contact-submit {
    align-self: flex-start;
  }
  .contact-form-thanks {
    font-family: var(--sans);
    font-size: 14px;
    color: var(--english-violet);
  }
  .contact-form-error {
    font-family: var(--sans);
    font-size: 14px;
    color: #b03a2e;
    margin: 0;
  }
  .contact-form-card.is-sent .contact-field:not(.contact-submit-row) {
    opacity: 0.45;
    pointer-events: none;
  }

  /* ============ Contact — channel cards (Email / LinkedIn / Instagram) ============ */
  .contact-channels {
    background: var(--paper);
    padding: 60px 28px 100px;
  }
  .contact-channels-wrap {
    max-width: 1360px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4px;
  }
  .contact-channel {
    position: relative;
    display: block;
    aspect-ratio: 3 / 5;
    background-color: var(--platinum);
    background-size: cover;
    background-position: center;
    overflow: hidden;
    color: var(--paper);
    isolation: isolate;
  }
  .contact-channel::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(20, 18, 26, 0) 35%,
      rgba(20, 18, 26, 0.55) 65%,
      rgba(20, 18, 26, 0.92) 100%
    );
    transition: background 0.4s;
  }
  .contact-channel:hover::after {
    background: linear-gradient(
      180deg,
      rgba(20, 18, 26, 0.1) 25%,
      rgba(20, 18, 26, 0.65) 60%,
      rgba(20, 18, 26, 0.95) 100%
    );
  }
  .contact-channel-overlay {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 1;
    padding: 32px 28px 36px;
    color: var(--paper);
  }
  .contact-channel-label {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(26px, 2.4vw, 34px);
    line-height: 1;
    margin-bottom: 14px;
    color: var(--paper);
  }
  .contact-channel-value {
    font-family: var(--sans);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.01em;
    color: rgba(242, 239, 233, 0.85);
    word-break: break-word;
  }

  /* ============ Contact — Instagram preview ============ */
  .contact-insta {
    background: var(--paper);
    padding: 60px 0 140px;
    overflow: hidden;
  }
  .contact-insta-wrap {
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 36px;
  }
  .contact-insta-title {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(28px, 2.6vw, 36px);
    color: var(--gunmetal);
    margin: 0 0 28px;
  }
  .contact-insta-intro {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 40px;
    align-items: end;
    margin-bottom: 56px;
  }
  .contact-insta-copy p {
    font-family: var(--sans);
    font-size: 16px;
    line-height: 1.65;
    color: var(--gunmetal);
    max-width: 760px;
    margin: 0 0 16px;
  }
  .contact-insta-copy p:last-child {
    margin-bottom: 0;
  }
  .contact-insta-follow {
    white-space: nowrap;
  }

  .contact-insta-embed {
    width: 100%;
    max-width: 1360px;
    margin: 0 auto;
    padding: 0 36px;
  }
  .contact-insta-embed iframe {
    display: block;
    width: 100%;
    min-height: 420px;
  }

  /* ============ Contact — responsive ============ */
  @media (max-width: 720px) {
    .contact-hero { min-height: 88vh; }
    .contact-hero-inner { padding: 140px 22px 100px; }
    .contact-form-section { padding: 80px 22px 60px; }
    .contact-form-title { margin: 0 0 48px; }
    .contact-form-card { padding: 36px 22px; grid-template-columns: 1fr; column-gap: 0; row-gap: 22px; }
    .contact-channels { padding: 40px 22px 60px; }
    .contact-channels-wrap { grid-template-columns: 1fr; gap: 4px; }
    .contact-channel { aspect-ratio: 4 / 5; }
    .contact-insta-wrap { padding: 0 22px; }
    .contact-insta-intro {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 24px;
    }
    .contact-insta-follow { justify-self: start; }
    .contact-insta-embed { padding: 0 22px; }
  }
</style>
