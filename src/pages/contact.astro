---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import DiscoveryPanel from "../components/DiscoveryPanel.astro";
---

<BaseLayout
  title="Get in Touch — TMKE"
  description="Looking for templates or full social media management? Tell us what you need and we'll point you in the right direction."
>
  <PageHero
    chapter="Get in Touch"
    title="<em>Let's chat.</em>"
    sub="Whether you're after a single template pack, a fully-managed channel, or just a conversation — start here."
  />

  <section class="contact-grid wrap">
    <a href="#" class="contact-card contact-card--accent" data-discovery-call>
      <span class="contact-card-eyebrow">Best place to start</span>
      <h2 class="contact-card-title">Book a discovery call</h2>
      <p>Thirty minutes on Google Meet. We'll talk through your brand, your channels, and where TMKE can take them.</p>
      <span class="contact-card-cta">Open the calendar <em>&rarr;</em></span>
    </a>

    <a href="/edit" class="contact-card">
      <span class="contact-card-eyebrow">Self-serve</span>
      <h2 class="contact-card-title">Browse The Edit</h2>
      <p>Ten signature template packs for estate agents and property brands. £299 each, on-brand, ready to post.</p>
      <span class="contact-card-cta">View the shop <em>&rarr;</em></span>
    </a>

    <a href="/services" class="contact-card">
      <span class="contact-card-eyebrow">Done for you</span>
      <h2 class="contact-card-title">Fully managed social media</h2>
      <p>Strategy, content, planning, posting, reporting. A long-term partnership for agencies who'd rather not run it themselves.</p>
      <span class="contact-card-cta">See the service <em>&rarr;</em></span>
    </a>
  </section>

  <section class="contact-meta wrap">
    <div>
      <div class="eyebrow">Direct</div>
      <p><a href="mailto:hello@tmke.co.uk">hello@tmke.co.uk</a></p>
      <p><a href="tel:+442012345678">+44 (0) 20 1234 5678</a></p>
    </div>
    <div>
      <div class="eyebrow">Social</div>
      <p><a href="https://instagram.com/tmke" rel="noopener" target="_blank">@tmke on Instagram</a></p>
      <p><a href="https://linkedin.com/company/tmke" rel="noopener" target="_blank">TMKE on LinkedIn</a></p>
    </div>
    <div>
      <div class="eyebrow">Office hours</div>
      <p>Mon–Fri · 9am–5pm GMT</p>
      <p>Replies within one working day.</p>
    </div>
  </section>

  <DiscoveryPanel />

  <style>
    .contact-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
      max-width: 1360px;
      margin: 0 auto;
      padding: 0 36px 60px;
    }
    @media (max-width: 980px) { .contact-grid { grid-template-columns: 1fr; } }

    .contact-card {
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 32px;
      background: rgba(255,255,255,0.5);
      border: 1px solid rgba(71,66,84,0.18);
      border-radius: 3px;
      color: var(--ink);
      text-decoration: none;
      transition: transform 0.45s cubic-bezier(.2,.7,.2,1), border-color 0.4s, background 0.4s;
      cursor: pointer;
    }
    .contact-card:hover {
      transform: translateY(-3px);
      border-color: var(--english-violet);
      background: #fff;
    }
    .contact-card--accent {
      background: var(--ink);
      color: var(--paper);
      border-color: var(--ink);
    }
    .contact-card--accent:hover {
      background: var(--english-violet);
      border-color: var(--english-violet);
      color: var(--paper);
    }
    .contact-card-eyebrow {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.28em;
      text-transform: uppercase;
      font-weight: 700;
      opacity: 0.7;
    }
    .contact-card-title {
      font-family: var(--serif);
      font-size: 30px;
      font-weight: 500;
      letter-spacing: -0.015em;
      margin: 8px 0 0;
    }
    .contact-card p {
      font-family: var(--sans);
      font-size: 14px;
      line-height: 1.55;
      margin: 0;
      opacity: 0.85;
      flex: 1;
    }
    .contact-card-cta {
      font-family: var(--sans);
      font-size: 11px;
      letter-spacing: 0.24em;
      text-transform: uppercase;
      font-weight: 700;
      margin-top: 8px;
    }
    .contact-card-cta em {
      font-family: var(--serif);
      font-style: italic;
      font-size: 15px;
      letter-spacing: 0;
      text-transform: none;
      margin-left: 6px;
    }

    .contact-meta {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 36px;
      max-width: 1360px;
      margin: 0 auto;
      padding: 60px 36px 200px;
      border-top: 1px solid rgba(28, 29, 34, 0.1);
    }
    @media (max-width: 980px) { .contact-meta { grid-template-columns: 1fr; gap: 28px; } }
    .contact-meta .eyebrow { margin-bottom: 14px; }
    .contact-meta p { font-size: 16px; color: rgba(28,29,34,0.7); margin: 0 0 6px; }
    .contact-meta a { color: var(--english-violet); border-bottom: 1px solid currentColor; }
  </style>
</BaseLayout>
